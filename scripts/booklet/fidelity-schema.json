{
  "type": "object",
  "additionalProperties": false,
  "required": ["section", "itemsChecked", "flags"],
  "properties": {
    "section": { "type": "string" },
    "itemsChecked": { "type": "integer" },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "field", "category", "note", "sourceLines", "suggestedFix"],
        "properties": {
          "id": { "type": "string" },
          "field": {
            "type": ["string", "null"],
            "description": "The field the flag is about, e.g. \"answer\" or \"parts[1].question_text\". Null when the whole item is at issue."
          },
          "category": {
            "type": "string",
            "enum": [
              "omission",
              "value-drift",
              "answer-mismatch",
              "figure-mismatch",
              "hallucination",
              "tag-doubt",
              "formatting",
              "other"
            ]
          },
          "note": { "type": "string" },
          "sourceLines": {
            "type": ["string", "null"],
            "description": "The line or range in the supplied source that shows the discrepancy, e.g. \"131-146\". Null when it cannot be pinned to a line."
          },
          "suggestedFix": {
            "type": ["string", "null"],
            "description": "The corrected value, when there is an obvious one. Null otherwise."
          }
        }
      }
    }
  }
}
