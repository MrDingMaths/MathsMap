{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["format", "pages"],
  "properties": {
    "format": {"const": "mathsmap-booklet-import-v2"},
    "version": {"const": 2},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pageNumber", "blocks", "reviewFlags"],
        "properties": {
          "id": {"type": "string"},
          "pageNumber": {"type": "integer", "minimum": 1},
          "sourceImage": {"type": ["string", "null"]},
          "pdfText": {"type": "string"},
          "wordText": {"type": "string"},
          "accepted": {"type": "boolean"},
          "reviewFlags": {"type": "array", "items": {"type": "string"}},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "id"],
              "properties": {
                "type": {"enum": ["rich-text", "heading", "callout", "image", "worked-example", "question", "grid", "page-break"]},
                "id": {"type": "string"},
                "content": {},
                "title": {"type": ["string", "null"]},
                "source": {},
                "reviewFlags": {"type": "array", "items": {"type": "string"}},
                "parts": {"type": "array"},
                "columns": {"type": "integer", "minimum": 1, "maximum": 4},
                "images": {"type": "array"},
                "tikz": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "assets": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  },
  "additionalProperties": true
}
