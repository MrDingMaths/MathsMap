                    "children": [
                      {
                        "id": "p2-investigation-a",
                        "type": "part",
                        "label": "a",
                        "prompt": "In which figures are the diagonals of equal length?",
                        "answerSpaceMm": 12,
                        "answer": {
                          "short": "The rectangle.",
                          "worked": "Draw both diagonals in each accurate construction and measure their lengths. The rectangle's diagonals have equal length; those of a general parallelogram or rhombus need not.",
                          "provenance": {
                            "short": "authored",
                            "worked": "authored"
                          }
                        }
                      },
                      {
                        "id": "p2-investigation-b",
                        "type": "part",
                        "label": "b",
                        "prompt": "In which figures do the diagonals bisect each other?",
                        "answerSpaceMm": 18,
                        "answer": {
                          "short": "The parallelogram, rhombus and rectangle.",
                          "worked": "Mark the intersection of the diagonals in each accurate construction. Measure the two sections of each diagonal. Each diagonal is divided into two equal lengths in all three figures.",
                          "provenance": {
                            "short": "authored",
                            "worked": "authored"
                          }
                        }
                      },
                      {
                        "id": "p2-investigation-c",
                        "type": "part",
                        "label": "c",
                        "prompt": "In which figures do the diagonals meet at right angles to each other?",
                        "answerSpaceMm": 12,
                        "answer": {
                          "short": "The rhombus.",
                          "worked": "Measure an angle between the diagonals in each accurate construction. In the rhombus it is $90^{\\circ}$; a general parallelogram or rectangle need not have perpendicular diagonals.",
                          "provenance": {
                            "short": "authored",
                            "worked": "authored"
                          }
                        }
                      },
                      {
                        "id": "p2-investigation-d",
                        "type": "part",
                        "label": "d",
                        "prompt": "A square is a quadrilateral that is both a rectangle and a rhombus. What properties do its diagonals have?",
                        "answerSpaceMm": 24,
                        "answer": {
                          "short": "They are equal in length and bisect each other at right angles.",
                          "worked": "As a rectangle, a square has equal diagonals that bisect each other. As a rhombus, it has diagonals that meet at right angles. Therefore its diagonals are equal in length and bisect each other at $90^{\\circ}$.",
                          "provenance": {
                            "short": "authored",
                            "worked": "authored"
                          }
                        }
                      }
                    ]
                  }
                ]
