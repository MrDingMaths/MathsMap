                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "text",
                    "text": "MA4-DAT-C-01",
                    "marks": [
                      "bold"
                    ]
                  },
                  {
                    "type": "text",
                    "text": " classifies and displays data using a variety of graphical representations"
                  }
                ]
              },
              {
                "id": "p2-syllabus-focus",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "text",
                    "text": "Display data using graphical representations relevant to the purpose of the data",
                    "marks": [
                      "bold"
                    ]
                  }
                ]
              },
              {
                "id": "p2-syllabus-list",
                "type": "list",
                "ordered": false,
                "indent": 7,
                "items": [
                  {
                    "id": "p2-syllabus-bullet-1",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "p2-syllabus-bullet-1-text",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Represent single datasets using graphs, including frequency histograms and polygons, dot plots, stem-and-leaf plots, divided bar graphs, column graphs, line graphs, sector graphs and pictograms, with or without digital tools"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p2-syllabus-bullet-2",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "p2-syllabus-bullet-2-text",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Include sources, titles, labels and scales when displaying data in a graph"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p2-syllabus-bullet-3",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "p2-syllabus-bullet-3-text",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Select the type of graph best suited to represent various single datasets and justify the choice of graph"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p2-syllabus-bullet-4",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "p2-syllabus-bullet-4-text",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Represent a dataset using a statistical infographic and justify the choice of graphical representation used"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
