      "sourcePageNumber": 2,
      "blocks": [
        {
          "id": "data-classification--p2-syllabus",
          "type": "rich-text",
          "content": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "data-classification--p2-outcome",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "text",
                    "text": "MA4-DAT-C-01 ",
                    "marks": [
                      "bold"
                    ]
                  },
                  {
                    "type": "text",
                    "text": "classifies and displays data using a variety of graphical representations"
                  }
                ]
              },
              {
                "id": "data-classification--p2-content-heading",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "text",
                    "text": "Classify data as either numerical (discrete or continuous) or categorical (nominal or ordinal) variables",
                    "marks": [
                      "bold"
                    ]
                  }
                ]
              },
              {
                "id": "data-classification--p2-content-bullets",
                "type": "list",
                "ordered": false,
                "indent": 7,
                "items": [
                  {
                    "id": "data-classification--p2-content-bullets-item-1",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "data-classification--p2-content-bullets-paragraph-1",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Define a variable in the context of statistics as any characteristic, number or quantity that can be measured or counted"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "data-classification--p2-content-bullets-item-2",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "data-classification--p2-content-bullets-paragraph-2",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Classify and describe variables as numerical or categorical"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "data-classification--p2-content-bullets-item-3",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "data-classification--p2-content-bullets-paragraph-3",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Describe a numerical variable as either discrete or continuous"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "data-classification--p2-content-bullets-item-4",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "data-classification--p2-content-bullets-paragraph-4",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Describe a categorical variable as nominal or ordinal"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "data-classification--p2-content-bullets-item-5",
                    "type": "list-item",
                    "blocks": [
                      {
                        "id": "data-classification--p2-content-bullets-paragraph-5",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Distinguish between and compare numerical (discrete or continuous) and categorical (nominal or ordinal) variables"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
