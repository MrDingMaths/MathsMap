                ],
                "reasoningScore": 78,
                "difficulty": "Mastery",
                "difficultyReason": "Simplify sums and differences of powers before solving; the final part requires quadratic factorisation."
              },
              "content": {
                "id": "p33-q9",
                "type": "question",
                "label": "9",
                "prompt": "Solve",
                "layout": "grid",
                "columns": 3,
                "children": [
                  {
                    "id": "p33-q9-a",
                    "type": "part",
                    "label": "a",
                    "prompt": "$8^x=2^{x+3}+2^{x+3}$",
                    "answerSpaceMm": 38,
                    "answer": {
                      "short": "$x=2$",
                      "worked": "$$\\begin{align*}2^{3x}&=2\\times2^{x+3}\\\\2^{3x}&=2^{x+4}\\\\3x&=x+4\\\\2x&=4\\\\x&=2\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p33-q9-b",
                    "type": "part",
                    "label": "b",
                    "prompt": "$32^x=2^{x+5}-2^{x+4}$",
                    "answerSpaceMm": 46,
                    "answer": {
                      "short": "$x=1$",
                      "worked": "$$\\begin{align*}2^{5x}&=2^{x+4}(2-1)\\\\2^{5x}&=2^{x+4}\\\\5x&=x+4\\\\4x&=4\\\\x&=1\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p33-q9-c",
                    "type": "part",
                    "label": "c",
                    "prompt": "$4^x-2^{x+1}-8=0$",
                    "answerSpaceMm": 62,
                    "answer": {
                      "short": "$x=2$; factorise as $(2^x-4)(2^x+2)=0$ and use $2^x>0$.",
                      "worked": "$$\\begin{align*}(2^x)^2-2(2^x)-8&=0\\\\(2^x-4)(2^x+2)&=0\\end{align*}$$\nSince $2^x>0$, $2^x+2$ cannot be zero.\n$$\\begin{align*}2^x&=4\\\\2^x&=2^2\\\\x&=2\\end{align*}$$",
                      "provenance": {
                        "short": "authored",
                        "worked": "authored"
                      }
                    }
                  }
                ]
              },
              "sourceReview": {
                "teachingContext": [
