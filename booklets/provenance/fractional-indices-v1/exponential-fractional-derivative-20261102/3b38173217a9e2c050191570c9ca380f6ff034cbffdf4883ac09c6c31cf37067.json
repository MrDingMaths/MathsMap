            {
              "id": "p33-q8-block",
              "type": "question",
              "sourceOrder": 8,
              "sourcePageNumber": 33,
              "sourceRefs": [
                {
                  "pageNumber": 33
                }
              ],
              "classification": {
                "primarySkillId": "factorise-index-expressions",
                "secondarySkillIds": [],
                "reasoningScore": 65,
                "difficulty": "Mastery",
                "difficultyReason": "Recognise squared powers and combine common-factor extraction with difference of squares."
              },
              "content": {
                "id": "p33-q8",
                "type": "question",
                "label": "8",
                "prompt": "Factorise: (hint: difference of two squares)",
                "layout": "grid",
                "columns": 2,
                "children": [
                  {
                    "id": "p33-q8-a",
                    "type": "part",
                    "label": "a",
                    "prompt": "$5^{2x}-2^{2y}$",
                    "answerSpaceMm": 22,
                    "answer": {
                      "short": "$(5^x+2^y)(5^x-2^y)$",
                      "worked": "$$\\begin{align*}5^{2x}-2^{2y}&=(5^x)^2-(2^y)^2\\\\&=(5^x+2^y)(5^x-2^y)\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p33-q8-b",
                    "type": "part",
                    "label": "b",
                    "prompt": "$2^{4x}-2^{6x}$",
                    "answerSpaceMm": 30,
                    "answer": {
                      "short": "$2^{4x}(1+2^x)(1-2^x)$",
                      "worked": "$$\\begin{align*}2^{4x}-2^{6x}&=2^{4x}(1-2^{2x})\\\\&=2^{4x}\\bigl(1^2-(2^x)^2\\bigr)\\\\&=2^{4x}(1+2^x)(1-2^x)\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  }
                ]
              },
              "sourceReview": {
                "teachingContext": [
                  {
                    "pageNumber": 28
                  },
                  {
                    "pageNumber": 29
                  }
                ],
                "taughtMethod": "Take out a common power where needed, then apply the supplied difference-of-squares hint.",
                "responses": [
