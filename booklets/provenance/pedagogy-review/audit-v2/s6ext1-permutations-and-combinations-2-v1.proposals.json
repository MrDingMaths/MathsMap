      "content": {
       "id": "v2-ab1d0-p48-practice-j4-132537-root",
       "type": "question",
       "label": null,
       "prompt": "Seven people sit around a round table. Two of them, Ana and Ben, do not want to sit together.",
       "children": [
        {
         "id": "v2-ab1d0-p48-practice-j4-132537-j4-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Find the number of arrangements with no restrictions.",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$720$",
          "worked": "$$\\begin{align*}N&=(7-1)!\\\\&=6!\\\\&=720\\end{align*}$$"
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-ab1d0-p48-practice-j4-132537-j4-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Find the number of arrangements in which Ana and Ben sit together.",
         "answerSpaceMm": 40,
         "answer": {
          "short": "$240$",
          "worked": "Treat Ana and Ben as one block, giving 6 units around the circle. The two can be ordered in $2$ ways within the block.\n$$\\begin{align*}N&=(6-1)!\\times2\\\\&=120\\times2\\\\&=240\\end{align*}$$"
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-ab1d0-p48-practice-j4-132537-j4-q-c",
         "type": "part",
         "label": "c",
         "prompt": "Hence find the number of arrangements in which Ana and Ben do not sit together.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$480$",
          "worked": "Subtract the arrangements where they sit together from the total.\n$$\\begin{align*}N&=720-240\\\\&=480\\end{align*}$$"
         },
         "questionDiagrams": []
        }
       ],
       "questionDiagrams": []
      },
