       "title": "",
       "content": {
        "id": "v2-proposal-j2-024412-root",
        "type": "question",
        "label": null,
        "prompt": "Show whether each function is even or odd.",
        "children": [
         {
          "id": "v2-proposal-j2-024412-j2-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$f(x)=x^4-5x^2+1$",
          "answerSpaceMm": 30,
          "answer": {
           "short": "Even, since $f(-x)=f(x)$.",
           "worked": "$$\\begin{align*}f(-x)&=(-x)^4-5(-x)^2+1\\\\&=x^4-5x^2+1\\\\&=f(x)\\end{align*}$$ So $f(x)$ is even."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j2-024412-j2-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$f(x)=x^5+2x$",
          "answerSpaceMm": 30,
          "answer": {
           "short": "Odd, since $f(-x)=-f(x)$.",
           "worked": "$$\\begin{align*}f(-x)&=(-x)^5+2(-x)\\\\&=-x^5-2x\\\\&=-(x^5+2x)\\\\&=-f(x)\\end{align*}$$ So $f(x)$ is odd."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j2-024412-j2-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$f(x)=\\dfrac{x}{x^2+1}$",
          "answerSpaceMm": 30,
          "answer": {
           "short": "Odd, since $f(-x)=-f(x)$.",
           "worked": "$$\\begin{align*}f(-x)&=\\frac{-x}{(-x)^2+1}\\\\&=\\frac{-x}{x^2+1}\\\\&=-f(x)\\end{align*}$$ So $f(x)$ is odd."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j2-024412-j2-gp-d",
          "type": "part",
          "label": "d",
          "prompt": "$f(x)=2^x+2^{-x}$",
          "answerSpaceMm": 30,
          "answer": {
           "short": "Even, since $f(-x)=f(x)$.",
           "worked": "$$\\begin{align*}f(-x)&=2^{-x}+2^{-(-x)}\\\\&=2^{-x}+2^x\\\\&=f(x)\\end{align*}$$ So $f(x)$ is even."
          },
          "questionDiagrams": []
         }
        ],
        "answer": null,
