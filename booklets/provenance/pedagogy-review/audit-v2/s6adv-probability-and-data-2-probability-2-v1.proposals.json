        "type": "question",
        "label": null,
        "prompt": "In a class of 30 students, $L$ is the event that a student learns a language and $F$ is the event that a student learns French. The Venn diagram shows the number of students in each region. A student is chosen at random. Find:",
        "children": [
         {
          "id": "v2-proposal-j4-075938-j4-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$P(F\\cap L)$",
          "answerSpaceMm": 20,
          "answer": {
           "short": "$\\dfrac{7}{30}$",
           "worked": "$F\\subset L$, so $F\\cap L=F$.\n$$P(F\\cap L)=P(F)=\\frac{7}{30}$$"
          }
         },
         {
          "id": "v2-proposal-j4-075938-j4-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$P(F\\cup L)$",
          "answerSpaceMm": 20,
          "answer": {
           "short": "$\\dfrac{8}{15}$",
           "worked": "$F\\subset L$, so $F\\cup L=L$.\n$$\\begin{align*}P(F\\cup L)&=P(L)=\\frac{9+7}{30}\\\\&=\\frac{8}{15}\\end{align*}$$"
          }
         },
         {
          "id": "v2-proposal-j4-075938-j4-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$P(L\\cap\\bar F)$",
          "answerSpaceMm": 20,
          "answer": {
           "short": "$\\dfrac{3}{10}$",
           "worked": "$L\\cap\\bar F$ is the part of $L$ outside $F$.\n$$P(L\\cap\\bar F)=\\frac{9}{30}=\\frac{3}{10}$$"
          }
         }
        ],
