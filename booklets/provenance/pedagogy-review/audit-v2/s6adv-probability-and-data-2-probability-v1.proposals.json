   "payloads": [
    {
     "op": "theory",
     "blockId": "p4-probability",
     "replacement": "If all outcomes in $S$ are equally likely, the probability of a single outcome is $\\frac{1}{|S|}$.\n\nFor an event $E$, when all outcomes are equally likely, $P(E)=\\frac{|E|}{|S|}$.\n\nHere $|E|$ and $|S|$ are the numbers of elements in $E$ and $S$, respectively.\n\n⚠ If the outcomes are not equally likely, redefine the sample space using equally likely outcomes before applying this counting formula.\n\n⚠ The probabilities of all possible outcomes must sum to 1.",
     "autoApply": true,
     "key": "theory|p4-probability",
     "targetFingerprint": "68f290726fb13d66a40b927a263fc3588e3791bdc8b12dca66456fde608789cb",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-probability-and-data-2-probability-v1/20261111-080313",
