       "content": {
        "id": "v2-proposal-j7-080313-root",
        "type": "question",
        "label": null,
        "prompt": "Bag A contains 2 red and 3 blue marbles. Bag B contains 4 red and 2 blue marbles.\nA bag is chosen at random by tossing a coin, and one marble is drawn from it.",
        "children": [
         {
          "id": "v2-proposal-j7-080313-j7-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "Find the probability that the marble is red.",
          "answerSpaceMm": 30,
          "answer": {
           "short": "$\\frac{8}{15}$",
           "worked": "$$\\begin{align*}P(\\text{red})&=P(A,R)+P(B,R)\\\\&=\\frac{1}{2}\\times\\frac{2}{5}+\\frac{1}{2}\\times\\frac{4}{6}\\\\&=\\frac{1}{5}+\\frac{1}{3}\\\\&=\\frac{8}{15}\\end{align*}$$"
          }
         },
         {
          "id": "v2-proposal-j7-080313-j7-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "Now suppose that Bag A is chosen with probability $\\frac14$ and Bag B with probability $\\frac34$. Find the probability that the marble is red.",
          "answerSpaceMm": 30,
          "answer": {
           "short": "$\\frac{3}{5}$",
           "worked": "$$\\begin{align*}P(\\text{red})&=P(A,R)+P(B,R)\\\\&=\\frac{1}{4}\\times\\frac{2}{5}+\\frac{3}{4}\\times\\frac{4}{6}\\\\&=\\frac{1}{10}+\\frac{1}{2}\\\\&=\\frac{3}{5}\\end{align*}$$"
          }
         },
         {
          "id": "v2-proposal-j7-080313-j7-gp-c",
          "type": "part",
          "label": "c",
          "prompt": {
           "format": "maths-editor-document-v1",
           "version": 1,
           "blocks": [
            {
             "id": "v2-proposal-j7-080313-j7-gp-c-d1",
             "type": "paragraph",
             "fontSize": null,
             "align": "left",
             "spaceBefore": 0,
             "spaceAfter": 2,
             "lineHeight": 1.4,
             "indent": 0,
             "inlines": [
              {
               "type": "text",
               "text": "With the probabilities in part ",
               "marks": []
              },
              {
               "type": "text",
               "text": "b",
               "marks": [
                "bold"
               ]
              },
              {
               "type": "text",
               "text": ", find the probability that the marble is blue.",
               "marks": []
              }
             ]
            }
           ]
          },
          "answerSpaceMm": 30,
          "answer": {
           "short": "$\\frac{2}{5}$",
           "worked": "$$\\begin{align*}P(\\text{blue})&=P(A,B)+P(B,B)\\\\&=\\frac{1}{4}\\times\\frac{3}{5}+\\frac{3}{4}\\times\\frac{2}{6}\\\\&=\\frac{3}{20}+\\frac{1}{4}\\\\&=\\frac{2}{5}\\end{align*}$$"
          }
         }
        ]
