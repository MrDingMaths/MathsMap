    "content": {
     "id": "v2-proposal-j18-085704-root",
     "type": "question",
     "label": null,
     "prompt": "A scooter costs $\\$640$.",
     "children": [
      {
       "id": "v2-proposal-j18-085704-j18-q-a",
       "type": "part",
       "label": "a",
       "prompt": "Find 15% of $\\$640$.",
       "answerSpaceMm": 20,
       "answer": {
        "short": "$\\$96$",
        "worked": "$$\\begin{align*}15\\%\\text{ of }640&=0.15\\times640\\\\&=96\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j18-085704-j18-q-b",
       "type": "part",
       "label": "b",
       "prompt": "The price of the scooter decreases by 15%. What is the new price?",
       "answerSpaceMm": 25,
       "answer": {
        "short": "$\\$544$",
        "worked": "$$\\begin{align*}\\text{Multiplier}&=1-0.15=0.85\\\\\\text{New price}&=640\\times0.85\\\\&=544\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j18-085704-j18-q-c",
       "type": "part",
       "label": "c",
       "prompt": "Mia sells the scooter for $\\$800$. What is her percentage profit?",
       "answerSpaceMm": 30,
       "answer": {
        "short": "25%",
        "worked": "$$\\begin{align*}\\text{Profit}&=800-640=160\\\\\\text{Percentage profit}&=\\frac{160}{640}\\times100\\%\\\\&=25\\%\\end{align*}$$"
       }
      }
     ],
     "questionDiagrams": []
