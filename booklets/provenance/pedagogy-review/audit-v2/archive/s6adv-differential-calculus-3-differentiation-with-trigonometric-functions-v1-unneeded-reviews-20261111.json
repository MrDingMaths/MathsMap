     "type": "question",
     "label": null,
     "prompt": "Find the equation of the normal to $y=x^2$ at the point $(2,4)$ in general form.",
     "answer": {
      "short": "$x+4y-18=0$",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x\\\\m_T&=4\\\\m_N&=-\\frac14\\\\y-4&=-\\frac14(x-2)\\\\4y-16&=-x+2\\\\x+4y-18&=0\\end{align*}$$"
     },
