       "answerSpaceMm": 12,
       "answer": {
        "short": "$20\\pi\\text{ m}$",
        "worked": "$$\\begin{align*}C&=2\\pi(10)\\\\C&=20\\pi\\text{ m}\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j11-021351-j11-q-c",
       "type": "part",
       "label": "c",
       "prompt": "$r=1.5\\text{ mm}$",
       "answerSpaceMm": 12,
       "answer": {
        "short": "$3\\pi\\text{ mm}$",
        "worked": "$$\\begin{align*}C&=2\\pi(1.5)\\\\C&=3\\pi\\text{ mm}\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j11-021351-j11-q-d",
       "type": "part",
       "label": "d",
       "prompt": "$r=\\dfrac{3}{4}\\text{ cm}$",
       "answerSpaceMm": 12,
       "answer": {
        "short": "$\\dfrac{3\\pi}{2}\\text{ cm}$",
        "worked": "$$\\begin{align*}C&=2\\pi\\left(\\tfrac34\\right)\\\\C&=\\frac{3\\pi}{2}\\text{ cm}\\end{align*}$$"
       }
      }
