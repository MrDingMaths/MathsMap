     "prompt": "Calculate the circumference of each circle in terms of $\\pi$, using $C=2\\pi r$.",
     "children": [
      {
       "id": "v2-proposal-j11-021351-j11-q-a",
       "type": "part",
       "label": "a",
       "prompt": "$r=4\\text{ cm}$",
       "answerSpaceMm": 12,
       "answer": {
        "short": "$8\\pi\\text{ cm}$",
        "worked": "$$\\begin{align*}C&=2\\pi(4)\\\\C&=8\\pi\\text{ cm}\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j11-021351-j11-q-b",
       "type": "part",
