     "id": "v2-proposal-j13-211127-root",
     "type": "question",
     "label": null,
     "prompt": "A normal distribution has mean 120 and standard deviation 15. Find the $z$-score of:",
     "children": [
      {
       "id": "v2-proposal-j13-211127-j13-q-a",
       "type": "part",
       "label": "a",
       "prompt": "$x=135$",
       "answerSpaceMm": 18,
       "answer": {
        "short": "$z=1$",
        "worked": "$$\\begin{align*}z&=\\frac{x-\\mu}{\\sigma}\\\\&=\\frac{135-120}{15}\\\\&=1\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j13-211127-j13-q-b",
       "type": "part",
       "label": "b",
       "prompt": "$x=90$",
       "answerSpaceMm": 18,
       "answer": {
        "short": "$z=-2$",
        "worked": "$$\\begin{align*}z&=\\frac{x-\\mu}{\\sigma}\\\\&=\\frac{90-120}{15}\\\\&=-2\\end{align*}$$"
       }
      }
     ],
