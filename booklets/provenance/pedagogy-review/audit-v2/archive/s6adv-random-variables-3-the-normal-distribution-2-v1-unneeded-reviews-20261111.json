     "type": "question",
     "label": null,
     "prompt": "The probability that a student at a school travels by train is $0.16$. How many students would you expect to travel by train in a year group of 250?",
     "answer": {
      "short": "40 students",
      "worked": "$$\\begin{align*}\\text{Expected number}&=n\\times P\\\\&=250\\times0.16\\\\&=40\\end{align*}$$"
     },
