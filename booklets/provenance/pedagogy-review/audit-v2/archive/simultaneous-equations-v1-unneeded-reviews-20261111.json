       "type": "part",
       "label": "a",
       "prompt": "A taxi charges $\\$4$ plus $\\$2$ per kilometre. Find a rule for the cost $\\$C$ of a trip of $d$ kilometres.",
       "answerSpaceMm": 20,
       "answer": {
        "short": "$C=4+2d$",
        "worked": "$$\\begin{align*}C&=\\text{fixed amount}+\\text{rate}\\times d\\\\C&=4+2d\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j11-104354-j11-q-b",
       "type": "part",
       "label": "b",
       "prompt": "A water tank holds $800$ L and drains at $25$ L per minute. Find a rule for the volume $V$ litres in the tank after $t$ minutes.",
       "answerSpaceMm": 20,
       "answer": {
        "short": "$V=800-25t$",
        "worked": "$$\\begin{align*}V&=\\text{starting value}-\\text{rate}\\times t\\\\V&=800-25t\\end{align*}$$"
       }
      }
