       "answerSpaceMm": 18,
       "answer": {
        "short": "$x=0$ or $x=-4$",
        "worked": "$$\\begin{align*}x^2+4x&=0\\\\x(x+4)&=0\\\\x&=0\\ \\text{or}\\ x=-4\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j6-224300-j6-q-c",
       "type": "part",
