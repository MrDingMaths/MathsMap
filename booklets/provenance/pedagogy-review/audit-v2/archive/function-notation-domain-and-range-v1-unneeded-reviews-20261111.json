       "answerSpaceMm": 16,
       "answer": {
        "short": "$a^2+8a+16$",
        "worked": "$$\\begin{align*}(a+4)^2&=a^2+2(a)(4)+4^2\\\\&=a^2+8a+16\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j5-224300-j5-q-b",
       "type": "part",
       "label": "b",
       "prompt": "$(a-6)^2$",
       "answerSpaceMm": 16,
       "answer": {
        "short": "$a^2-12a+36$",
        "worked": "$$\\begin{align*}(a-6)^2&=a^2-2(a)(6)+6^2\\\\&=a^2-12a+36\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j5-224300-j5-q-c",
       "type": "part",
       "label": "c",
       "prompt": "$(3a+2)^2$",
       "answerSpaceMm": 16,
       "answer": {
        "short": "$9a^2+12a+4$",
        "worked": "$$\\begin{align*}(3a+2)^2&=(3a)^2+2(3a)(2)+2^2\\\\&=9a^2+12a+4\\end{align*}$$"
       }
      }
     ],
