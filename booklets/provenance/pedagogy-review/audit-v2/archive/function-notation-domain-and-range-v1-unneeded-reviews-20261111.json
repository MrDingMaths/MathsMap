     "id": "v2-proposal-j8-224300-root",
     "type": "question",
     "label": null,
     "prompt": "Find the values that $\\dfrac{1}{u}$ can take.",
     "children": [
      {
       "id": "v2-proposal-j8-224300-j8-q-a",
       "type": "part",
       "label": "a",
       "prompt": "$0<u\\le5$",
       "answerSpaceMm": 15,
       "answer": {
        "short": "$\\dfrac1u\\ge\\dfrac15$",
        "worked": "$$\\begin{align*}0<u&\\le5\\\\\\frac1u&\\ge\\frac15\\end{align*}$$ Taking reciprocals of positive numbers reverses the inequality."
       }
      },
      {
       "id": "v2-proposal-j8-224300-j8-q-b",
       "type": "part",
       "label": "b",
       "prompt": "$0<u\\le\\dfrac13$",
       "answerSpaceMm": 15,
       "answer": {
        "short": "$\\dfrac1u\\ge3$",
        "worked": "$$\\begin{align*}0<u&\\le\\frac13\\\\\\frac1u&\\ge3\\end{align*}$$ Taking reciprocals of positive numbers reverses the inequality."
       }
      },
      {
       "id": "v2-proposal-j8-224300-j8-q-c",
       "type": "part",
       "label": "c",
       "prompt": "$2\\le u\\le4$",
       "answerSpaceMm": 15,
       "answer": {
        "short": "$\\dfrac14\\le\\dfrac1u\\le\\dfrac12$",
        "worked": "$$\\begin{align*}2\\le u&\\le4\\\\\\frac14\\le\\frac1u&\\le\\frac12\\end{align*}$$ Taking reciprocals of positive numbers reverses the inequalities."
       }
      }
     ],
