       "format": "tikz",
       "widthMm": 55,
       "code": "\\begin{tikzpicture}[scale=1,>=stealth]\n\\definecolor{houseblueFill}{HTML}{D4E8FF}\n\\fill[houseblueFill] (0,0)--(4,0)--(4,2)--cycle;\n\\draw[thick] (0,0)--(4,0)--(4,4)--(0,4)--cycle;\n\\draw[thick] (0,0)--(4,2);\n\\draw (3.65,0)--(3.65,0.35)--(4,0.35);\n\\draw (3.9,0.95)--(4.1,1.05);\n\\draw (3.9,2.95)--(4.1,3.05);\n\\node[below left] at (0,0) {$A$};\n\\node[below right] at (4,0) {$B$};\n\\node[above right] at (4,4) {$C$};\n\\node[above left] at (0,4) {$D$};\n\\node[right] at (4.1,2) {$E$};\n\\node[below] at (2,-0.05) {$10\\text{ cm}$};\n\\node[left,font=\\small] at (-0.05,2) {$10\\text{ cm}$};\n\\node[right,font=\\small] at (4.1,1) {$5\\text{ cm}$};\n\\node[right,font=\\small] at (4.1,3) {$5\\text{ cm}$};\n\\end{tikzpicture}"
