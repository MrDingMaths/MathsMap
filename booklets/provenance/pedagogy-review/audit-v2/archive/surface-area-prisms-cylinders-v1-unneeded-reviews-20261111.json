       "answer": {
        "short": "$49\\pi\\text{ cm}^2$",
        "worked": "$$\\begin{align*}A&=\\pi r^2\\\\&=\\pi(7)^2\\\\&=49\\pi\\text{ cm}^2\\end{align*}$$"
       }
      },
