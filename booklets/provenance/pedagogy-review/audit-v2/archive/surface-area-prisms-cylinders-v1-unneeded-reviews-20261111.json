         "format": "tikz",
         "widthMm": 30,
         "code": "\\begin{tikzpicture}[line width=0.8pt]\n\\draw (0,0) circle (1);\n\\draw[<->,line width=0.5pt] (-1,0)--(1,0);\n\\node[above] at (0,0) {$10\\text{ m}$};\n\\end{tikzpicture}"
        }
       ],
       "answer": {
        "short": "$78.5\\text{ m}^2$",
        "worked": "$$\\begin{align*}r&=10\\div2=5\\text{ m}\\\\A&=\\pi r^2\\\\&=\\pi(5)^2\\\\&=25\\pi\\\\&\\approx78.5\\text{ m}^2\\end{align*}$$"
       }
      }
