       "label": "a",
       "prompt": "Leave your answer in terms of $\\pi$.",
       "answerSpaceMm": 25,
       "questionDiagrams": [
        {
         "id": "v2-proposal-j12-212252-j12-q-a-diagram",
         "format": "tikz",
         "widthMm": 30,
         "code": "\\begin{tikzpicture}[line width=0.8pt]\n\\draw (0,0) circle (1);\n\\fill (0,0) circle (1pt);\n\\draw (0,0)--(1,0) node[midway,above] {$7\\text{ cm}$};\n\\end{tikzpicture}"
