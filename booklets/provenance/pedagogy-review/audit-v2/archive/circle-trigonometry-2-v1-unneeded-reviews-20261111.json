     "id": "v2-proposal-j18-215016-root",
     "type": "question",
     "label": null,
     "prompt": "Consider the points $A(-1,1)$ and $B(5,9)$.",
     "children": [
      {
       "id": "v2-proposal-j18-215016-j18-q-a",
       "type": "part",
       "label": "a",
       "prompt": "Find the gradient of $AB$.",
       "answerSpaceMm": 14,
       "answer": {
        "short": "$\\dfrac43$",
        "worked": "$$\\begin{align*}m&=\\frac{9-1}{5-(-1)}=\\frac86=\\frac43\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j18-215016-j18-q-b",
       "type": "part",
       "label": "b",
       "prompt": "Find the midpoint of $AB$.",
       "answerSpaceMm": 14,
       "answer": {
        "short": "$(2,5)$",
        "worked": "$$\\begin{align*}M&=\\left(\\frac{-1+5}{2},\\frac{1+9}{2}\\right)=(2,5)\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j18-215016-j18-q-c",
       "type": "part",
       "label": "c",
       "prompt": "Find the length of $AB$.",
       "answerSpaceMm": 14,
       "answer": {
        "short": "$10$",
        "worked": "$$\\begin{align*}AB&=\\sqrt{(5-(-1))^2+(9-1)^2}\\\\&=\\sqrt{36+64}=10\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j18-215016-j18-q-d",
       "type": "part",
       "label": "d",
       "prompt": "Find the gradient of a line perpendicular to $AB$.",
       "answerSpaceMm": 14,
       "answer": {
        "short": "$-\\dfrac34$",
        "worked": "$$\\begin{align*}\\frac43\\times m&=-1\\\\m&=-\\frac34\\end{align*}$$"
       }
      }
     ],
