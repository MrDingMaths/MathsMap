    "content": {
     "id": "v2-proposal-j9-023542-root",
     "type": "question",
     "label": null,
     "prompt": "Recall factorising quadratics and the null factor law",
     "children": [
      {
       "id": "v2-proposal-j9-023542-j9-prereq-a",
       "type": "part",
       "label": "a",
       "prompt": "Factorise $2u^2-3u-2$",
       "answerSpaceMm": 30,
       "answer": {
        "short": "$(2u+1)(u-2)$",
        "worked": "$$\\begin{align*}P&=2\\times(-2)=-4\\\\S&=-3\\\\F&=-4,\\ 1\\\\2u^2-3u-2&=2u^2-4u+u-2\\\\&=2u(u-2)+(u-2)\\\\&=(2u+1)(u-2)\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j9-023542-j9-prereq-b",
       "type": "part",
       "label": "b",
       "prompt": "Solve $3u^2+u-2=0$",
       "answerSpaceMm": 35,
       "answer": {
        "short": "$u=\\dfrac{2}{3}$ or $u=-1$",
        "worked": "$$\\begin{align*}P&=3\\times(-2)=-6\\\\S&=1\\\\F&=3,\\ -2\\\\3u^2+3u-2u-2&=0\\\\3u(u+1)-2(u+1)&=0\\\\(3u-2)(u+1)&=0\\end{align*}$$\nBy the null factor law:\n$$\\begin{align*}3u-2&=0\\quad\\text{or}\\quad u+1=0\\\\u&=\\frac{2}{3}\\quad\\text{or}\\quad u=-1\\end{align*}$$"
       }
      }
     ],
