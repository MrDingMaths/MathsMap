       "type": "part",
       "label": "a",
       "prompt": "Use log laws to write $\\ln\\left(\\dfrac{x^3(2x+1)}{x-4}\\right)$ as a sum and difference of logarithms.",
       "answerSpaceMm": 35,
       "answer": {
        "short": "$3\\ln x+\\ln(2x+1)-\\ln(x-4)$.",
        "worked": "$$\\begin{align*}\\ln\\left(\\frac{x^3(2x+1)}{x-4}\\right)&=\\ln x^3+\\ln(2x+1)-\\ln(x-4)\\\\&=3\\ln x+\\ln(2x+1)-\\ln(x-4).\\end{align*}$$"
       }
      },
      {
       "id": "v2-proposal-j11-034812-j11-b",
       "type": "part",
       "label": "b",
       "prompt": "Simplify $\\sin^4x+\\sin^2x\\cos^2x$.",
       "answerSpaceMm": 35,
       "answer": {
        "short": "$\\sin^2x$.",
        "worked": "$$\\begin{align*}\\sin^4x+\\sin^2x\\cos^2x&=\\sin^2x(\\sin^2x+\\cos^2x)\\\\&=\\sin^2x.\\end{align*}$$"
       }
      }
     ]
