 "comments": {
  "6fdec6f8-a0bd-4f08-ade2-ab621952c87d": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p7-angle-definition",
     "replacement": "By rearranging the geometric dot product formula, for nonzero vectors $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$:\n\n$$\\cos\\theta=\\frac{\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}}{|\\underset{\\sim}{a}||\\underset{\\sim}{b}|}$$\n\n1. Calculate $\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}$ using the algebraic dot product formula: $x_1x_2+y_1y_2$\n2. Calculate $|\\underset{\\sim}{a}|$ and $|\\underset{\\sim}{b}|$ using: $\\sqrt{x^2+y^2}$\n3. Use the formula above to find $\\theta$.",
     "autoApply": true,
     "key": "theory|p7-angle-definition",
     "targetFingerprint": "a66dea1228114d46167cccb944636df0f59c378b6665ad4180e04184f2a97723",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6ext1-2-further-operations-with-vectors-v1/20261111-121852",
