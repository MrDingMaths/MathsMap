       "content": {
        "id": "v2-proposal-j2-034116-root",
        "type": "question",
        "label": null,
        "prompt": "Find $k$ in each case.",
        "children": [
         {
          "id": "v2-proposal-j2-034116-j2-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "The concentration $C$ mg/L of a drug in the bloodstream after $t$ hours is $C=Ae^{kt}$. The half-life of the drug is 4 hours. Find the exact value of $k$.",
          "answerSpaceMm": 40,
          "answer": {
           "short": "$k=-\\dfrac{\\ln2}{4}$",
           "worked": "$$\\begin{align*}\\frac{A}{2}&=Ae^{4k}\\\\\\frac{1}{2}&=e^{4k}\\\\\\ln\\frac{1}{2}&=4k\\\\k&=-\\frac{\\ln2}{4}\\end{align*}$$"
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j2-034116-j2-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "The mass $M$ of a sample of radium after $t$ years is $M=M_0e^{-kt}$, where $k$ is positive. The half-life of radium is 1600 years. Find $k$, correct to 4 significant figures.",
          "answerSpaceMm": 40,
          "answer": {
           "short": "$k=\\dfrac{\\ln2}{1600}\\approx0.0004332$",
           "worked": "$$\\begin{align*}\\frac{M_0}{2}&=M_0e^{-1600k}\\\\\\frac{1}{2}&=e^{-1600k}\\\\\\ln\\frac{1}{2}&=-1600k\\\\-\\ln2&=-1600k\\\\k&=\\frac{\\ln2}{1600}\\approx0.0004332\\end{align*}$$"
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j2-034116-j2-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "A 80 mg dose of a drug in the body decays according to $Q=Ae^{kt}$, where $t$ is in hours. The half-life of the drug is 2.5 hours. Find $k$, correct to 3 decimal places.",
          "answerSpaceMm": 40,
          "answer": {
           "short": "$k=-\\dfrac{\\ln2}{2.5}\\approx-0.277$",
           "worked": "$$\\begin{align*}A&=80\\\\40&=80e^{2.5k}\\\\\\frac{1}{2}&=e^{2.5k}\\\\-\\ln2&=2.5k\\\\k&=-\\frac{\\ln2}{2.5}\\approx-0.277\\end{align*}$$"
          },
          "questionDiagrams": []
         }
        ]
