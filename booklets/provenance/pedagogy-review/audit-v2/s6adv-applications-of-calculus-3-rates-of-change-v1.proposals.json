             },
             {
              "type": "math",
              "latex": "\\begin{align*}\\frac{A}{2}&=Ae^{k(8)}\\\\\\frac{1}{2}&=e^{8k}\\quad\\color{#ef6068}{\\div A}\\\\\\ln\\frac{1}{2}&=8k\\quad\\color{#ef6068}{\\text{take }\\ln\\text{ of both sides}}\\\\-\\ln2&=8k\\\\k&=-\\frac{\\ln2}{8}\\end{align*}",
              "display": true,
