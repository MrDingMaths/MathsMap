       "content": {
        "id": "v2-proposal-j1-082555-root",
        "type": "question",
        "label": null,
        "prompt": "Write each sum in sigma notation, starting each sum at $n=1$.",
        "children": [
         {
          "id": "v2-proposal-j1-082555-j1-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$$5+9+13+\\cdots+41$$",
          "answerSpaceMm": 22,
          "answer": {
           "short": "$\\displaystyle\\sum_{n=1}^{10}(4n+1)$",
           "worked": "The terms increase by $4$ and the first term is $5$, so the $n$th term is $4n+1$.\n$$\\begin{align*}4n+1&=41\\\\4n&=40\\\\n&=10\\end{align*}$$\n$$\\sum_{n=1}^{10}(4n+1)$$"
          }
         },
         {
          "id": "v2-proposal-j1-082555-j1-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$$\\frac12+\\frac23+\\frac34+\\cdots+\\frac{20}{21}$$",
          "answerSpaceMm": 22,
          "answer": {
           "short": "$\\displaystyle\\sum_{n=1}^{20}\\frac{n}{n+1}$",
           "worked": "The numerators are $n$ and the denominators are $n+1$, so the $n$th term is $\\frac{n}{n+1}$. The last numerator is $20$, so $n=20$.\n$$\\sum_{n=1}^{20}\\frac{n}{n+1}$$"
          }
         },
         {
          "id": "v2-proposal-j1-082555-j1-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$$-3+6-9+\\cdots+30$$",
          "answerSpaceMm": 22,
          "answer": {
           "short": "$\\displaystyle\\sum_{n=1}^{10}(-1)^n\\,3n$",
           "worked": "The magnitudes are $3n$. The factor $(-1)^n$ is negative for odd $n$ and positive for even $n$, giving the required signs.\n$$\\begin{align*}3n&=30\\\\n&=10\\end{align*}$$\n$$\\sum_{n=1}^{10}(-1)^n\\,3n$$"
          }
         }
        ],
        "layout": "grid",
        "columns": 3
       },
