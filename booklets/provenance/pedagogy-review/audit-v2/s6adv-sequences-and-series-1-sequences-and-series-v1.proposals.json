   "payloads": [
    {
     "op": "theory",
     "blockId": "p3-recursive-definition",
     "replacement": "A **recursive rule**, or **term-to-term rule**, gives each term from the previous term. It also needs the first term $a_1$ to start the sequence.\n\nE.g. $a_n=a_{n-1}+3$ for $n\\geq2$ means: “to get the next term, add 3 to the previous term”.",
     "autoApply": true,
     "key": "theory|p3-recursive-definition",
     "targetFingerprint": "a14c75a8fa9ab697b7d8b0c67a6fe9c6de0559db4fd04507d17d2f9441ee3f68",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-sequences-and-series-1-sequences-and-series-v1/20261111-082555",
   "revision": 15
  },
  "05fb7346-03e6-4e55-85df-d61b302c0612": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p9-series-definition",
     "replacement": "For a sequence $a_1,a_2,a_3,\\ldots$, the **series** is the sum of its terms. If the sequence continues forever, this is an **infinite sum**:\n\n$$a_1+a_2+a_3+\\cdots$$",
     "autoApply": true,
     "key": "theory|p9-series-definition",
     "targetFingerprint": "16a4b8bae530519d6769b48c2abe153982bd006ac9548da3bd2c7c152990d0be",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-sequences-and-series-1-sequences-and-series-v1/20261111-082555",
   "revision": 15
  },
  "59fd7bcd-3cd8-4660-9ca1-7f53b4d5ef0a": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p9-partial-sum-definition",
     "replacement": "The **partial sum** $S_n$ of a series is the sum of its first $n$ terms, where $n$ is a positive integer:\n\n$$S_n=a_1+a_2+a_3+\\cdots+a_n$$",
     "autoApply": true,
     "key": "theory|p9-partial-sum-definition",
     "targetFingerprint": "27f826cdd9148f974e891501f8d3cd43365f9612e503a69f69e431ffeee567af",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-sequences-and-series-1-sequences-and-series-v1/20261111-082555",
   "revision": 15
  },
  "f52737ce-ee32-4efd-bf36-c80122ce62bd": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p10-sigma-definition",
     "replacement": "**Sigma notation** writes the partial sum of a sequence using its $n$th term formula. For integers $i\\le j$:\n\n$$\\sum_{n=i}^{j}a_n=a_i+a_{i+1}+a_{i+2}+\\cdots+a_{j-1}+a_j$$\n\nThis means: for each integer $n$ from $n=i$ to $n=j$, find $a_n$, then add up all these terms.",
     "autoApply": true,
     "key": "theory|p10-sigma-definition",
     "targetFingerprint": "75a9258f02e5f721f555e705f232f215f8c416517028b964380546b441254ce9",
     "applied": true
    }
   ],
