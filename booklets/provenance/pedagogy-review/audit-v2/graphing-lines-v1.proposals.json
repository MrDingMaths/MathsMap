          "type": "part",
          "label": "b",
          "prompt": "A line has gradient $-2$ and passes through the point $(3,1)$.\nFind its equation $y=mx+c$.",
          "answerSpaceMm": 32,
          "answer": {
           "short": "$y=-2x+7$",
           "worked": "$$\\begin{align*}y&=-2x+c\\\\1&=-2(3)+c\\\\1&=-6+c\\\\1\\color{#ef6068}{+6}&=-6+c\\color{#ef6068}{+6}\\\\c&=7\\end{align*}$$\nTherefore $y=-2x+7$."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j4-102831-j4-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "A line has gradient $\\dfrac{1}{2}$ and passes through the point $(6,5)$.\nFind its equation $y=mx+c$.",
          "answerSpaceMm": 32,
          "answer": {
           "short": "$y=\\dfrac{1}{2}x+2$",
           "worked": "$$\\begin{align*}y&=\\tfrac{1}{2}x+c\\\\5&=\\tfrac{1}{2}(6)+c\\\\5&=3+c\\\\5\\color{#ef6068}{-3}&=3+c\\color{#ef6068}{-3}\\\\c&=2\\end{align*}$$\nTherefore $y=\\tfrac{1}{2}x+2$."
          },
          "questionDiagrams": []
