  "de4bf12d-f6ec-47d4-a879-b37005c8978a": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p8-solving-inequalities",
     "replacement": "- A **solution** of an inequality is a value of the pronumeral that makes it true. The **solution set** is all such values.\n  For example, the solutions of $x>3$ include $x=3.1,\\ 4,\\ 792$, but not $3$, $2$ or $-4$. This set has infinitely many values.\n- To solve an inequality, apply inverse operations to both sides, as for equations. Adding, subtracting, multiplying or dividing by a positive number keeps the inequality symbol.\n  1. Isolate the pronumeral.\n  2. Write the pronumeral on the LHS.\n    If you swap LHS and RHS, flip the inequality symbol.",
     "autoApply": true,
     "key": "theory|p8-solving-inequalities",
     "targetFingerprint": "9e1a8bf75cd5b142e03363e0161c9afed7a07f04f9ae3f53155bd8c44cadac6b"
    }
   ],
