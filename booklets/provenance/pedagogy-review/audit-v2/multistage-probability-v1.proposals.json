   "payloads": [
    {
     "op": "theory",
     "blockId": "p5-counting-principle",
     "replacement": "If one step can occur in $m$ ways and, for each of those, a second step can occur in $n$ ways, then the two steps together can occur in $m\\times n$ ways.\n\nFor three or more steps, multiply the number of ways at every step.",
     "autoApply": true,
     "key": "theory|p5-counting-principle",
     "targetFingerprint": "7902e4a61cfc37fc931c0f12a70c51b38a141ad72758b2f83eb746a7e9641f9f",
