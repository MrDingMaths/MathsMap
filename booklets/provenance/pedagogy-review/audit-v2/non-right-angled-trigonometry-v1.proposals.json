         "id": "v2-nr-p10-s1-j2-034218-j2-qa",
         "type": "part",
         "label": "a",
         "prompt": "Find $\\angle BAC$.",
         "answerSpaceMm": 14,
         "answer": {
          "short": "$\\angle BAC=40^\\circ$",
          "worked": "$AC$ is due east, a bearing of $090^\\circ$.\n$$\\begin{align*}\\angle BAC&=90^\\circ-50^\\circ\\\\&=40^\\circ\\end{align*}$$"
         }
        },
        {
         "id": "v2-nr-p10-s1-j2-034218-j2-qb",
         "type": "part",
         "label": "b",
         "prompt": "Find $\\angle ABC$.",
         "answerSpaceMm": 20,
         "answer": {
          "short": "$\\angle ABC=110^\\circ$",
          "worked": "The bearing of $A$ from $B$ is $050^\\circ+180^\\circ=230^\\circ$.\n$$\\begin{align*}\\angle ABC&=230^\\circ-120^\\circ\\\\&=110^\\circ\\end{align*}$$"
         }
        },
        {
         "id": "v2-nr-p10-s1-j2-034218-j2-qc",
         "type": "part",
         "label": "c",
         "prompt": "Hence find $\\angle ACB$.",
         "answerSpaceMm": 16,
         "answer": {
          "short": "$\\angle ACB=30^\\circ$",
          "worked": "$$\\begin{align*}\\angle ACB&=180^\\circ-40^\\circ-110^\\circ\\\\&=30^\\circ\\end{align*}$$"
         }
        },
        {
         "id": "v2-nr-p10-s1-j2-034218-j2-qd",
         "type": "part",
         "label": "d",
         "prompt": "Hence find distance $BC$, to 1 d.p.",
         "answerSpaceMm": 34,
         "answer": {
          "short": "$BC=12.9\\text{ km}$",
          "worked": "$$\\begin{align*}\\frac{BC}{\\sin40^\\circ}&=\\frac{10}{\\sin30^\\circ}\\\\[8pt]BC&=\\frac{10\\sin40^\\circ}{\\sin30^\\circ}\\\\[8pt]BC&\\approx12.9\\text{ km}\\end{align*}$$"
         }
        }
       ],
