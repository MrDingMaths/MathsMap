        "prompt": "Solve each logistic equation. Find $P(t)$ and $k$ to 4 significant figures.",
        "children": [
         {
          "id": "v2-proposal-j6-125045-j6-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$\\dfrac{dP}{dt}=kP(600-P)$, $P(0)=200$, $P(1)=300$. Use $\\dfrac{600}{P(600-P)}=\\dfrac1P+\\dfrac1{600-P}$.",
          "answerSpaceMm": 80,
          "answer": {
           "short": "$P=\\dfrac{600}{1+2^{1-t}}$, $k\\approx0.001155$",
           "worked": "$$\\begin{align*}\\ln\\frac{P}{600-P}&=600kt+C\\\\\\frac{P}{600-P}&=Ae^{600kt}\\\\P(0)=200:\\ A&=\\frac{200}{400}=\\frac12\\\\P(1)=300:\\ 1&=\\frac12e^{600k}\\\\e^{600k}&=2\\\\k&=\\frac{\\ln2}{600}\\approx0.001155\\\\P&=\\frac{600}{1+2e^{-600kt}}=\\frac{600}{1+2^{1-t}}\\end{align*}$$"
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j6-125045-j6-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\dfrac{dP}{dt}=kP\\left(1-\\dfrac{P}{900}\\right)$, $P(0)=300$, $P(3)=600$. Use $\\dfrac{900}{P(900-P)}=\\dfrac1P+\\dfrac1{900-P}$.",
          "answerSpaceMm": 80,
          "answer": {
           "short": "$P=\\dfrac{900}{1+2\\cdot4^{-t/3}}$, $k\\approx0.4621$",
           "worked": "$$\\begin{align*}\\frac{900}{P(900-P)}\\,dP&=k\\,dt\\\\\\ln\\frac{P}{900-P}&=kt+C\\\\\\frac{P}{900-P}&=Ae^{kt}\\\\P(0)=300:\\ A&=\\frac{300}{600}=\\frac12\\\\P(3)=600:\\ 2&=\\frac12e^{3k}\\\\e^{3k}&=4\\\\k&=\\frac{\\ln4}{3}\\approx0.4621\\\\P&=\\frac{900}{1+2e^{-kt}}=\\frac{900}{1+2\\cdot4^{-t/3}}\\end{align*}$$"
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j6-125045-j6-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\dfrac{dP}{dt}=kP(1000-P)$, $P(0)=250$, $P(2)=500$. Use $\\dfrac{1000}{P(1000-P)}=\\dfrac1P+\\dfrac1{1000-P}$. Also find $P(4)$.",
          "answerSpaceMm": 85,
          "answer": {
           "short": "$P=\\dfrac{1000}{1+3\\cdot3^{-t/2}}$, $k\\approx0.0005493$, $P(4)=750$",
           "worked": "$$\\begin{align*}\\ln\\frac{P}{1000-P}&=1000kt+C\\\\\\frac{P}{1000-P}&=Ae^{1000kt}\\\\P(0)=250:\\ A&=\\frac{250}{750}=\\frac13\\\\P(2)=500:\\ 1&=\\frac13e^{2000k}\\\\e^{2000k}&=3\\\\k&=\\frac{\\ln3}{2000}\\approx0.0005493\\\\P&=\\frac{1000}{1+3e^{-1000kt}}=\\frac{1000}{1+3\\cdot3^{-t/2}}\\\\P(4)&=\\frac{1000}{1+3\\cdot\\frac19}=750\\end{align*}$$"
          },
          "questionDiagrams": []
         }
