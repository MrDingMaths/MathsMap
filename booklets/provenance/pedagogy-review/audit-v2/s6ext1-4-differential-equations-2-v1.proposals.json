         "label": "a",
         "prompt": "$\\dfrac{dP}{dt}=0.0004P(750-P)$",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$\\dfrac{dP}{dt}=0.3P\\left(1-\\dfrac{P}{750}\\right)$; carrying capacity 750",
          "worked": "$$\\begin{align*}\\frac{dP}{dt}&=0.0004P(750-P)\\\\&=0.0004\\times750\\,P\\left(1-\\frac{P}{750}\\right)\\\\&=0.3P\\left(1-\\frac{P}{750}\\right)\\end{align*}$$ So $C=750$."
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-978ba-p65-practice-j4-125045-j4-q-b",
         "type": "part",
         "label": "b",
         "prompt": "$\\dfrac{dP}{dt}=0.2P\\left(3-\\dfrac{P}{500}\\right)$",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$\\dfrac{dP}{dt}=0.6P\\left(1-\\dfrac{P}{1500}\\right)$; carrying capacity 1500",
          "worked": "$$\\begin{align*}\\frac{dP}{dt}&=0.2P\\left(3-\\frac{P}{500}\\right)\\\\&=0.2\\times3\\,P\\left(1-\\frac{P}{3\\times500}\\right)\\\\&=0.6P\\left(1-\\frac{P}{1500}\\right)\\end{align*}$$ So $C=1500$."
         },
         "questionDiagrams": []
        }
