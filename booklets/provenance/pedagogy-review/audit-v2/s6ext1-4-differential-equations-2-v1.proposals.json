             {
              "type": "break"
             },
             {
              "type": "math",
              "latex": "\\begin{align*}P(0)=50:\\quad\\frac{50}{350}&=A\\ \\Rightarrow\\ A=\\frac17\\\\P(1)=100:\\quad\\frac{100}{300}&=\\frac17e^{400k}\\\\e^{400k}&=\\frac73\\\\k&=\\frac{1}{400}\\ln\\frac73\\approx0.002118\\\\\\frac{P}{400-P}&=\\frac17e^{400kt}\\\\P&=\\frac{400}{1+7e^{-400kt}}=\\frac{400}{1+7\\left(\\frac37\\right)^t}\\end{align*}",
              "display": true,
              "colour": "#268cff"
             }
