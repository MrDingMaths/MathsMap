              "type": "math",
              "latex": "\\begin{align*}\\frac{dP}{dt}&=kP(400-P)\\\\\\frac{1}{P(400-P)}\\,dP&=k\\,dt\\\\\\frac{\\color{#ef6068}{400}}{P(400-P)}\\,dP&=\\color{#ef6068}{400}k\\,dt\\\\\\left(\\frac1P+\\frac1{400-P}\\right)dP&=400k\\,dt\\\\\\ln P-\\ln(400-P)&=400kt+C\\\\\\ln\\frac{P}{400-P}&=400kt+C\\\\\\frac{P}{400-P}&=Ae^{400kt}\\end{align*}",
              "display": true,
