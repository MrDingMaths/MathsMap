  "e5dbd70b-742b-4d0a-9e18-c27f65a0feb6": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p17-definition-block",
     "replacement": "A **binomial random variable** counts the number of ‘successes’ in repeated Bernoulli trials.\n\nA binomial random variable requires these conditions:\n\n1. The number of trials $n$ is finite and fixed.\n2. Each trial has exactly two outcomes: success or failure.\n3. The trials are independent.\n4. The probability of success $p$ is the same in every trial.",
     "autoApply": true,
     "key": "theory|p17-definition-block",
     "targetFingerprint": "250a7eaaf0ed20e54ac6b69588f9612013efa5d501c97baa1fd944f3f63107f8",
     "applied": true
    }
   ],
