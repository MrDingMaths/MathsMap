      "content": {
       "id": "v2-044f0-p28-practice-j3-024628-root",
       "type": "question",
       "label": null,
       "prompt": "Let $f(x)=x^2-6x+7$ for $x\\leq3$.",
       "children": [
        {
         "id": "v2-044f0-p28-practice-j3-024628-j3-a",
         "type": "part",
         "label": "a",
         "prompt": "State the range of $f$.",
         "answerSpaceMm": 15,
         "answer": {
          "short": "$[-2,\\infty)$, that is, $y\\geq-2$.",
          "worked": "$$\\begin{align*}f(x)&=(x-3)^2-2\\end{align*}$$\nThe turning point is $(3,-2)$. The function is strictly decreasing for $x\\leq3$, so the range is $y\\geq-2$."
         }
        },
        {
         "id": "v2-044f0-p28-practice-j3-024628-j3-b",
         "type": "part",
         "label": "b",
         "prompt": "Find $f^{-1}(x)$ and state its domain.",
         "answerSpaceMm": 40,
         "answer": {
          "short": "$f^{-1}(x)=3-\\sqrt{x+2}$, with domain $[-2,\\infty)$.",
          "worked": "$$\\begin{align*}y&=(x-3)^2-2\\\\x&=(y-3)^2-2\\\\(y-3)^2&=x+2\\\\y-3&=-\\sqrt{x+2}\\\\y&=3-\\sqrt{x+2}\\\\f^{-1}(x)&=3-\\sqrt{x+2}\\end{align*}$$\nThe negative root is required because the original domain gives $y\\leq3$ after swapping. The original range is $[-2,\\infty)$, so this is the domain of the inverse."
         }
        },
        {
         "id": "v2-044f0-p28-practice-j3-024628-j3-c",
         "type": "part",
         "label": "c",
         "prompt": "Solve $f(x)=x$, and hence find a point where $y=f(x)$ meets the graph of its inverse.",
         "answerSpaceMm": 50,
         "answer": {
          "short": "$x=\\dfrac{7\\pm\\sqrt{21}}{2}$; only $x=\\dfrac{7-\\sqrt{21}}{2}$ satisfies $x\\leq3$. The point is $\\left(\\dfrac{7-\\sqrt{21}}{2},\\dfrac{7-\\sqrt{21}}{2}\\right)$.",
          "worked": "A point of $y=f(x)$ on the line $y=x$ also lies on the inverse, since reflecting in $y=x$ leaves it fixed.\n$$\\begin{align*}x^2-6x+7&=x\\\\x^2-7x+7&=0\\\\x&=\\frac{7\\pm\\sqrt{21}}{2}\\end{align*}$$\nThe roots are about $5.79$ and $1.21$. Only $x=\\dfrac{7-\\sqrt{21}}{2}$ satisfies $x\\leq3$, so the point is $\\left(\\dfrac{7-\\sqrt{21}}{2},\\dfrac{7-\\sqrt{21}}{2}\\right)$."
         }
        }
       ]
      },
      "classification": {
       "primarySkillId": "solve-inverse-function-problems",
       "secondarySkillIds": [],
       "archetype": "inverse-graphs-with-intersections"
      },
