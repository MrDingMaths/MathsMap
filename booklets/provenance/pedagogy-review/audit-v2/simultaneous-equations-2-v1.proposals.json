  "8fdbb0ed-2b16-43c1-a8a3-a683c9d77f4c": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p53-investigation-block",
     "nodeId": "p53-investigation-root",
     "replacement": "When asked to solve an equation, we usually work with **conditional** equations.\n\nA **conditional equation** is true for some values of the variable and false for the others:\n\nSolve $2x+4=8$\n\n\n\nThe **solution** of this equation is $x=$[[$2$|9]], this means it is only true when $x=$[[$2$|9]]\nThis equation is an **identity**:\n\nSolve $5(x+3)+2x-4=7x+11$\n\n\n\nThis equation is true for [[all values of $x$|33]]; all values of $x$ are [[solutions|26]]\nThis equation is a **contradiction**:\n\nSolve $4x+5=2(2x-8)$\n\n\n\nThis equation is [[never|17]] true; it has [[no|11]] solution.",
     "autoApply": true,
     "key": "theory|p53-investigation-block",
     "targetFingerprint": "56ef2e3a43cb1b0a2b6b2ad74df936f222bf827e8c850016299af9d6951c505a",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/simultaneous-equations-2-v1/20261110-040631",
   "revision": 6
