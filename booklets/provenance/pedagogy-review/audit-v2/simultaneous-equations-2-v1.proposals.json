       "id": "v2-f1e31-p55-practice-j7-040631-root",
       "type": "question",
       "label": null,
       "prompt": "Consider the equation $(k+1)x+4=3x+k$.",
       "children": [
        {
         "id": "v2-f1e31-p55-practice-j7-040631-parallel-lines-parameter-a",
         "type": "part",
         "label": "a",
         "prompt": "Find $k$ so that $y=\\mathit{LHS}$ and $y=\\mathit{RHS}$ have the same gradient.",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$k=2$",
          "worked": "$$\\begin{align*}k+1&=3\\\\k&=2\\end{align*}$$"
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-f1e31-p55-practice-j7-040631-parallel-lines-parameter-b",
         "type": "part",
         "label": "b",
         "prompt": "Show that for this value of $k$ the equation is a contradiction.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "With $k=2$: $3x+4=3x+2$, which is never true.",
          "worked": "$$\\begin{align*}\\mathit{LHS}&=(2+1)x+4=3x+4\\\\\\mathit{RHS}&=3x+2\\end{align*}$$\nThe gradients are equal but the $y$-intercepts differ ($4\\ne2$), so the lines are parallel and the equation is a contradiction."
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-f1e31-p55-practice-j7-040631-parallel-lines-parameter-c",
         "type": "part",
         "label": "c",
         "prompt": "Find $k$ so that $(k+1)x+4=3x+2k$ is an identity.",
         "answerSpaceMm": 35,
         "answer": {
          "short": "$k=2$",
          "worked": "For an identity the gradients and the $y$-intercepts must both match.\n$$\\begin{align*}k+1&=3 &&\\Rightarrow k=2\\\\4&=2k &&\\Rightarrow k=2\\end{align*}$$\nBoth give $k=2$."
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-f1e31-p55-practice-j7-040631-parallel-lines-parameter-d",
         "type": "part",
         "label": "d",
         "prompt": "Find $k$ and $c$ so that $k(x+1)+2=3x+c$ is an identity.",
         "answerSpaceMm": 40,
         "answer": {
          "short": "$k=3$, $c=5$",
          "worked": "$$\\begin{align*}k(x+1)+2&=kx+(k+2)\\end{align*}$$\nMatching gradients: $k=3$.\nMatching $y$-intercepts: $c=k+2=5$."
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-f1e31-p55-practice-j7-040631-parallel-lines-parameter-e",
         "type": "part",
         "label": "e",
         "prompt": "For the value of $k$ in part d, find the values of $c$ for which $k(x+1)+2=3x+c$ is a contradiction.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "All $c$ except $c=5$.",
          "worked": "With $k=3$: $3x+5=3x+c$.\nThe gradients match, so the lines are parallel unless they coincide.\nThe equation is a contradiction when $c\\ne5$."
         },
         "questionDiagrams": []
        }
