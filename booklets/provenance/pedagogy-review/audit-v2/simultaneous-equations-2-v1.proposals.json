  "01288ccc-579c-4b33-95c2-d9fc1d928270": {
   "kind": "theory-wording",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p54-information",
     "nodeId": "p54-contradiction",
     "replacement": "**Contradiction**\n\nA **contradiction** is an equation that has no solution.\n\n$x+2=x-3$\n\nIf we graph $y=LHS$ and $y=RHS$, we get two parallel lines.\nParallel lines never intersect: they have the same gradient but different $y$-intercepts.\n\n$y=x+2$ and $y=x-3$\nare two parallel lines.\n\nThe two sides are never equal, so $x+2\\neq x-3$ for every value of $x$.",
     "autoApply": true,
     "key": "theory|p54-information",
     "targetFingerprint": "f07f8715ad6064e9cf1389f184f3a7c53fb1b78b1928e97a20f4d0802ef0311a",
     "applied": true
    }
   ],
