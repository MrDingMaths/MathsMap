  "76139e2e-dfe6-4928-89d8-97e0fec75d94": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p59-information-block",
     "replacement": "**Equating coefficients** is a strategy for finding unknowns when two expressions are equal for all values of $x$. The coefficients of each power of $x$, and the constant terms, must then match.\n\n1. Expand any brackets.\n2. Set equal the coefficients of matching powers of $x$ on both sides, including the constant terms.\n3. Solve for the unknowns. You may need simultaneous equations.",
     "autoApply": true,
     "key": "theory|p59-information-block",
     "targetFingerprint": "ab888655e7003091177b754c0c6c7a68fa0d20c5f31c4d350c3a0951e3f336d1",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/simultaneous-equations-2-v1/20261110-040631",
   "revision": 6
  },
  "ca662d99-0507-44ef-aed6-601d3e3a4099": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p65-information",
     "replacement": "**Splitting the numerator** rewrites an algebraic fraction as a constant plus a simpler fraction with the same denominator.\n\n$$\\frac{px+q}{x+r}=a+\\frac{b}{x+r},\\quad x\\ne-r$$\n\nWe can do this by **equating coefficients** or by **rewriting the numerator** so that part of it cancels with the denominator.\n\nThis is an important skill for sketching hyperbolas later on.",
     "autoApply": true,
     "key": "theory|p65-information",
     "targetFingerprint": "82877652db08dcc87b8f9e26676bfe35d98c4b7a41e4d831dafceccfb982f8b2",
     "applied": true
    }
