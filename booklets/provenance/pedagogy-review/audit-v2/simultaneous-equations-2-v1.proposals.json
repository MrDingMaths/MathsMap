        "label": null,
        "prompt": "Set up and solve a pair of simultaneous equations to find the current ages in each case.",
        "children": [
         {
          "id": "v2-proposal-j3-040631-ages-across-time-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "Jack is 5 times as old as his daughter. In 10 years’ time, he will be 3 times her age.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "Jack is 50 years old and his daughter is 10 years old.",
           "worked": "Let $j$ be Jack’s age and $d$ his daughter’s age, in years.\n$$\\begin{align*}j&=5d &&(1)\\\\j+10&=3(d+10) &&(2)\\end{align*}$$\nSub (1) into (2):\n$$\\begin{align*}5d+10&=3d+30\\\\2d&=20\\\\d&=10\\\\j&=50\\end{align*}$$\nJack is 50 years old and his daughter is 10 years old."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j3-040631-ages-across-time-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "Ben is 3 times as old as his sister Cara. 4 years ago, he was 5 times her age.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "Ben is 24 years old and Cara is 8 years old.",
           "worked": "Let $b$ be Ben’s age and $c$ Cara’s age, in years.\n$$\\begin{align*}b&=3c &&(1)\\\\b-4&=5(c-4) &&(2)\\end{align*}$$\nSub (1) into (2):\n$$\\begin{align*}3c-4&=5c-20\\\\16&=2c\\\\c&=8\\\\b&=24\\end{align*}$$\nBen is 24 years old and Cara is 8 years old."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j3-040631-ages-across-time-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "Lena is 18 years older than Sam. In 6 years’ time, she will be twice his age.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "Lena is 30 years old and Sam is 12 years old.",
           "worked": "Let $l$ be Lena’s age and $s$ Sam’s age, in years.\n$$\\begin{align*}l&=s+18 &&(1)\\\\l+6&=2(s+6) &&(2)\\end{align*}$$\nSub (1) into (2):\n$$\\begin{align*}s+24&=2s+12\\\\s&=12\\\\l&=30\\end{align*}$$\nLena is 30 years old and Sam is 12 years old."
          },
          "questionDiagrams": []
         }
        ]
