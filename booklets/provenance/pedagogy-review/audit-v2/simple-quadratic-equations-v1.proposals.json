   "payloads": [
    {
     "op": "theory",
     "blockId": "p4-solving-block",
     "replacement": "The inverse operation of squaring is **square rooting.**\n\nTo solve quadratic equations $x^{2}=c$:\n\n**Square root both sides** when $c\\geq 0$. Write $x=\\pm\\sqrt{c}$ to include both signs. If $c<0$, there is no real solution.\n\nIf the square root is not a whole number or a terminating decimal, leave it as a root. This is called **exact form** or **surd form.**\n\n- Simplify $\\sqrt{225}$ to 15.\n- Leave $\\sqrt{146}$ as is.\n\nSome questions ask you to round to a specified decimal place.",
     "autoApply": true,
     "key": "theory|p4-solving-block",
     "targetFingerprint": "d00169ec3e351f40d25d9e24855a0709eb8e1d5b26cd812a1a65e2deb0a19450",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/simple-quadratic-equations-v1/20261108-095526",
