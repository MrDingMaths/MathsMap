        "id": "v2-proposal-j8-135432-root",
        "type": "question",
        "label": null,
        "prompt": "Find the area enclosed between each pair of curves.",
        "children": [
         {
          "id": "v2-proposal-j8-135432-j8-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$x=4-y^2$ and $x=y+2$",
          "answerSpaceMm": 70,
          "questionDiagrams": [
           {
            "id": "v2-proposal-j8-135432-j8-guided-a-graph",
            "format": "tikz",
            "role": "question",
            "widthMm": 70,
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"regionGreen\",\"hex\":\"DCEBE0\",\"reason\":\"enclosed region\"}],\"reference\":\"j8 guided practice a\"}\n\\begin{tikzpicture}[x=0.7cm,y=0.8cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{regionGreen}{HTML}{DCEBE0}\n\\path[fill=regionGreen] plot[domain=-2:1,samples=50,variable=\\t] ({4-(\\t)^2},{\\t}) -- plot[domain=1:-2,samples=2,variable=\\t] ({(\\t)+2},{\\t}) -- cycle;\n\\draw[<->,line width=0.5pt] (-2,0)--(5.2,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-3)--(0,3.3) node[above] {$y$};\n\\draw[<->,line width=0.8pt] plot[domain=-2.3:2.3,samples=80,variable=\\t] ({4-(\\t)^2},{\\t});\n\\draw[<->,line width=0.8pt] (-0.6,-2.6)--(3.8,1.8);\n\\node[above left] at (-1.29,2.3) {$x=4-y^2$};\n\\node[above right] at (3.8,1.8) {$x=y+2$};\n\\end{tikzpicture}"
           }
          ],
          "answer": {
           "short": "$\\frac92\\text{ u}^2$",
           "worked": "$$\\begin{aligned}4-y^2&=y+2\\\\y^2+y-2&=0\\\\(y+2)(y-1)&=0\\\\y&=-2,\\ 1\\end{aligned}$$\nFor $-2<y<1$ the parabola is the right curve (at $y=0$: $x=4$ and $x=2$).\n$$\\begin{aligned}A&=\\int_{-2}^{1}\\big((4-y^2)-(y+2)\\big)\\,dy\\\\&=\\int_{-2}^{1}(2-y-y^2)\\,dy\\\\&=\\left[2y-\\frac{y^2}{2}-\\frac{y^3}{3}\\right]_{-2}^{1}\\\\&=\\left(2-\\frac12-\\frac13\\right)-\\left(-4-2+\\frac83\\right)\\\\&=\\frac76+\\frac{10}{3}\\\\&=\\frac92\\text{ u}^2\\end{aligned}$$"
          }
         },
         {
          "id": "v2-proposal-j8-135432-j8-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$x=y^2-3$ and $y=\\dfrac{x}{2}$",
          "answerSpaceMm": 70,
          "questionDiagrams": [
           {
            "id": "v2-proposal-j8-135432-j8-guided-b-graph",
            "format": "tikz",
            "role": "question",
            "widthMm": 70,
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"regionGreen\",\"hex\":\"DCEBE0\",\"reason\":\"enclosed region\"}],\"reference\":\"j8 guided practice b\"}\n\\begin{tikzpicture}[x=0.5cm,y=0.75cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{regionGreen}{HTML}{DCEBE0}\n\\path[fill=regionGreen] plot[domain=-1:3,samples=50,variable=\\t] ({(\\t)^2-3},{\\t}) -- plot[domain=3:-1,samples=2,variable=\\t] ({2*(\\t)},{\\t}) -- cycle;\n\\draw[<->,line width=0.5pt] (-4,0)--(9,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-2.5)--(0,4.3) node[above] {$y$};\n\\draw[<->,line width=0.8pt] plot[domain=-1.9:3.3,samples=80,variable=\\t] ({(\\t)^2-3},{\\t});\n\\draw[<->,line width=0.8pt] (-3.5,-1.75)--(7.6,3.8);\n\\node[right] at (0.8,-1.9) {$x=y^2-3$};\n\\node[below right] at (4,2) {$y=\\frac{x}{2}$};\n\\end{tikzpicture}"
           }
          ],
          "answer": {
           "short": "$\\frac{32}{3}\\text{ u}^2$",
           "worked": "Write the line as $x$ in terms of $y$:\n$$\\begin{aligned}y&=\\frac{x}{2}\\\\y\\color{#ef6068}{\\times2}&=\\frac{x}{2}\\color{#ef6068}{\\times2}\\\\x&=2y\\end{aligned}$$\n$$\\begin{aligned}y^2-3&=2y\\\\y^2-2y-3&=0\\\\(y-3)(y+1)&=0\\\\y&=-1,\\ 3\\end{aligned}$$\nFor $-1<y<3$ the line is the right curve (at $y=0$: $x=0$ and $x=-3$).\n$$\\begin{aligned}A&=\\int_{-1}^{3}\\big(2y-(y^2-3)\\big)\\,dy\\\\&=\\int_{-1}^{3}(2y+3-y^2)\\,dy\\\\&=\\left[y^2+3y-\\frac{y^3}{3}\\right]_{-1}^{3}\\\\&=(9+9-9)-\\left(1-3+\\frac13\\right)\\\\&=9+\\frac53\\\\&=\\frac{32}{3}\\text{ u}^2\\end{aligned}$$"
          }
         }
        ]
