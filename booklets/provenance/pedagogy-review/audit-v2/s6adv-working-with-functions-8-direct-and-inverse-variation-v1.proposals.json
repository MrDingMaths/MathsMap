   "payloads": [
    {
     "op": "theory",
     "blockId": "p16-power-information",
     "replacement": "**Power variation** happens when one variable is proportional to a power of another variable, where the power $n$ is a positive constant.\n\n**Direct power variation**\t**Inverse power variation**\n$y\\propto x^n$\t$y\\propto\\frac{1}{x^n}$ or $y\\propto x^{-n}$\nE.g.\tE.g.\nSphere volume $V\\propto r^3$\tInverse square law $I\\propto\\frac{1}{d^2}$\n\n1. Write $y=kx^n$ or $y=\\frac{k}{x^n}$.\n2. Substitute given information.\n3. Solve the equation to find the constant of variation $k$.\n4. Rewrite the equation with the $k$ you calculated.\n5. Use your equation to find the required information.",
     "autoApply": true,
     "key": "theory|p16-power-information",
     "targetFingerprint": "3c22b6838cd4e9bb40f9e78de1a625f06fe7e5781f00ed8651cc920f34dfd5b9",
     "applied": true
    }
   ],
