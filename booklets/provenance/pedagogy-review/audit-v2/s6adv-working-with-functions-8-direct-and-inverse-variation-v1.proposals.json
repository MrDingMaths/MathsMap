 "comments": {
  "e666dc0e-7d05-4587-840f-514c4f618e37": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p3-variation-definition-p3-definitions-block",
     "replacement": "Two quantities are **directly proportional** if:\n\n- An **increase** in one quantity causes a proportional **increase** in the other.\n- If you triple one quantity, the second quantity is also tripled.\n- A **decrease** in one quantity causes a proportional **decrease** in the other.\n- If you halve one quantity, the other quantity is also halved.\n\nTwo positive quantities are **inversely proportional** if:\n\n- An **increase** in one quantity causes a proportional **decrease** in the other.\n- If you triple one quantity, the second quantity is divided by 3.\n- A **decrease** in one quantity causes a proportional **increase** in the other.\n- If you halve one quantity, the second quantity is doubled.",
     "autoApply": true,
     "key": "theory|p3-variation-definition-p3-definitions-block",
     "targetFingerprint": "d12bcf602c374c7c251897c985e83ee25597e317fa65b98b78a6fec1885d85d9",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-working-with-functions-8-direct-and-inverse-variation-v1/20261111-091418",
   "revision": 15
  },
