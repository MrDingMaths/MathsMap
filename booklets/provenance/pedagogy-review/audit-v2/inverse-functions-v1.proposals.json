        "children": [
         {
          "id": "v2-proposal-j6-025857-j6-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$y=\\dfrac{2x+3}{x+1}$",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$y=\\dfrac{3-x}{x-2}$, $x\\ne2$.",
           "worked": "$$\\begin{align*}x&=\\frac{2y+3}{y+1}\\\\x(y+1)&=2y+3\\\\xy+x&=2y+3\\\\xy-2y&=3-x\\\\y(x-2)&=3-x\\\\y&=\\frac{3-x}{x-2}\\end{align*}$$\nThe inverse has domain $x\\ne2$."
          }
         },
         {
          "id": "v2-proposal-j6-025857-j6-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$y=\\dfrac{x}{2x-3}$",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$y=\\dfrac{3x}{2x-1}$, $x\\ne\\dfrac12$.",
           "worked": "$$\\begin{align*}x&=\\frac{y}{2y-3}\\\\x(2y-3)&=y\\\\2xy-3x&=y\\\\2xy-y&=3x\\\\y(2x-1)&=3x\\\\y&=\\frac{3x}{2x-1}\\end{align*}$$\nThe inverse has domain $x\\ne\\dfrac12$."
          }
         },
         {
          "id": "v2-proposal-j6-025857-j6-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$y=\\dfrac{4x-1}{3-x}$",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$y=\\dfrac{3x+1}{x+4}$, $x\\ne-4$.",
           "worked": "$$\\begin{align*}x&=\\frac{4y-1}{3-y}\\\\x(3-y)&=4y-1\\\\3x-xy&=4y-1\\\\3x+1&=4y+xy\\\\3x+1&=y(4+x)\\\\y&=\\frac{3x+1}{x+4}\\end{align*}$$\nThe inverse has domain $x\\ne-4$."
          }
         }
        ],
