   "payloads": [
    {
     "op": "theory",
     "blockId": "p3-factorials-block",
     "replacement": "The **factorial** of a whole number $n$ is the product of all the whole numbers from $n$ down to $1$.\n\n$$n!=n\\times(n-1)\\times(n-2)\\times\\cdots\\times2\\times1\\qquad\\text{for }n\\in\\{1,2,3,\\ldots\\}$$\n\nBy definition, $0!=1$.\n\nFactorials are defined only for whole numbers $n\\geq0$; for example, $1.5!$ is undefined.",
     "autoApply": true,
     "key": "theory|p3-factorials-block",
     "targetFingerprint": "ed2b3637545b0af1ab093cf09b4bd53805c5bdbed218f1d448dc4a2122bafee9",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6ext1-permutations-and-combinations-v1/20261111-133602",
