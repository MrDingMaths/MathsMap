         },
         {
          "id": "v2-proposal-j6-133602-j6-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$2$ that is a factor of $8!$",
          "answerSpaceMm": 35,
          "answer": {
           "short": "$2^7$",
           "worked": "$$\\begin{align*}2&=2\\\\4&=2^2\\\\6&=2\\times3\\\\8&=2^3\\end{align*}$$\nThe number of 2s is $1+2+1+3=7$.\nThe largest power is $2^7$."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j6-133602-j6-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$6$ that is a factor of $9!$",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$6^4$",
           "worked": "$$\\begin{align*}9!&=1\\times2\\times3\\times2^2\\times5\\times(2\\times3)\\times7\\times2^3\\times3^2\\\\&=2^7\\times3^4\\times5\\times7\\end{align*}$$\nSince $6^k=2^k\\times3^k$, we need $k\\leq7$ and $k\\leq4$.\nThe largest power is $6^4$."
          },
