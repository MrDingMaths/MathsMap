       "type": "question",
       "label": null,
       "prompt": "Consider the inequality $3x^{2}>5x+2$.",
       "children": [
        {
         "id": "v2-1e331-p64-practice-82a85b58-j3-20261111-82a85b58-j3-a",
         "type": "part",
         "label": "a",
         "prompt": "Rearrange the inequality so that one side is $0$.",
         "answerSpaceMm": 15,
         "answer": {
          "short": "$3x^{2}-5x-2>0$",
          "worked": "$$\\begin{align*}3x^{2}&>5x+2\\\\3x^{2}-5x-2&>0\\end{align*}$$"
         }
        },
        {
         "id": "v2-1e331-p64-practice-82a85b58-j3-20261111-82a85b58-j3-b",
         "type": "part",
         "label": "b",
         "prompt": "Factorise $3x^{2}-5x-2$.",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$(3x+1)(x-2)$",
          "worked": "$$\\begin{align*}3x^{2}-5x-2&=3x^{2}-6x+x-2\\\\&=3x(x-2)+(x-2)\\\\&=(3x+1)(x-2)\\end{align*}$$"
         }
        }
       ],
