  "9531f469-21e8-495d-8cc7-178c4bf8e83e": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p14-teaching",
     "replacement": "**Euler’s number** $e=2.71828182845\\ldots$ is the one base $a$ for which $\\frac{d}{dx}(a^x)=a^x$:\n\n$$\\begin{aligned}\\text{if }f(x)&=e^x\\\\\\text{then }f'(x)&=e^x\\end{aligned}$$\n\nThis means $f(x)=f'(x)$: the function equals its own derivative.\n\nFor $e^x$, the rate of growth always equals the current amount.\n\nExponential growth and decay model many real-life phenomena, such as:\n\npopulation growth, disease spread, radioactive decay, compound interest.",
     "autoApply": true,
     "key": "theory|p14-teaching",
     "targetFingerprint": "f2c7e2049f277abf1f91c3ffa6612489e90a9d70e85da369a24916f334ca0fe5",
     "applied": true
    }
   ],
