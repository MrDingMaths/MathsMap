      "title": "",
      "content": {
       "id": "v2-f-p10-introduction-j2-080620-root",
       "type": "question",
       "label": null,
       "prompt": "Two students are chosen at random to carry the school banner from a group of 5 boys and 7 girls. Find the probability that:",
       "children": [
        {
         "id": "v2-f-p10-introduction-j2-080620-j2-a",
         "type": "part",
         "label": "a",
         "prompt": "both students are boys,",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$\\dfrac{5}{33}$",
          "worked": "$$\\begin{align*}P(\\text{both boys})&=\\frac{5}{12}\\times\\frac{4}{11}\\\\P(\\text{both boys})&=\\frac{20}{132}\\\\P(\\text{both boys})&=\\frac{5}{33}\\end{align*}$$"
         }
        },
        {
         "id": "v2-f-p10-introduction-j2-080620-j2-b",
         "type": "part",
         "label": "b",
         "prompt": "at least one student is a girl,",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$\\dfrac{28}{33}$",
          "worked": "The complement of at least one girl is both boys.\n$$\\begin{align*}P(\\text{at least one girl})&=1-P(\\text{both boys})\\\\P(\\text{at least one girl})&=1-\\frac{5}{33}\\\\P(\\text{at least one girl})&=\\frac{28}{33}\\end{align*}$$"
         }
        },
        {
         "id": "v2-f-p10-introduction-j2-080620-j2-c",
         "type": "part",
         "label": "c",
         "prompt": "both students are girls, given that at least one student is a girl.",
         "answerSpaceMm": 45,
         "answer": {
          "short": "$\\dfrac{3}{8}$",
          "worked": "Both girls is an outcome within the event “at least one girl”.\n$$\\begin{align*}P(\\text{both girls})&=\\frac{7}{12}\\times\\frac{6}{11}\\\\P(\\text{both girls})&=\\frac{7}{22}\\\\P(\\text{both girls}\\mid\\text{at least one girl})&=\\frac{P(\\text{both girls})}{P(\\text{at least one girl})}\\\\P(\\text{both girls}\\mid\\text{at least one girl})&=\\frac{7/22}{28/33}\\\\P(\\text{both girls}\\mid\\text{at least one girl})&=\\frac{3}{8}\\end{align*}$$"
         }
        }
       ]
      },
