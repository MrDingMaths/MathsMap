            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
             {
              "type": "math",
              "latex": "\\begin{aligned}f'(x)&=\\frac{1}{1+x^2}+\\frac{-\\frac{1}{x^2}}{1+\\left(\\frac{1}{x}\\right)^2}\\\\&=\\frac{1}{1+x^2}-\\frac{1}{x^2+1}\\\\&=0\\end{aligned}",
