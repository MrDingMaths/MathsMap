              "latex": "\\begin{aligned}f(1)&=\\tan^{-1}(1)+\\tan^{-1}(1)\\\\&=\\frac{\\pi}{4}+\\frac{\\pi}{4}\\\\&=\\frac{\\pi}{2}\\end{aligned}",
              "display": true,
