      {
       "id": "v2-proposal-j3-132358",
       "type": "question",
       "pedagogyRole": "guided-practice",
       "snapshotKind": "local",
       "bankRef": null,
       "title": "",
       "content": {
        "id": "v2-proposal-j3-132358-root",
        "type": "question",
        "label": null,
        "prompt": "Show that each function is constant on the given interval, and find the constant.",
        "children": [
         {
          "id": "v2-proposal-j3-132358-j3-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$f(x)=\\tan^{-1}x+\\tan^{-1}\\left(\\dfrac{1}{x}\\right)$ for $x<0$",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$f'(x)=0$, so $f$ is constant; $f(x)=-\\dfrac{\\pi}{2}$.",
           "worked": "$$\\begin{aligned}f'(x)&=\\frac{1}{1+x^2}+\\frac{-\\frac{1}{x^2}}{1+\\left(\\frac{1}{x}\\right)^2}\\\\&=\\frac{1}{1+x^2}-\\frac{1}{x^2+1}\\\\&=0\\end{aligned}$$\nSo $f$ is constant for $x<0$. At $x=-1$,\n$$\\begin{aligned}f(-1)&=\\tan^{-1}(-1)+\\tan^{-1}(-1)\\\\&=-\\frac{\\pi}{4}-\\frac{\\pi}{4}\\\\&=-\\frac{\\pi}{2}\\end{aligned}$$"
          }
         },
         {
          "id": "v2-proposal-j3-132358-j3-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$f(x)=\\tan^{-1}(2x)+\\tan^{-1}\\left(\\dfrac{1}{2x}\\right)$ for $x>0$",
          "answerSpaceMm": 50,
          "answer": {
           "short": "$f'(x)=0$, so $f$ is constant; $f(x)=\\dfrac{\\pi}{2}$.",
           "worked": "$$\\begin{aligned}f'(x)&=\\frac{2}{1+4x^2}+\\frac{-\\frac{1}{2x^2}}{1+\\frac{1}{4x^2}}\\\\&=\\frac{2}{1+4x^2}-\\frac{2}{4x^2+1}\\\\&=0\\end{aligned}$$\nSo $f$ is constant for $x>0$. At $x=\\frac{1}{2}$,\n$$\\begin{aligned}f\\left(\\tfrac{1}{2}\\right)&=\\tan^{-1}(1)+\\tan^{-1}(1)\\\\&=\\frac{\\pi}{4}+\\frac{\\pi}{4}\\\\&=\\frac{\\pi}{2}\\end{aligned}$$"
          }
         },
         {
          "id": "v2-proposal-j3-132358-j3-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$f(x)=\\tan^{-1}x-\\tan^{-1}\\left(\\dfrac{x-1}{x+1}\\right)$ for $x>-1$",
          "answerSpaceMm": 60,
          "answer": {
           "short": "$f'(x)=0$, so $f$ is constant; $f(x)=\\dfrac{\\pi}{4}$.",
           "worked": "$$\\begin{aligned}f'(x)&=\\frac{1}{1+x^2}-\\frac{\\frac{2}{(x+1)^2}}{1+\\left(\\frac{x-1}{x+1}\\right)^2}\\\\&=\\frac{1}{1+x^2}-\\frac{2}{(x+1)^2+(x-1)^2}\\\\&=\\frac{1}{1+x^2}-\\frac{2}{2x^2+2}\\\\&=0\\end{aligned}$$\nSo $f$ is constant for $x>-1$. At $x=0$,\n$$\\begin{aligned}f(0)&=\\tan^{-1}(0)-\\tan^{-1}(-1)\\\\&=0+\\frac{\\pi}{4}\\\\&=\\frac{\\pi}{4}\\end{aligned}$$"
          }
         }
        ],
