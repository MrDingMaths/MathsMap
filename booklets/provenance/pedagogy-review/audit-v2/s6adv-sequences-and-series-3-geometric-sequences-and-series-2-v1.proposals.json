         "type": "part",
         "label": "a",
         "prompt": "Find the condition for the series to have a limiting sum.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$-\\frac12<x<\\frac12$",
          "worked": "$a=5$ and $r=2x$.\n$$\\begin{align*}|2x|&<1\\\\-\\frac12&<x<\\frac12\\end{align*}$$"
         },
