       "questionDiagrams": [
        {
         "id": "v2-70f90e0-p32-angles-j7-111641-j7-q-diagram",
         "format": "tikz",
         "widthMm": 43,
         "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"j7 diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-1.1,-0.6) rectangle (3.2,2.4);\n\\coordinate (Q) at (0,0); \\coordinate (R) at (2.4,0); \\coordinate (P) at (0,1.8);\n\\draw (Q)--(R)--(P)--cycle;\n\\draw[line width=0.4pt] (0.2,0)--(0.2,0.2)--(0,0.2);\n\\draw[line width=0.4pt] (P)++(270:0.45) arc(270:323.13:0.45);\n\\draw[line width=0.4pt] (R)++(-0.5,0) arc(180:143.13:0.5);\n\\node at (0.34,1.13) {$\\alpha$};\n\\node at (1.5,0.3) {$\\beta$};\n\\path (Q)--(P) node[midway,left] {$3\\text{ cm}$};\n\\path (Q)--(R) node[midway,below] {$4\\text{ cm}$};\n\\end{tikzpicture}"
        }
       ],
       "children": [
        {
         "id": "v2-70f90e0-p32-angles-j7-111641-j7-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Find $\\alpha$. Answer to 1 d.p.",
         "answerSpaceMm": 28,
         "answer": {
          "short": "$\\alpha\\approx53.1^{\\circ}$",
          "worked": "Opposite $=4$, adjacent $=3$.\n$$\\begin{align*}\\tan\\alpha&=\\frac{4}{3}\\\\\\alpha&=\\tan^{-1}\\left(\\frac{4}{3}\\right)\\\\\\alpha&\\approx53.1^{\\circ}\\end{align*}$$"
         }
        },
        {
         "id": "v2-70f90e0-p32-angles-j7-111641-j7-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Find $\\beta$. Answer to 1 d.p.",
         "answerSpaceMm": 28,
         "answer": {
          "short": "$\\beta\\approx36.9^{\\circ}$",
          "worked": "Opposite $=3$, adjacent $=4$.\n$$\\begin{align*}\\tan\\beta&=\\frac{3}{4}\\\\\\beta&=\\tan^{-1}\\left(\\frac{3}{4}\\right)\\\\\\beta&\\approx36.9^{\\circ}\\end{align*}$$"
         }
        },
        {
         "id": "v2-70f90e0-p32-angles-j7-111641-j7-q-c",
         "type": "part",
         "label": "c",
         "prompt": "Add your answers to parts a and b. What do you notice?",
         "answerSpaceMm": 20,
         "answer": {
          "short": "$\\alpha+\\beta=90^{\\circ}$",
          "worked": "$$53.1^{\\circ}+36.9^{\\circ}=90.0^{\\circ}$$\nThe two acute angles of a right-angled triangle add to $90^{\\circ}$, since the angles of a triangle add to $180^{\\circ}$ and one angle is $90^{\\circ}$. So $\\tan^{-1}\\left(\\frac{4}{3}\\right)+\\tan^{-1}\\left(\\frac{3}{4}\\right)=90^{\\circ}$."
         }
        },
        {
         "id": "v2-70f90e0-p32-angles-j7-111641-j7-q-d",
         "type": "part",
         "label": "d",
         "prompt": "Given that $\\tan^{-1}\\left(\\dfrac{5}{12}\\right)\\approx22.6^{\\circ}$, write down $\\tan^{-1}\\left(\\dfrac{12}{5}\\right)$ without using a calculator. Answer to 1 d.p.",
         "answerSpaceMm": 24,
         "answer": {
          "short": "$67.4^{\\circ}$",
          "worked": "The ratios $\\frac{5}{12}$ and $\\frac{12}{5}$ give the two acute angles of the same right-angled triangle.\n$$\\begin{align*}\\tan^{-1}\\left(\\frac{12}{5}\\right)&=90^{\\circ}-\\tan^{-1}\\left(\\frac{5}{12}\\right)\\\\&\\approx90^{\\circ}-22.6^{\\circ}\\\\&=67.4^{\\circ}\\end{align*}$$"
         }
        }
       ]
