      "content": {
       "id": "v2-e901d-p25-practice-j2-041248-root",
       "type": "question",
       "label": null,
       "prompt": "Consider the equation $3\\cos x=x+1$.",
       "children": [
        {
         "id": "v2-e901d-p25-practice-j2-041248-j2-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Use $-1\\le\\cos x\\le1$ to find the least and greatest values of $3\\cos x$.",
         "answerSpaceMm": 18,
         "answer": {
          "short": "Least $-3$, greatest $3$",
          "worked": "$$\\begin{align*}-1&\\le\\cos x\\le1\\\\-3&\\le3\\cos x\\le3\\end{align*}$$"
         }
        },
        {
         "id": "v2-e901d-p25-practice-j2-041248-j2-q-b",
         "type": "part",
         "label": "b",
         "prompt": "If $n$ is a solution, then $3\\cos n=n+1$. Use part a to find the interval that $n$ must lie in.",
         "answerSpaceMm": 28,
         "answer": {
          "short": "$-4\\le n\\le2$",
          "worked": "$$\\begin{align*}-3&\\le n+1\\le3\\\\-4&\\le n\\le2\\end{align*}$$"
         }
        },
        {
         "id": "v2-e901d-p25-practice-j2-041248-j2-q-c",
         "type": "part",
         "label": "c",
         "prompt": "Explain why the graphs of $y=3\\cos x$ and $y=x+1$ cannot intersect at $x=5$.",
         "answerSpaceMm": 22,
         "answer": {
          "short": "At $x=5$ the line has $y=6$, but $3\\cos x\\le3$.",
          "worked": "At $x=5$ the line has height $y=5+1=6$. The curve $y=3\\cos x$ never goes above $3$, so the graphs cannot meet there. Also $5>2$, outside the interval from part b."
         }
        }
       ],
       "answer": null,
       "questionDiagrams": []
      },
