         "type": "part",
         "label": "a",
         "prompt": "show that $y=2x-\\ln(1+e^x)$.",
         "answerSpaceMm": 28,
         "answer": {
          "short": "$y=2x-\\ln(1+e^x)$",
          "worked": "$$\\begin{align*}y&=\\ln(e^{2x})-\\ln(1+e^x)\\\\&=2x-\\ln(1+e^x)\\end{align*}$$"
         },
         "questionDiagrams": []
