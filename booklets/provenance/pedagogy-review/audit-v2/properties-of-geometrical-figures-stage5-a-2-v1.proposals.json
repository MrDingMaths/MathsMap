         "widthMm": 60,
         "code": "\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\coordinate (A) at (0,0);\\coordinate (B) at (1.5,3);\\coordinate (C) at (3.9,3);\\coordinate (D) at (5.4,0);\n\\coordinate (E) at (0.9,1.8);\\coordinate (F) at (4.5,1.8);\n\\draw[black] (A)--(B)--(C)--(D)--cycle;\\draw[black] (E)--(F);\n\\node[below left] at (A) {$A$};\\node[above left] at (B) {$B$};\\node[above right] at (C) {$C$};\\node[below right] at (D) {$D$};\\node[left] at (E) {$E$};\\node[right] at (F) {$F$};\n\\path (B)--node[above] {$4\\text{ cm}$} (C);\\path (E)--node[below] {$6\\text{ cm}$} (F);\\path (A)--node[below] {$y\\text{ cm}$} (D);\n\\foreach \\P/\\Q in {B/C,E/F,A/D}{\\coordinate (M) at ($ (\\P)!0.5!(\\Q) $);\\draw[black,line width=0.4pt] ($(M)+(-0.07,0.09)$)--($(M)+(0.03,0)$)--($(M)+(-0.07,-0.09)$);}\n\\end{tikzpicture}"
        }
       ],
