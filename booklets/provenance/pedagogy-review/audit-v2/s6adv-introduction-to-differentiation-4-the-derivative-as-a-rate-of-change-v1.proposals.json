  "e6b74298-96d4-4199-a472-5b98167524a0": {
   "kind": "theory-wording",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p6-operations",
     "replacement": "A ball shoots up and comes down. Its height is $h(t)$, where $h$ is in metres and $t$ is in seconds. Each operation answers a different question.\n\nFind $h(a)$: calculate the height at $t=a$ seconds.\n\nSolve $h(t)=a$: find when the ball reaches a height of $a$ metres.\n\nFind $h'(t)$: find the rate of change of the height.\n\nThis gives a formula describing how the height is increasing or decreasing.\n\nFind $h'(a)$: find how quickly the height changes at $t=a$ seconds.\n\nSolve $h'(t)=a$: find when the height changes at $a$ m/s. A positive rate means the height is increasing; a negative rate means it is decreasing.",
     "autoApply": true,
     "key": "theory|p6-operations",
     "targetFingerprint": "fd8f9195dd4f3b1dab80250568da2730f4c940ee55b47bc1afd909f545d4e8b5",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-introduction-to-differentiation-4-the-derivative-as-a-rate-of-change-v1/20261111-075143",
