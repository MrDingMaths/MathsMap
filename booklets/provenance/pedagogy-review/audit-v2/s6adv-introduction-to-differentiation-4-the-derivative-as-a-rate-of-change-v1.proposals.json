  },
  "8fc6e477-ba17-4ebf-bf82-ecfb6299aac4": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p16-motion-definitions",
     "replacement": "- **Magnitude** is the distance from zero.\n- **Direction** is indicated by a positive or negative sign in straight-line motion.\n- **Distance** and **speed** are called **scalar** quantities: they have magnitude only, with no direction.\n- **Displacement, velocity, and acceleration** are **vector** quantities. They have magnitude and direction.\n- In questions, it is important to define the positive direction to interpret results. For example, up is positive and down is negative; or right is positive and left is negative.\n\n**Displacement**\t**Velocity**\t**Acceleration**\nPosition relative to the origin, a fixed reference point.\tRate of change of displacement over time.\tRate of change of velocity over time.\n$x$\t$v\\text{ or }\\dot{x}\\text{ or }\\frac{dx}{dt}$\t$a\\text{ or }\\ddot{x}\\text{ or }\\frac{dv}{dt}$\nE.g. 3 metres north.\tE.g. 5 m/s west.\tE.g. 9.8 m/s² down.\nIts magnitude is the straight-line distance from the origin.\tSpeed is the magnitude of velocity.\t",
     "autoApply": true,
     "key": "theory|p16-motion-definitions",
     "targetFingerprint": "deda3163d0885016302b444309fd28f32e4b47918d8bcf0701e5ca6d0d76d374"
    }
   ],
