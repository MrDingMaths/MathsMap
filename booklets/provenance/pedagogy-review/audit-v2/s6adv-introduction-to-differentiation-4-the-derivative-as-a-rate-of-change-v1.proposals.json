  "1609d7e1-8ce5-49a1-b3ec-efdd2092e5c9": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p3-definition-text",
     "replacement": "The **average rate of change** of $f(x)$ between $x=a$ and $x=b$ (where $a\\ne b$) is the **gradient of the secant** through $(a,f(a))$ and $(b,f(b))$.",
     "autoApply": true,
     "key": "theory|p3-definition-text",
