      "content": {
       "id": "v2-f2031-p10-practice-j8-122539-root",
       "type": "question",
       "label": null,
       "prompt": "A circle of area $A$ and a sphere of surface area $S$ and volume $V$ each have radius $r$.",
       "children": [
        {
         "id": "v2-f2031-p10-practice-j8-122539-j8-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Find $\\dfrac{dA}{dr}$ and compare it with the circumference of the circle.",
         "answerSpaceMm": 35,
         "answer": {
          "short": "$\\dfrac{dA}{dr}=2\\pi r$, which is the circumference.",
          "worked": "$$\\begin{align*}A&=\\pi r^2\\\\\\frac{dA}{dr}&=2\\pi r.\\end{align*}$$This equals the circumference $C=2\\pi r$."
         }
        },
        {
         "id": "v2-f2031-p10-practice-j8-122539-j8-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Find $\\dfrac{dV}{dr}$ and write it in terms of $S$.",
         "answerSpaceMm": 40,
         "answer": {
          "short": "$\\dfrac{dV}{dr}=4\\pi r^2=S$.",
          "worked": "$$\\begin{align*}V&=\\frac43\\pi r^3\\\\\\frac{dV}{dr}&=4\\pi r^2.\\end{align*}$$Since $S=4\\pi r^2$, $\\dfrac{dV}{dr}=S$."
         }
        },
        {
         "id": "v2-f2031-p10-practice-j8-122539-j8-q-c",
         "type": "part",
         "label": "c",
         "prompt": "Hence show that $\\dfrac{dV}{dt}=S\\dfrac{dr}{dt}$.",
         "answerSpaceMm": 35,
         "answer": {
          "short": "$\\dfrac{dV}{dt}=\\dfrac{dV}{dr}\\times\\dfrac{dr}{dt}=S\\dfrac{dr}{dt}$.",
          "worked": "$$\\begin{align*}\\frac{dV}{dt}&=\\frac{dV}{dr}\\times\\frac{dr}{dt}\\\\&=S\\frac{dr}{dt}.\\end{align*}$$"
         }
        },
        {
         "id": "v2-f2031-p10-practice-j8-122539-j8-q-d",
         "type": "part",
         "label": "d",
         "prompt": "The radius of a sphere is increasing at $0.3\\text{ cm/s}$ at the instant its surface area is $200\\text{ cm}^2$. Find the rate at which its volume is increasing at this instant.",
         "answerSpaceMm": 40,
         "answer": {
          "short": "$60\\text{ cm}^3/\\text{s}$.",
          "worked": "$$\\begin{align*}\\frac{dV}{dt}&=S\\frac{dr}{dt}\\\\&=200\\times0.3\\\\&=60\\text{ cm}^3/\\text{s}.\\end{align*}$$"
         }
        }
       ],
