        "children": [
         {
          "id": "v2-proposal-j6-122539-j6-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "A 10 m ladder rests against a vertical wall. Its base slides away from the wall at $0.5\\text{ m/s}$. Find how fast the top is sliding down when the base is 6 m from the wall.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "$\\dfrac38\\text{ m/s}$ downwards.",
           "worked": "$$\\begin{align*}y&=\\sqrt{100-x^2}\\\\\\frac{dy}{dt}&=\\frac{dy}{dx}\\times\\frac{dx}{dt}\\\\&=-\\frac{x}{y}\\times0.5\\end{align*}$$At $x=6$, $y=\\sqrt{100-36}=8$.$$\\begin{align*}\\frac{dy}{dt}&=-\\frac{6}{8}\\times0.5\\\\&=-\\frac38\\text{ m/s}.\\end{align*}$$The top slides down at $\\frac38\\text{ m/s}$."
          }
         },
         {
          "id": "v2-proposal-j6-122539-j6-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "A 15 m ladder rests against a vertical wall. Its top is sliding down at $0.3\\text{ m/s}$. Find how fast the base is sliding away from the wall when the top is 12 m high.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "$0.4\\text{ m/s}$ away from the wall.",
           "worked": "$$\\begin{align*}x&=\\sqrt{225-y^2}\\\\\\frac{dx}{dt}&=\\frac{dx}{dy}\\times\\frac{dy}{dt}\\\\&=-\\frac{y}{x}\\times(-0.3)\\end{align*}$$At $y=12$, $x=\\sqrt{225-144}=9$.$$\\begin{align*}\\frac{dx}{dt}&=\\frac{12}{9}\\times0.3\\\\&=0.4\\text{ m/s}.\\end{align*}$$"
          }
         },
         {
          "id": "v2-proposal-j6-122539-j6-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "A drone flies horizontally at a constant height of 30 m, moving away from its operator at $4\\text{ m/s}$. Find the rate at which the distance from the operator to the drone is increasing when that distance is 50 m.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "$3.2\\text{ m/s}$.",
           "worked": "Let $x$ be the horizontal distance and $s$ the distance to the drone.$$\\begin{align*}s&=\\sqrt{x^2+900}\\\\\\frac{ds}{dt}&=\\frac{ds}{dx}\\times\\frac{dx}{dt}\\\\&=\\frac{x}{s}\\times4\\end{align*}$$When $s=50$, $x=\\sqrt{2500-900}=40$.$$\\begin{align*}\\frac{ds}{dt}&=\\frac{40}{50}\\times4\\\\&=3.2\\text{ m/s}.\\end{align*}$$"
          }
         }
        ],
