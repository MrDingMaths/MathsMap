   "kind": "theory-wording",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p30-teaching",
     "replacement": "The following scenarios all have a limiting value. They satisfy the differential equation below, where $k<0$:\n\n$$\\frac{dQ}{dt}=k(Q-P);\\qquad Q=\\overset{\\substack{\\text{limiting value}\\\\t\\to\\infty\\\\\\downarrow}}{P}+Ae^{kt};\\qquad Q(0)=\\underbrace{P+A}_{\\text{initial value}}$$",
     "autoApply": true,
