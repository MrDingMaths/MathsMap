   "payloads": [
    {
     "op": "theory",
     "blockId": "p41-definition-block",
     "replacement": "**Speed** is the rate of change of distance with time. For example, a car travelling on a highway at 90 kilometres per hour (km/h).\n\n**Acceleration** is the rate of change of speed with time. For example, an object falling under gravity accelerates at 9.8 metres per second, per second ($\\mathrm{m/s^2}$).\n\nAcceleration is the gradient of a speed-time graph.\n\nNegative acceleration is called **deceleration**.",
     "autoApply": true,
     "key": "theory|p41-definition-block",
