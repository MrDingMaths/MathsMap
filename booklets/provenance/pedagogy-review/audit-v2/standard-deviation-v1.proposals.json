       "content": {
        "id": "v2-proposal-j3-212252-root",
        "type": "question",
        "label": null,
        "prompt": "The data set $1,\\ 3,\\ 5,\\ 7$ has mean $4$ and standard deviation $2.24$. Find the new mean and standard deviation, to 2 d.p., when:",
        "children": [
         {
          "id": "v2-proposal-j3-212252-j3-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "each value is decreased by $3$",
          "answerSpaceMm": 25,
          "answer": {
           "short": "Mean $=1$; standard deviation $=2.24$ (unchanged).",
           "worked": "New data: $-2,\\ 0,\\ 2,\\ 4$, so the mean is $1$. Distances from the mean: $-3,\\ -1,\\ 1,\\ 3$, the same as before. The standard deviation stays $2.24$."
          }
         },
         {
          "id": "v2-proposal-j3-212252-j3-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "each value is multiplied by $2$",
          "answerSpaceMm": 30,
          "answer": {
           "short": "Mean $=8$; standard deviation $=4.47$ (doubled).",
           "worked": "New data: $2,\\ 6,\\ 10,\\ 14$, so the mean is $8$. Distances from the mean: $-6,\\ -2,\\ 2,\\ 6$, which are double the old distances. $$\\sigma=\\sqrt{\\frac{36+4+4+36}{4}}=\\sqrt{20}\\approx 4.47$$"
          }
         },
         {
          "id": "v2-proposal-j3-212252-j3-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "an extra value of $4$ is added",
          "answerSpaceMm": 35,
          "answer": {
           "short": "Mean $=4$ (unchanged); standard deviation $=2.00$ (decreases).",
           "worked": "New data: $1,\\ 3,\\ 4,\\ 5,\\ 7$. The sum is $20$, so the mean is $\\frac{20}{5}=4$. The new value equals the mean, so it adds no squared distance, but there are now $5$ values. $$\\sigma=\\sqrt{\\frac{9+1+0+1+9}{5}}=\\sqrt{4}=2.00$$"
          }
         },
         {
          "id": "v2-proposal-j3-212252-j3-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "an extra value of $20$ is added",
          "answerSpaceMm": 40,
          "answer": {
           "short": "Mean $=7.2$ (increases); standard deviation $=6.71$ (increases).",
           "worked": "New data: $1,\\ 3,\\ 5,\\ 7,\\ 20$. The sum is $36$, so the mean is $\\frac{36}{5}=7.2$. The new value is far above the mean, so the spread increases. $$\\sigma=\\sqrt{\\frac{38.44+17.64+4.84+0.04+163.84}{5}}=\\sqrt{44.96}\\approx 6.71$$"
          }
         }
        ],
