  "d3b2347a-240d-456f-9c25-d2a6c6a2ca41": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p29-cdf-definition",
     "replacement": "For a continuous random variable $X$ with probability density function $f(t)$ defined on $[a,b]$ and equal to $0$ elsewhere:\n\nThe **cumulative distribution function (CDF)**, $F(x)$, is the probability that $X\\le x$, which is the area under the graph of $f$ up to $x$. $F(x)=0$ for $x<a$ and $F(x)=1$ for $x>b$.\n\n$$F(x)=P(X\\le x)=\\int_a^x f(t)\\,dt,\\qquad a\\le x\\le b$$",
     "autoApply": true,
     "key": "theory|p29-cdf-definition",
     "targetFingerprint": "2ec10968e2a8a461b9cae5a2bc40f1e887026311148399d274e448f261ea7bed",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-random-variables-2-continuous-random-variables-2-v1/20261111-081428",
