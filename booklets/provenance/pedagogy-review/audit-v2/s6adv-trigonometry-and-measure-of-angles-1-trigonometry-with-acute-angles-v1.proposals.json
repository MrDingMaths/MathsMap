   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p11-compass-definition",
     "replacement": "**Compass bearings** give an **acute** angle to turn from north or south towards east or west, for example $\\mathrm{N}20^{\\circ}\\mathrm{E}$.",
     "autoApply": true,
     "key": "theory|p11-compass-definition",
     "targetFingerprint": "dc87f31eeccebb58cd8b9def18ba1f962d14e276d56b006e1b8e6b120c525654",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-trigonometry-and-measure-of-angles-1-trigonometry-with-acute-angles-v1/20261111-083532",
