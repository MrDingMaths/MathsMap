    {
     "op": "theory",
     "blockId": "p18-theory-explanation",
     "replacement": "This happens because $\\sin\\theta=\\sin(180^\\circ-\\theta)$, so two angles share the same sine.\n\nThe calculator's $\\sin^{-1}(\\phantom{00})$ gives only the acute angle.\n\nTo get the obtuse angle, **subtract the result from 180**: $180^\\circ-\\theta$\n\nYou will meet the reason for this identity later in this course.",
     "autoApply": true,
     "key": "theory|p18-theory-explanation",
     "targetFingerprint": "476ef973b41a1fd5c46fca467530ede765b9346b73fd0d1a4f4013080425166f",
     "applied": true
    }
   ],
