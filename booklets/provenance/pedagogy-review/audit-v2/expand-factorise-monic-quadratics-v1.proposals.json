   "payloads": [
    {
     "op": "theory",
     "blockId": "p9-definitions-block",
     "replacement": "1. A **trinomial** is an expression with **three terms**.\n2. A **quadratic** expression has highest power $x^2$.\n3. A **monic** quadratic has **1** as the coefficient of $x^2$.\n4. A **monic quadratic trinomial** is a monic quadratic with three terms. In descending powers it has the form $x^2+bx+c$, where $b$ and $c$ are non-zero constants.",
     "autoApply": true,
     "key": "theory|p9-definitions-block",
     "targetFingerprint": "605f2ce48e6b1f7444574cd2f27819ee279d849447bdc280ecf0618341ac6f31",
