        }
       ],
       "children": [
        {
         "id": "v2-b02ad-p42-practice-j5-101105-j5-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Use the graph to estimate how long it takes for the concentration to fall from 120 mg/L to 60 mg/L.",
         "answerSpaceMm": 20,
         "answer": {
          "short": "Approximately 4 hours.",
          "worked": "$C=120$ at $t=0$. Reading across from $C=60$ gives $t\\approx4$. The time taken is approximately $4-0=4$ hours."
