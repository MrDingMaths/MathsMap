       "type": "question",
       "label": null,
       "prompt": "Consider the curve $y=\\cos 3x$.",
       "children": [
        {
         "id": "v2-503cb8-p6-practice-j2-034613-j2-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Find $\\dfrac{dy}{dx}$, and hence the gradient of the curve at $x=\\dfrac{\\pi}{6}$.",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$\\dfrac{dy}{dx}=-3\\sin 3x$; gradient $=-3$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=-3\\sin 3x\\\\m&=-3\\sin\\left(\\frac{\\pi}{2}\\right)\\\\&=-3\\end{align*}$$"
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-503cb8-p6-practice-j2-034613-j2-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Find the $y$-coordinate of the point on the curve where $x=\\dfrac{\\pi}{6}$.",
         "answerSpaceMm": 15,
         "answer": {
          "short": "$y=0$",
          "worked": "$$\\begin{align*}y&=\\cos\\left(\\frac{\\pi}{2}\\right)\\\\&=0\\end{align*}$$"
         },
         "questionDiagrams": []
        },
        {
         "id": "v2-503cb8-p6-practice-j2-034613-j2-q-c",
         "type": "part",
         "label": "c",
         "prompt": "Find the equation of the tangent to the curve at $x=\\dfrac{\\pi}{6}$ in exact general form.",
         "answerSpaceMm": 35,
         "answer": {
          "short": "$6x+2y-\\pi=0$",
          "worked": "$$\\begin{align*}y-0&=-3\\left(x-\\frac{\\pi}{6}\\right)\\\\y&=-3x+\\frac{\\pi}{2}\\\\2y&=-6x+\\pi\\\\6x+2y-\\pi&=0\\end{align*}$$"
         },
         "questionDiagrams": []
        }
       ]
      },
