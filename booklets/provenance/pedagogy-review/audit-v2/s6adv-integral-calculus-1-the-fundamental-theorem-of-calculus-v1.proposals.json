  "5331afb9-5b2a-41e4-ad60-56ed4cc02a73": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p20-geometric-areas",
     "replacement": "We will start with straightforward examples involving straight lines and semicircles to get used to the notation.\n\nArea of a rectangle (base $b$, height $h$)   \n\nArea of a triangle (base $b$, height $h$)   \n$A=bh$\n\n$A=\\frac{1}{2}bh$\nArea of a trapezium (parallel sides $a$ and $b$, height $h$)   \n\nArea of a circle (radius $r$)   \n$A=\\frac{h}{2}(a+b)$\n\n$A=\\pi r^2$",
     "autoApply": true,
     "key": "theory|p20-geometric-areas",
     "targetFingerprint": "20e7f0be46c93320c92acd773d410fd3443081a27d2fc394acd8a4e0e1660740",
     "applied": true
    }
   ],
