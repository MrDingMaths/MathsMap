          "label": "a",
          "prompt": "$f''(x)=6x+2$, $f'(0)=1$ and $f(0)=4$",
          "answerSpaceMm": 55,
          "answer": {
           "short": "$f(x)=x^3+x^2+x+4$",
           "worked": "$$\\begin{align*}f'(x)&=3x^2+2x+C_1\\\\1&=C_1\\\\f'(x)&=3x^2+2x+1\\end{align*}$$\n$$\\begin{align*}f(x)&=x^3+x^2+x+C_2\\\\4&=C_2\\\\f(x)&=x^3+x^2+x+4\\end{align*}$$"
          }
         },
         {
          "id": "v2-proposal-j4-042605-j4-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$f''(x)=2-6x$, $f'(1)=0$ and $f(2)=-3$",
          "answerSpaceMm": 55,
          "answer": {
           "short": "$f(x)=-x^3+x^2+x-1$",
           "worked": "$$\\begin{align*}f'(x)&=2x-3x^2+C_1\\\\0&=2-3+C_1\\\\C_1&=1\\\\f'(x)&=2x-3x^2+1\\end{align*}$$\n$$\\begin{align*}f(x)&=x^2-x^3+x+C_2\\\\-3&=4-8+2+C_2\\\\C_2&=-1\\\\f(x)&=-x^3+x^2+x-1\\end{align*}$$"
          }
         },
         {
          "id": "v2-proposal-j4-042605-j4-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$f''(x)=x-2$, $f'(2)=-1$ and $f(6)=1$",
          "answerSpaceMm": 55,
          "answer": {
           "short": "$f(x)=\\dfrac{x^3}{6}-x^2+x-5$",
           "worked": "$$\\begin{align*}f'(x)&=\\frac{x^2}{2}-2x+C_1\\\\-1&=2-4+C_1\\\\C_1&=1\\\\f'(x)&=\\frac{x^2}{2}-2x+1\\end{align*}$$\n$$\\begin{align*}f(x)&=\\frac{x^3}{6}-x^2+x+C_2\\\\1&=36-36+6+C_2\\\\C_2&=-5\\\\f(x)&=\\frac{x^3}{6}-x^2+x-5\\end{align*}$$"
          }
         }
        ],
