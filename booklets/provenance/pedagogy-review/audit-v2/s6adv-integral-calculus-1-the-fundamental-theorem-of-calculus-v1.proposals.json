  "0d334fbb-4818-4ead-9a29-d53975836188": {
   "kind": "theory-wording",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p19-integral-definition-block",
     "replacement": "For a curve on or above the $x$-axis, the exact area found as the limit of sums of increasingly thin rectangles is called the **definite integral**:\n\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\lim_{\\Delta x\\to0}\\sum_a^b f(x)\\,\\Delta x\\\\&=\\int_a^b f(x)\\,dx\\end{aligned}$$\n\nRead this as ‘the integral of $f(x)$ with respect to $x$, from $x=a$ to $x=b$’.\n\nThe integral symbol $\\int$ is a stretched S, for ‘sum’. From now on, use it to write the definite integral.",
     "autoApply": true,
     "key": "theory|p19-integral-definition-block",
     "targetFingerprint": "2456c59f191fbf51b4bc5d0cb32c5ac91c0456939a929ca32ce6ccade5761b77",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-integral-calculus-1-the-fundamental-theorem-of-calculus-v1/20261111-042605",
   "revision": 21
