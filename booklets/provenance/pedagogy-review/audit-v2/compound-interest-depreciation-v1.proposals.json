       "title": "",
       "content": {
        "id": "v2-proposal-j12-085704-root",
        "type": "question",
        "label": null,
        "prompt": "Find the simple interest rate that would deliver the same overall interest as each compound investment. Round to 2 decimal places.",
        "children": [
         {
          "id": "v2-proposal-j12-085704-j12-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$\\$5000$ is invested for 3 years at 6% compounded annually.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "6.37% p.a.",
           "worked": "$$\\begin{align*}FV&=5000(1.06)^3=\\$5955.08\\\\I&=5955.08-5000=\\$955.08\\\\955.08&=5000\\times r\\times3\\\\r&=\\frac{955.08}{5000\\times3}\\approx0.06367\\end{align*}$$\nThe simple interest rate is $6.37\\%$ p.a."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j12-085704-j12-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\$12\\,000$ is invested for 6 years at 4.5% compounded annually.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "5.04% p.a.",
           "worked": "$$\\begin{align*}FV&=12000(1.045)^6=\\$15\\,627.12\\\\I&=15627.12-12000=\\$3627.12\\\\3627.12&=12000\\times r\\times6\\\\r&=\\frac{3627.12}{12000\\times6}\\approx0.05038\\end{align*}$$\nThe simple interest rate is $5.04\\%$ p.a."
          },
          "questionDiagrams": []
         },
         {
          "id": "v2-proposal-j12-085704-j12-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\$20\\,000$ is invested for 2 years at 3.5% compounded annually.",
          "answerSpaceMm": 55,
          "answer": {
           "short": "3.56% p.a.",
           "worked": "$$\\begin{align*}FV&=20000(1.035)^2=\\$21\\,424.50\\\\I&=21424.50-20000=\\$1424.50\\\\1424.50&=20000\\times r\\times2\\\\r&=\\frac{1424.50}{20000\\times2}\\approx0.03561\\end{align*}$$\nThe simple interest rate is $3.56\\%$ p.a."
          },
          "questionDiagrams": []
         }
        ],
