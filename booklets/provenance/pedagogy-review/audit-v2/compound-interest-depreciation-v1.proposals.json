            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
             {
              "type": "math",
              "latex": "\\$8000",
              "display": false
             },
             {
              "type": "text",
              "text": " is invested for 4 years at 5% compounded annually. Find the simple interest rate that would deliver the same overall interest at the end of the 4 years. Round to 2 decimal places.",
              "marks": []
             }
            ]
           },
           {
            "id": "866755da-c6a6-477d-b873-ac339860655c",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
             {
              "type": "math",
              "latex": "\\begin{aligned}FV&=PV(1+r)^n\\\\FV&=8000(1.05)^4\\\\FV&=\\$9724.05\\\\I&=FV-PV\\\\I&=9724.05-8000\\\\I&=\\$1724.05\\\\I&=Prn\\\\1724.05&=8000\\times r\\times4\\\\r&=\\frac{1724.05}{8000\\times4}\\quad\\color{#ef6068}{\\div(8000\\times4)}\\\\r&\\approx0.05388\\end{aligned}",
              "display": true,
              "colour": "#268cff"
             },
             {
              "type": "break"
             },
             {
              "type": "text",
              "text": "The simple interest rate is ",
              "marks": [],
              "colour": "#268cff"
             },
             {
              "type": "math",
              "latex": "5.39\\%",
              "display": false,
              "colour": "#268cff"
             },
             {
              "type": "text",
              "text": " p.a.",
              "marks": [],
              "colour": "#268cff"
             }
            ]
           }
          ]
         }
        }
       ],
       "flow": {
        "keepTogether": true,
        "sourcePageBreakBefore": false
       },
