  "037696c5-dca4-4dad-9dde-49411073c543": {
   "kind": "theory-wording",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p51-modified-introduction",
     "replacement": "In a **modified growth or decay model**, the rate of change is proportional to the difference between the current value $Q$ and a constant value $P$.\n\nA larger difference gives faster change; a smaller difference gives slower change.\n\n$$\\text{If }Q=P+Ae^{kt},\\qquad Q(0)=\\underbrace{P+A}_{\\text{initial quantity}}$$\n$$\\begin{aligned}\\frac{dQ}{dt}&=kAe^{kt}\\\\&=k(P+Ae^{kt}-P)\\\\&=k(Q-P)\\end{aligned}$$",
     "autoApply": true,
     "key": "theory|p51-modified-introduction",
     "targetFingerprint": "b605e5ec29c34a19a04a0f02824812b9272a3086d6c9177e6ca4443a0a936e3d",
     "applied": true
    }
   ],
