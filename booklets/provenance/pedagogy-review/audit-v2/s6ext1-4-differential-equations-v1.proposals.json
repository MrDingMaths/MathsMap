          "answer": {
           "short": "$y=\\sin x+2$",
           "worked": "$$\\begin{align*}y'&=\\cos x+A\\\\1&=1+A\\\\A&=0\\\\y'&=\\cos x\\\\y&=\\sin x+B\\\\2&=0+B\\\\y&=\\sin x+2\\end{align*}$$"
          }
         },
