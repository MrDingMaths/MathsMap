          "id": "v2-proposal-j5-130426-j5-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$y''=6x-2$, given $y'(1)=3$ and $y(1)=2$.",
          "answerSpaceMm": 50,
          "answer": {
