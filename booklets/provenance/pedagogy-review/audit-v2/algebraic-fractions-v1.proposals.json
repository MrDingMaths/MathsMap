       "prompt": "A square garden bed has side length $s$ metres. A square paving slab has area $\\dfrac{4s^2}{9}$ square metres.",
       "questionDiagrams": [
        {
         "id": "v2-49160-p14-practice-slot-7-093239-s7-q-diagram",
         "format": "tikz",
         "widthMm": 70,
         "code": "\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\draw[black] (0,0) rectangle (3,3);\n\\node[anchor=south] at (1.5,3.1) {Garden bed};\n\\node[anchor=north] at (1.5,-0.1) {$s$ m};\n\\draw[black] (4.5,0) rectangle (6.5,2);\n\\node[anchor=south] at (5.5,2.1) {Paving slab};\n\\node[align=center,font=\\fontsize{9}{11}\\selectfont] at (5.5,1) {Area\\\\$\\frac{4s^2}{9}$ m$^2$};\n\\end{tikzpicture}"
        }
       ],
       "children": [
        {
         "id": "v2-49160-p14-practice-slot-7-093239-s7-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Write an expression for the side length of the paving slab.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$\\dfrac{2s}{3}$ metres",
          "worked": "$$\\begin{align*}\\left(\\frac{2s}{3}\\right)^2&=\\frac{4s^2}{9}\\\\\\text{Side length}&=\\frac{2s}{3}\\end{align*}$$"
         }
        },
        {
         "id": "v2-49160-p14-practice-slot-7-093239-s7-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Write an expression for the area of the garden bed that is not covered when the slab is laid inside it.",
         "answerSpaceMm": 35,
         "answer": {
          "short": "$\\dfrac{5s^2}{9}$ square metres",
          "worked": "$$\\begin{align*}s^2-\\frac{4s^2}{9}&=\\frac{9s^2-4s^2}{9}\\\\&=\\frac{5s^2}{9}\\end{align*}$$"
         }
        },
        {
         "id": "v2-49160-p14-practice-slot-7-093239-s7-q-c",
         "type": "part",
         "label": "c",
         "prompt": "A new square has a side length equal to the sum of the side lengths of the garden bed and the slab. Write an expression for its area.",
         "answerSpaceMm": 45,
         "answer": {
          "short": "$\\dfrac{25s^2}{9}$ square metres",
          "worked": "$$\\begin{align*}\\text{Side}&=s+\\frac{2s}{3}\\\\&=\\frac{5s}{3}\\\\\\text{Area}&=\\frac{5s}{3}\\times\\frac{5s}{3}\\\\&=\\frac{25s^2}{9}\\end{align*}$$"
         }
        }
       ]
