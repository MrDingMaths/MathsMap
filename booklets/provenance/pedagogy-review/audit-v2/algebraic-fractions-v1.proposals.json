       "label": null,
       "prompt": "A poster has length $l$ cm and width $w$ cm. Each copy of the poster has a length that is three-quarters of the length of the previous poster and a width that is two-thirds of the width of the previous poster.",
       "questionDiagrams": [
        {
         "id": "v2-49160-p14-practice-slot-8-093239-s8-q-diagram",
         "format": "tikz",
         "widthMm": 100,
         "code": "\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\draw[black] (0,0) rectangle (3,2);\n\\node[anchor=south] at (1.5,2.1) {Original};\n\\node[anchor=north] at (1.5,-0.1) {$l$};\n\\node[anchor=west] at (3.08,1) {$w$};\n\\draw[black] (4.4,0) rectangle (6.65,1.33);\n\\node[anchor=south] at (5.52,1.43) {Copy 1};\n\\draw[black] (7.95,0) rectangle (9.64,0.89);\n\\node[anchor=south] at (8.8,0.99) {Copy 2};\n\\end{tikzpicture}"
        }
       ],
       "children": [
        {
         "id": "v2-49160-p14-practice-slot-8-093239-s8-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Write an expression for the length and width of copy 1.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "Length: $\\dfrac{3l}{4}$; width: $\\dfrac{2w}{3}$.",
          "worked": "$$\\begin{align*}L_1&=\\frac34\\times l=\\frac{3l}{4}\\\\W_1&=\\frac23\\times w=\\frac{2w}{3}\\end{align*}$$"
         }
        },
        {
         "id": "v2-49160-p14-practice-slot-8-093239-s8-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Write an expression for the area of copy 1.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$\\dfrac{lw}{2}$",
          "worked": "$$\\begin{align*}A_1&=\\frac{3l}{4}\\times\\frac{2w}{3}\\\\&=\\frac{6lw}{12}\\\\&=\\frac{lw}{2}\\end{align*}$$"
         }
        },
        {
         "id": "v2-49160-p14-practice-slot-8-093239-s8-q-c",
         "type": "part",
         "label": "c",
         "prompt": "Write an expression for the area of copy 2.",
         "answerSpaceMm": 40,
         "answer": {
          "short": "$\\dfrac{lw}{4}$",
          "worked": "$$\\begin{align*}L_2&=\\frac34\\times\\frac{3l}{4}=\\frac{9l}{16}\\\\W_2&=\\frac23\\times\\frac{2w}{3}=\\frac{4w}{9}\\\\A_2&=\\frac{9l}{16}\\times\\frac{4w}{9}\\\\&=\\frac{36lw}{144}\\\\&=\\frac{lw}{4}\\end{align*}$$"
         }
        },
        {
         "id": "v2-49160-p14-practice-slot-8-093239-s8-q-d",
         "type": "part",
         "label": "d",
         "prompt": "Write an expression for the area of copy $n$.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$\\dfrac{lw}{2^n}$",
          "worked": "$$\\begin{align*}\\text{Each copy has area}&=\\frac34\\times\\frac23\\times\\text{previous area}\\\\&=\\frac12\\times\\text{previous area}\\\\A_n&=\\frac{lw}{2^n}\\end{align*}$$"
         }
        }
       ],
