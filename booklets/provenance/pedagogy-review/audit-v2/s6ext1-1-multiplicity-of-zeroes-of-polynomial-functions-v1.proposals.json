       "snapshotKind": "local",
       "bankRef": null,
       "title": "",
       "content": {
        "id": "v2-proposal-j5-091733-root",
        "type": "question",
        "label": null,
        "prompt": "Each polynomial has a double zero. Find it.",
        "children": [
         {
          "id": "v2-proposal-j5-091733-j5-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$P(x)=x^3-12x+16$",
          "answerSpaceMm": 50,
          "answer": {
           "short": "$x=2$.",
           "worked": "$$\\begin{aligned}P'(x)&=3x^2-12\\\\0&=3x^2-12\\\\x^2&=4\\\\x&=\\pm2\\end{aligned}$$\n$$\\begin{aligned}P(2)&=8-24+16=0\\\\P(-2)&=-8+24+16=32\\end{aligned}$$The double zero is $x=2$."
          }
         },
         {
          "id": "v2-proposal-j5-091733-j5-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$P(x)=2x^3-9x^2+12x-4$",
          "answerSpaceMm": 55,
          "answer": {
           "short": "$x=2$.",
           "worked": "$$\\begin{aligned}P'(x)&=6x^2-18x+12\\\\0&=x^2-3x+2\\\\0&=(x-1)(x-2)\\end{aligned}$$\n$$\\begin{aligned}P(1)&=2-9+12-4=1\\\\P(2)&=16-36+24-4=0\\end{aligned}$$The double zero is $x=2$."
          }
         },
         {
          "id": "v2-proposal-j5-091733-j5-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$P(x)=9x^3-3x^2-8x+4$",
          "answerSpaceMm": 70,
          "answer": {
           "short": "$x=\\dfrac23$.",
           "worked": "$$\\begin{aligned}P'(x)&=27x^2-6x-8\\\\0&=(3x-2)(9x+4)\\end{aligned}$$\nSo $x=\\dfrac23$ or $x=-\\dfrac49$.\n$$\\begin{aligned}P\\left(\\tfrac23\\right)&=\\tfrac83-\\tfrac43-\\tfrac{16}{3}+4=0\\\\P\\left(-\\tfrac49\\right)&=\\tfrac{500}{81}\\ne0\\end{aligned}$$The double zero is $x=\\dfrac23$."
          }
         }
        ],
