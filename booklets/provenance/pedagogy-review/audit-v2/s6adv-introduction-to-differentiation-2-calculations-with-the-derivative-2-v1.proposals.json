         {
          "id": "v2-proposal-j7-121852-j7-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$y=\\dfrac{2x^3+x^2-x}{2x-1}$",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$y'=2x+1$, for $x\\ne\\frac12$.",
           "worked": "For $x\\ne\\frac12$,\n$$\\begin{aligned}y&=\\frac{x(2x^2+x-1)}{2x-1}\\\\y&=\\frac{x(2x-1)(x+1)}{2x-1}\\\\y&=x^2+x\\\\y'&=2x+1\\end{aligned}$$"
          }
         },
         {
          "id": "v2-proposal-j7-121852-j7-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$y=\\dfrac{x^4-81}{x+3}$",
          "answerSpaceMm": 50,
          "answer": {
           "short": "$y'=3x^2-6x+9$, for $x\\ne-3$.",
           "worked": "For $x\\ne-3$,\n$$\\begin{aligned}y&=\\frac{(x^2-9)(x^2+9)}{x+3}\\\\y&=\\frac{(x-3)(x+3)(x^2+9)}{x+3}\\\\y&=(x-3)(x^2+9)\\\\y&=x^3-3x^2+9x-27\\\\y'&=3x^2-6x+9\\end{aligned}$$"
          }
         }
        ],
