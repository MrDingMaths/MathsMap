  "38036ba7-630d-4051-85ce-f4f3c9435e3a": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p9-summary-text",
     "replacement": "The **gradient** of a linear function is its **rate of change**.\n\nWe calculate the **average rate of change** of a curved function by drawing a **secant line** between two points on the curve and finding its gradient.\n\nA **tangent** line to a curve at a point is a straight line that passes through that point and has the same slope as the curve at that location.\n\nThe **instantaneous rate of change** of a function at a point is the gradient of the tangent at that point.\n\nWe call the instantaneous rate of change at $x=a$ the **derivative** at $a$.\n\nWe write the derivative of $f(x)$ at $x=a$, which is the gradient of the tangent there, as $f'(a)$, read as “$f$ prime $a$.”",
     "autoApply": true,
     "key": "theory|p9-summary-text",
     "targetFingerprint": "0fa4125a4ef7ecb6ef367f83ce015a62378f1dcab332f6462f4e703f9531e225",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-introduction-to-differentiation-1-estimating-change-and-the-derivative-v1/20261111-044346",
   "revision": 15
  },
  "91ed514f-3863-4e58-93bb-7e90cc0df0b2": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p14-gradient-block",
     "replacement": "For a function $y=f(x)$, the **derivative function** $f'(x)$, also called the **gradient function**, gives the gradient of the tangent to the graph at each $x$ where the tangent exists.\n\nWe can write the derivative as $\\dfrac{dy}{dx}$ or $f'(x)$ or $y'$.\n\nWe call the process of finding the derivative **differentiation**.",
     "autoApply": true,
     "key": "theory|p14-gradient-block",
     "targetFingerprint": "498ad233eb733ab7290085862fbeb936eb377e7ad0d5b0781b286e5936001473",
     "applied": true
    }
   ],
