    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/fractional-indices-v1/20261109-224221",
   "revision": 40
  },
  "5a91696f-b914-42e8-b633-00d20ed856ee": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p21-information-block",
     "replacement": "- An **exponential equation** has a pronumeral in an index.\n- For example: $2^x=8$ and $3^{2x}-3^x-6=0$.\n- To solve an exponential equation by matching bases, when both sides can be written as powers of the same base $a$ (with $a>0$ and $a\\ne1$):\n  1. Rewrite all terms as powers of that base, using the smallest possible base number.\n  2. Equate the indices: if $a^m=a^n$ then $m=n$.",
     "autoApply": true,
     "key": "theory|p21-information-block",
     "targetFingerprint": "a8734b216ad734b4b05c1edb696ed125ea71795ff7f6356848ad90a48a044dde",
     "applied": true
    }
   ],
