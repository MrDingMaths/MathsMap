       "type": "question",
       "label": null,
       "prompt": "$f(x)=x^3-6x^2+kx$, where $k$ is a constant.",
       "children": [
        {
         "id": "v2-4-practice-section-j6-075135-j6-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Find $f'(x)$.",
         "answerSpaceMm": 20,
         "answer": {
          "short": "$f'(x)=3x^2-12x+k$.",
          "worked": "$$f'(x)=3x^2-12x+k$$"
         }
        },
        {
         "id": "v2-4-practice-section-j6-075135-j6-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Find the discriminant of $f'(x)$ in terms of $k$.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$\\Delta=144-12k$.",
          "worked": "$$\\begin{align*}\\Delta&=b^2-4ac\\\\&=(-12)^2-4(3)(k)\\\\&=144-12k\\end{align*}$$"
         }
        },
        {
         "id": "v2-4-practice-section-j6-075135-j6-q-c",
         "type": "part",
         "label": "c",
         "prompt": "Hence find the values of $k$ for which $f(x)$ is never decreasing.",
         "answerSpaceMm": 40,
         "answer": {
          "short": "$k\\geq12$.",
          "worked": "$f(x)$ is never decreasing when $f'(x)\\geq0$ for all $x$. The parabola $y=f'(x)$ opens upward, so this happens when it does not cross the $x$-axis, that is when $\\Delta\\leq0$.\n$$\\begin{align*}144-12k&\\leq0\\\\k&\\geq12\\end{align*}$$"
         }
        }
       ]
      },
