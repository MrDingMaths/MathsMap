        "id": "v2-proposal-j3-075135-root",
        "type": "question",
        "label": null,
        "prompt": "Show that each function is increasing or decreasing as stated, for its entire domain.",
        "children": [
         {
          "id": "v2-proposal-j3-075135-j3-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$y=\\sqrt{x+4}$ is increasing.",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$y'=\\dfrac{1}{2\\sqrt{x+4}}>0$ for $x>-4$, and $y(-4)=0<\\sqrt{x+4}$ for $x>-4$.",
           "worked": "The domain is $x\\geq-4$.\n$$\\begin{align*}y'&=\\tfrac12(x+4)^{-1/2}\\\\&=\\frac{1}{2\\sqrt{x+4}}>0\\qquad(x>-4)\\end{align*}$$\nAt $x=-4$ the derivative is undefined, but $y(-4)=0<\\sqrt{x+4}$ for every $x>-4$. So $y$ is increasing on $[-4,\\infty)$."
          }
         },
         {
          "id": "v2-proposal-j3-075135-j3-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$y=3+2\\sqrt{x}$ is increasing.",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$y'=\\dfrac{1}{\\sqrt{x}}>0$ for $x>0$, and $y(0)=3<3+2\\sqrt{x}$ for $x>0$.",
           "worked": "The domain is $x\\geq0$.\n$$\\begin{align*}y'&=2\\cdot\\tfrac12x^{-1/2}\\\\&=\\frac{1}{\\sqrt{x}}>0\\qquad(x>0)\\end{align*}$$\nAt $x=0$ the derivative is undefined, but $y(0)=3<3+2\\sqrt{x}$ for every $x>0$. So $y$ is increasing on $[0,\\infty)$."
          }
         },
         {
          "id": "v2-proposal-j3-075135-j3-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$y=6-\\sqrt{x}$ is decreasing.",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$y'=-\\dfrac{1}{2\\sqrt{x}}<0$ for $x>0$, and $y(0)=6>6-\\sqrt{x}$ for $x>0$.",
           "worked": "The domain is $x\\geq0$.\n$$\\begin{align*}y'&=-\\tfrac12x^{-1/2}\\\\&=-\\frac{1}{2\\sqrt{x}}<0\\qquad(x>0)\\end{align*}$$\nAt $x=0$ the derivative is undefined, but $y(0)=6>6-\\sqrt{x}$ for every $x>0$. So $y$ is decreasing on $[0,\\infty)$."
          }
         }
        ],
