         "id": "v2-7bec8-p22-practice-j4-104354-j4-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Hence, simplify $\\sqrt{450}$.",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$15\\sqrt{2}$",
          "worked": "The highest square factor is $225$.\n$$\\begin{align*}\\sqrt{450}&=\\sqrt{225\\times2}\\\\&=\\sqrt{225}\\times\\sqrt{2}\\\\&=15\\sqrt{2}\\end{align*}$$"
         }
