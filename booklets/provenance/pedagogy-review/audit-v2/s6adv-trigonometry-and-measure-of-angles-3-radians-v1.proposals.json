       "content": {
        "id": "v2-proposal-j7-084058-root",
        "type": "question",
        "label": null,
        "prompt": "A chord $AB$ cuts a minor segment from a circle with centre $O$. Find the area of the segment when:",
        "children": [
         {
          "id": "v2-proposal-j7-084058-j7-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$r=4\\text{ cm}$ and $\\angle AOB=\\frac{\\pi}{2}$, in exact form.",
          "answerSpaceMm": 40,
          "answer": {
           "short": "$(4\\pi-8)\\text{ cm}^2$",
           "worked": "$$\\begin{align*}A_{\\text{sector}}&=\\frac12(4)^2\\left(\\frac{\\pi}{2}\\right)=4\\pi\\\\A_{\\triangle}&=\\frac12(4)^2\\sin\\frac{\\pi}{2}=8\\\\A_{\\text{segment}}&=4\\pi-8\\text{ cm}^2\\end{align*}$$"
          }
         },
         {
          "id": "v2-proposal-j7-084058-j7-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$r=3\\text{ cm}$ and $\\angle AOB=120^{\\circ}$, in exact form.",
          "answerSpaceMm": 45,
          "answer": {
           "short": "$\\left(3\\pi-\\frac{9\\sqrt3}{4}\\right)\\text{ cm}^2$",
           "worked": "$$\\begin{align*}\\theta&=120^{\\circ}=\\frac{2\\pi}{3}\\\\A_{\\text{sector}}&=\\frac12(3)^2\\left(\\frac{2\\pi}{3}\\right)=3\\pi\\\\A_{\\triangle}&=\\frac12(3)^2\\sin\\frac{2\\pi}{3}=\\frac92\\times\\frac{\\sqrt3}{2}=\\frac{9\\sqrt3}{4}\\\\A_{\\text{segment}}&=3\\pi-\\frac{9\\sqrt3}{4}\\text{ cm}^2\\end{align*}$$"
          }
         },
         {
          "id": "v2-proposal-j7-084058-j7-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$r=10\\text{ cm}$ and $\\angle AOB=1.2$ radians, to 2 d.p.",
          "answerSpaceMm": 40,
          "answer": {
           "short": "$13.40\\text{ cm}^2$",
           "worked": "$$\\begin{align*}A_{\\text{sector}}&=\\frac12(10)^2(1.2)=60\\\\A_{\\triangle}&=\\frac12(10)^2\\sin1.2\\approx46.60\\\\A_{\\text{segment}}&=60-46.60\\\\&\\approx13.40\\text{ cm}^2\\end{align*}$$"
          }
         }
        ],
