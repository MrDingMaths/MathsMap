       "prompt": "A sector has radius $6\\text{ cm}$ and arc length $9\\text{ cm}$.",
       "children": [
        {
         "id": "v2-8cb27-p12-practice-j8-084058-j8-q-a",
         "type": "part",
         "label": "a",
         "prompt": "Find the angle subtended at the centre in radians.",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$\\frac32\\text{ radians}$",
          "worked": "$$\\begin{align*}l&=r\\theta\\\\9&=6\\theta\\\\\\theta&=\\frac32\\text{ radians}\\end{align*}$$"
         }
        },
        {
         "id": "v2-8cb27-p12-practice-j8-084058-j8-q-b",
         "type": "part",
         "label": "b",
         "prompt": "Hence find the area of the sector.",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$27\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac12r^2\\theta\\\\&=\\frac12(6)^2\\left(\\frac32\\right)\\\\&=27\\text{ cm}^2\\end{align*}$$"
         }
        },
        {
         "id": "v2-8cb27-p12-practice-j8-084058-j8-q-c",
         "type": "part",
         "label": "c",
         "prompt": "Show that $A=\\frac12rl$ by substituting $l=r\\theta$ into $A=\\frac12r^2\\theta$.",
         "answerSpaceMm": 30,
         "answer": {
          "short": "$A=\\frac12rl$",
          "worked": "$$\\begin{align*}A&=\\frac12r^2\\theta\\\\&=\\frac12r(r\\theta)\\\\&=\\frac12rl\\end{align*}$$"
         }
        },
        {
         "id": "v2-8cb27-p12-practice-j8-084058-j8-q-d",
         "type": "part",
         "label": "d",
         "prompt": "A sector has radius $12\\text{ cm}$ and arc length $5\\pi\\text{ cm}$. Use the formula in part c to find its area in exact form.",
         "answerSpaceMm": 25,
         "answer": {
          "short": "$30\\pi\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac12rl\\\\&=\\frac12(12)(5\\pi)\\\\&=30\\pi\\text{ cm}^2\\end{align*}$$"
         }
        }
       ]
