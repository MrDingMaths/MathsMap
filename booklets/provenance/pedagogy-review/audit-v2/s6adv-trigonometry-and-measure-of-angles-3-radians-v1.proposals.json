  "3ed43209-8086-449f-aa26-46032da8f8ac": {
   "kind": "theory-definition",
   "payloads": [
    {
     "op": "theory",
     "blockId": "p3-definition",
     "replacement": "- Babylonians chose degrees as an arbitrary unit of angle.\n  We use **radians** instead, which measure an angle using the circle itself.\n- One **radian** is the angle at the centre of a circle subtended by an arc equal in length to the radius.\n- An angle in radians is the **dimensionless ratio** of arc length to radius: an arc of length $l$ on a circle of radius $r$ subtends $\\frac{l}{r}$ radians.",
     "autoApply": true,
     "key": "theory|p3-definition",
     "targetFingerprint": "6cc72cef239b90b0f7330f85b95a0d49182c2238fffffa8e62a5e4a9fcfd91b0",
     "applied": true
    }
   ],
   "run": ".booklet-work/pedagogy-audit-v2/s6adv-trigonometry-and-measure-of-angles-3-radians-v1/20261111-084058",
   "revision": 29
  },
