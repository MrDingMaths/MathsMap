    "examples": [
      {
        "question_text": "(a) Which consecutive multiples of $6$ enclose $43$? Use them to calculate $43\\div6$.\n(b) Calculate $42\\div6$ and record the remainder.",
        "solution_text": "(a) $6\\times7=42$ and $6\\times8=48$.\n$42<43<48$, so $7$ complete groups fit.\n$43-42=1$.\n$43\\div6=7$ remainder $1$.\n(b) $6\\times7=42$.\n$42-42=0$.\n$42\\div6=7$ remainder $0$.\nHere the multiplication fact gives the exact total, so nothing is left over."
      },
      {
        "question_text": "A student uses $7\\times10=70$ to calculate $65\\div7$. Explain the adjustment and calculate the division.",
        "solution_text": "$70$ is too high, so use one fewer group:\n$7\\times9=63$.\n$65-63=2$.\n$65\\div7=9$ remainder $2$.\nThe remainder $2$ is less than $7$."
      },
      {
        "question_text": "Complete $79\\div9=8$ remainder $r$. Check your answer using multiplication.",
        "solution_text": "The $8$ complete groups contain $9\\times8=72$.\n$r=79-72=7$.\n$79\\div9=8$ remainder $7$.\nCheck: $9\\times8+7=72+7=79$, and $7<9$."
      },
      {
        "question_text": "Use $9\\times10=90$ to calculate $94\\div9$. Explain why the remainder is valid.",
        "solution_text": "$9\\times10=90$ and $9\\times11=99$.\n$90<94<99$, so $10$ complete groups fit.\n$94-90=4$.\n$94\\div9=10$ remainder $4$.\nThe remainder $4$ is less than $9$."
      }
    ],
    "methods": [
      {
        "id": "lower-multiple",
        "description": "Use a known multiplication fact giving the largest multiple at or below the dividend; subtract to find the remainder, including zero.",
        "sourceRef": "syllabus/Stage 3 Content.md — Multiplicative relations A, Represent and solve division problems with whole number remainders; example question 27 ÷ 6."
      },
      {
        "id": "consecutive-multiples",
        "description": "Locate the dividend between consecutive multiples to identify the quotient, then subtract the lower multiple.",
        "sourceRef": "syllabus/Stage 3 Content.md — Multiplicative relations A, Represent and solve division problems with whole number remainders; example question 27 ÷ 6 using 4 × 6 = 24 and 5 × 6 = 30."
      },
      {
        "id": "adjust-too-high",
        "description": "Reduce the number of groups when a recalled multiple exceeds the dividend, then calculate the remainder.",
        "sourceRef": "syllabus/Stage 3 Content.md — Multiplicative relations A, Represent and solve division problems with whole number remainders; example question 27 ÷ 6, rejecting 5 × 6 = 30 in favour of 4 × 6 = 24."
      },
      {
        "id": "find-and-check-remainder",
        "description": "With the quotient known, subtract divisor times quotient; check that multiplication plus the remainder reconstructs the dividend and the remainder is smaller than the divisor.",
        "sourceRef": "syllabus/Stage 3 Content.md — Multiplicative relations A, Represent and solve division problems with whole number remainders; example question 25 ÷ 4 = 6 remainder 1, connected to 25 = 4 × 6 + 1."
      },
