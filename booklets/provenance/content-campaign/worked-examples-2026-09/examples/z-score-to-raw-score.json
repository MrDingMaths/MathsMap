    "examples": [
      {
        "question_text": "A test has mean $47.8$ and standard deviation $6.5$.\n(a) Find the mark with $z=1.3$.\n(b) Find the mark that is $1.7$ standard deviations below the mean. Give exact answers.",
        "solution_text": "Use $x=\\mu+z\\sigma$.\n\n(a)\n$\\begin{align*}x&=47.8+1.3\\times6.5\\\\&=47.8+8.45\\\\&=56.25\\end{align*}$\n\n(b) Below the mean means $z=-1.7$.\n$\\begin{align*}x&=47.8+(-1.7)\\times6.5\\\\&=47.8-11.05\\\\&=36.75\\end{align*}$\n\nThe positive score gives a mark above the mean; the negative score gives one below it."
      },
      {
        "question_text": "The monthly rainfall at a station has a mean of $62$ mm and a standard deviation of $2.4$ mm. Find the rainfall corresponding to a standardised score of $2.7$, correct to one decimal place.",
        "solution_text": "$\\begin{align*}x&=\\mu+z\\sigma\\\\&=62+2.7\\times2.4\\\\&=62+6.48\\\\&=68.48\\end{align*}$\n\nThe rainfall is $68.5$ mm, correct to one decimal place."
      },
      {
        "question_text": "A reading test has a mean mark of $68.4$ and a standard deviation of $7.6$. A student achieved a $z$-score of $-2.25$. What was the student's actual mark?",
        "solution_text": "$\\begin{align*}x&=\\mu+z\\sigma\\\\&=68.4+(-2.25)\\times7.6\\\\&=68.4-17.1\\\\&=51.3\\end{align*}$"
      }
    ],
