    "examples": [
      {
        "question_text": "Find the HCF.\n(a) $18m$ and $30m$\n(b) $18m$ and $30n$",
        "solution_text": "(a) The HCF of $18$ and $30$ is $6$. Both terms have a factor of $m$.\n$\\text{HCF}=6m$\n(b) The HCF of the coefficients is still $6$. There is no common pronumeral factor.\n$\\text{HCF}=6$"
      },
      {
        "question_text": "Find the HCF.\n(a) $r^3$ and $r^5$\n(b) $14a^2b^2$ and $21ab^3$",
        "solution_text": "(a) Both terms have at least three factors of $r$. Take the lower power.\n$\\text{HCF}=r^3$\n(b) The HCF of $14$ and $21$ is $7$. The common pronumeral part is $ab^2$: take the lower power of each pronumeral.\n$\\text{HCF}=7ab^2$"
      },
      {
        "question_text": "Find the HCF of $9p^2q$ and $10p^3$. Explain why $q$ is not included.",
        "solution_text": "The only common numerical factor of $9$ and $10$ is $1$. Both terms contain $p^2$, the lower power of $p$. The pronumeral $q$ appears only in the first term.\n$\\text{HCF}=p^2$\nCheck the common factor by multiplication:\n$p^2\\times9q=9p^2q$\n$p^2\\times10p=10p^3$"
      }
    ],
    "methods": [
      {
        "id": "coefficient-hcf",
        "description": "Find the highest common positive whole-number factor of the coefficients.",
        "sourceRef": "booklets/mathsmap-sources/Stage 4/Algebraic Techniques 4_Factorise Expressions.md lines 474–477, Key Ideas 1a"
