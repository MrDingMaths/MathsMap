    "examples": [
      {
        "question_text": "Round to two decimal places.\na. $14.895$\nb. $29.997$",
        "solution_text": "a. The rounding place is the hundredths $9$. The critical digit is $5$, so round up.\n$9+1=10$: write $0$ in the hundredths and carry $1$ into the tenths.\nThe tenths $8$ becomes $9$. Keep two decimal places.\n$14.895\\approx14.90$\nb. The critical digit is $7$, so round the hundredths $9$ up.\nWrite $0$ and carry $1$ into the tenths $9$, which also becomes $0$ and carries.\nThe ones $9$ becomes $0$ and carries into the tens $2$, making $3$.\nKeep two decimal places.\n$29.997\\approx30.00$"
      },
      {
        "question_text": "A student rounds $5.9997$ to three decimal places and writes $5.990$. Explain the mistake and give the correct answer.",
        "solution_text": "The critical digit is $7$, so the thousandths $9$ must round up.\nWriting $0$ without carrying leaves $5.990$. The carry must continue through the hundredths and tenths $9$s into the ones.\nKeep three decimal places.\n$5.9997\\approx6.000$"
      },
      {
        "question_text": "Round $6.98$ to one decimal place.",
        "solution_text": "The rounding place is the tenths $9$. The critical digit is $8$, so round up.\n$9+1=10$: write $0$ in the tenths and carry $1$ into the ones.\nThe ones $6$ becomes $7$. Keep one decimal place.\n$6.98\\approx7.0$"
      }
    ],
    "methods": [
      {
