    "examples": [
      {
        "question_text": "$12\\%$ of a mass is $53$ kg. Find:\n(a) the full mass\n(b) $35\\%$ of the mass.\nGive answers to two decimal places.",
        "solution_text": "First find $1\\%$. Keep its exact value until the final answers.\n$1\\%=53\\div12=\\dfrac{53}{12}\\text{ kg}$.\n(a) $100\\%=\\dfrac{53}{12}\\times100=\\dfrac{1325}{3}\\text{ kg}\\approx441.67\\text{ kg}$.\n(b) $35\\%=\\dfrac{53}{12}\\times35=\\dfrac{1855}{12}\\text{ kg}\\approx154.58\\text{ kg}$."
      },
      {
        "question_text": "$40\\%$ of an amount is $\\$86$. Use $10\\%$ as the unit to find:\n(a) $15\\%$ of the amount\n(b) the full amount.",
        "solution_text": "$40\\%$ is four lots of $10\\%$, so divide by $4$.\n$10\\%=\\$86\\div4=\\$21.50$.\n(a) $5\\%=\\$21.50\\div2=\\$10.75$.\n$15\\%=\\$21.50+\\$10.75=\\$32.25$.\n(b) $100\\%=\\$21.50\\times10=\\$215$."
      },
      {
        "question_text": "Each student chooses one lunchtime activity. $26\\%$ choose sport and $38\\%$ choose music. The other $234$ students choose art. How many students are there?",
        "solution_text": "The $234$ students are the remaining share.\nArt $=100\\%-26\\%-38\\%=36\\%$.\n$1\\%=234\\div36=6.5$ students.\n$100\\%=6.5\\times100=650$ students.\nThere are $650$ students. The $1\\%$ value is a calculation step, not a separate group of students."
      },
      {
        "question_text": "$50\\%$ of an amount of money is $\\$18.75$. What is the full amount?",
        "solution_text": "$50\\%=\\$18.75$.\n$100\\%$ is twice $50\\%$, so double the given value.\nFull amount $=\\$18.75\\times2=\\$37.50$."
      }
    ],
    "methods": [
      {
        "id": "unitary-full",
        "description": "Divide the given value by its percentage to find 1%, then multiply by 100 to find the whole. Keep exact values until final rounding.",
        "sourceRef": "booklets/mathsmap-sources/Stage 4/Fractions Decimals Percentages 6_Percentages Problems.md lines 600–631, Example"
      },
      {
        "id": "unitary-other",
        "description": "Find 1% from the given percentage, then multiply by the required percentage, including percentages above 100%.",
        "sourceRef": "booklets/mathsmap-sources/Stage 4/Fractions Decimals Percentages 6_Percentages Problems.md lines 648–650, Guided Practice c–d; lines 717–731, Question 2e–h"
      },
      {
        "id": "complement-full",
        "description": "Subtract the stated shares from 100% to identify the percentage represented by the remaining group, then use the unitary method to find the whole.",
        "sourceRef": "booklets/mathsmap-sources/Stage 4/Fractions Decimals Percentages 6_Percentages Problems.md lines 832–850, Questions 11–13"
      },
      {
        "id": "ten-percent-unit",
        "description": "Use 10% as a convenient unit; halve it for 5%, combine units for another percentage, or multiply by 10 for the whole.",
        "sourceRef": "booklets/mathsmap-sources/Stage 4/Fractions Decimals Percentages 6_Percentages Problems.md lines 751–819, Questions 5–9"
