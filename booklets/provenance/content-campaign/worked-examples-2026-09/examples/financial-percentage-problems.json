    "examples": [
      {
        "question_text": "(a) A desk costs $\\$238$ before GST. Find the GST and the price including GST.\n(b) The GST payable on another item is $\\$14.70$. Find the pre-GST price and the price including GST.",
        "solution_text": "(a) $100\\%=\\$238$.\n$10\\%=\\$238\\div10=\\$23.80$.\nGST is $\\$23.80$.\nPrice including GST $=\\$238+\\$23.80=\\$261.80$.\n(b) $10\\%=\\$14.70$.\n$100\\%=\\$14.70\\times10=\\$147$.\nPrice including GST $=\\$147+\\$14.70=\\$161.70$."
      },
      {
        "question_text": "A scanner costs $\\$257.40$ including GST. Find the GST amount and the pre-GST price.",
        "solution_text": "$110\\%=\\$257.40$.\n$10\\%=\\$257.40\\div11=\\$23.40$.\nGST is $\\$23.40$.\n$100\\%=\\$23.40\\times10=\\$234$.\nThe pre-GST price is $\\$234$."
      },
      {
        "question_text": "Find the percentage profit or loss:\n(a) An item costs $\\$320$ and sells for $\\$376$.\n(b) An item costs $\\$450$ and sells for $\\$351$.",
        "solution_text": "(a) $\\$376-\\$320=\\$56$ profit.\n$\\dfrac{56}{320}\\times100=17.5\\%$ profit.\n(b) $\\$351-\\$450=-\\$99$, so the loss is $\\$99$.\n$\\dfrac{99}{450}\\times100=22\\%$ loss."
      },
      {
        "question_text": "A shop makes a $32\\%$ profit by selling an item for $\\$475.20$. Find the cost price.",
        "solution_text": "The selling price represents $100\\%+32\\%=132\\%$ of cost price.\n$132\\%=\\$475.20$.\n$1\\%=\\$475.20\\div132=\\$3.60$.\n$100\\%=\\$3.60\\times100=\\$360$.\nThe cost price was $\\$360$."
      },
      {
        "question_text": "Two repair quotes cover the same work. Quote A is $\\$287$ before GST. Quote B is $\\$318.45$ including GST. Which is cheaper, and by how much?",
        "solution_text": "Quote A including GST $=\\$287\\times1.1=\\$315.70$.\nQuote B including GST $=\\$318.45$.\n$\\$318.45-\\$315.70=\\$2.75$.\nQuote A is cheaper by $\\$2.75$."
      }
    ],
