    "examples": [
      {
        "question_text": "Verify whether each given value is a solution.\n(a) $x=-3$ in $2x+7=1$\n(b) $y=\\frac34$ in $8y=6$\n(c) $t=5$ in $t-2=4$",
        "solution_text": "Substitute the given value, evaluate, then compare.\n(a) LHS $=2(-3)+7=-6+7=1$. RHS $=1$.\nLHS $=$ RHS, so $x=-3$ is a solution.\n(b) LHS $=8\\left(\\frac34\\right)=6$. RHS $=6$.\nLHS $=$ RHS, so $y=\\frac34$ is a solution.\n(c) LHS $=(5)-2=3$. RHS $=4$.\nLHS $\\ne$ RHS, so $t=5$ is not a solution."
      },
      {
        "question_text": "Verify whether $p=4$ is a solution of $3p+2=2p+6$.",
        "solution_text": "Evaluate both sides using the same given value.\nLHS $=3(4)+2=14$.\nRHS $=2(4)+6=14$.\nLHS $=$ RHS, so $p=4$ is a solution."
      },
      {
        "question_text": "Verify whether each given value is a solution.\n(a) $x=-1$ in $3x+1=7$\n(b) $x=2$ in $3x+1=7$\n(c) $x=5$ in $3x+1=7$",
        "solution_text": "(a) LHS $=3(-1)+1=-2$. RHS $=7$.\nLHS $\\ne$ RHS, so $x=-1$ is not a solution.\n(b) LHS $=3(2)+1=7$. RHS $=7$.\nLHS $=$ RHS, so $x=2$ is a solution.\n(c) LHS $=3(5)+1=16$. RHS $=7$.\nLHS $\\ne$ RHS, so $x=5$ is not a solution."
      },
      {
        "question_text": "Verify whether $x=-2$ is a solution of $4(x+1)=4x+4$.",
        "solution_text": "LHS $=4(-2+1)=-4$.\nRHS $=4(-2)+4=-4$.\nLHS $=$ RHS, so $x=-2$ is a solution."
      },
      {
        "question_text": "Verify whether $x=-3.5$ is a solution of $\\frac{4x}{7}+3=1$.",
        "solution_text": "Substitute into the LHS and evaluate.\n$\\begin{aligned}\\text{LHS}&=\\frac{4(-3.5)}{7}+3\\\\&=\\frac{-14}{7}+3\\\\&=-2+3\\\\&=1\\end{aligned}$\nRHS $=1$.\nLHS $=$ RHS, so $x=-3.5$ is a solution."
      }
    ],
