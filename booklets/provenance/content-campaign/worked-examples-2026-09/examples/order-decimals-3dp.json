    "examples": [
      {
        "question_text": "Order $6.238$, $6.28$, $7.03$ and $6.280$:\n(a) from smallest to largest\n(b) from largest to smallest.\nKeep equal values together.",
        "solution_text": "Compare the whole-number parts first: $7.03$ is greater than the values beginning with $6$.\nWrite $6.28=6.280$.\n$6.238<6.280$ because their tenths match and $3$ hundredths is less than $8$ hundredths.\n(a) $6.238<6.28=6.280<7.03$\n(b) $7.03>6.28=6.280>6.238$"
      },
      {
        "question_text": "Which decimal is greater in each pair?\n(a) $2.406$ or $2.46$\n(b) $1.37$ or $1.369$",
        "solution_text": "(a) Write $2.46=2.460$. The whole-number parts and tenths match. Compare hundredths: $6>0$, so $2.46>2.406$.\n(b) Write $1.37=1.370$. The whole-number parts and tenths match. Compare hundredths: $7>6$, so $1.37>1.369$."
      }
    ],
    "methods": [
