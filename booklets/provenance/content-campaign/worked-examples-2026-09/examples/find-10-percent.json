    "examples": [
      {
        "question_text": "Find $10\\%$ of each amount.\n(a) $73$ litres\n(b) $6.8$ kilograms",
        "solution_text": "$10\\%$ is one tenth, so divide each whole by $10$.\n(a) $73\\div10=7.3$ litres\n(b) $6.8\\div10=0.68$ kilograms"
      },
      {
        "question_text": "A fund contains $\\$430$. Use $10\\%$ to find:\n(a) $20\\%$ of the fund\n(b) $5\\%$ of the fund.",
        "solution_text": "$10\\%$ is $\\$430\\div10=\\$43$.\n(a) Double this amount: $\\$43\\times2=\\$86$.\n(b) Halve it: $\\$43\\div2=\\$21.50$."
      },
      {
        "question_text": "Find $15\\%$ of a $370$ kilogram supply.",
        "solution_text": "$10\\%$ is $370\\div10=37$ kg.\n$5\\%$ is half of this: $37\\div2=18.5$ kg.\n$15\\%$ is $37+18.5=55.5$ kg."
      },
      {
        "question_text": "Find $20\\%$ of a $\\$460$ donation.",
        "solution_text": "$10\\%$ is $\\$460\\div10=\\$46$.\n$20\\%$ is $\\$46\\times2=\\$92$."
      },
      {
        "question_text": "The whole bar represents $500$ litres, divided into ten equal parts. Find $10\\%$ of the whole.\n[tikz]% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"template ten-percent-bar-question\"}\n\\begin{tikzpicture}[x=1mm,y=1mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-0.6,-10.6) rectangle (50.6,0.6);\n\\draw[black,line width=0.4pt] (5,0)--(5,-10);\n\\draw[black,line width=0.4pt] (10,0)--(10,-10);\n\\draw[black,line width=0.4pt] (15,0)--(15,-10);\n\\draw[black,line width=0.4pt] (20,0)--(20,-10);\n\\draw[black,line width=0.4pt] (25,0)--(25,-10);\n\\draw[black,line width=0.4pt] (30,0)--(30,-10);\n\\draw[black,line width=0.4pt] (35,0)--(35,-10);\n\\draw[black,line width=0.4pt] (40,0)--(40,-10);\n\\draw[black,line width=0.4pt] (45,0)--(45,-10);\n\\draw[black,line width=0.8pt] (0,0) rectangle (50,-10);\n\\end{tikzpicture}[/tikz]",
        "solution_text": "One of the ten equal parts represents $\\frac{1}{10}=10\\%$ of the whole.\n[tikz]% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"templateShade\",\"hex\":\"D4E8FF\",\"reason\":\"Identify the one tenth of the whole that represents 10%.\"}],\"reference\":\"template ten-percent-bar-solution\"}\n\\begin{tikzpicture}[x=1mm,y=1mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{templateShade}{HTML}{D4E8FF}\n\\path[use as bounding box] (-0.6,-10.6) rectangle (50.6,0.6);\n\\fill[templateShade] (0,-10) rectangle (5,0);\n\\draw[black,line width=0.4pt] (5,0)--(5,-10);\n\\draw[black,line width=0.4pt] (10,0)--(10,-10);\n\\draw[black,line width=0.4pt] (15,0)--(15,-10);\n\\draw[black,line width=0.4pt] (20,0)--(20,-10);\n\\draw[black,line width=0.4pt] (25,0)--(25,-10);\n\\draw[black,line width=0.4pt] (30,0)--(30,-10);\n\\draw[black,line width=0.4pt] (35,0)--(35,-10);\n\\draw[black,line width=0.4pt] (40,0)--(40,-10);\n\\draw[black,line width=0.4pt] (45,0)--(45,-10);\n\\draw[black,line width=0.8pt] (0,0) rectangle (50,-10);\n\\end{tikzpicture}[/tikz]\nEach part represents $500\\div10=50$ litres."
