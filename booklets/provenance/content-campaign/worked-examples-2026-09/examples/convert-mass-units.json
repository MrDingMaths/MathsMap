    "examples": [
      {
        "question_text": "Convert to the smaller unit.\n(a) $2.483$ kg to grams\n(b) $3.067$ t to kilograms",
        "solution_text": "(a) $1\\text{ kg}=1000\\text{ g}$, so multiply by $1000$.\n$2.483\\times1000=2483$.\n$2.483\\text{ kg}=2483\\text{ g}$.\n(b) $1\\text{ t}=1000\\text{ kg}$, so multiply by $1000$.\n$3.067\\times1000=3067$.\n$3.067\\text{ t}=3067\\text{ kg}$."
      },
      {
        "question_text": "Convert to the larger unit.\n(a) $74$ g to kilograms\n(b) $83$ kg to tonnes",
        "solution_text": "(a) $74\\div1000=0.074$.\n$74\\text{ g}=0.074\\text{ kg}$.\n(b) $83\\div1000=0.083$.\n$83\\text{ kg}=0.083\\text{ t}$.\nUse zeros to hold the empty tenths places."
      },
      {
        "question_text": "Write each mass in grams.\n(a) $2.057$ kg\n(b) $0.014$ t",
        "solution_text": "(a) Convert kilograms to grams.\n$2.057\\times1000=2057$.\n$2.057\\text{ kg}=2057\\text{ g}$.\n(b) Convert tonnes to kilograms first.\n$0.014\\times1000=14$, so $0.014\\text{ t}=14\\text{ kg}$.\nThen convert kilograms to grams.\n$14\\times1000=14000$.\n$0.014\\text{ t}=14000\\text{ g}$."
      },
      {
        "question_text": "Convert $768\\,000\\text{ g}$ to tonnes.",
        "solution_text": "Convert grams to kilograms first.\n$\\begin{aligned}&\\mathrel{\\phantom{=}}768\\,000\\div1000\\\\&=768\\end{aligned}$\n$768\\,000\\text{ g}=768\\text{ kg}$.\nThen convert kilograms to tonnes.\n$\\begin{aligned}&\\mathrel{\\phantom{=}}768\\div1000\\\\&=0.768\\end{aligned}$\n$768\\,000\\text{ g}=0.768\\text{ t}$."
      }
    ],
