    "examples": [
      {
        "question_text": "Find the LCM of (a) $8$ and $14$, (b) $11$ and $33$.",
        "solution_text": "(a) Multiples of $8$: $8,16,24,32,40,48,56,\\ldots$\nMultiples of $14$: $14,28,42,56,\\ldots$\nThe smallest shared multiple is $56$, so the LCM is $56$.\n(b) Multiples of $11$: $11,22,33,44,\\ldots$\nMultiples of $33$: $33,66,\\ldots$\nThe LCM is $33$. Since $33$ is a multiple of $11$, the LCM is the larger number."
      },
      {
        "question_text": "Use the product and HCF to find the LCM of (a) $16$ and $20$, (b) $11$ and $13$.",
        "solution_text": "(a) Product: $16\\times20=320$.\nFactors of $16$: $1,2,4,8,16$.\nFactors of $20$: $1,2,4,5,10,20$.\nThe HCF is $4$.\n$320\\div4=80$\nThe LCM is $80$.\n(b) Product: $11\\times13=143$.\nThe two different prime numbers share only the factor $1$. The HCF is $1$.\n$143\\div1=143$\nThe LCM is $143$."
      },
      {
        "question_text": "Find the LCM of $15$ and $63$ using the product and HCF.",
        "solution_text": "Product: $15\\times63=945$.\nFactors of $15$: $1,3,5,15$.\nFactors of $63$: $1,3,7,9,21,63$.\nThe HCF is $3$.\n$945\\div3=315$\nThe LCM is $315$."
      }
    ],
