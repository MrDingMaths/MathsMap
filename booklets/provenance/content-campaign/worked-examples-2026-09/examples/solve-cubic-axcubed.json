    "examples": [
      {
        "question_text": "Solve and state how many solutions each equation has.\n(a) $x^3=343$\n(b) $x^3=-512$\n(c) $x^3=0$",
        "solution_text": "Cube root each side.\n(a) $x=\\sqrt[3]{343}=7$\n(b) $x=\\sqrt[3]{-512}=-8$, since $(-8)^3=-512$.\n(c) $x=\\sqrt[3]{0}=0$\nEach has one solution. Do not attach $\\pm$."
      },
      {
        "question_text": "Solve.\n(a) $-3x^3=375$\n(b) $64x^3=27$",
        "solution_text": "(a) Divide both sides by $-3$ before cube rooting.\n$x^3=-125$\n$x=-5$\nCheck: $-3(-5)^3=375$.\n(b) $x^3=\\frac{27}{64}$\n$x=\\frac34$, because $\\left(\\frac34\\right)^3=\\frac{27}{64}$."
      },
      {
        "question_text": "Solve.\n(a) $\\frac{x^3}{3}-5=67$\n(b) $4(x^3-2)=100$\n(c) $7x^3=2x^3+320$",
        "solution_text": "(a) $\\frac{x^3}{3}=72$\n$x^3=216$\n$x=6$\n(b) Divide both sides by $4$.\n$x^3-2=25$\n$x^3=27$\n$x=3$\n(c) Subtract $2x^3$ from both sides.\n$5x^3=320$\n$x^3=64$\n$x=4$"
      },
      {
        "question_text": "Solve $3x^3=42$. Give an exact answer and a decimal approximation correct to $2$ decimal places.",
        "solution_text": "$x^3=14$\n$x=\\sqrt[3]{14}$, the exact answer.\n$x\\approx2.41$ (to $2$ decimal places).\nKeep the exact cube root until the final rounding."
      },
      {
        "question_text": "Two identical cube-shaped containers have a total volume of $250$ cm$^3$. Find the side length of one.",
        "solution_text": "Let the side length be $x$ cm.\n$2x^3=250$\n$x^3=125$\n$x=5$\nEach side is $5$ cm. Check: $2(5^3)=250$ cm$^3$."
      },
      {
        "question_text": "Solve $2x^3=-54$. Explain why $2x^2=-54$ has no solution.",
        "solution_text": "For the cubic equation, divide by $2$.\n$x^3=-27$\n$x=-3$\nFor the square equation, division gives $x^2=-27$. A square is positive or zero, so it cannot equal $-27$.\nA negative number can be cubed to give a negative answer, but its square is positive."
      }
    ],
