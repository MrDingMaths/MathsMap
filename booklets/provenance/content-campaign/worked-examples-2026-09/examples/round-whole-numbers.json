    "examples": [
      {
        "question_text": "Round:\n(a) $38\\,274\\,613$ to $6$ significant figures\n(b) $6\\,853\\,274$ to $2$ significant figures.",
        "solution_text": "(a) $38\\,274\\,\\underline{6}13$. The sixth significant figure is $6$, in the hundreds place. The tens digit is $1$, so keep the hundreds digit and replace the tens and ones with zeros.\n$38\\,274\\,613\\approx38\\,274\\,600$\n(b) $6\\,\\underline{8}53\\,274$. The second significant figure is $8$, in the hundred-thousands place. The next digit is $5$, so round up.\n$6\\,853\\,274\\approx6\\,900\\,000$"
      },
      {
        "question_text": "Round $47\\,999\\,684$ to $5$ significant figures.",
        "solution_text": "$47\\,99\\underline{9}\\,684$\nThe fifth significant figure is $9$, in the thousands place. The hundreds digit is $6$, so round up. The next thousand after $47\\,999\\,000$ is $48\\,000\\,000$.\n$47\\,999\\,684\\approx48\\,000\\,000$"
      },
      {
        "question_text": "Round $286\\,743\\,519$ to $5$ significant figures.",
        "solution_text": "The fifth significant figure is $4$, in the ten-thousands place. The next digit is $3$, so keep the $4$ and replace the remaining digits with zeros.\n$286\\,7\\underline{4}3\\,519\\approx286\\,740\\,000$"
      },
      {
        "question_text": "The number $7\\square2$ is rounded to $1$ significant figure. The answer is $800$. What could the original number have been?",
        "solution_text": "One possible number is $762$. Its first significant figure is $7$, in the hundreds place. The next digit is $6$, so round up.\n$762\\approx800$"
      },
      {
        "question_text": "A count rounds to $59\\,380\\,000$ to $4$ significant figures and to $59\\,400\\,000$ to $3$ significant figures. Give one possible original count and check it.",
        "solution_text": "One possible count is $59\\,382\\,617$.\nTo $4$ significant figures, round to the nearest ten thousand. The next digit is $2$, so $59\\,382\\,617\\approx59\\,380\\,000$.\nTo $3$ significant figures, round to the nearest hundred thousand. The next digit is $8$, so $59\\,382\\,617\\approx59\\,400\\,000$.\nIt satisfies both rounding statements."
      },
      {
        "question_text": "A whole number rounds to $400\\,000$ to each of $1$, $2$, $3$ and $4$ significant figures. Give one possible original number and check each rounding.",
        "solution_text": "One possible number is $399\\,999$.\nFor $1$ significant figure, the first digit is in the hundred-thousands place. The next digit is $9$, so round up: $399\\,999\\approx400\\,000$.\nFor $2$ significant figures, the second digit is in the ten-thousands place. The next digit is $9$, so round up: $399\\,999\\approx400\\,000$.\nFor $3$ significant figures, the third digit is in the thousands place. The next digit is $9$, so round up: $399\\,999\\approx400\\,000$.\nFor $4$ significant figures, the fourth digit is in the hundreds place. The next digit is $9$, so round up: $399\\,999\\approx400\\,000$."
      }
    ],
