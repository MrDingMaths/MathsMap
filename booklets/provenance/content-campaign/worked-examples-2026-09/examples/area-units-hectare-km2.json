    "examples": [
      {
        "question_text": "(a) Choose the more suitable unit, hectares or square kilometres, for a farm paddock.\n(b) Choose the more suitable unit for a large forest.\n(c) A forest covers $13$ square kilometres. Write its area using the unit symbol.",
        "solution_text": "(a) Hectares suit a block of land such as a paddock.\n(b) Square kilometres suit a large region such as a forest.\n(c) $13\\text{ km}^2$"
      },
      {
        "question_text": "(a) Record $73\\,000\\text{ m}^2$ in hectares.\n(b) Record $5.7$ ha in square metres.",
        "solution_text": "Use $10\\,000\\text{ m}^2=1$ ha.\n(a) $73\\,000\\div10\\,000=7.3\\text{ ha}$\n(b) $5.7\\times10\\,000=57\\,000\\text{ m}^2$"
      },
      {
        "question_text": "Order these land areas from smallest to largest: $38$ ha, $410\\,000\\text{ m}^2$ and $46$ ha.",
        "solution_text": "Record all three areas in hectares.\n$410\\,000\\div10\\,000=41\\text{ ha}$\n$38\\text{ ha}<41\\text{ ha}<46\\text{ ha}$\nFrom smallest to largest: $38$ ha, $410\\,000\\text{ m}^2$, $46$ ha."
      },
      {
        "question_text": "Two neighbouring paddocks have areas of $260\\,000\\text{ m}^2$ and $19$ ha. Find their total area in hectares.",
        "solution_text": "Record both areas in hectares before adding.\n$260\\,000\\div10\\,000=26\\text{ ha}$\n$26+19=45\\text{ ha}$"
      },
      {
        "question_text": "A square block of land has sides of $200$ m. Find its area in hectares.\n[tikz]\n\\begin{tikzpicture}[draw=black,text=black,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\draw (0,0) rectangle (3,3);\n\\path (1.5,0) node[below] {$200\\text{ m}$};\n\\path (3,1.5) node[right] {$200\\text{ m}$};\n\\end{tikzpicture}\n[/tikz]",
        "solution_text": "Find the area in square metres, then use $10\\,000\\text{ m}^2=1\\text{ ha}$.\n$\\begin{align*}\\text{Area}&=200\\times200\\\\&=40\\,000\\text{ m}^2\\end{align*}$\n$40\\,000\\div10\\,000=4\\text{ ha}$"
      }
    ],
