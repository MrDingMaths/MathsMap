              "content": {
                "id": "p17-q25-root",
                "type": "question",
                "label": "25",
                "prompt": "In a bag there are 3 six-sided dice. Two of the dice have faces marked 1, 2, 3, 4, 5, 6. The other is a special die with faces marked 1, 2, 3, 5, 5, 5.\n\nOne die is randomly selected and tossed.",
                "children": [
                  {
                    "id": "p17-q25-a",
                    "type": "part",
                    "label": "a",
                    "prompt": "What is the probability that the die shows a 5?",
                    "answerSpaceMm": 25,
                    "answer": {
                      "short": "$\\frac{5}{18}$",
                      "worked": "A probability tree is useful here.\n$$\\begin{align*}P(5)&=\\left(\\frac{1}{3}\\right)\\left(\\frac{1}{6}\\right)+\\left(\\frac{1}{3}\\right)\\left(\\frac{1}{6}\\right)+\\left(\\frac{1}{3}\\right)\\left(\\frac{3}{6}\\right)\\\\P(5)&=\\frac{5}{18}\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "source"
                      }
                    }
                  },
                  {
                    "id": "p17-q25-b",
                    "type": "part",
                    "label": "b",
                    "prompt": "Given that the die shows a 5, what is the probability that it is the special die?",
                    "answerSpaceMm": 34,
                    "answer": {
                      "short": "$\\frac{3}{5}$",
                      "worked": "$$\\begin{align*}P(\\text{special}\\mid 5\\text{ shown})&=\\frac{P(\\text{special}\\cap 5)}{P(5)}\\\\P(\\text{special}\\mid 5\\text{ shown})&=\\frac{\\frac{1}{3}\\times\\frac{1}{2}}{\\frac{5}{18}}\\\\P(\\text{special}\\mid 5\\text{ shown})&=\\frac{3}{5}\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "source"
                      }
                    }
                  }
                ]
              },
