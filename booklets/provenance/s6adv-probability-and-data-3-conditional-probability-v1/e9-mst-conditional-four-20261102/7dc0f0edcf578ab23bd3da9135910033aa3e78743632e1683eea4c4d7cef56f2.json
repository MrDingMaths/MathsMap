                      "inlines": [
                        {
                          "type": "text",
                          "text": "History and Geography are two subjects students may decide to study."
                        },
                        {
                          "type": "break"
                        },
                        {
                          "type": "text",
                          "text": "For a group of 40 students:"
                        },
                        {
                          "type": "break"
                        },
                        {
                          "type": "text",
                          "text": "7 students study neither History nor Geography"
                        },
                        {
                          "type": "break"
                        },
                        {
                          "type": "text",
                          "text": "20 students study History"
                        },
                        {
                          "type": "break"
                        },
                        {
                          "type": "text",
                          "text": "18 students study Geography"
                        }
                      ]
                    }
                  ]
                },
                "sharedSolutionDiagrams": [
                  {
                    "id": "p16-q23-diagram",
                    "format": "tikz",
                    "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 16, p16-q23-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black] (0,0) rectangle (6.8,4.2);\n\\draw[black] (2.3,1.9) circle (1.5);\n\\draw[black] (4.5,1.9) circle (1.5);\n\\node[black] at (2.1,3.8) {History};\n\\node[black] at (4.7,3.8) {Geography};\n\\node[black] at (1.8,1.9) {$15$};\n\\node[black] at (3.4,1.9) {$5$};\n\\node[black] at (5,1.9) {$13$};\n\\node[black] at (6.35,0.4) {$7$};\n\\end{tikzpicture}",
                    "widthMm": 70,
                    "role": "solution",
                    "reviewStatus": "needs-review",
                    "spec": {
                      "sourcePage": 16,
                      "sourceRegion": "Question 23 supplied answer diagram",
                      "description": "Unshaded overlapping circles within a rectangle, labelled History on the left and Geography on the right. Counts are 15, 5, 13 and 7 outside both circles.",
                      "mathematics": "There are 33 students in the union, 5 in the intersection, 15 studying only History, 13 studying only Geography, and 7 studying neither.",
                      "answerVisibility": "Answer editions only."
                    }
                  }
                ],
                "children": [
                  {
                    "id": "p16-q23-a",
                    "type": "part",
                    "label": "a",
                    "prompt": "Find the probability that the student studies both History and Geography.",
                    "answerSpaceMm": 30,
                    "sharedSolutionDiagramId": "p16-q23-diagram",
                    "answer": {
                      "short": "$\\frac18$",
                      "worked": "$$\\begin{align*}n(H\\cup G)&=40-7=33\\\\n(H\\cap G)&=20+18-33=5\\\\P(H\\cap G)&=\\frac{5}{40}=\\frac18\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p16-q23-b",
                    "type": "part",
                    "label": "b",
                    "prompt": "Given that the student studies Geography, what is the probability that the student does NOT study History?",
                    "answerSpaceMm": 24,
                    "answer": {
                      "short": "$\\frac{13}{18}$",
                      "worked": "$$\\begin{align*}n(\\overline H\\cap G)&=18-5=13\\\\P(\\overline H\\mid G)&=\\frac{P(\\overline H\\cap G)}{P(G)}\\\\P(\\overline H\\mid G)&=\\frac{13/40}{18/40}=\\frac{13}{18}\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p16-q23-c",
                    "type": "part",
                    "label": "c",
                    "prompt": "Two different students are chosen at random, one after the other. What is the probability that the first student studies History and the second student does NOT study History?",
                    "answerSpaceMm": 30,
                    "answer": {
                      "short": "$\\frac{10}{39}$",
                      "worked": "Let $H_1$ mean the first student studies History and $H_2$ mean the second student studies History. After choosing a History student, 39 students remain, including all 20 students who do not study History.\n$$\\begin{align*}P(H_1\\cap\\overline H_2)&=P(H_1)\\times P(\\overline H_2\\mid H_1)\\\\P(H_1\\cap\\overline H_2)&=\\left(\\frac{20}{40}\\right)\\times\\left(\\frac{20}{39}\\right)\\\\P(H_1\\cap\\overline H_2)&=\\frac{10}{39}\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  }
                ]
              },
