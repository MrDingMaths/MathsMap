  "content": {
    "id": "p13-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Each of the following experiments involves two events, $A$ and $B$. State in each case whether they are dependent or independent. If the given probabilities are impossible, explain why.",
    "children": [
      {
        "id": "p13-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(A\\mid B)=0.5$ and $P(A)=0.4$ and $P(B)=0.5$",
        "answerSpaceMm": 18,
        "answer": {
          "short": "Dependent.",
          "worked": "For independent events, $P(A\\mid B)=P(A)$. Here $0.5\\ne0.4$, so the events are dependent."
        }
      },
      {
        "id": "p13-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(A\\mid B)=0.3$ and $P(A)=0.3$ and $P(B)=0.6$",
        "answerSpaceMm": 18,
        "answer": {
          "short": "Independent.",
          "worked": "$P(A\\mid B)=0.3=P(A)$, so the events are independent."
        }
      },
      {
        "id": "p13-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(A\\mid B)=\\frac34$ and $P(A)=\\frac25$ and $P(B)=\\frac3{10}$",
        "answerSpaceMm": 21,
        "answer": {
          "short": "Dependent.",
          "worked": "For independent events, $P(A\\mid B)=P(A)$. Here $\\frac34\\ne\\frac25$, so the events are dependent."
        }
      },
      {
        "id": "p13-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(A)=0.3$ and $P(B)=0.7$ and $P(A\\cap B)=0.21$",
        "answerSpaceMm": 21,
        "answer": {
          "short": "Independent.",
          "worked": "$$\\begin{aligned}P(A)\\times P(B)&=0.3\\times0.7\\\\&=0.21\\\\&=P(A\\cap B)\\end{aligned}$$\nTherefore the events are independent."
        }
      },
      {
        "id": "p13-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(A)=0.2$ and $P(B)=0.4$ and $P(A\\cap B)=0.8$",
        "answerSpaceMm": 18,
        "answer": {
          "short": "Impossible probabilities.",
          "worked": "An intersection cannot have a greater probability than either event. Here $P(A\\cap B)=0.8$ exceeds both $P(A)=0.2$ and $P(B)=0.4$, so these probabilities are impossible."
        }
      },
      {
        "id": "p13-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$P(A)=\\frac12$ and $P(B)=\\frac23$ and $P(A\\cap B)=\\frac13$",
        "answerSpaceMm": 26,
        "answer": {
          "short": "Independent.",
          "worked": "$$\\begin{aligned}P(A)\\times P(B)&=\\frac12\\times\\frac23\\\\&=\\frac13\\\\&=P(A\\cap B)\\end{aligned}$$\nTherefore the events are independent."
        }
      }
    ]
  },
