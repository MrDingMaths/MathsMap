                "difficultyReason": "Construct a spatial distance relationship using trigonometry and then apply the chain rule with a constant angle of ascent."
              },
              "content": {
                "id": "p27-q16-root",
                "type": "question",
                "label": "16",
                "prompt": "A plane $P$ takes off from a point $B$. It flies due north at a constant angle $\\alpha$ to the horizontal.\n\nAn observer is located at $A$, 1 km from $B$, at a bearing $060^\\circ$ from $B$.\n\nLet $u$ km be the distance from $B$ to the plane and let $r$ km be the distance from the observer to the plane. The point $G$ is on the ground directly below the plane.",
                "questionDiagrams": [
                  {
                    "id": "p27-q16-diagram",
                    "format": "tikz",
                    "widthMm": 100,
                    "role": "question",
                    "reviewStatus": "needs-review",
                    "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 27 p27-q16-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (B) at (0,0);\n\\coordinate (A) at (3,-0.8);\n\\coordinate (G) at (5,2.2);\n\\coordinate (P) at (5,3.7);\n\\coordinate (N) at ($(B)!1.18!(G)$);\n\\draw[black,line width=0.8pt] (B)--node[midway,below] {$1$} (A);\n\\draw[black,line width=0.8pt] (B)--node[midway,above left] {$u$} (P);\n\\draw[black,line width=0.8pt] (A)--node[midway,left] {$r$} (P);\n\\draw[black,dashed,line width=0.4pt] (B)--(G)--(A);\n\\draw[black,dashed,line width=0.4pt] (G)--(P);\n\\draw[black,->,line width=0.5pt] (G)--(N) node[right] {$\\mathrm{N}$};\n\\pic[draw=black,line width=0.4pt,angle radius=11mm,angle eccentricity=1.3,\"$60^\\circ$\"] {angle=A--B--G};\n\\pic[draw=black,line width=0.4pt,angle radius=20mm,angle eccentricity=1.15,\"$\\alpha$\"] {angle=G--B--P};\n\\coordinate (Gup) at ($(G)!0.16!(P)$);\n\\coordinate (Gground) at ($(G)!0.055!(B)$);\n\\draw[black,line width=0.4pt] (Gup)--($(Gup)+(Gground)-(G)$)--(Gground);\n\\node[left] at (B) {$B$};\n\\node[below] at (A) {$A$};\n\\node[right] at (G) {$G$};\n\\node[above] at (P) {$P$};\n\\end{tikzpicture}",
                    "spec": {
                      "sourcePage": 27,
                      "sourceRegion": "Spatial diagram between the shared stem and part a",
                      "description": "Oblique spatial schematic preserving solid BA, BP and AP, dashed BG, AG and PG, the north continuation of BG, and the two angle labels at B. The non-mathematical aircraft illustration is omitted.",
                      "mathematics": "BA=1 km, BP=u km, AP=r km; BG is due north from B; angle ABG=60 degrees; angle PBG=alpha; PG is perpendicular to the ground plane.",
                      "answerVisibility": "All geometry and labels are permanent student givens."
                    }
                  }
                ],
                "children": [
                  {
                    "id": "p27-q16-a",
                    "type": "part",
                    "label": "a",
                    "prompt": "Show that $r=\\sqrt{1+u^2-u\\cos\\alpha}$.",
                    "answerSpaceMm": 96,
                    "answer": {
                      "short": "$r=\\sqrt{1+u^2-u\\cos\\alpha}$.",
                      "worked": {
                        "format": "maths-editor-document-v1",
                        "version": 1,
                        "blocks": [
                          {
                            "id": "p27-q16-a-work-pbg",
                            "type": "paragraph",
                            "align": "right",
                            "inlines": [
                              {
                                "type": "text",
                                "text": "Using triangle PBG:"
                              },
                              {
                                "type": "break"
                              },
                              {
                                "type": "math",
                                "latex": "BG=u\\cos\\alpha,\\qquad PG=u\\sin\\alpha",
                                "display": true
                              }
                            ]
                          },
                          {
                            "id": "p27-q16-a-work-abg",
                            "type": "paragraph",
                            "align": "right",
                            "inlines": [
                              {
                                "type": "text",
                                "text": "In triangle ABG:"
                              },
                              {
                                "type": "math",
                                "latex": "\\begin{aligned}AG^2&=1+u^2\\cos^2\\alpha-2u\\cos\\alpha\\cos60^\\circ\\\\&=1+u^2\\cos^2\\alpha-u\\cos\\alpha\\end{aligned}",
                                "display": true
                              }
                            ]
                          },
                          {
                            "id": "p27-q16-a-work-apg",
                            "type": "paragraph",
                            "align": "right",
                            "inlines": [
                              {
                                "type": "text",
                                "text": "In triangle APG:"
                              },
                              {
                                "type": "math",
                                "latex": "\\begin{aligned}r^2&=AG^2+PG^2\\\\r^2&=1+u^2\\cos^2\\alpha-u\\cos\\alpha+u^2\\sin^2\\alpha\\\\r^2&=1+u^2(\\cos^2\\alpha+\\sin^2\\alpha)-u\\cos\\alpha\\\\r^2&=1+u^2-u\\cos\\alpha\\\\r&=\\sqrt{1+u^2-u\\cos\\alpha}\\end{aligned}",
                                "display": true
                              }
                            ]
                          }
                        ]
                      },
                      "provenance": {
                        "short": "source",
                        "worked": "source"
                      }
                    }
                  },
                  {
                    "id": "p27-q16-b",
                    "type": "part",
                    "label": "b",
                    "prompt": "The plane is travelling at a constant speed of 360 km/h.\n\nAt what rate, in terms of $\\alpha$, is the distance of the plane from the observer changing 5 minutes after take-off?",
                    "answerSpaceMm": 104,
                    "answer": {
                      "short": "$\\displaystyle \\frac{180(60-\\cos\\alpha)}{\\sqrt{901-30\\cos\\alpha}}\\text{ km/h}$, increasing.",
                      "worked": {
                        "format": "maths-editor-document-v1",
                        "version": 1,
                        "blocks": [
                          {
                            "id": "p27-q16-b-work-distance",
                            "type": "paragraph",
                            "align": "right",
                            "inlines": [
                              {
                                "type": "text",
                                "text": "Speed = 360 km/h, so after 5 minutes:"
                              },
                              {
                                "type": "math",
                                "latex": "u=360\\times\\frac{5}{60}=30\\text{ km}",
                                "display": true
                              }
                            ]
                          },
                          {
                            "id": "p27-q16-b-work-chain",
                            "type": "paragraph",
                            "align": "right",
                            "inlines": [
                              {
                                "type": "math",
                                "latex": "\\frac{dr}{dt}=\\frac{dr}{du}\\times\\frac{du}{dt}",
                                "display": true
                              },
                              {
                                "type": "text",
                                "text": "The angle of ascent α remains constant."
                              }
                            ]
                          },
                          {
                            "id": "p27-q16-b-work-derivatives",
                            "type": "paragraph",
                            "align": "right",
                            "inlines": [
                              {
                                "type": "math",
                                "latex": "\\frac{dr}{du}=\\frac{2u-\\cos\\alpha}{2\\sqrt{1+u^2-u\\cos\\alpha}}",
                                "display": true
                              },
                              {
                                "type": "math",
                                "latex": "\\frac{du}{dt}=360\\text{ km/h}",
                                "display": true
                              }
                            ]
                          },
                          {
                            "id": "p27-q16-b-work-substitution",
                            "type": "paragraph",
                            "align": "right",
                            "inlines": [
                              {
                                "type": "text",
                                "text": "At u = 30:"
                              },
                              {
                                "type": "math",
                                "latex": "\\frac{dr}{du}=\\frac{60-\\cos\\alpha}{2\\sqrt{1+900-30\\cos\\alpha}}",
                                "display": true
                              },
                              {
                                "type": "math",
                                "latex": "\\begin{aligned}\\frac{dr}{dt}&=\\frac{360(60-\\cos\\alpha)}{2\\sqrt{901-30\\cos\\alpha}}\\\\\\frac{dr}{dt}&=\\frac{180(60-\\cos\\alpha)}{\\sqrt{901-30\\cos\\alpha}}\\text{ km/h}\\end{aligned}",
                                "display": true
                              },
                              {
                                "type": "text",
                                "text": "The distance is increasing."
                              }
                            ]
                          }
                        ]
                      },
                      "provenance": {
                        "short": "source",
                        "worked": "source"
                      }
                    }
                  }
                ]
              },
