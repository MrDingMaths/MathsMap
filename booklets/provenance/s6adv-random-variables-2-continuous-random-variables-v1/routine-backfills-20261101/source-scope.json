              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"barFill\",\"hex\":\"D4E8FF\",\"reason\":\"histogram probability areas\"},{\"name\":\"polygonBlue\",\"hex\":\"268CFF\",\"reason\":\"distinguishes frequency polygon from histogram\"}],\"reference\":\"page 7 p7-q3-graph\"}\n\\begin{tikzpicture}[x=1.15cm,y=9cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{barFill}{HTML}{D4E8FF}\\definecolor{polygonBlue}{HTML}{268CFF}\n\\draw[step=0.5cm,draw=none] (0,0)--(0,0);\n\\foreach \\x in {-1,-0.5,...,5.5}{\\draw[black!20,line width=0.15pt] (\\x,0)--(\\x,0.55);}\n\\foreach \\y in {0,0.1,...,0.5}{\\draw[black!20,line width=0.25pt] (-1,\\y)--(5.5,\\y);}\n\\foreach \\x/\\h in {0/0.25,1/0.5,2/0.125,3/0.1,4/0.025}{\\draw[fill=barFill,draw=black,line width=0.8pt] (\\x-0.5,0) rectangle (\\x+0.5,\\h);}\n\\draw[polygonBlue,line width=0.8pt] (-1,0)--(0,0.25)--(1,0.5)--(2,0.125)--(3,0.1)--(4,0.025)--(5,0);\n\\foreach \\x/\\h in {0/0.25,1/0.5,2/0.125,3/0.1,4/0.025}{\\draw[black,fill=white,line width=0.4pt] (\\x,\\h) circle[radius=1.5pt];}\n\\draw[black,line width=0.5pt] (-1,0.55)--(-1,0)--(5.5,0);\n\\foreach \\x in {0,...,5}{\\draw[black,line width=0.4pt] (\\x,0)--(\\x,-0.008) node[below]{\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\x$\\special{dvisvgm:raw </g>}};}\n\\foreach \\y in {0.2,0.4}{\\draw[black,line width=0.4pt] (-1.07,\\y)--(-0.93,\\y);\\node[left] at (-1.08,\\y){\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\y$\\special{dvisvgm:raw </g>}};}\n\\node[rotate=90] at (-1.85,0.28){relative frequency};\\node[right] at (5.5,-0.015){cars};\\node[above] at (2.25,0.57){Number of cars in household};\n\\end{tikzpicture}"
            }
          ],
          "children": [
            {
              "id": "p7-q3-g",
              "type": "part",
              "label": "g",
              "prompt": "Explain why the area under the relative frequency polygon equals the area of the histogram.",
              "answerSpaceMm": 26,
              "answer": {
                "short": "The triangular areas removed from the tops of bars balance the triangular areas added between them, including the end triangles, so the total area stays 1.",
                "worked": "Between adjacent bar centres the polygon forms a trapezium of width 1, with area equal to half the sum of the two bar heights. The end triangles each contribute half the first or last bar height. Altogether each bar height is counted once, giving the same total area as the unit-width histogram.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            }
          ]
        }
      }
    },
