    {
      "id": "p40-q13",
      "scope": [
        "p40-q13-a",
        "p40-q13-e"
      ],
      "purpose": "CDF/PDF reversal transfer context; omit unrelated probability parts",
      "wholeOwnerSha256": "16ee4348f644d5b8e94e79982b1665efafeb4e2aa8b0f97c0227c28d8b385fcc",
      "native": {
        "id": "p40-q13",
        "type": "question",
        "content": {
          "id": "p40-q13-root",
          "type": "question",
          "label": "13",
          "prompt": "A chicken wanders uniformly at random inside a circular enclosure of radius $6$ m. Let $X$ be its distance from the centre O.",
          "children": [
            {
              "id": "p40-q13-a",
              "type": "part",
              "label": "a",
              "prompt": "Find the CDF, which is the probability of finding the chicken a distance of $x$ metres or less from the centre of the enclosure. $F(x)=P(X\\le x)$.",
              "answerSpaceMm": 30,
              "answer": {
                "short": "$F(x)=\\begin{cases}0,&x<0,\\\\\\dfrac{x^2}{36},&0\\le x\\le6,\\\\1,&x>6.\\end{cases}$",
                "worked": "For $0\\le x\\le6$, uniform position within the enclosure gives\n$$\\begin{align*}F(x)&=\\frac{\\text{area of inner circle}}{\\text{area of whole circle}}\\\\F(x)&=\\frac{\\pi x^2}{\\pi\\times6^2}\\\\F(x)&=\\frac{x^2}{36}.\\end{align*}$$\nThus $F(x)=0$ for $x<0$ and $F(x)=1$ for $x>6$.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p40-q13-e",
              "type": "part",
              "label": "e",
              "prompt": "Find the PDF.",
              "answerSpaceMm": 21,
              "answer": {
                "short": "$f(x)=\\begin{cases}\\dfrac{x}{18},&0\\le x\\le6,\\\\0,&\\text{otherwise}.\\end{cases}$",
                "worked": "The PDF is the derivative of the CDF. For $0<x<6$,\n$$\\begin{align*}f(x)&=F'(x)\\\\f(x)&=\\frac{d}{dx}\\left(\\frac{x^2}{36}\\right)\\\\f(x)&=\\frac{x}{18}.\\end{align*}$$\nHence a PDF is $f(x)=\\frac{x}{18}$ for $0\\le x\\le6$, and $0$ otherwise.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            }
          ]
        }
      }
    }
