                      "type": "math",
                      "latex": "(\\underset{\\color{#ef6068}{x_1}}{-3},\\underset{\\color{#ef6068}{y_1}}{5})\\text{ and }(\\underset{\\color{#ef6068}{x_2}}{6},\\underset{\\color{#ef6068}{y_2}}{-4})",
                      "display": false
                    }
                  ]
                }
              ]
            },
            "theorySolution": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
