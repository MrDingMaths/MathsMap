                "id": "p10-q4-root",
                "type": "question",
                "label": "4",
                "prompt": {
                  "format": "maths-editor-document-v1",
                  "version": 1,
                  "blocks": [
                    {
                      "id": "p10-q4-definition",
                      "type": "paragraph",
                      "align": "left",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "Collinear points",
                          "marks": [
                            "bold"
                          ]
                        },
                        {
                          "type": "text",
                          "text": " lie on the same line. Three points "
                        },
                        {
                          "type": "math",
                          "latex": "A,B,C",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " are collinear if "
                        },
                        {
                          "type": "math",
                          "latex": "AB",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " and "
                        },
                        {
                          "type": "math",
                          "latex": "BC",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " have the same gradient, because then "
                        },
                        {
                          "type": "math",
                          "latex": "AB",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " and "
                        },
                        {
                          "type": "math",
                          "latex": "BC",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " are parallel lines passing through a common point "
                        },
                        {
                          "type": "math",
                          "latex": "B",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                "children": [
                  {
                    "id": "p10-q4-a",
                    "type": "part",
                    "label": "a",
                    "prompt": {
                      "format": "maths-editor-document-v1",
                      "version": 1,
                      "blocks": [
                        {
                          "id": "p10-q4-a-stem",
                          "type": "paragraph",
                          "align": "left",
                          "inlines": [
                            {
                              "type": "text",
                              "text": "Determine whether "
                            },
                            {
                              "type": "math",
                              "latex": "A(-2,5),\\ B(1,3)",
                              "display": false
                            },
                            {
                              "type": "text",
                              "text": " and "
                            },
                            {
                              "type": "math",
                              "latex": "C(7,-1)",
                              "display": false
                            },
                            {
                              "type": "text",
                              "text": " are collinear."
                            }
                          ]
                        },
                        {
                          "id": "p10-q4-a-scaffold",
                          "type": "table",
                          "widths": [
                            1,
                            1
                          ],
                          "rowHeights": [
                            35
                          ],
                          "padding": 0,
                          "border": false,
                          "rows": [
                            [
                              {
                                "id": "p10-q4-a-ab-cell",
                                "type": "cell",
                                "align": "left",
                                "blocks": [
                                  {
                                    "id": "p10-q4-a-ab-start",
                                    "type": "paragraph",
                                    "align": "left",
                                    "inlines": [
                                      {
                                        "type": "math",
                                        "latex": "m_{AB}=",
                                        "display": false
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "id": "p10-q4-a-bc-cell",
                                "type": "cell",
                                "align": "left",
                                "blocks": [
                                  {
                                    "id": "p10-q4-a-bc-start",
                                    "type": "paragraph",
                                    "align": "left",
                                    "inlines": [
                                      {
                                        "type": "math",
                                        "latex": "m_{BC}=",
                                        "display": false
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          ]
                        }
                      ]
                    },
                    "answerSpaceMm": 8,
                    "answer": {
                      "short": "Collinear; both gradients are $-\\frac{2}{3}$.",
                      "worked": "$$\\begin{align*}m_{AB}&=\\frac{3-5}{1-(-2)}\\\\m_{AB}&=-\\frac{2}{3}\\\\m_{BC}&=\\frac{-1-3}{7-1}\\\\m_{BC}&=-\\frac{4}{6}\\\\m_{BC}&=-\\frac{2}{3}\\end{align*}$$\nThe gradients are equal, so the points are collinear.",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p10-q4-b",
                    "type": "part",
                    "label": "b",
                    "prompt": "$P(-2,7),\\ Q(1,1),\\ R(4,-6)$",
                    "answerSpaceMm": 43,
                    "answer": {
                      "short": "Not collinear; the gradients are $-2$ and $-\\frac{7}{3}$.",
                      "worked": "$$\\begin{align*}m_{PQ}&=\\frac{1-7}{1-(-2)}\\\\m_{PQ}&=\\frac{-6}{3}\\\\m_{PQ}&=-2\\\\m_{QR}&=\\frac{-6-1}{4-1}\\\\m_{QR}&=-\\frac{7}{3}\\end{align*}$$\nThe gradients are different, so the points are not collinear.",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p10-q4-c",
                    "type": "part",
                    "label": "c",
                    "prompt": "$P(-5,-4),\\ Q(-2,-2),\\ R(1,0)$",
                    "answerSpaceMm": 38,
                    "answer": {
                      "short": "Collinear; both gradients are $\\frac{2}{3}$.",
                      "worked": "$$\\begin{align*}m_{PQ}&=\\frac{-2-(-4)}{-2-(-5)}\\\\m_{PQ}&=\\frac{2}{3}\\\\m_{QR}&=\\frac{0-(-2)}{1-(-2)}\\\\m_{QR}&=\\frac{2}{3}\\end{align*}$$\nThe gradients are equal, so the points are collinear.",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  }
                ]
              },
