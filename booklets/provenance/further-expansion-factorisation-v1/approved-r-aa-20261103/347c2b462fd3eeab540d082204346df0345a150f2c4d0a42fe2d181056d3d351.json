              "content": {
                "id": "p15-q15-root",
                "type": "group",
                "label": "15",
                "prompt": "Which is larger? $77\\times77$ or $78\\times76$?\nCompute each using perfect squares and the difference of two squares.",
                "layout": "grid",
                "columns": 2,
                "children": [
                  {
                    "id": "p15-q15-a",
                    "type": "part",
                    "label": "a",
                    "prompt": "$77\\times77$",
                    "answerSpaceMm": 28,
                    "answer": {
                      "short": "$5929$",
                      "worked": "$$\\begin{align*}77\\times77&=(70+7)^2\\\\&=70^2+2\\times70\\times7+7^2\\\\&=4900+980+49\\\\&=5929\\end{align*}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p15-q15-b",
                    "type": "part",
                    "label": "b",
                    "prompt": "$78\\times76$",
                    "answerSpaceMm": 34,
                    "answer": {
                      "short": "$5928$; $77\\times77$ is larger by $1$.",
                      "worked": "$$\\begin{align*}78\\times76&=(77+1)(77-1)\\\\&=77^2-1^2\\\\&=5929-1\\\\&=5928\\end{align*}$$\nSince $5929>5928$, $77\\times77$ is larger by $1$.",
                      "provenance": {
                        "short": "authored",
                        "worked": "authored"
                      }
                    }
                  }
                ]
              },
