                "children": [
                  {
                    "id": "p10-q13-part1",
                    "type": "part",
                    "label": "",
                    "prompt": "What is the order (degree) of the vertex that represents ACT?",
                    "answerSpaceMm": 8,
                    "answer": {
                      "short": "1",
                      "worked": "ACT shares a border only with New South Wales, so its vertex has one incident edge. Its degree is 1.",
                      "provenance": {
                        "short": "authored",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p10-q13-part2",
                    "type": "part",
                    "label": "",
                    "prompt": "Identify the letter representing Queensland. Explain why.",
                    "answerSpaceMm": 24,
                    "answer": {
                      "short": "$A$: it joins $E$ (Northern Territory), $H$ (South Australia) and $B$ (New South Wales).",
                      "worked": "The degree-1 vertex $D$ represents ACT, so its neighbour $B$ represents New South Wales. The degree-5 vertex $H$ represents South Australia. Queensland borders New South Wales, South Australia and Northern Territory. Vertex $A$ has exactly these neighbours: $B$, $H$ and $E$. Therefore Queensland is $A$.",
                      "provenance": {
                        "short": "authored",
                        "worked": "authored"
                      }
                    }
                  }
                ]
