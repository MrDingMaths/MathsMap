      "columns": 1,
      "children": [
        {
          "id": "exam-proposal-ef7ba4ce-952d-403a-af42-98d73f6d4513-root-a",
          "type": "part",
          "label": "a",
          "prompt": "By completing the square, express $y=2x^2-4x+5$ in the form $y=a(x+b)^2+c$, where $a$, $b$ and $c$ are constants.",
          "answer": {
            "short": "$y=2(x-1)^2+3$; $a=2,b=-1,c=3$.",
            "worked": "$$\\begin{align*}\ny&=2x^2-4x+5 \\\\\n&=2(x^2-2x)+5 \\\\\n&=2\\left[(x-1)^2-1\\right]+5 \\\\\n&=2(x-1)^2-2+5 \\\\\n&=2(x-1)^2+3\n\\end{align*}$$"
          }
        },
        {
          "id": "exam-proposal-ef7ba4ce-952d-403a-af42-98d73f6d4513-root-b",
          "type": "part",
          "label": "b",
          "prompt": "Hence, or otherwise, find the vertex of the parabola $y=2x^2-4x+5$.",
          "answer": {
            "short": "$(1,3)$.",
            "worked": "From $y=2(x-1)^2+3$, the vertex is $(1,3)$."
          }
        },
        {
          "id": "exam-proposal-ef7ba4ce-952d-403a-af42-98d73f6d4513-root-c",
          "type": "part",
          "label": "c",
          "prompt": "Sketch the graph of $y=2x^2-4x+5$, showing the vertex and intercept(s).",
          "answer": {
            "short": "No $x$-intercepts; $y$-intercept $(0,5)$; upward parabola.",
            "worked": "The $y$-intercept is found by setting $x=0$.\n$$\\begin{align*}\ny&=2(0)^2-4(0)+5 \\\\\n&=5\n\\end{align*}$$\nThe discriminant is negative, so there are no $x$-intercepts.\n$$\\begin{align*}\n\\Delta&=(-4)^2-4(2)(5) \\\\\n&=16-40 \\\\\n&=-24\n\\end{align*}$$",
            "solutionDiagrams": [
              {
                "id": "exam-proposal-ef7ba4ce-952d-403a-af42-98d73f6d4513-root-c-solution-1",
                "format": "tikz",
                "widthMm": 80,
                "role": "solution",
                "reviewStatus": "needs-review",
                "code": "\\definecolor{housegrid}{HTML}{CCCCCC}\n\\begin{tikzpicture}[every node/.style={font=\\large}, scale=0.7]\n\\draw[step=1cm, draw=housegrid, very thin] (-1,-1) grid (4,7);\n\\draw[->] (-1.2,0) -- (4.2,0) node[right] {$x$};\n\\draw[->] (0,-1.2) -- (0,7.2) node[above] {$y$};\n\\foreach \\x in {-1,1,2,3,4} {\\draw (\\x,0.08) -- (\\x,-0.08) node[below] {$\\x$};}\n\\foreach \\y in {2,4,6} {\\draw (0.08,\\y) -- (-0.08,\\y) node[left] {$\\y$};}\n\\draw[<->, thick, domain=-0.35:2.35, smooth, variable=\\x] plot ({\\x},{2*(\\x-1)*(\\x-1)+3});\n\\fill (1,3) circle (2pt) node[below right] {$(1,3)$};\n\\fill (0,5) circle (2pt) node[left] {$(0,5)$};\n\\fill (2,5) circle (2pt);\n\\end{tikzpicture}"
              }
            ]
          }
        }
      ]
    },
