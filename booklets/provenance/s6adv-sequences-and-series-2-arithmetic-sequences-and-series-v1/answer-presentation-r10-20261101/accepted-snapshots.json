{"originalArtifact":{"path":".booklet-work/full-imports/s6adv-sequences-and-series-2-arithmetic-sequences-and-series-20261024/lean-review/reviewed.json","sha256":"0db82cdd435f3801bc4011c5eb4e3a4429adc4041e19c629de653418cbc51df2"},"snapshots":{"p15-q19":{"id":"p15-q19","type":"question","sourceOrder":19,"sourcePageNumber":15,"sourceRefs":[{"pageNumber":15}],"classification":{"primarySkillId":"arithmetic-sequence-nth-term","secondarySkillIds":[],"reasoningScore":43,"difficulty":"Development","difficultyReason":"Find common differences and simplify general-term formulae involving logarithms, algebraic expressions, surds and decimals.","assessment":{"model":"gpt-6.1-sol","assessedAt":"2026-10-24T04:12:27.586Z","rubricVersion":"mathsmap-cognitive-demand-v1","taskHash":"0173117891528b9af577c3e914494d487cc870bb2d388d362561f2e36c425bf3","evidence":".booklet-work/full-imports/s6adv-sequences-and-series-2-arithmetic-sequences-and-series-20261024/semantic-packets/assignments/assignment-3bae23b4b4f28622aa8f/1/generation.json"}},"content":{"id":"p15-q19-root","type":"question","label":"19","prompt":"Find the common difference of each AP. Then find a formula for the $n$th term $a_n$.","layout":"grid","columns":2,"children":[{"id":"p15-q19-a","type":"part","label":"a","prompt":"$\\log_3 2,\\ \\log_3 4,\\ \\log_3 8,\\ldots$","answerSpaceMm":44,"answer":{"short":"$d=\\log_3 2;\\quad a_n=n\\log_3 2$.","worked":"$$\\begin{align*}d&=\\log_3 4-\\log_3 2\\\\d&=\\log_3\\left(\\frac42\\right)\\\\d&=\\log_3 2\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=\\log_3 2+(n-1)\\log_3 2\\\\a_n&=n\\log_3 2\\end{align*}$$"}},{"id":"p15-q19-b","type":"part","label":"b","prompt":"$\\log_a 54,\\ \\log_a 18,\\ \\log_a 6,\\ldots$","answerSpaceMm":66,"answer":{"short":"$d=-\\log_a 3;\\quad a_n=\\log_a 2+(4-n)\\log_a 3$.","worked":"$$\\begin{align*}d&=\\log_a 18-\\log_a 54\\\\d&=\\log_a\\left(\\frac{18}{54}\\right)\\\\d&=\\log_a\\left(\\frac13\\right)\\\\d&=-\\log_a 3\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=\\log_a 54+(n-1)(-\\log_a 3)\\\\a_n&=\\log_a 54-(n-1)\\log_a 3\\\\a_n&=\\log_a(2\\times3^3)+(1-n)\\log_a 3\\\\a_n&=\\log_a 2+3\\log_a 3+(1-n)\\log_a 3\\\\a_n&=\\log_a 2+(4-n)\\log_a 3\\end{align*}$$"}},{"id":"p15-q19-c","type":"part","label":"c","prompt":"$x-3y,\\ 2x+y,\\ 3x+5y,\\ldots$","answerSpaceMm":45,"answer":{"short":"$d=x+4y;\\quad a_n=nx+(4n-7)y$.","worked":"$$\\begin{align*}d&=(2x+y)-(x-3y)\\\\d&=x+4y\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=(x-3y)+(n-1)(x+4y)\\\\a_n&=x-3y+nx+4ny-x-4y\\\\a_n&=nx+(4n-7)y\\end{align*}$$"}},{"id":"p15-q19-d","type":"part","label":"d","prompt":"$5-6\\sqrt5,\\ 1+\\sqrt5,\\ -3+8\\sqrt5,\\ldots$","answerSpaceMm":51,"answer":{"short":"$d=-4+7\\sqrt5;\\quad a_n=9-4n+(7n-13)\\sqrt5$.","worked":"$$\\begin{align*}d&=(1+\\sqrt5)-(5-6\\sqrt5)\\\\d&=-4+7\\sqrt5\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=(5-6\\sqrt5)+(n-1)(-4+7\\sqrt5)\\\\a_n&=5-6\\sqrt5-4n+4\\\\&\\qquad{}+7n\\sqrt5-7\\sqrt5\\\\a_n&=9-4n+(7n-13)\\sqrt5\\end{align*}$$"}},{"id":"p15-q19-e","type":"part","label":"e","prompt":"$1.36,\\ -0.52,\\ -2.4,\\ldots$","answerSpaceMm":36,"answer":{"short":"$d=-1.88;\\quad a_n=3.24-1.88n$.","worked":"$$\\begin{align*}d&=-0.52-1.36\\\\d&=-1.88\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=1.36+(n-1)(-1.88)\\\\a_n&=1.36-1.88n+1.88\\\\a_n&=3.24-1.88n\\end{align*}$$"}},{"id":"p15-q19-f","type":"part","label":"f","prompt":"$\\log_a 3x^2,\\ \\log_a 3x,\\ \\log_a 3,\\ldots$","answerSpaceMm":58,"answer":{"short":"$d=-\\log_a x;\\quad a_n=\\log_a 3+(3-n)\\log_a x$.","worked":"$$\\begin{align*}d&=\\log_a(3x)-\\log_a(3x^2)\\\\d&=\\log_a\\left(\\frac{3x}{3x^2}\\right)\\\\d&=\\log_a\\left(\\frac1x\\right)\\\\d&=-\\log_a x\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=\\log_a(3x^2)+(n-1)(-\\log_a x)\\\\a_n&=\\log_a 3+2\\log_a x-(n-1)\\log_a x\\\\a_n&=\\log_a 3+(3-n)\\log_a x\\end{align*}$$"}}]},"sourceReview":{"sourceIdentity":{"questionLabel":"19","pdfPage":15},"teachingContext":{"pdfPages":[3,4,5,6,7],"methodNote":"Find the common difference by subtracting consecutive terms, identify the first term, substitute into a_n=a+(n-1)d and simplify. Page 5 demonstrates this substitution and expansion; the supplied question 19 solutions apply logarithm laws and algebraic simplification."},"responses":[{"targetId":"p15-q19-a","kind":"working"},{"targetId":"p15-q19-b","kind":"working"},{"targetId":"p15-q19-c","kind":"working"},{"targetId":"p15-q19-d","kind":"working"},{"targetId":"p15-q19-e","kind":"working"},{"targetId":"p15-q19-f","kind":"working"}],"workingSpaceEstimate":{"method":"solution-steps","estimates":[{"targetId":"p15-q19-a","widthMm":80,"mathematicalRows":6,"answerSpaceMm":44},{"targetId":"p15-q19-b","widthMm":80,"mathematicalRows":10,"answerSpaceMm":66},{"targetId":"p15-q19-c","widthMm":80,"mathematicalRows":6,"answerSpaceMm":45},{"targetId":"p15-q19-d","widthMm":80,"mathematicalRows":7,"answerSpaceMm":51},{"targetId":"p15-q19-e","widthMm":80,"mathematicalRows":6,"answerSpaceMm":36},{"targetId":"p15-q19-f","widthMm":80,"mathematicalRows":8,"answerSpaceMm":58}]},"sourcePagination":{"page":15,"breakBefore":true}},"flow":{"sourcePageBreakBefore":false,"localDifficulty":{"primarySkillId":"arithmetic-sequence-nth-term","secondarySkillIds":[],"reasoningScore":43,"difficulty":"Development","difficultyReason":"Find common differences and simplify general-term formulae involving logarithms, algebraic expressions, surds and decimals.","assessment":{"model":"gpt-6.1-sol","assessedAt":"2026-10-24T04:12:27.586Z","rubricVersion":"mathsmap-cognitive-demand-v1","taskHash":"0173117891528b9af577c3e914494d487cc870bb2d388d362561f2e36c425bf3","evidence":".booklet-work/full-imports/s6adv-sequences-and-series-2-arithmetic-sequences-and-series-20261024/semantic-packets/assignments/assignment-3bae23b4b4f28622aa8f/1/generation.json"}}},"snapshotKind":"local"},"p19-practice-1-block":{"id":"p19-practice-1-block","type":"question","sourcePageNumber":19,"sourceRefs":[{"pageNumber":19}],"content":{"id":"p19-practice-1-root","type":"question","label":"","prompt":"The 6th term of an arithmetic sequence is 23 and the sum of the first 10 terms is 210.\nFind the sum of the first 20 terms of the sequence.","answerSpaceMm":90,"answer":{"short":"$820$","worked":"Let $a$ be the first term and $d$ the common difference.\n$$\\begin{align*}a+5d&=23\\tag{1}\\\\\\frac{10}{2}[2a+9d]&=210\\\\2a+9d&=42\\tag{2}\\end{align*}$$\nTwice (1) gives $2a+10d=46$. Subtracting (2):\n$$\\begin{align*}d&=4\\\\a&=23-5(4)\\\\a&=3\\\\S_{20}&=\\frac{20}{2}[2(3)+(20-1)(4)]\\\\S_{20}&=10(82)\\\\S_{20}&=820\\end{align*}$$"}},"classification":{"primarySkillId":"arithmetic-series-sum","secondarySkillIds":["arithmetic-sequence-nth-term"],"reasoningScore":38,"difficulty":"Development","difficultyReason":"Translate the given term and partial sum into two linear equations, eliminate to find the parameters, then substitute into the sum formula.","assessment":{"model":"gpt-6.1-sol","assessedAt":"2026-10-24T04:13:44.728Z","rubricVersion":"mathsmap-cognitive-demand-v1","taskHash":"f2e9109bfa0bf9cb75dfe518543c37c1a2c5013311e7ca61e2bd9da59f671bd4","evidence":".booklet-work/full-imports/s6adv-sequences-and-series-2-arithmetic-sequences-and-series-20261024/semantic-packets/assignments/assignment-672f2ae5718978e9f0a2/1/generation.json"}},"sourceReview":{"sourceIdentity":{"questionLabel":"Practice \u2014 first question"},"teachingContext":{"pdfPages":[16,17,18,19],"methodNote":"Use a_n=a+(n-1)d and S_n=n/2[2a+(n-1)d], solve simultaneous equations by elimination and substitution, then evaluate the requested sum."},"responses":[{"targetId":"p19-practice-1-root","kind":"working"}],"workingSpaceEstimate":{"method":"solution-steps","estimates":[{"targetId":"p19-practice-1-root","widthMm":173,"mathematicalRows":10,"answerSpaceMm":90}]},"sourcePagination":{"page":19,"breakBefore":false}},"flow":{"sourcePageBreakBefore":false,"localDifficulty":{"primarySkillId":"arithmetic-series-sum","sec