              "classification": {
                "primarySkillId": "model-exponential-growth-decay-calculus",
                "secondarySkillIds": [],
                "reasoningScore": 57,
                "difficulty": "Development",
                "difficultyReason": "Differentiate an exponential decay model, solve logarithmic equations and distinguish an annual percentage decrease from an instantaneous decay rate."
              },
              "content": {
                "id": "p57-q8-root",
                "type": "question",
                "label": "8",
                "prompt": "A radioactive substance decays in such a way that the mass $M$ of a sample $t$ years after it has been measured and stored is $M=M_0e^{-0.1t}$, where $M_0$ is its original mass.",
                "children": [
                  {
                    "id": "p57-q8-a",
                    "type": "part",
                    "label": "a",
                    "prompt": "How long until half the sample is gone? Give your answer correct to three decimal places.",
                    "answerSpaceMm": 40,
                    "answer": {
                      "short": "$t=10\\ln 2\\approx6.931$ years.",
                      "worked": "Let $M=\\dfrac{M_0}{2}$.\n$$\\begin{aligned}\\frac12&=e^{-0.1t}\\\\\\ln\\left(\\frac12\\right)&=-0.1t\\\\t&=-10\\ln\\left(\\frac12\\right)\\\\&\\approx6.931\\text{ years}.\\end{aligned}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "source"
                      }
                    }
                  },
                  {
                    "id": "p57-q8-b",
                    "type": "part",
                    "label": "b",
                    "prompt": "Find the rate $\\dfrac{dM}{dt}$ at which the sample is decaying, and show that $\\dfrac{dM}{dt}=-0.1\\times M$.",
                    "answerSpaceMm": 20,
                    "answer": {
                      "short": "$\\dfrac{dM}{dt}=-0.1M_0e^{-0.1t}=-0.1M$.",
                      "worked": "$$\\begin{aligned}\\frac{dM}{dt}&=-0.1M_0e^{-0.1t}\\\\&=-0.1M.\\end{aligned}$$\nThe rate is measured in mass units per year.",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p57-q8-c",
                    "type": "part",
                    "label": "c",
                    "prompt": "What percentage of the remaining sample decays each year? Give your answer correct to three decimal places.",
                    "answerSpaceMm": 28,
                    "answer": {
                      "short": "$100(1-e^{-0.1})\\%\\approx9.516\\%$.",
                      "worked": "Every year the remaining mass is multiplied by $e^{-0.1}\\approx0.9048$.\n$$\\begin{aligned}\\text{Percentage decrease}&=100(1-e^{-0.1})\\%\\\\&\\approx9.516\\%.\\end{aligned}$$",
                      "provenance": {
                        "short": "source",
                        "worked": "authored"
                      }
                    }
                  },
                  {
                    "id": "p57-q8-d",
                    "type": "part",
                    "label": "d",
                    "prompt": "When will the rate of decay be $1\\%$ of the original mass $M_0$ per year? Give your answer correct to two decimal places.",
                    "answerSpaceMm": 48,
                    "answer": {
                      "short": "$t=10\\ln 10\\approx23.03$ years.",
                      "worked": "Let $\\dfrac{dM}{dt}=-0.01M_0$.\n$$\\begin{aligned}-0.1M_0e^{-0.1t}&=-0.01M_0\\\\e^{-0.1t}&=0.1\\\\-0.1t&=\\ln(0.1)\\\\t&=-10\\ln(0.1)\\\\&=10\\ln 10\\\\&\\approx23.03\\text{ years}.\\end{aligned}$$",
                      "provenance": {
                        "short": "authored",
                        "worked": "authored"
                      }
                    }
                  }
                ]
              },
