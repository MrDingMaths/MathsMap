  "content": {
    "id": "p57-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The population $P$ of cats on Snake Island is $P=1000e^{0.4t}$, where $t$ is the time in years after time zero when the population was first estimated.",
    "children": [
      {
        "id": "p57-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the rate at which the population is increasing.",
        "answerSpaceMm": 16,
        "answer": {
          "short": "$\\dfrac{dP}{dt}=400e^{0.4t}$ cats per year.",
          "worked": "$$\\begin{align*}\\frac{dP}{dt}&=1000(0.4)e^{0.4t}\\\\&=400e^{0.4t}\\end{align*}$$The population is increasing at $400e^{0.4t}$ cats per year.",
          "provenance": {
            "short": "source",
            "worked": "authored"
          }
        }
      },
      {
        "id": "p57-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the population, and the rate of increase, when $t=5$, both correct to 2 s.f.",
        "answerSpaceMm": 30,
        "answer": {
          "short": "$P(5)\\approx7.4\\times10^3$ cats; $P'(5)\\approx3.0\\times10^3$ cats per year.",
          "worked": "$$\\begin{align*}P(5)&=1000e^{0.4(5)}\\\\&\\approx7.4\\times10^3\\text{ cats}\\\\P'(5)&=400e^{0.4(5)}\\\\&\\approx3.0\\times10^3\\text{ cats per year}\\end{align*}$$Both answers are correct to 2 significant figures.",
          "provenance": {
            "short": "source",
            "worked": "authored"
          }
        }
      },
      {
        "id": "p57-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "When will the cat population reach $20\\,000$ cats, correct to one decimal place?",
        "answerSpaceMm": 38,
        "answer": {
          "short": "$t=\\dfrac{5}{2}\\ln20\\approx7.5$ years.",
          "worked": "$$\\begin{align*}1000e^{0.4t}&=20\\,000\\\\e^{0.4t}&=20\\\\0.4t&=\\ln20\\\\t&=\\frac{\\ln20}{0.4}\\\\&\\approx7.5\\text{ years}\\end{align*}$$",
          "provenance": {
            "short": "source",
            "worked": "authored"
          }
        }
      },
      {
        "id": "p57-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "When will the rate of increase reach $20\\,000$ cats per year, correct to one decimal place?",
        "answerSpaceMm": 38,
        "answer": {
          "short": "$t=\\dfrac{5}{2}\\ln50\\approx9.8$ years.",
          "worked": "$$\\begin{align*}400e^{0.4t}&=20\\,000\\\\e^{0.4t}&=50\\\\0.4t&=\\ln50\\\\t&=\\frac{\\ln50}{0.4}\\\\&\\approx9.8\\text{ years}\\end{align*}$$",
          "provenance": {
            "short": "source",
            "worked": "authored"
          }
        }
      }
    ]
  },
