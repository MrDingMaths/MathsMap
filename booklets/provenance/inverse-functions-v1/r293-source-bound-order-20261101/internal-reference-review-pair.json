    "content": {
      "id": "p11-q9-root",
      "type": "question",
      "label": "9",
      "prompt": "",
      "layout": "list",
      "children": [
        {
          "id": "p11-q9-root-initial",
          "type": "group",
          "label": null,
          "prompt": "When there are restrictions on a function, then the $x$ and $y$ must be swapped in these as well.",
          "layout": "grid",
          "columns": 2,
          "children": [
            {
              "id": "p11-q9-a",
              "type": "part",
              "label": "a",
              "prompt": {
                "format": "maths-editor-document-v1",
                "version": 1,
                "blocks": [
                  {
                    "id": "p11-q9-a-given",
                    "type": "paragraph",
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Find the inverse of"
                      },
                      {
                        "type": "break"
                      },
                      {
                        "type": "math",
                        "latex": "y=2x-3"
                      },
                      {
                        "type": "text",
                        "text": ", where "
                      },
                      {
                        "type": "math",
                        "latex": "x>1"
                      }
                    ],
                    "align": "left"
                  },
                  {
                    "id": "p11-q9-a-scaffold",
                    "type": "paragraph",
                    "align": "left",
                    "inlines": [
                      {
                        "type": "math",
                        "latex": "x=2y-3,\\quad y>1",
                        "colour": "#268cff"
                      }
                    ]
                  }
                ]
              },
              "answerSpaceMm": 22,
              "answer": {
                "short": "$y=\\frac{x+3}{2},\\quad y>1$",
                "worked": "$$\\begin{align*}x&=2y-3,\\quad y>1\\\\x+3&=2y\\\\y&=\\frac{x+3}{2},\\quad y>1\\end{align*}$$",
                "provenance": {
                  "short": "source",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p11-q9-b",
              "type": "part",
              "label": "b",
              "prompt": "Find the inverse of\n$y=3x-10$, where $x<2$.",
              "answerSpaceMm": 28,
              "answer": {
                "short": "$y=\\frac{x+10}{3},\\quad y<2$",
                "worked": "$$\\begin{align*}x&=3y-10,\\quad y<2\\\\x+10&=3y\\\\y&=\\frac{x+10}{3},\\quad y<2\\end{align*}$$",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p11-q9-c",
              "type": "part",
              "label": "c",
              "prompt": "Find the inverse of\n$y=x^3+2$, where $x<3$.",
              "answerSpaceMm": 27,
              "answer": {
                "short": "$y=\\sqrt[3]{x-2},\\quad y<3$",
                "worked": "$$\\begin{align*}x&=y^3+2,\\quad y<3\\\\x-2&=y^3\\\\y&=\\sqrt[3]{x-2},\\quad y<3\\end{align*}$$",
                "provenance": {
                  "short": "source",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p11-q9-d",
              "type": "part",
              "label": "d",
              "prompt": "Find the inverse of\n$y=13-6x$, where $x\\geq3$.",
              "answerSpaceMm": 28,
              "answer": {
                "short": "$y=\\frac{13-x}{6},\\quad y\\geq3$",
                "worked": "$$\\begin{align*}x&=13-6y,\\quad y\\geq3\\\\6y&=13-x\\\\y&=\\frac{13-x}{6},\\quad y\\geq3\\end{align*}$$",
                "provenance": {
                  "short": "source",
                  "worked": "authored"
                }
              }
            }
          ]
        },
        {
          "id": "p11-q10-root",
          "type": "group",
          "label": null,
          "prompt": "For each of parts a–d, the inverse has a restriction in terms of $y$. By solving the inequality, rewrite the restriction in terms of $x$.",
          "layout": "grid",
          "children": [
            {
              "id": "p11-q10-a",
              "type": "part",
              "label": "e",
              "prompt": {
                "format": "maths-editor-document-v1",
                "version": 1,
                "blocks": [
                  {
                    "id": "p11-q10-a-reference",
                    "type": "paragraph",
                    "inlines": [
                      {
                        "type": "text",
                        "text": "For part a."
                      }
                    ]
                  },
                  {
                    "id": "p11-q10-a-scaffold",
                    "type": "layout",
                    "arrangement": "scaffold",
                    "columns": 1,
                    "slots": [
                      {
                        "id": "p11-q10-a-scaffold-slot",
                        "blocks": [
                          {
                            "id": "p11-q10-a-supplied-inverse",
                            "type": "paragraph",
                            "align": "left",
                            "inlines": [
                              {
                                "type": "text",
                                "text": "The inverse was ",
                                "colour": "#268cff",
                                "marks": []
                              },
                              {
                                "type": "math",
                                "latex": "y=\\frac{1}{2}(x+3),\\quad y>1",
                                "display": false,
                                "colour": "#268cff"
                              }
                            ],
                            "fontSize": null,
                            "spaceBefore": 0,
                            "spaceAfter": 0,
                            "lineHeight": 1.4,
                            "indent": 0
                          },
                          {
                            "id": "p11-q10-a-supplied-inequality",
                            "type": "paragraph",
                            "align": "center",
                            "inlines": [
                              {
                                "type": "math",
                                "latex": "\\therefore\\frac{1}{2}(x+3)>1",
                                "display": true,
                                "colour": "#268cff"
                              }
                            ],
                            "fontSize": null,
                            "spaceBefore": 0,
                            "spaceAfter": 2,
                            "lineHeight": 1.4,
                            "indent": 0
                          }
                        ]
                      }
                    ],
                    "title": "",
                    "border": false,
                    "padding": 3,
                    "margin": 3,
                    "gap": 3
                  }
                ]
              },
              "answerSpaceMm": 22,
              "answer": {
                "short": "$y=\\frac{1}{2}(x+3),\\quad x>-1$.",
                "worked": "$$\\begin{align*}\\frac{1}{2}(x+3)&>1\\\\x+3&>2\\\\x&>-1\\end{align*}$$\nThus $y=\\frac{1}{2}(x+3)$, with domain $x>-1$.",
                "provenance": {
                  "short": "source",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p11-q10-b",
              "type": "part",
              "label": "f",
              "prompt": "For part b.",
              "answerSpaceMm": 30,
              "answer": {
                "short": "$y=\\frac{x+10}{3},\\quad x<-4$.",
                "worked": "From 10b, $y=\\frac{x+10}{3}$ and $y<2$.\n$$\\begin{align*}\\frac{x+10}{3}&<2\\\\x+10&<6\\\\x&<-4\\end{align*}$$\nThus $y=\\frac{x+10}{3}$, with domain $x<-4$.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p11-q10-c",
              "type": "part",
              "label": "g",
              "prompt": "For part c.",
              "answerSpaceMm": 30,
              "answer": {
                "short": "$y=\\sqrt[3]{x-2},\\quad x<29$.",
                "worked": "From 10c, $y=\\sqrt[3]{x-2}$ and $y<3$.\n$$\\begin{align*}\\sqrt[3]{x-2}&<3\\\\x-2&<27\\\\x&<29\\end{align*}$$\nCubing preserves the inequality because the cube function is increasing.\nThus $y=\\sqrt[3]{x-2}$, with domain $x<29$.",
                "provenance": {
                  "short": "source",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p11-q10-d",
              "type": "part",
              "label": "h",
              "prompt": "For part d.",
              "answerSpaceMm": 35,
              "answer": {
                "short": "$y=\\frac{13-x}{6},\\quad x\\le-5$.",
                "worked": "From 10d, $y=\\frac{13-x}{6}$ and $y\\ge3$.\n$$\\begin{align*}\\frac{13-x}{6}&\\ge3\\\\13-x&\\ge18\\\\-x&\\ge5\\\\x&\\le-5\\end{align*}$$\nMultiplying by $-1$ reverses the inequality.\nThus $y=\\frac{13-x}{6}$, with domain $x\\le-5$.",
                "provenance": {
                  "short": "source",
                  "worked": "authored"
                }
              }
            }
          ],
          "columns": 2
        }
      ]
    },
