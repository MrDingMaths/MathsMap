              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Develop and apply the formula to find the volume of a prism to solve problems",
                  "marks": [
                    "bold"
                  ]
                }
              ]
            },
            {
              "id": "p2-prism-block-2",
              "type": "list",
              "ordered": false,
              "start": 1,
              "indent": 7,
              "items": [
                {
                  "id": "p2-prism-bullet-1-item",
                  "type": "list-item",
                  "blocks": [
                    {
                      "id": "p2-prism-bullet-1",
                      "type": "paragraph",
                      "fontSize": null,
                      "align": "left",
                      "spaceBefore": 0,
                      "spaceAfter": 0,
                      "lineHeight": 1.4,
                      "indent": 0,
                      "inlines": [
                        {
                          "type": "text",
                          "text": "Develop the formula for the volume of a prism: ",
                          "marks": []
                        },
                        {
                          "type": "math",
                          "latex": "V = \\text{base area} \\times \\text{height}",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": ", leading to ",
                          "marks": []
                        },
                        {
                          "type": "math",
                          "latex": "V = Ah",
                          "display": false
                        }
                      ]
                    }
                  ]
                },
