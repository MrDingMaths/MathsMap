                      "lineHeight": 1.4,
                      "indent": 0,
                      "inlines": [
                        {
                          "type": "text",
                          "text": "Describe and illustrate solids formed from prism combinations from different views in 2 dimensions, including top, side, front and back views",
                          "marks": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "p2-views-bullet-3-item",
