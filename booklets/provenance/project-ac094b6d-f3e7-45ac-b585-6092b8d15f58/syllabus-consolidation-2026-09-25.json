                      "indent": 0,
                      "inlines": [
                        {
                          "type": "text",
                          "text": "Apply the formula for the volume of a prism to prisms with uniform cross-sections to solve problems",
                          "marks": []
                        }
                      ]
                    }
                  ]
                }
              ]
