      {
        "id": "p2-cylinder-heading",
        "type": "rich-text",
        "content": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p2-cylinder-block-1",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Develop the formula for finding the volume of a cylinder and apply the formula to solve problems",
                  "marks": [
                    "bold"
                  ]
                }
              ]
            },
            {
              "id": "p2-cylinder-block-2",
              "type": "list",
              "ordered": false,
              "start": 1,
              "indent": 7,
              "items": [
                {
                  "id": "p2-cylinder-bullet-1-item",
                  "type": "list-item",
                  "blocks": [
                    {
                      "id": "p2-cylinder-bullet-1",
                      "type": "paragraph",
                      "fontSize": null,
                      "align": "left",
                      "spaceBefore": 0,
                      "spaceAfter": 0,
                      "lineHeight": 1.4,
                      "indent": 0,
                      "inlines": [
                        {
                          "type": "text",
                          "text": "Develop and apply the formula to solve problems involving the volume of cylinders: ",
                          "marks": []
                        },
                        {
                          "type": "math",
                          "latex": "V = \\pi r^{2}h",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": ", where ",
                          "marks": []
                        },
                        {
                          "type": "math",
                          "latex": "r",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " is the length of the radius of the base and ",
                          "marks": []
                        },
                        {
                          "type": "math",
                          "latex": "h",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " is the perpendicular height",
                          "marks": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
