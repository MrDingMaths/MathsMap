                      "inlines": [
                        {
                          "type": "text",
                          "text": "Find the values of "
                        },
                        {
                          "type": "math",
                          "latex": "\\theta",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " in "
                        },
                        {
                          "type": "math",
                          "latex": "0^\\circ\\le\\theta\\le360^\\circ",
                          "display": false
                        },
                        {
                          "type": "text",
                          "text": " that satisfy the equation:"
                        }
                      ]
                    },
                    {
                      "id": "p75-q6-equation",
                      "type": "paragraph",
                      "align": "center",
                      "inlines": [
                        {
                          "type": "math",
                          "latex": "(\\tan\\theta-\\sqrt3)(\\cos^2\\theta-1)=0",
                          "display": true
                        }
                      ]
                    }
                  ]
                },
                "answerSpaceMm": 66,
                "answer": {
                  "short": "$\\theta=0^\\circ,60^\\circ,180^\\circ,240^\\circ,360^\\circ$.",
                  "worked": {
                    "format": "maths-editor-document-v1",
                    "version": 1,
                    "blocks": [
                      {
                        "id": "p75-q6-worked-method",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Using the null factor law:"
                          }
                        ]
                      },
                      {
                        "id": "p75-q6-worked-tangent",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\tan\\theta&=\\sqrt3\\\\\\theta&=60^\\circ,240^\\circ\\end{aligned}",
                            "display": true
                          }
                        ]
                      },
                      {
                        "id": "p75-q6-worked-cosine",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\cos^2\\theta&=1\\\\\\cos\\theta&=\\pm1\\\\\\theta&=0^\\circ,180^\\circ,360^\\circ\\end{aligned}",
                            "display": true
                          }
                        ]
                      },
                      {
                        "id": "p75-q6-worked-conclusion",
                        "type": "paragraph",
                        "align": "left",
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\therefore\\ \\theta=0^\\circ,60^\\circ,180^\\circ,240^\\circ,360^\\circ.",
                            "display": true
                          }
                        ]
                      }
                    ]
