                    "role": "question",
                    "reviewStatus": "needs-review",
                    "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 74 p74-q2-diagram\"}\n\\begin{tikzpicture}[line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\\coordinate (B) at (4,0);\\coordinate (C) at (5.25,2.165);\n\\draw[line width=0.8pt] (A)--node[below] {$6\\text{ cm}$}(B)--node[right] {$x\\text{ cm}$}(C)--cycle;\n\\node[left] at (A) {$A$};\\node[below right] at (B) {$B$};\\node[above right] at (C) {$C$};\n\\path (B)--node[pos=0.22,above left] {$120^\\circ$}(C);\n\\end{tikzpicture}",
                    "spec": {
                      "sourcePage": 74,
                      "sourceRegion": "Question 2 triangle",
                      "description": "Triangle ABC with horizontal AB, C above and to the right of B, and labels 6 cm on AB, x cm on BC and 120 degrees inside B.",
                      "mathematics": "AB=6 cm, BC=x cm and included angle ABC=120 degrees.",
                      "answerVisibility": "Givens only."
                    }
                  }
                ],
                "answerSpaceMm": 48,
                "answer": {
                  "short": "Correct answer: B.",
                  "worked": "$$\\begin{aligned}A&=\\frac12 ab\\sin C\\\\12-\\sqrt3&=\\frac12(6)x\\sin120^\\circ\\\\12-\\sqrt3&=\\frac{3\\sqrt3}{2}x\\\\x&=\\frac{2(12-\\sqrt3)}{3\\sqrt3}\\\\x&=\\frac{8\\sqrt3-2}{3}\\end{aligned}$$\nCorrect answer: B.",
                  "provenance": {
                    "short": "source",
                    "worked": "authored"
                  }
                }
