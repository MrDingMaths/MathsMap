  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Given the equation $2\\cos x-1=2\\cos2x$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\cos x=\\frac{1+\\sqrt5}{4}$ or $\\cos x=\\frac{1-\\sqrt5}{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos x=\\frac{1\\pm\\sqrt5}{4}$.",
          "worked": "$$\\begin{aligned}2\\cos x-1&=2(2\\cos^2x-1)\\\\2\\cos x-1&=4\\cos^2x-2\\\\4\\cos^2x-2\\cos x-1&=0\\\\\\cos x&=\\frac{2\\pm\\sqrt{4+16}}{8}\\\\&=\\frac{2\\pm\\sqrt{20}}{8}\\\\&=\\frac{1\\pm\\sqrt5}{4}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p17-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence solve the equation for $0\\leq x\\leq2\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac\\pi5,\\frac{3\\pi}5,\\frac{7\\pi}5$ or $\\frac{9\\pi}5$.",
          "worked": "$$\\begin{aligned}\\cos x&=\\frac{1+\\sqrt5}{4}:&x&=\\frac\\pi5,\\frac{9\\pi}5,\\\\\\cos x&=\\frac{1-\\sqrt5}{4}:&x&=\\frac{3\\pi}5,\\frac{7\\pi}5.\\end{aligned}$$\nTherefore $x=\\frac\\pi5,\\frac{3\\pi}5,\\frac{7\\pi}5$ or $\\frac{9\\pi}5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
