  "content": {
    "id": "p20-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "If $x=\\sqrt3+1$ and $y=\\sqrt3+2$, find, in simplest form:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac1x+\\dfrac1y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3-\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\frac1x+\\frac1y&=\\frac1{\\sqrt3+1}+\\frac1{\\sqrt3+2}\\\\\\frac1x+\\frac1y&=\\frac{\\sqrt3-1}{3-1}+\\frac{2-\\sqrt3}{4-3}\\\\\\frac1x+\\frac1y&=\\frac{\\sqrt3-1}{2}+2-\\sqrt3\\\\\\frac1x+\\frac1y&=\\frac{\\sqrt3-1+4-2\\sqrt3}{2}\\\\\\frac1x+\\frac1y&=\\frac{3-\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p20-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac1{x^2}+\\dfrac1{y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16-9\\sqrt3}{2}$\n\nRationalise the reciprocals, then square and collect like terms.",
          "worked": "$$\\begin{align*}\\frac1{x^2}+\\frac1{y^2}&=\\left(\\frac1{\\sqrt3+1}\\right)^2+\\left(\\frac1{\\sqrt3+2}\\right)^2\\\\\\frac1{x^2}+\\frac1{y^2}&=\\left(\\frac{\\sqrt3-1}{2}\\right)^2+(2-\\sqrt3)^2\\\\\\frac1{x^2}+\\frac1{y^2}&=\\frac{3-2\\sqrt3+1}{4}+4-4\\sqrt3+3\\\\\\frac1{x^2}+\\frac1{y^2}&=1-\\frac{\\sqrt3}{2}+7-4\\sqrt3\\\\\\frac1{x^2}+\\frac1{y^2}&=8-\\frac{9\\sqrt3}{2}\\\\\\frac1{x^2}+\\frac1{y^2}&=\\frac{16-9\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p20-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\sqrt3+10$",
          "worked": "$$\\begin{align*}x^3&=(\\sqrt3+1)^2(\\sqrt3+1)\\\\x^3&=(4+2\\sqrt3)(\\sqrt3+1)\\\\x^3&=4\\sqrt3+4+6+2\\sqrt3\\\\x^3&=6\\sqrt3+10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p20-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\sqrt3+26$",
          "worked": "$$\\begin{align*}y^3&=(\\sqrt3+2)^2(\\sqrt3+2)\\\\y^3&=(7+4\\sqrt3)(\\sqrt3+2)\\\\y^3&=7\\sqrt3+14+12+8\\sqrt3\\\\y^3&=15\\sqrt3+26\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
