    "children": [
      {
        "id": "p9-cc-1-6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\left(\\frac{\\pi}{2}-x\\right)=\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "By the complementary-angle identity,\n$$\\sin\\left(\\frac{\\pi}{2}-x\\right)=\\cos x.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p9-cc-1-6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\operatorname{cosec}\\left(\\frac{\\pi}{2}-x\\right)=\\sec x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}\\operatorname{cosec}\\left(\\frac{\\pi}{2}-x\\right)&=\\frac{1}{\\sin\\left(\\frac{\\pi}{2}-x\\right)}\\\\\\operatorname{cosec}\\left(\\frac{\\pi}{2}-x\\right)&=\\frac{1}{\\cos x}\\\\\\operatorname{cosec}\\left(\\frac{\\pi}{2}-x\\right)&=\\sec x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p9-cc-1-6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\left(\\frac{3\\pi}{2}-x\\right)=\\cot x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Tangent has period $\\pi$.\n$$\\begin{align*}\\tan\\left(\\frac{3\\pi}{2}-x\\right)&=\\tan\\left(\\frac{\\pi}{2}-x\\right)\\\\\\tan\\left(\\frac{3\\pi}{2}-x\\right)&=\\cot x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p9-cc-1-6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\left(\\frac{\\pi}{2}+x\\right)=\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}\\cos\\left(\\frac{\\pi}{2}+x\\right)&=\\cos\\left(\\frac{\\pi}{2}-(-x)\\right)\\\\\\cos\\left(\\frac{\\pi}{2}+x\\right)&=\\sin(-x)\\\\\\cos\\left(\\frac{\\pi}{2}+x\\right)&=-\\sin x.\\end{align*}$$\nThe proposed identity has the wrong sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p9-cc-1-6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cot\\left(\\frac{\\pi}{2}+x\\right)=\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}\\cot\\left(\\frac{\\pi}{2}+x\\right)&=\\frac{\\cos\\left(\\frac{\\pi}{2}+x\\right)}{\\sin\\left(\\frac{\\pi}{2}+x\\right)}\\\\\\cot\\left(\\frac{\\pi}{2}+x\\right)&=\\frac{\\sin(-x)}{\\cos(-x)}\\\\\\cot\\left(\\frac{\\pi}{2}+x\\right)&=\\frac{-\\sin x}{\\cos x}\\\\\\cot\\left(\\frac{\\pi}{2}+x\\right)&=-\\tan x.\\end{align*}$$\nThe proposed identity has the wrong sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p9-cc-1-6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sec\\left(\\frac{\\pi}{2}+x\\right)=\\operatorname{cosec}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}\\sec\\left(\\frac{\\pi}{2}+x\\right)&=\\frac{1}{\\cos\\left(\\frac{\\pi}{2}+x\\right)}\\\\\\sec\\left(\\frac{\\pi}{2}+x\\right)&=\\frac{1}{\\sin(-x)}\\\\\\sec\\left(\\frac{\\pi}{2}+x\\right)&=-\\frac{1}{\\sin x}\\\\\\sec\\left(\\frac{\\pi}{2}+x\\right)&=-\\operatorname{cosec}x.\\end{align*}$$\nThe proposed identity has the wrong sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
