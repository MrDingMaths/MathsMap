  "content": {
    "id": "p31-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the range of values of $x$ for which the curve $y=2x^3-3x^2-12x+8$ is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "increasing",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-1$ or $x>2$.",
          "worked": "$$\\begin{align*}y'&=6x^2-6x-12\\\\&=6(x-2)(x+1)\\\\y''&=12x-6\\\\&=6(2x-1).\\end{align*}$$\nFor increasing, $y'>0$. The factors $(x-2)$ and $(x+1)$ have the same sign when $x<-1$ or $x>2$.\n\nTherefore, $x<-1$ or $x>2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p31-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "decreasing",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1<x<2$.",
          "worked": "$$y'=6(x-2)(x+1).$$\nFor decreasing, $y'<0$. The factors have opposite signs between $-1$ and $2$.\n\nTherefore, $-1<x<2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p31-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "concave up",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\dfrac12$.",
          "worked": "$$y''=12x-6.$$\nFor concave up:\n$$\\begin{align*}y''&>0\\\\12x-6&>0\\\\x&>\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p31-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "concave down",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<\\dfrac12$.",
          "worked": "$$y''=12x-6.$$\nFor concave down:\n$$\\begin{align*}y''&<0\\\\12x-6&<0\\\\x&<\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
