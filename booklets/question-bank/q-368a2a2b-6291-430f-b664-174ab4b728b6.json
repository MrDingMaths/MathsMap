  "content": {
    "id": "p14-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Bricks are arranged on a concrete floor in 12 rows of 25, and stacked 4 bricks high. How many bricks are there in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1200$ bricks",
      "worked": "Using the any-order property:\n\n$$\\begin{align*}12\\times25\\times4&=12\\times(25\\times4)\\\\12\\times25\\times4&=12\\times100\\\\12\\times25\\times4&=1200\\end{align*}$$\n\nThere are $1200$ bricks in total.",
      "solutionDiagrams": []
    },
