  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The average $a$ of two numbers $m$ and $n$ is given by the formula $a=\\frac{m+n}{2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $a$ if $m=2$ and $n=8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}a&=\\frac{2+8}{2}\\\\a&=\\frac{10}{2}\\\\a&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $a$ if $m=6$ and $n=-10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}a&=\\frac{6+(-10)}{2}\\\\a&=\\frac{-4}{2}\\\\a&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $m$ if $a=6$ and $n=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}6&=\\frac{m+4}{2}\\\\12&=m+4\\\\12-4&=m\\\\m&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Find $a$ if $m=-2$ and $n=-6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}a&=\\frac{(-2)+(-6)}{2}\\\\a&=\\frac{-8}{2}\\\\a&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "Find $m$ if $a=0$ and $n=-9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}0&=\\frac{m+(-9)}{2}\\\\0&=m-9\\\\0+9&=m\\\\m&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
