      {
        "id": "p25-q5a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{1}{\\sqrt{1-4x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12\\sin^{-1}(2x)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{1}{\\sqrt{1-4x^2}}\\,dx&=\\frac12\\int\\frac{2}{\\sqrt{1-(2x)^2}}\\,dx\\\\&=\\frac12\\sin^{-1}(2x)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q5b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{1}{1+16x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14\\tan^{-1}(4x)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{1}{1+16x^2}\\,dx&=\\frac14\\int\\frac{4}{1+(4x)^2}\\,dx\\\\&=\\frac14\\tan^{-1}(4x)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p25-q5c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{-1}{\\sqrt{1-2x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{\\sqrt2}\\cos^{-1}(\\sqrt2x)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{-1}{\\sqrt{1-2x^2}}\\,dx&=\\frac{1}{\\sqrt2}\\int\\frac{-\\sqrt2}{\\sqrt{1-(\\sqrt2x)^2}}\\,dx\\\\&=\\frac{1}{\\sqrt2}\\cos^{-1}(\\sqrt2x)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p25-q5d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{1}{\\sqrt{4-9x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13\\sin^{-1}\\left(\\dfrac{3x}{2}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{1}{\\sqrt{4-9x^2}}\\,dx&=\\int\\frac{1}{2\\sqrt{1-(3x/2)^2}}\\,dx\\\\&=\\frac13\\int\\frac{3/2}{\\sqrt{1-(3x/2)^2}}\\,dx\\\\&=\\frac13\\sin^{-1}\\left(\\frac{3x}{2}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q5e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int\\frac{-1}{25+9x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac1{15}\\tan^{-1}\\left(\\dfrac{3x}{5}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{-1}{25+9x^2}\\,dx&=-\\frac1{25}\\int\\frac{1}{1+(3x/5)^2}\\,dx\\\\&=-\\frac1{15}\\int\\frac{3/5}{1+(3x/5)^2}\\,dx\\\\&=-\\frac1{15}\\tan^{-1}\\left(\\frac{3x}{5}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q5f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int\\frac{-1}{\\sqrt{3-4x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12\\cos^{-1}\\left(\\dfrac{2x}{\\sqrt3}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{-1}{\\sqrt{3-4x^2}}\\,dx&=\\int\\frac{-1}{\\sqrt3\\sqrt{1-(2x/\\sqrt3)^2}}\\,dx\\\\&=\\frac12\\int\\frac{-2/\\sqrt3}{\\sqrt{1-(2x/\\sqrt3)^2}}\\,dx\\\\&=\\frac12\\cos^{-1}\\left(\\frac{2x}{\\sqrt3}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
