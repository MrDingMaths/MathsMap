  "content": {
    "id": "p20-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The width of a rectangle is three times the length of the rectangle. The perimeter of the rectangle is 96 cm. Find the length and the width of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Length: $12\\text{ cm}$; width: $36\\text{ cm}$.",
      "worked": "Let the length be $x$ cm. Then the width is $3x$ cm.\n\n$$\\begin{align*}x+3x+x+3x&=96\\\\8x&=96\\\\x&=\\frac{96}{8}\\\\x&=12\\end{align*}$$\n\nThe length is $12\\text{ cm}$ and the width is $3\\times12=36\\text{ cm}$.\n\nCheck: $12+36+12+36=96\\text{ cm}$, and $36=3\\times12$.",
      "solutionDiagrams": []
    },
