    "label": "",
    "prompt": "Find the common ratio of a geometric sequence whose first term is 15 and limiting sum is 25.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{5}$",
      "worked": "$$\\begin{align*}S_\\infty&=\\frac{a}{1-r}\\\\25&=\\frac{15}{1-r}\\\\1-r&=\\frac{15}{25}\\\\-r&=-\\frac{2}{5}\\\\r&=\\frac{2}{5}\\end{align*}$$",
