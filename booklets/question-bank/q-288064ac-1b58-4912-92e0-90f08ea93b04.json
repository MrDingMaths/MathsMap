  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Use a similar technique to Question 11 to solve the following equations for $\\theta$ in the domain $\\theta\\in[0^\\circ,360^\\circ]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan 2\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=22.5^\\circ,112.5^\\circ,202.5^\\circ,292.5^\\circ$.",
          "worked": "Let $u=2\\theta$, so $u\\in[0^\\circ,720^\\circ]$.\n$$\\begin{align*}\\tan u&=1\\\\u&=45^\\circ,225^\\circ,405^\\circ,585^\\circ\\\\\\theta&=\\frac{u}{2}\\\\\\theta&=22.5^\\circ,112.5^\\circ,202.5^\\circ,292.5^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p20-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos 2\\theta=-\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^\\circ,120^\\circ,240^\\circ,300^\\circ$.",
          "worked": "Let $u=2\\theta$, so $u\\in[0^\\circ,720^\\circ]$. Cosine is negative in the second and third quadrants; the related angle is $60^\\circ$.\n$$\\begin{align*}\\cos u&=-\\frac12\\\\u&=120^\\circ,240^\\circ,480^\\circ,600^\\circ\\\\\\theta&=\\frac{u}{2}\\\\\\theta&=60^\\circ,120^\\circ,240^\\circ,300^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p20-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\frac{\\theta}{2}=-\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "Let $u=\\frac{\\theta}{2}$, so $u\\in[0^\\circ,180^\\circ]$.\n$$\\sin u=-\\frac12$$\nFor $u\\in[0^\\circ,180^\\circ]$, $\\sin u\\geq0$. Therefore there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p20-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos 3\\theta=\\frac1{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=15^\\circ,105^\\circ,135^\\circ,$ $225^\\circ,255^\\circ,345^\\circ$.\n\nSolve for $u=3\\theta$ on $[0^\\circ,1080^\\circ]$, then divide by $3$.",
          "worked": "Let $u=3\\theta$, so $u\\in[0^\\circ,1080^\\circ]$. Cosine is positive in the first and fourth quadrants; the related angle is $45^\\circ$.\n$$\\begin{align*}\\cos u&=\\frac1{\\sqrt2}\\\\u&=45^\\circ,315^\\circ,405^\\circ,\\\\&\\quad675^\\circ,765^\\circ,1035^\\circ\\\\\\theta&=\\frac{u}{3}\\\\\\theta&=15^\\circ,105^\\circ,135^\\circ,\\\\&\\quad225^\\circ,255^\\circ,345^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
