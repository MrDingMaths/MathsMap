    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "If $x = 5$, work out the value of $2x^2 - 4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$$\\begin{align*}2x^2-4x &= 2(5)^2-4(5)\\\\2x^2-4x &= 50-20\\\\2x^2-4x &= 30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Factorise $2x^2 - 4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x(x - 2)$",
          "worked": "The HCF is $2x$.\n$$\\begin{align*}2x^2-4x &= 2x(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q10-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p15-q10-c-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Determine the value of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "x",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " in this equation",
                  "marks": []
                }
              ]
            },
            {
              "id": "p15-q10-c-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "2x - 4 = 10",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 7$",
          "worked": "$$\\begin{align*}2x-4 &= 10\\\\2x &= 14\\\\x &= 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Expand $2x(x + 2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2 + 4x$",
          "worked": "$$\\begin{align*}2x(x+2) &= 2x\\times x+2x\\times2\\\\2x(x+2) &= 2x^2+4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
