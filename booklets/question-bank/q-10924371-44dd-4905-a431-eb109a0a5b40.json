  "content": {
    "id": "v2-p6-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Write the exact time for each population to reach its target as a logarithm.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-p6-practice-slot-1-slot-1-a",
        "type": "part",
        "label": "a",
        "prompt": "A culture begins with 1 cell and triples every hour. Find the time for the population to reach 500 cells.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\log_3 500$ hours.",
          "worked": "$$\\begin{align*}P&=3^t\\\\3^t&=500\\\\t&=\\log_3 500\\end{align*}$$The exact time is $\\log_3 500$ hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-p6-practice-slot-1-slot-1-b",
        "type": "part",
        "label": "b",
        "prompt": "A culture begins with 50 cells and quadruples every hour. Find the time for the population to reach 10000 cells.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\log_4 200$ hours.",
          "worked": "$$\\begin{align*}P&=50\\times4^t\\\\50\\times4^t&=10000\\\\4^t&=200\\\\t&=\\log_4 200\\end{align*}$$The exact time is $\\log_4 200$ hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
