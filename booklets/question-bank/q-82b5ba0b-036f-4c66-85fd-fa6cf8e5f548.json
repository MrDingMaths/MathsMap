    "children": [
      {
        "id": "p51-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\dfrac{d}{dx}(\\sqrt{x}+1)^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3(\\sqrt{x}+1)^2}{2\\sqrt{x}}$",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}(\\sqrt{x}+1)^3&=3(\\sqrt{x}+1)^2\\cdot\\frac{1}{2\\sqrt{x}}\\\\&=\\frac{3(\\sqrt{x}+1)^2}{2\\sqrt{x}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p51-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{3(\\sqrt{x}+1)^2}{2\\sqrt{x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sqrt{x}+1)^3+C$",
          "worked": "Using the derivative in part a,\n$$\\begin{aligned}\\int\\frac{3(\\sqrt{x}+1)^2}{2\\sqrt{x}}\\,dx&=(\\sqrt{x}+1)^3+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p51-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{(\\sqrt{x}+1)^2}{\\sqrt{x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac23(\\sqrt{x}+1)^3+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{(\\sqrt{x}+1)^2}{\\sqrt{x}}\\,dx&=\\frac23\\int\\frac{3(\\sqrt{x}+1)^2}{2\\sqrt{x}}\\,dx\\\\&=\\frac23(\\sqrt{x}+1)^3+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
