  "content": {
    "id": "p34-question-1-6-root",
    "type": "question",
    "label": "1",
    "prompt": "Evaluate the following, and express your answer as an exact value in simplest form.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-question-1-6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cot 90^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\cot 90^\\circ &= \\frac{\\cos 90^\\circ}{\\sin 90^\\circ}\\\\\\cot 90^\\circ &= \\frac{0}{1}\\\\\\cot 90^\\circ &= 0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-question-1-6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sec 45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sec 45^\\circ &= \\frac{1}{\\cos 45^\\circ}\\\\\\sec 45^\\circ &= \\frac{1}{1/\\sqrt{2}}\\\\\\sec 45^\\circ &= \\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-question-1-6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\operatorname{cosec} 30^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\operatorname{cosec} 30^\\circ &= \\frac{1}{\\sin 30^\\circ}\\\\\\operatorname{cosec} 30^\\circ &= \\frac{1}{1/2}\\\\\\operatorname{cosec} 30^\\circ &= 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-question-1-6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cot 150^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\cot 150^\\circ &= \\frac{1}{\\tan 150^\\circ}\\\\\\cot 150^\\circ &= \\frac{1}{-\\tan 30^\\circ}\\\\\\cot 150^\\circ &= \\frac{1}{-1/\\sqrt{3}}\\\\\\cot 150^\\circ &= -\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p34-question-1-6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sec 210^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}\\sec 210^\\circ &= \\frac{1}{\\cos 210^\\circ}\\\\\\sec 210^\\circ &= -\\frac{1}{\\cos 30^\\circ}\\\\\\sec 210^\\circ &= -\\frac{1}{\\sqrt{3}/2}\\\\\\sec 210^\\circ &= -\\frac{2\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p34-question-1-6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\operatorname{cosec} 300^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}\\operatorname{cosec} 300^\\circ &= \\frac{1}{\\sin 300^\\circ}\\\\\\operatorname{cosec} 300^\\circ &= -\\frac{1}{\\sin 60^\\circ}\\\\\\operatorname{cosec} 300^\\circ &= -\\frac{1}{\\sqrt{3}/2}\\\\\\operatorname{cosec} 300^\\circ &= -\\frac{2\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
