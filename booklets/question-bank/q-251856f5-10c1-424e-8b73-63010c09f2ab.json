    "children": [
      {
        "id": "p8-q7a",
        "type": "part",
        "label": "a",
        "prompt": "Find the first term $a$ and the common ratio $r$ of the GP $10,-30,90,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=10,\\ r=-3$",
          "worked": "$$\\begin{align*}a&=10\\\\r&=\\frac{-30}{10}=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q7b",
        "type": "part",
        "label": "b",
        "prompt": "Find the sixth term $a_6$ and an expression for the 25th term $a_{25}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_6=-2430,\\quad a_{25}=10\\times3^{24}$",
          "worked": "$$\\begin{align*}a_6&=ar^5=10(-3)^5=-2430\\\\a_{25}&=ar^{24}=10(-3)^{24}=10\\times3^{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q7c",
        "type": "part",
        "label": "c",
        "prompt": "Find a formula for the $n$th term $a_n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=10(-3)^{n-1}$",
          "worked": "$$\\begin{align*}a_n&=ar^{n-1}=10\\times(-3)^{n-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
