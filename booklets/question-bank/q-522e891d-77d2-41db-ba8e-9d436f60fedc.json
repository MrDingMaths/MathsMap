  "content": {
    "id": "v2-8b0de-p13-practice-j8-221729-root",
    "type": "question",
    "label": null,
    "prompt": "In a group of 60 students, 35 study Spanish, 28 study Japanese and 9 study neither language.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8b0de-p13-practice-j8-221729-j8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "How many students study Spanish or Japanese?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$51$",
          "worked": "$$\\begin{align*}\\text{Spanish or Japanese}&=60-9\\\\&=51\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-8b0de-p13-practice-j8-221729-j8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the number who study Spanish plus the number who study Japanese.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$63$",
          "worked": "$$\\begin{align*}35+28&=63\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-8b0de-p13-practice-j8-221729-j8-q-c",
        "type": "part",
        "label": "c",
        "prompt": "By how much does your answer to part b exceed your answer to part a?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}63-51&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-8b0de-p13-practice-j8-221729-j8-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the probability that a student chosen at random studies both languages.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "The students who study both were counted twice in part b, so the excess is the number who study both.\n$$\\begin{align*}P(\\text{both})&=\\frac{12}{60}\\\\&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
