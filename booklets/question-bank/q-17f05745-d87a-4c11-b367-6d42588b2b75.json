        "children": [],
        "answer": {
          "short": "22% decrease",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=1.3\\times0.6\\\\&=0.78\\\\\\text{Overall decrease}&=100\\%-78\\%\\\\&=22\\%\\end{align*}$$",
          "solutionDiagrams": []
