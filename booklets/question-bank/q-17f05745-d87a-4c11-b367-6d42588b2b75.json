        "label": "a",
        "prompt": "20% decrease is followed by a 30% increase.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4% increase",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=0.8\\times1.3\\\\&=1.04\\\\\\text{Overall increase}&=104\\%-100\\%\\\\&=4\\%\\end{align*}$$",
