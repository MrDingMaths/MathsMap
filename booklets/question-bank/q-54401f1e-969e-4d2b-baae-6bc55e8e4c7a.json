  "content": {
    "id": "p12-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The temperature in °C inside a room at a base in Antarctica is given by the expression $t^{2}-9t+8$, where $t$ is hours after 10 am.\nFind the times in the day when the temperature is 0°C.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "11 am and 6 pm.",
      "worked": "$$\\begin{align*}t^{2}-9t+8&=0\\\\(t-8)(t-1)&=0\\\\t&=1\\text{ or }8\\end{align*}$$\nThe temperature is 0°C at 11 am and 6 pm.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
