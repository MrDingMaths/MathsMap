  "content": {
    "id": "p30-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "At the start of the trading day, shares of a particular stock decrease in value by $20\\%$. However, by the end of the day the shares ‘recover’ and record a $15\\%$ increase from their lowest value. Determine the percentage decrease in the value of the shares over the course of the day.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8\\%$ decrease",
      "worked": "$$\\begin{align*}\\text{Final value}&=\\text{original value}\\times0.80\\times1.15\\\\\\text{Final value}&=\\text{original value}\\times0.92\\\\\\text{Percentage decrease}&=100\\%-92\\%\\\\\\text{Percentage decrease}&=8\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
