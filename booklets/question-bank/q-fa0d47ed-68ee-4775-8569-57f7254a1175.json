  "content": {
    "id": "p17-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Consider a ‘trapezium’ with $a=0$, $b=5$ and $h=3$, with all measurements in centimetres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the area using the formula.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.5\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{h(a+b)}{2}\\\\A&=\\frac{3(0+5)}{2}\\\\A&=7.5\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p17-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Sketch a diagram of this ‘trapezium’, what shape is it?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A triangle.",
          "worked": "The side of length $a=0$ collapses to a point, leaving a triangle with base $5\\text{ cm}$ and perpendicular height $3\\text{ cm}$.",
          "solutionDiagrams": [
            {
              "id": "p17-q11-b-solution-triangle",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 17 question 11b; authored solution sketch\"}\n\\begin{tikzpicture}[x=8mm,y=8mm,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (L) at (0,0);\n\\coordinate (R) at (5,0);\n\\coordinate (T) at (2.5,3);\n\\coordinate (F) at (2.5,0);\n\\draw[black,line width=0.8pt] (L)--(T)--(R)--cycle;\n\\draw[black,dashed,line width=0.4pt] (T)--(F) node[pos=0.82,right=1pt,fill=white,inner sep=1pt] {$h=3\\,\\mathrm{cm}$};\n\\draw[black,line width=0.4pt] (2.5,0.22)--(2.72,0.22)--(2.72,0);\n\\path (L)--(R) node[midway,below=3pt] {$b=5\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 58,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 17,
                "sourceRegion": "Question 11b",
                "description": "Authored illustrative triangle sketch; the source supplies the shape name but no completed sketch.",
                "mathematics": "The parallel side a has zero length. The remaining shape is a triangle with base 5 cm and perpendicular height 3 cm. The centred apex is an illustrative choice, not an additional source given.",
                "answerVisibility": "Solution only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p17-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Does this result match if you use the area formula for a triangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; the triangle also has area $7.5\\text{ cm}^2$.",
          "worked": "$$\\begin{align*}A&=\\frac{bh}{2}\\\\A&=\\frac{5\\times3}{2}\\\\A&=7.5\\text{ cm}^2\\end{align*}$$\nYes, this matches the result in part a.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
