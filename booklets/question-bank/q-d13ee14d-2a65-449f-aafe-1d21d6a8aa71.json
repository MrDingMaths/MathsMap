            {
              "type": "text",
              "text": "Bob claims that the area of a triangle formula can give negative area because when he used the cosine rule, he got a negative result for ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\cos C",
              "display": false
            },
