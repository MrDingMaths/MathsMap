  "content": {
    "id": "p8-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Express the following as a single fraction.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{2}{x}+\\frac{1}{x+1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x+2}{x(x+1)}$",
          "worked": "$$\\begin{aligned}\\frac{2}{x}+\\frac{1}{x+1}&=\\frac{2(x+1)+x}{x(x+1)}\\\\\\frac{2}{x}+\\frac{1}{x+1}&=\\frac{2x+2+x}{x(x+1)}\\\\\\frac{2}{x}+\\frac{1}{x+1}&=\\frac{3x+2}{x(x+1)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{4}{x-1}+\\frac{2}{x+2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6(x+1)}{(x-1)(x+2)}$",
          "worked": "$$\\begin{aligned}\\frac{4}{x-1}+\\frac{2}{x+2}&=\\frac{4(x+2)+2(x-1)}{(x-1)(x+2)}\\\\\\frac{4}{x-1}+\\frac{2}{x+2}&=\\frac{4x+8+2x-2}{(x-1)(x+2)}\\\\\\frac{4}{x-1}+\\frac{2}{x+2}&=\\frac{6x+6}{(x-1)(x+2)}\\\\\\frac{4}{x-1}+\\frac{2}{x+2}&=\\frac{6(x+1)}{(x-1)(x+2)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{x}{x-1}+\\frac{2x}{x+3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x(3x+1)}{(x-1)(x+3)}$",
          "worked": "$$\\begin{aligned}\\frac{x}{x-1}+\\frac{2x}{x+3}&=\\frac{x(x+3)+2x(x-1)}{(x-1)(x+3)}\\\\\\frac{x}{x-1}+\\frac{2x}{x+3}&=\\frac{x^2+3x+2x^2-2x}{(x-1)(x+3)}\\\\\\frac{x}{x-1}+\\frac{2x}{x+3}&=\\frac{3x^2+x}{(x-1)(x+3)}\\\\\\frac{x}{x-1}+\\frac{2x}{x+3}&=\\frac{x(3x+1)}{(x-1)(x+3)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{x+2}{x+3}-\\frac{x-1}{x-2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-2x-1}{(x-2)(x+3)}$",
          "worked": "$$\\begin{aligned}\\frac{x+2}{x+3}-\\frac{x-1}{x-2}&=\\frac{(x+2)(x-2)-(x-1)(x+3)}{(x+3)(x-2)}\\\\\\frac{x+2}{x+3}-\\frac{x-1}{x-2}&=\\frac{x^2-4-(x^2+2x-3)}{(x+3)(x-2)}\\\\\\frac{x+2}{x+3}-\\frac{x-1}{x-2}&=\\frac{x^2-4-x^2-2x+3}{(x+3)(x-2)}\\\\\\frac{x+2}{x+3}-\\frac{x-1}{x-2}&=\\frac{-2x-1}{(x-2)(x+3)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{2}{2x+1}-\\frac{x-4}{x-3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-2x^2+9x-2}{(x-3)(2x+1)}$",
          "worked": "$$\\begin{aligned}\\frac{2}{2x+1}-\\frac{x-4}{x-3}&=\\frac{2(x-3)-(x-4)(2x+1)}{(2x+1)(x-3)}\\\\\\frac{2}{2x+1}-\\frac{x-4}{x-3}&=\\frac{2x-6-(2x^2-7x-4)}{(2x+1)(x-3)}\\\\\\frac{2}{2x+1}-\\frac{x-4}{x-3}&=\\frac{2x-6-2x^2+7x+4}{(2x+1)(x-3)}\\\\\\frac{2}{2x+1}-\\frac{x-4}{x-3}&=\\frac{-2x^2+9x-2}{(x-3)(2x+1)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{x-1}{3x+2}-\\frac{x-2}{2x-1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-x^2+x+5}{(2x-1)(3x+2)}$",
          "worked": "$$\\begin{aligned}\\frac{x-1}{3x+2}-\\frac{x-2}{2x-1}&=\\frac{(x-1)(2x-1)-(x-2)(3x+2)}{(3x+2)(2x-1)}\\\\\\frac{x-1}{3x+2}-\\frac{x-2}{2x-1}&=\\frac{2x^2-3x+1-(3x^2-4x-4)}{(3x+2)(2x-1)}\\\\\\frac{x-1}{3x+2}-\\frac{x-2}{2x-1}&=\\frac{2x^2-3x+1-3x^2+4x+4}{(3x+2)(2x-1)}\\\\\\frac{x-1}{3x+2}-\\frac{x-2}{2x-1}&=\\frac{-x^2+x+5}{(2x-1)(3x+2)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
