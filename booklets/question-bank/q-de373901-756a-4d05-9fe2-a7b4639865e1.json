        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$.",
          "worked": "Here $x\\ne\\frac32$ and $4x-6=2(2x-3)$. Multiply both sides by $2(2x-3)$.\n$$\\begin{align*}4&=x\\\\x&=4\\end{align*}$$\nThe solution is permitted.",
          "solutionDiagrams": []
