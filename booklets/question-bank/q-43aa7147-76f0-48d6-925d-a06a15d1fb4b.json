      {
        "id": "v2-45f89-p18-practice-j6-090234-j6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The price is decreased by $100\\%$. What percentage of the original price remains?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0\\%$",
          "worked": "$$\\begin{align*}100\\%-100\\%&=0\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-45f89-p18-practice-j6-090234-j6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The price is decreased by $120\\%$. What percentage of the original price remains?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-20\\%$",
          "worked": "$$\\begin{align*}100\\%-120\\%&=-20\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-45f89-p18-practice-j6-090234-j6-q-c",
        "type": "part",
        "label": "c",
        "prompt": "What would the new price be after the $120\\%$ decrease?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\$100$",
          "worked": "$$\\begin{align*}-20\\%\\times500&=-0.2\\times500\\\\&=-100\\end{align*}$$\nThe price would be $-\\$100$, which is impossible for a sale price.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
