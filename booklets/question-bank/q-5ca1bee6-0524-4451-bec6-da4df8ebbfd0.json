  "content": {
    "id": "sum-product-b1-6-root",
    "type": "question",
    "label": null,
    "prompt": "Let $2+\\sqrt5$ be a root of the quadratic equation $x^2+bx-1=0$, where $b$ is a rational number. Find:\n\n(a) the other root\n\n(b) the value of $b$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "(a) $2-\\sqrt5$; (b) $b=-4$",
      "worked": "(a) Let the other root be $\\beta$.\n$$\\begin{aligned}(2+\\sqrt5)\\beta&=-1\\\\\\beta&=\\frac{-1}{2+\\sqrt5}\\\\&=\\frac{-(2-\\sqrt5)}{4-5}\\\\&=2-\\sqrt5\\end{aligned}$$\n(b)\n$$\\begin{aligned}(2+\\sqrt5)+(2-\\sqrt5)&=-b\\\\4&=-b\\\\b&=-4\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
