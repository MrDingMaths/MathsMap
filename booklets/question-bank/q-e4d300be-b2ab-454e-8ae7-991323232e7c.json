        "prompt": "$10n+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$103$",
          "worked": "$$\\begin{align*}10n+3&=10\\times10+3\\\\10n+3&=103\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$(10n)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\,000$",
          "worked": "$$\\begin{align*}(10n)^2&=(10\\times10)^2\\\\(10n)^2&=100^2\\\\(10n)^2&=10\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p25-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$3(20-n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$$\\begin{align*}3(20-n)&=3(20-10)\\\\3(20-n)&=3\\times10\\\\3(20-n)&=30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p25-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2n}{5}$",
