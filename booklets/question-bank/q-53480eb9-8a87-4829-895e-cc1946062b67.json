  "content": {
    "id": "p27-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If $x=2\\sqrt{3}$, find and rationalise the denominator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13\\sqrt{3}}{6}$",
          "worked": "$$\\begin{align*}x+\\frac1x&=2\\sqrt3+\\frac1{2\\sqrt3}\\\\x+\\frac1x&=2\\sqrt3+\\frac1{2\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}\\\\x+\\frac1x&=2\\sqrt3+\\frac{\\sqrt3}{6}\\\\x+\\frac1x&=\\frac{12\\sqrt3+\\sqrt3}{6}\\\\x+\\frac1x&=\\frac{13\\sqrt3}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p27-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x-\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11\\sqrt{3}}{6}$",
          "worked": "$$\\begin{align*}x-\\frac1x&=2\\sqrt3-\\frac1{2\\sqrt3}\\\\x-\\frac1x&=2\\sqrt3-\\frac1{2\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}\\\\x-\\frac1x&=2\\sqrt3-\\frac{\\sqrt3}{6}\\\\x-\\frac1x&=\\frac{12\\sqrt3-\\sqrt3}{6}\\\\x-\\frac1x&=\\frac{11\\sqrt3}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p27-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(x+\\dfrac{1}{x}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{169}{12}$",
          "worked": "Using part a:\n$$\\begin{align*}\\left(x+\\frac1x\\right)^2&=\\left(\\frac{13\\sqrt3}{6}\\right)^2\\\\\\left(x+\\frac1x\\right)^2&=\\frac{169\\times3}{36}\\\\\\left(x+\\frac1x\\right)^2&=\\frac{169}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p27-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(x-\\dfrac{1}{x}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{121}{12}$",
          "worked": "Using part b:\n$$\\begin{align*}\\left(x-\\frac1x\\right)^2&=\\left(\\frac{11\\sqrt3}{6}\\right)^2\\\\\\left(x-\\frac1x\\right)^2&=\\frac{121\\times3}{36}\\\\\\left(x-\\frac1x\\right)^2&=\\frac{121}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
