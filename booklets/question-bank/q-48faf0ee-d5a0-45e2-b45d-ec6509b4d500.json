  "content": {
    "id": "p9-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "First change each mixed numeral or decimal to a fraction, then simplify the expression.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(1\\frac{1}{2}\\right)^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{align*}\\left(1\\frac{1}{2}\\right)^{-1}&=\\left(\\frac{3}{2}\\right)^{-1}\\\\\\left(1\\frac{1}{2}\\right)^{-1}&=\\frac{1}{3/2}\\\\\\left(1\\frac{1}{2}\\right)^{-1}&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p9-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(2\\frac{2}{3}\\right)^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{8}$",
          "worked": "$$\\begin{align*}\\left(2\\frac{2}{3}\\right)^{-1}&=\\left(\\frac{8}{3}\\right)^{-1}\\\\\\left(2\\frac{2}{3}\\right)^{-1}&=\\frac{1}{8/3}\\\\\\left(2\\frac{2}{3}\\right)^{-1}&=\\frac{3}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p9-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(2\\frac{1}{2}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{25}$",
          "worked": "$$\\begin{align*}\\left(2\\frac{1}{2}\\right)^{-2}&=\\left(\\frac{5}{2}\\right)^{-2}\\\\\\left(2\\frac{1}{2}\\right)^{-2}&=\\frac{1}{(5/2)^2}\\\\\\left(2\\frac{1}{2}\\right)^{-2}&=\\frac{1}{25/4}\\\\\\left(2\\frac{1}{2}\\right)^{-2}&=\\frac{4}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(1\\frac{1}{3}\\right)^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{27}{64}$",
          "worked": "$$\\begin{align*}\\left(1\\frac{1}{3}\\right)^{-3}&=\\left(\\frac{4}{3}\\right)^{-3}\\\\\\left(1\\frac{1}{3}\\right)^{-3}&=\\frac{1}{(4/3)^3}\\\\\\left(1\\frac{1}{3}\\right)^{-3}&=\\frac{1}{64/27}\\\\\\left(1\\frac{1}{3}\\right)^{-3}&=\\frac{27}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "$0.2^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}0.2^{-1}&=\\left(\\frac{1}{5}\\right)^{-1}\\\\0.2^{-1}&=\\frac{1}{1/5}\\\\0.2^{-1}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p9-q16-f",
        "type": "part",
        "label": "f",
        "prompt": "$2.25^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{9}$",
          "worked": "$$\\begin{align*}2.25^{-1}&=\\left(\\frac{9}{4}\\right)^{-1}\\\\2.25^{-1}&=\\frac{1}{9/4}\\\\2.25^{-1}&=\\frac{4}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p9-q16-g",
        "type": "part",
        "label": "g",
        "prompt": "$2.5^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{25}$",
          "worked": "$$\\begin{align*}2.5^{-2}&=\\left(\\frac{5}{2}\\right)^{-2}\\\\2.5^{-2}&=\\frac{1}{(5/2)^2}\\\\2.5^{-2}&=\\frac{1}{25/4}\\\\2.5^{-2}&=\\frac{4}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q16-h",
        "type": "part",
        "label": "h",
        "prompt": "$0.05^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$400$",
          "worked": "$$\\begin{align*}0.05^{-2}&=\\left(\\frac{1}{20}\\right)^{-2}\\\\0.05^{-2}&=\\frac{1}{(1/20)^2}\\\\0.05^{-2}&=\\frac{1}{1/400}\\\\0.05^{-2}&=400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
