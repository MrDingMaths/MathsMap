                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the common denominator:",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p55-q4-root-bank-p55-q4-b-short-denominator",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(2\\sqrt5-\\sqrt7)(2\\sqrt5+\\sqrt7)=13",
                    "display": false
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{3}{2\\sqrt{5}-\\sqrt{7}}-\\frac{3}{2\\sqrt{5}+\\sqrt{7}}&=\\frac{3(2\\sqrt{5}+\\sqrt{7})-3(2\\sqrt{5}-\\sqrt{7})}{(2\\sqrt{5}-\\sqrt{7})(2\\sqrt{5}+\\sqrt{7})}\\\\&=\\frac{6\\sqrt{5}+3\\sqrt{7}-6\\sqrt{5}+3\\sqrt{7}}{(2\\sqrt{5})^2-(\\sqrt{7})^2}\\\\&=\\frac{6\\sqrt{7}}{20-7}\\\\&=\\frac{6\\sqrt{7}}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
