    "children": [
      {
        "id": "p55-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{\\sqrt{3}+1}+\\dfrac{1}{\\sqrt{3}-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{3}+1}+\\frac{1}{\\sqrt{3}-1}&=\\frac{(\\sqrt{3}-1)+(\\sqrt{3}+1)}{(\\sqrt{3}+1)(\\sqrt{3}-1)}\\\\&=\\frac{2\\sqrt{3}}{3-1}\\\\&=\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p55-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3}{2\\sqrt{5}-\\sqrt{7}}-\\dfrac{3}{2\\sqrt{5}+\\sqrt{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p55-q4-root-bank-p55-q4-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
