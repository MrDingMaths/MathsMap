    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The tangent to $y=x^2+ax-15$ is horizontal at the point $x=4$.\nFind the value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-8$",
      "worked": "A horizontal tangent has gradient $0$.\n$$\\begin{align*}y'&=2x+a\\\\y'(4)&=8+a=0\\\\a&=-8\\end{align*}$$",
