      }
    ],
    "children": [
      {
        "id": "p8-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the base and height of each triangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Base $b$, height $a$.",
          "worked": "The perpendicular legs have lengths $a$ and $b$, so the base is $b$ and the height is $a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of each triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{ab}{2}$",
          "worked": "$$\\begin{align*}A_{\\text{triangle}}&=\\frac12\\times b\\times a\\\\&=\\frac{ab}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the side length of the inner square?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b-a$",
          "worked": "The full leg of length $b$ consists of an inner-square side and a short leg of length $a$. The inner-square side is therefore $b-a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the area of the inner square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^2-2ab+a^2$",
          "worked": "$$\\begin{align*}A_{\\text{inner}}&=(b-a)(b-a)\\\\&=b^2-ab-ab+a^2\\\\&=b^2-2ab+a^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "Write an expression for the combined area of the four triangles and the inner square in terms of $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+b^2$",
          "worked": "$$\\begin{align*}A_{\\text{combined}}&=4\\left(\\frac{ab}{2}\\right)+(b^2-2ab+a^2)\\\\&=2ab+b^2-2ab+a^2\\\\&=a^2+b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p8-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "What theorem have you proven?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Pythagoras’ theorem: $a^2+b^2=c^2$.",
          "worked": "The outer square has area $c^2$. Its four triangles and inner square have combined area $a^2+b^2$, so $a^2+b^2=c^2$. This proves Pythagoras’ theorem.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
