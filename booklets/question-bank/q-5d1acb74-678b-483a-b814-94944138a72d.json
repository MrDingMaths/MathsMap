    "type": "question",
    "label": "3",
    "prompt": "The speed–time graph represents a cheetah seeing a gazelle and chasing it.\n\nThe cheetah catches the gazelle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p44-q3-graph",
