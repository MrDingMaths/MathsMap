    "children": [
      {
        "id": "p44-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Does the top graph represent the cheetah or the gazelle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cheetah.",
          "worked": "The top graph represents the cheetah: it reaches the greater speed and catches the gazelle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p44-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the cheetah’s acceleration in the initial stages of the chase.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.5\\text{ m/s}^2$",
          "worked": "$$\\begin{align*}\\text{Acceleration}&=\\frac{\\text{change in speed}}{\\text{time taken}}\\\\\\text{Acceleration}&=\\frac{30-0}{4-0}\\\\\\text{Acceleration}&=7.5\\text{ m/s}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p44-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the gazelle’s acceleration in the initial stages of the chase.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\text{ m/s}^2$",
          "worked": "$$\\begin{align*}\\text{Acceleration}&=\\frac{\\text{change in speed}}{\\text{time taken}}\\\\\\text{Acceleration}&=\\frac{20-0}{5-1}\\\\\\text{Acceleration}&=5\\text{ m/s}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p44-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Calculate the cheetah’s deceleration at the end.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\text{ m/s}^2$",
          "worked": "$$\\begin{align*}\\text{Acceleration}&=\\frac{0-30}{16-14}\\\\\\text{Acceleration}&=-15\\text{ m/s}^2\\end{align*}$$\nThe deceleration is the magnitude of the negative acceleration: $15\\text{ m/s}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
