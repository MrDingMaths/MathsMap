  "content": {
    "id": "p28-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q17-e",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x^2-x-20}{x^2-25}\\times\\frac{x^2-x-2}{x^2+2x-8}\\div\\frac{x+1}{x^2+5x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$",
          "worked": "$$\\begin{align*}\\frac{x^2-x-20}{x^2-25}\\times\\frac{x^2-x-2}{x^2+2x-8}\\div\\frac{x+1}{x^2+5x}&=\\frac{(x-5)(x+4)}{(x-5)(x+5)}\\times\\frac{(x-2)(x+1)}{(x+4)(x-2)}\\times\\frac{x(x+5)}{x+1}\\\\&=\\frac{x+4}{x+5}\\times\\frac{x+1}{x+4}\\times\\frac{x(x+5)}{x+1}\\\\&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p28-q17-f",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{x^2-8x+15}{5x^2+10x}\\div\\frac{x^2-9}{10x^2}\\times\\frac{x^2+5x+6}{2x-10}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$",
          "worked": "$$\\begin{align*}\\frac{x^2-8x+15}{5x^2+10x}\\div\\frac{x^2-9}{10x^2}\\times\\frac{x^2+5x+6}{2x-10}&=\\frac{(x-3)(x-5)}{5x(x+2)}\\times\\frac{10x^2}{(x-3)(x+3)}\\times\\frac{(x+2)(x+3)}{2(x-5)}\\\\&=\\frac{10x^2}{5x\\times2}\\\\&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p28-q17-g",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{100x^2-25}{2x^2-9x-5}\\div\\frac{5x^2+10x-75}{2x^2-5x-3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5(2x-1)(2x+1)}{(x-5)(x+5)}$",
          "worked": "$$\\begin{align*}\\frac{100x^2-25}{2x^2-9x-5}\\div\\frac{5x^2+10x-75}{2x^2-5x-3}&=\\frac{25(2x-1)(2x+1)}{(2x+1)(x-5)}\\times\\frac{(2x+1)(x-3)}{5(x+5)(x-3)}\\\\&=\\frac{5(2x-1)}{x-5}\\times\\frac{2x+1}{x+5}\\\\&=\\frac{5(2x-1)(2x+1)}{(x-5)(x+5)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p28-q17-h",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{3x^2-12}{30x+15}\\div\\frac{2x^2-3x-2}{4x^2+4x+1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{5}$",
          "worked": "$$\\begin{align*}\\frac{3x^2-12}{30x+15}\\div\\frac{2x^2-3x-2}{4x^2+4x+1}&=\\frac{3(x-2)(x+2)}{15(2x+1)}\\times\\frac{(2x+1)^2}{(2x+1)(x-2)}\\\\&=\\frac{3(x+2)}{15}\\\\&=\\frac{x+2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
