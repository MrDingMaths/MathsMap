  "content": {
    "id": "p39-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Convert these angles in decimal form to sexagesimal form and round to the nearest minute.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$25.2875^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25^{\\circ}\\,17'$",
          "worked": "$$\\begin{aligned}0.2875\\times60&=17.25\\\\0.25\\times60&=15\\\\25.2875^{\\circ}&=25^{\\circ}\\,17'\\,15''\\end{aligned}$$\nSince $15<30$, round down.\n$$25.2875^{\\circ}\\approx25^{\\circ}\\,17'$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$45.16666^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45^{\\circ}\\,10'$",
          "worked": "$$\\begin{aligned}0.16666\\times60&=9.9996\\\\0.9996\\times60&=59.976\\\\45.16666^{\\circ}&=45^{\\circ}\\,9'\\,59.976''\\end{aligned}$$\nSince $59.976\\ge30$, round up.\n$$45.16666^{\\circ}\\approx45^{\\circ}\\,10'$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$67.4916^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$67^{\\circ}\\,29'$",
          "worked": "$$\\begin{aligned}0.4916\\times60&=29.496\\\\0.496\\times60&=29.76\\\\67.4916^{\\circ}&=67^{\\circ}\\,29'\\,29.76''\\end{aligned}$$\nSince $29.76<30$, round down.\n$$67.4916^{\\circ}\\approx67^{\\circ}\\,29'$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$72.4215^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$72^{\\circ}\\,25'$",
          "worked": "$$\\begin{aligned}0.4215\\times60&=25.29\\\\0.29\\times60&=17.4\\\\72.4215^{\\circ}&=72^{\\circ}\\,25'\\,17.4''\\end{aligned}$$\nSince $17.4<30$, round down.\n$$72.4215^{\\circ}\\approx72^{\\circ}\\,25'$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$22.3^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22^{\\circ}\\,18'$",
          "worked": "$$\\begin{aligned}0.3\\times60&=18\\\\22.3^{\\circ}&=22^{\\circ}\\,18'\\,0''\\end{aligned}$$\nThere are no remaining seconds, so the nearest-minute answer is $22^{\\circ}\\,18'$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p39-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$87.252^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$87^{\\circ}\\,15'$",
          "worked": "$$\\begin{aligned}0.252\\times60&=15.12\\\\0.12\\times60&=7.2\\\\87.252^{\\circ}&=87^{\\circ}\\,15'\\,7.2''\\end{aligned}$$\nSince $7.2<30$, round down.\n$$87.252^{\\circ}\\approx87^{\\circ}\\,15'$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
