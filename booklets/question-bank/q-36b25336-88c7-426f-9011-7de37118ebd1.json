  "content": {
    "id": "p22-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Find the coefficient of the power of $x$ specified in each expansion.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{15}$ in $\\left(x^3-\\frac{2}{x}\\right)^9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-672$",
          "worked": "$$\\begin{align*}T_r&=\\binom{9}{r}(x^3)^{9-r}\\left(-\\frac{2}{x}\\right)^r\\\\&=\\binom{9}{r}(-2)^r x^{27-3r-r}\\\\&=\\binom{9}{r}(-2)^r x^{27-4r}.\\end{align*}$$\nFor $x^{15}$,\n$$\\begin{align*}27-4r&=15\\\\r&=3.\\end{align*}$$\nThe coefficient is $\\binom{9}{3}(-2)^3=84(-8)=-672$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{-14}$ in $(x-3x^{-4})^{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-112266$",
          "worked": "Indexing by the power of the first term,\n$$\\begin{align*}T_r&=\\binom{11}{r}x^r(-3x^{-4})^{11-r}\\\\&=\\binom{11}{r}(-3)^{11-r}x^{r-44+4r}\\\\&=\\binom{11}{r}(-3)^{11-r}x^{5r-44}.\\end{align*}$$\nFor $x^{-14}$,\n$$\\begin{align*}5r-44&=-14\\\\r&=6.\\end{align*}$$\nThe coefficient is $\\binom{11}{6}(-3)^5=462(-243)=-112266$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "The constant term in $\\left(\\frac{1}{2x^3}+x\\right)^{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{969}{2}$",
          "worked": "$$\\begin{align*}T_r&=\\binom{20}{r}\\left(\\frac{1}{2x^3}\\right)^{20-r}x^r\\\\&=\\binom{20}{r}2^{-(20-r)}x^{-60+3r+r}\\\\&=\\binom{20}{r}2^{r-20}x^{4r-60}.\\end{align*}$$\nThe constant term has power $0$:\n$$\\begin{align*}4r-60&=0\\\\r&=15.\\end{align*}$$\nThe constant term is\n$$\\begin{align*}\\binom{20}{15}2^{-5}&=\\frac{15504}{32}\\\\&=\\frac{969}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q21-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^7$ in $\\left(5x^2+\\frac{1}{2x}\\right)^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21875$",
          "worked": "$$\\begin{align*}T_r&=\\binom{8}{r}(5x^2)^{8-r}\\left(\\frac{1}{2x}\\right)^r\\\\&=\\binom{8}{r}5^{8-r}2^{-r}x^{16-2r-r}\\\\&=\\binom{8}{r}5^{8-r}2^{-r}x^{16-3r}.\\end{align*}$$\nFor $x^7$,\n$$\\begin{align*}16-3r&=7\\\\r&=3.\\end{align*}$$\nThe coefficient is\n$$\\begin{align*}\\binom{8}{3}5^5 2^{-3}&=\\frac{56\\times3125}{8}\\\\&=21875.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q21-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^{-1}$ in $\\left(x^{-1}+\\frac{2x}{7}\\right)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{40}{49}$",
          "worked": "$$\\begin{align*}T_r&=\\binom{5}{r}(x^{-1})^{5-r}\\left(\\frac{2x}{7}\\right)^r\\\\&=\\binom{5}{r}\\left(\\frac{2}{7}\\right)^r x^{-5+r+r}\\\\&=\\binom{5}{r}\\left(\\frac{2}{7}\\right)^r x^{2r-5}.\\end{align*}$$\nFor $x^{-1}$,\n$$\\begin{align*}2r-5&=-1\\\\r&=2.\\end{align*}$$\nThe coefficient is\n$$\\begin{align*}\\binom{5}{2}\\left(\\frac{2}{7}\\right)^2&=10\\times\\frac{4}{49}\\\\&=\\frac{40}{49}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
