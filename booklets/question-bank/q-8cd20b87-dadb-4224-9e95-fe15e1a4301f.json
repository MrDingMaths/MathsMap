        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"slot-13-q-diagram\"}\n\\begin{tikzpicture}[every node/.style={font=\\large}]\n\\coordinate (P) at (0,0);\n\\coordinate (Q) at (5.5,0);\n\\coordinate (R) at (3.447,2.892);\n\\draw[line width=0.8pt] (P)--(Q) node[midway,below] {$11$};\n\\draw[line width=0.8pt] (P)--(R) node[midway,above left] {$9$};\n\\draw[line width=0.8pt] (R)--(Q) node[midway,above right] {$x$};\n\\draw[line width=0.5pt] (0.6,0) arc (0:40:0.6);\n\\node at (1.32,0.48) {$40^\\circ$};\n\\draw[line width=0.5pt] ($(Q)+(180:0.6)$) arc (180:125.4:0.6);\n\\node at ($(Q)+(152.7:1.1)$) {$\\theta$};\n\\special{dvisvgm:raw <metadata data-diagram-colours=\"1\" data-diagram-kind=\"geometry\" data-diagram-base=\"\" data-diagram-semantic-palette=\"\" data-diagram-semantic-reference=\"slot-13-q-diagram\" data-diagram-semantic-reasons=\"\"/>}\n\\end{tikzpicture}",
