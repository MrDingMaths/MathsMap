    "children": [
      {
        "id": "v2-nr-p30-s1-slot-13-slot-13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $x$ using cosine rule to 4 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.0939$",
          "worked": "$$\\begin{align*}x^2&=11^2+9^2-2(11)(9)\\cos40^\\circ\\\\[8pt]x&=\\sqrt{202-198\\cos40^\\circ}\\\\[8pt]x&\\approx7.0939\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-nr-p30-s1-slot-13-slot-13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\theta$ to 2 d.p. using cosine rule.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=54.64^\\circ$",
          "worked": "Using the unrounded value of $x$,\n$$\\begin{align*}\\cos\\theta&=\\frac{x^2+11^2-9^2}{2(x)(11)}\\\\[8pt]\\theta&=\\cos^{-1}\\left(\\frac{x^2+11^2-9^2}{2(x)(11)}\\right)\\\\[8pt]\\theta&\\approx54.64^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-nr-p30-s1-slot-13-slot-13-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Use sine rule to find $\\theta$ to check your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=54.64^\\circ$, agreeing with part b.",
          "worked": "Use the unrounded value of $x$.\n$$\\begin{align*}\\frac{\\sin\\theta}{9}&=\\frac{\\sin40^\\circ}{x}\\\\[8pt]\\theta&=\\sin^{-1}\\left(\\frac{9\\sin40^\\circ}{x}\\right)\\\\[8pt]\\theta&\\approx54.64^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
