    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q22-opening",
        "type": "part",
        "label": "a",
        "prompt": "By taking 6th powers of both sides, show that $11^{\\frac13}<5^{\\frac12}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11^{\\frac13}<5^{\\frac12}$, since their sixth powers are $121<125$.",
          "worked": "$$\\begin{align*}(11^{\\frac13})^6&=11^2=121\\\\(5^{\\frac12})^6&=5^3=125\\end{align*}$$\nBoth numbers are positive, and taking sixth powers preserves their order. Since $121<125$, $11^{\\frac13}<5^{\\frac12}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q22-comparisons",
        "type": "group",
        "label": "",
        "prompt": "Using similar methods (followed perhaps by a check on the calculator), compare:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q22-a",
            "type": "part",
            "label": "b",
            "prompt": "$3^{\\frac13}$ and $2^{\\frac12}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3^{\\frac13}>2^{\\frac12}$.",
              "worked": "$$\\begin{align*}(3^{\\frac13})^6&=3^2=9\\\\(2^{\\frac12})^6&=2^3=8\\end{align*}$$\nSince $9>8$ and both original numbers are positive, $3^{\\frac13}>2^{\\frac12}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 43
          },
          {
            "id": "p13-q22-b",
            "type": "part",
            "label": "c",
            "prompt": "$2^{\\frac12}$ and $5^{\\frac15}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{\\frac12}>5^{\\frac15}$.",
              "worked": "$$\\begin{align*}(2^{\\frac12})^{10}&=2^5=32\\\\(5^{\\frac15})^{10}&=5^2=25\\end{align*}$$\nSince $32>25$ and both original numbers are positive, $2^{\\frac12}>5^{\\frac15}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 43
          },
          {
            "id": "p13-q22-c",
            "type": "part",
            "label": "d",
            "prompt": "$7^{\\frac32}$ and $20$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7^{\\frac32}<20$.",
              "worked": "$$\\begin{align*}(7^{\\frac32})^2&=7^3=343\\\\20^2&=400\\end{align*}$$\nSince $343<400$ and both original numbers are positive, $7^{\\frac32}<20$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 41
          },
          {
            "id": "p13-q22-d",
            "type": "part",
            "label": "e",
            "prompt": "$5^{\\frac15}$ and $3^{\\frac13}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5^{\\frac15}<3^{\\frac13}$.",
              "worked": "$$\\begin{align*}(5^{\\frac15})^{15}&=5^3=125\\\\(3^{\\frac13})^{15}&=3^5=243\\end{align*}$$\nSince $125<243$ and both original numbers are positive, $5^{\\frac15}<3^{\\frac13}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 46
          }
        ]
      }
    ]
  },
