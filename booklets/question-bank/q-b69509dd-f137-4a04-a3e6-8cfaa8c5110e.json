                "type": "math",
                "latex": "\\begin{align*}A&=(20\\times15)\\times2+(20\\times3)\\times2+(15\\times3)\\times2\\\\A&=600+120+90\\\\A&=810\\,\\mathrm{cm}^2\\end{align*}",
