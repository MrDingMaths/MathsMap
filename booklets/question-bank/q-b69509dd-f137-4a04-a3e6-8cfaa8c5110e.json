                "type": "math",
                "latex": "\\begin{align*}A_{1000}&=810\\times1000\\\\A_{1000}&=810\\,000\\,\\mathrm{cm}^2\\\\A_{1000}&=\\frac{810\\,000}{100^2}\\,\\mathrm{m}^2\\\\A_{1000}&=81\\,\\mathrm{m}^2\\end{align*}",
