  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A book measuring 20 cm long, 15 cm wide and 3 cm thick is covered in plastic.\n\nWhat area of plastic is needed to cover 1000 books? Convert your answer to $\\mathrm{m}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$81\\,\\mathrm{m}^2$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "c86fc55a-2a4d-4f12-8424-e10ccca0d47e-compact-0",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
