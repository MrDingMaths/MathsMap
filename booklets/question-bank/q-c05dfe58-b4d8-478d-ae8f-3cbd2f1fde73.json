  "content": {
    "id": "p13-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A model is made of a statue and the volumes of the statue and its model are in the ratio $27:1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the ratio of the height of the statue to the height of the model?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:1$",
          "worked": "The length ratio is the cube root of the volume ratio.\n$$\\begin{align*}\\text{Statue : model}&=\\sqrt[3]{27}:\\sqrt[3]{1}\\\\&=3:1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the ratio of the surface areas?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9:1$",
          "worked": "Square the length ratio, keeping the order statue : model.\n$$\\begin{align*}\\text{Surface-area ratio}&=3^2:1^2\\\\&=9:1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
