  "content": {
    "id": "v2-55815-p13-practice-j4-082156-root",
    "type": "question",
    "label": null,
    "prompt": "A test has a mean mark of 72. A mark of 84 has a $z$-score of $1.5$, so\n$$1.5=\\frac{84-72}{\\sigma}.$$\nRearrange to find the standard deviation $\\sigma$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sigma=8$",
      "worked": "$$\\begin{align*}1.5&=\\frac{84-72}{\\sigma}\\\\1.5&=\\frac{12}{\\sigma}\\\\1.5\\sigma&=12\\\\\\sigma&=\\frac{12}{1.5}\\\\\\sigma&=8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
