    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the median, upper quartile and lower quartile.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Median $=\\$149$, upper quartile $=\\$153.50$, lower quartile $=\\$143$.",
          "worked": "In ascending order, the amounts in dollars are:\n$$139,141,143,143,147,148,149,150,152,152,155,158,158.$$\nThere are 13 values, so the median is the seventh value, $\\$149$. Omit this value when dividing the data into two groups of six. Average the two middle values in each group.\n$$\\begin{align*}Q_3&=\\frac{152+155}{2}\\\\Q_3&=153.50\\\\Q_1&=\\frac{143+143}{2}\\\\Q_1&=143\\end{align*}$$\nThus the upper quartile is $\\$153.50$ and the lower quartile is $\\$143$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the interquartile range of the amounts spent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$10.50$.",
          "worked": "$$\\begin{align*}\\text{IQR}&=Q_3-Q_1\\\\\\text{IQR}&=153.50-143\\\\\\text{IQR}&=10.50\\end{align*}$$\nThe interquartile range is $\\$10.50$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
