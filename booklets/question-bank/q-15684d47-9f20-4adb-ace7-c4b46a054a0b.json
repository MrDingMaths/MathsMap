  "content": {
    "id": "p15-g41-44-root",
    "type": "question",
    "label": null,
    "prompt": "By using the identity $a^{\\log_a(x)}=x$, simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-g41-44-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^{\\log_a(1)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "For $a>0$, $a\\ne1$, the inverse identity gives\n$$\\begin{align*}a^{\\log_a(1)}&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-g41-44-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^{\\log_a(a^x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^x$",
          "worked": "For $a>0$, $a\\ne1$, the argument $a^x$ is positive. The inverse identity gives\n$$\\begin{align*}a^{\\log_a(a^x)}&=a^x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-g41-44-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^{\\log_4(a)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a$",
          "worked": "For $a>0$, the inverse identity gives\n$$\\begin{align*}4^{\\log_4(a)}&=a.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-g41-44-d",
        "type": "part",
        "label": "d",
        "prompt": "$e^{\\ln(2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$\\ln(2)=\\log_e(2)$, so\n$$\\begin{align*}e^{\\ln(2)}&=e^{\\log_e(2)}\\\\e^{\\ln(2)}&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
