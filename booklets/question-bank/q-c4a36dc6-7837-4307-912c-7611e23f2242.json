  "content": {
    "id": "p27-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "For each of the following functions, state the values of $x$ for which $f(x)$ is decreasing.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-6x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<3$",
          "worked": "$$\\begin{align*}y'&=2x-6\\\\2x&<6\\\\x&<3\\end{align*}$$ The last two lines solve $y'<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p27-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=10-4x-2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-1$",
          "worked": "$$\\begin{align*}y'&=-4-4x\\\\-4x&<4\\\\x&>-1\\end{align*}$$ The inequality reverses when dividing by $-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p27-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{x}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<4$ or $x>4$.",
          "worked": "$$\\begin{align*}y'&=\\frac{(x-4)-x}{(x-4)^2}\\\\y'&=-\\frac{4}{(x-4)^2}\\end{align*}$$ The denominator is positive wherever the function is defined. The curve is decreasing on $(-\\infty,4)$ and $(4,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p27-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^3-3x^2-24x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2<x<4$",
          "worked": "$$\\begin{align*}y'&=3x^2-6x-24\\\\y'&=3(x+2)(x-4)\\end{align*}$$ The factors have opposite signs between the roots $-2$ and $4$. Thus $y'<0$ for $-2<x<4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
