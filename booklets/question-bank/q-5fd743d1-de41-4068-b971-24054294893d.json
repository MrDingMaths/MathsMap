        "type": "part",
        "label": "a",
        "prompt": "Simplify $\\frac{(a^3)^2\\times a^4}{(a^2)^5}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{(a^3)^2\\times a^4}{(a^2)^5}&=\\frac{a^6\\times a^4}{a^{10}} \\\\ &=\\frac{a^{10}}{a^{10}}=1\\qquad(a\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Does the value of $a$ matter?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "dependsOn": [
          "index-t7-q19-a"
        ],
        "answer": {
          "short": "No, provided $a\\ne0$.",
          "worked": "Every nonzero value of $a$ gives $1$. At $a=0$, the denominator is zero, so the expression is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
