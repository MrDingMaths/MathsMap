  "content": {
    "id": "p38-cc-5-root",
    "type": "question",
    "label": "3",
    "prompt": "Bob is asked to differentiate $y=\\dfrac{u}{v}$ using the quotient rule. He recognises that differentiating $\\dfrac{v}{u}$ is much easier, so he differentiates $\\dfrac{v}{u}$, also using the quotient rule, and then he flips back the result afterwards. Will this work?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No. The derivative of a reciprocal is not the reciprocal of the derivative.",
      "worked": "Let $g=\\dfrac{v}{u}=\\dfrac1y$. Then $g'=-\\dfrac{y'}{y^2}$, so $y'=-\\dfrac{g'}{g^2}$ wherever the expressions are defined. Taking $\\frac{1}{g}'$ does not give $y'$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 22
  },
