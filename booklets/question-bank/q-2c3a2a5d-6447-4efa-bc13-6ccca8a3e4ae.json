    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt{a+b}+a)(\\sqrt{a+b}-a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b-a^2$",
          "worked": "$$\\begin{align*}(\\sqrt{a+b}+a)(\\sqrt{a+b}-a)&=(\\sqrt{a+b})^2-a^2\\\\(\\sqrt{a+b}+a)(\\sqrt{a+b}-a)&=a+b-a^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2\\sqrt{1+x^2}+1)(2\\sqrt{1+x^2}-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+4x^2$",
          "worked": "$$\\begin{align*}(2\\sqrt{1+x^2}+1)(2\\sqrt{1+x^2}-1)&=(2\\sqrt{1+x^2})^2-1^2\\\\(2\\sqrt{1+x^2}+1)(2\\sqrt{1+x^2}-1)&=4(1+x^2)-1\\\\(2\\sqrt{1+x^2}+1)(2\\sqrt{1+x^2}-1)&=3+4x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\sqrt{1+x}+\\sqrt{1-x})(\\sqrt{1+x}-\\sqrt{1-x})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$",
          "worked": "$$\\begin{align*}(\\sqrt{1+x}+\\sqrt{1-x})(\\sqrt{1+x}-\\sqrt{1-x})&=(\\sqrt{1+x})^2-(\\sqrt{1-x})^2\\\\(\\sqrt{1+x}+\\sqrt{1-x})(\\sqrt{1+x}-\\sqrt{1-x})&=(1+x)-(1-x)\\\\(\\sqrt{1+x}+\\sqrt{1-x})(\\sqrt{1+x}-\\sqrt{1-x})&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a-b}{\\sqrt a-\\sqrt b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt a+\\sqrt b$",
          "worked": "$$\\begin{align*}\\frac{a-b}{\\sqrt a-\\sqrt b}&=\\frac{(\\sqrt a-\\sqrt b)(\\sqrt a+\\sqrt b)}{\\sqrt a-\\sqrt b}\\\\\\frac{a-b}{\\sqrt a-\\sqrt b}&=\\sqrt a+\\sqrt b\\end{align*}$$\nThe original denominator requires $a\\ne b$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p24-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt{a+b}+\\sqrt{a-b})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a+2\\sqrt{a^2-b^2}$\n\nExpand the square and combine the two radicands in the cross term.",
          "worked": "$$\\begin{align*}(\\sqrt{a+b}+\\sqrt{a-b})^2&=(a+b)+2\\sqrt{a+b}\\sqrt{a-b}+(a-b)\\\\(\\sqrt{a+b}+\\sqrt{a-b})^2&=2a+2\\sqrt{(a+b)(a-b)}\\\\(\\sqrt{a+b}+\\sqrt{a-b})^2&=2a+2\\sqrt{a^2-b^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
