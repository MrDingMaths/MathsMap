      {
        "id": "p11-multiples-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that each of the numbers $68\\,839$, $88\\,396$, $83\\,968$, $39\\,688$ and $96\\,883$ is a multiple of 41.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$68\\,839=1679\\times41$; $88\\,396=2156\\times41$; $83\\,968=2048\\times41$; $39\\,688=968\\times41$; $96\\,883=2363\\times41$.",
          "worked": "$$\\begin{align*}68\\,839&=1679\\times41\\\\88\\,396&=2156\\times41\\\\83\\,968&=2048\\times41\\\\39\\,688&=968\\times41\\\\96\\,883&=2363\\times41\\end{align*}$$\nEach number is a whole-number multiple of 41.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p11-multiples-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Try some more five-digit multiples of 41 to see what happens.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answers: the clockwise rotations of $12\\,341$ and $24\\,682$ are all multiples of 41.",
          "worked": "For example:\n$$\\begin{align*}12\\,341&=301\\times41\\\\23\\,411&=571\\times41\\\\34\\,112&=832\\times41\\\\41\\,123&=1003\\times41\\\\11\\,234&=274\\times41\\\\24\\,682&=602\\times41\\\\46\\,822&=1142\\times41\\\\68\\,224&=1664\\times41\\\\82\\,246&=2006\\times41\\\\22\\,468&=548\\times41\\end{align*}$$\nIn both examples, every clockwise rotation is also a multiple of 41.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 82
      }
    ]
