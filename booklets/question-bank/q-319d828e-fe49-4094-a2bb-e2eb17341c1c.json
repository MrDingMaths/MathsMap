  "content": {
    "id": "p32-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "For each PDF, find $F(x)$ and confirm $F(b)=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\frac{1}{32}x$, where $0\\le x\\le 8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\frac{x^2}{64}$ for $0\\le x\\le8$; $F(8)=1$.",
          "worked": "$$\\begin{align*}F(x)&=\\int_0^x\\frac{t}{32}\\,dt\\\\F(x)&=\\left[\\frac{t^2}{64}\\right]_0^x\\\\F(x)&=\\frac{x^2}{64}\\\\F(8)&=\\frac{8^2}{64}=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p32-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\frac{3}{16}x^2$, where $-2\\le x\\le2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\frac{x^3+8}{16}$ for $-2\\le x\\le2$; $F(2)=1$.",
          "worked": "$$\\begin{align*}F(x)&=\\int_{-2}^x\\frac{3t^2}{16}\\,dt\\\\F(x)&=\\left[\\frac{t^3}{16}\\right]_{-2}^x\\\\F(x)&=\\frac{x^3-(-2)^3}{16}\\\\F(x)&=\\frac{x^3+8}{16}\\\\F(2)&=\\frac{2^3+8}{16}=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p32-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\frac32(1-x^2)$, where $0\\le x\\le1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\frac{3x-x^3}{2}$ for $0\\le x\\le1$; $F(1)=1$.",
          "worked": "$$\\begin{align*}F(x)&=\\int_0^x\\frac32(1-t^2)\\,dt\\\\F(x)&=\\left[\\frac{3t-t^3}{2}\\right]_0^x\\\\F(x)&=\\frac{3x-x^3}{2}\\\\F(1)&=\\frac{3-1}{2}=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p32-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\frac1e(e^x+1)$, where $0\\le x\\le1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\frac{e^x+x-1}{e}$ for $0\\le x\\le1$; $F(1)=1$.",
          "worked": "$$\\begin{align*}F(x)&=\\frac1e\\int_0^x(e^t+1)\\,dt\\\\F(x)&=\\frac1e\\left[e^t+t\\right]_0^x\\\\F(x)&=\\frac{e^x+x-1}{e}\\\\F(1)&=\\frac{e+1-1}{e}\\\\F(1)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
