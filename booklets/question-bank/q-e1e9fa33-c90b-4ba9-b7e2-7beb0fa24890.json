    "type": "question",
    "label": "25",
    "prompt": "How many diagonals are in a regular $n$-sided polygon?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\displaystyle\\binom{n}{2}-n=\\frac{n(n-3)}{2}$ diagonals.\n\nCount all pairs of vertices, then subtract the $n$ sides.",
      "worked": "Each pair of vertices determines either a side or a diagonal. There are $n$ sides.\n\n$$\\begin{align*}D&=\\binom{n}{2}-n\\\\D&=\\frac{n(n-1)}{2}-n\\\\D&=\\frac{n(n-3)}{2}.\\end{align*}$$",
      "solutionDiagrams": []
    },
