        "prompt": "$\\frac{x}{2}+\\frac{x}{3}=x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6$",
          "worked": "$$\\begin{align*}\\frac{3x}{6}+\\frac{2x}{6}&=x+1\\\\\\frac{5x}{6}&=x+1\\\\5x&=6(x+1)\\\\5x&=6x+6\\\\x&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-21edb-p17-practice-slot-7-upper-slot-7-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x+3}{2}-\\frac{x-1}{3}=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=13$",
          "worked": "$$\\begin{align*}\\frac{3(x+3)}{6}-\\frac{2(x-1)}{6}&=4\\\\\\frac{3(x+3)-2(x-1)}{6}&=4\\\\3(x+3)-2(x-1)&=24\\\\x+11&=24\\\\x&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-21edb-p17-practice-slot-7-upper-slot-7-upper-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2x-1}{4}-\\frac{x+2}{6}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{19}{4}$",
          "worked": "$$\\begin{align*}\\frac{3(2x-1)}{12}-\\frac{2(x+2)}{12}&=1\\\\3(2x-1)-2(x+2)&=12\\\\4x-7&=12\\\\4x&=19\\\\x&=\\frac{19}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-21edb-p17-practice-slot-7-upper-slot-7-upper-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{3}+\\frac{x-2}{4}=x-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{54}{5}$",
          "worked": "$$\\begin{align*}\\frac{4x}{12}+\\frac{3(x-2)}{12}&=x-5\\\\4x+3(x-2)&=12(x-5)\\\\7x-6&=12x-60\\\\54&=5x\\\\x&=\\frac{54}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "v2-21edb-p17-practice-slot-7-upper-slot-7-upper-q-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3x+1}{5}-\\frac{x-4}{10}=\\frac{2x+1}{5}$",
