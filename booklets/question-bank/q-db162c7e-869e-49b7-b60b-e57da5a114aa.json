    "reasoningScore": 36,
    "difficulty": "Development",
    "difficultyReason": "Compare consecutive differences, identify APs and simplify their nth-term formulas, including fractional and surd terms.",
    "assessment": {
      "model": "gpt-6.1-sol",
      "assessedAt": "2026-10-24T04:09:17.565Z",
      "rubricVersion": "mathsmap-cognitive-demand-v1",
      "taskHash": "907f34b45b6a98bc9e89032bf925cb4bdd697a97c03acf6b8e4ee85478d3fb22",
      "evidence": ".booklet-work/full-imports/s6adv-sequences-and-series-2-arithmetic-sequences-and-series-20261024/semantic-packets/assignments/assignment-34a9228576fb32828477/1/generation.json"
    }
  },
  "content": {
    "id": "p9-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find $a_3-a_2$ and $a_2-a_1$ to test whether each sequence is an AP.\nIf the sequence is an AP, use $a_n=a+(n-1)d$ to find a formula for the $n$th term $a_n$.\nAnswer in simplified form.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$8,11,14,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "AP; $d=3$, $a_n=5+3n$.",
          "worked": "$$\\begin{align*}a_2-a_1&=11-8=3\\\\a_3-a_2&=14-11=3\\\\d&=3\\\\a_n&=a+(n-1)d\\\\a_n&=8+(n-1)(3)\\\\a_n&=8+3n-3\\\\a_n&=5+3n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$21,15,9,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "AP; $d=-6$, $a_n=27-6n$.",
          "worked": "$$\\begin{align*}a_2-a_1&=15-21=-6\\\\a_3-a_2&=9-15=-6\\\\d&=-6\\\\a_n&=a+(n-1)d\\\\a_n&=21+(n-1)(-6)\\\\a_n&=21-6n+6\\\\a_n&=27-6n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$8,4,2,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not an AP; the differences are $-4$ and $-2$.",
          "worked": "$$\\begin{align*}a_2-a_1&=4-8=-4\\\\a_3-a_2&=2-4=-2\\end{align*}$$\nThe differences are unequal, so the sequence is not an AP.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$-3,1,5,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "AP; $d=4$, $a_n=4n-7$.",
          "worked": "$$\\begin{align*}a_2-a_1&=1-(-3)=4\\\\a_3-a_2&=5-1=4\\\\d&=4\\\\a_n&=a+(n-1)d\\\\a_n&=-3+(n-1)(4)\\\\a_n&=-3+4n-4\\\\a_n&=4n-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$1\\frac34,3,4\\frac14,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "AP; $d=\\frac54$, $a_n=\\frac{2+5n}{4}$.",
          "worked": "$$\\begin{align*}a_2-a_1&=3-1\\frac34=\\frac54\\\\a_3-a_2&=4\\frac14-3=\\frac54\\\\d&=\\frac54\\\\a_n&=a+(n-1)d\\\\a_n&=1\\frac34+(n-1)\\left(\\frac54\\right)\\\\a_n&=\\frac74+\\frac54(n-1)\\\\a_n&=\\frac{2+5n}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p9-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$12,-5,-22,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "AP; $d=-17$, $a_n=29-17n$.",
          "worked": "$$\\begin{align*}a_2-a_1&=-5-12=-17\\\\a_3-a_2&=-22-(-5)\\\\&=-17\\\\d&=-17\\\\a_n&=a+(n-1)d\\\\a_n&=12+(n-1)(-17)\\\\a_n&=12-17n+17\\\\a_n&=29-17n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p9-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt2,2\\sqrt2,3\\sqrt2,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "AP; $d=\\sqrt2$, $a_n=n\\sqrt2$.",
          "worked": "$$\\begin{align*}a_2-a_1&=2\\sqrt2-\\sqrt2=\\sqrt2\\\\a_3-a_2&=3\\sqrt2-2\\sqrt2\\\\&=\\sqrt2\\\\d&=\\sqrt2\\\\a_n&=a+(n-1)d\\\\a_n&=\\sqrt2+(n-1)\\sqrt2\\\\a_n&=n\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p9-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$1,4,9,16,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not an AP; the differences are $3$ and $5$.",
          "worked": "$$\\begin{align*}a_2-a_1&=4-1=3\\\\a_3-a_2&=9-4=5\\end{align*}$$\nThe differences are unequal, so the sequence is not an AP.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$-2\\frac12,1,4\\frac12,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "AP; $d=\\frac72$, $a_n=\\frac{7n-12}{2}$.",
          "worked": "$$\\begin{align*}a_2-a_1&=1-\\left(-2\\frac12\\right)=\\frac72\\\\a_3-a_2&=4\\frac12-1=\\frac72\\\\d&=\\frac72\\\\a_n&=a+(n-1)d\\\\a_n&=-2\\frac12+(n-1)\\left(\\frac72\\right)\\\\a_n&=-\\frac52+\\frac72(n-1)\\\\a_n&=\\frac{7n-12}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
