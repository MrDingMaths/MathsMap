  "content": {
    "id": "p9-ch19-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A pie chart is drawn to show how a university student spends her money. She spends 20% of her money on food and 40% on rent. Calculate the angles of the sectors used to represent:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-ch19-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "the amount she pays in rent",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$144^\\circ$",
          "worked": "$$\\begin{aligned}\\text{Rent angle}&=\\frac{40}{100}\\times360^\\circ\\\\\\text{Rent angle}&=144^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
