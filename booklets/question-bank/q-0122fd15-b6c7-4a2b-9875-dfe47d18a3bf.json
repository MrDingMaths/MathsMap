  "content": {
    "id": "p13-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Suppose $a,b,c$ are positive numbers and $b\\ne1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove that $a^{\\log_b c}=c^{\\log_b a}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{\\log_b c}=b^{(\\log_b a)(\\log_b c)}=c^{\\log_b a}$.\n\nWrite $a$ and $c$ as powers of $b$ and use the power-of-a-power law.",
          "worked": "Using $a=b^{\\log_b a}$ and $c=b^{\\log_b c}$,\n$$\\begin{align*}a^{\\log_b c}&=(b^{\\log_b a})^{\\log_b c}\\\\a^{\\log_b c}&=b^{(\\log_b a)(\\log_b c)}\\\\a^{\\log_b c}&=(b^{\\log_b c})^{\\log_b a}\\\\a^{\\log_b c}&=c^{\\log_b a}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p13-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $8^{\\log_2 3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "Using part (a),\n$$\\begin{align*}8^{\\log_2 3}&=3^{\\log_2 8}\\\\8^{\\log_2 3}&=3^3\\\\8^{\\log_2 3}&=27.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
