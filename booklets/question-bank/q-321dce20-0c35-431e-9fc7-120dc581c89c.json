    "label": "6",
    "prompt": "Solve for $x$, correct to three decimal places.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q16",
        "type": "part",
        "label": "a",
        "prompt": "$5^x=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx1.431$",
          "worked": "$$\\begin{align*}x\\ln 5&=\\ln 10\\\\x&=\\frac{\\ln 10}{\\ln 5}\\\\x&\\approx1.431\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q17",
        "type": "part",
        "label": "b",
        "prompt": "$4^x=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1.500$",
          "worked": "$$\\begin{align*}x\\ln 4&=\\ln 8\\\\x&=\\frac{\\ln 8}{\\ln 4}\\\\x&=1.500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q18",
        "type": "part",
        "label": "c",
        "prompt": "$e^x=2$",
