        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx0.610$",
          "worked": "$$\\begin{align*}3x\\ln 5&=\\ln 19\\\\x&=\\frac{\\ln 19}{3\\ln 5}\\\\x&\\approx0.610\\end{align*}$$",
