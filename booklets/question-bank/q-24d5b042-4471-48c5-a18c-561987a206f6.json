    "type": "question",
    "label": "s",
    "prompt": "Bev rolls a die and it lands on six 35% of the time. The dice lands on six 147 times. How many times did Bev roll the dice?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "420 rolls",
      "worked": "$$\\begin{align*}35\\%&=147\\text{ rolls}\\\\1\\%&=\\frac{147}{35}\\text{ rolls}\\\\100\\%&=\\frac{147}{35}\\times100\\text{ rolls}\\\\100\\%&=420\\text{ rolls}\\end{align*}$$\nBev rolled the die 420 times.",
      "solutionDiagrams": []
    },
