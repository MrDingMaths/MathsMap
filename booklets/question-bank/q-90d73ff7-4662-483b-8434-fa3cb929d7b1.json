  "content": {
    "id": "p10-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify the following. Assume $a$ and $b$ are non-negative.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{a^2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a\\sqrt b$",
          "worked": "$$\\begin{align*}\\sqrt{a^2b}&=\\sqrt{a^2}\\sqrt b\\\\\\sqrt{a^2b}&=a\\sqrt b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{a^4b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2b$",
          "worked": "$$\\begin{align*}\\sqrt{a^4b^2}&=\\sqrt{(a^2b)^2}\\\\\\sqrt{a^4b^2}&=a^2b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[3]{a^6b^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2b$",
          "worked": "$$\\begin{align*}\\sqrt[3]{a^6b^3}&=\\sqrt[3]{(a^2b)^3}\\\\\\sqrt[3]{a^6b^3}&=a^2b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{a^5b^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2b\\sqrt{ab}$",
          "worked": "$$\\begin{align*}\\sqrt{a^5b^3}&=\\sqrt{(a^2b)^2ab}\\\\\\sqrt{a^5b^3}&=\\sqrt{(a^2b)^2}\\sqrt{ab}\\\\\\sqrt{a^5b^3}&=a^2b\\sqrt{ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
