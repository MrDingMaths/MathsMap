  "content": {
    "id": "p4-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A gardener has 60 m of garden edging, which she uses to set out a rectangular garden with width 5 m less than the length. Let $x$ metres be the length of the garden.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find, in terms of $x$, the width of the garden.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)$ metres.",
          "worked": "The width is 5 m less than the length, so the width is $(x-5)$ metres.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p4-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, form an equation and solve it to find the length and width of the garden.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Length 17.5 m; width 12.5 m.",
          "worked": "The edging forms the perimeter of the rectangle.\n\n$$\\begin{align*}2x+2(x-5)&=60\\\\2x+2x-10&=60\\\\4x-10&=60\\\\4x&=70\\\\x&=17.5\\end{align*}$$\n\nThe length is 17.5 m. The width is $17.5-5=12.5$ m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
