  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": null,
    "prompt": "Find the reference angle for each of the following angles:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3\\pi}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{4}$",
          "worked": "The angle is in Quadrant II.\n$$\\begin{align*}\\phi &= \\pi-\\frac{3\\pi}{4}\\\\\\phi &= \\frac{\\pi}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{7\\pi}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{6}$",
          "worked": "The angle is in Quadrant III.\n$$\\begin{align*}\\phi &= \\frac{7\\pi}{6}-\\pi\\\\\\phi &= \\frac{\\pi}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{5\\pi}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{3}$",
          "worked": "The angle is in Quadrant IV.\n$$\\begin{align*}\\phi &= 2\\pi-\\frac{5\\pi}{3}\\\\\\phi &= \\frac{\\pi}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{9\\pi}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{4}$",
          "worked": "$$\\begin{align*}\\theta_0 &= \\frac{9\\pi}{4}-2\\pi\\\\\\theta_0 &= \\frac{\\pi}{4}\\end{align*}$$\nThe coterminal angle is in Quadrant I, so $\\phi=\\frac{\\pi}{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{5\\pi}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{6}$",
          "worked": "The angle is in Quadrant II.\n$$\\begin{align*}\\phi &= \\pi-\\frac{5\\pi}{6}\\\\\\phi &= \\frac{\\pi}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{8\\pi}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{3}$",
          "worked": "$$\\begin{align*}\\theta_0 &= \\frac{8\\pi}{3}-2\\pi\\\\\\theta_0 &= \\frac{2\\pi}{3}\\end{align*}$$\nThe coterminal angle is in Quadrant II.\n$$\\begin{align*}\\phi &= \\pi-\\frac{2\\pi}{3}\\\\\\phi &= \\frac{\\pi}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$-\\frac{3\\pi}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{4}$",
          "worked": "$$\\begin{align*}\\theta_0 &= -\\frac{3\\pi}{4}+2\\pi\\\\\\theta_0 &= \\frac{5\\pi}{4}\\end{align*}$$\nThe coterminal angle is in Quadrant III.\n$$\\begin{align*}\\phi &= \\frac{5\\pi}{4}-\\pi\\\\\\phi &= \\frac{\\pi}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$-\\frac{4\\pi}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{3}$",
          "worked": "$$\\begin{align*}\\theta_0 &= -\\frac{4\\pi}{3}+2\\pi\\\\\\theta_0 &= \\frac{2\\pi}{3}\\end{align*}$$\nThe coterminal angle is in Quadrant II.\n$$\\begin{align*}\\phi &= \\pi-\\frac{2\\pi}{3}\\\\\\phi &= \\frac{\\pi}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$-\\frac{5\\pi}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{6}$",
          "worked": "$$\\begin{align*}\\theta_0 &= -\\frac{5\\pi}{6}+2\\pi\\\\\\theta_0 &= \\frac{7\\pi}{6}\\end{align*}$$\nThe coterminal angle is in Quadrant III.\n$$\\begin{align*}\\phi &= \\frac{7\\pi}{6}-\\pi\\\\\\phi &= \\frac{\\pi}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
