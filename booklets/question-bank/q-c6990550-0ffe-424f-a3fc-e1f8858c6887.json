    "children": [
      {
        "id": "p7-q1",
        "type": "part",
        "label": "a",
        "prompt": "A permutation is the number of ways to order distinct objects.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. A permutation is a particular ordered selection of distinct objects.",
          "worked": "False. A permutation is a particular ordered selection; the number of such selections is a permutation count.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p7-q2",
        "type": "part",
        "label": "b",
        "prompt": "${}^{n}P_r$ counts the number of permutations of $r$ objects from $n$ distinct objects.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. ${}^{n}P_r$ counts ordered selections of $r$ objects from $n$ distinct objects.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p7-q3",
        "type": "part",
        "label": "c",
        "prompt": "LISTEN is a permutation of SILENT.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. LISTEN uses each of the six distinct letters of SILENT once, in a different order.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p7-q4",
        "type": "part",
        "label": "d",
        "prompt": "CBACBA is a permutation of ABC.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. CBACBA repeats each letter, whereas ABC supplies only one of each distinct letter.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p7-q5",
        "type": "part",
        "label": "e",
        "prompt": "BIRTHDAY is a permutation of BIRTHDAY.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The original order is also one possible ordering of the eight distinct letters.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p7-q6",
        "type": "part",
        "label": "f",
        "prompt": "MATH is a permutation of MATHS.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True. It is an ordered selection of four of the five distinct letters.",
          "worked": "True. A permutation may select some or all available objects. MATH orders four distinct letters selected from MATHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
