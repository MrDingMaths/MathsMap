    "label": "21",
    "prompt": "Find the smallest five-digit number divisible by 33.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10032$",
      "worked": "The smallest five-digit number is $10000$. The adjacent multiples of 33 are\n$$\\begin{align*}33\\times303&=9999\\\\33\\times304&=10032.\\end{align*}$$\nTherefore, the smallest five-digit multiple is $10032$. Its digit sum is 6 and its alternating digit sum is $1-0+0-3+2=0$, confirming divisibility by both 3 and 11.",
      "solutionDiagrams": []
    },
