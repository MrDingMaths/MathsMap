  "content": {
    "id": "p4-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Substitute $2$ for $x$ in each expression and evaluate.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}x+5&=2+5\\\\x+5&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}4x&=4\\times2\\\\4x&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{x}{2}&=\\frac{2}{2}\\\\\\frac{x}{2}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{7x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\frac{7x}{2}&=\\frac{7\\times2}{2}\\\\\\frac{7x}{2}&=\\frac{14}{2}\\\\\\frac{7x}{2}&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$3(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}3(x+4)&=3(2+4)\\\\3(x+4)&=3\\times6\\\\3(x+4)&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$2(x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}2(x-1)&=2(2-1)\\\\2(x-1)&=2\\times1\\\\2(x-1)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{x+8}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\frac{x+8}{2}&=\\frac{2+8}{2}\\\\\\frac{x+8}{2}&=\\frac{10}{2}\\\\\\frac{x+8}{2}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{9-x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{3}{4}$",
          "worked": "$$\\begin{align*}\\frac{9-x}{4}&=\\frac{9-2}{4}\\\\\\frac{9-x}{4}&=\\frac{7}{4}\\\\\\frac{9-x}{4}&=1\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
