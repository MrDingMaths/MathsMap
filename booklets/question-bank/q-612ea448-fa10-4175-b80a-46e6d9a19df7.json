  "content": {
    "id": "p34-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The contents of a tin of chocolates weigh 6500 grams. The chocolates are divided into packets of 250 grams. How many packets are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "26 packets",
      "worked": "$$\\begin{align*}6500\\div250&=(5000+1500)\\div250\\\\6500\\div250&=5000\\div250+1500\\div250\\\\6500\\div250&=20+6\\\\6500\\div250&=26\\end{align*}$$\n\nThere are 26 packets.",
      "solutionDiagrams": []
    },
