  "content": {
    "id": "p19-r7-root",
    "type": "question",
    "label": "7",
    "prompt": "Let $f(x)=3^x$. Find $f(x+1)-f(x)$ and express your answer in terms of $f(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2f(x)$.",
      "worked": "$$\\begin{align*}f(x+1)-f(x)&=3^{x+1}-3^x\\\\f(x+1)-f(x)&=3\\cdot3^x-3^x\\\\f(x+1)-f(x)&=2\\cdot3^x\\\\f(x+1)-f(x)&=2f(x).\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 21
