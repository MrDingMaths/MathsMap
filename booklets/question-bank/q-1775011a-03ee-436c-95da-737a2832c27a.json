  "content": {
    "id": "p56-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A population $P$ is varying with time $t$ in hours according to the formula $P=2000e^{0.3t}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the population when $t=5$. Give your answer to the nearest whole individual.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(5)=8963$ individuals.",
          "worked": "$$\\begin{align*}P(5)&=2000e^{0.3(5)}\\\\P(5)&\\approx8963\\text{ individuals}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p56-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find, as a function of $t$, the rate $\\dfrac{dP}{dt}$ at which the population is changing, and show that $\\dfrac{dP}{dt}=0.3P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dP}{dt}=600e^{0.3t}=0.3P$ individuals per hour.",
          "worked": "$$\\begin{align*}\\frac{dP}{dt}&=2000(0.3)e^{0.3t}\\\\\\frac{dP}{dt}&=600e^{0.3t}\\\\\\frac{dP}{dt}&=0.3\\left(2000e^{0.3t}\\right)\\\\\\frac{dP}{dt}&=0.3P.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p56-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the rate at which the population is changing when $t=5$. Give your answer to the nearest individual per hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P'(5)\\approx2689$ individuals per hour.",
          "worked": "$$\\begin{align*}P'(5)&=600e^{0.3(5)}\\\\P'(5)&\\approx2689\\text{ individuals per hour}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p56-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the average rate of change over the first 5 hours. Give your answer to the nearest individual per hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1393$ individuals per hour.",
          "worked": "$$\\begin{align*}\\text{Average rate}&=\\frac{P(5)-P(0)}{5-0}\\\\\\text{Average rate}&=\\frac{2000e^{1.5}-2000}{5}\\\\\\text{Average rate}&\\approx1393\\text{ individuals per hour}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
