  "content": {
    "id": "p29-q10-root",
    "type": "question",
    "label": "",
    "prompt": "Find $A$ and $\\alpha$ exactly, if $A>0$ and $0\\le\\alpha<2\\pi$, and:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$A\\sin\\alpha=1$ and $A\\cos\\alpha=-\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=2$, $\\alpha=\\frac{5\\pi}{6}$.",
          "worked": "$$\\begin{align*}A^2\\sin^2\\alpha+A^2\\cos^2\\alpha&=1^2+(-\\sqrt3)^2\\\\A^2&=4\\\\A&=2\\quad(A>0)\\\\\\tan\\alpha&=\\frac1{-\\sqrt3}=-\\frac1{\\sqrt3}\\end{align*}$$\nSince $\\sin\\alpha>0$ and $\\cos\\alpha<0$, $\\alpha$ is in quadrant II.\n$$\\alpha=\\pi-\\frac\\pi6=\\frac{5\\pi}{6}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p29-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$A\\cos\\alpha=-5$ and $A\\sin\\alpha=-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=5\\sqrt2$, $\\alpha=\\frac{5\\pi}{4}$.",
          "worked": "$$\\begin{align*}A^2\\cos^2\\alpha+A^2\\sin^2\\alpha&=(-5)^2+(-5)^2\\\\A^2&=50\\\\A&=5\\sqrt2\\quad(A>0)\\\\\\tan\\alpha&=\\frac{-5}{-5}=1\\end{align*}$$\nSince $\\sin\\alpha<0$ and $\\cos\\alpha<0$, $\\alpha$ is in quadrant III.\n$$\\alpha=\\pi+\\frac\\pi4=\\frac{5\\pi}{4}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
