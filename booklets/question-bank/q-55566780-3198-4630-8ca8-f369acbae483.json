  "content": {
    "id": "p54-q3-response",
    "type": "question",
    "label": "3",
    "prompt": "The expression $\\dfrac{\\sqrt{6}+1}{\\sqrt{3}+\\sqrt{2}}$ can be written as $a\\sqrt{3}+b\\sqrt{2}$. Find $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-1,\\ b=2$.",
      "worked": "$$\\begin{align*}\\frac{\\sqrt{6}+1}{\\sqrt{3}+\\sqrt{2}}&=\\frac{(\\sqrt{6}+1)(\\sqrt{3}-\\sqrt{2})}{(\\sqrt{3}+\\sqrt{2})(\\sqrt{3}-\\sqrt{2})}\\\\&=\\frac{\\sqrt{18}-\\sqrt{12}+\\sqrt{3}-\\sqrt{2}}{3-2}\\\\&=3\\sqrt{2}-2\\sqrt{3}+\\sqrt{3}-\\sqrt{2}\\\\&=-\\sqrt{3}+2\\sqrt{2}\\end{align*}$$\nComparing coefficients gives $a=-1$ and $b=2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
