  "content": {
    "id": "p6-factorisation-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Write each expression as a simplified single fraction.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-factorisation-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{(x-1)^2}\\div\\dfrac{1}{x^2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x-1}$",
          "worked": "$\\begin{align*}\\frac{1}{(x-1)^2}\\div\\frac{1}{x^2-1}&=\\frac{1}{(x-1)^2}\\times\\frac{x^2-1}{1}\\\\\\frac{1}{(x-1)^2}\\div\\frac{1}{x^2-1}&=\\frac{(x-1)(x+1)}{(x-1)^2}\\\\\\frac{1}{(x-1)^2}\\div\\frac{1}{x^2-1}&=\\frac{x+1}{x-1}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-factorisation-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x-4}{x^2+2x+1}\\times\\dfrac{x+1}{x^2-16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{(x+1)(x+4)}$",
          "worked": "$\\begin{align*}\\frac{x-4}{x^2+2x+1}\\times\\frac{x+1}{x^2-16}&=\\frac{(x-4)(x+1)}{(x+1)^2(x-4)(x+4)}\\\\\\frac{x-4}{x^2+2x+1}\\times\\frac{x+1}{x^2-16}&=\\frac{1}{(x+1)(x+4)}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p6-factorisation-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{m-2}{4m}\\times\\dfrac{m}{m-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14$",
          "worked": "$\\begin{align*}\\frac{m-2}{4m}\\times\\frac{m}{m-2}&=\\frac{m(m-2)}{4m(m-2)}\\\\\\frac{m-2}{4m}\\times\\frac{m}{m-2}&=\\frac14\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-factorisation-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{p+1}{8(p-1)}\\times\\dfrac{4(p-1)}{(p+1)(p+2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2(p+2)}$",
          "worked": "$\\begin{align*}\\frac{p+1}{8(p-1)}\\times\\frac{4(p-1)}{(p+1)(p+2)}&=\\frac{4(p+1)(p-1)}{8(p-1)(p+1)(p+2)}\\\\\\frac{p+1}{8(p-1)}\\times\\frac{4(p-1)}{(p+1)(p+2)}&=\\frac{1}{2(p+2)}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p6-factorisation-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac4a\\div\\dfrac2{a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a$",
          "worked": "$\\begin{align*}\\frac4a\\div\\frac2{a^2}&=\\frac4a\\times\\frac{a^2}{2}\\\\\\frac4a\\div\\frac2{a^2}&=\\frac{4a^2}{2a}\\\\\\frac4a\\div\\frac2{a^2}&=2a\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p6-factorisation-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{5a-7}{2a+4}\\times\\dfrac{12}{10a-14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac3{a+2}$",
          "worked": "$\\begin{align*}\\frac{5a-7}{2a+4}\\times\\frac{12}{10a-14}&=\\frac{12(5a-7)}{2(a+2)\\times2(5a-7)}\\\\\\frac{5a-7}{2a+4}\\times\\frac{12}{10a-14}&=\\frac{12}{4(a+2)}\\\\\\frac{5a-7}{2a+4}\\times\\frac{12}{10a-14}&=\\frac3{a+2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p6-factorisation-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x^2+3x-4}{2x-2}\\times\\dfrac{6x-12}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3(x-2)(x+4)}{x-1}$",
          "worked": "$\\begin{align*}\\frac{x^2+3x-4}{2x-2}\\times\\frac{6x-12}{x-1}&=\\frac{(x+4)(x-1)\\times6(x-2)}{2(x-1)^2}\\\\\\frac{x^2+3x-4}{2x-2}\\times\\frac{6x-12}{x-1}&=\\frac{3(x-2)(x+4)}{x-1}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-factorisation-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x^3}{y^2}\\div\\dfrac{x}{2y^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2y$",
          "worked": "$\\begin{align*}\\frac{x^3}{y^2}\\div\\frac{x}{2y^3}&=\\frac{x^3}{y^2}\\times\\frac{2y^3}{x}\\\\\\frac{x^3}{y^2}\\div\\frac{x}{2y^3}&=\\frac{2x^3y^3}{xy^2}\\\\\\frac{x^3}{y^2}\\div\\frac{x}{2y^3}&=2x^2y\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
