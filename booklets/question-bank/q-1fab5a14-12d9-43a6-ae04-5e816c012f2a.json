  "content": {
    "id": "p12-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A coin is flipped and then a die is rolled. What is the probability that",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "the coin lands tails and the die rolls a 5?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{12}$",
          "worked": "$$\\begin{align*}P(\\text{tail and 5}) &= \\frac12\\times\\frac16 \\\\ P(\\text{tail and 5}) &= \\frac1{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "the coin lands heads and the die rolls an even number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "The die has three even faces: 2, 4 and 6.\n\n$$\\begin{align*}P(\\text{head and even}) &= \\frac12\\times\\frac36 \\\\ P(\\text{head and even}) &= \\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
