      "short": "10% decrease in travel time; the new time is $3.6\\text{ h}$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p97-q20-worked-distance",
            "type": "paragraph",
            "fontSize": null,
