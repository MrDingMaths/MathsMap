            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}T&=\\frac{360}{100}\\text{ h}\\\\T&=3.6\\text{ h}\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p97-q20-worked-percentage",
