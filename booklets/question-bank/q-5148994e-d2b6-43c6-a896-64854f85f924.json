            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}D&=90\\times4\\\\D&=360\\text{ km}\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p97-q20-worked-fixed-distance",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "For the same distance, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "T=\\frac{D}{S}",
                "display": false
              },
              {
                "type": "text",
                "text": ". At ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "100\\text{ km h}^{-1}",
                "display": false
              },
              {
                "type": "text",
                "text": ",",
                "marks": []
              }
            ]
          },
          {
