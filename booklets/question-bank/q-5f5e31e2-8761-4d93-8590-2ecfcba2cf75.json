  "content": {
    "id": "p16-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A particle is projected from the origin with a speed of $30\\sqrt{2}\\text{ m/s}$ at an angle of $45^\\circ$ to the horizontal.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-part-a",
        "type": "part",
        "label": "a",
        "prompt": "Starting with $\\ddot{x}=0$ and $\\ddot{y}=-10$, show that $\\dot{x}=30$ and $\\dot{y}=-10t+30$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dot{x}=30,\\quad \\dot{y}=-10t+30$.",
          "worked": "Integrating the horizontal acceleration:\n$$\\begin{aligned}\\dot{x}&=C_1\\\\\\dot{x}(0)&=30\\sqrt{2}\\cos45^\\circ=30\\\\C_1&=30\\\\\\therefore\\ \\dot{x}&=30.\\end{aligned}$$\nIntegrating the vertical acceleration:\n$$\\begin{aligned}\\dot{y}&=-10t+C_2\\\\\\dot{y}(0)&=30\\sqrt{2}\\sin45^\\circ=30\\\\C_2&=30\\\\\\therefore\\ \\dot{y}&=-10t+30.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p16-q1-part-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $x$ and $y$ in terms of $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=30t,\\quad y=-5t^2+30t$.",
          "worked": "$$\\begin{aligned}x&=30t+C_3\\\\y&=-5t^2+30t+C_4.\\end{aligned}$$\nAt $t=0$, $x=0$ and $y=0$, so $C_3=C_4=0$.\n$$\\begin{aligned}x&=30t\\\\y&=-5t^2+30t.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q1-part-c",
        "type": "part",
        "label": "c",
        "prompt": "Put $y=0$ to find when the particle returns to the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ s}$.",
          "worked": "$$\\begin{aligned}0&=-5t^2+30t\\\\0&=t(-5t+30)\\\\t&=0\\text{ or }6.\\end{aligned}$$\nThe particle returns to the $x$-axis at $t=6\\text{ s}$; $t=0$ is launch.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p16-q1-part-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find the horizontal distance travelled.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180\\text{ m}$.",
          "worked": "$$\\begin{aligned}x(6)&=30(6)\\\\&=180\\text{ m}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p16-q1-part-e",
        "type": "part",
        "label": "e",
        "prompt": "Put $\\dot{y}=0$ to find when the particle reaches its greatest height.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\text{ s}$.",
          "worked": "$$\\begin{aligned}0&=-10t+30\\\\10t&=30\\\\t&=3\\text{ s}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q1-part-f",
        "type": "part",
        "label": "f",
        "prompt": "Find the greatest height.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45\\text{ m}$.",
          "worked": "$$\\begin{aligned}y(3)&=-5(3)^2+30(3)\\\\&=-45+90\\\\&=45\\text{ m}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
