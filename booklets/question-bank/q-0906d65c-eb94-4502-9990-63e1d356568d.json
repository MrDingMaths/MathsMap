  "content": {
    "id": "p148-q18-response",
    "type": "question",
    "label": "5",
    "prompt": "Determine the number of real solutions of $2x^2+(2m+1)x-1=0$, where $m$ is any real number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Two distinct real solutions for every real $m$.\n\nThe discriminant $\\Delta=(2m+1)^2+8$ is always positive.",
      "worked": "Here $a=2\\ne0$, so the equation is quadratic for every real $m$.\n\n$$\\begin{align*}\\Delta&=(2m+1)^2-4(2)(-1)\\\\\\Delta&=(2m+1)^2+8\\end{align*}$$\n\nSince $(2m+1)^2\\ge0$, $\\Delta>0$ for every real $m$.\n\nHence, there are two distinct real solutions for every real $m$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
