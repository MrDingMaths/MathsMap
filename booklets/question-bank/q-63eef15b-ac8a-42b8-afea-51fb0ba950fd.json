  "content": {
    "id": "p26-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find $R$ and $\\alpha$ exactly, if $R>0$ and $0\\leq\\alpha<2\\pi$, and:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$R\\sin\\alpha=\\sqrt{3}$ and $R\\cos\\alpha=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=2$, $\\alpha=\\dfrac{\\pi}{3}$.",
          "worked": "$$\\begin{align*}R^2&=(\\sqrt{3})^2+1^2=4\\\\R&=2\\\\\\tan\\alpha&=\\frac{\\sqrt{3}}{1}=\\sqrt{3}\\end{align*}$$\nSince $R>0$ and both given coefficients are positive, $\\alpha$ is in quadrant I.\n$$\\begin{align*}\\alpha&=\\frac{\\pi}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$R\\sin\\alpha=3$ and $R\\cos\\alpha=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=3\\sqrt{2}$, $\\alpha=\\dfrac{\\pi}{4}$.",
          "worked": "$$\\begin{align*}R^2&=3^2+3^2=18\\\\R&=3\\sqrt{2}\\\\\\tan\\alpha&=\\frac{3}{3}=1\\end{align*}$$\nSince $R>0$ and both given coefficients are positive, $\\alpha$ is in quadrant I.\n$$\\begin{align*}\\alpha&=\\frac{\\pi}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
