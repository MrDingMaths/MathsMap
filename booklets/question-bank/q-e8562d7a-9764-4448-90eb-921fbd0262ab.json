    "type": "question",
    "label": "5",
    "prompt": "The parallelogram $PQRS$ has vertices $P(1,6)$, $Q(5,12)$, $R(3,3)$ and $S(-1,-3)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of the midpoint of the diagonal $PR$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,4.5)$",
          "worked": "$$\\begin{align*}M_{PR}&=\\left(\\frac{1+3}{2},\\frac{6+3}{2}\\right)\\\\M_{PR}&=\\left(2,\\frac{9}{2}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coordinates of the midpoint of the diagonal $SQ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,4.5)$",
          "worked": "$$\\begin{align*}M_{SQ}&=\\left(\\frac{-1+5}{2},\\frac{-3+12}{2}\\right)\\\\M_{SQ}&=\\left(2,\\frac{9}{2}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "What well-known property of a parallelogram does this demonstrate?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The diagonals of a parallelogram bisect each other.",
          "worked": "Both diagonals have midpoint $(2,4.5)$. Their common midpoint divides each diagonal into two equal intervals, demonstrating that the diagonals of a parallelogram bisect each other.",
