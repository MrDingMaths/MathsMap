  "content": {
    "id": "p52-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Factorise:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q4a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2+7x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(x+3)$",
          "worked": "Product: $2\\times3=6$. Sum: $7$. Factor pair: $6,1$.\n$$\\begin{align*}2x^2+7x+3&=2x^2+6x+x+3\\\\&=2x(x+3)+(x+3)\\\\&=(2x+1)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q4b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2-7x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(x-3)$",
          "worked": "Product: $2\\times3=6$. Sum: $-7$. Factor pair: $-6,-1$.\n$$\\begin{align*}2x^2-7x+3&=2x^2-6x-x+3\\\\&=2x(x-3)-(x-3)\\\\&=(2x-1)(x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q4c",
        "type": "part",
        "label": "c",
        "prompt": "$2x^2+5x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(x+3)$",
          "worked": "Product: $2\\times(-3)=-6$. Sum: $5$. Factor pair: $6,-1$.\n$$\\begin{align*}2x^2+5x-3&=2x^2+6x-x-3\\\\&=2x(x+3)-(x+3)\\\\&=(2x-1)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q4d",
        "type": "part",
        "label": "d",
        "prompt": "$2x^2-5x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(x-3)$",
          "worked": "Product: $2\\times(-3)=-6$. Sum: $-5$. Factor pair: $-6,1$.\n$$\\begin{align*}2x^2-5x-3&=2x^2-6x+x-3\\\\&=2x(x-3)+(x-3)\\\\&=(2x+1)(x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
