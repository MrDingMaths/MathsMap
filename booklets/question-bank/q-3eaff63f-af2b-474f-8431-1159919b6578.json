    "id": "v2-8566fd-p4-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "The speed of a car is given by $s=\\frac{d}{t}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8566fd-p4-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange the formula to make $d$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=st$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\st&=d\\\\d&=st\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-8566fd-p4-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use your rearranged formula to find $d$ when $s=90$ and $t=2.5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=225$",
          "worked": "$$\\begin{align*}d&=90\\times2.5\\\\d&=225\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
