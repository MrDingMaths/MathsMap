    "children": [
      {
        "id": "p22-q4a",
        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=a\\times b^x$ passes through the points $(1,6)$ and $(2,12)$. Determine $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3,\\ b=2$.",
          "worked": "Substituting the two points gives\n$$\\begin{align*}ab&=6\\\\ab^2&=12.\\end{align*}$$\nDividing the second equation by the first,\n$$\\begin{align*}b&=\\frac{12}{6}\\\\b&=2.\\end{align*}$$\nSubstituting $b=2$ into $ab=6$,\n$$\\begin{align*}2a&=6\\\\a&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p22-q4b",
        "type": "part",
        "label": "b",
        "prompt": "The graph of $y=b^x+c$ passes through the point $(2,2)$. The equation of its asymptote is $y=-7$. Determine $b$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=3,\\ c=-7$.",
          "worked": "The horizontal asymptote is $y=c$, so $c=-7$. Substituting $(2,2)$ gives\n$$\\begin{align*}b^2-7&=2\\\\b^2&=9\\\\b&=3.\\end{align*}$$\nThe exponential base is positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
