  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The polynomial $P(x)=2x^3+5x^2-4x-12$ has a double zero.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the double zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$.",
          "worked": "$$\\begin{aligned}P(-2)&=2(-2)^3+5(-2)^2-4(-2)-12\\\\&=0\\\\P'(x)&=6x^2+10x-4\\\\P'(-2)&=24-20-4\\\\&=0\\\\P''(x)&=12x+10\\\\P''(-2)&=-14\\ne0\\end{aligned}$$Hence $x=-2$ is the double zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the remaining simple zero, and hence factor $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remaining simple zero: $\\dfrac32$. $P(x)=(x+2)^2(2x-3)$.",
          "worked": "Let the remaining zero be $r$. Using the sum of roots,\n$$\\begin{aligned}-2-2+r&=-\\frac52\\\\r&=\\frac32\\\\P(x)&=2(x+2)^2\\left(x-\\frac32\\right)\\\\&=(x+2)^2(2x-3).\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
