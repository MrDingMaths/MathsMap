      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^4}{2}-\\dfrac{x^3}{3}+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^3-x^2$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}\\left(\\frac{x^4}{2}-\\frac{x^3}{3}+4\\right)&=\\frac{4x^3}{2}-\\frac{3x^2}{3}+0\\\\&=2x^3-x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{3}x^6(x^2-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8x^7}{3}-6x^5$",
          "worked": "$$\\begin{align*}f(x)&=\\frac{1}{3}x^8-x^6\\\\f'(x)&=\\frac{8}{3}x^7-6x^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
