        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x$",
          "worked": "$$\\begin{align*}f(x)&=2x^2+5\\\\f'(x)&=4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x^2+2x}{4x}$",
