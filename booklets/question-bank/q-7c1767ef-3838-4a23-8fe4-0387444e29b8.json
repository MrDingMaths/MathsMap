    "id": "p47-ep-18-node",
    "type": "question",
    "label": "18",
    "prompt": "Find the equation of the tangent to $y=x^2+4x+3$ if the tangent is inclined at $45^\\circ$ from the positive $x$-axis.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
