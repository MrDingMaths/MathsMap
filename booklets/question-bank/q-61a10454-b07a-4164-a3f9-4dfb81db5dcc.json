              "type": "text",
              "text": "A patient is to receive 600 mL of saline solution.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "An intravenous drip delivers 30 drops/min and there are 12 drops/mL.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "How long will it take to deliver the required dose?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
