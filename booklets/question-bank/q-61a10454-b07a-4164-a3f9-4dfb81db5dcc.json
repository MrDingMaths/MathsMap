    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\text{ h}$",
      "worked": "The quantities are time, drops and volume. Let $x$ be the delivery time in minutes.\n\n$$\\begin{align*}\n\\frac{\\text{Time}}{\\text{Volume}}&=\\frac{\\text{Time}}{\\text{Drops}}\\times\\frac{\\text{Drops}}{\\text{Volume}}\\\\\n\\frac{x\\text{ min}}{600\\text{ mL}}&=\\frac{1\\text{ min}}{30\\text{ drops}}\\times\\frac{12\\text{ drops}}{1\\text{ mL}}\\\\\nx&=600\\times\\frac{12}{30}=240\\\\\n240\\text{ min}&=4\\text{ h}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
