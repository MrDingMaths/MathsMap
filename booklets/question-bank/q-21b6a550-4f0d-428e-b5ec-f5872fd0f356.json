  "content": {
    "id": "p37-question-22-25-root",
    "type": "question",
    "label": null,
    "prompt": "Write down the range of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-part-22",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,\\infty)$",
          "worked": "The exponential term takes every positive value and never equals zero.\n$$\\begin{align*}f(x)&=3^x\\\\f(x)&>0\\end{align*}$$\nThe range is $(0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p37-part-23",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=1+2^{-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,\\infty)$",
          "worked": "The term $2^{-x}$ takes every positive value and never equals zero.\n$$\\begin{align*}f(x)&=1+2^{-x}\\\\f(x)&>1\\end{align*}$$\nThe range is $(1,\\infty)$; the asymptote $y=1$ is not included.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p37-part-24",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3-5^{\\frac{x}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,3)$",
          "worked": "As $x$ varies over all real numbers, $5^{x/2}$ takes every positive value.\n$$\\begin{align*}f(x)&=3-5^{x/2}\\\\f(x)&<3\\end{align*}$$\nThe range is $(-\\infty,3)$; the asymptote $y=3$ is not included.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p37-part-25",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=8-3^{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,8)$",
          "worked": "As $x$ varies over all real numbers, $3^{2x-1}$ takes every positive value.\n$$\\begin{align*}f(x)&=8-3^{2x-1}\\\\f(x)&<8\\end{align*}$$\nThe range is $(-\\infty,8)$; the asymptote $y=8$ is not included.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
