    "label": "32",
    "prompt": "Simplify the following surds. $(\\sqrt3-\\sqrt2)^2$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5-2\\sqrt6$",
      "worked": "$$\\begin{align*}(\\sqrt3-\\sqrt2)^2&=(\\sqrt3)^2-2\\sqrt3\\sqrt2+(\\sqrt2)^2\\\\(\\sqrt3-\\sqrt2)^2&=3-2\\sqrt6+2\\\\(\\sqrt3-\\sqrt2)^2&=5-2\\sqrt6.\\end{align*}$$",
      "solutionDiagrams": []
    },
