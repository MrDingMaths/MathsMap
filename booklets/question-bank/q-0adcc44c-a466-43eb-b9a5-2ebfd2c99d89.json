      {
        "id": "p33-group-11-14-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x(2x-1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(2x-1)^2(8x-1)$",
          "worked": "$$\\begin{aligned}y'&=(2x-1)^3+6x(2x-1)^2\\\\y'&=(2x-1)^2\\big[(2x-1)+6x\\big]\\\\y'&=(2x-1)^2(8x-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-11-14-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2(2x+1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2x(2x+1)^2(5x+1)$",
          "worked": "$$\\begin{aligned}y'&=2x(2x+1)^3+6x^2(2x+1)^2\\\\y'&=2x(2x+1)^2\\big[(2x+1)+3x\\big]\\\\y'&=2x(2x+1)^2(5x+1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-11-14-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x(x^2+1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x^2+1)^2(7x^2+1)$",
          "worked": "$$\\begin{aligned}y'&=(x^2+1)^3+6x^2(x^2+1)^2\\\\y'&=(x^2+1)^2\\big[(x^2+1)+6x^2\\big]\\\\y'&=(x^2+1)^2(7x^2+1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-11-14-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^2(4-3x)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2x(4-3x)^3(4-9x)$",
          "worked": "$$\\begin{aligned}y'&=2x(4-3x)^4-12x^2(4-3x)^3\\\\y'&=2x(4-3x)^3\\big[(4-3x)-6x\\big]\\\\y'&=2x(4-3x)^3(4-9x)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
