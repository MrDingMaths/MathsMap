  "content": {
    "id": "p25-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "If $a=20$ and $b=4$, find the value of:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$a-b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$\\begin{align*}a-b&=20-4\\\\a-b&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{a+5}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\frac{a+5}{5}&=\\frac{20+5}{5}\\\\\\frac{a+5}{5}&=\\frac{25}{5}\\\\\\frac{a+5}{5}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{a}{5}+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}\\frac{a}{5}+5&=\\frac{20}{5}+5\\\\\\frac{a}{5}+5&=4+5\\\\\\frac{a}{5}+5&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$a^2-b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$384$",
          "worked": "$$\\begin{align*}a^2-b^2&=20^2-4^2\\\\a^2-b^2&=400-16\\\\a^2-b^2&=384\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
