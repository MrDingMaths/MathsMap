  "content": {
    "id": "p12-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "There are eight marbles, numbered 1 to 8, in a bowl. A marble is randomly taken out. What is the probability of getting:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "an 8?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "The only favourable outcome is 8. There are 8 equally likely outcomes.\n$$P(8)=\\frac{1}{8}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "an even number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The favourable outcomes are 2, 4, 6 and 8.\n$$\\begin{align*}P(\\text{even})&=\\frac{4}{8}\\\\P(\\text{even})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "a number less than 6?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "The favourable outcomes are 1, 2, 3, 4 and 5.\n$$P(\\text{less than }6)=\\frac{5}{8}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "a number divisible by 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "The favourable outcomes are 3 and 6.\n$$\\begin{align*}P(\\text{divisible by }3)&=\\frac{2}{8}\\\\P(\\text{divisible by }3)&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
