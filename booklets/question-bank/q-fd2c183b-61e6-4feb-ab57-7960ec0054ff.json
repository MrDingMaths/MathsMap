  "content": {
    "id": "p5-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Half of a number ($x$) plus one-third of twice the same number is equal to 4.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation describing the situation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{2}+\\frac{2x}{3}=4$",
          "worked": "$\\frac{x}{2}+\\frac{2x}{3}=4$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equation to find the number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{24}{7}$",
          "worked": "$$\\begin{align*}\\frac{3x}{6}+\\frac{4x}{6}&=4\\\\\\frac{7x}{6}&=4\\\\7x&=24\\\\x&=\\frac{24}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
