          "worked": "$$\\begin{align*}10+2x-3x&=15\\\\10-x&=15\\\\-x&=5\\\\x&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p55-q3-f",
