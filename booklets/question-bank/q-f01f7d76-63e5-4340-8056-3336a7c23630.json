        "label": "a",
        "prompt": "$5i+5(2+2i)=25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$i=1$",
          "worked": "$$\\begin{align*}5i+10+10i&=25\\\\15i+10&=25\\\\15i&=15\\\\i&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p55-q3-b",
