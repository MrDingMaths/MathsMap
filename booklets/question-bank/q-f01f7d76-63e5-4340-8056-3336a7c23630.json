        "label": "b",
        "prompt": "$3(4c-5)+c=50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=5$",
          "worked": "$$\\begin{align*}12c-15+c&=50\\\\13c-15&=50\\\\13c&=65\\\\c&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p55-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$3=2(x+4)+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$",
          "worked": "$$\\begin{align*}3&=2x+8+1\\\\3&=2x+9\\\\-6&=2x\\\\x&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p55-q3-d",
