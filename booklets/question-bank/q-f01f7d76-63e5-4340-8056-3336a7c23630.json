          "short": "$p=-4$",
          "worked": "$$\\begin{align*}4p-12+p&=-32\\\\5p-12&=-32\\\\5p&=-20\\\\p&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p55-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$2(5+x)-3x=15$",
