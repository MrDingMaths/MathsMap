        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate the powers of 2 from $2^1$ to $2^{10}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2, 4, 8, 16, 32, 64, 128, 256, 512, 1024$.",
          "worked": "$$\\begin{align*}2^1&=2\\\\2^2&=2\\times2=4\\\\2^3&=4\\times2=8\\\\2^4&=8\\times2=16\\\\2^5&=16\\times2=32\\\\2^6&=32\\times2=64\\\\2^7&=64\\times2=128\\\\2^8&=128\\times2=256\\\\2^9&=256\\times2=512\\\\2^{10}&=512\\times2=1024\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate the powers of 5 from $5^1$ to $5^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5, 25, 125, 625$.",
          "worked": "$$\\begin{align*}5^1&=5\\\\5^2&=5\\times5=25\\\\5^3&=25\\times5=125\\\\5^4&=125\\times5=625\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
