  "content": {
    "id": "v2-4eaff-p29-practice-j7-032010-root",
    "type": "question",
    "label": null,
    "prompt": "A function has equation $y=x^3+4x-5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4eaff-p29-practice-j7-032010-j7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{dy}{dx}>0$ for all $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3x^2+4\\ge4>0$ for all $x$.",
          "worked": "$$\\begin{align*}y'&=3x^2+4\\end{align*}$$\nSince $x^2\\ge0$, $y'\\ge4>0$ for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-4eaff-p29-practice-j7-032010-j7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the graph has an $x$-intercept at $x=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y(1)=0$.",
          "worked": "$$\\begin{align*}y(1)&=1^3+4(1)-5\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-4eaff-p29-practice-j7-032010-j7-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence state the number of $x$-intercepts of the graph. Justify your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Exactly one. The graph is strictly increasing, so it cannot cross the $x$-axis a second time.",
          "worked": "From part a, $y'>0$ for all $x$, so the graph is strictly increasing and takes each $y$-value only once. The intercept at $x=1$ from part b is therefore the only one.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
