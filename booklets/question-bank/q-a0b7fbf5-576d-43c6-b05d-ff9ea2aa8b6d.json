  "content": {
    "id": "p10-q6-parts",
    "type": "question",
    "label": "3",
    "prompt": "Which of the following can be factorised further?",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x^2-y^2)(x^2+y^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes: $(x-y)(x+y)(x^2+y^2)$.",
          "worked": "Use the difference of squares:\n$$(x^2-y^2)(x^2+y^2)=(x-y)(x+y)(x^2+y^2).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No, over the real polynomials.",
          "worked": "This is a sum of squares, not a difference of squares. It cannot be expressed as a product of nonconstant real polynomials.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x+y+xy+y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes: $(x+y)(1+y)$.",
          "worked": "$$\\begin{align*}x+y+xy+y^2&=(x+y)+y(x+y)\\\\x+y+xy+y^2&=(x+y)(1+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x-y-xy+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes: $(x+1)(1-y)$.",
          "worked": "$$\\begin{align*}x-y-xy+1&=x-xy+1-y\\\\x-y-xy+1&=x(1-y)+(1-y)\\\\x-y-xy+1&=(x+1)(1-y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
