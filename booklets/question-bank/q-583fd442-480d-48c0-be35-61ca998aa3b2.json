      {
        "id": "p32-stem-35-40-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2(x+4)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "The domain is $x>-4$.\n\n$$\\begin{align*}x+4&=2^3\\\\x+4&=8\\\\x&=4\\end{align*}$$\n\nThis satisfies the original domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p32-stem-35-40-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_3(2x+3)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "The domain is $x>-\\frac32$.\n\n$$\\begin{align*}2x+3&=3^2\\\\2x+3&=9\\\\x&=3\\end{align*}$$\n\nThis satisfies the original domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p32-stem-35-40-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\log_8(x+1)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "The domain is $x>-1$.\n\n$$\\begin{align*}\\log_8(x+1)&=\\frac23\\\\x+1&=8^{2/3}\\\\x+1&=4\\\\x&=3\\end{align*}$$\n\nThis satisfies the original domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p32-stem-35-40-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{\\frac13}(9x-6)=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac53$",
          "worked": "The domain is $x>\\frac23$.\n\n$$\\begin{align*}9x-6&=\\left(\\frac13\\right)^{-2}\\\\9x-6&=9\\\\9x&=15\\\\x&=\\frac53\\end{align*}$$\n\nThis satisfies the original domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p32-stem-35-40-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{\\sqrt2}(2x+2)=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "The domain is $x>-1$.\n\n$$\\begin{align*}2x+2&=(\\sqrt2)^4\\\\2x+2&=4\\\\x&=1\\end{align*}$$\n\nThis satisfies the original domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p32-stem-35-40-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_{\\sqrt3}(\\sqrt3\\,x-3)=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10\\sqrt3$",
          "worked": "The domain is $x>\\sqrt3$.\n\n$$\\begin{align*}\\sqrt3\\,x-3&=(\\sqrt3)^6\\\\\\sqrt3\\,x-3&=27\\\\\\sqrt3\\,x&=30\\\\x&=10\\sqrt3\\end{align*}$$\n\nThis satisfies the original domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
