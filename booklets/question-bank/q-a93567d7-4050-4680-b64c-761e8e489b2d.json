    "children": [
      {
        "id": "p10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the formula $a_n=a+(n-1)d$ to find the $n$th term $a_n$ of $165,160,155,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=170-5n$",
          "worked": "AP where $a=165$, $d=-5$.\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=165+(n-1)(-5)\\\\a_n&=165-5n+5\\\\a_n&=170-5n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve $a_n=40$ to find the number of terms in the finite sequence $165,160,155,\\ldots,40$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "26 terms.",
          "worked": "$$\\begin{align*}a_n&=40\\\\170-5n&=40\\\\130&=5n\\\\n&=26\\end{align*}$$\nThere are 26 terms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve $a_n<0$ to find the first negative term of the sequence $165,160,155,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{35}=-5$ is the first negative term.",
          "worked": "$$\\begin{align*}a_n&<0\\\\170-5n&<0\\\\170&<5n\\\\34&<n\\end{align*}$$\nThe least integer satisfying this is $n=35$.\n$$a_{35}=170-5(35)=-5$$\nTherefore, $a_{35}=-5$ is the first negative term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
