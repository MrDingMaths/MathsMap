        "type": "part",
        "label": "a",
        "prompt": "Mei and Dan have 85 marbles altogether. Mei has two-thirds as many marbles as Dan. How many marbles does Dan have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "51 marbles",
          "worked": "Mei : Dan $=2:3$.\n$$\\begin{align*}2+3&=5\\text{ parts}\\\\5\\text{ parts}&=85\\text{ marbles}\\\\1\\text{ part}&=85\\div5=17\\text{ marbles}\\\\3\\text{ parts}&=3\\times17=51\\text{ marbles}\\end{align*}$$\nDan has 51 marbles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-52079-p47-practice-retro-slot-9-225344-retro-slot-9-b",
        "type": "part",
        "label": "b",
        "prompt": "A 2.5 m board is cut into two pieces. The shorter piece is one quarter the length of the longer piece. Find the length of the longer piece in centimetres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "200 cm",
          "worked": "Shorter : longer $=1:4$.\n$$\\begin{align*}2.5\\text{ m}&=250\\text{ cm}\\\\1+4&=5\\text{ parts}\\\\5\\text{ parts}&=250\\text{ cm}\\\\1\\text{ part}&=250\\div5=50\\text{ cm}\\\\4\\text{ parts}&=4\\times50=200\\text{ cm}\\end{align*}$$\nThe longer piece is 200 cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
