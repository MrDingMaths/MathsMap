        "children": [],
        "answer": {
          "short": "$x=9$",
          "worked": "$$\\begin{align*}x^{\\frac32}&=27\\\\x&=27^{\\frac23}\\\\x&=\\left(\\sqrt[3]{27}\\right)^2\\\\x&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
