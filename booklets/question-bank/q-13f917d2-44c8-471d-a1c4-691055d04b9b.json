  "content": {
    "id": "p3-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve the following by rewriting each equation in index form.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\log_{10}(1000)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "$$\\begin{align*}10^x&=1000\\\\10^x&=10^3\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=\\log_{10}(0.01)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$",
          "worked": "$$\\begin{align*}10^x&=0.01\\\\10^x&=10^{-2}\\\\x&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=\\log_2(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}2^x&=4\\\\2^x&=2^2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=\\log_4\\left(\\frac14\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$$\\begin{align*}4^x&=\\frac14\\\\4^x&=4^{-1}\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p3-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$x=\\log_{\\frac12}(16)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$",
          "worked": "$$\\begin{align*}\\left(\\frac12\\right)^x&=16\\\\\\left(\\frac12\\right)^x&=\\left(\\frac12\\right)^{-4}\\\\x&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p3-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$x=\\log_{12}(12)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}12^x&=12\\\\12^x&=12^1\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$x=\\log_{12}(1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "$$\\begin{align*}12^x&=1\\\\12^x&=12^0\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_x(25)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}x^2&=25\\\\x&=\\sqrt{25}\\\\x&=5\\end{align*}$$ The logarithm base must be positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p3-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\log_x(64)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}x^3&=64\\\\x&=\\sqrt[3]{64}\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\log_x\\left(\\frac1{25}\\right)=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}x^{-2}&=\\frac1{25}\\\\\\frac1{x^2}&=\\frac1{25}\\\\x^2&=25\\\\x&=5\\end{align*}$$ The logarithm base must be positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p3-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\log_x(3)=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=9$",
          "worked": "$$\\begin{align*}x^{\\frac12}&=3\\\\x&=3^2\\\\x&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p3-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\log_x(27)=\\frac32$",
        "layout": "list",
        "columns": null,
