  "content": {
    "id": "p14-p1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find $a$, $b$ and $c$ if",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-p1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2\\equiv a(x-1)^2+b(x-1)+c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$, $b=2$, $c=1$",
          "worked": "$$\\begin{align*}x^2&\\equiv a(x^2-2x+1)+b(x-1)+c\\\\x^2&\\equiv ax^2+(b-2a)x+a-b+c\\end{align*}$$\nCompare the coefficients of $x^2$ and $x$, then the constant terms.\n$$\\begin{align*}a&=1\\\\b-2a&=0\\\\a-b+c&=0\\end{align*}$$\nWith $a=1$, the second equation gives $b=2$. The third gives $c=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p14-p1-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2-7x-5\\equiv a(x+2)^2+b(x+2)+c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$, $b=-15$, $c=17$",
          "worked": "$$\\begin{align*}2x^2-7x-5&\\equiv a(x^2+4x+4)+b(x+2)+c\\\\2x^2-7x-5&\\equiv ax^2+(4a+b)x+4a+2b+c\\end{align*}$$\nCompare the coefficients of $x^2$ and $x$, then the constant terms.\n$$\\begin{align*}a&=2\\\\4a+b&=-7\\\\4a+2b+c&=-5\\end{align*}$$\nSubstituting $a=2$ gives $b=-7-8=-15$. Then $c=-5-8+30=17$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p14-p1-c",
        "type": "part",
        "label": "c",
        "prompt": "$4x^2+x-5\\equiv ax(x+1)+b(x+1)+c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4$, $b=-3$, $c=-2$",
          "worked": "$$4x^2+x-5\\equiv ax^2+(a+b)x+b+c$$\nCompare the coefficients of $x^2$ and $x$, then the constant terms.\n$$\\begin{align*}a&=4\\\\a+b&=1\\\\b+c&=-5\\end{align*}$$\nSubstituting $a=4$ gives $b=1-4=-3$. Then $c=-5+3=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
