    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the running rate of Harvey. Give your answer exactly in km/min.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.2\\dot{6}\\text{ km/min}$",
          "worked": "$$\\begin{align*}\\text{Time} &= 37+\\frac{30}{60}\\\\\\text{Time} &= 37.5\\text{ min}\\\\\\text{Rate} &= \\frac{10\\text{ km}}{37.5\\text{ min}}\\\\\\text{Rate} &= \\frac{\\frac{4}{15}\\text{ km}}{1\\text{ min}}\\\\\\text{Rate} &= 0.2\\dot{6}\\text{ km/min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the running rate of Jack. Give your answer in km/min to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3\\text{ km/min}$",
          "worked": "$$\\begin{align*}\\text{Time} &= 53+\\frac{15}{60}\\\\\\text{Time} &= 53.25\\text{ min}\\\\\\text{Rate} &= \\frac{16\\text{ km}}{53.25\\text{ min}}\\\\\\text{Rate} &= \\frac{\\frac{64}{213}\\text{ km}}{1\\text{ min}}\\\\\\text{Rate} &\\approx 0.3\\text{ km/min}\\end{align*}$$\nTo 1 decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Who ran faster?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jack.",
          "worked": "$$\\frac{64}{213}>\\frac{4}{15}$$\nJack ran faster because his running rate was higher.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
