  "content": {
    "id": "p13-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "Simplify $\\left(\\dfrac{4p^{2}}{8}\\right)^{-3}$ and express as a fraction involving non-negative indices only.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{8}{p^{6}}$",
      "worked": "$$\\begin{align*}\\left(\\frac{4p^{2}}{8}\\right)^{-3}&=\\left(\\frac{8}{4p^{2}}\\right)^{3}\\\\&=\\left(\\frac{2}{p^{2}}\\right)^{3}\\\\&=\\frac{2^{3}}{p^{6}}\\\\&=\\frac{8}{p^{6}}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
