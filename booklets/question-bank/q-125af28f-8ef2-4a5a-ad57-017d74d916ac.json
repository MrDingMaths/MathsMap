      {
        "id": "p63-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\cos\\theta\\cos2\\theta\\cos4\\theta=\\dfrac18\\sin8\\theta\\operatorname{cosec}\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac18\\sin8\\theta\\operatorname{cosec}\\theta=\\cos\\theta\\cos2\\theta\\cos4\\theta$.\n\nExpand $\\sin8\\theta$ repeatedly using the sine double-angle formula.",
          "worked": "Work from the right-hand side, where $\\sin\\theta\\ne0$.\n\n$$\\begin{align*}\\frac18\\sin8\\theta\\operatorname{cosec}\\theta&=\\frac{\\sin8\\theta}{8\\sin\\theta}\\\\\\frac18\\sin8\\theta\\operatorname{cosec}\\theta&=\\frac{2\\sin4\\theta\\cos4\\theta}{8\\sin\\theta}\\\\\\frac18\\sin8\\theta\\operatorname{cosec}\\theta&=\\frac{4\\sin2\\theta\\cos2\\theta\\cos4\\theta}{8\\sin\\theta}\\\\\\frac18\\sin8\\theta\\operatorname{cosec}\\theta&=\\frac{8\\sin\\theta\\cos\\theta\\cos2\\theta\\cos4\\theta}{8\\sin\\theta}\\\\\\frac18\\sin8\\theta\\operatorname{cosec}\\theta&=\\cos\\theta\\cos2\\theta\\cos4\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p63-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the value of $\\cos20^\\circ\\cos40^\\circ\\cos80^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac18$.",
          "worked": "Set $\\theta=20^\\circ$ in part (a).\n\n$$\\begin{align*}\\cos20^\\circ\\cos40^\\circ\\cos80^\\circ&=\\frac{\\sin160^\\circ}{8\\sin20^\\circ}\\\\\\cos20^\\circ\\cos40^\\circ\\cos80^\\circ&=\\frac{\\sin20^\\circ}{8\\sin20^\\circ}\\\\\\cos20^\\circ\\cos40^\\circ\\cos80^\\circ&=\\frac18.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
