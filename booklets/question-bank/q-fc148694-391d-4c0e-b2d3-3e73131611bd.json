  "content": {
    "id": "p18-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Show that there are no three positive integers whose sum is 30 and whose least common multiple is 825.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No such integers exist.\n\nThe LCM requires factors of $25$ and $11$ in the integers; these force their sum to exceed $30$.",
      "worked": "Suppose such positive integers exist. Their prime factorisations must give\n$$825=3\\times5^2\\times11.$$\nSince the LCM takes the greatest power of each prime, at least one integer must be divisible by $25$, and at least one must be divisible by $11$.\n\nIf the same integer is divisible by both, it is at least $25\\times11=275$, exceeding the total sum of $30$.\n\nOtherwise, two distinct integers are at least $25$ and $11$. The third is at least $1$, so their sum is at least\n$$25+11+1=37>30.$$\nBoth cases contradict the required sum. Therefore, no such three positive integers exist.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 92
  },
