  "content": {
    "id": "p4-q9-root",
    "type": "question",
    "label": null,
    "prompt": "A cyclist’s journey is modelled by $d=0.5t^3-2t^2+3t$, where $d$ is the distance in metres. Determine the cyclist’s average speed for each of these time intervals:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "0 to 2 seconds",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\text{ m/s}$",
          "worked": "$$\\begin{align*}d(0)&=0\\\\d(2)&=0.5(2)^3-2(2)^2+3(2)\\\\d(2)&=2\\text{ m}\\\\\\text{Average speed}&=\\frac{d(2)-d(0)}{2-0}\\\\\\text{Average speed}&=\\frac{2-0}{2}\\\\\\text{Average speed}&=1\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "2 to 4 seconds",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\text{ m/s}$",
          "worked": "$$\\begin{align*}d(2)&=2\\text{ m}\\\\d(4)&=0.5(4)^3-2(4)^2+3(4)\\\\d(4)&=12\\text{ m}\\\\\\text{Average speed}&=\\frac{d(4)-d(2)}{4-2}\\\\\\text{Average speed}&=\\frac{12-2}{2}\\\\\\text{Average speed}&=5\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "4 to 6 seconds",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21\\text{ m/s}$",
          "worked": "$$\\begin{align*}d(4)&=12\\text{ m}\\\\d(6)&=0.5(6)^3-2(6)^2+3(6)\\\\d(6)&=54\\text{ m}\\\\\\text{Average speed}&=\\frac{d(6)-d(4)}{6-4}\\\\\\text{Average speed}&=\\frac{54-12}{2}\\\\\\text{Average speed}&=21\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
