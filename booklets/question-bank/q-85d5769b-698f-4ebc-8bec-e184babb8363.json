    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "A bag contains each of the letters from the word COMPUTER. A letter is chosen at random. Find the probability that the letter is a vowel.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{8}$",
          "worked": "The favourable letters are O, U and E, out of eight letters.\n$$\\Pr(\\text{vowel})=\\frac{3}{8}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "A class contains ten boys and twelve girls. A student is randomly chosen. Find the probability that the student is a boy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{11}$",
          "worked": "There are $10+12=22$ students.\n$$\\begin{align*}\\Pr(\\text{boy})&=\\frac{10}{22}\\\\\\Pr(\\text{boy})&=\\frac{5}{11}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "A regular six-sided die is rolled. Find the probability that the outcome exceeds 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "The favourable outcomes are 5 and 6, out of six outcomes.\n$$\\begin{align*}\\Pr(\\text{outcome exceeds }4)&=\\frac{2}{6}\\\\\\Pr(\\text{outcome exceeds }4)&=\\frac{1}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "A die is rolled. Find the probability that the outcome is a factor of 60.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Each possible outcome, 1, 2, 3, 4, 5 and 6, is a factor of 60.\n$$\\begin{align*}\\Pr(\\text{factor of }60)&=\\frac{6}{6}\\\\\\Pr(\\text{factor of }60)&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
