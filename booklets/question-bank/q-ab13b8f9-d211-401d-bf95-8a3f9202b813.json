    "children": [
      {
        "id": "p42-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $e^{-x^2}$ and hence write down a primitive of $xe^{-x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(e^{-x^2})=-2xe^{-x^2}$. A primitive is $-\\dfrac12e^{-x^2}$.",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(e^{-x^2})&=e^{-x^2}(-2x)\\\\&=-2xe^{-x^2}.\\end{align*}$$\nHence a primitive of $xe^{-x^2}$ is $-\\dfrac12e^{-x^2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p42-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the area between the curve $y=xe^{-x^2}$ and the $x$-axis from $x=0$ to $x=2$, and from $x=-2$ to $x=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "From $0$ to $2$: $\\dfrac12(1-e^{-4})\\text{ units}^2$. From $-2$ to $2$: $(1-e^{-4})\\text{ units}^2$.",
          "worked": "From $x=0$ to $x=2$, the curve is on or above the $x$-axis.\n$$\\begin{align*}A_{[0,2]}&=\\int_0^2 xe^{-x^2}\\,dx\\\\&=\\left[-\\frac12e^{-x^2}\\right]_0^2\\\\&=\\frac12-\\frac12e^{-4}\\text{ units}^2.\\end{align*}$$\nThe function $f(x)=xe^{-x^2}$ is odd, so its signed integral from $-2$ to $2$ is $0$. The area below the axis from $-2$ to $0$ equals the area above the axis from $0$ to $2$.\n$$\\begin{align*}A_{[-2,2]}&=2\\left(\\frac12-\\frac12e^{-4}\\right)\\\\&=(1-e^{-4})\\text{ units}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
