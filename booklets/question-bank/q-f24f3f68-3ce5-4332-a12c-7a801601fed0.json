  "content": {
    "id": "p16-q19",
    "type": "question",
    "label": "19",
    "prompt": "In senior years, it is often necessary to factorise out a fraction. Complete the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q19-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p16-q19-a-expression",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 3,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\mathrel{\\phantom{=}}\\frac{x}{2}+\\frac{y}{2}",
                  "display": false
                }
              ]
            },
            {
              "id": "p16-q19-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "=\\frac{1}{2}\\big(",
                  "display": false,
                  "colour": "#268cff"
                },
                {
                  "type": "cloze",
                  "answer": "$x+y$",
                  "width": 13
                },
                {
                  "type": "math",
                  "latex": "\\big)",
                  "display": false,
                  "colour": "#268cff"
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}(x+y)$",
          "worked": "Factor out $\\frac{1}{2}$. Dividing the terms by this factor gives $x$ and $y$.\n$$\\begin{align*}\\frac{x}{2}+\\frac{y}{2}&=\\frac{1}{2}(x+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p16-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3a}{4}-\\frac{3b}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{4}(a-b)$",
          "worked": "Factor out $\\frac{3}{4}$. Dividing the terms by this factor gives $a$ and $-b$.\n$$\\begin{align*}\\frac{3a}{4}-\\frac{3b}{4}&=\\frac{3}{4}(a-b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2p}{3}-\\frac{2q}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}(p-q)$",
          "worked": "Factor out $\\frac{2}{3}$. Dividing the terms by this factor gives $p$ and $-q$.\n$$\\begin{align*}\\frac{2p}{3}-\\frac{2q}{3}&=\\frac{2}{3}(p-q)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x^{2}}{3}+\\frac{2x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{3}(x+2)$",
          "worked": "Factor out $\\frac{x}{3}$. Dividing the terms by this factor gives $x$ and $2$.\n$$\\begin{align*}\\frac{x^{2}}{3}+\\frac{2x}{3}&=\\frac{x}{3}(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3ab}{5}-\\frac{2b}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b}{5}(3a-2)$",
          "worked": "Factor out $\\frac{b}{5}$. Dividing the terms by this factor gives $3a$ and $-2$.\n$$\\begin{align*}\\frac{3ab}{5}-\\frac{2b}{5}&=\\frac{b}{5}(3a-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q19-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5p^{2}q}{8}-\\frac{3pq}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{pq}{8}(5p-3)$",
          "worked": "Factor out $\\frac{pq}{8}$. Dividing the terms by this factor gives $5p$ and $-3$.\n$$\\begin{align*}\\frac{5p^{2}q}{8}-\\frac{3pq}{8}&=\\frac{pq}{8}(5p-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
