        "answer": {
          "short": "$\\frac{19}{30}$",
          "worked": "$$\\begin{align*}\\frac{1}{5}+\\frac{3}{10}+\\frac{2}{15}&=\\frac{6}{30}+\\frac{9}{30}+\\frac{4}{30}\\\\&=\\frac{19}{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-l",
