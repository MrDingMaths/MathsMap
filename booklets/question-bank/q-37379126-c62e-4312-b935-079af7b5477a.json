        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "$$\\begin{align*}\\frac{11}{12}-\\frac{1}{3}-\\frac{1}{4}&=\\frac{11}{12}-\\frac{4}{12}-\\frac{3}{12}\\\\&=\\frac{4}{12}\\\\&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{1}{5}+\\frac{3}{10}+\\frac{2}{15}$",
