  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "7",
    "prompt": "Add and subtract these fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{5}+\\frac{2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{3}{5}+\\frac{2}{5}&=\\frac{5}{5}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3}{5}-\\frac{2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$$\\begin{align*}\\frac{3}{5}-\\frac{2}{5}&=\\frac{3-2}{5}\\\\&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{5}+\\frac{3}{5}+\\frac{2}{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{3}$",
          "worked": "$$\\begin{align*}\\frac{3}{5}+\\frac{3}{5}+\\frac{2}{15}&=\\frac{9}{15}+\\frac{9}{15}+\\frac{2}{15}\\\\&=\\frac{20}{15}\\\\&=\\frac{4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{7}{20}+\\frac{5}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{20}$",
          "worked": "$$\\begin{align*}\\frac{7}{20}+\\frac{5}{10}&=\\frac{7}{20}+\\frac{10}{20}\\\\&=\\frac{17}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{7}{8}-\\frac{3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}\\frac{7}{8}-\\frac{3}{4}&=\\frac{7}{8}-\\frac{6}{8}\\\\&=\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5}{6}-\\frac{1}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{5}{6}-\\frac{1}{3}&=\\frac{5}{6}-\\frac{2}{6}\\\\&=\\frac{3}{6}\\\\&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{1}{4}+\\frac{3}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "$$\\begin{align*}\\frac{1}{4}+\\frac{3}{8}&=\\frac{2}{8}+\\frac{3}{8}\\\\&=\\frac{5}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{2}{5}+\\frac{4}{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{align*}\\frac{2}{5}+\\frac{4}{15}&=\\frac{6}{15}+\\frac{4}{15}\\\\&=\\frac{10}{15}\\\\&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{7}{10}-\\frac{2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "$$\\begin{align*}\\frac{7}{10}-\\frac{2}{5}&=\\frac{7}{10}-\\frac{4}{10}\\\\&=\\frac{3}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{11}{12}-\\frac{1}{3}-\\frac{1}{4}$",
