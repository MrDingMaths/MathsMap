  "content": {
    "id": "p20-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Let $f(x)=\\dfrac{1}{4x-1}$ and $g(x)=2^x$. Find the value of $k$ such that $g(g(3))=f(k)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\dfrac{257}{1024}$",
      "worked": "$$\\begin{aligned}g(g(3))&=2^{2^3}=256\\\\256&=\\frac{1}{4k-1}\\\\4k-1&=\\frac{1}{256}\\\\4k&=\\frac{257}{256}\\\\k&=\\frac{257}{1024}\\end{aligned}$$",
      "solutionDiagrams": []
    },
