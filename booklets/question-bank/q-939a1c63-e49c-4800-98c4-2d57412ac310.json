  "content": {
    "id": "p51-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Differentiate each function using the quotient rule. Express your answer in fully factored form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{x+1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{2}{(x-1)^2}$",
          "worked": "$$\\begin{align*}u&=x+1,&u'&=1\\\\v&=x-1,&v'&=1\\\\y'&=\\frac{1(x-1)-(x+1)(1)}{(x-1)^2}\\\\y'&=\\frac{x-1-x-1}{(x-1)^2}\\\\y'&=-\\frac{2}{(x-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p51-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{2x}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{4}{(x+2)^2}$",
          "worked": "$$\\begin{align*}u&=2x,&u'&=2\\\\v&=x+2,&v'&=1\\\\y'&=\\frac{2(x+2)-2x(1)}{(x+2)^2}\\\\y'&=\\frac{2x+4-2x}{(x+2)^2}\\\\y'&=\\frac{4}{(x+2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p51-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{3-2x}{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{13}{(x+5)^2}$",
          "worked": "$$\\begin{align*}u&=3-2x,&u'&=-2\\\\v&=x+5,&v'&=1\\\\y'&=\\frac{-2(x+5)-(3-2x)(1)}{(x+5)^2}\\\\y'&=\\frac{-2x-10-3+2x}{(x+5)^2}\\\\y'&=-\\frac{13}{(x+5)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p51-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{x^2}{1-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x(2-x)}{(1-x)^2}$",
          "worked": "$$\\begin{align*}u&=x^2,&u'&=2x\\\\v&=1-x,&v'&=-1\\\\y'&=\\frac{2x(1-x)-x^2(-1)}{(1-x)^2}\\\\y'&=\\frac{2x-2x^2+x^2}{(1-x)^2}\\\\y'&=\\frac{2x-x^2}{(1-x)^2}\\\\y'&=\\frac{x(2-x)}{(1-x)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p51-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{x^2-1}{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{4x}{(x^2+1)^2}$",
          "worked": "$$\\begin{align*}u&=x^2-1,&u'&=2x\\\\v&=x^2+1,&v'&=2x\\\\y'&=\\frac{2x(x^2+1)-(x^2-1)(2x)}{(x^2+1)^2}\\\\y'&=\\frac{2x^3+2x-2x^3+2x}{(x^2+1)^2}\\\\y'&=\\frac{4x}{(x^2+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p51-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{x}{1-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1+x^2}{(1-x)^2(1+x)^2}$",
          "worked": "$$\\begin{align*}u&=x,&u'&=1\\\\v&=1-x^2,&v'&=-2x\\\\y'&=\\frac{1(1-x^2)-x(-2x)}{(1-x^2)^2}\\\\y'&=\\frac{1-x^2+2x^2}{(1-x^2)^2}\\\\y'&=\\frac{1+x^2}{(1-x^2)^2}\\\\y'&=\\frac{1+x^2}{(1-x)^2(1+x)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p51-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\dfrac{x^3-1}{x^3+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{6x^2}{(x+1)^2(x^2-x+1)^2}$",
          "worked": "$$\\begin{align*}u&=x^3-1,&u'&=3x^2\\\\v&=x^3+1,&v'&=3x^2\\\\y'&=\\frac{3x^2(x^3+1)-(x^3-1)(3x^2)}{(x^3+1)^2}\\\\y'&=\\frac{3x^5+3x^2-3x^5+3x^2}{(x^3+1)^2}\\\\y'&=\\frac{6x^2}{(x^3+1)^2}\\\\y'&=\\frac{6x^2}{(x+1)^2(x^2-x+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p51-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\dfrac{x^2-9}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{10x}{(x-2)^2(x+2)^2}$",
          "worked": "$$\\begin{align*}u&=x^2-9,&u'&=2x\\\\v&=x^2-4,&v'&=2x\\\\y'&=\\frac{2x(x^2-4)-(x^2-9)(2x)}{(x^2-4)^2}\\\\y'&=\\frac{2x^3-8x-2x^3+18x}{(x^2-4)^2}\\\\y'&=\\frac{10x}{(x^2-4)^2}\\\\y'&=\\frac{10x}{(x-2)^2(x+2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
