  "content": {
    "id": "p36-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Say whether these statements are true or false, and if false, give a counterexample (any difficulties will usually involve negative numbers):",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$|x|>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False; $x=0$.",
          "worked": "For $x=0$, $|0|=0$, so $|0|>0$ is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p36-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$|-x|=|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$x$ and $-x$ have the same distance from zero, so $|-x|=|x|$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p36-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$-|x|\\leq x\\leq|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "If $x\\geq0$, then $|x|=x$ and $-x\\leq x\\leq x$. If $x<0$, then $|x|=-x$ and $x\\leq x\\leq-x$. Thus $-|x|\\leq x\\leq|x|$ in both cases.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p36-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$|x+2|=|x|+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False; $x=-2$.",
          "worked": "For $x=-2$:\n\n$\\begin{aligned}|x+2|&=|-2+2|=0\\\\|x|+2&=|-2|+2=4\\end{aligned}$\n\nSince $0\\ne4$, this is a counterexample.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p36-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$|5x|=5|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$|5x|=|5||x|=5|x|$, because $5$ is positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p36-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$|x|^2=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "For $x\\geq0$, $|x|^2=x^2$. For $x<0$, $|x|^2=(-x)^2=x^2$. Hence the statement is true for every real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p36-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$|x|^3=x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False; $x=-2$.",
          "worked": "For $x=-2$:\n\n$\\begin{aligned}|x|^3&=|-2|^3=8\\\\x^3&=(-2)^3=-8\\end{aligned}$\n\nSince $8\\ne-8$, this is a counterexample.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p36-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$|x-7|=|7-x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$7-x=-(x-7)$, so $|7-x|=|-(x-7)|=|x-7|$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
