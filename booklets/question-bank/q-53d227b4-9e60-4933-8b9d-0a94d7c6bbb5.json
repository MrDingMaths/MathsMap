  "content": {
    "id": "p16-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Derek is presently 20 years older than his daughter, Alana.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q7-a",
        "type": "group",
        "label": "a",
        "prompt": "If $x$ represents Alana’s present age, express each of the following in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q7-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Derek’s present age",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(x+20)$ years",
              "worked": "Derek is 20 years older than Alana, so his present age is $(x+20)$ years.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p16-q7-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Alana’s age in 12 years’ time",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(x+12)$ years",
              "worked": "In 12 years’ time, Alana’s age will be $(x+12)$ years.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p16-q7-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Derek’s age in 12 years’ time",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(x+32)$ years",
              "worked": "$$\\begin{align*}x+20+12&=x+32\\end{align*}$$\nDerek will be $(x+32)$ years old.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If Derek’s age 12 years from now is twice Alana’s age 12 years from now, find their present ages.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Alana is 8 years old and Derek is 28 years old.",
          "worked": "Let $x$ be Alana’s present age in years. In 12 years, Alana will be $(x+12)$ years old and Derek will be $(x+32)$ years old.\n$$\\begin{align*}x+32&=2(x+12)\\\\x+32&=2x+24\\\\32&=x+24\\\\8&=x\\end{align*}$$\nAlana is 8 years old. Derek’s present age is $8+20=28$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
