      {
        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Alice scores 17 out of 20 on a mathematics test. Express her score as a percentage.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$85\\%$",
          "worked": "$$\\begin{align*}\\text{Alice's score}&=\\frac{17}{20}\\times100\\%\\\\\\text{Alice's score}&=85\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Keanu scores 31 out of 40 on a science test. Express his score as a percentage.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$77.5\\%$",
          "worked": "$$\\begin{align*}\\text{Keanu's score}&=\\frac{31}{40}\\times100\\%\\\\\\text{Keanu's score}&=77.5\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Express 21 seconds as a percentage of 2 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17.5\\%$",
          "worked": "$2\\text{ minutes}=120\\text{ seconds}$.\n\n$$\\begin{align*}\\text{Percentage}&=\\frac{21}{120}\\times100\\%\\\\\\text{Percentage}&=17.5\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Express 54 seconds as a percentage of 3 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\%$",
          "worked": "$3\\text{ minutes}=180\\text{ seconds}$.\n\n$$\\begin{align*}\\text{Percentage}&=\\frac{54}{180}\\times100\\%\\\\\\text{Percentage}&=30\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "Express 27 cm as a percentage of 3 metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\%$",
          "worked": "$3\\text{ m}=300\\text{ cm}$.\n\n$$\\begin{align*}\\text{Percentage}&=\\frac{27}{300}\\times100\\%\\\\\\text{Percentage}&=9\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "Express 18 mm as a percentage of 2 metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9\\%$",
          "worked": "$2\\text{ m}=2000\\text{ mm}$.\n\n$$\\begin{align*}\\text{Percentage}&=\\frac{18}{2000}\\times100\\%\\\\\\text{Percentage}&=0.9\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
