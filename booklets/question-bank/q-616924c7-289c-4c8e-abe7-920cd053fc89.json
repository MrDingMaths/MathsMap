  "content": {
    "id": "p5-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the prime factorisation of each of the following numbers:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^8+(2\\times3^4)+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times41^2$",
          "worked": "$$\\begin{align*}3^8+(2\\times3^4)+1&=(3^4)^2+2(3^4)(1)+1^2\\\\3^8+(2\\times3^4)+1&=(3^4+1)^2\\\\3^8+(2\\times3^4)+1&=82^2\\\\3^8+(2\\times3^4)+1&=2^2\\times41^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^6-(2\\times3^3)+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times13^2$",
          "worked": "$$\\begin{align*}3^6-(2\\times3^3)+1&=(3^3)^2-2(3^3)(1)+1^2\\\\3^6-(2\\times3^3)+1&=(3^3-1)^2\\\\3^6-(2\\times3^3)+1&=26^2\\\\3^6-(2\\times3^3)+1&=2^2\\times13^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^8+2^5+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17^2$",
          "worked": "$$\\begin{align*}2^8+2^5+1&=(2^4)^2+2(2^4)(1)+1^2\\\\2^8+2^5+1&=(2^4+1)^2\\\\2^8+2^5+1&=17^2\\end{align*}$$\nSince $17$ is prime, this is the prime factorisation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p5-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$2^{12}-2^7+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^4\\times7^2$",
          "worked": "$$\\begin{align*}2^{12}-2^7+1&=(2^6)^2-2(2^6)(1)+1^2\\\\2^{12}-2^7+1&=(2^6-1)^2\\\\2^{12}-2^7+1&=63^2\\\\2^{12}-2^7+1&=3^4\\times7^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$5^4+(2\\times15^2)+3^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times17^2$",
          "worked": "$$\\begin{align*}5^4+(2\\times15^2)+3^4&=(5^2)^2+2(5^2)(3^2)+(3^2)^2\\\\5^4+(2\\times15^2)+3^4&=(5^2+3^2)^2\\\\5^4+(2\\times15^2)+3^4&=34^2\\\\5^4+(2\\times15^2)+3^4&=2^2\\times17^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^6+2^7+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^2\\times13^2$",
          "worked": "$$\\begin{align*}4^6+2^7+1&=(2^6)^2+2(2^6)(1)+1^2\\\\4^6+2^7+1&=(2^6+1)^2\\\\4^6+2^7+1&=65^2\\\\4^6+2^7+1&=5^2\\times13^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
