  "content": {
    "id": "p9-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "How many ways can five counters be placed on a $5\\times5$ grid so that there is one counter in each row and column?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5!=120$",
      "worked": "Place one counter in each row. The first row has 5 column choices; each later row must use a column not already occupied, giving 4, 3, 2 and 1 choices.\n\n$$\\begin{align*}N&=5\\times4\\times3\\times2\\times1\\\\N&=5!\\\\N&=120.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
