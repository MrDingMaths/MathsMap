  "content": {
    "id": "v2-1ddc9-p55-practice-slot-9-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Solve each of these equations for $0 \\leq \\theta < 360^{\\circ}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1ddc9-p55-practice-slot-9-upper-slot-9-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\theta=\\frac{1}{\\sqrt{2}}$\n\n1. Reference angle\n2. Quadrants\n3. Solutions",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=45^{\\circ}$ or $135^{\\circ}$. Reference angle $45^{\\circ}$; Q1 or Q2.",
          "worked": "1. Reference angle:\n$$\\begin{align*}A&=\\sin^{-1}\\left(\\frac{1}{\\sqrt{2}}\\right)\\\\A&=45^{\\circ}\\end{align*}$$\n2. $\\sin\\theta>0$, so $\\theta$ is in Q1 or Q2.\n\n3. Solutions:\n$$\\begin{align*}\\theta&=45^{\\circ}\\\\\\text{or }\\theta&=180^{\\circ}-45^{\\circ}\\\\\\theta&=135^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-1ddc9-p55-practice-slot-9-upper-slot-9-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\theta=\\frac{1}{\\sqrt{3}}$\n\n1. Reference angle\n2. Quadrants\n3. Solutions",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=30^{\\circ}$ or $210^{\\circ}$. Reference angle $30^{\\circ}$; Q1 or Q3.",
          "worked": "1. Reference angle:\n$$\\begin{align*}A&=\\tan^{-1}\\left(\\frac{1}{\\sqrt{3}}\\right)\\\\A&=30^{\\circ}\\end{align*}$$\n2. $\\tan\\theta>0$, so $\\theta$ is in Q1 or Q3.\n\n3. Solutions:\n$$\\begin{align*}\\theta&=30^{\\circ}\\\\\\text{or }\\theta&=180^{\\circ}+30^{\\circ}\\\\\\theta&=210^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
