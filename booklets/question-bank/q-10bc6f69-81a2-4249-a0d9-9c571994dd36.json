  "content": {
    "id": "p14-23d-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Divide each of the polynomials $P(x)$ by the given polynomial $D(x)$. Express your answer in the form $P(x)=D(x)Q(x)+R(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-23d-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=x^3+2x^2+3x-1$, $D(x)=x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3+2x^2+3x-1=(x+1)(x^2+x+2)-3$.",
          "worked": "Successive multiplication and subtraction give\n$$\\begin{align*}(x^3+2x^2+3x-1)-x^2(x+1)&=x^2+3x-1\\\\(x^2+3x-1)-x(x+1)&=2x-1\\\\(2x-1)-2(x+1)&=-3.\\end{align*}$$\nThus $Q(x)=x^2+x+2$ and $R(x)=-3$.\n$$x^3+2x^2+3x-1=(x+1)(x^2+x+2)-3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p14-23d-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=x^3+3x^2+2x-4$, $D(x)=x-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3+3x^2+2x-4=(x-1)(x^2+4x+6)+2$.",
          "worked": "Successive multiplication and subtraction give\n$$\\begin{align*}(x^3+3x^2+2x-4)-x^2(x-1)&=4x^2+2x-4\\\\(4x^2+2x-4)-4x(x-1)&=6x-4\\\\(6x-4)-6(x-1)&=2.\\end{align*}$$\nThus $Q(x)=x^2+4x+6$ and $R(x)=2$.\n$$x^3+3x^2+2x-4=(x-1)(x^2+4x+6)+2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p14-23d-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=x^3-9x^2+22x-7$, $D(x)=x-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3-9x^2+22x-7=(x-4)(x^2-5x+2)+1$.",
          "worked": "Successive multiplication and subtraction give\n$$\\begin{align*}(x^3-9x^2+22x-7)-x^2(x-4)&=-5x^2+22x-7\\\\(-5x^2+22x-7)-(-5x)(x-4)&=2x-7\\\\(2x-7)-2(x-4)&=1.\\end{align*}$$\nThus $Q(x)=x^2-5x+2$ and $R(x)=1$.\n$$x^3-9x^2+22x-7=(x-4)(x^2-5x+2)+1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p14-23d-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(x)=2x^3+5x^2+5x+6$, $D(x)=2x+3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^3+5x^2+5x+6=(2x+3)(x^2+x+1)+3$.",
          "worked": "Successive multiplication and subtraction give\n$$\\begin{align*}(2x^3+5x^2+5x+6)-x^2(2x+3)&=2x^2+5x+6\\\\(2x^2+5x+6)-x(2x+3)&=2x+6\\\\(2x+6)-(2x+3)&=3.\\end{align*}$$\nThus $Q(x)=x^2+x+1$ and $R(x)=3$.\n$$2x^3+5x^2+5x+6=(2x+3)(x^2+x+1)+3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p14-23d-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(x)=3x^3+2x^2+x+1$, $D(x)=x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^3+2x^2+x+1=(x+2)(3x^2-4x+9)-17$.",
          "worked": "Successive multiplication and subtraction give\n$$\\begin{align*}(3x^3+2x^2+x+1)-3x^2(x+2)&=-4x^2+x+1\\\\(-4x^2+x+1)-(-4x)(x+2)&=9x+1\\\\(9x+1)-9(x+2)&=-17.\\end{align*}$$\nThus $Q(x)=3x^2-4x+9$ and $R(x)=-17$.\n$$3x^3+2x^2+x+1=(x+2)(3x^2-4x+9)-17.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p14-23d-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$P(x)=3x^3-4x^2-x+4$, $D(x)=3x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^3-4x^2-x+4=(3x+2)(x^2-2x+1)+2$.",
          "worked": "Successive multiplication and subtraction give\n$$\\begin{align*}(3x^3-4x^2-x+4)-x^2(3x+2)&=-6x^2-x+4\\\\(-6x^2-x+4)-(-2x)(3x+2)&=3x+4\\\\(3x+4)-(3x+2)&=2.\\end{align*}$$\nThus $Q(x)=x^2-2x+1$ and $R(x)=2$.\n$$3x^3-4x^2-x+4=(3x+2)(x^2-2x+1)+2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p14-23d-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$P(x)=2x^3+3x^2+4x+5$, $D(x)=x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^3+3x^2+4x+5=(x+2)(2x^2-x+6)-7$.",
          "worked": "Successive multiplication and subtraction give\n$$\\begin{align*}(2x^3+3x^2+4x+5)-2x^2(x+2)&=-x^2+4x+5\\\\(-x^2+4x+5)-(-x)(x+2)&=6x+5\\\\(6x+5)-6(x+2)&=-7.\\end{align*}$$\nThus $Q(x)=2x^2-x+6$ and $R(x)=-7$.\n$$2x^3+3x^2+4x+5=(x+2)(2x^2-x+6)-7.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
