  "content": {
    "id": "p11-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Factorise each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^4-16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(x+2)(x^2+4)$",
          "worked": "$$\\begin{align*}x^4-16&=(x^2-4)(x^2+4)\\\\x^4-16&=(x-2)(x+2)(x^2+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^5-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-1)(x^4+x^3+x^2+x+1)$",
          "worked": "$$\\begin{align*}x^5-1&=x^5-1^5\\\\x^5-1&=(x-1)(x^4+x^3+x^2+x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^5+32$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x^4-2x^3+4x^2-8x+16)$",
          "worked": "$$\\begin{align*}x^5+32&=x^5+2^5\\\\x^5+32&=(x+2)(x^4-2x^3+4x^2-8x+16).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^5-32$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(x^4+2x^3+4x^2+8x+16)$",
          "worked": "$$\\begin{align*}x^5-32&=x^5-2^5\\\\x^5-32&=(x-2)(x^4+2x^3+4x^2+8x+16).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^7+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x^6-x^5+x^4-x^3+x^2-x+1)$",
          "worked": "$$\\begin{align*}x^7+1&=x^7+1^7\\\\x^7+1&=(x+1)(x^6-x^5+x^4-x^3+x^2-x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^7-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-1)(x^6+x^5+x^4+x^3+x^2+x+1)$",
          "worked": "$$\\begin{align*}x^7-1&=x^7-1^7\\\\x^7-1&=(x-1)(x^6+x^5+x^4+x^3+x^2+x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^4-81$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x+3)(x^2+9)$",
          "worked": "$$\\begin{align*}x^4-81&=(x^2-9)(x^2+9)\\\\x^4-81&=(x-3)(x+3)(x^2+9).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$16x^4-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(2x+1)(4x^2+1)$",
          "worked": "$$\\begin{align*}16x^4-1&=(4x^2)^2-1^2\\\\16x^4-1&=(4x^2-1)(4x^2+1)\\\\16x^4-1&=(2x-1)(2x+1)(4x^2+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$32x^5-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(16x^4+8x^3+4x^2+2x+1)$",
          "worked": "$$\\begin{align*}32x^5-1&=(2x)^5-1^5\\\\32x^5-1&=(2x-1)(16x^4+8x^3+4x^2+2x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
