  "content": {
    "id": "p17-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Prove the following identities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan\\theta+\\cot\\theta=\\sec\\theta\\operatorname{cosec}\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1}{\\sin\\theta\\cos\\theta}=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\tan\\theta+\\cot\\theta&=\\frac{\\sin\\theta}{\\cos\\theta}+\\frac{\\cos\\theta}{\\sin\\theta}\\\\&=\\frac{\\sin^2\\theta+\\cos^2\\theta}{\\sin\\theta\\cos\\theta}\\\\&=\\frac{1}{\\sin\\theta\\cos\\theta}\\\\&=\\sec\\theta\\operatorname{cosec}\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p17-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\theta(1-\\cot^2\\theta)+\\cot\\theta(1-\\tan^2\\theta)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\tan\\theta-\\cot\\theta+\\cot\\theta-\\tan\\theta=0$.",
          "worked": "Using $\\tan\\theta\\cot\\theta=1$:\n$$\\begin{align*}\\tan\\theta(1-\\cot^2\\theta)+\\cot\\theta(1-\\tan^2\\theta)&=\\tan\\theta-\\tan\\theta\\cot^2\\theta+\\cot\\theta-\\cot\\theta\\tan^2\\theta\\\\&=\\tan\\theta-\\cot\\theta+\\cot\\theta-\\tan\\theta\\\\&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\cos^2\\theta-1=1-2\\sin^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=2(1-\\sin^2\\theta)-1=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}2\\cos^2\\theta-1&=2(1-\\sin^2\\theta)-1\\\\&=1-2\\sin^2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p17-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan\\theta\\sin\\theta+\\cos\\theta=\\sec\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sin^2\\theta+\\cos^2\\theta}{\\cos\\theta}=\\sec\\theta$.",
          "worked": "$$\\begin{align*}\\tan\\theta\\sin\\theta+\\cos\\theta&=\\frac{\\sin^2\\theta}{\\cos\\theta}+\\cos\\theta\\\\&=\\frac{\\sin^2\\theta+\\cos^2\\theta}{\\cos\\theta}\\\\&=\\frac{1}{\\cos\\theta}\\\\&=\\sec\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p17-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1}{\\sin\\theta\\cos\\theta}-\\tan\\theta=\\cot\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1-\\sin^2\\theta}{\\sin\\theta\\cos\\theta}=\\cot\\theta$.",
          "worked": "$$\\begin{align*}\\frac{1}{\\sin\\theta\\cos\\theta}-\\tan\\theta&=\\frac{1}{\\sin\\theta\\cos\\theta}-\\frac{\\sin\\theta}{\\cos\\theta}\\\\&=\\frac{1-\\sin^2\\theta}{\\sin\\theta\\cos\\theta}\\\\&=\\frac{\\cos^2\\theta}{\\sin\\theta\\cos\\theta}\\\\&=\\cot\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p17-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1}{1+\\sin^2\\theta}+\\dfrac{1}{1+\\operatorname{cosec}^2\\theta}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1+\\sin^2\\theta}{1+\\sin^2\\theta}=1$.",
          "worked": "$$\\begin{align*}\\frac{1}{1+\\sin^2\\theta}+\\frac{1}{1+\\operatorname{cosec}^2\\theta}&=\\frac{1}{1+\\sin^2\\theta}+\\frac{\\sin^2\\theta}{1+\\sin^2\\theta}\\\\&=\\frac{1+\\sin^2\\theta}{1+\\sin^2\\theta}\\\\&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p17-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{1+\\cos\\theta}{\\sin^2\\theta}=\\dfrac{1}{1-\\cos\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Factor $\\sin^2\\theta=(1-\\cos\\theta)(1+\\cos\\theta)$ and cancel.",
          "worked": "$$\\begin{align*}\\frac{1+\\cos\\theta}{\\sin^2\\theta}&=\\frac{1+\\cos\\theta}{(1-\\cos\\theta)(1+\\cos\\theta)}\\\\&=\\frac{1}{1-\\cos\\theta}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p17-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{1-\\cos\\theta}{\\sin^2\\theta}=\\dfrac{1}{1+\\cos\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Factor $\\sin^2\\theta=(1-\\cos\\theta)(1+\\cos\\theta)$ and cancel.",
          "worked": "$$\\begin{align*}\\frac{1-\\cos\\theta}{\\sin^2\\theta}&=\\frac{1-\\cos\\theta}{(1-\\cos\\theta)(1+\\cos\\theta)}\\\\&=\\frac{1}{1+\\cos\\theta}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p17-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\sec^4\\theta-\\tan^4\\theta=2\\sec^2\\theta-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=(\\sec^2\\theta-\\tan^2\\theta)(\\sec^2\\theta+\\tan^2\\theta)=2\\sec^2\\theta-1$.",
          "worked": "$$\\begin{align*}\\sec^4\\theta-\\tan^4\\theta&=(\\sec^2\\theta-\\tan^2\\theta)(\\sec^2\\theta+\\tan^2\\theta)\\\\&=\\sec^2\\theta+\\tan^2\\theta\\\\&=\\sec^2\\theta+(\\sec^2\\theta-1)\\\\&=2\\sec^2\\theta-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p17-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{\\operatorname{cosec}\\theta+\\sec\\theta}{1+\\tan\\theta}=\\operatorname{cosec}\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1}{\\sin\\theta}=\\operatorname{cosec}\\theta$.",
          "worked": "$$\\begin{align*}\\frac{\\operatorname{cosec}\\theta+\\sec\\theta}{1+\\tan\\theta}&=\\frac{\\frac{1}{\\sin\\theta}+\\frac{1}{\\cos\\theta}}{1+\\frac{\\sin\\theta}{\\cos\\theta}}\\\\&=\\frac{\\sin\\theta+\\cos\\theta}{\\sin\\theta\\cos\\theta}\\cdot\\frac{\\cos\\theta}{\\cos\\theta+\\sin\\theta}\\\\&=\\frac{1}{\\sin\\theta}\\\\&=\\operatorname{cosec}\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p17-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{\\cos^2\\theta}{1+\\sin\\theta}+\\dfrac{\\cos^2\\theta}{1-\\sin\\theta}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=(1-\\sin\\theta)+(1+\\sin\\theta)=2$.",
          "worked": "$$\\begin{align*}\\frac{\\cos^2\\theta}{1+\\sin\\theta}+\\frac{\\cos^2\\theta}{1-\\sin\\theta}&=\\frac{(1-\\sin\\theta)(1+\\sin\\theta)}{1+\\sin\\theta}+\\frac{(1-\\sin\\theta)(1+\\sin\\theta)}{1-\\sin\\theta}\\\\&=(1-\\sin\\theta)+(1+\\sin\\theta)\\\\&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{1}{1+\\sin\\theta}+\\dfrac{1}{1-\\sin\\theta}=2\\sec^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{2}{1-\\sin^2\\theta}=2\\sec^2\\theta$.",
          "worked": "$$\\begin{align*}\\frac{1}{1+\\sin\\theta}+\\frac{1}{1-\\sin\\theta}&=\\frac{(1-\\sin\\theta)+(1+\\sin\\theta)}{(1+\\sin\\theta)(1-\\sin\\theta)}\\\\&=\\frac{2}{1-\\sin^2\\theta}\\\\&=\\frac{2}{\\cos^2\\theta}\\\\&=2\\sec^2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p17-q4-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{\\cot^2\\theta-1}{\\cot^2\\theta+1}=1-2\\sin^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\cos^2\\theta-\\sin^2\\theta=1-2\\sin^2\\theta$.",
          "worked": "$$\\begin{align*}\\frac{\\cot^2\\theta-1}{\\cot^2\\theta+1}&=\\frac{\\cos^2\\theta-\\sin^2\\theta}{\\cos^2\\theta+\\sin^2\\theta}\\\\&=\\cos^2\\theta-\\sin^2\\theta\\\\&=(1-\\sin^2\\theta)-\\sin^2\\theta\\\\&=1-2\\sin^2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p17-q4-n",
        "type": "part",
        "label": "n",
        "prompt": "$(\\sec\\theta+\\tan\\theta)^2=\\dfrac{1+\\sin\\theta}{1-\\sin\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{(1+\\sin\\theta)^2}{1-\\sin^2\\theta}=\\dfrac{1+\\sin\\theta}{1-\\sin\\theta}$.",
          "worked": "$$\\begin{align*}(\\sec\\theta+\\tan\\theta)^2&=\\left(\\frac{1+\\sin\\theta}{\\cos\\theta}\\right)^2\\\\&=\\frac{(1+\\sin\\theta)^2}{1-\\sin^2\\theta}\\\\&=\\frac{(1+\\sin\\theta)^2}{(1-\\sin\\theta)(1+\\sin\\theta)}\\\\&=\\frac{1+\\sin\\theta}{1-\\sin\\theta}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p17-q4-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\tan^2\\theta\\cos\\theta=\\sec\\theta-\\cos\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=(\\sec^2\\theta-1)\\cos\\theta=\\sec\\theta-\\cos\\theta$.",
          "worked": "$$\\begin{align*}\\tan^2\\theta\\cos\\theta&=(\\sec^2\\theta-1)\\cos\\theta\\\\&=\\frac{\\cos\\theta}{\\cos^2\\theta}-\\cos\\theta\\\\&=\\frac{1}{\\cos\\theta}-\\cos\\theta\\\\&=\\sec\\theta-\\cos\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p17-q4-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\dfrac{\\cos\\theta}{1+\\sin\\theta}+\\dfrac{1+\\sin\\theta}{\\cos\\theta}=2\\sec\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1-\\sin\\theta+1+\\sin\\theta}{\\cos\\theta}=2\\sec\\theta$.",
          "worked": "$$\\begin{align*}\\frac{\\cos\\theta}{1+\\sin\\theta}+\\frac{1+\\sin\\theta}{\\cos\\theta}&=\\frac{\\cos^2\\theta}{\\cos\\theta(1+\\sin\\theta)}+\\frac{1+\\sin\\theta}{\\cos\\theta}\\\\&=\\frac{1-\\sin\\theta}{\\cos\\theta}+\\frac{1+\\sin\\theta}{\\cos\\theta}\\\\&=\\frac{2}{\\cos\\theta}\\\\&=2\\sec\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
