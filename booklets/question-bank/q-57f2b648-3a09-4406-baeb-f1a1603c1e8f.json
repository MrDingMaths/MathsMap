            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}&\\mathrel{\\phantom{=}}\\frac{1}{x+\\frac{1}{x+2}}\\times\\frac{1}{x+\\frac{1}{x-2}}\\div\\frac{x-\\frac{4}{x}}{x^2-2+\\frac{1}{x^2}}\\\\&=\\frac{1}{\\frac{x(x+2)+1}{x+2}}\\times\\frac{1}{\\frac{x(x-2)+1}{x-2}}\\div\\frac{\\frac{x^2-4}{x}}{\\frac{x^4-2x^2+1}{x^2}}\\\\&=\\frac{x+2}{x^2+2x+1}\\times\\frac{x-2}{x^2-2x+1}\\div\\frac{\\frac{(x-2)(x+2)}{x}}{\\frac{(x^2-1)^2}{x^2}}\\\\&=\\frac{x+2}{(x+1)^2}\\times\\frac{x-2}{(x-1)^2}\\div\\left(\\frac{(x-2)(x+2)}{x}\\cdot\\frac{x^2}{(x-1)^2(x+1)^2}\\right)\\\\&=\\frac{(x+2)(x-2)}{(x+1)^2(x-1)^2}\\div\\frac{x(x-2)(x+2)}{(x-1)^2(x+1)^2}\\\\&=\\frac{(x+2)(x-2)}{(x+1)^2(x-1)^2}\\times\\frac{(x-1)^2(x+1)^2}{x(x-2)(x+2)}\\\\&=\\frac{1}{x}\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
