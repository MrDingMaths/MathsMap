    "type": "question",
    "label": null,
    "prompt": "Chloe is a barista and is paid \\$26.40/h. In one week she works 3 hours of overtime at time-and-a-half and 4 hours of overtime at double time. Calculate her overtime pay for the week.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$330",
      "worked": "$$\\begin{align*}\\text{Time-and-a-half pay}&=26.40\\times3\\times1.5\\\\\\text{Time-and-a-half pay}&=\\$118.80\\\\\\text{Double-time pay}&=26.40\\times4\\times2\\\\\\text{Double-time pay}&=\\$211.20\\\\\\text{Overtime pay}&=118.80+211.20\\\\\\text{Overtime pay}&=\\$330\\end{align*}$$",
      "solutionDiagrams": []
    },
