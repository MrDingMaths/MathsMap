  "content": {
    "id": "p100-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Of the marbles in a bag, $\\frac{1}{5}$ are blue and $\\frac{2}{3}$ are red. The remaining marbles are yellow, and there are 6 of these. How many marbles are in the bag?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "45 marbles.",
      "worked": "$$\\begin{align*}\\text{Fraction yellow}&=1-\\left(\\frac{1}{5}+\\frac{2}{3}\\right)\\\\\\text{Fraction yellow}&=1-\\frac{13}{15}\\\\\\text{Fraction yellow}&=\\frac{2}{15}\\end{align*}$$\nLet the total number of marbles be $x$.\n$$\\begin{align*}\\frac{2}{15}x&=6\\\\x&=6\\div\\frac{2}{15}\\\\x&=45\\end{align*}$$\nThere are 45 marbles in the bag.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
