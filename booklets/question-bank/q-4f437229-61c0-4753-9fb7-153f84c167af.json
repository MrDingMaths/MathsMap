  "content": {
    "id": "p30-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The price of a bike before GST is added is $\\$320$. What is the price after GST is added?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$352$",
      "worked": "The price including GST is $110\\%$ of the pre-GST price.\n\n$$\\begin{align*}10\\%\\text{ of the pre-GST price}&=\\$320\\div10\\\\10\\%\\text{ of the pre-GST price}&=\\$32\\\\\\text{Price including GST}&=\\$32\\times11\\\\\\text{Price including GST}&=\\$352\\end{align*}$$",
      "solutionDiagrams": []
    },
