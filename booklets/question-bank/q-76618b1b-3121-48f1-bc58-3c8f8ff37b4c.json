  "content": {
    "id": "p21-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify each of the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{5}{ab}+\\frac{2}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2b+5}{ab}$",
          "worked": "$$\\begin{align*}\\frac{5}{ab}+\\frac{2}{a}&=\\frac{5+2b}{ab}\\\\\\frac{5}{ab}+\\frac{2}{a}&=\\frac{2b+5}{ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2}{b^2c}-\\frac{1}{bc^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2c-b}{b^2c^2}$",
          "worked": "$$\\begin{align*}\\frac{2}{b^2c}-\\frac{1}{bc^2}&=\\frac{2c}{b^2c^2}-\\frac{b}{b^2c^2}\\\\\\frac{2}{b^2c}-\\frac{1}{bc^2}&=\\frac{2c-b}{b^2c^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{x^2}-\\frac{4}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3-4x}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{3}{x^2}-\\frac{4}{x}&=\\frac{3}{x^2}-\\frac{4x}{x^2}\\\\\\frac{3}{x^2}-\\frac{4}{x}&=\\frac{3-4x}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5}{2m}-\\frac{2}{3n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15n-4m}{6mn}$",
          "worked": "$$\\begin{align*}\\frac{5}{2m}-\\frac{2}{3n}&=\\frac{15n}{6mn}-\\frac{4m}{6mn}\\\\\\frac{5}{2m}-\\frac{2}{3n}&=\\frac{15n-4m}{6mn}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{a}+\\frac{2}{a^2}+\\frac{3}{a^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^2+2a+3}{a^3}$",
          "worked": "$$\\begin{align*}\\frac{1}{a}+\\frac{2}{a^2}+\\frac{3}{a^3}&=\\frac{a^2}{a^3}+\\frac{2a}{a^3}+\\frac{3}{a^3}\\\\\\frac{1}{a}+\\frac{2}{a^2}+\\frac{3}{a^3}&=\\frac{a^2+2a+3}{a^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{3}{x+2}-\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-4}{x(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+2}-\\frac{2}{x}&=\\frac{3x-2(x+2)}{x(x+2)}\\\\\\frac{3}{x+2}-\\frac{2}{x}&=\\frac{3x-2x-4}{x(x+2)}\\\\\\frac{3}{x+2}-\\frac{2}{x}&=\\frac{x-4}{x(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{2}{x+3}+\\frac{3}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+13}{(x+3)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x+3}+\\frac{3}{x+2}&=\\frac{2(x+2)+3(x+3)}{(x+3)(x+2)}\\\\\\frac{2}{x+3}+\\frac{3}{x+2}&=\\frac{2x+4+3x+9}{(x+3)(x+2)}\\\\\\frac{2}{x+3}+\\frac{3}{x+2}&=\\frac{5x+13}{(x+3)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{1}{a+1}-\\frac{2}{a+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1-a}{(a+1)(a+3)}$",
          "worked": "$$\\begin{align*}\\frac{1}{a+1}-\\frac{2}{a+3}&=\\frac{a+3-2(a+1)}{(a+1)(a+3)}\\\\\\frac{1}{a+1}-\\frac{2}{a+3}&=\\frac{a+3-2a-2}{(a+1)(a+3)}\\\\\\frac{1}{a+1}-\\frac{2}{a+3}&=\\frac{1-a}{(a+1)(a+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{2}{a-2}-\\frac{5}{a-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3a}{(a-2)(a-5)}$",
          "worked": "$$\\begin{align*}\\frac{2}{a-2}-\\frac{5}{a-5}&=\\frac{2(a-5)-5(a-2)}{(a-2)(a-5)}\\\\\\frac{2}{a-2}-\\frac{5}{a-5}&=\\frac{2a-10-5a+10}{(a-2)(a-5)}\\\\\\frac{2}{a-2}-\\frac{5}{a-5}&=-\\frac{3a}{(a-2)(a-5)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{m}{(m-1)^2}+\\frac{2}{m-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3m-2}{(m-1)^2}$",
          "worked": "$$\\begin{align*}\\frac{m}{(m-1)^2}+\\frac{2}{m-1}&=\\frac{m+2(m-1)}{(m-1)^2}\\\\\\frac{m}{(m-1)^2}+\\frac{2}{m-1}&=\\frac{m+2m-2}{(m-1)^2}\\\\\\frac{m}{(m-1)^2}+\\frac{2}{m-1}&=\\frac{3m-2}{(m-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{a}{(a-2)^2}-\\frac{3}{a-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6-2a}{(a-2)^2}$",
          "worked": "$$\\begin{align*}\\frac{a}{(a-2)^2}-\\frac{3}{a-2}&=\\frac{a-3(a-2)}{(a-2)^2}\\\\\\frac{a}{(a-2)^2}-\\frac{3}{a-2}&=\\frac{a-3a+6}{(a-2)^2}\\\\\\frac{a}{(a-2)^2}-\\frac{3}{a-2}&=\\frac{6-2a}{(a-2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{x+3}{x+2}+\\frac{x+2}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x^2+4x-5}{(x+2)(x-3)}$\n\nUse the common denominator $(x+2)(x-3)$ and expand the numerator.",
          "worked": "$$\\begin{align*}\\frac{x+3}{x+2}+\\frac{x+2}{x-3}&=\\frac{(x+3)(x-3)+(x+2)^2}{(x+2)(x-3)}\\\\\\frac{x+3}{x+2}+\\frac{x+2}{x-3}&=\\frac{x^2-9+x^2+4x+4}{(x+2)(x-3)}\\\\\\frac{x+3}{x+2}+\\frac{x+2}{x-3}&=\\frac{2x^2+4x-5}{(x+2)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q3-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac{1}{(a+1)(a+2)}+\\frac{2}{(a+2)(a+3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3a+5}{(a+1)(a+2)(a+3)}$\n\nInclude the shared factor $a+2$ once in the common denominator.",
          "worked": "$$\\begin{align*}\\frac{1}{(a+1)(a+2)}+\\frac{2}{(a+2)(a+3)}&=\\frac{a+3+2(a+1)}{(a+1)(a+2)(a+3)}\\\\\\frac{1}{(a+1)(a+2)}+\\frac{2}{(a+2)(a+3)}&=\\frac{a+3+2a+2}{(a+1)(a+2)(a+3)}\\\\\\frac{1}{(a+1)(a+2)}+\\frac{2}{(a+2)(a+3)}&=\\frac{3a+5}{(a+1)(a+2)(a+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q3-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{2}{(c+1)(c-3)}-\\frac{3}{(c-3)(c-2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{c+7}{(c+1)(c-3)(c-2)}$\n\nUse each denominator factor once and subtract the entire second numerator.",
          "worked": "$$\\begin{align*}\\frac{2}{(c+1)(c-3)}-\\frac{3}{(c-3)(c-2)}&=\\frac{2(c-2)-3(c+1)}{(c+1)(c-3)(c-2)}\\\\\\frac{2}{(c+1)(c-3)}-\\frac{3}{(c-3)(c-2)}&=\\frac{2c-4-3c-3}{(c+1)(c-3)(c-2)}\\\\\\frac{2}{(c+1)(c-3)}-\\frac{3}{(c-3)(c-2)}&=-\\frac{c+7}{(c+1)(c-3)(c-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
