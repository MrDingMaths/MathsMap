  "content": {
    "id": "p2-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A line passes through the points $(2, 4)$ and $(5, 6)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of the line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{3}$",
          "worked": "$$\\begin{align*}m&=\\frac{6-4}{5-2}\\\\m&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p2-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation of the line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2}{3}x+\\dfrac{8}{3}$",
          "worked": "Using $y=mx+c$ with $m=\\frac{2}{3}$ and the point $(2,4)$:\n$$\\begin{align*}4&=\\frac{2}{3}\\times2+c\\\\c&=4-\\frac{4}{3}\\\\c&=\\frac{8}{3}\\end{align*}$$\nTherefore $y=\\frac{2}{3}x+\\frac{8}{3}$, or $3y-2x=8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
