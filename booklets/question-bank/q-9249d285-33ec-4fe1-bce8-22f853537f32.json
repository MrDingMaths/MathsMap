  "content": {
    "id": "v2-4fd080-p4-midpoint-slot-1-2-root",
    "type": "question",
    "label": null,
    "prompt": "Find the coordinates of point $P$ that divides $A(-7,2)$ and $B(5,-6)$ in the ratio $3:1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P(2,-4)$\n\nMove three quarters of each coordinate difference from A towards B.",
      "worked": "$P$ is three quarters of the distance from $A$ to $B$.\n$$\\begin{align*}x_P &= -7+\\frac{3}{4}\\bigl(5-(-7)\\bigr)\\\\x_P &= 2\\\\y_P &= 2+\\frac{3}{4}(-6-2)\\\\y_P &= -4\\end{align*}$$\n$P(2,-4)$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
