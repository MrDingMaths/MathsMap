  "content": {
    "id": "p40-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Two numbers are chosen uniformly from an interval of length 10. Find the probability that they are no more than 2 units apart.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p40-q5-short-result",
            "type": "paragraph",
