  "content": {
    "id": "p11-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The $n$th term of an arithmetic sequence is $a_n=7+4n$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Write out the first four terms, and hence find the values of $a$ and $d$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11,15,19,23$; $a=11$, $d=4$.",
          "worked": "$$\\begin{align*}a_1&=7+4(1)=11\\\\a_2&=7+4(2)=15\\\\a_3&=7+4(3)=19\\\\a_4&=7+4(4)=23\\end{align*}$$\nThus $a=11$ and $d=15-11=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Which term of the sequence is 815?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The $202$nd term.",
          "worked": "$$\\begin{align*}a_n&=815\\\\7+4n&=815\\\\4n&=808\\\\n&=202\\end{align*}$$\n815 is the $202$nd term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p11-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the last term less than 1000 and the first term greater than 1000.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "999 and 1003, respectively.",
          "worked": "$$\\begin{align*}a_n&<1000\\\\7+4n&<1000\\\\4n&<993\\\\n&<248.25\\end{align*}$$\nThe last integer index below $248.25$ is $248$.\n$$\\begin{align*}a_{248}&=7+4(248)=999\\\\a_{249}&=7+4(249)=1003\\end{align*}$$\nThe last term less than 1000 is 999, and the first term greater than 1000 is 1003.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p11-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "Find how many terms there are between 200 and 300.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "25 terms.",
          "worked": "$$\\begin{align*}200&<a_n<300\\\\200&<7+4n<300\\\\193&<4n<293\\\\48.25&<n<73.25\\end{align*}$$\nThus $a_{49},\\ldots,a_{73}$ lie between 200 and 300.\n$$\\text{Number of terms}=73-49+1=25.$$\nThere are 25 terms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
