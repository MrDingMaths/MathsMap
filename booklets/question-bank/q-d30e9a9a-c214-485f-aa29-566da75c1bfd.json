  "content": {
    "id": "p26-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Think of a number. Let this number be $x$.\n\nWrite the following using algebra to see what you get.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Multiply the number you thought of by 2 and subtract 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x-5$",
          "worked": "$2\\times x-5=2x-5$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Multiply the result by 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(2x-5)=6x-15$",
          "worked": "$$\\begin{align*}3(2x-5)&=3\\times2x-3\\times5\\\\3(2x-5)&=6x-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p26-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Add 15.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x$",
          "worked": "$6x-15+15=6x$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Subtract 5 times the number you first thought of. What is the final answer? Why is it so?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$, the original number.\n\nThe constant terms cancel, leaving $6x-5x=x$.",
          "worked": "$6x-5x=x$.\n\nThe subtraction and addition of 15 cancel. This leaves six times the original number; subtracting five times that number leaves the original number, $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
