  "content": {
    "id": "p9-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If $y=\\ln(\\tan 2x)$, show that $\\dfrac{dy}{dx}=2\\sec 2x\\operatorname{cosec}2x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{dy}{dx}=2\\sec 2x\\operatorname{cosec}2x$.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\left(\\frac{1}{\\tan 2x}\\right)\\times\\sec^2 2x\\times 2\\\\&=\\frac{2\\sec^2 2x}{\\tan 2x}\\\\&=\\frac{2\\sec^2 2x}{\\left(\\dfrac{\\sin 2x}{\\cos 2x}\\right)}\\\\&=\\frac{2\\sec^2 2x\\times\\cos 2x}{\\sin 2x}\\\\&=\\frac{2\\sec 2x}{\\sin 2x}\\\\&=2\\sec 2x\\operatorname{cosec}2x\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 50
  },
