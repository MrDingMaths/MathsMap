  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Rearrange each of these formulas to make the pronumeral in brackets the subject. (All of the pronumerals represent positive numbers.)",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\ell\\times w\\qquad(\\ell)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ell=\\dfrac{A}{w}$",
          "worked": "$$\\begin{align*}A&=\\ell w\\\\\\frac{A}{w}&=\\ell\\\\\\ell&=\\frac{A}{w}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$C=2\\pi r\\qquad(r)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\dfrac{C}{2\\pi}$",
          "worked": "$$\\begin{align*}C&=2\\pi r\\\\\\frac{C}{2\\pi}&=r\\\\r&=\\frac{C}{2\\pi}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$V=\\pi r^2h\\qquad(h)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\dfrac{V}{\\pi r^2}$",
          "worked": "$$\\begin{align*}V&=\\pi r^2h\\\\\\frac{V}{\\pi r^2}&=h\\\\h&=\\frac{V}{\\pi r^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$A=2h(\\ell+b)\\qquad(b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\dfrac{A}{2h}-\\ell$",
          "worked": "$$\\begin{align*}A&=2h(\\ell+b)\\\\\\frac{A}{2h}&=\\ell+b\\\\\\frac{A}{2h}-\\ell&=b\\\\b&=\\frac{A}{2h}-\\ell\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$A=4\\pi r^2\\qquad(r)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\sqrt{\\dfrac{A}{4\\pi}}$",
          "worked": "$$\\begin{align*}A&=4\\pi r^2\\\\\\frac{A}{4\\pi}&=r^2\\\\r&=\\sqrt{\\frac{A}{4\\pi}}\\end{align*}$$\nTake the positive square root because $r$ is positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$w=10\\sqrt{\\dfrac{x}{a}}\\qquad(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{aw^2}{100}$",
          "worked": "$$\\begin{align*}w&=10\\sqrt{\\frac{x}{a}}\\\\\\frac{w}{10}&=\\sqrt{\\frac{x}{a}}\\\\\\frac{w^2}{100}&=\\frac{x}{a}\\\\x&=\\frac{aw^2}{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$w=\\sqrt{\\dfrac{3V}{\\pi h}}\\qquad(V)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=\\dfrac{w^2\\pi h}{3}$",
          "worked": "$$\\begin{align*}w&=\\sqrt{\\frac{3V}{\\pi h}}\\\\w^2&=\\frac{3V}{\\pi h}\\\\\\pi hw^2&=3V\\\\V&=\\frac{w^2\\pi h}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{1}{x}+\\dfrac{1}{y}=\\dfrac{2}{z}\\qquad(y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{xz}{2x-z}$\n\nIsolate $\\frac{1}{y}$, combine the fractions, then take reciprocals.",
          "worked": "$$\\begin{align*}\\frac{1}{x}+\\frac{1}{y}&=\\frac{2}{z}\\\\\\frac{1}{y}&=\\frac{2}{z}-\\frac{1}{x}\\\\\\frac{1}{y}&=\\frac{2x-z}{xz}\\\\y&=\\frac{xz}{2x-z}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
