  "content": {
    "id": "v2-1479f-p27-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "A circle with centre $(1,-2)$ has diameter $AB$, where $A=(-3,4)$. Find the coordinates of $B$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$B=(5,-8)$",
      "worked": "The centre is the midpoint of $AB$. Let $B=(x,y)$.\n$$\\begin{align*}\\frac{-3+x}{2}&=1\\\\-3+x&=2\\\\x&=5\\end{align*}$$\n$$\\begin{align*}\\frac{4+y}{2}&=-2\\\\4+y&=-4\\\\y&=-8\\end{align*}$$\nHence $B=(5,-8)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
