        "id": "p29-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3x^3+1$ where $x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36x-y-47=0$",
          "worked": "Point of tangency:\n$$\\begin{align*}y_1&=3(2)^3+1\\\\&=25\\end{align*}$$\nGradient function and tangent gradient:\n$$\\begin{align*}\\frac{dy}{dx}&=9x^2\\\\m&=9(2)^2\\\\&=36\\end{align*}$$\nEquation of the tangent:\n$$\\begin{align*}y-25&=36(x-2)\\\\y-25&=36x-72\\\\y&=36x-47\\\\36x-y-47&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p29-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$v=4t^4-7t^3-2$ where $t=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$44t-v-82=0$",
          "worked": "Point of tangency:\n$$\\begin{align*}v_1&=4(2)^4-7(2)^3-2\\\\&=64-56-2\\\\&=6\\end{align*}$$\nGradient function and tangent gradient:\n$$\\begin{align*}\\frac{dv}{dt}&=16t^3-21t^2\\\\m&=16(2)^3-21(2)^2\\\\&=44\\end{align*}$$\nEquation of the tangent:\n$$\\begin{align*}v-6&=44(t-2)\\\\v-6&=44t-88\\\\v&=44t-82\\\\44t-v-82&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
