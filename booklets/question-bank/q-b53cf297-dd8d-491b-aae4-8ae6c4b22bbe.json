    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2}{x+1}+\\frac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x+5}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x+1}+\\frac{1}{x+2}&=\\frac{2(x+2)+(x+1)}{(x+1)(x+2)}\\\\\\frac{2}{x+1}+\\frac{1}{x+2}&=\\frac{2x+4+x+1}{(x+1)(x+2)}\\\\\\frac{2}{x+1}+\\frac{1}{x+2}&=\\frac{3x+5}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3}{x+4}+\\frac{2}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5(x+1)}{(x+4)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+4}+\\frac{2}{x-1}&=\\frac{3(x-1)+2(x+4)}{(x+4)(x-1)}\\\\\\frac{3}{x+4}+\\frac{2}{x-1}&=\\frac{3x-3+2x+8}{(x+4)(x-1)}\\\\\\frac{3}{x+4}+\\frac{2}{x-1}&=\\frac{5x+5}{(x+4)(x-1)}\\\\\\frac{3}{x+4}+\\frac{2}{x-1}&=\\frac{5(x+1)}{(x+4)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{5}{x+3}+\\frac{4}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9x+2}{(x+3)(x-2)}$",
          "worked": "$$\\begin{align*}\\frac{5}{x+3}+\\frac{4}{x-2}&=\\frac{5(x-2)+4(x+3)}{(x+3)(x-2)}\\\\\\frac{5}{x+3}+\\frac{4}{x-2}&=\\frac{5x-10+4x+12}{(x+3)(x-2)}\\\\\\frac{5}{x+3}+\\frac{4}{x-2}&=\\frac{9x+2}{(x+3)(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{x+1}-\\frac{2}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+7}{(x+1)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+1}-\\frac{2}{x+3}&=\\frac{3(x+3)-2(x+1)}{(x+1)(x+3)}\\\\\\frac{3}{x+1}-\\frac{2}{x+3}&=\\frac{3x+9-2x-2}{(x+1)(x+3)}\\\\\\frac{3}{x+1}-\\frac{2}{x+3}&=\\frac{x+7}{(x+1)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{7}{x+2}-\\frac{4}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3(x-5)}{(x+2)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{7}{x+2}-\\frac{4}{x-1}&=\\frac{7(x-1)-4(x+2)}{(x+2)(x-1)}\\\\\\frac{7}{x+2}-\\frac{4}{x-1}&=\\frac{7x-7-4x-8}{(x+2)(x-1)}\\\\\\frac{7}{x+2}-\\frac{4}{x-1}&=\\frac{3x-15}{(x+2)(x-1)}\\\\\\frac{7}{x+2}-\\frac{4}{x-1}&=\\frac{3(x-5)}{(x+2)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p12-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{3}{2x-1}-\\frac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+7}{(2x-1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{3}{2x-1}-\\frac{1}{x+2}&=\\frac{3(x+2)-(2x-1)}{(2x-1)(x+2)}\\\\\\frac{3}{2x-1}-\\frac{1}{x+2}&=\\frac{3x+6-2x+1}{(2x-1)(x+2)}\\\\\\frac{3}{2x-1}-\\frac{1}{x+2}&=\\frac{x+7}{(2x-1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{2}{2a+1}+\\frac{3}{a-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8a-5}{(2a+1)(a-4)}$",
          "worked": "$$\\begin{align*}\\frac{2}{2a+1}+\\frac{3}{a-4}&=\\frac{2(a-4)+3(2a+1)}{(2a+1)(a-4)}\\\\\\frac{2}{2a+1}+\\frac{3}{a-4}&=\\frac{2a-8+6a+3}{(2a+1)(a-4)}\\\\\\frac{2}{2a+1}+\\frac{3}{a-4}&=\\frac{8a-5}{(2a+1)(a-4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{4}{b+3}-\\frac{2}{2b-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(3b-5)}{(b+3)(2b-1)}$",
          "worked": "$$\\begin{align*}\\frac{4}{b+3}-\\frac{2}{2b-1}&=\\frac{4(2b-1)-2(b+3)}{(b+3)(2b-1)}\\\\\\frac{4}{b+3}-\\frac{2}{2b-1}&=\\frac{8b-4-2b-6}{(b+3)(2b-1)}\\\\\\frac{4}{b+3}-\\frac{2}{2b-1}&=\\frac{6b-10}{(b+3)(2b-1)}\\\\\\frac{4}{b+3}-\\frac{2}{2b-1}&=\\frac{2(3b-5)}{(b+3)(2b-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p12-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{4}{b-1}-\\frac{3}{1-2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11b-7}{(b-1)(2b-1)}$\n\nUse $1-2b=-(2b-1)$ before combining the fractions.",
          "worked": "Since $1-2b=-(2b-1)$,\n$$\\begin{align*}\\frac{4}{b-1}-\\frac{3}{1-2b}&=\\frac{4}{b-1}+\\frac{3}{2b-1}\\\\\\frac{4}{b-1}-\\frac{3}{1-2b}&=\\frac{4(2b-1)+3(b-1)}{(b-1)(2b-1)}\\\\\\frac{4}{b-1}-\\frac{3}{1-2b}&=\\frac{8b-4+3b-3}{(b-1)(2b-1)}\\\\\\frac{4}{b-1}-\\frac{3}{1-2b}&=\\frac{11b-7}{(b-1)(2b-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      }
    ]
