  "content": {
    "id": "p23-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "If three pens and two pencils cost $\\$13$, and four pens and three pencils cost $\\$18$, then what is the price of each pen and each pencil?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Each pen costs $\\$3$ and each pencil costs $\\$2$.",
      "worked": "Let $p$ and $c$ be the prices in dollars of one pen and one pencil.\n$$\\begin{align*}3p+2c&=13\\\\4p+3c&=18\\\\9p+6c&=39\\\\8p+6c&=36\\\\p&=3\\\\3(3)+2c&=13\\\\2c&=4\\\\c&=2\\end{align*}$$\nThe third and fourth equations are three times the first and twice the second; subtracting eliminates $c$. Each pen costs $\\$3$ and each pencil costs $\\$2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 92
  },
