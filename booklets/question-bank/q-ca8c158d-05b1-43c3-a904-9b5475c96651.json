  "content": {
    "id": "index-t7-q17-root",
    "type": "question",
    "label": null,
    "prompt": "Read the example carefully and answer the questions.\n\nLiz’s work: Write as an expression without brackets.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t7-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "In the step marked with an arrow, why did Liz add instead of multiply?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "index-doc-1096",
            "role": "question",
            "format": "image",
            "code": null,
            "src": "/booklet-assets/projects/index-laws-complete-v1/885cd39faa74-image43.png",
            "widthMm": 63.04138888888889,
            "alt": "Source mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "sourceRegion": {
              "x": 0,
              "y": 0,
              "width": 575,
              "height": 456,
              "sourceWidth": 575,
              "sourceHeight": 456
            },
            "derived": false
          }
        ],
        "children": [],
        "answer": {
          "short": "She is multiplying powers with the same base.",
          "worked": "After expanding the power, Liz has $b^3\\times b^8$. The index law of multiplication gives $b^{3+8}=b^{11}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t7-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $(r^5)^2r^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r^{13}$",
          "worked": "$$\\begin{align*}(r^5)^2r^3&=r^{10}\\times r^3 \\\\ &=r^{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
