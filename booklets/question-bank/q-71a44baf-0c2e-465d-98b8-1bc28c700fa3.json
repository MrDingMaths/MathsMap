  "content": {
    "id": "p69-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Write an equation to represent these scenarios.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p69-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Each class has the same number ($x$) of students in it. There are six classes with a total of 132 students.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x=132$",
          "worked": "Six classes with $x$ students each contain $6x$ students altogether.\n$$6x=132$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p69-q8-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "d0e07784-88b8-4ab4-bf32-0f2c48b7490c",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.2,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "12 students shared ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "b",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " books equally. ",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Each student received 9 books.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b}{12}=9$",
          "worked": "Sharing $b$ books equally among 12 students gives $\\frac{b}{12}$ books per student.\n$$\\frac{b}{12}=9$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p69-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Ronnie has a number of basketball cards ($r$). The number of basketball cards Mick has ($m$) is 4 more than Ronnie.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=r+4$",
          "worked": "Mick has 4 more cards than Ronnie, so add 4 to $r$.\n$$m=r+4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p69-q8-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "ba3bda81-5e8e-456d-ba2c-88b15403c3e2",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.2,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "There are ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "p",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " lollies in a bag. Gilbert bought 7 bags and ate 5 lollies. ",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "He then has 128 lollies left.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7p-5=128$",
          "worked": "Seven bags contain $7p$ lollies. Eating 5 leaves $7p-5$ lollies.\n$$7p-5=128$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p69-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "Lola placed $c$ cookies on a tray for baking. Charlie added four more cookies to Lola’s tray. They then tripled the number of cookies to make 33 cookies.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(c+4)=33$",
          "worked": "Adding four cookies gives $c+4$. Tripling this entire quantity gives $3(c+4)$.\n$$3(c+4)=33$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p69-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "Simon had $d$ stickers, he took 4 for himself before sharing the rest between 3 friends. Each friend got 9 stickers each.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d-4}{3}=9$",
          "worked": "Taking 4 stickers leaves $d-4$. Sharing the remainder equally among 3 friends gives $\\frac{d-4}{3}$ stickers per friend.\n$$\\frac{d-4}{3}=9$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
