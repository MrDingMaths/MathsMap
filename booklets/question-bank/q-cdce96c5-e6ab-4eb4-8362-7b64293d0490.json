        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11x+41}{12}$",
          "worked": "$\\begin{aligned}\\frac{2x+5}{3}+\\frac{x+7}{4}&=\\frac{4(2x+5)}{12}+\\frac{3(x+7)}{12}\\\\&=\\frac{8x+20+3x+21}{12}\\\\&=\\frac{11x+41}{12}\\end{aligned}$",
