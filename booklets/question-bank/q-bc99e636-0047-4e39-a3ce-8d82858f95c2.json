    "type": "question",
    "label": "2",
    "prompt": "Express $x^4+3x-5$ in the form $(x+1)Q(x)+R(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x+1)(x^3-x^2+x+2)-7$",
      "worked": "$$\\begin{align*}(x^4+0x^3+0x^2+3x-5)-x^3(x+1)&=-x^3+3x-5\\\\(-x^3+0x^2+3x-5)-(-x^2)(x+1)&=x^2+3x-5\\\\(x^2+3x-5)-x(x+1)&=2x-5\\\\(2x-5)-2(x+1)&=-7\\\\x^4+3x-5&=(x+1)(x^3-x^2+x+2)-7\\end{align*}$$",
      "solutionDiagrams": []
    },
