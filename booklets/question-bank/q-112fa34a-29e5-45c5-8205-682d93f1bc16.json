        "id": "index-t10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\begin{aligned}&\\frac{(v^3x)^3}{(v^2x^2)^4}\\\\[2mm]&\\textcolor{#268cff}{=\\frac{v^9x^3}{v^8x^8}\\quad\\boxed{\\text{Expand}}}\\\\[2mm]&\\textcolor{#268cff}{=\\frac{v}{x^5}\\quad\\boxed{\\text{Simplify}}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac v{x^5}$",
          "worked": "Given worked example: $\\frac v{x^5}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "index-t10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\begin{aligned}\\frac{(a^5b^2)^4}{(a^2b^3)^2}&=\\frac{a^{\\boxed{\\rule{0pt}{3mm}\\hspace{4mm}}}b^{\\boxed{\\rule{0pt}{3mm}\\hspace{4mm}}}}{a^{\\boxed{\\rule{0pt}{3mm}\\hspace{4mm}}}b^{\\boxed{\\rule{0pt}{3mm}\\hspace{4mm}}}}\\\\[2mm]&=\\boxed{\\rule{0pt}{4mm}\\hspace{12mm}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Exponents: $20,8;4,6$. Result: $a^{16}b^2$.",
          "worked": "$$\\begin{align*}\\frac{(a^5b^2)^4}{(a^2b^3)^2}&=\\frac{a^{20}b^8}{a^4b^6} \\\\ &=a^{16}b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "index-t10-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\begin{aligned}\\frac{(n^2a^3)^2}{(n^3a^2)^3}&=\\frac{n^{\\boxed{\\rule{0pt}{3mm}\\hspace{4mm}}}a^{\\boxed{\\rule{0pt}{3mm}\\hspace{4mm}}}}{n^{\\boxed{\\rule{0pt}{3mm}\\hspace{4mm}}}a^{\\boxed{\\rule{0pt}{3mm}\\hspace{4mm}}}}\\\\[2mm]&=\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Exponents: $4,6;9,6$. Result: $\\frac1{n^5}$.",
          "worked": "$$\\begin{align*}\\frac{(n^2a^3)^2}{(n^3a^2)^3}&=\\frac{n^4a^6}{n^9a^6} \\\\ &=\\frac1{n^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
