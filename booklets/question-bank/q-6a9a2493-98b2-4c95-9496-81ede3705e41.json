    "type": "question",
    "label": "11",
    "prompt": "A company made a profit of \\$194 000 for the year. The owner decided to share 60% of the profit between her 80 employees as a bonus. Calculate the bonus paid to each employee.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$1455 each; divide 60% of the profit by 80.",
      "worked": "$$\\begin{align*}\\text{Total bonuses} &= 194\\,000\\times0.60 = \\$116\\,400\\\\\\text{Bonus per employee} &= 116\\,400\\div80 = \\$1455\\end{align*}$$",
