                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{3}{4}\\div\\frac{7}{12}&=\\frac{3}{4}\\times\\frac{12}{7}\\\\&=\\frac{3}{\\underset{1}{\\cancel{4}}}\\times\\frac{\\overset{3}{\\cancel{12}}}{7}\\\\&=\\frac{9}{7}\\end{aligned}",
