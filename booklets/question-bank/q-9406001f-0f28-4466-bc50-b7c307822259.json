    "children": [
      {
        "id": "p37-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sqrt{45}}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{5}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{45}}{3}&=\\frac{\\sqrt{9}\\sqrt{5}}{3}\\\\&=\\frac{3\\sqrt{5}}{3}\\\\&=\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sqrt{24}}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{6}}{2}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{24}}{4}&=\\frac{\\sqrt{4}\\sqrt{6}}{4}\\\\&=\\frac{2\\sqrt{6}}{4}\\\\&=\\frac{\\sqrt{6}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\sqrt{80}}{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{5}}{5}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{80}}{20}&=\\frac{\\sqrt{16}\\sqrt{5}}{20}\\\\&=\\frac{4\\sqrt{5}}{20}\\\\&=\\frac{\\sqrt{5}}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sqrt{99}}{18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{11}}{6}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{99}}{18}&=\\frac{\\sqrt{9}\\sqrt{11}}{18}\\\\&=\\frac{3\\sqrt{11}}{18}\\\\&=\\frac{\\sqrt{11}}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3\\sqrt{44}}{2}$",
