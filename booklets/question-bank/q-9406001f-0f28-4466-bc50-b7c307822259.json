        "children": [],
        "answer": {
          "short": "$3\\sqrt{11}$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt{44}}{2}&=\\frac{3\\sqrt{4}\\sqrt{11}}{2}\\\\&=\\frac{6\\sqrt{11}}{2}\\\\&=3\\sqrt{11}\\end{align*}$$",
          "solutionDiagrams": []
