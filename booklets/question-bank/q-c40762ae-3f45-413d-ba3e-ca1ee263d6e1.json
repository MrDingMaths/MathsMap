  "content": {
    "id": "p35-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Suppose that $\\underset{\\sim}{a}=2i+3j$ and $\\underset{\\sim}{b}=i-4j$. Find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}+\\underset{\\sim}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3i-j$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}+\\underset{\\sim}{b}&=(2+1)i+(3-4)j\\\\&=3i-j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p35-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$|\\underset{\\sim}{a}+\\underset{\\sim}{b}|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{10}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}+\\underset{\\sim}{b}&=3i-j\\\\|\\underset{\\sim}{a}+\\underset{\\sim}{b}|&=\\sqrt{3^2+(-1)^2}\\\\&=\\sqrt{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p35-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{a}-\\underset{\\sim}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$i+7j$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}-\\underset{\\sim}{b}&=(2-1)i+(3-(-4))j\\\\&=i+7j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p35-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$|\\underset{\\sim}{a}-\\underset{\\sim}{b}|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt{2}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}-\\underset{\\sim}{b}&=i+7j\\\\|\\underset{\\sim}{a}-\\underset{\\sim}{b}|&=\\sqrt{1^2+7^2}\\\\&=5\\sqrt{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p35-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$-3\\underset{\\sim}{a}-2\\underset{\\sim}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8i-j$",
          "worked": "$$\\begin{aligned}-3\\underset{\\sim}{a}-2\\underset{\\sim}{b}&=-3(2i+3j)\\\\&\\quad-2(i-4j)\\\\&=-6i-9j-2i+8j\\\\&=-8i-j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p35-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$|-3\\underset{\\sim}{a}-2\\underset{\\sim}{b}|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{65}$",
          "worked": "$$\\begin{aligned}-3\\underset{\\sim}{a}-2\\underset{\\sim}{b}&=-8i-j\\\\|-3\\underset{\\sim}{a}-2\\underset{\\sim}{b}|&=\\sqrt{(-8)^2+(-1)^2}\\\\&=\\sqrt{65}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
