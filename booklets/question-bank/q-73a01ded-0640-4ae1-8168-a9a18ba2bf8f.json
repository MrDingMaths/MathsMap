    "children": [
      {
        "id": "p40-q45-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $$\\binom{n}{r}=\\binom{n+1}{r+1}-\\binom{n}{r+1}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The right-hand side simplifies to $\\dfrac{n!}{r!(n-r)!}=\\binom{n}{r}$.\n\nExpand both combinations into factorials and use a common denominator.",
          "worked": "$$\\begin{align*}\\binom{n+1}{r+1}-\\binom{n}{r+1}&=\\frac{(n+1)!}{(r+1)!(n-r)!}-\\frac{n!}{(r+1)!(n-r-1)!}\\\\\\binom{n+1}{r+1}-\\binom{n}{r+1}&=\\frac{(n+1)n!-(n-r)n!}{(r+1)!(n-r)!}\\\\\\binom{n+1}{r+1}-\\binom{n}{r+1}&=\\frac{(r+1)n!}{(r+1)!(n-r)!}\\\\\\binom{n+1}{r+1}-\\binom{n}{r+1}&=\\frac{n!}{r!(n-r)!}\\\\\\binom{n+1}{r+1}-\\binom{n}{r+1}&=\\binom{n}{r}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      },
      {
        "id": "p40-q45-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find integers $a$ and $b$ such that $$\\binom{5}{5}+\\binom{6}{5}+\\binom{7}{5}+\\cdots+\\binom{15}{5}=\\binom{a}{b}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=16$, $b=6$.\n\nUse part (a) with $r=5$; the intermediate terms cancel.",
          "worked": "Let $S=\\binom{5}{5}+\\binom{6}{5}+\\cdots+\\binom{15}{5}$. Using part (a) with $r=5$ and $\\binom{5}{5}=\\binom{6}{6}=1$, $$\\begin{align*}S&=\\binom{6}{6}+\\left[\\binom{7}{6}-\\binom{6}{6}\\right]+\\left[\\binom{8}{6}-\\binom{7}{6}\\right]+\\cdots+\\left[\\binom{16}{6}-\\binom{15}{6}\\right]\\\\S&=\\binom{16}{6}.\\end{align*}$$ Thus $a=16$ and $b=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
