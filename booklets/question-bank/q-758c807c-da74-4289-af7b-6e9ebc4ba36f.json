  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Solve each of the following equations by performing the same operation on each side:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+3=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}x+3-3&=7-3\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x+15=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-11$",
          "worked": "$$\\begin{align*}x+15-15&=4-15\\\\x&=-11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x-5=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$",
          "worked": "$$\\begin{align*}x-5+5&=2+5\\\\x&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x-9=-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}x-9+9&=-5+9\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x}{3}=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=18$",
          "worked": "$$\\begin{align*}3\\times\\frac{x}{3}&=3\\times6\\\\x&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x}{5}=-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-30$",
          "worked": "$$\\begin{align*}5\\times\\frac{x}{5}&=5\\times(-6)\\\\x&=-30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$2x=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}\\frac{2x}{2}&=\\frac{8}{2}\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$3x=-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac{7}{3}$",
          "worked": "$$\\begin{align*}\\frac{3x}{3}&=\\frac{-7}{3}\\\\x&=-\\frac{7}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$-x+2=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$$\\begin{align*}-x+2+x&=3+x\\\\2&=3+x\\\\x+3&=2\\\\x+3-3&=2-3\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$-2x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac{3}{2}$",
          "worked": "$$\\begin{align*}\\frac{-2x}{-2}&=\\frac{3}{-2}\\\\x&=-\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$3-x=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-9$",
          "worked": "$$\\begin{align*}3-x+x&=12+x\\\\3&=12+x\\\\x+12&=3\\\\x+12-12&=3-12\\\\x&=-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$-7-x=-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$",
          "worked": "$$\\begin{align*}-7-x+x&=-3+x\\\\-7&=-3+x\\\\x-3&=-7\\\\x-3+3&=-7+3\\\\x&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
