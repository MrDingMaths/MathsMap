    "questionDiagrams": [],
    "children": [
      {
        "id": "p126-task43-48-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\lvert 4x+1\\rvert=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{3}{2}$ or $x=-2$.",
          "worked": "$$\\begin{align*}4x+1&=\\pm7\\\\4x&=-1\\pm7\\\\x&=\\frac{3}{2}\\quad\\text{or}\\quad x=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p126-task43-48-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\lvert x-2\\rvert=-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "Since $\\lvert x-2\\rvert\\ge0$, it cannot equal $-3$. There is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p126-task43-48-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\lvert -2x+5\\rvert=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=7$.",
          "worked": "$$\\begin{align*}-2x+5&=\\pm9\\\\-2x&=-5\\pm9\\\\x&=-2\\quad\\text{or}\\quad x=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p126-task43-48-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\lvert 5-2x\\rvert=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{5}{2}$.",
          "worked": "An absolute value is zero only when its argument is zero.\n\n$$\\begin{align*}5-2x&=0\\\\-2x&=-5\\\\x&=\\frac{5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p126-task43-48-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\lvert 2-3x\\rvert=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "Since $\\lvert 2-3x\\rvert\\ge0$, it cannot equal $-4$. There is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p126-task43-48-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left\\lvert\\dfrac{1-2x}{3}\\right\\rvert=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p126-task43-48-f-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x=-\\dfrac{5}{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " or ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=\\dfrac{7}{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p126-task43-48-f-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Set the fraction equal to ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\pm2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and solve both cases.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{1-2x}{3}&=\\pm2\\\\1-2x&=\\pm6\\\\-2x&=-1\\pm6\\\\x&=-\\frac{5}{2}\\quad\\text{or}\\quad x=\\frac{7}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
