    "answer": {
      "short": "$64^{\\frac{1}{2}}=8$, $64^{\\frac{1}{3}}=4$, $64^{\\frac{1}{6}}=2$, $64^0=1$.",
      "worked": "$$\\begin{aligned}64^{1/2}&=\\sqrt{64}=8\\\\64^{1/3}&=\\sqrt[3]{64}=4\\\\64^{1/6}&=\\sqrt[6]{64}=2\\\\64^0&=1\\end{aligned}$$",
      "solutionDiagrams": []
    },
