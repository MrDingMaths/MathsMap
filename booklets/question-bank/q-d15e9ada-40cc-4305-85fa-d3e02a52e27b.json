        "id": "p15-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Name the two triangles formed.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\triangle ACM$ and $\\triangle BCM$.",
          "worked": "The two triangles are $\\triangle ACM$ and $\\triangle BCM$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Will the two triangles be congruent? Give reasons.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, by SSS: $AC=BC$, $AM=BM$, and $CM$ is common.",
          "worked": "$AC=BC$ because $ABC$ is isosceles.\n\n$AM=BM$ because $M$ is the midpoint of $AB$.\n\n$CM$ is a common side.\n\nTherefore $\\triangle ACM\\equiv\\triangle BCM$ by SSS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
