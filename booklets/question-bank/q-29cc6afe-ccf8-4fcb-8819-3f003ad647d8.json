  "content": {
    "id": "p11-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Use $y-y_1=m(x-x_1)$ to find the equation of these lines in gradient-intercept form.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q1-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q1-a-given",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "(3,2)",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "m=4",
                  "display": false
                }
              ]
            },
            {
              "id": "p11-q1-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-2&=4(x-3)\\end{aligned}",
                  "display": true,
                  "colour": "#268cff"
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4x-10$",
          "worked": "$$\\begin{aligned}y-2&=4(x-3)\\\\y-2&=4x-12\\\\y&=4x-10\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(4,-1)$ and $m=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x+3$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y+1&=-(x-4)\\\\y+1&=-x+4\\\\y&=-x+3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(-7,2)$ and $m=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{x}{2}+\\frac{11}{2}$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-2&=\\frac12(x+7)\\\\y-2&=\\frac{x}{2}+\\frac72\\\\y&=\\frac{x}{2}+\\frac{11}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p11-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2,5)$ and $m=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+1$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-5&=2(x-2)\\\\y-5&=2x-4\\\\y&=2x+1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-6,4)$ and $m=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x-2$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-4&=-(x+6)\\\\y-4&=-x-6\\\\y&=-x-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(3,-8)$ and $m=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4x-20$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y+8&=4(x-3)\\\\y+8&=4x-12\\\\y&=4x-20\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
