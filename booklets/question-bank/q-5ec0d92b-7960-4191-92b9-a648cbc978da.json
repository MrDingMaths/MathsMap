  "content": {
    "id": "p2-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Show that these points lie on the graph of $y=x^2$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2=4$",
          "worked": "$$2^2=4.$$ This equals the $y$-coordinate, so the point lies on the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p2-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-10,100)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-10)^2=100$",
          "worked": "$$(-10)^2=100.$$ This equals the $y$-coordinate, so the point lies on the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p2-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac12,\\frac14\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac12\\right)^2=\\frac14$",
          "worked": "$$\\left(\\frac12\\right)^2=\\frac14.$$ This equals the $y$-coordinate, so the point lies on the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(-\\frac13,\\frac19\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac13\\right)^2=\\frac19$",
          "worked": "$$\\left(-\\frac13\\right)^2=\\frac19.$$ This equals the $y$-coordinate, so the point lies on the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt2,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sqrt2)^2=2$",
          "worked": "$$(\\sqrt2)^2=2.$$ This equals the $y$-coordinate, so the point lies on the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p2-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac1{\\sqrt3},\\frac13\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac1{\\sqrt3}\\right)^2=\\frac13$",
          "worked": "$$\\left(\\frac1{\\sqrt3}\\right)^2=\\frac13.$$ This equals the $y$-coordinate, so the point lies on the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(3\\sqrt3,27)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3\\sqrt3)^2=27$",
          "worked": "$$\\begin{align*}(3\\sqrt3)^2&=9\\times3\\\\(3\\sqrt3)^2&=27.\\end{align*}$$ This equals the $y$-coordinate, so the point lies on the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p2-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(-\\frac{\\sqrt2}{2},\\frac12\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac{\\sqrt2}{2}\\right)^2=\\frac24=\\frac12$",
          "worked": "$$\\begin{align*}\\left(-\\frac{\\sqrt2}{2}\\right)^2&=\\frac24\\\\\\left(-\\frac{\\sqrt2}{2}\\right)^2&=\\frac12.\\end{align*}$$ This equals the $y$-coordinate, so the point lies on the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
