        "id": "p6-q30-responses",
        "type": "group",
        "label": "",
        "prompt": "Find the value(s) of $k$ for which $y=k$ intersects $x^2+y^2=1$:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q30-a",
            "type": "part",
            "label": "a",
            "prompt": "twice.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1<k<1$",
              "worked": "Compare the horizontal line $y=k$ with the circle's lowest and highest points, at $y=-1$ and $y=1$. Strictly between these heights, the line crosses the circle twice.\n\n$$-1<k<1$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p6-q30-b",
            "type": "part",
            "label": "b",
            "prompt": "once.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=-1$ or $k=1$",
              "worked": "At the circle's lowest or highest point, the horizontal line touches the circle once.\n\n$$k=-1\\text{ or }k=1$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p6-q30-c",
            "type": "part",
            "label": "c",
            "prompt": "no times.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k<-1$ or $k>1$",
              "worked": "Below the circle's lowest point or above its highest point, the horizontal line has no intersection with the circle.\n\n$$k<-1\\text{ or }k>1$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      }
    ]
