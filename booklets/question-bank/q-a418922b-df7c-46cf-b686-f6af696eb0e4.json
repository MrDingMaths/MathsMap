  "content": {
    "id": "p19-q6",
    "type": "question",
    "label": "6",
    "prompt": "A car is worth $\\$18{,}000$. It loses $12\\%$ of its value in one year. What is it worth after one year?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$15{,}840$",
      "worked": "$100\\%-12\\%=88\\%$ remains.\n$$\\begin{align*}\\text{Value after one year}&=88\\%\\times\\$18{,}000\\\\\\text{Value after one year}&=0.88\\times\\$18{,}000\\\\\\text{Value after one year}&=\\$15{,}840\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
