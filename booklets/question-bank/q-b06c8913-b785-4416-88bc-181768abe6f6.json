    "type": "question",
    "label": "20",
    "prompt": "At a school with 1200 students, 60% of the students are boys and 55% of the boys have brown eyes. How many students are brown-eyed boys?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "396 brown-eyed boys.",
      "worked": "$$\\begin{align*}\\text{Number of boys} &= 0.60\\times1200\\\\\\text{Number of boys} &= 720\\\\\\text{Number of brown-eyed boys} &= 0.55\\times720\\\\\\text{Number of brown-eyed boys} &= 396\\end{align*}$$",
      "solutionDiagrams": []
    },
