        "prompt": "$\\dfrac{\\sin^2\\alpha}{1-\\sin^2\\alpha}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^2\\alpha$",
          "worked": "$$\\begin{align*}\\frac{\\sin^2\\alpha}{1-\\sin^2\\alpha}&=\\frac{\\sin^2\\alpha}{\\cos^2\\alpha}\\\\&=\\tan^2\\alpha\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-7ff42cfd9-practice-slot-16-slot-16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sec^2\\beta-1}{\\sec^2\\beta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2\\beta$",
          "worked": "$$\\begin{align*}\\frac{\\sec^2\\beta-1}{\\sec^2\\beta}&=\\frac{\\tan^2\\beta}{\\sec^2\\beta}\\\\&=\\frac{\\sin^2\\beta}{\\cos^2\\beta}\\cdot\\cos^2\\beta\\\\&=\\sin^2\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
