  "content": {
    "id": "p107-q35-root",
    "type": "question",
    "label": "35",
    "prompt": "Find the value of $m$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p107-q35-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{m}{m}+\\frac{m}{m}=m$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2$",
          "worked": "$$\\begin{align*}1+1&=m\\\\m&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p107-q35-b",
        "type": "part",
        "label": "b",
        "prompt": "$$m+\\frac{1}{m}=2\\frac{1}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2$ or $\\frac{1}{2}$",
          "worked": "$$m+\\frac{1}{m}=\\frac{5}{2}$$\nThe reciprocal numbers $2$ and $\\frac{1}{2}$ add to $\\frac{5}{2}$. Either number can be $m$.\n$$m=2\\text{ or }\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p107-q35-c",
        "type": "part",
        "label": "c",
        "prompt": "$$(m-3)^2=\\frac{1}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=3\\frac{1}{2}$ or $2\\frac{1}{2}$",
          "worked": "$$\\begin{align*}m-3&=\\pm\\frac{1}{2}\\\\m&=3\\pm\\frac{1}{2}\\\\m&=3\\frac{1}{2}\\text{ or }2\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p107-q35-d",
        "type": "part",
        "label": "d",
        "prompt": "$$(m-1)^2=\\frac{4}{9}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1\\frac{2}{3}$ or $\\frac{1}{3}$",
          "worked": "$$\\begin{align*}m-1&=\\pm\\frac{2}{3}\\\\m&=1\\pm\\frac{2}{3}\\\\m&=1\\frac{2}{3}\\text{ or }\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
