    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=x(x+6)$ is shown. Find the coordinates of its turning point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p28-q1-a-graph",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"supplied function curve\"}],\"reference\":\"source page 28, p28-q1-a-graph\"}\n\\begin{tikzpicture}[x=0.24cm,y=0.24cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\draw[<->,black,line width=0.5pt] (-11,0)--(11,0) node[right] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-11)--(0,11) node[above] {$y$};\n\\draw[<->,curveBlue,line width=0.8pt,domain=-7.47213595:1.47213595,samples=120] plot (\\x,{\\x*(\\x+6)});\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 70,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 28,
              "sourceRegion": "Question 1a, opening left-hand graph",
              "description": "Upward-opening blue parabola with vertex left of the vertical axis and below the horizontal axis. Both curve ends and both ends of each black axis have arrowheads. Axes are labelled x and y, without ticks, grid or coordinate labels.",
              "mathematics": "Plot y=x(x+6). The vertex is (-3,-9), and the intercepts are (-6,0) and (0,0). Display bounds preserve the qualitative source proportions and do not introduce a labelled numerical scale.",
              "answerVisibility": "The supplied unlabelled function graph is always visible; turning-point coordinates are answer-only."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$(-3,-9)$",
          "worked": "$$\\begin{align*}y&=x^2+6x\\\\y&=(x+3)^2-9\\end{align*}$$\nThe turning point is $(-3,-9)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the domain over which the function $y=x(x+6)$ is one-to-one and increasing, including the turning point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[-3,\\infty)$",
          "worked": "The curve increases to the right of its turning point at $x=-3$. Including the turning point gives $x\\geq-3$, or $[-3,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p28-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the inverse over this restricted domain, stating its domain and range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sqrt{x+9}-3$. Domain: $[-9,\\infty)$. Range: $[-3,\\infty)$.",
          "worked": "$$\\begin{align*}y&=(x+3)^2-9,\\quad x\\geq-3\\\\x&=(y+3)^2-9,\\quad y\\geq-3\\\\x+9&=(y+3)^2\\\\y+3&=\\sqrt{x+9}\\\\y&=\\sqrt{x+9}-3\\end{align*}$$\nSince $y\\geq-3$, choose the positive square-root branch. The original range is $[-9,\\infty)$, so the inverse has domain $[-9,\\infty)$ and range $[-3,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p28-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the domain over which the function $y=x(x+6)$ is one-to-one and decreasing, including the turning point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,-3]$",
          "worked": "The curve decreases to the left of its turning point at $x=-3$. Including the turning point gives $x\\leq-3$, or $(-\\infty,-3]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p28-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the inverse over this restricted domain, stating its domain and range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\sqrt{x+9}-3$. Domain: $[-9,\\infty)$. Range: $(-\\infty,-3]$.",
          "worked": "$$\\begin{align*}y&=(x+3)^2-9,\\quad x\\leq-3\\\\x&=(y+3)^2-9,\\quad y\\leq-3\\\\x+9&=(y+3)^2\\\\y+3&=-\\sqrt{x+9}\\\\y&=-\\sqrt{x+9}-3\\end{align*}$$\nSince $y\\leq-3$, choose the negative square-root branch. The original range is $[-9,\\infty)$, so the inverse has domain $[-9,\\infty)$ and range $(-\\infty,-3]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
