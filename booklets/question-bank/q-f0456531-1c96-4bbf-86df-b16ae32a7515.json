  "content": {
    "id": "p10-q1",
    "type": "question",
    "label": "1",
    "prompt": "Use the formula $a^{2}=c^{2}-b^{2}$ to find the value of",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$a$ when $c=10$ and $b=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm6$",
          "worked": "$$\\begin{align*}a^{2}&=c^{2}-b^{2}\\\\a^{2}&=10^{2}-8^{2}\\\\a^{2}&=36\\\\a&=\\pm6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$b$ when $a=3$ and $c=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\pm4$",
          "worked": "$$\\begin{align*}a^{2}&=c^{2}-b^{2}\\\\3^{2}&=5^{2}-b^{2}\\\\b^{2}&=25-9\\\\b^{2}&=16\\\\b&=\\pm4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
