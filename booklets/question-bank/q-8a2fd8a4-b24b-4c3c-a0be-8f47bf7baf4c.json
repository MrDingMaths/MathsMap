    "children": [
      {
        "id": "p9-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\ln(x^2+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{2x}{x^2+1}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{1}{x^2+1}(2x)\\\\\\frac{dy}{dx}&=\\frac{2x}{x^2+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\ln(2-x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{-2x}{2-x^2}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{1}{2-x^2}(-2x)\\\\\\frac{dy}{dx}&=\\frac{-2x}{2-x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\ln(1+e^x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{e^x}{1+e^x}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{1}{1+e^x}(e^x)\\\\\\frac{dy}{dx}&=\\frac{e^x}{1+e^x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_e(x^2+3x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{2x+3}{x^2+3x+2}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{1}{x^2+3x+2}(2x+3)\\\\\\frac{dy}{dx}&=\\frac{2x+3}{x^2+3x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p9-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_e(1+2x^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{6x^2}{1+2x^3}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{1}{1+2x^3}(6x^2)\\\\\\frac{dy}{dx}&=\\frac{6x^2}{1+2x^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\ln(e^x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{e^x}{e^x-2}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{1}{e^x-2}(e^x)\\\\\\frac{dy}{dx}&=\\frac{e^x}{e^x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$x+3-\\ln(x^2+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=1-\\dfrac{2x+1}{x^2+x}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=1+0-\\frac{1}{x^2+x}(2x+1)\\\\\\frac{dy}{dx}&=1-\\frac{2x+1}{x^2+x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2+\\ln(x^3-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2x+\\dfrac{3x^2-1}{x^3-x}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x+\\frac{1}{x^3-x}(3x^2-1)\\\\\\frac{dy}{dx}&=2x+\\frac{3x^2-1}{x^3-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$4x^3-\\ln(2x^2-3x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=12x^2-\\dfrac{4x-3}{2x^2-3x+1}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=12x^2\\\\&\\quad-\\frac{1}{2x^2-3x+1}(4x-3)\\\\\\frac{dy}{dx}&=12x^2-\\frac{4x-3}{2x^2-3x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
