  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The average of 8 numbers is 24. What is the average of the same 8 numbers plus the two numbers 22 and 32?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "24.6",
      "worked": "$$\\begin{align*}\\text{Original total}&=8\\times24\\\\\\text{Original total}&=192\\\\\\text{New total}&=192+22+32\\\\\\text{New total}&=246\\\\\\text{New average}&=\\frac{246}{10}\\\\\\text{New average}&=24.6\\end{align*}$$",
      "solutionDiagrams": []
    },
