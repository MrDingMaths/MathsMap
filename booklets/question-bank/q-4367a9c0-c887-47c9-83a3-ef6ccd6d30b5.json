      {
        "id": "p45-q4-equivalent",
        "type": "part",
        "label": "a",
        "prompt": "What whole number is equivalent to $\\frac{5}{5}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\frac{5}{5}=1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p45-q4-explain",
        "type": "part",
        "label": "b",
        "prompt": "Why is it not correct to multiply by $\\frac{5}{5}$ if we want to multiply by 5?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Multiplying by $\\frac{5}{5}$ means multiplying by 1, which leaves the number unchanged.",
          "worked": "Since $\\frac{5}{5}=1$, multiplying by $\\frac{5}{5}$ leaves the number unchanged. To multiply by 5, use $5=\\frac{5}{1}$; the original denominator stays the same.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p45-q4-workout",
        "type": "part",
        "label": "c",
        "prompt": "Work out:\n$$\\frac{3}{4}\\times7$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{4}$",
          "worked": "$$\\begin{align*}\\frac{3}{4}\\times7&=\\frac{3\\times7}{4}\\\\&=\\frac{21}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
