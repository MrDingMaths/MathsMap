    "answer": {
      "short": "$7$",
      "worked": "$$\\begin{align*}\\left(x+\\frac{1}{x}\\right)^2&=x^2+2x\\left(\\frac{1}{x}\\right)+\\frac{1}{x^2}\\\\x^2+\\frac{1}{x^2}&=\\left(x+\\frac{1}{x}\\right)^2-2\\\\x^2+\\frac{1}{x^2}&=3^2-2\\\\x^2+\\frac{1}{x^2}&=7\\end{align*}$$",
      "solutionDiagrams": []
    },
