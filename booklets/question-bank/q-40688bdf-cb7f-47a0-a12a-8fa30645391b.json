  "content": {
    "id": "p3-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A fair die is rolled. What is the probability that the number facing upwards is",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q2a",
        "type": "part",
        "label": "a",
        "prompt": "greater than 2?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "The favourable faces are $3,4,5,6$. The six faces are equally likely. $$\\begin{align*}P(\\text{greater than }2)&=\\frac{4}{6}\\\\P(\\text{greater than }2)&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p3-q2b",
        "type": "part",
        "label": "b",
        "prompt": "divisible by 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "The favourable faces are $3$ and $6$. The six faces are equally likely. $$\\begin{align*}P(\\text{divisible by }3)&=\\frac{2}{6}\\\\P(\\text{divisible by }3)&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
