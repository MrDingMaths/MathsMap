  "content": {
    "id": "p7-q10",
    "type": "question",
    "label": "10",
    "prompt": "Given that each interior angle of a regular polygon is $I=\\dfrac{180(n-2)}{n}$, rearrange the formula so that $n$ is the subject.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=-\\dfrac{360}{I-180}$",
      "worked": "$$\\begin{align*}I&=\\frac{180(n-2)}{n}\\\\In&=180n-360\\\\In-180n&=-360\\\\n(I-180)&=-360\\\\n&=-\\frac{360}{I-180}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
