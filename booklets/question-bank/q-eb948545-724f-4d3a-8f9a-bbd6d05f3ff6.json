  "content": {
    "id": "p21-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Solve each of the following for $(x,y)$ by equating each pair of equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=x+5\\\\y&=2x+4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,6)$",
          "worked": "$$\\begin{align*}x+5&=2x+4\\\\5&=x+4\\\\x&=1\\\\y&=1+5\\\\y&=6\\end{align*}$$\nTherefore, $(x,y)=(1,6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=3x+5\\\\y&=5x+4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac12,\\frac{13}{2}\\right)$",
          "worked": "$$\\begin{align*}3x+5&=5x+4\\\\1&=2x\\\\x&=\\frac12\\\\y&=3\\left(\\frac12\\right)+5\\\\y&=\\frac{13}{2}\\end{align*}$$\nTherefore, $(x,y)=\\left(\\frac12,\\frac{13}{2}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=2x-1\\\\y&=-2x-3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-\\frac12,-2\\right)$",
          "worked": "$$\\begin{align*}2x-1&=-2x-3\\\\4x&=-2\\\\x&=-\\frac12\\\\y&=2\\left(-\\frac12\\right)-1\\\\y&=-2\\end{align*}$$\nTherefore, $(x,y)=\\left(-\\frac12,-2\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p21-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=x-3\\\\y&=5x-7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,-2)$",
          "worked": "$$\\begin{align*}x-3&=5x-7\\\\4&=4x\\\\x&=1\\\\y&=1-3\\\\y&=-2\\end{align*}$$\nTherefore, $(x,y)=(1,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}y&=-2x+1\\\\y&=4x-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac12,0\\right)$",
          "worked": "$$\\begin{align*}-2x+1&=4x-2\\\\3&=6x\\\\x&=\\frac12\\\\y&=-2\\left(\\frac12\\right)+1\\\\y&=0\\end{align*}$$\nTherefore, $(x,y)=\\left(\\frac12,0\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p21-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}x&=y-1\\\\x&=5-y\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(2,3)$",
          "worked": "$$\\begin{align*}y-1&=5-y\\\\2y&=6\\\\y&=3\\\\x&=3-1\\\\x&=2\\end{align*}$$\nTherefore, $(x,y)=(2,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}y&=2x+2\\\\y&=-3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-\\frac52,-3\\right)$",
          "worked": "$$\\begin{align*}2x+2&=-3\\\\2x&=-5\\\\x&=-\\frac52\\end{align*}$$\nWith $y=-3$, $(x,y)=\\left(-\\frac52,-3\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}x&=3y-6\\\\x&=-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-2,\\frac43\\right)$",
          "worked": "$$\\begin{align*}3y-6&=-2\\\\3y&=4\\\\y&=\\frac43\\end{align*}$$\nWith $x=-2$, $(x,y)=\\left(-2,\\frac43\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\begin{aligned}y&=7-2x\\\\y&=4-5x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-1,9)$",
          "worked": "$$\\begin{align*}7-2x&=4-5x\\\\3x&=-3\\\\x&=-1\\\\y&=7-2(-1)\\\\y&=9\\end{align*}$$\nTherefore, $(x,y)=(-1,9)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\begin{aligned}x&=7+2y\\\\x&=-3-3y\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(3,-2)$",
          "worked": "$$\\begin{align*}7+2y&=-3-3y\\\\5y&=-10\\\\y&=-2\\\\x&=7+2(-2)\\\\x&=3\\end{align*}$$\nTherefore, $(x,y)=(3,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\begin{aligned}y&=2(x+3)\\\\y&=4(x+5)\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-7,-8)$\n\nEquate the expressions for $y$, expand and substitute.",
          "worked": "$$\\begin{align*}2(x+3)&=4(x+5)\\\\2x+6&=4x+20\\\\-14&=2x\\\\x&=-7\\\\y&=2(-7+3)\\\\y&=-8\\end{align*}$$\nTherefore, $(x,y)=(-7,-8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p21-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\begin{aligned}x&=2(3y+3)\\\\x&=4(2-y)\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac{36}{5},\\frac15\\right)$\n\nEquate the expressions for $x$, expand and substitute.",
          "worked": "$$\\begin{align*}2(3y+3)&=4(2-y)\\\\6y+6&=8-4y\\\\10y&=2\\\\y&=\\frac15\\\\x&=4\\left(2-\\frac15\\right)\\\\x&=\\frac{36}{5}\\end{align*}$$\nTherefore, $(x,y)=\\left(\\frac{36}{5},\\frac15\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p21-q4-m",
        "type": "part",
        "label": "m",
        "prompt": "$$\\begin{aligned}y&=\\frac{x}{2}+\\frac13\\\\y&=\\frac{x}{3}+\\frac12\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(1,\\frac56\\right)$\n\nEquate the expressions for $y$ and multiply by $6$.",
          "worked": "$$\\begin{align*}\\frac{x}{2}+\\frac13&=\\frac{x}{3}+\\frac12\\\\3x+2&=2x+3\\\\x&=1\\\\y&=\\frac12+\\frac13\\\\y&=\\frac56\\end{align*}$$\nTherefore, $(x,y)=\\left(1,\\frac56\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-q4-n",
        "type": "part",
        "label": "n",
        "prompt": "$$\\begin{aligned}y&=\\frac13-\\frac{x}{4}\\\\y&=\\frac{x}{3}-\\frac14\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(1,\\frac1{12}\\right)$\n\nEquate the expressions for $y$ and multiply by $12$.",
          "worked": "$$\\begin{align*}\\frac13-\\frac{x}{4}&=\\frac{x}{3}-\\frac14\\\\4-3x&=4x-3\\\\7&=7x\\\\x&=1\\\\y&=\\frac13-\\frac14\\\\y&=\\frac1{12}\\end{align*}$$\nTherefore, $(x,y)=\\left(1,\\frac1{12}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p21-q4-o",
        "type": "part",
        "label": "o",
        "prompt": "$$\\begin{aligned}y&=0.7x+1\\\\y&=0.2x+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(4,3.8)$",
          "worked": "$$\\begin{align*}0.7x+1&=0.2x+3\\\\0.5x&=2\\\\x&=4\\\\y&=0.7(4)+1\\\\y&=3.8\\end{align*}$$\nTherefore, $(x,y)=(4,3.8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q4-p",
        "type": "part",
        "label": "p",
        "prompt": "$$\\begin{aligned}x&=-0.3y+0.2\\\\x&=-0.5y+0.8\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-0.7,3)$",
          "worked": "$$\\begin{align*}-0.3y+0.2&=-0.5y+0.8\\\\0.2y&=0.6\\\\y&=3\\\\x&=-0.3(3)+0.2\\\\x&=-0.7\\end{align*}$$\nTherefore, $(x,y)=(-0.7,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
