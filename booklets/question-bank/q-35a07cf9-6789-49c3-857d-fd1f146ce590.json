  "content": {
    "id": "p17-q24",
    "type": "question",
    "label": "24",
    "prompt": "By finding expressions for the LHS and RHS, show that these are true for $f(x)=4^x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "$4f(x)=f(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True; both sides equal $4^{x+1}$.",
          "worked": "$$\\begin{aligned}\\text{LHS}&=4f(x)\\\\&=4\\cdot4^x\\\\&=4^{x+1}\\\\\\text{RHS}&=f(x+1)\\\\&=4^{x+1}\\end{aligned}$$\nThus LHS = RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x+1)-f(x)=3f(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True; both sides equal $3\\cdot4^x$.",
          "worked": "$$\\begin{aligned}\\text{LHS}&=f(x+1)-f(x)\\\\&=4^{x+1}-4^x\\\\&=4\\cdot4^x-4^x\\\\&=3\\cdot4^x\\\\\\text{RHS}&=3f(x)\\\\&=3\\cdot4^x\\end{aligned}$$\nThus LHS = RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
