    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q29-38-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2x+2$",
          "worked": "$$\\begin{align*}y'&=\\frac{d}{dx}(x^2)+\\frac{d}{dx}(2x)\\\\y'&=2x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q29-38-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^3-4x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3x^2-8x$",
          "worked": "$$\\begin{align*}y'&=\\frac{d}{dx}(x^3)-4\\frac{d}{dx}(x^2)\\\\y'&=3x^2-8x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q29-38-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=1-2x$",
          "worked": "$$\\begin{align*}y'&=\\frac{d}{dx}(x)-\\frac{d}{dx}(x^2)\\\\y'&=1-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q29-38-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=2x^2+3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4x+3$",
          "worked": "$$\\begin{align*}y'&=2\\frac{d}{dx}(x^2)+3\\frac{d}{dx}(x)\\\\y'&=4x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q29-38-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^2-4x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2x-4$",
          "worked": "$$\\begin{align*}y'&=\\frac{d}{dx}(x^2)-4\\frac{d}{dx}(x)+\\frac{d}{dx}(2)\\\\y'&=2x-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q29-38-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=2x^3-5x^2-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=6x^2-10x$",
          "worked": "$$\\begin{align*}y'&=2\\frac{d}{dx}(x^3)-5\\frac{d}{dx}(x^2)-\\frac{d}{dx}(1)\\\\y'&=6x^2-10x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q29-38-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=5x-\\dfrac{3x^2}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=5-3x$",
          "worked": "$$\\begin{align*}y'&=5\\frac{d}{dx}(x)-\\frac{3}{2}\\frac{d}{dx}(x^2)\\\\y'&=5-3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q29-38-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=4x-\\dfrac{5}{x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4+\\dfrac{15}{x^4}$",
          "worked": "$$\\begin{align*}y&=4x-5x^{-3}\\\\y'&=4+15x^{-4}\\\\y'&=4+\\frac{15}{x^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q29-38-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\dfrac{x^4}{4}+\\dfrac{x^3}{3}+\\dfrac{x^2}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=x^3+x^2+x$",
          "worked": "$$\\begin{align*}y'&=\\frac14(4x^3)+\\frac13(3x^2)+\\frac12(2x)\\\\y'&=x^3+x^2+x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q29-38-j",
        "type": "part",
        "label": "j",
        "prompt": "$y=\\dfrac{x^2}{4}-\\dfrac{4}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x}{2}+\\dfrac{8}{x^3}$",
          "worked": "$$\\begin{align*}y&=\\frac14x^2-4x^{-2}\\\\y'&=\\frac12x+8x^{-3}\\\\y'&=\\frac{x}{2}+\\frac{8}{x^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
