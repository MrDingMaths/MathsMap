  "content": {
    "id": "p5-q87-90-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q87",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sec x}{\\operatorname{cosec}x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan x$",
          "worked": "$$\\begin{align*}\\frac{\\sec x}{\\operatorname{cosec}x}&=\\frac{1/\\cos x}{1/\\sin x}\\\\\\frac{\\sec x}{\\operatorname{cosec}x}&=\\frac{\\sin x}{\\cos x}\\\\\\frac{\\sec x}{\\operatorname{cosec}x}&=\\tan x\\end{align*}$$\nThis holds where the original expression is defined: $\\sin x\\ne0$ and $\\cos x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p5-q88",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\cot x}{\\operatorname{cosec}x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos x$",
          "worked": "$$\\begin{align*}\\frac{\\cot x}{\\operatorname{cosec}x}&=\\frac{\\cos x/\\sin x}{1/\\sin x}\\\\\\frac{\\cot x}{\\operatorname{cosec}x}&=\\cos x\\end{align*}$$\nThis holds where the original expression is defined: $\\sin x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q89",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\tan x}{\\sec x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin x$",
          "worked": "$$\\begin{align*}\\frac{\\tan x}{\\sec x}&=\\frac{\\sin x/\\cos x}{1/\\cos x}\\\\\\frac{\\tan x}{\\sec x}&=\\sin x\\end{align*}$$\nThis holds where the original expression is defined: $\\cos x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q90",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\cos x}{\\cot x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin x$",
          "worked": "$$\\begin{align*}\\frac{\\cos x}{\\cot x}&=\\frac{\\cos x}{\\cos x/\\sin x}\\\\\\frac{\\cos x}{\\cot x}&=\\frac{\\cos x\\sin x}{\\cos x}\\\\\\frac{\\cos x}{\\cot x}&=\\sin x\\end{align*}$$\nThis holds where the original expression is defined: $\\sin x\\ne0$ and $\\cos x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
