  "content": {
    "id": "p21-q29-response",
    "type": "question",
    "label": "29",
    "prompt": "Mark is rowing in a river that flows downstream at 2 km/h. He rows downstream for 30 km, then turns around and returns to his original location. The total trip took 8 hrs.\nHow fast would Mark row in still water?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8\\text{ km/h}$. Use $\\dfrac{30}{s+2}+\\dfrac{30}{s-2}=8$, with $s>2$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p21-q29-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "t=\\frac{d}{s}",
                "display": false
              },
              {
                "type": "text",
                "text": ", let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "s",
                "display": false
              },
              {
                "type": "text",
                "text": " be Mark’s speed in still water, in km/h. To row upstream, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "s>2",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p21-q29-answer-times",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "t_{\\text{downstream}}=\\frac{30}{s+2}",
                "display": true
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "t_{\\text{upstream}}=\\frac{30}{s-2}",
                "display": true
              }
            ]
          },
          {
            "id": "p21-q29-answer-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}t_d+t_u&=8\\\\\\frac{30}{s+2}+\\frac{30}{s-2}&=8\\\\30(s-2)+30(s+2)&=8(s+2)(s-2)\\\\60s&=8s^2-32\\\\8s^2-60s-32&=0\\\\2s^2-15s-8&=0\\\\2s^2-16s+s-8&=0\\\\2s(s-8)+(s-8)&=0\\\\(2s+1)(s-8)&=0\\\\s&=-\\frac12\\text{ or }8\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p21-q29-answer-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Reject ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "s=-\\frac12",
                "display": false
              },
              {
                "type": "text",
                "text": " since ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "s>2",
                "display": false
              },
              {
                "type": "text",
                "text": ". Mark rows at 8 km/h in still water.",
                "marks": []
              }
            ]
          },
          {
            "id": "p21-q29-answer-check",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Check: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{30}{8+2}+\\frac{30}{8-2}=3+5=8\\text{ hours}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
