      {
        "id": "p115-question-three-branches-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "Since $5>2$, use the third branch.\n\n$$\\begin{align*}f(5)&=5+2\\\\f(5)&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p115-question-three-branches-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Since $-3<-2$, use the first branch.\n\n$$\\begin{align*}f(-3)&=2-(-3)\\\\f(-3)&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
