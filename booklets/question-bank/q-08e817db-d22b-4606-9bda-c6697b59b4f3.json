        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Use $x+2$ for $3>2$ and the constant branch for $-2\\le-1\\le2$.\n\n$$\\begin{align*}f(3)-f(-1)&=(3+2)-4\\\\f(3)-f(-1)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p115-question-three-branches-part-e",
        "type": "part",
        "label": "e",
        "prompt": "Sketch the graph of $y=f(x)$, labelling the equation of each branch.",
