  "content": {
    "id": "p17-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The following points lie on the line with equation $3x-12y=30$. Find the value of each pronumeral.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$(0,a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-\\dfrac{5}{2}$",
          "worked": "$$\\begin{aligned}3\\times0-12a&=30\\\\-12a&=30\\\\a&=-\\frac{5}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q11-b",
        "type": "part",
