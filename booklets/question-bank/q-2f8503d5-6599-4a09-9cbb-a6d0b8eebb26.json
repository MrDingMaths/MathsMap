    "children": [
      {
        "id": "p15-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the area of the senior netball court.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$lw$",
          "worked": "$$\\begin{align*}A_{\\text{senior}}&=l\\times w\\\\&=lw\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an expression for the length and width of the junior netball court.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Length: $\\dfrac{l}{2}$; width: $\\dfrac{2w}{3}$.",
          "worked": "$$\\begin{align*}L_{\\text{junior}}&=\\frac12\\times l\\\\&=\\frac{l}{2}\\\\W_{\\text{junior}}&=\\frac23\\times w\\\\&=\\frac{2w}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an expression for the area of the junior netball court.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{lw}{3}$",
          "worked": "$$\\begin{align*}A_{\\text{junior}}&=\\frac{l}{2}\\times\\frac{2w}{3}\\\\&=\\frac{2lw}{6}\\\\&=\\frac{lw}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Write an expression for the difference between the areas of the senior netball court and the junior netball court.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2lw}{3}$",
          "worked": "$$\\begin{align*}A_{\\text{senior}}-A_{\\text{junior}}&=lw-\\frac{lw}{3}\\\\&=\\frac{3lw-lw}{3}\\\\&=\\frac{2lw}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
