    "children": [
      {
        "id": "p24-q9a",
        "type": "part",
        "label": "a",
        "prompt": "Find the number of solutions to the equation $a+b+c+d=10$, where $a,b,c,d$ are non-negative integers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$286$",
          "worked": "Represent each solution by 10 identical stars and 3 identical bars separating the four groups. Empty groups are allowed. Choose the positions of the bars among the 13 positions.\n\n$$\\begin{align*}N&=\\binom{13}{3}\\\\N&=286\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q9b",
        "type": "part",
        "label": "b",
        "prompt": "Find the number of solutions to the equation $a+b+c+d=10$, where $a,b,c,d$ are positive integers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84$",
          "worked": "Represent the total by 10 stars. Each of the four groups must contain at least one star, so place the 3 bars in distinct gaps between stars. There are 9 gaps.\n\n$$\\begin{align*}N&=\\binom{9}{3}\\\\N&=84\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
