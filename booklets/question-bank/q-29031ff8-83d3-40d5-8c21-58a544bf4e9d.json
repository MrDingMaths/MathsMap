  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The sum $S$ of the squares of the first $n$ positive integers is given by the formula $$S=\\frac{n(n+1)(2n+1)}{6}.$$ Find the sum of the squares of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "the first 20 positive integers",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2870$",
          "worked": "Using the supplied formula with $n=20$:\n$$\\begin{align*}S&=\\frac{20(20+1)(2\\times20+1)}{6}\\\\S&=\\frac{20\\times21\\times41}{6}\\\\S&=2870\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "all the numbers from 5 to 21 inclusive",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3281$",
          "worked": "Subtract the sum for $1$ to $4$ from the sum for $1$ to $21$.\n$$\\begin{align*}S_{21}&=\\frac{21(21+1)(2\\times21+1)}{6}\\\\S_{21}&=3311\\\\S_4&=\\frac{4(4+1)(2\\times4+1)}{6}\\\\S_4&=30\\\\S_{21}-S_4&=3311-30\\\\S_{21}-S_4&=3281\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
