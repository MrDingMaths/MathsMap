  "content": {
    "id": "p29-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Simplify as much as possible, retain the absolute value sign where necessary.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{(-3x)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3|x|$",
          "worked": "$$\\begin{align*}\\sqrt{(-3x)^2}&=|-3x|\\\\&=3|x|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$|-2x||3x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2$",
          "worked": "$$\\begin{align*}|-2x||3x|&=2|x|\\cdot3|x|\\\\&=6|x|^2\\\\&=6x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p29-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{|6x|}{|2x|}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$, for $x\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{|6x|}{|2x|}&=\\frac{6|x|}{2|x|}\\\\&=3\\end{align*}$$\nThe original denominator requires $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p29-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{(x-4)^2}+|4-x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2|x-4|$",
          "worked": "$$\\begin{align*}\\sqrt{(x-4)^2}+|4-x|&=|x-4|+|4-x|\\\\&=|x-4|+|x-4|\\\\&=2|x-4|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p29-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$|-3x|^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2$",
          "worked": "$$\\begin{align*}|-3x|^2&=(-3x)^2\\\\&=9x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{(a-b)^2}\\,|b-a|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-b)^2$",
          "worked": "$$\\begin{align*}\\sqrt{(a-b)^2}\\,|b-a|&=|a-b||b-a|\\\\&=|a-b||a-b|\\\\&=|a-b|^2\\\\&=(a-b)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p29-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{|x^2y|}{|xy|}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|x|$, for $x\\ne0$ and $y\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{|x^2y|}{|xy|}&=\\frac{|x|^2|y|}{|x||y|}\\\\&=|x|\\end{align*}$$\nThe original denominator requires $x\\ne0$ and $y\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p29-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sqrt{(2x+1)^2}-|-(2x+1)|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\sqrt{(2x+1)^2}-|-(2x+1)|&=|2x+1|-|2x+1|\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
