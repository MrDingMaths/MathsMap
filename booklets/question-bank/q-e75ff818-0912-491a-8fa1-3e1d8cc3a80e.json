  "content": {
    "id": "v2-p22-mixed-practice-slot-11-upper-root",
    "type": "question",
    "label": null,
    "prompt": "The gravitational force $F$ newtons between two objects is given by $F=\\dfrac{Gm_1m_2}{r^{2}}$.\nTwo cargo ships of mass $2\\times10^{7}$ kg and $3\\times10^{7}$ kg are $2\\times10^{2}$ m apart.\nIf $G=6\\times10^{-11}$, calculate $F$ in scientific notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9\\times10^{-1}\\text{ N}$",
      "worked": "$$\\begin{align*}F&=\\frac{(6\\times10^{-11})(2\\times10^{7})(3\\times10^{7})}{(2\\times10^{2})^{2}}\\\\&=\\frac{36\\times10^{3}}{4\\times10^{4}}\\\\&=9\\times10^{3-4}\\\\&=9\\times10^{-1}\\text{ N}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
  },
