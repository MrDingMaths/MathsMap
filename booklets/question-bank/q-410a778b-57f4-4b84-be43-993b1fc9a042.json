        "label": "a",
        "prompt": "$\\displaystyle\\int x^3(x^4+1)^5\\,dx,\\quad u=x^4+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{24}(x^4+1)^6+C$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p36-q4-a-working",
                "type": "layout",
                "arrangement": "parallel",
                "title": "",
                "border": false,
                "padding": 3,
                "margin": 3,
                "gap": 3,
                "columns": 2,
                "slots": [
                  {
                    "id": "p36-q4-a-main",
                    "blocks": [
                      {
                        "id": "p36-q4-a-main-p",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\int x^3(x^4+1)^5\\,dx&=\\frac14\\int u^5\\,du\\\\&=\\frac{u^6}{24}+C\\\\&=\\frac{(x^4+1)^6}{24}+C\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p36-q4-a-substitution",
                    "blocks": [
                      {
                        "id": "p36-q4-a-substitution-p",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}u&=x^4+1\\\\\\frac{du}{dx}&=4x^3\\\\du&=4x^3\\,dx\\\\x^3\\,dx&=\\frac14\\,du\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p36-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int x^2\\sqrt{x^3-1}\\,dx,\\quad u=x^3-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac29(x^3-1)^{\\frac32}+C$",
          "worked": "$$\\begin{alignedat}{2}\\int x^2\\sqrt{x^3-1}\\,dx&=\\frac13\\int u^{1/2}\\,du&\\qquad u&=x^3-1\\\\&=\\frac13\\cdot\\frac23u^{3/2}+C&\\frac{du}{dx}&=3x^2\\\\&=\\frac29(x^3-1)^{3/2}+C&du&=3x^2\\,dx\\\\&&x^2\\,dx&=\\frac13\\,du\\end{alignedat}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p36-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int x^2e^{x^3}\\,dx,\\quad u=x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13e^{x^3}+C$",
          "worked": "$$\\begin{alignedat}{2}\\int x^2e^{x^3}\\,dx&=\\frac13\\int e^u\\,du&\\qquad u&=x^3\\\\&=\\frac13e^u+C&\\frac{du}{dx}&=3x^2\\\\&=\\frac13e^{x^3}+C&du&=3x^2\\,dx\\\\&&x^2\\,dx&=\\frac13\\,du\\end{alignedat}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p36-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac1{\\sqrt{x}(1+\\sqrt{x})^3}\\,dx,\\quad u=1+\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac1{(1+\\sqrt{x})^2}+C$",
          "worked": "$$\\begin{alignedat}{2}\\int\\frac{dx}{\\sqrt{x}(1+\\sqrt{x})^3}&=2\\int u^{-3}\\,du&\\qquad u&=1+\\sqrt{x}\\\\&=-u^{-2}+C&\\frac{du}{dx}&=\\frac1{2\\sqrt{x}}\\\\&=-\\frac1{(1+\\sqrt{x})^2}+C&du&=\\frac{dx}{2\\sqrt{x}}\\\\&&dx&=2\\sqrt{x}\\,du\\end{alignedat}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p36-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int\\tan^2 2x\\sec^2 2x\\,dx,\\quad u=\\tan 2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac16\\tan^3 2x+C$",
          "worked": "$$\\begin{alignedat}{2}\\int\\tan^2 2x\\sec^2 2x\\,dx&=\\frac12\\int u^2\\,du&\\qquad u&=\\tan 2x\\\\&=\\frac{u^3}{6}+C&\\frac{du}{dx}&=2\\sec^2 2x\\\\&=\\frac16\\tan^3 2x+C&du&=2\\sec^2 2x\\,dx\\\\&&\\sec^2 2x\\,dx&=\\frac12\\,du\\end{alignedat}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p36-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int\\frac{e^{1/x}}{x^2}\\,dx,\\quad u=\\frac1x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-e^{1/x}+C$",
          "worked": "$$\\begin{alignedat}{2}\\int\\frac{e^{1/x}}{x^2}\\,dx&=-\\int e^u\\,du&\\qquad u&=\\frac1x\\\\&=-e^u+C&\\frac{du}{dx}&=-\\frac1{x^2}\\\\&=-e^{1/x}+C&du&=-\\frac1{x^2}\\,dx\\\\&&\\frac{dx}{x^2}&=-du\\end{alignedat}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
