  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A bag contains 120 balls, some of which are red, some blue and the rest yellow. The probability of drawing a blue ball is $\\frac{1}{12}$ and the probability of drawing a red ball is $\\frac25$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "the number of yellow balls in the bag",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "62 yellow balls",
          "worked": "$$\\begin{align*}\\text{Blue balls}&=\\frac1{12}\\times120=10\\\\\\text{Red balls}&=\\frac25\\times120=48\\\\\\text{Yellow balls}&=120-10-48=62\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p22-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "the number of yellow balls that should be removed from the bag so that the probability of drawing a yellow ball is $\\frac13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "33 yellow balls\n\nThe 58 non-yellow balls must form two-thirds of the remaining bag.",
          "worked": "There are $10+48=58$ non-yellow balls. When yellow has probability $\\frac13$, non-yellow has probability $\\frac23$.\n\n$$\\begin{align*}\\text{Remaining total}&=58\\div\\frac23=87\\\\\\text{Remaining yellow balls}&=87-58=29\\\\\\text{Yellow balls removed}&=62-29=33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
