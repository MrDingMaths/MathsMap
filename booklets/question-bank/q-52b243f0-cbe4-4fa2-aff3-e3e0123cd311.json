  "content": {
    "id": "p5-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Decide if these pairs of variables are in direct proportion (D) or inverse proportion (I).",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Wage earned and Number of hours worked.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "D",
          "worked": "Direct proportion: at a fixed hourly wage, doubling the hours worked doubles the wage earned.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Height of a prism and volume.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "D",
          "worked": "Direct proportion: with a fixed cross-sectional area, $V=Ah$, so doubling the height doubles the volume.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Time to complete a job and Number of helpers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "I",
          "worked": "Inverse proportion: for the same job and equally productive helpers, doubling the number of helpers halves the time.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Speed and Time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "I",
          "worked": "Inverse proportion: for a fixed distance, doubling the speed halves the travel time.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "Distance and Time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "D",
          "worked": "Direct proportion: at a constant speed, doubling the travel time doubles the distance travelled.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "Number of people and cost per person of renting a yacht.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "I",
          "worked": "Inverse proportion: sharing a fixed rental cost equally among twice as many people halves the cost per person.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "Revenue and Number of sales.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "D",
          "worked": "Direct proportion: at a fixed price per sale, doubling the number of sales doubles the revenue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "Time to paint a house and Number of painters.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "I",
          "worked": "Inverse proportion: for the same house and equally productive painters, doubling the number of painters halves the time.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
