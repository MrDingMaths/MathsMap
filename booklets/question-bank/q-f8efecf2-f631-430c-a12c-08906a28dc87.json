            "prompt": "$g(f(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5$",
              "worked": "$\\begin{align*}f(2)&=2-2\\\\f(2)&=0\\\\g(f(2))&=0+5\\\\g(f(2))&=5\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p23-q1-c",
