            "answer": {
              "short": "$g(f(x))=x+3$",
              "worked": "$\\begin{align*}f(x)&=x-2\\\\g(f(x))&=g(x-2)\\\\g(f(x))&=x-2+5\\\\g(f(x))&=x+3\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
