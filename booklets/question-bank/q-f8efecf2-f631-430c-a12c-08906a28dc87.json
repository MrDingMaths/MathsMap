            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "$\\begin{align*}f(0)&=0-2\\\\f(0)&=-2\\\\g(f(0))&=-2+5\\\\g(f(0))&=3\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
