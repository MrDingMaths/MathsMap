              "short": "$a+3$",
              "worked": "$\\begin{align*}f(a)&=a-2\\\\g(f(a))&=g(a-2)\\\\g(f(a))&=a-2+5\\\\g(f(a))&=a+3\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p23-q1-e",
            "type": "part",
            "label": "e",
            "prompt": "$g(f(x))$",
