            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10$",
              "worked": "$\\begin{align*}f(7)&=7-2\\\\f(7)&=5\\\\g(f(7))&=5+5\\\\g(f(7))&=10\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p23-q1-d",
            "type": "part",
            "label": "d",
            "prompt": "$g(f(a))$",
            "layout": "list",
