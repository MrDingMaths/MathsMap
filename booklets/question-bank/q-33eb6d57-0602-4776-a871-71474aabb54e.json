  "content": {
    "id": "p30-reverse-quartile-root",
    "type": "question",
    "label": "",
    "prompt": "A dataset contains 50 integer scores, all at least 15. Its cumulative frequency at 15 is 4, and its lower quartile is 16. What is the smallest possible cumulative frequency at 16?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$13$. The lower half contains 25 observations, so its median is the 13th observation.",
      "worked": "The lower half contains 25 observations. Its median is the 13th observation in the ordered dataset. Since $Q_1=16$, the 13th score is 16, so at least 13 scores are at most 16. This is possible with four scores of 15, nine scores of 16 and all remaining scores greater than 16. The minimum cumulative frequency at 16 is $13$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
