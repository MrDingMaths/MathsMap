  "content": {
    "id": "p12-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Given that $x=16$ and $y=25$, evaluate:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{\\frac12}+y^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}x^{\\frac12}+y^{\\frac12}&=\\sqrt{16}+\\sqrt{25}\\\\x^{\\frac12}+y^{\\frac12}&=4+5\\\\x^{\\frac12}+y^{\\frac12}&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{\\frac14}-y^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}x^{\\frac14}-y^{\\frac12}&=\\sqrt[4]{16}-\\sqrt{25}\\\\x^{\\frac14}-y^{\\frac12}&=2-5\\\\x^{\\frac14}-y^{\\frac12}&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^{-\\frac12}-y^{-\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{20}$",
          "worked": "$$\\begin{align*}x^{-\\frac12}-y^{-\\frac12}&=\\frac1{\\sqrt{16}}-\\frac1{\\sqrt{25}}\\\\x^{-\\frac12}-y^{-\\frac12}&=\\frac14-\\frac15\\\\x^{-\\frac12}-y^{-\\frac12}&=\\frac5{20}-\\frac4{20}\\\\x^{-\\frac12}-y^{-\\frac12}&=\\frac1{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$(y-x)^{\\frac12}\\times(4y)^{-\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{10}$",
          "worked": "$$\\begin{align*}(y-x)^{\\frac12}\\times(4y)^{-\\frac12}&=(25-16)^{\\frac12}\\times100^{-\\frac12}\\\\(y-x)^{\\frac12}\\times(4y)^{-\\frac12}&=\\sqrt9\\times\\frac1{\\sqrt{100}}\\\\(y-x)^{\\frac12}\\times(4y)^{-\\frac12}&=3\\times\\frac1{10}\\\\(y-x)^{\\frac12}\\times(4y)^{-\\frac12}&=\\frac3{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
