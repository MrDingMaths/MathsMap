      {
        "id": "p33-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{dy}{dx}=\\sqrt{1-y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sin(x-C)$ for $-\\dfrac\\pi2<x-C<\\dfrac\\pi2$; also $y\\equiv1$ and $y\\equiv-1$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "e8cc8473-6d41-49b9-89a3-10e6bd27603d",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-1<y<1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ",",
                    "marks": []
                  }
                ]
              },
              {
                "id": "1ff49747-2131-4074-a5d6-2f306672b0bb",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{dx}{dy}&=\\frac1{\\sqrt{1-y^2}}\\\\x&=\\int\\frac1{\\sqrt{1-y^2}}\\,dy\\\\x&=\\sin^{-1}y+C\\\\y&=\\sin(x-C)\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "8c0f6aa0-3fa3-4381-b208-42126748a55a",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-\\frac\\pi2<x-C<\\frac\\pi2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so the derivative is nonnegative. The constant solutions are ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y\\equiv1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y\\equiv-1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". A nonconstant solution can be extended by ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=-1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " before its lower endpoint and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " after its upper endpoint.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
