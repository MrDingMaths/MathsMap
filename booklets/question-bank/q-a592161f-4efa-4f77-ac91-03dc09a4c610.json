  "content": {
    "id": "p45-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "Mel is taking her holidays. She receives \\$2937.50.\nThis includes her normal pay and 17.5% leave loading.\nHow much is the leave loading?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$437.50.",
      "worked": "Total holiday pay is $117.5\\%$ of normal pay for the holiday period.\n$$\\begin{align*}\\text{Normal pay} &= 2937.50 \\div 1.175 \\\\ &= \\$2500 \\\\ \\text{Leave loading} &= 0.175 \\times 2500 \\\\ &= \\$437.50\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
