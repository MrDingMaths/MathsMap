  "content": {
    "id": "p21-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Write each of the following expressions as a single fraction:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x}{2}+\\frac{x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x}{6}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}+\\frac{x}{3}&=\\frac{3x+2x}{6}\\\\\\frac{x}{2}+\\frac{x}{3}&=\\frac{5x}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{b}{2}+\\frac{b}{4}-\\frac{b}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11b}{20}$",
          "worked": "$$\\begin{align*}\\frac{b}{2}+\\frac{b}{4}-\\frac{b}{5}&=\\frac{10b+5b-4b}{20}\\\\\\frac{b}{2}+\\frac{b}{4}-\\frac{b}{5}&=\\frac{11b}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{a}{3}+\\frac{a}{6}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a+6}{2}$",
          "worked": "$$\\begin{align*}\\frac{a}{3}+\\frac{a}{6}+3&=\\frac{2a+a+18}{6}\\\\\\frac{a}{3}+\\frac{a}{6}+3&=\\frac{3a+18}{6}\\\\\\frac{a}{3}+\\frac{a}{6}+3&=\\frac{a+6}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{m+1}{4}+\\frac{m-3}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5m-3}{12}$",
          "worked": "$$\\begin{align*}\\frac{m+1}{4}+\\frac{m-3}{6}&=\\frac{3(m+1)+2(m-3)}{12}\\\\\\frac{m+1}{4}+\\frac{m-3}{6}&=\\frac{3m+3+2m-6}{12}\\\\\\frac{m+1}{4}+\\frac{m-3}{6}&=\\frac{5m-3}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x-3}{3}-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{5x+3}{3}$",
          "worked": "$$\\begin{align*}\\frac{x-3}{3}-2x&=\\frac{x-3-6x}{3}\\\\\\frac{x-3}{3}-2x&=-\\frac{5x+3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{m+4}{2}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{m+10}{2}$",
          "worked": "$$\\begin{align*}\\frac{m+4}{2}+3&=\\frac{m+4+6}{2}\\\\\\frac{m+4}{2}+3&=\\frac{m+10}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{a-2}{6}-\\frac{a+4}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{a+10}{6}$",
          "worked": "$$\\begin{align*}\\frac{a-2}{6}-\\frac{a+4}{3}&=\\frac{a-2-2(a+4)}{6}\\\\\\frac{a-2}{6}-\\frac{a+4}{3}&=\\frac{a-2-2a-8}{6}\\\\\\frac{a-2}{6}-\\frac{a+4}{3}&=-\\frac{a+10}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{b+1}{2}+\\frac{b+2}{3}+\\frac{b+3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13b+23}{12}$",
          "worked": "$$\\begin{align*}\\frac{b+1}{2}+\\frac{b+2}{3}+\\frac{b+3}{4}&=\\frac{6(b+1)+4(b+2)+3(b+3)}{12}\\\\\\frac{b+1}{2}+\\frac{b+2}{3}+\\frac{b+3}{4}&=\\frac{6b+6+4b+8+3b+9}{12}\\\\\\frac{b+1}{2}+\\frac{b+2}{3}+\\frac{b+3}{4}&=\\frac{13b+23}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{2(x-3)}{6}-\\frac{3(x+4)}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{x+60}{24}$",
          "worked": "$$\\begin{align*}\\frac{2(x-3)}{6}-\\frac{3(x+4)}{8}&=\\frac{8(x-3)-9(x+4)}{24}\\\\\\frac{2(x-3)}{6}-\\frac{3(x+4)}{8}&=\\frac{8x-24-9x-36}{24}\\\\\\frac{2(x-3)}{6}-\\frac{3(x+4)}{8}&=-\\frac{x+60}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
