  "content": {
    "id": "p19-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Researchers are trying to estimate the number of penguins in a colony. One day, they catch 40 penguins, tag their legs, then set them free. The next day, they catch 33 penguins and 5 of these have tagged legs. Estimate the number of penguins in the colony.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p19-q8-short-result",
