  "content": {
    "id": "p40-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Express with a rational denominator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{3-\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3+\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\frac{3}{3-\\sqrt3}&=\\frac{3(3+\\sqrt3)}{(3-\\sqrt3)(3+\\sqrt3)}\\\\\\frac{3}{3-\\sqrt3}&=\\frac{9+3\\sqrt3}{9-3}\\\\\\frac{3}{3-\\sqrt3}&=\\frac{3+\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{22}{2+3\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{22(3\\sqrt5-2)}{41}$",
          "worked": "$$\\begin{align*}\\frac{22}{2+3\\sqrt5}&=\\frac{22(2-3\\sqrt5)}{(2+3\\sqrt5)(2-3\\sqrt5)}\\\\\\frac{22}{2+3\\sqrt5}&=\\frac{22(2-3\\sqrt5)}{4-45}\\\\\\frac{22}{2+3\\sqrt5}&=\\frac{22(3\\sqrt5-2)}{41}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{24}{1-\\sqrt7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4\\sqrt7-4$",
          "worked": "$$\\begin{align*}\\frac{24}{1-\\sqrt7}&=\\frac{24(1+\\sqrt7)}{(1-\\sqrt7)(1+\\sqrt7)}\\\\\\frac{24}{1-\\sqrt7}&=\\frac{24(1+\\sqrt7)}{1-7}\\\\\\frac{24}{1-\\sqrt7}&=-4\\sqrt7-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{24}{1+\\sqrt{17}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3\\sqrt{17}-3}{2}$",
          "worked": "$$\\begin{align*}\\frac{24}{1+\\sqrt{17}}&=\\frac{24(1-\\sqrt{17})}{(1+\\sqrt{17})(1-\\sqrt{17})}\\\\\\frac{24}{1+\\sqrt{17}}&=\\frac{24(1-\\sqrt{17})}{1-17}\\\\\\frac{24}{1+\\sqrt{17}}&=\\frac{3\\sqrt{17}-3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{2-\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt3+6$",
          "worked": "$$\\begin{align*}\\frac{3}{2-\\sqrt3}&=\\frac{3(2+\\sqrt3)}{(2-\\sqrt3)(2+\\sqrt3)}\\\\\\frac{3}{2-\\sqrt3}&=\\frac{6+3\\sqrt3}{4-3}\\\\\\frac{3}{2-\\sqrt3}&=3\\sqrt3+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{30}{1-\\sqrt{11}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\sqrt{11}-3$",
          "worked": "$$\\begin{align*}\\frac{30}{1-\\sqrt{11}}&=\\frac{30(1+\\sqrt{11})}{(1-\\sqrt{11})(1+\\sqrt{11})}\\\\\\frac{30}{1-\\sqrt{11}}&=\\frac{30(1+\\sqrt{11})}{1-11}\\\\\\frac{30}{1-\\sqrt{11}}&=-3\\sqrt{11}-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{15}{2-\\sqrt7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5\\sqrt7-10$",
          "worked": "$$\\begin{align*}\\frac{15}{2-\\sqrt7}&=\\frac{15(2+\\sqrt7)}{(2-\\sqrt7)(2+\\sqrt7)}\\\\\\frac{15}{2-\\sqrt7}&=\\frac{15(2+\\sqrt7)}{4-7}\\\\\\frac{15}{2-\\sqrt7}&=-5\\sqrt7-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{10}{2-\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20+10\\sqrt3$",
          "worked": "$$\\begin{align*}\\frac{10}{2-\\sqrt3}&=\\frac{10(2+\\sqrt3)}{(2-\\sqrt3)(2+\\sqrt3)}\\\\\\frac{10}{2-\\sqrt3}&=\\frac{20+10\\sqrt3}{4-3}\\\\\\frac{10}{2-\\sqrt3}&=20+10\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
