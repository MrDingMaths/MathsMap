        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+7}{6}$",
          "worked": "$$\\begin{align*}\\frac{x+1}{2}+\\frac{x+2}{3}&=\\frac{3(x+1)+2(x+2)}{6}\\\\\\frac{x+1}{2}+\\frac{x+2}{3}&=\\frac{3x+3+2x+4}{6}\\\\\\frac{x+1}{2}+\\frac{x+2}{3}&=\\frac{5x+7}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2x-1}{5}+\\frac{2x+3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{18x+11}{20}$",
          "worked": "$$\\begin{align*}\\frac{2x-1}{5}+\\frac{2x+3}{4}&=\\frac{4(2x-1)+5(2x+3)}{20}\\\\\\frac{2x-1}{5}+\\frac{2x+3}{4}&=\\frac{8x-4+10x+15}{20}\\\\\\frac{2x-1}{5}+\\frac{2x+3}{4}&=\\frac{18x+11}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x+3}{6}+\\frac{x-3}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+1}{4}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{6}+\\frac{x-3}{12}&=\\frac{2(x+3)+(x-3)}{12}\\\\\\frac{x+3}{6}+\\frac{x-3}{12}&=\\frac{2x+6+x-3}{12}\\\\\\frac{x+3}{6}+\\frac{x-3}{12}&=\\frac{3x+3}{12}\\\\\\frac{x+3}{6}+\\frac{x-3}{12}&=\\frac{x+1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x+2}{2}-\\frac{x+3}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
