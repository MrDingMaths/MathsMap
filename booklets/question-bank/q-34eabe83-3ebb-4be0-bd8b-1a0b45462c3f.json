  "content": {
    "id": "p39-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "A card is drawn from a standard pack.\nThe dealer tells the players that it is a court card (jack, queen or king).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that it is a jack?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q18-a-worked-counts",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "4 jacks, 12 court cards.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p39-q18-a-worked-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "P(J\\mid C)=\\frac{4}{12}=\\frac{1}{3}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that it is either a jack or a red card?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q18-b-worked-counts",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Jack or red court cards: 2 black jacks + 6 red court cards = 8.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p39-q18-b-worked-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "P(J\\cup R\\mid C)=\\frac{8}{12}=\\frac{2}{3}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p39-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the probability that the next card drawn is a jack?\nAssume that the first card was not replaced.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{153}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q18-c-worked-notation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "J_1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "J_2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " mean that the first and second cards are jacks, and let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "C_1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " mean that the first card is a court card.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p39-q18-c-worked-remaining",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Cards remaining: 51.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p39-q18-c-worked-jack-case",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "If the first card was a jack: 3 jacks left.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p39-q18-c-worked-other-case",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "If the first card was a queen or king: 4 jacks left.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p39-q18-c-worked-first-probabilities",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "P(J_1\\mid C_1)=\\frac{1}{3}",
                    "display": false
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "P(\\overline{J_1}\\mid C_1)=\\frac{2}{3}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p39-q18-c-worked-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(J_2\\mid C_1)&=\\frac{1}{3}\\times\\frac{3}{51}+\\frac{2}{3}\\times\\frac{4}{51}\\\\P(J_2\\mid C_1)&=\\frac{3}{153}+\\frac{8}{153}\\\\P(J_2\\mid C_1)&=\\frac{11}{153}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
