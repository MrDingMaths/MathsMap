  "content": {
    "id": "p50-q52-node",
    "type": "question",
    "label": "52",
    "prompt": "Let $f(x)=1-kx^2$, where $k>0$. Find the value of $k$ such that the tangents to the curve at the $x$-intercepts are perpendicular to each other.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p50-q52-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "k=\\frac14",
                "display": false
              }
            ]
          },
          {
            "id": "p50-q52-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The tangent gradients at the intercepts are ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\pm2\\sqrt{k}",
                "display": false
              },
              {
                "type": "text",
                "text": ", so their product is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "-4k=-1",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}1-kx^2&=0\\\\x&=\\pm\\frac1{\\sqrt{k}}\\\\f'(x)&=-2kx\\\\f'\\!\\left(\\frac1{\\sqrt{k}}\\right)&=-2\\sqrt{k}\\\\f'\\!\\left(-\\frac1{\\sqrt{k}}\\right)&=2\\sqrt{k}\\\\(-2\\sqrt{k})(2\\sqrt{k})&=-1\\\\-4k&=-1\\\\k&=\\frac14\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 72
