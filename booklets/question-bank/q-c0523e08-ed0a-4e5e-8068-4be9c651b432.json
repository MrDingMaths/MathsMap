  "content": {
    "id": "p3-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find a quadratic equation with integer coefficients whose solutions are:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=1$, $x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-3x+2=0$.",
          "worked": "An equation with these roots is\n$$\\begin{align*}(x-1)(x-2)&=0\\\\x^2-3x+2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=-2$, $x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-x-6=0$.",
          "worked": "An equation with these roots is\n$$\\begin{align*}(x+2)(x-3)&=0\\\\x^2-x-6&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=-3$, $x=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+7x+12=0$.",
          "worked": "An equation with these roots is\n$$\\begin{align*}(x+3)(x+4)&=0\\\\x^2+7x+12&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=\\frac12$, $x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2-5x+2=0$.",
          "worked": "Use $2x-1$ and $x-2$ as factors to obtain integer coefficients:\n$$\\begin{align*}(2x-1)(x-2)&=0\\\\2x^2-5x+2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$x=\\frac14$, $x=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x^2-6x+1=0$.",
          "worked": "Use $4x-1$ and $2x-1$ as factors to obtain integer coefficients:\n$$\\begin{align*}(4x-1)(2x-1)&=0\\\\8x^2-6x+1&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$x=-\\frac23$, $x=\\frac32$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2-5x-6=0$.",
          "worked": "Use $3x+2$ and $2x-3$ as factors to obtain integer coefficients:\n$$\\begin{align*}(3x+2)(2x-3)&=0\\\\6x^2-5x-6&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
