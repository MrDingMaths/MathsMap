  "content": {
    "id": "v2-p30-mixed-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Find the first term of each geometric series.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-p30-mixed-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The common ratio is $3$ and the sum of the first $4$ terms is $280$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=7$",
          "worked": "$$\\begin{align*}S_4&=\\frac{a(r^4-1)}{r-1}\\\\280&=\\frac{a(3^4-1)}{3-1}\\\\280&=\\frac{80a}{2}\\\\280&=40a\\\\a&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-p30-mixed-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The common ratio is $2$ and the sum of the first $8$ terms is $1275$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=5$",
          "worked": "$$\\begin{align*}S_8&=\\frac{a(r^8-1)}{r-1}\\\\1275&=\\frac{a(2^8-1)}{2-1}\\\\1275&=255a\\\\a&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
