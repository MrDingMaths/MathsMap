        "prompt": "$45$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45=43+2=41+4=37+8=29+16=13+32$; five pairs.",
          "worked": "$$\\begin{align*}45-2&=43\\\\45-4&=41\\\\45-8&=37\\\\45-16&=29\\\\45-32&=13\\end{align*}$$\nAll five differences are prime, giving five pairs. Larger powers of two exceed $45$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p16-obstinate-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$29$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$29=13+16$; one pair.",
          "worked": "$$\\begin{align*}29-2&=27\\\\29-4&=25\\\\29-8&=21\\\\29-16&=13\\end{align*}$$\nOnly $13$ is prime. Thus the only pair is $13+2^4$; the next power, $32$, exceeds $29$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p16-obstinate-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$59$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$59=43+16$; one pair.",
          "worked": "$$\\begin{align*}59-2&=57\\\\59-4&=55\\\\59-8&=51\\\\59-16&=43\\\\59-32&=27\\end{align*}$$\nOnly $43$ is prime. Thus the only pair is $43+2^4$; the next power, $64$, exceeds $59$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p16-obstinate-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$95$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$95=79+16=31+64$; two pairs.",
          "worked": "$$\\begin{align*}95-2&=93\\\\95-4&=91\\\\95-8&=87\\\\95-16&=79\\\\95-32&=63\\\\95-64&=31\\end{align*}$$\nOnly $79$ and $31$ are prime. The pairs are $79+2^4$ and $31+2^6$; the next power, $128$, exceeds $95$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
