    "type": "question",
    "label": "4",
    "prompt": "Which of the two points $M(3,6)$ and $N(6,-4)$ is closer to $P(-2,-1)$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$N$ is closer to $P$: $MP=\\sqrt{74}$ and $NP=\\sqrt{73}$.",
      "worked": "$$\\begin{align*}MP^2&=(3-(-2))^2+(6-(-1))^2\\\\MP^2&=25+49=74\\\\NP^2&=(6-(-2))^2+(-4-(-1))^2\\\\NP^2&=64+9=73\\end{align*}$$\nSince $\\sqrt{73}<\\sqrt{74}$, $N$ is closer to $P$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
