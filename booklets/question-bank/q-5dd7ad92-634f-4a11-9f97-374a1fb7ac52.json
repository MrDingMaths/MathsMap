  "content": {
    "id": "p40-q65-root",
    "type": "question",
    "label": "18",
    "prompt": "Let $x=1+\\dfrac{1}{1+\\dfrac{1}{1+\\cdots}}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q65-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x-1=\\dfrac1x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The repeated denominator is $x$, so $x=1+\\dfrac1x$ and $x-1=\\dfrac1x$.",
          "worked": "Interpret the fraction as the limit of its usual positive finite truncations. Its repeated denominator is $x$:\n$$\\begin{align*}x&=1+\\frac1x\\\\x-1&=\\frac1x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p40-q65-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find a simpler expression for $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{1+\\sqrt5}{2}$.",
          "worked": "$$\\begin{align*}x(x-1)&=1\\\\x^2-x-1&=0\\\\x&=\\frac{1\\pm\\sqrt5}{2}.\\end{align*}$$\nThe continued fraction is positive, so $x=\\dfrac{1+\\sqrt5}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
