  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The displacement $x$ m at time $t$ seconds $(t\\geq 0)$ of a particle moving in a straight line is given by $x=t^2-5t+4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "At what time is its velocity zero?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2.5\\text{ s}$",
          "worked": "$$\\begin{aligned}v(t)&=\\frac{dx}{dt}=2t-5\\\\2t-5&=0\\\\t&=\\frac{5}{2}\\text{ s}=2.5\\text{ s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p20-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the acceleration at this time?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2\\text{ m/s}^2$",
          "worked": "$$\\begin{aligned}a(t)&=\\frac{dv}{dt}=2\\\\a\\!\\left(\\frac{5}{2}\\right)&=2\\text{ m/s}^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p20-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the distance travelled in the first 4 seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.5\\text{ m}$",
          "worked": "The velocity is negative for $0\\leq t<\\frac{5}{2}$ and positive for $t>\\frac{5}{2}$, so the particle changes direction at $t=\\frac{5}{2}$ s.\n$$\\begin{aligned}x(0)&=4\\text{ m}\\\\x\\!\\left(\\frac{5}{2}\\right)&=\\left(\\frac{5}{2}\\right)^2-5\\left(\\frac{5}{2}\\right)+4\\\\x\\!\\left(\\frac{5}{2}\\right)&=-\\frac{9}{4}\\text{ m}\\\\x(4)&=4^2-5(4)+4=0\\text{ m}\\end{aligned}$$\n$$\\begin{aligned}\\text{Distance travelled}&=\\left|{-\\frac{9}{4}}-4\\right|+\\left|0-\\left(-\\frac{9}{4}\\right)\\right|\\\\\\text{Distance travelled}&=\\frac{25}{4}+\\frac{9}{4}\\\\\\text{Distance travelled}&=\\frac{17}{2}\\text{ m}=8.5\\text{ m}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p20-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "At what time is the velocity $8\\text{ m s}^{-1}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.5\\text{ s}$",
          "worked": "$$\\begin{aligned}v(t)&=2t-5\\\\2t-5&=8\\\\2t&=13\\\\t&=\\frac{13}{2}\\text{ s}=6.5\\text{ s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
