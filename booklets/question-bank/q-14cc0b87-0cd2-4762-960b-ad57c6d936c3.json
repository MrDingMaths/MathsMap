  "content": {
    "id": "p58-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "“fraction of” questions can be turned into multiplication.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{7}$ of $42$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}\\frac{3}{7}\\text{ of }42&=\\frac{3}{7}\\times\\frac{42}{1}\\\\&=\\frac{3}{1}\\times\\frac{6}{1}\\\\&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{4}$ of $32$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}\\frac{1}{4}\\text{ of }32&=\\frac{1}{4}\\times\\frac{32}{1}\\\\&=\\frac{1}{1}\\times\\frac{8}{1}\\\\&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{4}{5}$ of $120$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$96$",
          "worked": "$$\\begin{align*}\\frac{4}{5}\\text{ of }120&=\\frac{4}{5}\\times\\frac{120}{1}\\\\&=\\frac{4}{1}\\times\\frac{24}{1}\\\\&=96\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{7}$ of $77$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33$",
          "worked": "$$\\begin{align*}\\frac{3}{7}\\text{ of }77&=\\frac{3}{7}\\times\\frac{77}{1}\\\\&=\\frac{3}{1}\\times\\frac{11}{1}\\\\&=33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{5}{10}$ of $\\frac{4}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{7}$",
          "worked": "$$\\begin{align*}\\frac{5}{10}\\text{ of }\\frac{4}{7}&=\\frac{5}{10}\\times\\frac{4}{7}\\\\&=\\frac{1}{2}\\times\\frac{4}{7}\\\\&=\\frac{1}{1}\\times\\frac{2}{7}\\\\&=\\frac{2}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{6}{9}$ of $\\frac{3}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "$$\\begin{align*}\\frac{6}{9}\\text{ of }\\frac{3}{12}&=\\frac{6}{9}\\times\\frac{3}{12}\\\\&=\\frac{2}{3}\\times\\frac{1}{4}\\\\&=\\frac{1}{3}\\times\\frac{1}{2}\\\\&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{3}{4}$ of $\\frac{2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "$$\\begin{align*}\\frac{3}{4}\\text{ of }\\frac{2}{5}&=\\frac{3}{4}\\times\\frac{2}{5}\\\\&=\\frac{3}{2}\\times\\frac{1}{5}\\\\&=\\frac{3}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{2}{5}$ of $\\frac{10}{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{11}$",
          "worked": "$$\\begin{align*}\\frac{2}{5}\\text{ of }\\frac{10}{11}&=\\frac{2}{5}\\times\\frac{10}{11}\\\\&=\\frac{2}{1}\\times\\frac{2}{11}\\\\&=\\frac{4}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
