            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 17 p17-q3a-diagram\"}\n\\begin{tikzpicture}[font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (E) at (-2.8,0);\\coordinate (N) at (-1.471,0.266);\\coordinate (F) at (1.255,0.811);\\coordinate (P) at (-1.375,-0.600);\\coordinate (Q) at (0.464,-1.426);\n\\draw[line width=0.8pt] (0,0) circle (1.5) (E)--(F) (E)--(Q);\n\\path (E)--(N) node[midway,above] {$x$};\\path (N)--(F) node[midway,above] {$9$};\\path (E)--(P) node[midway,below] {$4$};\\path (P)--(Q) node[midway,above] {$5$};\n\\end{tikzpicture}",
