  "content": {
    "id": "p6-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Over the course of a year an employee is given successive salary increases of $4\\%$, $6\\%$ and $5\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "If the employee’s original monthly salary was $\\$2600$, what is the employee’s salary after the three increases? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$3009.55$ per month.",
          "worked": "$$\\begin{align*}\\text{New monthly salary}&=2600\\times1.04\\times1.06\\times1.05\\\\\\text{New monthly salary}&=3009.552\\\\\\text{New monthly salary}&\\approx\\$3009.55\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "What single percentage change is equivalent to the three successive salary increases?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15.752\\%$ increase.",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=1.04\\times1.06\\times1.05\\\\\\text{Combined multiplier}&=1.15752\\\\\\text{Percentage increase}&=(1.15752-1)\\times100\\%\\\\\\text{Percentage increase}&=15.752\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
