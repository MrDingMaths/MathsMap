  "content": {
    "id": "p14-q4-root",
    "type": "question",
    "label": "",
    "prompt": "Find the $x$-intercepts of the parabolas by completing the square.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+2x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1\\pm\\sqrt5$.",
          "worked": "$$\\begin{align*}y&=(x^2+2x+1)-1-4\\\\y&=(x+1)^2-5\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x+1)^2&=5\\\\x+1&=\\pm\\sqrt5\\\\x&=-1\\pm\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2-6x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3\\pm\\sqrt2$.",
          "worked": "$$\\begin{align*}y&=(x^2-6x+9)+7-9\\\\y&=(x-3)^2-2\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x-3)^2&=2\\\\x-3&=\\pm\\sqrt2\\\\x&=3\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p14-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2-8x+13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4\\pm\\sqrt3$.",
          "worked": "$$\\begin{align*}y&=(x^2-8x+16)+13-16\\\\y&=(x-4)^2-3\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x-4)^2&=3\\\\x-4&=\\pm\\sqrt3\\\\x&=4\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p14-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^2+4x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2\\pm2\\sqrt2$.",
          "worked": "$$\\begin{align*}y&=(x^2+4x+4)-4-4\\\\y&=(x+2)^2-8\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x+2)^2&=8\\\\x+2&=\\pm\\sqrt8\\\\x&=-2\\pm2\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p14-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^2+10x-11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-11,\\ 1$.",
          "worked": "$$\\begin{align*}y&=(x^2+10x+25)-25-11\\\\y&=(x+5)^2-36\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x+5)^2&=36\\\\x+5&=\\pm6\\\\x&=-5\\pm6\\\\x&=-11\\text{ or }1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p14-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=x^2-20x-50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10\\pm5\\sqrt6$.",
          "worked": "$$\\begin{align*}y&=(x^2-20x+100)-100-50\\\\y&=(x-10)^2-150\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x-10)^2&=150\\\\x-10&=\\pm\\sqrt{150}\\\\x&=10\\pm5\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p14-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=-x^2+12x+13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ 13$.",
          "worked": "$$\\begin{align*}y&=-(x^2-12x-13)\\\\y&=-[(x^2-12x+36)-36-13]\\\\y&=-(x-6)^2+49\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x-6)^2&=49\\\\x-6&=\\pm7\\\\x&=6\\pm7\\\\x&=-1\\text{ or }13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 61
      },
      {
        "id": "p14-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=-x^2+6x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3\\pm\\sqrt5$.",
          "worked": "$$\\begin{align*}y&=-(x^2-6x+4)\\\\y&=-[(x^2-6x+9)+4-9]\\\\y&=-(x-3)^2+5\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x-3)^2&=5\\\\x-3&=\\pm\\sqrt5\\\\x&=3\\pm\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p14-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=-x^2+4x+8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\pm2\\sqrt3$.",
          "worked": "$$\\begin{align*}y&=-(x^2-4x-8)\\\\y&=-[(x^2-4x+4)-4-8]\\\\y&=-(x-2)^2+12\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}(x-2)^2&=12\\\\x-2&=\\pm\\sqrt{12}\\\\x&=2\\pm2\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 61
