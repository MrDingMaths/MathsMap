  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The $n$th term of a sequence is given by $a_n=3n+1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Put $a_n=40$, find which term of the sequence 40 is.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40=a_{13}$",
          "worked": "$$\\begin{align*}40&=3n+1\\\\39&=3n\\\\n&=13\\end{align*}$$\n40 is the 13th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find whether 100, 200 and 1000 are terms of the sequence.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100=a_{33}$\n\n200 is not a term.\n\n$1000=a_{333}$",
          "worked": "For 100:\n$$\\begin{align*}100&=3n+1\\\\99&=3n\\\\n&=33\\end{align*}$$\n100 is the 33rd term.\n\nFor 200:\n$$\\begin{align*}200&=3n+1\\\\199&=3n\\\\n&=\\frac{199}{3}\\end{align*}$$\n200 is not a term because $n$ is not an integer.\n\nFor 1000:\n$$\\begin{align*}1000&=3n+1\\\\999&=3n\\\\n&=333\\end{align*}$$\n1000 is the 333rd term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
