  "content": {
    "id": "p5-p3-root",
    "type": "question",
    "label": "3",
    "prompt": "Suppose $p=\\dfrac{1}{a}$, $q=\\dfrac{1}{1-p}$ and $r=\\dfrac{q}{q-1}$. Show that $r=a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$r=a$ for $a\\ne0,1$.\n\nSubstitution gives $q=\\dfrac{a}{a-1}$ and $q-1=\\dfrac{1}{a-1}$.",
      "worked": "The given fractions require $a\\ne0,1$.\n\n$$\\begin{align*}q&=\\frac{1}{1-\\frac{1}{a}}\\\\q&=\\frac{a}{a-1}\\end{align*}$$\n\n$$\\begin{align*}q-1&=\\frac{a}{a-1}-1\\\\q-1&=\\frac{a-(a-1)}{a-1}\\\\q-1&=\\frac{1}{a-1}\\end{align*}$$\n\n$$\\begin{align*}r&=\\frac{\\frac{a}{a-1}}{\\frac{1}{a-1}}\\\\r&=\\frac{a}{1}\\\\r&=a\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 37
  },
