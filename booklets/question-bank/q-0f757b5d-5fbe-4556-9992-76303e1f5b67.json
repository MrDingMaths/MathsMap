    "label": "18",
    "prompt": "The average of $x$, 2, and 5 is $\\frac{5}{2}$. Find $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac{1}{2}$",
      "worked": "$$\\begin{align*}\\frac{x+2+5}{3}&=\\frac{5}{2}\\\\x+7&=\\frac{15}{2}\\\\x&=\\frac{15}{2}-7\\\\x&=\\frac{1}{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
