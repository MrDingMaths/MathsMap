  "content": {
    "id": "p10-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "For two events $A$ and $B$ it is known that $A\\cap B=A\\cup B$. What can be said about $A$ and $B$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$A=B$.",
      "worked": "Every element of $A$ belongs to $A\\cup B$, hence to $A\\cap B$, so it also belongs to $B$. Thus $A\\subseteq B$. Similarly, $B\\subseteq A$. Therefore, $A=B$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
