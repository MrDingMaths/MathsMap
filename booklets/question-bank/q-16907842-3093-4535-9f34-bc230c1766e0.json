  "content": {
    "id": "v2-c-p54-applications-slot-9-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A stone is thrown from a bridge over the Yarra River. Its height, $h$ metres, above the water $t$ seconds after it is thrown is given by $h=-5t^2+10t+15$. After how many seconds does the stone hit the water?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "3 seconds.",
      "worked": "The stone hits the water when $h=0$.\n$$\\begin{align*}-5t^2+10t+15&=0\\\\t^2-2t-3&=0\\\\(t-3)(t+1)&=0\\\\t&=3\\text{ or }-1\\end{align*}$$\nTime cannot be negative, so the stone hits the water after 3 seconds.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
