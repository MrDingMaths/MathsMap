  "content": {
    "id": "p28-p3-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider the curve $y=(x+1)\\sqrt{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-p3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y'=\\frac{3x+1}{2\\sqrt{x}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{3x+1}{2\\sqrt{x}}$ for $x>0$, by the product rule.",
          "worked": "For $x>0$, the product rule gives\n\n$$\\begin{align*}y'&=\\sqrt{x}+\\frac{x+1}{2\\sqrt{x}}\\\\y'&=\\frac{2x+(x+1)}{2\\sqrt{x}}\\\\y'&=\\frac{3x+1}{2\\sqrt{x}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p28-p3-b",
        "type": "part",
        "label": "b",
        "prompt": "Bob claims that there is therefore a stationary point at $x=-\\frac{1}{3}$. Mary claims that there is no stationary point. Who is correct, and why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mary is correct. The proposed value $x=-\\frac{1}{3}$ is outside the domain, and the derivative is undefined at $x=0$.",
          "worked": "The curve is defined for $x\\ge 0$. For $x>0$, the derivative can be zero only if $3x+1=0$, which gives $x=-\\frac{1}{3}$ outside the domain. At $x=0$ the derivative is undefined. There is no stationary point, so Mary is correct.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
