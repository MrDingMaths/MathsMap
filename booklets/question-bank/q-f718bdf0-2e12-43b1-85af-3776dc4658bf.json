      {
        "id": "p39-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f'(x)=\\pi\\cos\\pi x$ and $f(0)=0$, find $f(x)$ and $f\\left(\\frac13\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\sin\\pi x$; $f\\left(\\frac13\\right)=\\frac{\\sqrt3}{2}$.",
          "worked": "$$\\begin{aligned}f(x)&=\\int\\pi\\cos\\pi x\\,dx\\\\&=\\sin\\pi x+C.\\end{aligned}$$\nUsing $f(0)=0$:\n$$\\begin{aligned}\\sin0+C&=0\\\\C&=0.\\end{aligned}$$\n$$\\begin{aligned}f(x)&=\\sin\\pi x\\\\f\\left(\\frac13\\right)&=\\sin\\left(\\frac\\pi3\\right)\\\\&=\\frac{\\sqrt3}{2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p39-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If $f'(x)=\\cos\\pi x$ and $f(0)=\\frac{1}{2\\pi}$, find $f(x)$ and $f\\left(\\frac16\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\frac{1}{2\\pi}+\\frac1\\pi\\sin\\pi x$; $f\\left(\\frac16\\right)=\\frac1\\pi$.",
          "worked": "$$\\begin{aligned}f(x)&=\\int\\cos\\pi x\\,dx\\\\&=\\frac1\\pi\\sin\\pi x+C.\\end{aligned}$$\nUsing $f(0)=\\frac{1}{2\\pi}$:\n$$\\begin{aligned}\\frac1\\pi\\sin0+C&=\\frac{1}{2\\pi}\\\\C&=\\frac{1}{2\\pi}.\\end{aligned}$$\n$$\\begin{aligned}f(x)&=\\frac{1}{2\\pi}+\\frac1\\pi\\sin\\pi x\\\\f\\left(\\frac16\\right)&=\\frac{1}{2\\pi}+\\frac1\\pi\\sin\\left(\\frac\\pi6\\right)\\\\&=\\frac1\\pi.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
