  "content": {
    "id": "p18-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Check whether or not each of these points lies on the line with equation $y=-2x+3$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3,9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=9\\\\\\mathrm{RHS}&=-2(3)+3\\\\\\mathrm{RHS}&=-3\\end{align*}$$\nSince $9\\ne-3$, the point does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-2,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=7\\\\\\mathrm{RHS}&=-2(-2)+3\\\\\\mathrm{RHS}&=7\\end{align*}$$\nSince LHS equals RHS, the point lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(-1,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=5\\\\\\mathrm{RHS}&=-2(-1)+3\\\\\\mathrm{RHS}&=5\\end{align*}$$\nSince LHS equals RHS, the point lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q3-d",
        "type": "part",
