    "id": "p14-point-membership-b",
    "type": "question",
    "label": "2",
    "prompt": "Determine if y=-3x-3 contains the point (-1,0).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes.",
      "worked": "For $x=-1$,\n$$\\begin{align*}-3x-3&=-3(-1)-3\\\\-3x-3&=0.\\end{align*}$$\nThis equals the given $y$-coordinate, so $(-1,0)$ lies on the line.",
      "solutionDiagrams": []
    },
