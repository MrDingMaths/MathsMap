        "type": "part",
        "label": "a",
        "prompt": "The radius of a circle is 6 cm. Calculate the area of the circle.\nLeave your answer in terms of $\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p22-q7a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 22 p22-q7a-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black] (0,0) circle (1.5);\n\\draw[black,line width=0.4pt] (0,0)--(1.5,0) node[midway,above] {$6\\text{ cm}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 35,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 22,
