        ],
        "children": [],
        "answer": {
          "short": "$36\\pi\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A &= \\pi r^2\\\\A &= \\pi(6)^2\\\\A &= 36\\pi\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p22-q7b",
        "type": "part",
        "label": "b",
        "prompt": "Shown is a face of a cylinder with a height of 10 cm. Calculate the exact surface area of the cylinder.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p22-q7b-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 22 p22-q7b-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black] (0,0) circle (1.5);\n\\draw[black,line width=0.4pt] (-1.5,0)--(1.5,0) node[midway,above] {$12\\text{ cm}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 35,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 22,
              "sourceRegion": "Question 7b",
              "description": "Circular face with a complete horizontal diameter.",
              "mathematics": "Diameter 12 cm; cylinder height 10 cm is given in the prompt.",
              "answerVisibility": "Only the supplied diameter is visible."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$192\\pi\\text{ cm}^2$",
          "worked": "$$\\begin{align*}r &= \\frac{12}{2}=6\\text{ cm}\\\\A &= 2\\pi r^2+2\\pi rh\\\\A &= 2\\pi(6)^2+2\\pi(6)(10)\\\\A &= 192\\pi\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q7c",
        "type": "part",
        "label": "c",
        "prompt": "The circumference of a circle shown is $7\\pi$ cm. Calculate the area of the shaded region in terms of $\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p22-q7c-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"templateShade\",\"hex\":\"D4E8FF\",\"reason\":\"The lower-right quarter is the region whose area must be calculated.\"}],\"reference\":\"template p22-q7c-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{templateShade}{HTML}{D4E8FF}\n\\path[use as bounding box] (-0.6,-9.6) rectangle (18.6,9.6);\n\\fill[templateShade] (9,0)--++(0:9) arc[start angle=0,end angle=-90,radius=9]--cycle;\n\\draw[black,line width=0.4pt] (9,0)--++(90:9);\n\\draw[black,line width=0.4pt] (9,0)--++(0:9);\n\\draw[black,line width=0.4pt] (9,0)--++(-90:9);\n\\draw[black,line width=0.4pt] (9,0)--++(-180:9);\n\\draw[black,line width=0.8pt] (9,0) circle[radius=9];\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 19.2,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 22,
              "sourceRegion": "Question 7c",
              "description": "Circle with its lower-right quarter shaded, bounded by horizontal and vertical radii and the circular arc.",
              "mathematics": "Shaded fraction is one quarter; circumference is 7π cm.",
              "answerVisibility": "The shaded region is a given; no calculated measurements are visible.",
              "template": {
                "version": 1,
                "family": "fraction-circle",
                "sectors": 4,
                "shaded": [
                  1
                ],
                "shadeReason": "The lower-right quarter is the region whose area must be calculated."
              }
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$\\frac{49\\pi}{16}\\text{ cm}^2$",
          "worked": "$$\\begin{align*}C &= 2\\pi r\\\\7\\pi &= 2\\pi r\\\\r &= 3.5\\text{ cm}\\\\A_{\\text{shaded}} &= \\frac{\\pi r^2}{4}\\\\A_{\\text{shaded}} &= \\frac{\\pi(3.5)^2}{4}\\\\A_{\\text{shaded}} &= \\frac{49\\pi}{16}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
