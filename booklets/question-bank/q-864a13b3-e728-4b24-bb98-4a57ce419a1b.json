  "content": {
    "id": "v2-2e68c-p55-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the tangent to the curve $y=\\dfrac{1}{(2x-1)^2}$ at the point where $x=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4x+y-5=0$",
      "worked": "$$\\begin{align*}y&=(2x-1)^{-2}\\\\\\frac{dy}{dx}&=-2(2x-1)^{-3}\\times2\\\\\\frac{dy}{dx}&=-\\frac{4}{(2x-1)^3}\\end{align*}$$\nAt $x=1$:\n$$\\begin{align*}m&=-\\frac{4}{(2(1)-1)^3}=-4\\\\y(1)&=\\frac{1}{(2(1)-1)^2}=1\\end{align*}$$\nThe tangent passes through $(1,1)$:\n$$\\begin{align*}y-1&=-4(x-1)\\\\y&=-4x+5\\\\4x+y-5&=0\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
