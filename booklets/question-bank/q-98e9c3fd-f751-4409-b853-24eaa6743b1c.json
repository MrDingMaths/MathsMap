  "content": {
    "id": "p50-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Let $\\alpha$ and $\\beta$ be roots of $x^2+5x-3=0$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q24a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}\\alpha+\\beta&=-\\frac{5}{1}\\\\\\alpha+\\beta&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-q24b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}\\alpha\\beta&=\\frac{-3}{1}\\\\\\alpha\\beta&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-q24c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{\\alpha}+\\dfrac{1}{\\beta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\alpha}+\\frac{1}{\\beta}&=\\frac{\\alpha+\\beta}{\\alpha\\beta}\\\\\\frac{1}{\\alpha}+\\frac{1}{\\beta}&=\\frac{-5}{-3}\\\\\\frac{1}{\\alpha}+\\frac{1}{\\beta}&=\\frac{5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p50-q24d",
        "type": "part",
        "label": "d",
        "prompt": "$\\alpha^2+\\beta^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31$",
          "worked": "$$\\begin{align*}\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\\\alpha^2+\\beta^2&=(-5)^2-2(-3)\\\\\\alpha^2+\\beta^2&=31\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
