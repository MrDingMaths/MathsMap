  "content": {
    "id": "p30-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "$X\\sim\\operatorname{Bin}(6,0.3)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $\\binom62=\\binom64$ without evaluating.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Choosing the 2 successes determines the 4 failures, so the counts are equal.",
          "worked": "Every choice of 2 successful trials from the 6 leaves exactly 4 failed trials. Conversely, choosing the 4 failed trials determines the 2 successful trials. Thus both combinations count the same arrangements.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $P(X=2)$ and $P(X=4)$, correct to four decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(X=2)\\approx0.3241$; $P(X=4)\\approx0.0595$.",
          "worked": "$$\\begin{aligned}P(X=2)&=\\binom62(0.3)^2(0.7)^4\\\\&=0.324135\\approx0.3241.\\end{aligned}$$\n$$\\begin{aligned}P(X=4)&=\\binom64(0.3)^4(0.7)^2\\\\&=0.059535\\approx0.0595.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p30-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "The counting factors are equal. Explain why the two probabilities are not.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Success and failure have different probabilities, so arrangements with 2 successes and with 4 successes have different probabilities.",
          "worked": "The counting factor is 15 in both cases, but the probability of each arrangement differs:\n$$\\begin{aligned}(0.3)^2(0.7)^4&=0.021609,\\\\(0.3)^4(0.7)^2&=0.003969.\\end{aligned}$$\nSuccess has probability $0.3$ and failure has probability $0.7$. The two binomial probabilities would be equal if success and failure were equally likely.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
