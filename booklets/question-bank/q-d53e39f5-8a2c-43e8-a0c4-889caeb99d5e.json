              {
                "type": "text",
                "text": "Find the positive radius from ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "A=\\tfrac12 r^2\\theta",
                "display": false
              },
              {
                "type": "text",
                "text": ", then use ",
