  "content": {
    "id": "p4-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the equations of the circles that match each of the following descriptions:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "A circle has radius $1$ and centre $(0,0)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=1^2$",
          "worked": "Using $(x-a)^2+(y-b)^2=r^2$,\n$$\\begin{align*}(x-0)^2+(y-0)^2&=1^2\\\\x^2+y^2&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "A circle has radius $2$ and centre $(3,4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2+(y-4)^2=2^2$",
          "worked": "Using $(x-a)^2+(y-b)^2=r^2$,\n$$\\begin{align*}(x-3)^2+(y-4)^2&=2^2\\\\(x-3)^2+(y-4)^2&=4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "A circle has radius $3$ and centre $(-2,3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2+(y-3)^2=3^2$",
          "worked": "Using $(x-a)^2+(y-b)^2=r^2$,\n$$\\begin{align*}(x-(-2))^2+(y-3)^2&=3^2\\\\(x+2)^2+(y-3)^2&=9.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "A circle has radius $4$ and centre $(2,-4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2+(y+4)^2=4^2$",
          "worked": "Using $(x-a)^2+(y-b)^2=r^2$,\n$$\\begin{align*}(x-2)^2+(y-(-4))^2&=4^2\\\\(x-2)^2+(y+4)^2&=16.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "A circle has radius $5$ and centre $(-2,-4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2+(y+4)^2=5^2$",
          "worked": "Using $(x-a)^2+(y-b)^2=r^2$,\n$$\\begin{align*}(x-(-2))^2+(y-(-4))^2&=5^2\\\\(x+2)^2+(y+4)^2&=25.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
