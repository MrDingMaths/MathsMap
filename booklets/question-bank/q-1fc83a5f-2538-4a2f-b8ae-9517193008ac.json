        "answer": {
          "short": "$2x^3-6x+12$",
          "worked": "$$\\begin{align*}P(x)-Q(x)&=(5x^3-2x+7)-(3x^3+4x-5)\\\\P(x)-Q(x)&=5x^3-2x+7-3x^3-4x+5\\\\P(x)-Q(x)&=2x^3-6x+12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-task-11-13-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=-x^2+6x-9,\\quad Q(x)=4x^2-x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5x^2+7x-10$",
          "worked": "$$\\begin{align*}P(x)-Q(x)&=(-x^2+6x-9)-(4x^2-x+1)\\\\P(x)-Q(x)&=-x^2+6x-9-4x^2+x-1\\\\P(x)-Q(x)&=-5x^2+7x-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
