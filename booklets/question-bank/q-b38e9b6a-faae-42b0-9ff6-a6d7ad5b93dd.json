    "type": "question",
    "label": "44",
    "prompt": "Rationalise the denominator of the following. $$\\frac{2+\\sqrt6}{3-\\sqrt3}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1+\\dfrac{\\sqrt3}{3}+\\dfrac{\\sqrt6}{2}+\\dfrac{\\sqrt2}{2}$",
      "worked": "$$\\begin{align*}\\frac{2+\\sqrt6}{3-\\sqrt3}&=\\frac{(2+\\sqrt6)(3+\\sqrt3)}{(3-\\sqrt3)(3+\\sqrt3)}\\\\\\frac{2+\\sqrt6}{3-\\sqrt3}&=\\frac{6+2\\sqrt3+3\\sqrt6+\\sqrt{18}}{9-3}\\\\\\frac{2+\\sqrt6}{3-\\sqrt3}&=\\frac{6+2\\sqrt3+3\\sqrt6+3\\sqrt2}{6}\\\\\\frac{2+\\sqrt6}{3-\\sqrt3}&=1+\\frac{\\sqrt3}{3}+\\frac{\\sqrt6}{2}+\\frac{\\sqrt2}{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
