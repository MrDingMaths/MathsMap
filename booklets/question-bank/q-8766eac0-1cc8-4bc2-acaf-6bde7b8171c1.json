  "content": {
    "id": "p63-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Show that $\\dfrac{d}{dx}(\\sin x-x\\cos x)=x\\sin x$, and hence find $\\displaystyle\\int_0^{\\pi/2}x\\sin x\\,dx$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
