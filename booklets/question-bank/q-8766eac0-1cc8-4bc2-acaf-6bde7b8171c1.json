            "inlines": [
              {
                "type": "math",
                "latex": "\\dfrac{d}{dx}(\\sin x-x\\cos x)=\\cos x-(\\cos x-x\\sin x)=x\\sin x",
                "display": true
              }
            ]
          },
          {
            "id": "p63-q23-completion-short-1",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 1,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\displaystyle\\int_0^{\\pi/2}x\\sin x\\,dx=1",
                "display": true
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\frac{d}{dx}(\\sin x-x\\cos x)&=\\cos x-(\\cos x-x\\sin x)\\\\&=\\cos x-\\cos x+x\\sin x\\\\&=x\\sin x.\\end{align*}$$\n\n$$\\begin{align*}\\int_0^{\\pi/2}x\\sin x\\,dx&=\\left[\\sin x-x\\cos x\\right]_0^{\\pi/2}\\\\&=(1-0)-(0-0)\\\\&=1.\\end{align*}$$",
      "solutionDiagrams": []
    },
