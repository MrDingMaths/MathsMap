      {
        "id": "p28-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the substitution $u=2^x$ to solve $4^x-9\\times2^x+14=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $x=\\log_2 7$.",
          "worked": "Let $u=2^x$, so $4^x=u^2$.\n$$\\begin{align*}u^2-9u+14&=0\\\\(u-7)(u-2)&=0\\\\u&=7\\text{ or }2\\\\2^x&=7\\text{ or }2\\\\x&=\\log_2 7\\text{ or }1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p28-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the substitution $u=3^x$ to solve $3^{2x}-8\\times3^x-9=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$.",
          "worked": "Let $u=3^x>0$, so $3^{2x}=u^2$.\n$$\\begin{align*}u^2-8u-9&=0\\\\(u-9)(u+1)&=0\\\\u&=9\\text{ or }-1\\end{align*}$$\nReject $u=-1$ because $3^x>0$.\n$$\\begin{align*}3^x&=9\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p28-q5-c",
        "type": "group",
        "label": "c",
        "prompt": "Use similar substitutions to solve:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p28-q5-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$25^x-26\\times5^x+25=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=2$ or $x=0$.",
              "worked": "Let $u=5^x$, so $25^x=u^2$.\n$$\\begin{align*}u^2-26u+25&=0\\\\(u-25)(u-1)&=0\\\\u&=25\\text{ or }1\\\\5^x&=25\\text{ or }1\\\\x&=2\\text{ or }0\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 56
          },
          {
            "id": "p28-q5-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$9^x-5\\times3^x+4=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=0$ or $x=\\log_3 4$.",
              "worked": "Let $u=3^x$, so $9^x=u^2$.\n$$\\begin{align*}u^2-5u+4&=0\\\\(u-4)(u-1)&=0\\\\u&=4\\text{ or }1\\\\3^x&=4\\text{ or }1\\\\x&=\\log_3 4\\text{ or }0\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 56
          },
          {
            "id": "p28-q5-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$3^{2x}-3^x-20=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\log_3 5$.",
              "worked": "Let $u=3^x>0$.\n$$\\begin{align*}u^2-u-20&=0\\\\(u-5)(u+4)&=0\\\\u&=5\\text{ or }-4\\end{align*}$$\nReject $u=-4$ because $3^x>0$.\n$$\\begin{align*}3^x&=5\\\\x&=\\log_3 5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 64
          },
          {
            "id": "p28-q5-c-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$7^{2x}+7^x+1=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "No real solutions.",
              "worked": "Let $u=7^x>0$. The equation becomes $u^2+u+1=0$.\n$$\\begin{align*}\\Delta&=1^2-4(1)(1)\\\\\\Delta&=-3\\end{align*}$$\nThe quadratic has no real roots, so there are no real values of $x$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
          {
            "id": "p28-q5-c-v",
            "type": "part",
            "label": "v",
            "prompt": "$2^{2x}-64=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=3$.",
              "worked": "Let $u=2^x>0$.\n$$\\begin{align*}u^2-64&=0\\\\(u-8)(u+8)&=0\\\\u&=8\\text{ or }-8\\end{align*}$$\nReject $u=-8$ because $2^x>0$.\n$$\\begin{align*}2^x&=8\\\\x&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 64
          },
          {
            "id": "p28-q5-c-vi",
            "type": "part",
            "label": "vi",
            "prompt": "$2^x-3\\times2^{\\frac12x}+2=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=2$ or $x=0$.",
              "worked": "Let $u=2^{x/2}$, so $2^x=u^2$.\n$$\\begin{align*}u^2-3u+2&=0\\\\(u-2)(u-1)&=0\\\\u&=2\\text{ or }1\\\\2^{x/2}&=2\\text{ or }1\\\\\\frac{x}{2}&=1\\text{ or }0\\\\x&=2\\text{ or }0\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 64
          }
        ]
