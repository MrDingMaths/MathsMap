  "content": {
    "id": "p81-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A parabolic bridge arch has a span of $24$ metres and a maximum height of $9$ metres at its centre. Let $x$ be the distance from the left end of the arch.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p81-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an equation for the arch.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=-\\dfrac{1}{16}x(x-24)=-\\dfrac{1}{16}(x-12)^2+9$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p81-q12-a-answer-intro",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The arch has roots 0 and 24, so",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p81-q12-a-answer-model",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "h=ax(x-24)",
                    "display": true
                  }
                ]
              },
              {
                "id": "p81-q12-a-answer-vertex",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Its vertex is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(12,9)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", hence",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p81-q12-a-answer-coefficient",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}9&=a(12)(-12)\\\\9&=-144a\\\\a&=-\\frac{1}{16}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p81-q12-a-answer-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}h&=-\\frac{1}{16}x(x-24)\\\\h&=-\\frac{1}{16}(x-12)^2+9\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p81-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "A flat-topped truck is $6$ metres wide and travels exactly through the centre of the arch. Find the maximum possible height of the truck. Give the answer exactly and to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{135}{16}\\text{ m}\\approx8.44\\text{ m}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p81-q12-b-answer-intro",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "A centred truck of width 6 metres has outer edges at",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p81-q12-b-answer-edges",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x=12\\pm3",
                    "display": true
                  }
                ]
              },
              {
                "id": "p81-q12-b-answer-symmetry",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "So ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=9",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=15",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". The arch has the same height at both edges:",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p81-q12-b-answer-substitution",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}h(9)&=-\\frac{1}{16}(9-12)^2+9\\\\h(9)&=9-\\frac{9}{16}\\\\h(9)&=\\frac{135}{16}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p81-q12-b-answer-clearance",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "This edge clearance determines the greatest possible truck height.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p81-q12-b-answer-result-intro",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The maximum truck height is",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p81-q12-b-answer-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{135}{16}\\text{ m}=8.4375\\text{ m}\\approx8.44\\text{ m}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
