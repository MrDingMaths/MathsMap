  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the percentage error for an object measured as 13.0 cm, to the nearest 0.5 cm.\nAnswer to 2 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1.92\\%$",
      "worked": "$$\\begin{aligned}\\text{Precision} &=0.5\\text{ cm}\\\\\\text{Absolute error} &=\\tfrac12\\times0.5=0.25\\text{ cm}\\\\\\text{Percentage error} &=\\frac{0.25}{13.0}\\times100\\%\\\\\\text{Percentage error} &\\approx1.92\\%\\quad\\text{(2 d.p.)}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
