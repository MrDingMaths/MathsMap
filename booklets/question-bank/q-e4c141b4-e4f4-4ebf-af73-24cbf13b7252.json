  "content": {
    "id": "p51-task55-60",
    "type": "question",
    "label": null,
    "prompt": "Use the discriminant to determine the number of distinct solutions to the following quadratic equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-task55-60-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+6x+9=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "One distinct real solution (a double root); $\\Delta=0$.",
          "worked": "$$\\begin{align*}\\Delta &= 6^2-4(1)(9)\\\\\\Delta &= 0\\end{align*}$$\n\nThere is one distinct real solution (a double root).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-task55-60-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+7x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two distinct real solutions; $\\Delta=57>0$.",
          "worked": "$$\\begin{align*}\\Delta &= 7^2-4(1)(-2)\\\\\\Delta &= 57>0\\end{align*}$$\n\nThere are two distinct real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-task55-60-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+3x+10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solutions; $\\Delta=-31<0$.",
          "worked": "$$\\begin{align*}\\Delta &= 3^2-4(1)(10)\\\\\\Delta &= -31<0\\end{align*}$$\n\nThere are no real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-task55-60-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2-4x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "One distinct real solution (a double root); $\\Delta=0$.",
          "worked": "$$\\begin{align*}\\Delta &= (-4)^2-4(4)(1)\\\\\\Delta &= 0\\end{align*}$$\n\nThere is one distinct real solution (a double root).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-task55-60-e",
        "type": "part",
        "label": "e",
        "prompt": "$2x^2+8x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two distinct real solutions; $\\Delta=32>0$.",
          "worked": "$$\\begin{align*}\\Delta &= 8^2-4(2)(4)\\\\\\Delta &= 32>0\\end{align*}$$\n\nThere are two distinct real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-task55-60-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x^2+7x+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solutions; $\\Delta=-11<0$.",
          "worked": "$$\\begin{align*}\\Delta &= 7^2-4(3)(5)\\\\\\Delta &= -11<0\\end{align*}$$\n\nThere are no real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
