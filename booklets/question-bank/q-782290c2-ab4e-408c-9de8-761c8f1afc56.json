  "content": {
    "id": "v2-multistep-practice-slot-17-root",
    "type": "question",
    "label": null,
    "prompt": "$(15,36,n)$ is a Pythagorean triad. Find the value(s) of $n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=39$ only. Taking $n$ as a shorter side gives $\\sqrt{1071}$, which is not a whole number.",
      "worked": "If $n$ is the largest number:\n$$\\begin{align*}15^2+36^2&=n^2\\\\n^2&=225+1296\\\\n^2&=1521\\\\n&=39\\end{align*}$$\nIf $36$ is the largest number:\n$$\\begin{align*}15^2+n^2&=36^2\\\\n^2&=36^2-15^2\\\\n^2&=1296-225\\\\n^2&=1071\\\\n&=\\sqrt{1071}\\end{align*}$$\nSince $32^2<1071<33^2$, $\\sqrt{1071}$ is not a whole number. Therefore, $n=39$ is the only answer.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
