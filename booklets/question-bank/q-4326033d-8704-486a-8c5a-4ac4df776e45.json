  "content": {
    "id": "p32-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve these equations using the elimination method.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}2x+3y&=18\\\\6x+3y&=30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=4$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(6x+3y)-(2x+3y)&=30-18\\\\4x&=12\\\\x&=3\\end{align*}$$\nSubstitute $x=3$ into the first equation.\n$$\\begin{align*}2(3)+3y&=18\\\\3y&=12\\\\y&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}2x+3y&=18\\\\6x-3y&=30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6,\\ y=2$",
          "worked": "Add the equations.\n$$\\begin{align*}(2x+3y)+(6x-3y)&=18+30\\\\8x&=48\\\\x&=6\\end{align*}$$\nSubstitute $x=6$ into the first equation.\n$$\\begin{align*}2(6)+3y&=18\\\\3y&=6\\\\y&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}2x+y&=18\\\\6x-y&=30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6,\\ y=6$",
          "worked": "Add the equations.\n$$\\begin{align*}(2x+y)+(6x-y)&=18+30\\\\8x&=48\\\\x&=6\\end{align*}$$\nSubstitute $x=6$ into the first equation.\n$$\\begin{align*}2(6)+y&=18\\\\y&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p32-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}2x-y&=18\\\\6x-y&=30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=-12$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(6x-y)-(2x-y)&=30-18\\\\4x&=12\\\\x&=3\\end{align*}$$\nSubstitute $x=3$ into the first equation.\n$$\\begin{align*}2(3)-y&=18\\\\-y&=12\\\\y&=-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}y+2x&=18\\\\y+6x&=30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=12$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(y+6x)-(y+2x)&=30-18\\\\4x&=12\\\\x&=3\\end{align*}$$\nSubstitute $x=3$ into the first equation.\n$$\\begin{align*}y+2(3)&=18\\\\y&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p32-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}y+2x&=-18\\\\y+6x&=30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=12,\\ y=-42$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(y+6x)-(y+2x)&=30-(-18)\\\\4x&=48\\\\x&=12\\end{align*}$$\nSubstitute $x=12$ into the first equation.\n$$\\begin{align*}y+2(12)&=-18\\\\y&=-42\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p32-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}2x+y&=-18\\\\6x-y&=-30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6,\\ y=-6$",
          "worked": "Add the equations.\n$$\\begin{align*}(2x+y)+(6x-y)&=-18+(-30)\\\\8x&=-48\\\\x&=-6\\end{align*}$$\nSubstitute $x=-6$ into the first equation.\n$$\\begin{align*}2(-6)+y&=-18\\\\y&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p32-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}2x+4y&=-18\\\\2x-4y&=-30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-12,\\ y=\\frac{3}{2}$",
          "worked": "Add the equations.\n$$\\begin{align*}(2x+4y)+(2x-4y)&=-18+(-30)\\\\4x&=-48\\\\x&=-12\\end{align*}$$\nSubstitute $x=-12$ into the first equation.\n$$\\begin{align*}2(-12)+4y&=-18\\\\4y&=6\\\\y&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p32-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\begin{aligned}x+4y&=-18\\\\2x-4y&=-30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-16,\\ y=-\\frac{1}{2}$",
          "worked": "Add the equations.\n$$\\begin{align*}(x+4y)+(2x-4y)&=-18+(-30)\\\\3x&=-48\\\\x&=-16\\end{align*}$$\nSubstitute $x=-16$ into the first equation.\n$$\\begin{align*}-16+4y&=-18\\\\4y&=-2\\\\y&=-\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
