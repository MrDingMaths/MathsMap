  "content": {
    "id": "p41-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the surface area of a hemisphere whose volume is $18\\pi\\text{ cm}^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$27\\pi\\text{ cm}^2$",
      "worked": "$$\\begin{align*}\\frac{2}{3}\\pi r^3&=18\\pi\\\\r^3&=27\\\\r&=3\\text{ cm}\\end{align*}$$\nInclude the curved surface and circular base.\n$$\\begin{align*}A&=2\\pi r^2+\\pi r^2\\\\A&=3\\pi(3)^2\\\\A&=27\\pi\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
