  "content": {
    "id": "v2-1e331-p64-practice-slot-13-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Determine the $x$ values for which the $y$ value is defined.\n$$y=\\sqrt{x^2-5x+6}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x\\le2$ or $x\\ge3$.",
      "worked": "The expression inside the square root must be greater than or equal to zero.\n$$\\begin{aligned}x^2-5x+6&\\ge0\\\\(x-2)(x-3)&\\ge0.\\end{aligned}$$\nThe upward-opening parabola has $x$-intercepts $2$ and $3$. It is on or above the $x$-axis outside these intercepts, so $x\\le2$ or $x\\ge3$.",
      "solutionDiagrams": []
    },
