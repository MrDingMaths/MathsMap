        "children": [],
        "answer": {
          "short": "$-\\sin\\theta$",
          "worked": "$$\\begin{align*}\\cos(90^\\circ+\\theta)&=\\cos(90^\\circ-(-\\theta))\\\\\\cos(90^\\circ+\\theta)&=\\sin(-\\theta)\\\\\\cos(90^\\circ+\\theta)&=-\\sin\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-ap-31-48-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(90^\\circ+\\theta)$",
