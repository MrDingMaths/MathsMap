        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta$",
          "worked": "$$\\begin{align*}\\sin(90^\\circ+\\theta)&=\\sin(90^\\circ-(-\\theta))\\\\\\sin(90^\\circ+\\theta)&=\\cos(-\\theta)\\\\\\sin(90^\\circ+\\theta)&=\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-ap-31-48-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos(90^\\circ+\\theta)$",
        "layout": "list",
        "columns": null,
