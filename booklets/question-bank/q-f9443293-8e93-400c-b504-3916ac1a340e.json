  "content": {
    "id": "p28-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "How many zeros are there in each number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^2\\times5^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 zeros.",
          "worked": "$$\\begin{align*}2^2\\times5^2&=(2\\times5)(2\\times5)\\\\2^2\\times5^2&=10^2\\\\2^2\\times5^2&=100\\end{align*}$$\n\nThere are 2 zeros.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^3\\times5^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 zeros.",
          "worked": "$$\\begin{align*}2^3\\times5^3&=(2\\times5)(2\\times5)(2\\times5)\\\\2^3\\times5^3&=10^3\\\\2^3\\times5^3&=1000\\end{align*}$$\n\nThere are 3 zeros.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^4\\times5^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 zeros.",
          "worked": "$$\\begin{align*}2^4\\times5^3&=2\\times(2\\times5)(2\\times5)(2\\times5)\\\\2^4\\times5^3&=2\\times10^3\\\\2^4\\times5^3&=2000\\end{align*}$$\n\nThere are 3 zeros.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$2^3\\times5^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 zeros.",
          "worked": "$$\\begin{align*}2^3\\times5^4&=5\\times(2\\times5)(2\\times5)(2\\times5)\\\\2^3\\times5^4&=5\\times10^3\\\\2^3\\times5^4&=5000\\end{align*}$$\n\nThere are 3 zeros.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$2^{20}\\times5^{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 zeros.\n\nPair each factor of 2 with a factor of 5 to make 10.",
          "worked": "There are 20 pairs of factors $2\\times5$.\n\n$$2^{20}\\times5^{20}=10^{20}$$\n\nThis is 1 followed by 20 zeros, so there are 20 zeros.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p28-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$2^{21}\\times5^{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 zeros.\n\nForm 20 factors of 10; one factor of 2 remains.",
          "worked": "$$\\begin{align*}2^{21}\\times5^{20}&=2\\times(2^{20}\\times5^{20})\\\\2^{21}\\times5^{20}&=2\\times10^{20}\\end{align*}$$\n\nThis is 2 followed by 20 zeros, so there are 20 zeros.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q14-g",
        "type": "part",
        "label": "g",
        "prompt": "$2^{23}\\times5^{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 zeros.\n\nForm 20 factors of 10; the remaining factor is $2^3=8$.",
          "worked": "$$\\begin{align*}2^{23}\\times5^{20}&=2^3\\times(2^{20}\\times5^{20})\\\\2^{23}\\times5^{20}&=2^3\\times10^{20}\\\\2^{23}\\times5^{20}&=8\\times10^{20}\\end{align*}$$\n\nThis is 8 followed by 20 zeros, so there are 20 zeros.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
