  "content": {
    "id": "p58-q10",
    "type": "question",
    "label": "10",
    "prompt": "A function $h=3t^2-2t+5$ has a tangent at the point where $t=2$.\nFind the equation of the tangent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10t-h-7=0$",
      "worked": "$$\\begin{aligned}\\frac{dh}{dt}&=6t-2\\\\m&=6(2)-2\\\\m&=10\\\\h(2)&=3(2)^2-2(2)+5\\\\h(2)&=13\\\\h-13&=10(t-2)\\\\h&=10t-7\\\\10t-h-7&=0\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
