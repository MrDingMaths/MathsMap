  "content": {
    "id": "p23-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Mohammed spends $30$ minutes travelling to work. He takes the same path home but travels $10$ km/h faster. This takes him $20$ minutes. How fast does Mohammed travel on the way to work?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20$ km/h",
      "worked": "Let $s$ km/h be Mohammed's speed to work. The journey times are $\\frac{1}{2}$ h and $\\frac{1}{3}$ h, so the distances are $\\frac{s}{2}$ km and $\\frac{s+10}{3}$ km. These distances are equal.\n$$\\begin{align*}\\frac{s}{2}&=\\frac{s+10}{3}\\\\3s&=2s+20\\\\s&=20\\end{align*}$$\nMohammed travels to work at $20$ km/h.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
