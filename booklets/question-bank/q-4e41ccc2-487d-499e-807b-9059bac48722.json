    "answer": {
      "short": "\\$3572",
      "worked": "$$\\begin{align*}\\text{4 weeks’ pay} &= 760\\times4 = \\$3040\\\\\\text{Holiday loading} &= 0.175\\times3040 = \\$532\\\\\\text{Holiday pay} &= 3040+532 = \\$3572\\end{align*}$$",
