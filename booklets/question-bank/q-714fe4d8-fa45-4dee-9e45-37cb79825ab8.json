  "content": {
    "id": "p25-q4",
    "type": "question",
    "label": "4",
    "prompt": "Show that the following vectors are perpendicular.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$-2\\binom{3}{4}$ and $\\binom{8}{-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-6)(8)+(-8)(-6)=0$, so the vectors are perpendicular.",
          "worked": "$$-2\\binom{3}{4}=\\binom{-6}{-8}$$\n$$\\begin{aligned}(-6)(8)+(-8)(-6)&=-48+48\\\\&=0\\end{aligned}$$\nThe vectors are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\binom{5}{2}+\\binom{1}{-3}$ and $\\binom{1}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(1)+(-1)(6)=0$, so the vectors are perpendicular.",
          "worked": "$$\\binom{5}{2}+\\binom{1}{-3}=\\binom{6}{-1}$$\n$$\\begin{aligned}6(1)+(-1)(6)&=6-6\\\\&=0\\end{aligned}$$\nThe vectors are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\binom{7}{-3}-\\binom{2}{1}$ and $\\binom{4}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(4)+(-4)(5)=0$, so the vectors are perpendicular.",
          "worked": "$$\\binom{7}{-3}-\\binom{2}{1}=\\binom{5}{-4}$$\n$$\\begin{aligned}5(4)+(-4)(5)&=20-20\\\\&=0\\end{aligned}$$\nThe vectors are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
