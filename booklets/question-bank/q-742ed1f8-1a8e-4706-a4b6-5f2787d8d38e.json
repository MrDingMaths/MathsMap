  "content": {
    "id": "p17-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A car and a truck are approaching each other on a straight road. They are 20 km apart and the truck is travelling at 60 km/h. Find how long it takes for the car to pass the truck if the car maintains a steady speed of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "90 km/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\text{ min}$",
          "worked": "Closing speed is $90+60=150\\text{ km/h}$. Thus $t=\\frac{20}{150}=\\frac{2}{15}\\text{ h}=8\\text{ min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "100 km/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.5\\text{ min}$",
          "worked": "Closing speed is $100+60=160\\text{ km/h}$. Thus $t=\\frac{20}{160}=\\frac{1}{8}\\text{ h}=7.5\\text{ min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "80 km/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\frac47\\text{ min}$",
          "worked": "Closing speed is $80+60=140\\text{ km/h}$. Thus $t=\\frac{20}{140}=\\frac{1}{7}\\text{ h}=\\frac{60}{7}\\text{ min}=8\\frac47\\text{ min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
