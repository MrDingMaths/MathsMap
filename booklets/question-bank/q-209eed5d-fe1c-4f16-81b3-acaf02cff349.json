  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Calculate the area of a rectangular field with length $150\\text{ m}$ and width $0.6\\text{ km}$. Give your answer in square metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$90\\,000\\text{ m}^2$",
      "worked": "Convert the width to metres: $0.6\\text{ km}=600\\text{ m}$.\n\n$$\\begin{align*}A&=L\\times W\\\\A&=150\\times600\\\\A&=90\\,000\\text{ m}^2\\end{align*}$$",
