        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8",
          "worked": "Substitute 1 for each whole nonzero base to power zero.\n\n$$\\begin{align*}\\left( 2h^{0} \\right)^{3}&=(2\\times1)^{3} \\\\ &=2^{3} \\\\ &=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
