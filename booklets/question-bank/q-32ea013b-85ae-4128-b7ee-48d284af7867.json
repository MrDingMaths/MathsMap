    "children": [
      {
        "id": "index-t5-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\begin{aligned}&(5n^0)^{4}\\\\[2mm]&=(\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}\\times \\boxed{\\rule{0pt}{4mm}\\hspace{8mm}})^{4}\\\\[2mm]&=\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}^{4}=\\boxed{\\rule{0pt}{4mm}\\hspace{12mm}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5,1,5,625$",
          "worked": "Substitute 1 for each whole nonzero base to power zero.\n\n$$\\begin{align*}(5n^0)^4&=(5\\times1)^{4} \\\\ &=5^{4} \\\\ &=625\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "index-t5-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\begin{aligned}&(8p^0)^{3}\\\\[2mm]&=(\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}\\times \\boxed{\\rule{0pt}{4mm}\\hspace{8mm}})^{3}\\\\[2mm]&=\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}^{3}=\\boxed{\\rule{0pt}{4mm}\\hspace{12mm}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8,1,8,512$",
          "worked": "Substitute 1 for each whole nonzero base to power zero.\n\n$$\\begin{align*}(8p^0)^3&=(8\\times1)^{3} \\\\ &=8^{3} \\\\ &=512\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "index-t5-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\begin{aligned}&(2h^0)^{9}\\\\[2mm]&=(\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}\\times \\boxed{\\rule{0pt}{4mm}\\hspace{8mm}})^{9}\\\\[2mm]&=\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}^{9}=\\boxed{\\rule{0pt}{4mm}\\hspace{12mm}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2,1,2,512$",
          "worked": "Substitute 1 for each whole nonzero base to power zero.\n\n$$\\begin{align*}(2h^0)^9&=(2\\times1)^{9} \\\\ &=2^{9} \\\\ &=512\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "index-t5-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left( 2h^{0} \\right)^{3}$",
