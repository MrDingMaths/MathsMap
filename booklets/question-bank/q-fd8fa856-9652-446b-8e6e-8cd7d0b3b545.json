    "children": [
      {
        "id": "p20-q4a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the line with gradient $-4$ that passes through the point $(0,-6)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4x-6$.",
          "worked": "$$\\begin{align*}y-(-6)&=-4(x-0)\\\\y+6&=-4x\\\\y&=-4x-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q4b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation of the line with gradient $-4$ that passes through the point $(3,8)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4x+20$.",
          "worked": "$$\\begin{align*}y-8&=-4(x-3)\\\\y-8&=-4x+12\\\\y&=-4x+20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q4c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of the line that passes through the points $(-4,8)$ and $(-6,-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=5x+28$.",
          "worked": "$$\\begin{align*}m&=\\frac{-2-8}{-6-(-4)}\\\\m&=\\frac{-10}{-2}\\\\m&=5\\end{align*}$$\nUsing $(-4,8)$:\n$$\\begin{align*}y-8&=5(x+4)\\\\y-8&=5x+20\\\\y&=5x+28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q4d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of the line that is parallel to the line $y=-2x+3$ and passes through the point with coordinates $(-1,-10)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x-12$.",
          "worked": "Parallel lines have equal gradients, so $m=-2$.\n$$\\begin{align*}y-(-10)&=-2(x-(-1))\\\\y+10&=-2x-2\\\\y&=-2x-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
