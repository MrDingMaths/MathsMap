                            }
                          ]
                        },
                        {
                          "id": "p15-first-explain-scaffold",
                          "type": "paragraph",
                          "fontSize": null,
                          "align": "left",
                          "spaceBefore": 0,
                          "spaceAfter": 2,
                          "lineHeight": 1.4,
                          "indent": 0,
                          "inlines": [
                            {
                              "type": "text",
                              "text": "To cancel negative signs, you are dividing both sides by ",
                              "marks": [
                                "italic"
                              ]
                            },
                            {
                              "type": "cloze",
                              "answer": "$-1$",
                              "width": 13
                            },
                            {
                              "type": "text",
                              "text": ", so you must reverse the inequality sign.",
                              "marks": [
                                "italic"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    "layout": "list",
                    "columns": null,
                    "questionDiagrams": [],
                    "children": [],
                    "answer": {
                      "short": "$-1$",
                      "worked": "Dividing both sides by $-1$ reverses the inequality sign.",
                      "solutionDiagrams": []
                    },
                    "answerSpaceMm": 0,
                    "responseSpace": "scaffold"
                  },
                  {
                    "id": "p15-q2-first-correct",
                    "type": "part",
                    "label": "ii",
                    "prompt": "What is the correct answer?",
                    "layout": "list",
                    "columns": null,
                    "questionDiagrams": [],
                    "children": [],
                    "answer": {
                      "short": "$3>x$, or $x<3$.",
                      "worked": "$\\begin{align*}-3&<-x\\\\3&>x\\\\x&<3\\end{align*}$\nDividing by $-1$ reverses the inequality; swapping the sides reverses its direction again.",
                      "solutionDiagrams": []
                    },
                    "answerSpaceMm": 10
                  },
                  {
                    "id": "p15-q2-first-solve",
                    "type": "part",
                    "label": "iii",
                    "prompt": "Solve\n$$-\\frac{2}{4}\\le\\frac{x}{-6}$$",
                    "layout": "list",
                    "columns": null,
                    "questionDiagrams": [],
                    "children": [],
                    "answer": {
                      "short": "$x\\le3$",
                      "worked": "$\\begin{align*}(-6)\\left(-\\frac{2}{4}\\right)&\\ge x\\\\3&\\ge x\\\\x&\\le3\\end{align*}$\nMultiplying by $-6$ reverses the inequality.",
                      "solutionDiagrams": []
                    },
                    "answerSpaceMm": 23
                  }
                ]
              }
            ]
