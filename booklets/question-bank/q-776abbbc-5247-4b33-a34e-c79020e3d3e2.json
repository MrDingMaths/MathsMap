          "short": "$-900$",
          "worked": "$$\\begin{align*}(-w)^3+w^2&=(-10)^3+10^2\\\\(-w)^3+w^2&=-1000+100\\\\(-w)^3+w^2&=-900\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$w^3-10w^2$",
