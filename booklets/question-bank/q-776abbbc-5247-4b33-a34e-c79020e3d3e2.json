    "label": "8",
    "prompt": "Evaluate each expression for $w=10$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$-40w$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-400$",
          "worked": "$$\\begin{align*}-40w&=-40\\times10\\\\-40w&=-400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$-w^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10000$",
          "worked": "$$\\begin{align*}-w^4&=-(10)^4\\\\-w^4&=-10000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$10-2w$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10$",
          "worked": "$$\\begin{align*}10-2w&=10-2\\times10\\\\10-2w&=10-20\\\\10-2w&=-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$(-2w)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8000$",
          "worked": "$$\\begin{align*}(-2w)^3&=(-2\\times10)^3\\\\(-2w)^3&=(-20)^3\\\\(-2w)^3&=-8000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-w)^3+w^2$",
        "layout": "list",
        "columns": null,
