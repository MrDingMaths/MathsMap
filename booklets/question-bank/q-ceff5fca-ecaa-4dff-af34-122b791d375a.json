  "content": {
    "id": "p13-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Bob and Mary go for their driving tests. Bob has an 80% chance of passing and Mary has a 90% chance of passing. Assume their results are independent. What is the probability that",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "only Bob passes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{25}$",
          "worked": "$$\\begin{align*} P(\\text{only Bob passes}) &= 0.8\\times(1-0.9) \\\\ P(\\text{only Bob passes}) &= \\frac{2}{25} \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p13-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "either Bob or Mary passes, but not both.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{50}$",
          "worked": "$$\\begin{align*} P(\\text{exactly one passes}) &= P(\\text{only Bob passes})+P(\\text{only Mary passes}) \\\\ P(\\text{exactly one passes}) &= 0.8\\times0.1+0.2\\times0.9 \\\\ P(\\text{exactly one passes}) &= \\frac{13}{50} \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p13-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "at least one person passes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{49}{50}$",
          "worked": "$$\\begin{align*} P(\\text{at least one passes}) &= 1-P(\\text{both fail}) \\\\ P(\\text{at least one passes}) &= 1-0.2\\times0.1 \\\\ P(\\text{at least one passes}) &= \\frac{49}{50} \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
  },
