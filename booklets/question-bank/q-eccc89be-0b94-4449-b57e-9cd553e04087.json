    "children": [
      {
        "id": "p65-q28-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{d}{dx}(\\tan^3x)=3(\\sec^4x-\\sec^2x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{aligned}\\dfrac{d}{dx}(\\tan^3x)&=3\\tan^2x\\sec^2x\\\\&=3(\\sec^2x-1)\\sec^2x\\\\&=3(\\sec^4x-\\sec^2x)\\end{aligned}$$",
          "worked": "Using $\\tan^2x=\\sec^2x-1$,\n$$\\begin{align*}\\frac{d}{dx}(\\tan^3x)&=3\\tan^2x\\sec^2x\\\\&=3(\\sec^2x-1)\\sec^2x\\\\&=3(\\sec^4x-\\sec^2x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p65-q28-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int_0^{\\pi/4}\\sec^4x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{3}$",
          "worked": "From part a,\n$$\\sec^4x=\\frac13\\frac{d}{dx}(\\tan^3x)+\\sec^2x.$$\nTherefore,\n$$\\begin{align*}\\int_0^{\\pi/4}\\sec^4x\\,dx&=\\left[\\frac13\\tan^3x+\\tan x\\right]_0^{\\pi/4}\\\\&=\\left(\\frac13(1)^3+1\\right)-\\left(\\frac13(0)^3+0\\right)\\\\&=\\frac43.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
