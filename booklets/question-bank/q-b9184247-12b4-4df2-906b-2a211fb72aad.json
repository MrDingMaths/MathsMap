      {
        "id": "p53-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the domain of $y=\\frac{1}{x}+\\ln x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>0$.",
          "worked": "The logarithm $\\ln x$ requires $x>0$, which also excludes the undefined value $x=0$ in $\\frac{1}{x}$. Domain: $(0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p53-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the first and second derivatives may be expressed as single fractions as $y'=\\frac{x-1}{x^2}$ and $y''=\\frac{2-x}{x^3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{1}{x^2}+\\frac{1}{x}=\\frac{x-1}{x^2}$; $y''=\\frac{2}{x^3}-\\frac{1}{x^2}=\\frac{2-x}{x^3}$.",
          "worked": "$$\\begin{align*}y'&=-x^{-2}+x^{-1}\\\\y'&=\\frac{-1+x}{x^2}\\\\y'&=\\frac{x-1}{x^2}\\\\y''&=2x^{-3}-x^{-2}\\\\y''&=\\frac{2-x}{x^3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p53-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that the curve has a minimum at $(1,1)$ and an inflection at $\\left(2,\\frac{1}{2}+\\ln 2\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'$ changes from negative to positive at $x=1$, giving a minimum at $(1,1)$. $y''$ changes from positive to negative at $x=2$, giving an inflection at $\\left(2,\\frac12+\\ln2\\right)$.",
