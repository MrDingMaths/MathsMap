    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $(\\alpha+\\beta)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha^2+2\\alpha\\beta+\\beta^2$",
          "worked": "$$\\begin{aligned}(\\alpha+\\beta)^2&=(\\alpha+\\beta)(\\alpha+\\beta)\\\\&=\\alpha^2+2\\alpha\\beta+\\beta^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, express $\\alpha^2+\\beta^2$ in terms of $(\\alpha+\\beta)$ and $\\alpha\\beta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha^2+\\beta^2=(\\alpha+\\beta)^2-2\\alpha\\beta$",
          "worked": "$$\\begin{aligned}(\\alpha+\\beta)^2&=\\alpha^2+2\\alpha\\beta+\\beta^2\\\\\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Let the roots of $x^2-3x-2=0$ be $\\alpha$ and $\\beta$. Find the value of $\\alpha^2+\\beta^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "$$\\begin{aligned}\\alpha+\\beta&=-\\frac{-3}{1}=3\\\\\\alpha\\beta&=\\frac{-2}{1}=-2\\\\\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\&=3^2-2(-2)\\\\&=13\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
