  "content": {
    "id": "p25-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A new car that costs $\\$25\\,500$ depreciates by 18.5% of its value each year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the car’s value after 2 years. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$16\\,937.74$",
          "worked": "$$\\begin{align*}S &= V_0(1-r)^n\\\\S &= 25\\,500(1-0.185)^2\\\\S &= 16\\,937.7375\\end{align*}$$\nThe car’s value is $\\$16\\,937.74$ to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "How much did it depreciate by in that time? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$8562.26$",
          "worked": "$$\\begin{align*}\\text{Depreciation} &= 25\\,500-16\\,937.7375\\\\\\text{Depreciation} &= 8562.2625\\end{align*}$$\nIt depreciated by $\\$8562.26$ to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
