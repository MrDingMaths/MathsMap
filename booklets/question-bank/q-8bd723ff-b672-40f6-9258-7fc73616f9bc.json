  "content": {
    "id": "v2-p30-mixed-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "Find the first term and common difference of the AP with $a_5=-2$ and $a_{13}=18$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-12$, $d=2.5$.",
      "worked": "$$\\begin{align*}a+4d&=-2\\qquad\\text{(1)}\\\\a+12d&=18\\qquad\\text{(2)}\\end{align*}$$\n(2) − (1):\n$$\\begin{align*}8d&=20\\\\d&=2.5\\end{align*}$$\nSubstitute into (1):\n$$\\begin{align*}a+10&=-2\\\\a&=-12\\end{align*}$$\nTherefore $a=-12$ and $d=2.5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
