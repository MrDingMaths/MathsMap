  "content": {
    "id": "p70-q29-response",
    "type": "question",
    "label": "29",
    "prompt": "Find the range of $y=\\dfrac{x+1}{x^2+2x+2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p70-q29-short-result",
            "type": "paragraph",
