        "prompt": "$\\sin135^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{\\sqrt2}$",
          "worked": "$$\\begin{aligned}\\sin135^\\circ&=\\sin(180^\\circ-135^\\circ)\\\\\\sin135^\\circ&=\\sin45^\\circ\\\\\\sin135^\\circ&=\\frac{1}{\\sqrt2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p21-q2b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos135^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{\\sqrt2}$",
          "worked": "$$\\begin{aligned}\\cos135^\\circ&=-\\cos(180^\\circ-135^\\circ)\\\\\\cos135^\\circ&=-\\cos45^\\circ\\\\\\cos135^\\circ&=-\\frac{1}{\\sqrt2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
