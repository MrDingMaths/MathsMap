        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m<\\frac{6}{7}$",
          "worked": "$$\\begin{align*}3(2-m)-4m&>0\\\\6-3m-4m&>0\\\\6-7m&>0\\\\-7m&>-6\\\\m&<\\frac{6}{7}\\end{align*}$$\nDividing by $-7$ reverses the inequality sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
