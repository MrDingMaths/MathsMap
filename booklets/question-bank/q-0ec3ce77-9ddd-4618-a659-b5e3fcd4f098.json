  "content": {
    "id": "p26-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "If $\\alpha,\\beta,\\gamma,\\delta$ are the roots of $x^4-2x^3+5x-3=0$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q2a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha\\beta\\gamma\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{aligned}\\alpha\\beta\\gamma\\delta&=\\frac{e}{a}\\\\&=\\frac{-3}{1}\\\\&=-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p26-q2b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta\\gamma+\\alpha\\beta\\delta+\\alpha\\gamma\\delta+\\beta\\gamma\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{aligned}\\alpha\\beta\\gamma+\\alpha\\beta\\delta+\\alpha\\gamma\\delta+\\beta\\gamma\\delta&=-\\frac{d}{a}\\\\&=-\\frac{5}{1}\\\\&=-5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q2c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{\\alpha}+\\frac{1}{\\beta}+\\frac{1}{\\gamma}+\\frac{1}{\\delta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{3}$",
          "worked": "$$\\begin{aligned}\\frac{1}{\\alpha}+\\frac{1}{\\beta}+\\frac{1}{\\gamma}+\\frac{1}{\\delta}&=\\frac{\\alpha\\beta\\gamma+\\alpha\\beta\\delta+\\alpha\\gamma\\delta+\\beta\\gamma\\delta}{\\alpha\\beta\\gamma\\delta}\\\\&=\\frac{-5}{-3}\\\\&=\\frac{5}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
