  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the value of $m$ and $n$ if $(3,4)$ is the midpoint of points $(2,m)$ and $(n,7)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=1,\\quad n=4$",
      "worked": "Using the midpoint formula,\n$$\\begin{align*}\\frac{2+n}{2}&=3\\\\2+n&=6\\\\n&=4\\end{align*}$$\n$$\\begin{align*}\\frac{m+7}{2}&=4\\\\m+7&=8\\\\m&=1\\end{align*}$$\nTherefore, $m=1$ and $n=4$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 70
  },
