  "content": {
    "id": "v2-078cb-p18-practice-j2-105033-root",
    "type": "question",
    "label": null,
    "prompt": "I roll a fair 6-sided die and spin a spinner with $n$ equal sectors numbered $1$ to $n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-078cb-p18-practice-j2-105033-j2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability of getting a 4 on the spinner? Give your answer in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{n}$",
          "worked": "$$P(4)=\\frac{1}{n}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-078cb-p18-practice-j2-105033-j2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability of getting a 6 on the die and a 4 on the spinner? Give your answer in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6n}$",
          "worked": "$$\\begin{align*}P(6\\text{ and }4)&=\\frac{1}{6}\\times\\frac{1}{n}\\\\&=\\frac{1}{6n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-078cb-p18-practice-j2-105033-j2-q-c",
        "type": "part",
        "label": "c",
        "prompt": "The probability of getting a 6 on the die and a 4 on the spinner is $\\frac{1}{48}$. Find $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=8$",
          "worked": "$$\\begin{align*}\\frac{1}{6n}&=\\frac{1}{48}\\\\6n&=48\\\\n&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
