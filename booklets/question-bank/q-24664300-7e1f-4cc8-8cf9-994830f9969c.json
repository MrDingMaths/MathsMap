  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find what percentage the first quantity is of the second quantity, correct to two decimal places. You will first need to express both quantities in the same unit.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "48 cents, $\\$10.00$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.80\\%$",
          "worked": "$$\\begin{align*}\\$10.00&=1000\\text{ cents}\\\\\\text{Percentage}&=\\frac{48}{1000}\\times100\\%\\\\\\text{Percentage}&=4.80\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "3.4 cm, 2 m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.70\\%$",
          "worked": "$$\\begin{align*}2\\text{ m}&=200\\text{ cm}\\\\\\text{Percentage}&=\\frac{3.4}{200}\\times100\\%\\\\\\text{Percentage}&=1.70\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "28 hours, 4 weeks",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.17\\%$",
          "worked": "$$\\begin{align*}4\\text{ weeks}&=4\\times7\\times24\\text{ hours}\\\\4\\text{ weeks}&=672\\text{ hours}\\\\\\text{Percentage}&=\\frac{28}{672}\\times100\\%\\\\\\text{Percentage}&\\approx4.17\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "250 m, 8 km",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.13\\%$",
          "worked": "$$\\begin{align*}8\\text{ km}&=8000\\text{ m}\\\\\\text{Percentage}&=\\frac{250}{8000}\\times100\\%\\\\\\text{Percentage}&=3.125\\%\\\\\\text{Percentage}&\\approx3.13\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "40 km, 1250 m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3200.00\\%$",
          "worked": "$$\\begin{align*}40\\text{ km}&=40000\\text{ m}\\\\\\text{Percentage}&=\\frac{40000}{1250}\\times100\\%\\\\\\text{Percentage}&=3200.00\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "1 day, 2 years",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.14\\%$",
          "worked": "Using 365 days in a year:\n\n$$\\begin{align*}2\\text{ years}&=2\\times365\\text{ days}\\\\2\\text{ years}&=730\\text{ days}\\\\\\text{Percentage}&=\\frac{1}{730}\\times100\\%\\\\\\text{Percentage}&\\approx0.14\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
