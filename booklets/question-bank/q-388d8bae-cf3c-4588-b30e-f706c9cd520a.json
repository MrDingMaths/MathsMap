  "content": {
    "id": "p9-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Given that $y\\propto\\sqrt{x}$, and if $y=27$ when $x=9$,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q2-formula",
        "type": "part",
        "label": "a",
        "prompt": "find the formula for $y$ in terms of $x$, and find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=9\\sqrt{x}$",
          "worked": "Write $y=k\\sqrt{x}$.\n$$\\begin{align*}27&=k\\sqrt{9}\\\\27&=3k\\\\k&=9\\end{align*}$$\nTherefore, $y=9\\sqrt{x}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q2-values",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q2-a",
            "type": "part",
            "label": "b",
            "prompt": "$y$ when $x=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=18$",
              "worked": "Using $y=9\\sqrt{x}$,\n$$\\begin{align*}y&=9\\sqrt{4}\\\\y&=9\\times2\\\\y&=18\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p9-q2-b",
            "type": "part",
            "label": "c",
            "prompt": "$x$ when $y=75$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\dfrac{625}{9}$",
              "worked": "Using $y=9\\sqrt{x}$,\n$$\\begin{align*}75&=9\\sqrt{x}\\\\\\sqrt{x}&=\\frac{75}{9}\\\\\\sqrt{x}&=\\frac{25}{3}\\\\x&=\\left(\\frac{25}{3}\\right)^2\\\\x&=\\frac{625}{9}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      }
    ]
