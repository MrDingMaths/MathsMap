  "content": {
    "id": "p28-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A ball is tossed with initial speed $6\\text{ m/s}$ at an angle of $45^\\circ$ to the horizontal. It hits the ground at a point $2\\text{ m}$ below the point of projection. Using $g=10\\text{ m s}^{-2}$, find, to 2 d.p.:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "the time of flight,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.19\\text{ s}$",
          "worked": "Take the point of projection as the origin, with upwards positive.\n$$\\begin{align*}\n\\dot{x}&=6\\cos45^\\circ=3\\sqrt2\\\\\n\\dot{y}&=-10t+3\\sqrt2\\\\\ny&=-5t^2+3\\sqrt2\\,t\\\\\n-2&=-5t^2+3\\sqrt2\\,t\\\\\n5t^2-3\\sqrt2\\,t-2&=0\\\\\nt&=\\frac{3\\sqrt2\\pm\\sqrt{18+40}}{10}\\\\\nt&=\\frac{3\\sqrt2+\\sqrt{58}}{10}\\qquad(t>0)\\\\\nt&\\approx1.19\\text{ s}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p28-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "the horizontal distance travelled.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.03\\text{ m}$",
          "worked": "$$\\begin{align*}\nx&=3\\sqrt2\\,t\\\\\nx&=3\\sqrt2\\left(\\frac{3\\sqrt2+\\sqrt{58}}{10}\\right)\\\\\nx&=\\frac{9+3\\sqrt{29}}5\\\\\nx&\\approx5.03\\text{ m}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
