        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}3^x&=3^2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p11-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$4^x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$",
          "worked": "$$\\begin{align*}2^{2x}&=2^1\\\\2x&=1\\\\x&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$5^x=\\dfrac1{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$",
          "worked": "$$\\begin{align*}5^x&=5^{-2}\\\\x&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p11-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$4^x=\\dfrac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac12$",
          "worked": "$$\\begin{align*}2^{2x}&=2^{-1}\\\\2x&=-1\\\\x&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$3^{4x-1}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac14$",
          "worked": "$$\\begin{align*}3^{4x-1}&=3^0\\\\4x-1&=0\\\\4x&=1\\\\x&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
