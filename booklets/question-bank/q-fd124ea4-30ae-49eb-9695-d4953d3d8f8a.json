  "content": {
    "id": "p22-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Reducing as you go along is really important when taking powers. You can also group the factors in pairs, or in threes, if that will make the calculations easier.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$5\\times5\\times5\\times5\\times5\\times5\\pmod{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}5^6&=(5^2)^3\\\\5^6&\\equiv4^3=64\\pmod{7}\\\\5^6&\\equiv1\\pmod{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$4\\times4\\times4\\times4\\pmod{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}4^4&=(4^2)^2\\\\4^4&\\equiv2^2\\pmod{7}\\\\4^4&\\equiv4\\pmod{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$16\\times16\\times16\\times16\\times16\\pmod{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}16^5&\\equiv2^5\\pmod{7}\\\\16^5&\\equiv2^3\\times2^2\\equiv1\\times4\\pmod{7}\\\\16^5&\\equiv4\\pmod{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$23^8\\pmod{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}23^8&\\equiv3^8\\pmod{5}\\\\23^8&\\equiv(3^2)^4\\equiv4^4\\pmod{5}\\\\23^8&\\equiv(4^2)^2\\equiv1^2=1\\pmod{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$5^6\\pmod{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}5^6&=(5^2)^3\\\\5^6&\\equiv3^3=27\\pmod{11}\\\\5^6&\\equiv5\\pmod{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^7\\pmod{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}4^7&=(4^2)^3\\times4\\\\4^7&\\equiv4^3\\times4=4^4\\pmod{12}\\\\4^7&\\equiv(4^2)^2\\equiv4^2\\equiv4\\pmod{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$2^{12}\\pmod{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}2^{12}&=(2^4)^3\\\\2^{12}&\\equiv4^3\\pmod{12}\\\\2^{12}&\\equiv4\\times4=16\\pmod{12}\\\\2^{12}&\\equiv4\\pmod{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$9^{26}\\pmod{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}9^{26}&=(9^2)^{13}\\\\9^{26}&\\equiv1^{13}\\pmod{10}\\\\9^{26}&\\equiv1\\pmod{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
