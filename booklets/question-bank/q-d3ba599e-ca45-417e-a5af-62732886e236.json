    "type": "question",
    "label": "4",
    "prompt": "Find a formula for the area $A$ of a circle in terms of its circumference $C$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$A=\\dfrac{C^2}{4\\pi}$",
      "worked": "$$\\begin{align*}C&=2\\pi r\\\\r&=\\frac{C}{2\\pi}\\\\A&=\\pi\\left(\\frac{C}{2\\pi}\\right)^2\\\\A&=\\frac{C^2}{4\\pi}\\end{align*}$$",
      "solutionDiagrams": []
    },
