      {
        "id": "p34-q60-a",
        "type": "part",
        "label": "a",
        "prompt": "find the rule for $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=-2x+11$, where $x\\ge 0$.",
          "worked": "$$\\begin{align*}m&=\\frac{3-5}{4-3}\\\\m&=-2\\\\f(x)-5&=-2(x-3)\\\\f(x)&=-2x+11,\\quad x\\ge 0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p34-q60-b",
        "type": "part",
        "label": "b",
        "prompt": "find the range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p34-q60-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(-\\infty,11]",
                    "display": false
                  }
                ]
              },
              {
                "id": "p34-q60-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "f",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " decreases without bound from the included endpoint ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "f(0)=11",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Since $x\\ge 0$,\n$$\\begin{align*}-2x&\\le 0\\\\-2x+11&\\le 11\\\\f(x)&\\le 11.\\end{align*}$$\nThe endpoint is included because $f(0)=11$. The gradient is negative, so $f(x)$ decreases without bound as $x$ increases without bound. Every $y\\le 11$ is attained: $x=\\frac{11-y}{2}\\ge 0$ lies in the domain and gives $f(x)=y$.\n\nTherefore, the range is $(-\\infty,11]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
