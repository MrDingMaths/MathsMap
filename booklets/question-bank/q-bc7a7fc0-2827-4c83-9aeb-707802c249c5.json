  "content": {
    "id": "p12-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "We know that a cone of height $h$ and radius $r$ has volume $V=\\frac13\\pi r^2h$.\n\nFor cones of the same volume, height is inversely proportional to the radius squared.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q15-a",
        "type": "group",
        "label": "a",
        "prompt": "What is the effect on:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q15-a-i",
            "type": "part",
            "label": "i",
            "prompt": "the height when the radius is doubled?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The height is divided by $4$.",
              "worked": "For fixed volume, write $h=\\frac{k}{r^2}$.\n$$\\begin{align*}h_{\\text{new}}&=\\frac{k}{(2r)^2}\\\\h_{\\text{new}}&=\\frac14\\frac{k}{r^2}\\\\h_{\\text{new}}&=\\frac h4.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p12-q15-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the radius when the height is multiplied by $9$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The radius is divided by $3$.",
              "worked": "Since $hr^2=k$,\n$$\\begin{align*}9h\\,r_{\\text{new}}^2&=hr^2\\\\r_{\\text{new}}^2&=\\frac{r^2}{9}\\\\r_{\\text{new}}&=\\frac r3.\\end{align*}$$\nThe radius is positive.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p12-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "For cones of volume $12\\pi\\text{ cm}^3$, state the constant of proportionality in the relationship $h\\propto\\frac1{r^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=36$ when $h$ and $r$ are measured in centimetres.",
          "worked": "Using centimetres,\n$$\\begin{align*}12\\pi&=\\frac13\\pi r^2h\\\\r^2h&=36\\\\h&=\\frac{36}{r^2}.\\end{align*}$$\nTherefore the constant of proportionality is $36$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
