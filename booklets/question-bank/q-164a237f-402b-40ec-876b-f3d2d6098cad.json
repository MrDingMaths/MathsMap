    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Suppose that $AB=CD$ and $AB\\parallel CD$. Prove that $X$ is the midpoint of both $AD$ and $BC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AX=DX$ and $BX=CX$, so $X$ is the midpoint of both $AD$ and $BC$.\n\nUse alternate angles and $AB=CD$ to establish AAS congruence.",
          "worked": "$AB\\parallel CD$, so\n$$\\begin{align*}\\angle XAB&=\\angle XDC &&\\text{(alternate angles)}\\\\\\angle XBA&=\\angle XCD &&\\text{(alternate angles)}\\\\AB&=DC &&\\text{(given)}\\end{align*}$$\nThus $\\triangle AXB\\cong\\triangle DXC$ by ASA. Corresponding sides give $AX=DX$ and $BX=CX$. Since $X$ lies on both $AD$ and $BC$, it is the midpoint of both segments.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose that $X$ is the midpoint of both $AD$ and $BC$. Prove that $AB\\parallel CD$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB\\parallel CD$.\n\nSAS congruence gives equal alternate angles $\\angle XAB=\\angle XDC$.",
          "worked": "$X$ is the midpoint of both segments, so\n$$\\begin{align*}AX&=DX &&\\text{(midpoint)}\\\\BX&=CX &&\\text{(midpoint)}\\\\\\angle AXB&=\\angle DXC &&\\text{(vertically opposite angles)}\\end{align*}$$\nThus $\\triangle AXB\\cong\\triangle DXC$ by SAS. Hence $\\angle XAB=\\angle XDC$ as corresponding angles. These are alternate angles, so $AB\\parallel CD$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
