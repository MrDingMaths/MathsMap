        "answer": {
          "short": "$1$",
          "worked": "The right triangle has perpendicular sides $\\cos\\theta$ and $\\sin\\theta$ and hypotenuse $1$. By Pythagoras’ theorem,\n$$\\begin{align*}\\sin^2\\theta+\\cos^2\\theta&=1^2\\\\\\sin^2\\theta+\\cos^2\\theta&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
