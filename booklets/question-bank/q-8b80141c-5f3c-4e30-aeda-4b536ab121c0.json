  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "$A=\\{1,2,4\\},\\qquad B=\\{1,3,5,6\\}$.\n\nList every ordered pair $(a,b)$ satisfying the rule.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$b>a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(1,3),(1,5),(1,6),(2,3),(2,5),(2,6),(4,5),(4,6)\\}$",
          "worked": "For $a=1$, the values of $b$ greater than $1$ are $3,5,6$.\n\nFor $a=2$, the values of $b$ greater than $2$ are $3,5,6$.\n\nFor $a=4$, the values of $b$ greater than $4$ are $5,6$.\n\nThe ordered pairs are $\\{(1,3),(1,5),(1,6),(2,3),(2,5),(2,6),(4,5),(4,6)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$b>a+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(1,3),(1,5),(1,6),(2,5),(2,6),(4,6)\\}$",
          "worked": "For $a=1$, $b>2$, so $b=3,5,6$.\n\nFor $a=2$, $b>3$, so $b=5,6$.\n\nFor $a=4$, $b>5$, so $b=6$.\n\nThe ordered pairs are $\\{(1,3),(1,5),(1,6),(2,5),(2,6),(4,6)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$b>a+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(1,5),(1,6),(2,5),(2,6)\\}$",
          "worked": "For $a=1$, $b>3$, so $b=5,6$.\n\nFor $a=2$, $b>4$, so $b=5,6$.\n\nFor $a=4$, $b>6$, so no element of $B$ qualifies.\n\nThe ordered pairs are $\\{(1,5),(1,6),(2,5),(2,6)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$b<a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(2,1),(4,1),(4,3)\\}$",
          "worked": "For $a=1$, no element of $B$ is less than $1$.\n\nFor $a=2$, $b=1$.\n\nFor $a=4$, $b=1,3$.\n\nThe ordered pairs are $\\{(2,1),(4,1),(4,3)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$b\\leq a$",
