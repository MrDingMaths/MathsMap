  "content": {
    "id": "p25-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A rectangular block of land measures $15.78\\text{ m}$ by $27.93\\text{ m}$. Calculate the perimeter and area of the block.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Perimeter: $87.42\\text{ m}$. Area: $440.7354\\text{ m}^2$.",
      "worked": "Perimeter:\n\n$$\\begin{align*}P&=2(15.78+27.93)\\\\P&=2\\times43.71\\\\P&=87.42\\text{ m}\\end{align*}$$\n\nArea:\n\n$$\\begin{align*}A&=15.78\\times27.93\\\\A&=\\frac{1578\\times2793}{10000}\\\\A&=\\frac{4407354}{10000}\\\\A&=440.7354\\text{ m}^2\\end{align*}$$",
      "solutionDiagrams": []
