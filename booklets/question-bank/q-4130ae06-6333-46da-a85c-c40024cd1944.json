  "content": {
    "id": "p15-q29-root",
    "type": "question",
    "label": null,
    "prompt": "Let $A=\\{1,2,3\\}$ and $B=\\{x,y,z,w\\}$. Define the function from $A$ to $B$ by $f=\\{(1,y),(2,z),(3,x)\\}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q29-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(1)$, $f(2)$ and $f(3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(1)=y,\\quad f(2)=z,\\quad f(3)=x$.",
          "worked": "Read the output from the second coordinate of each ordered pair.\n\n$$\\begin{align*}f(1)&=y\\\\f(2)&=z\\\\f(3)&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-q29-b",
        "type": "part",
        "label": "b",
        "prompt": "State the domain and range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $\\{1,2,3\\}$. Range: $\\{x,y,z\\}$.",
          "worked": "The domain contains the inputs; the range contains the actual outputs.\n\n$$\\begin{align*}\\operatorname{domain}(f)&=\\{1,2,3\\}\\\\\\operatorname{range}(f)&=\\{x,y,z\\}\\end{align*}$$\n\nAlthough $w\\in B$, no input maps to $w$, so it is not in the range.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
