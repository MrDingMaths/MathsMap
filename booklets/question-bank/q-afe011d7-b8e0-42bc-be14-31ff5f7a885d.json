  "content": {
    "id": "p9-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "$a$ is proportional to $x$ and inversely proportional to $y$. If $a=8$ when $x=7$ and $y=14$, find $a$ when $x=14$ and $y=7$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=32$.",
      "worked": "Write $a=\\dfrac{kx}{y}$ for a constant $k$.\n$$\\begin{align*}8&=\\frac{k\\times7}{14}\\\\8&=\\frac{k}{2}\\\\k&=16\\end{align*}$$\nHence $a=\\dfrac{16x}{y}$. When $x=14$ and $y=7$,\n$$\\begin{align*}a&=\\frac{16\\times14}{7}\\\\a&=32.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
