  "content": {
    "id": "p9-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A man walks $2\\frac{7}{8}$ km and then runs for $1\\frac{3}{4}$ km. How far has he travelled in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\frac{5}{8}$ km",
      "worked": "$$\\begin{align*}2\\frac{7}{8}+1\\frac{3}{4}&=2\\frac{7}{8}+1\\frac{6}{8}\\\\2\\frac{7}{8}+1\\frac{3}{4}&=3+\\frac{13}{8}\\\\2\\frac{7}{8}+1\\frac{3}{4}&=3+1+\\frac{5}{8}\\\\2\\frac{7}{8}+1\\frac{3}{4}&=4\\frac{5}{8}\\end{align*}$$\nHe has travelled $4\\frac{5}{8}$ km in total.",
      "solutionDiagrams": []
    },
