  "content": {
    "id": "p31-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find $a$ if the curve $y=x^3-ax^2+3x-4$ has an inflection at the point where $x=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=6$.",
      "worked": "$$\\begin{align*}y'&=3x^2-2ax+3\\\\y''&=6x-2a\\end{align*}$$\nAt the point of inflection, $y''(2)=0$.\n$$\\begin{align*}6(2)-2a&=0\\\\12-2a&=0\\\\a&=6\\end{align*}$$\nFor $a=6$, $y''=6(x-2)$ is negative for $x<2$ and positive for $x>2$, confirming the change in concavity.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
