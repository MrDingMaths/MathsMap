        "answerSpaceMm": 68
      },
      {
        "id": "p118-q45-b",
        "type": "part",
        "label": "b",
        "prompt": "Express $f(x)$ as a piecewise-defined function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$f(x)=\\begin{cases}x&\\text{if }x\\ge0,\\\\0&\\text{if }x<0.\\end{cases}$$",
          "worked": "For $x\\ge0$, the maximum of $x$ and $0$ is $x$. For $x<0$, the maximum is $0$. Hence\n$$f(x)=\\begin{cases}x&\\text{if }x\\ge0,\\\\0&\\text{if }x<0.\\end{cases}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
