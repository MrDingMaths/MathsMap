  "content": {
    "id": "p118-q45-content",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=\\max\\{x,0\\}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p118-q45-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The rays $y=0$ for $x<0$ and $y=x$ for $x\\ge0$, joined at the included origin.",
          "worked": "For $x<0$, the maximum is $0$, so the left branch is $y=0$. For $x\\ge0$, the maximum is $x$, so the right branch is $y=x$.\n\nThe branches meet at $(0,0)$ with no hole. The rising branch passes through $(1,1)$.",
          "solutionDiagrams": [
            {
              "id": "p118-q45-a-solution-graph",
              "role": "solution",
              "format": "tikz",
