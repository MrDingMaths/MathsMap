              "src": null,
              "widthMm": 60,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 26,
                "sourceRegion": "Answer book, printed page 604, left column, Question 45(a).",
                "description": "Unshaded coordinate graph with a horizontal left ray on the x-axis and a rising right ray, joined at the origin. Dashed guides identify (1,1).",
                "mathematics": "y=0 for x<0; y=x for x>=0. The origin belongs to the graph. Both branches continue indefinitely in their indicated directions.",
                "answerVisibility": "Solution only; the student question supplies no axes or drawing scaffold."
