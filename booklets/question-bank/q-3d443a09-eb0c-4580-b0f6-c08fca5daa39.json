  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": "",
    "prompt": "Find $\\dfrac{dx}{dy}$ of the inverse function $f^{-1}(x)$ of each function in terms of $y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-paired-parts",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q5-a",
            "type": "part",
            "label": "a",
            "prompt": "$f(x)=x^2e^x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{dx}{dy}=ye^y(2+y)$.",
              "worked": "$$\\begin{aligned}x&=y^2e^y\\\\\\frac{dx}{dy}&=2ye^y+y^2e^y\\\\&=ye^y(2+y).\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p9-q5-b",
            "type": "part",
            "label": "b",
            "prompt": "$f(x)=3x\\sin 2x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{dx}{dy}=3\\sin 2y+6y\\cos 2y$.",
              "worked": "$$\\begin{aligned}x&=3y\\sin 2y\\\\\\frac{dx}{dy}&=3\\sin 2y+3y(2\\cos 2y)\\\\&=3\\sin 2y+6y\\cos 2y.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p9-q5-c",
            "type": "part",
            "label": "c",
            "prompt": "$y=x(2x-3)^4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{dx}{dy}=(2y-3)^3(10y-3)$.",
              "worked": "$$\\begin{aligned}x&=y(2y-3)^4\\\\\\frac{dx}{dy}&=(2y-3)^4+y\\cdot4(2y-3)^3\\cdot2\\\\&=(2y-3)^3\\bigl((2y-3)+8y\\bigr)\\\\&=(2y-3)^3(10y-3).\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p9-q5-d",
            "type": "part",
            "label": "d",
            "prompt": "$f(x)=\\dfrac{3x-1}{2x+5}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{dx}{dy}=\\dfrac{17}{(2y+5)^2}$.",
              "worked": "$$\\begin{aligned}x&=\\frac{3y-1}{2y+5}\\\\\\frac{dx}{dy}&=\\frac{3(2y+5)-2(3y-1)}{(2y+5)^2}\\\\&=\\frac{17}{(2y+5)^2}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p9-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{\\ln x}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dx}{dy}=\\dfrac{y+2-y\\ln y}{y(y+2)^2}$.",
          "worked": "$$\\begin{aligned}x&=\\frac{\\ln y}{y+2}\\\\\\frac{dx}{dy}&=\\frac{\\frac1y(y+2)-\\ln y}{(y+2)^2}\\\\&=\\frac{y+2-y\\ln y}{y(y+2)^2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
