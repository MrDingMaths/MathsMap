      {
        "id": "p27-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $\\tan^{-1}\\left(\\frac{x^3}{2}\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6x^2}{4+x^6}$",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}\\left(\\tan^{-1}\\left(\\frac{x^3}{2}\\right)\\right)&=\\frac{1}{1+\\left(\\frac{x^3}{2}\\right)^2}\\cdot\\frac32x^2\\\\&=\\frac{\\frac32x^2}{1+\\frac{x^6}{4}}\\\\&=\\frac{6x^2}{4+x^6}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p27-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int\\frac{x^2}{4+x^6}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac16\\tan^{-1}\\left(\\dfrac{x^3}{2}\\right)+C$",
          "worked": "Since\n$$\\int\\frac{6x^2}{4+x^6}\\,dx=\\tan^{-1}\\left(\\frac{x^3}{2}\\right)+C,$$\n$$\\begin{aligned}\\int\\frac{x^2}{4+x^6}\\,dx&=\\frac16\\int\\frac{6x^2}{4+x^6}\\,dx\\\\&=\\frac16\\tan^{-1}\\left(\\frac{x^3}{2}\\right)+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
