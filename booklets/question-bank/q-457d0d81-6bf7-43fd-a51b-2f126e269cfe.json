  "content": {
    "id": "p12-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Find the term independent of $x$ in the expansion of $\\left(x+\\frac{3}{x}\\right)^{10}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$61\\,236$",
      "worked": "$$\\begin{align*}T_k&=\\binom{10}{k}x^{10-k}\\left(\\frac{3}{x}\\right)^k\\\\T_k&=\\binom{10}{k}3^kx^{10-2k}.\\end{align*}$$\nThe term independent of $x$ has exponent zero.\n$$\\begin{align*}10-2k&=0\\\\k&=5\\\\T_5&=\\binom{10}{5}3^5\\\\T_5&=61\\,236.\\end{align*}$$",
      "solutionDiagrams": []
    },
