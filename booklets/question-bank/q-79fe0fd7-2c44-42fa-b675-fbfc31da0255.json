  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve for $0^\\circ\\le\\theta<360^\\circ$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(2\\theta-60^\\circ)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=75^\\circ,\\ 255^\\circ$",
          "worked": "Let $u=2\\theta-60^\\circ$.\n$$\\begin{aligned}-60^\\circ&\\le 2\\theta-60^\\circ<660^\\circ\\\\-60^\\circ&\\le u<660^\\circ\\end{aligned}$$\n$$\\begin{aligned}\\sin u&=1\\\\u&=90^\\circ,\\ 450^\\circ\\\\2\\theta-60^\\circ&=90^\\circ,\\ 450^\\circ\\\\2\\theta&=150^\\circ,\\ 510^\\circ\\\\\\theta&=75^\\circ,\\ 255^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p24-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos(3\\theta+45^\\circ)=-\\dfrac{1}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=30^\\circ,\\ 60^\\circ,\\ 150^\\circ,\\ 180^\\circ,\\ 270^\\circ,\\ 300^\\circ$",
          "worked": "Let $u=3\\theta+45^\\circ$.\n$$\\begin{aligned}45^\\circ&\\le 3\\theta+45^\\circ<1125^\\circ\\\\45^\\circ&\\le u<1125^\\circ\\end{aligned}$$\n$$\\cos u=-\\frac{1}{\\sqrt{2}}$$\nThe reference angle is $45^\\circ$. Cosine is negative in quadrants II and III.\n$$\\begin{aligned}u&=135^\\circ,\\ 225^\\circ,\\ 495^\\circ, 585^\\circ,\\ 855^\\circ,\\ 945^\\circ\\\\3\\theta+45^\\circ&=135^\\circ,\\ 225^\\circ,\\ 495^\\circ, 585^\\circ,\\ 855^\\circ,\\ 945^\\circ\\\\3\\theta&=90^\\circ,\\ 180^\\circ,\\ 450^\\circ, 540^\\circ,\\ 810^\\circ,\\ 900^\\circ\\\\\\theta&=30^\\circ,\\ 60^\\circ,\\ 150^\\circ, 180^\\circ,\\ 270^\\circ,\\ 300^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
