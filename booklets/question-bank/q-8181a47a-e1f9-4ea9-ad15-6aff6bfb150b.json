  "content": {
    "id": "p19-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Suppose $x,y\\in\\mathbb{R}$ such that $2x+3y=12$. Prove that either $x\\geq 3$ or $y\\geq 2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "If $x<3$ and $y<2$, then $2x+3y<12$, contradicting $2x+3y=12$. Hence $x\\geq3$ or $y\\geq2$.",
      "worked": "Suppose the conclusion is false. Then $x<3$ and $y<2$, so\n$$\\begin{align*}2x+3y&<2(3)+3(2)\\\\2x+3y&<12.\\end{align*}$$\nThis contradicts $2x+3y=12$. Therefore, either $x\\geq3$ or $y\\geq2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
