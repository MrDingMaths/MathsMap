  "content": {
    "id": "p26-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The line $y=2x$ intersects the line $y=x+6$ at the point $A$. Find the equation of the line that passes through $A$ and has gradient 3.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=3x-6$",
      "worked": "At the intersection,\n$$\\begin{align*}2x&=x+6\\\\x&=6\\\\y&=2\\times6\\\\y&=12.\\end{align*}$$\nThus $A=(6,12)$. Both original equations give $y=12$ when $x=6$.\n\nUsing point–gradient form with gradient 3,\n$$\\begin{align*}y-12&=3(x-6)\\\\y-12&=3x-18\\\\y&=3x-6.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
