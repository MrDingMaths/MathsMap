        "label": "a",
        "prompt": "$\\dfrac{(n-2)!(n-1)!}{n!(n-3)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n-2}{n}$",
          "worked": "$$\\begin{aligned}\\frac{(n-2)!(n-1)!}{n!(n-3)!}&=\\frac{(n-2)!(n-1)!}{n(n-1)!(n-3)!}\\\\&=\\frac{(n-2)!}{n(n-3)!}\\\\&=\\frac{(n-2)(n-3)!}{n(n-3)!}\\\\&=\\frac{n-2}{n}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{n!(n-1)!}{(n+1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(n-1)!}{n+1}$",
          "worked": "$$\\begin{aligned}\\frac{n!(n-1)!}{(n+1)!}&=\\frac{n!(n-1)!}{(n+1)n!}\\\\&=\\frac{(n-1)!}{n+1}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
