  "content": {
    "id": "p21-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "David and Renae stand 36 metres apart. David runs towards Renae at a speed of 4 metres per second and Renae runs towards David at a speed of 5 metres per second.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "How long does it take for David and Renae to meet?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 seconds",
          "worked": "Their relative speed is the sum of their speeds because they run towards one another.\n\n$$\\begin{align*}s_{\\text{relative}}&=4+5\\\\s_{\\text{relative}}&=9\\text{ m/s}\\\\t&=\\frac{d}{s_{\\text{relative}}}\\\\t&=\\frac{36}{9}\\\\t&=4\\text{ s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p21-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "How far has David travelled by the time they met?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "16 metres",
          "worked": "$$\\begin{align*}d&=st\\\\d&=4\\times4\\\\d&=16\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
