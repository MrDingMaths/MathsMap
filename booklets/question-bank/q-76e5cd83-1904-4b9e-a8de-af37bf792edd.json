  "content": {
    "id": "p36-q3-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $\\displaystyle\\int\\frac{x}{\\sqrt{1-x^2}}\\,dx$, with $u=1-x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x\\,dx=-\\frac12\\,du$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\,dx=-\\frac12\\,du$.",
          "worked": "$$\\begin{aligned}u&=1-x^2\\\\\\frac{du}{dx}&=-2x\\\\du&=-2x\\,dx\\\\x\\,dx&=-\\frac12\\,du\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p36-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Show the integral can be written as $-\\frac12\\displaystyle\\int u^{-\\frac12}\\,du$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12\\displaystyle\\int u^{-\\frac12}\\,du$.",
          "worked": "$$\\begin{aligned}\\int\\frac{x}{\\sqrt{1-x^2}}\\,dx&=\\int\\frac1{\\sqrt u}\\left(-\\frac12\\right)\\,du\\\\&=-\\frac12\\int u^{-\\frac12}\\,du\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p36-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find the primitive of $\\dfrac{x}{\\sqrt{1-x^2}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sqrt{1-x^2}+C$.",
          "worked": "$$\\begin{aligned}\\int\\frac{x}{\\sqrt{1-x^2}}\\,dx&=-\\frac12(2\\sqrt u)+C\\\\&=-\\sqrt u+C\\\\&=-\\sqrt{1-x^2}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
