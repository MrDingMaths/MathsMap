        "questionDiagrams": [],
        "children": [
          {
            "id": "p46-q4-a",
            "type": "part",
            "label": "a",
            "prompt": "$\\displaystyle\\int_0^2(3-2x)^5\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{182}{3}$",
              "worked": "$$\\begin{aligned}\\int_0^2(3-2x)^5\\,dx&=\\left[-\\frac{(3-2x)^6}{12}\\right]_0^2\\\\&=-\\frac{(-1)^6-3^6}{12}\\\\&=\\frac{728}{12}\\\\&=\\frac{182}{3}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p46-q4-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\displaystyle\\int_0^1\\frac{(3x-1)^2}{6}\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac16$",
              "worked": "$$\\begin{aligned}\\int_0^1\\frac{(3x-1)^2}{6}\\,dx&=\\left[\\frac{(3x-1)^3}{54}\\right]_0^1\\\\&=\\frac{2^3-(-1)^3}{54}\\\\&=\\frac16\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p46-q4-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\displaystyle\\int_4^5(5-x)^6\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac17$",
              "worked": "$$\\begin{aligned}\\int_4^5(5-x)^6\\,dx&=\\left[-\\frac{(5-x)^7}{7}\\right]_4^5\\\\&=-\\frac{0^7-1^7}{7}\\\\&=\\frac17\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p46-q4-d",
            "type": "part",
            "label": "d",
            "prompt": "$\\displaystyle\\int_3^6\\sqrt{x-2}\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{14}{3}$",
              "worked": "$$\\begin{aligned}\\int_3^6\\sqrt{x-2}\\,dx&=\\left[\\frac23(x-2)^{3/2}\\right]_3^6\\\\&=\\frac23\\left(4^{3/2}-1^{3/2}\\right)\\\\&=\\frac23(8-1)\\\\&=\\frac{14}{3}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p46-q4-e",
            "type": "part",
            "label": "e",
            "prompt": "$\\displaystyle\\int_0^{1/2}\\sin(\\pi x)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac1\\pi$",
              "worked": "$$\\begin{aligned}\\int_0^{1/2}\\sin(\\pi x)\\,dx&=\\left[-\\frac{\\cos(\\pi x)}{\\pi}\\right]_0^{1/2}\\\\&=-\\frac{\\cos(\\pi/2)-\\cos0}{\\pi}\\\\&=\\frac1\\pi\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p46-q4-f",
            "type": "part",
            "label": "f",
            "prompt": "$\\displaystyle\\int_0^{\\pi/8}\\sec^2(2x)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac12$",
              "worked": "$$\\begin{aligned}\\int_0^{\\pi/8}\\sec^2(2x)\\,dx&=\\left[\\frac12\\tan(2x)\\right]_0^{\\pi/8}\\\\&=\\frac12\\left(\\tan\\frac\\pi4-\\tan0\\right)\\\\&=\\frac12\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p46-q4-g",
            "type": "part",
            "label": "g",
            "prompt": "$\\displaystyle\\int_{\\pi/2}^{\\pi}\\sin\\left(\\frac{x}{2}\\right)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt2$",
              "worked": "$$\\begin{aligned}\\int_{\\pi/2}^{\\pi}\\sin\\left(\\frac{x}{2}\\right)\\,dx&=\\left[-2\\cos\\frac{x}{2}\\right]_{\\pi/2}^{\\pi}\\\\&=-2\\left(\\cos\\frac\\pi2-\\cos\\frac\\pi4\\right)\\\\&=\\sqrt2\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p46-q4-h",
            "type": "part",
            "label": "h",
            "prompt": "$\\displaystyle\\int_0^{\\pi/12}3\\cos(2x)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac34$",
              "worked": "$$\\begin{aligned}\\int_0^{\\pi/12}3\\cos(2x)\\,dx&=\\left[\\frac32\\sin(2x)\\right]_0^{\\pi/12}\\\\&=\\frac32\\left(\\sin\\frac\\pi6-\\sin0\\right)\\\\&=\\frac34\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p46-q4-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\displaystyle\\int_0^{\\pi/10}-\\sin(5x)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\frac15$",
              "worked": "$$\\begin{aligned}\\int_0^{\\pi/10}-\\sin(5x)\\,dx&=\\left[\\frac15\\cos(5x)\\right]_0^{\\pi/10}\\\\&=\\frac15\\left(\\cos\\frac\\pi2-\\cos0\\right)\\\\&=-\\frac15\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p46-q4-j",
            "type": "part",
            "label": "j",
            "prompt": "$\\displaystyle\\int_1^4 2e^{3x+4}\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2e^7}{3}(e^9-1)$",
              "worked": "$$\\begin{aligned}\\int_1^4 2e^{3x+4}\\,dx&=\\left[\\frac23e^{3x+4}\\right]_1^4\\\\&=\\frac23(e^{16}-e^7)\\\\&=\\frac{2e^7}{3}(e^9-1)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p46-q4-k",
            "type": "part",
            "label": "k",
            "prompt": "$\\displaystyle\\int_0^2(e^{2x}+1)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac12e^4+\\frac32$",
              "worked": "$$\\begin{aligned}\\int_0^2(e^{2x}+1)\\,dx&=\\left[\\frac12e^{2x}+x\\right]_0^2\\\\&=\\left(\\frac12e^4+2\\right)-\\frac12\\\\&=\\frac12e^4+\\frac32\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p46-q4-l",
            "type": "part",
            "label": "l",
            "prompt": "$\\displaystyle\\int_1^2(e^x-x)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$e^2-e-\\frac32$",
              "worked": "$$\\begin{aligned}\\int_1^2(e^x-x)\\,dx&=\\left[e^x-\\frac{x^2}{2}\\right]_1^2\\\\&=(e^2-2)-\\left(e-\\frac12\\right)\\\\&=e^2-e-\\frac32\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p46-q4-m",
            "type": "part",
            "label": "m",
            "prompt": "$\\displaystyle\\int_2^3(3x^2-e^{2x})\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$19-\\frac12e^4(e^2-1)$",
              "worked": "$$\\begin{aligned}\\int_2^3(3x^2-e^{2x})\\,dx&=\\left[x^3-\\frac12e^{2x}\\right]_2^3\\\\&=\\left(27-\\frac12e^6\\right)\\\\&\\quad-\\left(8-\\frac12e^4\\right)\\\\&=19-\\frac12e^4(e^2-1)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          },
          {
            "id": "p46-q4-n",
            "type": "part",
            "label": "n",
            "prompt": "$\\displaystyle\\int_0^3(e^{2x}-e^{-x})\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac12e^6+e^{-3}-\\frac32$",
              "worked": "$$\\begin{aligned}\\int_0^3(e^{2x}-e^{-x})\\,dx&=\\left[\\frac12e^{2x}+e^{-x}\\right]_0^3\\\\&=\\frac12e^6+e^{-3}\\\\&\\quad-\\left(\\frac12+1\\right)\\\\&=\\frac12e^6+e^{-3}-\\frac32\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p46-q4-o",
            "type": "part",
            "label": "o",
            "prompt": "$\\displaystyle\\int_0^2\\frac5{(2x+1)^3}\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac65$",
              "worked": "$$\\begin{aligned}\\int_0^2\\frac5{(2x+1)^3}\\,dx&=5\\int_0^2(2x+1)^{-3}\\,dx\\\\&=\\left[-\\frac5{4(2x+1)^2}\\right]_0^2\\\\&=-\\frac5{100}+\\frac54\\\\&=\\frac65\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p46-q4-p",
            "type": "part",
            "label": "p",
            "prompt": "$\\displaystyle\\int_1^4\\frac2{\\sqrt{(5x-4)^3}}\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac35$",
              "worked": "$$\\begin{aligned}\\int_1^4\\frac2{\\sqrt{(5x-4)^3}}\\,dx&=2\\int_1^4(5x-4)^{-3/2}\\,dx\\\\&=\\left[-\\frac4{5\\sqrt{5x-4}}\\right]_1^4\\\\&=-\\frac4{5\\sqrt{16}}+\\frac45\\\\&=\\frac35\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p46-q4-q",
            "type": "part",
            "label": "q",
            "prompt": "$\\displaystyle\\int_1^3\\frac2{2x+5}\\,dx$\n\nGive your answer correct to 1 decimal place.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.5$",
              "worked": "$$\\begin{aligned}\\int_1^3\\frac2{2x+5}\\,dx&=\\left[\\ln|2x+5|\\right]_1^3\\\\&=\\ln11-\\ln7\\\\&=\\ln\\frac{11}{7}\\\\&\\approx0.5\\end{aligned}$$\nTo 1 decimal place.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p46-q4-r",
            "type": "part",
            "label": "r",
            "prompt": "$\\displaystyle\\int_2^5\\frac1{x+1}\\,dx$\n\nGive your answer correct to 1 decimal place.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.7$",
              "worked": "$$\\begin{aligned}\\int_2^5\\frac1{x+1}\\,dx&=\\left[\\ln|x+1|\\right]_2^5\\\\&=\\ln6-\\ln3\\\\&=\\ln2\\\\&\\approx0.7\\end{aligned}$$\nTo 1 decimal place.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
