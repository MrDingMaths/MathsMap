            "id": "p46-q4-s",
            "type": "part",
            "label": "s",
            "prompt": "$\\displaystyle\\int\\left(\\cos x\\cos\\left(\\frac\\pi3\\right)-\\sin x\\sin\\left(\\frac\\pi3\\right)\\right)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{\\sin x+\\sqrt3\\cos x}{2}+C$",
              "worked": "$$\\begin{aligned}\\int\\left(\\cos x\\cos\\frac\\pi3-\\sin x\\sin\\frac\\pi3\\right)\\,dx&=\\int\\left(\\frac12\\cos x-\\frac{\\sqrt3}{2}\\sin x\\right)\\,dx\\\\&=\\frac12\\sin x+\\frac{\\sqrt3}{2}\\cos x+C\\\\&=\\frac{\\sin x+\\sqrt3\\cos x}{2}+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p46-q4-t",
            "type": "part",
            "label": "t",
            "prompt": "$\\displaystyle\\int(\\sin\\pi\\cos x-\\cos\\pi\\sin x)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\cos x+C$",
              "worked": "$$\\begin{aligned}\\int(\\sin\\pi\\cos x-\\cos\\pi\\sin x)\\,dx&=\\int(0\\cos x+\\sin x)\\,dx\\\\&=-\\cos x+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
