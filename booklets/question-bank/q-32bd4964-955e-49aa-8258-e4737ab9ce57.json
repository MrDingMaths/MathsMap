  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A sheet of paper is roughly 0.05 mm thick. The sheet of paper is folded $n$ times, which doubles the thickness with every fold.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the thickness of the sheet of paper after two folds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.20\\,\\mathrm{mm}$.",
          "worked": "$$\\begin{align*}T(2)&=0.05\\times2^2\\,\\mathrm{mm}\\\\T(2)&=0.20\\,\\mathrm{mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p22-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If the thickness is 1.6 mm, how many folds have been made?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 folds.",
          "worked": "$$\\begin{align*}0.05\\times 2^n&=1.6\\\\2^n&=32\\\\2^n&=2^5\\\\n&=5\\end{align*}$$\n\nThe sheet has been folded 5 times.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
