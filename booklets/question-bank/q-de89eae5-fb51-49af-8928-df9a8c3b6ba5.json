    "label": "11",
    "prompt": "Find $y$ in terms of $x$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$4x^2-y^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x$ or $y=-2x$.",
          "worked": "$$\\begin{align*}(2x-y)(2x+y)&=0\\\\2x-y&=0\\quad\\text{or}\\quad 2x+y=0\\\\y&=2x\\quad\\text{or}\\quad y=-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p20-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-9xy-22y^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{x}{11}$ or $y=-\\dfrac{x}{2}$.\n\nFactorise and set each factor equal to zero.",
          "worked": "$$\\begin{align*}x^2-11xy+2xy-22y^2&=0\\\\x(x-11y)+2y(x-11y)&=0\\\\(x-11y)(x+2y)&=0\\\\x-11y&=0\\quad\\text{or}\\quad x+2y=0\\\\y&=\\frac{x}{11}\\quad\\text{or}\\quad y=-\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
