        "id": "p31-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the perpendicular height of an equilateral triangle, side length 10 cm.\nAnswer in exact surd form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p31-q13-a-triangle",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"User feedback 19 October 2026\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\draw[black] (0,0)--(3,0)--(1.5,{1.5*sqrt(3)})--cycle;\n\\path (0,0)--(3,0) node[midway,below] {$10\\text{ cm}$};\n\\draw[black,line width=0.4pt] (0.68,1.33)--(0.82,1.25) (2.18,1.25)--(2.32,1.33) (1.5,-0.08)--(1.5,0.08);\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 45,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$5\\sqrt3\\text{ cm}$.",
          "worked": "The perpendicular height bisects the base, giving a right-angled triangle with hypotenuse $10\\text{ cm}$ and shorter side $5\\text{ cm}$.\n$$\\begin{aligned}h&=\\sqrt{10^2-5^2}\\\\&=\\sqrt{75}\\\\&=5\\sqrt3\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p31-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the perpendicular height of an equilateral triangle with side length $x$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p31-q13-b-triangle",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"User feedback 19 October 2026\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\draw[black] (0,0)--(3,0)--(1.5,{1.5*sqrt(3)})--cycle;\n\\path (0,0)--(3,0) node[midway,below] {$x\\text{ cm}$};\n\\draw[black,line width=0.4pt] (0.68,1.33)--(0.82,1.25) (2.18,1.25)--(2.32,1.33) (1.5,-0.08)--(1.5,0.08);\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 45,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3}{2}x\\text{ cm}$.",
          "worked": "The perpendicular height bisects the base, giving a right-angled triangle with hypotenuse $x$ and shorter side $\\frac{x}{2}$.\n$$\\begin{aligned}h&=\\sqrt{x^2-\\left(\\frac{x}{2}\\right)^2}\\\\&=\\sqrt{x^2-\\frac{x^2}{4}}\\\\&=\\sqrt{\\frac{3x^2}{4}}\\\\&=\\frac{\\sqrt3}{2}x\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
