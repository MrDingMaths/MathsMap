  "content": {
    "id": "p5-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the exact value of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sec 0^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\sec 0^\\circ&=\\frac{1}{\\cos 0^\\circ}\\\\&=\\frac{1}{1}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p5-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\operatorname{cosec}270^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{aligned}\\operatorname{cosec}270^\\circ&=\\frac{1}{\\sin270^\\circ}\\\\&=\\frac{1}{-1}\\\\&=-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p5-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sec90^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Undefined.",
          "worked": "$$\\begin{aligned}\\sec90^\\circ&=\\frac{1}{\\cos90^\\circ}\\\\&=\\frac{1}{0}\\end{aligned}$$\nUndefined because division by zero is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p5-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\operatorname{cosec}180^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Undefined.",
          "worked": "$$\\begin{aligned}\\operatorname{cosec}180^\\circ&=\\frac{1}{\\sin180^\\circ}\\\\&=\\frac{1}{0}\\end{aligned}$$\nUndefined because division by zero is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p5-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cot270^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{aligned}\\cot270^\\circ&=\\frac{\\cos270^\\circ}{\\sin270^\\circ}\\\\&=\\frac{0}{-1}\\\\&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p5-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sec180^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{aligned}\\sec180^\\circ&=\\frac{1}{\\cos180^\\circ}\\\\&=\\frac{1}{-1}\\\\&=-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
