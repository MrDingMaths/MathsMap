  "content": {
    "id": "p2-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Express each equation in the form $(x-h)^2+(y-k)^2=r^2$ and hence state the coordinates of the centre and the radius of the circle.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-4x+y^2+6y+9=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2+(y+3)^2=4$; centre $(2,-3)$, radius $2$.",
          "worked": "$$\\begin{align*}x^2-4x+y^2+6y&=-9\\\\x^2-4x+4+y^2+6y+9&=-9+4+9\\\\(x-2)^2+(y+3)^2&=4\\end{align*}$$\nThe centre is $(2,-3)$ and the radius is $\\sqrt{4}=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p2-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+2x+y^2+8y+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2+(y+4)^2=16$; centre $(-1,-4)$, radius $4$.",
          "worked": "$$\\begin{align*}x^2+2x+y^2+8y&=-1\\\\x^2+2x+1+y^2+8y+16&=-1+1+16\\\\(x+1)^2+(y+4)^2&=16\\end{align*}$$\nThe centre is $(-1,-4)$ and the radius is $\\sqrt{16}=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
