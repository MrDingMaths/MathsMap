        "prompt": "What fraction of the perimeter is one width of the rectangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{10}$; the perimeter contains $2(1+4)=10$ width-sized parts.",
          "worked": "Width : length $=1:4$, so a width is 1 part and a length is 4 parts.\n\n$$\\begin{aligned}\\text{Perimeter in parts}&=2(1+4)\\\\\\text{Perimeter in parts}&=10\\\\\\text{Fraction for one width}&=\\frac{1}{10}\\end{aligned}$$",
          "solutionDiagrams": []
