  "content": {
    "id": "p11-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the equation of the line:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "through $(1,1)$ with gradient $2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-1$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-1&=2(x-1)\\\\y-1&=2x-2\\\\y&=2x-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "with gradient $-1$ through $(3,1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x+4$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-1&=-(x-3)\\\\y-1&=-x+3\\\\y&=-x+4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "through $(0,0)$ with gradient $-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-5x$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-0&=-5(x-0)\\\\y&=-5x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "through $(-1,3)$ with gradient $-\\frac13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{x}{3}+\\frac83$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-3&=-\\frac13(x+1)\\\\y-3&=-\\frac{x}{3}-\\frac13\\\\y&=-\\frac{x}{3}+\\frac83\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p11-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "with gradient $-\\frac45$ through $(3,-4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{4x}{5}-\\frac85$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y+4&=-\\frac45(x-3)\\\\y+4&=-\\frac{4x}{5}+\\frac{12}{5}\\\\y&=-\\frac{4x}{5}-\\frac85\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p11-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "through $(-5,3)$ with gradient $-\\frac35$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{3x}{5}$",
          "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-3&=-\\frac35(x+5)\\\\y-3&=-\\frac{3x}{5}-3\\\\y&=-\\frac{3x}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
