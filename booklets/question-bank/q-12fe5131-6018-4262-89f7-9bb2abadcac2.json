                  "latex": "a>1",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "b>1",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", connect the points ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "(-a,a^2)",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "(b,b^2)",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " with line segments. Determine which positive integers ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "n",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " ",
