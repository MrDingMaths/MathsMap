  "content": {
    "id": "p8-q7",
    "type": "question",
    "label": "7",
    "prompt": "Consider this dataset: $10, 20, 30, 40, 50, 60, 70, 80$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7a",
        "type": "part",
        "label": "a",
        "prompt": "What is the range?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70$",
          "worked": "$$\\begin{align*}\\text{Range} &= 80-10\\\\\\text{Range} &= 70\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q7b",
        "type": "part",
        "label": "b",
        "prompt": "Change one score to make the range $60$. List your new scores.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $20, 20, 30, 40, 50, 60, 70, 80$: change $10$ to $20$. Other valid answers are possible.",
          "worked": "Change $10$ to $20$. The new scores are $20, 20, 30, 40, 50, 60, 70, 80$. $$\\begin{align*}\\text{New range} &= 80-20\\\\\\text{New range} &= 60\\end{align*}$$ Other valid answers are possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q7c",
        "type": "part",
        "label": "c",
        "prompt": "Which scores affect the range?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The smallest and largest scores: $10$ and $80$.",
          "worked": "The range uses only the minimum and maximum: $\\text{Range}=\\text{Max}-\\text{Min}$. Here these scores are $10$ and $80$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
