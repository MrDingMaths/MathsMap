  "content": {
    "id": "p14-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The quadrilateral $ABCD$ has vertices $A(-1,1)$, $B(3,-1)$, $C(5,3)$ and $D(1,5)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the opposite sides are parallel, and hence that $ABCD$ is a parallelogram.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AB}=m_{DC}=-\\frac12$ and $m_{BC}=m_{AD}=2$. Both pairs of opposite sides are parallel, so $ABCD$ is a parallelogram.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q7-a-answer-calculations",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}m_{AB}&=\\frac{-1-1}{3-(-1)}=-\\frac12\\\\m_{DC}&=\\frac{5-3}{1-5}=-\\frac12\\\\m_{BC}&=\\frac{3-(-1)}{5-3}=2\\\\m_{AD}&=\\frac{5-1}{1-(-1)}=2\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p14-q7-a-answer-parallel",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "m_{AB}=m_{DC}",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "m_{BC}=m_{AD}",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", so opposite sides are parallel.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p14-q7-a-answer-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "ABCD",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is a parallelogram.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $AB\\perp BC$, and hence that $ABCD$ is a rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AB}m_{BC}=-\\frac12\\times2=-1$, so $AB\\perp BC$. The parallelogram $ABCD$ is therefore a rectangle.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q7-b-answer-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}m_{AB}\\times m_{BC}&=-\\frac12\\times2=-1\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p14-q7-b-answer-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "AB\\perp BC",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", so ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "ABCD",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is a rectangle (parallelogram with adjacent sides perpendicular).",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $AB=BC$, and hence that $ABCD$ is a square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=BC=\\sqrt{20}$. The rectangle $ABCD$ has equal adjacent sides, so it is a square.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q7-c-answer-calculations",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}AB&=\\sqrt{(3-(-1))^2+(-1-1)^2}=\\sqrt{20}\\\\BC&=\\sqrt{(5-3)^2+(3-(-1))^2}=\\sqrt{20}\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p14-q7-c-answer-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "AB=BC",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", so ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "ABCD",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is a square (rectangle with adjacent sides equal).",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
