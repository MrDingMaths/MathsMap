    "id": "p41-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "English exam results are normally distributed with mean 70 and standard deviation 10.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage of pupils score over 50?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $97.5\\%$.",
          "worked": "$$\\begin{aligned}z&=\\frac{50-70}{10}=-2\\\\P(X>50)&=P(Z>-2)=P(Z\\leq2)\\\\P(X>50)&\\approx0.5+0.475=0.975\\end{aligned}$$\nApproximately $97.5\\%$ of pupils score over 50.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p41-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage score under 80?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $84\\%$.",
          "worked": "$$\\begin{aligned}z&=\\frac{80-70}{10}=1\\\\P(X<80)&=P(Z<1)\\\\P(X<80)&\\approx0.5+0.34=0.84\\end{aligned}$$\nApproximately $84\\%$ score under 80.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
