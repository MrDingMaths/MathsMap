  "content": {
    "id": "p15-q30-root",
    "type": "question",
    "label": null,
    "prompt": "Define the function $f$ with the rule $f(x)=x^3+1$, where $x\\in\\{-1,0,1,2\\}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q30-a",
        "type": "part",
        "label": "a",
        "prompt": "State the domain and range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $\\{-1,0,1,2\\}$. Range: $\\{0,1,2,9\\}$.",
          "worked": "$$\\begin{align*}f(-1)&=(-1)^3+1\\\\f(-1)&=0\\\\f(0)&=0^3+1\\\\f(0)&=1\\\\f(1)&=1^3+1\\\\f(1)&=2\\\\f(2)&=2^3+1\\\\f(2)&=9\\end{align*}$$\nThe domain is $\\{-1,0,1,2\\}$ and the range is $\\{0,1,2,9\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p15-q30-b",
        "type": "part",
        "label": "b",
        "prompt": "Write the function $f$ as a set of ordered pairs.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f=\\{(-1,0),(0,1),(1,2),(2,9)\\}$.",
          "worked": "Pair each input with its output from part (a).\n$$f=\\{(-1,0),(0,1),(1,2),(2,9)\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
