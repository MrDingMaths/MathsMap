            },
            {
              "type": "math",
              "latex": "a",
              "display": false
            },
            {
              "type": "text",
              "text": " so that the function is continuous at all points in its domain.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p116-task-30-33-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p116-task-30-33-a-function",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(x)=\\begin{cases}x^2+ax&\\text{if }x\\le 1\\\\5x-2&\\text{if }x>1\\end{cases}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$.",
          "worked": "At $x=1$,\n$$\\begin{align*}f(1)&=1+a\\\\f_L(1)&=1+a\\\\f_R(1)&=3\\end{align*}$$\nFor continuity, all three values must agree:\n$$\\begin{align*}1+a&=3\\\\a&=2\\end{align*}$$\nBoth polynomial branches are continuous elsewhere, so $a=2$ gives continuity throughout the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p116-task-30-33-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p116-task-30-33-b-function",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(x)=\\begin{cases}3x+a&\\text{if }x<0\\\\x^2-2x+1&\\text{if }x\\ge 0\\end{cases}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$.",
          "worked": "At $x=0$,\n$$\\begin{align*}f(0)&=1\\\\f_L(0)&=a\\\\f_R(0)&=1\\end{align*}$$\nAll three values agree when $a=1$. Both polynomial branches are continuous elsewhere, so this gives continuity throughout the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p116-task-30-33-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p116-task-30-33-c-function",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(x)=\\begin{cases}2x+3&\\text{if }x<1\\\\-x^2+a&\\text{if }x\\ge 1\\end{cases}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=6$.",
          "worked": "At $x=1$,\n$$\\begin{align*}f(1)&=a-1\\\\f_L(1)&=5\\\\f_R(1)&=a-1\\end{align*}$$\nFor continuity, all three values must agree:\n$$\\begin{align*}a-1&=5\\\\a&=6\\end{align*}$$\nBoth polynomial branches are continuous elsewhere, so $a=6$ gives continuity throughout the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p116-task-30-33-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p116-task-30-33-d-function",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(x)=\\begin{cases}ax+2&\\text{if }x\\le 2\\\\2a^2x&\\text{if }x>2\\end{cases}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p116-task-30-33-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=-\\frac12",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " or ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p116-task-30-33-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Match the branch values at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and solve ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2a+2=4a^2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "At $x=2$,\n$$\\begin{align*}f(2)&=2a+2\\\\f_L(2)&=2a+2\\\\f_R(2)&=4a^2\\end{align*}$$\nFor continuity, all three values must agree:\n$$\\begin{align*}2a+2&=4a^2\\\\2a^2-a-1&=0\\\\(2a+1)(a-1)&=0\\\\a&=-\\frac12\\text{ or }a=1\\end{align*}$$\nFor $a=-\\frac12$, all three boundary values are $1$; for $a=1$, all three are $4$. Both polynomial branches are continuous elsewhere, so both parameter values give continuity throughout the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
