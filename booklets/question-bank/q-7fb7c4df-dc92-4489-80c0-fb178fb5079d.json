  "content": {
    "id": "p21-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "For $\\triangle ABC$ we are given that $a=6$ and $b=5$. Given that the area of the triangle is $10$, find $\\sin C$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sin C=\\dfrac23$",
      "worked": "$$\\begin{align*}10&=\\frac12(6)(5)\\sin C\\\\10&=15\\sin C\\\\\\sin C&=\\frac{10}{15}\\\\\\sin C&=\\frac23.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
