    "children": [
      {
        "id": "p47-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{2}-x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=17$; two real solutions.",
          "worked": "$$\\begin{aligned}\\Delta&=b^{2}-4ac\\\\\\Delta&=(-1)^{2}-4(1)(-4)\\\\\\Delta&=17\\end{aligned}$$\nSince $\\Delta>0$, there are two real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p47-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^{2}+3x+6=0$",
