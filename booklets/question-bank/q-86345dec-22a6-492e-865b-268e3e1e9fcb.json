    "children": [
      {
        "id": "p32-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "A laptop costs \\$440 before GST. Calculate the price including GST.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$484",
          "worked": "The pre-GST price represents $100\\%$; the price including GST represents $110\\%$.\n$$\\begin{align*}100\\% &= \\$440\\\\10\\% &= \\$440\\div10=\\$44\\\\110\\% &= \\$44\\times11=\\$484\\end{align*}$$\nThe price including GST is \\$484.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p32-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "A tablet's price including GST is \\$627. Find the original price before GST.",
