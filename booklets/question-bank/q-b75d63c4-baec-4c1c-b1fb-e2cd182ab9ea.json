  "content": {
    "id": "p10-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Find the rate $R$ in each simple interest investment.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "Interest of $\\$7200$ on $\\$8000$ for 12 years",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.5\\%$ p.a.",
          "worked": "$$\\begin{align*}I&=PRT\\\\7200&=8000\\times R\\times12\\\\R&=\\frac{7200}{8000\\times12}\\\\R&=0.075\\\\R&=7.5\\%\\text{ p.a.}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "Interest of $\\$3\\,400\\,000$ on $\\$12\\,500\\,000$ for four years",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.8\\%$ p.a.",
          "worked": "$$\\begin{align*}I&=PRT\\\\3\\,400\\,000&=12\\,500\\,000\\times R\\times4\\\\R&=\\frac{3\\,400\\,000}{12\\,500\\,000\\times4}\\\\R&=0.068\\\\R&=6.8\\%\\text{ p.a.}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
