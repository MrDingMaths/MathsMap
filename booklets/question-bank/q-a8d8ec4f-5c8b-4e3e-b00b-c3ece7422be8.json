            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 31 p31-q6-tree\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black},line cap=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (S) at (0,0);\n\\coordinate (D) at (23,18);\n\\coordinate (W) at (23,-18);\n\\coordinate (DD) at (49,27);\n\\coordinate (DW) at (49,9);\n\\coordinate (WD) at (49,-9);\n\\coordinate (WW) at (49,-27);\n\\node[anchor=east] at (S) {Start};\n\\node[align=center] at (23,39) {1st\\\\Bulb};\n\\node[align=center] at (49,39) {2nd\\\\Bulb};\n\\draw (S)--(D) node[midway,above,sloped=false] {0.05};\n\\draw (S)--(W) node[midway,below,sloped=false] {0.95};\n\\draw (D)--(DD) node[midway,above] {0.05};\n\\draw (D)--(DW) node[midway,below] {0.95};\n\\draw (W)--(WD) node[midway,above] {0.05};\n\\draw (W)--(WW) node[midway,below] {0.95};\n\\node[fill=white,inner sep=1pt] at (D) {D};\n\\node[fill=white,inner sep=1pt] at (W) {W};\n\\node[anchor=west,fill=white,inner sep=1pt] at (DD) {D};\n\\node[anchor=west,fill=white,inner sep=1pt] at (DW) {W};\n\\node[anchor=west,fill=white,inner sep=1pt] at (WD) {D};\n\\node[anchor=west,fill=white,inner sep=1pt] at (WW) {W};\n\\end{tikzpicture}",
