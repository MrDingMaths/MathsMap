        "children": [
          {
            "id": "p31-q6-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(\\text{both bulbs work})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.9025=90.25\\%$",
              "worked": "$$\\begin{aligned}P(\\text{both work})&=0.95\\times0.95\\\\&=0.9025\\\\&=90.25\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p31-q6-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the first bulb works, but the second is defective",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.0475=4.75\\%$",
              "worked": "$$\\begin{aligned}P(WD)&=0.95\\times0.05\\\\&=0.0475\\\\&=4.75\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p31-q6-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the first bulb is defective, but the second works",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.0475=4.75\\%$",
              "worked": "$$\\begin{aligned}P(DW)&=0.05\\times0.95\\\\&=0.0475\\\\&=4.75\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p31-q6-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(\\text{both bulbs are defective})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.0025=0.25\\%$",
              "worked": "$$\\begin{aligned}P(\\text{both defective})&=0.05\\times0.05\\\\&=0.0025\\\\&=0.25\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ],
        "diagramPlacement": "beside-prompt"
      },
      {
        "id": "p31-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the probability that at least one bulb works.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9975=99.75\\%$",
          "worked": "The complement of at least one bulb working is both bulbs being defective.\n$$\\begin{aligned}P(\\text{at least one works})&=1-P(\\text{both defective})\\\\&=1-0.0025\\\\&=0.9975\\\\&=99.75\\%\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
