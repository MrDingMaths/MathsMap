  "content": {
    "id": "p16-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve the pair of simultaneous equations algebraically: $3x+2y=12$ and $x-y=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac{14}{5}$, $y=\\frac95$.",
      "worked": "From $x-y=1$, $x=y+1$. Substitute into $3x+2y=12$:\n$$\\begin{align*}3(y+1)+2y&=12\\\\5y+3&=12\\\\5y&=9\\\\y&=\\frac95\\end{align*}$$\nThen\n$$\\begin{align*}x&=\\frac95+1\\\\x&=\\frac{14}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 39
  },
