  "content": {
    "id": "v2-690a0-p44-practice-j3-100327-root",
    "type": "question",
    "label": null,
    "prompt": "Evaluate the following expression in steps.\n$$\\frac{\\sqrt{25}-1}{\\sqrt[3]{-27}}\\times\\frac{\\sqrt{81}}{2^3}$$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-690a0-p44-practice-j3-100327-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $\\dfrac{\\sqrt{25}-1}{\\sqrt[3]{-27}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac43$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{25}-1}{\\sqrt[3]{-27}}&=\\frac{5-1}{-3}\\\\&=\\frac{4}{-3}\\\\&=-\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-690a0-p44-practice-j3-100327-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate $\\dfrac{\\sqrt{81}}{2^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac98$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{81}}{2^3}&=\\frac98\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-690a0-p44-practice-j3-100327-j3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence evaluate the whole expression.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac32$",
          "worked": "$$\\begin{align*}-\\frac43\\times\\frac98&=-\\frac{36}{24}\\\\&=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
