            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}7(2(x+3)-2x)&=7(2x+6-2x)\\\\&=7(6)\\\\&=42\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p22-q19-answer-conclusion",
