    "answer": {
      "short": "$7(2(x+3)-2x)=7(6)=42$ for any original number $x$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p22-q19-answer",
            "type": "paragraph",
