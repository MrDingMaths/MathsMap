  "content": {
    "id": "p32-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "In total, 14 carbon, hydrogen and nitrogen atoms make up one toxic molecule. If the number of carbon atoms is 5 more than the number of nitrogen atoms, and $42\\frac{6}{7}\\%$ of the atoms are carbon, find the number of each type of atom.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "6 carbon atoms, 7 hydrogen atoms and 1 nitrogen atom.",
      "worked": "$$\\begin{align*}\\text{Carbon atoms}&=\\frac{300}{7}\\times\\frac{1}{100}\\times14\\\\\\text{Carbon atoms}&=6\\\\\\text{Nitrogen atoms}&=6-5\\\\\\text{Nitrogen atoms}&=1\\\\\\text{Hydrogen atoms}&=14-6-1\\\\\\text{Hydrogen atoms}&=7\\end{align*}$$",
      "solutionDiagrams": []
    },
