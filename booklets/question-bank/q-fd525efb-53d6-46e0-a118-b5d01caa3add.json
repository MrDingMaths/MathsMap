  "content": {
    "id": "v2-218388-p5-practice-slot-3-091153-root",
    "type": "question",
    "label": null,
    "prompt": "Consider points $P(-6,8)$, $Q(6,-8)$ and $R(10,0)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-218388-p5-practice-slot-3-091153-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the points all lie on the circle $x^2+y^2=100$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$OP=OQ=OR=10$, so all three points lie on the circle with centre $(0,0)$ and radius $10$.",
          "worked": "$$\\begin{align*}OP&=\\sqrt{(-6)^2+8^2}=10\\\\OQ&=\\sqrt{6^2+(-8)^2}=10\\\\OR&=\\sqrt{10^2+0^2}=10\\end{align*}$$\nAll three points are $10$ units from the origin, so they lie on the circle $x^2+y^2=100$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-218388-p5-practice-slot-3-091153-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $PR\\perp QR$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{PR}=-\\frac12$ and $m_{QR}=2$. The gradients are negative reciprocals, so $PR\\perp QR$.",
          "worked": "$$\\begin{align*}m_{PR}&=\\frac{0-8}{10-(-6)}=\\frac{-8}{16}=-\\frac12\\\\m_{QR}&=\\frac{0-(-8)}{10-6}=\\frac84=2\\end{align*}$$\nThe gradients are negative reciprocals, since $-\\frac12\\times2=-1$. Therefore $PR\\perp QR$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
