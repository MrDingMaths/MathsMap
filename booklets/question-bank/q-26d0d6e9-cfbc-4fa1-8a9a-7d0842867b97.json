  "content": {
    "id": "v2-8113f-p18-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "Sam has $\\$6000$ to invest for 3 years. Option A pays 6% p.a. interest, compounded monthly. Option B pays 6.2% p.a. interest, compounded annually. Give monetary answers to the nearest cent.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8113f-p18-practice-slot-11-s11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the future value of Option A.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$7180.08$",
          "worked": "$$\\begin{align*}r &= \\frac{0.06}{12}=0.005\\\\n &= 3\\times12=36\\\\FV &= PV(1+r)^n\\\\FV &= 6000(1+0.005)^{36}\\\\FV &\\approx \\$7180.08\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-8113f-p18-practice-slot-11-s11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the future value of Option B.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$7186.62$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 6000(1+0.062)^3\\\\FV &\\approx \\$7186.62\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-8113f-p18-practice-slot-11-s11-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Which option gives more money, and by how much?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Option B, by $\\$6.54$.",
          "worked": "$$\\begin{align*}7186.62-7180.08 &= \\$6.54\\end{align*}$$\nOption B gives more, by $\\$6.54$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
