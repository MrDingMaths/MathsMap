  "content": {
    "id": "p8-q10-response",
    "type": "question",
    "label": "10",
    "prompt": "Kylie simplifies $\\dfrac{4x+6}{2}$ and gets $2x+6$. Explain her error and give the correct answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "She divided only the first term by 2. Both terms must be divided by 2, giving $2x+3$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p8-q10-answer-explanation",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "She divided only the first term by 2. Every term in the numerator must be divided:",
                "marks": []
              }
            ]
          },
          {
            "id": "p8-q10-answer-division",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\frac{4x+6}{2}&=\\frac{4x}{2}+\\frac{6}{2}\\\\&=2x+3\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p8-q10-answer-alternative",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Equivalently, factorise first:",
                "marks": []
              }
            ]
          },
          {
            "id": "p8-q10-answer-factorisation",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\frac{4x+6}{2}&=\\frac{2(2x+3)}{2}\\\\&=2x+3\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
