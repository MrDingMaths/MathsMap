  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider a square with side length $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p16-q8-square",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 16, p16-q8-square\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.8pt] (0,0) rectangle (3,3);\n\\draw[black,line width=0.4pt] (1.5,-0.15)--(1.5,0.15);\n\\draw[black,line width=0.4pt] (1.5,2.85)--(1.5,3.15);\n\\draw[black,line width=0.4pt] (-0.15,1.5)--(0.15,1.5);\n\\draw[black,line width=0.4pt] (2.85,1.5)--(3.15,1.5);\n\\node[black,left=3mm,font=\\fontsize{10}{12}\\selectfont] at (0,1.5) {$x$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 38,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 16,
          "sourceRegion": "Upper-right square beside parts a and b",
          "description": "Unshaded square with one centred equality tick on each side and x outside the left side. Decorative blue outline is rendered in house black.",
          "mathematics": "All four sides have equal length x.",
          "answerVisibility": "Permanent question figure; no supplied answers appear in the diagram."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p16-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the area of the square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2$",
          "worked": "$$\\begin{align*}A&=x\\times x\\\\A&=x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "The length of each side is now halved.\nGive an expression for the area of the new square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{4}$",
          "worked": "$$\\begin{align*}A&=\\frac{x}{2}\\times\\frac{x}{2}\\\\A&=\\frac{x^2}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "If each side of the original square is multiplied by 0.7, find an expression for the area of the square, as an algebraic fraction. Recall that $0.7=\\dfrac{7}{10}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{49x^2}{100}$",
          "worked": "$$\\begin{align*}A&=\\frac{7x}{10}\\times\\frac{7x}{10}\\\\A&=\\frac{7x\\times7x}{10\\times10}\\\\A&=\\frac{49x^2}{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p16-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "If each side of the original square is three-fifths of the original length, would the new area be more or less than half of the original area? Show your reasoning.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Less than half: the new area is $\\dfrac{9x^2}{25}$ and $\\dfrac{9}{25}<\\dfrac12$.",
          "worked": "$$\\begin{align*}A&=\\frac{3x}{5}\\times\\frac{3x}{5}\\\\A&=\\frac{9x^2}{25}\\end{align*}$$\nSince $\\dfrac{9}{25}=\\dfrac{18}{50}<\\dfrac{25}{50}=\\dfrac12$, the new area is less than half of the original area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "If you want to halve the area of the original square, by what factor would you have to divide each length?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Divide by $\\sqrt{2}$.",
          "worked": "Let the positive divisor be $k$.\n$$\\begin{align*}\\frac{x}{k}\\times\\frac{x}{k}&=\\frac{x^2}{2}\\\\\\frac{x^2}{k^2}&=\\frac{x^2}{2}\\\\k^2&=2\\\\k&=\\sqrt{2}\\end{align*}$$\nDivide each length by $\\sqrt{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "If you continued to reduce each side of the original square by a factor of $\\dfrac35$, show that the area after 2 reductions is $\\dfrac{81}{625}x^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\dfrac35\\times\\dfrac35x\\right)^2=\\left(\\dfrac{9x}{25}\\right)^2=\\dfrac{81}{625}x^2$.",
          "worked": "$$\\begin{align*}\\text{Side after 2 reductions}&=\\frac35\\times\\frac35x\\\\\\text{Side after 2 reductions}&=\\frac{9x}{25}\\\\A&=\\frac{9x}{25}\\times\\frac{9x}{25}\\\\A&=\\frac{81}{625}x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "If you continued to reduce each side of the original square by a factor of $\\dfrac35$, write an expression for the area after $n$ reductions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\dfrac35\\right)^{2n}x^2$",
          "worked": "$$\\begin{align*}\\text{Side after }n\\text{ reductions}&=\\left(\\frac35\\right)^n x\\\\A&=\\left(\\frac35\\right)^n x\\times\\left(\\frac35\\right)^n x\\\\A&=\\left(\\frac35\\right)^{2n}x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ],
    "diagramPlacement": "before-prompt"
  },
