  "content": {
    "id": "p7-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "How many four-digit numbers can be made using the digits $\\{1,3,5,7,9\\}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q12a",
        "type": "part",
        "label": "a",
        "prompt": "without restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$625$",
          "worked": "Each of the four positions has 5 choices, since repetition is allowed.\n$$\\begin{align*}N&=5\\times5\\times5\\times5\\\\N&=625\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q12b",
        "type": "part",
        "label": "b",
        "prompt": "without repetition",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "There are 5, then 4, then 3, then 2 choices for the successive digits.\n$$\\begin{align*}N&=5\\times4\\times3\\times2\\\\N&=120\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
