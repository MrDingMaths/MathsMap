  "content": {
    "id": "p57-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the coordinates of points on the curve $y=x^3+1$ that have tangents with gradient of $3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(1,2)$ and $(-1,0)$.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2\\\\3x^2&=3\\\\x^2&=1\\\\x&=\\pm1\\end{align*}$$\nFor $x=1$, $y=1^3+1=2$.\n\nFor $x=-1$, $y=(-1)^3+1=0$.\n\nThe points are $(1,2)$ and $(-1,0)$.",
      "solutionDiagrams": []
    },
