  "content": {
    "id": "v2-9cb9c2-p5-practice-slot-2-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Solve for $x$.\n$ax-a^{2}=2x-4$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=a+2$ for $a\\ne2$. For $a=2$, every real $x$ is a solution.",
      "worked": "$$\\begin{align*}ax-2x&=a^{2}-4\\\\x(a-2)&=(a-2)(a+2)\\end{align*}$$\nFor $a\\ne2$, divide both sides by $a-2$:\n$$x=a+2$$\nFor $a=2$, the original equation becomes $2x-4=2x-4$, which is true for every real $x$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
