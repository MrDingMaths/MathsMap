                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "0.83\\text{ m/s}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p14-q13-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Divide the total swimming distance by the total swimming time, excluding the rest.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Exclude the 10-minute rest from the total time.\n\n$$\\begin{align*}\\text{Total distance}&=500+750=1250\\text{ m}\\\\\\text{Swimming time}&=480+1020=1500\\text{ s}\\\\\\text{Average speed}&=\\frac{1250}{1500}\\text{ m/s}\\\\\\text{Average speed}&=\\frac56\\text{ m/s}\\\\\\text{Average speed}&\\approx0.83\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
