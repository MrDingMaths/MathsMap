  "content": {
    "id": "p14-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Michael swims 10 laps of a 50 m pool in 8 minutes. He rests for 10 minutes and then swims a further 15 laps at 68 seconds per lap. What is his average speed in m/s, correct to two decimal places, for:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "the first 10 laps?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.04\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\text{Distance}&=10\\times50=500\\text{ m}\\\\\\text{Time}&=8\\times60=480\\text{ s}\\\\\\text{Average speed}&=\\frac{500}{480}\\text{ m/s}\\\\\\text{Average speed}&\\approx1.04\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "the last 15 laps?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.74\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\text{Distance}&=15\\times50=750\\text{ m}\\\\\\text{Time}&=15\\times68=1020\\text{ s}\\\\\\text{Average speed}&=\\frac{750}{1020}\\text{ m/s}\\\\\\text{Average speed}&\\approx0.74\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "the whole swim, excluding rest time?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q13-c-short-result",
                "type": "paragraph",
