  "content": {
    "id": "v2-50e3a8-p9-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "For each equation, in what direction and how many units was $f(x)$ translated to yield $g(x)$?",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-50e3a8-p9-practice-slot-1-lower-slot-1-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\sqrt{x+3},\\quad g(x)=\\sqrt{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 units right.",
          "worked": "Let $f(x-b)=g(x)$.\n$$\\begin{aligned}\\sqrt{(x-b)+3}&=\\sqrt{x-2}\\\\-b+3&=-2\\\\b&=5\\end{aligned}$$\nTherefore, 5 units right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-50e3a8-p9-practice-slot-1-lower-slot-1-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{1}{x-4},\\quad g(x)=\\dfrac{1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 units left.",
          "worked": "Let $f(x-b)=g(x)$.\n$$\\begin{aligned}\\frac{1}{(x-b)-4}&=\\frac{1}{x+1}\\\\-b-4&=1\\\\b&=-5\\end{aligned}$$\nTherefore, 5 units left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-50e3a8-p9-practice-slot-1-lower-slot-1-lower-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=2^{3x},\\quad g(x)=2^{3x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 units right.",
          "worked": "Let $f(x-b)=g(x)$.\n$$\\begin{aligned}2^{3(x-b)}&=2^{3x-6}\\\\3x-3b&=3x-6\\\\3b&=6\\\\b&=2\\end{aligned}$$\nTherefore, 2 units right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
