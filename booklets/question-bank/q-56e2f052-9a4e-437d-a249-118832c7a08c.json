  "content": {
    "id": "p37-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If a fair coin is tossed eight times, find the probability of obtaining more heads than tails.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{93}{256}$",
      "worked": "Let $X$ be the number of heads, so $X\\sim\\operatorname{Bin}(8,\\tfrac12)$. More heads than tails means $X>4$. By symmetry, $P(X>4)=P(X<4)$.\n\n$$\\begin{align*}P(X=4)&=\\binom{8}{4}\\left(\\frac12\\right)^4\\left(\\frac12\\right)^4\\\\P(X=4)&=\\frac{70}{256}=\\frac{35}{128}\\\\P(X>4)&=\\frac{1-P(X=4)}{2}\\\\P(X>4)&=\\frac{1-\\frac{35}{128}}{2}\\\\P(X>4)&=\\frac{93}{256}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
