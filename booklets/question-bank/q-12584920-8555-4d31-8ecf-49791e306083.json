  "content": {
    "id": "p28-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "The expression $x^2+bx+16$ completes to give a perfect square $(x+a)^2$ with no $c$ term.\nFind all possible integer values of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=\\pm8$.",
      "worked": "$$\\begin{align*}x^2+bx+16&=x^2+bx+\\left(\\frac b2\\right)^2-\\left(\\frac b2\\right)^2+16\\\\&=\\left(x+\\frac b2\\right)^2+16-\\frac{b^2}{4}\\end{align*}$$\nFor no $c$ term:\n$$\\begin{align*}16-\\frac{b^2}{4}&=0\\\\b^2&=64\\\\b&=\\pm8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
