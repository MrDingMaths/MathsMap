  "content": {
    "id": "p9-q12-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the straight line equation $x+2y-4=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "The line is translated 2 units left. Find the equation of the new line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-2=0$.",
          "worked": "Replace $x$ by $x+2$.\n$$\\begin{align*}(x+2)+2y-4&=0\\\\x+2y-2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "The original line is translated 1 unit down. Find the equation of this third line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-2=0$.",
          "worked": "Replace $y$ by $y+1$ in the original equation.\n$$\\begin{align*}x+2(y+1)-4&=0\\\\x+2y-2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Comment on your answers. Drawing the situation may help.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both translations produce the same line.",
          "worked": "The original line has gradient $-\\frac12$ and $y$-intercept $(0,2)$. The translations send this point to $(-2,2)$ and $(0,1)$. The gradient between these points is\n$$\\frac{1-2}{0-(-2)}=-\\frac12.$$\nThey therefore lie on the same translated line, $y=-\\frac12x+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
