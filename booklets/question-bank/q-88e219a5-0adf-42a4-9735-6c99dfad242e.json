  "content": {
    "id": "p5-practice-2-root",
    "type": "question",
    "label": "",
    "prompt": "Consider the geometric sequence: $\\frac{2}{3},\\ \\frac{4}{15},\\ \\frac{8}{75}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-practice-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $n$th term formula for the sequence.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=\\frac{2}{3}\\left(\\frac{2}{5}\\right)^{n-1}$",
          "worked": "$a=\\frac{2}{3}$.\n$$\\begin{align*}r&=\\frac{4}{15}\\div\\frac{2}{3}\\\\r&=\\frac{2}{5}\\\\a_n&=ar^{n-1}\\\\a_n&=\\frac{2}{3}\\left(\\frac{2}{5}\\right)^{n-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-practice-2-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the $8$th term? Answer in index form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_8=\\frac{2^8}{3\\times5^7}$",
          "worked": "Substitute $n=8$ into the formula.\n$$\\begin{align*}a_8&=\\frac{2}{3}\\left(\\frac{2}{5}\\right)^7\\\\a_8&=\\frac{2\\times2^7}{3\\times5^7}\\\\a_8&=\\frac{2^8}{3\\times5^7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
