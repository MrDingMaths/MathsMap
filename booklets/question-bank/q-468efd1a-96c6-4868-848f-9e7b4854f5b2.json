  "content": {
    "id": "p17-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q2-a",
        "type": "group",
        "label": "a",
        "prompt": "A car left town A and travelled at a constant speed towards town B, 150 km away. Half an hour later, an express train left A travelling at a constant speed towards B, and overtook the car 90 km from A. The speed of the car was 80 km/h. Find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q2-a-i",
            "type": "part",
            "label": "i",
            "prompt": "the time for which the car had been travelling before it was overtaken by the train",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1\\tfrac18$ hours",
              "worked": "$$\\begin{align*}\\text{Car's travelling time}&=\\frac{90}{80}\\\\\\text{Car's travelling time}&=\\frac98\\text{ hours}\\\\\\text{Car's travelling time}&=1\\tfrac18\\text{ hours}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p17-q2-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the time for which the train had been travelling before it overtook the car",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\tfrac58$ hours",
              "worked": "The train left half an hour after the car.\n\n$$\\begin{align*}\\text{Train's travelling time}&=\\frac98-\\frac12\\\\\\text{Train's travelling time}&=\\frac58\\text{ hours}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p17-q2-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the speed of the train",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$144\\text{ km/h}$",
              "worked": "$$\\begin{align*}\\text{Train's speed}&=90\\div\\frac58\\\\\\text{Train's speed}&=90\\times\\frac85\\\\\\text{Train's speed}&=144\\text{ km/h}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p17-q2-b",
        "type": "group",
        "label": "b",
        "prompt": "A car left town A and travelled at a constant speed to town B, which is $d$ km away. At a time $n$ hours later, an express train left A travelling at a constant speed to B and overtook the car $m$ km from B. The speed of the car was $v$ km/h.\n\nFind formulas for:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q2-b-i",
            "type": "part",
            "label": "i",
            "prompt": "the distance from town A to the point where the train passes the car",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(d-m)\\text{ km}$",
              "worked": "The overtaking point is $m$ km before B, so its distance from A is $(d-m)$ km.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p17-q2-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the time, $T$ hours, for which the car was travelling before it was overtaken by the train in terms of $d$, $m$ and $v$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$T=\\dfrac{d-m}{v}$",
              "worked": "Use time = distance ÷ speed.\n\n$$T=\\frac{d-m}{v}\\text{ hours}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p17-q2-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the time, $t$ hours, for which the train was travelling before it overtook the car in terms of $d$, $m$, $v$ and $n$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t=\\dfrac{d-m}{v}-n$",
              "worked": "The train travels for $n$ hours less than the car.\n\n$$\\begin{align*}t&=T-n\\\\t&=\\frac{d-m}{v}-n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p17-q2-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "the speed of the train, $w$ km/h, in terms of $d$, $m$, $v$ and $n$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$w=\\dfrac{v(d-m)}{d-m-nv}$\n\nDivide the distance travelled by the train's travelling time.",
              "worked": "$$\\begin{align*}w&=\\frac{d-m}{t}\\\\w&=\\frac{d-m}{\\frac{d-m}{v}-n}\\\\w&=\\frac{d-m}{\\frac{d-m-nv}{v}}\\\\w&=\\frac{v(d-m)}{d-m-nv}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p17-q2-b-v",
            "type": "part",
            "label": "v",
            "prompt": "the speed of the car, $v$ km/h, in terms of $d$, $m$, $n$ and $w$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$v=\\dfrac{w(d-m)}{wn+d-m}$\n\nCollect the terms containing $v$, factorise, then divide.",
              "worked": "$$\\begin{align*}w(d-m-nv)&=v(d-m)\\\\w(d-m)-wnv&=v(d-m)\\\\w(d-m)&=v(d-m)+wnv\\\\w(d-m)&=v(d-m+wn)\\\\v&=\\frac{w(d-m)}{wn+d-m}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          }
        ]
      },
      {
        "id": "p17-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $d=150$, $m=90$, $n=0.5$ and $w=108$, find the speed of the car.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56\\tfrac{16}{19}\\text{ km/h}$",
          "worked": "$$\\begin{align*}v&=\\frac{w(d-m)}{wn+d-m}\\\\v&=\\frac{108(150-90)}{108(0.5)+150-90}\\\\v&=\\frac{6480}{114}\\\\v&=\\frac{1080}{19}\\\\v&=56\\frac{16}{19}\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
