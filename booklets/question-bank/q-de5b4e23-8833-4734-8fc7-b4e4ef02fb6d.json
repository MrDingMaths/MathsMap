  "content": {
    "id": "p16-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Without finding a common denominator, determine which of these two fractions is greater:\n\n$$\\frac{97}{98}\\text{ or }\\frac{98}{99}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p16-q7-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
