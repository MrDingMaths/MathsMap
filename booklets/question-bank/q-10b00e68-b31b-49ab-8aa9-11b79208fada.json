  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Sketch $y=x^2-2x-48$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "factorise:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+6)(x-8)$",
          "worked": "$$\\begin{align*}y&=x^2-2x-48\\\\y&=(x+6)(x-8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave up.",
          "worked": "$a=1>0$, so the parabola is concave up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p8-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-48)$",
          "worked": "Let $x=0$.\n$$\\begin{align*}y&=0^2-2(0)-48\\\\y&=-48\\end{align*}$$\nThe $y$-intercept is $(0,-48)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-6,0)$ and $(8,0)$.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=(x+6)(x-8)\\end{align*}$$\nBy the null factor law, $x+6=0$ or $x-8=0$, giving $x=-6$ or $x=8$.\nThe $x$-intercepts are $(-6,0)$ and $(8,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-49)$",
          "worked": "Use the mean of the $x$-intercepts.\n$$\\begin{align*}x&=\\frac{-6+8}{2}\\\\x&=1\\end{align*}$$\nSubstitute $x=1$.\n$$\\begin{align*}y&=1^2-2(1)-48\\\\y&=-49\\end{align*}$$\nThe vertex is $(1,-49)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ],
    "sharedSolutionDiagrams": [
