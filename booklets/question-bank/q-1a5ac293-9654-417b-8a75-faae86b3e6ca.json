    "type": "question",
    "label": "5",
    "prompt": "A jacket originally costs $\\$85$. It is reduced by $40\\%$ in a sale. What is the sale price?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$51$",
      "worked": "$100\\%-40\\%=60\\%$ remains.\n$$\\begin{align*}\\text{Sale price}&=60\\%\\times\\$85\\\\\\text{Sale price}&=0.6\\times\\$85\\\\\\text{Sale price}&=\\$51\\end{align*}$$",
      "solutionDiagrams": []
