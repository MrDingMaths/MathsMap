  "content": {
    "id": "p27-q14",
    "type": "question",
    "label": "14",
    "prompt": "Two car hire firms offer the following deals.\n\nMovit: $\\$25$ plus 6 cents per km\n\nRentlow: $\\$20$ plus 8 cents per km",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q14-a",
        "type": "group",
        "label": "a",
        "prompt": "If a client is to drive $x$ km, express the cost of hiring a car from:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p27-q14-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Movit, in terms of $x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(25+0.06x)$",
              "worked": "6 cents is $\\$0.06$.\n\nCost in dollars $=25+0.06x$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p27-q14-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Rentlow, in terms of $x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(20+0.08x)$",
              "worked": "8 cents is $\\$0.08$.\n\nCost in dollars $=20+0.08x$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      },
      {
        "id": "p27-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "For what distances does Movit offer the better deal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Distances greater than $250\\text{ km}$.",
          "worked": "Movit offers the better deal when its cost is lower.\n\n$$\\begin{align*}25+0.06x&<20+0.08x\\\\5+0.06x&<0.08x\\\\5&<0.02x\\\\250&<x\\end{align*}$$\n\nMovit is cheaper for distances greater than $250\\text{ km}$. At $250\\text{ km}$ the costs are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
