        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "find the value of $x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8\\,\\mathrm{m}$",
          "worked": "The side $x$ corresponds to $20\\,\\mathrm{m}$, and $6\\,\\mathrm{m}$ corresponds to $15\\,\\mathrm{m}$.\n$$\\begin{align*}\\frac{x}{20}&=\\frac{6}{15}\\\\x&=20\\times\\frac{6}{15}\\\\x&=8\\,\\mathrm{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
