  "content": {
    "id": "p26-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Light travels 1 millimetre in 3.3 picoseconds.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "How long does it take for light to travel 1 metre?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.3\\text{ ns}$",
          "worked": "One metre is 1000 mm.\n$$\\begin{aligned}t&=1000\\times3.3=3300\\text{ ps}\\\\t&=3.3\\text{ ns}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p26-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How long does it take for light to travel 1 kilometre?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.3\\text{ microseconds}$",
          "worked": "One kilometre is one million millimetres.\n$$\\begin{aligned}t&=10^6\\times3.3\\text{ ps}\\\\t&=3.3\\text{ microseconds}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p26-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "How far does light travel in 1 nanosecond? Give your answer correct to 3 significant figures.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$303\\text{ mm}$",
          "worked": "One nanosecond is 1000 picoseconds.\n$$\\begin{aligned}d&=\\frac{1000}{3.3}\\text{ mm}\\\\d&\\approx303\\text{ mm}\\quad(3\\text{ s.f.}).\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
