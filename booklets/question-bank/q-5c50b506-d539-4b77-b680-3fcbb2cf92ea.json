  "content": {
    "id": "p20-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A photo is projected onto a screen.\nIf the height of the photo is 10 cm and the height of its image on the screen is 1.2 m, what is the scale factor?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12$",
      "worked": "$1.2\\text{ m}=120\\text{ cm}$.\n$$\\begin{align*}\\text{Scale factor}&=\\frac{\\text{Image height}}{\\text{Original height}}\\\\&=\\frac{120}{10}\\\\&=12\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
