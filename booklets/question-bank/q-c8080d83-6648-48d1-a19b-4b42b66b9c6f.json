  "content": {
    "id": "p30-r1-root",
    "type": "question",
    "label": "1",
    "prompt": "State whether or not each expression is a polynomial.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-r1-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x^2+3x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Polynomial.",
          "worked": "Polynomial: the powers of $x$ are $2$, $1$ and $0$, all whole numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p30-r1-b",
        "type": "part",
        "label": "b",
        "prompt": "$3-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Polynomial.",
          "worked": "Polynomial: the powers of $x$ are $0$ and $1$, both whole numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p30-r1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x-3}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Polynomial.",
          "worked": "$\\begin{align*}\\frac{x-3}{8}&=\\frac18x-\\frac38\\end{align*}$\n\nPolynomial: its coefficients are real numbers and its powers of $x$ are $1$ and $0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p30-r1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x^2}{x^2-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not a polynomial.",
          "worked": "$\\begin{align*}\\frac{x^2}{x^2-2}&=1+\\frac{2}{x^2-2}\\end{align*}$\n\nNot a polynomial: the variable remains in the denominator and the expression cannot be written as a finite sum of multiples of whole-number powers of $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p30-r1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x+2}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not a polynomial.",
          "worked": "$\\begin{align*}\\frac{x+2}{\\sqrt{x}}&=x^{1/2}+2x^{-1/2}\\end{align*}$\n\nNot a polynomial: the indices $\\frac12$ and $-\\frac12$ are not whole numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p30-r1-f",
        "type": "part",
        "label": "f",
        "prompt": "$2(x-1)^3-2x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Polynomial.",
          "worked": "$\\begin{align*}2(x-1)^3-2x+1&=2(x^3-3x^2+3x-1)-2x+1\\\\2(x-1)^3-2x+1&=2x^3-6x^2+4x-1\\end{align*}$\n\nPolynomial: every power of $x$ is a whole number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      }
    ]
  },
