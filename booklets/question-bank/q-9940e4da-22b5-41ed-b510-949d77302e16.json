  "content": {
    "id": "nr-p29-q5",
    "type": "question",
    "label": "5",
    "prompt": "A triangle has side lengths $10\\text{ m}$, $7\\text{ m}$, and $13\\text{ m}$. Find the largest angle, to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$98.2^\\circ$",
      "worked": "The largest angle is opposite the longest side, $13\\text{ m}$.\n$$\\begin{align*}\\cos\\theta&=\\frac{10^2+7^2-13^2}{2(10)(7)}\\\\[8pt]\\theta&=\\cos^{-1}\\left(-\\frac17\\right)\\\\[8pt]\\theta&\\approx98.2^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 23
