  "content": {
    "id": "p37-q2",
    "type": "question",
    "label": "2",
    "prompt": "Simplify these surds.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{\\dfrac{8}{9}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{2}}{3}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{8}{9}}&=\\frac{\\sqrt{8}}{\\sqrt{9}}\\\\&=\\frac{\\sqrt{4}\\sqrt{2}}{3}\\\\&=\\frac{2\\sqrt{2}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{\\dfrac{12}{49}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{3}}{7}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{12}{49}}&=\\frac{\\sqrt{12}}{\\sqrt{49}}\\\\&=\\frac{\\sqrt{4}\\sqrt{3}}{7}\\\\&=\\frac{2\\sqrt{3}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{\\dfrac{18}{25}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3\\sqrt{2}}{5}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{18}{25}}&=\\frac{\\sqrt{18}}{\\sqrt{25}}\\\\&=\\frac{\\sqrt{9}\\sqrt{2}}{5}\\\\&=\\frac{3\\sqrt{2}}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{\\dfrac{10}{9}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{10}}{3}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{10}{9}}&=\\frac{\\sqrt{10}}{\\sqrt{9}}\\\\&=\\frac{\\sqrt{10}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt{\\dfrac{21}{144}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{21}}{12}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{21}{144}}&=\\frac{\\sqrt{21}}{\\sqrt{144}}\\\\&=\\frac{\\sqrt{21}}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{\\dfrac{26}{32}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{13}}{4}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{26}{32}}&=\\sqrt{\\frac{13}{16}}\\\\&=\\frac{\\sqrt{13}}{\\sqrt{16}}\\\\&=\\frac{\\sqrt{13}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt{\\dfrac{28}{50}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{7}}{5\\sqrt{2}}$ or $\\dfrac{\\sqrt{14}}{5}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{28}{50}}&=\\frac{\\sqrt{28}}{\\sqrt{50}}\\\\&=\\frac{\\sqrt{4}\\sqrt{7}}{\\sqrt{25}\\sqrt{2}}\\\\&=\\frac{2\\sqrt{7}}{5\\sqrt{2}}\\end{align*}$$\nAn equivalent form is $\\dfrac{\\sqrt{14}}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sqrt{\\dfrac{15}{27}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{5}}{3}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{15}{27}}&=\\sqrt{\\frac{5}{9}}\\\\&=\\frac{\\sqrt{5}}{\\sqrt{9}}\\\\&=\\frac{\\sqrt{5}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\sqrt{\\dfrac{45}{72}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{5}}{2\\sqrt{2}}$ or $\\dfrac{\\sqrt{10}}{4}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{45}{72}}&=\\sqrt{\\frac{5}{8}}\\\\&=\\frac{\\sqrt{5}}{\\sqrt{4}\\sqrt{2}}\\\\&=\\frac{\\sqrt{5}}{2\\sqrt{2}}\\end{align*}$$\nAn equivalent form is $\\dfrac{\\sqrt{10}}{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
