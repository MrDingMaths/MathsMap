    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "If $f(x)=x(x-1)^4$, use the product rule to find $f'(x)$ and $f''(x)$ in fully factored form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
