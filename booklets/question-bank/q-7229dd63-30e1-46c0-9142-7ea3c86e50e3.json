        ]
      },
      "worked": "$$\\begin{align*}f'(x)&=(x-1)^4+4x(x-1)^3\\\\f'(x)&=(x-1)^3[(x-1)+4x]\\\\f'(x)&=(x-1)^3(5x-1)\\\\f''(x)&=3(x-1)^2(5x-1)+5(x-1)^3\\\\f''(x)&=(x-1)^2[3(5x-1)+5(x-1)]\\\\f''(x)&=4(x-1)^2(5x-2)\\end{align*}$$",
      "solutionDiagrams": []
