  "content": {
    "id": "p24-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Deb travels to work from home at 40 km/h and then immediately returns home at a speed of 60 km/h. What is her average speed? And no, the answer is not 50 km/h.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$48\\text{ km/h}$.\n\nDivide the total distance by the total travelling time.",
      "worked": "Let $d$ km be the distance from home to work. The outward and return times are $\\frac{d}{40}$ hours and $\\frac{d}{60}$ hours.\n\n$$\\begin{align*}\\text{Total time}&=\\frac{d}{40}+\\frac{d}{60}\\\\\\text{Total time}&=\\frac{5d}{120}=\\frac{d}{24}\\\\\\text{Average speed}&=\\frac{2d}{d/24}\\\\\\text{Average speed}&=48\\text{ km/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
