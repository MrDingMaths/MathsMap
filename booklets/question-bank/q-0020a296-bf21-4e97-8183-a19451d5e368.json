  "content": {
    "id": "p21-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the discriminant $\\Delta$ of each equation. Hence state how many zeroes there are, and whether or not they are rational.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-6x+9=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=0$; one double rational zero.",
          "worked": "$$\\begin{align*}\\Delta&=b^2-4ac\\\\\\Delta&=(-6)^2-4(1)(9)\\\\\\Delta&=0\\end{align*}$$\nSince $\\Delta=0$, there is one double zero. It is rational because $0$ is a square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p21-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$-x^2-4x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=24$; two irrational zeroes.",
          "worked": "$$\\begin{align*}\\Delta&=b^2-4ac\\\\\\Delta&=(-4)^2-4(-1)(2)\\\\\\Delta&=24\\end{align*}$$\nSince $\\Delta>0$, there are two distinct zeroes. They are irrational because $24$ is not a square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$9x^2-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=36$; two rational zeroes.",
          "worked": "$$\\begin{align*}\\Delta&=b^2-4ac\\\\\\Delta&=0^2-4(9)(-1)\\\\\\Delta&=36\\end{align*}$$\nSince $\\Delta>0$, there are two distinct zeroes. They are rational because $36=6^2$ is a square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
