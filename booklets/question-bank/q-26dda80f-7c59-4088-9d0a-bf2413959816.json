    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Odd positive integers less than 10.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,3,5,7,9\\}$",
          "worked": "The odd positive integers below 10 are $1,3,5,7,9$.\n\n$\\{1,3,5,7,9\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "The first six positive multiples of 6.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{6,12,18,24,30,36\\}$",
          "worked": "$6\\times1=6$, $6\\times2=12$, $6\\times3=18$, $6\\times4=24$, $6\\times5=30$, $6\\times6=36$.\n\n$\\{6,12,18,24,30,36\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "The numbers on a die.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,3,4,5,6\\}$",
          "worked": "A standard die has faces numbered $1$ to $6$.\n\n$\\{1,2,3,4,5,6\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "The factors of 20.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,4,5,10,20\\}$",
          "worked": "The factor pairs are $1\\times20=20$, $2\\times10=20$ and $4\\times5=20$.\n\n$\\{1,2,4,5,10,20\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
