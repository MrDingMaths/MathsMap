    "children": [
      {
        "id": "p6-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "How many wooden planks are required for a path containing twenty hexagonal stones?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "82 wooden planks.",
          "worked": "The two end stones each require 5 planks. Each of the other 18 stones requires 4.\n$$\\begin{align*}P&=2\\times5+18\\times4\\\\P&=10+72\\\\P&=82.\\end{align*}$$\n82 wooden planks are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p6-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "How many wooden planks are required for a path containing $m$ hexagonal stones?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4m+2$ wooden planks.",
          "worked": "The two end stones each require 5 planks. Each of the other $m-2$ stones requires 4.\n$$\\begin{align*}P&=2\\times5+4(m-2)\\\\P&=10+4m-8\\\\P&=4m+2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p6-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "How many stones would there be if the path included 362 wooden planks?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "90 stones.",
          "worked": "$$\\begin{align*}4m+2&=362\\\\4m&=360\\\\m&=90.\\end{align*}$$\nThere would be 90 stones.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "Another path is made in the same manner from $m$ stones, each in the shape of a regular $n$-gon, where $m>1$ and $n\\geq3$. Given the path includes thirty-two wooden planks, find the possible values of the pair $m$ and $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m,n)=(2,17),(3,12),(5,8),(6,7),(10,5),(15,4),(30,3)$.\n\nThe end stones require $n-1$ planks each and the others require $n-2$, giving $m(n-2)=30$.",
          "worked": "Each end stone requires $n-1$ planks, and each of the other $m-2$ stones requires $n-2$.\n$$\\begin{align*}P&=2(n-1)+(m-2)(n-2)\\\\P&=m(n-2)+2.\\end{align*}$$\nWith 32 planks,\n$$\\begin{align*}m(n-2)+2&=32\\\\m(n-2)&=30.\\end{align*}$$\nSince $m>1$ and $n-2\\geq1$ are integers, the possible factor pairs $(m,n-2)$ are $(2,15),(3,10),(5,6),(6,5),(10,3),(15,2),(30,1)$. Therefore,\n$$ (m,n)=(2,17),(3,12),(5,8),(6,7),(10,5),(15,4),(30,3). $$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 61
      }
    ]
  },
