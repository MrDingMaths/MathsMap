  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Calculate the exact value of each number.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$16^{-\\frac{3}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}16^{-\\frac{3}{4}}&=\\left(\\frac{1}{16}\\right)^{\\frac{3}{4}}\\\\16^{-\\frac{3}{4}}&=\\left(\\frac{1}{2}\\right)^3\\\\16^{-\\frac{3}{4}}&=\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$100^{-\\frac{3}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{1000}$",
          "worked": "$$\\begin{align*}100^{-\\frac{3}{2}}&=\\left(\\frac{1}{100}\\right)^{\\frac{3}{2}}\\\\100^{-\\frac{3}{2}}&=\\left(\\frac{1}{10}\\right)^3\\\\100^{-\\frac{3}{2}}&=\\frac{1}{1000}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{1}{8}\\right)^{-\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{8}\\right)^{-\\frac{2}{3}}&=8^{\\frac{2}{3}}\\\\\\left(\\frac{1}{8}\\right)^{-\\frac{2}{3}}&=2^2\\\\\\left(\\frac{1}{8}\\right)^{-\\frac{2}{3}}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$125^{-\\frac{4}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{625}$",
          "worked": "$$\\begin{align*}125^{-\\frac{4}{3}}&=\\left(\\frac{1}{125}\\right)^{\\frac{4}{3}}\\\\125^{-\\frac{4}{3}}&=\\left(\\frac{1}{5}\\right)^4\\\\125^{-\\frac{4}{3}}&=\\frac{1}{625}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$1000^{-\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{100}$",
          "worked": "$$\\begin{align*}1000^{-\\frac{2}{3}}&=\\left(\\frac{1}{1000}\\right)^{\\frac{2}{3}}\\\\1000^{-\\frac{2}{3}}&=\\left(\\frac{1}{10}\\right)^2\\\\1000^{-\\frac{2}{3}}&=\\frac{1}{100}\\end{align*}$$",
          "solutionDiagrams": []
