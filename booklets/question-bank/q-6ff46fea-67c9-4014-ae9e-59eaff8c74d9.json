  "content": {
    "id": "p39-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Calculate the unknown quantity in each of these scenarios. Round speeds and distances to 2 decimal places where needed. Express times in minutes and seconds.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the average speed (in km/h) of a vehicle that travels 500 km in 6 hours and 10 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81.08\\text{ km/h}$",
          "worked": "$$\\begin{align*}t&=6+\\frac{10}{60}\\text{ h}\\\\t&=\\frac{37}{6}\\text{ h}\\\\s&=\\frac{d}{t}\\\\s&=\\frac{500}{37/6}\\text{ km/h}\\\\s&\\approx81.08\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p39-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the distance travelled by a car whose average speed is 68 km/h if the journey lasts 1 hour 20 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90.67\\text{ km}$",
          "worked": "$$\\begin{align*}t&=1+\\frac{20}{60}=\\frac{4}{3}\\text{ h}\\\\d&=st\\\\d&=68\\times\\frac{4}{3}\\text{ km}\\\\d&\\approx90.67\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "How long will it take a vehicle to travel 50 km at a speed of 60 km/h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\text{ min }0\\text{ s}$",
          "worked": "$$\\begin{align*}t&=\\frac{d}{s}\\\\t&=\\frac{50}{60}\\text{ h}\\\\t&=\\frac{5}{6}\\times60\\text{ min}\\\\t&=50\\text{ min }0\\text{ s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p39-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the average speed (in km/h) of a vehicle that travels 36 000 m in 45 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\text{ km/h}$",
          "worked": "$$\\begin{align*}d&=36000\\div1000=36\\text{ km}\\\\t&=\\frac{45}{60}=\\frac{3}{4}\\text{ h}\\\\s&=\\frac{d}{t}\\\\s&=\\frac{36}{3/4}\\text{ km/h}\\\\s&=48\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p39-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "How long will it take a vehicle to travel 15 km at a speed of 40 km/h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22\\text{ min }30\\text{ s}$",
          "worked": "$$\\begin{align*}t&=\\frac{d}{s}\\\\t&=\\frac{15}{40}=0.375\\text{ h}\\\\t&=0.375\\times60=22.5\\text{ min}\\\\0.5\\text{ min}&=0.5\\times60=30\\text{ s}\\\\t&=22\\text{ min }30\\text{ s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p39-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "Find the distance travelled by a car whose average speed is 70 km/h if the journey lasts 50 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$58.33\\text{ km}$",
          "worked": "$$\\begin{align*}t&=\\frac{50}{60}=\\frac{5}{6}\\text{ h}\\\\d&=st\\\\d&=70\\times\\frac{5}{6}\\text{ km}\\\\d&\\approx58.33\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
