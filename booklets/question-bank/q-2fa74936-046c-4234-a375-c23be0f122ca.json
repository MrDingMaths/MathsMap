  "content": {
    "id": "p29-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "A piece of wire is 100 cm long. Find the dimensions of the rectangle formed by bending this wire when the area is a maximum.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$25\\text{ cm}$ by $25\\text{ cm}$.",
      "worked": "Let the rectangle have sides $x$ cm and $(50-x)$ cm, where $0<x<50$.\n$$\\begin{align*}2x+2w&=100\\\\w&=50-x\\\\A&=x(50-x)\\\\A&=50x-x^2.\\end{align*}$$\nThe downward-opening parabola has zeros at $x=0$ and $x=50$, so its axis of symmetry is $x=25$. Its maximum area occurs there. The other side is $50-25=25$ cm, so the dimensions are $25\\text{ cm}$ by $25\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 65
  },
