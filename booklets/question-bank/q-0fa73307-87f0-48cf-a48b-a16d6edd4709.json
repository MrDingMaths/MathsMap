  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Identify the dilation factor for the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2f(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "In $y=kf(x)$, the vertical dilation factor is $k$. Here, $k=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{f(x)}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$y=\\frac{1}{2}f(x)$$\nThe vertical dilation factor is $\\dfrac{1}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$2y=3f(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2}$",
          "worked": "Divide both sides by $2$.\n$$y=\\frac{3}{2}f(x)$$\nThe vertical dilation factor is $\\dfrac{3}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\pi y=\\dfrac{f(x)}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{4\\pi}$",
          "worked": "Divide both sides by $\\pi$.\n$$y=\\frac{1}{4\\pi}f(x)$$\nThe vertical dilation factor is $\\dfrac{1}{4\\pi}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
