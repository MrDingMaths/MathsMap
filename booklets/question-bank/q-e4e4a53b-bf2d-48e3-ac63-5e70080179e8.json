        "id": "p31-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Using the line of best fit, find the number of new customers expected if there are 30 market stalls. Give your answer to the nearest whole number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "76 new customers per hour.",
          "worked": "$\\begin{align*}m &= 30\\\\c &= 13.33 + 2.097(30)\\\\c &= 76.24\\end{align*}$\nExpected number: 76 new customers per hour, to the nearest whole number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the equation to find the number of market stalls required to expect 150 new customers. Give your answer to the nearest whole number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "65 stalls.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "c0bfbef0-f5c3-4b27-975c-6acd131026c4-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}c &= 150\\\\150 &= 13.33 + 2.097m\\\\150 - 13.33 &= 2.097m\\\\m &= \\frac{136.67}{2.097}\\\\m &\\approx 65.17\\end{align*}",
                    "display": false
                  }
                ]
              },
