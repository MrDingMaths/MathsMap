      {
        "id": "p31-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why part a is interpolation, while part b is extrapolation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "30 stalls is within the observed range of 5–50 stalls; the estimate of about 65 stalls is outside it.",
          "worked": "Part a uses 30 stalls, within the observed range of 5–50 stalls, so it is interpolation. Part b predicts about 65 stalls, beyond the observed maximum of 50 stalls, so it is extrapolation. The target of 150 new customers also exceeds the observed maximum of 120.",
