              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "2x+3y+1=0,",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "translated right by 2 units.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+3y-3=0$",
          "worked": "Replace $x$ with $x-2$.\n$$\\begin{align*}2(x-2)+3y+1&=0\\\\2x-4+3y+1&=0\\\\2x+3y-3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q6b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p38-q6b-given",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "x^2+y^2=4,",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "translated left by 4 units.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2+y^2=4$",
          "worked": "Replace $x$ with $x+4$.\n$$(x+4)^2+y^2=4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p38-q6c",
        "type": "part",
        "label": "c",
        "prompt": "$xy=1$, translated right by 3 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{x-3}$",
          "worked": "Replace $x$ with $x-3$.\n$$\\begin{align*}(x-3)y&=1\\\\y&=\\frac{1}{x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p38-q6d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+xy=1$, translated left by 1 unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{x+1}-(x+1)$",
          "worked": "Replace every $x$ with $x+1$.\n$$\\begin{align*}(x+1)^2+(x+1)y&=1\\\\(x+1)y&=1-(x+1)^2\\\\y&=\\frac{1-(x+1)^2}{x+1}\\\\y&=\\frac{1}{x+1}-(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
