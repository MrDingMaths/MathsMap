  "content": {
    "id": "p38-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Write down the new equation obtained when the following translation is applied to the graph.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q6a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
