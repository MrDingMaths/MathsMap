    "type": "question",
    "label": "18",
    "prompt": "A hotel charges a fee of $2\\%$ for a guest using a credit card. If the hotel bill is $\\$1250$ before the fee is applied, how much is the fee?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$25$",
      "worked": "$$\\begin{align*}\\text{Fee}&=\\frac{2}{100}\\times\\$1250\\\\\\text{Fee}&=\\frac{1}{50}\\times\\$1250\\\\\\text{Fee}&=\\$25\\end{align*}$$",
