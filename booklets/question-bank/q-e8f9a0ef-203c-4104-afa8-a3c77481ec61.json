  "content": {
    "id": "p9-ep-27-30-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-ep-27-30-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan20^\\circ+\\cot70^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\tan20^\\circ$ or $2\\cot70^\\circ$",
          "worked": "$$\\begin{align*}\\tan20^\\circ+\\cot70^\\circ&=\\tan20^\\circ+\\tan(90^\\circ-70^\\circ)\\\\\\tan20^\\circ+\\cot70^\\circ&=\\tan20^\\circ+\\tan20^\\circ\\\\\\tan20^\\circ+\\cot70^\\circ&=2\\tan20^\\circ\\end{align*}$$\nEquivalently, $2\\cot70^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-ep-27-30-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan20^\\circ\\tan70^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\tan20^\\circ\\tan70^\\circ&=\\tan20^\\circ\\cot20^\\circ\\\\\\tan20^\\circ\\tan70^\\circ&=\\frac{\\sin20^\\circ}{\\cos20^\\circ}\\frac{\\cos20^\\circ}{\\sin20^\\circ}\\\\\\tan20^\\circ\\tan70^\\circ&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-ep-27-30-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\sin2^\\circ}{\\cos88^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{\\sin2^\\circ}{\\cos88^\\circ}&=\\frac{\\sin2^\\circ}{\\sin2^\\circ}\\\\\\frac{\\sin2^\\circ}{\\cos88^\\circ}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-ep-27-30-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}&=\\frac{\\sin20^\\circ+\\sin20^\\circ}{\\sin20^\\circ}\\\\\\frac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}&=\\frac{2\\sin20^\\circ}{\\sin20^\\circ}\\\\\\frac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
