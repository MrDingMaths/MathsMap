    "children": [
      {
        "id": "p57-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Rationalise the denominator of\n$$\\frac{1}{\\sqrt{n}+\\sqrt{n+1}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{n+1}-\\sqrt n$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt n+\\sqrt{n+1}}&=\\frac{1}{\\sqrt n+\\sqrt{n+1}}\\times\\frac{\\sqrt{n+1}-\\sqrt n}{\\sqrt{n+1}-\\sqrt n}\\\\&=\\frac{\\sqrt{n+1}-\\sqrt n}{(n+1)-n}\\\\&=\\sqrt{n+1}-\\sqrt n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p57-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence simplify\n$$\\frac{1}{1+\\sqrt2}+\\frac{1}{\\sqrt2+\\sqrt3}+\\frac{1}{\\sqrt3+\\sqrt4}+\\cdots+\\frac{1}{\\sqrt{99}+\\sqrt{100}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$. By part a, consecutive terms cancel, leaving $\\sqrt{100}-1$.",
          "worked": "Using part a,\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\frac{1}{1+\\sqrt2}+\\frac{1}{\\sqrt2+\\sqrt3}+\\frac{1}{\\sqrt3+\\sqrt4}+\\cdots+\\frac{1}{\\sqrt{99}+\\sqrt{100}}\\\\&=(\\sqrt2-1)+(\\sqrt3-\\sqrt2)+(\\sqrt4-\\sqrt3)+\\cdots+(\\sqrt{100}-\\sqrt{99})\\\\&=-1+\\sqrt{100}\\\\&=9\\end{aligned}$$\nThe intermediate square-root terms cancel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
