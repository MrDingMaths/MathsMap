  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Jimmy expanded $(x+5)^2=x^2+25$. Explain why he is incorrect.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "He omitted the middle term $10x$. The correct expansion is $x^2+10x+25$.",
      "worked": "The rule includes the middle term $2ab=2(x)(5)=10x$.\n$$\\begin{align*}(x+5)^2&=x^2+2(x)(5)+5^2\\\\&=x^2+10x+25\\end{align*}$$\nJimmy omitted $10x$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
