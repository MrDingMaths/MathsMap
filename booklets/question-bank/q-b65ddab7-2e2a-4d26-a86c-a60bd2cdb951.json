          "inlines": [
            {
              "type": "text",
              "text": "by using the definition of the binomial coefficient, ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\binom{n}{k}=\\frac{n!}{k!(n-k)!}",
              "display": false
            },
