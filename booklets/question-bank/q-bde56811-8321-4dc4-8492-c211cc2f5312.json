      {
        "id": "v2-d17859d5b-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $(e^x+e^{-x})^2-(e^x-e^{-x})^2=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(e^x+e^{-x})^2-(e^x-e^{-x})^2=4$.",
          "worked": "$$\\begin{align*}(e^x+e^{-x})^2&=e^{2x}+2+e^{-2x}\\\\(e^x-e^{-x})^2&=e^{2x}-2+e^{-2x}\\\\(e^x+e^{-x})^2-(e^x-e^{-x})^2&=e^{2x}+2+e^{-2x}-e^{2x}+2-e^{-2x}\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-d17859d5b-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Given $y=(e^x+e^{-x})(e^x-e^{-x})$, show that $\\dfrac{dy}{dx}=2(e^{2x}+e^{-2x})$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{2x}-e^{-2x}$, so $\\dfrac{dy}{dx}=2(e^{2x}+e^{-2x})$.",
          "worked": "$$\\begin{align*}y&=e^{2x}-e^{x}e^{-x}+e^{-x}e^{x}-e^{-2x}\\\\y&=e^{2x}-e^{-2x}\\\\\\frac{dy}{dx}&=2e^{2x}-(-2e^{-2x})\\\\&=2e^{2x}+2e^{-2x}\\\\&=2(e^{2x}+e^{-2x})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
