        "answer": {
          "short": "$S_1=24,\\ S_2=12,\\ S_3=18,\\ S_4=15,\\ S_5=16\\frac12,\\ S_6=15\\frac34$.",
          "worked": "$$\\begin{align*}S_1&=24\\\\S_2&=24-12=12\\\\S_3&=12+6=18\\\\S_4&=18-3=15\\\\S_5&=15+\\frac32=16\\frac12\\\\S_6&=16\\frac12-\\frac34=15\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
