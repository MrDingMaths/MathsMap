      {
        "id": "p26-q2b",
        "type": "part",
        "label": "b",
        "prompt": "Find the limiting sum using $S_\\infty=\\dfrac{a}{1-r}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=16$.",
          "worked": "Since $|r|=\\frac12<1$, the limiting sum exists.\n$$\\begin{align*}S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{24}{1-\\left(-\\frac12\\right)}\\\\S_\\infty&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
