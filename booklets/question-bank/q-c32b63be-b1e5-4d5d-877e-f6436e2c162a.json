        "prompt": "$y'=1-y,\\quad y(0)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1+2e^{-x}$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=\\frac{1}{1-y}\\\\x&=\\int\\frac{1}{1-y}\\,dy\\\\x&=-\\ln|1-y|+C\\\\\\ln|1-y|&=-x+C\\\\y&=1+Ae^{-x}\\\\3&=1+A\\\\A&=2\\\\y&=1+2e^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p34-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y'=y-1,\\quad y(0)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1-e^x$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=\\frac{1}{y-1}\\\\x&=\\int\\frac{1}{y-1}\\,dy\\\\x&=\\ln|y-1|+C\\\\y&=1+Ae^x\\\\0&=1+A\\\\A&=-1\\\\y&=1-e^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p34-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y'=\\frac12(y+1),\\quad y(0)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-1+2e^{x/2}$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=\\frac{2}{y+1}\\\\x&=\\int\\frac{2}{y+1}\\,dy\\\\x&=2\\ln|y+1|+C\\\\\\ln|y+1|&=\\frac{x}{2}+C\\\\y&=-1+Ae^{x/2}\\\\1&=-1+A\\\\A&=2\\\\y&=-1+2e^{x/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
