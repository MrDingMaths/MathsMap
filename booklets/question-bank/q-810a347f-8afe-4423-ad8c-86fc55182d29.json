  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A triangle has area $4\\text{ cm}^2$ and a base of length $3\\text{ cm}$. Find the height of the triangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{8}{3}\\text{ cm}$.",
      "worked": "$$\\begin{align*}A&=\\frac{bh}{2}\\\\4&=\\frac{3h}{2}\\\\3h&=8\\\\h&=\\frac{8}{3}\\text{ cm}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
