    "children": [
      {
        "id": "v2-aaf64-p28-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "${}^{9}C_3+{}^{9}C_7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{10}C_3$",
          "worked": "$$\\begin{align*}{}^{9}C_3+{}^{9}C_7&={}^{9}C_3+{}^{9}C_2\\\\&={}^{10}C_3\\end{align*}$$\nBy symmetry ${}^{9}C_7={}^{9}C_2$, then Pascal's identity gives the result. (${}^{10}C_7$ is also correct.)",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-aaf64-p28-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "${}^{n}C_r+{}^{n}C_{n-r+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{n+1}C_r$",
          "worked": "$$\\begin{align*}{}^{n}C_r+{}^{n}C_{n-r+1}&={}^{n}C_r+{}^{n}C_{r-1}\\\\&={}^{n+1}C_r\\end{align*}$$\nBy symmetry ${}^{n}C_{n-r+1}={}^{n}C_{r-1}$, then Pascal's identity gives the result.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-aaf64-p28-practice-slot-5-slot-5-q-c",
        "type": "part",
        "label": "c",
        "prompt": "${}^{6}C_2+2\\times{}^{6}C_3+{}^{6}C_4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{8}C_4$",
          "worked": "$$\\begin{align*}{}^{6}C_2+2\\times{}^{6}C_3+{}^{6}C_4&=\\left({}^{6}C_2+{}^{6}C_3\\right)+\\left({}^{6}C_3+{}^{6}C_4\\right)\\\\&={}^{7}C_3+{}^{7}C_4\\\\&={}^{8}C_4\\end{align*}$$\nCheck: $15+2(20)+15=70={}^{8}C_4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
