        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p8-q7-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence, find the domain of the following functions.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q7-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$f(x)=\\frac1x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "D: $x\\in\\mathbb R$, $x\\ne0$.",
              "worked": "The denominator is zero when $x=0$. Exclude this value.\n\nD: $x\\in\\mathbb R$, $x\\ne0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          },
          {
            "id": "p8-q7-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$f(x)=\\frac1{x-1}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "D: $x\\in\\mathbb R$, $x\\ne1$.",
              "worked": "$$\\begin{align*}x-1&=0\\\\x&=1\\end{align*}$$\nExclude $1$. D: $x\\in\\mathbb R$, $x\\ne1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p8-q7-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$f(x)=\\frac1{2x-3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "D: $x\\in\\mathbb R$, $x\\ne\\frac32$.",
              "worked": "$$\\begin{align*}2x-3&=0\\\\2x&=3\\\\x&=\\frac32\\end{align*}$$\nExclude $\\frac32$. D: $x\\in\\mathbb R$, $x\\ne\\frac32$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p8-q7-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$f(x)=\\frac{x}{x+2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "D: $x\\in\\mathbb R$, $x\\ne-2$.",
              "worked": "$$\\begin{align*}x+2&=0\\\\x&=-2\\end{align*}$$\nExclude $-2$. D: $x\\in\\mathbb R$, $x\\ne-2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p8-q7-b-v",
            "type": "part",
            "label": "v",
            "prompt": "$f(x)=\\frac2{x-7}+3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "D: $x\\in\\mathbb R$, $x\\ne7$.",
              "worked": "$$\\begin{align*}x-7&=0\\\\x&=7\\end{align*}$$\nExclude $7$. D: $x\\in\\mathbb R$, $x\\ne7$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p8-q7-b-vi",
            "type": "part",
            "label": "vi",
            "prompt": "$f(x)=\\frac1{(x-3)^2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "D: $x\\in\\mathbb R$, $x\\ne3$.",
              "worked": "$$\\begin{align*}(x-3)^2&=0\\\\x-3&=0\\\\x&=3\\end{align*}$$\nExclude $3$. D: $x\\in\\mathbb R$, $x\\ne3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
