  "content": {
    "id": "p12-ch18-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Given $y\\propto x^3$ and $y=40$ when $x=2$, find the formula for $y$ in terms of $x$ and the exact value of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-ch18-q7-formula",
        "type": "part",
        "label": "",
        "prompt": "Formula for $y$ in terms of $x$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=5x^3$",
          "worked": "$\\begin{align*}y&=kx^3\\\\40&=k\\times2^3\\\\40&=8k\\\\k&=5\\\\y&=5x^3\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-ch18-q7-values",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
