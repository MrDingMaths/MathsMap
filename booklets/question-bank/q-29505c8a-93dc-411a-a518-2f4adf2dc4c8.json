  "content": {
    "id": "p27-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Find $\\frac{2ab}{a+b}$ if:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$a=2$ and $b=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12}{5}$",
          "worked": "$$\\begin{align*}\\frac{2ab}{a+b}&=\\frac{2\\times2\\times3}{2+3}\\\\\\frac{2ab}{a+b}&=\\frac{12}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$a=10$ and $b=50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{50}{3}$",
          "worked": "$$\\begin{align*}\\frac{2ab}{a+b}&=\\frac{2\\times10\\times50}{10+50}\\\\\\frac{2ab}{a+b}&=\\frac{1000}{60}\\\\\\frac{2ab}{a+b}&=\\frac{50}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p27-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$a=\\frac12$ and $b=\\frac13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac25$",
          "worked": "$$\\begin{align*}\\frac{2ab}{a+b}&=\\frac{2\\times\\frac12\\times\\frac13}{\\frac12+\\frac13}\\\\\\frac{2ab}{a+b}&=\\frac13\\div\\frac56\\\\\\frac{2ab}{a+b}&=\\frac13\\times\\frac65\\\\\\frac{2ab}{a+b}&=\\frac25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p27-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$a=\\frac13$ and $b=\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac27$",
          "worked": "$$\\begin{align*}\\frac{2ab}{a+b}&=\\frac{2\\times\\frac13\\times\\frac14}{\\frac13+\\frac14}\\\\\\frac{2ab}{a+b}&=\\frac16\\div\\frac7{12}\\\\\\frac{2ab}{a+b}&=\\frac16\\times\\frac{12}{7}\\\\\\frac{2ab}{a+b}&=\\frac27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p27-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$a=\\frac23$ and $b=\\frac34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12}{17}$",
          "worked": "$$\\begin{align*}\\frac{2ab}{a+b}&=\\frac{2\\times\\frac23\\times\\frac34}{\\frac23+\\frac34}\\\\\\frac{2ab}{a+b}&=1\\div\\frac{17}{12}\\\\\\frac{2ab}{a+b}&=1\\times\\frac{12}{17}\\\\\\frac{2ab}{a+b}&=\\frac{12}{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p27-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$a=\\frac1x$ and $b=\\frac1y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{x+y}$\n\nCombine the denominator fractions, then multiply by the reciprocal.",
          "worked": "$$\\begin{align*}\\frac{2ab}{a+b}&=\\frac{2\\times\\frac1x\\times\\frac1y}{\\frac1x+\\frac1y}\\\\\\frac{2ab}{a+b}&=\\frac{2}{xy}\\div\\frac{x+y}{xy}\\\\\\frac{2ab}{a+b}&=\\frac{2}{xy}\\times\\frac{xy}{x+y}\\\\\\frac{2ab}{a+b}&=\\frac{2}{x+y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
