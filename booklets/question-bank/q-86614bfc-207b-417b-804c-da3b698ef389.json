    "type": "question",
    "label": null,
    "prompt": "Find $\\displaystyle\\int\\left(15\\cos 5x-4\\sin 2x+12\\sec^2\\left(\\frac{x}{3}\\right)\\right)\\,dx$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\sin 5x+2\\cos 2x+36\\tan\\left(\\frac{x}{3}\\right)+C$",
      "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int\\left(15\\cos 5x-4\\sin 2x+12\\sec^2\\left(\\frac{x}{3}\\right)\\right)\\,dx\\\\&=\\frac{15}{5}\\sin 5x+\\frac{4}{2}\\cos 2x+\\frac{12}{1/3}\\tan\\left(\\frac{x}{3}\\right)+C\\\\&=3\\sin 5x+2\\cos 2x+36\\tan\\left(\\frac{x}{3}\\right)+C\\end{aligned}$$",
      "solutionDiagrams": []
    },
