  "content": {
    "id": "p21-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Solve the following for $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$8(x-4)-3(4-x)=2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{44}{9}$",
          "worked": "$$\\begin{align*}8(x-4)-3(4-x)&=2x\\\\8x-32-12+3x&=2x\\\\11x-44&=2x\\\\9x&=44\\\\x&=\\frac{44}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p21-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2}{3}x-1=\\frac{x}{2}-\\frac{1}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "Multiply both sides by $6$.\n\n$$\\begin{align*}4x-6&=3x-1\\\\4x-3x&=6-1\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3x-1}{2}-\\frac{2x+1}{3}=-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5$",
          "worked": "Multiply both sides by $6$.\n\n$$\\begin{align*}3(3x-1)-2(2x+1)&=-30\\\\9x-3-4x-2&=-30\\\\5x-5&=-30\\\\5x&=-25\\\\x&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p21-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1-2x}{x-2}=\\frac{1-4x}{2x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5}{13}$",
          "worked": "The denominators require $x\\ne 2,-\\frac{3}{2}$. Multiply both sides by $(x-2)(2x+3)$.\n\n$$\\begin{align*}(1-2x)(2x+3)&=(1-4x)(x-2)\\\\-4x^2-4x+3&=-4x^2+9x-2\\\\5&=13x\\\\x&=\\frac{5}{13}\\end{align*}$$\n\nBoth original denominators are nonzero at $x=\\frac{5}{13}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
