            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Under the original effectiveness of 70%, Team B: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "X_B\\sim B(90,0.7)",
                "display": false
              }
            ]
          },
          {
            "id": "p49-q18-answer-b-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\mu_B&=90(0.7)=63\\\\\\sigma_B&=\\sqrt{90(0.7)(0.3)}\\approx4.3\\\\z_B&=\\frac{74-63}{\\sqrt{90(0.7)(0.3)}}\\approx2.5\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p49-q18-answer-conclusion",
