  "content": {
    "id": "p59-net-pay-bridge-root",
    "type": "question",
    "label": "4",
    "prompt": "Sam earns \\$1000 gross per week and has weekly PAYG deductions of \\$250.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p59-bridge-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate his weekly net pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$750",
          "worked": "$$\\begin{align*}\\text{Weekly net pay}&=1000-250\\\\&=\\$750\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p59-bridge-b",
        "type": "part",
        "label": "b",
        "prompt": "He spends \\$90 per week on household expenses. What percentage of his net pay is this?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage of net pay}&=\\frac{90}{750}\\times100\\%\\\\&=12\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
