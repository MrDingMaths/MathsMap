  "content": {
    "id": "p16-q12",
    "type": "question",
    "label": "12",
    "prompt": "Consider the two parabolas $y=x^2-4x+3$ and $y=x^2+4x+3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q12a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch both quadratic functions on the same set of axes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Upward parabolas with vertices $(2,-1)$ and $(-2,-1)$, common $y$-intercept $3$, and $x$-intercepts $1,3$ and $-3,-1$.",
          "worked": "$$\\begin{align*}x^2-4x+3&=(x-2)^2-1\\\\x^2-4x+3&=(x-1)(x-3),\\\\x^2+4x+3&=(x+2)^2-1\\\\x^2+4x+3&=(x+1)(x+3).\\end{align*}$$\nPlot the vertices $(2,-1)$ and $(-2,-1)$, the four $x$-intercepts and the common point $(0,3)$, then draw the two upward parabolas.",
          "solutionDiagrams": [
            {
              "id": "p16-q12a-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"p16-q12a; teacher p35\"}\n\\begin{tikzpicture}[x=0.95cm,y=0.7cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[->,line width=0.5pt] (-4.4,0)--(4.4,0) node[right] {$x$};\\draw[->,line width=0.5pt] (0,-2)--(0,5.3) node[above] {$y$};\\draw[<->,line width=0.8pt,domain=-0.4:4.4,samples=80] plot (\\x,{((\\x)-2)^2-1});\\draw[<->,line width=0.8pt,domain=-4.4:0.4,samples=80] plot (\\x,{((\\x)+2)^2-1});\n\\fill (-2,-1) circle[radius=1.3pt];\\fill (2,-1) circle[radius=1.3pt];\\node[below left=5pt] at (-2,-1) {$(-2,-1)$};\\node[below right=5pt] at (2,-1) {$(2,-1)$};\n\\node[below left=4pt] at (-3,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-3$\\special{dvisvgm:raw </g>}};\\node[below right=4pt] at (-1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\\node[below left=4pt] at (1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\\node[below right=4pt] at (3,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\\node[below left=5pt] at (0,3) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 105,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 16,
                "sourceRegion": "12a; teacher p35",
                "description": "Two parabolas on common axes with all source intercepts and vertices.",
                "mathematics": "y=(x-2)^2-1 and y=(x+2)^2-1",
                "answerVisibility": "solution only"
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p16-q12b",
        "type": "part",
        "label": "b",
        "prompt": "What reflection maps each parabola onto the other?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Reflection in the $y$-axis.",
          "worked": "For $f(x)=x^2-4x+3$, $f(-x)=x^2+4x+3$. The vertices and corresponding intercepts are reflected in the $y$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-q12c",
        "type": "part",
        "label": "c",
        "prompt": "How can the second parabola be obtained by shifting the first?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate $4$ units left.",
          "worked": "The vertex moves from $(2,-1)$ to $(-2,-1)$ while the parabola's shape and orientation stay the same.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-q12d",
        "type": "part",
        "label": "d",
        "prompt": "Confirm your answer to part c algebraically.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2-4(x+4)+3=x^2+4x+3$.",
          "worked": "For $f(x)=x^2-4x+3$, a shift $4$ units left gives:\n$$\\begin{align*}f(x+4)&=(x+4)^2-4(x+4)+3\\\\f(x+4)&=x^2+8x+16-4x-16+3\\\\f(x+4)&=x^2+4x+3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
