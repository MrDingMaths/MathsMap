  "content": {
    "id": "p26-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Anna is paid at the rate of $\\frac{\\$23.60}{\\text{h}}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "How much would she be paid for working 15 h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$354$",
          "worked": "$$\\begin{align*}\\frac{\\$23.60}{1\\text{ h}}&=\\frac{\\$x}{15\\text{ h}}\\\\x&=23.60\\times15\\\\x&=354\\end{align*}$$\nShe would be paid $\\$354$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p26-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "How long would she need to work to earn $\\$472$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ h}$",
          "worked": "$$\\frac{\\$23.60}{1\\text{ h}}=\\frac{\\$472}{x\\text{ h}}$$\nTake the reciprocal of both sides.\n$$\\begin{align*}\\frac{1\\text{ h}}{\\$23.60}&=\\frac{x\\text{ h}}{\\$472}\\\\x&=\\frac{472}{23.60}\\\\x&=20\\end{align*}$$\nShe would need to work $20\\text{ h}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p26-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Anna wants to save for a trip. If she works 28 h in week 1, and 31 h in the next week, how many more hours does she need to work to earn $\\$2000$? Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $25.7\\text{ h}$ more.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p26-q14-c-worked-current",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Current earnings: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(28+31)\\times\\$23.60=\\$1392.40",
                    "display": false
                  }
                ]
              },
              {
                "id": "p26-q14-c-worked-remaining",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Still needs: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\$2000-\\$1392.40=\\$607.60",
                    "display": false
                  }
                ]
              },
              {
                "id": "p26-q14-c-worked-hours",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Additional hours: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{607.60}{23.60}\\text{ h}=\\frac{1519}{59}\\text{ h}\\approx25.7\\text{ h}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
