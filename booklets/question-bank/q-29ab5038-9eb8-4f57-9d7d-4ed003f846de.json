    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\frac{x}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{1}{2\\sqrt{x}}$",
          "worked": "$$\\begin{align*}y&=x^{\\frac{1}{2}}\\\\ y'&=\\frac{1}{2}x^{-\\frac{1}{2}}\\\\ y'&=\\frac{1}{2\\sqrt{x}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac{x^4-x^2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3x^2-1$",
          "worked": "$$\\begin{align*}y&=\\frac{x^4}{x}-\\frac{x^2}{x}\\\\ y&=x^3-x\\\\ y'&=3x^2-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p19-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{x^2+1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=1-\\frac{1}{x^2}$",
          "worked": "$$\\begin{align*}y&=\\frac{x^2}{x}+\\frac{1}{x}\\\\ y&=x+x^{-1}\\\\ y'&=1-x^{-2}\\\\ y'&=1-\\frac{1}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p19-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{x^2-1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=1$",
          "worked": "$$\\begin{align*}y&=\\frac{(x-1)(x+1)}{x+1}\\\\ y&=x-1\\\\ y'&=1\\end{align*}$$ The original domain excludes $x=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{x-1}{x^2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{1}{(x+1)^2}$",
          "worked": "$$\\begin{align*}y&=\\frac{x-1}{(x-1)(x+1)}\\\\ y&=(x+1)^{-1}\\\\ y'&=-(x+1)^{-2}\\\\ y'&=-\\frac{1}{(x+1)^2}\\end{align*}$$ The original domain excludes $x=\\pm1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{x^2-5x+6}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=1$",
          "worked": "$$\\begin{align*}y&=\\frac{(x-2)(x-3)}{x-3}\\\\ y&=x-2\\\\ y'&=1\\end{align*}$$ The original domain excludes $x=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
