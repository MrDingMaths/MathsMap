  "content": {
    "id": "p32-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "By using the fact that $\\cos(90^\\circ-\\alpha)=\\sin\\alpha$ and $\\sin(90^\\circ-\\alpha)=\\cos\\alpha$, solve the following for $\\theta\\in[0^\\circ,90^\\circ]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\theta=\\sin30^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^\\circ$.",
          "worked": "$\\begin{align*}\\cos\\theta&=\\cos(90^\\circ-30^\\circ)\\\\\\cos\\theta&=\\cos60^\\circ\\\\\\theta&=60^\\circ.\\end{align*}$\nThis is the solution in $[0^\\circ,90^\\circ]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin2\\theta=\\cos42^\\circ$\n\nHint: This one has 2 solutions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=24^\\circ$ or $66^\\circ$.",
          "worked": "Since $\\theta\\in[0^\\circ,90^\\circ]$, $2\\theta\\in[0^\\circ,180^\\circ]$.\n$\\begin{align*}\\sin2\\theta&=\\sin(90^\\circ-42^\\circ)\\\\\\sin2\\theta&=\\sin48^\\circ\\\\2\\theta&=48^\\circ\\text{ or }132^\\circ\\\\\\theta&=24^\\circ\\text{ or }66^\\circ.\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
