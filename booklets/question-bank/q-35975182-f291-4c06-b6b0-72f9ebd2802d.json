  "content": {
    "id": "p23-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A continuous probability function is given by $f(x)=ke^x$, defined on $[1,6]$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the exact value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac{1}{e(e^5-1)}$",
          "worked": "$$\\begin{align*}\\int_1^6 ke^x\\,dx&=1\\\\k[e^x]_1^6&=1\\\\k(e^6-e)&=1\\\\k&=\\frac{1}{e(e^5-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p23-q17-b",
        "type": "group",
        "label": "b",
        "prompt": "Find each exact probability:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q17-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(2\\le X\\le5)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{e(e^3-1)}{e^5-1}$",
              "worked": "$$\\begin{align*}P(2\\le X\\le5)&=\\int_2^5 ke^x\\,dx\\\\&=k[e^x]_2^5\\\\&=k(e^5-e^2)\\\\&=\\frac{e^5-e^2}{e(e^5-1)}\\\\&=\\frac{e(e^3-1)}{e^5-1}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p23-q17-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(X<4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{e^3-1}{e^5-1}$",
              "worked": "$$\\begin{align*}P(X<4)&=\\int_1^4 ke^x\\,dx\\\\&=k[e^x]_1^4\\\\&=k(e^4-e)\\\\&=\\frac{e^4-e}{e(e^5-1)}\\\\&=\\frac{e^3-1}{e^5-1}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p23-q17-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(X\\ge3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{e^2(e^3-1)}{e^5-1}$",
              "worked": "$$\\begin{align*}P(X\\ge3)&=\\int_3^6 ke^x\\,dx\\\\&=k[e^x]_3^6\\\\&=k(e^6-e^3)\\\\&=\\frac{e^6-e^3}{e(e^5-1)}\\\\&=\\frac{e^2(e^3-1)}{e^5-1}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      }
    ]
  },
