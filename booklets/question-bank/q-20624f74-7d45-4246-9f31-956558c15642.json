    "children": [
      {
        "id": "p27-q5a",
        "type": "part",
        "label": "a",
        "prompt": "Find the surface area of the smallest cuboid that will contain three balls arranged in a line if the radius of each ball is $2\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$224\\text{ cm}^2$",
          "worked": "Each ball has diameter $4\\text{ cm}$, so the smallest cuboid has dimensions $12\\text{ cm}\\times4\\text{ cm}\\times4\\text{ cm}$.\n$$\\begin{align*}A&=2(12\\times4)+2(12\\times4)+2(4\\times4)\\\\A&=96+96+32\\\\A&=224\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p27-q5b",
        "type": "part",
        "label": "b",
        "prompt": "Find a formula for the surface area of the smallest cuboid that will contain $n$ balls of radius $r$ arranged in a line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p27-q5b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "A=8r^2(2n+1)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p27-q5b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use cuboid dimensions ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2nr\\times2r\\times2r",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Each ball has diameter $2r$, so the smallest cuboid has dimensions $2nr\\times2r\\times2r$.\n$$\\begin{align*}A&=2(2nr)(2r)+2(2nr)(2r)+2(2r)(2r)\\\\A&=8nr^2+8nr^2+8r^2\\\\A&=8r^2(2n+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
