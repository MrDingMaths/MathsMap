    "type": "question",
    "label": "2",
    "prompt": "What is the difference between the distance travelled and displacement of a particle’s motion?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Distance travelled is the total path length and is non-negative. Displacement is the net change in position and can be positive, negative or zero.",
      "worked": "Distance travelled adds the lengths of all parts of the path, so it is non-negative. Displacement from the start to the finish is final position minus initial position; it records direction through its sign.",
      "solutionDiagrams": []
    },
