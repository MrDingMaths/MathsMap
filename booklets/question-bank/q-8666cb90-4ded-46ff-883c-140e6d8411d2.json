  "content": {
    "id": "p21-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "An arc of a circle $C_1$ subtends an angle of $60^\\circ$ at the centre, and has the same length as an arc of a circle $C_2$ subtending an angle of $45^\\circ$ at the centre. Find the ratio of the area of $C_1$ to $C_2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
