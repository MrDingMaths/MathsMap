  "content": {
    "id": "v2-f5ff6-p11-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "$P(x)=ax^2-5$. If $P(3)=13$, find the value of the leading coefficient $a$ and hence find the polynomial.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=2$; $P(x)=2x^2-5$.",
      "worked": "$$\\begin{align*}P(3)&=a(3)^2-5\\\\13&=9a-5\\\\18&=9a\\\\a&=2\\\\P(x)&=2x^2-5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
