  "content": {
    "id": "p43-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Write down the new equations if these curves are translated to the right by 2 units.\nBe careful with negatives!",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=7-2x$",
          "worked": "Replace $x$ with $x-2$.\n$$\\begin{align*}f(x)&=3-2(x-2)\\\\f(x)&=3-2x+4\\\\f(x)&=7-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p43-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=3-4x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=7-x^2$",
          "worked": "Replace $x$ with $x-2$.\n$$\\begin{align*}f(x)&=3-4(x-2)-(x-2)^2\\\\f(x)&=3-4x+8-(x^2-4x+4)\\\\f(x)&=3-4x+8-x^2+4x-4\\\\f(x)&=7-x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p43-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=2^{-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=2^{-2x+4}$",
          "worked": "Replace $x$ with $x-2$.\n$$\\begin{align*}f(x)&=2^{-2(x-2)}\\\\f(x)&=2^{-2x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
