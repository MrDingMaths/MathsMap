    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$1.50$, $\\$6$ and $\\$7.50$, respectively.",
      "worked": "$$\\begin{align*}\\text{Total parts}&=1+4+5=10\\\\\\text{Value of one part}&=\\$15\\div10=\\$1.50\\\\\\text{First share}&=1\\times\\$1.50=\\$1.50\\\\\\text{Second share}&=4\\times\\$1.50=\\$6\\\\\\text{Third share}&=5\\times\\$1.50=\\$7.50\\end{align*}$$",
      "solutionDiagrams": []
    },
