                "type": "math",
                "latex": "\\sqrt{\\frac{\\operatorname{cosec}\\theta+\\cot\\theta}{\\operatorname{cosec}\\theta-\\cot\\theta}}=\\left|\\frac{\\sin\\theta}{1-\\cos\\theta}\\right|,\\qquad\\sin\\theta\\ne0",
                "display": false
              }
            ]
