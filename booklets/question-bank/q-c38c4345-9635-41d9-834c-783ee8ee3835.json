        "label": "a",
        "prompt": "$\\tan\\theta\\cos\\theta=\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sin\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\tan\\theta\\cos\\theta\\\\&=\\frac{\\sin\\theta}{\\cos\\theta}\\cos\\theta\\\\&=\\sin\\theta=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p26-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cot\\alpha\\sin\\alpha=\\cos\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\cos\\alpha=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\cot\\alpha\\sin\\alpha\\\\&=\\frac{\\cos\\alpha}{\\sin\\alpha}\\sin\\alpha\\\\&=\\cos\\alpha=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p26-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\beta\\sec\\beta=\\tan\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\tan\\beta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\sin\\beta\\sec\\beta\\\\&=\\sin\\beta\\frac{1}{\\cos\\beta}\\\\&=\\frac{\\sin\\beta}{\\cos\\beta}\\\\&=\\tan\\beta=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p26-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos A\\operatorname{cosec}A=\\cot A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\cot A=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\cos A\\operatorname{cosec}A\\\\&=\\cos A\\frac{1}{\\sin A}\\\\&=\\frac{\\cos A}{\\sin A}\\\\&=\\cot A=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p26-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\operatorname{cosec}x\\cos x\\tan x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\operatorname{cosec}x\\cos x\\tan x\\\\&=\\frac{1}{\\sin x}\\cos x\\frac{\\sin x}{\\cos x}\\\\&=1=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sin y\\cot y\\sec y=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\sin y\\cot y\\sec y\\\\&=\\sin y\\frac{\\cos y}{\\sin y}\\frac{1}{\\cos y}\\\\&=1=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
