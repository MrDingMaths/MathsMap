      {
        "id": "v2-96654-p31-practice-j2-021943-j2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2}{x}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x+2}{x}$",
          "worked": "$$\\begin{align*}\\frac{2}{x}+3&=\\frac{2}{x}+\\frac{3x}{x}\\\\&=\\frac{2+3x}{x}\\\\&=\\frac{3x+2}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-96654-p31-practice-j2-021943-j2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5}{x+1}-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3-2x}{x+1}$",
          "worked": "$$\\begin{align*}\\frac{5}{x+1}-2&=\\frac{5}{x+1}-\\frac{2(x+1)}{x+1}\\\\&=\\frac{5-(2x+2)}{x+1}\\\\&=\\frac{3-2x}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-96654-p31-practice-j2-021943-j2-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2}{x+2}-(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{x^2}{x+2}-(x-2)&=\\frac{x^2}{x+2}-\\frac{(x-2)(x+2)}{x+2}\\\\&=\\frac{x^2-(x^2-4)}{x+2}\\\\&=\\frac{4}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
