  "content": {
    "id": "p38-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A child cycles for 90 minutes at $8\\text{ km/h}$. How far does he go?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\text{ km}$",
      "worked": "$$\\begin{align*}\\text{Time}&=\\frac{90}{60}\\text{ h}\\\\\\text{Time}&=1.5\\text{ h}\\end{align*}$$\n\n$$\\begin{align*}\\text{Distance}&=\\text{speed}\\times\\text{time}\\\\\\text{Distance}&=8\\times1.5\\text{ km}\\\\\\text{Distance}&=12\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
