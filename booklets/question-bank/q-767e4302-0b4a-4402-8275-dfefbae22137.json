        "label": "a",
        "prompt": "Find the number of sides of the polygon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "15 sides",
          "worked": "$$\\begin{align*}24^{\\circ}&=\\frac{360^{\\circ}}{n}\\\\n&=\\frac{360^{\\circ}}{24^{\\circ}}\\\\n&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-3cf9e-p17-practice-slot-6-lower-slot-6-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the angle sum of the polygon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2340^{\\circ}$",
          "worked": "$$\\begin{align*}S&=180(n-2)\\\\&=180(15-2)\\\\&=180(13)\\\\&=2340^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
