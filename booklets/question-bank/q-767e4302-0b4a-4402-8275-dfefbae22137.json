    "type": "question",
    "label": null,
    "prompt": "Each exterior angle of a regular polygon is $24^{\\circ}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-3cf9e-p17-practice-slot-6-lower-slot-6-lower-q-a",
