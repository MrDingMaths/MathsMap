            "inlines": [
              {
                "type": "math",
                "latex": "\\binom{n}{k}=\\frac{n-k+1}{k}\\frac{n!}{(n-k+1)!(k-1)!}=\\frac{n-k+1}{k}\\binom{n}{k-1}",
                "display": false
              }
            ]
          },
          {
            "id": "p40-q36-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Expand the combinations into factorials and use k! = k(k−1)!.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\binom{n}{k}&=\\frac{n!}{(n-k)!k!}\\\\\\binom{n}{k}&=\\frac{(n-k+1)n!}{(n-k+1)!\\,k(k-1)!}\\\\\\binom{n}{k}&=\\frac{n-k+1}{k}\\frac{n!}{[n-(k-1)]!(k-1)!}\\\\\\binom{n}{k}&=\\frac{n-k+1}{k}\\binom{n}{k-1}.\\end{align*}$$",
      "solutionDiagrams": []
    },
