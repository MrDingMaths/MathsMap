    "id": "p40-q36-root",
    "type": "question",
    "label": "36",
    "prompt": "Show that $\\binom{n}{k}=\\frac{n-k+1}{k}\\binom{n}{k-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p40-q36-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
