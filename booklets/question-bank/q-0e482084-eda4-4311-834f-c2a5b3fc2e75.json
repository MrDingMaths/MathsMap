        "label": "a",
        "prompt": "$2y+5=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\dfrac{x-5}{2}$",
          "worked": "$\\begin{align*}2y&=x-5\\\\y&=\\frac{x-5}{2}\\\\f(x)&=\\frac{x-5}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p14-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$3x+4y+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=-\\dfrac{3x+5}{4}$",
          "worked": "$\\begin{align*}4y&=-3x-5\\\\y&=-\\frac{3x+5}{4}\\\\f(x)&=-\\frac{3x+5}{4}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p14-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\sqrt[3]{x}$",
          "worked": "$\\begin{align*}y&=\\sqrt[3]{x}\\\\f(x)&=\\sqrt[3]{x}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
