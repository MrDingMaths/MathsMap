      {
        "id": "p20-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$8^{\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}8^{\\frac{2}{3}}&=(\\sqrt[3]{8})^2\\\\8^{\\frac{2}{3}}&=2^2\\\\8^{\\frac{2}{3}}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$25^{-\\frac{3}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{125}$",
          "worked": "$$\\begin{align*}25^{-\\frac{3}{2}}&=\\frac{1}{(\\sqrt{25})^3}\\\\25^{-\\frac{3}{2}}&=\\frac{1}{5^3}\\\\25^{-\\frac{3}{2}}&=\\frac{1}{125}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{1}{16}\\right)^{-\\frac{3}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{16}\\right)^{-\\frac{3}{4}}&=16^{\\frac{3}{4}}\\\\\\left(\\frac{1}{16}\\right)^{-\\frac{3}{4}}&=(\\sqrt[4]{16})^3\\\\\\left(\\frac{1}{16}\\right)^{-\\frac{3}{4}}&=2^3\\\\\\left(\\frac{1}{16}\\right)^{-\\frac{3}{4}}&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
