  "content": {
    "id": "p12-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Find the missing numbers to make these equations true.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q15-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p12-q15-a-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "10x+6y-",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$7$",
                  "width": 11,
                  "expectedResponse": "$7$"
                },
                {
                  "type": "math",
                  "latex": "x+",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$2$",
                  "width": 11,
                  "expectedResponse": "$2$"
                },
                {
                  "type": "math",
                  "latex": "y=3x+8y",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7,\\ 2$",
          "worked": "The missing coefficients are $10-3=7$ and $8-6=2$.\n$$\\begin{align*}10x+6y-7x+2y&=(10-7)x+(6+2)y\\\\&=3x+8y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p12-q15-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p12-q15-b-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "5a-7b+",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$6$",
                  "width": 11,
                  "expectedResponse": "$6$"
                },
                {
                  "type": "math",
                  "latex": "a+",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$7$",
                  "width": 11,
                  "expectedResponse": "$7$"
                },
                {
                  "type": "math",
                  "latex": "b=11a",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6,\\ 7$",
          "worked": "The missing $a$ coefficient is $11-5=6$. Adding $7b$ cancels $-7b$.\n$$\\begin{align*}5a-7b+6a+7b&=(5+6)a+(-7+7)b\\\\&=11a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p12-q15-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p12-q15-c-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "cloze",
                  "answer": "$7$",
                  "width": 11,
                  "expectedResponse": "$7$"
                },
                {
                  "type": "math",
                  "latex": "c+",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$9$",
                  "width": 11,
                  "expectedResponse": "$9$"
                },
                {
                  "type": "math",
                  "latex": "d+",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$5$",
                  "width": 11,
                  "expectedResponse": "$5$"
                },
                {
                  "type": "math",
                  "latex": "=4c+2d+1+3c+7d+4",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7,\\ 9,\\ 5$",
          "worked": "$$\\begin{align*}4c+2d+1+3c+7d+4&=(4+3)c+(2+7)d+(1+4)\\\\&=7c+9d+5\\end{align*}$$\nThe missing numbers, from left to right, are $7,\\ 9,\\ 5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p12-q15-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p12-q15-d-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "cloze",
                  "answer": "$8$",
                  "width": 11,
                  "expectedResponse": "$8$"
                },
                {
                  "type": "math",
                  "latex": "a^2b+",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$6$",
                  "width": 11,
                  "expectedResponse": "$6$"
                },
                {
                  "type": "math",
                  "latex": "b^2a+2a^2b+b^2a=7b^2a+10a^2b",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8,\\ 6$",
          "worked": "$a^2b$ and $b^2a$ are unlike terms. The missing coefficients are $10-2=8$ and $7-1=6$.\n$$\\begin{align*}8a^2b+6b^2a+2a^2b+b^2a&=(8+2)a^2b+(6+1)b^2a\\\\&=10a^2b+7b^2a\\\\&=7b^2a+10a^2b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
  },
