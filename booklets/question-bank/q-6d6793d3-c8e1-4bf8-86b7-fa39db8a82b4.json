  "content": {
    "id": "p25-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Determine how many injective functions $f:X\\to Y$ there are, given that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$X=\\{1,2,3\\}$ and $Y=\\{1,2,3\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "Different inputs must have different images. There are 3 choices for the image of 1, then 2 for the image of 2, then 1 for the image of 3.\n$$3\\times2\\times1=6.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$X=\\{1,2,3,4\\}$ and $Y=\\{1,2,3\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "Four different inputs would require four different images, but $Y$ contains only three elements. Hence there are no injective functions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$X=\\{1,2,3\\}$ and $Y=\\{1,2,3,4\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "Different inputs must have different images. There are 4 choices for the image of 1, then 3 for the image of 2, then 2 for the image of 3.\n$$4\\times3\\times2=24.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
