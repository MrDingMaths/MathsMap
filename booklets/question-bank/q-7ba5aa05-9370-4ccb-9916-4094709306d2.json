  "content": {
    "id": "p18-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "The point $P(a,b)$ is shown in the diagram below.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p18-q1-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 18 p18-q1-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-2.7,-2.7) rectangle (2.9,2.9);\n\\draw[->,line width=0.5pt] (-2.6,0)--(2.6,0) node[below] {$x$};\n\\draw[->,line width=0.5pt] (0,-2.6)--(0,2.6) node[left] {$y$};\n\\fill[black] (1.15,1.7) circle (1.6pt);\n\\node[above right] at (1.15,1.7) {$P(a,b)$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 50,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 18,
          "sourceRegion": "Question 1, supplied coordinate diagram",
          "description": "Unscaled Cartesian axes with positive-direction arrowheads, no ticks or grid, and P in the first quadrant. Ordinary point and label use house black.",
          "mathematics": "P represents symbolic coordinates (a,b), with a and b positive as shown. Drawing coordinates specify qualitative placement only, not numerical givens.",
          "answerVisibility": "Only the supplied point P is visible; reflected points and their labels are withheld."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p18-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "The point $P$ is reflected across the $x$-axis. Label the result $Q$ and write the coordinates.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p18-q1-solution-diagram",
        "answer": {
          "short": "$Q(a,-b)$",
          "worked": "Reflection across the $x$-axis keeps the $x$-coordinate and changes the sign of the $y$-coordinate.\n$$Q(a,-b)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "The point $P$ is reflected across the $y$-axis. Label the result $R$ and write the coordinates.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p18-q1-solution-diagram",
        "answer": {
          "short": "$R(-a,b)$",
          "worked": "Reflection across the $y$-axis changes the sign of the $x$-coordinate and keeps the $y$-coordinate.\n$$R(-a,b)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "The point $R$ is reflected across the $x$-axis. Label the result $S$, and write the coordinates.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p18-q1-solution-diagram",
        "answer": {
          "short": "$S(-a,-b)$",
          "worked": "Reflect $R(-a,b)$ across the $x$-axis by changing the sign of its $y$-coordinate.\n$$S(-a,-b)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "The point $Q$ is reflected across the $y$-axis. What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p18-q1-solution-diagram",
        "answer": {
          "short": "$S(-a,-b)$. Reflecting across $x$ then $y$ is the same as reflecting across $y$ then $x$.",
          "worked": "Reflecting $Q(a,-b)$ across the $y$-axis gives $(-a,-b)$, the point $S$. Both orders of reflection give the same point: each coordinate changes sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ],
