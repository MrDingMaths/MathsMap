    "id": "v2-tions-mixed-review-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Find $f^{-1}(x)$ for each function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-tions-mixed-review-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=9x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=\\dfrac{x+4}{9}$.",
          "worked": "Write $y=9x-4$. Interchange $x$ and $y$:\n$$\\begin{align*}x&=9y-4\\\\9y&=x+4\\\\y&=\\frac{x+4}{9}\\\\f^{-1}(x)&=\\frac{x+4}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-tions-mixed-review-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{x}{4}-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=4x+12$.",
          "worked": "Write $y=\\dfrac{x}{4}-3$. Interchange $x$ and $y$:\n$$\\begin{align*}x&=\\frac{y}{4}-3\\\\x+3&=\\frac{y}{4}\\\\y&=4x+12\\\\f^{-1}(x)&=4x+12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
