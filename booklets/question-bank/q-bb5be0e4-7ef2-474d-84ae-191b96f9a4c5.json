    "type": "question",
    "label": "8",
    "prompt": "How many subsets of $\\{1,2,3,\\ldots,10\\}$ contain the numbers 1 and 2?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$256$",
      "worked": "Include 1 and 2. Each of the remaining eight numbers can independently be included or excluded.\n\n$$\\begin{align*}\\text{Number of subsets}&=2^{10-2}\\\\\\text{Number of subsets}&=2^8\\\\\\text{Number of subsets}&=256.\\end{align*}$$",
      "solutionDiagrams": []
    },
