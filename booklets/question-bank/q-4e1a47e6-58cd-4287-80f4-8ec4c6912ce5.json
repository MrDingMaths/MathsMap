  "content": {
    "id": "p50-task37-42-root",
    "type": "question",
    "label": null,
    "prompt": "Find the range of the following quadratic functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-task37-42-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x-2)^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[-4,\\infty)$",
          "worked": "The vertex is $(2,-4)$ and the parabola is concave up, so the minimum value is $-4$.\n\nRange: $[-4,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-task37-42-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=9-(x+3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,9]$",
          "worked": "The vertex is $(-3,9)$ and the parabola is concave down, so the maximum value is $9$.\n\nRange: $(-\\infty,9]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-task37-42-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x+3)(x-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[-16,\\infty)$.\n\nComplete the square: $y=(x-1)^2-16$, so the minimum is $-16$.",
          "worked": "$$\\begin{align*}y&=x^2-2x-15\\\\y&=(x-1)^2-1-15\\\\y&=(x-1)^2-16\\end{align*}$$\n\nThe vertex is $(1,-16)$ and the parabola is concave up, so the minimum value is $-16$.\n\nRange: $[-16,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p50-task37-42-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=-x(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,1]$.\n\nComplete the square: $y=1-(x+1)^2$, so the maximum is $1$.",
          "worked": "$$\\begin{align*}y&=-x^2-2x\\\\y&=-\\bigl((x+1)^2-1\\bigr)\\\\y&=1-(x+1)^2\\end{align*}$$\n\nThe vertex is $(-1,1)$ and the parabola is concave down, so the maximum value is $1$.\n\nRange: $(-\\infty,1]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p50-task37-42-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^2+4x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[-6,\\infty)$.\n\nComplete the square: $y=(x+2)^2-6$, so the minimum is $-6$.",
          "worked": "$$\\begin{align*}y&=(x+2)^2-4-2\\\\y&=(x+2)^2-6\\end{align*}$$\n\nThe vertex is $(-2,-6)$ and the parabola is concave up, so the minimum value is $-6$.\n\nRange: $[-6,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p50-task37-42-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=3-6x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,12]$.\n\nComplete the square: $y=12-(x+3)^2$, so the maximum is $12$.",
          "worked": "$$\\begin{align*}y&=-(x^2+6x)+3\\\\y&=-\\bigl((x+3)^2-9\\bigr)+3\\\\y&=12-(x+3)^2\\end{align*}$$\n\nThe vertex is $(-3,12)$ and the parabola is concave down, so the maximum value is $12$.\n\nRange: $(-\\infty,12]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
