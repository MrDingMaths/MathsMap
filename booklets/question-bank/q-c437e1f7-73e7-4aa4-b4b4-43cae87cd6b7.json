  "content": {
    "id": "p89-q6-response",
    "type": "question",
    "label": "3",
    "prompt": "Describe the effect of changing the value of $k$ on the graph of $y=\\frac{k}{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "For $k\\ne0$ and a fixed sign, increasing $|k|$ moves the branches farther from the origin; decreasing $|k|$ moves them closer. Replacing $k$ by $-k$ reflects the graph in either coordinate axis.",
      "worked": "For positive $k$, the graphs with $k=0.5,1,2$ have branches progressively farther from the origin. For negative $k$, the same outward movement occurs for $k=-0.5,-1,-2$. Thus branch distance increases with $|k|$, rather than with signed $k$.\n\nFor $k>0$, the branches lie in quadrants I and III; for $k<0$, they lie in quadrants II and IV. Replacing $k$ by $-k$ reflects the graph in either coordinate axis. Here $k\\ne0$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
