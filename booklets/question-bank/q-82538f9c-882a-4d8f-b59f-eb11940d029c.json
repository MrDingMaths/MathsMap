        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x-5}{4}+\\frac{5x-3}{10}=-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4\\frac{3}{5}$",
          "worked": "Multiply both sides by 20.\n\n$$\\begin{align*}5(x-5)+2(5x-3)&=-100\\\\5x-25+10x-6&=-100\\\\15x-31&=-100\\\\15x&=-69\\\\x&=-\\frac{69}{15}\\\\x&=-4\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
