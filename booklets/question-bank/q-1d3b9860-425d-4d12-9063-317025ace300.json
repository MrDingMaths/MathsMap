        "type": "part",
        "label": "a",
        "prompt": "160 km at 80 km/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\text{ h}$",
          "worked": "$$\\begin{align*}t&=\\frac{d}{s}\\\\t&=\\frac{160}{80}\\\\t&=2\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
