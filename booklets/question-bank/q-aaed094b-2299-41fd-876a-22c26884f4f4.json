  "content": {
    "id": "p19-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Calculate the value of the following investments if interest is compounded monthly. Give your answers to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\$2000$ at 6% p.a. for 2 years",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2254.32$",
          "worked": "$$\\begin{align*}r &= \\frac{0.06}{12}=0.005\\\\n &= 2\\times12=24\\\\FV &= PV(1+r)^n\\\\FV &= 2000(1+0.005)^{24}\\\\FV &\\approx \\$2254.32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\$34\\,000$ at 24% p.a. for 4 years",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$87\\,960.39$",
          "worked": "$$\\begin{align*}r &= \\frac{0.24}{12}=0.02\\\\n &= 4\\times12=48\\\\FV &= PV(1+r)^n\\\\FV &= 34\\,000(1+0.02)^{48}\\\\FV &\\approx \\$87\\,960.39\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\$670$ at 6.6% p.a. for 2.5 years",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$789.84$",
          "worked": "$$\\begin{align*}r &= \\frac{0.066}{12}=0.0055\\\\n &= 2.5\\times12=30\\\\FV &= PV(1+r)^n\\\\FV &= 670(1+0.0055)^{30}\\\\FV &\\approx \\$789.84\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
