  "content": {
    "id": "v2-80820-p11-practice-retro-slot-4-004338-root",
    "type": "question",
    "label": null,
    "prompt": "Find the total volume, correct to 1 decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-80820-p11-practice-retro-slot-4-004338-retro-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "An ice-cream shop serves 120 spherical scoops, each of radius $2.5\\text{ cm}$. How many litres of ice-cream are needed? ($1\\text{ L}=1000\\text{ cm}^3$)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.9\\text{ L}$",
          "worked": "$$\\begin{align*}V_{\\text{scoop}}&=\\frac43\\pi(2.5)^3\\text{ cm}^3\\\\V_{\\text{total}}&=120\\times\\frac43\\pi(2.5)^3\\\\&=2500\\pi\\text{ cm}^3\\\\&\\approx7854.0\\text{ cm}^3\\\\&=7854.0\\div1000\\\\&\\approx7.9\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-80820-p11-practice-retro-slot-4-004338-retro-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "A factory makes 8000 steel ball bearings, each a sphere of diameter $4\\text{ mm}$. What is the total volume of steel, in $\\text{cm}^3$? ($1\\text{ cm}^3=1000\\text{ mm}^3$)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$268.1\\text{ cm}^3$",
          "worked": "$$\\begin{align*}r&=4\\div2=2\\text{ mm}\\\\V_{\\text{total}}&=8000\\times\\frac43\\pi(2)^3\\\\&=\\frac{256000\\pi}{3}\\text{ mm}^3\\\\&\\approx268082.6\\text{ mm}^3\\\\&=268082.6\\div1000\\\\&\\approx268.1\\text{ cm}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
