      {
        "id": "p6-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\int (3x^2-8x^3+7x^4)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3-2x^4+\\frac{7x^5}{5}+C$",
          "worked": "$$\\begin{align*}\\int (3x^2-8x^3+7x^4)\\,dx&=\\frac{3x^3}{3}-\\frac{8x^4}{4}+\\frac{7x^5}{5}+C\\\\&=x^3-2x^4+\\frac{7x^5}{5}+C\\end{align*}$$",
