    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\int (x+x^2)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{2}+\\frac{x^3}{3}+C$",
          "worked": "$$\\begin{align*}\\int (x+x^2)\\,dx&=\\frac{x^{1+1}}{1+1}+\\frac{x^{2+1}}{2+1}+C\\\\&=\\frac{x^2}{2}+\\frac{x^3}{3}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\int (x^4-x^3)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^5}{5}-\\frac{x^4}{4}+C$",
          "worked": "$$\\begin{align*}\\int (x^4-x^3)\\,dx&=\\frac{x^{4+1}}{4+1}-\\frac{x^{3+1}}{3+1}+C\\\\&=\\frac{x^5}{5}-\\frac{x^4}{4}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\int (x^7+x^{10})\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^8}{8}+\\frac{x^{11}}{11}+C$",
          "worked": "$$\\begin{align*}\\int (x^7+x^{10})\\,dx&=\\frac{x^{7+1}}{7+1}+\\frac{x^{10+1}}{10+1}+C\\\\&=\\frac{x^8}{8}+\\frac{x^{11}}{11}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\int (2x+5x^4)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+x^5+C$",
          "worked": "$$\\begin{align*}\\int (2x+5x^4)\\,dx&=\\frac{2x^2}{2}+\\frac{5x^5}{5}+C\\\\&=x^2+x^5+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\int (9x^8-11)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^9-11x+C$",
          "worked": "$$\\begin{align*}\\int (9x^8-11)\\,dx&=\\frac{9x^9}{9}-11x+C\\\\&=x^9-11x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\int (7x^{13}+3x^8)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^{14}}{2}+\\frac{x^9}{3}+C$",
          "worked": "$$\\begin{align*}\\int (7x^{13}+3x^8)\\,dx&=\\frac{7x^{14}}{14}+\\frac{3x^9}{9}+C\\\\&=\\frac{x^{14}}{2}+\\frac{x^9}{3}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\int (4-3x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x-\\frac{3x^2}{2}+C$",
          "worked": "$$\\begin{align*}\\int (4-3x)\\,dx&=4x-\\frac{3x^{1+1}}{1+1}+C\\\\&=4x-\\frac{3x^2}{2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\int (1-x^2+x^4)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-\\frac{x^3}{3}+\\frac{x^5}{5}+C$",
          "worked": "$$\\begin{align*}\\int (1-x^2+x^4)\\,dx&=x-\\frac{x^{2+1}}{2+1}+\\frac{x^{4+1}}{4+1}+C\\\\&=x-\\frac{x^3}{3}+\\frac{x^5}{5}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
