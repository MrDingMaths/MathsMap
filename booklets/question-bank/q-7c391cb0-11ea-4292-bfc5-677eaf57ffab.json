  "content": {
    "id": "p23-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "From a total of 10 people, 5 like apples, 6 like bananas, and 4 like both.\nDraw a Venn diagram and find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q2-drawing",
        "type": "part",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A$ only: $1$; both: $4$; $B$ only: $2$; neither: $3$.",
          "worked": "Let $A$ be the people who like apples and $B$ the people who like bananas.\n$$\\begin{align*}\n n(A\\cap B)&=4\\\\\n n(A\\cap B')&=5-4=1\\\\\n n(A'\\cap B)&=6-4=2\\\\\n n(A\\cup B)&=5+6-4=7\\\\\n n(A'\\cap B')&=10-7=3\n\\end{align*}$$",
          "solutionDiagrams": [
            {
              "id": "p23-q2-answer-diagram",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 23, p23-q2-answer-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black] (0,0) rectangle (5,3);\n\\draw[black] (1.8,1.5) circle (1.05);\n\\draw[black] (3.2,1.5) circle (1.05);\n\\node at (1.65,2.15) {$A$};\n\\node at (3.35,2.15) {$B$};\n\\node at (1.35,1.35) {$1$};\n\\node at (2.5,1.35) {$4$};\n\\node at (3.65,1.35) {$2$};\n\\node at (4.55,0.45) {$3$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 60,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 23,
                "sourceRegion": "Question 2, supplied answer diagram on the left",
                "description": "Rectangular universal set containing two overlapping circles labelled A and B, with no universal-set label. Source answer blue is replaced by ordinary black diagram marks.",
                "mathematics": "A only contains 1 person, the intersection contains 4, B only contains 2, and neither contains 3; total 10.",
                "answerVisibility": "Answer editions only; no completed diagram appears in the student prompt."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 48,
        "responseSpace": "scaffold"
      },
      {
        "id": "p23-q2-parts",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q2-a",
            "type": "part",
            "label": "b",
            "prompt": "$n(A'\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$$\\begin{align*}\nn(A'\\cap B)&=n(B)-n(A\\cap B)\\\\\n&=6-4\\\\\n&=2\n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p23-q2-b",
            "type": "part",
            "label": "c",
            "prompt": "$n(A'\\cap B')$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "$$\\begin{align*}\nn(A\\cup B)&=5+6-4\\\\\n&=7\\\\\nn(A'\\cap B')&=10-7\\\\\n&=3\n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p23-q2-c",
            "type": "part",
            "label": "d",
            "prompt": "$P(A\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{5}$",
              "worked": "$$\\begin{align*}\nP(A\\cap B)&=\\frac{4}{10}\\\\\n&=\\frac{2}{5}\n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p23-q2-d",
            "type": "part",
            "label": "e",
            "prompt": "$P(A\\cup B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{7}{10}$",
              "worked": "$$\\begin{align*}\nP(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\\n&=\\frac{5}{10}+\\frac{6}{10}-\\frac{4}{10}\\\\\n&=\\frac{7}{10}\n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      }
    ]
  },
