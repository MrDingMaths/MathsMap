  "content": {
    "id": "feedback-rearrange-bridge-root",
    "type": "question",
    "label": "",
    "prompt": "Make $x$ the subject.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "feedback-rearrange-bridge-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\log_2 x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2^{y-3}$",
          "worked": "$$\\begin{align*}y-3 &= \\log_2 x \\\\ x &= 2^{y-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "feedback-rearrange-bridge-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\log_2(7x-5)+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{2^{y-3}+5}{7}$",
          "worked": "$$\\begin{align*}y-3 &= \\log_2(7x-5) \\\\ 2^{y-3} &= 7x-5 \\\\ 7x &= 2^{y-3}+5 \\\\ x &= \\frac{2^{y-3}+5}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
