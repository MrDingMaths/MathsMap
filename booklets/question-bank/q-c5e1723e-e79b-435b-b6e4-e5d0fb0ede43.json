  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The centre of a circle is located at point $C(1,2)$. The line segment $AB$ is a diameter of the circle where $A$ has coordinates $A(-1,4)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the radius of the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{2}$",
          "worked": "$$\\begin{align*}r&=CA\\\\r&=\\sqrt{(-1-1)^2+(4-2)^2}\\\\r&=\\sqrt{8}\\\\r&=2\\sqrt{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coordinates of $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B(3,0)$",
          "worked": "Since $C$ is the midpoint of $AB$,\n$$\\begin{align*}\\frac{-1+x_B}{2}&=1\\\\-1+x_B&=2\\\\x_B&=3.\\end{align*}$$\n$$\\begin{align*}\\frac{4+y_B}{2}&=2\\\\4+y_B&=4\\\\y_B&=0.\\end{align*}$$\nThus $B=(3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p7-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine if the point $(3,4)$ lies on this circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; its squared distance from $C$ is $8=r^2$.",
          "worked": "Let $P=(3,4)$.\n$$\\begin{align*}CP^2&=(3-1)^2+(4-2)^2\\\\CP^2&=8.\\end{align*}$$\nSince $CP^2=r^2=8$, the point lies on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
