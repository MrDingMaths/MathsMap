  "content": {
    "id": "p26-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A runner’s speed is $\\dfrac{x+3}{x+1}$ m/s and she runs for $\\dfrac{x^2-1}{x+3}$ seconds.\n\nWrite an expression for the distance covered.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-1)$ m",
      "worked": "Distance = speed × time.\n$$\\begin{align*}\n\\text{Distance}&=\\frac{x+3}{x+1}\\times\\frac{x^2-1}{x+3}\\\\\n&=\\frac{x+3}{x+1}\\times\\frac{(x-1)(x+1)}{x+3}\\\\\n&=x-1\\text{ m}.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
