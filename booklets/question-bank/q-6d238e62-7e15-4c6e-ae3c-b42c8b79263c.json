    "type": "question",
    "label": "53",
    "prompt": "For each of the following, determine if the sets are disjoint or not disjoint.\n$$\\begin{aligned}A&=[0,1)\\\\B&=[1,2)\\end{aligned}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Disjoint.",
      "worked": "Every member of $A$ is less than $1$, while every member of $B$ is at least $1$. Hence $A\\cap B=\\varnothing$.",
