              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p50-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "The curve passes through the origin.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac18(x+4)^2+2$.",
