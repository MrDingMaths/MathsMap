                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(0,5.2)",
                    "display": false
                  },
                  {
                    "type": "text",
