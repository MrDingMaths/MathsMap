                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{align*}5.2&=k(0+4)^2+2\\\\3.2&=16k\\\\k&=\\frac15\\end{align*}",
                    "display": true
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "y=\\frac15(x+4)^2+2",
                    "display": true
                  }
