  "content": {
    "id": "p50-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "$y=k(x+4)^2+2$ is the form of a quadratic with vertex $(-4,2)$.\nFind the equation of such a quadratic if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "The quadratic is monic.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+4)^2+2$.",
          "worked": "A monic quadratic has coefficient of $x^2$ equal to $1$, so $k=1$.\n$$y=(x+4)^2+2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "The coefficient of $x^2$ is $3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3(x+4)^2+2$.",
          "worked": "The coefficient of $x^2$ is $k$, so $k=3$.\n$$y=3(x+4)^2+2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "The $y$-intercept is $5.2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac15(x+4)^2+2$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p50-q10-root-bank-7b8dbc85-f3d7-4a24-9b95-b94a44e8c62a",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
