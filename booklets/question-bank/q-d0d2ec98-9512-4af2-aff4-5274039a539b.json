            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 27, p27-q2a-diagram\"}\n\\begin{tikzpicture}[x=6mm,y=6mm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (L) at (0,0);\\coordinate (T) at (2.19186,4.49397);\\coordinate (R) at (9.99117,0);\n\\draw (L)--(T)--(R)--cycle;\n\\path (L)--(T) node[midway,above left] {$5\\text{ cm}$};\n\\path (T)--(R) node[midway,above right] {$9\\text{ cm}$};\n\\pic[draw,line width=0.4pt,angle radius=5mm] {angle=R--L--T};\n\\pic[draw,line width=0.4pt,angle radius=6mm] {angle=T--R--L};\n\\node at ($(L)+(32:1.3)$) {$64^\\circ$};\n\\node at ($(R)+(165:1.5)$) {$\\theta$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 65,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 27,
              "sourceRegion": "Question 2(a), left column",
              "description": "Unfilled triangle with horizontal base, 5 cm on the left slope, 9 cm on the right slope, 64° at the left base and θ at the right base.",
              "mathematics": "The side opposite θ is 5 cm; the side opposite 64° is 9 cm. Coordinates derive from these givens.",
              "answerVisibility": "Only source givens and the unknown θ appear."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$\\theta=30^\\circ$",
          "worked": "$$\\begin{align*}\\frac{\\sin\\theta}{5}&=\\frac{\\sin64^\\circ}{9}\\\\\\sin\\theta&=\\frac{5\\sin64^\\circ}{9}\\\\\\theta&=\\sin^{-1}\\!\\left(\\frac{5\\sin64^\\circ}{9}\\right)\\\\\\theta&\\approx30^\\circ\\end{align*}$$",
          "solutionDiagrams": []
