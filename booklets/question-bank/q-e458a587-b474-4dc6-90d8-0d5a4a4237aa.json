  "content": {
    "id": "p4-q7",
    "type": "question",
    "label": "7",
    "prompt": "A bag contains only red and blue marbles. There are five times as many red marbles as blue marbles. A marble is drawn at random. What is the probability that it is blue?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{6}$",
      "worked": "For every blue marble there are five red marbles.\n\n$$\\begin{align*}P(\\text{blue})&=\\frac{1}{5+1}\\\\P(\\text{blue})&=\\frac{1}{6}.\\end{align*}$$",
      "solutionDiagrams": []
    },
