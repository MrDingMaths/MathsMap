  "content": {
    "id": "p18-p6-node",
    "type": "question",
    "label": "6",
    "prompt": "Find the condition on $p$, $q$ and $r$ for the quadratic equation $px^2+2qx+r=0$ to have one distinct real root.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$q^2=pr$.",
      "worked": "A quadratic has one distinct real root exactly when its discriminant is zero.\n\n$$\\begin{align*}\\Delta&=(2q)^2-4pr\\\\\\Delta&=4(q^2-pr)\\end{align*}$$\n\nThus $\\Delta=0$ exactly when $q^2=pr$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 16
  },
