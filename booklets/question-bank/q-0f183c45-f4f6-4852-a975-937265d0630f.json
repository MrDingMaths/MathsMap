  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the difference quotient $\\frac{f(x+h)-f(x)}{h}$ of the following functions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-root-run-1",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q4-a",
            "type": "part",
            "label": "a",
            "prompt": "$f(x)=2x+1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "For $h\\ne0$,\n$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{2(x+h)+1-(2x+1)}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{2h}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q4-b",
            "type": "part",
            "label": "b",
            "prompt": "$f(x)=3-4x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-4$",
              "worked": "For $h\\ne0$,\n$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{3-4(x+h)-(3-4x)}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{-4h}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=-4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q4-c",
            "type": "part",
            "label": "c",
            "prompt": "$f(x)=x^2-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2x+h$",
              "worked": "For $h\\ne0$,\n$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{(x+h)^2-1-(x^2-1)}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{2xh+h^2}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=2x+h\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p8-q4-d",
            "type": "part",
            "label": "d",
            "prompt": "$f(x)=x^2+x-5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2x+1+h$",
              "worked": "For $h\\ne0$,\n$$\\begin{align*}f(x+h)&=(x+h)^2+(x+h)-5\\\\f(x+h)-f(x)&=2xh+h^2+h\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{2xh+h^2+h}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=2x+1+h\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          }
        ]
      },
      {
        "id": "p8-q5-root",
        "type": "group",
        "label": "",
        "prompt": "For each function below, take the limit as $h\\to0$ of its difference quotient from the preceding question. State the derivative and hence find the gradient $m$ of the tangent when $x=1$.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q5-a",
            "type": "part",
            "label": "e",
            "prompt": "$f(x)=2x+1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(x)=2,\\quad m=2$",
              "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}2\\\\f'(x)&=2\\\\m&=f'(1)=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p8-q5-b",
            "type": "part",
            "label": "f",
            "prompt": "$f(x)=3-4x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(x)=-4,\\quad m=-4$",
              "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}(-4)\\\\f'(x)&=-4\\\\m&=f'(1)=-4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p8-q5-c",
            "type": "part",
            "label": "g",
            "prompt": "$f(x)=x^2-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(x)=2x,\\quad m=2$",
              "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}(2x+h)\\\\f'(x)&=2x\\\\m&=f'(1)=2(1)=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p8-q5-d",
            "type": "part",
            "label": "h",
            "prompt": "$f(x)=x^2+x-5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(x)=2x+1,\\quad m=3$",
              "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}(2x+1+h)\\\\f'(x)&=2x+1\\\\m&=f'(1)=2(1)+1=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      }
    ]
  },
