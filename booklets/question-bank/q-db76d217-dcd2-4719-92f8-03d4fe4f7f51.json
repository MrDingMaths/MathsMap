  "content": {
    "id": "p35-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Identify the natural domain of these functions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne 0$",
          "worked": "The denominator cannot be zero. The domain is all real $x$ with $x\\ne 0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p35-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\frac{1}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne 2$",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x-2&\\ne 0\\\\x&\\ne 2\\end{align*}$$\nThe domain is all real numbers except $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\frac{1}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne -3$",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x+3&\\ne 0\\\\x&\\ne -3\\end{align*}$$\nThe domain is all real numbers except $-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\frac{1}{2x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne \\frac{3}{2}$",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}2x-3&\\ne 0\\\\2x&\\ne 3\\\\x&\\ne \\frac{3}{2}\\end{align*}$$\nThe domain is all real numbers except $\\frac{3}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\frac{x}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne -2$",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x+2&\\ne 0\\\\x&\\ne -2\\end{align*}$$\nThe domain is all real numbers except $-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\frac{2}{x-7}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne 7$",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x-7&\\ne 0\\\\x&\\ne 7\\end{align*}$$\nThe domain is all real numbers except $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
