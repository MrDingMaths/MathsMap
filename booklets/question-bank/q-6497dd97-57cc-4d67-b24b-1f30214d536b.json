      {
        "id": "p17-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "For the formula $T=2\\pi\\sqrt{\\frac{W}{gF}}$, make $F$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F=\\frac{4\\pi^2W}{gT^2}$",
          "worked": "$$\\begin{align*}\\frac{T}{2\\pi}&=\\sqrt{\\frac{W}{gF}}\\\\\\frac{T^2}{4\\pi^2}&=\\frac{W}{gF}\\\\gFT^2&=4\\pi^2W\\\\F&=\\frac{4\\pi^2W}{gT^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p17-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "For the formula $P=\\frac{\\pi rx}{180}+2r$, make $x$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{180(P-2r)}{\\pi r}$",
          "worked": "$$\\begin{align*}P-2r&=\\frac{\\pi rx}{180}\\\\180(P-2r)&=\\pi rx\\\\x&=\\frac{180(P-2r)}{\\pi r}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p17-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "For the formula $D=\\sqrt{\\frac{f+x}{f-x}}$, make $x$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{f(D^2-1)}{D^2+1}$\n\nSquare both sides, clear the denominator, then collect and factorise the terms containing $x$.",
          "worked": "$$\\begin{align*}D^2&=\\frac{f+x}{f-x}\\\\D^2(f-x)&=f+x\\\\D^2f-D^2x&=f+x\\\\D^2f-f&=D^2x+x\\\\f(D^2-1)&=x(D^2+1)\\\\x&=\\frac{f(D^2-1)}{D^2+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
  },
