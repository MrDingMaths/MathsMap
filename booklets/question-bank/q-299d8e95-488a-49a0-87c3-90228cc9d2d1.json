  "content": {
    "id": "p27-q12-17-root",
    "type": "question",
    "label": "",
    "prompt": "Differentiate the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q12-17-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{1}{5x+8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{5}{(5x+8)^2}$",
          "worked": "$y=(5x+8)^{-1}$. \n\n$$\\begin{align*}y'&=-(5x+8)^{-2}\\times5\\\\y'&=-\\dfrac{5}{(5x+8)^2}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q12-17-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{1}{2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1}{(2-x)^2}$",
          "worked": "$y=(2-x)^{-1}$. \n\n$$\\begin{align*}y'&=-(2-x)^{-2}\\times(-1)\\\\y'&=\\dfrac{1}{(2-x)^2}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q12-17-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{2}{x^2+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{4x}{(x^2+4)^2}$",
          "worked": "$y=2(x^2+4)^{-1}$. \n\n$$\\begin{align*}y'&=-2(x^2+4)^{-2}\\times2x\\\\y'&=-\\dfrac{4x}{(x^2+4)^2}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q12-17-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{10}{x^3-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{30x^2}{(x^3-3)^2}$",
          "worked": "$y=10(x^3-3)^{-1}$. \n\n$$\\begin{align*}y'&=-10(x^3-3)^{-2}\\times3x^2\\\\y'&=-\\dfrac{30x^2}{(x^3-3)^2}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q12-17-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{2}{(4-3x)^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{30}{(4-3x)^6}$",
          "worked": "$y=2(4-3x)^{-5}$. \n\n$$\\begin{align*}y'&=-10(4-3x)^{-6}\\times(-3)\\\\y'&=\\dfrac{30}{(4-3x)^6}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q12-17-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{4}{(2x+1)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{24}{(2x+1)^4}$",
          "worked": "$y=4(2x+1)^{-3}$. \n\n$$\\begin{align*}y'&=-12(2x+1)^{-4}\\times2\\\\y'&=-\\dfrac{24}{(2x+1)^4}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
