    "type": "question",
    "label": "7",
    "prompt": "The waist measurements of 22 people measured to the nearest centimetres are:\n\n85, 91, 81, 92, 92, 101, 76, 84, 74, 76, 80, 86, 82, 82, 96, 81, 76, 84, 88, 82, 96, 99",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the mean. Give your answer correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$85.64\\text{ cm}$",
          "worked": "$$\\begin{align*}\\text{Mean}&=\\frac{1884}{22}\\text{ cm}\\\\\\text{Mean}&=\\frac{942}{11}\\text{ cm}\\\\\\text{Mean}&\\approx85.64\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the median.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84\\text{ cm}$",
          "worked": "In ascending order:\n\n74, 76, 76, 76, 80, 81, 81, 82, 82, 82, 84, 84, 85, 86, 88, 91, 92, 92, 96, 96, 99, 101.\n\nThere are 22 measurements, so use the 11th and 12th values.\n\n$$\\begin{align*}\\text{Median}&=\\frac{84+84}{2}\\text{ cm}\\\\\\text{Median}&=84\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p11-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27\\text{ cm}$",
          "worked": "$$\\begin{align*}\\text{Range}&=(101-74)\\text{ cm}\\\\\\text{Range}&=27\\text{ cm}\\end{align*}$$",
