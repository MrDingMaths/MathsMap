  "content": {
    "id": "p22-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A spherical container has an outer radius of $8\\text{ m}$ and a steel shell that is $40\\text{ mm}$ thick.\nWhat is the volume of the shell, to the nearest cubic metre?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$32\\text{ m}^3$",
      "worked": "$$\\begin{align*}40\\text{ mm}&=0.04\\text{ m}\\\\r_{\\text{inner}}&=8-0.04\\\\r_{\\text{inner}}&=7.96\\text{ m}\\\\V_{\\text{shell}}&=V_{\\text{outer}}-V_{\\text{inner}}\\\\V_{\\text{shell}}&=\\frac{4}{3}\\pi(8^3)-\\frac{4}{3}\\pi(7.96^3)\\\\V_{\\text{shell}}&\\approx32\\text{ m}^3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
