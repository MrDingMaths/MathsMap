            "type": "part",
            "label": "a",
            "prompt": "Estimate the mass of the orangutan at age 3.5 months.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\approx 2.8\\text{ kg}$",
              "worked": "Read upwards from $x=3.5$ to the curve, then across to the mass axis: $m\\approx2.8\\text{ kg}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p42-q1-b",
            "type": "part",
            "label": "b",
            "prompt": "At about what age would the orangutan weigh 3.4 kg?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\approx 4.5$ months",
              "worked": "Read across from $m=3.4$ to the curve, then down to the age axis: $x\\approx4.5$ months.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p42-q1-c",
            "type": "part",
            "label": "c",
            "prompt": "Each month, the mass increases by a factor of 1.2. What is the monthly growth rate of the baby orangutan’s mass? Write your answer as a percentage.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$20\\%$",
              "worked": "$$\\begin{align*}1.2&=1+0.2\\\\0.2\\times100\\%&=20\\%\\end{align*}$$The mass increases by $20\\%$ each month.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ],
        "diagramPlacement": "beside-prompt"
      },
      {
        "id": "p42-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Why might this model only be useful up to age 6 months?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The orangutan’s growth rate might speed up or slow down after 6 months.",
          "worked": "The model assumes a constant monthly percentage increase. After 6 months, the orangutan’s growth rate may change, so the model may no longer give reliable masses.",
