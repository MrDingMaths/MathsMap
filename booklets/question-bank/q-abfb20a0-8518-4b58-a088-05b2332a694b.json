  "content": {
    "id": "p14-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A triangle is called **Heronian** if it has integer side lengths and integer area.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that a triangle with side lengths $5$, $5$ and $6$ is Heronian.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The area is $12$ square units, an integer, so the triangle is Heronian.",
          "worked": "$$\\begin{align*}s&=\\frac{5+5+6}{2}=8\\\\A&=\\sqrt{8(8-5)(8-5)(8-6)}\\\\A&=\\sqrt{144}\\\\A&=12\\end{align*}$$\nThe side lengths and area are integers, so the triangle is Heronian.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p14-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Can you find a right-angled Heronian triangle whose area is smaller than the previous example?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, sides $3$, $4$ and $5$ give area $6$ square units.",
          "worked": "Choose side lengths $3$, $4$ and $5$. Since $3^2+4^2=25=5^2$, the triangle is right-angled.\n$$\\begin{align*}A&=\\frac12\\times3\\times4\\\\A&=6\\end{align*}$$\nIts sides and area are integers, and $6<12$, so it is a suitable Heronian triangle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p14-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that the triangle with sides $13$, $14$ and $15$ is Heronian.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q3-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The area is 84 square units, so the triangle is Heronian.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p14-q3-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Heron’s formula gives ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "s=21",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "A=\\sqrt{21\\times8\\times7\\times6}=84",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}s&=\\frac{13+14+15}{2}=21\\\\A&=\\sqrt{s(s-a)(s-b)(s-c)}\\\\A&=\\sqrt{21(21-13)(21-14)(21-15)}\\\\A&=\\sqrt{21\\times8\\times7\\times6}\\\\A&=\\sqrt{(3\\times7)(2^3)(7)(2\\times3)}\\\\A&=\\sqrt{2^4\\times3^2\\times7^2}\\\\A&=2^2\\times3\\times7\\\\A&=84\\end{align*}$$\nThe side lengths and area are integers, so the triangle is Heronian.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      }
    ]
  },
