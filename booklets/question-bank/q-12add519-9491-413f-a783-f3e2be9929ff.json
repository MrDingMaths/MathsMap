  "content": {
    "id": "p40-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $y=x^2-6x+10$ in vertex form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-3)^2+1$",
          "worked": "$$\\begin{align*}y&=x^2-6x+9-9+10\\\\y&=(x-3)^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Using your answer to part a, explain why the parabola is always above the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Since $(x-3)^2\\ge0$, $y=(x-3)^2+1\\ge1>0$.",
          "worked": "Since $(x-3)^2\\ge0$, adding 1 gives $y\\ge1$. Thus every point on the parabola lies above the $x$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p40-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Check the discriminant to confirm there are no $x$-intercepts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=(-6)^2-4(1)(10)=-4<0$; no $x$-intercepts.",
          "worked": "$$\\begin{align*}\\Delta&=b^2-4ac\\\\\\Delta&=(-6)^2-4(1)(10)\\\\\\Delta&=-4\\end{align*}$$\nSince $\\Delta<0$, there are no real roots and hence no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Express $y=-x^2+2x-4$ in vertex form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-1)^2-3$",
          "worked": "$$\\begin{align*}y&=-(x^2-2x)-4\\\\y&=-\\bigl((x-1)^2-1\\bigr)-4\\\\y&=-(x-1)^2-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p40-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "Georgie says that $y=-x^2+2x-4$ is always above the $x$-axis. Explain why she is wrong.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It is always below the $x$-axis: it is concave down with vertex $(1,-3)$.",
          "worked": "The parabola is concave down and its vertex $(1,-3)$ is its maximum point. Therefore $y\\le-3<0$, so it is always below the $x$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
