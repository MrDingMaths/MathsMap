    "children": [
      {
        "id": "p64-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the derivative of $y=2x^2\\log_e x-x^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4x\\log_e x$.",
          "worked": "$$\\begin{align*}y&=2x^2\\log_e x-x^2\\\\y'&=4x\\log_e x+2x^2\\left(\\frac1x\\right)-2x\\\\&=4x\\log_e x+2x-2x\\\\&=4x\\log_e x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p64-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int x\\log_e x\\,dx$ and $\\displaystyle\\int_e^2 x\\log_e x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\int x\\log_e x\\,dx=\\frac12x^2\\log_e x-\\frac14x^2+C$; $\\displaystyle\\int_e^2 x\\log_e x\\,dx=2\\log_e2-1-\\frac{e^2}{4}$.",
          "worked": "From part a,\n$$\\begin{align*}\\int x\\log_e x\\,dx&=\\frac14\\left(2x^2\\log_e x-x^2\\right)+C\\\\&=\\frac12x^2\\log_e x-\\frac14x^2+C.\\end{align*}$$\nThen\n$$\\begin{align*}\\int_e^2 x\\log_e x\\,dx&=\\left[\\frac12x^2\\log_e x-\\frac14x^2\\right]_e^2\\\\&=\\left(\\frac12(4)\\log_e2-1\\right)-\\left(\\frac12e^2-\\frac14e^2\\right)\\\\&=2\\log_e2-1-\\frac{e^2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
  },
