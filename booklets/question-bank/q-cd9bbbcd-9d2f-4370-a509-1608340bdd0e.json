    "type": "question",
    "label": null,
    "prompt": "Consider the equation $\\dfrac{3(x-2)}{4}+1=7$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4ecde1-p4-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Solve the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10$",
          "worked": "$$\\begin{align*}\\frac{3(x-2)}{4}&=6\\\\3(x-2)&=24\\\\x-2&=8\\\\x&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "v2-4ecde1-p4-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Verify your solution by substitution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LHS $=7=$ RHS",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\frac{3(10-2)}{4}+1\\\\&=\\frac{24}{4}+1\\\\&=7\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
