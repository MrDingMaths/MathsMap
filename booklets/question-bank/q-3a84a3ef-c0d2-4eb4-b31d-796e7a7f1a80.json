  "content": {
    "id": "p11-p3-root",
    "type": "question",
    "label": "3",
    "prompt": "Explain why the domain of $f(x)=\\dfrac{x}{x}$ is $x\\in\\mathbb{R},\\ x\\ne0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "The denominator cannot equal zero.",
      "worked": "At $x=0$, the original expression is $\\frac{0}{0}$, which is undefined. For every $x\\ne0$, $\\frac{x}{x}=1$. Cancelling $x$ does not make the original expression defined at zero, so the domain is $\\mathbb{R}\\setminus\\{0\\}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 10
  },
