    "type": "question",
    "label": "3",
    "prompt": "Find the approximate areas of the circles from Question 2: (a) diameter $8\\text{ mm}$ and (b) radius $3\\text{ m}$. Use $\\pi\\approx\\frac{22}{7}$ and give answers to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
