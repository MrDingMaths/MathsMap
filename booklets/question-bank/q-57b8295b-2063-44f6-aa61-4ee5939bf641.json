  "content": {
    "id": "v2-f5ff6-p11-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "$P(x)=ax^3-7$. If $P(-2)=-31$, find the value of the leading coefficient $a$ and hence find the polynomial.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=3$; $P(x)=3x^3-7$.",
      "worked": "$$\\begin{align*}P(-2)&=a(-2)^3-7\\\\-31&=-8a-7\\\\-24&=-8a\\\\a&=3\\\\P(x)&=3x^3-7\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
