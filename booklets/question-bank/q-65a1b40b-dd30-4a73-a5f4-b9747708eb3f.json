  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A cone with a base area of $150\\text{ cm}^2$ has a total surface area of $2000\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the radius of the base? Answer correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.9\\text{ cm}$",
          "worked": "$$\\begin{align*}\\pi r^2&=150\\\\r&=\\sqrt{\\frac{150}{\\pi}}\\\\r&\\approx6.9\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the slant height? Answer correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$85.2\\text{ cm}$",
          "worked": "Use the unrounded radius from part a.\n$$\\begin{align*}A&=\\pi r^2+\\pi rl\\\\2000&=150+\\pi\\sqrt{\\frac{150}{\\pi}}\\,l\\\\l&=\\frac{1850}{\\sqrt{150\\pi}}\\\\l&\\approx85.2\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the perpendicular height? Answer correct to the nearest whole number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$85\\text{ cm}$",
          "worked": "The perpendicular height, radius and slant height form a right triangle. Use unrounded values.\n$$\\begin{align*}h^2+r^2&=l^2\\\\h&=\\sqrt{l^2-r^2}\\\\h&=\\sqrt{\\left(\\frac{1850}{\\sqrt{150\\pi}}\\right)^2-\\frac{150}{\\pi}}\\\\h&\\approx85\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
