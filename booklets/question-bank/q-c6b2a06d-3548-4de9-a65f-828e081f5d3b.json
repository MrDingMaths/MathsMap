  "content": {
    "id": "p5-q4",
    "type": "question",
    "label": "4",
    "prompt": "30 salad rolls were bought to feed 20 people at a picnic. The total cost was \\$120.\nFind these unit rates:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Salad rolls/person",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5\\text{ rolls/person}$",
          "worked": "$$\\begin{align*}\\frac{30\\text{ rolls}}{20\\text{ people}}&=\\frac{30\\div20\\text{ rolls}}{20\\div20\\text{ people}}\\\\&=\\frac{1.5\\text{ rolls}}{1\\text{ person}}\\\\&=1.5\\text{ rolls/person}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Cost/person",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$6\\text{ per person}$",
          "worked": "$$\\begin{align*}\\frac{\\$120}{20\\text{ people}}&=\\frac{\\$(120\\div20)}{20\\div20\\text{ people}}\\\\&=\\frac{\\$6}{1\\text{ person}}\\\\&=\\$6\\text{/person}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Cost/roll",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$4}{\\text{roll}}$",
          "worked": "$$\\begin{align*}\\frac{\\$120}{30\\text{ rolls}}&=\\frac{\\$(120\\div30)}{30\\div30\\text{ rolls}}\\\\&=\\frac{\\$4}{1\\text{ roll}}\\\\&=\\$4\\text{/roll}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
