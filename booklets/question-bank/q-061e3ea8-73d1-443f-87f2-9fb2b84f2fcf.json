      {
        "id": "p17-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $(1+x)^4$ as far as the term in $x^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+4x+6x^2+\\cdots$",
          "worked": "$$\\begin{aligned}(1+x)^4&=1+\\binom41x+\\binom42x^2+\\cdots\\\\&=1+4x+6x^2+\\cdots\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the coefficient of $x^2$ in the expansion of $(1-5x)(1+x)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-14$",
          "worked": "$$(1-5x)(1+x)^4=(1-5x)(1+4x+6x^2+\\cdots).$$\nCoefficient of $x^2$:\n$$\\begin{aligned}6+(-5)(4)&=6-20\\\\&=-14.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
