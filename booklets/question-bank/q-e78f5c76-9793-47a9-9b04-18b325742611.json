  "content": {
    "id": "p16-review-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A pillar is in the shape of a cylinder with a hemispherical top. If $r$ metres is the radius of the base and $h$ metres is the total height, the volume $V$ cubic metres is given by the formula $$V=\\frac{1}{3}\\pi r^2(3h-r).$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-review-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange the formula to make $h$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\dfrac{V}{\\pi r^2}+\\dfrac{r}{3}$",
          "worked": "$$\\begin{align*}V&=\\frac{1}{3}\\pi r^2(3h-r)\\\\\\frac{3V}{\\pi r^2}&=3h-r\\\\\\frac{3V}{\\pi r^2}+r&=3h\\\\h&=\\frac{V}{\\pi r^2}+\\frac{r}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p16-review-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the height of the pillar, correct to the nearest centimetre, if the radius of the pillar is $0.5\\text{ m}$ and the volume is $10\\text{ m}^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1290\\text{ cm}$",
          "worked": "$$\\begin{align*}h&=\\frac{V}{\\pi r^2}+\\frac{r}{3}\\\\h&=\\frac{10}{\\pi(0.5)^2}+\\frac{0.5}{3}\\\\h&=\\frac{40}{\\pi}+\\frac{1}{6}\\text{ m}\\\\h&=12.899062\\ldots\\text{ m}\\end{align*}$$\n\nThe height is $1289.9062\\ldots\\text{ cm}$, so the height to the nearest centimetre is $1290\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
