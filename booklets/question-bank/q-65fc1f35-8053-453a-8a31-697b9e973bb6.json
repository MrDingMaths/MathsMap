    "children": [
      {
        "id": "p4-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A number is multiplied by −5 and 3 is subtracted. The result is −4. Write an equation and find the number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5x-3=-4,\\quad x=\\frac15$",
          "worked": "Let $x$ be the number.\n$$\\begin{aligned}-5x-3&=-4\\\\-5x&=-1\\\\x&=\\frac15\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Six is added to a number, and the result is multiplied by −3. The result is 28. Write an equation and find the number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3(x+6)=28,\\quad x=-\\frac{46}{3}$",
          "worked": "Let $x$ be the number.\n$$\\begin{aligned}-3(x+6)&=28\\\\x+6&=-\\frac{28}{3}\\\\x&=-\\frac{46}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Seven is subtracted from a number and the result is multiplied by 4. The result is 15. Write an equation and find the number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(x-7)=15,\\quad x=\\frac{43}{4}$",
          "worked": "Let $x$ be the number.\n$$\\begin{aligned}4(x-7)&=15\\\\x-7&=\\frac{15}{4}\\\\x&=\\frac{43}{4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "When a number is multiplied by 5 and divided by 11, the result is 22.8. Find the number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=50.16$",
          "worked": "Let $x$ be the number.\n$$\\begin{aligned}\\frac{5x}{11}&=22.8\\\\5x&=250.8\\\\x&=50.16\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "If you add 13 to a number, you get the same result as when you subtract half the number from 4. What is the number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6$",
          "worked": "Let $x$ be the number.\n$$\\begin{aligned}x+13&=4-\\frac{x}{2}\\\\\\frac{3x}{2}&=-9\\\\x&=-6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
