    "label": "6",
    "prompt": "Simplify each of the following by base swapping:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_9 3+\\log_{27}3+\\log_{81}3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13}{12}$",
          "worked": "$$\\begin{align*}\\log_9 3+\\log_{27}3+\\log_{81}3&=\\frac1{\\log_3 9}+\\frac1{\\log_3 27}+\\frac1{\\log_3 81}\\\\\\log_9 3+\\log_{27}3+\\log_{81}3&=\\frac12+\\frac13+\\frac14\\\\\\log_9 3+\\log_{27}3+\\log_{81}3&=\\frac{13}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\log_{16}2+3\\log_8 2+4\\log_4 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac72$",
          "worked": "$$\\begin{align*}2\\log_{16}2+3\\log_8 2+4\\log_4 2&=\\frac2{\\log_2 16}+\\frac3{\\log_2 8}+\\frac4{\\log_2 4}\\\\2\\log_{16}2+3\\log_8 2+4\\log_4 2&=\\frac24+\\frac33+\\frac42\\\\2\\log_{16}2+3\\log_8 2+4\\log_4 2&=\\frac72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
