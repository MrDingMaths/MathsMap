    "type": "question",
    "label": "6",
    "prompt": "Evaluate the following:\n$$\\frac{1}{2+\\frac{3}{4+\\frac{5}{6}}}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{29}{76}$",
      "worked": "Evaluate from the innermost denominator outwards.\n$$\\begin{align*}\n\\frac{1}{2+\\frac{3}{4+\\frac{5}{6}}}&=\\frac{1}{2+\\frac{3}{\\frac{29}{6}}}\\\\\n\\frac{1}{2+\\frac{3}{4+\\frac{5}{6}}}&=\\frac{1}{2+3\\times\\frac{6}{29}}\\\\\n\\frac{1}{2+\\frac{3}{4+\\frac{5}{6}}}&=\\frac{1}{2+\\frac{18}{29}}\\\\\n\\frac{1}{2+\\frac{3}{4+\\frac{5}{6}}}&=\\frac{1}{\\frac{76}{29}}\\\\\n\\frac{1}{2+\\frac{3}{4+\\frac{5}{6}}}&=\\frac{29}{76}.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 58
  },
