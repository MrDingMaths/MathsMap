  "content": {
    "id": "p12-practice-left-root",
    "type": "question",
    "label": "",
    "prompt": "$f(x)=x^3+2x^2+3$.\n\nDetermine the behaviour of the curve at:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-practice-left-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increasing.",
          "worked": "$$\\begin{align*}f'(x)&=3x^2+4x\\\\f'(-2)&=3(-2)^2+4(-2)\\\\&=4>0\\end{align*}$$\nThe curve is increasing at $x=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-practice-left-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Stationary.",
          "worked": "Using $f'(x)=3x^2+4x$:\n$$\\begin{align*}f'(0)&=3(0)^2+4(0)\\\\&=0\\end{align*}$$\nThe curve is stationary at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-practice-left-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increasing.",
          "worked": "Using $f'(x)=3x^2+4x$:\n$$\\begin{align*}f'(2)&=3(2)^2+4(2)\\\\&=20>0\\end{align*}$$\nThe curve is increasing at $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
