  "content": {
    "id": "p27-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Write in the form $(x+a)^2+c$ by completing the square, then fully factorise as $(x+\\alpha)(x+\\beta)$ using difference of two squares. Note that not all of these expressions can be fully factorised.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+4x-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2-9=(x-1)(x+5)$",
          "worked": "$$\\begin{align*}x^2+4x-5&=x^2+4x+2^2-2^2-5\\\\&=(x+2)^2-9\\\\&=(x+2-3)(x+2+3)\\\\&=(x-1)(x+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p27-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^2-6x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2-7=(x-3-\\sqrt7)(x-3+\\sqrt7)$",
          "worked": "$$\\begin{align*}x^2-6x+2&=x^2-6x+(-3)^2-(-3)^2+2\\\\&=(x-3)^2-7\\\\&=(x-3-\\sqrt7)(x-3+\\sqrt7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p27-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+4x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2-7=(x+2-\\sqrt7)(x+2+\\sqrt7)$",
          "worked": "$$\\begin{align*}x^2+4x-3&=x^2+4x+2^2-2^2-3\\\\&=(x+2)^2-7\\\\&=(x+2-\\sqrt7)(x+2+\\sqrt7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p27-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2-6x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2-16=(x-7)(x+1)$",
          "worked": "$$\\begin{align*}x^2-6x-7&=x^2-6x+(-3)^2-(-3)^2-7\\\\&=(x-3)^2-16\\\\&=(x-3-4)(x-3+4)\\\\&=(x-7)(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p27-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+4x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2+1$; cannot be factorised over the reals.",
          "worked": "$$\\begin{align*}x^2+4x+5&=x^2+4x+2^2-2^2+5\\\\&=(x+2)^2+1\\end{align*}$$\nThe remaining constant is positive, so this is not a difference of two squares and cannot be factorised over the reals.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$x^2-6x+11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2+2$; cannot be factorised over the reals.",
          "worked": "$$\\begin{align*}x^2-6x+11&=x^2-6x+(-3)^2-(-3)^2+11\\\\&=(x-3)^2+2\\end{align*}$$\nThe remaining constant is positive, so this is not a difference of two squares and cannot be factorised over the reals.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+8x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2-9=(x+1)(x+7)$",
          "worked": "$$\\begin{align*}x^2+8x+7&=x^2+8x+4^2-4^2+7\\\\&=(x+4)^2-9\\\\&=(x+4-3)(x+4+3)\\\\&=(x+1)(x+7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p27-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$x^2+3x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac32\\right)^2-\\frac{25}{4}=(x-1)(x+4)$",
          "worked": "$$\\begin{align*}x^2+3x-4&=x^2+3x+\\left(\\frac32\\right)^2-\\left(\\frac32\\right)^2-4\\\\&=\\left(x+\\frac32\\right)^2-\\frac{25}{4}\\\\&=\\left(x+\\frac32-\\frac52\\right)\\left(x+\\frac32+\\frac52\\right)\\\\&=(x-1)(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p28-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2+8x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2-19=(x+4-\\sqrt{19})(x+4+\\sqrt{19})$",
          "worked": "$$\\begin{align*}x^2+8x-3&=x^2+8x+4^2-4^2-3\\\\&=(x+4)^2-19\\\\&=(x+4-\\sqrt{19})(x+4+\\sqrt{19})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p28-q7-k",
        "type": "part",
        "label": "k",
        "prompt": "$x^2+3x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac32\\right)^2-\\frac{13}{4}=\\left(x+\\frac32-\\frac{\\sqrt{13}}2\\right)\\left(x+\\frac32+\\frac{\\sqrt{13}}2\\right)$",
          "worked": "$$\\begin{align*}x^2+3x-1&=x^2+3x+\\left(\\frac32\\right)^2-\\left(\\frac32\\right)^2-1\\\\&=\\left(x+\\frac32\\right)^2-\\frac{13}{4}\\\\&=\\left(x+\\frac32-\\frac{\\sqrt{13}}2\\right)\\left(x+\\frac32+\\frac{\\sqrt{13}}2\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p28-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2+8x+17$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2+1$; cannot be factorised over the reals.",
          "worked": "$$\\begin{align*}x^2+8x+17&=x^2+8x+4^2-4^2+17\\\\&=(x+4)^2+1\\end{align*}$$\nThe remaining constant is positive, so this is not a difference of two squares and cannot be factorised over the reals.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p28-q7-l",
        "type": "part",
        "label": "l",
        "prompt": "$x^2+3x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac32\\right)^2+\\frac74$; cannot be factorised over the reals.",
          "worked": "$$\\begin{align*}x^2+3x+4&=x^2+3x+\\left(\\frac32\\right)^2-\\left(\\frac32\\right)^2+4\\\\&=\\left(x+\\frac32\\right)^2+\\frac74\\end{align*}$$\nThe remaining constant is positive, so this is not a difference of two squares and cannot be factorised over the reals.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
