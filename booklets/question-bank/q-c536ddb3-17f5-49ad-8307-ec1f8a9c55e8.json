  "content": {
    "id": "p14-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "When a balloon is blown up it roughly forms a sphere.\nBy taking a large breath, a teenager can expel $1.2\\text{ L}$ of air from their lungs.\nHow many of these breaths would be needed to make a balloon of diameter $26\\text{ cm}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "8 breaths",
      "worked": "$$\\begin{align*}r&=\\frac{26}{2}=13\\text{ cm}\\\\V&=\\frac43\\pi\\times13^3\\\\V&=\\frac{8788\\pi}{3}\\text{ cm}^{3}\\end{align*}$$\nEach breath supplies $1.2\\text{ L}=1200\\text{ cm}^{3}$.\n$$\\begin{align*}\\text{Number of breaths}&=\\frac{8788\\pi}{3\\times1200}\\\\\\text{Number of breaths}&\\approx7.67\\end{align*}$$\nRound up: 8 breaths are needed.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
  },
