  "content": {
    "id": "p7-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider the function\n$$f(x)=\\begin{cases}x-1,&x<0,\\\\x+1,&x\\ge 0.\\end{cases}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "Since $-2<0$, use the first rule.\n$$\\begin{align*}f(-2)&=-2-1\\\\f(-2)&=-3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $f(3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Since $3\\ge 0$, use the second rule.\n$$\\begin{align*}f(3)&=3+1\\\\f(3)&=4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Sketch the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-1$ for $x<0$, with an open endpoint at $(0,-1)$; $y=x+1$ for $x\\ge0$, with a closed endpoint at $(0,1)$.",
          "worked": "For $x<0$, take the graph of $y=x-1$, excluding $(0,-1)$. For $x\\ge0$, take the graph of $y=x+1$, including $(0,1)$.",
          "solutionDiagrams": [
            {
              "id": "p7-q1-c-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 7 question 1(c); teacher page 31 Section B 1(c)\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.8cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-3.6,-4.3) rectangle (3.6,4.3);\n\\draw[->,line width=0.5pt] (-3.2,0)--(3.2,0) node[right] {$x$};\n\\draw[->,line width=0.5pt] (0,-4)--(0,4) node[above] {$y$};\n\\draw[line width=0.8pt,domain=-3:0,samples=2] plot (\\x,{\\x-1});\n\\draw[line width=0.8pt,domain=0:3,samples=2] plot (\\x,{\\x+1});\n\\draw[black,fill=white,line width=0.8pt] (0,-1) circle (2pt);\n\\fill[black] (0,1) circle (2pt);\n\\node[anchor=north west] at (0.12,-1) {$(0,-1)$};\n\\node[anchor=south east] at (-0.12,1) {$(0,1)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 60,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 7,
                "sourceRegion": "Question 1(c); corresponding answer graph on teacher PDF page 31, printed page 360",
                "description": "Two restricted straight-line branches with unscaled arrowed axes, no ticks or grid, and labelled open and closed endpoints. Decorative source blue is replaced by black.",
                "mathematics": "y=x-1 on x<0; y=x+1 on x>=0. Open point (0,-1), closed point (0,1).",
                "answerVisibility": "Answer editions only; no axes or graph are supplied in the student question."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,-1)\\cup[1,\\infty)$",
          "worked": "For $x<0$, $x-1<-1$, giving $(-\\infty,-1)$. For $x\\ge0$, $x+1\\ge1$, giving $[1,\\infty)$.\n$$\\operatorname{ran}(f)=(-\\infty,-1)\\cup[1,\\infty).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
