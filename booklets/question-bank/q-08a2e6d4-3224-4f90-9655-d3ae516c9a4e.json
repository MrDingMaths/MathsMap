  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Verify that the given function is a particular solution of the DE.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4a",
        "type": "part",
        "label": "a",
        "prompt": "$$x^2y''-2xy'+2y=6;\\qquad y=x^2-2x+3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes: $\\mathrm{LHS}=6=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}y'&=2x-2,\\\\y''&=2.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{LHS}&=x^2(2)-2x(2x-2)+2(x^2-2x+3)\\\\&=2x^2-4x^2+4x+2x^2-4x+6\\\\&=6=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q4b",
        "type": "part",
        "label": "b",
        "prompt": "$$y''-6y'+5y=0;\\qquad y=2e^x+e^{5x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes: $\\mathrm{LHS}=0=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}y'&=2e^x+5e^{5x},\\\\y''&=2e^x+25e^{5x}.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{LHS}&=(2e^x+25e^{5x})\\\\&\\quad-6(2e^x+5e^{5x})\\\\&\\quad+5(2e^x+e^{5x})\\\\&=(2-12+10)e^x\\\\&\\quad+(25-30+5)e^{5x}\\\\&=0=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q4c",
        "type": "part",
        "label": "c",
        "prompt": "$$y''+\\pi^2y=0;\\qquad y=\\cos\\pi x-3\\sin\\pi x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes: $\\mathrm{LHS}=0=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}y'&=-\\pi\\sin\\pi x-3\\pi\\cos\\pi x,\\\\y''&=-\\pi^2\\cos\\pi x+3\\pi^2\\sin\\pi x.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{LHS}&=y''+\\pi^2y\\\\&=-\\pi^2\\cos\\pi x+3\\pi^2\\sin\\pi x\\\\&\\quad+\\pi^2(\\cos\\pi x-3\\sin\\pi x)\\\\&=0=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q4d",
        "type": "part",
        "label": "d",
        "prompt": "$$x^2y''+xy'+y=0;$$\n\n$$y=\\cos(\\ln x),\\quad x>0$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, for $x>0$: $\\mathrm{LHS}=0=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}y'&=-\\frac{\\sin(\\ln x)}{x},\\\\y''&=\\frac{-\\cos(\\ln x)\\cdot\\left(\\frac1x\\right)\\cdot x+\\sin(\\ln x)}{x^2}\\\\&=\\frac{\\sin(\\ln x)-\\cos(\\ln x)}{x^2}.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{LHS}&=x^2y''+xy'+y\\\\&=(\\sin(\\ln x)-\\cos(\\ln x))\\\\&\\quad+x\\left(-\\frac{\\sin(\\ln x)}x\\right)+\\cos(\\ln x)\\\\&=\\sin(\\ln x)-\\cos(\\ln x)\\\\&\\quad-\\sin(\\ln x)+\\cos(\\ln x)\\\\&=0=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
