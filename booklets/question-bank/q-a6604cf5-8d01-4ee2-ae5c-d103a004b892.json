  "content": {
    "id": "p5-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The formula for the time of swing, $T$ seconds, of a pendulum is $T=2\\pi\\sqrt{\\frac{p}{g}}$, where $p$ metres is the length of the pendulum and $g$ is a constant related to gravity.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Make $g$ the subject of this formula.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g=\\dfrac{4\\pi^2p}{T^2}$",
          "worked": "$$\\begin{align*}\\frac{T}{2\\pi}&=\\sqrt{\\frac{p}{g}}\\\\\\frac{T^2}{4\\pi^2}&=\\frac{p}{g}\\\\gT^2&=4\\pi^2p\\\\g&=\\frac{4\\pi^2p}{T^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p5-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "The time of swing is found to be 3 seconds when the length of the pendulum is 2.24 m. What is the value of $g$ (correct to one decimal place)?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g=9.8$",
          "worked": "$$\\begin{align*}g&=\\frac{4\\pi^2\\times2.24}{3^2}\\\\g&=\\frac{224\\pi^2}{225}\\\\g&\\approx9.8\\end{align*}$$\nCorrect to one decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
