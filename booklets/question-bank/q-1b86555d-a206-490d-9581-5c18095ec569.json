  },
  "content": {
    "id": "p7-q4",
    "type": "question",
    "label": "4",
    "prompt": "During Term 2, Rachel did 9 spelling tests. The tests were scored out of 20.\nHer mean score is 15 and her standard deviation is 2.54.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "If Rachel had scored 2 extra marks on every test,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "What would happen to her mean?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Mean increases to 17.",
              "worked": "$15+2=17$. Her mean increases by 2 marks to 17.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p7-q4-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Explain why her standard deviation would be unchanged.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The spread of the distribution has not changed.",
              "worked": "Every score and the mean increase by 2 marks, so each score's distance from the mean stays the same. The standard deviation remains 2.54.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p7-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "If Rachel had scored 15 on every test,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "What would happen to her mean?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Unchanged at 15.",
              "worked": "All 9 scores would be 15, so their mean would still be 15.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p7-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Explain why her standard deviation would be zero.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "No spread means zero standard deviation.",
              "worked": "Every score equals the mean of 15, so every distance from the mean is zero. There is no spread, so the standard deviation is zero.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          }
        ]
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "What will happen to Rachel’s standard deviation if she scores 15 on her next test?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Decreases: the new score equals the mean.",
          "worked": "The new score of 15 equals the existing mean, so the mean stays 15. The new score adds no squared distance from the mean, while the number of scores increases from 9 to 10. The population standard deviation decreases.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "What will happen to Rachel’s standard deviation if she scores 0 on her next test?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increases: 0 is far below the current mean.",
          "worked": "The new score of 0 is 15 marks below the current mean, much farther than the current standard deviation of 2.54. This low score increases the spread, so the standard deviation increases.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
