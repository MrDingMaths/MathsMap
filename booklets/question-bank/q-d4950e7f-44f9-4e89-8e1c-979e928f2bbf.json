  "content": {
    "id": "v2-84011-p25-practice-slot-14-root",
    "type": "question",
    "label": null,
    "prompt": "A council puts aside $\\$3000$ at the end of each year for 12 years in a fund that earns 8% p.a.\nHow much will the fund be worth at the end of the 12 years? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$56\\,931.38$",
      "worked": "End of 1st year: $3000$\n\nEnd of 2nd year: $3000(1.08)+3000$\n\nEnd of 12th year: $3000(1.08)^{11}+3000(1.08)^{10}+\\cdots+3000$\n\nThis is a geometric series with $a=3000$, $R=1.08$ and $n=12$.\n\n$$\\begin{align*}FV&=\\frac{a(R^n-1)}{R-1}\\\\&=\\frac{3000(1.08^{12}-1)}{1.08-1}\\\\&=56\\,931.3794\\ldots\\\\&\\approx\\$56\\,931.38\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
