      {
        "id": "p9-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $y=x-e^x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=1-e^x$",
          "worked": "$$\\frac{dy}{dx}=1-e^x$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p9-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the gradient of the tangent to $y=x-e^x$ at the point where $x=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-e$",
          "worked": "At $x=1$,\n$$\\begin{align*}m&=1-e^1\\\\m&=1-e.\\end{align*}$$\nThe point of tangency is given by\n$$\\begin{align*}y&=1-e,\\end{align*}$$\nso it is $(1,1-e)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Write down the equation of the tangent, and say why it passes through the origin.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(1-e)x$. It has the form $y=kx$, so it passes through the origin.",
          "worked": "$$\\begin{align*}y-(1-e)&=(1-e)(x-1)\\\\y&=(1-e)x-(1-e)+(1-e)\\\\y&=(1-e)x.\\end{align*}$$\nThis is in the form $y=kx$, so it passes through the origin.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q6-d",
        "type": "group",
        "label": "d",
        "prompt": "Find the values of $x$ for which the curve is:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q6-d-i",
            "type": "part",
            "label": "i",
            "prompt": "Stationary",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=0$",
              "worked": "$$\\begin{align*}1-e^x&=0\\\\e^x&=1\\\\x&=0.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p9-q6-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Increasing",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x<0$",
              "worked": "$$\\begin{align*}1-e^x&>0\\\\e^x&<1\\\\x&<0.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p9-q6-d-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Decreasing",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x>0$",
              "worked": "$$\\begin{align*}1-e^x&<0\\\\e^x&>1\\\\x&>0.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      }
