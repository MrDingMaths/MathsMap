  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify the following, expressing your answer using positive indices:\n$$\\frac{a^{-1}+b^{-1}}{a+b}-\\frac{a^{-1}-b^{-1}}{a-b}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{2}{ab}$\n\nThe two fractions simplify to $\\frac{1}{(ab)}$ and $-\\frac{1}{(ab)}$ respectively.",
      "worked": "$$\\begin{align*}\\frac{a^{-1}+b^{-1}}{a+b}-\\frac{a^{-1}-b^{-1}}{a-b}&=\\frac{\\frac1a+\\frac1b}{a+b}-\\frac{\\frac1a-\\frac1b}{a-b}\\\\\\frac{a^{-1}+b^{-1}}{a+b}-\\frac{a^{-1}-b^{-1}}{a-b}&=\\frac{a+b}{ab(a+b)}-\\frac{b-a}{ab(a-b)}\\\\\\frac{a^{-1}+b^{-1}}{a+b}-\\frac{a^{-1}-b^{-1}}{a-b}&=\\frac1{ab}-\\left(-\\frac1{ab}\\right)\\\\\\frac{a^{-1}+b^{-1}}{a+b}-\\frac{a^{-1}-b^{-1}}{a-b}&=\\frac2{ab}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
