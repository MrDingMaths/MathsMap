            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\frac{1}{n}-\\frac{1}{n+1}&=\\frac{n+1-n}{n(n+1)}\\\\&=\\frac{1}{n(n+1)}.\\end{align*}",
                "display": true
              }
            ]
