    "answer": {
      "short": "$\\dfrac{1}{n}-\\dfrac{1}{n+1}=\\dfrac{n+1-n}{n(n+1)}=\\dfrac{1}{n(n+1)}$, where $n\\in\\mathbb{Z}$ and $n\\ne-1,0$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p43-q1-answer",
            "type": "paragraph",
