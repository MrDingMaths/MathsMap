                "type": "math",
                "latex": "n\\ne-1,0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p43-q1-answer-working",
            "type": "paragraph",
            "fontSize": null,
