          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Prove that, for any two consecutive non-zero integers, the reciprocal of the smaller integer minus the reciprocal of the larger integer is the reciprocal of their product.",
              "marks": []
            }
          ]
        }
