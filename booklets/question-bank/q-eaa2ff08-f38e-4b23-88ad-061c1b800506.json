  "content": {
    "id": "p68-q49-question",
    "type": "question",
    "label": "49",
    "prompt": "Find two possible parametrisations for $y=2x-x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(t,2t-t^2)$ or $(-t,-2t-t^2)$, each with $t\\in\\mathbb R$.",
      "worked": "Choose $x=t$:\n$$y=2t-t^2.$$\nThis gives $(t,2t-t^2)$.\nChoose $x=-t$:\n$$\\begin{align*}y&=2(-t)-(-t)^2\\\\y&=-2t-t^2\\end{align*}$$\nThis gives $(-t,-2t-t^2)$. Both use $t\\in\\mathbb R$.",
      "solutionDiagrams": []
    },
