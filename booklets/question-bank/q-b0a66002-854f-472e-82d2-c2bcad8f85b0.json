  "content": {
    "id": "p3-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Verify that the following properties of absolute values are true for the values $x=3$ and $y=-5$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$|-x|=|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|-3|=3$ and $|3|=3$.",
          "worked": "$\\begin{aligned}|-x|&=|-3|\\\\|-x|&=3\\\\|x|&=|3|\\\\|x|&=3\\end{aligned}$\n\nBoth sides equal 3.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$|xy|=|x||y|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|-15|=15$ and $|3||-5|=15$.",
          "worked": "$\\begin{aligned}|xy|&=|3(-5)|\\\\|xy|&=|-15|\\\\|xy|&=15\\\\|x||y|&=|3||-5|\\\\|x||y|&=3\\times5\\\\|x||y|&=15\\end{aligned}$\n\nBoth sides equal 15.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p3-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left|\\dfrac{x}{y}\\right|=\\dfrac{|x|}{|y|}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left|\\dfrac{3}{-5}\\right|=\\dfrac35$ and $\\dfrac{|3|}{|-5|}=\\dfrac35$.",
          "worked": "$\\begin{aligned}\\left|\\frac{x}{y}\\right|&=\\left|\\frac3{-5}\\right|\\\\\\left|\\frac{x}{y}\\right|&=\\frac35\\\\\\frac{|x|}{|y|}&=\\frac{|3|}{|-5|}\\\\\\frac{|x|}{|y|}&=\\frac35\\end{aligned}$\n\nBoth sides equal $\\frac35$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$|x-y|=|y-x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|3+5|=8$ and $|-5-3|=8$.",
          "worked": "$\\begin{aligned}|x-y|&=|3-(-5)|\\\\|x-y|&=|8|\\\\|x-y|&=8\\\\|y-x|&=|-5-3|\\\\|y-x|&=|-8|\\\\|y-x|&=8\\end{aligned}$\n\nBoth sides equal 8.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
