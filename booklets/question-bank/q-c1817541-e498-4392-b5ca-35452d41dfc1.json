        "answer": {
          "short": "$x=\\frac59$ or $x=-1$",
          "worked": "$$\\begin{align*}9x^2+9x-5x-5&=0\\\\9x(x+1)-5(x+1)&=0\\\\(x+1)(9x-5)&=0\\\\x+1&=0\\quad\\text{or}\\quad 9x-5=0\\\\x&=-1\\quad\\text{or}\\quad x=\\frac59\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
