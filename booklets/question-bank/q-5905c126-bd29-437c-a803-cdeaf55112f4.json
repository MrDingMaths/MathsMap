  "content": {
    "id": "p36-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Show that each statement is false when $x=-2$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$|x|=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LHS $=2$, RHS $=-2$.",
          "worked": "$\\begin{aligned}\\text{LHS}&=|-2|=2\\\\\\text{RHS}&=-2\\end{aligned}$\n\nSince $2\\ne-2$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p36-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$|-x|=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LHS $=2$, RHS $=-2$.",
          "worked": "$\\begin{aligned}\\text{LHS}&=|-(-2)|=|2|=2\\\\\\text{RHS}&=-2\\end{aligned}$\n\nSince $2\\ne-2$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p36-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$|x+2|=|x|+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LHS $=0$, RHS $=4$.",
          "worked": "$\\begin{aligned}\\text{LHS}&=|-2+2|=0\\\\\\text{RHS}&=|-2|+2=4\\end{aligned}$\n\nSince $0\\ne4$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p36-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$|x+1|=x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LHS $=1$, RHS $=-1$.",
          "worked": "$\\begin{aligned}\\text{LHS}&=|-2+1|=|-1|=1\\\\\\text{RHS}&=-2+1=-1\\end{aligned}$\n\nSince $1\\ne-1$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p36-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$|x-1|<|x|-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LHS $=3$, RHS $=1$; $3<1$ is false.",
          "worked": "$\\begin{aligned}\\text{LHS}&=|-2-1|=|-3|=3\\\\\\text{RHS}&=|-2|-1=1\\end{aligned}$\n\nSince $3<1$ is false, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p36-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$|x|^3=x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LHS $=8$, RHS $=-8$.",
          "worked": "$\\begin{aligned}\\text{LHS}&=|-2|^3=2^3=8\\\\\\text{RHS}&=(-2)^3=-8\\end{aligned}$\n\nSince $8\\ne-8$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
