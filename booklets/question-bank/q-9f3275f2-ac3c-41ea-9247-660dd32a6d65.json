  "content": {
    "id": "p20-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A stone is dropped from the top of a tall building. The stone's height $h$ metres above the ground $t$ seconds later is $h=80-5t^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "How high is the building?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80\\text{ m}$",
          "worked": "$$\\begin{aligned}h(0)&=80-5(0)^2\\\\h(0)&=80\\text{ m}\\end{aligned}$$\nThe building is $80\\text{ m}$ high.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p20-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "How many seconds does the stone take to reach the ground?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\text{ s}$",
          "worked": "At the ground, $h=0$.\n$$\\begin{aligned}80-5t^2&=0\\\\5t^2&=80\\\\t^2&=16\\\\t&=4\\text{ s}\\end{aligned}$$\nTake the positive value because $t$ is the elapsed time.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p20-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "The velocity $v$ is the rate of change $\\dfrac{dh}{dt}$ of the height. Find the velocity function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(t)=-10t\\text{ m/s}$",
          "worked": "$$\\begin{aligned}v(t)&=\\frac{dh}{dt}\\\\v(t)&=-10t\\text{ m/s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "How fast is the stone travelling when it hits the ground?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40\\text{ m/s}$",
          "worked": "The stone reaches the ground at $t=4$.\n$$\\begin{aligned}v(4)&=-10(4)\\\\v(4)&=-40\\text{ m/s}\\end{aligned}$$\nSpeed is the magnitude of velocity, so it hits the ground at $40\\text{ m/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Acceleration is the rate of change $\\frac{dv}{dt}$ of the velocity. Find the acceleration of the stone (the units are 'metres-per-second, per second', usually written as $\\text{m/s}^2$).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10\\text{ m/s}^2$",
          "worked": "$$\\begin{aligned}a(t)&=\\frac{dv}{dt}\\\\a(t)&=-10\\text{ m/s}^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
