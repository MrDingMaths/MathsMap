  "content": {
    "id": "p17-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A line has equation $2x-by+7=0$. The point $(6,-5)$ is on the line. Find the value of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=-\\dfrac{19}{5}$",
      "worked": "Substitute $x=6$ and $y=-5$.\n$$\\begin{aligned}2(6)-b(-5)+7&=0\\\\5b+19&=0\\\\5b&=-19\\\\b&=-\\frac{19}{5}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
