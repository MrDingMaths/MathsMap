  "content": {
    "id": "p16-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Simplify to a single logarithm.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\log_3 2+\\log_3 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 20$",
          "worked": "$$\\begin{align*}2\\log_3 2+\\log_3 5 &= \\log_3(2^2)+\\log_3 5\\\\&= \\log_3(4\\times5)\\\\&= \\log_3 20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$4\\log_{10}2+\\log_{10}3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{10}48$",
          "worked": "$$\\begin{align*}4\\log_{10}2+\\log_{10}3 &= \\log_{10}(2^4)+\\log_{10}3\\\\&= \\log_{10}(16\\times3)\\\\&= \\log_{10}48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\log_{10}2-\\log_{10}4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{10}2$",
          "worked": "$$\\begin{align*}3\\log_{10}2-\\log_{10}4 &= \\log_{10}(2^3)-\\log_{10}4\\\\&= \\log_{10}\\left(\\frac{8}{4}\\right)\\\\&= \\log_{10}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$5\\log_7 2-\\log_7 16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_7 2$",
          "worked": "$$\\begin{align*}5\\log_7 2-\\log_7 16 &= \\log_7(2^5)-\\log_7 16\\\\&= \\log_7\\left(\\frac{32}{16}\\right)\\\\&= \\log_7 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{2}\\log_3 4+2\\log_3 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 8$",
          "worked": "$$\\begin{align*}\\frac{1}{2}\\log_3 4+2\\log_3 2 &= \\log_3(4^{1/2})+\\log_3(2^2)\\\\&= \\log_3(2\\times4)\\\\&= \\log_3 8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_5 3-\\frac{1}{2}\\log_5 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_5 1=0$",
          "worked": "$$\\begin{align*}\\log_5 3-\\frac{1}{2}\\log_5 9 &= \\log_5 3-\\log_5(9^{1/2})\\\\&= \\log_5\\left(\\frac{3}{3}\\right)\\\\&= \\log_5 1\\\\&= 0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{1}{3}\\log_2 27-\\frac{1}{3}\\log_2 64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2\\frac{3}{4}$",
          "worked": "$$\\begin{align*}\\frac{1}{3}\\log_2 27-\\frac{1}{3}\\log_2 64 &= \\log_2(27^{1/3})-\\log_2(64^{1/3})\\\\&= \\log_2 3-\\log_2 4\\\\&= \\log_2\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{1}{4}\\log_5 16+\\frac{1}{5}\\log_5 243$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_5 6$",
          "worked": "$$\\begin{align*}\\frac{1}{4}\\log_5 16+\\frac{1}{5}\\log_5 243 &= \\log_5(16^{1/4})+\\log_5(243^{1/5})\\\\&= \\log_5 2+\\log_5 3\\\\&= \\log_5(2\\times3)\\\\&= \\log_5 6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
