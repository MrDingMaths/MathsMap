    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\cos2x+2\\sin^2x=1-2\\sin^2x+2\\sin^2x=1$",
      "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\cos2x+2\\sin^2x\\\\&=(1-2\\sin^2x)+2\\sin^2x\\\\&=1\\\\&=\\mathrm{RHS}.\\end{align*}$$",
      "solutionDiagrams": []
    },
