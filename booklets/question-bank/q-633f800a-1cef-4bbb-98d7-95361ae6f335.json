    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p76-g34-39-a",
        "type": "part",
        "label": "a",
        "prompt": "$|7-5x|\\le 8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{5}\\le x\\le 3$",
          "worked": "$$\\begin{align*}-8&\\le 7-5x\\le 8\\\\-15&\\le -5x\\le 1\\\\-\\frac{1}{5}&\\le x\\le 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p76-g34-39-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left|5-\\frac{x}{3}\\right|>2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<9$ or $x>21$",
          "worked": "$$\\begin{align*}5-\\frac{x}{3}&>2\\quad\\text{or}\\quad 5-\\frac{x}{3}<-2\\\\-\\frac{x}{3}&>-3\\quad\\text{or}\\quad -\\frac{x}{3}<-7\\\\x&<9\\quad\\text{or}\\quad x>21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p76-g34-39-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left|2-\\frac{x}{4}\\right|\\ge 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le -4$ or $x\\ge 20$",
          "worked": "$$\\begin{align*}2-\\frac{x}{4}&\\ge 3\\quad\\text{or}\\quad 2-\\frac{x}{4}\\le -3\\\\-\\frac{x}{4}&\\ge 1\\quad\\text{or}\\quad -\\frac{x}{4}\\le -5\\\\x&\\le -4\\quad\\text{or}\\quad x\\ge 20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p76-g34-39-d",
        "type": "part",
        "label": "d",
        "prompt": "$|-3x+2|<7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{5}{3}<x<3$",
          "worked": "$$\\begin{align*}-7&<-3x+2<7\\\\-9&<-3x<5\\\\-\\frac{5}{3}&<x<3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p76-g34-39-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left|-\\frac{x}{2}+1\\right|\\ge 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le -4$ or $x\\ge 8$",
          "worked": "$$\\begin{align*}-\\frac{x}{2}+1&\\ge 3\\quad\\text{or}\\quad -\\frac{x}{2}+1\\le -3\\\\-\\frac{x}{2}&\\ge 2\\quad\\text{or}\\quad -\\frac{x}{2}\\le -4\\\\x&\\le -4\\quad\\text{or}\\quad x\\ge 8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p76-g34-39-f",
        "type": "part",
        "label": "f",
        "prompt": "$|1-2x|\\le \\frac{5}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3}{4}\\le x\\le \\frac{7}{4}$",
          "worked": "$$\\begin{align*}-\\frac{5}{2}&\\le 1-2x\\le \\frac{5}{2}\\\\-\\frac{7}{2}&\\le -2x\\le \\frac{3}{2}\\\\-\\frac{3}{4}&\\le x\\le \\frac{7}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
