  "content": {
    "id": "p53-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Consider $y=\\dfrac{5+2x}{5-2x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q9-methods",
        "type": "group",
        "label": "",
        "prompt": "",
