        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p53-q9-a",
            "type": "part",
            "label": "a",
            "prompt": "Using the quotient rule.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y'=\\dfrac{20}{(5-2x)^2}$",
              "worked": "$$\\begin{align*}y'&=\\frac{2(5-2x)-(5+2x)(-2)}{(5-2x)^2}\\\\&=\\frac{10-4x+10+4x}{(5-2x)^2}\\\\&=\\frac{20}{(5-2x)^2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p53-q9-b",
            "type": "part",
            "label": "b",
            "prompt": "Using the product rule by considering the function as $y=(5+2x)(5-2x)^{-1}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y'=\\dfrac{20}{(5-2x)^2}$",
              "worked": "$$\\begin{align*}y'&=2(5-2x)^{-1}\\\\&\\quad +(5+2x)(-1)(5-2x)^{-2}(-2)\\\\&=\\frac{2}{5-2x}+\\frac{2(5+2x)}{(5-2x)^2}\\\\&=\\frac{2(5-2x)+2(5+2x)}{(5-2x)^2}\\\\&=\\frac{20}{(5-2x)^2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 43
          }
        ]
      },
      {
        "id": "p53-q9-c",
        "type": "part",
