          "inlines": [
            {
              "type": "text",
              "text": "The following trick is sometimes useful in some calculations involving percentages:",
              "marks": []
            }
          ]
        },
        {
          "id": "p5-q10-demonstration-equation",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "84\\%\\text{ of }25=25\\%\\text{ of }84=21",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain how the trick works.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Multiplication is commutative: $p\\%$ of $q$ and $q\\%$ of $p$ both equal $\\frac{pq}{100}$.",
          "worked": "Multiplication is commutative, so $pq=qp$.\n$$\\begin{align*}p\\%\\text{ of }q&=\\frac{p}{100}\\times q\\\\p\\%\\text{ of }q&=\\frac{pq}{100}\\\\p\\%\\text{ of }q&=\\frac{qp}{100}\\\\p\\%\\text{ of }q&=\\frac{q}{100}\\times p\\\\p\\%\\text{ of }q&=q\\%\\text{ of }p\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p5-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "Use the trick to evaluate each of the following, without the use of a calculator:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p5-q10-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$24\\%$ of $25$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6$",
              "worked": "$$\\begin{align*}24\\%\\text{ of }25&=25\\%\\text{ of }24\\\\24\\%\\text{ of }25&=\\frac14\\times24\\\\24\\%\\text{ of }25&=6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p5-q10-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$65\\%$ of $20$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$13$",
              "worked": "$$\\begin{align*}65\\%\\text{ of }20&=20\\%\\text{ of }65\\\\65\\%\\text{ of }20&=\\frac15\\times65\\\\65\\%\\text{ of }20&=13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p5-q10-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$32\\%$ of $75$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$24$",
              "worked": "$$\\begin{align*}32\\%\\text{ of }75&=75\\%\\text{ of }32\\\\32\\%\\text{ of }75&=\\frac34\\times32\\\\32\\%\\text{ of }75&=24\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p5-q10-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$64\\%$ of $25$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$16$",
              "worked": "$$\\begin{align*}64\\%\\text{ of }25&=25\\%\\text{ of }64\\\\64\\%\\text{ of }25&=\\frac14\\times64\\\\64\\%\\text{ of }25&=16\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p5-q10-b-v",
            "type": "part",
            "label": "v",
            "prompt": "$16\\%$ of $75$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12$",
              "worked": "$$\\begin{align*}16\\%\\text{ of }75&=75\\%\\text{ of }16\\\\16\\%\\text{ of }75&=\\frac34\\times16\\\\16\\%\\text{ of }75&=12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p5-q10-b-vi",
            "type": "part",
            "label": "vi",
            "prompt": "$8\\%$ of $40$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3.2$",
              "worked": "$$\\begin{align*}8\\%\\text{ of }40&=40\\%\\text{ of }8\\\\8\\%\\text{ of }40&=\\frac25\\times8\\\\8\\%\\text{ of }40&=3.2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p5-q10-b-vii",
            "type": "part",
            "label": "vii",
            "prompt": "$12\\%$ of $75$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9$",
              "worked": "$$\\begin{align*}12\\%\\text{ of }75&=75\\%\\text{ of }12\\\\12\\%\\text{ of }75&=\\frac34\\times12\\\\12\\%\\text{ of }75&=9\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p5-q10-b-viii",
            "type": "part",
            "label": "viii",
            "prompt": "$22\\%$ of $150$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$33$",
              "worked": "$$\\begin{align*}22\\%\\text{ of }150&=150\\%\\text{ of }22\\\\22\\%\\text{ of }150&=\\frac32\\times22\\\\22\\%\\text{ of }150&=33\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      }
