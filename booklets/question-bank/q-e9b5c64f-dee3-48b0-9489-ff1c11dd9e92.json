  "content": {
    "id": "v2-nr-p44-s1-slot-19-root",
    "type": "question",
    "label": null,
    "prompt": "A shade sail is attached to three posts $P$, $Q$ and $R$ on level ground.\nThe length of $PQ$ is $9\\text{ m}$, $\\angle QPR$ is $41^\\circ$ and $\\angle PQR$ is $74^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "v2-nr-p44-s1-slot-19-slot-19-q-diagram",
        "role": "question",
        "format": "tikz",
        "code": "\\begin{tikzpicture}[every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\usetikzlibrary{angles,quotes}\n\\coordinate (P) at (0,0);\n\\coordinate (Q) at (4.5,0);\n\\coordinate (R) at (3.6,3.13);\n\\draw[line width=0.8pt] (P)--(Q) node[midway,below] {$9\\mathrm{m}$};\n\\draw[line width=0.8pt] (P)--(R);\n\\draw[line width=0.8pt] (Q)--(R);\n\\node[left] at (P) {$P$};\n\\node[right] at (Q) {$Q$};\n\\node[above] at (R) {$R$};\n\\pic[draw,line width=0.4pt,\"$41^\\circ$\",angle radius=8mm,angle eccentricity=1.6] {angle=Q--P--R};\n\\pic[draw,line width=0.4pt,\"$74^\\circ$\",angle radius=7mm,angle eccentricity=1.6] {angle=R--Q--P};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 60,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": false
      }
    ],
    "children": [
      {
        "id": "v2-nr-p44-s1-slot-19-slot-19-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the size of $\\angle PRQ$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$65^\\circ$",
          "worked": "$$\\begin{align*}\\angle PRQ&=180^\\circ-41^\\circ-74^\\circ\\\\&=65^\\circ\\end{align*}$$\nAngles in a triangle sum to $180^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-nr-p44-s1-slot-19-slot-19-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the length of $QR$. Answer correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.5\\text{ m}$",
          "worked": "$$\\begin{align*}\\frac{QR}{\\sin41^\\circ}&=\\frac{9}{\\sin65^\\circ}\\\\QR&=\\frac{9\\sin41^\\circ}{\\sin65^\\circ}\\\\QR&\\approx6.5\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
