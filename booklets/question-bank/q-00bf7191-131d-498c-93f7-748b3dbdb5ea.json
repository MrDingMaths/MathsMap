    "label": "39",
    "prompt": "Rationalise the denominator. $\\dfrac{6}{\\sqrt{6}}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt{6}$",
      "worked": "$$\\begin{align*}\\frac{6}{\\sqrt{6}}&=\\frac{6}{\\sqrt{6}}\\times\\frac{\\sqrt{6}}{\\sqrt{6}}\\\\\\frac{6}{\\sqrt{6}}&=\\frac{6\\sqrt{6}}{6}\\\\\\frac{6}{\\sqrt{6}}&=\\sqrt{6}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
