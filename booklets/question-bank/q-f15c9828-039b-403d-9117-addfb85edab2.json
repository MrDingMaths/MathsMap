      {
        "id": "p13-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(x^{\\frac12}+x^{-\\frac12}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2+x^{-1}$",
          "worked": "$$\\begin{align*}\\left(x^{\\frac12}+x^{-\\frac12}\\right)^2&=x^{2\\times\\frac12}+2x^{\\frac12-\\frac12}+x^{2\\times(-\\frac12)}\\\\\\left(x^{\\frac12}+x^{-\\frac12}\\right)^2&=x+2x^0+x^{-1}\\\\\\left(x^{\\frac12}+x^{-\\frac12}\\right)^2&=x+2+x^{-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(x^{\\frac12}-x^{-\\frac12}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2+x^{-1}$",
          "worked": "$$\\begin{align*}\\left(x^{\\frac12}-x^{-\\frac12}\\right)^2&=x^{2\\times\\frac12}-2x^{\\frac12-\\frac12}+x^{2\\times(-\\frac12)}\\\\\\left(x^{\\frac12}-x^{-\\frac12}\\right)^2&=x-2x^0+x^{-1}\\\\\\left(x^{\\frac12}-x^{-\\frac12}\\right)^2&=x-2+x^{-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(x^{\\frac52}-x^{-\\frac52}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5-2+x^{-5}$",
          "worked": "$$\\begin{align*}\\left(x^{\\frac52}-x^{-\\frac52}\\right)^2&=x^{2\\times\\frac52}-2x^{\\frac52-\\frac52}+x^{2\\times(-\\frac52)}\\\\\\left(x^{\\frac52}-x^{-\\frac52}\\right)^2&=x^5-2x^0+x^{-5}\\\\\\left(x^{\\frac52}-x^{-\\frac52}\\right)^2&=x^5-2+x^{-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
