  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the value of $a$ when the distance between:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1,a)$ and $(3,5)$ is $\\sqrt{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3$ or $7$.",
          "worked": "$$\\begin{align*}\\sqrt{(3-1)^2+(5-a)^2}&=\\sqrt{8}\\\\4+(5-a)^2&=8\\\\(5-a)^2&=4\\\\5-a&=\\pm2\\\\a&=3\\text{ or }7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$(a,-1)$ and $(4,-3)$ is $\\sqrt{29}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-1$ or $9$.",
          "worked": "$$\\begin{align*}\\sqrt{(4-a)^2+(-3-(-1))^2}&=\\sqrt{29}\\\\(4-a)^2+4&=29\\\\(4-a)^2&=25\\\\4-a&=\\pm5\\\\a&=-1\\text{ or }9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
