    "children": [
      {
        "id": "p45-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{9}+\\sqrt{16}\\times\\sqrt{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23$",
          "worked": "$$\\begin{align*}\\sqrt{9}+\\sqrt{16}\\times\\sqrt{25}&=3+4\\times5\\\\&=3+20\\\\&=23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p45-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt{9}+\\sqrt{16})\\times\\sqrt{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$",
          "worked": "$$\\begin{align*}(\\sqrt{9}+\\sqrt{16})\\times\\sqrt{25}&=(3+4)\\times5\\\\&=7\\times5\\\\&=35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p45-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\sqrt{9}+\\sqrt{16})^{2}\\times\\sqrt{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$245$",
          "worked": "$$\\begin{align*}(\\sqrt{9}+\\sqrt{16})^{2}\\times\\sqrt{25}&=(3+4)^{2}\\times5\\\\&=7^{2}\\times5\\\\&=49\\times5\\\\&=245\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p45-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$2(\\sqrt{9}+\\sqrt{16})^{2}\\times\\sqrt{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$490$",
          "worked": "$$\\begin{align*}2(\\sqrt{9}+\\sqrt{16})^{2}\\times\\sqrt{25}&=2(3+4)^{2}\\times5\\\\&=2\\times7^{2}\\times5\\\\&=2\\times49\\times5\\\\&=98\\times5\\\\&=490\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
