    "answer": {
      "short": "$\\dfrac35$",
      "worked": "$$\\begin{align*}P(A\\cap B)&=P(A\\mid B)P(B)\\\\P(A\\cap B)&=0.5\\times0.6=0.3\\\\P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=0.3+0.6-0.3\\\\P(A\\cup B)&=\\frac35\\end{align*}$$",
      "solutionDiagrams": []
    },
