    "children": [
      {
        "id": "p22-q19-21-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos80^\\circ\\cos20^\\circ+\\sin80^\\circ\\sin20^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$$\\begin{align*}\\cos80^\\circ\\cos20^\\circ+\\sin80^\\circ\\sin20^\\circ&=\\cos(80^\\circ-20^\\circ)\\\\\\cos80^\\circ\\cos20^\\circ+\\sin80^\\circ\\sin20^\\circ&=\\cos60^\\circ=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q19-21-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin85^\\circ\\cos35^\\circ+\\cos85^\\circ\\sin35^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\sin85^\\circ\\cos35^\\circ+\\cos85^\\circ\\sin35^\\circ&=\\sin(85^\\circ+35^\\circ)\\\\\\sin85^\\circ\\cos35^\\circ+\\cos85^\\circ\\sin35^\\circ&=\\sin120^\\circ=\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q19-21-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\tan10^\\circ+\\tan35^\\circ}{1-\\tan10^\\circ\\tan35^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{\\tan10^\\circ+\\tan35^\\circ}{1-\\tan10^\\circ\\tan35^\\circ}&=\\tan(10^\\circ+35^\\circ)\\\\\\frac{\\tan10^\\circ+\\tan35^\\circ}{1-\\tan10^\\circ\\tan35^\\circ}&=\\tan45^\\circ=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
