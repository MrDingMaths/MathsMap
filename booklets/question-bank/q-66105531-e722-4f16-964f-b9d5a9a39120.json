  "content": {
    "id": "p15-q8",
    "type": "question",
    "label": "8",
    "prompt": "A quadrilateral, $ABCD$, has vertices $A(2,7)$, $B(4,9)$, $C(8,5)$ and $D(6,3)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q8-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the gradient of:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q8-a-a",
            "type": "part",
            "label": "i",
            "prompt": "$AB$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{aligned}m_{AB}&=\\frac{9-7}{4-2}\\\\&=1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p15-q8-a-b",
            "type": "part",
            "label": "ii",
            "prompt": "$BC$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1$",
              "worked": "$$\\begin{aligned}m_{BC}&=\\frac{5-9}{8-4}\\\\&=-1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p15-q8-a-c",
            "type": "part",
            "label": "iii",
            "prompt": "$CD$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{aligned}m_{CD}&=\\frac{3-5}{6-8}\\\\&=1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p15-q8-a-d",
            "type": "part",
            "label": "iv",
            "prompt": "$DA$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1$",
              "worked": "$$\\begin{aligned}m_{DA}&=\\frac{7-3}{2-6}\\\\&=-1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p15-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "What type of quadrilateral is $ABCD$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rectangle.",
          "worked": "$ABCD$ is a rectangle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Opposite sides are parallel and adjacent sides are perpendicular.",
          "worked": "$m_{AB}=m_{CD}=1$ and $m_{BC}=m_{DA}=-1$, so both pairs of opposite sides are parallel.\n\n$$m_{AB}\\times m_{BC}=1\\times(-1)=-1$$\n\nAdjacent sides are perpendicular, so $ABCD$ is a rectangle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
