        "children": [],
        "answer": {
          "short": "$\\frac{2}{x^{21}}$",
          "worked": "$$\\begin{aligned}2(x^{-7})^3&=2x^{-21}\\\\&=\\frac{2}{x^{21}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$4(d^{-2})^3$",
