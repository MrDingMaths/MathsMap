  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify these expressions. Write using positive indices.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{-2}\\times x^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{x^5}$",
          "worked": "$$\\begin{aligned}x^{-2}\\times x^{-3}&=x^{-2-3}\\\\&=x^{-5}\\\\&=\\frac{1}{x^5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$k^5\\div k^{-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k^{11}$",
          "worked": "$$\\begin{aligned}k^5\\div k^{-6}&=k^{5-(-6)}\\\\&=k^{11}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(y^{-3})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{y^6}$",
          "worked": "$$\\begin{aligned}(y^{-3})^2&=y^{-3\\times2}\\\\&=y^{-6}\\\\&=\\frac{1}{y^6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$a^5\\div a^7\\times a^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a^6}$",
          "worked": "$$\\begin{aligned}a^5\\div a^7\\times a^{-4}&=a^{5-7-4}\\\\&=a^{-6}\\\\&=\\frac{1}{a^6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$xy^3\\times x^2y^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3y$",
          "worked": "$$\\begin{aligned}xy^3\\times x^2y^{-2}&=x^{1+2}y^{3-2}\\\\&=x^3y\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{h^{10}\\times(h^{-3})^5}{h^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{h^7}$",
          "worked": "$$\\begin{aligned}\\frac{h^{10}\\times(h^{-3})^5}{h^2}&=\\frac{h^{10}\\times h^{-15}}{h^2}\\\\&=h^{10-15-2}\\\\&=h^{-7}\\\\&=\\frac{1}{h^7}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$5y^{-2}\\times4xy^6\\div2xy^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10y^7$",
          "worked": "$$\\begin{aligned}5y^{-2}\\times4xy^6\\div2xy^{-3}&=\\frac{20xy^4}{2xy^{-3}}\\\\&=10y^{4-(-3)}\\\\&=10y^7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p12-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$(6x^{-4})^2\\div4x^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{x^5}$",
          "worked": "$$\\begin{aligned}(6x^{-4})^2\\div4x^{-3}&=36x^{-8}\\div4x^{-3}\\\\&=9x^{-8-(-3)}\\\\&=9x^{-5}\\\\&=\\frac{9}{x^5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(\\frac{2x^2}{x^3}\\right)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{16}{x^4}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{2x^2}{x^3}\\right)^4&=(2x^{-1})^4\\\\&=16x^{-4}\\\\&=\\frac{16}{x^4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\left(\\frac{m^3}{4m^5}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{64m^6}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{m^3}{4m^5}\\right)^3&=\\left(\\frac{m^{-2}}4\\right)^3\\\\&=\\frac{m^{-6}}{64}\\\\&=\\frac{1}{64m^6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$2(x^{-7})^3$",
