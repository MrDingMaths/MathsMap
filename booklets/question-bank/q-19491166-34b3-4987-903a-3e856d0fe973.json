              {
                "id": "p15-q5-a-short-cases",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "P(X=x)=\\begin{cases}\\frac{3}{4}&x=1\\\\\\frac{1}{4}&x=0.\\end{cases}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "worked": "Let $X=1$ for a head and $X=0$ for a tail. The probability of a tail is $1-\\frac{3}{4}=\\frac{1}{4}$.\n\n$$P(X=x)=\\begin{cases}\\frac{3}{4}&x=1\\\\\\frac{1}{4}&x=0.\\end{cases}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p15-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "For the distribution, find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q5-b-i",
            "type": "part",
            "label": "i",
            "prompt": "the mean",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$E(X)=\\frac{3}{4}$",
              "worked": "$$E(X)=p=\\frac{3}{4}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 11
          },
          {
            "id": "p15-q5-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the variance",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\operatorname{Var}(X)=\\frac{3}{16}$",
              "worked": "$$\\begin{aligned}\\operatorname{Var}(X)&=p(1-p)\\\\\\operatorname{Var}(X)&=\\frac{3}{4}\\left(\\frac{1}{4}\\right)\\\\\\operatorname{Var}(X)&=\\frac{3}{16}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      }
