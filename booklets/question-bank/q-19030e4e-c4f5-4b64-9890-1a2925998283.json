  "content": {
    "id": "p59-q20-content",
    "type": "question",
    "label": "20",
    "prompt": "Ed thinks of a number. He takes away four lots of this number from itself. He is left with $-36$.\n\nWhat was Ed’s original number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12$",
      "worked": "One lot minus four lots leaves $-3$ lots of the number.\n\n$$-36\\div(-3)=12$$\n\nCheck:\n\n$$\\begin{align*}12-4\\times12&=12-48\\\\&=-36\\end{align*}$$\n\nEd’s original number was $12$.",
      "solutionDiagrams": []
    },
