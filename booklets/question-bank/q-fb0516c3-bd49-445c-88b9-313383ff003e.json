        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\,000\\text{ m}^2$",
          "worked": "$$\\begin{align*}1.5\\text{ ha}&=1.5\\times10\\,000\\text{ m}^2\\\\&=15\\,000\\text{ m}^2\\end{align*}$$",
