  "content": {
    "id": "p32-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^{1/2}x^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{24}$",
          "worked": "$$\\begin{aligned}\\int_0^{1/2}x^2\\,dx&=\\left[\\frac{x^3}{3}\\right]_0^{1/2}\\\\&=\\frac{(\\frac12)^3}{3}-\\frac{0^3}{3}\\\\&=\\frac{1}{24}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p32-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^{2/3}(2x+3x^2)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{20}{27}$",
          "worked": "$$\\begin{aligned}\\int_0^{2/3}(2x+3x^2)\\,dx&=\\left[x^2+x^3\\right]_0^{2/3}\\\\&=\\left[\\left(\\frac23\\right)^2+\\left(\\frac23\\right)^3\\right]-(0^2+0^3)\\\\&=\\frac49+\\frac8{27}\\\\&=\\frac{20}{27}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p32-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{1/2}^{3/4}(6-4x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac78$",
          "worked": "$$\\begin{aligned}\\int_{1/2}^{3/4}(6-4x)\\,dx&=\\left[6x-2x^2\\right]_{1/2}^{3/4}\\\\&=\\left[6\\left(\\frac34\\right)-2\\left(\\frac34\\right)^2\\right]-\\left[6\\left(\\frac12\\right)-2\\left(\\frac12\\right)^2\\right]\\\\&=\\frac{27}{8}-\\frac52\\\\&=\\frac78\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
