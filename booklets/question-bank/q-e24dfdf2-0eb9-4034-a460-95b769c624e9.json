  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The circulation of a newspaper on 1 January 2008 was $840\\,000$. On 1 January 2009, the circulation was $640\\,000$. Find the percentage decrease in circulation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$23\\frac{17}{21}\\%$ decrease",
      "worked": "$$\\begin{align*}\\text{Decrease in circulation}&=840\\,000-640\\,000\\\\\\text{Decrease in circulation}&=200\\,000\\end{align*}$$\n\n$$\\begin{align*}\\text{Percentage decrease}&=\\frac{200\\,000}{840\\,000}\\times100\\%\\\\\\text{Percentage decrease}&=\\frac{500}{21}\\%\\\\\\text{Percentage decrease}&=23\\frac{17}{21}\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
