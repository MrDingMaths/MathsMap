    "children": [
      {
        "id": "p14-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Suppose that $P(V\\cup W)=0.7$ and $P(V)=0.5$ and $P(W)=0.35$. Find $P(V\\mid W)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{7}$",
          "worked": "$$\\begin{aligned}P(V\\cup W)&=P(V)+P(W)-P(V\\cap W)\\\\0.7&=0.5+0.35-P(V\\cap W)\\\\P(V\\cap W)&=0.85-0.7=0.15\\\\P(V\\mid W)&=\\frac{P(V\\cap W)}{P(W)}=\\frac{0.15}{0.35}=\\frac{3}{7}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $P(X\\mid Y)$ if $P(X\\cap Y)=0.2$ and $P(X)=0.3$ and $P(Y)=0.4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$P(X\\mid Y)=\\frac{P(X\\cap Y)}{P(Y)}=\\frac{0.2}{0.4}=\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p14-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $P(A\\mid B)$ if $P(A\\cup B)=\\dfrac{1}{3}$ and $P(A)=\\dfrac{1}{5}$ and $P(B)=\\dfrac{3}{10}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{9}$",
          "worked": "$$\\begin{aligned}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\\\frac{1}{3}&=\\frac{1}{5}+\\frac{3}{10}-P(A\\cap B)\\\\P(A\\cap B)&=\\frac{1}{5}+\\frac{3}{10}-\\frac{1}{3}=\\frac{1}{6}\\\\P(A\\mid B)&=\\frac{P(A\\cap B)}{P(B)}=\\frac{\\frac{1}{6}}{\\frac{3}{10}}=\\frac{5}{9}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
