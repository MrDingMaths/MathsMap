    "children": [
      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "If $\\tan\\alpha=\\frac12$, $\\tan\\beta=\\frac13$, find $\\tan(\\alpha+\\beta)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\tan(\\alpha+\\beta)&=\\frac{\\tan\\alpha+\\tan\\beta}{1-\\tan\\alpha\\tan\\beta}\\\\&=\\frac{\\frac12+\\frac13}{1-\\left(\\frac12\\right)\\left(\\frac13\\right)}\\\\&=\\frac{\\frac56}{1-\\frac16}\\\\&=\\frac{\\frac56}{\\frac56}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\cos A=\\frac45$, $\\sin B=\\frac{12}{13}$, where $A,B$ are acute, find $\\sin(A+B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{63}{65}$",
          "worked": "Since $A$ and $B$ are acute,\n$$\\begin{aligned}\\sin A&=\\sqrt{1-\\left(\\frac45\\right)^2}=\\frac35,\\\\\\cos B&=\\sqrt{1-\\left(\\frac{12}{13}\\right)^2}=\\frac5{13}.\\end{aligned}$$\n$$\\begin{aligned}\\sin(A+B)&=\\sin A\\cos B+\\cos A\\sin B\\\\&=\\left(\\frac35\\right)\\left(\\frac5{13}\\right)+\\left(\\frac45\\right)\\left(\\frac{12}{13}\\right)\\\\&=\\frac{15}{65}+\\frac{48}{65}\\\\&=\\frac{63}{65}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "If $\\sin\\theta=\\frac23$, $\\cos\\phi=\\frac14$, where $\\theta,\\phi$ are acute, find $\\cos(\\theta-\\phi)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt5+2\\sqrt{15}}{12}$",
          "worked": "Since $\\theta$ and $\\phi$ are acute,\n$$\\begin{aligned}\\cos\\theta&=\\sqrt{1-\\left(\\frac23\\right)^2}=\\frac{\\sqrt5}{3},\\\\\\sin\\phi&=\\sqrt{1-\\left(\\frac14\\right)^2}=\\frac{\\sqrt{15}}4.\\end{aligned}$$\n$$\\begin{aligned}\\cos(\\theta-\\phi)&=\\cos\\theta\\cos\\phi+\\sin\\theta\\sin\\phi\\\\&=\\left(\\frac{\\sqrt5}3\\right)\\left(\\frac14\\right)+\\left(\\frac23\\right)\\left(\\frac{\\sqrt{15}}4\\right)\\\\&=\\frac{\\sqrt5}{12}+\\frac{2\\sqrt{15}}{12}\\\\&=\\frac{\\sqrt5+2\\sqrt{15}}{12}\\\\&=\\frac{\\sqrt5(1+2\\sqrt3)}{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
