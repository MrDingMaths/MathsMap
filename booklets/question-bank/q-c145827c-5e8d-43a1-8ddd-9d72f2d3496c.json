        "type": "part",
        "label": "a",
        "prompt": "If a cube has volume $64\\text{ cm}^3$, find its side length.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\text{ cm}$",
          "worked": "Let $s$ be the side length in centimetres.\n$$\\begin{align*}s^3&=64\\\\s&=\\sqrt[3]{64}\\\\s&=4.\\end{align*}$$\nThe side length is $4\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "If a cube has volume $400\\text{ cm}^3$, find its side length, correct to one decimal place.",
        "layout": "list",
        "columns": null,
