  "content": {
    "id": "p4-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "On a maths test paper, there are $x$ questions. Before the test starts, it is announced that the last two questions are wrong and should be ignored.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "How many questions must the students complete now?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2$ questions.",
          "worked": "Number of questions to complete $=x-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p4-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "The students are given an hour to do the test. How many minutes should they spend on each question, on average?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{60}{x-2}$ minutes.",
          "worked": "One hour is $60$ minutes.\n$$\\begin{align*}\\text{Average minutes per question}&=60\\div(x-2)\\\\\\text{Average minutes per question}&=\\frac{60}{x-2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
