    "id": "p63-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find the exact value of $\\dfrac1{2\\sin10^\\circ}-\\dfrac{\\sqrt3}{2\\cos10^\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2$.\n\nCombine the fractions and use $\\sin(30^\\circ-10^\\circ)=\\sin20^\\circ$.",
      "worked": "$$\\begin{align*}\\frac1{2\\sin10^\\circ}-\\frac{\\sqrt3}{2\\cos10^\\circ}&=\\frac{\\sin30^\\circ}{\\sin10^\\circ}-\\frac{\\cos30^\\circ}{\\cos10^\\circ}\\\\\\frac1{2\\sin10^\\circ}-\\frac{\\sqrt3}{2\\cos10^\\circ}&=\\frac{\\sin30^\\circ\\cos10^\\circ-\\cos30^\\circ\\sin10^\\circ}{\\sin10^\\circ\\cos10^\\circ}\\\\\\frac1{2\\sin10^\\circ}-\\frac{\\sqrt3}{2\\cos10^\\circ}&=\\frac{\\sin20^\\circ}{\\sin10^\\circ\\cos10^\\circ}\\\\\\frac1{2\\sin10^\\circ}-\\frac{\\sqrt3}{2\\cos10^\\circ}&=\\frac{2\\sin10^\\circ\\cos10^\\circ}{\\sin10^\\circ\\cos10^\\circ}\\\\\\frac1{2\\sin10^\\circ}-\\frac{\\sqrt3}{2\\cos10^\\circ}&=2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
