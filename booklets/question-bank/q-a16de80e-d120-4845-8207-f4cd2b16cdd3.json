  "content": {
    "id": "v2-939c3-p18-practice-j5-223210-root",
    "type": "question",
    "label": null,
    "prompt": "The mass $m$ of a steel rod, in kilograms, is directly proportional to its length $l$, in metres. A rod of length 2.5 m has a mass of 9 kg. Find the mass of a rod of length 4 m.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "14.4 kg",
      "worked": "$$\\begin{align*}m&=kl\\\\9&=k\\times2.5\\\\k&=\\frac{9}{2.5}=3.6\\\\m&=3.6l\\\\m&=3.6\\times4\\\\m&=14.4\\end{align*}$$\nThe rod has a mass of 14.4 kg.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
