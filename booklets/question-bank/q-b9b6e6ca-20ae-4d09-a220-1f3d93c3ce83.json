    "type": "question",
    "label": "8",
    "prompt": "True or False? Let $x,y\\geq0$. The conjugate of $\\sqrt{5}+1$ is $\\sqrt{5}-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "False. Its conjugate is $-\\sqrt{5}+1$.",
      "worked": "The rational term $1$ stays unchanged and the surd term $\\sqrt{5}$ changes sign. The conjugate is $-\\sqrt{5}+1$, not $\\sqrt{5}-1$.",
