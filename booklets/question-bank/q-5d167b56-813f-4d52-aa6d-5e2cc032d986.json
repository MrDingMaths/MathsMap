  "content": {
    "id": "p8-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "If you add 13 to a number, you get the same result as when you subtract half the number from 4. What is the number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-6$",
      "worked": "Let $x$ be the number.\n\n$$\\begin{align*}x+13&=4-\\frac{x}{2}\\\\\\frac{3x}{2}+13&=4\\\\\\frac{3x}{2}&=-9\\\\x&=-6\\end{align*}$$\n\nCheck: $-6+13=7$ and $4-\\frac{-6}{2}=7$. The number is $-6$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
