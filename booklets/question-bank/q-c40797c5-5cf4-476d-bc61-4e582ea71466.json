  "content": {
    "id": "p9-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider the sample space $\\Omega=\\{1,2,3,4,5,6\\}$. Let $A=\\{2,3,4\\}$ and $B=\\{3,4,5\\}$. Illustrate sets $A$ and $B$ on a Venn diagram with sample space $\\Omega$ and then determine each of the following sets:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q1-construction",
        "type": "part",
        "label": "",
        "prompt": "Venn diagram",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A$ only: $\\{2\\}$; $A\\cap B$: $\\{3,4\\}$; $B$ only: $\\{5\\}$; outside both: $\\{1,6\\}$.",
          "worked": "Place $3$ and $4$ in the overlap, $2$ in $A$ only, and $5$ in $B$ only. Place $1$ and $6$ inside the sample-space rectangle but outside both circles.",
