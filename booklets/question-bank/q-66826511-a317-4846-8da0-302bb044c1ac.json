  "content": {
    "id": "p53-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "If $\\overrightarrow{OX}=\\begin{pmatrix}2\\\\5\\end{pmatrix}$ and $\\overrightarrow{OY}=\\begin{pmatrix}-4\\\\3\\end{pmatrix}$, find the resultant vector for:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{OX}+\\overrightarrow{OY}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}-2\\\\8\\end{pmatrix}$",
          "worked": "$\\begin{aligned}\\overrightarrow{OX}+\\overrightarrow{OY}&=\\begin{pmatrix}2\\\\5\\end{pmatrix}+\\begin{pmatrix}-4\\\\3\\end{pmatrix}\\\\&=\\begin{pmatrix}2-4\\\\5+3\\end{pmatrix}\\\\&=\\begin{pmatrix}-2\\\\8\\end{pmatrix}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p53-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{OY}-\\overrightarrow{OX}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}-6\\\\-2\\end{pmatrix}$",
          "worked": "$\\begin{aligned}\\overrightarrow{OY}-\\overrightarrow{OX}&=\\begin{pmatrix}-4\\\\3\\end{pmatrix}-\\begin{pmatrix}2\\\\5\\end{pmatrix}\\\\&=\\begin{pmatrix}-4-2\\\\3-5\\end{pmatrix}\\\\&=\\begin{pmatrix}-6\\\\-2\\end{pmatrix}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
