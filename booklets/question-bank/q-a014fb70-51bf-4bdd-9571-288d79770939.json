    "id": "v2-aed72-p42-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Give the exact value of $\\displaystyle\\int_1^2(5^x-2x)\\,dx$, then evaluate it correct to four decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{20}{\\ln 5}-3\\approx 9.4267$",
      "worked": "$$\\begin{align*}\\int_1^2(5^x-2x)\\,dx&=\\left[\\frac{5^x}{\\ln 5}-x^2\\right]_1^2\\\\&=\\frac{25}{\\ln 5}-4-\\left(\\frac{5}{\\ln 5}-1\\right)\\\\&=\\frac{20}{\\ln 5}-3\\\\&\\approx 9.4267\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
