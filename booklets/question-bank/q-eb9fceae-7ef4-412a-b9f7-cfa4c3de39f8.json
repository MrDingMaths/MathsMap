  "content": {
    "id": "p32-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "In a triangle, $ABC$, $a=5$, $b=6$ and $\\cos C=\\frac{1}{5}$. Find $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c=7$",
      "worked": "By the cosine rule:\n$$\\begin{align*}c^2&=a^2+b^2-2ab\\cos C\\\\c^2&=5^2+6^2-2\\times5\\times6\\times\\frac{1}{5}\\\\c^2&=49\\\\c&=7\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
