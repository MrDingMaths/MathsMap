  "content": {
    "id": "p50-q27-response",
    "type": "question",
    "label": "27",
    "prompt": "Four years ago Emily was twice Ally’s age. In four years’ time, Emily will be one and a quarter times Ally’s age. How old are Emily and Ally now?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Emily is $9\\frac{1}{3}$ years old and Ally is $6\\frac{2}{3}$ years old.",
      "worked": "Let $x$ be Emily’s current age and $y$ Ally’s current age, in years.\n$$\\begin{align*}x-4&=2(y-4)\\\\x+4&=\\frac{5}{4}(y+4)\\end{align*}$$\nSimplifying:\n$$\\begin{align*}x-2y&=-4 &&(1)\\\\4x-5y&=4 &&(2)\\end{align*}$$\nEquation $(2)-4\\times(1)$:\n$$\\begin{align*}3y&=20\\\\y&=\\frac{20}{3}\\end{align*}$$\nSubstitute into $(1)$:\n$$\\begin{align*}x-2\\left(\\frac{20}{3}\\right)&=-4\\\\x&=\\frac{28}{3}\\end{align*}$$\nEmily is $9\\frac{1}{3}$ years old and Ally is $6\\frac{2}{3}$ years old.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 80
  },
