              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Sometimes the quadratic has a repeated factor, as in ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y=a(x-\\alpha)^2",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ". In this case, the only solution when ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y=0",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " is ",
