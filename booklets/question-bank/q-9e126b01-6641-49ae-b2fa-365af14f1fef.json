                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha$, $\\beta$",
          "worked": "Set $y=0$. Since $a\\ne0$, the null factor law gives $x-\\alpha=0$ or $x-\\beta=0$. So $x=\\alpha$ or $x=\\beta$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
