              "inlines": [
                {
                  "type": "text",
                  "text": "If a quadratic is expressed in factorised form ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y=a(x-\\alpha)(x-\\beta)",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", then the solutions when ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y=0",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " are ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "x=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$\\alpha$",
                  "width": 9
