                },
                {
                  "type": "math",
                  "latex": "x=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$\\alpha$",
                  "width": 9
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha$",
          "worked": "Set $y=0$ and divide by $a\\ne0$. The square is zero only when its repeated factor is zero.\n\n$$\\begin{align*}x-\\alpha&=0\\\\x&=\\alpha\\end{align*}$$",
          "solutionDiagrams": []
        },
