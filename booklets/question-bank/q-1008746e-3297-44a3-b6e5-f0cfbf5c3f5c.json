  "content": {
    "id": "p25-q12-root",
    "type": "question",
    "label": null,
    "prompt": "A bag contains two blue and three red marbles. A marble is taken from the bag and its colour is noted. Without returning the marble, a second marble is chosen. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "both marbles are red.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "$$\\begin{align*}\\Pr(\\text{both red})&=\\frac35\\times\\frac24\\\\\\Pr(\\text{both red})&=\\frac{3}{10}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p25-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "both marbles are blue.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "$$\\begin{align*}\\Pr(\\text{both blue})&=\\frac25\\times\\frac14\\\\\\Pr(\\text{both blue})&=\\frac{1}{10}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p25-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "both marbles are blue given that they both have the same colour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p25-q12-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac14",
                    "display": false
                  }
                ]
              },
              {
                "id": "p25-q12-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Divide the probability of two blue marbles by the probability of two marbles of the same colour.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The marbles have the same colour if both are red or both are blue. These events are mutually exclusive.\n\n$$\\begin{align*}\\Pr(\\text{same colour})&=\\frac{3}{10}+\\frac{1}{10}\\\\\\Pr(\\text{same colour})&=\\frac25.\\end{align*}$$\n\n$$\\begin{align*}\\Pr(\\text{both blue}\\mid\\text{same colour})&=\\frac{\\Pr(\\text{both blue})}{\\Pr(\\text{same colour})}\\\\\\Pr(\\text{both blue}\\mid\\text{same colour})&=\\frac{1/10}{2/5}\\\\\\Pr(\\text{both blue}\\mid\\text{same colour})&=\\frac14.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
