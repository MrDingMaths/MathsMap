    "type": "question",
    "label": "10",
    "prompt": "A piece of string is cut into two lengths so that the longer length is 25 cm. The ratio of the lengths is $5:2$. What is the length of the string?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$35\\text{ cm}$",
      "worked": "The longer length represents 5 parts.\n$$\\begin{align*}5\\text{ parts}&=25\\text{ cm}\\\\1\\text{ part}&=25\\div5=5\\text{ cm}\\\\\\text{Total parts}&=5+2=7\\\\\\text{Length of string}&=7\\times5=35\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
