  "content": {
    "id": "v2-e0e51-p15-practice-slot-5-lower-root",
    "type": "question",
    "label": null,
    "prompt": "At a Melbourne school, 45% of students catch the train, 30% catch the bus, and 12% catch both.\nWhat percentage of students catch the train or the bus?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "63%.",
      "worked": "Let $T$ and $B$ be the sets of students who catch the train and the bus, measured as percentages of all students.\n$$\\begin{align*}|T\\cup B|&=|T|+|B|-|T\\cap B|\\\\|T\\cup B|&=45+30-12\\\\|T\\cup B|&=63\\end{align*}$$\n63% of students catch the train or the bus.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
