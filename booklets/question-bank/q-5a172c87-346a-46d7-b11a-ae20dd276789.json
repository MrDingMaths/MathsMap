      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Five is subtracted from a number and the result is 10.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-5=10$, so $x=15$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}x-5&=10\\\\x&=10+5\\\\x&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "A number is multiplied by 7 and the result is 84.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7x=84$, so $x=12$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}7x&=84\\\\x&=\\frac{84}{7}\\\\x&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
