  "content": {
    "id": "p8-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Sketch $y=(x+1)^2$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave up.",
          "worked": "$a=1>0$, so the parabola is concave up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,1)$.",
          "worked": "Let $x=0$.\n$$\\begin{aligned}y&=(0+1)^2\\\\y&=1\\end{aligned}$$\nThe $y$-intercept is $(0,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,0)$, a repeated intercept.",
          "worked": "Let $y=0$.\n$$\\begin{aligned}0&=(x+1)(x+1)\\\\x+1&=0\\\\x&=-1\\end{aligned}$$\nThe only $x$-intercept is $(-1,0)$; the graph touches the axis there.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,0)$.",
          "worked": "The two factors give the repeated root $-1$.\n$$\\begin{aligned}x&=\\frac{-1+(-1)}{2}\\\\x&=-1\\end{aligned}$$\nSubstitute $x=-1$.\n$$\\begin{aligned}y&=(-1+1)^2\\\\y&=0\\end{aligned}$$\nThe vertex is $(-1,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ],
    "sharedSolutionDiagrams": [
      {
        "id": "p8-q6-graph",
        "role": "solution",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"supplied function curve\"}],\"reference\":\"source page 8, p8-q6-graph\"}\n\\begin{tikzpicture}[x=0.55cm,y=0.28cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\draw[<->,line width=0.5pt] (-10,0)--(10,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-10)--(0,10) node[above] {$y$};\n\\draw[<->,draw=curveBlue,line width=0.8pt,samples=101,domain=-4.08:2.08] plot (\\x,{(\\x+1)^2});\n\\node[below left] at (-1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[right] at (0,1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
