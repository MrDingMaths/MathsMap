  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": null,
    "prompt": "A line has gradient $3$ and passes through the point $(1,7)$. Find its equation $y = mx + c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y = 3x + 4$",
      "worked": "$$\\begin{aligned}y &= 3x + c\\\\7 &= 3(1) + c\\\\c &= 4\\end{aligned}$$\nTherefore $y = 3x + 4$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
