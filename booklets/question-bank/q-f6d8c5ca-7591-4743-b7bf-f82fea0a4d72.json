  "content": {
    "id": "p37-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Each of the following experiments involves two events, $A$ and $B$.\nState in each case whether they are dependent or independent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(A\\mid B)=0.5$ and $P(A)=0.4$ and $P(B)=0.5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Dependent.",
          "worked": "Check whether $P(A\\mid B)=P(A)$.\n$$P(A\\mid B)=0.5\\ne 0.4=P(A).$$\nTherefore, the events are dependent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(A\\mid B)=0.3$ and $P(A)=0.3$ and $P(B)=0.6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Independent.",
          "worked": "Check whether $P(A\\mid B)=P(A)$.\n$$P(A\\mid B)=0.3=P(A).$$\nTherefore, the events are independent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(A\\mid B)=\\dfrac{3}{4}$ and $P(A)=\\dfrac{2}{5}$ and $P(B)=\\dfrac{3}{10}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Dependent.",
          "worked": "Check whether $P(A\\mid B)=P(A)$.\n$$P(A\\mid B)=\\frac{3}{4}\\ne\\frac{2}{5}=P(A).$$\nTherefore, the events are dependent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(A)=0.3$ and $P(B)=0.7$ and $P(A\\cap B)=0.21$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Independent.",
          "worked": "Check whether $P(A\\cap B)=P(A)\\times P(B)$.\n$$\\begin{aligned}P(A)\\times P(B)&=0.3\\times0.7\\\\P(A)\\times P(B)&=0.21\\\\P(A)\\times P(B)&=P(A\\cap B).\\end{aligned}$$\nTherefore, the events are independent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(A)=0.2$ and $P(B)=0.4$ and $P(A\\cap B)=0.8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Impossible probability data.",
          "worked": "The intersection cannot have a greater probability than either event. Here $P(A\\cap B)=0.8$ exceeds both $P(A)=0.2$ and $P(B)=0.4$, so these probability data are impossible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$P(A)=\\dfrac{1}{2}$ and $P(B)=\\dfrac{2}{3}$ and $P(A\\cap B)=\\dfrac{1}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Independent.",
          "worked": "Check whether $P(A\\cap B)=P(A)\\times P(B)$.\n$$\\begin{aligned}P(A)\\times P(B)&=\\frac{1}{2}\\times\\frac{2}{3}\\\\P(A)\\times P(B)&=\\frac{1}{3}\\\\P(A)\\times P(B)&=P(A\\cap B).\\end{aligned}$$\nTherefore, the events are independent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
