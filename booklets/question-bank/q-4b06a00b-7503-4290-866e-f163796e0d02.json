  "content": {
    "id": "p26-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the mode of each continuous probability distribution.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=-\\dfrac{3(x^2-8x-9)}{434}$ defined in the domain $[0,7]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mode $=4$.",
          "worked": "This is a concave down parabola, so its turning point is a maximum.\n$$\\begin{align*}f'(x)&=-\\frac{3(2x-8)}{434}\\\\0&=-\\frac{3(2x-8)}{434}\\\\x&=4\\end{align*}$$\nSince $4\\in[0,7]$, the turning point is in the domain.\n$$f(0)=\\frac{27}{434},\\qquad f(4)=\\frac{75}{434},\\qquad f(7)=\\frac{48}{434}.$$\nThe maximum occurs at $x=4$, so the mode is $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p26-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=-\\dfrac{3(x^2-16x+15)}{1100}$ defined in the domain $[1,11]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mode $=8$.",
          "worked": "This is a concave down parabola, so its turning point is a maximum.\n$$\\begin{align*}f'(x)&=-\\frac{3(2x-16)}{1100}\\\\0&=-\\frac{3(2x-16)}{1100}\\\\x&=8\\end{align*}$$\nSince $8\\in[1,11]$, the turning point is in the domain.\n$$f(1)=0,\\qquad f(8)=\\frac{147}{1100},\\qquad f(11)=\\frac{120}{1100}.$$\nThe maximum occurs at $x=8$, so the mode is $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p26-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{4e^{4x}}{e^8(e^{16}-1)}$ defined in the interval $2\\le x\\le6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mode $=6$.",
          "worked": "$$f'(x)=\\frac{16e^{4x}}{e^8(e^{16}-1)}>0\\quad\\text{for }2\\le x\\le6.$$\nThe function is always increasing on $[2,6]$. Its maximum is at the end of the domain, $x=6$.\nTherefore, the mode is $6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
