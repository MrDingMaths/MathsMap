    "type": "question",
    "label": null,
    "prompt": "Noah's weekly rent was \\$450 but has increased by 8%. He has budgeted \\$500 a week for rent. How much of his budget is left over?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$14",
      "worked": "The multiplier for an 8% increase is $1.08$.\n$$\\begin{align*}\\text{New rent}&=\\$450\\times1.08\\\\&=\\$486\\\\\\text{Budget left over}&=\\$500-\\$486\\\\&=\\$14\\end{align*}$$",
      "solutionDiagrams": []
    },
