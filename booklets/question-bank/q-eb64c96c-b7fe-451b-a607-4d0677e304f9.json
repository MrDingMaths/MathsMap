                  },
                  {
                    "type": "math",
                    "latex": "y=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{align*}0&=x^2-10\\\\0&=(x+\\sqrt{10})(x-\\sqrt{10})\\\\x+\\sqrt{10}&=0\\quad\\text{or}\\quad x-\\sqrt{10}=0\\\\x&=-\\sqrt{10}\\quad\\text{or}\\quad x=\\sqrt{10}\\end{align*}",
                    "display": true
                  }
