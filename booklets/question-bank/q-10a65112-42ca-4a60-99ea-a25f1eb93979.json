  "content": {
    "id": "p22-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Solve these simultaneous equations for $(x,y)$ using the elimination method.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}ax+by&=c\\\\ax-by&=d\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\dfrac{c+d}{2a},\\dfrac{c-d}{2b}\\right)$, where $a,b\\ne0$.\n\nAdd the equations to find $x$; subtract them to find $y$.",
          "worked": "Add the equations to eliminate $y$; subtract the second from the first to eliminate $x$.\n$$\\begin{align*}2ax&=c+d\\\\x&=\\frac{c+d}{2a}\\\\2by&=c-d\\\\y&=\\frac{c-d}{2b}\\end{align*}$$\nTherefore, $(x,y)=\\left(\\dfrac{c+d}{2a},\\dfrac{c-d}{2b}\\right)$, where $a,b\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p22-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}ax-by&=c\\\\ax-by&=d\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution if $c\\ne d$. If $c=d$, every pair satisfying $ax-by=c$ is a solution.",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}(ax-by)-(ax-by)&=c-d\\\\0&=c-d\\end{align*}$$\nIf $c\\ne d$, the equations are inconsistent and have no solution. If $c=d$, the equations coincide: every pair satisfying $ax-by=c$ is a solution. For $a,b\\ne0$, there are infinitely many such pairs.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      },
      {
        "id": "p22-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}ax+3by&=3b\\\\ax+2by&=2b\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(0,1)$, where $a,b\\ne0$.",
          "worked": "Subtract the second equation from the first, then substitute $y=1$ into the second equation.\n$$\\begin{align*}by&=b\\\\y&=1\\\\ax+2b(1)&=2b\\\\ax&=0\\\\x&=0\\end{align*}$$\nTherefore, $(x,y)=(0,1)$, where $a,b\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      },
      {
        "id": "p22-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}\\frac{x}{a}+\\frac{y}{b}&=2\\\\\\frac{x}{a}-\\frac{y}{b}&=1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\dfrac{3a}{2},\\dfrac{b}{2}\\right)$, where $a,b\\ne0$.",
          "worked": "Add the equations to eliminate $y$; subtract the second from the first to eliminate $x$.\n$$\\begin{align*}\\frac{2x}{a}&=3\\\\x&=\\frac{3a}{2}\\\\\\frac{2y}{b}&=1\\\\y&=\\frac{b}{2}\\end{align*}$$\nTherefore, $(x,y)=\\left(\\dfrac{3a}{2},\\dfrac{b}{2}\\right)$, where $a,b\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 82
      }
    ]
  },
