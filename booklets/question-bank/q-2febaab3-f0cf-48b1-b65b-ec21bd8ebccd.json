  "content": {
    "id": "v2-9cb9c2-p5-practice-j2-025907-root",
    "type": "question",
    "label": null,
    "prompt": "Solve these equations using the substitution given.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-9cb9c2-p5-practice-j2-025907-j2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{6}-7x^{3}-8=0$, using $u=x^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-1$.",
          "worked": "Let $u=x^{3}$.\n$$\\begin{align*}u^{2}-7u-8&=0\\\\(u-8)(u+1)&=0\\\\u&=8\\text{ or }-1\\\\x^{3}&=8\\text{ or }-1\\\\x&=2\\text{ or }-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-9cb9c2-p5-practice-j2-025907-j2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-1)^{2}+(x-1)-12=0$, using $u=x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=-3$.",
          "worked": "Let $u=x-1$.\n$$\\begin{align*}u^{2}+u-12&=0\\\\(u+4)(u-3)&=0\\\\u&=-4\\text{ or }3\\\\x-1&=-4\\text{ or }3\\\\x&=-3\\text{ or }4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-9cb9c2-p5-practice-j2-025907-j2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x-5\\sqrt{x}+6=0$, using $u=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=9$.",
          "worked": "Let $u=\\sqrt{x}$, so $x=u^{2}$.\n$$\\begin{align*}u^{2}-5u+6&=0\\\\(u-2)(u-3)&=0\\\\u&=2\\text{ or }3\\\\\\sqrt{x}&=2\\text{ or }3\\\\x&=4\\text{ or }9\\end{align*}$$\nBoth values of $u$ are positive, so both solutions are valid.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
