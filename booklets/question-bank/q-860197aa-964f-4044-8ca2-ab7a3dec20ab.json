  "content": {
    "id": "p19-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "If the first of November is a Sunday, what dates of November are Wednesdays? What day of the week is the 27 November?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "4, 11, 18 and 25 November are Wednesdays. 27 November is a Friday.",
      "worked": "The first Wednesday is three days after Sunday 1 November, so it is 4 November. Adding seven days each time gives 4, 11, 18 and 25 November.\n\n$$\\begin{align*}27-1&=26\\\\26&=7\\times3+5\\end{align*}$$\n\nThus 27 November is five days after a Sunday, so it is a Friday.",
      "solutionDiagrams": []
    },
