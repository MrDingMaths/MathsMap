    "type": "question",
    "label": null,
    "prompt": "A particular strain of bacteria increases its population on a certain prepared Petri dish by $34\\%$ every hour. Calculate the size of the original population four hours ago if there are now $56\\,000$ bacteria. Give your answer to the nearest whole bacterium.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$17\\,369$ bacteria.",
      "worked": "Each hour the population is $134\\%$ of its previous value, so the multiplier is $1.34$.\n\n$$\\begin{align*}\\text{Original population}&=56\\,000\\div(1.34)^4\\\\\\text{Original population}&\\approx17\\,369\\text{ bacteria}.\\end{align*}$$",
      "solutionDiagrams": []
    },
