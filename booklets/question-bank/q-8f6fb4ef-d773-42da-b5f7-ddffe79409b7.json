              "type": "math",
              "latex": "-4+9x^{2}",
              "display": false
            },
            {
              "type": "text",
              "text": " may not seem like a difference of two squares, but",
              "marks": []
            }
          ]
        },
        {
          "id": "p31-q8-demonstration",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}-4+9x^{2}&=9x^{2}-4\\\\&=(3x+2)(3x-2)\\end{aligned}",
              "display": true
            }
          ]
        },
        {
          "id": "p31-q8-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Use this idea to factorise these expressions.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$-9+x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x+3)$",
          "worked": "$$\\begin{align*}-9+x^{2}&=x^{2}-9\\\\-9+x^{2}&=x^{2}-3^{2}\\\\-9+x^{2}&=(x-3)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$-121+16x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x-11)(4x+11)$",
          "worked": "$$\\begin{align*}-121+16x^{2}&=16x^{2}-121\\\\-121+16x^{2}&=(4x)^{2}-11^{2}\\\\-121+16x^{2}&=(4x-11)(4x+11)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$-25a^{2}+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2-5a)(2+5a)$",
          "worked": "$$\\begin{align*}-25a^{2}+4&=4-25a^{2}\\\\-25a^{2}+4&=2^{2}-(5a)^{2}\\\\-25a^{2}+4&=(2-5a)(2+5a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$-25a^{2}+4b^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2b-5a)(2b+5a)$",
          "worked": "$$\\begin{align*}-25a^{2}+4b^{2}&=4b^{2}-25a^{2}\\\\-25a^{2}+4b^{2}&=(2b)^{2}-(5a)^{2}\\\\-25a^{2}+4b^{2}&=(2b-5a)(2b+5a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$-36a^{2}b^{2}+c^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(c-6ab)(c+6ab)$",
          "worked": "$$\\begin{align*}-36a^{2}b^{2}+c^{2}&=c^{2}-36a^{2}b^{2}\\\\-36a^{2}b^{2}+c^{2}&=c^{2}-(6ab)^{2}\\\\-36a^{2}b^{2}+c^{2}&=(c-6ab)(c+6ab)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p31-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$-16x^{2}+y^{2}z^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(yz-4x)(yz+4x)$",
          "worked": "$$\\begin{align*}-16x^{2}+y^{2}z^{2}&=y^{2}z^{2}-16x^{2}\\\\-16x^{2}+y^{2}z^{2}&=(yz)^{2}-(4x)^{2}\\\\-16x^{2}+y^{2}z^{2}&=(yz-4x)(yz+4x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
