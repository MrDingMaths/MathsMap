        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "The graph gives $f(-2)=0$ and $f(0)=1$.\n$$\\begin{align*}f(f(-2))&=f(0)\\\\f(f(-2))&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
