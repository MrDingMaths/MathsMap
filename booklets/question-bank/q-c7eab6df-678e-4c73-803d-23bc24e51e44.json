        "prompt": "$x$ given $f(x)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\le x\\le1$",
          "worked": "The horizontal segment lies on $y=1$ for every input from $-1$ to $1$, including both endpoints. Hence $-1\\le x\\le1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
