  "content": {
    "id": "p30-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The equation of the line of best fit connecting hip measurement ($H$), in cm, and waist measurement ($W$), in cm, is $W = 0.7H - 2.1$. Use the equation to predict:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "The waist of a person with a hip measurement of 96 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "65.1 cm",
          "worked": "Let $H = 96$.\n$$\\begin{align*}W &= 0.7(96) - 2.1\\\\W &= 65.1\\end{align*}$$\nThe predicted waist measurement is 65.1 cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "The hip measurement of a person with a waist of 65 cm. Give your answer correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "95.86 cm",
          "worked": "Let $W = 65$.\n$$\\begin{align*}65 &= 0.7H - 2.1\\\\67.1 &= 0.7H\\\\H &= \\frac{67.1}{0.7}\\\\H &\\approx 95.86\\end{align*}$$\nThe predicted hip measurement is 95.86 cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
