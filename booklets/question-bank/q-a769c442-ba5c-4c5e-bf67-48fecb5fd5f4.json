  "content": {
    "id": "p61-identity-question",
    "type": "question",
    "label": null,
    "prompt": "Find the values of $A$, $B$ and $C$ in the following quadratic identities.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p61-identity-question-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(x-3)^2+B(x-3)+C=5x^2-12x+8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=5$, $B=18$, $C=17$.",
          "worked": "Expanding gives\n$$\\begin{align*}A(x-3)^2+B(x-3)+C &= Ax^2+(B-6A)x+9A-3B+C.\\end{align*}$$\nEquate the coefficients of $x^2$, $x$ and the constant terms:\n$$\\begin{align*}A &= 5,\\\\B-6A &= -12,\\\\B-6(5) &= -12,\\\\B &= 18,\\\\9A-3B+C &= 8,\\\\9(5)-3(18)+C &= 8,\\\\C &= 17.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p61-identity-question-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(2x+1)^2+B(2x+1)+C=4x^2-10x-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=1$, $B=-7$, $C=2$.\n\nExpand $(2x+1)^2=4x^2+4x+1$, then equate coefficients.",
          "worked": "Expanding gives\n$$\\begin{align*}A(2x+1)^2+B(2x+1)+C &= 4Ax^2+(4A+2B)x+A+B+C.\\end{align*}$$\nEquate the coefficients of $x^2$, $x$ and the constant terms:\n$$\\begin{align*}4A &= 4,\\\\A &= 1,\\\\4A+2B &= -10,\\\\4(1)+2B &= -10,\\\\B &= -7,\\\\A+B+C &= -4,\\\\1-7+C &= -4,\\\\C &= 2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      },
      {
        "id": "p61-identity-question-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(x+2)^2+B(x+2)+C=3x^2+5x+7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=3$, $B=-7$, $C=9$.",
          "worked": "Expanding gives\n$$\\begin{align*}A(x+2)^2+B(x+2)+C &= Ax^2+(4A+B)x+4A+2B+C.\\end{align*}$$\nEquate the coefficients of $x^2$, $x$ and the constant terms:\n$$\\begin{align*}A &= 3,\\\\4A+B &= 5,\\\\4(3)+B &= 5,\\\\B &= -7,\\\\4A+2B+C &= 7,\\\\4(3)+2(-7)+C &= 7,\\\\C &= 9.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p61-identity-question-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(3x-1)^2+B(3x-1)+C=9x^2+15x-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=1$, $B=7$, $C=2$.\n\nExpand $(3x-1)^2=9x^2-6x+1$, then equate coefficients.",
          "worked": "Expanding gives\n$$\\begin{align*}A(3x-1)^2+B(3x-1)+C &= 9Ax^2+(-6A+3B)x+A-B+C.\\end{align*}$$\nEquate the coefficients of $x^2$, $x$ and the constant terms:\n$$\\begin{align*}9A &= 9,\\\\A &= 1,\\\\-6A+3B &= 15,\\\\-6(1)+3B &= 15,\\\\B &= 7,\\\\A-B+C &= -4,\\\\1-7+C &= -4,\\\\C &= 2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      },
      {
        "id": "p61-identity-question-e",
        "type": "part",
        "label": "e",
        "prompt": "$A(x-1)(x-2)+B(x-1)+C=2x^2-9x+14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=2$, $B=-3$, $C=7$.",
          "worked": "Expanding gives\n$$\\begin{align*}A(x-1)(x-2)+B(x-1)+C &= Ax^2+(B-3A)x+2A-B+C.\\end{align*}$$\nEquate the coefficients of $x^2$, $x$ and the constant terms:\n$$\\begin{align*}A &= 2,\\\\B-3A &= -9,\\\\B-3(2) &= -9,\\\\B &= -3,\\\\2A-B+C &= 14,\\\\2(2)-(-3)+C &= 14,\\\\C &= 7.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
