  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Write an expression for each of the following and then expand it.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "A number, $x$, has 3 added to it and the result is multiplied by 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(x+3)=5x+15$",
          "worked": "$$\\begin{align*}5(x+3)&=5(x)+5(3)\\\\5(x+3)&=5x+15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "A number, $b$, has 6 added to it and the result is doubled.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(b+6)=2b+12$",
          "worked": "$$\\begin{align*}2(b+6)&=2(b)+2(6)\\\\2(b+6)&=2b+12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "A number, $z$, has 4 subtracted from it and the result is multiplied by 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(z-4)=3z-12$",
          "worked": "$$\\begin{align*}3(z-4)&=3(z)+3(-4)\\\\3(z-4)&=3z-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "A number, $y$, is subtracted from 10 and the result is multiplied by 7.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7(10-y)=70-7y$",
          "worked": "$$\\begin{align*}7(10-y)&=7(10)+7(-y)\\\\7(10-y)&=70-7y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
