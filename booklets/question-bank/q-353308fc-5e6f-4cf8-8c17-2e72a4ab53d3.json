  "content": {
    "id": "p39-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A quantity $Q$ is varying over time $t$ according to the formula $Q=5\\times10^{t/2}$. Give answers correct to four significant figures.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $Q$ when $t=6$, and when $t=5.43$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q=5000$ and $Q=2594$, respectively (4 significant figures).",
          "worked": "When $t=6$:\n$$\\begin{align*}Q&=5\\times10^{6/2}\\\\Q&=5\\times10^3\\\\Q&=5000\\end{align*}$$\nWhen $t=5.43$:\n$$\\begin{align*}Q&=5\\times10^{5.43/2}\\\\Q&\\approx2594\\end{align*}$$\nBoth answers are given to four significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p39-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Rewrite the formula with $t$ as the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2\\log_{10}\\left(\\dfrac{Q}{5}\\right)$.",
          "worked": "$$\\begin{align*}\\frac{Q}{5}&=10^{t/2}\\\\\\log_{10}\\left(\\frac{Q}{5}\\right)&=\\frac{t}{2}\\\\t&=2\\log_{10}\\left(\\frac{Q}{5}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $t$ when $Q=500$, and when $Q=256$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=4.000$ and $t=3.419$, respectively.",
          "worked": "When $Q=500$:\n$$\\begin{align*}t&=2\\log_{10}\\left(\\frac{500}{5}\\right)\\\\t&=2\\log_{10}100\\\\t&=4.000\\end{align*}$$\nWhen $Q=256$:\n$$\\begin{align*}t&=2\\log_{10}\\left(\\frac{256}{5}\\right)\\\\t&\\approx3.419\\end{align*}$$\nBoth answers are given to four significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
