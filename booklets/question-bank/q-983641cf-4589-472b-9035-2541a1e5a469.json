    "children": [
      {
        "id": "p42-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the interquartile range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\mathrm{IQR}&=Q_3-Q_1\\\\&=48-42\\\\&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p42-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What are the upper and lower limits for outliers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Upper limit: $57$. Lower limit: $33$.",
          "worked": "$$\\begin{align*}\\text{Upper limit}&=Q_3+1.5\\times\\mathrm{IQR}\\\\&=48+1.5\\times6\\\\&=57\\\\\\text{Lower limit}&=Q_1-1.5\\times\\mathrm{IQR}\\\\&=42-1.5\\times6\\\\&=33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p42-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Are there outliers in this dataset?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. The minimum, $31$, is below the lower limit of $33$.",
          "worked": "The minimum is $31$. Since $31<33$, there is at least one outlier below the lower limit. The maximum is $56<57$, so there are no outliers above the upper limit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
