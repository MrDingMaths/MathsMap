  "content": {
    "id": "p25-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the missing values by equating coefficients.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$a(2x+7)=8x+14b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4,\\ b=2$",
          "worked": "$$\\begin{aligned}2ax+7a&=8x+14b\\end{aligned}$$\nEquating coefficients of $x$:\n$$\\begin{aligned}2a&=8\\\\a&=4\\end{aligned}$$\nEquating constant terms:\n$$\\begin{aligned}7a&=14b\\\\7(4)&=14b\\\\b&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p25-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(c-2)x^2+3d=7x^2+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=9,\\ d=3$",
          "worked": "Equating coefficients of $x^2$:\n$$\\begin{aligned}c-2&=7\\\\c&=9\\end{aligned}$$\nEquating constant terms:\n$$\\begin{aligned}3d&=9\\\\d&=3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$9(2x+5)+2(3x+b)=ax+23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=24,\\ b=-11$",
          "worked": "$$\\begin{aligned}18x+45+6x+2b&=ax+23\\\\24x+45+2b&=ax+23\\end{aligned}$$\nEquating coefficients of $x$ gives $a=24$.\n\nEquating constant terms:\n$$\\begin{aligned}45+2b&=23\\\\2b&=-22\\\\b&=-11\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p25-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$4(2x+b)+a(x+3)=10x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2,\\ b=-1$",
          "worked": "$$\\begin{aligned}8x+4b+ax+3a&=10x+2\\\\(8+a)x+4b+3a&=10x+2\\end{aligned}$$\nEquating coefficients of $x$:\n$$\\begin{aligned}8+a&=10\\\\a&=2\\end{aligned}$$\nEquating constant terms:\n$$\\begin{aligned}4b+3a&=2\\\\4b+3(2)&=2\\\\4b&=-4\\\\b&=-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p25-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$4(3x+2)+a(x+b)=15x-16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3,\\ b=-8$",
          "worked": "$$\\begin{aligned}12x+8+ax+ab&=15x-16\\\\(12+a)x+8+ab&=15x-16\\end{aligned}$$\nEquating coefficients of $x$:\n$$\\begin{aligned}12+a&=15\\\\a&=3\\end{aligned}$$\nEquating constant terms:\n$$\\begin{aligned}8+ab&=-16\\\\8+3b&=-16\\\\3b&=-24\\\\b&=-8\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p25-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$2ax+9-3(x+b)=5x-30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4,\\ b=13$",
          "worked": "$$\\begin{aligned}2ax+9-3x-3b&=5x-30\\\\(2a-3)x+9-3b&=5x-30\\end{aligned}$$\nEquating coefficients of $x$:\n$$\\begin{aligned}2a-3&=5\\\\2a&=8\\\\a&=4\\end{aligned}$$\nEquating constant terms:\n$$\\begin{aligned}9-3b&=-30\\\\-3b&=-39\\\\b&=13\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
