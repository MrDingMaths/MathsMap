    "id": "simple-cubic-r26-backfill-3-root",
    "type": "question",
    "label": null,
    "prompt": "A rectangular prism has dimensions in the ratio $1:2:4$. Calculate the side lengths if the volume is $1728\\text{ cm}^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6\\text{ cm},\\ 12\\text{ cm},\\ 24\\text{ cm}$",
      "worked": "Let the side lengths be $x$, $2x$ and $4x$ centimetres.\n$$\\begin{align*}x\\times2x\\times4x&=1728\\\\8x^3&=1728\\\\x^3&=216\\\\x&=\\sqrt[3]{216}\\\\x&=6\\end{align*}$$\nThe side lengths are $6\\text{ cm}$, $12\\text{ cm}$ and $24\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
