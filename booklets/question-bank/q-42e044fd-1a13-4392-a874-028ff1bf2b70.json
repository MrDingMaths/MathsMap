  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Rewrite the following such that there is only a single angle and trigonometric function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos 2x+3\\cos^2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\cos^2x-1$",
          "worked": "$$\\begin{aligned}\\cos 2x+3\\cos^2x&=(2\\cos^2x-1)+3\\cos^2x\\\\&=5\\cos^2x-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin 2x-4\\sin x\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sin 2x$",
          "worked": "$$\\begin{aligned}\\sin 2x-4\\sin x\\cos x&=\\sin 2x-2\\sin 2x\\\\&=-\\sin 2x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin^2x+\\sin 2x+\\cos^2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\sin 2x$",
          "worked": "$$\\begin{aligned}\\sin^2x+\\sin 2x+\\cos^2x&=(\\sin^2x+\\cos^2x)+\\sin 2x\\\\&=1+\\sin 2x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1-\\cos 2x}{1+\\cos 2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^2x$",
          "worked": "$$\\begin{aligned}\\frac{1-\\cos 2x}{1+\\cos 2x}&=\\frac{2\\sin^2x}{2\\cos^2x}\\\\&=\\frac{\\sin^2x}{\\cos^2x}\\\\&=\\tan^2x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\sin 2x}{1-\\cos 2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot x$",
          "worked": "$$\\begin{aligned}\\frac{\\sin 2x}{1-\\cos 2x}&=\\frac{2\\sin x\\cos x}{2\\sin^2x}\\\\&=\\frac{\\cos x}{\\sin x}\\\\&=\\cot x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$(1+\\tan^2x)\\cos^2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}(1+\\tan^2x)\\cos^2x&=\\sec^2x\\cos^2x\\\\&=\\frac{1}{\\cos^2x}\\cos^2x\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
