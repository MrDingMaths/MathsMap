  "content": {
    "id": "p19-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A rectangle has a length of $6$ cm and a width of $4.5$ cm. A second rectangle has length $9$ cm and width $1.5$ cm. Find the ratio of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "the lengths of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:3$",
          "worked": "Both lengths are measured in centimetres. Divide both terms by $3$.\n\n$$\\begin{align*}\\text{First length : second length}&=6:9\\\\\\text{First length : second length}&=2:3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "the widths of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:1$",
          "worked": "Both widths are measured in centimetres. Multiply both terms by $10$, then divide by $15$.\n\n$$\\begin{align*}\\text{First width : second width}&=4.5:1.5\\\\\\text{First width : second width}&=45:15\\\\\\text{First width : second width}&=3:1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p19-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "the perimeters of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:1$",
          "worked": "$$\\begin{align*}P_1&=2(6+4.5)\\text{ cm}\\\\P_1&=21\\text{ cm}\\end{align*}$$\n\n$$\\begin{align*}P_2&=2(9+1.5)\\text{ cm}\\\\P_2&=21\\text{ cm}\\end{align*}$$\n\n$$\\begin{align*}\\text{First perimeter : second perimeter}&=21:21\\\\\\text{First perimeter : second perimeter}&=1:1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p19-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "the areas of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:1$",
          "worked": "$$\\begin{align*}A_1&=6\\times4.5\\text{ cm}^2\\\\A_1&=27\\text{ cm}^2\\end{align*}$$\n\n$$\\begin{align*}A_2&=9\\times1.5\\text{ cm}^2\\\\A_2&=13.5\\text{ cm}^2\\end{align*}$$\n\n$$\\begin{align*}\\text{First area : second area}&=27:13.5\\\\\\text{First area : second area}&=54:27\\\\\\text{First area : second area}&=2:1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
