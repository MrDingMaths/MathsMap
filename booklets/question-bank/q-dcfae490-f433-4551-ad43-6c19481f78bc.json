        "spec": {
          "sourcePage": 64,
          "sourceRegion": "Question 22 triangle",
          "description": "Triangle OAB with horizontal OB, filled midpoint markers M on OA and N on OB, and arrows along OM and ON. MN is intentionally not drawn.",
          "mathematics": "M=(O+A)/2; N=(O+B)/2; OM=a; ON=b.",
          "answerVisibility": "Givens and midpoint markers only."
