        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\frac12\\%,\\ \\frac{12}{32},\\ 0.39$",
          "worked": "$$\\begin{align*}4\\frac12\\%&=\\frac{4.5}{100}=0.045\\\\\\frac{12}{32}&=\\frac38=0.375\\end{align*}$$\n\nSince $0.045<0.375<0.39$, the order is $4\\frac12\\%,\\ \\frac{12}{32},\\ 0.39$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-ch15-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$64\\%,\\ 0.6,\\ \\frac23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.6,\\ 64\\%,\\ \\frac23$",
          "worked": "$$\\begin{align*}64\\%&=\\frac{64}{100}=0.64\\\\\\frac23&=0.\\overline6\\end{align*}$$\n\nSince $0.6<0.64<0.\\overline6$, the order is $0.6,\\ 64\\%,\\ \\frac23$.",
