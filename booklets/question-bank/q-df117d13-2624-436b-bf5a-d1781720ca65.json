  "content": {
    "id": "index-t10-q7-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t10-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{x^2}{y}\\right)^3\\times\\frac{2x}{y^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x^{7}}{y^{7}}$",
          "worked": "$$\\begin{align*}\n\\left(\\frac{x^2}{y}\\right)^3\\times\\frac{2x}{y^4} &= \\frac{2\\,x^{2\\times3 + 1}}{y^{3 + 4}} \\\\\n&= \\frac{2x^{7}}{y^{7}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{a^2b}{c}\\right)^4\\times\\left(\\frac{b^2}{c}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^{8}b^{10}}{c^{7}}$",
          "worked": "$$\\begin{align*}\n\\left(\\frac{a^2b}{c}\\right)^4\\times\\left(\\frac{b^2}{c}\\right)^3 &= \\frac{a^{2\\times4}\\,b^{4 + 2\\times3}}{c^{4 + 3}} \\\\\n&= \\frac{a^{8}b^{10}}{c^{7}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{pq^3}{r^2}\\right)^2\\times\\left(\\frac{p^0q^2}{r}\\right)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{p^{2}q^{14}}{r^{8}}$",
          "worked": "$$\\begin{align*}\n\\left(\\frac{pq^3}{r^2}\\right)^2\\times\\left(\\frac{p^0q^2}{r}\\right)^4 &= \\frac{p^{2 + 0\\times4}\\,q^{3\\times2 + 2\\times4}}{r^{2\\times2 + 4}} \\\\\n&= \\frac{p^{2}q^{14}}{r^{8}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{a^3b}{c}\\right)^3\\times\\left(\\frac{ac^4}{b}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{11}bc^{5}$",
          "worked": "$$\\begin{align*}\n\\left(\\frac{a^3b}{c}\\right)^3\\times\\left(\\frac{ac^4}{b}\\right)^2 &= a^{3\\times3 + 2}\\,b^{3 - 2}\\,c^{- 3 + 4\\times2} \\\\\n&= a^{11}bc^{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\frac{x^2z}{y}\\right)^4\\times\\left(\\frac{xy^2}{z}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{11}y^{2}z$",
          "worked": "$$\\begin{align*}\n\\left(\\frac{x^2z}{y}\\right)^4\\times\\left(\\frac{xy^2}{z}\\right)^3 &= x^{2\\times4 + 3}\\,z^{4 - 3}\\,y^{- 4 + 2\\times3} \\\\\n&= x^{11}y^{2}z\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{r^3s}{t}\\right)^2\\div\\left(\\frac{s}{rt^4}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{r^{9}t^{10}}{s}$",
          "worked": "$$\\begin{align*}\n\\left(\\frac{r^3s}{t}\\right)^2\\div\\left(\\frac{s}{rt^4}\\right)^3 &= \\frac{r^{3\\times2 + 3}\\,t^{- 2 + 4\\times3}}{s^{- 2 + 3}} \\\\\n&= \\frac{r^{9}t^{10}}{s}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
