  "content": {
    "id": "p14-q8",
    "type": "question",
    "label": "8",
    "prompt": "Factorise these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$8x-xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(8-y)$",
          "worked": "The HCF is $x$.\n$$\\begin{align*}8x-xy&=x(8-y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$8x-2xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x(4-y)$",
          "worked": "The HCF is $2x$.\n$$\\begin{align*}8x-2xy&=2x(4-y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$8x-4xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x(2-y)$",
          "worked": "The HCF is $4x$.\n$$\\begin{align*}8x-4xy&=4x(2-y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$8x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(8-x)$",
          "worked": "The HCF is $x$.\n$$\\begin{align*}8x-x^2&=x(8-x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-8x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x-8)$",
          "worked": "The HCF is $x$.\n$$\\begin{align*}x^2-8x&=x(x-8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x^2-12x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x(x-4)$",
          "worked": "The HCF is $3x$.\n$$\\begin{align*}3x^2-12x&=3x(x-4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$3x^2-12x+xy$",
