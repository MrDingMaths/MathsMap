  "content": {
    "id": "p21-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Make $a$ the subject in each of these equations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$a(b+1)=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{c}{b+1}$",
          "worked": "$$\\begin{align*}a(b+1)&=c\\\\a&=\\frac{c}{b+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$ab+a=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{b}{b+1}$",
          "worked": "$$\\begin{align*}a(b+1)&=b\\\\a&=\\frac{b}{b+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{a}+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{1}{c-b}$",
          "worked": "$$\\begin{align*}\\frac{1}{a}&=c-b\\\\1&=a(c-b)\\\\a(c-b)&=1\\\\a&=\\frac{1}{c-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{a+b}{a-b}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3b$",
          "worked": "$$\\begin{align*}a+b&=2(a-b)\\\\a+b&=2a-2b\\\\b&=a-2b\\\\3b&=a\\\\a&=3b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{a}+\\frac{1}{b}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{b}{b-1}$",
          "worked": "$$\\begin{align*}b+a&=ab\\\\b&=ab-a\\\\b&=a(b-1)\\\\a(b-1)&=b\\\\a&=\\frac{b}{b-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p21-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1}{a}+\\frac{1}{b}=\\frac{1}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{cb}{b-c}$",
          "worked": "$$\\begin{align*}bc+ac&=ab\\\\bc&=ab-ac\\\\bc&=a(b-c)\\\\a(b-c)&=bc\\\\a&=\\frac{bc}{b-c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
