  "content": {
    "id": "p75-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Let $n$ be any positive integer. Show that the curve $f(x)=x(x^2+1)^n$ has no horizontal tangent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(x)=(x^2+1)^{n-1}[(1+2n)x^2+1]>0$ for every real $x$. Hence the curve has no horizontal tangent.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p75-q23-work-derivative",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}f'(x)&=(x^2+1)^n+x\\cdot n(x^2+1)^{n-1}\\cdot2x\\\\&=(x^2+1)^{n-1}[(x^2+1)+2nx^2]\\\\&=(x^2+1)^{n-1}[x^2(1+2n)+1].\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p75-q23-work-horizontal",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "A tangent is horizontal when ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(x^2+1)^{n-1}[x^2(1+2n)+1]=0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p75-q23-work-null-factor",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "By the null factor law, either ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(x^2+1)^{n-1}=0",
                "display": false
              },
              {
                "type": "text",
                "text": " or ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x^2(1+2n)+1=0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p75-q23-work-first-factor",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "(x^2+1)^{n-1}>0",
                "display": false
              },
              {
                "type": "text",
                "text": " because ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x^2+1>0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p75-q23-work-second-factor",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x^2(1+2n)+1\\ge1>0",
                "display": false
              },
              {
                "type": "text",
                "text": " because ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n\\ge1",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x^2\\ge0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p75-q23-work-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Neither factor can be zero for any real ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x",
                "display": false
              },
              {
                "type": "text",
                "text": ". Therefore the tangent can never be horizontal.",
                "marks": []
              }
            ]
          },
