            {
              "type": "math",
              "latex": "x(t)=\\sqrt{4t+1}-t",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p77-q19a",
        "type": "part",
        "label": "a",
        "prompt": "Find the initial displacement.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(0)=1\\text{ m}$",
          "worked": "$$\\begin{align*}x(0)&=\\sqrt{4(0)+1}-0\\\\&=1\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p77-q19b",
        "type": "part",
        "label": "b",
        "prompt": "In which direction does the particle travel initially?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Right, since $v(0)=1\\text{ m s}^{-1}>0$.",
          "worked": "$$\\begin{align*}v(t)&=x'(t)=\\frac{2}{\\sqrt{4t+1}}-1\\\\v(0)&=\\frac{2}{\\sqrt{1}}-1=1\\text{ m s}^{-1}.\\end{align*}$$\nThe positive initial velocity means the particle travels to the right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p77-q19c",
        "type": "part",
        "label": "c",
        "prompt": "Find when the particle is at rest.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac34\\text{ s}$",
          "worked": "$$\\begin{align*}v(t)&=0\\\\\\frac{2}{\\sqrt{4t+1}}-1&=0\\\\\\sqrt{4t+1}&=2\\\\4t+1&=4\\\\t&=\\frac34\\text{ s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p77-q19d",
        "type": "part",
        "label": "d",
        "prompt": "Find when the particle has speed $0.5\\text{ m s}^{-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{7}{36}\\text{ s}$ or $t=\\frac{15}{4}\\text{ s}$.\n\nSolve $v(t)=\\frac12$ and $v(t)=-\\frac12$.",
          "worked": "Speed is $|v(t)|$, so solve both velocity signs.\n\n$$\\begin{align*}\\frac{2}{\\sqrt{4t+1}}-1&=\\frac12\\\\\\sqrt{4t+1}&=\\frac43\\\\4t+1&=\\frac{16}{9}\\\\t&=\\frac{7}{36}\\text{ s}.\\end{align*}$$\n\n$$\\begin{align*}\\frac{2}{\\sqrt{4t+1}}-1&=-\\frac12\\\\\\sqrt{4t+1}&=4\\\\4t+1&=16\\\\t&=\\frac{15}{4}\\text{ s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 82
      }
    ]
