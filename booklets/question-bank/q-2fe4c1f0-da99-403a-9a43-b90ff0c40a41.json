    "type": "question",
    "label": "22",
    "prompt": "Solve the following. $3x^2+5x+2=0$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-1$ or $x=-\\dfrac23$.",
      "worked": "$$\\begin{align*}3x(x+1)+2(x+1)&=0\\\\(3x+2)(x+1)&=0.\\end{align*}$$\nBy the null factor law, $3x+2=0$ or $x+1=0$.\n$$x=-\\frac23\\quad\\text{or}\\quad x=-1.$$",
      "solutionDiagrams": []
    },
