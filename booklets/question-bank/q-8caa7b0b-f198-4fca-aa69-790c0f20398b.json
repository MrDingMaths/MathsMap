  "content": {
    "id": "v2-c10bb-p19-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=\\dfrac{x+2}{x-1}$. Find $f(f(x))$ and hence write down $f^{-1}(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(f(x))=x$, so $f^{-1}(x)=\\dfrac{x+2}{x-1}$.",
      "worked": "$$\\begin{align*}f(f(x))&=\\frac{\\frac{x+2}{x-1}+2}{\\frac{x+2}{x-1}-1}\\\\&=\\frac{\\frac{(x+2)+2(x-1)}{x-1}}{\\frac{(x+2)-(x-1)}{x-1}}\\\\&=\\frac{\\frac{3x}{x-1}}{\\frac{3}{x-1}}\\\\&=x\\end{align*}$$\nSince $f(f(x))=x$, $f$ is its own inverse, so $f^{-1}(x)=\\dfrac{x+2}{x-1}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
