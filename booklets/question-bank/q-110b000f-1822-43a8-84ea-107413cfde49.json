  "content": {
    "id": "p11-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Twenty people go to the theatre. Each ticket costs $x$ dollars. The cost of the tickets is to be shared equally among 15 people. How much does each of these people pay?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$\\frac{4x}{3}$ each.",
      "worked": "The total ticket cost is $20x$ dollars. Sharing this equally among 15 people gives:\n$$\\begin{align*}\\text{Cost per person}&=\\frac{20x}{15}\\\\\\text{Cost per person}&=\\frac{4x}{3}\\text{ dollars}.\\end{align*}$$",
      "solutionDiagrams": []
    },
