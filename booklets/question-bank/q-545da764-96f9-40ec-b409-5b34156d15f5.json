  "content": {
    "id": "p18-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Answer the following questions about an eighteen-sided polygon.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the sum of the interior angles of an eighteen-sided polygon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2880^{\\circ}$",
          "worked": "$$\\begin{align*}\\text{Interior-angle sum}&=(18-2)\\times180^{\\circ}\\\\\\text{Interior-angle sum}&=2880^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the measure of each angle if the polygon is regular?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$160^{\\circ}$",
          "worked": "$$\\begin{align*}\\text{Each interior angle}&=\\frac{2880^{\\circ}}{18}\\\\\\text{Each interior angle}&=160^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
