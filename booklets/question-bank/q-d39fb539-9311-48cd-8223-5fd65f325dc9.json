        "label": "a",
        "prompt": "$y=(2x+1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=10(2x+1)^4$",
          "worked": "$$\\begin{align*}y'&=5(2x+1)^4(2)\\\\y'&=10(2x+1)^4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q06-11-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(4-3x)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-18(4-3x)^5$",
          "worked": "$$\\begin{align*}y'&=6(4-3x)^5(-3)\\\\y'&=-18(4-3x)^5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q06-11-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x^2+1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=10x(x^2+1)^4$",
          "worked": "$$\\begin{align*}y'&=5(x^2+1)^4(2x)\\\\y'&=10x(x^2+1)^4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q06-11-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(5x^2+4)^7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=70x(5x^2+4)^6$",
          "worked": "$$\\begin{align*}y'&=7(5x^2+4)^6(10x)\\\\y'&=70x(5x^2+4)^6.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q06-11-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=(2x+1)^{\\frac32}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3(2x+1)^{\\frac12}$",
          "worked": "$$\\begin{align*}y'&=\\frac32(2x+1)^{\\frac12}(2)\\\\y'&=3(2x+1)^{\\frac12}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q06-11-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=(x^2+2)^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x}{\\sqrt{x^2+2}}$",
          "worked": "$$\\begin{align*}y'&=\\frac12(x^2+2)^{-\\frac12}(2x)\\\\y'&=x(x^2+2)^{-\\frac12}\\\\y'&=\\frac{x}{\\sqrt{x^2+2}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
