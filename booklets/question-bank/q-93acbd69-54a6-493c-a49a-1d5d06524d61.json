    "type": "question",
    "label": "3",
    "prompt": "The space diagonal of a cube is 12 cm long. Find its side length.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\sqrt{3}\\text{ cm}$",
      "worked": "Let the side length be $s$ cm.\n\n$$\\begin{align*}12^2 &= s^2+s^2+s^2\\\\144 &= 3s^2\\\\s^2 &= 48\\\\s &= \\sqrt{48}\\\\s &= 4\\sqrt{3}\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
