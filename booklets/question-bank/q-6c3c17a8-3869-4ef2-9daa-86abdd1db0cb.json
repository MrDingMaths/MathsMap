        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 105$",
          "worked": "$$\\begin{align*}\\log_2 3+\\log_2 5+\\log_2 7&=\\log_2(3\\times5\\times7)\\\\\\log_2 3+\\log_2 5+\\log_2 7&=\\log_2 105\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_3 100-\\log_3 10-\\log_3 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 5$",
          "worked": "$$\\begin{align*}\\log_3 100-\\log_3 10-\\log_3 2&=\\log_3\\left(\\frac{100}{10\\times2}\\right)\\\\\\log_3 100-\\log_3 10-\\log_3 2&=\\log_3 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
