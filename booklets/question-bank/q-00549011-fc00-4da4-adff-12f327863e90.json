  "content": {
    "id": "p6-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Common factors can also be removed from expressions with more than two terms.\nFor example: $2x^2+6x+10xy=2x(x+3+5y)$. Factorise these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$3a+9b+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(a+3b+4)$",
          "worked": "The HCF is $3$.\n$\\begin{aligned}3a+9b+12&=3(a+3b+4)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$5z^{2}-10z+zy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z(5z-10+y)$",
          "worked": "The HCF is $z$.\n$\\begin{aligned}5z^{2}-10z+zy&=z(5z-10+y)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^{2}-2xy+x^{2}y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x-2y+xy)$",
          "worked": "The HCF is $x$.\n$\\begin{aligned}x^{2}-2xy+x^{2}y&=x(x-2y+xy)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$4by-2b+6b^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2b(2y-1+3b)$",
          "worked": "The HCF is $2b$.\n$\\begin{aligned}4by-2b+6b^{2}&=2b(2y-1+3b)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$-12xy-8yz-20xyz$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4y(3x+2z+5xz)$",
          "worked": "Take out the negative HCF, $-4y$.\n$\\begin{aligned}-12xy-8yz-20xyz&=-4y(3x+2z+5xz)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$3ab+4ab^{2}+6a^{2}b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab(3+4b+6a)$",
          "worked": "The HCF is $ab$.\n$\\begin{aligned}3ab+4ab^{2}+6a^{2}b&=ab(3+4b+6a)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
