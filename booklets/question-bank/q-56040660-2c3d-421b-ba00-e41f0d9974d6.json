  "content": {
    "id": "p61-q10-root",
    "type": "question",
    "label": null,
    "prompt": "$ABC$ is a triangle. The point $M$ is the midpoint of $BA$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p61-q10-figure",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 61 question 10\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (C) at (0,0);\\coordinate (B) at (3.2,2.5);\\coordinate (A) at (5.7,0.45);\\coordinate (M) at ($(B)!0.5!(A)$);\n\\draw (C)--(B)--(A)--cycle;\n\\draw[->] (C)--($(C)!0.55!(B)$);\\draw[->] (C)--($(C)!0.55!(A)$);\n\\fill (M) circle (1.4pt);\n\\node[below left] at (C) {$C$};\\node[above] at (B) {$B$};\\node[right] at (A) {$A$};\\node[above right] at (M) {$M$};\n\\path (C)--(B) node[midway,above left] {$-2\\underset{\\sim}{a}+\\underset{\\sim}{b}$};\n\\path (C)--(A) node[midway,below] {$\\underset{\\sim}{a}-3\\underset{\\sim}{b}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 62,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 61,
          "sourceRegion": "Question 10 diagram",
          "description": "Triangle CBA with midpoint M on BA and arrows from C towards B and A.",
          "mathematics": "CB=-2a+b; CA=a-3b; BM=MA.",
          "answerVisibility": "Givens only."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p61-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $\\overrightarrow{BM}$ in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tfrac32\\underset{\\sim}{a}-2\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{BA}&=\\overrightarrow{CA}-\\overrightarrow{CB}\\\\\\overrightarrow{BA}&=(\\underset{\\sim}{a}-3\\underset{\\sim}{b})-(-2\\underset{\\sim}{a}+\\underset{\\sim}{b})\\\\\\overrightarrow{BA}&=3\\underset{\\sim}{a}-4\\underset{\\sim}{b}\\\\\\overrightarrow{BM}&=\\tfrac12\\overrightarrow{BA}\\\\\\overrightarrow{BM}&=\\tfrac32\\underset{\\sim}{a}-2\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p61-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Write $\\overrightarrow{CM}$ in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\tfrac12\\underset{\\sim}{a}-\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{CM}&=\\overrightarrow{CB}+\\overrightarrow{BM}\\\\\\overrightarrow{CM}&=(-2\\underset{\\sim}{a}+\\underset{\\sim}{b})+(\\tfrac32\\underset{\\sim}{a}-2\\underset{\\sim}{b})\\\\\\overrightarrow{CM}&=-\\tfrac12\\underset{\\sim}{a}-\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
