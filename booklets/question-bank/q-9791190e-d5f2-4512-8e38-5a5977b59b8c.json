  "content": {
    "id": "p13-challenge-q4-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the probability that a randomly chosen three-digit number is divisible by:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-challenge-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "three",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "There are $999-100+1=900$ three-digit numbers. The multiples of 3 run from $102=3\\times34$ to $999=3\\times333$, giving $333-34+1=300$ favourable numbers.\n$$P(\\text{divisible by }3)=\\frac{300}{900}=\\frac{1}{3}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-challenge-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "seven",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{32}{225}$\n\nCount the multiples of 7 from 105 to 994 among the 900 three-digit numbers.",
          "worked": "There are 900 three-digit numbers. The multiples of 7 run from $105=7\\times15$ to $994=7\\times142$, giving $142-15+1=128$ favourable numbers.\n$$P(\\text{divisible by }7)=\\frac{128}{900}=\\frac{32}{225}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
