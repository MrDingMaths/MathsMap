  "content": {
    "id": "p10-q3",
    "type": "question",
    "label": "3",
    "prompt": "Solve the quadratic equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x(x+3)=x(2x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=7$",
          "worked": "$$\\begin{align*}x(x+3)-x(2x-4)&=0\\\\x[(x+3)-(2x-4)]&=0\\\\x(7-x)&=0\\\\x&=0\\quad\\text{or}\\quad 7-x=0\\\\x&=0\\quad\\text{or}\\quad x=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+3)(2x-1)=(2x-1)(3x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$ or $x=\\frac72$",
          "worked": "$$\\begin{align*}(x+3)(2x-1)-(2x-1)(3x-4)&=0\\\\(2x-1)[(x+3)-(3x-4)]&=0\\\\(2x-1)(7-2x)&=0\\\\2x-1&=0\\quad\\text{or}\\quad 7-2x=0\\\\x&=\\frac12\\quad\\text{or}\\quad x=\\frac72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x(x+3)=2x(2x+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=-1$",
          "worked": "$$\\begin{align*}3x(x+3)-2x(2x+5)&=0\\\\x[3(x+3)-2(2x+5)]&=0\\\\x(-x-1)&=0\\\\x&=0\\quad\\text{or}\\quad -x-1=0\\\\x&=0\\quad\\text{or}\\quad x=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$4(x+3)(2x-3)=2(x+3)(5x+8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-14$ or $x=-3$",
          "worked": "$$\\begin{align*}4(x+3)(2x-3)-2(x+3)(5x+8)&=0\\\\2(x+3)[2(2x-3)-(5x+8)]&=0\\\\2(x+3)(-x-14)&=0\\\\x+3&=0\\quad\\text{or}\\quad -x-14=0\\\\x&=-3\\quad\\text{or}\\quad x=-14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 51
      },
      {
        "id": "p10-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(5x+2)(x-7)=(x-7)(2x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$ or $x=-\\frac13$",
          "worked": "$$\\begin{align*}(5x+2)(x-7)-(x-7)(2x+1)&=0\\\\(x-7)[(5x+2)-(2x+1)]&=0\\\\(x-7)(3x+1)&=0\\\\x-7&=0\\quad\\text{or}\\quad 3x+1=0\\\\x&=7\\quad\\text{or}\\quad x=-\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
