  "content": {
    "id": "v2-d025a-p23-practice-retro-slot-6-225238-root",
    "type": "question",
    "label": null,
    "prompt": "Five identical pumps are used to drain a flooded car park in Geelong.\nEach pump removes 180 L of water every 6 minutes.\nHow long will the 5 pumps take to remove 6000 L of water?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$40\\text{ minutes}$",
      "worked": "$$\\begin{align*}\\text{Rate of one pump}&=\\frac{180\\text{ L}}{6\\text{ min}}=30\\text{ L/min}\\\\\\text{Combined rate}&=5\\times30=150\\text{ L/min}\\\\\\text{Time}&=\\frac{6000\\text{ L}}{150\\text{ L/min}}\\\\&=40\\text{ minutes}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
