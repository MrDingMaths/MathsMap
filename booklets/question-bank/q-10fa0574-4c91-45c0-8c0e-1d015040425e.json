  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find $x$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2(\\log_2 x)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=256$",
          "worked": "$$\\begin{align*}\\log_2 x&=2^3\\\\\\log_2 x&=8\\\\x&=2^8\\\\x&=256\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2(\\log_3 x)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=81$",
          "worked": "$$\\begin{align*}\\log_3 x&=2^2\\\\\\log_3 x&=4\\\\x&=3^4\\\\x&=81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2 2^x=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}2^x&=2^5\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p4-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_2 3^x=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_3 16$",
          "worked": "$$\\begin{align*}3^x&=2^4\\\\3^x&=16\\\\x&=\\log_3 16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$2^{\\log_2 x}=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=16$",
          "worked": "$$\\begin{align*}2^{\\log_2 x}&=2^4\\\\\\log_2 x&=4\\\\x&=2^4\\\\x&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^{\\log_3 x}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\sqrt{3}$",
          "worked": "$$\\begin{align*}(2^2)^{\\log_3 x}&=2^1\\\\2^{2\\log_3 x}&=2^1\\\\2\\log_3 x&=1\\\\\\log_3 x&=\\frac12\\\\x&=3^{1/2}\\\\x&=\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
