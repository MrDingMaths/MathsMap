  "content": {
    "id": "p6-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Consider the piecewise defined function and evaluate:\n$$f(x)=\\begin{cases}4x-3,&x\\geq 0\\\\7-x^2,&x<0\\end{cases}$$",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(5)-f(-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$",
          "worked": "$$\\begin{aligned}f(5)&=4(5)-3\\\\&=17\\end{aligned}$$\n$$\\begin{aligned}f(-5)&=7-(-5)^2\\\\&=-18\\end{aligned}$$\n$$\\begin{aligned}f(5)-f(-5)&=17-(-18)\\\\&=35\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$6f(6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$126$",
          "worked": "$$\\begin{aligned}f(6)&=4(6)-3\\\\&=21\\end{aligned}$$\n$$\\begin{aligned}6f(6)&=6(21)\\\\&=126\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(a^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2-3$",
          "worked": "Since $a^2\\geq 0$, use the branch $4x-3$.\n$$\\begin{aligned}f(a^2)&=4(a^2)-3\\\\&=4a^2-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
