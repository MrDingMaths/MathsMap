  "content": {
    "id": "p17-q1-4-root",
    "type": "question",
    "label": "1",
    "prompt": "Determine whether each equation contains the given point.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q1-4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y+x=2$; point $(1,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Substituting $(x,y)=(1,1)$:\n$$\\begin{align*}\\text{LHS}&=1+1\\\\\\text{LHS}&=2=\\text{RHS}.\\end{align*}$$\nTherefore, the point lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y-3x=1$; point $(1,4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Substituting $(x,y)=(1,4)$:\n$$\\begin{align*}\\text{LHS}&=4-3(1)\\\\\\text{LHS}&=1=\\text{RHS}.\\end{align*}$$\nTherefore, the point lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-4-c",
        "type": "part",
        "label": "c",
        "prompt": "$-4x+3y=10$; point $(-2,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Substituting $(x,y)=(-2,1)$:\n$$\\begin{align*}\\text{LHS}&=-4(-2)+3(1)\\\\\\text{LHS}&=11\\ne10=\\text{RHS}.\\end{align*}$$\nTherefore, the point does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p17-q1-4-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x-3y=7$; point $(1,-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Substituting $(x,y)=(1,-2)$:\n$$\\begin{align*}\\text{LHS}&=2(1)-3(-2)\\\\\\text{LHS}&=8\\ne7=\\text{RHS}.\\end{align*}$$\nTherefore, the point does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
