            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 21 p21-q7-a-diagram\"}\n\\begin{tikzpicture}[x=0.65cm,y=0.65cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (-6,2);\n\\coordinate (B) at (2,-5);\n\\draw[<->,black,line width=0.5pt] (-7.5,0)--(3.5,0) node[right,font=\\fontsize{10}{12}\\selectfont] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-6)--(0,3) node[above left,font=\\fontsize{10}{12}\\selectfont] {$y$};\n\\draw[black,line width=0.8pt] (A)--(B);\n\\fill[black] (A) circle (2pt);\n\\fill[black] (B) circle (2pt);\n\\node[above,font=\\fontsize{10}{12}\\selectfont] at (A) {$(-6,2)$};\n\\node[right,font=\\fontsize{10}{12}\\selectfont] at (B) {$(2,-5)$};\n\\end{tikzpicture}",
