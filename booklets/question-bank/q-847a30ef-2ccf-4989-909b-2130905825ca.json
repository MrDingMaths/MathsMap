    "answer": {
      "short": "$x=38$. The median increases by $0.5$, so the mean increases by $5$ to $13$; hence $x=6(13)-40$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p30-q28-worked-medians",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The original median is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "9",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ". Since ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "x>15",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ", the new median is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\frac{9+10}{2}=9.5",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p30-q28-worked-differences",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Difference in median: ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "9.5-9=0.5",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ", so the difference in mean is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "10\\times0.5=5",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p30-q28-worked-original-mean",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Old mean: ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\frac{1+5+9+10+15}{5}=8",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p30-q28-worked-new-mean",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Since ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "x>15>8",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ", adding ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "x",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " increases the mean. New mean: ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "8+5=13",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p30-q28-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}13&=\\frac{40+x}{6}\\\\78&=40+x\\\\x&=38\\end{align*}",
