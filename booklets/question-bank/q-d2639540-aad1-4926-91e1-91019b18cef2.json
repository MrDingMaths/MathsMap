  "content": {
    "id": "p25-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2x(x-4)}{4(x+1)}\\times\\dfrac{x+1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-4}{2}$",
          "worked": "$$\\begin{align*}\\frac{2x(x-4)}{4(x+1)}\\times\\frac{x+1}{x}&=\\frac{2(x-4)}{4}\\\\&=\\frac{x-4}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p25-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{(x+2)(x-3)}{x-5}\\times\\dfrac{x-5}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-3$",
          "worked": "$$\\begin{align*}\\frac{(x+2)(x-3)}{x-5}\\times\\frac{x-5}{x+2}&=\\frac{(x+2)(x-3)(x-5)}{(x-5)(x+2)}\\\\&=x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p25-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x-3}{x+2}\\times\\dfrac{3(x+4)(x+2)}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x-3)$",
          "worked": "$$\\begin{align*}\\frac{x-3}{x+2}\\times\\frac{3(x+4)(x+2)}{x+4}&=\\frac{3(x-3)(x+4)(x+2)}{(x+2)(x+4)}\\\\&=3(x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
