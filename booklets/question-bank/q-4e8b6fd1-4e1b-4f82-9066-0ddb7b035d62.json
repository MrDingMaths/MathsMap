  "content": {
    "id": "p5-practice-1-root",
    "type": "question",
    "label": "",
    "prompt": "Consider the arithmetic sequence: $12,14,16,18,\\ldots$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-practice-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $n$th term formula for the sequence.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=10+2n$",
          "worked": "$a=12$, $d=14-12=2$.\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=12+2(n-1)\\\\a_n&=10+2n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-practice-1-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the 20th term?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{20}=50$",
          "worked": "$$\\begin{align*}a_{20}&=10+2(20)\\\\a_{20}&=50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p5-practice-1-c",
        "type": "part",
        "label": "c",
        "prompt": "Which term of the sequence is 78?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The 34th term: $a_{34}=78$.",
          "worked": "$$\\begin{align*}10+2n&=78\\\\2n&=68\\\\n&=34\\end{align*}$$\nTherefore, 78 is the 34th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
