        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 29 p29-q9-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (2,3.2);\n\\coordinate (D) at (0,0);\n\\coordinate (E) at (4,0);\n\\coordinate (B) at ($(A)!0.65!(D)$);\n\\coordinate (C) at ($(A)!0.65!(E)$);\n\\draw[black,line width=0.8pt] (A)--(D)--(E)--cycle;\n\\draw[black,line width=0.8pt] (B)--(C);\n\\node[above=2pt] at (A) {$A$};\n\\node[left=3pt] at (B) {$B$};\n\\node[right=3pt] at (C) {$C$};\n\\node[left=3pt] at (D) {$D$};\n\\node[right=3pt] at (E) {$E$};\n\\node[below=3pt] at ($(B)!0.5!(C)$) {$8\\,\\mathrm{mm}$};\n\\node[below=5pt] at ($(D)!0.5!(E)$) {$20\\,\\mathrm{mm}$};\n\\draw[black,line width=0.4pt,->] ($(B)!0.46!(C)$)--($(B)!0.54!(C)$);\n\\draw[black,line width=0.4pt,->] ($(D)!0.46!(E)$)--($(D)!0.54!(E)$);\n\\coordinate (Adim) at ($(A)+(-0.20,0.12)$);\n\\coordinate (Bdim) at ($(B)+(-0.20,0.12)$);\n\\draw[black,line width=0.4pt,<->] (Adim)--(Bdim) node[midway,left=4pt] {$6\\,\\mathrm{mm}$};\n\\end{tikzpicture}",
