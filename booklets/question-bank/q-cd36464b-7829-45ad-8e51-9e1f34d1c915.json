        "id": "p29-q9-part-a",
        "type": "part",
        "label": "a",
        "prompt": "Using angle relationships, show that $ABC$ and $ADE$ are similar.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle ABC=\\angle ADE$ and $\\angle ACB=\\angle AED$ (corresponding angles, $BC\\parallel DE$). $\\angle BAC=\\angle DAE$ (common angle). Hence $\\triangle ABC\\sim\\triangle ADE$.",
          "worked": "$\\angle ABC=\\angle ADE$ (corresponding angles on parallel lines).\n\n$\\angle ACB=\\angle AED$ (corresponding angles on parallel lines).\n\n$\\angle BAC=\\angle DAE$ (common angle).\n\nTherefore $\\triangle ABC\\sim\\triangle ADE$, since all corresponding angles are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
