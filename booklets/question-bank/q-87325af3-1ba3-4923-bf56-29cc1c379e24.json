  "content": {
    "id": "v2-3d06b-p41-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "A bag contains 4 green and 6 yellow marbles. Two marbles are picked without replacement.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-3d06b-p41-practice-slot-2-s2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability of picking one marble of each colour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8}{15}$",
          "worked": "$$\\begin{align*}P(\\text{one of each})&=P(GY)+P(YG)\\\\&=\\frac{4}{10}\\times\\frac{6}{9}+\\frac{6}{10}\\times\\frac{4}{9}\\\\&=\\frac{24}{90}+\\frac{24}{90}\\\\&=\\frac{8}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-3d06b-p41-practice-slot-2-s2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The two marbles are returned to the bag and the process is repeated until it has been done 450 times. How many times would you expect to pick one marble of each colour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "240 times",
          "worked": "$$\\begin{align*}\\text{Expected number}&=450\\times\\frac{8}{15}\\\\&=240\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
