  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Fully simplify each of the following, writing each answer using a single logarithm. Note that the previous question may help.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 3+\\log_4 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4 27$",
          "worked": "$$\\begin{align*}\\log_2 3+\\log_4 3&=2\\log_4 3+\\log_4 3\\\\\\log_2 3+\\log_4 3&=3\\log_4 3\\\\\\log_2 3+\\log_4 3&=\\log_4(3^3)\\\\\\log_2 3+\\log_4 3&=\\log_4 27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\log_3 2+\\log_9 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_9 32$",
          "worked": "$$\\begin{align*}2\\log_3 2+\\log_9 2&=4\\log_9 2+\\log_9 2\\\\2\\log_3 2+\\log_9 2&=5\\log_9 2\\\\2\\log_3 2+\\log_9 2&=\\log_9(2^5)\\\\2\\log_3 2+\\log_9 2&=\\log_9 32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\log_2 3+2\\log_4 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 135$",
          "worked": "$$\\begin{align*}3\\log_2 3+2\\log_4 5&=3\\log_2 3+\\log_2 5\\\\3\\log_2 3+2\\log_4 5&=\\log_2 27+\\log_2 5\\\\3\\log_2 3+2\\log_4 5&=\\log_2(27\\times5)\\\\3\\log_2 3+2\\log_4 5&=\\log_2 135\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\log_4\\sqrt{3}-\\frac12\\log_2 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4\\!\\left(\\frac13\\right)$",
          "worked": "$$\\begin{align*}2\\log_4\\sqrt{3}-\\tfrac12\\log_2 9&=\\log_4 3-\\log_2 3\\\\2\\log_4\\sqrt{3}-\\tfrac12\\log_2 9&=\\log_4 3-2\\log_4 3\\\\2\\log_4\\sqrt{3}-\\tfrac12\\log_2 9&=\\log_4 3-\\log_4 9\\\\2\\log_4\\sqrt{3}-\\tfrac12\\log_2 9&=\\log_4\\!\\left(\\frac39\\right)\\\\2\\log_4\\sqrt{3}-\\tfrac12\\log_2 9&=\\log_4\\!\\left(\\frac13\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
