        "label": "a",
        "prompt": "If $14\\%$ of students in Year 7 are absent due to illness, what percentage of Year 7 students are at school?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$86\\%$",
          "worked": "$$\\begin{align*}\\text{At school}&=100\\%-14\\%\\\\\\text{At school}&=86\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p34-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "If $80\\%$ of the population is vaccinated, what percentage has not been vaccinated?",
