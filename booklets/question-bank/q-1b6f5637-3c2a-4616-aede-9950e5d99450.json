  "content": {
    "id": "p13-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Given that $x$ and $y$ are positive, simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{x^2y^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy\\sqrt{y}$",
          "worked": "$$\\begin{align*}\\sqrt{x^2y^3}&=\\sqrt{x^2y^2\\cdot y}\\\\\\sqrt{x^2y^3}&=xy\\sqrt{y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\sqrt{x^2y^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2y^3$",
          "worked": "$$\\begin{align*}x\\sqrt{x^2y^6}&=x\\sqrt{(xy^3)^2}\\\\x\\sqrt{x^2y^6}&=x^2y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{x^2+6x+9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$",
          "worked": "$$\\begin{align*}\\sqrt{x^2+6x+9}&=\\sqrt{(x+3)^2}\\\\\\sqrt{x^2+6x+9}&=x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{x^3+2x^2+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)\\sqrt{x}$",
          "worked": "$$\\begin{align*}\\sqrt{x^3+2x^2+x}&=\\sqrt{x(x^2+2x+1)}\\\\\\sqrt{x^3+2x^2+x}&=\\sqrt{x(x+1)^2}\\\\\\sqrt{x^3+2x^2+x}&=(x+1)\\sqrt{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p13-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt{x^2y^4(x^2+2x+1)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x+1)y^2$",
          "worked": "$$\\begin{align*}\\sqrt{x^2y^4(x^2+2x+1)}&=\\sqrt{x^2y^4(x+1)^2}\\\\\\sqrt{x^2y^4(x^2+2x+1)}&=xy^2(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{x^4+2x^3+x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x+1)$",
          "worked": "$$\\begin{align*}\\sqrt{x^4+2x^3+x^2}&=\\sqrt{x^2(x^2+2x+1)}\\\\\\sqrt{x^4+2x^3+x^2}&=\\sqrt{x^2(x+1)^2}\\\\\\sqrt{x^4+2x^3+x^2}&=x(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
