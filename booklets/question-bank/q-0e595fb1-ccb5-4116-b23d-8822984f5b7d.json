  "content": {
    "id": "p57-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify the following. $\\dfrac1{\\sqrt[3]{8x^2y^4}}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac1{2x^{\\frac{2}{3}}y^{\\frac{4}{3}}}$, $x\\ne0$, $y\\ne0$, using real cube roots.",
      "worked": "The denominator is nonzero when $x\\ne0$ and $y\\ne0$. Interpret powers with denominator 3 using real cube roots.\n$$\\begin{align*}\\frac1{\\sqrt[3]{8x^2y^4}}&=\\frac1{\\sqrt[3]8\\,\\sqrt[3]{x^2}\\,\\sqrt[3]{y^4}}\\\\\\frac1{\\sqrt[3]{8x^2y^4}}&=\\frac1{2x^{\\frac{2}{3}}y^{\\frac{4}{3}}}.\\end{align*}$$",
      "solutionDiagrams": []
    },
