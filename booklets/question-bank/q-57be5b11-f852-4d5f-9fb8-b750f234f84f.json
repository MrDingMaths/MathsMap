  "content": {
    "id": "p22-q16-root",
    "type": "question",
    "label": null,
    "prompt": "Solve these simultaneous equations for $(x,y)$ using the elimination method.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}2x+y&=4\\\\x+2y&=3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac53,\\frac23\\right)$",
          "worked": "Double the second equation and subtract the first.\n$$\\begin{align*}2x+4y&=6\\\\3y&=2\\\\y&=\\frac23\\\\2x+\\frac23&=4\\\\2x&=\\frac{10}{3}\\\\x&=\\frac53\\end{align*}$$\nThus $(x,y)=\\left(\\frac53,\\frac23\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p22-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}x+3y&=2\\\\3x+y&=-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-1,1)$",
          "worked": "Triple the first equation and subtract the second.\n$$\\begin{align*}3x+9y&=6\\\\8y&=8\\\\y&=1\\\\x+3(1)&=2\\\\x&=-1\\end{align*}$$\nThus $(x,y)=(-1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p22-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}2x-y&=-4\\\\-x+2y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-1,2)$",
          "worked": "Double the second equation and add the first.\n$$\\begin{align*}-2x+4y&=10\\\\3y&=6\\\\y&=2\\\\2x-2&=-4\\\\x&=-1\\end{align*}$$\nThus $(x,y)=(-1,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p22-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}4x+8y&=5\\\\5x+16y&=7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(1,\\frac18\\right)$",
          "worked": "Double the first equation and subtract the second.\n$$\\begin{align*}8x+16y&=10\\\\3x&=3\\\\x&=1\\\\4(1)+8y&=5\\\\8y&=1\\\\y&=\\frac18\\end{align*}$$\nThus $(x,y)=\\left(1,\\frac18\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p22-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}x-4y&=2\\\\-4x+y&=-23\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(6,1)$",
          "worked": "Multiply the first equation by 4 and add the second.\n$$\\begin{align*}4x-16y&=8\\\\-15y&=-15\\\\y&=1\\\\x-4(1)&=2\\\\x&=6\\end{align*}$$\nThus $(x,y)=(6,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p22-q16-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}4x+3y&=5\\\\2x+5y&=6\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac12,1\\right)$",
          "worked": "Double the second equation and subtract the first.\n$$\\begin{align*}4x+10y&=12\\\\7y&=7\\\\y&=1\\\\2x+5(1)&=6\\\\2x&=1\\\\x&=\\frac12\\end{align*}$$\nThus $(x,y)=\\left(\\frac12,1\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p22-q16-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}3x+2y&=1\\\\5x+6y&=-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,-1)$",
          "worked": "Triple the first equation and subtract the second.\n$$\\begin{align*}9x+6y&=3\\\\4x&=4\\\\x&=1\\\\3(1)+2y&=1\\\\2y&=-2\\\\y&=-1\\end{align*}$$\nThus $(x,y)=(1,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      },
      {
        "id": "p22-q16-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}-2x+5y&=11\\\\4x+3y&=4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-\\frac12,2\\right)$",
          "worked": "Double the first equation and add the second.\n$$\\begin{align*}-4x+10y&=22\\\\13y&=26\\\\y&=2\\\\4x+3(2)&=4\\\\4x&=-2\\\\x&=-\\frac12\\end{align*}$$\nThus $(x,y)=\\left(-\\frac12,2\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p22-q16-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\begin{aligned}4x+3y&=2\\\\5x-6y&=-4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(0,\\frac23\\right)$",
          "worked": "Double the first equation and add the second.\n$$\\begin{align*}8x+6y&=4\\\\13x&=0\\\\x&=0\\\\4(0)+3y&=2\\\\3y&=2\\\\y&=\\frac23\\end{align*}$$\nThus $(x,y)=\\left(0,\\frac23\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p22-q16-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\begin{aligned}2x+3y&=5\\\\3x+2y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,1)$",
          "worked": "Multiply the first equation by 3 and the second by 2, then subtract.\n$$\\begin{align*}6x+9y&=15\\\\6x+4y&=10\\\\5y&=5\\\\y&=1\\\\2x+3(1)&=5\\\\2x&=2\\\\x&=1\\end{align*}$$\nThus $(x,y)=(1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      },
      {
        "id": "p22-q16-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\begin{aligned}4x-3y&=10\\\\3x+4y&=-5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,-2)$",
          "worked": "Multiply the first equation by 4 and the second by 3, then add.\n$$\\begin{align*}16x-12y&=40\\\\9x+12y&=-15\\\\25x&=25\\\\x&=1\\\\4(1)-3y&=10\\\\-3y&=6\\\\y&=-2\\end{align*}$$\nThus $(x,y)=(1,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      },
      {
        "id": "p22-q16-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\begin{aligned}-3x-5y&=9\\\\4x-6y&=26\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(2,-3)$",
          "worked": "Multiply the first equation by 4 and the second by 3, then add.\n$$\\begin{align*}-12x-20y&=36\\\\12x-18y&=78\\\\-38y&=114\\\\y&=-3\\\\-3x-5(-3)&=9\\\\-3x&=-6\\\\x&=2\\end{align*}$$\nThus $(x,y)=(2,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      },
      {
        "id": "p22-q16-m",
        "type": "part",
        "label": "m",
        "prompt": "$$\\begin{aligned}0.5x-0.2y&=1\\\\x+0.1y&=7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(6,10)$\n\nClear decimals, then eliminate $y$.",
          "worked": "Multiply both equations by 10. Double the resulting second equation and add the first.\n$$\\begin{align*}5x-2y&=10\\\\10x+y&=70\\\\20x+2y&=140\\\\25x&=150\\\\x&=6\\\\10(6)+y&=70\\\\y&=10\\end{align*}$$\nThus $(x,y)=(6,10)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 92
      },
      {
        "id": "p22-q16-n",
        "type": "part",
        "label": "n",
        "prompt": "$$\\begin{aligned}0.2x-0.3y&=1\\\\0.4x+0.6y&=14\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(20,10)$\n\nClear decimals, then eliminate $y$.",
          "worked": "Multiply both equations by 10. Double the resulting first equation and add the second.\n$$\\begin{align*}2x-3y&=10\\\\4x+6y&=140\\\\4x-6y&=20\\\\8x&=160\\\\x&=20\\\\2(20)-3y&=10\\\\-3y&=-30\\\\y&=10\\end{align*}$$\nThus $(x,y)=(20,10)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 100
      },
      {
        "id": "p22-q16-o",
        "type": "part",
        "label": "o",
        "prompt": "$$\\begin{aligned}\\frac{x}{2}-3y&=1\\\\\\frac{x}{3}-4y&=2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-2,-\\frac23\\right)$\n\nClear denominators, then eliminate $x$.",
          "worked": "Multiply the first equation by 2 and the second by 3, then subtract the second from the first.\n$$\\begin{align*}x-6y&=2\\\\x-12y&=6\\\\6y&=-4\\\\y&=-\\frac23\\\\x-6\\left(-\\frac23\\right)&=2\\\\x+4&=2\\\\x&=-2\\end{align*}$$\nThus $(x,y)=\\left(-2,-\\frac23\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 94
      },
      {
        "id": "p22-q16-p",
        "type": "part",
        "label": "p",
        "prompt": "$$\\begin{aligned}\\frac{x}{2}+\\frac{y}{3}&=1\\\\\\frac{x}{4}+\\frac{y}{5}&=2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-28,45)$\n\nClear denominators, then eliminate $x$.",
          "worked": "Multiply the first equation by 6 and the second by 20. Multiply these resulting equations by 5 and 3 respectively, then subtract.\n$$\\begin{align*}3x+2y&=6\\\\5x+4y&=40\\\\15x+10y&=30\\\\15x+12y&=120\\\\2y&=90\\\\y&=45\\\\3x+2(45)&=6\\\\3x&=-84\\\\x&=-28\\end{align*}$$\nThus $(x,y)=(-28,45)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 116
      }
    ]
