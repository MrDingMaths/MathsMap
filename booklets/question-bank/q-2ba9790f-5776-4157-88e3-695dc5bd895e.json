  "content": {
    "id": "p20-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The curve $f(x)=ax^2+4x+c$ has a turning point at $(-1,1)$. Find $a$ and $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=2,\\ c=3$.",
      "worked": "$$\\begin{align*}f'(x)&=2ax+4\\\\f(-1)&=a-4+c=1\\\\f'(-1)&=-2a+4=0\\\\2a&=4\\\\a&=2\\end{align*}$$\nSubstituting $a=2$ into the point condition:\n$$\\begin{align*}2-4+c&=1\\\\c&=3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
