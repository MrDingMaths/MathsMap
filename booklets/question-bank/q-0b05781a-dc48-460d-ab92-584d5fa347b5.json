  "content": {
    "id": "p16-review-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Given that $a\\propto b^2$, what is the effect on $a$ when $b$ is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-review-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "increased by 5%?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a$ is increased by $10.25\\%$.",
          "worked": "Since $a=kb^2$, take the original value $b=1$, giving $a=k$. Increasing $b$ by $5\\%$ gives $b=1.05$.\n$$\\begin{align*}a&=k(1.05)^2\\\\a&=1.1025k\\end{align*}$$\nThe new value is $110.25\\%$ of the original, so $a$ increases by $10.25\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p16-review-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "decreased by 8%?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a$ is decreased by $15.36\\%$.",
          "worked": "Since $a=kb^2$, take the original value $b=1$, giving $a=k$. Decreasing $b$ by $8\\%$ gives $b=0.92$.\n$$\\begin{align*}a&=k(0.92)^2\\\\a&=0.8464k\\end{align*}$$\nThe new value is $84.64\\%$ of the original, so $a$ decreases by $100\\%-84.64\\%=15.36\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
