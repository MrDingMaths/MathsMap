  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Let $m>0$. Consider the two lines sketched below. The equations of these lines are $y=mx$ and $y=-\\frac{1}{m}x$. Point $A$ is located on the first line, and point $B$ is located on the second line. Let $O$ denote the origin.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p17-q9-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 17 p17-q9-diagram\"}\n\\begin{tikzpicture}[x=1.5cm,y=1.5cm,line cap=round,line join=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.5pt,->] (-2.5,0)--(2.5,0) node[right] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-2.5)--(0,2.5) node[above] {$y$};\n\\draw[black,line width=0.8pt] (-1.35,-2.7)--(1.35,2.7);\n\\draw[black,line width=0.8pt] (-2.5,1.25)--(2.5,-1.25);\n\\fill[black] (1,2) circle (1.2pt) node[right] {$A(1,m)$};\n\\fill[black] (1,-0.5) circle (1.2pt);\n\\node[below] at (1,-1) {$B\\left(1,-\\frac{1}{m}\\right)$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 63.4,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 17,
          "sourceRegion": "Question 9 coordinate sketch",
          "description": "Unscaled schematic of two lines through the origin. Both marked points have x-coordinate 1; A lies above the x-axis and B below it. No grid, ticks, AB segment or right-angle marker. The origin label O is omitted under the graph house convention.",
          "mathematics": "The lines are y=mx and y=-x/m, with m>0. Illustrative geometry uses m=2 without printing a numerical value or axis scale.",
          "answerVisibility": "Only supplied points, labels, axes and lines are visible."
