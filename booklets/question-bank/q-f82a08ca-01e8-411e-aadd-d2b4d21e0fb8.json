    ],
    "children": [
      {
        "id": "p17-q9-a",
        "type": "group",
        "label": "a",
        "prompt": "Find each of the following lengths:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q9-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$OA$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt{1+m^2}$",
              "worked": "Using Pythagoras' theorem,\n$$\\begin{align*}OA^2&=1^2+m^2\\\\OA^2&=1+m^2\\\\OA&=\\sqrt{1+m^2}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          },
          {
            "id": "p17-q9-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$OB$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt{\\frac{1+m^2}{m^2}}$",
              "worked": "Using Pythagoras' theorem,\n$$\\begin{align*}OB^2&=1^2+\\left(\\frac{1}{m}\\right)^2\\\\OB^2&=1+\\frac{1}{m^2}\\\\OB^2&=\\frac{1+m^2}{m^2}\\\\OB&=\\sqrt{\\frac{1+m^2}{m^2}}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 56
          },
          {
            "id": "p17-q9-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$AB$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{m^2+1}{m}$",
              "worked": "$A$ and $B$ have the same x-coordinate, so $AB$ is their vertical separation. Since $m>0$,\n$$\\begin{align*}AB&=m-\\left(-\\frac{1}{m}\\right)\\\\AB&=m+\\frac{1}{m}\\\\AB&=\\frac{m^2+1}{m}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 62
          }
        ]
      },
      {
        "id": "p17-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, using the converse of the Pythagorean Theorem, show that these two lines cross at right-angles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$OA^2+OB^2=\\frac{(m^2+1)^2}{m^2}=AB^2$.\n\nBy the converse of Pythagoras' theorem, $\\angle AOB=90^\\circ$, so the lines cross at right angles.",
          "worked": "$$\\begin{align*}OA^2+OB^2&=\\left(\\sqrt{1+m^2}\\right)^2+\\left(\\sqrt{\\frac{1+m^2}{m^2}}\\right)^2\\\\OA^2+OB^2&=1+m^2+\\frac{1+m^2}{m^2}\\\\OA^2+OB^2&=\\frac{m^2(1+m^2)+1+m^2}{m^2}\\\\OA^2+OB^2&=\\frac{m^4+2m^2+1}{m^2}\\\\OA^2+OB^2&=\\frac{(m^2+1)^2}{m^2}\\\\OA^2+OB^2&=AB^2.\\end{align*}$$\nBy the converse of Pythagoras' theorem, triangle $AOB$ is right-angled at $O$. The two lines therefore cross at right angles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      }
    ]
  },
