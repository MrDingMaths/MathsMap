  "content": {
    "id": "v2-5021a0-p9-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "A rectangular prism cabinet measures $0.6$ m by $0.9$ m by $2$ m.\nTariq paints all the faces of the cabinet.\nOne tin of paint costs $\\$14$. Each tin covers $3\\text{ m}^2$.\nWork out the total cost of the paint that Tariq needs.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$42$",
      "worked": "$$\\begin{align*}A&=2(0.6\\times0.9)+2(0.6\\times2)+2(0.9\\times2)\\\\&=1.08+2.4+3.6\\\\&=7.08\\text{ m}^2\\\\\\text{Tins required}&=7.08\\div3\\\\&=2.36\\end{align*}$$\nTariq needs $3$ whole tins.\n$$\\begin{align*}\\text{Cost}&=\\$14\\times3\\\\&=\\$42\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
