  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^{2m}\\times3^{-m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^m$",
          "worked": "$$\\begin{align*}3^{2m}\\times3^{-m}&=3^{2m+(-m)}\\\\3^{2m}\\times3^{-m}&=3^m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\times5^{-m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{1-m}$",
          "worked": "$$\\begin{align*}5\\times5^{-m}&=5^{1+(-m)}\\\\5\\times5^{-m}&=5^{1-m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^{-m}\\times2^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{n-m}$",
          "worked": "$$\\begin{align*}2^{-m}\\times2^n&=2^{-m+n}\\\\2^{-m}\\times2^n&=2^{n-m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$2^m\\times2^{-m}\\times2^m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^m$",
          "worked": "$$\\begin{align*}2^m\\times2^{-m}\\times2^m&=2^{m-m+m}\\\\2^m\\times2^{-m}\\times2^m&=2^m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$(5^{-m})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{-2m}$",
          "worked": "$$\\begin{align*}(5^{-m})^2&=5^{(-m)\\times2}\\\\(5^{-m})^2&=5^{-2m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$(3^{-m})^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{2m}$",
          "worked": "$$\\begin{align*}(3^{-m})^{-2}&=3^{(-m)\\times(-2)}\\\\(3^{-m})^{-2}&=3^{2m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$(7^m\\times7^m)^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{-2m}$",
          "worked": "$$\\begin{align*}(7^m\\times7^m)^{-1}&=(7^{2m})^{-1}\\\\(7^m\\times7^m)^{-1}&=7^{2m\\times(-1)}\\\\(7^m\\times7^m)^{-1}&=7^{-2m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{2^m}{2^{-m}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{2m}$",
          "worked": "$$\\begin{align*}\\frac{2^m}{2^{-m}}&=2^{m-(-m)}\\\\\\frac{2^m}{2^{-m}}&=2^{2m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{3^{-m}}{3^m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{-2m}$",
          "worked": "$$\\begin{align*}\\frac{3^{-m}}{3^m}&=3^{-m-m}\\\\\\frac{3^{-m}}{3^m}&=3^{-2m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{5^{-m}\\times5^{2m}}{5^m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{5^{-m}\\times5^{2m}}{5^m}&=5^{-m+2m-m}\\\\\\frac{5^{-m}\\times5^{2m}}{5^m}&=5^0\\\\\\frac{5^{-m}\\times5^{2m}}{5^m}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p7-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{2^m\\times2^m}{2^{-m}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{3m}$",
          "worked": "$$\\begin{align*}\\frac{2^m\\times2^m}{2^{-m}}&=2^{m+m-(-m)}\\\\\\frac{2^m\\times2^m}{2^{-m}}&=2^{3m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\left(\\dfrac{3^m}{3^n}\\right)^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{n-m}$",
          "worked": "$$\\begin{align*}\\left(\\frac{3^m}{3^n}\\right)^{-1}&=(3^{m-n})^{-1}\\\\\\left(\\frac{3^m}{3^n}\\right)^{-1}&=3^{-(m-n)}\\\\\\left(\\frac{3^m}{3^n}\\right)^{-1}&=3^{n-m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
