    "children": [
      {
        "id": "p10-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "By writing $\\sec x$ as $(\\cos x)^{-1}$, show that $\\dfrac{d}{dx}(\\sec x)=\\sec x\\tan x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(\\sec x)=\\dfrac{\\sin x}{\\cos^2x}=\\sec x\\tan x$.",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}(\\sec x)&=-(\\cos x)^{-2}(-\\sin x)\\\\&=\\frac{\\sin x}{\\cos^2x}\\\\&=\\left(\\frac{1}{\\cos x}\\right)\\left(\\frac{\\sin x}{\\cos x}\\right)\\\\&=\\sec x\\tan x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Similarly, show that $\\dfrac{d}{dx}(\\operatorname{cosec}x)=-\\operatorname{cosec}x\\cot x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(\\operatorname{cosec}x)=-\\dfrac{\\cos x}{\\sin^2x}=-\\operatorname{cosec}x\\cot x$.",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}(\\operatorname{cosec}x)&=-(\\sin x)^{-2}(\\cos x)\\\\&=-\\frac{\\cos x}{\\sin^2x}\\\\&=-\\left(\\frac{1}{\\sin x}\\right)\\left(\\frac{\\cos x}{\\sin x}\\right)\\\\&=-\\operatorname{cosec}x\\cot x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Similarly, show that $\\dfrac{d}{dx}(\\cot x)=-\\operatorname{cosec}^2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(\\cot x)=-\\dfrac{1}{\\sin^2x}=-\\operatorname{cosec}^2x$.",
          "worked": "Using $\\cot x=\\dfrac{\\cos x}{\\sin x}$ and the quotient rule:\n$$\\begin{aligned}\\frac{d}{dx}(\\cot x)&=\\frac{\\sin x(-\\sin x)-\\cos x(\\cos x)}{\\sin^2x}\\\\&=\\frac{-\\sin^2x-\\cos^2x}{\\sin^2x}\\\\&=-\\frac{1}{\\sin^2x}\\\\&=-\\operatorname{cosec}^2x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
