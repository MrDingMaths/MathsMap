  "content": {
    "id": "p4-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Let $f(x)=x^2-3x$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}f(3)&=3^2-3(3)\\\\f(3)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "the image of $2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}f(2)&=2^2-3(2)\\\\f(2)&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(2a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a(2a-3)$",
          "worked": "$$\\begin{align*}f(2a)&=(2a)^2-3(2a)\\\\f(2a)&=4a^2-6a\\\\f(2a)&=2a(2a-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$f\\left(\\dfrac1a\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1-3a}{a^2}$, $a\\ne0$",
          "worked": "For $a\\ne0$:\n$$\\begin{align*}f\\left(\\frac1a\\right)&=\\left(\\frac1a\\right)^2-3\\left(\\frac1a\\right)\\\\f\\left(\\frac1a\\right)&=\\frac1{a^2}-\\frac3a\\\\f\\left(\\frac1a\\right)&=\\frac{1-3a}{a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p4-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$x$ given $f(x)=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,4$",
          "worked": "$$\\begin{align*}x^2-3x&=4\\\\x^2-3x-4&=0\\\\(x-4)(x+1)&=0\\\\x&=-1,4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$x$ given $f(x)=18$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,6$",
          "worked": "$$\\begin{align*}x^2-3x&=18\\\\x^2-3x-18&=0\\\\(x-6)(x+3)&=0\\\\x&=-3,6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
