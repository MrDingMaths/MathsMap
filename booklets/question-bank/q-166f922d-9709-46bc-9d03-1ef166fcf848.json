  "content": {
    "id": "p17-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Where necessary, give percentages to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "A table originally priced at $\\$370$ was increased in price by $100\\%$. What percentage discount will restore it to its original price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\%$",
          "worked": "$$\\begin{align*}\\text{New price}&=370\\times2=\\$740\\\\\\text{Original as a percentage of new}&=\\frac{370}{740}\\times100\\%=50\\%\\\\\\text{Discount}&=100\\%-50\\%=50\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "The number of daily passengers on the Jarrabine ferry-bus was $156$, and in one year it increased by $25\\%$. What percentage decrease next year would restore the number of passengers to its original value?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\%$",
          "worked": "$$\\begin{align*}\\text{New passenger number}&=156\\times1.25=195\\\\\\text{Original as a percentage of new}&=\\frac{156}{195}\\times100\\%=80\\%\\\\\\text{Decrease}&=100\\%-80\\%=20\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Thien had savings of $\\$15\\,000$, but he spent $45\\%$ of this last year. By what percentage of the new amount must he increase his savings to restore them to their original value?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81.8\\%$\n\nUse the remaining savings as the percentage base.",
          "worked": "$$\\begin{align*}\\text{Remaining savings}&=15\\,000\\times0.55=\\$8250\\\\\\text{Original as a percentage of remaining}&=\\frac{15\\,000}{8250}\\times100\\%\\\\\\text{Required increase}&=\\left(\\frac{15\\,000}{8250}-1\\right)\\times100\\%\\\\\\text{Required increase}&\\approx81.8\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p17-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "The profit of the Audry Goldfish Guild last year was $\\$3650$, but this year it decreased by $42\\%$. By what percentage must the profit increase next year to restore it to its original value?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$72.4\\%$\n\nUse this year’s profit as the percentage base.",
          "worked": "$$\\begin{align*}\\text{This year's profit}&=3650\\times0.58=\\$2117\\\\\\text{Original as a percentage of current}&=\\frac{3650}{2117}\\times100\\%\\\\\\text{Required increase}&=\\left(\\frac{3650}{2117}-1\\right)\\times100\\%\\\\\\text{Required increase}&\\approx72.4\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
