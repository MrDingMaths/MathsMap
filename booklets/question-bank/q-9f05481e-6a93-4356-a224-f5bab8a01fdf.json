            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}0&=3000(1.22)^5-M\\left[\\frac{1.22^5-1}{1.22-1}\\right]\\\\M\\left[\\frac{1.22^5-1}{0.22}\\right]&=3000(1.22)^5\\\\M&=\\frac{3000(1.22)^5(0.22)}{1.22^5-1}\\\\M&\\approx\\$1047.62\\end{aligned}",
