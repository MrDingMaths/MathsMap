  "content": {
    "id": "p46-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "An amount of $\\$3000$ is borrowed at 22% p.a. and paid off over 5 years with yearly repayments. How much is each repayment? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
