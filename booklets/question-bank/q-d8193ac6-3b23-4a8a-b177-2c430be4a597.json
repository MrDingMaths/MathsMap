  "content": {
    "id": "p25-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Use the addition rule $P(A\\cup B)=P(A)+P(B)-P(A\\cap B)$ to answer the following questions.\n\nDrawing a Venn diagram helps.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "If $P(A)=\\frac{1}{5}$, $P(B)=\\frac{1}{3}$ and $P(A\\cap B)=\\frac{1}{15}$, find $P(A\\cup B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{15}$",
          "worked": "$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=\\frac{1}{5}+\\frac{1}{3}-\\frac{1}{15}\\\\P(A\\cup B)&=\\frac{7}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If $P(A)=\\frac{1}{2}$, $P(B)=\\frac{1}{3}$ and $P(A\\cup B)=\\frac{5}{6}$, find $P(A\\cap B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}P(A\\cap B)&=P(A)+P(B)-P(A\\cup B)\\\\P(A\\cap B)&=\\frac{1}{2}+\\frac{1}{3}-\\frac{5}{6}\\\\P(A\\cap B)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "If $P(A\\cup B)=\\frac{9}{10}$, $P(A\\cap B)=\\frac{1}{5}$ and $P(A)=\\frac{1}{2}$, find $P(B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "$$\\begin{align*}P(B)&=P(A\\cup B)-P(A)+P(A\\cap B)\\\\P(B)&=\\frac{9}{10}-\\frac{1}{2}+\\frac{1}{5}\\\\P(B)&=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "If $A$ and $B$ are mutually exclusive and $P(A)=\\frac{1}{7}$ and $P(B)=\\frac{4}{7}$, find $P(A\\cup B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{7}$",
          "worked": "Since $A$ and $B$ are mutually exclusive, $P(A\\cap B)=0$.\n\n$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=\\frac{1}{7}+\\frac{4}{7}-0\\\\P(A\\cup B)&=\\frac{5}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Find $P(A\\cap B')$ when $P(A\\cup B)=0.8$, $P(A)=0.5$ and $P(B)=0.4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\0.8&=0.5+0.4-P(A\\cap B)\\\\P(A\\cap B)&=0.1\\end{align*}$$\n\n$$\\begin{align*}P(A\\cap B')&=P(A)-P(A\\cap B)\\\\P(A\\cap B')&=0.5-0.1\\\\P(A\\cap B')&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p25-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "Find $P(A'\\cap B)$ when $P(A\\cup B)=0.76$, $P(A)=0.31$ and $P(B)=0.59$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.45$",
          "worked": "$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\0.76&=0.31+0.59-P(A\\cap B)\\\\P(A\\cap B)&=0.14\\end{align*}$$\n\n$$\\begin{align*}P(A'\\cap B)&=P(B)-P(A\\cap B)\\\\P(A'\\cap B)&=0.59-0.14\\\\P(A'\\cap B)&=0.45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
