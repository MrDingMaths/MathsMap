    "children": [
      {
        "id": "p9-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+4x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2+\\sqrt5)(x+2-\\sqrt5)$",
          "worked": "$$\\begin{align*}x^2+4x-1&=x^2+4x+4-4-1\\\\x^2+4x-1&=(x+2)^2-5\\\\x^2+4x-1&=(x+2)^2-(\\sqrt5)^2\\\\x^2+4x-1&=(x+2+\\sqrt5)(x+2-\\sqrt5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p9-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+2x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1+\\sqrt3)(x+1-\\sqrt3)$",
          "worked": "$$\\begin{align*}x^2+2x-2&=x^2+2x+1-1-2\\\\x^2+2x-2&=(x+1)^2-3\\\\x^2+2x-2&=(x+1)^2-(\\sqrt3)^2\\\\x^2+2x-2&=(x+1+\\sqrt3)(x+1-\\sqrt3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p9-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-6x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3+2\\sqrt2)(x-3-2\\sqrt2)$",
          "worked": "$$\\begin{align*}x^2-6x+1&=x^2-6x+9-9+1\\\\x^2-6x+1&=(x-3)^2-8\\\\x^2-6x+1&=(x-3)^2-(2\\sqrt2)^2\\\\x^2-6x+1&=(x-3+2\\sqrt2)\\\\&\\quad\\times(x-3-2\\sqrt2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p9-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+5x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac52-\\frac{\\sqrt{17}}2\\right)\\left(x+\\frac52+\\frac{\\sqrt{17}}2\\right)$",
          "worked": "$$\\begin{align*}x^2+5x+2&=x^2+5x+\\frac{25}{4}-\\frac{25}{4}+2\\\\x^2+5x+2&=\\left(x+\\frac52\\right)^2-\\frac{17}{4}\\\\x^2+5x+2&=\\left(x+\\frac52\\right)^2-\\left(\\frac{\\sqrt{17}}2\\right)^2\\\\x^2+5x+2&=\\left(x+\\frac52-\\frac{\\sqrt{17}}2\\right)\\\\&\\quad\\times\\left(x+\\frac52+\\frac{\\sqrt{17}}2\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
