  "content": {
    "id": "p32-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Express each with a common denominator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x}{x-2}-\\dfrac{3}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2-x+6}{(x-2)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{x}{x-2}-\\frac{3}{x+2}&=\\frac{x(x+2)-3(x-2)}{(x-2)(x+2)}\\\\\\frac{x}{x-2}-\\frac{3}{x+2}&=\\frac{x^2+2x-3x+6}{(x-2)(x+2)}\\\\\\frac{x}{x-2}-\\frac{3}{x+2}&=\\frac{x^2-x+6}{(x-2)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2x-3}{3x-9}-\\dfrac{x-2}{2x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{6(x-3)}$",
          "worked": "$$\\begin{align*}\\frac{2x-3}{3x-9}-\\frac{x-2}{2x-6}&=\\frac{2x-3}{3(x-3)}-\\frac{x-2}{2(x-3)}\\\\\\frac{2x-3}{3x-9}-\\frac{x-2}{2x-6}&=\\frac{2(2x-3)-3(x-2)}{6(x-3)}\\\\\\frac{2x-3}{3x-9}-\\frac{x-2}{2x-6}&=\\frac{4x-6-3x+6}{6(x-3)}\\\\\\frac{2x-3}{3x-9}-\\frac{x-2}{2x-6}&=\\frac{x}{6(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p32-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{4}{x+3}+\\dfrac{12}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4x}{x^2-9}$",
          "worked": "$$\\begin{align*}\\frac{4}{x+3}+\\frac{12}{x^2-9}&=\\frac{4}{x+3}+\\frac{12}{(x-3)(x+3)}\\\\\\frac{4}{x+3}+\\frac{12}{x^2-9}&=\\frac{4(x-3)+12}{(x-3)(x+3)}\\\\\\frac{4}{x+3}+\\frac{12}{x^2-9}&=\\frac{4x}{x^2-9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x+3}{x+2}-\\dfrac{x+2}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+5}{(x+2)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{x+2}-\\frac{x+2}{x+3}&=\\frac{(x+3)^2-(x+2)^2}{(x+2)(x+3)}\\\\\\frac{x+3}{x+2}-\\frac{x+2}{x+3}&=\\frac{x^2+6x+9-(x^2+4x+4)}{(x+2)(x+3)}\\\\\\frac{x+3}{x+2}-\\frac{x+2}{x+3}&=\\frac{2x+5}{(x+2)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1}{x^2-4}-\\dfrac{1}{x^2+2x-8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{(x-2)(x+2)(x+4)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x^2-4}-\\frac{1}{x^2+2x-8}&=\\frac{1}{(x-2)(x+2)}-\\frac{1}{(x-2)(x+4)}\\\\\\frac{1}{x^2-4}-\\frac{1}{x^2+2x-8}&=\\frac{(x+4)-(x+2)}{(x-2)(x+2)(x+4)}\\\\\\frac{1}{x^2-4}-\\frac{1}{x^2+2x-8}&=\\frac{2}{(x-2)(x+2)(x+4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p32-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x}{x^2-4x+3}-\\dfrac{2}{x^2-x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2+2}{(x-1)(x-3)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{x}{x^2-4x+3}-\\frac{2}{x^2-x-6}&=\\frac{x}{(x-1)(x-3)}-\\frac{2}{(x-3)(x+2)}\\\\\\frac{x}{x^2-4x+3}-\\frac{2}{x^2-x-6}&=\\frac{x(x+2)-2(x-1)}{(x-1)(x-3)(x+2)}\\\\\\frac{x}{x^2-4x+3}-\\frac{2}{x^2-x-6}&=\\frac{x^2+2x-2x+2}{(x-1)(x-3)(x+2)}\\\\\\frac{x}{x^2-4x+3}-\\frac{2}{x^2-x-6}&=\\frac{x^2+2}{(x-1)(x-3)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p32-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{1}{x-1}+\\dfrac{2}{x^2+2x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+5}{(x-1)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x-1}+\\frac{2}{x^2+2x-3}&=\\frac{1}{x-1}+\\frac{2}{(x-1)(x+3)}\\\\\\frac{1}{x-1}+\\frac{2}{x^2+2x-3}&=\\frac{x+3+2}{(x-1)(x+3)}\\\\\\frac{1}{x-1}+\\frac{2}{x^2+2x-3}&=\\frac{x+5}{(x-1)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{1}{x-2}-\\dfrac{7}{2x^2-x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{2x+3}$",
          "worked": "$$\\begin{align*}\\frac{1}{x-2}-\\frac{7}{2x^2-x-6}&=\\frac{1}{x-2}-\\frac{7}{(x-2)(2x+3)}\\\\\\frac{1}{x-2}-\\frac{7}{2x^2-x-6}&=\\frac{2x+3-7}{(x-2)(2x+3)}\\\\\\frac{1}{x-2}-\\frac{7}{2x^2-x-6}&=\\frac{2(x-2)}{(x-2)(2x+3)}\\\\\\frac{1}{x-2}-\\frac{7}{2x^2-x-6}&=\\frac{2}{2x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p32-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{a-2}{a^2-3a+4}-\\dfrac{a-1}{a^2-a-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^2-7a+8}{(a^2-3a+4)(a+1)(a-2)}$\n\nFactor the second denominator, then combine over the product of the distinct factors.",
          "worked": "$$\\begin{align*}\\frac{a-2}{a^2-3a+4}-\\frac{a-1}{a^2-a-2}&=\\frac{a-2}{a^2-3a+4}-\\frac{a-1}{(a-2)(a+1)}\\\\\\frac{a-2}{a^2-3a+4}-\\frac{a-1}{a^2-a-2}&=\\frac{(a-2)^2(a+1)-(a-1)(a^2-3a+4)}{(a^2-3a+4)(a-2)(a+1)}\\\\\\frac{a-2}{a^2-3a+4}-\\frac{a-1}{a^2-a-2}&=\\frac{a^3-3a^2+4-(a^3-4a^2+7a-4)}{(a^2-3a+4)(a-2)(a+1)}\\\\\\frac{a-2}{a^2-3a+4}-\\frac{a-1}{a^2-a-2}&=\\frac{a^2-7a+8}{(a^2-3a+4)(a-2)(a+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      }
    ]
  },
