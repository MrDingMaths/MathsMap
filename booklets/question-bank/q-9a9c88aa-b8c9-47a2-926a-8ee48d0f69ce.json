        "id": "p86-q9-relative-frequency",
        "type": "part",
        "label": "a",
        "prompt": "What is the relative frequency of the 51–55 year retirement age?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{400}=0.0175$, or $1.75\\%$. Divide the class frequency by the total.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p86-q9-relative-frequency-worked-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\text{Relative frequency}&=\\frac{\\text{frequency}}{\\text{total}}\\\\\\text{Relative frequency}&=\\frac{35000}{2000000}\\\\\\text{Relative frequency}&=\\frac{7}{400}\\\\\\text{Relative frequency}&=0.0175\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p86-q9-relative-frequency-worked-percentage",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "This is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "1.75\\%",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
