  "content": {
    "id": "p12-q39-root",
    "type": "question",
    "label": "39",
    "prompt": "Find the value of $n$ such that the coefficients of $x^5$ and $x^6$ are equal in the expansion of $(1+x)^n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=11$.\n\nEquate $\\binom{n}{5}$ and $\\binom{n}{6}$.",
      "worked": "The coefficients of $x^5$ and $x^6$ are $\\binom{n}{5}$ and $\\binom{n}{6}$. Thus\n$$\\begin{align*}\\binom{n}{5}&=\\binom{n}{6}\\\\\\frac{n!}{5!(n-5)!}&=\\frac{n!}{6!(n-6)!}\\\\6!(n-6)!&=5!(n-5)!\\\\6&=n-5\\\\n&=11.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
