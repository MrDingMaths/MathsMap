  "content": {
    "id": "p57-q6-root",
    "type": "question",
    "label": null,
    "prompt": "Draw up a table of values for $y=\\dfrac{|x|}{x}$, and explain whether the function is continuous at $x=0$. Sketch the curve, and write down its domain and range.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Not continuous at $x=0$. Domain: $\\mathbb R\\setminus\\{0\\}$. Range: $\\{-1,1\\}$. The graph has $y=-1$ for $x<0$ and $y=1$ for $x>0$, with open endpoints at $x=0$.",
