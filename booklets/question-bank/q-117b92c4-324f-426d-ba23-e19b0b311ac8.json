  "content": {
    "id": "v2-e5d47-p53-practice-j4-130426-root",
    "type": "question",
    "label": null,
    "prompt": "The number of bacteria $N$ in a culture grows at a rate proportional to $N$:\n$$\\frac{dN}{dt}=kN,$$\nwhere $t$ is the time in hours and $k$ is an unknown constant. There are 600 bacteria after 1 hour and 1350 bacteria after 3 hours.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-e5d47-p53-practice-j4-130426-j4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution of this DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$N=Ae^{kt}$.",
          "worked": "$$\\begin{align*}\\frac{dN}{N}&=k\\,dt\\\\\\ln|N|&=kt+C\\\\N&=Ae^{kt}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-e5d47-p53-practice-j4-130426-j4-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute both data points into the solution, then divide one equation by the other to find $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\ln\\left(\\frac32\\right)$.",
          "worked": "$$\\begin{align*}Ae^{k}&=600\\qquad(1)\\\\Ae^{3k}&=1350\\qquad(2)\\end{align*}$$\nDividing (2) by (1):\n$$\\begin{align*}e^{2k}&=\\frac{1350}{600}\\\\e^{2k}&=\\frac94\\\\2k&=\\ln\\frac94\\\\k&=\\ln\\frac32.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-e5d47-p53-practice-j4-130426-j4-c",
        "type": "part",
        "label": "c",
        "prompt": "Use equation (1) to find $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=400$.",
          "worked": "$$\\begin{align*}Ae^{\\ln(3/2)}&=600\\\\\\frac32A&=600\\\\A&=400.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-e5d47-p53-practice-j4-130426-j4-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the number of bacteria after 5 hours, to the nearest whole number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3038$ bacteria.",
          "worked": "$$\\begin{align*}N&=400e^{t\\ln(3/2)}\\\\N&=400\\left(\\frac32\\right)^t\\\\N(5)&=400\\left(\\frac32\\right)^5\\\\&=3037.5\\\\&\\approx3038.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
