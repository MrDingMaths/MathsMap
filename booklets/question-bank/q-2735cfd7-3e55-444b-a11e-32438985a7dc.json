    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Taxable income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$118 740",
          "worked": "$$\\begin{align*}\\text{Gross income} &= 122\\,400 + 1500 + 2140 \\\\\\text{Gross income} &= \\$126\\,040 \\\\\\text{Allowable deductions} &= 2900 + 4400 \\\\\\text{Allowable deductions} &= \\$7300 \\\\\\text{Taxable income} &= 126\\,040 - 7300 \\\\\\text{Taxable income} &= \\$118\\,740\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p54-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Income tax payable. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$29 057.50; third tax bracket.",
          "worked": "The taxable income of \\$118 740 is in the third tax bracket, \\$45 001–\\$120 000.\n\n$$\\begin{align*}\\text{Excess} &= 118\\,740 - 45\\,000 \\\\\\text{Excess} &= \\$73\\,740 \\\\\\text{Tax payable} &= \\text{Base tax} + \\text{Tax rate}\\times\\text{Excess} \\\\\\text{Tax payable} &= 5092 + 0.325\\times73\\,740 \\\\\\text{Tax payable} &= \\$29\\,057.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
