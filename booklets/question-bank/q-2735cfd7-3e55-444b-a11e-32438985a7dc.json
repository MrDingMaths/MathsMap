          "inlines": [
            {
              "type": "text",
              "text": "Vivienne earns $122 400 per year from her job, $1500 interest from savings, and $2140 from share dividends. She has allowable tax deductions of $2900 for a comfy office chair and $4400 in other allowable tax deductions. Calculate:",
              "marks": []
