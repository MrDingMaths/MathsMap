  "content": {
    "id": "p17-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Two of the roots of $x^3-2x^2-9x+18=0$ sum to zero.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q7a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p17-q7a-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Since two of the roots sum to zero, we can let the roots be ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$\\alpha$",
                  "width": 8
                },
                {
                  "type": "text",
                  "text": ", ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$-\\alpha$",
                  "width": 9
                },
                {
                  "type": "text",
                  "text": ", and ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\beta",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha,-\\alpha$",
          "worked": "Opposite roots sum to zero: $\\alpha+(-\\alpha)=0$. The roots can therefore be $\\alpha,-\\alpha,\\beta$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p17-q7b",
        "type": "part",
        "label": "b",
        "prompt": "Use the sum of roots to show that $\\beta=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\beta=2$",
          "worked": "$$\\begin{align*}\\alpha+(-\\alpha)+\\beta&=-\\frac{-2}{1}\\\\\\beta&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q7c",
        "type": "part",
        "label": "c",
        "prompt": "If one of the roots is $2$, write the corresponding linear factor.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2$",
          "worked": "A root of $2$ corresponds to the linear factor $x-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p17-q7d",
        "type": "part",
        "label": "d",
        "prompt": "Using long division, or otherwise, completely factorise $x^3-2x^2-9x+18=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(x-3)(x+3)=0$",
          "worked": "By grouping,\n$$\\begin{align*}x^3-2x^2-9x+18&=x^2(x-2)-9(x-2)\\\\&=(x-2)(x^2-9)\\\\&=(x-2)(x-3)(x+3).\\end{align*}$$\nHence the equation is $(x-2)(x-3)(x+3)=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p17-q7e",
        "type": "part",
        "label": "e",
        "prompt": "Hence, find all the roots of $x^3-2x^2-9x+18=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3,2,3$",
          "worked": "$$(x-2)(x-3)(x+3)=0.$$\nBy the zero-product property, $x=2$, $x=3$ or $x=-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
