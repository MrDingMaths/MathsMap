  "content": {
    "id": "p21-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Using the digits 1, 2, 3 and 4 once, find all four-digit numbers that are divisible by 11.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1243,\\ 1342,\\ 2134,\\ 2431,\\ 3124,\\ 3421,\\ 4213,\\ 4312$",
      "worked": "For digits $a,b,c,d$, divisibility by 11 requires $a-b+c-d$ to be a multiple of 11. The possible difference lies between $-4$ and $4$, so it must be 0. Thus the two alternating-position sums are equal. Since the total digit sum is 10, each sum must be 5. The pairs are $\\{1,4\\}$ and $\\{2,3\\}$. Put either pair in the first and third positions, and arrange each pair in either order. This gives exactly eight numbers:\n\n$1243,\\ 1342,\\ 2134,\\ 2431,\\ 3124,\\ 3421,\\ 4213,\\ 4312$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
