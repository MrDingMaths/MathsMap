  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $y'=\\dfrac{1}{x(1-x)}$, where $y\\left(\\dfrac12\\right)=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{1}{x(1-x)}=\\dfrac1x+\\dfrac{1}{1-x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1x+\\dfrac{1}{1-x}=\\dfrac{1-x+x}{x(1-x)}=\\dfrac{1}{x(1-x)}$.",
          "worked": "$$\\begin{align*}\\text{RHS}&=\\frac1x+\\frac{1}{1-x}\\\\&=\\frac{1-x+x}{x(1-x)}\\\\&=\\frac{1}{x(1-x)}=\\text{LHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the general solution of the DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln\\left|\\dfrac{x}{1-x}\\right|+C$.",
          "worked": "$$\\begin{align*}y&=\\int\\left(\\frac1x+\\frac{1}{1-x}\\right)\\,dx\\\\&=\\ln|x|-\\ln|1-x|+C\\\\&=\\ln\\left|\\frac{x}{1-x}\\right|+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence solve the IVP.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln\\left(\\dfrac{x}{1-x}\\right)$, $0<x<1$.",
          "worked": "Substitute $y\\left(\\dfrac12\\right)=0$:\n$$\\begin{align*}0&=\\ln|1|+C\\\\C&=0\\\\y&=\\ln\\left(\\frac{x}{1-x}\\right),\\qquad 0<x<1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
