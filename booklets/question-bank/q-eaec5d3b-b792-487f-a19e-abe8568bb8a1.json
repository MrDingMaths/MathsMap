  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "By using the rule $x=-\\dfrac{b}{2a}$, find the coordinates of the turning point of the graphs whose equations are:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,2)$",
          "worked": "$$\\begin{align*}x&=-\\frac{2}{2(1)}\\\\x&=-1\\\\y&=(-1)^2+2(-1)+3\\\\y&=2\\end{align*}$$\nThe turning point is $(-1,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2x^2-4x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,0)$",
          "worked": "$$\\begin{align*}x&=-\\frac{-4}{2(2)}\\\\x&=1\\\\y&=2(1)^2-4(1)+2\\\\y&=0\\end{align*}$$\nThe turning point is $(1,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2x^2+3x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\dfrac34,\\dfrac{23}{8}\\right)$",
          "worked": "$$\\begin{align*}x&=-\\frac{3}{2(2)}\\\\x&=-\\frac34\\\\y&=2\\left(-\\frac34\\right)^2+3\\left(-\\frac34\\right)+4\\\\y&=\\frac98-\\frac{18}{8}+\\frac{32}{8}\\\\y&=\\frac{23}{8}\\end{align*}$$\nThe turning point is $\\left(-\\frac34,\\frac{23}{8}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=3x^2-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\dfrac23,-\\dfrac43\\right)$",
          "worked": "$$\\begin{align*}x&=-\\frac{-4}{2(3)}\\\\x&=\\frac23\\\\y&=3\\left(\\frac23\\right)^2-4\\left(\\frac23\\right)\\\\y&=\\frac43-\\frac83\\\\y&=-\\frac43\\end{align*}$$\nThe turning point is $\\left(\\frac23,-\\frac43\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=-3x^2-6x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,4)$",
          "worked": "$$\\begin{align*}x&=-\\frac{-6}{2(-3)}\\\\x&=-1\\\\y&=-3(-1)^2-6(-1)+1\\\\y&=4\\end{align*}$$\nThe turning point is $(-1,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=x^2+\\sqrt{8}\\,x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\sqrt2,5)$",
          "worked": "$$\\begin{align*}x&=-\\frac{\\sqrt8}{2(1)}\\\\x&=-\\sqrt2\\\\y&=(-\\sqrt2)^2+\\sqrt8(-\\sqrt2)+7\\\\y&=2-4+7\\\\y&=5\\end{align*}$$\nThe turning point is $(-\\sqrt2,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\dfrac16x^2+\\dfrac13x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-1,-\\dfrac76\\right)$",
          "worked": "$$\\begin{align*}x&=-\\frac{\\frac13}{2\\left(\\frac16\\right)}\\\\x&=-1\\\\y&=\\frac16(-1)^2+\\frac13(-1)-1\\\\y&=\\frac16-\\frac26-\\frac66\\\\y&=-\\frac76\\end{align*}$$\nThe turning point is $\\left(-1,-\\frac76\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\sqrt2\\,x^2+\\sqrt8\\,x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,-\\sqrt2)$",
          "worked": "$$\\begin{align*}x&=-\\frac{\\sqrt8}{2\\sqrt2}\\\\x&=-1\\\\y&=\\sqrt2(-1)^2+\\sqrt8(-1)\\\\y&=\\sqrt2-2\\sqrt2\\\\y&=-\\sqrt2\\end{align*}$$\nThe turning point is $(-1,-\\sqrt2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
