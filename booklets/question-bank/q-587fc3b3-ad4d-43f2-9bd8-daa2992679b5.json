        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "There are 13 spades and 13 clubs, giving 26 black cards.\n\n$$P(\\text{black})=\\frac{26}{52}=\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
