  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "[A way to bypass the quotient rule]",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find constants $a$ and $b$ such that $\\frac{x}{x+1}=a+\\frac{b}{x+1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$ and $b=-1$.",
          "worked": "Multiply by $x+1$ and expand.\n\n$$\\begin{align*}x&=a(x+1)+b\\\\x&=ax+(a+b)\\end{align*}$$\n\nEquating coefficients of $x$ gives $a=1$. Equating constant terms gives $a+b=0$, so $b=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, differentiate $y=\\frac{x}{x+1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{dy}{dx}=\\frac{1}{(x+1)^2}$.",
          "worked": "$$y=1-(x+1)^{-1}$$\n\n$$\\begin{align*}\\frac{dy}{dx}&=-\\big[-(x+1)^{-2}\\big]\\cdot 1\\\\\\frac{dy}{dx}&=\\frac{1}{(x+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
