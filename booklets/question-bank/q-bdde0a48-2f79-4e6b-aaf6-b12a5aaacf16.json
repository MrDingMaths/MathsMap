  },
  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A bacterial population starts with 1000 bacteria and doubles every half hour.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "How many bacteria are there after 1 hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4000$ bacteria",
          "worked": "There are two half-hour periods.\n$$\\begin{align*}P &= 1000\\times 2^2\\\\P &= 4000\\end{align*}$$\nThere are $4000$ bacteria.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p30-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "How many bacteria are there after 2 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\,000$ bacteria",
          "worked": "There are four half-hour periods.\n$$\\begin{align*}P &= 1000\\times 2^4\\\\P &= 16\\,000\\end{align*}$$\nThere are $16\\,000$ bacteria.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p30-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "How many bacteria are there after 3 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64\\,000$ bacteria",
          "worked": "There are six half-hour periods.\n$$\\begin{align*}P &= 1000\\times 2^6\\\\P &= 64\\,000\\end{align*}$$\nThere are $64\\,000$ bacteria.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p30-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Write down an equation for the population of the bacteria after $t$ hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=1000\\times 2^{2t}$",
          "worked": "There are $2t$ half-hour periods in $t$ hours, so\n$$P=1000\\times 2^{2t},$$\nwhere $P$ is the population.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p30-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Using the continuous exponential model, how long will it take for the population to exceed 10 million? Answer to the nearest minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6 hours 39 min",
          "worked": "$$\\begin{align*}P &= 1000\\times 2^{2t}\\\\1000\\times 2^{2t} &> 10\\,000\\,000\\\\2^{2t} &> 10\\,000\\\\2t &> \\log_2 10\\,000\\\\t &> \\frac{\\log_2 10\\,000}{2}\\end{align*}$$\nThe inequality direction is unchanged because the logarithm base $2$ is greater than $1$.\nThe threshold is $\\dfrac{\\log_2 10\\,000}{2}=6.64385\\ldots$ hours, or $30\\log_2 10\\,000=398.63137\\ldots$ minutes.\nTo the nearest minute, the time is $399$ minutes, or 6 hours 39 min.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
