  "content": {
    "id": "p19-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "$f(x)=x^2-3$ and $g(x)=x-1$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression for $gf(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$gf(x)=x^2-4$",
          "worked": "$$\\begin{align*}gf(x)&=g(x^2-3)\\\\&=(x^2-3)-1\\\\&=x^2-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Find an expression for $fg(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$fg(x)=x^2-2x-2$",
          "worked": "$$\\begin{align*}fg(x)&=f(x-1)\\\\&=(x-1)^2-3\\\\&=x^2-2x+1-3\\\\&=x^2-2x-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve the equation $gf(x)=fg(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}x^2-4&=x^2-2x-2\\\\2x&=2\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
