                  "text": "the number 1",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$, unlikely",
          "worked": "One of the ten cards is labelled 1.\n\n$$P(\\text{number }1)=\\frac{1}{10}$$\n\nLess than half the cards qualify, so this is unlikely.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
