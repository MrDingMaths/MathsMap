              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$, certain",
          "worked": "All ten cards have numbers less than 20.\n\n$$\\begin{align*}P(\\text{number less than }20)&=\\frac{10}{10}\\\\P(\\text{number less than }20)&=1\\end{align*}$$\n\nEvery card qualifies, so this is certain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
