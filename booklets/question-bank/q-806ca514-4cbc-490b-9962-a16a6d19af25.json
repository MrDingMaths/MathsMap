        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$, even chance",
          "worked": "The favourable cards are 7, 9, 10, 11 and 12.\n\n$$\\begin{align*}P(\\text{number greater than }6)&=\\frac{5}{10}\\\\P(\\text{number greater than }6)&=\\frac{1}{2}\\end{align*}$$\n\nHalf the cards qualify, so there is an even chance.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
