  "content": {
    "id": "p39-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The position of a particle $x$ metres from $O$ after $t$ seconds is given by\n\n$$x=t^2-2t-8$$\n\nFind the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "The initial position of the particle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8\\,\\text{m}$",
          "worked": "$$\\begin{align*}x(0)&=0^2-2(0)-8\\\\x(0)&=-8\\,\\text{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "The velocity-time function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(t)=2t-2$, in metres per second.",
          "worked": "$$\\begin{align*}v(t)&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(t^2-2t-8)\\\\v(t)&=2t-2\\end{align*}$$\n\nVelocity is measured in metres per second.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p39-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "The initial velocity of the particle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\,\\text{m/s}$",
          "worked": "$$\\begin{align*}v(0)&=2(0)-2\\\\v(0)&=-2\\,\\text{m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "The direction in which the particle starts to move.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Left.",
          "worked": "The initial velocity is negative ($v(0)=-2\\,\\text{m/s}$), so the particle starts moving to the left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p39-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "When the particle is at rest.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=1\\,\\text{s}$",
          "worked": "At rest, $v(t)=0$.\n\n$$\\begin{align*}2t-2&=0\\\\2t&=2\\\\t&=1\\,\\text{s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
