  "content": {
    "id": "p41-q14-root",
    "type": "question",
    "label": null,
    "prompt": "Suppose that the solution curve for $\\dfrac{dy}{dx}=-\\dfrac{x}{y}$ passes through $(1,\\sqrt3)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Separate the variables and hence write down the corresponding equation of integrals.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\,dy=-x\\,dx$, so $\\displaystyle\\int y\\,dy=\\int-x\\,dx$.",
          "worked": "$$\\begin{align*}y\\,dy&=-x\\,dx\\\\\\int y\\,dy&=\\int-x\\,dx\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p41-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the general solution as a relation, writing your answer without fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=D$",
          "worked": "$$\\begin{align*}\\frac{y^2}{2}&=-\\frac{x^2}{2}+C\\\\x^2+y^2&=D\\end{align*}$$\nHere $D=2C$ is an arbitrary constant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p41-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence determine the equation of the solution curve through the given point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=4$, on the branch with $y>0$.",
          "worked": "Substitute $(1,\\sqrt3)$:\n$$\\begin{align*}1^2+(\\sqrt3)^2&=D\\\\D&=4\\\\x^2+y^2&=4\\end{align*}$$\nThe branch through the given point has $y>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
