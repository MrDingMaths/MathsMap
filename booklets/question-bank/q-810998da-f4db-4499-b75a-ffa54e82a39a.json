  "content": {
    "id": "p11-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "$A = \\{\\text{red},\\text{white},\\text{blue}\\}$, $B = \\{\\text{green},\\text{red},\\text{yellow},\\text{black}\\}$.\n\nExplain why $A \\cup B$ is not $\\{\\text{red},\\text{white},\\text{blue},\\text{green},\\text{red},\\text{yellow},\\text{black}\\}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Sets have no repeated elements, so red must appear only once.",
      "worked": "Red belongs to both $A$ and $B$, but a set lists each element only once. Therefore $A \\cup B = \\{\\text{red},\\text{white},\\text{blue},\\text{green},\\text{yellow},\\text{black}\\}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 14
  },
