            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "(r,\\theta)=\\left(14\\text{ cm},\\frac{3\\pi}{7}\\text{ radians}\\right)",
                "display": false
              },
              {
