    "type": "question",
    "label": "24",
    "prompt": "A sector has perimeter $28+6\\pi$ cm and area $42\\pi$ cm$^2$. Find all possible values of the radius $r$ and the corresponding angle $\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
