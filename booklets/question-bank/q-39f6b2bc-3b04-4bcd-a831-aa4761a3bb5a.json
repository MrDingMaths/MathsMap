        "type": "part",
        "label": "a",
        "prompt": "$\\sin(A+45^\\circ)=\\frac{1}{\\sqrt2}(\\sin A+\\cos A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin(A+45^\\circ)=\\frac{1}{\\sqrt2}(\\sin A+\\cos A)$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\sin A\\cos45^\\circ+\\cos A\\sin45^\\circ\\\\&=\\sin A\\left(\\frac1{\\sqrt2}\\right)+\\cos A\\left(\\frac1{\\sqrt2}\\right)\\\\&=\\frac1{\\sqrt2}(\\sin A+\\cos A)\\\\&=\\text{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\cos\\left(\\theta+\\frac\\pi3\\right)=\\cos\\theta-\\sqrt3\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\cos\\left(\\theta+\\frac\\pi3\\right)=\\cos\\theta-\\sqrt3\\sin\\theta$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=2\\left(\\cos\\theta\\cos\\frac\\pi3-\\sin\\theta\\sin\\frac\\pi3\\right)\\\\&=2\\left(\\cos\\theta\\left(\\frac12\\right)-\\sin\\theta\\left(\\frac{\\sqrt3}2\\right)\\right)\\\\&=\\cos\\theta-\\sqrt3\\sin\\theta\\\\&=\\text{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\left(\\frac\\pi4-A\\right)=\\frac{1-\\tan A}{1+\\tan A}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\left(\\frac\\pi4-A\\right)=\\frac{1-\\tan A}{1+\\tan A}$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\frac{\\tan\\frac\\pi4-\\tan A}{1+\\tan\\frac\\pi4\\tan A}\\\\&=\\frac{1-\\tan A}{1+\\tan A}\\\\&=\\text{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin(A-30^\\circ)=\\frac12(\\sqrt3\\sin A-\\cos A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin(A-30^\\circ)=\\frac12(\\sqrt3\\sin A-\\cos A)$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\sin A\\cos30^\\circ-\\cos A\\sin30^\\circ\\\\&=\\sin A\\left(\\frac{\\sqrt3}2\\right)-\\cos A\\left(\\frac12\\right)\\\\&=\\frac12(\\sqrt3\\sin A-\\cos A)\\\\&=\\text{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
