  "content": {
    "id": "p6-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A card is drawn at random from a pack of 52 playing cards. What is the probability that it is not a 2?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{12}{13}$",
      "worked": "There are four 2s in the pack. Let $A$ be the event ‘a 2 is drawn’.\n\n$$\\begin{aligned}P(A)&=\\frac{4}{52}\\\\P(A)&=\\frac{1}{13}\\\\P(A^c)&=1-\\frac{1}{13}\\\\P(A^c)&=\\frac{12}{13}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
