  "content": {
    "id": "p47-q23-node",
    "type": "question",
    "label": "23",
    "prompt": "Find the values of $x$ for which",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "the curve $y=x^3-6x^2+9x-8$ is decreasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1<x<3$.",
          "worked": "$$\\begin{align*}y'&=3x^2-12x+9\\\\y'&=3(x-1)(x-3).\\end{align*}$$ The factors $x-1$ and $x-3$ have opposite signs exactly when $1<x<3$. The derivative is negative there, so the curve is decreasing on this interval.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p47-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "the curve $y=2x^3-x^2$ is concave up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\frac{1}{6}$.",
          "worked": "$$\\begin{align*}y'&=6x^2-2x\\\\y''&=12x-2.\\end{align*}$$ The curve is concave up where $y''>0$. $$\\begin{align*}12x-2&>0\\\\12x&>2\\\\x&>\\frac{1}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
