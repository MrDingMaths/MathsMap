    "id": "v2-94367-p55-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "A costume requires $2\\frac{3}{4}$ metres of ribbon.\nHow many metres of ribbon are required to make six identical costumes?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16\\frac{1}{2}$ metres",
      "worked": "$$\\begin{align*}2\\frac{3}{4}\\times6&=\\frac{11}{4}\\times\\frac{6}{1}\\\\&=\\frac{66}{4}\\\\&=\\frac{33}{2}\\\\&=16\\frac{1}{2}\\end{align*}$$\n$16\\frac{1}{2}$ metres of ribbon are required.",
      "solutionDiagrams": []
    },
