  "content": {
    "id": "p18-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Evaluate $\\displaystyle\\int_4^5(2x-3)\\,dx$ and $\\displaystyle\\int_5^4(2x-3)\\,dx$. What do you notice?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6$ and $-6$, respectively. Reversing the limits changes the sign.",
      "worked": "$$\\begin{aligned}\\int_4^5(2x-3)\\,dx&=[x^2-3x]_4^5\\\\&=(25-15)-(16-12)\\\\&=6\\end{aligned}$$\n$$\\begin{aligned}\\int_5^4(2x-3)\\,dx&=[x^2-3x]_5^4\\\\&=(16-12)-(25-15)\\\\&=-6\\end{aligned}$$\nThe values are $6$ and $-6$. Reversing the limits changes the sign.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
