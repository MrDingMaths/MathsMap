  "content": {
    "id": "p35-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Let $m>0$ and $b=c$. Describe the gradient-intercept formula $y=mx+c$ in terms of a dilation of the line $y=x+b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Horizontal dilation by factor $\\frac1m$.",
      "worked": "$$\\begin{align*}y&=\\frac{x}{1/m}+b\\\\y&=mx+b\\\\y&=mx+c\\end{align*}$$Replacing $x$ with $mx$ gives a horizontal dilation by factor $\\frac1m$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
