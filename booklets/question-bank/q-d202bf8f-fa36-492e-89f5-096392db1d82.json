  "content": {
    "id": "p9-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Decide whether these functions can be a probability distribution.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(0,\\frac15\\right)\\;\\left(1,\\frac25\\right)\\;\\left(2,-\\frac15\\right)\\;\\left(3,\\frac25\\right)\\;\\left(4,\\frac15\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. $P(2)=-\\frac15<0$.",
          "worked": "Every probability must lie between $0$ and $1$. Here $P(2)=-\\frac15$, so this cannot be a probability distribution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=\\dfrac{x+2}{4}$ for $x\\in\\{0,1,2\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. The probabilities sum to $\\frac94>1$.",
          "worked": "$$\\begin{align*}P(0)+P(1)+P(2)&=\\frac24+\\frac34+\\frac44\\\\&=\\frac94.\\end{align*}$$\nThe probabilities do not sum to $1$, so this cannot be a probability distribution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
