  "content": {
    "id": "p17-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Differentiate the following using the product rule, and simplify your answer.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x(x+1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x+1)^4(6x+1)$",
          "worked": "$$\\begin{align*}y'&=(x+1)^5+5x(x+1)^4\\\\y'&=(x+1)^4[(x+1)+5x]\\\\y'&=(x+1)^4(6x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p17-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(3x-1)(5-4x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-36x^2+8x+15$",
          "worked": "$$\\begin{align*}y'&=3(5-4x^2)-8x(3x-1)\\\\y'&=15-12x^2-24x^2+8x\\\\y'&=-36x^2+8x+15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p17-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(3x^2+2x+9)(4-5x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-45x^2+4x-37$",
          "worked": "$$\\begin{align*}y'&=(6x+2)(4-5x)\\\\&\\quad-5(3x^2+2x+9)\\\\y'&=-30x^2+14x+8\\\\&\\quad-15x^2-10x-45\\\\y'&=-45x^2+4x-37\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x(3x-2)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(3x-2)^3(15x-2)$",
          "worked": "$$\\begin{align*}y'&=(3x-2)^4+12x(3x-2)^3\\\\y'&=(3x-2)^3[(3x-2)+12x]\\\\y'&=(3x-2)^3(15x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p17-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^2(x-1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=x(x-1)^2(5x-2)$",
          "worked": "$$\\begin{align*}y'&=2x(x-1)^3+3x^2(x-1)^2\\\\y'&=x(x-1)^2[2(x-1)+3x]\\\\y'&=x(x-1)^2(5x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p17-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=(x+1)^2(x+2)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x+2)^2(x+1)(5x+7)$",
          "worked": "$$\\begin{align*}y'&=2(x+1)(x+2)^3\\\\&\\quad+3(x+1)^2(x+2)^2\\\\y'&=(x+2)^2(x+1)\\\\&\\quad\\times[2(x+2)+3(x+1)]\\\\y'&=(x+2)^2(x+1)(5x+7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
