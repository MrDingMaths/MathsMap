  "content": {
    "id": "p19-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Reciprocals are used in the study of electronics to calculate resistances in parallel circuits. This formula finds the total resistance $R_T$ in a circuit, given two resistors $R_1$, $R_2$ in parallel.\n$$\\frac{1}{R_T}=\\frac{1}{R_1}+\\frac{1}{R_2}$$\nFind $R_T$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q6-calculations",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q6-a",
            "type": "part",
            "label": "a",
            "prompt": "$$\\frac{1}{R_T}=\\frac{1}{8}+\\frac{1}{8}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$R_T=4$",
              "worked": "$$\\begin{align*}\\frac{1}{R_T}&=\\frac{2}{8}\\\\\\frac{1}{R_T}&=\\frac{1}{4}\\\\R_T&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p19-q6-b",
            "type": "part",
            "label": "b",
            "prompt": "$$\\frac{1}{R_T}=\\frac{1}{6}+\\frac{1}{6}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$R_T=3$",
              "worked": "$$\\begin{align*}\\frac{1}{R_T}&=\\frac{2}{6}\\\\\\frac{1}{R_T}&=\\frac{1}{3}\\\\R_T&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p19-q6-c",
            "type": "part",
            "label": "c",
            "prompt": "$$\\frac{1}{R_T}=\\frac{1}{6}+\\frac{1}{4}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$R_T=\\frac{12}{5}$",
              "worked": "$$\\begin{align*}\\frac{1}{R_T}&=\\frac{2}{12}+\\frac{3}{12}\\\\\\frac{1}{R_T}&=\\frac{5}{12}\\\\R_T&=\\frac{12}{5}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p19-q6-d",
            "type": "part",
            "label": "d",
            "prompt": "$$\\frac{1}{R_T}=\\frac{1}{120}+\\frac{1}{260}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$R_T=\\frac{1560}{19}$",
              "worked": "$$\\begin{align*}\\frac{1}{R_T}&=\\frac{13}{1560}+\\frac{6}{1560}\\\\\\frac{1}{R_T}&=\\frac{19}{1560}\\\\R_T&=\\frac{1560}{19}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          }
        ]
      },
      {
        "id": "p19-q6-proof",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p19-q6-proof-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Show that this is ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "always",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": " true: When two resistors with equal resistance are connected in parallel, the total resistance is equal to half the resistance of one of the resistors.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R_T=\\frac{x}{2}$, where each resistor has resistance $x$.",
          "worked": "Let each resistor have resistance $x$.\n$$\\begin{align*}\\frac{1}{R_T}&=\\frac{1}{x}+\\frac{1}{x}\\\\\\frac{1}{R_T}&=\\frac{2}{x}\\\\x&=2R_T\\\\R_T&=\\frac{x}{2}\\end{align*}$$\nThus the total resistance is half the resistance of either resistor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
