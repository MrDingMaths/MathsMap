  "content": {
    "id": "p18-q2",
    "type": "question",
    "label": "2",
    "prompt": "The cost of a photocopier ($C$, in dollars) varies directly with its speed ($s$, in pages per minute).\nA photocopier with a speed of 50 pages per minute costs $\\$700$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the constant of variation $k$? What does it represent in this scenario?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=14$: $\\$14$ per page per minute of speed.",
          "worked": "$$\\begin{align*}C&=ks\\\\700&=50k\\\\k&=\\frac{700}{50}\\\\k&=14\\end{align*}$$\nThe constant represents $\\$14$ of cost for each page per minute of the photocopier’s speed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an equation connecting $C$ and $s$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=14s$",
          "worked": "Substituting $k=14$ into $C=ks$ gives $C=14s$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "How much does a photocopier with a speed of 60 pages per minute cost?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$840$",
          "worked": "$$\\begin{align*}C&=14s\\\\C&=14\\times60\\\\C&=840\\end{align*}$$\nThe photocopier costs $\\$840$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
