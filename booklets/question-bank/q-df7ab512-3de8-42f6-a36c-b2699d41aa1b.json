  "content": {
    "id": "p8-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Prove the following identities:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q11a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\frac1{1+\\cos\\theta}+\\frac1{1-\\cos\\theta}=2\\csc^2\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac1{1+\\cos\\theta}+\\frac1{1-\\cos\\theta}=\\frac2{\\sin^2\\theta}=2\\csc^2\\theta$.",
          "worked": "$$\\begin{align*}\\frac1{1+\\cos\\theta}+\\frac1{1-\\cos\\theta}&=\\frac{1-\\cos\\theta+1+\\cos\\theta}{(1+\\cos\\theta)(1-\\cos\\theta)}\\\\\\frac1{1+\\cos\\theta}+\\frac1{1-\\cos\\theta}&=\\frac2{1-\\cos^2\\theta}\\\\\\frac1{1+\\cos\\theta}+\\frac1{1-\\cos\\theta}&=\\frac2{\\sin^2\\theta}\\\\\\frac1{1+\\cos\\theta}+\\frac1{1-\\cos\\theta}&=2\\csc^2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p8-q11b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\frac{\\cos\\theta}{1+\\sin\\theta}+\\frac{\\cos\\theta}{1-\\sin\\theta}=2\\sec\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{\\cos\\theta}{1+\\sin\\theta}+\\frac{\\cos\\theta}{1-\\sin\\theta}=\\frac{2\\cos\\theta}{\\cos^2\\theta}=2\\sec\\theta$.",
          "worked": "$$\\begin{align*}\\frac{\\cos\\theta}{1+\\sin\\theta}+\\frac{\\cos\\theta}{1-\\sin\\theta}&=\\frac{\\cos\\theta(1-\\sin\\theta)+\\cos\\theta(1+\\sin\\theta)}{(1+\\sin\\theta)(1-\\sin\\theta)}\\\\\\frac{\\cos\\theta}{1+\\sin\\theta}+\\frac{\\cos\\theta}{1-\\sin\\theta}&=\\frac{2\\cos\\theta}{1-\\sin^2\\theta}\\\\\\frac{\\cos\\theta}{1+\\sin\\theta}+\\frac{\\cos\\theta}{1-\\sin\\theta}&=\\frac{2\\cos\\theta}{\\cos^2\\theta}\\\\\\frac{\\cos\\theta}{1+\\sin\\theta}+\\frac{\\cos\\theta}{1-\\sin\\theta}&=2\\sec\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p8-q11c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\frac1{\\sec\\theta+\\tan\\theta}=\\frac{\\cos\\theta}{1+\\sin\\theta}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac1{\\sec\\theta+\\tan\\theta}=\\frac1{\\frac{(1+\\sin\\theta)}{\\cos\\theta}}=\\frac{\\cos\\theta}{1+\\sin\\theta}$.",
          "worked": "$$\\begin{align*}\\frac1{\\sec\\theta+\\tan\\theta}&=\\frac1{\\frac1{\\cos\\theta}+\\frac{\\sin\\theta}{\\cos\\theta}}\\\\\\frac1{\\sec\\theta+\\tan\\theta}&=\\frac1{\\frac{1+\\sin\\theta}{\\cos\\theta}}\\\\\\frac1{\\sec\\theta+\\tan\\theta}&=\\frac{\\cos\\theta}{1+\\sin\\theta}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q11d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\frac1{\\csc\\theta+\\cot\\theta}=\\frac{\\sin\\theta}{1+\\cos\\theta}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac1{\\csc\\theta+\\cot\\theta}=\\frac1{\\frac{(1+\\cos\\theta)}{\\sin\\theta}}=\\frac{\\sin\\theta}{1+\\cos\\theta}$.",
          "worked": "$$\\begin{align*}\\frac1{\\csc\\theta+\\cot\\theta}&=\\frac1{\\frac1{\\sin\\theta}+\\frac{\\cos\\theta}{\\sin\\theta}}\\\\\\frac1{\\csc\\theta+\\cot\\theta}&=\\frac1{\\frac{1+\\cos\\theta}{\\sin\\theta}}\\\\\\frac1{\\csc\\theta+\\cot\\theta}&=\\frac{\\sin\\theta}{1+\\cos\\theta}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q11e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}=2\\csc\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}=\\frac{2(1-\\cos\\theta)}{\\sin\\theta(1-\\cos\\theta)}=2\\csc\\theta$.\n\nCombine the fractions and use $\\sin^2\\theta+\\cos^2\\theta=1$.",
          "worked": "$$\\begin{align*}\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{\\sin^2\\theta+(1-\\cos\\theta)^2}{\\sin\\theta(1-\\cos\\theta)}\\\\\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{\\sin^2\\theta+1-2\\cos\\theta+\\cos^2\\theta}{\\sin\\theta(1-\\cos\\theta)}\\\\\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{2-2\\cos\\theta}{\\sin\\theta(1-\\cos\\theta)}\\\\\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{2(1-\\cos\\theta)}{\\sin\\theta(1-\\cos\\theta)}\\\\\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac2{\\sin\\theta}\\\\\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=2\\csc\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p8-q11f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\frac{1+\\tan\\theta}{1+\\cot\\theta}=\\tan\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{1+\\tan\\theta}{1+\\cot\\theta}=\\frac{\\sin\\theta}{\\cos\\theta}=\\tan\\theta$.\n\nWrite tangent and cotangent in terms of sine and cosine, then cancel the common sum.",
          "worked": "$$\\begin{align*}\\frac{1+\\tan\\theta}{1+\\cot\\theta}&=\\frac{1+\\frac{\\sin\\theta}{\\cos\\theta}}{1+\\frac{\\cos\\theta}{\\sin\\theta}}\\\\\\frac{1+\\tan\\theta}{1+\\cot\\theta}&=\\frac{\\cos\\theta+\\sin\\theta}{\\cos\\theta}\\cdot\\frac{\\sin\\theta}{\\sin\\theta+\\cos\\theta}\\\\\\frac{1+\\tan\\theta}{1+\\cot\\theta}&=\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\frac{1+\\tan\\theta}{1+\\cot\\theta}&=\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
