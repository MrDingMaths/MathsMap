    "children": [
      {
        "id": "backfill-solving-polynomial-equations-3-root",
        "type": "part",
        "label": "a",
        "prompt": "Show that $P(x)=x^3-2x+7$ does not have an integer zero by testing all the possible integer zeros.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-7)=-322$, $P(-1)=8$, $P(1)=6$, $P(7)=336$. None is zero, so there is no integer zero.",
          "worked": "Any integer zero must be a factor of $7$, so test $-7,-1,1,7$.\n$$\\begin{aligned}P(-7)&=(-7)^3-2(-7)+7=-322\\\\P(-1)&=(-1)^3-2(-1)+7=8\\\\P(1)&=1^3-2(1)+7=6\\\\P(7)&=7^3-2(7)+7=336\\end{aligned}$$\nNone of the possible integer zeros gives $P(x)=0$. Therefore $P(x)$ has no integer zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "backfill-solving-polynomial-equations-4-root",
        "type": "part",
        "label": "b",
        "prompt": "Show that $P(x)=x^3-x^2+3x+10$ does not have an integer zero by testing all the possible integer zeros.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-10)=-1120$, $P(-5)=-155$, $P(-2)=-8$, $P(-1)=5$, $P(1)=13$, $P(2)=20$, $P(5)=125$, $P(10)=940$. None is zero, so there is no integer zero.",
          "worked": "Any integer zero must be a factor of $10$, so test $\\pm1,\\pm2,\\pm5,\\pm10$.\n$$\\begin{aligned}P(-10)&=-1000-100-30+10=-1120\\\\P(-5)&=-125-25-15+10=-155\\\\P(-2)&=-8-4-6+10=-8\\\\P(-1)&=-1-1-3+10=5\\\\P(1)&=1-1+3+10=13\\\\P(2)&=8-4+6+10=20\\\\P(5)&=125-25+15+10=125\\\\P(10)&=1000-100+30+10=940\\end{aligned}$$\nNone of the possible integer zeros gives $P(x)=0$. Therefore $P(x)$ has no integer zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
