  "content": {
    "id": "v2-49d178-p3-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "The population of quokkas on an island is modelled by $P(t)=200+15t-t^2$, where $t$ is in years.\nFind the average rate of change of the population from $t=3$ to $t=9$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\text{ quokkas/year}$.",
      "worked": "$$\\begin{aligned}P(3)&=200+15(3)-3^2=236\\\\P(9)&=200+15(9)-9^2=254\\\\\\text{Average rate of change}&=\\frac{P(9)-P(3)}{9-3}\\\\&=\\frac{254-236}{6}\\\\&=3\\text{ quokkas/year}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
