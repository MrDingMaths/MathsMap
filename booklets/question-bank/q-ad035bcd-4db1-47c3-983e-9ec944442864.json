  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Use compound-angle formulae to solve, for $0\\leq\\theta\\leq2\\pi$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\left(\\theta+\\frac{\\pi}{6}\\right)=2\\sin\\left(\\theta-\\frac{\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{\\pi}{3},\\frac{4\\pi}{3}$",
          "worked": "$$\\begin{aligned}\\sin\\theta\\cos\\frac{\\pi}{6}+\\cos\\theta\\sin\\frac{\\pi}{6}&=2\\left(\\sin\\theta\\cos\\frac{\\pi}{6}-\\cos\\theta\\sin\\frac{\\pi}{6}\\right)\\\\\\frac{\\sqrt3}{2}\\sin\\theta+\\frac12\\cos\\theta&=\\sqrt3\\sin\\theta-\\cos\\theta\\\\\\frac32\\cos\\theta&=\\frac{\\sqrt3}{2}\\sin\\theta\\\\\\tan\\theta&=\\sqrt3\\\\\\therefore\\theta&=\\frac{\\pi}{3},\\frac{4\\pi}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\left(\\theta-\\frac{\\pi}{6}\\right)=2\\cos\\left(\\theta+\\frac{\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{\\pi}{6},\\frac{7\\pi}{6}$",
          "worked": "$$\\begin{aligned}\\cos\\theta\\cos\\frac{\\pi}{6}+\\sin\\theta\\sin\\frac{\\pi}{6}&=2\\left(\\cos\\theta\\cos\\frac{\\pi}{6}-\\sin\\theta\\sin\\frac{\\pi}{6}\\right)\\\\\\frac{\\sqrt3}{2}\\cos\\theta+\\frac12\\sin\\theta&=\\sqrt3\\cos\\theta-\\sin\\theta\\\\\\frac32\\sin\\theta&=\\frac{\\sqrt3}{2}\\cos\\theta\\\\\\tan\\theta&=\\frac1{\\sqrt3}\\\\\\therefore\\theta&=\\frac{\\pi}{6},\\frac{7\\pi}{6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos4\\theta\\cos\\theta+\\sin4\\theta\\sin\\theta=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{\\pi}{9},\\frac{5\\pi}{9},\\frac{7\\pi}{9},\\frac{11\\pi}{9},\\frac{13\\pi}{9},\\frac{17\\pi}{9}$",
          "worked": "Using $\\cos(A-B)=\\cos A\\cos B+\\sin A\\sin B$,\n$$\\begin{aligned}\\cos(4\\theta-\\theta)&=\\frac12\\\\\\cos3\\theta&=\\frac12\\\\3\\theta&=\\frac{\\pi}{3},\\frac{5\\pi}{3},\\frac{7\\pi}{3},\\frac{11\\pi}{3},\\frac{13\\pi}{3},\\frac{17\\pi}{3}\\\\\\therefore\\theta&=\\frac{\\pi}{9},\\frac{5\\pi}{9},\\frac{7\\pi}{9},\\frac{11\\pi}{9},\\frac{13\\pi}{9},\\frac{17\\pi}{9}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p15-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos3\\theta=\\cos2\\theta\\cos\\theta$\n\n(Hint: write $\\cos3\\theta$ as $\\cos(2\\theta+\\theta)$.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0,\\frac{\\pi}{2},\\pi,\\frac{3\\pi}{2},2\\pi$",
          "worked": "$$\\begin{aligned}\\cos(2\\theta+\\theta)&=\\cos2\\theta\\cos\\theta\\\\\\cos2\\theta\\cos\\theta-\\sin2\\theta\\sin\\theta&=\\cos2\\theta\\cos\\theta\\\\\\sin2\\theta\\sin\\theta&=0\\\\2\\sin^2\\theta\\cos\\theta&=0\\\\\\sin\\theta&=0\\quad\\text{or}\\quad\\cos\\theta=0\\\\\\therefore\\theta&=0,\\frac{\\pi}{2},\\pi,\\frac{3\\pi}{2},2\\pi\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
