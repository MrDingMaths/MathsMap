  "content": {
    "id": "v2-4f43a-p47-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "On any weekday, the probability that Mia catches a train on her way to work is $\\frac{p}{20}$, the probability that she catches a bus is $\\frac{7}{20}$, and the probability that she catches both is $\\frac{1}{20}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4f43a-p47-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find, in terms of $p$, the probability that Mia catches the train but not the bus.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{p-1}{20}$",
          "worked": "Let $T$ denote catching the train and $B$ denote catching the bus.\n$$\\begin{align*}P(T\\cap B')&=P(T)-P(T\\cap B)\\\\&=\\frac{p}{20}-\\frac{1}{20}\\\\&=\\frac{p-1}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-4f43a-p47-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The probability that Mia catches neither the train nor the bus is $\\frac25$. Find $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=6$",
          "worked": "$$\\begin{align*}P(T\\cup B)&=P(T)+P(B)-P(T\\cap B)\\\\&=\\frac{p}{20}+\\frac{7}{20}-\\frac{1}{20}\\\\&=\\frac{p+6}{20}\\end{align*}$$\n$$\\begin{align*}P(\\overline{T\\cup B})&=1-\\frac{p+6}{20}\\\\\\frac25&=1-\\frac{p+6}{20}\\\\\\frac{p+6}{20}&=\\frac35\\\\p+6&=12\\\\p&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
