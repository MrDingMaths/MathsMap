    "children": [
      {
        "id": "p36-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y=\\cos x$ is a PDF in the domain $\\left[\\frac{3\\pi}{2},2\\pi\\right]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos x\\geq0$ on $\\left[\\frac{3\\pi}{2},2\\pi\\right]$ and $\\displaystyle\\int_{3\\pi/2}^{2\\pi}\\cos x\\,dx=1$. Therefore, it is a PDF.",
          "worked": "$$\\begin{aligned}\\int_{3\\pi/2}^{2\\pi}\\cos x\\,dx&=[\\sin x]_{3\\pi/2}^{2\\pi}\\\\&=\\sin(2\\pi)-\\sin\\left(\\frac{3\\pi}{2}\\right)\\\\&=0-(-1)\\\\&=1.\\end{aligned}$$\nAlso, $\\cos x\\geq0$ on $\\left[\\frac{3\\pi}{2},2\\pi\\right]$, since cosine is non-negative in the fourth quadrant. Therefore, it is a PDF.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p36-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the CDF.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\sin x+1$ for $\\frac{3\\pi}{2}\\leq x\\leq2\\pi$.",
          "worked": "$$\\begin{aligned}F(x)&=\\int_{3\\pi/2}^{x}\\cos t\\,dt\\\\&=[\\sin t]_{3\\pi/2}^{x}\\\\&=\\sin x+1,\\qquad \\frac{3\\pi}{2}\\leq x\\leq2\\pi.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p36-q8-c",
        "type": "group",
        "label": "c",
        "prompt": "Find each probability in exact form:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p36-q8-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$P\\left(X\\leq\\frac{5\\pi}{3}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{2-\\sqrt3}{2}$",
              "worked": "$$\\begin{aligned}P\\left(X\\leq\\frac{5\\pi}{3}\\right)&=F\\left(\\frac{5\\pi}{3}\\right)\\\\&=\\sin\\left(\\frac{5\\pi}{3}\\right)+1\\\\&=-\\frac{\\sqrt3}{2}+1\\\\&=\\frac{2-\\sqrt3}{2}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p36-q8-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P\\left(X\\geq\\frac{7\\pi}{4}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{\\sqrt2}$",
              "worked": "$$\\begin{aligned}P\\left(X\\geq\\frac{7\\pi}{4}\\right)&=1-F\\left(\\frac{7\\pi}{4}\\right)\\\\&=1-\\left(\\sin\\left(\\frac{7\\pi}{4}\\right)+1\\right)\\\\&=-\\sin\\left(\\frac{7\\pi}{4}\\right)\\\\&=\\frac{1}{\\sqrt2}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p36-q8-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P\\left(\\frac{5\\pi}{3}\\leq X\\leq\\frac{11\\pi}{6}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{\\sqrt3-1}{2}$",
              "worked": "$$\\begin{aligned}P\\left(\\frac{5\\pi}{3}\\leq X\\leq\\frac{11\\pi}{6}\\right)&=F\\left(\\frac{11\\pi}{6}\\right)-F\\left(\\frac{5\\pi}{3}\\right)\\\\&=\\sin\\left(\\frac{11\\pi}{6}\\right)-\\sin\\left(\\frac{5\\pi}{3}\\right)\\\\&=-\\frac12-\\left(-\\frac{\\sqrt3}{2}\\right)\\\\&=\\frac{\\sqrt3-1}{2}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          }
        ]
      }
    ]
  },
