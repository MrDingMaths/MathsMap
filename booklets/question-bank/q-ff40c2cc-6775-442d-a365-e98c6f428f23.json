    "type": "question",
    "label": null,
    "prompt": "The angle sum of a regular polygon is $1800^{\\circ}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-165a9d-p5-practice-slot-1-2-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "How many sides does it have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "12",
          "worked": "$$\\begin{aligned}S&=180(n-2)\\\\1800&=180(n-2)\\\\10&=n-2\\\\n&=12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-165a9d-p5-practice-slot-1-2-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the size of each angle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$150^{\\circ}$",
          "worked": "The interior angles of a regular polygon are equal.\n$$\\begin{aligned}\\text{Each interior angle}&=\\frac{1800^{\\circ}}{12}\\\\&=150^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
