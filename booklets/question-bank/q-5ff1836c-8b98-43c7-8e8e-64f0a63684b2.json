  "content": {
    "id": "p11-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find the missing algebraic fraction. The missing fraction is fully simplified.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q11-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q11-root-bank-p11-q11-a-compact-0",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{x}{2}+\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}=\\frac{5x}{6}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{3}$",
          "worked": "$\\begin{aligned}\\text{Missing fraction}&=\\frac{5x}{6}-\\frac{x}{2}\\\\&=\\frac{5x}{6}-\\frac{3x}{6}\\\\&=\\frac{2x}{6}\\\\&=\\frac{x}{3}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p11-q11-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q11-root-bank-p11-q11-b-compact-0",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}+\\frac{x}{4}=\\frac{3x}{8}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{8}$",
          "worked": "$\\begin{aligned}\\text{Missing fraction}&=\\frac{3x}{8}-\\frac{x}{4}\\\\&=\\frac{3x}{8}-\\frac{2x}{8}\\\\&=\\frac{x}{8}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p11-q11-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q11-root-bank-p11-q11-c-compact-0",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{2x}{5}+\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}=\\frac{9x}{10}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{2}$",
          "worked": "$\\begin{aligned}\\text{Missing fraction}&=\\frac{9x}{10}-\\frac{2x}{5}\\\\&=\\frac{9x}{10}-\\frac{4x}{10}\\\\&=\\frac{5x}{10}\\\\&=\\frac{x}{2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p11-q11-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q11-root-bank-p11-q11-d-compact-0",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{2x}{3}-\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}=\\frac{7x}{15}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{5}$",
          "worked": "$\\begin{aligned}\\text{Missing fraction}&=\\frac{2x}{3}-\\frac{7x}{15}\\\\&=\\frac{10x}{15}-\\frac{7x}{15}\\\\&=\\frac{3x}{15}\\\\&=\\frac{x}{5}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p11-q11-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q11-root-bank-p11-q11-e-compact-0",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}-\\frac{x}{3}=\\frac{5x}{9}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8x}{9}$",
          "worked": "$\\begin{aligned}\\text{Missing fraction}&=\\frac{5x}{9}+\\frac{x}{3}\\\\&=\\frac{5x}{9}+\\frac{3x}{9}\\\\&=\\frac{8x}{9}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p11-q11-f",
        "type": "part",
        "label": "f",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q11-root-bank-p11-q11-f-compact-0",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{2x}{3}-\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}=\\frac{5x}{12}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{4}$",
          "worked": "$\\begin{aligned}\\text{Missing fraction}&=\\frac{2x}{3}-\\frac{5x}{12}\\\\&=\\frac{8x}{12}-\\frac{5x}{12}\\\\&=\\frac{3x}{12}\\\\&=\\frac{x}{4}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
