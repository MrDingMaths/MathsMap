    "type": "question",
    "label": "15",
    "prompt": "Five-twelfths of a farm covers 325 hectares (ha). What is the area of the whole farm?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "780 ha",
      "worked": "$$\\begin{align*}\\text{Whole farm area}&=325\\div\\frac{5}{12}\\\\\\text{Whole farm area}&=325\\times\\frac{12}{5}\\\\\\text{Whole farm area}&=65\\times12\\\\\\text{Whole farm area}&=780\\text{ ha}\\end{align*}$$",
