    "children": [
      {
        "id": "p37-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Nineteen two-digit numbers are selected. At least two of them have the same digital sum.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "There are 18 possible digital sums and 19 numbers, so at least two have the same digital sum.",
          "worked": "The digital sum of a two-digit number ranges from 1 to 18. Label 18 holes with these possible sums and place each selected number in the hole corresponding to its digital sum.\n\nSince $19=18+1$, the pigeonhole principle guarantees that some hole contains at least two numbers. These numbers have the same digital sum.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p37-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Eighty-two three-digit numbers are selected. At least four of them have the same digital sum.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "There are 27 possible digital sums. Since $82=27\\times3+1$, at least four numbers have the same digital sum.",
          "worked": "The digital sum of a three-digit number ranges from 1 to 27. Label 27 holes with these possible sums and place each selected number in the hole corresponding to its digital sum.\n\nSince $82=27\\times3+1$, the generalised pigeonhole principle guarantees that some hole contains at least $3+1=4$ numbers. These numbers have the same digital sum.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
