  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3x}{2}+\\frac{4x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{23x}{10}$",
          "worked": "$$\\begin{align*}\\frac{3x}{2}+\\frac{4x}{5}&=\\frac{15x}{10}+\\frac{8x}{10}\\\\\\frac{3x}{2}+\\frac{4x}{5}&=\\frac{23x}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x}{2}+\\frac{4x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13x}{10}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}+\\frac{4x}{5}&=\\frac{5x}{10}+\\frac{8x}{10}\\\\\\frac{x}{2}+\\frac{4x}{5}&=\\frac{13x}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x}{2}+\\frac{x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{10}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}+\\frac{x}{5}&=\\frac{5x}{10}+\\frac{2x}{10}\\\\\\frac{x}{2}+\\frac{x}{5}&=\\frac{7x}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{2}-\\frac{x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x}{10}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}-\\frac{x}{5}&=\\frac{5x}{10}-\\frac{2x}{10}\\\\\\frac{x}{2}-\\frac{x}{5}&=\\frac{3x}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x}{5}-\\frac{x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3x}{10}$",
          "worked": "$$\\begin{align*}\\frac{x}{5}-\\frac{x}{2}&=\\frac{2x}{10}-\\frac{5x}{10}\\\\\\frac{x}{5}-\\frac{x}{2}&=-\\frac{3x}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5x}{5}-\\frac{x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{2}$",
          "worked": "$$\\begin{align*}\\frac{5x}{5}-\\frac{x}{2}&=\\frac{10x}{10}-\\frac{5x}{10}\\\\\\frac{5x}{5}-\\frac{x}{2}&=\\frac{5x}{10}=\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{5}{x}+\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{x}$",
          "worked": "$$\\begin{align*}\\frac{5}{x}+\\frac{2}{x}&=\\frac{5+2}{x}\\\\\\frac{5}{x}+\\frac{2}{x}&=\\frac{7}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{5}{x^2}+\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5+2x}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{5}{x^2}+\\frac{2}{x}&=\\frac{5}{x^2}+\\frac{2x}{x^2}\\\\\\frac{5}{x^2}+\\frac{2}{x}&=\\frac{5+2x}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{5}{2x^2}-\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5-4x}{2x^2}$",
          "worked": "$$\\begin{align*}\\frac{5}{2x^2}-\\frac{2}{x}&=\\frac{5}{2x^2}-\\frac{4x}{2x^2}\\\\\\frac{5}{2x^2}-\\frac{2}{x}&=\\frac{5-4x}{2x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{6}{2x^2}+\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3+2x}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{6}{2x^2}+\\frac{2}{x}&=\\frac{6}{2x^2}+\\frac{4x}{2x^2}\\\\\\frac{6}{2x^2}+\\frac{2}{x}&=\\frac{6+4x}{2x^2}\\\\\\frac{6}{2x^2}+\\frac{2}{x}&=\\frac{3+2x}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{6}{2xy}+\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3+2y}{xy}$",
          "worked": "$$\\begin{align*}\\frac{6}{2xy}+\\frac{2}{x}&=\\frac{6}{2xy}+\\frac{4y}{2xy}\\\\\\frac{6}{2xy}+\\frac{2}{x}&=\\frac{6+4y}{2xy}\\\\\\frac{6}{2xy}+\\frac{2}{x}&=\\frac{3+2y}{xy}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{6}{2xy}+\\frac{2}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9+2y}{3xy}$",
          "worked": "$$\\begin{align*}\\frac{6}{2xy}+\\frac{2}{3x}&=\\frac{18}{6xy}+\\frac{4y}{6xy}\\\\\\frac{6}{2xy}+\\frac{2}{3x}&=\\frac{18+4y}{6xy}\\\\\\frac{6}{2xy}+\\frac{2}{3x}&=\\frac{9+2y}{3xy}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q5-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac{6}{2xy}-\\frac{2}{3x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9x-2y}{3x^2y}$",
          "worked": "$$\\begin{align*}\\frac{6}{2xy}-\\frac{2}{3x^2}&=\\frac{18x}{6x^2y}-\\frac{4y}{6x^2y}\\\\\\frac{6}{2xy}-\\frac{2}{3x^2}&=\\frac{18x-4y}{6x^2y}\\\\\\frac{6}{2xy}-\\frac{2}{3x^2}&=\\frac{9x-2y}{3x^2y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q5-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{6y}{2xy}+\\frac{2}{3x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9x+2}{3x^2}$",
          "worked": "$$\\begin{align*}\\frac{6y}{2xy}+\\frac{2}{3x^2}&=\\frac{18xy}{6x^2y}+\\frac{4y}{6x^2y}\\\\\\frac{6y}{2xy}+\\frac{2}{3x^2}&=\\frac{18xy+4y}{6x^2y}\\\\\\frac{6y}{2xy}+\\frac{2}{3x^2}&=\\frac{9x+2}{3x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q5-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\frac{y}{2xy}-\\frac{2}{3x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x^2-4}{6x^3}$",
          "worked": "$$\\begin{align*}\\frac{y}{2xy}-\\frac{2}{3x^3}&=\\frac{3x^2y}{6x^3y}-\\frac{4y}{6x^3y}\\\\\\frac{y}{2xy}-\\frac{2}{3x^3}&=\\frac{3x^2y-4y}{6x^3y}\\\\\\frac{y}{2xy}-\\frac{2}{3x^3}&=\\frac{3x^2-4}{6x^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
