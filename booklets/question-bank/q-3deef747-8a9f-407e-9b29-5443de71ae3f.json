  "content": {
    "id": "p18-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "It takes 2 painters 3 hours to paint 4 rooms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q2a",
        "type": "part",
        "label": "a",
        "prompt": "How many hours will it take 3 painters to paint 6 rooms?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 hours",
          "worked": "More painters decrease the time; more rooms increase the time.\n$$\\begin{align*}\\text{Time}&=3\\times\\frac{2}{3}\\times\\frac{6}{4}\\\\\\text{Time}&=3\\text{ hours}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q2b",
        "type": "part",
        "label": "b",
        "prompt": "How many rooms can 15 painters paint in 5 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50 rooms",
          "worked": "More painters and more time both increase the number of rooms.\n$$\\begin{align*}\\text{Number of rooms}&=4\\times\\frac{15}{2}\\times\\frac{5}{3}\\\\\\text{Number of rooms}&=50.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q2c",
        "type": "part",
        "label": "c",
        "prompt": "How many hours will it take 5 painters to paint 2 rooms?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$ hours",
          "worked": "More painters and fewer rooms both decrease the time.\n$$\\begin{align*}\\text{Time}&=3\\times\\frac{2}{5}\\times\\frac{2}{4}\\\\\\text{Time}&=\\frac{3}{5}\\text{ hours}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
