  "content": {
    "id": "p44-q8",
    "type": "question",
    "label": "8",
    "prompt": "The cost of 1 apple and 1 banana at the school canteen is $\\$1$ and the cost of 3 apples and 2 bananas is $\\$2.40$.\nFind the cost of a single banana.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "A banana costs $\\$0.60$.",
      "worked": "Let $a$ be the price of an apple and $b$ be the price of a banana, in dollars.\n$$\\begin{align*}a+b&=1.00\\quad\\text{(1)}\\\\3a+2b&=2.40\\quad\\text{(2)}\\end{align*}$$\nSubtract $2\\times(1)$ from (2).\n$$\\begin{align*}(3a+2b)-2(a+b)&=2.40-2.00\\\\a&=0.40\\end{align*}$$\nSubstitute into (1).\n$$\\begin{align*}0.40+b&=1.00\\\\b&=0.60\\end{align*}$$\nA banana costs $\\$0.60$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 58
  },
