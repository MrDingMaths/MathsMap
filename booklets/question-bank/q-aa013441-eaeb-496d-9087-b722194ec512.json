  "content": {
    "id": "p36-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "$ABCD$ is a cyclic quadrilateral. Chord $AB$ is produced and a point $E$ is marked on the line $AB$ so that $B$ is between $A$ and $E$. Prove that $\\angle EBC=\\angle ADC$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\angle EBC=\\angle ADC$.",
      "worked": "Opposite angles of cyclic quadrilateral $ABCD$ are supplementary, so $\\angle ABC+\\angle ADC=180^\\circ$.\n\nSince $ABE$ is straight, $\\angle ABC+\\angle EBC=180^\\circ$.\n\nSubtracting the common angle $ABC$ gives $\\angle EBC=\\angle ADC$.",
      "solutionDiagrams": []
    },
