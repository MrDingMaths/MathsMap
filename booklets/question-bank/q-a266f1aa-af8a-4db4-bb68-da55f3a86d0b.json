      },
      {
        "id": "p43-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Did Emily walk faster when she was on her own or when she was with Ed?\nExplain your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "On her own. The graph is steeper when Emily was on her own.",
          "worked": "Emily walked faster on her own: the segment from 9:00 to 9:20 is steeper than the segment from 9:50 to 10:50. A steeper distance–time graph represents a greater speed.",
