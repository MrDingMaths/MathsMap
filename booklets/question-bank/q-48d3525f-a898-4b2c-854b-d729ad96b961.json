  "content": {
    "id": "p25-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A man buys a car for $\\$7500$ and sells it two years later for $\\$5000$. What is his percentage loss?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$33\\frac{1}{3}\\%$ loss.",
      "worked": "$$\\begin{align*}\\text{Loss}&=\\$7500-\\$5000\\\\\\text{Loss}&=\\$2500\\\\\\text{Percentage loss}&=\\frac{2500}{7500}\\times100\\%\\\\\\text{Percentage loss}&=33\\frac{1}{3}\\%\\end{align*}$$",
