    "id": "p10-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "How many ways can three adults and three children be arranged in a line given that the first and last positions are to be filled by an adult?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$144$",
      "worked": "There are 3 choices of adult for the first position and 2 choices of adult for the last position. The remaining adult and three children can be arranged in the four middle positions in $4!$ ways.\n\n$$\\begin{align*}N&=3\\times2\\times4!\\\\N&=144.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
