  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Simplify the following, expressing your answers using positive indices:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{a^{-1}-b^{-1}}{a^{-2}-b^{-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{ab}{a+b}$\n\nRewrite the negative powers as reciprocals and factor the difference of squares.",
          "worked": "$$\\begin{align*}\\frac{a^{-1}-b^{-1}}{a^{-2}-b^{-2}}&=\\frac{\\frac1a-\\frac1b}{\\frac1{a^2}-\\frac1{b^2}}\\\\\\frac{a^{-1}-b^{-1}}{a^{-2}-b^{-2}}&=\\frac{b-a}{ab}\\times\\frac{a^2b^2}{b^2-a^2}\\\\\\frac{a^{-1}-b^{-1}}{a^{-2}-b^{-2}}&=\\frac{ab(b-a)}{(b-a)(b+a)}\\\\\\frac{a^{-1}-b^{-1}}{a^{-2}-b^{-2}}&=\\frac{ab}{a+b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{a^{-2}-b^{-2}}{a^{-1}+b^{-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b-a}{ab}$\n\nRewrite the negative powers as reciprocals and factor the difference of squares.",
          "worked": "$$\\begin{align*}\\frac{a^{-2}-b^{-2}}{a^{-1}+b^{-1}}&=\\frac{\\frac1{a^2}-\\frac1{b^2}}{\\frac1a+\\frac1b}\\\\\\frac{a^{-2}-b^{-2}}{a^{-1}+b^{-1}}&=\\frac{b^2-a^2}{a^2b^2}\\times\\frac{ab}{a+b}\\\\\\frac{a^{-2}-b^{-2}}{a^{-1}+b^{-1}}&=\\frac{(b-a)(b+a)}{ab(a+b)}\\\\\\frac{a^{-2}-b^{-2}}{a^{-1}+b^{-1}}&=\\frac{b-a}{ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
