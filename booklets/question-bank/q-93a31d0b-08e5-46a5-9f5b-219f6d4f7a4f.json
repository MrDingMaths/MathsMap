  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "I drive around the city, travelling $200\\text{ km}$ at an average speed of $25\\text{ km/h}$. For what distance must I now travel at a speed of $100\\text{ km/h}$ to increase the average speed for the entire journey to $40\\text{ km/h}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$200\\text{ km}$\n\nUse total distance divided by total time for the entire journey.",
      "worked": "The first stage takes $\\frac{200}{25}=8$ hours. Let $d$ km be the additional distance; this takes $\\frac{d}{100}$ hours.\n$$\\begin{align*}\\frac{200+d}{8+\\frac{d}{100}}&=40\\\\200+d&=320+\\frac{2d}{5}\\\\1000+5d&=1600+2d\\\\3d&=600\\\\d&=200\\end{align*}$$\nThe additional distance is $200\\text{ km}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 72
  },
