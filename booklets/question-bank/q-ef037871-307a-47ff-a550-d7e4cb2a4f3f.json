    "type": "question",
    "label": "3",
    "prompt": "Determine if y=4x-3 contains the point (2,4).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No.",
      "worked": "For $x=2$,\n$$\\begin{align*}4x-3&=4(2)-3\\\\4x-3&=5.\\end{align*}$$\nSince $5\\ne4$, $(2,4)$ does not lie on the line.",
      "solutionDiagrams": []
    },
