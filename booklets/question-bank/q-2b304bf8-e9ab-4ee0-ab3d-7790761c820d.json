  "content": {
    "id": "p18-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Find the greatest number that divides 34, 90, and 104 and leaves the same remainder in each case.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$14$.\n\nFind the GCD of the differences; division by 14 leaves remainder 6 in each case.",
      "worked": "A number leaving the same remainder must divide the differences.\n\n$$\\begin{align*}90-34&=56\\\\104-34&=70\\\\56&=2^3\\times7\\\\70&=2\\times5\\times7\\\\\\operatorname{GCD}(56,70)&=2\\times7=14\\end{align*}$$\n\nCheck:\n\n$$\\begin{align*}34&=2\\times14+6\\\\90&=6\\times14+6\\\\104&=7\\times14+6\\end{align*}$$\n\nAll three remainders are 6, so the greatest number is $14$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 92
  },
