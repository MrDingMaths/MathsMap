    "type": "question",
    "label": "4",
    "prompt": "Peter walks 5.1 km each day. How many micrometres is this?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5\\,100\\,000\\,000\\ \\mu\\mathrm{m}$",
      "worked": "There are $1000$ metres in a kilometre and $1\\,000\\,000$ micrometres in a metre.\n\n$$\\begin{align*}5.1\\ \\mathrm{km}&=5.1\\times1000\\ \\mathrm{m}\\\\5.1\\ \\mathrm{km}&=5100\\ \\mathrm{m}\\\\5.1\\ \\mathrm{km}&=5100\\times1\\,000\\,000\\ \\mu\\mathrm{m}\\\\5.1\\ \\mathrm{km}&=5\\,100\\,000\\,000\\ \\mu\\mathrm{m}\\end{align*}$$",
      "solutionDiagrams": []
    },
