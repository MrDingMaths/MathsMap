  "content": {
    "id": "p49-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "In an aviary there are four canaries, five cockatoos and three budgerigars. If two birds are selected at random, find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "both are canaries,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{11}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q20-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{both canaries})&=\\frac{4}{12}\\times\\frac{3}{11}\\\\P(\\text{both canaries})&=\\frac{12}{132}\\\\P(\\text{both canaries})&=\\frac{1}{11}\\end{aligned}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p49-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "neither is a canary,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14}{33}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q20-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{neither canary})&=\\frac{8}{12}\\times\\frac{7}{11}\\\\P(\\text{neither canary})&=\\frac{56}{132}\\\\P(\\text{neither canary})&=\\frac{14}{33}\\end{aligned}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p49-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "one is a canary and one is a cockatoo,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{33}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q20-c-order-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The birds can be selected in either order.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p49-q20-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{one canary, one cockatoo})&=2\\times\\frac{4}{12}\\times\\frac{5}{11}\\\\P(\\text{one canary, one cockatoo})&=\\frac{40}{132}\\\\P(\\text{one canary, one cockatoo})&=\\frac{10}{33}\\end{aligned}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p49-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "at least one is a canary.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19}{33}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q20-d-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{at least one canary})&=1-P(\\text{neither canary})\\\\P(\\text{at least one canary})&=1-\\frac{14}{33}\\\\P(\\text{at least one canary})&=\\frac{19}{33}\\end{aligned}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
