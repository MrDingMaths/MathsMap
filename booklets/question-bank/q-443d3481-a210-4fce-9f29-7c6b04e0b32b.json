    "answer": {
      "short": "$93.6\\text{ cm}^2$. Two trapeziums; check using a rectangle and two triangles.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p21-q7-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Consider as two trapeziums. Using the symmetry shown, each has height ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "10.4\\div2=5.2\\text{ cm}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p21-q7-trapezium-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}A_{\\text{Total}}&=\\frac{5.2}{2}(6+12)\\times2\\\\A_{\\text{Total}}&=93.6\\text{ cm}^2\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p21-q7-alternative-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Another possibility is rectangle + 2 triangles. The rectangle is 6 cm wide and 10.4 cm high. Each side triangle has base 10.4 cm and perpendicular height ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{12-6}{2}=3\\text{ cm}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p21-q7-check-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}A_{\\text{rectangle}}&=6\\times10.4\\\\A_{\\text{rectangle}}&=62.4\\text{ cm}^2\\\\A_{\\text{triangle}}&=\\frac{10.4\\times3}{2}\\\\A_{\\text{triangle}}&=15.6\\text{ cm}^2\\\\A_{\\text{Total}}&=62.4+2\\times15.6\\\\A_{\\text{Total}}&=93.6\\text{ cm}^2\\end{align*}",
                "display": true
              }
            ]
          }
        ]
      },
