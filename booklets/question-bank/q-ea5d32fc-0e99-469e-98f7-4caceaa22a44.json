  "content": {
    "id": "p19-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "If I roll two fair, 6-sided dice, what is the probability that both show even numbers?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{4}$",
      "worked": "Each die has three even outcomes: 2, 4 and 6. The rolls are independent.\n$$\\begin{align*}P(\\text{even})&=\\frac{3}{6}=\\frac{1}{2}\\\\P(\\text{both even})&=\\frac{1}{2}\\times\\frac{1}{2}\\\\&=\\frac{1}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
