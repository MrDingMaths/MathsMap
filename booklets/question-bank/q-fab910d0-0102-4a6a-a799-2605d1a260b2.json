      {
        "id": "p19-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "What are the maximum and minimum values of $\\sin\\theta$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Maximum: $1$; minimum: $-1$.",
          "worked": "The highest ordinate of the sine graph is $1$ and the lowest is $-1$. Therefore the maximum is $1$ and the minimum is $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Where do they occur?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Maximum: $\\theta=90^\\circ+360^\\circ k$; minimum: $\\theta=270^\\circ+360^\\circ k$, where $k$ is any integer.",
          "worked": "On one revolution, the sine graph reaches its maximum at $90^\\circ$ and its minimum at $270^\\circ$. Its period is $360^\\circ$, so these repeat at\n$$\\begin{align*}\\theta_{\\text{maximum}}&=90^\\circ+360^\\circ k\\\\\\theta_{\\text{minimum}}&=270^\\circ+360^\\circ k\\end{align*}$$\nwhere $k$ is any integer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
