      {
        "id": "p27-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "If three numbers $x$, $y$, and $z$ satisfy\n$$\\begin{aligned}x+y&=7,\\\\x+z&=12,\\\\y+z&=21,\\end{aligned}$$\nfind $x+y+z$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "Add the three equations.\n$$\\begin{align*}(x+y)+(x+z)+(y+z)&=7+12+21\\\\2(x+y+z)&=40\\\\x+y+z&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p27-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "If three numbers $x$, $y$, and $z$ satisfy\n$$\\begin{aligned}xy&=7,\\\\xz&=12,\\\\yz&=21,\\end{aligned}$$\nfind $xyz$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p27-q13-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "xyz=\\pm42",
                    "display": false
                  }
                ]
              },
              {
                "id": "p27-q13-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Multiply the three equations. Both signs are possible because the numbers may all be positive or all negative.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Multiply the three equations.\n$$\\begin{align*}(xy)(xz)(yz)&=7\\times12\\times21\\\\(xyz)^2&=1764\\\\xyz&=\\pm42\\end{align*}$$\nBoth signs are possible: $(x,y,z)=(2,\\frac72,6)$ and $(x,y,z)=(-2,-\\frac72,-6)$ satisfy all three equations.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
