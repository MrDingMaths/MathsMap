  "content": {
    "id": "p22-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Do not use a calculator.\n\nUse the log law $\\log_a x^n=n\\log_a x$ and the identity $\\log_a a=1$ to simplify:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_a a^2&=2\\log_a a\\\\\\log_a a^2&=2\\times1\\\\\\log_a a^2&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\log_a a^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}5\\log_a a^3&=5\\times3\\log_a a\\\\5\\log_a a^3&=15\\times1\\\\5\\log_a a^3&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a\\frac{1}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\log_a\\frac{1}{a}&=\\log_a a^{-1}\\\\\\log_a\\frac{1}{a}&=-\\log_a a\\\\\\log_a\\frac{1}{a}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$12\\log_a\\sqrt{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}12\\log_a\\sqrt{a}&=12\\log_a a^{1/2}\\\\12\\log_a\\sqrt{a}&=12\\times\\frac12\\log_a a\\\\12\\log_a\\sqrt{a}&=6\\times1\\\\12\\log_a\\sqrt{a}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
