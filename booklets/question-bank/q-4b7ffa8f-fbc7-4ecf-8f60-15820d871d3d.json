      {
        "id": "p9-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Suppose the quadratic equation $4x^2-px-5=0$ has two roots that are of equal magnitude but opposite in sign. Find the value of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=0$.",
          "worked": "Let the roots be $\\alpha$ and $-\\alpha$.\n\nSum of roots:\n$$\\begin{aligned}\\alpha+(-\\alpha)&=-\\frac{b}{a}\\\\0&=\\frac{p}{4}\\\\p&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p9-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose the quadratic equation $x^2+5x+3p-1=0$ has two roots that are reciprocals of each other. Find the value of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\frac{2}{3}$.",
          "worked": "Let the roots be $\\alpha$ and $\\frac{1}{\\alpha}$.\n\nProduct of roots:\n$$\\begin{aligned}\\alpha\\times\\frac{1}{\\alpha}&=\\frac{c}{a}\\\\1&=3p-1\\\\p&=\\frac{2}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
