  "content": {
    "id": "v2-de45f-p12-practice-j3-021747-root",
    "type": "question",
    "label": null,
    "prompt": "The distance between $(p,2)$ and $(5,p)$ is exactly $\\sqrt{17}$ units.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-de45f-p12-practice-j3-021747-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the square of the distance between the points as an expression in $p$. Expand and simplify it.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2p^2-14p+29$",
          "worked": "$$\\begin{align*}d^2&=(5-p)^2+(p-2)^2\\\\&=25-10p+p^2+p^2-4p+4\\\\&=2p^2-14p+29\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-de45f-p12-practice-j3-021747-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence form a quadratic equation in $p$ and simplify it to $p^2+bp+c=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^2-7p+6=0$",
          "worked": "$$\\begin{align*}2p^2-14p+29&=17\\\\2p^2-14p+12&=0\\\\p^2-7p+6&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-de45f-p12-practice-j3-021747-j3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve for $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=1$ or $6$",
          "worked": "PSF: Product $=6$, Sum $=-7$, Factors $=-1$ and $-6$.$$\\begin{align*}(p-1)(p-6)&=0\\\\p&=1\\text{ or }6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
