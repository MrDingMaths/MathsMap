  "content": {
    "id": "v2-481a5-p20-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "The line through $A(-3,2)$ and $B(k,8)$ is perpendicular to $2x+3y-6=0$.\n\nFind the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=1$",
      "worked": "$$\\begin{align*}3y&=-2x+6\\\\y&=-\\frac{2}{3}x+2\\end{align*}$$\nThe perpendicular gradient is $\\dfrac32$.\n$$\\begin{align*}\\frac{8-2}{k-(-3)}&=\\frac32\\\\\\frac{6}{k+3}&=\\frac32\\\\12&=3(k+3)\\\\k&=1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
