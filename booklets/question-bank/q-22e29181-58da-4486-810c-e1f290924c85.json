  "content": {
    "id": "p52-q87-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x^2-2x-3$. Solve the following equations for $a$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q87-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(1-a)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm2$",
          "worked": "$$\\begin{align*}(1-a)^2-2(1-a)-3 &= 0\\\\a^2-4 &= 0\\\\a &= \\pm2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q87-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(2a)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p52-q87-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=\\frac{1\\pm\\sqrt5}{2}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p52-q87-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2a",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " into the function, then use the quadratic formula.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}(2a)^2-2(2a)-3 &= 1\\\\4a^2-4a-3 &= 1\\\\a^2-a-1 &= 0\\\\a &= \\frac{1\\pm\\sqrt{(-1)^2-4(1)(-1)}}{2(1)}\\\\a &= \\frac{1\\pm\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p52-q87-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(2a+1)=4f(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-1$",
          "worked": "$$\\begin{align*}(2a+1)^2-2(2a+1)-3 &= 4(a^2-2a-3)\\\\4a^2-4 &= 4a^2-8a-12\\\\8a &= -8\\\\a &= -1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p52-q87-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(a-1)+f(a+1)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p52-q87-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=1\\pm\\frac{\\sqrt{14}}{2}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p52-q87-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute both arguments and combine the expressions, then use the quadratic formula.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}(a-1)^2-2(a-1)-3+(a+1)^2-2(a+1)-3 &= 1\\\\2a^2-4a-4 &= 1\\\\2a^2-4a-5 &= 0\\\\a &= \\frac{4\\pm\\sqrt{(-4)^2-4(2)(-5)}}{2(2)}\\\\a &= \\frac{4\\pm\\sqrt{56}}{4}\\\\a &= 1\\pm\\frac{\\sqrt{14}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
