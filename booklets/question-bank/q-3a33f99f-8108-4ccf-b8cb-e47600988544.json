  "content": {
    "id": "p70-q24-response",
    "type": "question",
    "label": "24",
    "prompt": "For which values of $k$ will the line $y=k$ intersect $y=3+2x-x^2$ twice?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k<4$.",
      "worked": "Equating the expressions for $y$ gives\n$$x^2-2x+(k-3)=0.$$\nTwo distinct intersections require $\\Delta>0$.\n$$\\begin{align*}(-2)^2-4(k-3)&>0\\\\16-4k&>0\\\\k&<4.\\end{align*}$$",
      "solutionDiagrams": []
    },
