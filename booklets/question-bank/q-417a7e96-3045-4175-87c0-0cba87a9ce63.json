  "content": {
    "id": "p18-q10-root",
    "type": "question",
    "label": "3",
    "prompt": "Use complementary-angle identities to rewrite each right-hand side as a single trigonometric term on the left. Keep the angle from the first term on the right and state $a$ and $x$ without evaluating the trigonometric ratios.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$a\\tan x=2\\tan\\frac\\pi6+4\\cot\\frac\\pi3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=6,\\quad x=\\frac\\pi6$.",
          "worked": "$$\\begin{align*}\\cot\\frac\\pi3&=\\tan\\left(\\frac\\pi2-\\frac\\pi3\\right)\\\\\\cot\\frac\\pi3&=\\tan\\frac\\pi6\\\\a\\tan x&=2\\tan\\frac\\pi6+4\\tan\\frac\\pi6\\\\a\\tan x&=6\\tan\\frac\\pi6.\\end{align*}$$\nKeeping the first angle gives $a=6$ and $x=\\frac\\pi6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p18-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$a\\sin x=\\sin\\frac\\pi{12}+5\\cos\\frac{5\\pi}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=6,\\quad x=\\frac\\pi{12}$.",
          "worked": "$$\\begin{align*}\\cos\\frac{5\\pi}{12}&=\\sin\\left(\\frac\\pi2-\\frac{5\\pi}{12}\\right)\\\\\\cos\\frac{5\\pi}{12}&=\\sin\\frac\\pi{12}\\\\a\\sin x&=\\sin\\frac\\pi{12}+5\\sin\\frac\\pi{12}\\\\a\\sin x&=6\\sin\\frac\\pi{12}.\\end{align*}$$\nKeeping the first angle gives $a=6$ and $x=\\frac\\pi{12}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
