  "content": {
    "id": "p35-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Find the equation of the line that is perpendicular to the line with equation $y=2x-4$ and passes through the point $(3,8)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-\\frac12x+\\frac{19}{2}$",
      "worked": "The given line has gradient $2$, so the perpendicular gradient is $-\\frac12$.\nUsing $y-y_1=m(x-x_1)$ through $(3,8)$:\n$$\\begin{align*}y-8&=-\\frac12(x-3)\\\\y-8&=-\\frac12x+\\frac32\\\\y&=-\\frac12x+\\frac{19}{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
