  "content": {
    "id": "p15-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve each of the following equations:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$4^{n+1}=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac12$",
          "worked": "$$\\begin{align*}(2^2)^{n+1}&=2^3\\\\2^{2n+2}&=2^3\\\\2n+2&=3\\\\2n&=1\\\\n&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$9^{n+2}=27$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-\\dfrac12$",
          "worked": "$$\\begin{align*}(3^2)^{n+2}&=3^3\\\\3^{2n+4}&=3^3\\\\2n+4&=3\\\\2n&=-1\\\\n&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^{2n-1}=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac54$",
          "worked": "$$\\begin{align*}(2^2)^{2n-1}&=2^3\\\\2^{4n-2}&=2^3\\\\4n-2&=3\\\\4n&=5\\\\n&=\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$8^{2n}=4^{n+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac12$",
          "worked": "$$\\begin{align*}(2^3)^{2n}&=(2^2)^{n+1}\\\\2^{6n}&=2^{2n+2}\\\\6n&=2n+2\\\\4n&=2\\\\n&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$9^{3n}=27^{n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-1$",
          "worked": "$$\\begin{align*}(3^2)^{3n}&=(3^3)^{n-1}\\\\3^{6n}&=3^{3n-3}\\\\6n&=3n-3\\\\3n&=-3\\\\n&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$16^{4n}=8^{2n+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac9{10}$",
          "worked": "$$\\begin{align*}(2^4)^{4n}&=(2^3)^{2n+3}\\\\2^{16n}&=2^{6n+9}\\\\16n&=6n+9\\\\10n&=9\\\\n&=\\frac9{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac1{4^{n+1}}=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-\\dfrac52$",
          "worked": "$$\\begin{align*}(2^2)^{-(n+1)}&=2^3\\\\2^{-2n-2}&=2^3\\\\-2n-2&=3\\\\-2n&=5\\\\n&=-\\frac52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac1{9^{n+2}}=\\dfrac1{27}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-\\dfrac12$",
          "worked": "$$\\begin{align*}(3^2)^{-(n+2)}&=3^{-3}\\\\3^{-2n-4}&=3^{-3}\\\\-2n-4&=-3\\\\-2n&=1\\\\n&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(\\dfrac14\\right)^{3n-1}=\\dfrac18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac56$",
          "worked": "$$\\begin{align*}(2^{-2})^{3n-1}&=2^{-3}\\\\2^{-6n+2}&=2^{-3}\\\\-6n+2&=-3\\\\-6n&=-5\\\\n&=\\frac56\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
