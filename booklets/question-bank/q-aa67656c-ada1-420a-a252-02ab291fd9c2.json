            "answer": {
              "short": "$\\dfrac{81}{100}$",
              "worked": "$\\begin{aligned}P(X<9)&=\\int_0^9\\frac{x}{50}\\,dx\\\\&=\\left[\\frac{x^2}{100}\\right]_0^9\\\\&=\\frac{81}{100}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
