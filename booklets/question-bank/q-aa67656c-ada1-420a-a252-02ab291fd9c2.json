        "answer": {
          "short": "$y=\\dfrac{x}{50}$",
          "worked": "$\\begin{aligned}\\int_0^{10}ax\\,dx&=1\\\\\\left[\\frac{ax^2}{2}\\right]_0^{10}&=1\\\\50a&=1\\\\a&=\\frac{1}{50}\\\\y&=\\frac{x}{50}\\end{aligned}$",
