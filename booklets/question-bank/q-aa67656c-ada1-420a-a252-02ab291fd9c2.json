              "short": "$\\dfrac{9}{100}$",
              "worked": "$\\begin{aligned}P(X\\le3)&=\\int_0^3\\frac{x}{50}\\,dx\\\\&=\\left[\\frac{x^2}{100}\\right]_0^3\\\\&=\\frac{9}{100}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p21-q13-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(4\\le X\\le7)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{33}{100}$",
              "worked": "$\\begin{aligned}P(4\\le X\\le7)&=\\int_4^7\\frac{x}{50}\\,dx\\\\&=\\left[\\frac{x^2}{100}\\right]_4^7\\\\&=\\frac{49-16}{100}\\\\&=\\frac{33}{100}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p21-q13-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(2<X<6)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{8}{25}$",
              "worked": "$\\begin{aligned}P(2<X<6)&=\\int_2^6\\frac{x}{50}\\,dx\\\\&=\\left[\\frac{x^2}{100}\\right]_2^6\\\\&=\\frac{36-4}{100}\\\\&=\\frac{8}{25}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
