  "content": {
    "id": "p15-q6-root",
    "type": "question",
    "label": null,
    "prompt": "State the range of the following in the domain $x\\in\\left[0,\\frac{\\pi}{2}\\right]$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[0,1]$.",
          "worked": "On $\\left[0,\\frac{\\pi}{2}\\right]$, $\\sin x$ increases from $0$ to $1$. Hence $y\\in[0,1]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[0,1]$.",
          "worked": "On $\\left[0,\\frac{\\pi}{2}\\right]$, $\\cos x$ decreases from $1$ to $0$. Hence $y\\in[0,1]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[0,\\infty)$.",
          "worked": "$\\tan 0=0$, and $\\tan x$ increases without bound as $x$ approaches $\\frac{\\pi}{2}$ from below. It is undefined at $\\frac{\\pi}{2}$. Hence $y\\in[0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\operatorname{cosec}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[1,\\infty)$.",
          "worked": "Where defined, $0<\\sin x\\leq1$. Taking reciprocals gives $\\operatorname{cosec}x\\geq1$, with no upper bound as $x$ approaches $0$ from above. Hence $y\\in[1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\sec x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[1,\\infty)$.",
          "worked": "Where defined, $0<\\cos x\\leq1$. Taking reciprocals gives $\\sec x\\geq1$, with no upper bound as $x$ approaches $\\frac{\\pi}{2}$ from below. Hence $y\\in[1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\cot x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[0,\\infty)$.",
          "worked": "$\\cot x=\\frac{\\cos x}{\\sin x}$ decreases from arbitrarily large positive values to $0$ at $x=\\frac{\\pi}{2}$. It is undefined at $0$. Hence $y\\in[0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
