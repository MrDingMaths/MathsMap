    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the gradient of each side.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AB}=\\frac12$, $m_{BC}=-2$, $m_{CA}=0$.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{2-0}{3-(-1)}\\\\m_{AB}&=\\frac12\\\\m_{BC}&=\\frac{0-2}{4-3}\\\\m_{BC}&=-2\\\\m_{CA}&=\\frac{0-0}{-1-4}\\\\m_{CA}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why $\\triangle ABC$ is a right-angled triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AB}m_{BC}=-1$, so $AB\\perp BC$ and $\\triangle ABC$ is right-angled at $B$.",
          "worked": "$$\\begin{align*}m_{AB}\\times m_{BC}&=\\frac12\\times(-2)\\\\m_{AB}\\times m_{BC}&=-1\\end{align*}$$\nThe gradients are negative reciprocals, so $AB\\perp BC$. Hence $\\triangle ABC$ is right-angled at $B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ],
    "diagramPlacement": "beside-prompt"
