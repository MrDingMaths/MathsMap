    "children": [
      {
        "id": "p51-q1-response",
        "type": "part",
        "label": "a",
        "prompt": "$\\{a,b,c\\}\\cup\\{a,b,c,d,e\\}=\\{a,b,c,d,e\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The union contains every element in either set: $\\{a,b,c,d,e\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p51-q2-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\{a,b,c\\}\\cap\\{a,b,c,d,e\\}=\\{a,b,c\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The elements common to both sets are $a$, $b$ and $c$, so their intersection is $\\{a,b,c\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p51-q3-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\{a,b,c\\}\\cap\\overline{\\{a,b,c,d,e\\}}=\\{d,e\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. The left side is $\\varnothing$.",
          "worked": "False. Every element of $\\{a,b,c\\}$ belongs to $\\{a,b,c,d,e\\}$, so none belongs to its complement. Hence\n$$\\{a,b,c\\}\\cap\\overline{\\{a,b,c,d,e\\}}=\\varnothing.$$",
