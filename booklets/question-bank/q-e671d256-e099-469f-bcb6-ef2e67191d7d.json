        "children": [],
        "answer": {
          "short": "$17$",
          "worked": "$$\\begin{align*}(2\\sqrt5-\\sqrt3)(2\\sqrt5+\\sqrt3)&=(2\\sqrt5)^2-(\\sqrt3)^2\\\\(2\\sqrt5-\\sqrt3)(2\\sqrt5+\\sqrt3)&=20-3\\\\(2\\sqrt5-\\sqrt3)(2\\sqrt5+\\sqrt3)&=17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
