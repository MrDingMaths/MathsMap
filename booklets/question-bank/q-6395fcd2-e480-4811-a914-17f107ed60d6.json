    "label": "30",
    "prompt": "Find the largest ten-digit number divisible by 4 and 9.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9\\,999\\,999\\,972$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p79-q30-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The largest ten-digit number is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "9\\,999\\,999\\,999",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ". The number formed by the last two digits must be divisible by 4.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p79-q30-answer-maximality",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Every ten-digit number larger than 9 999 999 972 has its first eight digits all 9. The only larger endings divisible by 4 are 96, 92, 88, 84, 80 and 76. Their digit sums are 87, 83, 88, 84, 80 and 85 respectively; none is divisible by 9.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p79-q30-answer-check",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The next ending is 72:",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}72\\div4&=18\\\\\\text{Digit sum}&=8\\times9+7+2\\\\&=81.\\end{aligned}",
                "display": false,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p79-q30-answer-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Since 81 is divisible by 9, the largest qualifying number is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "9\\,999\\,999\\,972",
                "display": false,
                "colour": "#268cff"
              },
              {
