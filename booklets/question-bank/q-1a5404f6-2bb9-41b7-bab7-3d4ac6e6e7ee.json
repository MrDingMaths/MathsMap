    "type": "question",
    "label": "12",
    "prompt": "Solve $\\cos 2x=\\sin x$ for $0^\\circ\\le x\\le360^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=30^\\circ,150^\\circ,270^\\circ$.",
      "worked": "$$\\begin{align*}1-2\\sin^2x&=\\sin x\\\\2\\sin^2x+\\sin x-1&=0\\\\(2\\sin x-1)(\\sin x+1)&=0\\end{align*}$$\nHence $\\sin x=\\frac12$ or $\\sin x=-1$.\n$$\\begin{align*}\\sin x&=\\frac12,&x&=30^\\circ,150^\\circ\\\\\\sin x&=-1,&x&=270^\\circ\\end{align*}$$\nTherefore $x=30^\\circ,150^\\circ,270^\\circ$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
