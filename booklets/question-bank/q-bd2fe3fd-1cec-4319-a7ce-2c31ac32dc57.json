            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "For example, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "f(x)=x,\\quad x\\ne0",
                "display": false
              },
              {
                "type": "text",
                "text": ". Its reciprocal is ",
                "marks": []
              },
              {
