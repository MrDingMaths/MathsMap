  "content": {
    "id": "p10-q9-response",
    "type": "question",
    "label": "4",
    "prompt": "Give an example of a function where the graph of $y=f(x)$ does not have any $x$-intercepts, but the graph of $y=\\dfrac{1}{f(x)}$ has a vertical asymptote.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p10-q9-short-result",
            "type": "paragraph",
            "fontSize": null,
