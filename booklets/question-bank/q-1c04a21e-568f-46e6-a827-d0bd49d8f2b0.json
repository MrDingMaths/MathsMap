  "content": {
    "id": "p25-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Gold is measured in troy ounces. One troy ounce is equal to $31.103$ g. What is the weight, in grams, of each of the following gold nuggets?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "The Welcome Nugget, found at Ballarat in 1858, weighing 2217 ounces",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$68\\,955.351\\text{ g}$",
          "worked": "$$\\begin{align*}31.103\\times2217&=\\frac{31\\,103\\times2217}{1000}\\\\31.103\\times2217&=\\frac{68\\,955\\,351}{1000}\\\\31.103\\times2217&=68\\,955.351\\end{align*}$$\n\nThe nugget weighs $68\\,955.351$ g.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "The Welcome Stranger Nugget, found at Moliagul in 1869, weighing 2284 ounces",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$71\\,039.252\\text{ g}$",
          "worked": "$$\\begin{align*}31.103\\times2284&=\\frac{31\\,103\\times2284}{1000}\\\\31.103\\times2284&=\\frac{71\\,039\\,252}{1000}\\\\31.103\\times2284&=71\\,039.252\\end{align*}$$\n\nThe nugget weighs $71\\,039.252$ g.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "The Beyers and Holterman specimen, which was reported to have contained 3000 ounces of gold",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$93\\,309\\text{ g}$",
          "worked": "$$\\begin{align*}31.103\\times3000&=31.103\\times1000\\times3\\\\31.103\\times3000&=31\\,103\\times3\\\\31.103\\times3000&=93\\,309\\end{align*}$$\n\nThe specimen contained $93\\,309$ g of gold.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
