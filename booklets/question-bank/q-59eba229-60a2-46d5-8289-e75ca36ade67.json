    "type": "question",
    "label": "14",
    "prompt": "Find the first five terms of the GP with $a=48$ and $a_5=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$48,24,12,6,3$ or $48,-24,12,-6,3$.",
      "worked": "$$\\begin{align*}a_5&=ar^4\\\\3&=48r^4\\\\r^4&=\\frac{1}{16}\\\\r&=\\frac12\\text{ or }-\\frac12\\end{align*}$$\nFor $r=\\frac12$: $48,24,12,6,3$.\n\nFor $r=-\\frac12$: $48,-24,12,-6,3$.",
      "solutionDiagrams": []
