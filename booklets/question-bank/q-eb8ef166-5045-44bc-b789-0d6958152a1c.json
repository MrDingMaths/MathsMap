          {
            "id": "reuse-s5-p87-umi-error",
            "type": "part",
            "label": "i",
            "prompt": "What did Umi do wrong in her first step?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "She subtracted $5$ from each constant on the right instead of applying the same operation once to both sides.",
              "worked": "Umi subtracted $5$ from each constant term on the right, subtracting $10$ in total, while leaving the left side unchanged. An operation must be applied once to each side to preserve equality.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "reuse-s5-p87-umi-next-step",
            "type": "part",
            "label": "ii",
            "prompt": "What should Umi have done on the right side of the equation to solve it?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Simplify $-6+5$ to $-1$, then subtract $3x$ from both sides.",
              "worked": "Combine the constants: $-6+5=-1$. This gives $3x=4x-1$. Subtract $3x$ from both sides to keep a positive coefficient of $x$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "reuse-s5-p87-umi-solve",
            "type": "part",
            "label": "iii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
