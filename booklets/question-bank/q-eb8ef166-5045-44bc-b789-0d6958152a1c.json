          {
            "id": "reuse-s5-p87-jackson-identify",
            "type": "part",
            "label": "i",
            "prompt": "Which terms did Jackson incorrectly combine to get $9x$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$ and $6x$; they are not like terms.",
              "worked": "$3$ is a constant term and $6x$ is an $x$ term. They are not like terms, so they cannot be combined.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "reuse-s5-p87-jackson-like-terms",
            "type": "part",
            "label": "ii",
            "prompt": "Give an example of two terms that would correctly add to $9x$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "For example, $3x+6x$.",
              "worked": "$3x+6x=(3+6)x=9x$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "reuse-s5-p87-jackson-solve",
            "type": "part",
            "label": "iii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "reuse-s5-p87-jackson-solve-instruction",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Solve:",
                      "marks": []
                    }
                  ]
                },
                {
                  "id": "reuse-s5-p87-jackson-solve-equation",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "center",
                  "spaceBefore": 2,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "-6x+3=-5x",
                      "display": false
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=3$. Add $6x$ to both sides to get $3=x$.",
              "worked": "$$\\begin{align*}-6x+6x+3&=-5x+6x\\\\3&=x\\\\x&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
