                  "align": "center",
                  "spaceBefore": 2,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "6x=3x-5-4",
                      "display": false
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-3$.",
              "worked": "$$\\begin{align*}6x&=3x-9\\\\3x&=-9\\\\x&=-3\\end{align*}$$",
