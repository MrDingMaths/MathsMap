  "content": {
    "id": "v2-429c3-p20-practice-slot-4-022849-root",
    "type": "question",
    "label": null,
    "prompt": "Substitute, simplify and rearrange to make the stated pronumeral the subject.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-429c3-p20-practice-slot-4-022849-s4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Substitute $x=\\dfrac{t}{t+2}$ into $y=\\dfrac{3x}{x+1}$, then make $t$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{2y}{3-2y}$",
          "worked": "$$\\begin{align*}y&=\\frac{\\frac{3t}{t+2}}{\\frac{t}{t+2}+1}\\\\y&=\\frac{3t}{t+t+2}\\\\y&=\\frac{3t}{2t+2}\\\\y(2t+2)&=3t\\\\2yt+2y&=3t\\\\2y&=3t-2yt\\\\2y&=t(3-2y)\\\\t&=\\frac{2y}{3-2y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      },
      {
        "id": "v2-429c3-p20-practice-slot-4-022849-s4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute $m=\\dfrac{x}{x+k}$ into $y=\\dfrac{m+1}{m-1}$, then make $x$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{k(y+1)}{2}$",
          "worked": "$$\\begin{align*}y&=\\frac{\\frac{x}{x+k}+1}{\\frac{x}{x+k}-1}\\\\y&=\\frac{x+x+k}{x-(x+k)}\\\\y&=\\frac{2x+k}{-k}\\\\-ky&=2x+k\\\\2x&=-ky-k\\\\x&=-\\frac{k(y+1)}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
