    "label": "6",
    "prompt": "How many subsets of $\\{1,2,3,4,5,6\\}$ have at least one element?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$63$",
      "worked": "There are $2^6$ subsets, including the empty set. Subtract the one empty subset:\n$$\\begin{align*}N&=2^6-1\\\\N&=63.\\end{align*}$$",
