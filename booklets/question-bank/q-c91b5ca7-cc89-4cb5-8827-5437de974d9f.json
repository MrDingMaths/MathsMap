        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(8x+3)(5x-2)$",
          "worked": "$P=-240$, $S=-1$, $F=-16,15$.\n$$\\begin{align*}40x^{2}-x-6&=40x^{2}-16x+15x-6\\\\&=8x(5x-2)+3(5x-2)\\\\&=(8x+3)(5x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
