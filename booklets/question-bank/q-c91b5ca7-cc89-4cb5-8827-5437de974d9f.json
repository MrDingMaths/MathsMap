        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(7x-2)(3x+4)$",
          "worked": "$P=-168$, $S=22$, $F=28,-6$.\n$$\\begin{align*}21x^{2}+22x-8&=21x^{2}+28x-6x-8\\\\&=7x(3x+4)-2(3x+4)\\\\&=(7x-2)(3x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p53-q8-c",
