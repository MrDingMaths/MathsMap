    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Between June 1996 and June 2001, the population of Brisbane increased by $133\\,400$ people to reach $1.7$ million. What was the population in June 1996?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1\\,566\\,600$ people.",
      "worked": "$1.7$ million $=1\\,700\\,000$ people.\n\n$$\\begin{array}{r}1\\,700\\,000\\\\-\\phantom{0}133\\,400\\\\\\hline1\\,566\\,600\\\\\\hline\\end{array}$$\n\nThe population in June 1996 was $1\\,566\\,600$ people.",
