  "content": {
    "id": "p11-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Suppose $\\sin\\theta=0.6$. Find each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.6$",
          "worked": "$$\\begin{align*}\\sin(\\pi-\\theta)&=\\sin\\theta\\\\\\sin(\\pi-\\theta)&=0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin(-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.6$",
          "worked": "$$\\begin{align*}\\sin(-\\theta)&=-\\sin\\theta\\\\\\sin(-\\theta)&=-0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin(\\pi+\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.6$",
          "worked": "$$\\begin{align*}\\sin(\\pi+\\theta)&=-\\sin\\theta\\\\\\sin(\\pi+\\theta)&=-0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin(2\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.6$",
          "worked": "$$\\begin{align*}\\sin(2\\pi-\\theta)&=\\sin(-\\theta)\\\\\\sin(2\\pi-\\theta)&=-\\sin\\theta\\\\\\sin(2\\pi-\\theta)&=-0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
