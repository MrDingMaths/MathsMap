      {
        "id": "p11-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "There are infinitely many lines that will cut a single rectangle into two regions of equal area. Describe these lines.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Any straight line through the centre of the rectangle.",
          "worked": "The centre is the intersection of the diagonals. A half-turn about this centre maps the rectangle onto itself and exchanges the two regions cut by any line through the centre. The regions therefore have equal area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "A small rectangular region is removed from a larger rectangular region. Using a single straight line, how can you cut what remains into two regions of equal area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p11-q12-b-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"retainedArea\",\"hex\":\"D4E8FF\",\"reason\":\"retained rectangular area contrasted with the removed white region\"}],\"reference\":\"source page 11, p11-q12-b-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{retainedArea}{HTML}{D4E8FF}\n\\draw[fill=retainedArea] (0,0) rectangle (3,2.4);\n\\draw[fill=retainedArea] (3.9,0) rectangle (6.9,2.4);\n\\begin{scope}[shift={(4.8,1.35)},rotate=28]\n\\draw[fill=white] (-0.34,-0.7) rectangle (0.34,0.7);\n\\end{scope}\n\\end{tikzpicture}",
