        "answer": {
          "short": "$100^\\circ\\mathrm{C}$",
          "worked": "Initially, $h=0$.\n$$\\begin{align*}T &= 100\\times(0.87)^0\\\\T &= 100^\\circ\\mathrm{C}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p29-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "How long would it take for the temperature to drop to $70^\\circ\\mathrm{C}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{0.87}(0.7)$ minutes $\\approx 2.56$ minutes",
          "worked": "$$\\begin{align*}70 &= 100\\times(0.87)^h\\\\0.7 &= (0.87)^h\\\\h &= \\log_{0.87}(0.7)\\\\h &\\approx 2.56\\text{ minutes}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
