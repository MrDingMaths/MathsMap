  "content": {
    "id": "v2-8cb27-p12-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "A sector has perimeter $(24+8\\pi)\\text{ cm}$. If the angle subtended at the centre is $\\frac{2\\pi}{3}$ radians, find in exact form the area of the sector.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$48\\pi\\text{ cm}^{2}$",
      "worked": "$$\\begin{align*}P&=2r+r\\theta\\\\24+8\\pi&=2r+\\frac{2\\pi}{3}r\\\\8(3+\\pi)&=\\frac{2r}{3}(3+\\pi)\\\\r&=12\\text{ cm}\\\\A&=\\frac12r^2\\theta\\\\A&=\\frac12\\times12^2\\times\\frac{2\\pi}{3}\\\\A&=48\\pi\\text{ cm}^{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
