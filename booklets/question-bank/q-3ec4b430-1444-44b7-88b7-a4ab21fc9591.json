      {
        "id": "p57-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $\\left(x+\\frac{1}{x}\\right)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2+\\frac{1}{x^2}$",
          "worked": "$$\\begin{aligned}\\left(x+\\frac{1}{x}\\right)^2&=x^2+2x\\left(\\frac{1}{x}\\right)+\\frac{1}{x^2}\\\\&=x^2+2+\\frac{1}{x^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p57-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "Suppose that $x=\\sqrt{7}+\\sqrt{6}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p57-q10-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Show that $x+\\frac{1}{x}=2\\sqrt{7}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x+\\frac{1}{x}=\\sqrt{7}+\\sqrt{6}+\\sqrt{7}-\\sqrt{6}=2\\sqrt{7}$.",
              "worked": "$$\\begin{aligned}x+\\frac{1}{x}&=\\sqrt{7}+\\sqrt{6}+\\frac{1}{\\sqrt{7}+\\sqrt{6}}\\\\&=\\sqrt{7}+\\sqrt{6}+\\frac{1}{\\sqrt{7}+\\sqrt{6}}\\times\\frac{\\sqrt{7}-\\sqrt{6}}{\\sqrt{7}-\\sqrt{6}}\\\\&=\\sqrt{7}+\\sqrt{6}+\\frac{\\sqrt{7}-\\sqrt{6}}{7-6}\\\\&=2\\sqrt{7}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p57-q10-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p57-q10-b-ii-instruction",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 1,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Use the result in part ",
                      "marks": []
                    },
                    {
                      "type": "text",
                      "text": "a",
                      "marks": [
                        "bold"
                      ]
                    },
                    {
                      "type": "text",
                      "text": " to find the value of ",
                      "marks": []
                    },
                    {
                      "type": "math",
                      "latex": "x^2+\\frac{1}{x^2}",
                      "display": false
                    },
                    {
                      "type": "text",
                      "text": ".",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$26$, since $x^2+\\frac{1}{x^2}=(2\\sqrt{7})^2-2$.",
              "worked": "$$\\begin{aligned}\\left(x+\\frac{1}{x}\\right)^2&=x^2+2+\\frac{1}{x^2}\\\\\\therefore\\quad x^2+\\frac{1}{x^2}&=\\left(x+\\frac{1}{x}\\right)^2-2\\\\&=(2\\sqrt{7})^2-2\\\\&=26\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      }
    ]
  },
