  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Given $\\csc\\theta=2$, find the value of $\\sec\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sec\\theta=\\pm\\frac{2\\sqrt3}{3}$.",
      "worked": "$$\\begin{align*}\\sin\\theta&=\\frac12\\\\\\cos^2\\theta&=1-\\left(\\frac12\\right)^2\\\\\\cos^2\\theta&=\\frac34\\\\\\cos\\theta&=\\pm\\frac{\\sqrt3}{2}\\\\\\sec\\theta&=\\frac1{\\cos\\theta}\\\\\\sec\\theta&=\\pm\\frac{2\\sqrt3}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
