  "content": {
    "id": "p27-q7-root",
    "type": "question",
    "label": null,
    "prompt": "A ball is rolled horizontally off the top of a $45\\text{ m}$ cliff at $20\\text{ m/s}$. Taking the origin at the base, find the following. Use $g=10\\text{ m/s}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$x$ and $y$ as functions of $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=20t$, $y=-5t^2+45$.",
          "worked": "$$\\begin{aligned}\\theta&=0\\\\ \\dot{x}&=20,\\qquad\\dot{y}(0)=0\\\\ x&=20t\\qquad(x(0)=0)\\\\ y&=-5t^2+C\\\\ y&=-5t^2+45\\qquad(y(0)=45)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p27-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "The time to land.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\text{ s}$.",
          "worked": "At ground level, $y=0$.\n$$\\begin{aligned}5t^2&=45\\\\ t^2&=9\\\\ t&=3\\text{ s}\\end{aligned}$$\nTake the positive time.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p27-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "The range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60\\text{ m}$.",
          "worked": "$$\\begin{aligned}x(3)&=20(3)\\\\ &=60\\text{ m}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p27-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "The impact speed and angle to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36.1\\text{ m/s}$ at $56.3^\\circ$ below the horizontal.",
          "worked": "$$\\begin{aligned}\\dot{x}&=20\\\\ \\dot{y}(3)&=-10(3)=-30\\\\ V&=\\sqrt{400+900}\\\\ &=10\\sqrt{13}\\\\ &\\approx36.1\\text{ m/s}\\\\ \\theta&=\\tan^{-1}\\left(\\frac{30}{20}\\right)\\approx56.3^\\circ\\end{aligned}$$\nThe impact direction is $56.3^\\circ$ below the horizontal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
