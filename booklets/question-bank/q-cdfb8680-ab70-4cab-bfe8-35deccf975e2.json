    "children": [
      {
        "id": "p12-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+x<30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6<x<5$.",
          "worked": "$$\\begin{align*}x^2+x-30&=(x+6)(x-5)\\end{align*}$$\nThe graph of $y=(x+6)(x-5)$ opens upwards and has $x$-intercepts $-6$ and $5$. It lies below the $x$-axis between these intercepts.\nHence $-6<x<5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p12-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+5x\\geq-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq-3$ or $x\\geq-2$.",
          "worked": "$$\\begin{align*}x^2+5x+6&=(x+3)(x+2)\\end{align*}$$\nThe graph of $y=(x+3)(x+2)$ opens upwards and has $x$-intercepts $-3$ and $-2$. It lies on or above the $x$-axis outside the interval between these intercepts, including the intercepts.\nHence $x\\leq-3$ or $x\\geq-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p12-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$-x^2+4x+60\\leq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq-6$ or $x\\geq10$.",
          "worked": "$$\\begin{align*}-x^2+4x+60&=-(x^2-4x-60)\\\\-x^2+4x+60&=-(x-10)(x+6)\\end{align*}$$\nThe graph of $y=-(x-10)(x+6)$ opens downwards and has $x$-intercepts $-6$ and $10$. It lies on or below the $x$-axis outside the interval between these intercepts, including the intercepts.\nHence $x\\leq-6$ or $x\\geq10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
