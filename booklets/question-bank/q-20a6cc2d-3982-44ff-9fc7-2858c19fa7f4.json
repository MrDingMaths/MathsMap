        "type": "part",
        "label": "a",
        "prompt": "A courier in Perth starts deliveries at 8:20 am and finishes at 5:20 pm. She delivers 50 parcels. Find the rate at which she delivers, in parcels/hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.56\\text{ parcels/hour}$",
          "worked": "From 8:20 am to 5:20 pm is $9$ hours.\n$$\\begin{align*}\\text{Rate}&=\\frac{50\\text{ parcels}}{9\\text{ hours}}\\\\&=\\frac{\\frac{50}{9}\\text{ parcels}}{1\\text{ hour}}\\\\&\\approx5.56\\text{ parcels/hour}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-612b9b-p5-practice-retro-slot-3-225238-retro-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "A bushwalker leaves a campsite at 6:40 am and reaches a lookout at 1:40 pm after walking 25 km. Find her average speed, in km/hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.57\\text{ km/hour}$",
          "worked": "From 6:40 am to 1:40 pm is $7$ hours.\n$$\\begin{align*}\\text{Rate}&=\\frac{25\\text{ km}}{7\\text{ hours}}\\\\&=\\frac{\\frac{25}{7}\\text{ km}}{1\\text{ hour}}\\\\&\\approx3.57\\text{ km/hour}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
