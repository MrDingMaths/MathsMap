    "children": [
      {
        "id": "p81-q48-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why Car $B$ has displacement equation $$x_B(t)=x_A(t-2),$$ where $t\\geq 2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Car $B$ starts at $t=2$ and follows Car $A$'s motion, so at time $t$ it has travelled for $t-2$ seconds.",
          "worked": "Car $A$ has travelled for $t$ seconds, whereas Car $B$ has travelled for $t-2$ seconds. They follow the same displacement rule from the same starting point. Thus $x_B(t)=x_A(t-2)$ for $t\\geq2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p81-q48-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the time when Car $A$ and Car $B$ collide.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p81-q48-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "They collide ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2.5",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " seconds after Car A is released.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p81-q48-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Equate their displacements using ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x_B(t)=x_A(t-2)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "\n\n$$\\begin{align*}x_A(t)&=3t-t^2\\\\x_B(t)&=3(t-2)-(t-2)^2\\\\x_B(t)&=7t-t^2-10\\\\3t-t^2&=7t-t^2-10\\\\4t&=10\\\\t&=\\frac52\\end{align*}$$\n\n Since $\\frac52\\geq2$, the cars collide $2.5$ seconds after Car $A$ is released.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
