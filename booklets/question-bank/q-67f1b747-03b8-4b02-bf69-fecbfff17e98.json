        "answer": {
          "short": "$(x^2+5)(x^2-5)$",
          "worked": "$\\begin{align*}x^4-25&=(x^2)^2-5^2\\\\&=(x^2+5)(x^2-5)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "$4x^4-25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x^2+5)(2x^2-5)$",
          "worked": "$\\begin{align*}4x^4-25&=(2x^2)^2-5^2\\\\&=(2x^2+5)(2x^2-5)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^4-25y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+5y)(x^2-5y)$",
          "worked": "$\\begin{align*}x^4-25y^2&=(x^2)^2-(5y)^2\\\\&=(x^2+5y)(x^2-5y)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q21-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^4-25y^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x^2+5y^3)(2x^2-5y^3)$",
          "worked": "$\\begin{align*}4x^4-25y^6&=(2x^2)^2-(5y^3)^2\\\\&=(2x^2+5y^3)(2x^2-5y^3)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q21-e",
        "type": "part",
        "label": "e",
        "prompt": "$9x^6-4y^4$",
