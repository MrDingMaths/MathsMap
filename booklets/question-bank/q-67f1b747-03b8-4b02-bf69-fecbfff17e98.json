        "children": [],
        "answer": {
          "short": "$(3x^3+2y^2)(3x^3-2y^2)$",
          "worked": "$\\begin{align*}9x^6-4y^4&=(3x^3)^2-(2y^2)^2\\\\&=(3x^3+2y^2)(3x^3-2y^2)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
