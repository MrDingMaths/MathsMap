  "content": {
    "id": "p19-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A sector has a central angle of $0.7$ radians and an area of $20\\text{ cm}^2$. Find the following in exact form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "The radius of the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{20}{\\sqrt{7}}\\text{ cm}$",
          "worked": "$$\\begin{align*}A&=\\frac{1}{2}r^2\\theta\\\\20&=\\frac{1}{2}r^2\\times\\frac{7}{10}\\\\r^2&=\\frac{400}{7}\\\\r&=\\sqrt{\\frac{400}{7}}\\\\r&=\\frac{20}{\\sqrt{7}}\\text{ cm}\\end{align*}$$\nTake the positive square root because the radius is a length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "The perimeter of the sector.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{54}{\\sqrt{7}}\\text{ cm}$",
          "worked": "The perimeter is the arc length plus two radii.\n$$\\begin{align*}P&=r\\theta+2r\\\\P&=\\frac{20}{\\sqrt{7}}\\times\\frac{7}{10}+2\\times\\frac{20}{\\sqrt{7}}\\\\P&=\\frac{14}{\\sqrt{7}}+\\frac{40}{\\sqrt{7}}\\\\P&=\\frac{54}{\\sqrt{7}}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
