  "content": {
    "id": "p25-q7-response",
    "type": "question",
    "label": "7",
    "prompt": "Squeaky Clean Windows can clean all windows of a building in 5 days when it hires 8 people.\nThis year the client wants the job completed in 4 days.\nHow many cleaners are required?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "10 cleaners",
      "worked": "Let $N$ be the number of cleaners and $t$ the time in days.\n$$\\begin{align*}N&=\\frac{k}{t}\\\\8&=\\frac{k}{5}\\\\k&=40\\\\N&=\\frac{40}{t}\\\\N&=\\frac{40}{4}\\\\N&=10\\end{align*}$$\n10 cleaners are required.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
