          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Note that",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "math",
              "latex": "\\begin{aligned}\\operatorname{area}(\\triangle AOB)&\\leq\\operatorname{area}(\\operatorname{sector}(AOD))\\\\&\\leq\\operatorname{area}(\\triangle COD).\\end{aligned}",
              "display": true
            }
          ]
        }
      ]
    },
