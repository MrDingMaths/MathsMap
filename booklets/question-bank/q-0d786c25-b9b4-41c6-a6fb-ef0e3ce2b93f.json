  "content": {
    "id": "p25-q11-response",
    "type": "question",
    "label": "11",
    "prompt": "Prove that $\\log_{xy}(a)=\\dfrac{\\log_x(a)}{1+\\log_x(y)}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{\\log_x a}{1+\\log_x y}=\\dfrac{\\log_x a}{\\log_x(xy)}=\\log_{xy}a$.",
      "worked": "For $a>0$, $x>0$, $x\\ne1$, $y>0$ and $xy\\ne1$:\n$$\\begin{align*}\\mathrm{RHS}&=\\frac{\\log_x a}{\\log_x x+\\log_x y}\\\\\\mathrm{RHS}&=\\frac{\\log_x a}{\\log_x(xy)}\\\\\\mathrm{RHS}&=\\log_{xy}a\\\\\\mathrm{RHS}&=\\mathrm{LHS}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
