            },
            {
              "id": "p34-q14-b-invalid-calculation",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\displaystyle\\int_{-1}^{1}\\frac{1}{x^2}\\,dx=\\left[-\\frac{1}{x}\\right]_{-1}^{1}=-1-1=-2",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The function is undefined at $x=0$, inside the interval. Applying the Fundamental Theorem across this discontinuity is invalid.",
          "worked": "The denominator is zero at $x=0$, and $-1<0<1$. Thus $\\dfrac{1}{x^2}$ has a vertical asymptote inside the interval, so the Fundamental Theorem cannot be applied across the whole interval. The displayed calculation is invalid; the integral has no finite value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
