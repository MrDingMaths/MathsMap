        "type": "part",
        "label": "a",
        "prompt": "Explain why $y=\\dfrac{1}{x^2}$ is never negative.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $x\\ne0$, $x^2>0$, so $\\dfrac{1}{x^2}>0$.",
          "worked": "For every $x$ in the domain, $x\\ne0$ and $x^2>0$. Its reciprocal $\\dfrac{1}{x^2}$ is therefore positive, so it is never negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q14-b",
        "type": "part",
        "label": "b",
        "prompt": {
