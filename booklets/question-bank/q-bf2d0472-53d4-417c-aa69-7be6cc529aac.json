        "type": "part",
        "label": "b",
        "prompt": "Explain why the third angle $\\angle C$ is $110^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The angles of a triangle sum to $180^\\circ$, so $\\angle C=180^\\circ-40^\\circ-30^\\circ=110^\\circ$.",
          "worked": "The interior angles of a triangle sum to $180^\\circ$.\n$$\\begin{align*}\\angle C&=180^\\circ-40^\\circ-30^\\circ\\\\\\angle C&=110^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
