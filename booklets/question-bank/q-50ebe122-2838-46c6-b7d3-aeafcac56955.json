        "label": "a",
        "prompt": "Find $\\angle QPR$ to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle QPR=46^{\\circ}$.",
          "worked": "Let $\\theta=\\angle QPR$.\n$$\\begin{align*}\\cos\\theta&=\\frac{45}{65}\\\\\\theta&=\\cos^{-1}\\left(\\frac{45}{65}\\right)\\\\\\theta&\\approx46^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p39-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the bearing of $R$ from $P$ to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$101^{\\circ}\\mathrm{T}$.",
          "worked": "The diagram places $PR$ clockwise from $PQ$.\n$$\\begin{align*}\\text{Bearing of }R\\text{ from }P&=55^{\\circ}+\\cos^{-1}\\left(\\frac{45}{65}\\right)\\\\&\\approx101^{\\circ}\\mathrm{T}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
