  "content": {
    "id": "p18-practice-q1-root",
    "type": "question",
    "label": "",
    "prompt": "Find the value of $n$ for which the partial sum $S_n$ of $2+11+20+\\cdots$ is equal to 618.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=12$.",
      "worked": "$a=2$, $d=9$.\n$$\\begin{align*}S_n&=\\frac{n}{2}[2a+(n-1)d]\\\\618&=\\frac{n}{2}[2(2)+(n-1)9]\\\\1236&=n(9n-5)\\\\9n^2-5n-1236&=0\\\\(n-12)(9n+103)&=0\\\\n&=12\\text{ or }-\\frac{103}{9}\\end{align*}$$\nSince $n$ is a positive integer, $n=12$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
