        "id": "p63-q23-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"segmentFill\",\"hex\":\"D4E8FF\",\"reason\":\"Identifies the seven circular segments whose total area is requested\"}],\"reference\":\"source PDF page 63, p63-q23-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,draw=black,text=black,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{segmentFill}{HTML}{D4E8FF}\n\\coordinate (C) at (0,0);\n\\foreach \\i in {0,...,6} {\\coordinate (V\\i) at ({90-360*\\i/7}:2);}\n\\path[fill=segmentFill,even odd rule] (C) circle[radius=2] (V0)--(V1)--(V2)--(V3)--(V4)--(V5)--(V6)--cycle;\n\\draw (C) circle[radius=2];\n\\draw (V0)--(V1)--(V2)--(V3)--(V4)--(V5)--(V6)--cycle;\n\\draw[dashed,line width=0.4pt] (C)--node[midway,above,sloped] {$r$} (V1);\n\\fill[black] (C) circle[radius=1.2pt];\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 41.1,
        "alt": "Mathematical diagram",
        "overlayOf": null,
