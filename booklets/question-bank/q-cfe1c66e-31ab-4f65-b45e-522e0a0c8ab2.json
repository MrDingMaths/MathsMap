  "content": {
    "id": "v2-nr-p50-s1-slot-30-root",
    "type": "question",
    "label": null,
    "prompt": "A runner trains on the triangular loop $PQR$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "v2-nr-p50-s1-slot-30-slot-30-d1",
        "role": "question",
        "format": "tikz",
        "code": "\\usetikzlibrary{angles,quotes}\n\\begin{tikzpicture}[every node/.style={font=\\large}]\n\\coordinate (Q) at (0,0);\n\\coordinate (P) at (124:2.16);\n\\coordinate (R) at (56:2.79);\n\\draw[line width=0.8pt] (P)--(Q) node[midway,below left] {$2.4\\text{ km}$};\n\\draw[line width=0.8pt] (Q)--(R) node[midway,below right] {$3.1\\text{ km}$};\n\\draw[line width=0.8pt] (R)--(P);\n\\pic[draw,line width=0.5pt,\"$68^\\circ$\",angle radius=0.6cm,angle eccentricity=1.8] {angle=R--Q--P};\n\\node[above left] at (P) {$P$};\n\\node[below] at (Q) {$Q$};\n\\node[above right] at (R) {$R$};\n\\end{tikzpicture}",
