    "children": [
      {
        "id": "v2-nr-p50-s1-slot-30-slot-30-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of $PR$, correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.13\\text{ km}$",
          "worked": "$$\\begin{align*}PR^2&=2.4^2+3.1^2-2(2.4)(3.1)\\cos68^\\circ\\\\PR&=\\sqrt{2.4^2+3.1^2-2(2.4)(3.1)\\cos68^\\circ}\\\\PR&\\approx3.13\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-nr-p50-s1-slot-30-slot-30-b",
        "type": "part",
        "label": "b",
        "prompt": "She runs at an average speed of 11 km/h. How long does one lap of the loop take, to the nearest minute?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$47\\text{ minutes}$",
          "worked": "Using the unrounded $PR$:\n$$\\begin{align*}\\text{Distance}&=2.4+3.1+PR\\approx8.63\\text{ km}\\\\t&=\\frac{8.63}{11}\\times60\\text{ min}\\\\t&\\approx47\\text{ min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
