  "content": {
    "id": "p28-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q2a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the seventh row of Pascal’s triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\ 7,\\ 21,\\ 35,\\ 35,\\ 21,\\ 7,\\ 1$.",
          "worked": "The apex is row $n=0$. Add adjacent entries of row $n=6$, keeping $1$ at each end:\n$$n=6:\\quad 1,\\ 6,\\ 15,\\ 20,\\ 15,\\ 6,\\ 1.$$\n$$n=7:\\quad 1,\\ 7,\\ 21,\\ 35,\\ 35,\\ 21,\\ 7,\\ 1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q2b",
        "type": "part",
        "label": "b",
        "prompt": "Use your answer to write down the values of $\\binom{7}{3}$ and $\\binom{7}{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{7}{3}=35$ and $\\binom{7}{4}=35$.",
          "worked": "In row $n=7$, entries are indexed from $k=0$. The entries for $k=3$ and $k=4$ are both $35$:\n$$\\binom{7}{3}=35,\\qquad \\binom{7}{4}=35.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p28-q2c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, evaluate $\\binom{8}{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70$.",
          "worked": "By Pascal’s Identity,\n$$\\begin{align*}\\binom{8}{4}&=\\binom{7}{3}+\\binom{7}{4}\\\\\\binom{8}{4}&=35+35\\\\\\binom{8}{4}&=70.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
