  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The time taken for a plane flight is $6\\tfrac{1}{2}$ hours, to the nearest $\\tfrac{1}{2}$ hour.\n\nFind the lower and upper bounds of the true measurement.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Lower bound: $6.25$ hours. Upper bound: $6.75$ hours.",
      "worked": "Precision: $0.5$ hours. Absolute error: $\\tfrac12\\times0.5=0.25$ hours.\n$$\\begin{align*}\\text{Upper bound}&=6.5+0.25=6.75\\text{ hours}\\\\\\text{Lower bound}&=6.5-0.25=6.25\\text{ hours}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
