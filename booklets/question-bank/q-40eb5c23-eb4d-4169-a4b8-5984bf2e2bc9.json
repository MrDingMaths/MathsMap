          "inlines": [
            {
              "type": "text",
              "text": "Find the average rate of return, in dollars per year, of an investment of $5000 that increases in value by 6% per annum, compounded annually, for 4 years. Give your answer to 2 decimal places.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$328.10$ per year.",
      "worked": "$$\\begin{align*}V(4)&=5000(1.06)^4\\\\V(4)&=6312.3848,\\\\\\text{Average return}&=\\frac{6312.3848-5000}{4}\\\\\\text{Average return}&=328.0962.\\end{align*}$$\nThe average return is $\\$328.10$ per year, to 2 decimal places.",
      "solutionDiagrams": []
    },
