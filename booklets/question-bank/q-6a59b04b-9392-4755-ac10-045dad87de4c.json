  "content": {
    "id": "p43-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The probability of a new car passing a quality-control check is $93\\%$. If a quality-control check is made on $250$ cars, then for the number of cars that pass, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "the mean",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$232.5$ cars",
          "worked": "$X\\sim\\operatorname{Bin}(250,0.93)$.\n$$\\begin{aligned}E(X)&=np\\\\E(X)&=250(0.93)\\\\E(X)&=232.5\\end{aligned}$$\nThe mean is $232.5$ cars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p43-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "the variance",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16.275$",
          "worked": "$$\\begin{aligned}\\operatorname{Var}(X)&=np(1-p)\\\\\\operatorname{Var}(X)&=250(0.93)(0.07)\\\\\\operatorname{Var}(X)&=16.275\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p43-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "the standard deviation, correct to $3$ decimal places",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.034$ cars",
          "worked": "$$\\begin{aligned}\\sigma(X)&=\\sqrt{np(1-p)}\\\\\\sigma(X)&=\\sqrt{250(0.93)(0.07)}\\\\\\sigma(X)&=\\sqrt{16.275}\\\\\\sigma(X)&\\approx4.034\\end{aligned}$$\nThe standard deviation is $4.034$ cars, correct to $3$ decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
