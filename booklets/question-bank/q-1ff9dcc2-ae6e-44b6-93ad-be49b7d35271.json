  "content": {
    "id": "p37-cc-13-root",
    "type": "question",
    "label": "3",
    "prompt": "If $3\\sin x-4\\cos x=R\\cos(x+\\alpha)$ where $R>0$, which quadrant is $\\alpha$ in?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Third quadrant.",
      "worked": "$$R\\cos(x+\\alpha)=R\\cos\\alpha\\cos x-R\\sin\\alpha\\sin x.$$\nEquating coefficients gives $R\\cos\\alpha=-4$ and $-R\\sin\\alpha=3$. Since $R>0$, $\\cos\\alpha<0$ and $\\sin\\alpha<0$. Therefore $\\alpha$ is in the third quadrant.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
