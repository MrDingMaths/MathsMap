    "id": "p8-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Expand and simplify, answering without using negative indices:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+x^{-1})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2+\\dfrac{1}{x^2}$",
          "worked": "$$\\begin{align*}(x+x^{-1})^2&=x^2+2x\\cdot x^{-1}+(x^{-1})^2\\\\(x+x^{-1})^2&=x^2+2x^0+x^{-2}\\\\(x+x^{-1})^2&=x^2+2+\\frac{1}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p8-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-x^{-1})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-2+\\dfrac{1}{x^2}$",
          "worked": "$$\\begin{align*}(x-x^{-1})^2&=x^2-2x\\cdot x^{-1}+(x^{-1})^2\\\\(x-x^{-1})^2&=x^2-2x^0+x^{-2}\\\\(x-x^{-1})^2&=x^2-2+\\frac{1}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p8-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x^2-x^{-2})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-2+\\dfrac{1}{x^4}$",
          "worked": "$$\\begin{align*}(x^2-x^{-2})^2&=(x^2)^2-2x^2\\cdot x^{-2}+(x^{-2})^2\\\\(x^2-x^{-2})^2&=x^4-2x^0+x^{-4}\\\\(x^2-x^{-2})^2&=x^4-2+\\frac{1}{x^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
