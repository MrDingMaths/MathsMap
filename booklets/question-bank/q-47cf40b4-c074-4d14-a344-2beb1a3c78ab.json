        "answer": {
          "short": "$1$, since $\\tan60^\\circ=\\dfrac1{\\tan30^\\circ}$.",
          "worked": "$\\begin{align*}\\tan30^\\circ\\tan60^\\circ&=\\tan30^\\circ\\times\\frac1{\\tan30^\\circ}\\\\&=1\\end{align*}$",
          "solutionDiagrams": []
