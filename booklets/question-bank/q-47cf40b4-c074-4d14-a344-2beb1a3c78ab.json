        "answer": {
          "short": "$2\\tan20^\\circ$, since $\\dfrac1{\\tan70^\\circ}=\\tan20^\\circ$.",
          "worked": "$\\begin{align*}\\tan20^\\circ+\\frac1{\\tan70^\\circ}&=\\tan20^\\circ+\\tan20^\\circ\\\\&=2\\tan20^\\circ\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
