  "content": {
    "id": "p39-q25-28-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q25-28-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{(n+2)!}{n!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n+2)(n+1)$",
          "worked": "$$\\begin{align*}\\frac{(n+2)!}{n!}&=\\frac{(n+2)(n+1)n!}{n!}\\\\\\frac{(n+2)!}{n!}&=(n+2)(n+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p39-q25-28-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{(n+1)!}{(n-1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n(n+1)$",
          "worked": "$$\\begin{align*}\\frac{(n+1)!}{(n-1)!}&=\\frac{(n+1)n(n-1)!}{(n-1)!}\\\\\\frac{(n+1)!}{(n-1)!}&=n(n+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p39-q25-28-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{(n-1)!+n!}{(n+1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{n}$",
          "worked": "$$\\begin{align*}\\frac{(n-1)!+n!}{(n+1)!}&=\\frac{(n-1)!(1+n)}{(n+1)n(n-1)!}\\\\\\frac{(n-1)!+n!}{(n+1)!}&=\\frac{n+1}{n(n+1)}\\\\\\frac{(n-1)!+n!}{(n+1)!}&=\\frac{1}{n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q25-28-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{n!+(n+2)!}{n!+(n+1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q25-28-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{n^2+3n+3}{n+2}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p39-q25-28-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Factor out n! from both sums, then cancel.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{n!+(n+2)!}{n!+(n+1)!}&=\\frac{n![1+(n+2)(n+1)]}{n![1+(n+1)]}\\\\\\frac{n!+(n+2)!}{n!+(n+1)!}&=\\frac{1+n^2+3n+2}{n+2}\\\\\\frac{n!+(n+2)!}{n!+(n+1)!}&=\\frac{n^2+3n+3}{n+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
