  "content": {
    "id": "p11-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Expand each of the following by inserting extra brackets where necessary:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+y)^2-(x-y)(x+y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2xy+2y^2$",
          "worked": "$$\\begin{align*}(x+y)^2-(x-y)(x+y)&=x^2+2xy+y^2-(x^2-y^2)\\\\(x+y)^2-(x-y)(x+y)&=x^2+2xy+y^2-x^2+y^2\\\\(x+y)^2-(x-y)(x+y)&=2xy+2y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$4x-(x+4)(x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x^2+4x+16$",
          "worked": "$$\\begin{align*}4x-(x+4)(x-4)&=4x-(x^2-16)\\\\4x-(x+4)(x-4)&=-x^2+4x+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(a+2)(a-2)-(a-3)(a+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}(a+2)(a-2)-(a-3)(a+3)&=(a^2-4)-(a^2-9)\\\\(a+2)(a-2)-(a-3)(a+3)&=a^2-4-a^2+9\\\\(a+2)(a-2)-(a-3)(a+3)&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(m+3)(m-3)-(m+4)(m-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}(m+3)(m-3)-(m+4)(m-4)&=(m^2-9)-(m^2-16)\\\\(m+3)(m-3)-(m+4)(m-4)&=m^2-9-m^2+16\\\\(m+3)(m-3)-(m+4)(m-4)&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
