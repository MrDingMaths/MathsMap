    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{\\sqrt2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt2+1$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt2-1}&=\\frac1{\\sqrt2-1}\\times\\frac{\\sqrt2+1}{\\sqrt2+1}\\\\\\frac1{\\sqrt2-1}&=\\frac{\\sqrt2+1}{2-1}\\\\\\frac1{\\sqrt2-1}&=\\sqrt2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{\\sqrt3+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-\\sqrt3$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt3+2}&=\\frac1{\\sqrt3+2}\\times\\frac{\\sqrt3-2}{\\sqrt3-2}\\\\\\frac1{\\sqrt3+2}&=\\frac{\\sqrt3-2}{3-4}\\\\\\frac1{\\sqrt3+2}&=2-\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{\\sqrt3+\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3-\\sqrt2$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt3+\\sqrt2}&=\\frac1{\\sqrt3+\\sqrt2}\\times\\frac{\\sqrt3-\\sqrt2}{\\sqrt3-\\sqrt2}\\\\\\frac1{\\sqrt3+\\sqrt2}&=\\frac{\\sqrt3-\\sqrt2}{3-2}\\\\\\frac1{\\sqrt3+\\sqrt2}&=\\sqrt3-\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{\\sqrt3-\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3+\\sqrt2$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt3-\\sqrt2}&=\\frac1{\\sqrt3-\\sqrt2}\\times\\frac{\\sqrt3+\\sqrt2}{\\sqrt3+\\sqrt2}\\\\\\frac1{\\sqrt3-\\sqrt2}&=\\frac{\\sqrt3+\\sqrt2}{3-2}\\\\\\frac1{\\sqrt3-\\sqrt2}&=\\sqrt3+\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
