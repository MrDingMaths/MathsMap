    "children": [
      {
        "id": "p17-q12-a-node",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression for $AF$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{h}{\\tan10^\\circ}$",
          "worked": "$\\begin{aligned}\\tan10^\\circ&=\\frac{h}{AF}\\\\AF&=\\frac{h}{\\tan10^\\circ}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q12-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Find an expression for $BF$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{h}{\\tan12^\\circ}$",
          "worked": "$\\begin{aligned}\\tan12^\\circ&=\\frac{h}{BF}\\\\BF&=\\frac{h}{\\tan12^\\circ}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q12-c-node",
        "type": "part",
        "label": "c",
        "prompt": "Use Pythagoras’ theorem to form an equation using $h$, then solve for $h$ to 3 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\dfrac{h}{\\tan10^\\circ}\\right)^2+\\left(\\dfrac{h}{\\tan12^\\circ}\\right)^2=9$; $h\\approx0.407\\text{ km}$.",
          "worked": "Take $h$ in kilometres. In the right-angled ground triangle $AFB$:\n\n$\\begin{aligned}AF^2+BF^2&=AB^2\\\\\\left(\\frac{h}{\\tan10^\\circ}\\right)^2+\\left(\\frac{h}{\\tan12^\\circ}\\right)^2&=3^2\\\\h^2\\left(\\frac{1}{\\tan^210^\\circ}+\\frac{1}{\\tan^212^\\circ}\\right)&=9\\\\h&=\\frac{3}{\\sqrt{\\frac{1}{\\tan^210^\\circ}+\\frac{1}{\\tan^212^\\circ}}}\\\\&\\approx0.407\\text{ km}\\end{aligned}$\n\nThe positive root is used because $h$ is a height.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p17-q12-d-node",
        "type": "part",
        "label": "d",
        "prompt": "In what direction was the motorist driving? Give the bearing to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Bearing $040^\\circ$.",
          "worked": "Let $\\theta=\\angle FAB$, measured east of north. Use the unrounded value of $h$ from part c.\n\n$\\begin{aligned}\\sin\\theta&=\\frac{FB}{AB}\\\\&=\\frac{h}{3\\tan12^\\circ}\\\\\\theta&=\\sin^{-1}\\left(\\frac{h}{3\\tan12^\\circ}\\right)\\\\&\\approx40^\\circ\\end{aligned}$\n\nShe was travelling on a bearing of $040^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
