        {
          "id": "p17-q12-explanation",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "In this question, no more than two measurements are known in any one of the triangles. Therefore, we must introduce a pronumeral for the height, and work around until we have enough expressions in terms of ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "h",
              "display": false
            },
            {
              "type": "text",
              "text": " such that an equation can be formed and solved.",
