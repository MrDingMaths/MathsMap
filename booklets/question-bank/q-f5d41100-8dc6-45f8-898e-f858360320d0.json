        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 17 question 12 spatial\"}\n\\begin{tikzpicture}[line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\\coordinate (F) at (2,1.5);\\coordinate (B) at (4.4,1.05);\\coordinate (T) at (2,3.5);\n\\coordinate (N) at ($(F)!1.65!(F)-(A)!0.65!(F)$);\n\\coordinate (Nend) at ($(F)+0.65*(F)-0.65*(A)$);\n\\coordinate (Eend) at ($(F)!1.2!(B)$);\n\\draw (A)--(T)--(B)--cycle;\n\\draw[dashed,line width=0.4pt] (A)--(F)--(B) (F)--(T);\n\\draw[dashed,->,line width=0.5pt] (F)--(Nend) node[right] {N};\n\\draw[dashed,->,line width=0.5pt] (B)--(Eend) node[right] {E};\n\\draw[line width=0.4pt] ($(F)!0.12!(A)$)--($(F)!0.12!(A)+(F)!0.12!(B)-(F)$)--($(F)!0.12!(B)$);\n\\pic[draw,line width=0.4pt,angle radius=8mm,\"$10^\\circ$\",angle eccentricity=1.65] {angle=F--A--T};\n\\pic[draw,line width=0.4pt,angle radius=7mm,\"$12^\\circ$\",angle eccentricity=1.65] {angle=T--B--F};\n\\path (A)--(B) node[midway,below] {$3\\text{ km}$};\\path (F)--(T) node[midway,right] {$h$};\n\\node[below left] at (A) {$A$};\\node[below] at (B) {$B$};\\node[left] at (F) {$F$};\\node[above] at (T) {$T$};\n\\end{tikzpicture}",
