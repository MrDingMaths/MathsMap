  "content": {
    "id": "p30-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The number 36 can be written as the sum of three cubes: $1^3 + 2^3 + 3^3 = 36$. Find the three cubes that sum to:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$73$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$73 = 1^3 + 2^3 + 4^3$",
          "worked": "The cube numbers up to 73 are $1,8,27,64$. Since $73-64=9=1+8$,\n$$\\begin{align*}1^3+2^3+4^3 &= 1+8+64\\\\1^3+2^3+4^3 &= 73\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$92$",
