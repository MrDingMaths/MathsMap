  "content": {
    "id": "p38-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A parabola has the equation $y=x^2-2x-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave up.",
          "worked": "$a=1>0$, so the parabola is concave up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p38-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-1)$",
          "worked": "Let $x=0$.\n$$\\begin{align*}y&=0^2-2(0)-1\\\\y&=-1\\end{align*}$$\nThe $y$-intercept is $(0,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p38-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-\\sqrt2,0)$ and $(1+\\sqrt2,0)$.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=x^2-2x-1\\\\x&=\\frac{-(-2)\\pm\\sqrt{(-2)^2-4(1)(-1)}}{2(1)}\\\\x&=\\frac{2\\pm\\sqrt8}{2}\\\\x&=\\frac{2\\pm2\\sqrt2}{2}\\\\x&=1\\pm\\sqrt2\\end{align*}$$\nThe $x$-intercepts are $(1-\\sqrt2,0)$ and $(1+\\sqrt2,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p38-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-2)$",
          "worked": "$$\\begin{align*}x&=-\\frac{b}{2a}\\\\x&=-\\frac{-2}{2(1)}\\\\x&=1\\\\y&=1^2-2(1)-1\\\\y&=-2\\end{align*}$$\nThe vertex is $(1,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ],
    "sharedSolutionDiagrams": [
      {
