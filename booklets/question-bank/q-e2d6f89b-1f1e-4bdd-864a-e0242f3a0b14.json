  "content": {
    "id": "intro-functions-parameter-r6-2-root",
    "type": "question",
    "label": null,
    "prompt": "$f(x)=px^3-x$.\n\nFind $p$ if $f(2)=5f(1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=-1$.",
      "worked": "$$\\begin{align*}f(2)&=p(2)^3-2\\\\&=8p-2\\\\f(1)&=p(1)^3-1\\\\&=p-1\\\\8p-2&=5(p-1)\\\\8p-2&=5p-5\\\\3p&=-3\\\\p&=-1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
