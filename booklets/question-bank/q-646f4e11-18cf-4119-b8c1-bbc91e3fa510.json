  "content": {
    "id": "p10-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "In an arithmetic sequence, the sum of the first four terms is 42. The sum of the next four terms is 116. Find the sum of the first twelve terms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$348$",
      "worked": "Each term in the next group of four increases by $4d$, so consecutive group sums increase by $16d$.\n\n$$\\begin{align*}16d&=116-42=74\\\\a_9+a_{10}+a_{11}+a_{12}&=116+74=190\\\\S_{12}&=42+116+190=348\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
