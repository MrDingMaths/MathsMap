    "type": "question",
    "label": "14",
    "prompt": "Show that $\\dfrac{d}{dx}\\left(\\dfrac{\\sin^5 x}{5}-\\dfrac{\\sin^7 x}{7}\\right)=\\sin^4 x\\cos^3 x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{d}{dx}\\left(\\dfrac{\\sin^5 x}{5}-\\dfrac{\\sin^7 x}{7}\\right)=\\sin^4 x\\cos x(1-\\sin^2 x)=\\sin^4 x\\cos^3 x$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p10-q14-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\frac{d}{dx}\\left(\\frac{\\sin^5 x}{5}-\\frac{\\sin^7 x}{7}\\right)&=\\left(\\frac15\\right)(5\\sin^4 x\\cos x)-\\left(\\frac17\\right)(7\\sin^6 x\\cos x)\\\\&=\\sin^4 x\\cos x-\\sin^6 x\\cos x\\\\&=\\sin^4 x\\cos x(1-\\sin^2 x)\\\\&=\\sin^4 x\\cos x\\cos^2 x\\\\&=\\sin^4 x\\cos^3 x\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
