  "content": {
    "id": "p12-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "For each problem, write an equation and solve it to find the unknown number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q1a",
        "type": "part",
        "label": "a",
        "prompt": "Six is added to a number, $x$, and the result is multiplied by $-3$. The result of this is $-72$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3(x+6)=-72$, $x=18$.",
          "worked": "$$\\begin{align*}-3(x+6)&=-72\\\\x+6&=24\\\\x&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q1b",
        "type": "part",
        "label": "b",
        "prompt": "One-third of a number, $x$, and one-quarter of the same number are added, and the result is $25$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{3}+\\frac{x}{4}=25$, $x=42\\frac{6}{7}$.",
          "worked": "Multiply both sides by $12$.\n\n$$\\begin{align*}\\frac{x}{3}+\\frac{x}{4}&=25\\\\4x+3x&=300\\\\7x&=300\\\\x&=\\frac{300}{7}\\\\x&=42\\frac{6}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q1c",
        "type": "part",
        "label": "c",
        "prompt": "Three-fifths of a number, $z$, and one-seventh of the same number are added and the result is $30$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3z}{5}+\\frac{z}{7}=30$, $z=40\\frac{5}{13}$.",
          "worked": "Multiply both sides by $35$.\n\n$$\\begin{align*}\\frac{3z}{5}+\\frac{z}{7}&=30\\\\21z+5z&=1050\\\\26z&=1050\\\\z&=\\frac{525}{13}\\\\z&=40\\frac{5}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q1d",
        "type": "part",
        "label": "d",
        "prompt": "Two-thirds of a number, $m$, is subtracted from three-fifths of the same number, and the result is $1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3m}{5}-\\frac{2m}{3}=1$, $m=-15$.",
          "worked": "Multiply both sides by $15$.\n\n$$\\begin{align*}\\frac{3m}{5}-\\frac{2m}{3}&=1\\\\9m-10m&=15\\\\-m&=15\\\\m&=-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q1e",
        "type": "part",
        "label": "e",
        "prompt": "The result of multiplying a number, $a$, by $-2$ and adding $6$ is the same as the result of multiplying $a$ by $3$ and subtracting $4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2a+6=3a-4$, $a=2$.",
          "worked": "$$\\begin{align*}-2a+6&=3a-4\\\\6&=5a-4\\\\10&=5a\\\\a&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
