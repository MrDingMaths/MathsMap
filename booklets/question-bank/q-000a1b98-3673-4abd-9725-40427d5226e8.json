  "content": {
    "id": "p5-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the shortest distance from the point $(-1,2)$ to a circle of radius $2$ centred at $(2,-1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\sqrt{2}-2$ units.",
      "worked": "The shortest segment lies along the line joining the point to the centre.\n$$\\begin{align*}d&=\\sqrt{(-1-2)^2+(2-(-1))^2}\\\\d&=\\sqrt{18}\\\\d&=3\\sqrt{2}.\\end{align*}$$\nThe point is outside the circle, so the shortest distance is\n$$3\\sqrt{2}-2\\text{ units}.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
