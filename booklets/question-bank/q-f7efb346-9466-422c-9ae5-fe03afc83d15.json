              }
            ]
          },
          "worked": "$$\\begin{align*}\\cos^2\\theta-(1-\\cos^2\\theta)+3\\cos\\theta+2&=0\\\\2\\cos^2\\theta+3\\cos\\theta+1&=0\\\\(2\\cos\\theta+1)(\\cos\\theta+1)&=0\\\\\\cos\\theta&=-\\frac12\\quad\\text{or}\\quad-1\\\\\\theta&=120^\\circ,\\ 180^\\circ,\\ 240^\\circ\\end{align*}$$",
