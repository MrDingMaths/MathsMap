  "content": {
    "id": "p34-q3",
    "type": "question",
    "label": "3",
    "prompt": "Two dice are rolled. Find the probability of rolling:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "a double six if the first die was a six.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "The first die is already a six, so the second die must show six. The results on the two dice are independent.\n$$\\begin{align*}P(\\text{double six}\\mid\\text{first die is six}) &= P(\\text{second die is six})\\\\&=\\frac{1}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "a total of 8 or more if the first die was a 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "With three on the first die, the second die must show five or six. Its six possible outcomes remain equally likely.\n$$\\begin{align*}P(\\text{total}\\geq8\\mid\\text{first die is three}) &=\\frac{2}{6}\\\\&=\\frac{1}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
