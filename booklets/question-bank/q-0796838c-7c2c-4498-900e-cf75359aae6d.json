    "children": [
      {
        "id": "p28-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $y$ as a function of $x$ if $y'=e^{x-1}$, and $y=1$ when $x=1$. What is the $y$-intercept of this curve?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{x-1}$; $y$-intercept $e^{-1}$.",
          "worked": "$$\\begin{align*}y&=\\int e^{x-1}\\,dx\\\\y&=e^{x-1}+C\\end{align*}$$\nUsing $y(1)=1$:\n$$\\begin{align*}e^0+C&=1\\\\C&=0\\\\y&=e^{x-1}\\\\y(0)&=e^{-1}\\end{align*}$$\nThe $y$-intercept is $e^{-1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p28-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "The gradient of a curve is given by $y'=e^{2-x}$, and the curve passes through the point $(0,1)$. What is the equation of this curve? What is its horizontal asymptote?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^2+1-e^{2-x}$; horizontal asymptote $y=e^2+1$.",
          "worked": "$$\\begin{align*}y&=\\int e^{2-x}\\,dx\\\\y&=-e^{2-x}+C\\end{align*}$$\nUsing $y(0)=1$:\n$$\\begin{align*}-e^2+C&=1\\\\C&=e^2+1\\\\y&=e^2+1-e^{2-x}\\end{align*}$$\nAs $x\\to\\infty$, $e^{2-x}\\to0$, so the horizontal asymptote is $y=e^2+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p28-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "It is known that $f'(x)=e^x+\\frac{1}{e}$ and that $f(-1)=-1$. Find $f(0)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(0)=0$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p28-q13-c-completion-worked-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}f(x)&=\\int\\left(e^x+\\frac{1}{e}\\right)\\,dx\\\\f(x)&=e^x+\\frac{x}{e}+C\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p28-q13-c-completion-worked-1",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Using ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "f(-1)=-1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ":",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p28-q13-c-completion-worked-2",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}e^{-1}-\\frac{1}{e}+C&=-1\\\\C&=-1\\\\f(x)&=e^x+\\frac{x}{e}-1\\\\f(0)&=1+0-1\\\\f(0)&=0\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p28-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "Given that $f''(x)=e^x-e^{-x}$ and that $y=f(x)$ is horizontal as it passes through the origin, find $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=e^x-e^{-x}-2x$.",
          "worked": "$$\\begin{align*}f''(x)&=e^x-e^{-x}\\\\f'(x)&=e^x+e^{-x}+C_1\\end{align*}$$\nHorizontal at the origin means $f'(0)=0$:\n$$\\begin{align*}1+1+C_1&=0\\\\C_1&=-2\\\\f'(x)&=e^x+e^{-x}-2\\\\f(x)&=e^x-e^{-x}-2x+C_2\\end{align*}$$\nPassing through the origin means $f(0)=0$:\n$$\\begin{align*}1-1-0+C_2&=0\\\\C_2&=0\\\\f(x)&=e^x-e^{-x}-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
