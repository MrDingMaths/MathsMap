  "content": {
    "id": "p54-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "It is known that $y$ varies directly with $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=kx$",
          "worked": "Direct variation has the form $y=kx$, where $k$ is the constant of proportionality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p54-q1-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the value of $k$ given that:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q1-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$y=10$ when $x=2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=5$",
              "worked": "$$\\begin{align*}10&=k\\times2\\\\k&=\\frac{10}{2}\\\\k&=5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p54-q1-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$y=-6$ when $x=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=-2$",
              "worked": "$$\\begin{align*}-6&=k\\times3\\\\k&=\\frac{-6}{3}\\\\k&=-2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p54-q1-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$y=6$ when $x=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=\\frac{3}{2}$",
              "worked": "$$\\begin{align*}6&=k\\times4\\\\k&=\\frac{6}{4}\\\\k&=\\frac{3}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
  },
