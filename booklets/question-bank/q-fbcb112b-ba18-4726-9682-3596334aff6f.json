    "children": [
      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log(ab)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+y$",
          "worked": "$$\\begin{align*}\\log(ab)&=\\log a+\\log b\\\\\\log(ab)&=x+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log\\left(\\frac{c}{b}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z-y$",
          "worked": "$$\\begin{align*}\\log(c/b)&=\\log c-\\log b\\\\\\log(c/b)&=z-y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log\\left(\\sqrt{ab}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(x+y)$",
          "worked": "$$\\begin{align*}\\log(\\sqrt{ab})&=\\tfrac12\\log(ab)\\\\\\log(\\sqrt{ab})&=\\tfrac12(\\log a+\\log b)\\\\\\log(\\sqrt{ab})&=\\tfrac12(x+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log\\left(\\frac{1}{abc}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+y+z)$",
          "worked": "$$\\begin{align*}\\log(1/(abc))&=-\\log(abc)\\\\\\log(1/(abc))&=-(\\log a+\\log b+\\log c)\\\\\\log(1/(abc))&=-(x+y+z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log(ab^2c^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y+3z$",
          "worked": "$$\\begin{align*}\\log(ab^2c^3)&=\\log a+\\log(b^2)+\\log(c^3)\\\\\\log(ab^2c^3)&=\\log a+2\\log b+3\\log c\\\\\\log(ab^2c^3)&=x+2y+3z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p6-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log\\left(\\frac{1}{\\sqrt{b^2c}}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12(2y+z)$",
          "worked": "Let $L=\\log\\left(\\frac{1}{\\sqrt{b^2c}}\\right)$.\n\n$$\\begin{align*}L&=-\\log(\\sqrt{b^2c})\\\\L&=-\\tfrac12\\log(b^2c)\\\\L&=-\\tfrac12(2\\log b+\\log c)\\\\L&=-\\tfrac12(2y+z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log\\left(\\frac{\\sqrt{ac}}{b}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(x+z)-y$",
          "worked": "Let $L=\\log\\left(\\frac{\\sqrt{ac}}{b}\\right)$.\n\n$$\\begin{align*}L&=\\log(\\sqrt{ac})-\\log b\\\\L&=\\tfrac12(\\log a+\\log c)-\\log b\\\\L&=\\tfrac12(x+z)-y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log(a^3\\sqrt{bc})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+\\frac12(y+z)$",
          "worked": "$$\\begin{align*}\\log(a^3\\sqrt{bc})&=\\log(a^3)+\\log(\\sqrt{bc})\\\\\\log(a^3\\sqrt{bc})&=3\\log a+\\tfrac12(\\log b+\\log c)\\\\\\log(a^3\\sqrt{bc})&=3x+\\tfrac12(y+z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\log\\left(\\frac{c^2}{a^2b^3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2z-(2x+3y)$",
          "worked": "Let $L=\\log\\left(\\frac{c^2}{a^2b^3}\\right)$.\n\n$$\\begin{align*}L&=\\log(c^2)-\\log(a^2b^3)\\\\L&=2\\log c-(2\\log a+3\\log b)\\\\L&=2z-(2x+3y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
