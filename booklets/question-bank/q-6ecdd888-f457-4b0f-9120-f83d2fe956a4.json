  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A piece of string is $x$ m in length. It is divided into five equal parts.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of each part in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{5}\\text{ m}$",
          "worked": "Each part has length $\\frac{\\text{total length}}{5}=\\frac{x}{5}\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
