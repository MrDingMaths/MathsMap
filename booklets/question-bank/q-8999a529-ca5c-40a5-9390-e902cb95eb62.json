  "content": {
    "id": "v2-ceb80-p39-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "The time a tram takes to travel between two stops is normally distributed with mean 6.4 minutes and standard deviation 0.8 minutes. Find the probability that a trip takes more than 5.6 minutes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.84$",
      "worked": "$$\\begin{aligned}z&=\\frac{5.6-6.4}{0.8}\\\\&=-1\\end{aligned}$$\nUsing symmetry and the empirical rule,\n$$\\begin{aligned}P(X>5.6)&=P(z>-1)\\\\&\\approx0.5+\\frac{0.68}{2}\\\\&=0.84.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
