  "content": {
    "id": "p41-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "$p=8$ and $q=-12$. Work out",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$p+q$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}p+q&=8+(-12)\\\\p+q&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p41-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$q-p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-20$",
          "worked": "$$\\begin{align*}q-p&=(-12)-8\\\\q-p&=-20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p41-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$pq$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-96$",
          "worked": "$$\\begin{align*}pq&=8(-12)\\\\pq&=-96\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p41-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$p-2q$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32$",
          "worked": "$$\\begin{align*}p-2q&=8-2(-12)\\\\p-2q&=8-(-24)\\\\p-2q&=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p41-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{2q}{p}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}\\frac{2q}{p}&=\\frac{2(-12)}{8}\\\\\\frac{2q}{p}&=\\frac{-24}{8}\\\\\\frac{2q}{p}&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p41-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{pq}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-48$",
          "worked": "$$\\begin{align*}\\frac{pq}{2}&=\\frac{8(-12)}{2}\\\\\\frac{pq}{2}&=\\frac{-96}{2}\\\\\\frac{pq}{2}&=-48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p41-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$p-\\frac{q}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{align*}p-\\frac{q}{2}&=8-\\frac{-12}{2}\\\\p-\\frac{q}{2}&=8-(-6)\\\\p-\\frac{q}{2}&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p41-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{p-q}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\frac{p-q}{2}&=\\frac{8-(-12)}{2}\\\\\\frac{p-q}{2}&=\\frac{20}{2}\\\\\\frac{p-q}{2}&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p41-q10-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{q-p}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}\\frac{q-p}{4}&=\\frac{(-12)-8}{4}\\\\\\frac{q-p}{4}&=\\frac{-20}{4}\\\\\\frac{q-p}{4}&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
