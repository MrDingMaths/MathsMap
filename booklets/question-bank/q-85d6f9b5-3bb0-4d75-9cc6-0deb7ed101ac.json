  "content": {
    "id": "p12-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A meat pie in the microwave rises in temperature by about $9^\\circ\\mathrm{C}$ for each minute of heating. If you take a frozen meat pie out of the freezer, where it has been stored at $-14^\\circ\\mathrm{C}$, how long does it have to be in the microwave before it reaches $40^\\circ\\mathrm{C}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "6 minutes.",
      "worked": "The required temperature rise is\n$$\\begin{align*}40-(-14)&=40+14\\\\40-(-14)&=54^\\circ\\mathrm{C}.\\end{align*}$$\nAt about $9^\\circ\\mathrm{C}$ per minute, the heating time is\n$$54\\div9=6\\text{ minutes}.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
