  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the approximate value of the perimeter of each figure, using $\\pi\\approx3.14$. Give your answers to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "A semicircle with diameter $9\\text{ cm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23.13\\text{ cm}$",
          "worked": "Include the diameter as well as the semicircular arc.\n$$\\begin{align*}P&=\\frac{\\pi d}{2}+d\\\\P&\\approx\\frac{3.14\\times9}{2}+9\\\\P&\\approx23.13\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "A quadrant with radius $2\\text{ cm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.14\\text{ cm}$",
          "worked": "Include both radii and one quarter of the circumference.\n$$\\begin{align*}P&=\\frac{2\\pi r}{4}+2r\\\\P&\\approx\\frac{2\\times3.14\\times2}{4}+2\\times2\\\\P&\\approx7.14\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "A quadrant with radius $5\\text{ cm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17.85\\text{ cm}$",
          "worked": "Include both radii and one quarter of the circumference.\n$$\\begin{align*}P&=\\frac{2\\pi r}{4}+2r\\\\P&\\approx\\frac{2\\times3.14\\times5}{4}+2\\times5\\\\P&\\approx17.85\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "A semicircle with radius $8\\text{ mm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$41.12\\text{ mm}$",
          "worked": "The straight boundary is the diameter, $2r$.\n$$\\begin{align*}P&=\\pi r+2r\\\\P&\\approx3.14\\times8+2\\times8\\\\P&\\approx41.12\\text{ mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "A sector with radius $14\\text{ cm}$ containing an angle of $120^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$57.31\\text{ cm}$\n\nAdd the two radii to one third of the circumference.",
          "worked": "The arc is $\\frac{120}{360}=\\frac13$ of the circumference. Include both radii.\n$$\\begin{align*}P&=\\frac{120}{360}\\times2\\pi r+2r\\\\P&\\approx\\frac13\\times2\\times3.14\\times14+28\\\\P&\\approx\\frac{4298}{75}\\text{ cm}\\\\P&\\approx57.31\\text{ cm}\\quad\\text{(2 decimal places)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
