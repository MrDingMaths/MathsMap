  "content": {
    "id": "p19-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Evaluate the following, and write each result using scientific notation:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$(6\\times10^6)\\div(2\\times10^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times10^4$",
          "worked": "$$\\begin{align*}(6\\times10^6)\\div(2\\times10^2)&=\\frac{6}{2}\\times10^{6-2}\\\\(6\\times10^6)\\div(2\\times10^2)&=3\\times10^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$(3.3\\times10^{12})\\div(3\\times10^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.1\\times10^9$",
          "worked": "$$\\begin{align*}(3.3\\times10^{12})\\div(3\\times10^3)&=\\frac{3.3}{3}\\times10^{12-3}\\\\(3.3\\times10^{12})\\div(3\\times10^3)&=1.1\\times10^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$(8.4\\times10^5)\\div(2.1\\times10^{-7})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\times10^{12}$",
          "worked": "$$\\begin{align*}(8.4\\times10^5)\\div(2.1\\times10^{-7})&=\\frac{8.4}{2.1}\\times10^{5-(-7)}\\\\(8.4\\times10^5)\\div(2.1\\times10^{-7})&=4\\times10^{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2.6\\times10^{-8})\\div(1.3\\times10^{-13})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times10^5$",
          "worked": "$$\\begin{align*}(2.6\\times10^{-8})\\div(1.3\\times10^{-13})&=\\frac{2.6}{1.3}\\times10^{-8-(-13)}\\\\(2.6\\times10^{-8})\\div(1.3\\times10^{-13})&=2\\times10^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$(1.2\\times10^{-14})\\div(3\\times10^{-4})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\times10^{-11}$",
          "worked": "$$\\begin{align*}(1.2\\times10^{-14})\\div(3\\times10^{-4})&=\\frac{1.2}{3}\\times10^{-14-(-4)}\\\\(1.2\\times10^{-14})\\div(3\\times10^{-4})&=0.4\\times10^{-10}\\\\(1.2\\times10^{-14})\\div(3\\times10^{-4})&=4\\times10^{-11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p19-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$(5.5\\times10^{11})\\div(1.1\\times10^{11})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\times10^0$",
          "worked": "$$\\begin{align*}(5.5\\times10^{11})\\div(1.1\\times10^{11})&=\\frac{5.5}{1.1}\\times10^{11-11}\\\\(5.5\\times10^{11})\\div(1.1\\times10^{11})&=5\\times10^0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$0.000063\\div300\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.1\\times10^{-10}$",
          "worked": "$$\\begin{align*}0.000063\\div300\\,000&=\\frac{6.3\\times10^{-5}}{3\\times10^5}\\\\0.000063\\div300\\,000&=2.1\\times10^{-5-5}\\\\0.000063\\div300\\,000&=2.1\\times10^{-10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p19-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$125\\,000\\div0.00005$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.5\\times10^9$",
          "worked": "$$\\begin{align*}125\\,000\\div0.00005&=\\frac{1.25\\times10^5}{5\\times10^{-5}}\\\\125\\,000\\div0.00005&=0.25\\times10^{5-(-5)}\\\\125\\,000\\div0.00005&=0.25\\times10^{10}\\\\125\\,000\\div0.00005&=2.5\\times10^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
