  "content": {
    "id": "p55-q10-root",
    "type": "question",
    "label": "",
    "prompt": "Evaluate using the standard forms $\\int \\sec^2 x\\,dx=\\tan x+C$ and $\\int \\operatorname{cosec}^2 x\\,dx=-\\cot x+C$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int \\tan^2(2x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\tan(2x)-x+C$",
          "worked": "$$\\begin{aligned}\\int\\tan^2(2x)\\,dx&=\\int\\bigl(\\sec^2(2x)-1\\bigr)\\,dx\\\\&=\\frac12\\tan(2x)-x+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p55-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int \\cot^2\\left(\\frac{x}{2}\\right)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\cot\\left(\\frac{x}{2}\\right)-x+C$",
          "worked": "$$\\begin{aligned}\\int\\cot^2\\left(\\frac{x}{2}\\right)\\,dx&=\\int\\left(\\operatorname{cosec}^2\\left(\\frac{x}{2}\\right)-1\\right)\\,dx\\\\&=-2\\cot\\left(\\frac{x}{2}\\right)-x+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p55-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{\\pi/12}^{\\pi/9}3\\tan^2(3x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3-1-\\frac{\\pi}{12}$",
          "worked": "$$\\begin{aligned}\\int_{\\pi/12}^{\\pi/9}3\\tan^2(3x)\\,dx&=\\int_{\\pi/12}^{\\pi/9}3\\bigl(\\sec^2(3x)-1\\bigr)\\,dx\\\\&=\\left[\\tan(3x)-3x\\right]_{\\pi/12}^{\\pi/9}\\\\&=\\left(\\tan\\frac{\\pi}{3}-\\frac{\\pi}{3}\\right)-\\left(\\tan\\frac{\\pi}{4}-\\frac{\\pi}{4}\\right)\\\\&=\\left(\\sqrt3-\\frac{\\pi}{3}\\right)-\\left(1-\\frac{\\pi}{4}\\right)\\\\&=\\sqrt3-1-\\frac{\\pi}{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p55-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{\\pi/24}^{\\pi/8}\\cot^2(4x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt3}{4}-\\frac{\\pi}{12}$",
          "worked": "$$\\begin{aligned}\\int_{\\pi/24}^{\\pi/8}\\cot^2(4x)\\,dx&=\\int_{\\pi/24}^{\\pi/8}\\bigl(\\operatorname{cosec}^2(4x)-1\\bigr)\\,dx\\\\&=\\left[-\\frac14\\cot(4x)-x\\right]_{\\pi/24}^{\\pi/8}\\\\&=\\left(-\\frac14\\cot\\frac{\\pi}{2}-\\frac{\\pi}{8}\\right)-\\left(-\\frac14\\cot\\frac{\\pi}{6}-\\frac{\\pi}{24}\\right)\\\\&=\\left(0-\\frac{\\pi}{8}\\right)-\\left(-\\frac{\\sqrt3}{4}-\\frac{\\pi}{24}\\right)\\\\&=\\frac{\\sqrt3}{4}-\\frac{\\pi}{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
