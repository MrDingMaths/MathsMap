    "type": "question",
    "label": "7",
    "prompt": "The difference of two fractions is $\\frac14$. The larger of the fractions is $\\frac78$. What is the smaller of the two fractions?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac58$",
      "worked": "Subtract the difference from the larger fraction.\n$$\\begin{align*}\\frac78-\\frac14&=\\frac78-\\frac28\\\\\\frac78-\\frac14&=\\frac58\\end{align*}$$\nThe smaller fraction is $\\frac58$.",
      "solutionDiagrams": []
    },
