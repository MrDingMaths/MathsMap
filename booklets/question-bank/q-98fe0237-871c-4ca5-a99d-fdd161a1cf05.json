    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$75\\sqrt2$",
      "worked": "$$11250=2\\times3^2\\times5^4$$\n$$\\begin{align*}\\sqrt{11250}&=\\sqrt{2\\times3^2\\times5^4}\\\\\\sqrt{11250}&=3\\times5^2\\sqrt2\\\\\\sqrt{11250}&=75\\sqrt2\\end{align*}$$",
      "solutionDiagrams": []
    },
