  "content": {
    "id": "p73-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A committee of three is to be selected from the nine members in a club.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p73-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "How many different committees can be formed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84$",
          "worked": "Order does not matter.\n$$\\begin{aligned}N&=\\binom{9}{3}\\\\&=84\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p73-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If there are five men in the club, what is the probability that the selected committee consists entirely of males?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{42}$",
          "worked": "There are $\\binom{5}{3}$ all-male committees out of $\\binom{9}{3}$ possible committees.\n$$\\begin{aligned}P(\\text{all males})&=\\frac{\\binom{5}{3}}{\\binom{9}{3}}\\\\&=\\frac{10}{84}\\\\&=\\frac{5}{42}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
