    "type": "question",
    "label": null,
    "prompt": "A polynomial is divided by $D(x)=x^4-3x+1$. What are the possible degrees of the remainder?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0$, $1$, $2$ or $3$.",
      "worked": "The degree of the remainder must be less than the degree of the divisor. Since $\\deg D(x)=4$, the possible degrees of the remainder are $0$, $1$, $2$ or $3$.",
