    "type": "question",
    "label": "5",
    "prompt": "A liquid cools from its original temperature of $95^\\circ\\text{C}$ to a temperature $T^\\circ\\text{C}$ in $t$ minutes. Given that $T=95(0.96)^t$, find the following temperatures, correct to one decimal place:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "the value of $T$ when $t=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$63.2^\\circ\\text{C}$",
          "worked": "$$\\begin{align*}T&=95(0.96)^{10}\\\\T&\\approx63.2\\end{align*}$$\nThe temperature is $63.2^\\circ\\text{C}$.",
