      {
        "id": "p36-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\$2000$ is invested for 10 years at $8\\%$ p.a. compounded annually",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$4317.85$",
          "worked": "$P=2000$, $R=0.08$ and $n=10$ annual periods.\n\n$$\\begin{align*}A_n&=P(1+R)^n\\\\A_{10}&=2000(1+0.08)^{10}\\\\A_{10}&=2000(1.08)^{10}\\\\A_{10}&\\approx\\$4317.85\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p36-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\$5000$ is invested for six years at $1\\%$ per month compound interest",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$10\\,235.50$",
          "worked": "There are $6\\times12=72$ monthly periods, with $R=0.01$ per month.\n\n$$\\begin{align*}A_n&=P(1+R)^n\\\\A_{72}&=5000(1+0.01)^{72}\\\\A_{72}&=5000(1.01)^{72}\\\\A_{72}&\\approx\\$10\\,235.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p36-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\$500$ is invested for 40 years at $3\\%$ per six-month period compound interest",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$5320.45$",
          "worked": "There are $40\\times2=80$ six-month periods, with $R=0.03$ per period.\n\n$$\\begin{align*}A_n&=P(1+R)^n\\\\A_{80}&=500(1+0.03)^{80}\\\\A_{80}&=500(1.03)^{80}\\\\A_{80}&\\approx\\$5320.45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
