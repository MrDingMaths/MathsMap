  "content": {
    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Prove that $(\\sin\\theta)(\\cos\\theta)(\\tan\\theta)=1-\\cos^2\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$$(\\sin\\theta)(\\cos\\theta)(\\tan\\theta)=\\sin^2\\theta=1-\\cos^2\\theta.$$",
      "worked": "$$\\begin{align*}(\\sin\\theta)(\\cos\\theta)(\\tan\\theta)&=(\\sin\\theta)(\\cos\\theta)\\frac{\\sin\\theta}{\\cos\\theta}\\\\(\\sin\\theta)(\\cos\\theta)(\\tan\\theta)&=\\sin^2\\theta\\\\(\\sin\\theta)(\\cos\\theta)(\\tan\\theta)&=1-\\cos^2\\theta\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
