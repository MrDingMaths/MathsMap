    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 units up.",
          "worked": "Replacing $y$ with $y-2$ gives $y-2=x^2$, a translation 2 units up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
