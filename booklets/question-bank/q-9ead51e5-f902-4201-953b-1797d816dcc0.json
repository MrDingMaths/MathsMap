        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"selectedCurve\",\"hex\":\"268CFF\",\"reason\":\"included section of the parabola\"},{\"name\":\"excludedCurve\",\"hex\":\"268CFF\",\"reason\":\"excluded continuation, also distinguished by dashes\"}],\"reference\":\"PDF page 68, printed page 74, p68-q62-diagram\"}\n\\begin{tikzpicture}[x=0.75cm,y=0.75cm,line cap=round,line join=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{selectedCurve}{HTML}{268CFF}\n\\definecolor{excludedCurve}{HTML}{268CFF}\n\\path[use as bounding box] (-2.35,-2.1) rectangle (3.05,4.7);\n\\draw[black,line width=0.5pt,->] (-2.2,0)--(2.95,0) node[below left] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-2)--(0,4.45) node[above left] {$y$};\n\\draw[black,dashed,line width=0.4pt] (-1,0)--(-1,1)--(0,1);\n\\draw[black,line width=0.4pt] (-1,-0.07)--(-1,0.07);\n\\draw[black,line width=0.4pt] (-0.07,1)--(0.07,1);\n\\node[below] at (-1,-0.08) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[right,xshift=2mm] at (0.08,1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\draw[opacity=0.65,excludedCurve,dashed,line width=0.8pt,<-] plot[domain=-2.05:-1,samples=45] (\\x,{\\x*\\x});\n\\draw[selectedCurve,line width=0.8pt,->] plot[domain=-1:2.05,samples=85] (\\x,{\\x*\\x});\n\\draw[black,fill=white,line width=0.4pt] (-1,1) circle[radius=1.65pt];\n\\end{tikzpicture}",
