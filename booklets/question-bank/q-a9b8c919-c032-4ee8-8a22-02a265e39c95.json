    "type": "question",
    "label": "5",
    "prompt": "Convert 9.85 megatonnes into milligrams.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9\\,850\\,000\\,000\\,000\\,000\\text{ mg}$",
      "worked": "Mega means one million. Convert megatonnes to tonnes, then multiply by 1000 at each step from tonnes to kilograms, grams and milligrams.\n\n$$\\begin{align*}\\text{Mass}&=9.85\\times1\\,000\\,000\\text{ t}\\\\\\text{Mass}&=9\\,850\\,000\\text{ t}\\\\\\text{Mass}&=9\\,850\\,000\\times1000\\text{ kg}\\\\\\text{Mass}&=9\\,850\\,000\\,000\\text{ kg}\\\\\\text{Mass}&=9\\,850\\,000\\,000\\times1000\\text{ g}\\\\\\text{Mass}&=9\\,850\\,000\\,000\\,000\\text{ g}\\\\\\text{Mass}&=9\\,850\\,000\\,000\\,000\\times1000\\text{ mg}\\\\\\text{Mass}&=9\\,850\\,000\\,000\\,000\\,000\\text{ mg}\\end{align*}$$",
      "solutionDiagrams": []
    },
