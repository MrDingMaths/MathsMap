  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Determine if the following sets of points are collinear:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(2,1)$, $B(3,3)$ and $C(6,9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "These points are collinear.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{3-1}{3-2}\\\\m_{AB}&=2\\\\m_{BC}&=\\frac{9-3}{6-3}\\\\m_{BC}&=2\\end{align*}$$\nThe intervals share $B$ and have equal gradients, so the points are collinear.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(1,2)$, $B(3,3)$ and $C(9,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "These points are collinear.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{3-2}{3-1}\\\\m_{AB}&=\\frac12\\\\m_{BC}&=\\frac{6-3}{9-3}\\\\m_{BC}&=\\frac12\\end{align*}$$\nThe intervals share $B$ and have equal gradients, so the points are collinear.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
