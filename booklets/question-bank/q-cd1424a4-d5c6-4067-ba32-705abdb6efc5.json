  "content": {
    "id": "v2-97400-p42-practice-slot-2-upper-root",
    "type": "question",
    "label": null,
    "prompt": "The average of two numbers is 4.6 and their difference is 7.8. Find the two numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "8.5 and 0.7.",
      "worked": "Let $x$ be the larger number and $y$ the smaller number.\n$$\\begin{align*}x+y&=2\\times4.6=9.2 &&(1)\\\\x-y&=7.8 &&(2)\\end{align*}$$\n$(1)+(2)$:\n$$\\begin{align*}2x&=17\\\\x&=8.5\\end{align*}$$\nSubstitute $x=8.5$ into (1):\n$$\\begin{align*}8.5+y&=9.2\\\\y&=0.7\\end{align*}$$\nThe two numbers are 8.5 and 0.7.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
