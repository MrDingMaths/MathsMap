    "prompt": "Find the average of the first 100 positive integers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{101}{2}$",
      "worked": "$$\\begin{align*}S_{100}&=\\frac{100}{2}(1+100)\\\\S_{100}&=5050\\\\\\text{Average}&=\\frac{5050}{100}\\\\\\text{Average}&=\\frac{101}{2}.\\end{align*}$$",
      "solutionDiagrams": []
    },
