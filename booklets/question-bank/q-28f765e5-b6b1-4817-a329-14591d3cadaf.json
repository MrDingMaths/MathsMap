    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "List the factors of 16",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1, 2, 4, 8, 16$",
          "worked": "Factor pairs of $16$: $1\\times16$, $2\\times8$, $4\\times4$.\n\nFactors: $1, 2, 4, 8, 16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "List the factors of 32",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1, 2, 4, 8, 16, 32$",
          "worked": "Factor pairs of $32$: $1\\times32$, $2\\times16$, $4\\times8$.\n\nFactors: $1, 2, 4, 8, 16, 32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "List the common factors of 16 and 32",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1, 2, 4, 8, 16$",
          "worked": "Factors of $16$: $1, 2, 4, 8, 16$.\n\nFactors of $32$: $1, 2, 4, 8, 16, 32$.\n\nCommon factors: $1, 2, 4, 8, 16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the highest common factor of 16 and 32?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "The common factors are $1, 2, 4, 8, 16$. The largest is $16$, so the HCF is $16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "What do you notice? Why does this happen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The HCF equals the smaller number because $16$ is a factor of $32$.",
          "worked": "$32=2\\times16$, so $16$ divides both numbers. No factor of $16$ is larger than $16$, so the HCF equals the smaller number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
