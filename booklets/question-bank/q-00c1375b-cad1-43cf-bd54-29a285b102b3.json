  "content": {
    "id": "p23-q2",
    "type": "question",
    "label": "2",
    "prompt": "By substituting $y = 0$, find the $x$-intercepts of these graphs.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y = (x+4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=(x+4)^2\\\\x+4&=0\\\\x&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = -(x-5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-(x-5)^2\\\\(x-5)^2&=0\\\\x-5&=0\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y = -2(x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-2(x+1)^2\\\\(x+1)^2&=0\\\\x+1&=0\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y = x^2 + 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "None.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=x^2+3\\\\x^2&=-3\\end{align*}$$\nA real square cannot be negative, so there are no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p23-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y = -x^2 - 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "None.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-x^2-3\\\\x^2&=-3\\end{align*}$$\nA real square cannot be negative, so there are no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p23-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y = 2x^2 - 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pm\\sqrt{\\frac{3}{2}}$",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=2x^2-3\\\\2x^2&=3\\\\x^2&=\\frac{3}{2}\\\\x&=\\pm\\sqrt{\\frac{3}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$y = -6x^2 - 1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "None.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-6x^2-1\\\\6x^2&=-1\\\\x^2&=-\\frac{1}{6}\\end{align*}$$\nA real square cannot be negative, so there are no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$y = (x-1)^2 - 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\pm\\sqrt{3}$",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=(x-1)^2-3\\\\(x-1)^2&=3\\\\x-1&=\\pm\\sqrt{3}\\\\x&=1\\pm\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$y = -(x+2)^2 + 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\pm\\sqrt{3}$",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-(x+2)^2+3\\\\(x+2)^2&=3\\\\x+2&=\\pm\\sqrt{3}\\\\x&=-2\\pm\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$y = (x+1)^2 + 1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "None.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=(x+1)^2+1\\\\(x+1)^2&=-1\\end{align*}$$\nA real square cannot be negative, so there are no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p23-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$y = (x-3)^2 - 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\pm\\sqrt{3}$",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=(x-3)^2-3\\\\(x-3)^2&=3\\\\x-3&=\\pm\\sqrt{3}\\\\x&=3\\pm\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$y = -(x+7)^2 - 14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "None.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-(x+7)^2-14\\\\(x+7)^2&=-14\\end{align*}$$\nA real square cannot be negative, so there are no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
