    "children": [
      {
        "id": "p12-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\log_2 9}{\\log_2 3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{\\log_2 9}{\\log_2 3}&=\\log_3 9\\\\\\frac{\\log_2 9}{\\log_2 3}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\log_3 8}{\\log_3 2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{\\log_3 8}{\\log_3 2}&=\\log_2 8\\\\\\frac{\\log_3 8}{\\log_3 2}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\log_5 2}{\\log_5 4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$$\\begin{align*}\\frac{\\log_5 2}{\\log_5 4}&=\\log_4 2\\\\\\frac{\\log_5 2}{\\log_5 4}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\log_4 3}{\\log_4 9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$$\\begin{align*}\\frac{\\log_4 3}{\\log_4 9}&=\\log_9 3\\\\\\frac{\\log_4 3}{\\log_4 9}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
