  "content": {
    "id": "p23-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A rectangle has side lengths $x+2$ cm and $6$ cm. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q11a",
        "type": "part",
        "label": "a",
        "prompt": "the perimeter of the rectangle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+16)$ cm",
          "worked": "$$\\begin{align*}P&=(x+2)+6+(x+2)+6\\\\P&=2x+2+6+2+6\\\\P&=(2x+16)\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q11b",
        "type": "part",
        "label": "b",
        "prompt": "the area of the rectangle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(6x+12)$ cm$^2$",
          "worked": "$$\\begin{align*}A&=6(x+2)\\\\A&=(6x+12)\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
