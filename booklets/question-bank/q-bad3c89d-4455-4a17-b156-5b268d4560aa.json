    "children": [
      {
        "id": "p16-26e-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the sum of the first 10 terms of the geometric sequence $6,12,24,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6138$",
          "worked": "$a=6$, $r=2$ and $n=10$.\n$$\\begin{align*}S_{10}&=\\frac{6(2^{10}-1)}{2-1}\\\\S_{10}&=6(1024-1)\\\\S_{10}&=6138.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p16-26e-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the sum of the first 8 terms of the geometric sequence $3,-6,12,-24,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-255$",
          "worked": "$a=3$, $r=-2$ and $n=8$.\n$$\\begin{align*}S_8&=\\frac{3((-2)^8-1)}{-2-1}\\\\S_8&=\\frac{3(256-1)}{-3}\\\\S_8&=-255.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p16-26e-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the sum of the first 8 terms of the geometric sequence $8,4,2,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{255}{16}$",
          "worked": "$a=8$, $r=\\frac12$ and $n=8$.\n$$\\begin{align*}S_8&=\\frac{8((\\frac12)^8-1)}{\\frac12-1}\\\\S_8&=\\frac{8(\\frac1{256}-1)}{-\\frac12}\\\\S_8&=\\frac{255}{16}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p16-26e-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the sum of the first 5 terms of the geometric sequence $24,-8,\\frac83,-\\frac89,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{488}{27}$",
          "worked": "$a=24$, $r=-\\frac13$ and $n=5$.\n$$\\begin{align*}S_5&=\\frac{24((-\\frac13)^5-1)}{-\\frac13-1}\\\\S_5&=\\frac{24(-\\frac1{243}-1)}{-\\frac43}\\\\S_5&=\\frac{488}{27}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p16-26e-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the sum of the first 8 terms of the geometric sequence $2,6,18,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6560$",
          "worked": "$a=2$, $r=3$ and $n=8$.\n$$\\begin{align*}S_8&=\\frac{2(3^8-1)}{3-1}\\\\S_8&=\\frac{2(6561-1)}{2}\\\\S_8&=6560.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p16-26e-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "Find the sum of the first 6 terms of the geometric sequence $3,3\\sqrt3,9,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$39(\\sqrt3+1)$",
          "worked": "$a=3$, $r=\\sqrt3$ and $n=6$.\n$$\\begin{align*}S_6&=\\frac{3((\\sqrt3)^6-1)}{\\sqrt3-1}\\\\S_6&=\\frac{3(27-1)}{\\sqrt3-1}\\\\S_6&=\\frac{78(\\sqrt3+1)}{(\\sqrt3-1)(\\sqrt3+1)}\\\\S_6&=\\frac{78(\\sqrt3+1)}{2}\\\\S_6&=39(\\sqrt3+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
