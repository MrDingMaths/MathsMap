    "type": "question",
    "label": "18",
    "prompt": "A rope $10\\frac{7}{8}$ m is cut into five equal length pieces of rope. How long is each piece?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{87}{40}\\text{ m}$",
      "worked": "$$\\begin{align*}\\text{Length of each piece}&=10\\frac{7}{8}\\div5\\\\\\text{Length of each piece}&=\\frac{87}{8}\\div5\\\\\\text{Length of each piece}&=\\frac{87}{8}\\times\\frac{1}{5}\\\\\\text{Length of each piece}&=\\frac{87}{40}\\text{ m}\\\\\\text{Length of each piece}&=2\\frac{7}{40}\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
