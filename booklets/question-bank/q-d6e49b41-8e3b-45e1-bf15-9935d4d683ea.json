        "answerSpaceMm": 10
      },
      {
        "id": "p14-q14b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the equation of the new graph if the graph is then translated up by 1 unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2e^x+1$",
          "worked": "Add $1$ to the output of the dilated function.\n\n$$y=2e^x+1$$",
