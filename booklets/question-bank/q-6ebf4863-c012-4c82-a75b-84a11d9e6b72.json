        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-2$",
          "worked": "$$\\begin{align*}(2x-4)(3x+6)&=0\\\\6(x-2)(x+2)&=0\\\\x-2&=0\\quad\\text{or}\\quad x+2=0\\\\x&=2\\quad\\text{or}\\quad x=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
