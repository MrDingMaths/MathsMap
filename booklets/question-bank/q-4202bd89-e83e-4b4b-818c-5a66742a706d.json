  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the percentage change for each of the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "The price of a belt increases from $\\$25$ to $\\$30$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\frac{30-25}{25}\\times100\\%\\\\\\text{Percentage increase}&=\\frac{5}{25}\\times100\\%\\\\\\text{Percentage increase}&=20\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The price of a painting decreases from $\\$80$ to $\\$70$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12.5\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Percentage decrease}&=\\frac{80-70}{80}\\times100\\%\\\\\\text{Percentage decrease}&=\\frac{10}{80}\\times100\\%\\\\\\text{Percentage decrease}&=12.5\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "The price of a lamp increases from $\\$50$ to $\\$65$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\frac{65-50}{50}\\times100\\%\\\\\\text{Percentage increase}&=\\frac{15}{50}\\times100\\%\\\\\\text{Percentage increase}&=30\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "The price of a shirt decreases from $\\$60$ to $\\$42$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Percentage decrease}&=\\frac{60-42}{60}\\times100\\%\\\\\\text{Percentage decrease}&=\\frac{18}{60}\\times100\\%\\\\\\text{Percentage decrease}&=30\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "The price of an apartment increases from $\\$500\\,000$ to $\\$520\\,000$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\frac{520\\,000-500\\,000}{500\\,000}\\times100\\%\\\\\\text{Percentage increase}&=\\frac{20\\,000}{500\\,000}\\times100\\%\\\\\\text{Percentage increase}&=4\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "The price of a car decreases from $\\$21\\,000$ to $\\$17\\,850$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Percentage decrease}&=\\frac{21\\,000-17\\,850}{21\\,000}\\times100\\%\\\\\\text{Percentage decrease}&=\\frac{3150}{21\\,000}\\times100\\%\\\\\\text{Percentage decrease}&=15\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
