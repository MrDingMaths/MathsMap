        "code": "\\begin{tikzpicture}[x=1cm,y=1cm,>=latex,font=\\fontsize{10}{12}\\selectfont]\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (4.5,0);\n\\coordinate (C) at (4.5,2.5);\n\\coordinate (D) at (0,2.5);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--(D)--cycle;\n\\draw[black,line width=0.5pt,<->] (0,2.85)--(4.5,2.85) node[midway,fill=white,inner xsep=2pt,inner ysep=0pt] {$3n+2$};\n\\draw[black,line width=0.5pt,<->] (-0.4,0)--(-0.4,2.5);\n\\draw[black,line width=0.8pt,fill=white] (-0.65,1)--(-0.15,1)--(-0.15,1.5)--(-0.65,1.5)--cycle;\n\\end{tikzpicture}",
