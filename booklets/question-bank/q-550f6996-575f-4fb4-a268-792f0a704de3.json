        "id": "v2-413b3e-p8-practice-topup-slot-3-topup-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the value of the unknown measurement?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$12n+8=4(3n+2)$$\nThe unknown measurement is the area divided by the known side:\n$$\\frac{4(3n+2)}{3n+2}=4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-413b3e-p8-practice-topup-slot-3-topup-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an expression for the perimeter of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6n+12$",
          "worked": "$$\\begin{align*}P&=2(3n+2)+2(4)\\\\P&=6n+4+8\\\\P&=6n+12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
