    "type": "question",
    "label": "6",
    "prompt": "A fund begins with $\\$20\\,000$ and earns $6\\%$ p.a. At the end of each year, $\\$3000$ is withdrawn. Find how much remains in the fund after 4 years. Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$12\\,125.69$",
