  "content": {
    "id": "p54-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A radioactive material decays at a rate proportional to the amount present:\n$$\\frac{dR}{dt}=kR,$$\nwhere $R$ is the amount at time $t$ days and $k$ is an unknown constant.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution of this DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=Ae^{kt}$.",
          "worked": "$$\\begin{align*}\\frac{dR}{R}&=k\\,dt\\\\\\int\\frac{dR}{R}&=\\int k\\,dt\\\\\\ln|R|&=kt+C\\\\R&=Ae^{kt}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p54-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Initially there is 100 grams. Determine the arbitrary constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=100$.",
          "worked": "$R(0)=100$, so\n$$\\begin{align*}100&=Ae^0\\\\A&=100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p54-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "After 4 days only 20 grams remain. Determine the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\frac14\\ln\\left(\\frac15\\right)=-\\frac14\\ln5\\ \\text{day}^{-1}$.",
          "worked": "$R(4)=20$, so\n$$\\begin{align*}100e^{4k}&=20\\\\e^{4k}&=\\frac15\\\\4k&=\\ln\\left(\\frac15\\right)\\\\k&=\\frac14\\ln\\left(\\frac15\\right)\\\\k&=-\\frac14\\ln5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p54-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence determine the amount present after 12 days.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.8\\text{ g}$.",
          "worked": "$$\\begin{align*}R(12)&=100e^{12\\left(-\\frac14\\ln5\\right)}\\\\R(12)&=100e^{-3\\ln5}\\\\R(12)&=\\frac{100}{125}\\\\R(12)&=0.8\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p54-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "Show that $R=100\\times\\left(\\frac15\\right)^{t/4}$, then use this formula to check part d mentally.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=100\\left(\\frac15\\right)^{t/4}$; at $t=12$, $R=100\\left(\\frac15\\right)^3=\\frac45=0.8\\text{ g}$.",
          "worked": "$$\\begin{align*}R&=100e^{kt}\\\\R&=100e^{\\frac{t}{4}\\ln(1/5)}\\\\R&=100\\left(\\frac15\\right)^{t/4}\\end{align*}$$\nFor $t=12$, there are three 4-day periods, so\n$$\\begin{align*}R(12)&=100\\left(\\frac15\\right)^3\\\\R(12)&=\\frac{100}{125}\\\\R(12)&=\\frac45\\text{ g}\\\\R(12)&=0.8\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
