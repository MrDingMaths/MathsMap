              "type": "text",
              "text": "Give a proof of Theorem 1 (Index Laws) from the Rational powers section using the definitions introduced in that section.",
              "marks": []
            }
          ]
        },
        {
          "id": "p13-q18-reference-text",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "a,b\\geq0",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "m,n\\in\\mathbb Q",
              "display": false
            },
            {
              "type": "text",
              "text": ". Prove the following laws wherever the expressions are defined.",
              "marks": []
            }
          ]
        }
