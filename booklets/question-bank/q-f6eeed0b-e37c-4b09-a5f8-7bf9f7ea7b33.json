  "content": {
    "id": "p16-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "If $x=2+\\sqrt{5}$ and $y=\\sqrt{5}-2$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}xy&=(2+\\sqrt{5})(\\sqrt{5}-2)\\\\xy&=(\\sqrt{5})^2-2^2\\\\xy&=5-4=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{5}$",
          "worked": "$$\\begin{align*}x+y&=(2+\\sqrt{5})+(\\sqrt{5}-2)\\\\x+y&=2\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}x^2&=(2+\\sqrt{5})^2\\\\x^2&=4+4\\sqrt{5}+5\\\\x^2&=9+4\\sqrt{5}\\\\y^2&=(\\sqrt{5}-2)^2\\\\y^2&=5-4\\sqrt{5}+4\\\\y^2&=9-4\\sqrt{5}\\\\x^2+y^2&=(9+4\\sqrt{5})+(9-4\\sqrt{5})\\\\x^2+y^2&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p16-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\sqrt{5}$",
          "worked": "$$\\begin{align*}x^2-y^2&=(x-y)(x+y)\\\\x^2-y^2&=\\bigl[(2+\\sqrt{5})-(\\sqrt{5}-2)\\bigr](2\\sqrt{5})\\\\x^2-y^2&=4(2\\sqrt{5})\\\\x^2-y^2&=8\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
