  "content": {
    "id": "p47-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find the value of $a$ and $b$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt{3}+1)^2=a+b\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4,\\ b=2$",
          "worked": "$$\\begin{aligned}(\\sqrt{3}+1)^2&=3+2\\sqrt{3}+1\\\\&=4+2\\sqrt{3}\\end{aligned}$$\nComparing terms, $a=4$ and $b=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p47-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$(4-\\sqrt{5})^2=a+b\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=21,\\ b=-8$",
          "worked": "$$\\begin{aligned}(4-\\sqrt{5})^2&=16-8\\sqrt{5}+5\\\\&=21-8\\sqrt{5}\\end{aligned}$$\nComparing terms, $a=21$ and $b=-8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p47-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2\\sqrt{3}+\\sqrt{2})^2=a+b\\sqrt{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=14,\\ b=4$",
          "worked": "$$\\begin{aligned}(2\\sqrt{3}+\\sqrt{2})^2&=12+4\\sqrt{6}+2\\\\&=14+4\\sqrt{6}\\end{aligned}$$\nComparing terms, $a=14$ and $b=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p47-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2\\sqrt{2}+1)^2=a+4\\sqrt{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=9,\\ b=2$",
          "worked": "$$\\begin{aligned}(2\\sqrt{2}+1)^2&=8+4\\sqrt{2}+1\\\\&=9+4\\sqrt{2}\\end{aligned}$$\nComparing with $a+4\\sqrt{b}$, $a=9$ and $b=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p47-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2\\sqrt{3}-3\\sqrt{6})^2=a+b\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=66,\\ b=-36$. Expand the square and use $\\sqrt{18}=3\\sqrt{2}$.",
          "worked": "$$\\begin{aligned}(2\\sqrt{3}-3\\sqrt{6})^2&=12-12\\sqrt{18}+54\\\\&=66-12(3\\sqrt{2})\\\\&=66-36\\sqrt{2}\\end{aligned}$$\nComparing terms, $a=66$ and $b=-36$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p47-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$(1-3\\sqrt{2})^2-(2+3\\sqrt{2})^2=a+b\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-3,\\ b=-18$. Expand both squares and subtract every term of the second.",
          "worked": "$$\\begin{aligned}(1-3\\sqrt{2})^2&=1-6\\sqrt{2}+18\\\\&=19-6\\sqrt{2}\\end{aligned}$$\n$$\\begin{aligned}(2+3\\sqrt{2})^2&=4+12\\sqrt{2}+18\\\\&=22+12\\sqrt{2}\\end{aligned}$$\n$$\\begin{aligned}(19-6\\sqrt{2})-(22+12\\sqrt{2})&=-3-18\\sqrt{2}\\end{aligned}$$\nComparing terms, $a=-3$ and $b=-18$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
