          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\left(\\frac{3}{2}+\\frac{2}{3}\\right)^2-\\left(\\frac{3}{2}-\\frac{2}{3}\\right)^2=4,\\qquad \\left(\\frac{7}{6}+\\frac{6}{7}\\right)^2-\\left(\\frac{7}{6}-\\frac{6}{7}\\right)^2=4",
              "display": true
            }
          ]
        },
        {
          "id": "p43-q2-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Write a rule for this pattern and prove it algebraically.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\left(\\dfrac{n+1}{n}+\\dfrac{n}{n+1}\\right)^2-\\left(\\dfrac{n+1}{n}-\\dfrac{n}{n+1}\\right)^2=4$ for integers $n\\ne0,-1$. Use the difference of two squares, then cancel common factors.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p43-q2-rule",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "For consecutive integers ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n+1",
                "display": false
              },
              {
                "type": "text",
                "text": ", with neither equal to zero, the difference of the two squares is always 4.",
                "marks": []
              }
            ]
          },
          {
            "id": "p43-q2-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\left(\\frac{n+1}{n}+\\frac{n}{n+1}\\right)^2-\\left(\\frac{n+1}{n}-\\frac{n}{n+1}\\right)^2&=\\left(\\frac{n^2+2n+1+n^2}{n(n+1)}\\right)^2-\\left(\\frac{n^2+2n+1-n^2}{n(n+1)}\\right)^2\\\\&=\\left(\\frac{2n^2+2n+1}{n(n+1)}\\right)^2-\\left(\\frac{2n+1}{n(n+1)}\\right)^2\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p43-q2-difference-of-squares-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using the difference of two squares,",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p43-q2-factorised-proof",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}&=\\left(\\frac{2n^2+2n+1}{n(n+1)}+\\frac{2n+1}{n(n+1)}\\right)\\left(\\frac{2n^2+2n+1}{n(n+1)}-\\frac{2n+1}{n(n+1)}\\right)\\\\&=\\left(\\frac{2n^2+4n+2}{n(n+1)}\\right)\\left(\\frac{2n^2}{n(n+1)}\\right)\\\\&=\\left(\\frac{2(n+1)^2}{n(n+1)}\\right)\\left(\\frac{2n^2}{n(n+1)}\\right)\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p43-q2-cancellation-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "By cancelling common factors,",
