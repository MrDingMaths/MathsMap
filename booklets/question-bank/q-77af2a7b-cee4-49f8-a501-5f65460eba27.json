  "content": {
    "id": "p40-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve these percentage problems.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A computer costs \\$800 before GST of 10% is added. Work out the price of the computer after GST is added.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$880$",
          "worked": "$$\\begin{align*}100\\%&=\\$800\\\\10\\%&=\\$800\\div10=\\$80\\\\110\\%&=\\$80\\times11=\\$880\\end{align*}$$\nThe price after GST is $\\$880$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "A washing machine costs \\$450. Work out the price of the washing machine after a 20% discount.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$360$",
          "worked": "A $20\\%$ discount leaves $80\\%$ of the original price.\n$$\\begin{align*}\\text{Sale price}&=\\$450\\times0.8\\\\&=\\$360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p40-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Beca scores 68 out of 80 in a Science test. Express her score as a percentage.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$85\\%$",
          "worked": "$$\\begin{align*}\\text{Beca's percentage}&=\\frac{68}{80}\\times100\\%\\\\&=85\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p40-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Marta scored 84 marks in a test. As a percentage, Marta scored 70%. Work out the total number of marks in the test.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "120 marks",
          "worked": "$$\\begin{align*}70\\%&=84\\text{ marks}\\\\1\\%&=\\frac{84}{70}\\text{ marks}\\\\100\\%&=\\frac{84}{70}\\times100\\text{ marks}\\\\&=120\\text{ marks}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "In a school, 15% of the students wear glasses. If 63 students wear glasses, how many students are in the school?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "420 students",
          "worked": "$$\\begin{align*}15\\%&=63\\text{ students}\\\\1\\%&=\\frac{63}{15}\\text{ students}\\\\100\\%&=\\frac{63}{15}\\times100\\text{ students}\\\\&=420\\text{ students}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "Jackson buys a scooter. He pays \\$300 including GST at 10%. Work out the price of the scooter before GST is added. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$272.73$",
          "worked": "The GST-inclusive price represents $110\\%$ of the pre-GST price.\n$$\\begin{align*}110\\%&=\\$300\\\\10\\%&=\\frac{\\$300}{11}\\\\100\\%&=\\frac{\\$300}{11}\\times10\\\\&=\\frac{\\$3000}{11}\\\\&\\approx\\$272.73\\end{align*}$$\nThe price before GST is $\\$272.73$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "A necklace costs \\$23. In a sale, the price is reduced by 12%. What is the sale price of the necklace?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$20.24$",
          "worked": "A $12\\%$ reduction leaves $88\\%$ of the original price.\n$$\\begin{align*}\\text{Sale price}&=\\$23\\times0.88\\\\&=\\$20.24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p40-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "In a survey, the population of a village was 4752. One year later, the population has increased by 3%. Find the new population to the nearest integer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4895 people",
          "worked": "$$\\begin{align*}\\text{New population}&=4752\\times1.03\\\\&=4894.56\\\\&\\approx4895\\end{align*}$$\nThe new population is 4895 people, to the nearest integer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p40-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "Flo scored 56 out of 80 in a Maths test. Ed scored 64 out of 92 in a different test. Who did better?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Flo; $70\\%>\\frac{1600}{23}\\%$.",
          "worked": "$$\\begin{align*}\\text{Flo's percentage}&=\\frac{56}{80}\\times100\\%\\\\&=70\\%\\\\\\text{Ed's percentage}&=\\frac{64}{92}\\times100\\%\\\\&=\\frac{1600}{23}\\%\\end{align*}$$\nSince $70=\\frac{1610}{23}>\\frac{1600}{23}$, Flo did better.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q6-j",
        "type": "part",
        "label": "j",
        "prompt": "Seb buys a bike for \\$245 and sells it for \\$380. Work out the percentage profit. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$55.1\\%$ profit; $\\frac{380-245}{245}\\times100\\%$.",
          "worked": "$$\\begin{align*}\\text{Profit}&=\\$380-\\$245\\\\&=\\$135\\\\\\text{Percentage profit}&=\\frac{135}{245}\\times100\\%\\\\&=\\frac{2700}{49}\\%\\\\&\\approx55.1\\%\\end{align*}$$\nThe percentage profit is $55.1\\%$, to 1 decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
