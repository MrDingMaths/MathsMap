      {
        "id": "p44-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\int x\\sqrt{1+x}\\,dx$ using the substitution $x=u^2-1$, where $u\\geq0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\left(\\frac{(1+x)^{5/2}}5-\\frac{(1+x)^{3/2}}3\\right)+C$.",
          "worked": "Let $x=u^2-1$. Then $dx=2u\\,du$ and $u=\\sqrt{1+x}$ since $u\\geq0$.\n$$\\begin{aligned}\\int x\\sqrt{1+x}\\,dx&=\\int(u^2-1)u(2u)\\,du\\\\&=2\\int(u^4-u^2)\\,du\\\\&=2\\left(\\frac{u^5}{5}-\\frac{u^3}{3}\\right)+C\\\\&=2\\left(\\frac{(1+x)^{5/2}}5-\\frac{(1+x)^{3/2}}3\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p44-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\int x\\sqrt{1+x}\\,dx$ using the substitution $x=u^2-1$, where $u\\leq0$.\n\nShow that your answer simplifies to the same result as part a.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\left(\\frac{(1+x)^{5/2}}5-\\frac{(1+x)^{3/2}}3\\right)+C$; both choices give the same antiderivative.",
          "worked": "Let $x=u^2-1$. Then $dx=2u\\,du$ and $u=-\\sqrt{1+x}$ since $u\\leq0$, so $\\sqrt{1+x}=-u$.\n$$\\begin{aligned}\\int x\\sqrt{1+x}\\,dx&=\\int(u^2-1)(-u)(2u)\\,du\\\\&=-2\\int(u^4-u^2)\\,du\\\\&=-2\\left(\\frac{u^5}{5}-\\frac{u^3}{3}\\right)+C\\\\&=-2\\left(\\frac{(-\\sqrt{1+x})^5}{5}-\\frac{(-\\sqrt{1+x})^3}{3}\\right)+C\\\\&=-2\\left(-\\frac{(1+x)^{5/2}}5+\\frac{(1+x)^{3/2}}3\\right)+C\\\\&=2\\left(\\frac{(1+x)^{5/2}}5-\\frac{(1+x)^{3/2}}3\\right)+C\\end{aligned}$$\nBoth choices give the same antiderivative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
