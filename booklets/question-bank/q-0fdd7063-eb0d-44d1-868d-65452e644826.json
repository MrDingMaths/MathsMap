  "content": {
    "id": "p13-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A rectangle has an area of $24\\text{ m}^2$. Its length is $5\\text{ m}$ longer than its breadth.\nLet $x$ be the breadth of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p13-q1-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 13, p13-q1-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.8pt] (0,0) rectangle (28,19);\n\\node[anchor=east] at (-2,9.5) {$x\\text{ m}$};\n\\node at (14,9.5) {$24\\text{ m}^2$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 42,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 13,
          "sourceRegion": "Question 1 opening rectangle at the upper right",
          "description": "An unshaded rectangle with x m beside the left side and 24 m² inside; no length label is supplied.",
          "mathematics": "Breadth x metres and area 24 square metres. The stem gives length x + 5 metres.",
          "answerVisibility": "Both labels are permanent givens; the inferred length is omitted."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p13-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the rectangle’s length.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+5$",
          "worked": "The length is $5\\text{ m}$ more than the breadth, so its length is $(x+5)\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p13-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an equation using the rectangle’s area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x+5)=24$",
          "worked": "$$\\begin{align*}\\text{breadth}\\times\\text{length}&=\\text{area}\\\\x(x+5)&=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p13-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Write your equation from part b in standard form (i.e. $ax^2+bx+c=0$) and solve for $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+5x-24=0$; $x=3$ (reject $x=-8$).",
          "worked": "$$\\begin{align*}x(x+5)&=24\\\\x^2+5x-24&=0\\\\(x+8)(x-3)&=0\\\\x&=-8\\text{ or }3\\end{align*}$$\nReject $x=-8$ because the breadth must be positive. Hence $x=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p13-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "What are the dimensions of the rectangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\text{ m}$ by $8\\text{ m}$.",
          "worked": "Breadth: $3\\text{ m}$.\nLength: $3+5=8\\text{ m}$.\nCheck: $3\\times8=24\\text{ m}^2$, and $8-3=5\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
