  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Prove that the two acute angles of a right-angled triangle add to $90^{\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "The acute angles add to $180^{\\circ}-90^{\\circ}=90^{\\circ}$.",
      "worked": "Let $A$ and $B$ be the acute angles and $C$ the right angle. By the angle sum of a triangle,\n$$\\begin{align*}\\angle A+\\angle B+\\angle C&=180^{\\circ}\\\\\\angle A+\\angle B+90^{\\circ}&=180^{\\circ}\\\\\\angle A+\\angle B&=90^{\\circ}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
