  "content": {
    "id": "p16-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A rod $2.5\\text{ m}$ long is leaning against a wall. The bottom of the rod is $1.5\\text{ m}$ from the wall. How far up the wall does the rod reach?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\text{ m}$",
      "worked": "Let $h$ be the height reached, measured in metres. The rod is the hypotenuse of the right-angled triangle formed by the wall and the ground. By Pythagoras’ theorem:\n$$\\begin{aligned}h^2+1.5^2&=2.5^2\\\\h^2+2.25&=6.25\\\\h^2&=6.25-2.25\\\\h^2&=4\\\\h&=2\\end{aligned}$$\nThe rod reaches $2\\text{ m}$ up the wall.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
