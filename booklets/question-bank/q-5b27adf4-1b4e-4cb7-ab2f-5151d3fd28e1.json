        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 18 p18-q4-diagram\"}\n\\begin{tikzpicture}[x=4cm,y=4cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (-1,0);\n\\coordinate (B) at (0,0);\n\\coordinate (C) at (0.5,0);\n\\coordinate (D) at (0.5,{sqrt(3)/2});\n\\draw[dashed] (A)--(C);\n\\draw[dashed] (A)--(D);\n\\draw (B)--(D)--(C);\n\\draw[line width=0.4pt] ($(A)!0.5!(B)+(0,-0.025)$)--($(A)!0.5!(B)+(0,0.025)$);\n\\draw[line width=0.4pt] ($(B)!0.5!(D)+({-sqrt(3)*0.025/2},0.0125)$)--($(B)!0.5!(D)+({sqrt(3)*0.025/2},-0.0125)$);\n\\draw[line width=0.4pt] ($(C)+(-0.11,0)$)--($(C)+(-0.11,0.11)$)--($(C)+(0,0.11)$);\n\\path (A)--(B) node[midway,below=3pt] {$1$};\n\\path (B)--(D) node[midway,above left=3pt] {$1$};\n\\pic[draw=none,\"$\\alpha$\",angle radius=10mm,angle eccentricity=1] {angle=B--A--D};\n\\pic[draw=none,\"$\\theta$\",angle radius=7mm,angle eccentricity=1] {angle=C--B--D};\n\\node[below left=2pt] at (A) {$A$};\n\\node[below=3pt] at (B) {$B$};\n\\node[below=3pt] at (C) {$C$};\n\\node[above=3pt] at (D) {$D$};\n\\end{tikzpicture}",
