        "id": "p16-q7-a",
        "type": "group",
        "label": "a",
        "prompt": "Find each of the lengths:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q7-a-a",
            "type": "part",
            "label": "a",
            "prompt": "$AB$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt{20}$",
              "worked": "$$\\begin{align*}AB^2&=(2-(-2))^2+(-1-(-3))^2\\\\AB^2&=4^2+2^2\\\\AB^2&=20\\\\AB&=\\sqrt{20}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          },
          {
            "id": "p16-q7-a-b",
            "type": "part",
            "label": "b",
            "prompt": "$BC$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt{20}$",
              "worked": "$$\\begin{align*}BC^2&=(0-2)^2+(3-(-1))^2\\\\BC^2&=(-2)^2+4^2\\\\BC^2&=20\\\\BC&=\\sqrt{20}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p16-q7-a-c",
            "type": "part",
            "label": "c",
            "prompt": "$CA$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt{40}$",
              "worked": "$$\\begin{align*}CA^2&=(-2-0)^2+(-3-3)^2\\\\CA^2&=(-2)^2+(-6)^2\\\\CA^2&=40\\\\CA&=\\sqrt{40}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\triangle ABC$ has a right angle, and then find its area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p16-q7-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\angle ABC=90^\\circ",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": "; area = 10 square units.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p16-q7-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "AB^2+BC^2=40=CA^2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so use the converse and take AB and BC as perpendicular sides.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}AB^2+BC^2&=(\\sqrt{20})^2+(\\sqrt{20})^2\\\\AB^2+BC^2&=20+20\\\\AB^2+BC^2&=40\\\\AB^2+BC^2&=CA^2\\end{align*}$$\nBy the converse of the Pythagorean theorem, $\\angle ABC=90^\\circ$.\n$$\\begin{align*}\\text{Area}&=\\frac{AB\\times BC}{2}\\\\\\text{Area}&=\\frac{\\sqrt{20}\\times\\sqrt{20}}{2}\\\\\\text{Area}&=10\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
