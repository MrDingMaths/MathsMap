      {
        "id": "p17-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x^2+1)(3x-1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2(3x-1)(6x^2-x+3)$",
          "worked": "$$\\begin{align*}y'&=2x(3x-1)^2\\\\&\\quad+6(x^2+1)(3x-1)\\\\y'&=2(3x-1)\\\\&\\quad\\times[x(3x-1)+3(x^2+1)]\\\\y'&=2(3x-1)(6x^2-x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p17-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(x^2-1)^3(5x+2)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2(5x+2)^3(x^2-1)^2(25x^2+6x-10)$",
          "worked": "$$\\begin{align*}y'&=6x(x^2-1)^2(5x+2)^4\\\\&\\quad+20(x^2-1)^3(5x+2)^3\\\\y'&=2(5x+2)^3(x^2-1)^2\\\\&\\quad\\times[3x(5x+2)+10(x^2-1)]\\\\y'&=2(5x+2)^3(x^2-1)^2\\\\&\\quad\\times(25x^2+6x-10)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p17-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(2x+1)^4(2x-1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2(2x-1)^4(2x+1)^3(18x+1)$",
          "worked": "$$\\begin{align*}y'&=8(2x+1)^3(2x-1)^5\\\\&\\quad+10(2x+1)^4(2x-1)^4\\\\y'&=2(2x-1)^4(2x+1)^3\\\\&\\quad\\times[4(2x-1)+5(2x+1)]\\\\y'&=2(2x-1)^4(2x+1)^3(18x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x\\sqrt{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{3x+2}{2\\sqrt{x+1}}$",
          "worked": "$$\\begin{align*}y'&=\\sqrt{x+1}+\\frac{x}{2\\sqrt{x+1}}\\\\y'&=\\frac{2(x+1)+x}{2\\sqrt{x+1}}\\\\y'&=\\frac{3x+2}{2\\sqrt{x+1}},\\quad x>-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p17-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^2\\sqrt{1-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{x(4-5x)}{2\\sqrt{1-x}}$",
          "worked": "$$\\begin{align*}y'&=2x\\sqrt{1-x}-\\frac{x^2}{2\\sqrt{1-x}}\\\\y'&=\\frac{4x(1-x)-x^2}{2\\sqrt{1-x}}\\\\y'&=\\frac{x(4-5x)}{2\\sqrt{1-x}},\\quad x<1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p17-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=x\\sqrt{1+x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{1+2x^2}{\\sqrt{1+x^2}}$",
          "worked": "$$\\begin{align*}y'&=\\sqrt{1+x^2}+\\frac{x^2}{\\sqrt{1+x^2}}\\\\y'&=\\frac{1+x^2+x^2}{\\sqrt{1+x^2}}\\\\y'&=\\frac{1+2x^2}{\\sqrt{1+x^2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
