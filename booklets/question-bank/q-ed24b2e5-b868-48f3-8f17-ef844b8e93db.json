        "id": "p7-q3a",
        "type": "part",
        "label": "a",
        "prompt": "Beth says “The range of the kilometres I drive is 17 to 120” Describe Beth’s mistake.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Beth has given the minimum and maximum. The range is their difference, a single number.",
          "worked": "Beth has stated the minimum and maximum. The range is their difference, a single number.\n\n$$\\begin{align*}\\text{Range} &= \\text{Max}-\\text{Min}\\\\\\text{Range} &= (120-17)\\text{ km}\\\\\\text{Range} &= 103\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q3b",
        "type": "part",
        "label": "b",
        "prompt": "Find the range of the number of kilometres she drives in a week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
