  "content": {
    "id": "p42-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Let $x^3+5x^2-7x+1=0$ have roots $\\alpha$, $\\beta$ and $\\gamma$. Find the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta+\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}\\alpha+\\beta+\\gamma&=-\\frac{5}{1}\\\\\\alpha+\\beta+\\gamma&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p42-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta+\\beta\\gamma+\\gamma\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7$",
          "worked": "$$\\begin{align*}\\alpha\\beta+\\beta\\gamma+\\gamma\\alpha&=\\frac{-7}{1}\\\\\\alpha\\beta+\\beta\\gamma+\\gamma\\alpha&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p42-q24-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha\\beta\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\alpha\\beta\\gamma&=-\\frac{1}{1}\\\\\\alpha\\beta\\gamma&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p42-q24-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{\\alpha}+\\dfrac{1}{\\beta}+\\dfrac{1}{\\gamma}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\frac{1}{\\alpha}+\\frac{1}{\\beta}+\\frac{1}{\\gamma}&=\\frac{\\alpha\\beta+\\beta\\gamma+\\gamma\\alpha}{\\alpha\\beta\\gamma}\\\\\\frac{1}{\\alpha}+\\frac{1}{\\beta}+\\frac{1}{\\gamma}&=\\frac{-7}{-1}\\\\\\frac{1}{\\alpha}+\\frac{1}{\\beta}+\\frac{1}{\\gamma}&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
