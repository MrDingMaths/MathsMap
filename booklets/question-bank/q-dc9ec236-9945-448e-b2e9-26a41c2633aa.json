    "type": "question",
    "label": "9",
    "prompt": "Find the area of an isosceles triangle where the equal sides of length $4\\text{ cm}$ are opposite angles of $30^\\circ$. Give an exact answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\sqrt{3}\\text{ cm}^2$",
      "worked": "The angle between the equal sides is $180^\\circ-30^\\circ-30^\\circ=120^\\circ$.\n$$\\begin{align*}A&=\\frac{1}{2}(4)(4)\\sin120^\\circ\\\\A&=4\\sqrt{3}\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
