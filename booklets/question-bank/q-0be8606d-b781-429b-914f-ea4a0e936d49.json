              "inlines": [
                {
                  "type": "text",
                  "text": "Prove that the square of every integer leaves a remainder of 0, 1 or 4 when divided by 8.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p7-q19-a-hint",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Hint: Every integer is of the form ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "4n",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", ",
