      {
        "id": "p51-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $P(-a\\le Z\\le a)=2P(Z\\le a)-1$ for $a\\ge0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-a\\le Z\\le a)=2P(Z\\le a)-1$.",
          "worked": "By symmetry, $P(Z<-a)=1-P(Z\\le a)$.\n$$\\begin{aligned}P(-a\\le Z\\le a)&=P(Z\\le a)-P(Z<-a)\\\\&=P(Z\\le a)-[1-P(Z\\le a)]\\\\&=P(Z\\le a)-1+P(Z\\le a)\\\\&=2P(Z\\le a)-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
