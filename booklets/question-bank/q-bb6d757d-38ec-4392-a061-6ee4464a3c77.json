        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=165^{\\circ},\\ 345^{\\circ}$",
          "worked": "The related angle is $360^{\\circ}-345^{\\circ}=15^{\\circ}$. Tangent is negative in quadrants 2 and 4.\n\n$$\\begin{align*}\\theta &= 180^{\\circ}-15^{\\circ}=165^{\\circ}\\\\\\theta &= 360^{\\circ}-15^{\\circ}=345^{\\circ}\\\\\\theta &= 165^{\\circ},\\ 345^{\\circ}\\end{align*}$$",
