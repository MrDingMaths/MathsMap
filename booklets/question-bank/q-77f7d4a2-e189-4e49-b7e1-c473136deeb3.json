    "children": [
      {
        "id": "p6-p5-a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $f(x+h)-f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2xh+h^2$",
          "worked": "$$\\begin{align*}f(x+h)-f(x)&=(x+h)^2-x^2\\\\f(x+h)-f(x)&=x^2+2xh+h^2-x^2\\\\f(x+h)-f(x)&=2xh+h^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p6-p5-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, show that\n\n$$\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}=2x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$\n\nFor $h\\ne0$, dividing $2xh+h^2$ by $h$ gives $2x+h$, which approaches $2x$ as $h\\to0$.",
          "worked": "$$\\begin{align*}\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}&=\\lim_{h\\to0}\\frac{2xh+h^2}{h}\\\\\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}&=\\lim_{h\\to0}\\frac{h(2x+h)}{h}\\\\\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}&=\\lim_{h\\to0}(2x+h)\\\\\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
