    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What did Akemi do wrong when substituting the points into the slope formula?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "She used the change in $x$ divided by the change in $y$.",
          "worked": "She substituted the $x$-coordinates into the numerator and the $y$-coordinates into the denominator. The gradient is the change in $y$ divided by the change in $x$: $m=\\dfrac{3-5}{4-1}=-\\dfrac23$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Using the graph, how could she have checked her work?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The line goes 2 down for every 3 across, so its gradient is $-\\dfrac23$.",
          "worked": "From $(1,5)$ to $(4,3)$, move 3 units right and 2 units down. Hence $m=\\dfrac{\\text{rise}}{\\text{run}}=\\dfrac{-2}{3}$, which does not agree with Akemi’s $-\\dfrac32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the gradient:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p10-q3-c-graph",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 10 p10-q3-c-graph\"}\n\\begin{tikzpicture}[x=0.42cm,y=0.42cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[step=1,line width=0.25pt,black!20] (-6,-6) grid (6,6);\n\\draw[<->,line width=0.5pt] (-7.4,0)--(7.4,0) node[below] {$x$};\n\\draw[<->,line width=0.5pt] (0,-7.4)--(0,7.4) node[right] {$y$};\n\\draw[<->,line width=0.8pt] (-7.5,-1.25)--(3.7,4.35);\n\\fill (-5,0) circle (2pt) node[above left] {$(-5,0)$};\n\\fill (-1,2) circle (2pt) node[above left] {$(-1,2)$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 70,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 10,
              "sourceRegion": "Question 3, final response graph",
              "description": "Six-unit square grid either side of the origin, unnumbered axes with arrows at both ends, and an ascending line through (-5,0) and (-1,2). The source origin numeral is omitted under the graph convention.",
              "mathematics": "The line is y=(x+5)/2. Its gradient is 1/2.",
              "answerVisibility": "Only the given graph and labelled points are visible in questions."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "diagramPlacement": "beside-prompt",
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$\\begin{aligned}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{2-0}{-1-(-5)}\\\\m&=\\frac24\\\\m&=\\frac12\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
