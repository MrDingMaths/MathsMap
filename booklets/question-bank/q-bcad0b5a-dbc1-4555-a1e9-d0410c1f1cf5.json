  "content": {
    "id": "p21-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Usain Bolt ran 100 metres in 9.58 seconds. In this race, what was his average speed in kilometres per hour? Give your answer correct to two decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$37.58\\text{ km/h}$",
      "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{100}{9.58}\\text{ m/s}\\\\s&=\\frac{100}{9.58}\\times3.6\\text{ km/h}\\\\s&\\approx37.58\\text{ km/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
