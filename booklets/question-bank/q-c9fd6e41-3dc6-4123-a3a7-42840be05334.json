      "taskHash": "afc5c29302160b3a18cd5009b0a480058c53b793d04fe21fd39a18ef8f28f783",
      "evidence": ".booklet-work/reasoning-ratings/calls/surds-v1/c058a4f293dba839d1fed724426551f2f937c0fc1e92dca83f9780bc9daf6950-1792562104297/last-message.txt"
    }
  },
  "content": {
    "id": "p54-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Expand these products of conjugate pairs.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q1-products",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q1-a",
            "type": "part",
            "label": "a",
            "prompt": "$(4-\\sqrt{3})(4+\\sqrt{3})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$13$",
              "worked": "$$\\begin{align*}(4-\\sqrt{3})(4+\\sqrt{3})&=4^2-(\\sqrt{3})^2\\\\&=16-3\\\\&=13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p54-q1-b",
            "type": "part",
            "label": "b",
            "prompt": "$(5+\\sqrt{7})(5-\\sqrt{7})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$18$",
              "worked": "$$\\begin{align*}(5+\\sqrt{7})(5-\\sqrt{7})&=5^2-(\\sqrt{7})^2\\\\&=25-7\\\\&=18\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p54-q1-c",
            "type": "part",
            "label": "c",
            "prompt": "$(\\sqrt{6}-2\\sqrt{10})(\\sqrt{6}+2\\sqrt{10})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-34$",
              "worked": "$$\\begin{align*}(\\sqrt{6}-2\\sqrt{10})(\\sqrt{6}+2\\sqrt{10})&=(\\sqrt{6})^2-(2\\sqrt{10})^2\\\\&=6-4\\times10\\\\&=-34\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p54-q1-d",
            "type": "part",
            "label": "d",
            "prompt": "$(a+\\sqrt{b})(a-\\sqrt{b})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a^2-b$",
              "worked": "$$\\begin{align*}(a+\\sqrt{b})(a-\\sqrt{b})&=a^2-(\\sqrt{b})^2\\\\&=a^2-b\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          }
        ]
      },
      {
        "id": "p54-q1-followup",
        "type": "part",
        "label": "e",
        "prompt": "Do you get a rational number as a result in each example?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes for a–c. In d, this depends on the values of $a$ and $b$.",
          "worked": "The results $13$, $18$ and $-34$ are rational. The symbolic result $a^2-b$ is not necessarily rational without conditions on $a$ and $b$; for example, $a=1$ and $b=\\sqrt{2}$ give $1-\\sqrt{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
