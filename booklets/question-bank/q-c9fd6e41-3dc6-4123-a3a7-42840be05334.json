    "difficulty": "Mastery",
    "difficultyReason": "Beyond routine conjugate products, decide whether the symbolic result a squared minus b must be rational, recognising that unspecified variable values prevent that conclusion.",
    "assessment": {
      "model": "gpt-6.1-sol",
      "assessedAt": "2026-10-21T05:55:43.222Z",
