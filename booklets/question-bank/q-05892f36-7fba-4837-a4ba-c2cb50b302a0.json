  "content": {
    "id": "p18-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "One pump would take 6 days to fill a pool. A second pump would take 8 days to fill the same pool.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q5a",
        "type": "part",
        "label": "a",
        "prompt": "How long would it take for the pool to be filled if both pumps were working together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{24}{7}$ days.",
          "worked": "In 24 days, the first pump could fill $24\\div6=4$ pools and the second could fill $24\\div8=3$ pools. Together they could fill $4+3=7$ pools.\n\n$$\\begin{align*}\\text{Time for one pool}&=24\\div7\\\\\\text{Time for one pool}&=\\frac{24}{7}\\text{ days}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q5b",
        "type": "part",
        "label": "b",
        "prompt": "The second pump breaks down when the pool is half full. The first pump continues alone. Find the total time required to fill the pool.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p18-q5b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{33}{7}\\text{ days}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p18-q5b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the time for both pumps to fill half the pool to the first pump's time for the remaining half.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\text{Time for the first half}&=\\frac12\\times\\frac{24}{7}\\\\\\text{Time for the first half}&=\\frac{12}{7}\\text{ days}\\\\\\text{Time for the remaining half}&=\\frac12\\times6\\\\\\text{Time for the remaining half}&=3\\text{ days}\\\\\\text{Total time}&=\\frac{12}{7}+3\\\\\\text{Total time}&=\\frac{33}{7}\\text{ days}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
