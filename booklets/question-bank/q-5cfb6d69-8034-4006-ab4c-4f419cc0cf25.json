      {
        "id": "p48-q11-a-node",
        "type": "part",
        "label": "a",
        "prompt": "Show that the derivative of $f(x)=\\dfrac{1}{x^2-4}$ is $f'(x)=-\\dfrac{2x}{(x^2-4)^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-2x(x^2-4)^{-2}=-\\dfrac{2x}{(x^2-4)^2}$.",
          "worked": "$$\\begin{align*}f(x)&=(x^2-4)^{-1}\\\\f'(x)&=-(x^2-4)^{-2}(2x)\\\\f'(x)&=-\\frac{2x}{(x^2-4)^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p48-q11-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Show that $y=f(x)$ has a stationary point at $x=0$.\nThen determine its nature, using a table of values of $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A local maximum at $(0,-\\tfrac14)$; $f'(x)$ changes from positive to negative.",
