        "type": "part",
        "label": "a",
        "prompt": "$y=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,0)$",
          "worked": "There is no horizontal or vertical shift, so the turning point is $(0,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p17-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,0)$",
          "worked": "Reflection across the $x$-axis leaves the turning point at $(0,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p17-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,3)$",
          "worked": "The graph shifts up 3 units, so the turning point is $(0,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p17-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=-x^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-3)$",
          "worked": "Reflection leaves the vertex at the origin; shifting down 3 units gives $(0,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p17-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=-x^2+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,7)$",
          "worked": "Reflection leaves the vertex at the origin; shifting up 7 units gives $(0,7)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p17-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=(x-2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,0)$",
          "worked": "The graph shifts right 2 units, so the turning point is $(2,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p17-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=(x+5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-5,0)$",
          "worked": "The graph shifts left 5 units, so the turning point is $(-5,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p17-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=2x^2$",
