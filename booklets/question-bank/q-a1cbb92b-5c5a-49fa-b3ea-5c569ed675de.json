    "children": [
      {
        "id": "p19-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why this cone is NOT half full.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Half the height does not give half the volume: the water occupies the narrower bottom of the cone.",
          "worked": "The water has half the full cone's height and half its radius. Since $V=\\frac13\\pi r^2h$, its volume is $\\left(\\frac12\\right)^2\\times\\frac12=\\frac18$ of the full volume.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Work out the fraction of the cone that is filled with water.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac18$",
          "worked": "$$\\begin{align*}V_{\\text{water}}&=\\frac13\\times\\pi\\times4^2\\times6\\\\&=32\\pi\\text{ cm}^3\\\\V_{\\text{full}}&=\\frac13\\times\\pi\\times8^2\\times12\\\\&=256\\pi\\text{ cm}^3\\\\\\text{Fraction filled}&=\\frac{32\\pi}{256\\pi}\\\\&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
