  "content": {
    "id": "p7-q34-42-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following expressions, and express your answer as an exact value in simplest form. Do not use a calculator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q34",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin45^{\\circ}+\\cos45^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sin45^{\\circ}+\\cos45^{\\circ}&=\\frac{1}{\\sqrt{2}}+\\frac{1}{\\sqrt{2}}\\\\\\sin45^{\\circ}+\\cos45^{\\circ}&=\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q35",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin^2 45^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}\\sin^2 45^{\\circ}&=\\left(\\frac{1}{\\sqrt{2}}\\right)^2\\\\\\sin^2 45^{\\circ}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q36",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin^2 30^{\\circ}+\\cos^2 30^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin^2 30^{\\circ}+\\cos^2 30^{\\circ}&=\\left(\\frac{1}{2}\\right)^2+\\left(\\frac{\\sqrt{3}}{2}\\right)^2\\\\\\sin^2 30^{\\circ}+\\cos^2 30^{\\circ}&=\\frac{1}{4}+\\frac{3}{4}\\\\\\sin^2 30^{\\circ}+\\cos^2 30^{\\circ}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q37",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos^2 60^{\\circ}-\\sin^2 60^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}\\cos^2 60^{\\circ}-\\sin^2 60^{\\circ}&=\\left(\\frac{1}{2}\\right)^2-\\left(\\frac{\\sqrt{3}}{2}\\right)^2\\\\\\cos^2 60^{\\circ}-\\sin^2 60^{\\circ}&=\\frac{1}{4}-\\frac{3}{4}\\\\\\cos^2 60^{\\circ}-\\sin^2 60^{\\circ}&=-\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q38",
        "type": "part",
        "label": "e",
        "prompt": "$2\\cos^2 30^{\\circ}-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}2\\cos^2 30^{\\circ}-1&=2\\left(\\frac{\\sqrt{3}}{2}\\right)^2-1\\\\2\\cos^2 30^{\\circ}-1&=\\frac{3}{2}-1\\\\2\\cos^2 30^{\\circ}-1&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q39",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1+\\tan30^{\\circ}}{1-\\tan30^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-q39-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "2+\\sqrt{3}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p7-q39-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute the exact tangent value and rationalise the denominator.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{1+\\tan30^{\\circ}}{1-\\tan30^{\\circ}}&=\\frac{1+\\frac{1}{\\sqrt{3}}}{1-\\frac{1}{\\sqrt{3}}}\\\\\\frac{1+\\tan30^{\\circ}}{1-\\tan30^{\\circ}}&=\\frac{\\sqrt{3}+1}{\\sqrt{3}-1}\\\\\\frac{1+\\tan30^{\\circ}}{1-\\tan30^{\\circ}}&=\\frac{(\\sqrt{3}+1)^2}{(\\sqrt{3}-1)(\\sqrt{3}+1)}\\\\\\frac{1+\\tan30^{\\circ}}{1-\\tan30^{\\circ}}&=\\frac{4+2\\sqrt{3}}{2}\\\\\\frac{1+\\tan30^{\\circ}}{1-\\tan30^{\\circ}}&=2+\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p7-q40",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\tan60^{\\circ}-\\tan45^{\\circ}}{1+\\tan60^{\\circ}\\tan45^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-q40-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "2-\\sqrt{3}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p7-q40-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute the exact tangent values and rationalise the denominator.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{\\tan60^{\\circ}-\\tan45^{\\circ}}{1+\\tan60^{\\circ}\\tan45^{\\circ}}&=\\frac{\\sqrt{3}-1}{1+\\sqrt{3}}\\\\\\frac{\\tan60^{\\circ}-\\tan45^{\\circ}}{1+\\tan60^{\\circ}\\tan45^{\\circ}}&=\\frac{(\\sqrt{3}-1)^2}{(\\sqrt{3}+1)(\\sqrt{3}-1)}\\\\\\frac{\\tan60^{\\circ}-\\tan45^{\\circ}}{1+\\tan60^{\\circ}\\tan45^{\\circ}}&=\\frac{4-2\\sqrt{3}}{2}\\\\\\frac{\\tan60^{\\circ}-\\tan45^{\\circ}}{1+\\tan60^{\\circ}\\tan45^{\\circ}}&=2-\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q41",
        "type": "part",
        "label": "h",
        "prompt": "$\\sin60^{\\circ}\\cos30^{\\circ}+\\cos60^{\\circ}\\sin30^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin60^{\\circ}\\cos30^{\\circ}+\\cos60^{\\circ}\\sin30^{\\circ}&=\\frac{\\sqrt{3}}{2}\\cdot\\frac{\\sqrt{3}}{2}+\\frac{1}{2}\\cdot\\frac{1}{2}\\\\\\sin60^{\\circ}\\cos30^{\\circ}+\\cos60^{\\circ}\\sin30^{\\circ}&=\\frac{3}{4}+\\frac{1}{4}\\\\\\sin60^{\\circ}\\cos30^{\\circ}+\\cos60^{\\circ}\\sin30^{\\circ}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q42",
        "type": "part",
        "label": "i",
        "prompt": "$\\sin60^{\\circ}\\cos45^{\\circ}-\\cos60^{\\circ}\\sin45^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-q42-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{\\sqrt{6}-\\sqrt{2}}{4}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p7-q42-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute the exact ratios, combine the fractions and rationalise.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\sin60^{\\circ}\\cos45^{\\circ}-\\cos60^{\\circ}\\sin45^{\\circ}&=\\frac{\\sqrt{3}}{2}\\cdot\\frac{1}{\\sqrt{2}}-\\frac{1}{2}\\cdot\\frac{1}{\\sqrt{2}}\\\\\\sin60^{\\circ}\\cos45^{\\circ}-\\cos60^{\\circ}\\sin45^{\\circ}&=\\frac{\\sqrt{3}-1}{2\\sqrt{2}}\\\\\\sin60^{\\circ}\\cos45^{\\circ}-\\cos60^{\\circ}\\sin45^{\\circ}&=\\frac{(\\sqrt{3}-1)\\sqrt{2}}{4}\\\\\\sin60^{\\circ}\\cos45^{\\circ}-\\cos60^{\\circ}\\sin45^{\\circ}&=\\frac{\\sqrt{6}-\\sqrt{2}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
