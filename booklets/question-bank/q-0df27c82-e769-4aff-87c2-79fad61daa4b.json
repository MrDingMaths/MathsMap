    "id": "v2-94367-p55-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "A paddock is $2\\frac{2}{3}$ hectares in area.\nIf $\\frac{5}{8}$ of the paddock is planted with wheat, what area in hectares is planted with wheat?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1\\frac{2}{3}$ hectares",
      "worked": "$$\\begin{align*}\\text{Area planted}&=\\frac{5}{8}\\times2\\frac{2}{3}\\text{ hectares}\\\\&=\\frac{5}{8}\\times\\frac{8}{3}\\text{ hectares}\\\\&=\\frac{40}{24}\\text{ hectares}\\\\&=\\frac{5}{3}\\text{ hectares}\\\\&=1\\frac{2}{3}\\text{ hectares}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
