  "content": {
    "id": "p21-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A rectangle has length $x$ cm and area $\\frac{6x^2}{5}\\text{ cm}^2$. Find its width.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{6x}{5}\\text{ cm}$\n\nDivide the area by the length.",
      "worked": "Width is area divided by length.\n\n$$\\begin{align*}w&=\\frac{6x^2}{5}\\div x\\\\w&=\\frac{6x^2}{5x}\\\\w&=\\frac{6x}{5}\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
