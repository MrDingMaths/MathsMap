  "content": {
    "id": "v2-d7eec-p10-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "The formula for converting a temperature from degrees Celsius, $C$, to degrees Fahrenheit, $F$, is $F=\\frac{9}{5}C+32$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d7eec-p10-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $C$ when $F=77$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=25$",
          "worked": "$$\\begin{align*}F&=\\frac{9}{5}C+32\\\\77&=\\frac{9}{5}C+32\\\\45&=\\frac{9}{5}C\\\\225&=9C\\\\25&=C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-d7eec-p10-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $C$ when $F=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=-20$",
          "worked": "$$\\begin{align*}F&=\\frac{9}{5}C+32\\\\-4&=\\frac{9}{5}C+32\\\\-36&=\\frac{9}{5}C\\\\-180&=9C\\\\-20&=C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
