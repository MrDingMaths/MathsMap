  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Determine the integer values of $n$ for which the fraction $\\frac{n+13}{n+2}$ will not be in lowest terms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p24-q3-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "n=11k+9,\\quad k\\in\\mathbb Z,\\quad k\\ne-1",
                "display": false
              }
            ]
          },
          {
            "id": "p24-q3-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The numerator and denominator differ by 11, so their common factor must be 11. Exclude ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n=-2",
                "display": false
              },
              {
                "type": "text",
                "text": ", where the fraction is undefined.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "For integer $n$, subtract the denominator from the numerator:\n$$\\begin{align*}(n+13)-(n+2)&=11\\\\\\operatorname{GCD}(n+13,n+2)&=\\operatorname{GCD}(n+2,11).\\end{align*}$$\nSince $11$ is prime, a common factor greater than $1$ occurs exactly when $11$ divides $n+2$.\n$$\\begin{align*}n+2&=11m\\\\n&=11m-2\\\\n&=11k+9,\\qquad k=m-1.\\end{align*}$$\nThus $n=11k+9$ for $k\\in\\mathbb Z$, excluding $k=-1$ because $n=-2$ makes the denominator zero.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
