        "children": [],
        "answer": {
          "short": "$48.6$ years",
          "worked": "Class centres: $9,\\ 24,\\ 40,\\ 57.5,\\ 77.5$ years.\n$$\\begin{aligned}9\\times30&=270\\\\24\\times25&=600\\\\40\\times61&=2440\\\\57.5\\times72&=4140\\\\77.5\\times58&=4495\\\\\\sum(cc\\times f)&=270+600+2440+4140+4495\\\\&=11945\\\\\\sum f&=30+25+61+72+58\\\\&=246\\\\\\bar{x}&=\\frac{11945}{246}\\\\\\bar{x}&\\approx48.6\\text{ years}\\end{aligned}$$",
          "solutionDiagrams": []
        },
