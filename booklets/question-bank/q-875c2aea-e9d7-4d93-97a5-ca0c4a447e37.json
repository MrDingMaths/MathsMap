    "answer": {
      "short": "$1200\\text{ members/year}$",
      "worked": "$$\\begin{align*}\\text{Membership increase} &= 18\\,000-12\\,000 = 6000\\text{ members}\\\\\\text{Time} &= 5\\text{ years}\\\\\\text{Average rate} &= \\frac{6000\\text{ members}}{5\\text{ years}} = 1200\\text{ members/year}\\end{align*}$$",
