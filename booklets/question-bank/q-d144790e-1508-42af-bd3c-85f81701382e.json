      {
        "id": "p5-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{a}+\\dfrac{1}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{a}+\\frac{1}{b}&=\\frac{a+b}{ab}\\\\&=\\frac{5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p5-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{a^2}+\\dfrac{1}{b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{19}{9}$\n\nWrite $a^2+b^2$ as $(a+b)^2-2ab$.",
          "worked": "$$\\begin{align*}\\frac{1}{a^2}+\\frac{1}{b^2}&=\\frac{a^2+b^2}{(ab)^2}\\\\&=\\frac{(a+b)^2-2ab}{(ab)^2}\\\\&=\\frac{5^2-2\\cdot3}{3^2}\\\\&=\\frac{19}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{a^2+ab}+\\dfrac{1}{b^2+ab}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3}$\n\nFactor both denominators to expose their common factor $a+b$.",
          "worked": "$$\\begin{align*}\\frac{1}{a^2+ab}+\\frac{1}{b^2+ab}&=\\frac{1}{a(a+b)}+\\frac{1}{b(a+b)}\\\\&=\\frac{a+b}{ab(a+b)}\\\\&=\\frac{1}{ab}\\\\&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
