  "content": {
    "id": "p42-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Let the cost of an apple be $a$ and the cost of a banana be $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "One apple and one banana cost $\\$1.25$. Write an equation to describe this information.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b=1.25$",
          "worked": "$$\\begin{align*}a+b&=1.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p42-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Two apples and three bananas cost $\\$3.25$. Write an equation to describe this information.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a+3b=3.25$",
          "worked": "$$\\begin{align*}2a+3b&=3.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p42-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Use parts a and b to find the cost of an apple and the cost of a banana.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Apple: $\\$0.50$; banana: $\\$0.75$.",
          "worked": "$$\\begin{align*}a+b&=1.25 &&(1)\\\\2a+3b&=3.25 &&(2)\\\\2a+2b&=2.50 &&2\\times(1)\\end{align*}$$\n$(2)-2\\times(1)$:\n$$\\begin{align*}b&=0.75\\end{align*}$$\nSubstitute $b=0.75$ into (1):\n$$\\begin{align*}a+0.75&=1.25\\\\a&=0.50\\end{align*}$$\nAn apple costs $\\$0.50$ and a banana costs $\\$0.75$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
