        "answer": {
          "short": "Rectangle: $6\\pi\\text{ cm}\\times7\\text{ cm}$. Each circle: radius $3\\text{ cm}$.",
          "worked": "The rectangle's length is the circumference of a circular end:\n$$\\begin{align*}C&=2\\pi r\\\\C&=2\\pi(3)\\\\C&=6\\pi\\text{ cm}.\\end{align*}$$\nIts width is the cylinder's height, $7\\text{ cm}$. Each circle has radius $3\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-76b48-p20-practice-retro-slot-8-retro-slot-8-b",
        "type": "group",
        "label": "b",
        "prompt": "Calculate the area of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "v2-76b48-p20-practice-retro-slot-8-retro-slot-8-b-i",
            "type": "part",
            "label": "i",
            "prompt": "The two circles. Answer in exact form.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$18\\pi\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A_{\\text{circles}}&=2\\pi r^2\\\\A_{\\text{circles}}&=2\\pi(3)^2\\\\A_{\\text{circles}}&=18\\pi\\text{ cm}^2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "v2-76b48-p20-practice-retro-slot-8-retro-slot-8-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "The rectangle. Answer in exact form.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$42\\pi\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A_{\\text{rectangle}}&=2\\pi rh\\\\A_{\\text{rectangle}}&=2\\pi(3)(7)\\\\A_{\\text{rectangle}}&=42\\pi\\text{ cm}^2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "v2-76b48-p20-practice-retro-slot-8-retro-slot-8-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Hence find the surface area of the cylinder to 1 d.p.",
            "layout": "list",
