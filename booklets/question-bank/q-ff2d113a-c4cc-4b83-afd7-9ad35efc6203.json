            "answer": {
              "short": "$188.5\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A&=18\\pi+42\\pi\\\\A&=60\\pi\\text{ cm}^2\\\\A&\\approx188.5\\text{ cm}^2\\quad\\text{(1 d.p.)}.\\end{align*}$$",
