    "children": [
      {
        "id": "p25-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the perpendicular bisector of the line segment joining $(1,1)$ with $(3,5)$ in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-8=0$. Midpoint $(2,3)$; perpendicular gradient $-\\frac12$.",
          "worked": "The perpendicular bisector passes through the midpoint.\n$$\\begin{align*}\nM&=\\left(\\frac{1+3}{2},\\frac{1+5}{2}\\right)\\\\\n&=(2,3)\\\\\nm&=\\frac{5-1}{3-1}\\\\\n&=2\\\\\nm_{\\mathrm{perp}}&=-\\frac12\n\\end{align*}$$\nUsing point–gradient form:\n$$\\begin{align*}\ny-y_1&=m_{\\mathrm{perp}}(x-x_1)\\\\\ny-3&=-\\frac12(x-2)\\\\\n2y-6&=-x+2\\\\\nx+2y-8&=0\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p25-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find where this bisector cuts the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(8,0)$",
          "worked": "On the $x$-axis, $y=0$.\n$$\\begin{align*}\nx+2(0)-8&=0\\\\\nx-8&=0\\\\\nx&=8\n\\end{align*}$$\nThe bisector cuts the $x$-axis at $(8,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
