  "content": {
    "id": "p16-g88-93-root",
    "type": "question",
    "label": null,
    "prompt": "Determine whether the following functions are odd, even, or neither.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-g88-93-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even.",
          "worked": "$$\\begin{align*}f(-x)&=2\\cos(-x)\\\\f(-x)&=2\\cos x\\\\f(-x)&=f(x)\\end{align*}$$\nCosine is even, so $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-g88-93-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)\\sin(-x)\\\\f(-x)&=(-x)(-\\sin x)\\\\f(-x)&=x\\sin x\\\\f(-x)&=f(x)\\end{align*}$$\nBoth factors change sign, so $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-g88-93-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sin x-\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Neither.",
          "worked": "$$\\begin{align*}f(-x)&=\\sin(-x)-\\cos(-x)\\\\f(-x)&=-\\sin x-\\cos x\\end{align*}$$\nThis is neither $f(x)$ nor $-f(x)$ for all $x$, so $f$ is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-g88-93-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\tan x+\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Odd.",
          "worked": "$$\\begin{align*}f(-x)&=\\tan(-x)+\\sin(-x)\\\\f(-x)&=-\\tan x-\\sin x\\\\f(-x)&=-(\\tan x+\\sin x)\\\\f(-x)&=-f(x)\\end{align*}$$\nTangent and sine are odd, so $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-g88-93-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\dfrac{\\tan x-1}{\\tan x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p16-g88-93-e-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Neither.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p16-g88-93-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " throughout the quotient and use tangent’s odd identity.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}f(-x)&=\\frac{\\tan(-x)-1}{\\tan(-x)+1}\\\\f(-x)&=\\frac{-\\tan x-1}{-\\tan x+1}\\\\f(-x)&=\\frac{\\tan x+1}{\\tan x-1}\\end{align*}$$\nThis is neither $f(x)$ nor $-f(x)$ as an identity, so $f$ is neither even nor odd. Its natural domain is also not symmetric about $0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-g88-93-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\dfrac{1}{1+\\cos x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even.",
          "worked": "$$\\begin{align*}f(-x)&=\\frac{1}{1+\\cos(-x)}\\\\f(-x)&=\\frac{1}{1+\\cos x}\\\\f(-x)&=f(x)\\end{align*}$$\nCosine is even, so $f$ is even on its domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
