  "content": {
    "id": "p14-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Between three people, $\\$37$ is shared. The second person receives $\\$2$ less than the first person, and the third person receives three times as much as the second person. How much does each receive?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "First person: $\\$9$; second person: $\\$7$; third person: $\\$21$.",
      "worked": "Let the first person receive $x$ dollars. The second receives $x-2$ dollars and the third receives $3(x-2)$ dollars.\n$$\\begin{align*}x+(x-2)+3(x-2)&=37\\\\x+x-2+3x-6&=37\\\\5x-8&=37\\\\5x&=45\\\\x&=9\\end{align*}$$\nThe first person receives $\\$9$, the second receives $\\$7$, and the third receives $\\$21$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
