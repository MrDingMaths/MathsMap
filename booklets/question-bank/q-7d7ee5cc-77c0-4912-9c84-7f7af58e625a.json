  "content": {
    "id": "p4-q12",
    "type": "question",
    "label": "12",
    "prompt": "Let $f(x)=\\frac2x$. Simplify $f(x)\\div f\\left(\\frac1x\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac1{x^2}$, for $x\\ne0$.",
      "worked": "For $x\\ne0$,\n$$\\begin{align*}f\\left(\\frac1x\\right)&=\\frac2{1/x}\\\\f\\left(\\frac1x\\right)&=2x\\end{align*}$$\nHence,\n$$\\begin{align*}f(x)\\div f\\left(\\frac1x\\right)&=\\frac2x\\div2x\\\\f(x)\\div f\\left(\\frac1x\\right)&=\\frac2x\\times\\frac1{2x}\\\\f(x)\\div f\\left(\\frac1x\\right)&=\\frac1{x^2}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
