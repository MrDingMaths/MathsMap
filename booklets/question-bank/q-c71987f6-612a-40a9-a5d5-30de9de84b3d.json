      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down all the powers of $2$ from $2^0=1$ to $2^{12}=4096$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,2,4,8,16,32,64,128,256,512,1024,2048,4096$",
          "worked": "Start with $2^0=1$ and multiply each value by $2$ to obtain the next.\n$$\\begin{aligned}2^0&=1,&2^1&=2,&2^2&=4,\\\\2^3&=8,&2^4&=16,&2^5&=32,\\\\2^6&=64,&2^7&=128,&2^8&=256,\\\\2^9&=512,&2^{10}&=1024,&2^{11}&=2048,\\\\2^{12}&=4096.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q2-b",
        "type": "group",
        "label": "b",
        "prompt": "In the same way, write down:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q2-b-i",
            "type": "part",
            "label": "i",
            "prompt": "the powers of $3$ to $3^6=729$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1,3,9,27,81,243,729$",
              "worked": "Start with $3^0=1$ and multiply each value by $3$.\n$$\\begin{aligned}3^0&=1,&3^1&=3,\\\\3^2&=9,&3^3&=27,\\\\3^4&=81,&3^5&=243,\\\\3^6&=729.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p6-q2-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the powers of $5$ to $5^5=3125$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1,5,25,125,625,3125$",
              "worked": "Start with $5^0=1$ and multiply each value by $5$.\n$$\\begin{aligned}5^0&=1,&5^1&=5,\\\\5^2&=25,&5^3&=125,\\\\5^4&=625,&5^5&=3125.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p6-q2-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the powers of $6$ to $6^3=216$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1,6,36,216$",
              "worked": "Start with $6^0=1$ and multiply each value by $6$.\n$$\\begin{aligned}6^0&=1,&6^1&=6,\\\\6^2&=36,&6^3&=216.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p6-q2-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "the powers of $7$ to $7^3=343$",
            "layout": "list",
            "columns": null,
