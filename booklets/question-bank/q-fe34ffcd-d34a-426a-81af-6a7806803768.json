  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "If $f(x)=x^2$, state whether each statement is true or false.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q7-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p13-q7-a-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(5)=f(3)+f(4)",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "cloze",
                  "answer": "True",
                  "width": 18
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$f(5)=5^2=25$ and $f(3)+f(4)=3^2+4^2=9+16=25$.\n\nThe statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p13-q7-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p13-q7-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(4)=2f(3)-f(1)",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "cloze",
                  "answer": "False",
                  "width": 18
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$f(4)=4^2=16$ and $2f(3)-f(1)=2(3^2)-1^2=17$.\n\nSince $16\\ne17$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p13-q7-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p13-q7-c-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(x+y)=f(x)+f(y)",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "cloze",
                  "answer": "False",
                  "width": 18
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}f(x+y)&=(x+y)^2\\\\f(x+y)&=x^2+2xy+y^2\\\\f(x)+f(y)&=x^2+y^2\\end{align*}$$\nThese expressions are not equal in general. For example, $x=y=1$ gives $4\\ne2$. The statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p13-q7-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p13-q7-d-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(xy)=f(x)f(y)",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "cloze",
                  "answer": "True",
                  "width": 18
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}f(xy)&=(xy)^2\\\\f(xy)&=x^2y^2\\\\f(x)f(y)&=x^2y^2\\end{align*}$$\nBoth sides are equal, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p13-q7-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
