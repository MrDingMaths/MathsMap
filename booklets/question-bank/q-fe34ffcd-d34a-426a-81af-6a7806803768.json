              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "f(ax)=a^2f(x)",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "cloze",
                  "answer": "True",
                  "width": 18
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}f(ax)&=(ax)^2\\\\f(ax)&=a^2x^2\\\\a^2f(x)&=a^2x^2\\end{align*}$$\nBoth sides are equal, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p13-q7-f",
