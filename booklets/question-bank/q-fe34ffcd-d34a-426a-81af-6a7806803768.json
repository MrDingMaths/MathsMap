              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}f(a+b)-f(a)-f(b)&=(a+b)^2-a^2-b^2\\\\f(a+b)-f(a)-f(b)&=a^2+2ab+b^2-a^2-b^2\\\\f(a+b)-f(a)-f(b)&=2ab\\end{align*}$$\nThe statement is true.",
          "solutionDiagrams": []
