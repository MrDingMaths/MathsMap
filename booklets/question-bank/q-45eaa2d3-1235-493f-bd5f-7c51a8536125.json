      "taskHash": "37b4e4cfc5f1a5d2973bb75b170b39cd095f78511cf9a5f938f85672dbfaed70",
      "evidence": ".booklet-work/reasoning-ratings/calls/enrichment-maths-2-part5-20261009/5b4f59f3e2874a80d211b94df7d8fe259b63835f3a6c0495b82feb6854bd148d-1792558575248/last-message.txt"
    }
  },
  "content": {
    "id": "p6-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan\\theta\\cos\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\theta$",
          "worked": "$$\\begin{align*}\\tan\\theta\\cos\\theta&=\\frac{\\sin\\theta}{\\cos\\theta}\\cos\\theta\\\\\\tan\\theta\\cos\\theta&=\\sin\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cot\\theta\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta$",
          "worked": "$$\\begin{align*}\\cot\\theta\\sin\\theta&=\\frac{\\cos\\theta}{\\sin\\theta}\\sin\\theta\\\\\\cot\\theta\\sin\\theta&=\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\theta\\sec\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta$",
          "worked": "$$\\begin{align*}\\sin\\theta\\sec\\theta&=\\sin\\theta\\frac{1}{\\cos\\theta}\\\\\\sin\\theta\\sec\\theta&=\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\sin\\theta\\sec\\theta&=\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\csc\\theta\\cos\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\theta$",
          "worked": "$$\\begin{align*}\\csc\\theta\\cos\\theta&=\\frac{1}{\\sin\\theta}\\cos\\theta\\\\\\csc\\theta\\cos\\theta&=\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\csc\\theta\\cos\\theta&=\\cot\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\cot\\theta}{\\csc\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\cot\\theta}{\\csc\\theta}&=\\frac{\\cos\\theta}{\\sin\\theta}\\times\\sin\\theta\\\\\\frac{\\cot\\theta}{\\csc\\theta}&=\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\sec\\theta}{\\tan\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\csc\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\sec\\theta}{\\tan\\theta}&=\\frac{1}{\\cos\\theta}\\times\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\frac{\\sec\\theta}{\\tan\\theta}&=\\frac{1}{\\sin\\theta}\\\\\\frac{\\sec\\theta}{\\tan\\theta}&=\\csc\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p6-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\csc\\theta}{\\sec\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\csc\\theta}{\\sec\\theta}&=\\frac{1}{\\sin\\theta}\\times\\cos\\theta\\\\\\frac{\\csc\\theta}{\\sec\\theta}&=\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\frac{\\csc\\theta}{\\sec\\theta}&=\\cot\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p6-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\cos\\theta}{\\sin\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\theta$",
          "worked": "$$\\frac{\\cos\\theta}{\\sin\\theta}=\\cot\\theta$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
