    "children": [
      {
        "id": "p26-q5-response",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac4{x+1}+\\frac3{x-1}=\\frac2{x^2-1}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac37$",
          "worked": "The original denominators require $x\\ne-1,1$.\n\n$$\\begin{align*}\\frac{4(x-1)+3(x+1)}{(x+1)(x-1)}&=\\frac2{(x+1)(x-1)}\\\\4(x-1)+3(x+1)&=2\\\\7x-1&=2\\\\7x&=3\\\\x&=\\frac37\\end{align*}$$\n\nThis value is permitted.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p26-q6-response",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac5{x-2}-\\frac3{x+2}=\\frac{8x}{x^2-4}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac83$",
          "worked": "The original denominators require $x\\ne-2,2$.\n\n$$\\begin{align*}\\frac{5(x+2)-3(x-2)}{(x-2)(x+2)}&=\\frac{8x}{(x-2)(x+2)}\\\\5(x+2)-3(x-2)&=8x\\\\2x+16&=8x\\\\16&=6x\\\\x&=\\frac83\\end{align*}$$\n\nThis value is permitted.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p26-q7-response",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{x+1}{x^2-x}-\\frac2{x-1}=\\frac3x.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.\n\nClearing the denominators gives $x=1$, which makes an original denominator zero.",
          "worked": "The original denominators require $x\\ne0,1$.\n\n$$\\begin{align*}\\frac{x+1-2x}{x(x-1)}&=\\frac{3(x-1)}{x(x-1)}\\\\x+1-2x&=3(x-1)\\\\1-x&=3x-3\\\\4&=4x\\\\x&=1\\end{align*}$$\n\nSince $x=1$ is excluded, there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p26-q8-response",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac2{x+3}+\\frac4{x-3}=\\frac{5x+6}{x^2-9}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "The original denominators require $x\\ne-3,3$.\n\n$$\\begin{align*}\\frac{2(x-3)+4(x+3)}{(x+3)(x-3)}&=\\frac{5x+6}{(x+3)(x-3)}\\\\2(x-3)+4(x+3)&=5x+6\\\\6x+6&=5x+6\\\\x&=0\\end{align*}$$\n\nThis value is permitted.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
    ]
