    "questionDiagrams": [],
    "children": [
      {
        "id": "p101-q15-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p101-q15-a-prompt-1",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "It costs a family of two adults and three children $28 to go to a show.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p101-q15-a-prompt-2",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "If a child's ticket costs ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\frac{1}{2}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " of the price of an adult's ticket, find the cost of an adult's ticket.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$8",
          "worked": "Let $y$ be the child's ticket price in dollars. An adult's ticket costs $2y$ dollars.\n$$\\begin{align*}2(2y)+3y&=28\\\\7y&=28\\\\y&=4\\end{align*}$$\nThe child's ticket costs \\$4, so an adult's ticket costs \\$8.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p101-q15-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p101-q15-b-prompt-1",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "If the same family spent $68 to go to a concert and a child's ticket costs ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\frac{3}{4}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " of the price of an adult's ticket, find the price of a child's ticket.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$12",
          "worked": "Let $y$ be the adult ticket price in dollars. The child's ticket price is $\\frac{3}{4}y$ dollars. The family has two adults and three children.\n$$\\begin{align*}2y+3\\left(\\frac{3}{4}\\right)y&=68\\\\8y+9y&=4\\times68\\\\17y&=272\\\\y&=16\\\\\\frac{3}{4}y&=\\frac{3}{4}\\times16\\\\&=12\\end{align*}$$\nAn adult's ticket costs \\$16 and a child's ticket costs \\$12.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
