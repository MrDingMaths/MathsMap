    "id": "v2-da4e1-p18-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Find $f'(2)$ if $f(x)=\\ln\\sqrt[3]{4x+1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(2)=\\dfrac{4}{27}$.",
      "worked": "$$\\begin{align*}f(x)&=\\frac13\\ln(4x+1)\\\\f'(x)&=\\frac13\\left(\\frac{4}{4x+1}\\right)\\\\f'(x)&=\\frac{4}{3(4x+1)}\\\\f'(2)&=\\frac{4}{3(4(2)+1)}\\\\f'(2)&=\\frac{4}{27}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
  },
