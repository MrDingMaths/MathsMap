  "content": {
    "id": "p147-q16-root",
    "type": "question",
    "label": null,
    "prompt": "It takes 15 workers to complete a job in 20 days.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p147-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "How many days will it take 10 workers to complete the same job?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "30 days.",
          "worked": "Assume each worker maintains the same individual work rate. Let $t$ be the time in days and $w$ the number of workers. For the same job, $t=\\frac{k}{w}$.\n\n$$\\begin{align*}20 &= \\frac{k}{15}\\\\k &= 300\\\\t &= \\frac{300}{10}\\\\t &= 30\\end{align*}$$\n\nThe job takes 30 days.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p147-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "If it took 75 days to complete the job, how many workers were working on it?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 workers.",
          "worked": "Using $t=\\frac{300}{w}$ for the same job,\n\n$$\\begin{align*}75 &= \\frac{300}{w}\\\\w &= \\frac{300}{75}\\\\w &= 4\\end{align*}$$\n\nThere were 4 workers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
