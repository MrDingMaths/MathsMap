    "children": [
      {
        "id": "p38-q34",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin x+\\sqrt3\\cos x=R\\cos(x+\\alpha)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=2,\\quad\\alpha=\\frac{11\\pi}{6}$.",
          "worked": "$$R\\cos(x+\\alpha)=R\\cos\\alpha\\cos x-R\\sin\\alpha\\sin x.$$\nEquating coefficients gives\n$$\\begin{align*}R\\cos\\alpha&=\\sqrt3\\\\R\\sin\\alpha&=-1\\\\R&=\\sqrt{3+1}=2\\\\\\tan\\alpha&=-\\frac1{\\sqrt3}.\\end{align*}$$\nSince $\\cos\\alpha>0$ and $\\sin\\alpha<0$, $\\alpha$ is in the fourth quadrant. Hence $R=2$ and $\\alpha=\\frac{11\\pi}{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p38-q35",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt3\\sin x-3\\cos x=R\\cos(x+\\alpha)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=2\\sqrt3,\\quad\\alpha=\\frac{7\\pi}{6}$.",
          "worked": "$$R\\cos(x+\\alpha)=R\\cos\\alpha\\cos x-R\\sin\\alpha\\sin x.$$\nEquating coefficients gives\n$$\\begin{align*}R\\cos\\alpha&=-3\\\\R\\sin\\alpha&=-\\sqrt3\\\\R&=\\sqrt{9+3}=2\\sqrt3\\\\\\tan\\alpha&=\\frac1{\\sqrt3}.\\end{align*}$$\nSince $\\cos\\alpha<0$ and $\\sin\\alpha<0$, $\\alpha$ is in the third quadrant. Hence $R=2\\sqrt3$ and $\\alpha=\\frac{7\\pi}{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p38-q36",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin x-\\cos x=R\\cos(x+\\alpha)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=\\sqrt2,\\quad\\alpha=\\frac{5\\pi}{4}$.",
          "worked": "$$R\\cos(x+\\alpha)=R\\cos\\alpha\\cos x-R\\sin\\alpha\\sin x.$$\nEquating coefficients gives\n$$\\begin{align*}R\\cos\\alpha&=-1\\\\R\\sin\\alpha&=-1\\\\R&=\\sqrt{1+1}=\\sqrt2\\\\\\tan\\alpha&=1.\\end{align*}$$\nSince $\\cos\\alpha<0$ and $\\sin\\alpha<0$, $\\alpha$ is in the third quadrant. Hence $R=\\sqrt2$ and $\\alpha=\\frac{5\\pi}{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p38-q37",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt3\\cos x-\\sin x=R\\sin(x+\\alpha)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=2,\\quad\\alpha=\\frac{2\\pi}{3}$.",
          "worked": "$$R\\sin(x+\\alpha)=R\\cos\\alpha\\sin x+R\\sin\\alpha\\cos x.$$\nEquating coefficients gives\n$$\\begin{align*}R\\sin\\alpha&=\\sqrt3\\\\R\\cos\\alpha&=-1\\\\R&=\\sqrt{3+1}=2\\\\\\tan\\alpha&=-\\sqrt3.\\end{align*}$$\nSince $\\cos\\alpha<0$ and $\\sin\\alpha>0$, $\\alpha$ is in the second quadrant. Hence $R=2$ and $\\alpha=\\frac{2\\pi}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p38-q38",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt2\\cos x+\\sqrt2\\sin x=R\\sin(x-\\alpha)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=2,\\quad\\alpha=\\frac{7\\pi}{4}$.",
          "worked": "$$R\\sin(x-\\alpha)=R\\cos\\alpha\\sin x-R\\sin\\alpha\\cos x.$$\nEquating coefficients gives\n$$\\begin{align*}R\\cos\\alpha&=\\sqrt2\\\\R\\sin\\alpha&=-\\sqrt2\\\\R&=\\sqrt{2+2}=2\\\\\\tan\\alpha&=-1.\\end{align*}$$\nSince $\\cos\\alpha>0$ and $\\sin\\alpha<0$, $\\alpha$ is in the fourth quadrant. Hence $R=2$ and $\\alpha=\\frac{7\\pi}{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p38-q39",
        "type": "part",
        "label": "f",
        "prompt": "$-\\cos x-\\sin x=R\\sin(x+\\alpha)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=\\sqrt2,\\quad\\alpha=\\frac{5\\pi}{4}$.",
          "worked": "$$R\\sin(x+\\alpha)=R\\cos\\alpha\\sin x+R\\sin\\alpha\\cos x.$$\nEquating coefficients gives\n$$\\begin{align*}R\\sin\\alpha&=-1\\\\R\\cos\\alpha&=-1\\\\R&=\\sqrt{1+1}=\\sqrt2\\\\\\tan\\alpha&=1.\\end{align*}$$\nSince $\\cos\\alpha<0$ and $\\sin\\alpha<0$, $\\alpha$ is in the third quadrant. Hence $R=\\sqrt2$ and $\\alpha=\\frac{5\\pi}{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
