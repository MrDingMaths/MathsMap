  "content": {
    "id": "p31-stem69-74-root",
    "type": "question",
    "label": null,
    "prompt": "Solve the following for $0^\\circ\\leq\\theta\\leq360^\\circ$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q69",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\theta=\\cos25^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=65^\\circ,\\ 115^\\circ$.",
          "worked": "$$\\begin{align*}\\cos25^\\circ&=\\sin65^\\circ\\\\\\sin\\theta&=\\sin65^\\circ\\\\\\theta&=65^\\circ,\\ 180^\\circ-65^\\circ\\\\\\theta&=65^\\circ,\\ 115^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q70",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\theta=\\sin235^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=145^\\circ,\\ 215^\\circ$.",
          "worked": "$$\\begin{align*}\\sin235^\\circ&=-\\sin55^\\circ\\\\\\sin235^\\circ&=-\\cos35^\\circ\\\\\\cos\\theta&=-\\cos35^\\circ\\\\\\theta&=180^\\circ-35^\\circ,\\ 180^\\circ+35^\\circ\\\\\\theta&=145^\\circ,\\ 215^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p31-q71",
        "type": "part",
        "label": "c",
        "prompt": "$\\cot\\theta=\\tan80^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=10^\\circ,\\ 190^\\circ$.",
          "worked": "$$\\begin{align*}\\tan80^\\circ&=\\cot10^\\circ\\\\\\cot\\theta&=\\cot10^\\circ\\\\\\theta&=10^\\circ+180^\\circ n,\\quad n\\in\\mathbb Z\\\\\\theta&=10^\\circ,\\ 190^\\circ\\end{align*}$$\nBoth solutions have $\\sin\\theta\\ne0$, so cotangent is defined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p31-q72",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\theta+\\cos40^\\circ=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=230^\\circ,\\ 310^\\circ$.",
          "worked": "$$\\begin{align*}\\sin\\theta&=-\\cos40^\\circ\\\\\\sin\\theta&=-\\sin50^\\circ\\\\\\theta&=180^\\circ+50^\\circ,\\ 360^\\circ-50^\\circ\\\\\\theta&=230^\\circ,\\ 310^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q73",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos\\theta+\\sin50^\\circ=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=140^\\circ,\\ 220^\\circ$.",
          "worked": "$$\\begin{align*}\\cos\\theta&=-\\sin50^\\circ\\\\\\cos\\theta&=-\\cos40^\\circ\\\\\\theta&=180^\\circ-40^\\circ,\\ 180^\\circ+40^\\circ\\\\\\theta&=140^\\circ,\\ 220^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q74",
        "type": "part",
        "label": "f",
        "prompt": "$\\cot\\theta+\\tan200^\\circ=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=110^\\circ,\\ 290^\\circ$.",
          "worked": "$$\\begin{align*}\\tan200^\\circ&=\\tan20^\\circ\\\\\\cot\\theta&=-\\tan20^\\circ\\\\\\cot\\theta&=\\cot110^\\circ\\\\\\theta&=110^\\circ+180^\\circ n,\\quad n\\in\\mathbb Z\\\\\\theta&=110^\\circ,\\ 290^\\circ\\end{align*}$$\nBoth solutions have $\\sin\\theta\\ne0$, so cotangent is defined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
