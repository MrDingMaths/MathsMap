  "content": {
    "id": "p23-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A student walks from home to school at a speed of $3$ km/h. If she had walked at a speed of $5$ km/h, then she would have arrived $20$ minutes earlier. Find the distance from home to school.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{2}$ km",
      "worked": "Let $d$ km be the distance to school. The journey times are $\\frac{d}{3}$ h and $\\frac{d}{5}$ h, with a difference of $20$ minutes $=\\frac{1}{3}$ h.\n$$\\begin{align*}\\frac{d}{3}-\\frac{d}{5}&=\\frac{1}{3}\\\\5d-3d&=5\\\\2d&=5\\\\d&=\\frac{5}{2}\\end{align*}$$\nThe distance to school is $\\frac{5}{2}$ km.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
