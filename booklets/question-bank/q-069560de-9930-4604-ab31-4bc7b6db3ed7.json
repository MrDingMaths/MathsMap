  "content": {
    "id": "p18-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Find the specified terms in each expansion.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "For $(2+x)^7$, find the term in $x^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$672x^2$",
          "worked": "General term: $\\binom7r2^{7-r}x^r$.\nFor $x^2$, let $r=2$.\n$$\\begin{aligned}\\binom722^5x^2&=21(32)x^2\\\\&=672x^2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p18-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "For $\\left(x+\\frac y2\\right)^{14}$, find the term in $x^9y^5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1001x^9y^5}{16}$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\binom{14}r x^{14-r}\\left(\\frac y2\\right)^r\\\\&=\\binom{14}r\\left(\\frac12\\right)^r x^{14-r}y^r.\\end{aligned}$$\nFor $x^9y^5$, $14-r=9$, so $r=5$.\n$$\\begin{aligned}\\binom{14}5\\left(\\frac12\\right)^5x^9y^5&=\\frac{2002}{32}x^9y^5\\\\&=\\frac{1001x^9y^5}{16}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p18-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "For $\\left(\\frac x2-3y^2\\right)^{11}$, find the term in $x^{10}y^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{33x^{10}y^2}{1024}$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\binom{11}r\\left(\\frac x2\\right)^{11-r}(-3y^2)^r\\\\&=\\binom{11}r\\left(\\frac12\\right)^{11-r}(-3)^r x^{11-r}y^{2r}.\\end{aligned}$$\nFor $x^{10}y^2$, $11-r=10$ and $2r=2$, so $r=1$.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\binom{11}1\\left(\\frac12\\right)^{10}(-3)x^{10}y^2\\\\&=-\\frac{33x^{10}y^2}{1024}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p18-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "For $(a-\\sqrt b)^{20}$, find the term in $a^2b^9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$190a^2b^9$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\binom{20}r a^{20-r}(-b^{1/2})^r\\\\&=\\binom{20}r(-1)^r a^{20-r}b^{r/2}.\\end{aligned}$$\nFor $a^2b^9$, $20-r=2$ and $\\frac r2=9$, so $r=18$.\n$$\\begin{aligned}\\binom{20}{18}(-1)^{18}a^2b^9&=\\binom{20}{18}a^2b^9\\\\&=190a^2b^9.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
