  "content": {
    "id": "p34-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Find the largest positive decimal integer less than $10^6$ whose binary representation consists only of 1s.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$524287$.\n\nAn all-ones binary numeral with $n$ digits equals $2^n-1$; 19 digits fit below $10^6$, but 20 do not.",
      "worked": "An all-ones binary numeral with $n$ digits has value $N$:\n$$\\begin{align*}N&=1+2+2^2+\\cdots+2^{n-1}\\\\N&=2^n-1.\\end{align*}$$\nThe consecutive candidates around the bound are\n$$\\begin{align*}2^{19}-1&=524287<1000000,\\\\2^{20}-1&=1048575>1000000.\\end{align*}$$\nTherefore, the largest required integer is $524287$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
