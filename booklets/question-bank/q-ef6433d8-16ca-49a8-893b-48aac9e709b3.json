  "content": {
    "id": "p29-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The coordinates of the vertices of $\\triangle PQR$ are $P(1,-2)$, $Q(3,6)$ and $R(7,0)$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "the coordinates of $S$, the midpoint of $PQ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S(2,2)$",
          "worked": "$$\\begin{align*}S&=\\left(\\frac{1+3}{2},\\frac{-2+6}{2}\\right)\\\\S&=(2,2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "the gradient of $SR$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac25$",
          "worked": "$$\\begin{align*}m_{SR}&=\\frac{0-2}{7-2}\\\\m_{SR}&=-\\frac25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q14-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
