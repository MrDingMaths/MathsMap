    "label": "9",
    "prompt": "A club has 8 men and 10 women. How many ways can a team of 6 men and 6 women be chosen?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\binom{8}{6}\\binom{10}{6}=5880$",
      "worked": "Choose six of the eight men and six of the ten women. Multiply the counts for these independent selections.\n\n$$\\begin{align*}N&=\\binom{8}{6}\\binom{10}{6}\\\\N&=28\\times210\\\\N&=5880.\\end{align*}$$",
