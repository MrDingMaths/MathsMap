    "type": "question",
    "label": "1",
    "prompt": "Use the change-of-base formula, $\\log_a x=\\dfrac{\\log_{10}x}{\\log_{10}a}$, and your calculator, to verify that:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q1a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 8=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Verified: $\\log_2 8=3$.",
          "worked": "$$\\begin{align*}\\log_2 8&=\\frac{\\log_{10}8}{\\log_{10}2}\\\\\\log_2 8&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q1b",
        "type": "part",
