        "children": [],
        "answer": {
          "short": "$\\{1,2,3,5,6\\}$",
          "worked": "Combine the elements of both sets without repetition.\n$$A\\cup B=\\{1,2,3,5,6\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
