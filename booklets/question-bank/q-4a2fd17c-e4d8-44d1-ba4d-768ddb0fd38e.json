  "content": {
    "id": "p52-q27-root",
    "type": "question",
    "label": "9",
    "prompt": "Let the universal set $U=\\{0,1,2,3,4,5,6\\}$. Let $A=\\{1,2,5,6\\}$ and $B=\\{1,3,5\\}$. List the following.",
    "layout": "grid",
    "columns": 2,
