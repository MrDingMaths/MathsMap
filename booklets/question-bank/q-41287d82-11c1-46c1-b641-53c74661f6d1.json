  "content": {
    "id": "p38-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Show that the irrational numbers $\\mathbb R\\setminus\\mathbb Q$ are uncountable. Hint: Try a proof by contradiction.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\mathbb R\\setminus\\mathbb Q$ is uncountable.\n\nOtherwise its union with the countable set $\\mathbb Q$ would make $\\mathbb R$ countable, a contradiction.",
      "worked": "Suppose, for a contradiction, that $\\mathbb R\\setminus\\mathbb Q$ is countable. The rational numbers $\\mathbb Q$ are countable, and the union of two countable sets is countable. Hence\n$$\\mathbb R=\\mathbb Q\\cup(\\mathbb R\\setminus\\mathbb Q)$$\nwould be countable. This contradicts Cantor’s result that $\\mathbb R$ is uncountable. Therefore $\\mathbb R\\setminus\\mathbb Q$ is uncountable.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
