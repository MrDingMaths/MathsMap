  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "3",
    "prompt": "Write down the equation of the circles with the following features.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Centre $(0,0)$ and radius $2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=4$",
          "worked": "$$\\begin{align*}x^2+y^2&=2^2\\\\x^2+y^2&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Centre $(3,-2)$ and radius $2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2+(y+2)^2=4$",
          "worked": "$$\\begin{align*}(x-3)^2+(y-(-2))^2&=2^2\\\\(x-3)^2+(y+2)^2&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p10-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Centre $(-2,1)$ and radius $\\sqrt3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2+(y-1)^2=3$",
          "worked": "$$\\begin{align*}(x-(-2))^2+(y-1)^2&=(\\sqrt3)^2\\\\(x+2)^2+(y-1)^2&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p10-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Centre $(-1,1)$ and radius $\\frac14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2+(y-1)^2=\\frac1{16}$",
          "worked": "$$\\begin{align*}(x-(-1))^2+(y-1)^2&=\\left(\\frac14\\right)^2\\\\(x+1)^2+(y-1)^2&=\\frac1{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "Centre $(h,k)$ and radius $r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-h)^2+(y-k)^2=r^2$",
          "worked": "Substitute the centre $(h,k)$ and radius $r$ into the circle equation: $(x-h)^2+(y-k)^2=r^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p10-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "Centre $(-p,-q)$ and radius $2r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+p)^2+(y+q)^2=4r^2$",
          "worked": "$$\\begin{align*}(x-(-p))^2+(y-(-q))^2&=(2r)^2\\\\(x+p)^2+(y+q)^2&=4r^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
