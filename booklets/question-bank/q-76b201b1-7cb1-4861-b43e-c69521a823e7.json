    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the derivative of the inverse function $f^{-1}$ given $f(x)=4x^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f^{-1})'(x)=\\dfrac{1}{12}\\sqrt[3]{\\dfrac{16}{x^2}}$, $x\\ne0$.",
          "worked": "$$\\begin{aligned}f^{-1}(x)&=\\left(\\frac{x}{4}\\right)^{1/3}\\\\(f^{-1})'(x)&=\\frac13\\left(\\frac{x}{4}\\right)^{-2/3}\\cdot\\frac14\\\\&=\\frac{1}{12}\\sqrt[3]{\\frac{16}{x^2}},\\quad x\\ne0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p8-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "The point $(4,1)$ lies on $f^{-1}$. Find the gradient of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "the tangent",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac1{12}$",
              "worked": "$$\\begin{aligned}f'(x)&=12x^2\\\\m_{\\text{tangent}}&=\\frac{1}{f'(1)}\\\\&=\\frac1{12}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p8-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the normal at that point",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-12$",
              "worked": "$$\\begin{aligned}m_{\\text{normal}}&=-\\frac{1}{m_{\\text{tangent}}}\\\\&=-\\frac{1}{1/12}\\\\&=-12\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          }
        ]
      }
    ]
  },
