  "content": {
    "id": "p68-q2-7-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the exact values of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p68-q2-7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(90^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "At $90^\\circ$, the unit-circle point is $(0,1)$. Sine is the $y$-coordinate.\n\n$$\\sin 90^\\circ=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p68-q2-7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan(135^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "Tangent is negative in quadrant II.\n\n$$\\begin{align*}\\tan 135^\\circ&=-\\tan 45^\\circ\\\\\\tan 135^\\circ&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p68-q2-7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos(225^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{\\sqrt{2}}{2}$",
          "worked": "Cosine is negative in quadrant III.\n\n$$\\begin{align*}\\cos 225^\\circ&=-\\cos 45^\\circ\\\\\\cos 225^\\circ&=-\\frac{\\sqrt{2}}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p68-q2-7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin(180^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "At $180^\\circ$, the unit-circle point is $(-1,0)$. Sine is the $y$-coordinate.\n\n$$\\sin 180^\\circ=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p68-q2-7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos(360^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "At $360^\\circ$, the unit-circle point is $(1,0)$. Cosine is the $x$-coordinate.\n\n$$\\cos 360^\\circ=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p68-q2-7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan(240^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{3}$",
          "worked": "Tangent is positive in quadrant III.\n\n$$\\begin{align*}\\tan 240^\\circ&=\\tan 60^\\circ\\\\\\tan 240^\\circ&=\\sqrt{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
