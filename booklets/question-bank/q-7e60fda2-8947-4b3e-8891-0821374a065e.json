    "label": "9",
    "prompt": "Each exterior angle of a polygon measures $30^{\\circ}$. How many sides does the polygon have?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12 sides",
      "worked": "The exterior angles sum to $360^{\\circ}$.\n$$\\begin{align*}n&=\\frac{360^{\\circ}}{30^{\\circ}}\\\\n&=12\\end{align*}$$\nThe polygon has 12 sides.",
      "solutionDiagrams": []
