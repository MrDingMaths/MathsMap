  "content": {
    "id": "p33-q15",
    "type": "question",
    "label": "15",
    "prompt": "Factorise using surds, then simplify the surds.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2\\sqrt2)(x+2\\sqrt2)$",
          "worked": "$$\\begin{align*}x^2-8&=(x-\\sqrt8)(x+\\sqrt8)\\\\&=(x-\\sqrt{4\\times2})(x+\\sqrt{4\\times2})\\\\&=(x-2\\sqrt2)(x+2\\sqrt2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p33-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-45$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3\\sqrt5)(x+3\\sqrt5)$",
          "worked": "$$\\begin{align*}x^2-45&=(x-\\sqrt{45})(x+\\sqrt{45})\\\\&=(x-\\sqrt{9\\times5})(x+\\sqrt{9\\times5})\\\\&=(x-3\\sqrt5)(x+3\\sqrt5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
