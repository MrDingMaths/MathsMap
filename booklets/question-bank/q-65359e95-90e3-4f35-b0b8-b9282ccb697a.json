    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\sin\\theta=\\dfrac{3\\theta}{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\dfrac{200}{\\theta}$ and $\\sin\\theta=\\dfrac{150}{r}=\\dfrac{3\\theta}{4}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p13-q10-a-radius-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Arc length formula: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "l=r\\alpha",
                    "display": false
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}400&=r(2\\theta)\\\\r&=\\frac{200}{\\theta}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p13-q10-a-methods",
                "type": "layout",
                "arrangement": "parallel",
                "title": "",
                "border": false,
                "padding": 3,
                "margin": 3,
                "gap": 3,
                "columns": 2,
                "slots": [
                  {
                    "id": "p13-q10-a-method1-slot",
                    "blocks": [
                      {
                        "id": "p13-q10-a-method1",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Method 1: Sine rule with double-angle formula (extension students only)",
                            "marks": []
                          },
                          {
                            "type": "break"
                          },
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\frac{\\sin2\\theta}{300}&=\\frac{\\sin\\left(\\frac{\\pi-2\\theta}{2}\\right)}{r}\\\\\\frac{\\sin2\\theta}{300}&=\\frac{\\sin(\\frac{\\pi}{2}-\\theta)}{\\frac{200}{\\theta}}\\\\\\frac{2\\sin\\theta\\cos\\theta}{300}&=\\frac{\\cos\\theta}{\\frac{200}{\\theta}}\\\\\\frac{2\\sin\\theta}{300}&=\\frac{\\theta}{200}\\\\\\sin\\theta&=\\frac{3\\theta}{4}\\end{aligned}",
                            "display": true
                          },
                          {
                            "type": "break"
                          },
                          {
                            "type": "text",
                            "text": "The minor central angle is less than π, so 0 < θ < π/2 and cos θ is nonzero.",
                            "marks": []
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p13-q10-a-method2-slot",
                    "blocks": [
                      {
                        "id": "p13-q10-a-method2",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Method 2: Construct a right-angled triangle.",
                            "marks": []
                          },
                          {
                            "type": "break"
                          },
                          {
                            "type": "text",
                            "text": "Draw the perpendicular from O to the midpoint of AB. It bisects the chord and the central angle. Using right-angled trigonometry,",
                            "marks": []
                          },
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\sin\\theta&=\\frac{150}{r}\\\\\\sin\\theta&=\\frac{150}{\\frac{200}{\\theta}}\\\\\\sin\\theta&=\\frac{3\\theta}{4}\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
