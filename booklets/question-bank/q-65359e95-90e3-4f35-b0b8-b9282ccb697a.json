    "columns": null,
    "questionDiagrams": [
      {
        "id": "p13-q10-circle",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 13 p13-q10-circle\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (A) at (160:2.2);\n\\coordinate (B) at (60:2.2);\n\\draw[black,line width=0.8pt] (O) circle[radius=2.2];\n\\draw[black,line width=0.8pt] (A)--(O)--(B) (A)--(B);\n\\node[left] at (A) {$A$};\n\\node[above right] at (B) {$B$};\n\\node[below] at (O) {$O$};\n\\path (O)--(110:0.55) node {$2\\theta$};\n\\path (A)--(B) node[midway,above,sloped] {$300\\text{ m}$};\n\\path (110:2.2) node[above,rotate=20] {$400\\text{ m}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 39.8,
        "alt": "Mathematical diagram",
