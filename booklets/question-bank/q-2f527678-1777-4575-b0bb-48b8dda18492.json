        "prompt": "$$\\sin(180^\\circ-\\theta)\\cos(90^\\circ-\\theta)=\\sin^2\\theta$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sin\\theta\\sin\\theta=\\sin^2\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\sin\\theta\\times\\sin\\theta\\\\&=\\sin^2\\theta=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-5396d-p48-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{\\sin(180^\\circ-\\theta)}{\\cos(180^\\circ+\\theta)}=-\\tan\\theta$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sin\\theta}{-\\cos\\theta}=-\\tan\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sin\\theta}{-\\cos\\theta}\\\\&=-\\frac{\\sin\\theta}{\\cos\\theta}\\\\&=-\\tan\\theta=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
