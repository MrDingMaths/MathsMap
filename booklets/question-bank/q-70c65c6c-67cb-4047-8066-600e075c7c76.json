  "content": {
    "id": "p28-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A tree, whose original foliage was estimated to have a mass of $1500\\text{ kg}$, lost $20\\%$ of its foliage in a storm, then lost $15\\%$ of what was left in a storm the next day, then lost $40\\%$ of what was left in a third storm. Estimate the remaining mass of foliage.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$612\\text{ kg}$",
      "worked": "The fractions remaining after the storms are $0.80$, $0.85$ and $0.60$.\n\n$$\\begin{align*}\\text{Remaining mass}&=1500\\times0.80\\times0.85\\times0.60\\\\\\text{Remaining mass}&=612\\text{ kg}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
