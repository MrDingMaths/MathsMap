  "content": {
    "id": "v2-5021a0-p9-practice-slot-4-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A cube-shaped box with side length 30 cm is covered in paper.\n\nWhat area of paper is needed to cover 20 boxes? Convert your answer to $\\mathrm{m}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10.8\\,\\mathrm{m}^2$",
      "worked": "Surface area of one box:\n\n$$\\begin{align*}A&=6\\times30^2\\\\A&=5400\\,\\mathrm{cm}^2\\end{align*}$$\n\nArea for 20 boxes:\n\n$$\\begin{align*}A_{20}&=5400\\times20\\\\A_{20}&=108\\,000\\,\\mathrm{cm}^2\\\\A_{20}&=\\frac{108\\,000}{100^2}\\,\\mathrm{m}^2\\\\A_{20}&=10.8\\,\\mathrm{m}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
