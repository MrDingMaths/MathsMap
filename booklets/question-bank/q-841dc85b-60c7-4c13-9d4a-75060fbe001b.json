      {
        "id": "p18-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the tangent to $y=\\log_{10}x$ at $(10,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-10y\\ln 10+10(\\ln 10-1)=0$.",
          "worked": "$$\\begin{align*}y'&=\\frac{1}{x\\ln 10}\\\\y'(10)&=\\frac{1}{10\\ln 10}\\end{align*}$$\nThe point is $(10,1)$.\n$$\\begin{align*}y-1&=\\frac{1}{10\\ln 10}(x-10)\\\\10\\ln 10(y-1)&=x-10\\\\x-10y\\ln 10-10+10\\ln 10&=0\\\\x-10y\\ln 10+10(\\ln 10-1)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p18-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "At what value of $x$ will the tangent have gradient $1$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{1}{\\ln 10}$.",
          "worked": "$$\\begin{align*}\\frac{1}{x\\ln 10}&=1\\\\x\\ln 10&=1\\\\x&=\\frac{1}{\\ln 10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
