  "content": {
    "id": "v2-331c2d056-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $f(x)=4x^2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-331c2d056-practice-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(-2)=16$ and $f(-2+h)=16-16h+4h^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-2)=4(-2)^2=16$ and $f(-2+h)=4(4-4h+h^2)=16-16h+4h^2$.",
          "worked": "$$\\begin{align*}f(-2)&=4(-2)^2\\\\f(-2)&=16\\end{align*}$$\n$$\\begin{align*}f(-2+h)&=4(-2+h)^2\\\\f(-2+h)&=4(4-4h+h^2)\\\\f(-2+h)&=16-16h+4h^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-331c2d056-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\dfrac{f(-2+h)-f(-2)}{h}=-16+4h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{f(-2+h)-f(-2)}{h}=\\dfrac{-16h+4h^2}{h}=-16+4h$, for $h\\ne0$.",
          "worked": "For $h\\ne0$,\n$$\\begin{align*}\\frac{f(-2+h)-f(-2)}{h}&=\\frac{16-16h+4h^2-16}{h}\\\\\\frac{f(-2+h)-f(-2)}{h}&=\\frac{h(-16+4h)}{h}\\\\\\frac{f(-2+h)-f(-2)}{h}&=-16+4h.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-331c2d056-practice-slot-4-slot-4-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Take the limit as $h\\to0$ to show that $f'(-2)=-16$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(-2)=\\lim_{h\\to0}(-16+4h)=-16$.",
          "worked": "$$\\begin{align*}f'(-2)&=\\lim_{h\\to0}\\frac{f(-2+h)-f(-2)}{h}\\\\f'(-2)&=\\lim_{h\\to0}(-16+4h)\\\\f'(-2)&=-16.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
