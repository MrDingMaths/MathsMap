    "label": "10",
    "prompt": "Simplify $\\tan(-\\alpha)-\\tan(\\alpha)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-2\\tan\\alpha$",
      "worked": "Since tangent is odd, $\\tan(-\\alpha)=-\\tan\\alpha$.\n$$\\begin{align*}\\tan(-\\alpha)-\\tan(\\alpha)&=-\\tan\\alpha-\\tan\\alpha\\\\\\tan(-\\alpha)-\\tan(\\alpha)&=-2\\tan\\alpha\\end{align*}$$",
      "solutionDiagrams": []
    },
