  "content": {
    "id": "p32-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "How many integers from 1 to 120 are multiples of 2 or 3?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$80$",
      "worked": "Let $A$ and $B$ be the sets of multiples of 2 and 3, respectively, from 1 to 120. Their intersection consists of multiples of 6.\n$$\\begin{align*}|A|&=120\\div2=60\\\\|B|&=120\\div3=40\\\\|A\\cap B|&=120\\div6=20\\\\|A\\cup B|&=|A|+|B|-|A\\cap B|\\\\|A\\cup B|&=60+40-20\\\\|A\\cup B|&=80\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
