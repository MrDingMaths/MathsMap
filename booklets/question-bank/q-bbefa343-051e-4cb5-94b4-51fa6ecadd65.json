    "children": [
      {
        "id": "p25-q6a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^{1/6}\\frac{1}{\\sqrt{1-9x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\pi}{18}$",
          "worked": "$$\\begin{aligned}\\int_0^{1/6}\\frac{1}{\\sqrt{1-9x^2}}\\,dx&=\\frac13\\int_0^{1/6}\\frac{3}{\\sqrt{1-(3x)^2}}\\,dx\\\\&=\\left[\\frac13\\sin^{-1}(3x)\\right]_0^{1/6}\\\\&=\\frac13\\left(\\sin^{-1}\\frac12-\\sin^{-1}0\\right)\\\\&=\\frac13\\left(\\frac{\\pi}{6}-0\\right)\\\\&=\\frac{\\pi}{18}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p25-q6b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_{1/2}^{\\sqrt3/2}\\frac{2}{1+4x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\pi}{12}$",
          "worked": "$$\\begin{aligned}\\int_{1/2}^{\\sqrt3/2}\\frac{2}{1+4x^2}\\,dx&=\\left[\\tan^{-1}(2x)\\right]_{1/2}^{\\sqrt3/2}\\\\&=\\tan^{-1}(\\sqrt3)-\\tan^{-1}(1)\\\\&=\\frac{\\pi}{3}-\\frac{\\pi}{4}\\\\&=\\frac{\\pi}{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q6c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-3x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\pi\\sqrt3}{9}$",
          "worked": "$$\\begin{aligned}\\int_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-3x^2}}\\,dx&=\\frac1{\\sqrt3}\\int_{-1/2}^{1/2}\\frac{\\sqrt3}{\\sqrt{1-(\\sqrt3x)^2}}\\,dx\\\\&=\\left[\\frac1{\\sqrt3}\\sin^{-1}(\\sqrt3x)\\right]_{-1/2}^{1/2}\\\\&=\\frac1{\\sqrt3}\\left(\\sin^{-1}\\frac{\\sqrt3}{2}-\\sin^{-1}\\frac{-\\sqrt3}{2}\\right)\\\\&=\\frac1{\\sqrt3}\\left(\\frac{\\pi}{3}-\\left(-\\frac{\\pi}{3}\\right)\\right)\\\\&=\\frac{2\\pi}{3\\sqrt3}\\\\&=\\frac{2\\pi\\sqrt3}{9}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
