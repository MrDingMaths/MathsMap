  "content": {
    "id": "p3-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Let $a$, $b$ and $c$ be positive integers. Simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^a\\times2^a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{2a}$",
          "worked": "$$\\begin{align*}2^a\\times2^a&=2^{a+a}\\\\2^a\\times2^a&=2^{2a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^a\\times3^a\\times3^a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{3a}$",
          "worked": "$$\\begin{align*}3^a\\times3^a\\times3^a&=3^{a+a+a}\\\\3^a\\times3^a\\times3^a&=3^{3a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{5^{2a}}{5^a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^a$",
          "worked": "$$\\begin{align*}\\frac{5^{2a}}{5^a}&=5^{2a-a}\\\\\\frac{5^{2a}}{5^a}&=5^a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{7^a\\times7^{2a}}{7^a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{2a}$",
          "worked": "$$\\begin{align*}\\frac{7^a\\times7^{2a}}{7^a}&=7^{a+2a-a}\\\\\\frac{7^a\\times7^{2a}}{7^a}&=7^{2a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2^a)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{2a}$",
          "worked": "$$\\begin{align*}(2^a)^2&=2^{a\\times2}\\\\(2^a)^2&=2^{2a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$((5^a)^b)^c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{abc}$",
          "worked": "$$\\begin{align*}((5^a)^b)^c&=(5^{ab})^c\\\\((5^a)^b)^c&=5^{abc}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$7\\times(7^a)^b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{ab+1}$",
          "worked": "$$\\begin{align*}7\\times(7^a)^b&=7^1\\times7^{ab}\\\\7\\times(7^a)^b&=7^{ab+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$(3^a\\times3^a)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{4a}$",
          "worked": "$$\\begin{align*}(3^a\\times3^a)^2&=(3^{2a})^2\\\\(3^a\\times3^a)^2&=3^{4a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$(2^a\\times2^b)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{2a+2b}$",
          "worked": "$$\\begin{align*}(2^a\\times2^b)^2&=(2^{a+b})^2\\\\(2^a\\times2^b)^2&=2^{2(a+b)}\\\\(2^a\\times2^b)^2&=2^{2a+2b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\left(\\dfrac{5^a}{5^b}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{2a-2b}$",
          "worked": "$$\\begin{align*}\\left(\\frac{5^a}{5^b}\\right)^2&=(5^{a-b})^2\\\\\\left(\\frac{5^a}{5^b}\\right)^2&=5^{2(a-b)}\\\\\\left(\\frac{5^a}{5^b}\\right)^2&=5^{2a-2b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q7-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\left(\\dfrac{3^a}{3}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{3a-3}$",
          "worked": "$$\\begin{align*}\\left(\\frac{3^a}{3}\\right)^3&=(3^{a-1})^3\\\\\\left(\\frac{3^a}{3}\\right)^3&=3^{3(a-1)}\\\\\\left(\\frac{3^a}{3}\\right)^3&=3^{3a-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q7-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\left(\\dfrac{7^a\\times7^b}{7^c}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{2a+2b-2c}$",
          "worked": "$$\\begin{align*}\\left(\\frac{7^a\\times7^b}{7^c}\\right)^2&=(7^{a+b-c})^2\\\\\\left(\\frac{7^a\\times7^b}{7^c}\\right)^2&=7^{2(a+b-c)}\\\\\\left(\\frac{7^a\\times7^b}{7^c}\\right)^2&=7^{2a+2b-2c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
