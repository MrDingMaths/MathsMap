  "content": {
    "id": "p45-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find each indefinite integral using the given substitution. Assume $u\\geq0$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int 3x\\sqrt{4x-5}\\,dx$, using $x=\\frac14(u^2+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{3}{40}(4x-5)^{5/2}+\\frac58(4x-5)^{3/2}+C$",
          "worked": "$x=\\frac14(u^2+5)$, so $dx=\\frac u2\\,du$ and $\\sqrt{4x-5}=u$. Therefore\n$$\\begin{aligned}\\int 3x\\sqrt{4x-5}\\,dx&=\\int\\frac34(u^2+5)u\\frac u2\\,du\\\\&=\\frac38\\int(u^4+5u^2)\\,du\\\\&=\\frac38\\left(\\frac{u^5}{5}+\\frac{5u^3}{3}\\right)+C\\\\&=\\frac{3u^5}{40}+\\frac{5u^3}{8}+C\\\\&=\\frac{3}{40}(4x-5)^{5/2}+\\frac58(4x-5)^{3/2}+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p45-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{1}{1+\\sqrt{x}}\\,dx$, using $x=(u-1)^2$, with $u\\geq1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(1+\\sqrt{x})-2\\ln(1+\\sqrt{x})+C$",
          "worked": "Choose $u=1+\\sqrt{x}\\geq1$, so $\\sqrt{x}=u-1$ and $dx=2(u-1)\\,du$.\n$$\\begin{aligned}\\int\\frac{1}{1+\\sqrt{x}}\\,dx&=\\int\\frac{2(u-1)}u\\,du\\\\&=2\\int\\left(1-\\frac1u\\right)\\,du\\\\&=2u-2\\ln u+C\\\\&=2(1+\\sqrt{x})-2\\ln(1+\\sqrt{x})+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
