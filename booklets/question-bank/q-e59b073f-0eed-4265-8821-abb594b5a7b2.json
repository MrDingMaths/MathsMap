    "type": "question",
    "label": null,
    "prompt": "Hamish sells furniture. His commission is based on a sliding scale of 4% on the first \\$3000 of his sales, 5.5% on the next \\$2000, and 7% thereafter.\nWhat is Hamish’s commission when his total sales are \\$8400?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$468: \\$120 + \\$110 + \\$238.",
      "worked": "$$\\begin{align*}\\text{Remaining sales}&=8400-3000-2000\\\\&=\\$3400\\\\\\text{Commission}&=0.04\\times3000+0.055\\times2000+0.07\\times3400\\\\&=120+110+238\\\\&=\\$468\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
