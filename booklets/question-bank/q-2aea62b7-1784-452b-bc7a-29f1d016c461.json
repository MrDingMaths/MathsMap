  "content": {
    "id": "v2-11f0f-p40-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "The parabola $y=x^2-2x-3$ and the line $y=x+1$ intersect at points $A$ and $B$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-11f0f-p40-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,0)$ and $(4,5)$",
          "worked": "$$\\begin{align*}x^2-2x-3&=x+1\\\\x^2-3x-4&=0\\\\(x-4)(x+1)&=0\\\\x&=4\\text{ or }-1\\end{align*}$$\nFor $x=-1$, $y=-1+1=0$. For $x=4$, $y=4+1=5$.\nThe points are $A(-1,0)$ and $B(4,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-11f0f-p40-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The vertical line $x=k$ lies between $A$ and $B$. It meets the parabola at $P$ and the line at $Q$. Find the possible values of $k$ if $PQ=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=0$ or $k=3$",
          "worked": "On $x=k$: $P$ has $y=k^2-2k-3$ and $Q$ has $y=k+1$.\nBetween $A$ and $B$ the line is above the parabola, so\n$$\\begin{align*}PQ&=(k+1)-(k^2-2k-3)\\\\PQ&=-k^2+3k+4\\end{align*}$$\n$$\\begin{align*}-k^2+3k+4&=4\\\\k^2-3k&=0\\\\k(k-3)&=0\\\\k&=0\\text{ or }3\\end{align*}$$\nBoth values lie between $-1$ and $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
