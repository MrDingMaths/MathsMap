    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{3}+\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\sqrt{3}+\\sqrt{3}&=(1+1)\\sqrt{3}\\\\\\sqrt{3}+\\sqrt{3}&=2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\sqrt{7}-3\\sqrt{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{7}$",
          "worked": "$$\\begin{align*}5\\sqrt{7}-3\\sqrt{7}&=(5-3)\\sqrt{7}\\\\5\\sqrt{7}-3\\sqrt{7}&=2\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sqrt{5}-\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{5}$",
          "worked": "$$\\begin{align*}2\\sqrt{5}-\\sqrt{5}&=(2-1)\\sqrt{5}\\\\2\\sqrt{5}-\\sqrt{5}&=\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$-3\\sqrt{2}+\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\sqrt{2}$",
          "worked": "$$\\begin{align*}-3\\sqrt{2}+\\sqrt{2}&=(-3+1)\\sqrt{2}\\\\-3\\sqrt{2}+\\sqrt{2}&=-2\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$4\\sqrt{3}+3\\sqrt{2}-2\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{3}+3\\sqrt{2}$",
          "worked": "$$\\begin{align*}4\\sqrt{3}+3\\sqrt{2}-2\\sqrt{3}&=(4-2)\\sqrt{3}+3\\sqrt{2}\\\\4\\sqrt{3}+3\\sqrt{2}-2\\sqrt{3}&=2\\sqrt{3}+3\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$-5\\sqrt{5}-2\\sqrt{7}+6\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{5}-2\\sqrt{7}$",
          "worked": "$$\\begin{align*}-5\\sqrt{5}-2\\sqrt{7}+6\\sqrt{5}&=(-5+6)\\sqrt{5}-2\\sqrt{7}\\\\-5\\sqrt{5}-2\\sqrt{7}+6\\sqrt{5}&=\\sqrt{5}-2\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$7\\sqrt{6}+5\\sqrt{3}-4\\sqrt{6}-7\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{6}-2\\sqrt{3}$",
          "worked": "$$\\begin{align*}7\\sqrt{6}+5\\sqrt{3}-4\\sqrt{6}-7\\sqrt{3}&=(7-4)\\sqrt{6}+(5-7)\\sqrt{3}\\\\7\\sqrt{6}+5\\sqrt{3}-4\\sqrt{6}-7\\sqrt{3}&=3\\sqrt{6}-2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$-6\\sqrt{2}-4\\sqrt{5}+3\\sqrt{2}-2\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\sqrt{2}-6\\sqrt{5}$",
          "worked": "$$\\begin{align*}-6\\sqrt{2}-4\\sqrt{5}+3\\sqrt{2}-2\\sqrt{5}&=(-6+3)\\sqrt{2}+(-4-2)\\sqrt{5}\\\\-6\\sqrt{2}-4\\sqrt{5}+3\\sqrt{2}-2\\sqrt{5}&=-3\\sqrt{2}-6\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$3\\sqrt{10}-8\\sqrt{5}-7\\sqrt{10}+10\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4\\sqrt{10}+2\\sqrt{5}$",
          "worked": "$$\\begin{align*}3\\sqrt{10}-8\\sqrt{5}-7\\sqrt{10}+10\\sqrt{5}&=(3-7)\\sqrt{10}+(-8+10)\\sqrt{5}\\\\3\\sqrt{10}-8\\sqrt{5}-7\\sqrt{10}+10\\sqrt{5}&=-4\\sqrt{10}+2\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
