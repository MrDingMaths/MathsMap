          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$\\begin{align*}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{0-4}{5-1}\\\\m&=\\frac{-4}{4}\\\\m&=-1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(-2,-7),\\ B(3,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$\\begin{align*}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{3-(-7)}{3-(-2)}\\\\m&=\\frac{10}{5}\\\\m&=2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(-5,-2),\\ B(3,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$\\begin{align*}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{2-(-2)}{3-(-5)}\\\\m&=\\frac48\\\\m&=\\frac12\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(3,6),\\ B(5,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12$",
          "worked": "$\\begin{align*}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{5-6}{5-3}\\\\m&=\\frac{-1}{2}\\\\m&=-\\frac12\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$A(-1,-2),\\ B(1,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$\\begin{align*}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{4-(-2)}{1-(-1)}\\\\m&=\\frac62\\\\m&=3\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$A(-5,7),\\ B(15,-7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac7{10}$",
          "worked": "$\\begin{align*}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{-7-7}{15-(-5)}\\\\m&=\\frac{-14}{20}\\\\m&=-\\frac7{10}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
