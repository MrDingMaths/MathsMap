                  "latex": "A(1,4),\\ B(5,0)",
                  "display": false
                }
              ]
            },
            {
              "id": "p9-q1-a-formula",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 3,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "m=\\frac{y_2-y_1}{x_2-x_1}",
                  "display": false
                }
              ]
            },
            {
              "id": "p9-q1-a-substitution",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 3,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\phantom{m}=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$\\frac{0-4}{5-1}$",
                  "width": 22
                }
              ]
            },
            {
              "id": "p9-q1-a-result",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 3,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\phantom{m}=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$-1$",
                  "width": 11
