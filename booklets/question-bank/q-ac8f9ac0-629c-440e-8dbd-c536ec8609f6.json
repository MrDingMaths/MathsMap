              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "Q(x)=x^4-a_1x^3+a_2x^2-a_3x+a_4,",
                  "display": false
                }
              ]
            },
            {
              "id": "p47-q73-d-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "with roots ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\alpha,\\beta,\\gamma,\\delta",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "s_k=\\alpha^k+\\beta^k+\\gamma^k+\\delta^k",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", find similar expressions for ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "s_1,s_2,s_3",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and ",
