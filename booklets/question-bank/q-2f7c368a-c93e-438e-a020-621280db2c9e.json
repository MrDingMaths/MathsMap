  "content": {
    "id": "p28-q19",
    "type": "question",
    "label": "19",
    "prompt": "The amount of arable land in a region is decreasing by 6% p.a. due to the encroachment of desert and soil erosion. If the arable area is currently 2 million hectares, what will it be in 20 years’ time? Give your answer to the nearest 1000 hectares.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$580\\,000$ hectares.",
      "worked": "$$\\begin{align*}A &= A_0(1-r)^n\\\\A &= 2\\,000\\,000(1-0.06)^{20}\\\\A &= 2\\,000\\,000(0.94)^{20}\\\\A &\\approx 580\\,000\\text{ ha}\\end{align*}$$\nTo the nearest 1000 hectares.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
