        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "63.4",
          "worked": "$$\\begin{align*}\\text{Total}&=46+55+44+62+75+83+75+68+49+59+72+75+61\\\\\\text{Total}&=824\\\\\\text{Mean}&=\\frac{824}{13}\\\\\\text{Mean}&\\approx63.4\\quad\\text{(1 decimal place)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p13-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "If Ken does one more test and raises his average to 64, what was his mark on that test?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "72",
          "worked": "There will be 14 test results. Use the exact total from the first 13 tests.\n$$\\begin{align*}\\text{Required total}&=14\\times64\\\\\\text{Required total}&=896\\\\\\text{New mark}&=896-824\\\\\\text{New mark}&=72\\end{align*}$$",
