  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The weights of a group of students, in kilograms, are given below.\n\n$47,\\ 46,\\ 45,\\ 46,\\ 42,\\ 41,\\ 45,\\ 41,\\ 49,\\ 46,\\ 42,\\ 43$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the median?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45\\text{ kg}$",
          "worked": "In ascending order:\n\n$41,\\ 41,\\ 42,\\ 42,\\ 43,\\ 45,\\ 45,\\ 46,\\ 46,\\ 46,\\ 47,\\ 49$\n\nThere are 12 values, so use the average of the sixth and seventh values.\n\n$$\\begin{align*}\\text{Median}&=\\frac{45+45}{2}\\\\\\text{Median}&=45\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the mean, correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$44.42\\text{ kg}$",
          "worked": "$$\\begin{align*}\\text{Sum}&=47+46+45+46+42+41+45+41+49+46+42+43\\\\\\text{Sum}&=533\\\\\\text{Mean}&=\\frac{533}{12}\\text{ kg}\\\\\\text{Mean}&\\approx44.42\\text{ kg}\\end{align*}$$\n\nThe mean is $44.42\\text{ kg}$, correct to two decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
