  "content": {
    "id": "v2-a4943-p66-practice-slot-12-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A circular pond of radius $r$ metres is surrounded by a path 3 metres wide.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "v2-a4943-p66-practice-slot-12-lower-slot-12-lower-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"ringFill\",\"hex\":\"D4E8FF\",\"reason\":\"The shaded path is the region between the two circles\"}],\"reference\":\"Slot 12 annulus draft, 10 November 2026\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,font=\\fontsize{10}{12}\\selectfont]\n\\definecolor{ringFill}{HTML}{D4E8FF}\n\\path[fill=ringFill,even odd rule] (0,0) circle[radius=2.4] (0,0) circle[radius=1.4];\n\\draw[black,line width=0.8pt] (0,0) circle[radius=2.4];\n\\draw[black,line width=0.8pt] (0,0) circle[radius=1.4];\n\\fill[black] (0,0) circle[radius=0.04];\n\\draw[black,line width=0.6pt] (0,0)--(130:1.4) node[midway,left=1pt] {$r$};\n\\draw[black,line width=0.6pt,|-|] (1.4,0)--(2.4,0) node[midway,below=2pt] {$3$ m};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 50,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": false
      }
    ],
    "children": [
      {
        "id": "v2-a4943-p66-practice-slot-12-lower-slot-12-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of the path, in terms of $\\pi$ and $r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pi(6r+9)$ m$^2$",
          "worked": "$$\\begin{align*}A&=\\pi(r+3)^2-\\pi r^2\\\\&=\\pi(r^2+6r+9-r^2)\\\\&=\\pi(6r+9)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-a4943-p66-practice-slot-12-lower-slot-12-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "Write the area of the path divided by the length of its outer edge in the form $a+\\dfrac{b}{2r+6}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-\\dfrac{9}{2r+6}$",
          "worked": "The outer edge has length $2\\pi(r+3)=\\pi(2r+6)$.\n$$\\begin{align*}\\frac{\\pi(6r+9)}{\\pi(2r+6)}&=\\frac{6r+9}{2r+6}\\\\&=\\frac{3(2r+6)-9}{2r+6}\\\\&=\\frac{3(2r+6)}{2r+6}-\\frac{9}{2r+6}\\\\&=3-\\frac{9}{2r+6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
