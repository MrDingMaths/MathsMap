  "content": {
    "id": "p10-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A rectangular prism has a surface area of $550\\text{ cm}^2$. If its length is $15\\text{ cm}$ and its width is $10\\text{ cm}$, calculate the height of the rectangular prism.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5\\text{ cm}$",
      "worked": "Let the height be $h$ centimetres. Add the areas of the three pairs of opposite faces.\n\n$$\\begin{align*}2(15\\times10)+2(15h)+2(10h)&=550\\\\300+50h&=550\\\\50h&=250\\\\h&=5\\end{align*}$$\n\nThe height is $5\\text{ cm}$.",
      "solutionDiagrams": []
    },
