  "content": {
    "id": "p32-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A rectangle has dimension $10\\text{ cm}\\times20\\text{ cm}$. Find the volume of the cylinder that is formed when the two longer sides are pasted together and its two circular ends are capped.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
