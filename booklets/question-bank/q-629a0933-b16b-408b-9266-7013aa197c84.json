  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A triangle has an area of $24\\text{ cm}^2$ and height $2\\text{ cm}$ less than its base.\nFind the height and base lengths.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Height $6\\text{ cm}$; base $8\\text{ cm}$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "92bfeb03-0fe7-4886-b073-d56c0d1174ec-compact-0",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x\\text{ cm}",
                "display": false
              },
              {
                "type": "text",
                "text": " be the base, so the height is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(x-2)\\text{ cm}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "92bfeb03-0fe7-4886-b073-d56c0d1174ec-compact-1",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\frac12 x(x-2)&=24\\\\x(x-2)&=48\\\\x^2-2x-48&=0\\\\(x-8)(x+6)&=0\\\\x&=8\\text{ or }-6\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "92bfeb03-0fe7-4886-b073-d56c0d1174ec-compact-2",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Reject ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=-6",
                "display": false
              },
              {
                "type": "text",
                "text": " because the base must be positive. The base is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "8\\text{ cm}",
                "display": false
              },
              {
                "type": "text",
                "text": " and the height is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "8-2=6\\text{ cm}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "92bfeb03-0fe7-4886-b073-d56c0d1174ec-compact-3",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Check: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac12\\times8\\times6=24\\text{ cm}^2",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
