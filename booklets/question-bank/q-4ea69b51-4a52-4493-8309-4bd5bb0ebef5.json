  "content": {
    "id": "p63-q36-root",
    "type": "question",
    "label": "36",
    "prompt": "Consider the function $f(x)=\\dfrac{x^2}{x-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p63-q36-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(x)=x+1+\\dfrac{1}{x-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x+1+\\dfrac{1}{x-1}$.",
          "worked": "$$\\begin{align*}f(x)&=\\frac{x^2-1+1}{x-1}\\\\&=\\frac{x^2-1}{x-1}+\\frac{1}{x-1}\\\\&=\\frac{(x-1)(x+1)}{x-1}+\\frac{1}{x-1}\\\\&=x+1+\\frac{1}{x-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p63-q36-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, differentiate $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=1-\\dfrac{1}{(x-1)^2}$.",
          "worked": "$$\\begin{align*}f(x)&=x+1+(x-1)^{-1}\\\\f'(x)&=1-(x-1)^{-2}\\times1\\\\&=1-\\frac{1}{(x-1)^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
