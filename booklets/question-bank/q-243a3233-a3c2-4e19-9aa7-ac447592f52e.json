  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Suppose $\\sin\\theta=0.7$. Find each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.7$",
          "worked": "$$\\begin{align*}\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)&=\\sin\\theta\\\\\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)&=0.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\left(\\frac{\\pi}{2}+\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.7$",
          "worked": "$$\\begin{align*}\\cos\\left(\\frac{\\pi}{2}+\\theta\\right)&=-\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)\\\\\\cos\\left(\\frac{\\pi}{2}+\\theta\\right)&=-\\sin\\theta\\\\\\cos\\left(\\frac{\\pi}{2}+\\theta\\right)&=-0.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos\\left(\\frac{3\\pi}{2}+\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.7$",
          "worked": "$$\\begin{align*}\\cos\\left(\\frac{3\\pi}{2}+\\theta\\right)&=-\\cos\\left(\\frac{\\pi}{2}+\\theta\\right)\\\\\\cos\\left(\\frac{3\\pi}{2}+\\theta\\right)&=\\sin\\theta\\\\\\cos\\left(\\frac{3\\pi}{2}+\\theta\\right)&=0.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\left(\\frac{5\\pi}{2}-\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.7$",
          "worked": "$$\\begin{align*}\\cos\\left(\\frac{5\\pi}{2}-\\theta\\right)&=\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)\\\\\\cos\\left(\\frac{5\\pi}{2}-\\theta\\right)&=\\sin\\theta\\\\\\cos\\left(\\frac{5\\pi}{2}-\\theta\\right)&=0.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
