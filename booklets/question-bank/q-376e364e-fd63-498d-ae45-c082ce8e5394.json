  "content": {
    "id": "p5-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A packet of lollies contains 12 red lollies, 20 green lollies, and some blue lollies. If $20\\%$ of the lollies are blue, then what percentage of the lollies are red?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p5-q17-short-result",
            "type": "paragraph",
