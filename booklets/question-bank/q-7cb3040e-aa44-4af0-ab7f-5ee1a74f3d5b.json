        "id": "p34-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y'=2y^2,\\quad y(0)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{3}{1-6x}$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=\\frac{1}{2y^2}\\\\x&=\\frac12\\int y^{-2}\\,dy\\\\x&=-\\frac{1}{2y}+C\\\\0&=-\\frac16+C\\\\C&=\\frac16\\\\\\frac{1}{y}&=\\frac13-2x\\\\y&=\\frac{3}{1-6x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p34-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y'=-y^2,\\quad y(0)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{1+x}$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=-\\frac{1}{y^2}\\\\x&=-\\int y^{-2}\\,dy\\\\x&=\\frac{1}{y}+C\\\\0&=1+C\\\\C&=-1\\\\\\frac{1}{y}&=x+1\\\\y&=\\frac{1}{1+x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p34-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y'=1+y^2,\\quad y\\left(\\frac{\\pi}{4}\\right)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\tan x$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=\\frac{1}{1+y^2}\\\\x&=\\int\\frac{1}{1+y^2}\\,dy\\\\x&=\\arctan y+C\\\\\\frac{\\pi}{4}&=\\frac{\\pi}{4}+C\\\\C&=0\\\\y&=\\tan x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p34-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$y'=-e^y,\\quad y(0)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\ln(1+x)$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=-e^{-y}\\\\x&=-\\int e^{-y}\\,dy\\\\x&=e^{-y}+C\\\\0&=1+C\\\\C&=-1\\\\e^{-y}&=x+1\\\\y&=-\\ln(1+x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p34-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$y'=e^{-y},\\quad y(3)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln(x-2)$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=e^y\\\\x&=\\int e^y\\,dy\\\\x&=e^y+C\\\\3&=1+C\\\\C&=2\\\\e^y&=x-2\\\\y&=\\ln(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p34-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$y'=y^{2/3},\\quad y(0)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\left(\\frac{x+3}{3}\\right)^3$",
          "worked": "$$\\begin{align*}\\frac{dx}{dy}&=y^{-2/3}\\\\x&=\\int y^{-2/3}\\,dy\\\\x&=3y^{1/3}+C\\\\0&=3+C\\\\C&=-3\\\\y^{1/3}&=\\frac{x+3}{3}\\\\y&=\\left(\\frac{x+3}{3}\\right)^3\\end{align*}$$",
