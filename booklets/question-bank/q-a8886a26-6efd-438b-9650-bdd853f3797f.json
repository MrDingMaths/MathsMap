  "content": {
    "id": "p58-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The atmospheric pressure $P$ on a planet changes with altitude $h$ at a rate proportional to $P$:\n$$\\frac{dP}{dh}=kP,$$\nfor some constant $k$. Let $P=P_0$ at ground level.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution of this DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=P_0e^{kh}$.",
          "worked": "$$\\begin{align*}\\frac{dP}{P}&=k\\,dh\\\\\\ln|P|&=kh+C\\\\P&=Ae^{kh}.\\end{align*}$$\nAt ground level, $h=0$ and $P=P_0$, so $A=P_0$.\n$$P=P_0e^{kh}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p58-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "The pressure at $10\\,000\\text{ m}$ is $40\\text{ kPa}$ (kilopascals) and at $6000\\text{ m}$ is $80\\text{ kPa}$. Find the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-\\dfrac{\\ln 2}{4000}\\text{ m}^{-1}$.",
          "worked": "$$\\begin{align*}P_0e^{6000k}&=80\\qquad (1)\\\\P_0e^{10000k}&=40\\qquad (2)\\end{align*}$$\nDividing (2) by (1):\n$$\\begin{align*}e^{4000k}&=\\frac{40}{80}\\\\e^{4000k}&=\\frac12\\\\4000k&=-\\ln 2\\\\k&=-\\frac{\\ln 2}{4000}\\text{ m}^{-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p58-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine the pressure at ground level, correct to the nearest kPa.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$226\\text{ kPa}$.",
          "worked": "From (1):\n$$\\begin{align*}P_0&=80e^{-6000k}\\\\P_0&=80e^{6000\\ln 2/4000}\\\\P_0&=160\\sqrt2\\text{ kPa}\\\\P_0&\\approx226\\text{ kPa}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
