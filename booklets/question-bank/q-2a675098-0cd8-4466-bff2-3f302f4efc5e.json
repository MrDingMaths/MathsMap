  "content": {
    "id": "p23-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $f(x)=3x-2$ and $g(x)=\\frac{1}{3}(x+2)$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q3-calculations",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q3-a",
            "type": "part",
            "label": "a",
            "prompt": "$g(f(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$\\begin{align*}f(2)&=3(2)-2\\\\f(2)&=4\\\\g(f(2))&=\\frac{1}{3}(4+2)\\\\g(f(2))&=2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p23-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "$f(g(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$\\begin{align*}g(2)&=\\frac{1}{3}(2+2)\\\\g(2)&=\\frac{4}{3}\\\\f(g(2))&=3\\left(\\frac{4}{3}\\right)-2\\\\f(g(2))&=2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p23-q3-c",
            "type": "part",
            "label": "c",
            "prompt": "$g(f(4))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$\\begin{align*}f(4)&=3(4)-2\\\\f(4)&=10\\\\g(f(4))&=\\frac{1}{3}(10+2)\\\\g(f(4))&=4\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p23-q3-d",
            "type": "part",
            "label": "d",
            "prompt": "$f(g(4))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$\\begin{align*}g(4)&=\\frac{1}{3}(4+2)\\\\g(4)&=2\\\\f(g(4))&=3(2)-2\\\\f(g(4))&=4\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p23-q3-e",
            "type": "part",
            "label": "e",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x$",
              "worked": "$\\begin{align*}f(g(x))&=3\\left(\\frac{x+2}{3}\\right)-2\\\\f(g(x))&=x+2-2\\\\f(g(x))&=x\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p23-q3-f",
            "type": "part",
            "label": "f",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x$",
              "worked": "$\\begin{align*}g(f(x))&=\\frac{1}{3}\\bigl((3x-2)+2\\bigr)\\\\g(f(x))&=\\frac{3x}{3}\\\\g(f(x))&=x\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p23-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "Describe the relationship between $f(x)$ and $g(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f$ and $g$ are inverses of each other.",
          "worked": "Since $f(g(x))=x$ and $g(f(x))=x$ for every real $x$, $f$ and $g$ are inverses of each other. Applying either function followed by the other returns the original input.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
