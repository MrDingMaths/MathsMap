  "content": {
    "id": "p31-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A machine makes 720 bottles in 12 hours. How many bottles does it make in 40 minutes?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "40 bottles",
      "worked": "$$\\begin{align*}12\\text{ hours}&=12\\times60\\text{ minutes}\\\\12\\text{ hours}&=720\\text{ minutes}\\end{align*}$$\nIn 720 minutes, the machine makes 720 bottles.\n$$\\begin{align*}\\text{Bottles made in 1 minute}&=720\\div720=1\\\\\\text{Bottles made in 40 minutes}&=1\\times40=40\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
