  "content": {
    "id": "v2-50a09-p41-practice-slot-25-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Three buses leave Central Station in Adelaide together at 6:00 am. They then leave every $6$, $8$ and $9$ minutes respectively. Determine a number of minutes between $200$ and $230$ after 6:00 am when all three buses leave together.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$216$ minutes",
      "worked": "Multiples of $9$ are $9,18,\\ldots,72,\\ldots$. The first divisible by both $6$ and $8$ is $72$.\n\n$\\operatorname{LCM}(6,8,9)=72$\n\nMultiples of $72$ are $72,144,216,288,\\ldots$. The only one between $200$ and $230$ is $216$.",
      "solutionDiagrams": []
    },
