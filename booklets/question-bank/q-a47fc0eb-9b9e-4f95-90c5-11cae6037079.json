  "content": {
    "id": "p35-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Factorise the denominator before simplifying these fractions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3}{x+2}+\\dfrac{5}{2x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11}{2(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+2}+\\frac{5}{2x+4}&=\\frac{3}{x+2}+\\frac{5}{2(x+2)}\\\\&=\\frac{6+5}{2(x+2)}\\\\&=\\frac{11}{2(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p35-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{7}{3x-3}-\\dfrac{2}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{7}{3x-3}-\\frac{2}{x-1}&=\\frac{7}{3(x-1)}-\\frac{2}{x-1}\\\\&=\\frac{7-6}{3(x-1)}\\\\&=\\frac{1}{3(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p35-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3}{8x-4}-\\dfrac{5}{1-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{23}{4(2x-1)}$",
          "worked": "$$\\begin{align*}\\frac{3}{8x-4}-\\frac{5}{1-2x}&=\\frac{3}{4(2x-1)}-\\frac{5}{-(2x-1)}\\\\&=\\frac{3}{4(2x-1)}+\\frac{5}{2x-1}\\\\&=\\frac{3+20}{4(2x-1)}\\\\&=\\frac{23}{4(2x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p35-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{4}{x^2-9}-\\dfrac{3}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13-3x}{(x-3)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{4}{x^2-9}-\\frac{3}{x+3}&=\\frac{4}{(x-3)(x+3)}-\\frac{3}{x+3}\\\\&=\\frac{4-3(x-3)}{(x-3)(x+3)}\\\\&=\\frac{13-3x}{(x-3)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p35-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{5}{2x+4}+\\dfrac{2}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x-6}{2(x-2)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{5}{2x+4}+\\frac{2}{x^2-4}&=\\frac{5}{2(x+2)}+\\frac{2}{(x-2)(x+2)}\\\\&=\\frac{5(x-2)+4}{2(x-2)(x+2)}\\\\&=\\frac{5x-6}{2(x-2)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p35-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{10}{3x-4}-\\dfrac{7}{9x^2-16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3(10x+11)}{(3x-4)(3x+4)}$",
          "worked": "$$\\begin{align*}\\frac{10}{3x-4}-\\frac{7}{9x^2-16}&=\\frac{10}{3x-4}-\\frac{7}{(3x-4)(3x+4)}\\\\&=\\frac{10(3x+4)-7}{(3x-4)(3x+4)}\\\\&=\\frac{30x+33}{(3x-4)(3x+4)}\\\\&=\\frac{3(10x+11)}{(3x-4)(3x+4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p35-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{1}{x^2+x}+\\dfrac{1}{x^2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{(x+1)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x^2+x}+\\frac{1}{x^2-x}&=\\frac{1}{x(x+1)}+\\frac{1}{x(x-1)}\\\\&=\\frac{(x-1)+(x+1)}{x(x+1)(x-1)}\\\\&=\\frac{2x}{x(x+1)(x-1)}\\\\&=\\frac{2}{(x+1)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p35-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{1}{x-y}+\\dfrac{2x-y}{x^2-y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x}{(x+y)(x-y)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x-y}+\\frac{2x-y}{x^2-y^2}&=\\frac{1}{x-y}+\\frac{2x-y}{(x-y)(x+y)}\\\\&=\\frac{(x+y)+(2x-y)}{(x-y)(x+y)}\\\\&=\\frac{3x}{(x-y)(x+y)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p35-q11-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{3}{x^2+2x-8}-\\dfrac{2}{x^2+x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{(x-2)(x+3)(x+4)}$",
          "worked": "$$\\begin{align*}x^2+2x-8&=(x-2)(x+4)\\\\x^2+x-6&=(x-2)(x+3)\\end{align*}$$\n$$\\begin{align*}\\frac{3}{x^2+2x-8}-\\frac{2}{x^2+x-6}&=\\frac{3(x+3)-2(x+4)}{(x-2)(x+3)(x+4)}\\\\&=\\frac{x+1}{(x-2)(x+3)(x+4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p35-q11-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{1}{x^2-4x+3}+\\dfrac{1}{x^2-5x+6}-\\dfrac{1}{x^2-3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{(x-3)(x-2)(x-1)}$",
          "worked": "$$\\begin{align*}x^2-4x+3&=(x-1)(x-3)\\\\x^2-5x+6&=(x-2)(x-3)\\\\x^2-3x+2&=(x-1)(x-2)\\end{align*}$$\n$$\\begin{aligned}&\\frac{1}{x^2-4x+3}+\\frac{1}{x^2-5x+6}-\\frac{1}{x^2-3x+2}\\\\&\\qquad=\\frac{(x-2)+(x-1)-(x-3)}{(x-3)(x-2)(x-1)}\\\\&\\qquad=\\frac{x}{(x-3)(x-2)(x-1)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      }
    ]
  },
