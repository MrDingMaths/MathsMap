  "content": {
    "id": "p58-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "If $x=\\sqrt{1+\\sqrt{1+\\sqrt{1+\\sqrt{1\\ldots}}}}$, find the value of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\dfrac{1+\\sqrt{5}}{2}$, the positive root of $x^2=1+x$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p58-q13-repetition",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Since the radical repeats infinitely, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=\\sqrt{1+x}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p58-q13-square-instruction",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Square both sides.",
                "marks": []
              }
            ]
          },
          {
            "id": "p58-q13-square-equation",
            "type": "paragraph",
            "fontSize": null,
            "align": "center",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x^2=1+x",
                "display": true
              }
            ]
          },
          {
            "id": "p58-q13-formula-instruction",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Solve using the quadratic formula.",
                "marks": []
              }
            ]
          },
          {
            "id": "p58-q13-quadratic-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "center",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}x^2-x-1&=0\\\\x&=\\frac{1\\pm\\sqrt{(-1)^2-4(1)(-1)}}{2(1)}\\\\x&=\\frac{1\\pm\\sqrt{5}}{2}\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p58-q13-positive-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x",
                "display": false
              },
              {
                "type": "text",
                "text": " must be positive because it is a square root, so",
                "marks": []
              }
            ]
          },
          {
            "id": "p58-q13-final-equation",
            "type": "paragraph",
            "fontSize": null,
            "align": "center",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x=\\frac{1+\\sqrt{5}}{2}",
                "display": true
              }
            ]
          },
          {
            "id": "p58-q13-golden-ratio",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "(This number ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\phi\\approx1.618",
                "display": false
              },
              {
                "type": "text",
                "text": " is the golden ratio.)",
                "marks": []
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
