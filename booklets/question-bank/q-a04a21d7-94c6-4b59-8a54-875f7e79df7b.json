  "content": {
    "id": "v2-78c76-p71-practice-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "Find the number of ways in which:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-78c76-p71-practice-slot-13-slot-13-a",
        "type": "part",
        "label": "a",
        "prompt": "a president, a secretary and a treasurer can be chosen from a club of 12 members,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1320$",
          "worked": "The order matters because the positions are different.\n$$\\begin{align*}N&={}^{12}P_3\\\\&=12\\times11\\times10\\\\&=1320\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-78c76-p71-practice-slot-13-slot-13-b",
        "type": "part",
        "label": "b",
        "prompt": "a four-digit number less than $3000$ can be formed from the digits $0$ to $9$ if no digit is repeated,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1008$",
          "worked": "The first digit is $1$ or $2$ (not $0$): $2$ ways. The other three digits are an ordered selection from the remaining $9$ digits.\n$$\\begin{align*}N&=2\\times{}^{9}P_3\\\\&=2\\times504\\\\&=1008\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-78c76-p71-practice-slot-13-slot-13-c",
        "type": "part",
        "label": "c",
        "prompt": "gold, silver and bronze medals can be awarded to nine swimmers in a final if Maddie must win a medal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$168$",
          "worked": "Maddie wins gold, silver or bronze: $3$ ways. The other two medals are an ordered selection from the remaining $8$ swimmers.\n$$\\begin{align*}N&=3\\times{}^{8}P_2\\\\&=3\\times56\\\\&=168\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
