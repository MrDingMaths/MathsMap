  "content": {
    "id": "p18-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The volume $V\\text{ cm}^3$ of metal in a tube is given by the formula $V=\\pi\\ell\\bigl(r^2-(r-t)^2\\bigr)$ where $\\ell$ cm is the length, $r$ cm is the radius of the outside surface and $t$ cm the thickness of the material.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $V$ if $\\ell=50$, $r=5$ and $t=0.25$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=\\frac{975\\pi}{8}\\text{ cm}^3$",
          "worked": "$$\\begin{align*}V&=\\pi\\times50\\left(5^2-\\left(5-\\frac14\\right)^2\\right)\\\\V&=50\\pi\\left(25-\\frac{361}{16}\\right)\\\\V&=50\\pi\\times\\frac{39}{16}\\\\V&=\\frac{975\\pi}{8}\\text{ cm}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p18-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Make $r$ the subject of the formula.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\frac{1}{2t}\\left(\\frac{V}{\\pi\\ell}+t^2\\right)$\n\nExpand the square so that the $r^2$ terms cancel, then isolate $r$.",
          "worked": "$$\\begin{align*}V&=\\pi\\ell(r^2-r^2+2rt-t^2)\\\\\\frac{V}{\\pi\\ell}&=2rt-t^2\\\\2rt&=\\frac{V}{\\pi\\ell}+t^2\\\\r&=\\frac{1}{2t}\\left(\\frac{V}{\\pi\\ell}+t^2\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
