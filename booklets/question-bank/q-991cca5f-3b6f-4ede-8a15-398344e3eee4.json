  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The curve $y=ax^2+bx+c$ passes through the points $(1,4)$ and $(-1,6)$. There is a maximum turning point at $x=-0.5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $a+b+c=4$, $a-b+c=6$, and $-a+b=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y(1)=a+b+c=4$, $y(-1)=a-b+c=6$, and $y'(-0.5)=-a+b=0$.",
          "worked": "Using the two given points:\n$$\\begin{align*}y(1)&=a(1)^2+b(1)+c=a+b+c=4\\\\y(-1)&=a(-1)^2+b(-1)+c=a-b+c=6\\end{align*}$$\nAt the turning point, $y'(-0.5)=0$:\n$$\\begin{align*}y'(x)&=2ax+b\\\\y'(-0.5)&=2a(-0.5)+b=-a+b=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the values of $a,b,c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=b=-1$, $c=6$.",
          "worked": "Subtract the second equation in part (a) from the first:\n$$\\begin{align*}2b&=4-6\\\\2b&=-2\\\\b&=-1\\end{align*}$$\nUse $-a+b=0$:\n$$\\begin{align*}-a-1&=0\\\\a&=-1\\end{align*}$$\nSubstitute into $a+b+c=4$:\n$$\\begin{align*}-1-1+c&=4\\\\c&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
