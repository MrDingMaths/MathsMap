  "content": {
    "id": "p21-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find any points on these curves where the tangent has gradient $-1$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=-\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac14,-\\frac12\\right)$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=-\\frac{1}{2\\sqrt{x}}\\\\-\\frac{1}{2\\sqrt{x}}&=-1\\\\2\\sqrt{x}&=1\\\\\\sqrt{x}&=\\frac12\\\\x&=\\frac14\\\\y&=-\\sqrt{\\frac14}\\\\&=-\\frac12\\end{aligned}$$\nThe point is $\\left(\\frac14,-\\frac12\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No points.",
          "worked": "$$\\frac{dy}{dx}=\\frac{1}{2\\sqrt{x}}.$$\nFor $x>0$, the derivative is positive, so it cannot equal $-1$. At $x=0$, the tangent is vertical. There are no points with tangent gradient $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
