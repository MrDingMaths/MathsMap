  "content": {
    "id": "p25-q7",
    "type": "question",
    "label": "7",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2-1}{x+1}\\div\\dfrac{x-1}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$\\begin{aligned}\\frac{x^2-1}{x+1}\\div\\frac{x-1}{3}&=\\frac{x^2-1}{x+1}\\times\\frac{3}{x-1}\\\\&=\\frac{(x-1)(x+1)}{x+1}\\times\\frac{3}{x-1}\\\\&=3\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p25-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2-4}{x+2}\\div(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$\\begin{aligned}\\frac{x^2-4}{x+2}\\div(x-2)&=\\frac{x^2-4}{x+2}\\times\\frac{1}{x-2}\\\\&=\\frac{(x-2)(x+2)}{x+2}\\times\\frac{1}{x-2}\\\\&=1\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p25-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2+5x+6}{x+3}\\div\\dfrac{x+2}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$\\begin{aligned}\\frac{x^2+5x+6}{x+3}\\div\\frac{x+2}{4}&=\\frac{x^2+5x+6}{x+3}\\times\\frac{4}{x+2}\\\\&=\\frac{(x+2)(x+3)}{x+3}\\times\\frac{4}{x+2}\\\\&=4\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p25-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x^2+5x+6}{x^2-x-6}\\div\\dfrac{x+2}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{x+2}$",
          "worked": "$\\begin{aligned}\\frac{x^2+5x+6}{x^2-x-6}\\div\\frac{x+2}{x-3}&=\\frac{x^2+5x+6}{x^2-x-6}\\times\\frac{x-3}{x+2}\\\\&=\\frac{(x+2)(x+3)}{(x-3)(x+2)}\\times\\frac{x-3}{x+2}\\\\&=\\frac{x+3}{x+2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p25-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x^2-16}{x^2-5x+4}\\div\\dfrac{x+4}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$\\begin{aligned}\\frac{x^2-16}{x^2-5x+4}\\div\\frac{x+4}{x-1}&=\\frac{x^2-16}{x^2-5x+4}\\times\\frac{x-1}{x+4}\\\\&=\\frac{(x-4)(x+4)}{(x-1)(x-4)}\\times\\frac{x-1}{x+4}\\\\&=1\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p25-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(x-3)(x+3)}{2}\\times\\dfrac{6}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x-3)$",
          "worked": "$\\begin{aligned}\\frac{(x-3)(x+3)}{2}\\times\\frac{6}{x+3}&=\\frac{x-3}{2}\\times6\\\\&=3(x-3)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
