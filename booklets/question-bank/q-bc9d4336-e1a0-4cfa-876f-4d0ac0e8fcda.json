      "blocks": [
        {
          "id": "5c4f5962-6c6e-492e-a64b-5f045117c5c0",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "For each equation, find a constant value of ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "k",
              "display": false
            },
            {
              "type": "text",
              "text": " that makes the equation true for every value of the other variable, if such a constant exists.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q22-bridge-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "aa4808dc-9bdd-4bc8-bd1f-41b05ddfb821",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "k(x+2)=3x+6",
                  "display": false
                }
              ]
            },
            {
              "id": "8255d0df-7e89-4625-aaff-d8573b697438",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Expand the left side. Match the coefficient of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "x",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " to find ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "k",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                },
                {
                  "type": "break"
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=3$",
          "worked": "$$\\begin{aligned}k(x+2)&=kx+2k\\\\k&=3\\\\2k&=2(3)=6\\end{aligned}$$\nBoth coefficient conditions agree, so $k=3$ makes the equation true for every $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q22-bridge-b",
        "type": "part",
        "label": "b",
        "prompt": "$kx(x+2)=4x^2+8x$\n\nExpand, match the coefficient of $x^2$ and check the coefficient of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=4$",
          "worked": "$$\\begin{aligned}kx(x+2)&=kx^2+2kx\\\\k&=4\\\\2k&=2(4)=8\\end{aligned}$$\nBoth coefficient conditions agree, so $k=4$ makes the equation true for every $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q22-bridge-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "17f9bf0e-8f55-4f31-a87a-45e61a227bdf",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "2x(x+3)+kx(x-1)=5x^2+3x",
                  "display": false
                }
              ]
            },
            {
              "id": "41e59f15-538e-475d-a3d1-306923facadb",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Expand and collect like terms. Find ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "k",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and check.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=3$",
          "worked": "$$\\begin{aligned}2x(x+3)+kx(x-1)&=(2+k)x^2+(6-k)x\\\\2+k&=5\\\\k&=3\\\\6-k&=6-3=3\\end{aligned}$$\nBoth coefficient conditions agree, so $k=3$ makes the equation true for every $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p17-q22-a",
        "type": "part",
        "label": "d",
        "prompt": "$2x(x+3)+kx(x-1)=5x^{2}+4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No constant $k$ makes this an identity.",
          "worked": "$$\\begin{align*}2x^{2}+6x+kx^{2}-kx&=5x^{2}+4x\\\\(2+k)x^{2}+(6-k)x&=5x^{2}+4x\\end{align*}$$\nFor an identity, the coefficients of $x^{2}$ and $x$ must both match:\n$$\\begin{align*}2+k&=5\\\\k&=3\\\\6-k&=4\\\\k&=2\\end{align*}$$\nThese conditions conflict, so no constant $k$ makes the equation true for every $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p17-q22-b",
        "type": "part",
        "label": "e",
        "prompt": "$ka(a-2)+3a(a+4)=7a^{2}+6a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No constant $k$ makes this an identity.",
          "worked": "$$\\begin{align*}ka^{2}-2ka+3a^{2}+12a&=7a^{2}+6a\\\\(k+3)a^{2}+(12-2k)a&=7a^{2}+6a\\end{align*}$$\nFor an identity, the coefficients of $a^{2}$ and $a$ must both match:\n$$\\begin{align*}k+3&=7\\\\k&=4\\\\12-2k&=6\\\\k&=3\\end{align*}$$\nThese conditions conflict, so no constant $k$ makes the equation true for every $a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
