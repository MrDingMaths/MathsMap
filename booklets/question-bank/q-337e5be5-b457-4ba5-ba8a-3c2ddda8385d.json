  "content": {
    "id": "p18-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Write in index form with a single base.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac{5}{2}}$",
          "worked": "$$\\begin{align*}x^2\\sqrt{x}&=x^2\\times x^{\\frac12}\\\\&=x^{2+\\frac12}\\\\&=x^{\\frac52}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\sqrt{x}}{x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{-\\frac{5}{2}}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{x}}{x^3}&=\\frac{x^{\\frac12}}{x^3}\\\\&=x^{\\frac12-3}\\\\&=x^{-\\frac52}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p18-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^3\\sqrt[3]{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac{11}{3}}$",
          "worked": "$$\\begin{align*}x^3\\sqrt[3]{x^2}&=x^3\\times x^{\\frac23}\\\\&=x^{3+\\frac23}\\\\&=x^{\\frac{11}{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{\\sqrt[3]{x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac{1}{3}}$",
          "worked": "$$\\begin{align*}\\frac{x}{\\sqrt[3]{x^2}}&=\\frac{x^1}{x^{\\frac23}}\\\\&=x^{1-\\frac23}\\\\&=x^{\\frac13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p18-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{\\frac{3}{2}}$",
          "worked": "$$\\begin{align*}2\\sqrt2&=2^1\\times2^{\\frac12}\\\\&=2^{1+\\frac12}\\\\&=2^{\\frac32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$3\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{\\frac{3}{2}}$",
          "worked": "$$\\begin{align*}3\\sqrt3&=3^1\\times3^{\\frac12}\\\\&=3^{1+\\frac12}\\\\&=3^{\\frac32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$25\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{\\frac{5}{2}}$",
          "worked": "$$\\begin{align*}25\\sqrt5&=5^2\\times5^{\\frac12}\\\\&=5^{2+\\frac12}\\\\&=5^{\\frac52}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$27\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{\\frac{7}{2}}$",
          "worked": "$$\\begin{align*}27\\sqrt3&=3^3\\times3^{\\frac12}\\\\&=3^{3+\\frac12}\\\\&=3^{\\frac72}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
