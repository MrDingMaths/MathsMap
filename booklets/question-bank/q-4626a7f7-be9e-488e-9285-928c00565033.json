  "content": {
    "id": "p57-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A radioactive substance decays in such a way that the mass $M$ of a sample $t$ years after it has been measured and stored is $M=M_0e^{-0.1t}$, where $M_0$ is its original mass.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "How long until half the sample is gone? Give your answer correct to three decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=10\\ln 2\\approx6.931$ years.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "9608f0db-217f-436a-bff1-417830712d73",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "M=\\dfrac{M_0}{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac12&=e^{-0.1t}\\\\\\ln\\left(\\frac12\\right)&=-0.1t\\\\t&=-10\\ln\\left(\\frac12\\right)\\\\&\\approx6.931\\text{ years}.\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p57-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the rate $\\dfrac{dM}{dt}$ at which the sample is decaying, and show that $\\dfrac{dM}{dt}=-0.1\\times M$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dM}{dt}=-0.1M_0e^{-0.1t}=-0.1M$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "5d55080e-e962-46ff-826f-4690f867571c",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{dM}{dt}&=-0.1M_0e^{-0.1t}\\\\&=-0.1M.\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "The rate is measured in mass units per year.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p57-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "What percentage of the remaining sample decays each year? Give your answer correct to three decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100(1-e^{-0.1})\\%\\approx9.516\\%$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "d170b738-c1a5-4fc0-8525-5c63e3530226",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Every year the remaining mass is multiplied by ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "e^{-0.1}\\approx0.9048",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\text{Percentage decrease}&=100(1-e^{-0.1})\\%\\\\&\\approx9.516\\%.\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p57-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "When will the rate of decay be $1\\%$ of the original mass $M_0$ per year? Give your answer correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=10\\ln 10\\approx23.03$ years.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "6c786d70-c63c-4587-bfdd-dbf1c3e9f5a2",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\dfrac{dM}{dt}=-0.01M_0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}-0.1M_0e^{-0.1t}&=-0.01M_0\\\\e^{-0.1t}&=0.1\\\\-0.1t&=\\ln(0.1)\\\\t&=-10\\ln(0.1)\\\\&=10\\ln 10\\\\&\\approx23.03\\text{ years}.\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
