          "inlines": [
            {
              "type": "text",
              "text": "EB Games and Target buy PlayStations at a cost-price of $480 and resell them at a markup.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "EB Games has a mark-up of $150 while Target has a mark-up of 25% of the cost-price.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "At which store is the PlayStation cheaper, and by how much?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Target cheaper by \\$30.",
      "worked": "$$\\begin{align*}\\text{EB Games price} &= \\$480+\\$150=\\$630\\\\\\text{Target price} &= \\$480\\times1.25=\\$600\\\\\\text{Difference} &= \\$630-\\$600=\\$30\\end{align*}$$\nTarget is cheaper by \\$30.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
