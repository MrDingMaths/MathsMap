        "answer": {
          "short": "$x^4+x^2+1$",
          "worked": "$$\\begin{align*}(x^2+x+1)(x^2-x+1)&=x^2(x^2-x+1)+x(x^2-x+1)+(x^2-x+1)\\\\(x^2+x+1)(x^2-x+1)&=x^4-x^3+x^2+x^3-x^2+x+x^2-x+1\\\\(x^2+x+1)(x^2-x+1)&=x^4+x^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p31-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+1)(x^2-x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3+1$",
          "worked": "$$\\begin{align*}(x+1)(x^2-x+1)&=x^3-x^2+x+x^2-x+1\\\\(x+1)(x^2-x+1)&=x^3+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p31-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x^5-1)(x^5+1)$",
