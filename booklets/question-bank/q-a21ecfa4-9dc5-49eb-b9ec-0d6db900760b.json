  "content": {
    "id": "p30-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the values of $x$ for which:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q2a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2(x-2)(x+1)>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-1$ or $x>2$.",
          "worked": "The zeroes are $-1,0,2$. The graph crosses at $-1$ and $2$ and touches the axis at the double zero $0$. Its leading coefficient is positive.\n\nThe graph is above the axis for $x<-1$ and $x>2$. Hence $x<-1$ or $x>2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q2b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-1)(x-2)^2(x-3)^3\\le0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\le x\\le3$.",
          "worked": "The graph crosses at the odd-multiplicity zeroes $1$ and $3$ and touches at the double zero $2$. The leading coefficient is positive.\n\nIt is negative between $1$ and $3$, except that its value at $2$ is zero. Including all zeroes gives $1\\le x\\le3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q2c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x-3)^2(3x-4)^4\\ge0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R$.",
          "worked": "Both factors are even powers and are non-negative for every real $x$. Their product is therefore non-negative for every real $x$.\n\nHence $x\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q2d",
        "type": "part",
        "label": "d",
        "prompt": "$(x+1)^3(x+2)^2(x+3)<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3<x<-2$ or $-2<x<-1$.",
          "worked": "The graph crosses at $-3$ and $-1$ and touches at the double zero $-2$. Its leading coefficient is positive.\n\nIt lies below the axis between $-3$ and $-1$, except at $-2$, where it is zero. Thus $-3<x<-2$ or $-2<x<-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
