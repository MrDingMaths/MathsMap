    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q5-part1",
        "type": "part",
        "label": "a",
        "prompt": "On a map, the distance between two towns is measured at 54 millimetres.\nThe actual distance between the two towns is 16.2 kilometres. What is the scale of the map?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:300\\,000$",
          "worked": "$$\\begin{align*}16.2\\text{ km}&=16\\,200\\,000\\text{ mm}\\\\\\text{Scale factor}&=\\frac{\\text{image}}{\\text{original}}\\\\&=\\frac{54}{16\\,200\\,000}\\\\&=\\frac{1}{300\\,000}\\end{align*}$$\nThe scale is $1:300\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p53-q5-part2",
        "type": "part",
        "label": "b",
        "prompt": "If two other towns on the same map are 9.2 centimetres apart, what is the actual distance between the two towns in kilometres?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27.6\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Actual distance}&=9.2\\times300\\,000\\text{ cm}\\\\&=2\\,760\\,000\\text{ cm}\\\\&=27.6\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
