  "content": {
    "id": "v2-edca4c-p5-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Which is greater, $2^{-3}$ or $3^{-2}$? Show your working.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3^{-2}$ is not greater; $2^{-3}=\\frac{1}{8}$ is greater than $3^{-2}=\\frac{1}{9}$.",
      "worked": "$$\\begin{align*}2^{-3}&=\\frac{1}{2^3}=\\frac{1}{8}\\\\3^{-2}&=\\frac{1}{3^2}=\\frac{1}{9}\\end{align*}$$ Since $\\frac{1}{8}>\\frac{1}{9}$, $2^{-3}$ is greater.",
      "solutionDiagrams": []
    },
