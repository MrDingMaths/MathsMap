  "content": {
    "id": "v2-b6751-p10-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Substitute, simplify and rearrange to make $c$ the subject.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b6751-p10-practice-slot-2-s2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Substitute $b=2(a-3c)$ into $T=4a-b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=\\frac{T-2a}{6}$",
          "worked": "$$\\begin{align*}T&=4a-2(a-3c)\\\\T&=4a-2a+6c\\\\T&=2a+6c\\\\T-2a&=6c\\\\c&=\\frac{T-2a}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-b6751-p10-practice-slot-2-s2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute $v=\\sqrt{2c}$ into $E=\\frac{1}{2}mv^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=\\frac{E}{m}$",
          "worked": "$$\\begin{align*}E&=\\frac{1}{2}m\\left(\\sqrt{2c}\\right)^2\\\\E&=\\frac{1}{2}m\\times2c\\\\E&=mc\\\\c&=\\frac{E}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
