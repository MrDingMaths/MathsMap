  "content": {
    "id": "p23-review-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $A=30^\\circ$, $B=60^\\circ$ and $C=45^\\circ$, find the value of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-review-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin 2A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\sin 2A&=\\sin(2\\times30^\\circ)\\\\\\sin 2A&=\\sin60^\\circ\\\\\\sin 2A&=\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-review-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\sin A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}2\\sin A&=2\\sin30^\\circ\\\\2\\sin A&=2\\times\\frac12\\\\2\\sin A&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-review-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos 2B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac12$",
          "worked": "$120^\\circ$ is in the second quadrant, where cosine is negative; its related angle is $60^\\circ$.\n\n$$\\begin{align*}\\cos 2B&=\\cos(2\\times60^\\circ)\\\\\\cos 2B&=\\cos120^\\circ\\\\\\cos 2B&=-\\cos60^\\circ\\\\\\cos 2B&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-review-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\cos B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}2\\cos B&=2\\cos60^\\circ\\\\2\\cos B&=2\\times\\frac12\\\\2\\cos B&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-review-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos^2 B-\\sin^2 B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac12$",
          "worked": "$$\\begin{align*}\\cos^2B-\\sin^2B&=\\cos^260^\\circ-\\sin^260^\\circ\\\\\\cos^2B-\\sin^2B&=\\left(\\frac12\\right)^2-\\left(\\frac{\\sqrt3}{2}\\right)^2\\\\\\cos^2B-\\sin^2B&=\\frac14-\\frac34\\\\\\cos^2B-\\sin^2B&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-review-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan 3C$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$135^\\circ$ is in the second quadrant, where tangent is negative; its related angle is $45^\\circ$.\n\n$$\\begin{align*}\\tan3C&=\\tan(3\\times45^\\circ)\\\\\\tan3C&=\\tan135^\\circ\\\\\\tan3C&=-\\tan45^\\circ\\\\\\tan3C&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
