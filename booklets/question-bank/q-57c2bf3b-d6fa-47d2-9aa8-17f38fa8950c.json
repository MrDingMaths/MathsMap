                  "type": "math",
                  "latex": "x=2",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", then ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "f(2)",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " is undefined. ",
                  "marks": []
