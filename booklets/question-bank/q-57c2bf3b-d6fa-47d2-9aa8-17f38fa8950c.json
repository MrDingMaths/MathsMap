        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True, using the textbook's convention for continuity at a specified point.",
          "worked": "True, using the textbook's convention at a specified point. Continuity at $x=2$ requires $f(2)$ to be defined and equal both approached values. An undefined $f(2)$ fails this test. This differs from calling a function continuous throughout its domain: a point outside the domain does not prevent continuity at every point within the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p114-ex2l-q1-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
