  "content": {
    "id": "p28-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The number of finches on an island, $N$, at time $t$ years after 1 January 2010 is approximately described by the rule $N=80\\,000\\times(1.008)^t$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Identify (from the rule) the annual percentage increase in finches on the island after 1 January 2010.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.8\\%$",
          "worked": "$$\\begin{align*}\\text{Annual percentage increase}&=(1.008-1)\\times100\\%\\\\\\text{Annual percentage increase}&=0.8\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p28-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How many finches were there on the island on 1 January 2010?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80\\,000$ finches",
          "worked": "On 1 January 2010, $t=0$.\n\n$$\\begin{align*}N&=80\\,000\\times(1.008)^0\\\\N&=80\\,000\\end{align*}$$\n\nThere were $80\\,000$ finches.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p28-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "How many finches will there be on the island on 1 January 2020? Give your answer to the nearest whole finch.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $86\\,635$ finches.",
          "worked": "$$\\begin{align*}t&=2020-2010\\\\t&=10\\\\N&=80\\,000\\times(1.008)^{10}\\\\N&\\approx86\\,635\\end{align*}$$\n\nThere will be approximately $86\\,635$ finches, to the nearest whole finch.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
