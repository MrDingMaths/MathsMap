  "content": {
    "id": "p4-q17-group-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q17-response",
        "type": "part",
        "label": "a",
        "prompt": "$x^4\\times x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^7$",
          "worked": "$$\\begin{align*}x^4\\times x^3&=x^{4+3}\\\\x^4\\times x^3&=x^7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q18-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^7}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5$, $x\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{x^7}{x^2}&=x^{7-2}\\\\\\frac{x^7}{x^2}&=x^5\\end{align*}$$The original denominator requires $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q19-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{y^2}{y^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^{-3}=\\dfrac1{y^3}$, $y\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{y^2}{y^5}&=y^{2-5}\\\\\\frac{y^2}{y^5}&=y^{-3}\\\\\\frac{y^2}{y^5}&=\\frac1{y^3}\\end{align*}$$The original denominator requires $y\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q20-response",
        "type": "part",
        "label": "d",
        "prompt": "$(a^2)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{12}$",
          "worked": "$$\\begin{align*}(a^2)^6&=a^{2\\times6}\\\\(a^2)^6&=a^{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q21-response",
        "type": "part",
        "label": "e",
        "prompt": "$3b^0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$ for $b\\ne0$; undefined at $b=0$.",
          "worked": "For $b\\ne0$, $b^0=b^{1-1}=\\dfrac bb=1$. Hence$$\\begin{align*}3b^0&=3\\times1\\\\3b^0&=3.\\end{align*}$$At $b=0$, the original expression contains the undefined power $0^0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q22-response",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{c^3\\times c^4}{c^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c^2$, $c\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{c^3\\times c^4}{c^5}&=c^{3+4-5}\\\\\\frac{c^3\\times c^4}{c^5}&=c^2\\end{align*}$$The original denominator requires $c\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
