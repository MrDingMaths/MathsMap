  "content": {
    "id": "p6-q6",
    "type": "question",
    "label": "6",
    "prompt": "Complete the square in $x$ and $y$ to find the coordinates of the centre and the radius of each circle.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+4x+y^2+6y+9=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-2,-3)$, radius $2$.",
          "worked": "$$\\begin{align*}(x^2+4x)+(y^2+6y)&=-9\\\\(x^2+4x+4)+(y^2+6y+9)&=-9+4+9\\\\(x+2)^2+(y+3)^2&=4\\\\(x+2)^2+(y+3)^2&=2^2\\end{align*}$$\nCentre $(-2,-3)$, radius $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-2x+y^2+8y+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(1,-4)$, radius $\\sqrt{13}$.",
          "worked": "$$\\begin{align*}(x^2-2x)+(y^2+8y)&=-4\\\\(x^2-2x+1)+(y^2+8y+16)&=-4+1+16\\\\(x-1)^2+(y+4)^2&=13\\end{align*}$$\nCentre $(1,-4)$, radius $\\sqrt{13}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-6x+y^2-8y=39$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(3,4)$, radius $8$.",
          "worked": "$$\\begin{align*}(x^2-6x)+(y^2-8y)&=39\\\\(x^2-6x+9)+(y^2-8y+16)&=39+9+16\\\\(x-3)^2+(y-4)^2&=64\\\\(x-3)^2+(y-4)^2&=8^2\\end{align*}$$\nCentre $(3,4)$, radius $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-14x+y^2-8y+40=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(7,4)$, radius $5$.",
          "worked": "$$\\begin{align*}(x^2-14x)+(y^2-8y)&=-40\\\\(x^2-14x+49)+(y^2-8y+16)&=-40+49+16\\\\(x-7)^2+(y-4)^2&=25\\\\(x-7)^2+(y-4)^2&=5^2\\end{align*}$$\nCentre $(7,4)$, radius $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-8x+y^2-6y+15=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(4,3)$, radius $\\sqrt{10}$.",
          "worked": "$$\\begin{align*}(x^2-8x)+(y^2-6y)&=-15\\\\(x^2-8x+16)+(y^2-6y+9)&=-15+16+9\\\\(x-4)^2+(y-3)^2&=10\\end{align*}$$\nCentre $(4,3)$, radius $\\sqrt{10}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2-8x+y^2-4y+10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(4,2)$, radius $\\sqrt{10}$.",
          "worked": "$$\\begin{align*}(x^2-8x)+(y^2-4y)&=-10\\\\(x^2-8x+16)+(y^2-4y+4)&=-10+16+4\\\\(x-4)^2+(y-2)^2&=10\\end{align*}$$\nCentre $(4,2)$, radius $\\sqrt{10}$.",
