      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Consider an arithmetic sequence for which $a_3=15$ and $a_5=23$. Find $a_8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$",
          "worked": "$$\\begin{align*}2d&=a_5-a_3=23-15=8\\\\d&=4\\\\a_8&=a_5+3d=23+3\\times4\\\\a_8&=35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Consider an arithmetic sequence for which $a_2=2$ and $a_6=-10$. Find $a_8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-16$",
          "worked": "$$\\begin{align*}4d&=a_6-a_2=-10-2=-12\\\\d&=-3\\\\a_8&=a_6+2d=-10+2\\times(-3)\\\\a_8&=-16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
