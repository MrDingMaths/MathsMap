  "content": {
    "id": "p17-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Write the equation for these parabolas, when compared to $y=x^2$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "reflected across $x$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^2$",
          "worked": "Reflection across the $x$-axis changes the sign of the squared term: $y=-x^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "translated 2 units left",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+2)^2$",
          "worked": "A shift left 2 units replaces $x$ with $x+2$: $y=(x+2)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "translated 5 units down",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2-5$",
          "worked": "A shift down 5 units subtracts 5 from the output: $y=x^2-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "translated 4 units up",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2+4$",
          "worked": "A shift up 4 units adds 4 to the output: $y=x^2+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "translated 1 unit right",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-1)^2$",
          "worked": "A shift right 1 unit replaces $x$ with $x-1$: $y=(x-1)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "reflected across $x$-axis and translated 2 units up",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^2+2$",
          "worked": "Reflection gives $-x^2$; shifting up 2 units adds 2. Thus $y=-x^2+2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "reflected across $x$-axis, translated 3 units left",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x+3)^2$",
          "worked": "Reflection gives a negative coefficient; shifting left 3 units replaces $x$ with $x+3$. Thus $y=-(x+3)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "translated 5 units left and 3 units down",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+5)^2-3$",
          "worked": "Shifting left 5 units replaces $x$ with $x+5$; shifting down 3 units subtracts 3. Thus $y=(x+5)^2-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "translated 6 units right and 1 unit up",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-6)^2+1$",
          "worked": "Shifting right 6 units replaces $x$ with $x-6$; shifting up 1 unit adds 1. Thus $y=(x-6)^2+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
