  "content": {
    "id": "p13-q3",
    "type": "question",
    "label": "3",
    "prompt": "A square has vertices $A(2,-3)$, $B(6,3)$, $C(0,7)$ and $D(-4,1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p13-q3-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 13 p13-q3-diagram\"}\n\\begin{tikzpicture}[x=0.42cm,y=0.42cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-6,-5) rectangle (8,9);\n\\draw[<->,black,line width=0.5pt] (-5.5,0)--(7.8,0) node[below left,font=\\fontsize{10}{12}\\selectfont] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-4.5)--(0,8.7) node[above left,font=\\fontsize{10}{12}\\selectfont] {$y$};\n\\coordinate (A) at (2,-3);\n\\coordinate (B) at (6,3);\n\\coordinate (C) at (0,7);\n\\coordinate (D) at (-4,1);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--(D)--cycle;\n\\foreach \\P in {A,B,C,D} {\\fill[black] (\\P) circle (1.5pt);}\n\\node[below right,black,font=\\fontsize{10}{12}\\selectfont] at (A) {$A$};\n\\node[above right,black,font=\\fontsize{10}{12}\\selectfont] at (B) {$B$};\n\\node[above right,black,font=\\fontsize{10}{12}\\selectfont] at (C) {$C$};\n\\node[above left,black,font=\\fontsize{10}{12}\\selectfont] at (D) {$D$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
