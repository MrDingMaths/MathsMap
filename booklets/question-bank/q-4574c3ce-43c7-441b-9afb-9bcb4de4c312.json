  "content": {
    "id": "p20-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Write the following in index form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q13-abc",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q13-a",
            "type": "part",
            "label": "a",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p20-q13-a-given",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 1.5,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "\\mathrel{\\phantom{=}}\\sqrt{2\\sqrt{2}}",
                      "display": false
                    }
                  ]
                },
                {
                  "id": "p20-q13-a-scaffold",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "\\begin{aligned}&=\\left(2\\sqrt{2}\\right)^{\\frac12}\\\\&=\\left(2^1\\times2^{\\frac12}\\right)^{\\frac12}\\\\&=\\end{aligned}",
                      "display": false,
                      "colour": "#268cff"
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{\\frac34}$",
              "worked": "$$\\begin{aligned}\\sqrt{2\\sqrt{2}}&=\\left(2^1\\times2^{\\frac12}\\right)^{\\frac12}\\\\&=\\left(2^{\\frac32}\\right)^{\\frac12}\\\\&=2^{\\frac34}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p20-q13-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\sqrt{2\\sqrt{2\\sqrt{2}}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{\\frac78}$",
              "worked": "$$\\begin{aligned}\\sqrt{2\\sqrt{2\\sqrt{2}}}&=\\left(2^1\\times2^{\\frac34}\\right)^{\\frac12}\\\\&=\\left(2^{\\frac74}\\right)^{\\frac12}\\\\&=2^{\\frac78}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p20-q13-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\sqrt{2\\sqrt{2\\sqrt{2\\sqrt{2}}}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{\\frac{15}{16}}$",
              "worked": "$$\\begin{aligned}\\sqrt{2\\sqrt{2\\sqrt{2\\sqrt{2}}}}&=\\left(2^1\\times2^{\\frac78}\\right)^{\\frac12}\\\\&=\\left(2^{\\frac{15}{8}}\\right)^{\\frac12}\\\\&=2^{\\frac{15}{16}}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      },
      {
        "id": "p20-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "With $n$ twos, the fractional index has denominator $2^n$ and numerator $2^n-1$.",
          "worked": "The indices are $\\frac34$, $\\frac78$ and $\\frac{15}{16}$. Each numerator is one less than its denominator. With $n$ twos, the denominator is $2^n$ and the numerator is $2^n-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "What would be $\\sqrt{2\\sqrt{2\\sqrt{2\\sqrt{2}}}}\\ldots$ with 6 twos?\n\nAnswer in index form and check your answer using a calculator, giving both calculator values to 6 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{\\frac{63}{64}}$. Calculator check: both forms give approximately $1.978456$.",
          "worked": "$$\\begin{aligned}\\text{Index}&=\\frac{2^6-1}{2^6}\\\\&=\\frac{63}{64}\\end{aligned}$$\nThe index form is $2^{\\frac{63}{64}}$.\n\nCalculator check: $\\sqrt{2\\sqrt{2\\sqrt{2\\sqrt{2\\sqrt{2\\sqrt{2}}}}}}\\approx1.978456$ and $2^{\\frac{63}{64}}\\approx1.978456$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "What would be $\\sqrt{2\\sqrt{2\\sqrt{2\\sqrt{2}}}}\\ldots$ with $n$ twos? Answer in index form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{\\frac{2^n-1}{2^n}}$",
          "worked": "With $n$ twos, the fractional index has denominator $2^n$ and numerator $2^n-1$. Hence the index form is $2^{\\frac{2^n-1}{2^n}}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
