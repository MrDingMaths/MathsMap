  "content": {
    "id": "p26-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Fatima is thirty years older than her daughter, but is two years younger than her husband. If the sum of their ages is eighty years, then how old is Fatima?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Fatima is 36 years old.",
      "worked": "Let Fatima's age be $x$ years. Her daughter is $x-30$ years old and her husband is $x+2$ years old.\n\n$$\\begin{align*}x+(x-30)+(x+2)&=80\\\\3x-28&=80\\\\3x&=108\\\\x&=36\\end{align*}$$\n\nTherefore, Fatima is 36 years old.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
