  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify, if possible.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3x+6}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$",
          "worked": "$$\\begin{align*}\\frac{3x+6}{3}&=\\frac{3(x+2)}{3}\\\\&=x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3x+6}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{3x+6}{x+2}&=\\frac{3(x+2)}{x+2}\\\\&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3x+6}{x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cannot simplify.",
          "worked": "$$\\begin{align*}\\frac{3x+6}{x+6}&=\\frac{3(x+2)}{x+6}\\end{align*}$$\nThe numerator and denominator share no common factor other than 1, so the fraction cannot be simplified.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3x+6}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{2}$",
          "worked": "$$\\begin{align*}\\frac{3x+6}{6}&=\\frac{3(x+2)}{3\\times2}\\\\&=\\frac{x+2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3x+6}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{x}$",
          "worked": "$$\\begin{align*}\\frac{3x+6}{3x}&=\\frac{3(x+2)}{3x}\\\\&=\\frac{x+2}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{3x+6}{9x+18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3}$",
          "worked": "$$\\begin{align*}\\frac{3x+6}{9x+18}&=\\frac{3(x+2)}{9(x+2)}\\\\&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{3x+6}{3x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{3x+6}{3x+6}&=\\frac{3(x+2)}{3(x+2)}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{3x+6}{3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cannot simplify.",
          "worked": "$$\\begin{align*}\\frac{3x+6}{3x+2}&=\\frac{3(x+2)}{3x+2}\\end{align*}$$\nThe numerator and denominator share no common factor other than 1, so the fraction cannot be simplified.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
