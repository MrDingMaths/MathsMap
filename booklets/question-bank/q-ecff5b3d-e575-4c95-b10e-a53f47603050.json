      "evidence": ".booklet-work/reasoning-ratings/calls/logarithms-v1/4c2e5995df7310707f7cf78e360e5e650ce98f11f544c8f1f8c5f7b44f3af96e-1792560614807/last-message.txt"
    }
  },
  "content": {
    "id": "p17-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "If $x=\\log_a 2$, $y=\\log_a 3$ and $z=\\log_a 5$, write in terms of $x,y,z$:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a 64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x$",
          "worked": "$$\\begin{align*}\\log_a 64&=\\log_a 2^6\\\\&=6\\log_a 2\\\\&=6x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a\\frac{1}{30}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x-y-z$",
          "worked": "$$\\begin{align*}\\log_a\\frac1{30}&=-\\log_a(2\\times3\\times5)\\\\&=-\\log_a2-\\log_a3-\\log_a5\\\\&=-x-y-z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a 27\\,a^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3y+5$",
          "worked": "$$\\begin{align*}\\log_a(27a^5)&=\\log_a 3^3+\\log_a a^5\\\\&=3\\log_a3+5\\log_a a\\\\&=3y+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_a\\frac{100}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+2z-1$",
          "worked": "$$\\begin{align*}\\log_a\\frac{100}{a}&=\\log_a(2^2\\times5^2)-\\log_a a\\\\&=2\\log_a2+2\\log_a5-1\\\\&=2x+2z-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_a 1.5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y-x$",
          "worked": "$$\\begin{align*}\\log_a 1.5&=\\log_a\\frac32\\\\&=\\log_a3-\\log_a2\\\\&=y-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a\\frac{18}{25a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-2z-1$",
          "worked": "$$\\begin{align*}\\log_a\\frac{18}{25a}&=\\log_a(2\\times3^2)-\\log_a(5^2a)\\\\&=\\log_a2+2\\log_a3-2\\log_a5-\\log_a a\\\\&=x+2y-2z-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q14-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_a 0.04$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2z$",
          "worked": "$$\\begin{align*}\\log_a 0.04&=\\log_a\\frac1{25}\\\\&=\\log_a5^{-2}\\\\&=-2\\log_a5\\\\&=-2z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q14-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_a\\frac{8}{15a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x-y-z-2$",
          "worked": "$$\\begin{align*}\\log_a\\frac8{15a^2}&=\\log_a2^3-\\log_a(3\\times5\\times a^2)\\\\&=3\\log_a2-\\log_a3-\\log_a5-2\\log_a a\\\\&=3x-y-z-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
