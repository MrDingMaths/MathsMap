  "content": {
    "id": "v2-6eff0-p80-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Find the initial population in each case, to the nearest whole number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-6eff0-p80-practice-slot-9-slot-9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The population $P$ of frogs in a wetland satisfies $\\dfrac{dP}{dt}=0.2P\\left(1-\\dfrac{P}{2000}\\right)$, with $t$ in years. After 5 years the population is 1000. Use $\\dfrac{2000}{P(2000-P)}=\\dfrac1P+\\dfrac1{2000-P}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(0)=\\dfrac{2000}{1+e}\\approx538$.",
          "worked": "$$\\begin{align*}\\frac{dt}{dP}&=\\frac{10\\,000}{P(2000-P)}\\\\\\frac{dt}{dP}&=5\\left(\\frac1P+\\frac1{2000-P}\\right)\\\\t&=5\\bigl(\\ln|P|-\\ln|2000-P|\\bigr)+D\\\\\\frac{P}{2000-P}&=Ae^{t/5}.\\end{align*}$$\nUsing $P(5)=1000$,\n$$\\begin{align*}1&=Ae\\\\A&=e^{-1}.\\end{align*}$$\nAt $t=0$,\n$$\\begin{align*}\\frac{P}{2000-P}&=e^{-1}\\\\eP&=2000-P\\\\P&=\\frac{2000}{1+e}\\\\&\\approx538.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 85
      },
      {
        "id": "v2-6eff0-p80-practice-slot-9-slot-9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The population $N$ of koalas on an island satisfies $\\dfrac{dN}{dt}=0.5N\\left(1-\\dfrac{N}{600}\\right)$, with $t$ in years. After 4 years the population is 450. Use $\\dfrac{600}{N(600-N)}=\\dfrac1N+\\dfrac1{600-N}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$N(0)=\\dfrac{1800}{e^2+3}\\approx173$.",
          "worked": "$$\\begin{align*}\\frac{dt}{dN}&=\\frac{1200}{N(600-N)}\\\\\\frac{dt}{dN}&=2\\left(\\frac1N+\\frac1{600-N}\\right)\\\\t&=2\\bigl(\\ln|N|-\\ln|600-N|\\bigr)+D\\\\\\frac{N}{600-N}&=Ae^{t/2}.\\end{align*}$$\nUsing $N(4)=450$,\n$$\\begin{align*}3&=Ae^2\\\\A&=3e^{-2}.\\end{align*}$$\nAt $t=0$,\n$$\\begin{align*}\\frac{N}{600-N}&=3e^{-2}\\\\e^2N&=1800-3N\\\\N&=\\frac{1800}{e^2+3}\\\\&\\approx173.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 85
      }
    ]
  },
