  "content": {
    "id": "p30-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Find the value of $x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{63}-\\sqrt{28}=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$",
          "worked": "$$\\begin{align*}\\sqrt{x}&=3\\sqrt{7}-2\\sqrt{7}\\\\&=\\sqrt{7}\\\\x&=(\\sqrt{7})^2\\\\&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p30-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{80}-\\sqrt{20}=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=20$",
          "worked": "$$\\begin{align*}\\sqrt{x}&=4\\sqrt{5}-2\\sqrt{5}\\\\&=2\\sqrt{5}\\\\x&=(2\\sqrt{5})^2\\\\&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p30-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sqrt{150}-3\\sqrt{24}=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=96$",
          "worked": "$$\\begin{align*}\\sqrt{x}&=2(5\\sqrt{6})-3(2\\sqrt{6})\\\\&=10\\sqrt{6}-6\\sqrt{6}\\\\&=4\\sqrt{6}\\\\x&=(4\\sqrt{6})^2\\\\&=96\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
