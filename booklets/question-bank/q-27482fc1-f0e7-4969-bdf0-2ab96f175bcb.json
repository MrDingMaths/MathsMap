  "content": {
    "id": "p9-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "In a packet of jelly beans, $\\frac{1}{3}$ of the jelly beans are purple, $\\frac{1}{8}$ are black and $\\frac{1}{4}$ are red.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the jelly beans are either purple or black?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{24}$",
          "worked": "$$\\begin{align*}\\frac{1}{3}+\\frac{1}{8}&=\\frac{8}{24}+\\frac{3}{24}\\\\\\frac{1}{3}+\\frac{1}{8}&=\\frac{11}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the jelly beans are either purple or red?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{12}$",
          "worked": "$$\\begin{align*}\\frac{1}{3}+\\frac{1}{4}&=\\frac{4}{12}+\\frac{3}{12}\\\\\\frac{1}{3}+\\frac{1}{4}&=\\frac{7}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "What fraction of the jelly beans are purple or red or black?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{24}$",
          "worked": "$$\\begin{align*}\\frac{1}{3}+\\frac{1}{4}+\\frac{1}{8}&=\\frac{8}{24}+\\frac{6}{24}+\\frac{3}{24}\\\\\\frac{1}{3}+\\frac{1}{4}+\\frac{1}{8}&=\\frac{17}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "What fraction of the jelly beans are not purple or red or black?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{24}$",
          "worked": "Subtract the fraction in the three named colours from the whole packet.\n\n$$\\begin{align*}1-\\frac{17}{24}&=\\frac{24}{24}-\\frac{17}{24}\\\\1-\\frac{17}{24}&=\\frac{7}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
