  "content": {
    "id": "p16-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The length of a swimming pool is 2 m more than four times its width.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "If $x$ metres represents the width of the pool, express the length of the pool in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x+2)\\text{ m}$",
          "worked": "Four times the width is $4x$ metres, so the length is $(4x+2)\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p16-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "If the perimeter of the pool is 124 m find the length and width of the pool.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Length $50\\text{ m}$, width $12\\text{ m}$.",
          "worked": "Using width $x$ metres and length $(4x+2)$ metres,\n$$\\begin{align*}x+x+(4x+2)+(4x+2)&=124\\\\10x+4&=124\\\\10x&=120\\\\x&=12\\end{align*}$$\nThe width is $12\\text{ m}$. The length is $(4\\times12+2)\\text{ m}=50\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
