  "content": {
    "id": "p11-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Annie’s bank account is halved in value and then $\\$20$ is removed.\nIf it initially had $\\$A$ in it, write an algebraic fraction for the amount left.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{A-40}{2}$ dollars",
      "worked": "Amount left, in dollars:\n$$\\begin{align*}\\frac{A}{2}-20 &= \\frac{A}{2}-\\frac{40}{2}\\\\&=\\frac{A-40}{2}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
