  "content": {
    "id": "p23-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Let $x^3+5x-1=0$ have roots $\\alpha$, $\\beta$ and $\\gamma$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $\\alpha^2+\\beta^2+\\gamma^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10$",
          "worked": "$$\\begin{aligned}\\alpha^2+\\beta^2+\\gamma^2&=(\\alpha+\\beta+\\gamma)^2-2(\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma)\\\\&=0^2-2(5)\\\\&=-10\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p23-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, explain why the graph of $y=x^3+5x-1$ cannot have 3 $x$-intercepts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If all three roots were real, their squares would have a non-negative sum. Since the sum is $-10$, the roots cannot all be real, so the graph cannot have 3 $x$-intercepts.",
          "worked": "A cubic has three roots, counting multiplicity. If all three were real, $\\alpha^2+\\beta^2+\\gamma^2\\geq0$. Part a gives $\\alpha^2+\\beta^2+\\gamma^2=-10$, so the roots cannot all be real. Hence the graph cannot have 3 $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
