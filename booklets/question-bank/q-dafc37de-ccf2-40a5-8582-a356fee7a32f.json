  "content": {
    "id": "p15-q7",
    "type": "question",
    "label": "7",
    "prompt": "A cone with a radius of 5 cm has a total surface area of $200\\pi\\text{ cm}^2$.\n\nWhat is the perpendicular height of the cone? Answer in exact form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20\\sqrt{3}\\text{ cm}$",
      "worked": "$$\\begin{align*}\n\\pi r^2+\\pi rl&=200\\pi\\\\\n\\pi(5)^2+\\pi(5)l&=200\\pi\\\\\n25+5l&=200\\\\\nl&=35\\text{ cm}\n\\end{align*}$$\nUsing Pythagoras:\n$$\\begin{align*}\nh^2&=l^2-r^2\\\\\nh^2&=35^2-5^2\\\\\nh^2&=1200\\\\\nh&=20\\sqrt{3}\\text{ cm}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
