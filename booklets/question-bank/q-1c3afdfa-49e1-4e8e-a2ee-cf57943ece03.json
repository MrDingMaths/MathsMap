  "content": {
    "id": "p39-q1-7-root",
    "type": "question",
    "label": null,
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p39-q1-7-shared-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "True or False?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q1-7-a",
        "type": "part",
        "label": "a",
        "prompt": "The highest common factor of $8!$ and $10!$ is $8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. It is $8!$.",
          "worked": "$10!=10\\times9\\times8!$, so $8!$ divides both factorials. Their highest common factor is $8!$, not $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p39-q1-7-b",
        "type": "part",
        "label": "b",
        "prompt": "The lowest common multiple of $8!$ and $10!$ is $10!$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$10!=10\\times9\\times8!$, so $10!$ is a multiple of $8!$. Their lowest common multiple is therefore $10!$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p39-q1-7-c",
        "type": "part",
        "label": "c",
        "prompt": "$8!+9!=17!$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}8!+9!&=8!+9\\times8!\\\\8!+9!&=10\\times8!\\end{align*}$$\nThis is not $17!$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p39-q1-7-d",
        "type": "part",
        "label": "d",
        "prompt": "$7!+8!=7!\\times(1+8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}7!+8!&=7!+8\\times7!\\\\7!+8!&=7!(1+8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p39-q1-7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{n!}{(n+1)!}=\\dfrac{1}{n+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}\\frac{n!}{(n+1)!}&=\\frac{n!}{(n+1)n!}\\\\\\frac{n!}{(n+1)!}&=\\frac{1}{n+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p39-q1-7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{6!+5!}{6!-5!}=\\dfrac{6+1}{6-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}\\frac{6!+5!}{6!-5!}&=\\frac{5!(6+1)}{5!(6-1)}\\\\\\frac{6!+5!}{6!-5!}&=\\frac{6+1}{6-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p39-q1-7-g",
        "type": "part",
        "label": "g",
        "prompt": "$n!+2!=(n+2)!$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "For $n=1$, $n!+2!=1+2=3$, whereas $(n+2)!=3!=6$. The statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
