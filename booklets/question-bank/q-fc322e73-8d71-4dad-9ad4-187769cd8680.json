  "content": {
    "id": "index-t2-q16-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t2-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$7^{5a} \\div 7^{2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{3a}$",
          "worked": "$$\\begin{align*}7^{5a} \\div 7^{2a}&=7^{5a-2a} \\\\ &=7^{3a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t2-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$y^{5x + 3} \\div y^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^{3x + 3}$",
          "worked": "$$\\begin{align*}y^{5x + 3} \\div y^{2x}&=y^{5x+3-2x} \\\\ &=y^{3x + 3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t2-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$y^{2m + 3} \\div y^{m + 5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^{m - 2}$",
          "worked": "$$\\begin{align*}y^{2m + 3} \\div y^{m + 5}&=y^{2m+3-(m+5)} \\\\ &=y^{2m+3-m-5} \\\\ &=y^{m - 2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
