        "prompt": "$\\displaystyle\\int 3^{5x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{3^{5x}}{5\\ln 3}+C$",
          "worked": "$$\\begin{align*}\\int 3^{5x}\\,dx&=\\frac{1}{5}\\int 5\\cdot3^{5x}\\,dx\\\\&=\\frac{1}{5}\\cdot\\frac{3^{5x}}{\\ln 3}+C\\\\&=\\frac{3^{5x}}{5\\ln 3}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p71-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int 6^{2x+7}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{6^{2x+7}}{2\\ln 6}+C$",
          "worked": "$$\\begin{align*}\\int 6^{2x+7}\\,dx&=\\frac{1}{2}\\int 2\\cdot6^{2x+7}\\,dx\\\\&=\\frac{1}{2}\\cdot\\frac{6^{2x+7}}{\\ln 6}+C\\\\&=\\frac{6^{2x+7}}{2\\ln 6}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p71-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int 5\\times7^{4-9x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle-\\frac{5\\times7^{4-9x}}{9\\ln 7}+C$",
          "worked": "$$\\begin{align*}\\int 5\\times7^{4-9x}\\,dx&=5\\int 7^{4-9x}\\,dx\\\\&=-\\frac{5}{9}\\int(-9)7^{4-9x}\\,dx\\\\&=-\\frac{5}{9}\\cdot\\frac{7^{4-9x}}{\\ln 7}+C\\\\&=-\\frac{5\\times7^{4-9x}}{9\\ln 7}+C\\end{align*}$$",
