  "content": {
    "id": "p44-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the number of circular arrangements of the word QUARTIC if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6!=720$.",
          "worked": "The seven letters are distinct. Rotations represent the same circular arrangement.\n\n$$\\begin{align*}N&=(7-1)!\\\\N&=6!\\\\N&=720.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "the vowels are all together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p44-q10-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "4!\\times3!=144",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p44-q10-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Treat U, A and I as one block; arrange five entities in a circle and the three vowels within their block.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Treat the vowels U, A and I as one block. Together with Q, R, T and C, this gives five distinct entities in a circle. The vowels have $3!$ internal arrangements.\n\n$$\\begin{align*}N&=(5-1)!\\times3!\\\\N&=4!\\times3!\\\\N&=144.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
