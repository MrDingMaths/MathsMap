    "answer": {
      "short": "$11$",
      "worked": "$$\\begin{align*}16\\cos^2\\theta+4(1-\\cos^2\\theta)&=5\\\\12\\cos^2\\theta&=1\\\\\\cos^2\\theta&=\\frac{1}{12}\\\\\\sin^2\\theta&=1-\\frac{1}{12}\\\\\\sin^2\\theta&=\\frac{11}{12}\\\\\\tan^2\\theta&=\\frac{11/12}{1/12}\\\\\\tan^2\\theta&=11.\\end{align*}$$",
      "solutionDiagrams": []
    },
