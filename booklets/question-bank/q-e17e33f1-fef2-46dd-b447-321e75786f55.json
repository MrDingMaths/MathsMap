      {
        "id": "v2-543ca-p31-practice-slot-12-slot-12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the possible values of $\\lambda$ if the projection of $3\\mathbf{i}+\\lambda\\mathbf{j}$ onto $3\\mathbf{i}-4\\mathbf{j}$ has length $3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\lambda=-\\dfrac32$ or $\\lambda=6$.",
          "worked": "$$\\begin{aligned}(3\\mathbf{i}+\\lambda\\mathbf{j})\\cdot(3\\mathbf{i}-4\\mathbf{j})&=9-4\\lambda\\\\|3\\mathbf{i}-4\\mathbf{j}|&=\\sqrt{9+16}=5\\\\|\\operatorname{proj}|&=\\frac{|9-4\\lambda|}{5}=3\\\\|9-4\\lambda|&=15\\\\9-4\\lambda&=15\\quad\\text{or}\\quad9-4\\lambda=-15\\\\\\lambda&=-\\frac32\\quad\\text{or}\\quad\\lambda=6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-543ca-p31-practice-slot-12-slot-12-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the possible values of $\\lambda$ if the projection of $\\begin{pmatrix}\\lambda\\\\5\\end{pmatrix}$ onto $\\begin{pmatrix}1\\\\1\\end{pmatrix}$ has length $3\\sqrt2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\lambda=1$ or $\\lambda=-11$.",
          "worked": "$$\\begin{aligned}\\begin{pmatrix}\\lambda\\\\5\\end{pmatrix}\\cdot\\begin{pmatrix}1\\\\1\\end{pmatrix}&=\\lambda+5\\\\\\left|\\begin{pmatrix}1\\\\1\\end{pmatrix}\\right|&=\\sqrt2\\\\|\\operatorname{proj}|&=\\frac{|\\lambda+5|}{\\sqrt2}=3\\sqrt2\\\\|\\lambda+5|&=6\\\\\\lambda+5&=6\\quad\\text{or}\\quad\\lambda+5=-6\\\\\\lambda&=1\\quad\\text{or}\\quad\\lambda=-11\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
