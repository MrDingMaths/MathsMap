              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{50}{100}\\;\\longrightarrow\\;\\frac{25}{50}\\;\\longrightarrow\\;\\frac{5}{10}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; $\\frac{1}{2}$.",
          "worked": "No. The numerator and denominator still have a common factor of $5$.\n$$\\begin{align*}\\frac{5}{10}&=\\frac{5\\div5}{10\\div5}\\\\\\frac{5}{10}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p29-q5-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
