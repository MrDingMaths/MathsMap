                  "type": "math",
                  "latex": "\\frac{16}{20}\\;\\longrightarrow\\;\\frac{8}{10}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; $\\frac{4}{5}$.",
          "worked": "No. The numerator and denominator still have a common factor of $2$.\n$$\\begin{align*}\\frac{8}{10}&=\\frac{8\\div2}{10\\div2}\\\\\\frac{8}{10}&=\\frac{4}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
