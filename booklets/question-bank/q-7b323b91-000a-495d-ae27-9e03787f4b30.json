  "content": {
    "id": "p29-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Wally says he has simplified these fractions as much as he can. Is he correct?\nIf not, find the simplest fraction in each case.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
