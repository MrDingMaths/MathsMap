              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{24}{36}\\;\\longrightarrow\\;\\frac{4}{6}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; $\\frac{2}{3}$.",
          "worked": "No. The numerator and denominator still have a common factor of $2$.\n$$\\begin{align*}\\frac{4}{6}&=\\frac{4\\div2}{6\\div2}\\\\\\frac{4}{6}&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
