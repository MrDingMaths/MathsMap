        "answer": {
          "short": "$\\frac{4(\\sqrt5+\\sqrt2)}3$",
          "worked": "$$\\begin{align*}\\frac4{\\sqrt5-\\sqrt2}&=\\frac4{\\sqrt5-\\sqrt2}\\times\\frac{\\sqrt5+\\sqrt2}{\\sqrt5+\\sqrt2}\\\\\\frac4{\\sqrt5-\\sqrt2}&=\\frac{4(\\sqrt5+\\sqrt2)}{5-2}\\\\\\frac4{\\sqrt5-\\sqrt2}&=\\frac{4(\\sqrt5+\\sqrt2)}3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{\\sqrt3}{\\sqrt5+\\sqrt2}$",
