        "id": "p20-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt5-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt5+2$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt5-2}&=\\frac1{\\sqrt5-2}\\times\\frac{\\sqrt5+2}{\\sqrt5+2}\\\\\\frac1{\\sqrt5-2}&=\\frac{\\sqrt5+2}{5-4}\\\\\\frac1{\\sqrt5-2}&=\\sqrt5+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{7+\\sqrt6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7-\\sqrt6}{43}$",
          "worked": "$$\\begin{align*}\\frac1{7+\\sqrt6}&=\\frac1{7+\\sqrt6}\\times\\frac{7-\\sqrt6}{7-\\sqrt6}\\\\\\frac1{7+\\sqrt6}&=\\frac{7-\\sqrt6}{49-6}\\\\\\frac1{7+\\sqrt6}&=\\frac{7-\\sqrt6}{43}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{\\sqrt6+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3(\\sqrt6-2)}2$",
          "worked": "$$\\begin{align*}\\frac3{\\sqrt6+2}&=\\frac3{\\sqrt6+2}\\times\\frac{\\sqrt6-2}{\\sqrt6-2}\\\\\\frac3{\\sqrt6+2}&=\\frac{3(\\sqrt6-2)}{6-4}\\\\\\frac3{\\sqrt6+2}&=\\frac{3(\\sqrt6-2)}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{6}{2-\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(2+\\sqrt3)$",
          "worked": "$$\\begin{align*}\\frac6{2-\\sqrt3}&=\\frac6{2-\\sqrt3}\\times\\frac{2+\\sqrt3}{2+\\sqrt3}\\\\\\frac6{2-\\sqrt3}&=\\frac{6(2+\\sqrt3)}{4-3}\\\\\\frac6{2-\\sqrt3}&=6(2+\\sqrt3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{2}{\\sqrt3-\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(\\sqrt3+\\sqrt2)$",
          "worked": "$$\\begin{align*}\\frac2{\\sqrt3-\\sqrt2}&=\\frac2{\\sqrt3-\\sqrt2}\\times\\frac{\\sqrt3+\\sqrt2}{\\sqrt3+\\sqrt2}\\\\\\frac2{\\sqrt3-\\sqrt2}&=\\frac{2(\\sqrt3+\\sqrt2)}{3-2}\\\\\\frac2{\\sqrt3-\\sqrt2}&=2(\\sqrt3+\\sqrt2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{4}{\\sqrt5-\\sqrt2}$",
