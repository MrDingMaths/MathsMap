        "answer": {
          "short": "$(2x+1-2\\sqrt{5})(2x+1+2\\sqrt{5})$",
          "worked": "$$\\begin{align*}(2x+1)^2-20&=(2x+1)^2-(\\sqrt{20})^2\\\\(2x+1)^2-20&=(2x+1)^2-(2\\sqrt{5})^2\\\\(2x+1)^2-20&=(2x+1-2\\sqrt{5})(2x+1+2\\sqrt{5})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
