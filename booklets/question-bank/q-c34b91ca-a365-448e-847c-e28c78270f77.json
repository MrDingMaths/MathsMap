  "content": {
    "id": "p47-q02-content",
    "type": "question",
    "label": "2",
    "prompt": "Find the value of $k$ and $a$ such that $2^{3x+1}=k\\times3^{ax}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
