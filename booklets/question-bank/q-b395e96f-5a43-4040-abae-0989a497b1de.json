  "content": {
    "id": "p35-q70-root",
    "type": "question",
    "label": "70",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p35-q70-stem-1",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A small business sells two types of bags: standard and premium. The business has a fixed daily cost of $300, a variable cost of $10 for each standard bag and $16 for each premium bag. The selling prices are $",
              "marks": []
            },
            {
              "type": "math",
              "latex": "s",
              "display": false
            },
            {
              "type": "text",
              "text": " for a standard bag and $",
              "marks": []
            },
            {
              "type": "math",
              "latex": "p",
              "display": false
            },
            {
              "type": "text",
              "text": " for a premium bag.",
              "marks": []
            }
          ]
        },
        {
          "id": "p35-q70-stem-2",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "On a weekday, the business sold 20 standard bags and 15 premium bags and made a profit of $360. On a weekend, it sold 30 standard bags and 10 premium bags and made a profit of $390.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q70-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the total daily cost $C$ in terms of the numbers of standard bags $x$ and premium bags $y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=300+10x+16y$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q70-a-worked-explanation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the fixed daily cost and the production costs of both types of bag. The total cost, in dollars, is",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-a-worked-equation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "C=300+10x+16y.",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p35-q70-b",
        "type": "part",
        "label": "b",
        "prompt": "Find equations for the weekday and weekend profits, each in terms of $s$ and $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Weekday: $4s+3p=220$.\n\nWeekend: $3s+p=115$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q70-b-worked-model",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Profit is revenue minus cost. Add the revenue from both products and deduct the fixed cost once per day.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-b-worked-weekday-label",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Weekday:",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-b-worked-weekday-equations",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}20s+15p-(300+20\\times10+15\\times16)&=360\\\\20s+15p&=1100\\\\4s+3p&=220\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p35-q70-b-worked-weekend-label",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Weekend:",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-b-worked-weekend-equations",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}30s+10p-(300+30\\times10+10\\times16)&=390\\\\30s+10p&=1150\\\\3s+p&=115\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p35-q70-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the selling price of each bag.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q70-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Standard: $25; premium: $40.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "p=115-3s",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " into ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "4s+3p=220",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q70-c-worked-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Isolate ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "p",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " in the weekend equation and substitute its equal expression into the weekday equation.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-c-worked-substitution",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}p&=115-3s\\\\4s+3(115-3s)&=220\\\\-5s&=-125\\\\s&=25\\\\p&=115-3(25)\\\\p&=40\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p35-q70-c-worked-check-label",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Check both original daily profits:",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-c-worked-checks",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}20(25)+15(40)-740&=360\\\\30(25)+10(40)-760&=390\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p35-q70-c-worked-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Standard bags sell for $25 each and premium bags for $40 each.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p35-q70-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the profit if on another day, the business sells 40 standard bags and 20 premium bags.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q70-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "$780.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Subtract the total daily cost from the total sales revenue.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q70-d-worked-units",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Revenue, cost and profit are in dollars.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p35-q70-d-worked-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}R&=40(25)+20(40)\\\\R&=1800\\\\C&=300+40(10)+20(16)\\\\C&=1020\\\\P&=1800-1020\\\\P&=780\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p35-q70-d-worked-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The profit is $780.",
                    "marks": []
                  }
                ]
              }
            ]
          },
