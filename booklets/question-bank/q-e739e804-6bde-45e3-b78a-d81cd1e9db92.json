        "prompt": "$\\frac{1}{\\sqrt{12}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.29$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{12}}&=\\frac{1}{2\\sqrt3}\\\\\\frac{1}{\\sqrt{12}}&=\\frac{1}{2\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}\\\\\\frac{1}{\\sqrt{12}}&=\\frac{\\sqrt3}{6}\\\\\\frac{1}{\\sqrt{12}}&\\approx\\frac{1.732}{6}=0.2886\\ldots\\\\\\frac{1}{\\sqrt{12}}&\\approx0.29\\end{align*}$$\nCorrect to 2 decimal places.",
