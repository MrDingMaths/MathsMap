  "content": {
    "id": "p26-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Given that $\\sqrt2\\approx1.412$ and $\\sqrt3\\approx1.732$, find these values, correct to 2 decimal places, without using a calculator. (First rationalise the denominator where appropriate.)",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.71$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt2}&=\\frac{1}{\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}\\\\\\frac{1}{\\sqrt2}&=\\frac{\\sqrt2}{2}\\\\\\frac{1}{\\sqrt2}&\\approx\\frac{1.412}{2}=0.706\\\\\\frac{1}{\\sqrt2}&\\approx0.71\\end{align*}$$\nCorrect to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p26-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.58$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt3}&=\\frac{1}{\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}\\\\\\frac{1}{\\sqrt3}&=\\frac{\\sqrt3}{3}\\\\\\frac{1}{\\sqrt3}&\\approx\\frac{1.732}{3}=0.5773\\ldots\\\\\\frac{1}{\\sqrt3}&\\approx0.58\\end{align*}$$\nCorrect to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p26-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.12$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt2}&=\\frac{3}{\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}\\\\\\frac{3}{\\sqrt2}&=\\frac{3\\sqrt2}{2}\\\\\\frac{3}{\\sqrt2}&\\approx\\frac{3\\times1.412}{2}=2.118\\\\\\frac{3}{\\sqrt2}&\\approx2.12\\end{align*}$$\nCorrect to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p26-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5}{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.89$",
          "worked": "$$\\begin{align*}\\frac{5}{\\sqrt3}&=\\frac{5}{\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}\\\\\\frac{5}{\\sqrt3}&=\\frac{5\\sqrt3}{3}\\\\\\frac{5}{\\sqrt3}&\\approx\\frac{5\\times1.732}{3}=2.8866\\ldots\\\\\\frac{5}{\\sqrt3}&\\approx2.89\\end{align*}$$\nCorrect to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p26-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.46$",
          "worked": "$$\\begin{align*}\\sqrt{12}&=\\sqrt{4\\times3}\\\\\\sqrt{12}&=2\\sqrt3\\\\\\sqrt{12}&\\approx2\\times1.732=3.464\\\\\\sqrt{12}&\\approx3.46\\end{align*}$$\nCorrect to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q3-f",
