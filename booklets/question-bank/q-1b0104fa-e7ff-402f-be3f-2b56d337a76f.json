  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "An amount is increased by $80\\%$ and then the result is decreased by $20\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find a single increase that would give the same overall result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$44\\%$ increase.\n\nThe combined multiplier is $1.8\\times0.8=1.44$.",
          "worked": "$$\\begin{align*}1.8\\times0.8&=1.44\\\\(1.44-1)\\times100\\%&=44\\%\\end{align*}$$\nA single increase of $44\\%$ gives the same result.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find two equal consecutive increases that would give the same overall result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two consecutive increases of $20\\%$ each.\n\nEach multiplier is $1.2$, and $1.2\\times1.2=1.44$.",
          "worked": "$$\\begin{align*}1.8\\times0.8&=1.44\\\\1.2\\times1.2&=1.44\\\\(1.2-1)\\times100\\%&=20\\%\\end{align*}$$\nTwo consecutive increases of $20\\%$ each give the same result.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
