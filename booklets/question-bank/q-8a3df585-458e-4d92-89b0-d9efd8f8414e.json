      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of households have no cars?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "$P(X=0)=0.25=\\frac14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of households have fewer than 2 cars?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac34$",
          "worked": "$$\\begin{aligned}P(X<2)&=P(X=0)+P(X=1)\\\\&=0.25+0.50\\\\&=\\frac34.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the probability that a randomly selected household has three cars?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.1$",
          "worked": "The bar at 3 cars has height $0.1$, so $P(X=3)=0.1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Planners advise additional on-street parking if more than 40% of households have 3 or more cars. Will they advise additional parking?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; $12.5\\%<40\\%$.",
          "worked": "$$\\begin{aligned}P(X\\ge3)&=0.10+0.025\\\\&=0.125\\\\&=12.5\\%.\\end{aligned}$$Since $12.5\\%<40\\%$, planners will not advise additional parking.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
