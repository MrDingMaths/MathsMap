  "content": {
    "id": "p15-q8-response",
    "type": "question",
    "label": "8",
    "prompt": "An interval $AB$ is $10\\text{ cm}$ in length. $C$ is a point on $AB$ such that the ratio of the length $AC$ to the length $CB$ is $3:2$. Find the lengths of $AC$ and $CB$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AC=6\\text{ cm}$ and $CB=4\\text{ cm}$.",
      "worked": "There are $3+2=5$ equal parts.\n$$\\begin{align*}\\text{Length of one part}&=10\\div5=2\\text{ cm}\\\\AC&=3\\times2=6\\text{ cm}\\\\CB&=2\\times2=4\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
