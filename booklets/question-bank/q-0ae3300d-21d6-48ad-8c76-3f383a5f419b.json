        "prompt": "How many multiples of 6 are there between 10 and 40?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Counting the list in part a gives $5$ multiples.",
