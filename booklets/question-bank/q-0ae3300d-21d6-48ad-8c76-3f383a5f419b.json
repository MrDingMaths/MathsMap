        "answer": {
          "short": "$12,\\ 18,\\ 24,\\ 30,\\ 36$",
          "worked": "$$\\begin{align*}6\\times2&=12\\\\6\\times3&=18\\\\6\\times4&=24\\\\6\\times5&=30\\\\6\\times6&=36\\end{align*}$$",
