    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q35-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\cos 3x=4\\cos^3x-3\\cos x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos 3x=4\\cos^3x-3\\cos x$.\n\nExpand $\\cos(2x+x)$ and substitute the double-angle identities.",
          "worked": "$$\\begin{align*}\\cos 3x&=\\cos(2x+x)\\\\\\cos 3x&=\\cos 2x\\cos x-\\sin 2x\\sin x\\\\\\cos 3x&=(2\\cos^2x-1)\\cos x-(2\\sin x\\cos x)\\sin x\\\\\\cos 3x&=2\\cos^3x-\\cos x-2(1-\\cos^2x)\\cos x\\\\\\cos 3x&=4\\cos^3x-3\\cos x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p49-q35-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, solve $\\cos 3x=\\cos x$ for $0^\\circ\\le x\\le360^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0^\\circ,90^\\circ,180^\\circ,270^\\circ,360^\\circ$.\n\nUse part (a) and factorise $4\\cos x(\\cos^2x-1)=0$.",
          "worked": "Using part (a),\n$$\\begin{align*}4\\cos^3x-3\\cos x&=\\cos x\\\\4\\cos^3x-4\\cos x&=0\\\\4\\cos x(\\cos^2x-1)&=0.\\end{align*}$$\nTherefore $\\cos x=0$ or $\\cos^2x=1$.\n$$\\begin{align*}\\cos x&=0,1,-1\\\\x&=0^\\circ,90^\\circ,180^\\circ,270^\\circ,360^\\circ.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
