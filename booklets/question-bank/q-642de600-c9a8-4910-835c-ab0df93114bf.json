                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}4(2-r^2)&<0\\\\r^2&>2\\\\r&<-\\sqrt{2}\\quad\\text{or}\\quad r>\\sqrt{2}.\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
