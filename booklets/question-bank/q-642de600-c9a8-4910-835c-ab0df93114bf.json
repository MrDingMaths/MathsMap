        "answer": {
          "short": "For $r=\\sqrt{2}$: $(-1-\\sqrt{2},0)$. For $r=-\\sqrt{2}$: $(\\sqrt{2}-1,0)$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p77-q8-d-tangency",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "At tangency, ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=-\\frac{b}{2a}=-\\frac{1}{r-1}.",
                    "display": false
                  }
                ]
              },
              {
                "id": "p77-q8-d-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r=\\sqrt{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ":",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x&=-\\frac{1}{\\sqrt{2}-1}\\\\x&=-\\frac{\\sqrt{2}+1}{(\\sqrt{2}-1)(\\sqrt{2}+1)}\\\\x&=-(\\sqrt{2}+1).\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "The point is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(-1-\\sqrt{2},0).",
                    "display": false
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r=-\\sqrt{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ":",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x&=-\\frac{1}{-\\sqrt{2}-1}\\\\x&=\\frac{1}{\\sqrt{2}+1}\\\\x&=\\sqrt{2}-1.\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "The point is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(\\sqrt{2}-1,0).",
                    "display": false
                  }
                ]
