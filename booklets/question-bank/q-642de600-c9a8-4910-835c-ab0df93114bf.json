        "answer": {
          "short": "Entirely above for $r>\\sqrt{2}$; entirely below for $r<-\\sqrt{2}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p77-q8-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "If ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r>\\sqrt{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", then ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r-1>0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so the parabola opens upwards and lies entirely above the ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": "-axis.",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "If ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r<-\\sqrt{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", then ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r-1<0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so the parabola opens downwards and lies entirely below the ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false
                  },
                  {
                    "type": "text",
