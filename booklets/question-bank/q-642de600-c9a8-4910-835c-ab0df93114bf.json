        "answer": {
          "short": "$\\Delta=4(2-r^2)$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p77-q8-a-coefficients",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=r-1,\\qquad b=2,\\qquad c=r+1.",
                    "display": false
                  }
                ]
              },
              {
                "id": "p77-q8-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\Delta&=b^2-4ac\\\\\\Delta&=2^2-4(r-1)(r+1)\\\\\\Delta&=4-4(r^2-1)\\\\\\Delta&=4(2-r^2).\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
