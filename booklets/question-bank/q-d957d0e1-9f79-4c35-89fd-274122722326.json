    "id": "v2-a6eb5da01-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "The population of cane toads in a region is currently increasing according to the formula $N=800e^{0.06t}$, where $t$ is in months. Find the population after 2 years and after 5 years, rounding to the nearest toad.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "After 2 years about $3377$ toads; after 5 years about $29\\,279$ toads.",
      "worked": "$2$ years $=24$ months.\n$$\\begin{align*}N&=800e^{0.06(24)}\\\\N&=800e^{1.44}\\\\N&\\approx3377\\end{align*}$$\n$5$ years $=60$ months.\n$$\\begin{align*}N&=800e^{0.06(60)}\\\\N&=800e^{3.6}\\\\N&\\approx29\\,279\\end{align*}$$",
      "solutionDiagrams": []
    },
