        "prompt": "Find $\\dfrac{d}{dx}(5-x^2-x)^7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7(2x+1)(5-x^2-x)^6$",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}(5-x^2-x)^7&=7(5-x^2-x)^6(-2x-1)\\\\&=-7(2x+1)(5-x^2-x)^6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p52-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int(-14x-7)(5-x^2-x)^6\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5-x^2-x)^7+C$",
          "worked": "$$\\begin{aligned}\\int(-14x-7)(5-x^2-x)^6\\,dx&=7\\int(-2x-1)(5-x^2-x)^6\\,dx\\\\&=7\\frac{(5-x^2-x)^7}{7}+C\\\\&=(5-x^2-x)^7+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p52-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int(2x+1)(5-x^2-x)^6\\,dx$",
        "layout": "list",
        "columns": null,
