    "type": "question",
    "label": "18",
    "prompt": "Show that $\\dfrac{6^{2x}}{3^x}=12^x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$$\\begin{aligned}\\frac{6^{2x}}{3^x}&=\\left(\\frac{6^2}{3}\\right)^x\\\\\\frac{6^{2x}}{3^x}&=12^x\\end{aligned}$$",
      "worked": "$$\\begin{align*}\\frac{6^{2x}}{3^x}&=\\frac{(6^2)^x}{3^x}\\\\\\frac{6^{2x}}{3^x}&=\\left(\\frac{36}{3}\\right)^x\\\\\\frac{6^{2x}}{3^x}&=12^x\\end{align*}$$",
      "solutionDiagrams": []
    },
