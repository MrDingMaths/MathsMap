    "children": [
      {
        "id": "p70-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{700}{P(700-P)}=\\dfrac{1}{P}+\\dfrac{1}{700-P}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{P}+\\dfrac{1}{700-P}=\\dfrac{700-P+P}{P(700-P)}=\\dfrac{700}{P(700-P)}$, as required.",
          "worked": "$$\\begin{align*}\\text{RHS}&=\\frac{700-P+P}{P(700-P)}\\\\\\text{RHS}&=\\frac{700}{P(700-P)}\\end{align*}$$\nThis equals the LHS, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p70-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve $\\dfrac{dP}{dt}=\\dfrac{1}{5}P\\left(1-\\dfrac{P}{700}\\right)$, $P(0)=140$. Find $P(t)$ and $P(10)$. Give $P(10)$ to the nearest whole number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(t)=\\dfrac{700}{1+4e^{-t/5}}$; $P(10)=\\dfrac{700}{1+4e^{-2}}\\approx454$.",
          "worked": "$$\\begin{align*}\\frac{dt}{dP}&=\\frac{5}{P\\left(1-\\frac{P}{700}\\right)}\\\\\\frac{dt}{dP}&=\\frac{5\\cdot700}{P(700-P)}\\\\\\frac{dt}{dP}&=5\\left(\\frac{1}{P}+\\frac{1}{700-P}\\right)\\end{align*}$$\nIntegrating gives\n$$\\begin{align*}t&=5\\bigl(\\ln|P|-\\ln|700-P|\\bigr)+D\\\\\\ln\\left|\\frac{P}{700-P}\\right|&=\\frac{t-D}{5}\\\\\\frac{P}{700-P}&=Ae^{t/5}\\end{align*}$$\nUsing $P(0)=140$,\n$$\\begin{align*}\\frac{140}{560}&=A\\\\A&=\\frac14\\end{align*}$$\nHence\n$$\\begin{align*}\\frac{P}{700-P}&=\\frac14e^{t/5}\\\\4P&=(700-P)e^{t/5}\\\\P(4+e^{t/5})&=700e^{t/5}\\\\P(t)&=\\frac{700e^{t/5}}{4+e^{t/5}}\\\\P(t)&=\\frac{700}{1+4e^{-t/5}}\\end{align*}$$\n$$\\begin{align*}P(10)&=\\frac{700}{1+4e^{-2}}\\\\P(10)&\\approx454\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 103
      }
    ]
  },
