  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The perimeter of a rectangle is 16 m and the length of its diagonals is 6 m. Find the area of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p9-q8-short-result",
