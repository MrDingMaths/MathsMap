  "content": {
    "id": "p6-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A bushwalker has walked 12 km North from base $B$ and then 5 km in an Easterly direction to a lookout at $L$. What is the bearing of $L$ from $B$ (to the nearest degree)?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$023^\\circ\\mathrm{T}$",
      "worked": "Let $\\theta$ be the clockwise angle from north at $B$ to $BL$.\n$$\\begin{align*}\\tan\\theta&=\\frac{5}{12}\\\\\\theta&=\\tan^{-1}\\!\\left(\\frac{5}{12}\\right)\\\\\\theta&\\approx23^\\circ\\end{align*}$$\nThe bearing is $023^\\circ\\mathrm{T}$, to the nearest degree.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
