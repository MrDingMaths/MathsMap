  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "$A=\\{1,2,4\\},\\quad B=\\{1,3,5,6\\}$.\n\nList every ordered pair $(a,b)$ satisfying the rule.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$b>a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(1,3),(1,5),(1,6),(2,3),(2,5),(2,6),(4,5),(4,6)\\}$",
          "worked": "For $a=1$, $b\\in\\{3,5,6\\}$; for $a=2$, $b\\in\\{3,5,6\\}$; for $a=4$, $b\\in\\{5,6\\}$.\n\nThe relation is $\\{(1,3),(1,5),(1,6),(2,3),(2,5),(2,6),(4,5),(4,6)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$b>a+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(1,3),(1,5),(1,6),(2,5),(2,6),(4,6)\\}$",
          "worked": "For $a=1$, require $b>2$, giving $b\\in\\{3,5,6\\}$. For $a=2$, require $b>3$, giving $b\\in\\{5,6\\}$. For $a=4$, require $b>5$, giving $b=6$.\n\nThe relation is $\\{(1,3),(1,5),(1,6),(2,5),(2,6),(4,6)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$b>a+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(1,5),(1,6),(2,5),(2,6)\\}$",
          "worked": "For $a=1$, require $b>3$, giving $b\\in\\{5,6\\}$. For $a=2$, require $b>4$, giving $b\\in\\{5,6\\}$. For $a=4$, no element of $B$ is greater than $6$.\n\nThe relation is $\\{(1,5),(1,6),(2,5),(2,6)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$b<a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(2,1),(4,1),(4,3)\\}$",
          "worked": "For $a=1$, no element of $B$ is smaller than $1$. For $a=2$, $b=1$. For $a=4$, $b\\in\\{1,3\\}$.\n\nThe relation is $\\{(2,1),(4,1),(4,3)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$b\\leq a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(1,1),(2,1),(4,1),(4,3)\\}$",
          "worked": "For $a=1$, $b=1$. For $a=2$, $b=1$. For $a=4$, $b\\in\\{1,3\\}$.\n\nThe relation is $\\{(1,1),(2,1),(4,1),(4,3)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$b=2a-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(1,1),(2,3)\\}$",
          "worked": "$$\\begin{aligned}a=1:\\quad b&=2(1)-1=1\\\\a=2:\\quad b&=2(2)-1=3\\\\a=4:\\quad b&=2(4)-1=7\\end{aligned}$$\nSince $7\\notin B$, the relation is $\\{(1,1),(2,3)\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
