  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The mass in grams of a melting ice block is given by the formula $M=t-2t^2+100$, where $t$ is time in minutes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the average rate of change at which the ice block is melting between:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "1 and 3 minutes",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-7\\text{ g/min}$",
              "worked": "$$\\begin{align*}M(1)&=1-2(1)^2+100=99\\\\M(3)&=3-2(3)^2+100=85\\\\\\text{Average rate}&=\\frac{85-99}{3-1}\\\\&=-7\\text{ g/min}\\end{align*}$$\nThe mass decreases by an average of $7\\text{ g/min}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q4-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "2 and 5 minutes.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-13\\text{ g/min}$",
              "worked": "$$\\begin{align*}M(2)&=2-2(2)^2+100=94\\\\M(5)&=5-2(5)^2+100=55\\\\\\text{Average rate}&=\\frac{55-94}{5-2}\\\\&=-13\\text{ g/min}\\end{align*}$$\nThe mass decreases by an average of $13\\text{ g/min}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the rate at which it is melting at 5 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-19\\text{ g/min}$",
          "worked": "$$\\begin{align*}M'(t)&=1-4t\\\\M'(5)&=1-4(5)\\\\&=-19\\text{ g/min}\\end{align*}$$\nThe mass is decreasing at $19\\text{ g/min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
