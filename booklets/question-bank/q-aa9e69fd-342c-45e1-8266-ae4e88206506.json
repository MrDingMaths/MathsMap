  "content": {
    "id": "p25-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x+1}{x+2}\\times\\dfrac{x+2}{x+3}\\times\\dfrac{x+3}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x+4}$",
          "worked": "$$\\begin{align*}\\frac{x+1}{x+2}\\times\\frac{x+2}{x+3}\\times\\frac{x+3}{x+4}&=\\frac{(x+1)(x+2)(x+3)}{(x+2)(x+3)(x+4)}\\\\&=\\frac{x+1}{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x+1}{x+2}\\times\\dfrac{x+2}{x+3}\\times\\dfrac{x+4}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+4}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{x+1}{x+2}\\times\\frac{x+2}{x+3}\\times\\frac{x+4}{x+1}&=\\frac{(x+1)(x+2)(x+4)}{(x+2)(x+3)(x+1)}\\\\&=\\frac{x+4}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2-1}{x+2}\\times\\dfrac{x+2}{x^2-4}\\times\\dfrac{x-2}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-1}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{x^2-1}{x+2}\\times\\frac{x+2}{x^2-4}\\times\\frac{x-2}{x+1}&=\\frac{(x-1)(x+1)}{x+2}\\times\\frac{x+2}{(x-2)(x+2)}\\times\\frac{x-2}{x+1}\\\\&=\\frac{x-1}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p25-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a^2-b^2}{a+c}\\times\\dfrac{a+c}{a-b}\\times\\dfrac{1}{a+b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{a^2-b^2}{a+c}\\times\\frac{a+c}{a-b}\\times\\frac{1}{a+b}&=\\frac{(a-b)(a+b)}{a+c}\\times\\frac{a+c}{a-b}\\times\\frac{1}{a+b}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
