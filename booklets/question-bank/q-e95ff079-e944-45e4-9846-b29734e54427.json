  "content": {
    "id": "p31-q51-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify\n$$\\cos^2\\left(\\frac{\\pi}{16}\\right)+\\cos^2\\left(\\frac{3\\pi}{16}\\right)+\\cos^2\\left(\\frac{5\\pi}{16}\\right)+\\cos^2\\left(\\frac{7\\pi}{16}\\right).$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2$.\n\nUse $\\cos^2u=\\frac{1+\\cos2u}{2}$; the resulting cosine terms cancel in pairs.",
      "worked": "Let $S$ be the given sum. Using $\\cos^2u=\\frac{1+\\cos2u}{2}$,\n$$\\begin{align*}S&=2+\\frac12\\left(\\cos\\frac\\pi8+\\cos\\frac{3\\pi}8+\\cos\\frac{5\\pi}8+\\cos\\frac{7\\pi}8\\right)\\\\S&=2+\\frac12\\left(\\cos\\frac\\pi8+\\cos\\frac{3\\pi}8-\\cos\\frac{3\\pi}8-\\cos\\frac\\pi8\\right)\\\\S&=2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
