  "content": {
    "id": "p3-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve each of the following quadratic equations:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-2x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=2$.",
          "worked": "$$\\begin{align*}x(x-2)&=0\\\\x&=0\\quad\\text{or}\\quad x-2=0\\\\x&=0\\quad\\text{or}\\quad x=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+3x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $x=0$.",
          "worked": "$$\\begin{align*}x(x+3)&=0\\\\x&=0\\quad\\text{or}\\quad x+3=0\\\\x&=0\\quad\\text{or}\\quad x=-3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-4x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=4$.",
          "worked": "$$\\begin{align*}x(x-4)&=0\\\\x&=0\\quad\\text{or}\\quad x-4=0\\\\x&=0\\quad\\text{or}\\quad x=4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x^2-x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=\\frac12$.",
          "worked": "$$\\begin{align*}x(2x-1)&=0\\\\x&=0\\quad\\text{or}\\quad 2x-1=0\\\\x&=0\\quad\\text{or}\\quad 2x=1\\\\x&=0\\quad\\text{or}\\quad x=\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$4x-x^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=4$.",
          "worked": "$$\\begin{align*}x(4-x)&=0\\\\x&=0\\quad\\text{or}\\quad 4-x=0\\\\x&=0\\quad\\text{or}\\quad x=4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x^2-4x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=\\frac43$.",
          "worked": "$$\\begin{align*}x(3x-4)&=0\\\\x&=0\\quad\\text{or}\\quad 3x-4=0\\\\x&=0\\quad\\text{or}\\quad 3x=4\\\\x&=0\\quad\\text{or}\\quad x=\\frac43.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
