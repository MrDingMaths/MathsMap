  "content": {
    "id": "p18-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Let $m\\in\\mathbb R$. Prove that the quadratic equation $x^2+mx+(2m-5)=0$ has two real solutions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\Delta=(m-4)^2+4>0$, so there are two distinct real solutions.\n\nComplete the square in the discriminant.",
      "worked": "$$\\begin{align*}\\Delta&=m^2-4(1)(2m-5)\\\\\\Delta&=m^2-8m+20\\\\\\Delta&=(m^2-8m+16)+4\\\\\\Delta&=(m-4)^2+4.\\end{align*}$$\nSince $(m-4)^2\\ge0$, we have $\\Delta\\ge4>0$. Therefore the quadratic has two distinct real solutions for every real $m$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
