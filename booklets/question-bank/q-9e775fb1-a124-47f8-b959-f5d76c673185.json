  "content": {
    "id": "p59-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "If the gradient of the tangent to $y=\\sqrt{x}$ is $\\frac{1}{6}$ at point $A$, find the coordinates of $A$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$A=(9,3)$",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{1}{2\\sqrt{x}}\\\\\\frac{1}{2\\sqrt{x}}&=\\frac{1}{6}\\\\\\sqrt{x}&=3\\\\x&=9\\\\y&=\\sqrt{9}\\\\y&=3\\end{align*}$$\nTherefore $A=(9,3)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
