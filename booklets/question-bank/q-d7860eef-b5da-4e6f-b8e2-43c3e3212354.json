  "content": {
    "id": "p71-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "The equation of the tangent to the curve $y=x^3+ax^2+bx+4$ at the point $x=2$ is $y=x-4$. Find $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-2,\\quad b=-3$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p71-q15-working-derivative",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "y'=3x^2+2ax+b",
                "display": true
              }
            ]
          },
          {
            "id": "p71-q15-working-gradient-note",
            "type": "paragraph",
            "fontSize": null,
