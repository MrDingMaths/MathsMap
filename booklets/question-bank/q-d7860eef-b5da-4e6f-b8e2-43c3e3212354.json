            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "When ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=2,\\ y'=1",
                "display": false
              }
            ]
          },
          {
            "id": "p71-q15-working-gradient-equation",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y'(2)&=12+4a+b=1\\\\4a+b&=-11\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p71-q15-working-point-note",
            "type": "paragraph",
