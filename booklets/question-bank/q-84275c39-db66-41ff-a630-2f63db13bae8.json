  "content": {
    "id": "p32-q4",
    "type": "question",
    "label": "4",
    "prompt": "Simplify by a combination of prime factorisation and taking out a common factor.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$6^{n}-3^{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{n}(2^{n}-1)$",
          "worked": "$$\\begin{align*}6^{n}-3^{n}&=2^{n}3^{n}-3^{n}\\\\&=3^{n}(2^{n}-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{6^{n}+3^{n}}{2^{n+1}+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3^{n}}{2}$",
          "worked": "$$\\begin{align*}\\frac{6^{n}+3^{n}}{2^{n+1}+2}&=\\frac{2^{n}3^{n}+3^{n}}{2\\times2^{n}+2}\\\\&=\\frac{3^{n}(2^{n}+1)}{2(2^{n}+1)}\\\\&=\\frac{3^{n}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p32-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{12^{x}+1}{6^{2x}+3^{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3^{x}}$",
          "worked": "$$\\begin{align*}\\frac{12^{x}+1}{6^{2x}+3^{x}}&=\\frac{12^{x}+1}{2^{2x}3^{2x}+3^{x}}\\\\&=\\frac{12^{x}+1}{3^{x}(2^{2x}3^{x}+1)}\\\\&=\\frac{12^{x}+1}{3^{x}(12^{x}+1)}\\\\&=\\frac{1}{3^{x}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p32-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{12^{n}-18^{n}}{3^{n}-2^{n}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2^{n}3^{n}$",
          "worked": "$$\\begin{align*}\\frac{12^{n}-18^{n}}{3^{n}-2^{n}}&=\\frac{2^{2n}3^{n}-2^{n}3^{2n}}{3^{n}-2^{n}}\\\\&=\\frac{2^{n}3^{n}(2^{n}-3^{n})}{3^{n}-2^{n}}\\\\&=\\frac{-2^{n}3^{n}(3^{n}-2^{n})}{3^{n}-2^{n}}\\\\&=-2^{n}3^{n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
