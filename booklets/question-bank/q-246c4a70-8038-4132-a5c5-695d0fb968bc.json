  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Simplify:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{b-a}{a-b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{b-a}{a-b}&=\\frac{-(a-b)}{a-b}\\\\\\frac{b-a}{a-b}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{v^2-u^2}{u-v}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-u-v$",
          "worked": "$$\\begin{align*}\\frac{v^2-u^2}{u-v}&=\\frac{(v-u)(v+u)}{u-v}\\\\\\frac{v^2-u^2}{u-v}&=-(v+u)\\\\\\frac{v^2-u^2}{u-v}&=-u-v\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x^2-5x+6}{2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-x$",
          "worked": "$$\\begin{align*}\\frac{x^2-5x+6}{2-x}&=\\frac{(x-2)(x-3)}{-(x-2)}\\\\\\frac{x^2-5x+6}{2-x}&=-(x-3)\\\\\\frac{x^2-5x+6}{2-x}&=3-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{a-b}-\\frac{1}{b-a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{a-b}$",
          "worked": "$$\\begin{align*}\\frac{1}{a-b}-\\frac{1}{b-a}&=\\frac{1}{a-b}+\\frac{1}{a-b}\\\\\\frac{1}{a-b}-\\frac{1}{b-a}&=\\frac{2}{a-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{m}{m-n}+\\frac{n}{n-m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{m}{m-n}+\\frac{n}{n-m}&=\\frac{m}{m-n}-\\frac{n}{m-n}\\\\\\frac{m}{m-n}+\\frac{n}{n-m}&=\\frac{m-n}{m-n}\\\\\\frac{m}{m-n}+\\frac{n}{n-m}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p14-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{x-y}{y^2+xy-2x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{2x+y}$",
          "worked": "$$\\begin{align*}\\frac{x-y}{y^2+xy-2x^2}&=\\frac{x-y}{(y+2x)(y-x)}\\\\\\frac{x-y}{y^2+xy-2x^2}&=\\frac{-(y-x)}{(y+2x)(y-x)}\\\\\\frac{x-y}{y^2+xy-2x^2}&=-\\frac{1}{2x+y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
