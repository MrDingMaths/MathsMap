    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$3x^2-12x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\pm\\sqrt3$",
          "worked": "$$\\begin{align*}3x^2-12x&=-3\\\\x^2-4x&=-1\\\\x^2-4x+4&=-1+4\\\\(x-2)^2&=3\\\\x-2&=\\pm\\sqrt3\\\\x&=2\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$3x^2+6x-12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1\\pm\\sqrt5$",
          "worked": "$$\\begin{align*}3x^2+6x&=12\\\\x^2+2x&=4\\\\x^2+2x+1&=4+1\\\\(x+1)^2&=5\\\\x+1&=\\pm\\sqrt5\\\\x&=-1\\pm\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$-x^2-2x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1\\pm\\sqrt5$",
          "worked": "$$\\begin{align*}-x^2-2x&=-4\\\\x^2+2x&=4\\\\x^2+2x+1&=4+1\\\\(x+1)^2&=5\\\\x+1&=\\pm\\sqrt5\\\\x&=-1\\pm\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$-x^2+8x-10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4\\pm\\sqrt6$",
          "worked": "$$\\begin{align*}-x^2+8x&=10\\\\x^2-8x&=-10\\\\x^2-8x+16&=-10+16\\\\(x-4)^2&=6\\\\x-4&=\\pm\\sqrt6\\\\x&=4\\pm\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$-x^2-6x+12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3\\pm\\sqrt{21}$",
          "worked": "$$\\begin{align*}-x^2-6x&=-12\\\\x^2+6x&=12\\\\x^2+6x+9&=12+9\\\\(x+3)^2&=21\\\\x+3&=\\pm\\sqrt{21}\\\\x&=-3\\pm\\sqrt{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x^2+24x-12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4\\pm2\\sqrt5$",
          "worked": "$$\\begin{align*}3x^2+24x&=12\\\\x^2+8x&=4\\\\x^2+8x+16&=4+16\\\\(x+4)^2&=20\\\\x+4&=\\pm2\\sqrt5\\\\x&=-4\\pm2\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$2x^2-3x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-\\dfrac12$",
          "worked": "$$\\begin{align*}2x^2-3x&=2\\\\x^2-\\tfrac32x&=1\\\\x^2-\\tfrac32x+\\tfrac9{16}&=1+\\tfrac9{16}\\\\(x-\\tfrac34)^2&=\\tfrac{25}{16}\\\\x-\\tfrac34&=\\pm\\tfrac54\\\\x&=2\\text{ or }-\\tfrac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$3x^2-8x-6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{4\\pm\\sqrt{34}}3$",
          "worked": "$$\\begin{align*}3x^2-8x&=6\\\\x^2-\\tfrac83x&=2\\\\x^2-\\tfrac83x+\\tfrac{16}9&=2+\\tfrac{16}9\\\\(x-\\tfrac43)^2&=\\tfrac{34}9\\\\x-\\tfrac43&=\\pm\\tfrac{\\sqrt{34}}3\\\\x&=\\tfrac{4\\pm\\sqrt{34}}3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$4x^2-x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{1\\pm\\sqrt{65}}8$",
          "worked": "$$\\begin{align*}4x^2-x&=4\\\\x^2-\\tfrac14x&=1\\\\x^2-\\tfrac14x+\\tfrac1{64}&=1+\\tfrac1{64}\\\\(x-\\tfrac18)^2&=\\tfrac{65}{64}\\\\x-\\tfrac18&=\\pm\\tfrac{\\sqrt{65}}8\\\\x&=\\tfrac{1\\pm\\sqrt{65}}8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$5x^2+x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-1\\pm\\sqrt{21}}{10}$",
          "worked": "$$\\begin{align*}5x^2+x&=1\\\\x^2+\\tfrac15x&=\\tfrac15\\\\x^2+\\tfrac15x+\\tfrac1{100}&=\\tfrac15+\\tfrac1{100}\\\\(x+\\tfrac1{10})^2&=\\tfrac{21}{100}\\\\x+\\tfrac1{10}&=\\pm\\tfrac{\\sqrt{21}}{10}\\\\x&=\\tfrac{-1\\pm\\sqrt{21}}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$2x^2-5x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $x=-\\dfrac12$",
          "worked": "$$\\begin{align*}2x^2-5x&=3\\\\x^2-\\tfrac52x&=\\tfrac32\\\\x^2-\\tfrac52x+\\tfrac{25}{16}&=\\tfrac32+\\tfrac{25}{16}\\\\(x-\\tfrac54)^2&=\\tfrac{49}{16}\\\\x-\\tfrac54&=\\pm\\tfrac74\\\\x&=3\\text{ or }-\\tfrac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$3x^2+10x-15=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-5\\pm\\sqrt{70}}3$",
          "worked": "$$\\begin{align*}3x^2+10x&=15\\\\x^2+\\tfrac{10}3x&=5\\\\x^2+\\tfrac{10}3x+\\tfrac{25}9&=5+\\tfrac{25}9\\\\(x+\\tfrac53)^2&=\\tfrac{70}9\\\\x+\\tfrac53&=\\pm\\tfrac{\\sqrt{70}}3\\\\x&=\\tfrac{-5\\pm\\sqrt{70}}3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p19-q4-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac16x^2+\\dfrac13x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1\\pm\\sqrt7$",
          "worked": "$$\\begin{align*}\\tfrac16x^2+\\tfrac13x&=1\\\\x^2+2x&=6\\\\x^2+2x+1&=6+1\\\\(x+1)^2&=7\\\\x+1&=\\pm\\sqrt7\\\\x&=-1\\pm\\sqrt7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p19-q4-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\dfrac34x^2-\\dfrac32x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1\\pm\\sqrt5$",
          "worked": "$$\\begin{align*}\\tfrac34x^2-\\tfrac32x&=3\\\\x^2-2x&=4\\\\x^2-2x+1&=4+1\\\\(x-1)^2&=5\\\\x-1&=\\pm\\sqrt5\\\\x&=1\\pm\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p19-q4-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\sqrt2x^2-4x-2\\sqrt2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\sqrt2\\pm2$\n\nDivide by $\\sqrt2$ and complete the square.",
          "worked": "$$\\begin{align*}\\sqrt2x^2-4x&=2\\sqrt2\\\\x^2-2\\sqrt2x&=2\\\\x^2-2\\sqrt2x+2&=2+2\\\\(x-\\sqrt2)^2&=4\\\\x-\\sqrt2&=\\pm2\\\\x&=\\sqrt2\\pm2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      }
