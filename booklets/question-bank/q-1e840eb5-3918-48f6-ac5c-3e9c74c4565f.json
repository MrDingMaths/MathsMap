  "content": {
    "id": "p19-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find $\\Pr(B)$ if $A$ and $B$ are independent and\n$$\\Pr(A\\cup B)=\\frac13,\\quad \\Pr(A)=\\frac14.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac19$",
      "worked": "$$\\begin{align*}\\Pr(A\\cup B)&=\\Pr(A)+\\Pr(B)-\\Pr(A)\\Pr(B)\\\\\\frac13&=\\frac14+\\Pr(B)-\\frac14\\Pr(B)\\\\4&=3+12\\Pr(B)-3\\Pr(B)\\\\1&=9\\Pr(B)\\\\\\Pr(B)&=\\frac19.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
