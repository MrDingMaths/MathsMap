        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "There are 25 multiples of 4, from 4 to 100.\n$$\\begin{align*}P(A)&=\\frac{25}{100}\\\\P(A)&=\\frac{1}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
