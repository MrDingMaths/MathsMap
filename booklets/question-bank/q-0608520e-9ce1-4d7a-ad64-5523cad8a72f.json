              "type": "text",
              "text": "An integer is randomly chosen from 1 to 100 where all numbers are equally likely to be chosen. Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "A",
              "display": false
            },
            {
              "type": "text",
              "text": " be the event the number is divisible by 4, and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "B",
              "display": false
            },
            {
              "type": "text",
              "text": " be the event the number is a multiple of 5 but not a multiple of 10.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
