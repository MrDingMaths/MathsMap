        "answer": {
          "short": "$\\$7467.69$",
          "worked": "$$\\begin{align*}\\text{Weekly pay} &= \\frac{97080}{52}\\\\\\text{4 weeks’ pay} &= \\frac{97080}{52}\\times4\\approx\\$7467.69\\end{align*}$$",
