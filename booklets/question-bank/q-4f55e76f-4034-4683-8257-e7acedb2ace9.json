        },
        "answerSpaceMm": 18
      },
      {
        "id": "p44-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the leave loading.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1306.85$",
          "worked": "$$\\begin{align*}\\text{Leave loading} &= 0.175\\times\\text{Weekly pay}\\times4\\\\\\text{Leave loading} &= 0.175\\times\\frac{97080}{52}\\times4\\\\\\text{Leave loading} &\\approx \\$1306.85\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate total holiday pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$8774.54$",
          "worked": "$$\\begin{align*}\\text{Total holiday pay} &= \\text{Weekly pay}\\times4+\\text{Leave loading}\\\\\\text{Total holiday pay} &= \\frac{97080}{52}\\times4+0.175\\times\\frac{97080}{52}\\times4\\\\\\text{Total holiday pay} &\\approx \\$8774.54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
