        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"Source PDF 81, printed 145, Q54 net\"}\n\\usetikzlibrary{arrows.meta}\n\\begin{tikzpicture}[x=8mm,y=8mm,draw=black,text=black,line cap=round,line join=round,>=Stealth,every node/.style={font=\\fontsize{10}{12}\\selectfont,inner sep=1pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-1.15,-1.05) rectangle (5.15,5.15);\n% Coordinates reproduce the illustrative source proportions; no numerical ratio is a given.\n\\draw[line width=0.4pt,dash pattern=on 2.5pt off 2.5pt] (0,4)--(0,5)--(1,5);\n\\draw[line width=0.4pt,dash pattern=on 2.5pt off 2.5pt] (4,5)--(5,5)--(5,4);\n\\draw[line width=0.4pt,dash pattern=on 2.5pt off 2.5pt] (5,1)--(5,0)--(4,0);\n\\draw[line width=0.4pt,dash pattern=on 2.5pt off 2.5pt] (1,0)--(0,0)--(0,1);\n\\draw[line width=0.8pt] (1,5)--(4,5)--(4,4)--(5,4)--(5,1)--(4,1)--(4,0)--(1,0)--(1,1)--(0,1)--(0,4)--(1,4)--cycle;\n\\draw[line width=0.8pt] (1,1) rectangle (4,4);\n\\draw[line width=0.4pt] (-0.56,5)--(-0.28,5) (-0.56,4)--(-0.28,4) (-0.56,1)--(-0.28,1) (-0.56,0)--(-0.28,0);\n\\draw[<->,line width=0.4pt] (-0.42,4)--(-0.42,5);\n\\draw[<->,line width=0.4pt] (-0.42,0)--(-0.42,1);\n\\node[rotate=90] at (-0.84,4.5) {$x$};\n\\node[rotate=90] at (-0.84,0.5) {$x$};\n\\draw[line width=0.4pt] (0,-0.28)--(0,-0.56) (5,-0.28)--(5,-0.56);\n\\draw[<->,line width=0.4pt] (0,-0.42)--(5,-0.42);\n\\node[anchor=north,yshift=-2pt] at (2.5,-0.42) {$s$};\n\\end{tikzpicture}",
        "src": null,
