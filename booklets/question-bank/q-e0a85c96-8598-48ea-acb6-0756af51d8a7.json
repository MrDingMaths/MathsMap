  "content": {
    "id": "p16-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A man puts $\\$2000$ into a bank account every month for 12 months.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is his bank balance at the end of 12 months, given that he does not withdraw any money?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$24\\,000$",
          "worked": "$$2000\\times12=24\\,000$$\n\nHis bank balance is $\\$24\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "He writes a cheque for $\\$40\\,000$. What is his new bank balance?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\$16\\,000$",
          "worked": "$$24\\,000-40\\,000=-16\\,000$$\n\nHis new bank balance is $-\\$16\\,000$, an overdraft of $\\$16\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
