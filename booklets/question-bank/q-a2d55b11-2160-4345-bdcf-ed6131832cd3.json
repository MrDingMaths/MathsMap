  "content": {
    "id": "p29-ex7e-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The price of a car has been discounted by 10%. The discounted price is $\\$22\\,500$. What was the price before the discount?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$25\\,000$",
      "worked": "The discounted price is $(100-10)\\%=90\\%$ of the original price.\n\n$$\\begin{align*}90\\%\\text{ of the original price}&=\\$22\\,500\\\\1\\%\\text{ of the original price}&=\\$22\\,500\\div90=\\$250\\\\100\\%\\text{ of the original price}&=\\$250\\times100=\\$25\\,000\\end{align*}$$\nThe price before the discount was $\\$25\\,000$.",
      "solutionDiagrams": []
    },
