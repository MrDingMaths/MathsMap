    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$15$",
      "worked": "Choose the 2 positions for the successes:\n\n$$\\begin{aligned}\\text{Number of orders}&=\\binom{6}{2}\\\\&=\\frac{6!}{2!\\,4!}\\\\&=15.\\end{aligned}$$",
