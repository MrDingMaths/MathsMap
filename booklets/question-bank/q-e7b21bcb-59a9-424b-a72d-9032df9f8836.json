    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Represent these data with a stem-and-leaf plot.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{array}{r|l}2&4\\;5\\;6\\;7\\;8\\;8\\;9\\\\3&0\\;0\\;1\\;2\\;2\\;6\\;6\\;6\\;6\\;7\\;7\\;9\\\\4&2\\end{array}$$\nKey: $2\\mid4$ means $2.4\\text{ kg}$.",
          "worked": "Use the whole-number part as the stem and the tenths digit as the leaf. List the leaves in ascending order.\n$$\\begin{array}{r|l}2&4\\;5\\;6\\;7\\;8\\;8\\;9\\\\3&0\\;0\\;1\\;2\\;2\\;6\\;6\\;6\\;6\\;7\\;7\\;9\\\\4&2\\end{array}$$\nKey: $2\\mid4$ means $2.4\\text{ kg}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the median value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.15\\text{ kg}$",
          "worked": "There are 20 values. The 10th and 11th values in ascending order are $3.1$ and $3.2$.\n$$\\begin{align*}\\text{Median}&=\\frac{3.1+3.2}{2}\\\\\\text{Median}&=3.15\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the mean value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.205\\text{ kg}$",
          "worked": "$$\\begin{align*}\\text{Sum}&=3.0+2.8+3.6+2.8+3.6+3.7+3.2+3.9+3.6+4.2\\\\&\\quad+3.7+2.7+3.1+3.0+2.5+2.6+3.6+2.4+2.9+3.2\\\\\\text{Sum}&=64.1\\text{ kg}\\\\\\text{Mean}&=\\frac{64.1}{20}\\\\\\text{Mean}&=3.205\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
