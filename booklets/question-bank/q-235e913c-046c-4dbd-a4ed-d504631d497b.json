    "type": "question",
    "label": "3",
    "prompt": "Two thousand tickets are sold in a raffle. If you buy 10 tickets, what is the probability that you will win first prize?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{200}$",
      "worked": "There are 10 favourable tickets out of 2000 equally likely tickets.\n\n$$\\begin{align*}P(\\text{winning first prize})&=\\frac{10}{2000}\\\\P(\\text{winning first prize})&=\\frac{1}{200}\\end{align*}$$",
