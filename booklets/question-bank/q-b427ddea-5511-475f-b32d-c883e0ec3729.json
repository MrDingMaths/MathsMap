    "children": [
      {
        "id": "p35-q2-explain",
        "type": "part",
        "label": "a",
        "prompt": "Natalie tried to add the two equations and got stuck. She should have subtracted.\n\nHow would subtracting have gotten her closer to solving the equations?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Subtracting would eliminate $y$.",
          "worked": "Both equations have coefficient $1$ for $y$, so subtracting eliminates $y$ and leaves an equation in $x$ only:\n$$\\begin{align*}(2x+y)-(-x+y)&=5-3\\\\3x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p35-q2-solve",
        "type": "part",
        "label": "b",
        "prompt": "Solve simultaneously:\n$$\\begin{aligned}3x+3y&=15\\\\2x+3y&=12\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=2$.",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}(3x+3y)-(2x+3y)&=15-12\\\\x&=3\\end{align*}$$\nSubstitute $x=3$ into the first equation.\n$$\\begin{align*}3(3)+3y&=15\\\\9+3y&=15\\\\3y&=6\\\\y&=2\\end{align*}$$\nTherefore $x=3,\\ y=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
