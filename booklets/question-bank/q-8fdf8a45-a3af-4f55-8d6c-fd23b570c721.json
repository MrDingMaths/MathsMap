      {
        "id": "p42-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{dy}{dx}=\\dfrac{y}{x}$ with $y(2)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{x}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{y}\\,dy&=\\frac{1}{x}\\,dx\\\\\\int\\frac{1}{y}\\,dy&=\\int\\frac{1}{x}\\,dx\\\\\\ln|y|&=\\ln|x|+C_1\\\\y&=Cx\\\\1&=2C\\\\C&=\\frac12\\\\y&=\\frac{x}{2},\\quad x>0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      },
      {
        "id": "p42-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{dy}{dx}=\\dfrac{y}{2x}$ with $y(1)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2\\sqrt{x}$",
          "worked": "$$\\begin{align*}\\frac{1}{y}\\,dy&=\\frac{1}{2x}\\,dx\\\\\\int\\frac{1}{y}\\,dy&=\\int\\frac{1}{2x}\\,dx\\\\\\ln|y|&=\\frac12\\ln|x|+C_1\\\\y&=C\\sqrt{x}\\quad(x>0)\\\\2&=C\\sqrt{1}\\\\C&=2\\\\y&=2\\sqrt{x},\\quad x>0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p42-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{dy}{dx}=-\\dfrac{2xy}{1+x^2}$ with $y(1)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{4}{1+x^2}$",
          "worked": "$$\\begin{align*}\\frac{1}{y}\\,dy&=-\\frac{2x}{1+x^2}\\,dx\\\\\\int\\frac{1}{y}\\,dy&=-\\int\\frac{2x}{1+x^2}\\,dx\\\\\\ln|y|&=-\\ln(1+x^2)+C_1\\\\y&=\\frac{C}{1+x^2}\\\\2&=\\frac{C}{1+1^2}\\\\C&=4\\\\y&=\\frac{4}{1+x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p42-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{dy}{dx}=-\\dfrac{y}{x}$ with $y(2)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2}{x}$",
          "worked": "$$\\begin{align*}\\frac{1}{y}\\,dy&=-\\frac{1}{x}\\,dx\\\\\\int\\frac{1}{y}\\,dy&=-\\int\\frac{1}{x}\\,dx\\\\\\ln|y|&=-\\ln|x|+C_1\\\\y&=\\frac{C}{x}\\\\1&=\\frac{C}{2}\\\\C&=2\\\\y&=\\frac{2}{x},\\quad x>0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p42-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{dy}{dx}=y\\cos x$ with $y\\left(\\dfrac{\\pi}{2}\\right)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{\\sin x-1}$",
          "worked": "$$\\begin{align*}\\frac{1}{y}\\,dy&=\\cos x\\,dx\\\\\\int\\frac{1}{y}\\,dy&=\\int\\cos x\\,dx\\\\\\ln|y|&=\\sin x+C\\\\\\ln1&=\\sin\\frac{\\pi}{2}+C\\\\C&=-1\\\\\\ln|y|&=\\sin x-1\\\\y&=e^{\\sin x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      },
      {
        "id": "p42-q15-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{dy}{dx}=\\dfrac{y(2-x)}{x^2}$ with $y(2)=\\dfrac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{x}e^{1-\\frac{2}{x}}$",
          "worked": "$$\\begin{align*}\\frac{1}{y}\\,dy&=\\left(\\frac{2}{x^2}-\\frac{1}{x}\\right)dx\\\\\\int\\frac{1}{y}\\,dy&=\\int\\left(2x^{-2}-x^{-1}\\right)dx\\\\\\ln|y|&=-\\frac{2}{x}-\\ln|x|+C_1\\\\y&=\\frac{C}{x}e^{-2/x}\\quad(x>0)\\\\\\frac12&=\\frac{C}{2}e^{-1}\\\\C&=e\\\\y&=\\frac{1}{x}e^{1-2/x},\\quad x>0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
