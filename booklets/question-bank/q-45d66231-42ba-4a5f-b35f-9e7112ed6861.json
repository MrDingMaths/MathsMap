        "id": "p14-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What number multiplied by $2\\frac{1}{4}$ gives $1\\frac{1}{8}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Divide the product by the known factor.\n\n$$\\begin{align*}1\\frac{1}{8}\\div2\\frac{1}{4}&=\\frac{9}{8}\\div\\frac{9}{4}\\\\1\\frac{1}{8}\\div2\\frac{1}{4}&=\\frac{9}{8}\\times\\frac{4}{9}\\\\1\\frac{1}{8}\\div2\\frac{1}{4}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What number divided by $1\\frac{1}{3}$ gives $2\\frac{1}{4}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "Multiply the quotient by the divisor.\n\n$$\\begin{align*}2\\frac{1}{4}\\times1\\frac{1}{3}&=\\frac{9}{4}\\times\\frac{4}{3}\\\\2\\frac{1}{4}\\times1\\frac{1}{3}&=\\frac{3}{1}\\times\\frac{1}{1}\\\\2\\frac{1}{4}\\times1\\frac{1}{3}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
