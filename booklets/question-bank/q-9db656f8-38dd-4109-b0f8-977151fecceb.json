    "id": "p25-q38-root",
    "type": "question",
    "label": "38",
    "prompt": "Think of a number. Let this number be $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q38-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p25-q38-a-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Write the following using algebra to see what you get:",
                  "marks": []
                }
              ]
            },
            {
              "id": "p25-q38-a-operations",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Add 6 to the number, then",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "multiply the result by 10, then",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "subtract the result from 20, then",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "multiply this result by 2.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(20-10(x+6))=-80-20x$.",
          "worked": "Step by step:\n$$\\begin{align*}&x+6\\\\&10(x+6)\\\\&20-10(x+6)\\\\&2(20-10(x+6))\\\\2(20-10(x+6))&=-80-20x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p25-q38-b",
        "type": "part",
        "label": "b",
        "prompt": "If this final result is twice the original number, find the original number $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3\\frac{7}{11}$.",
          "worked": "$$\\begin{align*}-80-20x&=2x\\\\-80&=22x\\\\x&=-3\\frac{7}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p25-q38-c",
        "type": "part",
        "label": "c",
        "prompt": "If the number obtained in part (a) is 1000 less than the original number, find the original number $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=43\\frac{17}{21}$.",
          "worked": "$$\\begin{align*}-80-20x&=x-1000\\\\21x&=920\\\\x&=43\\frac{17}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
