  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If a generator needs 32 L of fuel to run for 5 days, for how long can it run on 112 L?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$17.5$ days",
      "worked": "32 L runs the generator for 5 days.\n\n1 L runs the generator for $\\frac{5}{32}$ days.\n\n$$\\begin{align*}\\text{Duration on 112 L}&=112\\times\\frac{5}{32}\\text{ days}\\\\\\text{Duration on 112 L}&=17.5\\text{ days}\\end{align*}$$",
      "solutionDiagrams": []
    },
