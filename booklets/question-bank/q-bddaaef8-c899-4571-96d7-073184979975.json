  "content": {
    "id": "p11-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "In each part, find the gradients of intervals $AB$ and $BC$, and state whether $A$, $B$ and $C$ lie on the same line (are collinear) or not.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(3,6)$, $B(-1,4)$, $C(4,11)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AB}=\\frac12$, $m_{BC}=\\frac75$; not collinear.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{4-6}{-1-3}=\\frac12\\\\m_{BC}&=\\frac{11-4}{4-(-1)}=\\frac75.\\end{align*}$$\nThe gradients differ, so $A$, $B$ and $C$ are not collinear.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(3,8)$, $B(2,5)$, $C(1,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AB}=m_{BC}=3$; collinear.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{5-8}{2-3}=3\\\\m_{BC}&=\\frac{2-5}{1-2}=3.\\end{align*}$$\nThe intervals share $B$ and have equal gradients, so $A$, $B$ and $C$ are collinear.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(4,11)$, $B(-1,-4)$, $C(2,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AB}=m_{BC}=3$; collinear.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{-4-11}{-1-4}=3\\\\m_{BC}&=\\frac{5-(-4)}{2-(-1)}=3.\\end{align*}$$\nThe intervals share $B$ and have equal gradients, so $A$, $B$ and $C$ are collinear.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(4,5)$, $B(-1,-6)$, $C(3,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AB}=\\frac{11}{5}$, $m_{BC}=\\frac{13}{4}$; not collinear.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{-6-5}{-1-4}=\\frac{11}{5}\\\\m_{BC}&=\\frac{7-(-6)}{3-(-1)}=\\frac{13}{4}.\\end{align*}$$\nThe gradients differ, so $A$, $B$ and $C$ are not collinear.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
