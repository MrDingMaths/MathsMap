  "content": {
    "id": "p18-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A bowl contains green and red balls. The ratio of the number of green balls to the number of red balls is $7:4$. If there are 244 red balls, how many green balls are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "427 green balls.",
      "worked": "The red balls represent 4 parts.\n$$\\begin{align*}\\text{1 part}&=244\\div4\\\\\\text{1 part}&=61\\\\\\text{Green balls}&=7\\times61\\\\\\text{Green balls}&=427\\end{align*}$$\nThere are 427 green balls.",
      "solutionDiagrams": []
    },
