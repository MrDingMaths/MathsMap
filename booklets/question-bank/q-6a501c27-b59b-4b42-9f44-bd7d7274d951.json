  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Show by substitution that the given function is a particular solution of the DE.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=5x^3;\\quad xy'-3y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy'-3y=0=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}y'&=15x^2\\\\\\mathrm{LHS}&=xy'-3y\\\\&=x(15x^2)-3(5x^3)\\\\&=15x^3-15x^3\\\\&=0\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2-1;\\quad xy'-2y=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy'-2y=2=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}y'&=2x\\\\\\mathrm{LHS}&=xy'-2y\\\\&=x(2x)-2(x^2-1)\\\\&=2x^2-2x^2+2\\\\&=2\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=3e^{-x};\\quad y'+y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'+y=0=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}y'&=-3e^{-x}\\\\\\mathrm{LHS}&=y'+y\\\\&=-3e^{-x}+3e^{-x}\\\\&=0\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\sqrt{x^2+4};\\quad y'y=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'y=x=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}y'&=\\frac{x}{\\sqrt{x^2+4}}\\\\\\mathrm{LHS}&=y'y\\\\&=\\left(\\frac{x}{\\sqrt{x^2+4}}\\right)\\sqrt{x^2+4}\\\\&=x\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
