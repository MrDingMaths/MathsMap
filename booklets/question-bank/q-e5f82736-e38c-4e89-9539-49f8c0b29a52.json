        "answer": {
          "short": "$11b$",
          "worked": "$$\\begin{align*}6b + 15b \\div 3 &= 6b + 5b\\\\&= 11b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q1-l",
