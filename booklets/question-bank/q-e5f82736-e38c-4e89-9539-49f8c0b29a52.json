  "content": {
    "id": "p37-q1-content",
    "type": "question",
    "label": "1",
    "prompt": "Simplify these expressions. Remember to follow the order of operations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$3 + a \\times b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3 + ab$",
          "worked": "$$\\begin{align*}3 + a \\times b &= 3 + ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p37-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(4x + 2x) \\div 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6x}{5}$",
          "worked": "$$\\begin{align*}(4x + 2x) \\div 5 &= 6x \\div 5\\\\&= \\frac{6x}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x + y) \\div 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x + y}{5}$",
          "worked": "$$\\begin{align*}(2x + y) \\div 5 &= \\frac{2x + y}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2 + x) \\div (4y + y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2 + x}{5y}$",
          "worked": "$$\\begin{align*}(2 + x) \\div (4y + y) &= (2 + x) \\div(5y)\\\\&= \\frac{2 + x}{5y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x - 5) \\div (3 + b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x - 5}{3 + b}$",
          "worked": "$$\\begin{align*}(x - 5) \\div (3 + b) &= \\frac{x - 5}{3 + b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$2x + y \\div 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x + \\frac{y}{5}$",
          "worked": "$$\\begin{align*}2x + y \\div 5 &= 2x + \\frac{y}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$3 + x \\div 2 + y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3 + \\frac{x}{2} + y$",
          "worked": "$$\\begin{align*}3 + x \\div 2 + y &= 3 + \\frac{x}{2} + y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$x - 5 \\div 3 + b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x - \\frac{5}{3} + b$",
          "worked": "$$\\begin{align*}x - 5 \\div 3 + b &= x - \\frac{5}{3} + b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$3 \\times 2b - b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5b$",
          "worked": "$$\\begin{align*}3 \\times 2b - b &= 6b - b\\\\&= 5b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$3 \\times (2b - 2b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}3 \\times (2b - 2b) &= 3 \\times 0\\\\&= 0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$6b + 15b \\div 3$",
