    "label": null,
    "prompt": "A straight line has equation $y = 5x + 2a + 3$. The line passes through the point $(0,19)$.\nWork out the value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a = 8$",
      "worked": "Substitute into the equation:\n$$\\begin{aligned}19 &= 5(0) + 2a + 3\\\\2a &= 16\\\\a &= 8\\end{aligned}$$",
      "solutionDiagrams": []
    },
