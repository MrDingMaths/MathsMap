  "content": {
    "id": "p54-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The area $A\\text{ cm}^2$ of a triangle varies directly with its height $h\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=kh$",
          "worked": "Direct variation gives $A=kh$, where $k$ is the constant of proportionality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p54-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine $k$ if $A=12\\text{ cm}^2$ when $h=3\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=4$",
          "worked": "$$\\begin{align*}12&=3k\\\\k&=\\frac{12}{3}\\\\k&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "What are the units of $k$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "cm",
          "worked": "Since $k=\\frac{A}{h}$, its units are $\\text{cm}^2/\\text{cm}=\\text{cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p54-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Explain the units of $k$ using the formula for the area of a triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\frac12 bh$, so $k=\\frac12 b$. The base $b$ has units of cm, so $k$ also has units of cm.",
          "worked": "For a triangle with base $b$,\n$$A=\\frac12 bh.$$\nComparing this with $A=kh$ gives $k=\\frac12 b$. Since $b$ is measured in centimetres and $\\frac12$ is dimensionless, $k$ has units of cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
