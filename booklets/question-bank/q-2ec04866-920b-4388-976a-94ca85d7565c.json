    "answer": {
      "short": "Any of $4116$, $8232$, $20\\,580$, $41\\,160$, $102\\,900$ or $205\\,800$. The third number is $2^a\\times3\\times5^b\\times7^3$, where $a=2$ or $3$ and $b=0$, $1$ or $2$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p97-q89-factorisations",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}1176&=2^3\\times3^1\\times5^0\\times7^2\\\\2100&=2^2\\times3^1\\times5^2\\times7^1\\\\84&=2^2\\times3^1\\times5^0\\times7^1\\\\205\\,800&=2^3\\times3^1\\times5^2\\times7^3\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p97-q89-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The GCD uses the smallest powers and the LCM uses the largest powers.",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "The third number must contain ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "7^3",
                "display": false
              },
              {
                "type": "text",
                "text": " and exactly ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "3^1",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Its power of 2 can be 2 or 3, and independently its power of 5 can be 0, 1 or 2. No other prime factors are possible.",
                "marks": []
              }
            ]
          },
          {
            "id": "p97-q89-general-form",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "n=2^a\\times3^1\\times5^b\\times7^3",
                "display": false
              },
              {
                "type": "text",
                "text": ", where ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a\\in\\{2,3\\},\\quad b\\in\\{0,1,2\\}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
