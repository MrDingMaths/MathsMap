                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y&=(x^{-1}+x^{1/2})^2\\\\y&=x^{-2}+2x^{-1/2}+x\\\\y'&=-2x^{-3}+2\\left(-\\frac12x^{-3/2}\\right)+1\\\\y'&=-2x^{-3}-x^{-3/2}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
