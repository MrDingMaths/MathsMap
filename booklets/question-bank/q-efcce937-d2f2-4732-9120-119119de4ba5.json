        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac32x^{-5/2}$",
          "worked": "$$\\begin{align*}y&=x^{1/2-2}\\\\y&=x^{-3/2}\\\\y'&=-\\frac32x^{-5/2}\\end{align*}$$",
