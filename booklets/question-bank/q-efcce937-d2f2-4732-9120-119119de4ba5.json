        "answer": {
          "short": "$y'=7x^{5/2}$",
          "worked": "$$\\begin{align*}y&=\\frac{2x^5}{x^{3/2}}\\\\y&=2x^{7/2}\\\\y'&=2\\left(\\frac72x^{5/2}\\right)\\\\y'&=7x^{5/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p22-q63-72-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\dfrac{x^4-1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p22-q70-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y'=3x^2+2x+1\\quad(x\\ne1)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p22-q70-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Factor and cancel before differentiating.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y&=\\frac{(x-1)(x+1)(x^2+1)}{x-1}\\\\y&=(x+1)(x^2+1)\\qquad(x\\ne1)\\\\y&=x^3+x^2+x+1\\qquad(x\\ne1)\\\\y'&=3x^2+2x+1\\qquad(x\\ne1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
