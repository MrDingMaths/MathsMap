        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p22-q67-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y'=-3\\quad(x\\ne1)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p22-q67-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Factor and cancel first.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y&=\\frac{(3x-1)(x-1)}{-(x-1)}\\\\y&=1-3x\\qquad(x\\ne1)\\\\y'&=-3\\qquad(x\\ne1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q63-72-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{4x^2-9}{2x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2\\quad(x\\ne-\\tfrac32)$",
          "worked": "$$\\begin{align*}y&=\\frac{(2x-3)(2x+3)}{2x+3}\\\\y&=2x-3\\qquad(x\\ne-\\tfrac32)\\\\y'&=2\\qquad(x\\ne-\\tfrac32)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q63-72-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\dfrac{2x^5}{x\\sqrt{x}}$",
