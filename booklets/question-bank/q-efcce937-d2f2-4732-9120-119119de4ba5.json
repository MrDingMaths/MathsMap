        "answer": {
          "short": "$y'=\\dfrac{\\sqrt2}{2}x^{-1/2}$",
          "worked": "$$\\begin{align*}y&=\\sqrt2\\sqrt{x}\\\\y&=\\sqrt2x^{1/2}\\\\y'&=\\sqrt2\\left(\\frac12x^{-1/2}\\right)\\\\y'&=\\frac{\\sqrt2}{2}x^{-1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p22-q63-72-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x\\sqrt[3]{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac43x^{1/3}$",
          "worked": "$$\\begin{align*}y&=x\\cdot x^{1/3}\\\\y&=x^{4/3}\\\\y'&=\\frac43x^{1/3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q63-72-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{\\sqrt{x}}{x^2}$",
