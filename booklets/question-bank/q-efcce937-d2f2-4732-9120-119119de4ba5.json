        "answer": {
          "short": "$y'=-\\dfrac53x^{-8/3}$",
          "worked": "$$\\begin{align*}y&=x^{1/3-2}\\\\y&=x^{-5/3}\\\\y'&=-\\frac53x^{-8/3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q63-72-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{3x^2-4x+1}{1-x}$",
        "layout": "list",
        "columns": null,
