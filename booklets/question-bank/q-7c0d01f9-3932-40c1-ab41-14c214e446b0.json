  "content": {
    "id": "p11-q3",
    "type": "question",
    "label": "3",
    "prompt": "Darius thinks the ratio $2:3$ is the same as the ratio $1:2$, as the numbers have both been increased by $1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why Darius is wrong.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Equivalent ratios require multiplying or dividing both parts by the same number; adding $1$ to each part does not preserve this relationship.",
          "worked": "From $1:2$ to $2:3$, the first part is multiplied by $2$, but the second part is multiplied by $\\frac{3}{2}$. The factors differ, so the ratios are not equivalent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find a ratio that is the same as $2:3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4:6$ (for example).",
          "worked": "Multiply both parts by $2$.\n$$\\begin{align*}2:3&=(2\\times2):(3\\times2)\\\\&=4:6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
