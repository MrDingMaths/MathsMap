  "content": {
    "id": "p32-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the exact solutions to the following quadratic equations, using the quadratic formula.\nTo help you remember it, write down the formula every time.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+3x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-3\\pm\\sqrt{17}}{2}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p32-q2-a-coefficients",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=1,\\quad b=3,\\quad c=-2",
                    "display": false
                  }
                ]
              },
              {
                "id": "p32-q2-a-supplied-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p32-q2-a-substitution",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x&=\\frac{-3\\pm\\sqrt{3^2-4(1)(-2)}}{2(1)}\\\\x&=\\frac{-3\\pm\\sqrt{17}}{2}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p32-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+7x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-7\\pm\\sqrt{65}}{2}$",
          "worked": "$a=1,\\ b=7,\\ c=-4$.\n$$\\begin{aligned}x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{-7\\pm\\sqrt{7^2-4(1)(-4)}}{2(1)}\\\\x&=\\frac{-7\\pm\\sqrt{65}}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p32-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-7x+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{7\\pm\\sqrt{29}}{2}$",
          "worked": "$a=1,\\ b=-7,\\ c=5$.\n$$\\begin{aligned}x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{-(-7)\\pm\\sqrt{(-7)^2-4(1)(5)}}{2(1)}\\\\x&=\\frac{7\\pm\\sqrt{29}}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p32-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-8x+16=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$a=1,\\ b=-8,\\ c=16$.\n$$\\begin{aligned}x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{-(-8)\\pm\\sqrt{(-8)^2-4(1)(16)}}{2(1)}\\\\x&=\\frac{8\\pm\\sqrt{0}}{2}\\\\x&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      }
    ]
