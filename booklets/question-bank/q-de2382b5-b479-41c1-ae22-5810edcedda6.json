              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What is the constant of proportionality?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\pi$.",
          "worked": "The circle-area formula is $A=\\pi r^2$. Comparing with $A=kr^2$ gives $k=\\pi$.",
          "solutionDiagrams": []
        },
