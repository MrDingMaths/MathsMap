              "inlines": [
                {
                  "type": "text",
                  "text": "If the radius is tripled, by what factor does the area increase?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Factor $9$.",
          "worked": "Let $A_{\\text{new}}$ be the new area.\n$$\\begin{align*}\\frac{A_{\\text{new}}}{A} &= \\frac{k(3r)^2}{kr^2} \\\\\n\\frac{A_{\\text{new}}}{A} &= 9\\end{align*}$$\nThe area increases by a factor of $9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p98-q26-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
