  "content": {
    "id": "p14-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Factor where possible and then simplify:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2p+2q}{p+q}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{2p+2q}{p+q}&=\\frac{2(p+q)}{p+q}\\\\\\frac{2p+2q}{p+q}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3t-12}{2t-8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2}$",
          "worked": "$$\\begin{align*}\\frac{3t-12}{2t-8}&=\\frac{3(t-4)}{2(t-4)}\\\\\\frac{3t-12}{2t-8}&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2+3x}{3x+9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{3}$",
          "worked": "$$\\begin{align*}\\frac{x^2+3x}{3x+9}&=\\frac{x(x+3)}{3(x+3)}\\\\\\frac{x^2+3x}{3x+9}&=\\frac{x}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a}{ax+ay}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x+y}$",
          "worked": "$$\\begin{align*}\\frac{a}{ax+ay}&=\\frac{a}{a(x+y)}\\\\\\frac{a}{ax+ay}&=\\frac{1}{x+y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3a^2-6ab}{2a^2b-4ab^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2b}$",
          "worked": "$$\\begin{align*}\\frac{3a^2-6ab}{2a^2b-4ab^2}&=\\frac{3a(a-2b)}{2ab(a-2b)}\\\\\\frac{3a^2-6ab}{2a^2b-4ab^2}&=\\frac{3}{2b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x^2+2x}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{x-2}$",
          "worked": "$$\\begin{align*}\\frac{x^2+2x}{x^2-4}&=\\frac{x(x+2)}{(x-2)(x+2)}\\\\\\frac{x^2+2x}{x^2-4}&=\\frac{x}{x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{a^2-9}{a^2+a-12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a+3}{a+4}$",
          "worked": "$$\\begin{align*}\\frac{a^2-9}{a^2+a-12}&=\\frac{(a-3)(a+3)}{(a+4)(a-3)}\\\\\\frac{a^2-9}{a^2+a-12}&=\\frac{a+3}{a+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x^2+2x+1}{x^2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x-1}$",
          "worked": "$$\\begin{align*}\\frac{x^2+2x+1}{x^2-1}&=\\frac{(x+1)^2}{(x-1)(x+1)}\\\\\\frac{x^2+2x+1}{x^2-1}&=\\frac{x+1}{x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{x^2+10x+25}{x^2+9x+20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+5}{x+4}$",
          "worked": "$$\\begin{align*}\\frac{x^2+10x+25}{x^2+9x+20}&=\\frac{(x+5)^2}{(x+4)(x+5)}\\\\\\frac{x^2+10x+25}{x^2+9x+20}&=\\frac{x+5}{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
