  "content": {
    "id": "p7-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Solve the simultaneous equations using the substitution method.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=x+2\\\\y&=2x+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ y=1$.",
          "worked": "$$\\begin{align*}x+2&=2x+3\\\\-x&=1\\\\x&=-1\\\\y&=-1+2\\\\y&=1\\end{align*}$$\nCheck: $1=-1+2$ and $1=2(-1)+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=2x-1\\\\y&=3x+4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5,\\ y=-11$.",
          "worked": "$$\\begin{align*}2x-1&=3x+4\\\\-x&=5\\\\x&=-5\\\\y&=2(-5)-1\\\\y&=-11\\end{align*}$$\nCheck: $-11=2(-5)-1$ and $-11=3(-5)+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=2x+6\\\\y&=4x-2x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.\n\nSubstitution gives the contradiction $6=0$.",
          "worked": "$$\\begin{align*}2x+6&=4x-2x\\\\2x+6&=2x\\\\6&=0\\end{align*}$$\nThis contradiction means there is no solution. The equations describe parallel lines with different intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=x-1\\\\y&=3x-5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=1$.",
          "worked": "$$\\begin{align*}x-1&=3x-5\\\\4&=2x\\\\x&=2\\\\y&=2-1\\\\y&=1\\end{align*}$$\nCheck: $1=2-1$ and $1=3(2)-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}y&=1-x\\\\y&=3-2x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=-1$.",
          "worked": "$$\\begin{align*}1-x&=3-2x\\\\x&=2\\\\y&=1-2\\\\y&=-1\\end{align*}$$\nCheck: $-1=1-2$ and $-1=3-2(2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}y&=3x-5\\\\y&=6x-11\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=1$.",
          "worked": "$$\\begin{align*}3x-5&=6x-11\\\\6&=3x\\\\x&=2\\\\y&=3(2)-5\\\\y&=1\\end{align*}$$\nCheck: $1=3(2)-5$ and $1=6(2)-11$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}y&=4-3x\\\\y&=5x-2x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac23,\\ y=2$.",
          "worked": "$$\\begin{align*}4-3x&=5x-2x\\\\4-3x&=3x\\\\6x&=4\\\\x&=\\frac23\\\\y&=4-3\\left(\\frac23\\right)\\\\y&=2\\end{align*}$$\nCheck: $2=4-3(\\frac23)$ and $2=5(\\frac23)-2(\\frac23)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p7-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}y&=2x\\\\y&=5-2x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac54,\\ y=\\dfrac52$.",
          "worked": "$$\\begin{align*}2x&=5-2x\\\\4x&=5\\\\x&=\\frac54\\\\y&=2\\left(\\frac54\\right)\\\\y&=\\frac52\\end{align*}$$\nCheck: $\\frac52=2(\\frac54)$ and $\\frac52=5-2(\\frac54)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      }
    ]
  },
