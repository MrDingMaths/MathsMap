  "content": {
    "id": "p41-25j-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "From the numbers $1,\\ldots,20$, three are chosen at random. Find the probability that no two are consecutive.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
