    "id": "p3-ch2-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The lengths of the sides of a triangle are $8.2\\text{ cm}$, $11.6\\text{ cm}$ and $14.3\\text{ cm}$. Is the triangle right-angled?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No.",
      "worked": "The longest side is $14.3\\text{ cm}$.\n$$\\begin{align*}8.2^2+11.6^2&=201.8\\\\14.3^2&=204.49\\end{align*}$$\nSince $201.8\\ne204.49$, the triangle is not right-angled.",
      "solutionDiagrams": []
