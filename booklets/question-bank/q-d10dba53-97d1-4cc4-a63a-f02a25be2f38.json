  "content": {
    "id": "p17-q57-question",
    "type": "question",
    "label": null,
    "prompt": "Let $A$ and $B$ be sets. The set of all functions from $A$ to $B$ is denoted $B^A$.\n\nFor each of the following, find how many elements are in $B^A$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q57-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\{p\\}$ and $B=\\{a,b,c,d,e,f\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "The single input $p$ has six possible outputs.\n\n$$6^1=6$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q57-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\{a,b,c,d,e,f\\}$ and $B=\\{p\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Each of the six inputs must map to $p$, so each has one output choice.\n\n$$1^6=1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q57-c",
        "type": "part",
        "label": "c",
        "prompt": "$A=\\{0,1,2\\}$ and $B=\\{a,b\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "Each of the three inputs independently has two output choices. Outputs may be repeated.\n\n$$2\\times2\\times2=8$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q57-d",
        "type": "part",
        "label": "d",
        "prompt": "$A=\\{x,y\\}$ and $B=\\{1,2,3\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "Each of the two inputs independently has three output choices. Outputs may be repeated.\n\n$$3\\times3=9$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
