  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Write the equations of the lines with these gradients and $y$-intercepts.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Gradient $7$ and $y$-intercept $(0,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 7x + 2$",
          "worked": "$m = 7$, $c = 2$.\n$$\\begin{align*}y &= mx + c\\\\y &= 7x + 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept $(0,-9)$ and gradient $4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 4x - 9$",
          "worked": "$m = 4$, $c = -9$.\n$$\\begin{align*}y &= mx + c\\\\y &= 4x - 9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p5-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Gradient $-5$ and $y$-intercept $(0,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = -5x$",
          "worked": "$m = -5$, $c = 0$.\n$$\\begin{align*}y &= mx + c\\\\y &= -5x + 0\\\\y &= -5x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y$-intercept $(0,11)$ and gradient $-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = -x + 11$",
          "worked": "$m = -1$, $c = 11$.\n$$\\begin{align*}y &= mx + c\\\\y &= -1x + 11\\\\y &= -x + 11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Gradient $-0.65$ and $y$-intercept $(0,-1.2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = -0.65x - 1.2$",
          "worked": "$m = -0.65$, $c = -1.2$.\n$$\\begin{align*}y &= mx + c\\\\y &= -0.65x - 1.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p5-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$y$-intercept $\\left(0,\\frac{7}{12}\\right)$ and gradient $\\frac{5}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = \\frac{5x}{6} + \\frac{7}{12}$",
          "worked": "$m = \\frac{5}{6}$, $c = \\frac{7}{12}$.\n$$\\begin{align*}y &= mx + c\\\\y &= \\frac{5x}{6} + \\frac{7}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
