      {
        "id": "p53-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution of $y'=e^{-y}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln(x+C)$, where $x+C>0$.",
          "worked": "$$\\begin{align*}e^y\\,dy&=dx\\\\e^y&=x+C\\\\y&=\\ln(x+C),\\qquad x+C>0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p53-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Describe the family of curves.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal translations of $y=\\ln x$, with different $x$-intercepts.",
          "worked": "Each curve $y=\\ln(x+C)$ is a horizontal translation of $y=\\ln x$. Its vertical asymptote is $x=-C$ and its $x$-intercept is $1-C$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p53-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Evaluate the arbitrary constant given the curve passes through $(0,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=e$, so $y=\\ln(x+e)$.",
          "worked": "$$\\begin{align*}e^1&=0+C\\\\C&=e\\\\y&=\\ln(x+e).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
