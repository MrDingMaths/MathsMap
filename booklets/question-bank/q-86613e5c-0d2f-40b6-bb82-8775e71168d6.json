        ],
        "children": [],
        "answer": {
          "short": "$30^\\circ$",
          "worked": "Opposite: $5\\,\\mathrm{cm}$; hypotenuse: $10\\,\\mathrm{cm}$. Use sine.\n$$\\begin{align*}\\sin\\theta&=\\frac{O}{H}\\\\\\sin\\theta&=\\frac{5}{10}\\\\\\theta&=\\sin^{-1}\\left(\\frac{5}{10}\\right)\\\\\\theta&=30^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48,
