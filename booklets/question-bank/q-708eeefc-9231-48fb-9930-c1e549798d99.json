    "children": [
      {
        "id": "p24-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+6x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3-\\sqrt{11}$ or $x=-3+\\sqrt{11}$.",
          "worked": "$$\\begin{align*}x^2+6x+9-9-2&=0\\\\(x+3)^2-11&=0\\\\(x+3)^2&=11\\\\x+3&=\\pm\\sqrt{11}\\\\x&=-3\\pm\\sqrt{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p24-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-4x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2-2\\sqrt{2}$ or $x=2+2\\sqrt{2}$.",
          "worked": "$$\\begin{align*}x^2-4x+4-4-4&=0\\\\(x-2)^2-8&=0\\\\(x-2)^2&=8\\\\x-2&=\\pm2\\sqrt{2}\\\\x&=2\\pm2\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p24-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-10x+20=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5-\\sqrt{5}$ or $x=5+\\sqrt{5}$.",
          "worked": "$$\\begin{align*}x^2-10x+25-25+20&=0\\\\(x-5)^2-5&=0\\\\(x-5)^2&=5\\\\x-5&=\\pm\\sqrt{5}\\\\x&=5\\pm\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p24-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+5x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-5-\\sqrt{13}}{2}$ or $x=\\dfrac{-5+\\sqrt{13}}{2}$.",
          "worked": "$$\\begin{align*}x^2+5x+\\frac{25}{4}-\\frac{25}{4}+3&=0\\\\\\left(x+\\frac52\\right)^2-\\frac{13}{4}&=0\\\\\\left(x+\\frac52\\right)^2&=\\frac{13}{4}\\\\x+\\frac52&=\\pm\\frac{\\sqrt{13}}2\\\\x&=\\frac{-5\\pm\\sqrt{13}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p24-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-7x+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{7-\\sqrt{29}}{2}$ or $x=\\dfrac{7+\\sqrt{29}}{2}$.",
          "worked": "$$\\begin{align*}x^2-7x+\\frac{49}{4}-\\frac{49}{4}+5&=0\\\\\\left(x-\\frac72\\right)^2-\\frac{29}{4}&=0\\\\\\left(x-\\frac72\\right)^2&=\\frac{29}{4}\\\\x-\\frac72&=\\pm\\frac{\\sqrt{29}}2\\\\x&=\\frac{7\\pm\\sqrt{29}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p24-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2+3x-7=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-3-\\sqrt{37}}{2}$ or $x=\\dfrac{-3+\\sqrt{37}}{2}$.",
          "worked": "$$\\begin{align*}x^2+3x+\\frac94-\\frac94-7&=0\\\\\\left(x+\\frac32\\right)^2-\\frac{37}{4}&=0\\\\\\left(x+\\frac32\\right)^2&=\\frac{37}{4}\\\\x+\\frac32&=\\pm\\frac{\\sqrt{37}}2\\\\x&=\\frac{-3\\pm\\sqrt{37}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
