  "content": {
    "id": "p16-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Without the use of your calculator, express each of the following numbers as a product of prime factors:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$6^4+6^2-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times5\\times7\\times19$",
          "worked": "Treat the expression as a quadratic in $6^2$.\n$$\\begin{align*}6^4+6^2-2&=(6^2+2)(6^2-1)\\\\6^4+6^2-2&=38\\times35\\\\6^4+6^2-2&=(2\\times19)(5\\times7)\\\\6^4+6^2-2&=2\\times5\\times7\\times19\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p16-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^4+5^2-56$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times3^3\\times11$",
          "worked": "Treat the expression as a quadratic in $5^2$.\n$$\\begin{align*}5^4+5^2-56&=(5^2+8)(5^2-7)\\\\5^4+5^2-56&=33\\times18\\\\5^4+5^2-56&=(3\\times11)(2\\times3^2)\\\\5^4+5^2-56&=2\\times3^3\\times11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p16-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^6+3^3-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times3\\times5^3$",
          "worked": "Treat the expression as a quadratic in $3^3$.\n$$\\begin{align*}3^6+3^3-6&=(3^3)^2+3^3-6\\\\3^6+3^3-6&=(3^3+3)(3^3-2)\\\\3^6+3^3-6&=30\\times25\\\\3^6+3^3-6&=(2\\times3\\times5)5^2\\\\3^6+3^3-6&=2\\times3\\times5^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p16-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$10^4-10^2-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^5\\times3\\times103$",
          "worked": "Treat the expression as a quadratic in $10^2$.\n$$\\begin{align*}10^4-10^2-12&=(10^2+3)(10^2-4)\\\\10^4-10^2-12&=103\\times96\\\\10^4-10^2-12&=103(2^5\\times3)\\\\10^4-10^2-12&=2^5\\times3\\times103\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p16-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$4^6+(3\\times4^3)-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times3\\times23\\times31$",
          "worked": "Treat the expression as a quadratic in $4^3$.\n$$\\begin{align*}4^6+(3\\times4^3)-10&=(4^3)^2+3\\times4^3-10\\\\4^6+(3\\times4^3)-10&=(4^3+5)(4^3-2)\\\\4^6+(3\\times4^3)-10&=69\\times62\\\\4^6+(3\\times4^3)-10&=(3\\times23)(2\\times31)\\\\4^6+(3\\times4^3)-10&=2\\times3\\times23\\times31\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p16-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$2^8+2^5-24$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^3\\times3\\times11$",
          "worked": "Treat the expression as a quadratic in $2^4$.\n$$\\begin{align*}2^8+2^5-24&=(2^4)^2+2\\times2^4-24\\\\2^8+2^5-24&=(2^4+6)(2^4-4)\\\\2^8+2^5-24&=22\\times12\\\\2^8+2^5-24&=(2\\times11)(2^2\\times3)\\\\2^8+2^5-24&=2^3\\times3\\times11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
