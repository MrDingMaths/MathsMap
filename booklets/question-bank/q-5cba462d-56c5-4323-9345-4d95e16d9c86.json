  "content": {
    "id": "p10-q6",
    "type": "question",
    "label": "6",
    "prompt": "Let $f(x)=x^3+5x$.\n\nGiven $f(1)=6$, find $(f^{-1})'(6)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac18$",
      "worked": "$$\\begin{aligned}f'(x)&=3x^2+5\\\\(f^{-1})'(x)&=\\frac{1}{f'(f^{-1}(x))}\\end{aligned}$$\nSince $f(1)=6$, $f^{-1}(6)=1$.\n$$\\begin{aligned}(f^{-1})'(6)&=\\frac{1}{f'(1)}\\\\&=\\frac{1}{3(1)^2+5}\\\\&=\\frac18\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
