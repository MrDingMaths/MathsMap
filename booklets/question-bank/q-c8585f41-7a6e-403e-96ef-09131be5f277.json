  "content": {
    "id": "p31-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "When the kindergarten children arrived yesterday, $\\frac{1}{4}$ of them were wearing skirts, $\\frac{2}{5}$ were wearing shorts, $\\frac{3}{10}$ were wearing dresses and the rest of the children were wearing jeans. What percentage of the children were wearing jeans?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5\\%$",
      "worked": "$$\\begin{align*}\\text{Skirts}&=\\frac{1}{4}=\\frac{25}{100}=25\\%\\\\\\text{Shorts}&=\\frac{2}{5}=\\frac{40}{100}=40\\%\\\\\\text{Dresses}&=\\frac{3}{10}=\\frac{30}{100}=30\\%\\\\\\text{Jeans}&=100\\%-(25\\%+40\\%+30\\%)\\\\\\text{Jeans}&=5\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
