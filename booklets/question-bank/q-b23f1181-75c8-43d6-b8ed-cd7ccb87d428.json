    "children": [
      {
        "id": "p8-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2\\sin(x-y)}{\\cos(x+y)-\\cos(x-y)}=\\cot x-\\cot y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\cot x-\\cot y=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{2\\sin x\\cos y-2\\cos x\\sin y}{\\cos x\\cos y-\\sin x\\sin y-(\\cos x\\cos y+\\sin x\\sin y)}\\\\&=\\frac{2\\sin x\\cos y-2\\cos x\\sin y}{-2\\sin x\\sin y}\\\\&=\\frac{2\\sin x\\cos y}{-2\\sin x\\sin y}-\\frac{2\\cos x\\sin y}{-2\\sin x\\sin y}\\\\&=-\\frac{\\cos y}{\\sin y}+\\frac{\\cos x}{\\sin x}\\\\&=-\\cot y+\\cot x\\\\&=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p8-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sin(\\theta+\\phi)}{\\cos(\\theta-\\phi)}=\\dfrac{\\tan\\theta+\\tan\\phi}{1+\\tan\\theta\\tan\\phi}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\tan\\theta+\\tan\\phi}{1+\\tan\\theta\\tan\\phi}=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{\\sin\\theta\\cos\\phi+\\cos\\theta\\sin\\phi}{\\cos\\theta\\cos\\phi+\\sin\\theta\\sin\\phi}.\\end{aligned}$$\nDivide numerator and denominator by $\\cos\\theta\\cos\\phi$.\n$$\\begin{aligned}\\mathrm{LHS}&=\\frac{\\tan\\theta+\\tan\\phi}{1+\\tan\\theta\\tan\\phi}\\\\&=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
