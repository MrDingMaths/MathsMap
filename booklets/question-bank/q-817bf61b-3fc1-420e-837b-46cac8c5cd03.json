  "content": {
    "id": "p47-q25-root",
    "type": "question",
    "label": null,
    "prompt": "A tangent is drawn to a curve, and its $x$-intercept is 1 less than the $x$-coordinate of the point of contact.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the gradient of the line from $(x-1,0)$ to $(x,y)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$",
          "worked": "$$\\begin{aligned}m&=\\frac{y-0}{x-(x-1)}\\\\&=\\frac{y}{1}\\\\&=y\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p47-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "Now suppose $(x,y)$ is on this curve. Write down a DE for this curve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=y$",
          "worked": "The derivative equals the tangent gradient, so $\\dfrac{dy}{dx}=y$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p47-q25-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence determine the general equation of this curve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=Ae^x$, where $A\\ne0$.",
          "worked": "$$\\begin{aligned}\\frac{dy}{y}&=dx\\\\\\int\\frac{1}{y}\\,dy&=\\int1\\,dx\\\\\\ln|y|&=x+C\\\\y&=Ae^x\\end{aligned}$$\nHere $A\\ne0$: the constant solution $y=0$ has the $x$-axis as its tangent and does not have the specified single $x$-intercept.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p47-q25-d",
        "type": "part",
        "label": "d",
        "prompt": "Find such a curve passing through $(0,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^x$",
          "worked": "$$\\begin{aligned}1&=Ae^0\\\\A&=1\\\\y&=e^x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
