    "id": "p22-q63-response",
    "type": "question",
    "label": "17",
    "prompt": "Show that the conjugate of $\\dfrac{1+\\sqrt3}{1-\\sqrt3}$ is $\\dfrac{1-\\sqrt3}{1+\\sqrt3}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
