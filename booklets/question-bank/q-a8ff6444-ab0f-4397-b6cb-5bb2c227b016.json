    "type": "question",
    "label": "4",
    "prompt": "The difference between two numbers is $11\\frac{3}{28}$, and the smaller number is $15\\frac{5}{21}$. Find the larger number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$26\\frac{29}{84}$",
      "worked": "The larger number equals the smaller number plus the difference.\n$$\\begin{align*}15\\frac{5}{21}+11\\frac{3}{28}&=26+\\frac{5}{21}+\\frac{3}{28}\\\\15\\frac{5}{21}+11\\frac{3}{28}&=26+\\frac{20}{84}+\\frac{9}{84}\\\\15\\frac{5}{21}+11\\frac{3}{28}&=26\\frac{29}{84}\\end{align*}$$",
      "solutionDiagrams": []
    },
