              }
            ]
          },
          {
            "id": "p62-q6-worked-height",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x=168+1.28(9)\\approx179.5\\text{ cm}",
                "display": false
              }
            ]
