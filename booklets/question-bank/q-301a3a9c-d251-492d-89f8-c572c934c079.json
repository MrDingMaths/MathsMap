  "content": {
    "id": "p62-q6",
    "type": "question",
    "label": "6",
    "prompt": "Heights of Year 12 males are approximately normally distributed with mean 168 cm and standard deviation 9 cm. Bradley is a Year 12 male whose height puts him just inside the top 10%. Find Bradley’s height, answer to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$179.5\\text{ cm}$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p62-q6-worked-probability",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "We want a z-score with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "P(Z\\le z)=0.9",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p62-q6-worked-table",
            "type": "paragraph",
