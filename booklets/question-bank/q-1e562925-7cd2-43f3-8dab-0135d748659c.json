  "content": {
    "id": "p33-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A regular die is rolled twice. Find the expected number of times a 6 is rolled.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{3}$",
      "worked": "Let $X$ be the number of sixes rolled. The rolls are independent.\n$$\\begin{align*}P(X=0)&=\\left(\\frac56\\right)^2=\\frac{25}{36}\\\\P(X=1)&=2\\times\\frac16\\times\\frac56=\\frac{10}{36}\\\\P(X=2)&=\\left(\\frac16\\right)^2=\\frac1{36}\\\\E(X)&=0\\times\\frac{25}{36}+1\\times\\frac{10}{36}+2\\times\\frac1{36}\\\\E(X)&=\\frac13.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
