  "content": {
    "id": "p5-q7",
    "type": "question",
    "label": "7",
    "prompt": "Sam started the week with a debt of $\\$360.50$. He worked hard and earned $\\$3100$, but had $\\$250$ stolen. He won $\\$80.20$ in the lottery and had to pay an electricity bill of $\\$210$. After paying his debt and his electricity bill, how much did Sam have left?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$2359.70$",
      "worked": "$$\\begin{align*}\\text{Money left}&=3100-360.50-250+80.20-210\\\\\\text{Money left}&=2739.50-250+80.20-210\\\\\\text{Money left}&=2489.50+80.20-210\\\\\\text{Money left}&=2569.70-210\\\\\\text{Money left}&=2359.70\\end{align*}$$\nSam had $\\$2359.70$ left.",
      "solutionDiagrams": []
    },
