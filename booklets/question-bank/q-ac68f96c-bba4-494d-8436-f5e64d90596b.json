        "children": [],
        "answer": {
          "short": "$\\frac{dy}{dx}=\\frac{x^2+2}{x^2}$",
          "worked": "$\\begin{aligned}y&=x+3-2x^{-1}\\\\\\frac{dy}{dx}&=1+2x^{-2}\\\\\\frac{dy}{dx}&=\\frac{x^2+2}{x^2}\\end{aligned}$",
