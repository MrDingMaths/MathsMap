      {
        "id": "p30-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the inverse of\n$$f=\\{(1,2),(2,3),(3,4),(4,1)\\}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}=\\{(2,1),(3,2),(4,3),(1,4)\\}$.",
          "worked": "Reverse the coordinates in each ordered pair:\n$$f^{-1}=\\{(2,1),(3,2),(4,3),(1,4)\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why there is no inverse of\n$$f=\\{(1,2),(2,3),(3,2),(4,1)\\}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "There is no inverse function because $f(1)=f(3)=2$ although $1\\ne3$, so $f$ is not injective.",
          "worked": "$f(1)=f(3)=2$ although $1\\ne3$, so $f$ is not injective. Reversing the pairs would assign both $1$ and $3$ to the input $2$, which does not define a function. Therefore, $f$ has no inverse function.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
