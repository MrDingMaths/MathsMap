  "content": {
    "id": "v2-d2748-p15-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "A particle moves in a straight line according to $x=6te^{-0.5t}$, where $x$ is its displacement in metres and $t\\ge0$ is time in seconds.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d2748-p15-practice-slot-6-slot-6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression for its velocity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=3(2-t)e^{-0.5t}$ m/s.",
          "worked": "$$\\begin{align*}v=\\frac{dx}{dt}&=6e^{-0.5t}+6t(-0.5e^{-0.5t})\\\\&=6e^{-0.5t}-3te^{-0.5t}\\\\&=3(2-t)e^{-0.5t}\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-d2748-p15-practice-slot-6-slot-6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find when the particle is momentarily at rest, and its displacement then, to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "At $t=2$ s; $x=\\dfrac{12}{e}\\approx4.41$ m.",
          "worked": "At rest, $v=0$:\n$$3(2-t)e^{-0.5t}=0.$$\nSince $e^{-0.5t}>0$, $t=2$ s.\n$$\\begin{align*}x(2)&=6(2)e^{-1}\\\\&=\\frac{12}{e}\\\\&\\approx4.41\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-d2748-p15-practice-slot-6-slot-6-q-c",
        "type": "part",
        "label": "c",
        "prompt": "What happens to its displacement and velocity as $t\\to\\infty$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Displacement and velocity both approach $0$.",
          "worked": "As $t\\to\\infty$, $e^{-0.5t}\\to0$ faster than $t$ grows, so\n$$\\begin{align*}x&=6te^{-0.5t}\\\\&\\to0\\text{ m}.\\end{align*}$$\nSimilarly,\n$$\\begin{align*}v&=3(2-t)e^{-0.5t}\\\\&\\to0\\text{ m/s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
