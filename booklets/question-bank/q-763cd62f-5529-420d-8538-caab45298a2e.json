              "inlines": [
                {
                  "type": "text",
                  "text": "Suppose that",
                  "marks": []
                }
              ]
            },
            {
              "id": "p16-q50-b-identity",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "x^5-x=Q(x)+R(x)",
                  "display": true
