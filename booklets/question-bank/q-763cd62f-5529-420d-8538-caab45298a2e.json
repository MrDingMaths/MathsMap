        "type": "part",
        "label": "a",
        "prompt": "Expand $Q(x)=(x-2)(x-1)x(x+1)(x+2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(x)=x^5-5x^3+4x$.",
          "worked": "$$\\begin{align*}\nQ(x)&=x(x-2)(x+2)(x-1)(x+1)\\\\\nQ(x)&=x(x^2-4)(x^2-1)\\\\\nQ(x)&=x(x^4-5x^2+4)\\\\\nQ(x)&=x^5-5x^3+4x.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q50-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p16-q50-b-intro",
              "type": "paragraph",
