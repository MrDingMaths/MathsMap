              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "for some polynomial ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "R(x)",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ". Find ",
                  "marks": []
