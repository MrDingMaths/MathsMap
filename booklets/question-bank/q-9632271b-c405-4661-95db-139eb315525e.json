  "content": {
    "id": "p4-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Give a reason for why $\\log_1 x$ is not defined.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Since $1^y=1$ for every $y$, there is no exponent giving $x\\ne1$, and no unique exponent when $x=1$.",
      "worked": "If $\\log_1 x=y$, the exponential definition requires $1^y=x$. But $1^y=1$ for every real $y$. For $x\\ne1$ there is no solution; for $x=1$ every real $y$ is a solution. Thus base 1 does not give a uniquely defined logarithm.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
