      {
        "id": "backfill-factor-theorem-5-root",
        "type": "part",
        "label": "a",
        "prompt": "Prove that $x^n+1$ is divisible by $(x+1)$ for every odd positive integer $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-1)=(-1)^n+1=0$ for odd $n$, so $x+1$ is a factor of $x^n+1$.",
          "worked": "Let $P(x)=x^n+1$.\n$$\\begin{align*}P(-1)&=(-1)^n+1\\\\P(-1)&=-1+1\\\\P(-1)&=0\\end{align*}$$\nSince $(-1)^n=-1$ for every odd positive integer $n$, the factor theorem shows that $x+1$ divides $x^n+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "backfill-factor-theorem-6-root",
        "type": "part",
        "label": "b",
        "prompt": "Prove that $x^n-3^n$ is always divisible by $(x-3)$ for every positive integer $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(3)=3^n-3^n=0$, so $x-3$ is a factor of $x^n-3^n$.",
          "worked": "Let $P(x)=x^n-3^n$.\n$$\\begin{align*}P(3)&=3^n-3^n\\\\P(3)&=0\\end{align*}$$\nBy the factor theorem, $x-3$ divides $x^n-3^n$ for every positive integer $n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
