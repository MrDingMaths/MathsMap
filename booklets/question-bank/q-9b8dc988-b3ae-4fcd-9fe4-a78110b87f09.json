        "prompt": "$\\sqrt8\\times\\sqrt8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\sqrt8\\times\\sqrt8=(\\sqrt8)^2=8$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p3-surds-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt a-\\sqrt b)(\\sqrt a+\\sqrt b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a-b$",
          "worked": "$$\\begin{align*}(\\sqrt a-\\sqrt b)(\\sqrt a+\\sqrt b)&=(\\sqrt a)^2-(\\sqrt b)^2\\\\(\\sqrt a-\\sqrt b)(\\sqrt a+\\sqrt b)&=a-b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-surds-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\sqrt a+\\sqrt b)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+2\\sqrt{ab}+b$",
          "worked": "$$\\begin{align*}(\\sqrt a+\\sqrt b)^2&=(\\sqrt a)^2+2\\sqrt a\\sqrt b+(\\sqrt b)^2\\\\(\\sqrt a+\\sqrt b)^2&=a+2\\sqrt{ab}+b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
