  "content": {
    "id": "p16-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the fraction halfway between $\\frac{5}{8}$ and $\\frac{8}{13}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{129}{208}$",
      "worked": "Using a common denominator,\n$$\\begin{align*}\\frac{5}{8}&=\\frac{65}{104}\\\\\\frac{8}{13}&=\\frac{64}{104}.\\end{align*}$$\nThe numerators differ by 1, so double both numerators and denominators:\n$$\\begin{align*}\\frac{5}{8}&=\\frac{130}{208}\\\\\\frac{8}{13}&=\\frac{128}{208}.\\end{align*}$$\nThe numerator halfway between 128 and 130 is 129. Therefore, the fraction halfway between is $\\frac{129}{208}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 74
  },
