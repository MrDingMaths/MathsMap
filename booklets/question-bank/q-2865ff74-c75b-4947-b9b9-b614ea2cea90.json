  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Two of the roots of $x^3-px^2-qx+30=0$ are $3$ and $5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q9a",
        "type": "part",
        "label": "a",
        "prompt": "Find the other root.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "Let the other root be $\\gamma$. Using the product of roots,\n$$\\begin{align*}(3)(5)\\gamma&=-30\\\\\\gamma&=-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q9b",
        "type": "part",
        "label": "b",
        "prompt": "Find $p$ and $q$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=6,\\ q=1$.",
          "worked": "Using the sum of roots,\n$$\\begin{align*}p&=3+5+(-2)\\\\&=6.\\end{align*}$$\nUsing the sum of products taken two at a time,\n$$\\begin{align*}-q&=3(5)+3(-2)+5(-2)\\\\&=-1\\\\q&=1.\\end{align*}$$\nThus the equation is $x^3-6x^2-x+30=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
