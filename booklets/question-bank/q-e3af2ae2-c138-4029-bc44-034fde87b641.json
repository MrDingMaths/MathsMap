        "type": "part",
        "label": "a",
        "prompt": "$\\left( \\frac{3x}{2y} \\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9x^{2}}{4y^{2}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{3x}{2y} \\right)^{2} &= \\frac{3^{2}\\,x^{2}}{2^{2}\\,y^{2}} \\\\\n&= \\frac{9x^{2}}{4y^{2}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left( \\frac{4m}{n} \\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{16m^{2}}{n^{2}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{4m}{n} \\right)^{2} &= \\frac{4^{2}\\,m^{2}}{n^{2}} \\\\\n&= \\frac{16m^{2}}{n^{2}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left( \\frac{2x^{2}}{3y} \\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x^{4}}{9y^{2}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{2x^{2}}{3y} \\right)^{2} &= \\frac{2^{2}\\,x^{2\\times2}}{3^{2}\\,y^{2}} \\\\\n&= \\frac{4x^{4}}{9y^{2}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left( \\frac{2a}{5b} \\right)^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8a^{3}}{125b^{3}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{2a}{5b} \\right)^{3} &= \\frac{2^{3}\\,a^{3}}{5^{3}\\,b^{3}} \\\\\n&= \\frac{8a^{3}}{125b^{3}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left( \\frac{p}{3q} \\right)^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{p^{3}}{27q^{3}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{p}{3q} \\right)^{3} &= \\frac{p^{3}}{3^{3}\\,q^{3}} \\\\\n&= \\frac{p^{3}}{27q^{3}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left( \\frac{5a}{2b^{3}} \\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25a^{2}}{4b^{6}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{5a}{2b^{3}} \\right)^{2} &= \\frac{5^{2}\\,a^{2}}{2^{2}\\,b^{3\\times2}} \\\\\n&= \\frac{25a^{2}}{4b^{6}}\n\\end{align*}$$",
