  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the perfect square prior to $10\\,000$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9801$",
      "worked": "Since $10\\,000=100^2$, the preceding perfect square is $99^2$.\n\n$$\\begin{align*}99^2&=(100-1)^2\\\\99^2&=100^2-2(100)(1)+1^2\\\\99^2&=10\\,000-200+1\\\\99^2&=9801.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
