    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q9-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the Pythagorean triple corresponding to:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q9-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$m=4$ and $n=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(7,24,25)$",
              "worked": "$$\\begin{align*}a&=4^2-3^2=7\\\\b&=2\\times4\\times3=24\\\\c&=4^2+3^2=25\\end{align*}$$\nThe triple is $(7,24,25)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p19-q9-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$m=7$ and $n=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(33,56,65)$",
              "worked": "$$\\begin{align*}a&=7^2-4^2=33\\\\b&=2\\times7\\times4=56\\\\c&=7^2+4^2=65\\end{align*}$$\nThe triple is $(33,56,65)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p19-q9-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$m=8$ and $n=5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(39,80,89)$",
              "worked": "$$\\begin{align*}a&=8^2-5^2=39\\\\b&=2\\times8\\times5=80\\\\c&=8^2+5^2=89\\end{align*}$$\nThe triple is $(39,80,89)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      },
      {
        "id": "p19-q9-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the values of $m$ and $n$ that yield these Pythagorean triples:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q9-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$(3,4,5)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$m=2$, $n=1$",
              "worked": "Adding and subtracting $a=m^2-n^2$ and $c=m^2+n^2$ gives\n$$\\begin{align*}m^2&=\\frac{c+a}{2}=\\frac{5+3}{2}=4\\\\n^2&=\\frac{c-a}{2}=\\frac{5-3}{2}=1\\end{align*}$$\nThus $m=2$ and $n=1$. Check: $2mn=2\\times2\\times1=4=b$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p19-q9-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$(5,12,13)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$m=3$, $n=2$",
              "worked": "Adding and subtracting the formulas for $a$ and $c$ gives\n$$\\begin{align*}m^2&=\\frac{c+a}{2}=\\frac{13+5}{2}=9\\\\n^2&=\\frac{c-a}{2}=\\frac{13-5}{2}=4\\end{align*}$$\nThus $m=3$ and $n=2$. Check: $2mn=2\\times3\\times2=12=b$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p19-q9-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$(7,24,25)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$m=4$, $n=3$",
              "worked": "Adding and subtracting the formulas for $a$ and $c$ gives\n$$\\begin{align*}m^2&=\\frac{c+a}{2}=\\frac{25+7}{2}=16\\\\n^2&=\\frac{c-a}{2}=\\frac{25-7}{2}=9\\end{align*}$$\nThus $m=4$ and $n=3$. Check: $2mn=2\\times4\\times3=24=b$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      },
      {
        "id": "p19-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Prove that if $a$, $b$ and $c$ are given by Euclid’s formula, then $(a,b,c)$ is a Pythagorean triple.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+b^2=(m^2+n^2)^2=c^2$.\n\nExpand and simplify the squares in Euclid’s formula.",
          "worked": "$$\\begin{align*}a^2+b^2&=(m^2-n^2)^2+(2mn)^2\\\\a^2+b^2&=m^4-2m^2n^2+n^4+4m^2n^2\\\\a^2+b^2&=m^4+2m^2n^2+n^4\\\\a^2+b^2&=(m^2+n^2)^2\\\\a^2+b^2&=c^2\\end{align*}$$\nSince $m$ and $n$ are positive integers with $m>n$, the values of $a$, $b$ and $c$ are positive integers. Therefore $(a,b,c)$ is a Pythagorean triple.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
