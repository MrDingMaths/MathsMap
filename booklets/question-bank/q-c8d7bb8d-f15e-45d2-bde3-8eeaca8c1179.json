          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "a=m^2-n^2,\\quad b=2mn,\\quad c=m^2+n^2,",
              "display": true
            }
          ]
        },
        {
          "id": "p19-q9-primitive-condition",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "then ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "(a,b,c)",
              "display": false
            },
            {
              "type": "text",
              "text": " is a Pythagorean triple. In fact, it can be shown that every primitive Pythagorean triple is of this form for some choice of ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "m",
              "display": false
            },
            {
