      {
        "id": "v2-8424b-p43-practice-slot-7-s7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "A fair die is rolled 9 times. Find the probability that a number greater than 4 is rolled exactly 4 times.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.2048$",
          "worked": "Let $X$ be the number of rolls greater than 4. Then $p=\\frac26=\\frac13$ and $X\\sim\\operatorname{Bin}\\left(9,\\frac13\\right)$.\n$$\\begin{align*}P(X=4)&=\\binom{9}{4}\\left(\\frac13\\right)^4\\left(\\frac23\\right)^5\\\\&\\approx0.2048\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-8424b-p43-practice-slot-7-s7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "A nursery finds that each seed in its wildflower mix germinates with probability 0.9, independently. From a packet of 15 seeds, find the probability that exactly 2 seeds fail to germinate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.2669$",
          "worked": "Let $Y$ be the number of seeds that fail to germinate. Then $Y\\sim\\operatorname{Bin}(15,0.1)$.\n$$\\begin{align*}P(Y=2)&=\\binom{15}{2}(0.1)^2(0.9)^{13}\\\\&\\approx0.2669\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
