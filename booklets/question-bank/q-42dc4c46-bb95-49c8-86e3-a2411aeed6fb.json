  "content": {
    "id": "p38-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A car travels at 90 km/h, so in $n$ hours it has travelled $90n$ kilometres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "How far does the car travel in 3 hours (i.e. $n=3$)?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$270$ km",
          "worked": "$$\\begin{align*}d&=90\\times3\\\\d&=270\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p38-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "How far does the car travel in 30 minutes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45$ km",
          "worked": "$$\\begin{align*}n&=\\frac{30}{60}\\\\n&=\\frac12\\text{ hour}\\\\d&=90\\times\\frac12\\\\d&=45\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p38-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an expression for the distance travelled in $n$ hours for a bike with speed 70 km/h.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70n$ km",
          "worked": "$d=70n$ km.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
