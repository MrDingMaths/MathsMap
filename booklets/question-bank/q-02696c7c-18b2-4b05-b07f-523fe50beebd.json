    "type": "question",
    "label": null,
    "prompt": "For what value of $k$ is $\\dfrac{kx-15}{2x-3}=5$ true for all $x\\ne\\frac32$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=10$.",
      "worked": "The numerator must equal $5(2x-3)$.\n$$\\begin{align*}kx-15&=5(2x-3)\\\\kx-15&=10x-15\\end{align*}$$\nComparing the coefficients of $x$ gives $k=10$.",
      "solutionDiagrams": []
    },
