  "content": {
    "id": "p17-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin^2\\theta\\operatorname{cosec}^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin^2\\theta\\operatorname{cosec}^2\\theta&=\\sin^2\\theta\\cdot\\frac{1}{\\sin^2\\theta}\\\\&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p17-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cot^2\\theta-\\operatorname{cosec}^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\cot^2\\theta-\\operatorname{cosec}^2\\theta&=\\cot^2\\theta-(1+\\cot^2\\theta)\\\\&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan^2\\theta-\\dfrac{1}{\\cos^2\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\tan^2\\theta-\\frac{1}{\\cos^2\\theta}&=\\tan^2\\theta-\\sec^2\\theta\\\\&=\\tan^2\\theta-(1+\\tan^2\\theta)\\\\&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p17-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin^2\\theta-\\sin^2\\theta\\cos^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^4\\theta$",
          "worked": "$$\\begin{align*}\\sin^2\\theta-\\sin^2\\theta\\cos^2\\theta&=\\sin^2\\theta(1-\\cos^2\\theta)\\\\&=\\sin^2\\theta\\sin^2\\theta\\\\&=\\sin^4\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p17-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin^4\\theta-\\cos^4\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2\\theta-\\cos^2\\theta$",
          "worked": "$$\\begin{align*}\\sin^4\\theta-\\cos^4\\theta&=(\\sin^2\\theta-\\cos^2\\theta)(\\sin^2\\theta+\\cos^2\\theta)\\\\&=(\\sin^2\\theta-\\cos^2\\theta)\\cdot1\\\\&=\\sin^2\\theta-\\cos^2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sin\\theta+\\cos\\theta)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+2\\sin\\theta\\cos\\theta$",
          "worked": "$$\\begin{align*}(\\sin\\theta+\\cos\\theta)^2&=\\sin^2\\theta+2\\sin\\theta\\cos\\theta+\\cos^2\\theta\\\\&=1+2\\sin\\theta\\cos\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p17-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$1-\\tan^2\\theta+\\sec^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}1-\\tan^2\\theta+\\sec^2\\theta&=1-\\tan^2\\theta+(1+\\tan^2\\theta)\\\\&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\tan^2\\theta\\cos^2\\theta+\\cot^2\\theta\\sin^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\tan^2\\theta\\cos^2\\theta+\\cot^2\\theta\\sin^2\\theta&=\\frac{\\sin^2\\theta}{\\cos^2\\theta}\\cos^2\\theta+\\frac{\\cos^2\\theta}{\\sin^2\\theta}\\sin^2\\theta\\\\&=\\sin^2\\theta+\\cos^2\\theta\\\\&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
