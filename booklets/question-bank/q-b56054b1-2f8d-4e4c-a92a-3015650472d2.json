  "content": {
    "id": "p32-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_5^{10}x^{-2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "$$\\begin{align*}\\int_5^{10}x^{-2}\\,dx&=\\left[-x^{-1}\\right]_5^{10}\\\\&=-\\frac{1}{10}-\\left(-\\frac{1}{5}\\right)\\\\&=\\frac{1}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p32-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_2^3 2x^{-3}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{36}$",
          "worked": "$$\\begin{align*}\\int_2^3 2x^{-3}\\,dx&=\\left[-x^{-2}\\right]_2^3\\\\&=-\\frac{1}{9}-\\left(-\\frac{1}{4}\\right)\\\\&=\\frac{5}{36}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p32-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{1/2}^1 4x^{-5}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}\\int_{1/2}^1 4x^{-5}\\,dx&=\\left[-x^{-4}\\right]_{1/2}^1\\\\&=-1-\\left(-\\left(\\frac12\\right)^{-4}\\right)\\\\&=-1+16\\\\&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p32-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_1^2\\frac{1}{x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\int_1^2\\frac{1}{x^2}\\,dx&=\\int_1^2x^{-2}\\,dx\\\\&=\\left[-x^{-1}\\right]_1^2\\\\&=-\\frac12-(-1)\\\\&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p32-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_1^4\\frac{1}{x^3}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15}{32}$",
          "worked": "$$\\begin{align*}\\int_1^4\\frac{1}{x^3}\\,dx&=\\int_1^4x^{-3}\\,dx\\\\&=\\left[-\\frac{x^{-2}}2\\right]_1^4\\\\&=-\\frac{1}{32}-\\left(-\\frac12\\right)\\\\&=\\frac{15}{32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p32-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_{1/2}^1\\frac{3}{x^4}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\int_{1/2}^1\\frac{3}{x^4}\\,dx&=\\int_{1/2}^1 3x^{-4}\\,dx\\\\&=\\left[-x^{-3}\\right]_{1/2}^1\\\\&=-1-\\left(-\\left(\\frac12\\right)^{-3}\\right)\\\\&=-1+8\\\\&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
