  "content": {
    "id": "p7-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Substitute $y = 0$ then use the null factor law to find the $x$-intercepts of these quadratics.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y = (x + 1)(x - 2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -1,\\ 2$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=(x+1)(x-2)\\\\x+1&=0\\quad\\text{or}\\quad x-2=0\\\\x&=-1\\quad\\text{or}\\quad x=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = (x - 3)(x - 4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 3,\\ 4$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=(x-3)(x-4)\\\\x-3&=0\\quad\\text{or}\\quad x-4=0\\\\x&=3\\quad\\text{or}\\quad x=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y = (x + 1)(x + 5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -1,\\ -5$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=(x+1)(x+5)\\\\x+1&=0\\quad\\text{or}\\quad x+5=0\\\\x&=-1\\quad\\text{or}\\quad x=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y = x(x - 3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 0,\\ 3$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=x(x-3)\\\\x&=0\\quad\\text{or}\\quad x-3=0\\\\x&=0\\quad\\text{or}\\quad x=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$y = 2x(x - 5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 0,\\ 5$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=2x(x-5)\\\\2x&=0\\quad\\text{or}\\quad x-5=0\\\\x&=0\\quad\\text{or}\\quad x=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$y = -3x(x + 2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 0,\\ -2$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=-3x(x+2)\\\\-3x&=0\\quad\\text{or}\\quad x+2=0\\\\x&=0\\quad\\text{or}\\quad x=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$y = (x + \\sqrt{5})(x - \\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -\\sqrt{5},\\ \\sqrt{5}$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=(x+\\sqrt{5})(x-\\sqrt{5})\\\\x+\\sqrt{5}&=0\\quad\\text{or}\\\\x-\\sqrt{5}&=0\\\\x&=-\\sqrt{5}\\quad\\text{or}\\quad x=\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
