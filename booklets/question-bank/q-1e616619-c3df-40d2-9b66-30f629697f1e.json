  "content": {
    "id": "p3-q4-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=2x+1$. Find the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}f(-3)&=2(-3)+1\\\\f(-3)&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(-a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2a+1$",
          "worked": "$$\\begin{align*}f(-a)&=2(-a)+1\\\\f(-a)&=-2a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(a^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a^2+1$",
          "worked": "$$\\begin{align*}f(a^2)&=2(a^2)+1\\\\f(a^2)&=2a^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(2a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a+1$",
          "worked": "$$\\begin{align*}f(2a)&=2(2a)+1\\\\f(2a)&=4a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(\\sqrt{a})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{a}+1$",
          "worked": "$$f(\\sqrt{a})=2\\sqrt{a}+1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(1+a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a+3$",
          "worked": "$$\\begin{align*}f(1+a)&=2(1+a)+1\\\\f(1+a)&=2+2a+1\\\\f(1+a)&=2a+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p3-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(3a-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6a-3$",
          "worked": "$$\\begin{align*}f(3a-2)&=2(3a-2)+1\\\\f(3a-2)&=6a-4+1\\\\f(3a-2)&=6a-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p3-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(a+b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a+2b+1$",
          "worked": "$$\\begin{align*}f(a+b)&=2(a+b)+1\\\\f(a+b)&=2a+2b+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$f(ab)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2ab+1$",
          "worked": "$$\\begin{align*}f(ab)&=2(ab)+1\\\\f(ab)&=2ab+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$f\\left(\\dfrac{1}{a}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a+2}{a}$",
          "worked": "$$\\begin{align*}f\\left(\\frac{1}{a}\\right)&=2\\left(\\frac{1}{a}\\right)+1\\\\f\\left(\\frac{1}{a}\\right)&=\\frac{2}{a}+\\frac{a}{a}\\\\f\\left(\\frac{1}{a}\\right)&=\\frac{a+2}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
