  "content": {
    "id": "v2-33836-p21-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the expression $(2x-3)(x+5)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-33836-p21-practice-slot-6-slot-6-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand and simplify.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2+7x-15$",
          "worked": "$$\\begin{align*}(2x-3)(x+5)&=2x^2+10x-3x-15\\\\&=2x^2+7x-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-33836-p21-practice-slot-6-slot-6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of the expression when $x=-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-21$",
          "worked": "$$\\begin{align*}2(-2)^2+7(-2)-15&=8-14-15\\\\&=-21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
