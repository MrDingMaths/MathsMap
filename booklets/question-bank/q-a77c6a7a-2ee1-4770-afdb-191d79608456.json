  "content": {
    "id": "p7-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Verify whether each given value is a solution of its equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x = 3$\n\n$$x + 1 = 4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= 3 + 1 \\\\ \\mathrm{LHS} &= 4 \\\\ \\mathrm{RHS} &= 4 \\\\ \\mathrm{LHS} &= \\mathrm{RHS}\\end{align*}$$\n$x = 3$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x = 4$\n\n$$12 - 3x = 4 - x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= 12 - 3(4) \\\\ \\mathrm{LHS} &= 0 \\\\ \\mathrm{RHS} &= 4 - 4 \\\\ \\mathrm{RHS} &= 0 \\\\ \\mathrm{LHS} &= \\mathrm{RHS}\\end{align*}$$\n$x = 4$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$b = 4$\n\n$$12 - 3b = 5 - b$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= 12 - 3(4) \\\\ \\mathrm{LHS} &= 0 \\\\ \\mathrm{RHS} &= 5 - 4 \\\\ \\mathrm{RHS} &= 1 \\\\ \\mathrm{LHS} &\\ne \\mathrm{RHS}\\end{align*}$$\n$b = 4$ is not a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$x = 0.5$\n\n$$\\frac{4x}{6} = \\frac{1}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= \\frac{4(0.5)}{6} \\\\ \\mathrm{LHS} &= \\frac{1}{3} \\\\ \\mathrm{RHS} &= \\frac{1}{3} \\\\ \\mathrm{LHS} &= \\mathrm{RHS}\\end{align*}$$\n$x = 0.5$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$x = 5$\n\n$$15 + 2x = x^{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= 15 + 2(5) \\\\ \\mathrm{LHS} &= 25 \\\\ \\mathrm{RHS} &= 5^{2} \\\\ \\mathrm{RHS} &= 25 \\\\ \\mathrm{LHS} &= \\mathrm{RHS}\\end{align*}$$\n$x = 5$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$x = 3$\n\n$$7x + 2 = 8x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= 7(3) + 2 \\\\ \\mathrm{LHS} &= 23 \\\\ \\mathrm{RHS} &= 8(3) \\\\ \\mathrm{RHS} &= 24 \\\\ \\mathrm{LHS} &\\ne \\mathrm{RHS}\\end{align*}$$\n$x = 3$ is not a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$x = -1$\n\n$$x(x + 1) = 0$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= (-1)(-1 + 1) \\\\ \\mathrm{LHS} &= 0 \\\\ \\mathrm{RHS} &= 0 \\\\ \\mathrm{LHS} &= \\mathrm{RHS}\\end{align*}$$\n$x = -1$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p7-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$x = -3$\n\n$$3x + 3 = 3(x + 1)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= 3(-3) + 3 \\\\ \\mathrm{LHS} &= -6 \\\\ \\mathrm{RHS} &= 3(-3 + 1) \\\\ \\mathrm{RHS} &= 3(-2) \\\\ \\mathrm{RHS} &= -6 \\\\ \\mathrm{LHS} &= \\mathrm{RHS}\\end{align*}$$\n$x = -3$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p7-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$x = 7.5$\n\n$$\\frac{2x}{5} + 5 = 10$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "baac20eb-ec19-48b1-93d9-d5d5e6cf7665-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\mathrm{LHS} &= \\frac{2(7.5)}{5} + 5 \\\\ \\mathrm{LHS} &= 3 + 5 \\\\ \\mathrm{LHS} &= 8 \\\\ \\mathrm{RHS} &= 10 \\\\ \\mathrm{LHS} &\\ne \\mathrm{RHS}\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "baac20eb-ec19-48b1-93d9-d5d5e6cf7665-compact-1",
