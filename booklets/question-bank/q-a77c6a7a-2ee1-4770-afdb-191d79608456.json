        },
        "answerSpaceMm": 42
      },
      {
        "id": "p7-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$x = -2$\n\n$$x^{2} + 4x + 4 = 0$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS} &= (-2)^{2} + 4(-2) + 4 \\\\ \\mathrm{LHS} &= 4 - 8 + 4 \\\\ \\mathrm{LHS} &= 0 \\\\ \\mathrm{RHS} &= 0 \\\\ \\mathrm{LHS} &= \\mathrm{RHS}\\end{align*}$$\n$x = -2$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
