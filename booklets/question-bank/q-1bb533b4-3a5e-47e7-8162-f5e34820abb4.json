  "content": {
    "id": "p29-q04-root",
    "type": "question",
    "label": "4",
    "prompt": "The product of two consecutive even numbers is 224. Find the numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$14$ and $16$, or $-16$ and $-14$.",
      "worked": "Let the smaller even number be $x$. The next even number is $x+2$.\n$$\\begin{align*}x(x+2)&=224\\\\x^2+2x-224&=0\\\\(x+16)(x-14)&=0\\end{align*}$$\nThus $x=-16$ or $x=14$. The numbers are $-16$ and $-14$, or $14$ and $16$. Both pairs consist of consecutive even numbers and have product $224$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
