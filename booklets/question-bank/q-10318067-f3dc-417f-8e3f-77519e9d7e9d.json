  "content": {
    "id": "p21-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The equations of two lines are $y=x-1$ and $mx-2y=4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "For what values of $m$ will the two lines not intersect?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2$.",
          "worked": "Rearranging the second equation gives\n$$\\begin{align*}2y&=mx-4\\\\y&=\\frac{m}{2}x-2.\\end{align*}$$\nThe lines have different $y$-intercepts, $-1$ and $-2$, so they do not intersect when their gradients are equal:\n$$\\begin{align*}\\frac{m}{2}&=1\\\\m&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "For what values of $m$ will the two lines intersect?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m\\ne2$.",
          "worked": "The gradients are $1$ and $\\frac{m}{2}$. The lines intersect when these are different:\n$$\\begin{align*}\\frac{m}{2}&\\ne1\\\\m&\\ne2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p21-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that the lines intersect at $(2,1)$, find $m$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=3$.",
          "worked": "Substitute $x=2$ and $y=1$ into $mx-2y=4$:\n$$\\begin{align*}2m-2(1)&=4\\\\2m-2&=4\\\\2m&=6\\\\m&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
