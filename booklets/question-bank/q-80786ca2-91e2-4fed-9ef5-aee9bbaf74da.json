  "content": {
    "id": "p4-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Evaluate each expression for $z=-3$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$-3z$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}-3z&=-3\\times(-3)\\\\-3z&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$z^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81$",
          "worked": "$$\\begin{align*}z^4&=(-3)^4\\\\z^4&=81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$5-2z$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$",
          "worked": "$$\\begin{align*}5-2z&=5-2\\times(-3)\\\\5-2z&=5+6\\\\5-2z&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2z)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-216$",
          "worked": "$$\\begin{align*}(2z)^3&=\\bigl(2\\times(-3)\\bigr)^3\\\\(2z)^3&=(-6)^3\\\\(2z)^3&=-216\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-z)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "$$\\begin{align*}(-z)^3&=\\bigl(-(-3)\\bigr)^3\\\\(-z)^3&=3^3\\\\(-z)^3&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q6-f",
        "type": "part",
        "label": "f",
