    "children": [
      {
        "id": "p14-g19-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^3+5x^2-x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+3)(x-1)(x+2)$",
          "worked": "Let $P(x)=2x^3+5x^2-x-6$.\n$$\\begin{align*}P(1)&=2+5-1-6\\\\P(1)&=0\\end{align*}$$\nHence $x-1$ is a factor. Long division gives\n$$x-1\\;\\big)\\;\\begin{array}{rrrr}2x^2&+7x&+6&\\\\\\hline 2x^3&+5x^2&-x&-6\\\\-(2x^3&-2x^2)&&\\\\\\hline &7x^2&-x&-6\\\\&-(7x^2&-7x)&\\\\\\hline &&6x&-6\\\\&&-(6x&-6)\\\\\\hline &&&0\\end{array}$$\n$$\\begin{align*}P(x)&=(x-1)(2x^2+7x+6)\\\\P(x)&=(x-1)(2x+3)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 116
      },
      {
        "id": "p14-g19-b",
        "type": "part",
        "label": "b",
        "prompt": "$6x^3-11x^2-24x+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-1)(2x+3)(x-3)$",
          "worked": "Let $P(x)=6x^3-11x^2-24x+9$.\n$$\\begin{align*}P(3)&=162-99-72+9\\\\P(3)&=0\\end{align*}$$\nHence $x-3$ is a factor. Long division gives\n$$x-3\\;\\big)\\;\\begin{array}{rrrr}6x^2&+7x&-3&\\\\\\hline 6x^3&-11x^2&-24x&+9\\\\-(6x^3&-18x^2)&&\\\\\\hline &7x^2&-24x&+9\\\\&-(7x^2&-21x)&\\\\\\hline &&-3x&+9\\\\&&-(-3x&+9)\\\\\\hline &&&0\\end{array}$$\n$$\\begin{align*}P(x)&=(x-3)(6x^2+7x-3)\\\\P(x)&=(x-3)(3x-1)(2x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 116
      },
      {
        "id": "p14-g19-c",
        "type": "part",
        "label": "c",
        "prompt": "$10x^3+7x^2-49x-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+5)(x-2)(5x+1)$",
          "worked": "Let $P(x)=10x^3+7x^2-49x-10$.\n$$\\begin{align*}P(2)&=80+28-98-10\\\\P(2)&=0\\end{align*}$$\nHence $x-2$ is a factor. Long division gives\n$$x-2\\;\\big)\\;\\begin{array}{rrrr}10x^2&+27x&+5&\\\\\\hline 10x^3&+7x^2&-49x&-10\\\\-(10x^3&-20x^2)&&\\\\\\hline &27x^2&-49x&-10\\\\&-(27x^2&-54x)&\\\\\\hline &&5x&-10\\\\&&-(5x&-10)\\\\\\hline &&&0\\end{array}$$\n$$\\begin{align*}P(x)&=(x-2)(10x^2+27x+5)\\\\P(x)&=(x-2)(2x+5)(5x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 116
      },
      {
        "id": "p14-g19-d",
        "type": "part",
        "label": "d",
        "prompt": "$12x^3+49x^2+3x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x-1)(3x+1)(x+4)$",
          "worked": "Let $P(x)=12x^3+49x^2+3x-4$.\n$$\\begin{align*}P(-4)&=-768+784-12-4\\\\P(-4)&=0\\end{align*}$$\nHence $x+4$ is a factor. Long division gives\n$$x+4\\;\\big)\\;\\begin{array}{rrrr}12x^2&+x&-1&\\\\\\hline 12x^3&+49x^2&+3x&-4\\\\-(12x^3&+48x^2)&&\\\\\\hline &x^2&+3x&-4\\\\&-(x^2&+4x)&\\\\\\hline &&-x&-4\\\\&&-(-x&-4)\\\\\\hline &&&0\\end{array}$$\n$$\\begin{align*}P(x)&=(x+4)(12x^2+x-1)\\\\P(x)&=(x+4)(4x-1)(3x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 116
