  "content": {
    "id": "p42-q2",
    "type": "question",
    "label": "2",
    "prompt": "Expand and simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{2}(3-\\sqrt{3})-\\sqrt{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}-\\sqrt{6}$",
          "worked": "$$\\begin{align*}\\sqrt{2}(3-\\sqrt{3})-\\sqrt{8}&=3\\sqrt{2}-\\sqrt{6}-\\sqrt{8}\\\\&=3\\sqrt{2}-\\sqrt{6}-2\\sqrt{2}\\\\&=\\sqrt{2}-\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p42-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{8}(\\sqrt{6}+\\sqrt{2})-\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{3}+4$",
          "worked": "$$\\begin{align*}\\sqrt{8}(\\sqrt{6}+\\sqrt{2})-\\sqrt{3}&=\\sqrt{48}+\\sqrt{16}-\\sqrt{3}\\\\&=4\\sqrt{3}+4-\\sqrt{3}\\\\&=3\\sqrt{3}+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p42-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{5}(\\sqrt{2}+1)-\\sqrt{40}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{5}-\\sqrt{10}$",
          "worked": "$$\\begin{align*}\\sqrt{5}(\\sqrt{2}+1)-\\sqrt{40}&=\\sqrt{10}+\\sqrt{5}-\\sqrt{40}\\\\&=\\sqrt{10}+\\sqrt{5}-2\\sqrt{10}\\\\&=\\sqrt{5}-\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p42-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{44}-2(\\sqrt{11}-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\sqrt{44}-2(\\sqrt{11}-1)&=\\sqrt{44}-2\\sqrt{11}+2\\\\&=2\\sqrt{11}-2\\sqrt{11}+2\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p42-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt{24}-2\\sqrt{2}(\\sqrt{3}-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sqrt{24}-2\\sqrt{2}(\\sqrt{3}-4)&=\\sqrt{24}-2\\sqrt{6}+8\\sqrt{2}\\\\&=2\\sqrt{6}-2\\sqrt{6}+8\\sqrt{2}\\\\&=8\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p42-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$2\\sqrt{3}(\\sqrt{6}-\\sqrt{3})-\\sqrt{50}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}-6$",
          "worked": "$$\\begin{align*}2\\sqrt{3}(\\sqrt{6}-\\sqrt{3})-\\sqrt{50}&=2\\sqrt{18}-2\\sqrt{9}-\\sqrt{50}\\\\&=6\\sqrt{2}-6-5\\sqrt{2}\\\\&=\\sqrt{2}-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
