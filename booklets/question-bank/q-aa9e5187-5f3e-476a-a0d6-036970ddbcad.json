  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Given $f'(x)=3x^2+4x-2$ and $f(-3)=4$, find the value of $f(1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(1)=8$",
      "worked": "$$\\begin{align*}f(x)&=x^3+2x^2-2x+C\\\\4&=(-3)^3+2(-3)^2-2(-3)+C\\\\4&=-3+C\\\\C&=7\\\\f(x)&=x^3+2x^2-2x+7\\\\f(1)&=1+2-2+7\\\\f(1)&=8\\end{align*}$$",
      "solutionDiagrams": []
    },
