  "content": {
    "id": "p55-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A satellite dish is in the shape of a parabola with equation $y=-3x^2+6$.\n\nAll dimensions are in metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p55-q2-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 55 p55-q2-diagram\"}\n\\begin{tikzpicture}[x=18mm,y=4mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,line width=0.5pt] (-1.75,0)--(1.9,0);\n\\draw[<->,line width=0.5pt] (0,-1.25)--(0,9.5);\n\\draw[line width=0.8pt,domain=-1.414213562:1.414213562,samples=81] plot (\\x,{-3*\\x*\\x+6});\n\\draw[<->,line width=0.4pt] (0.10,0)--(0.10,6) node[midway,right,fill=white,inner sep=1pt] {$d$};\n\\draw[<->,line width=0.4pt] (-1.414213562,-2)--(1.414213562,-2) node[midway,fill=white,inner sep=2pt] {$w$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 55,
          "sourceRegion": "Question 2, supplied dish diagram",
          "description": "Downward parabola with unlabelled double-ended axes, depth dimension d and width dimension w. No ticks or numerical annotations.",
          "mathematics": "Curve y=-3x^2+6, bounded by its baseline intersections x=±sqrt(2). Depth runs from y=0 to y=6; width spans both intersections.",
          "answerVisibility": "Permanent supplied reference figure; no numerical answers."
