    "children": [
      {
        "id": "p55-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the depth of the dish.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ m}$",
          "worked": "At $x=0$,\n$$\\begin{align*}y&=-3(0)^2+6\\\\y&=6.\\end{align*}$$\nThe vertex is $(0,6)$, so the dish is $6\\text{ m}$ deep.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p55-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the width of the dish. Answer to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.8\\text{ m}$",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-3x^2+6\\\\3x^2&=6\\\\x^2&=2\\\\x&=\\pm\\sqrt{2}.\\end{align*}$$\n$$\\begin{align*}w&=\\sqrt{2}-(-\\sqrt{2})\\\\w&=2\\sqrt{2}\\\\w&\\approx2.8\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ],
