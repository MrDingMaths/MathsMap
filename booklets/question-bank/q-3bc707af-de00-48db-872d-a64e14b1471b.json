  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the angle $\\theta$ between the vectors $\\underset{\\sim}{u}$ and $\\underset{\\sim}{v}$ (nearest degree if necessary) if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$|\\underset{\\sim}{u}|=4$, $|\\underset{\\sim}{v}|=5$ and $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120^\\circ$",
          "worked": "$$\\begin{aligned}\\cos\\theta&=\\frac{\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}}{|\\underset{\\sim}{u}||\\underset{\\sim}{v}|}\\\\&=\\frac{-10}{4\\times5}=-\\frac12\\\\\\theta&=120^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$|\\underset{\\sim}{u}|=3$, $|\\underset{\\sim}{v}|=5$ and $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$37^\\circ$",
          "worked": "$$\\begin{aligned}\\cos\\theta&=\\frac{\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}}{|\\underset{\\sim}{u}||\\underset{\\sim}{v}|}\\\\&=\\frac{12}{3\\times5}=\\frac45\\\\\\theta&=\\cos^{-1}\\!\\left(\\frac45\\right)\\\\&\\approx37^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
