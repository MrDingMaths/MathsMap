        "answer": {
          "short": "$x=-3\\pm\\sqrt5$",
          "worked": "$$\\begin{align*}x&=\\frac{-6\\pm\\sqrt{6^2-4(1)(4)}}{2(1)}\\\\x&=\\frac{-6\\pm\\sqrt{20}}{2}\\\\x&=\\frac{-6\\pm2\\sqrt5}{2}\\\\x&=-3\\pm\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
