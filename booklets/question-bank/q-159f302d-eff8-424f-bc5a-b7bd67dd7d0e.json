        "prompt": "$x^2-3x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{3\\pm\\sqrt{13}}{2}$",
          "worked": "$$\\begin{align*}x&=\\frac{-(-3)\\pm\\sqrt{(-3)^2-4(1)(-1)}}{2(1)}\\\\x&=\\frac{3\\pm\\sqrt{13}}{2}\\end{align*}$$",
