        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the smallest number that must be subtracted from 5762, so that the result is exactly divisible by 19?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5.",
          "worked": "$$5762=19\\times303+5$$\n\nSubtract the remainder, 5, to obtain $5757=19\\times303$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What number divided by 367 will give 59 as the quotient and 126 as the remainder?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "21 779.",
          "worked": "$$\\begin{align*}\\text{Number}&=367\\times59+126\\\\\\text{Number}&=21653+126\\\\\\text{Number}&=21779\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Divide 931 into two parts such that one part is greater than the other by 127.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "402 and 529.",
          "worked": "Remove the difference before sharing the rest equally.\n\n$$\\begin{align*}\\text{Smaller part}&=(931-127)\\div2\\\\\\text{Smaller part}&=804\\div2\\\\\\text{Smaller part}&=402\\\\\\text{Larger part}&=402+127\\\\\\text{Larger part}&=529\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
