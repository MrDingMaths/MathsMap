            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{6}$",
              "worked": "The favourable (spinner, die) outcomes are $(1,6),(2,5),(3,4)$.\n$$\\begin{align*}P(7)&=\\frac{3}{18}\\\\P(7)&=\\frac{1}{6}\\end{align*}$$",
              "solutionDiagrams": []
