    "type": "question",
    "label": "8",
    "prompt": "Show that the following equations have no real roots.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q8a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-3x+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=-11<0$, so there are no real roots.",
          "worked": "$$\\begin{align*}\\Delta&=(-3)^2-4(1)(5)\\\\\\Delta&=9-20\\\\\\Delta&=-11\\end{align*}$$\nThe negative discriminant gives no real roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q8b",
        "type": "part",
        "label": "b",
        "prompt": "$-5x^2+2x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=-76<0$, so there are no real roots.",
          "worked": "$$\\begin{align*}\\Delta&=2^2-4(-5)(-4)\\\\\\Delta&=4-80\\\\\\Delta&=-76\\end{align*}$$\nThe negative discriminant gives no real roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
