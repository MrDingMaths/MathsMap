    "type": "question",
    "label": "16",
    "prompt": "Simplify the following. $\\sqrt{27}+2\\sqrt{3}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5\\sqrt{3}$",
      "worked": "$$\\begin{align*}\\sqrt{27}+2\\sqrt{3}&=\\sqrt{9\\times3}+2\\sqrt{3}\\\\\\sqrt{27}+2\\sqrt{3}&=3\\sqrt{3}+2\\sqrt{3}\\\\\\sqrt{27}+2\\sqrt{3}&=5\\sqrt{3}\\end{align*}$$",
