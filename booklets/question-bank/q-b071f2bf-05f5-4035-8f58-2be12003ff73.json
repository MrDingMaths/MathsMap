  "content": {
    "id": "p124-practice-03-root",
    "type": "question",
    "label": "3",
    "prompt": "Give counter-examples to the following statements to demonstrate that they are not always true.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p124-practice-03-a",
        "type": "part",
        "label": "a",
        "prompt": "$|a+b|=|a|+|b|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$, $b=-1$: the left side is $0$ and the right side is $2$.",
          "worked": "Take $a=1$ and $b=-1$.\n\n$$\\begin{align*}|a+b|&=|1+(-1)|\\\\|a+b|&=0\\\\|a|+|b|&=|1|+|-1|\\\\|a|+|b|&=2\\end{align*}$$\n\nThe two sides are unequal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p124-practice-03-b",
        "type": "part",
        "label": "b",
        "prompt": "$|a-b|=|a|-|b|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$, $b=-1$: the left side is $2$ and the right side is $0$.",
          "worked": "Take $a=1$ and $b=-1$.\n\n$$\\begin{align*}|a-b|&=|1-(-1)|\\\\|a-b|&=2\\\\|a|-|b|&=|1|-|-1|\\\\|a|-|b|&=0\\end{align*}$$\n\nThe two sides are unequal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p124-practice-03-c",
        "type": "part",
        "label": "c",
        "prompt": "$|x|$ is the same as $\\pm x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$: $|x|=1$, whereas $\\pm x$ represents both $1$ and $-1$.",
          "worked": "Take $x=1$.\n\n$$\\begin{align*}|x|&=|1|\\\\|x|&=1\\end{align*}$$\n\nHere $\\pm x$ represents $1$ and $-1$. Absolute value gives the single value $1$, so the expressions are not the same.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p124-practice-03-d",
        "type": "part",
        "label": "d",
        "prompt": "$|ax|=a|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-1$, $x=2$: the left side is $2$ and the right side is $-2$.",
          "worked": "Take $a=-1$ and $x=2$.\n\n$$\\begin{align*}|ax|&=|(-1)\\times2|\\\\|ax|&=2\\\\a|x|&=(-1)|2|\\\\a|x|&=-2\\end{align*}$$\n\nThe two sides are unequal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p124-practice-03-e",
        "type": "part",
        "label": "e",
        "prompt": "$|x|=|y|$ means that $x=y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$, $y=-2$: $|x|=|y|=2$, but $x\\ne y$.",
          "worked": "Take $x=2$ and $y=-2$.\n\n$$\\begin{align*}|x|&=|2|\\\\|x|&=2\\\\|y|&=|-2|\\\\|y|&=2\\end{align*}$$\n\nThus $|x|=|y|$, but $x\\ne y$. Opposite numbers can have the same distance from zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p124-practice-03-f",
        "type": "part",
        "label": "f",
        "prompt": "If $|x+y|=|x|$, then $y=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$, $y=-2$: $|x+y|=|x|=1$, although $y\\ne0$.",
          "worked": "Take $x=1$ and $y=-2$.\n\n$$\\begin{align*}|x+y|&=|1+(-2)|\\\\|x+y|&=1\\\\|x|&=|1|\\\\|x|&=1\\end{align*}$$\n\nThe hypothesis $|x+y|=|x|$ holds, but $y=-2\\ne0$. This disproves the statement.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
