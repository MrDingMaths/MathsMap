  "content": {
    "id": "p4-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the straight line that passes through $(-2,4)$ and is parallel to the line $y=4x-7$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=4x+12$",
      "worked": "Parallel lines have equal gradients, so $m=4$.\n$$\\begin{align*}y-4&=4(x+2)\\\\y-4&=4x+8\\\\y&=4x+12\\end{align*}$$",
      "solutionDiagrams": []
    },
