  "content": {
    "id": "p41-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Jason has $4y + 2$ lollipops, where $y$ represents the number of lollipops in each bag.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "What does the 4 represent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The number of bags.",
          "worked": "Each bag contains $y$ lollipops, so $4y$ is the number of lollipops in four bags. The 4 is the number of bags.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p41-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "What does the 2 represent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The number of loose lollipops.",
          "worked": "The 2 adds two lollipops to those in the bags, so it represents the number of loose lollipops.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p41-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "What does $4y$ represent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The number of lollipops in all the bags.",
          "worked": "Four bags with $y$ lollipops in each contain $4y$ lollipops altogether.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
