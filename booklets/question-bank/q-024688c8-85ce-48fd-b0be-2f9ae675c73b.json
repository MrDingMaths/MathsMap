  "content": {
    "id": "p19-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "$60\\%$ of a group of students are boys, and $30\\%$ of the boys have blue eyes. What percentage of the class are boys with blue eyes?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$18\\%$",
      "worked": "The boys with blue eyes make up $30\\%$ of the $60\\%$ who are boys.\n\n$$\\begin{align*}30\\%\\text{ of }60\\% &= \\frac{30}{100}\\times\\frac{60}{100}\\\\30\\%\\text{ of }60\\% &= \\frac{3}{10}\\times\\frac{3}{5}\\\\30\\%\\text{ of }60\\% &= \\frac{9}{50}\\\\30\\%\\text{ of }60\\% &= 18\\%.\\end{align*}$$\n\nTherefore, $18\\%$ of the class are boys with blue eyes.",
      "solutionDiagrams": []
    },
