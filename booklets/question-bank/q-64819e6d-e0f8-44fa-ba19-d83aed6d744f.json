    "type": "question",
    "label": "1",
    "prompt": "Simplify $\\dfrac{\\log(8)}{\\log(16)}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac34$",
      "worked": "$$\\begin{align*}\\frac{\\log(8)}{\\log(16)}&=\\frac{\\log(2^3)}{\\log(2^4)}\\\\\\frac{\\log(8)}{\\log(16)}&=\\frac{3\\log(2)}{4\\log(2)}\\\\\\frac{\\log(8)}{\\log(16)}&=\\frac34\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
