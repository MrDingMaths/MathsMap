        "label": "a",
        "prompt": "$\\sec\\pi$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\sec\\pi&=\\frac{1}{\\cos\\pi}\\\\\\sec\\pi&=\\frac{1}{-1}\\\\\\sec\\pi&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q38",
        "type": "part",
        "label": "b",
