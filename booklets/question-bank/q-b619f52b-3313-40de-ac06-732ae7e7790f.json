        "answer": {
          "short": "Undefined.",
          "worked": "$\\sin\\pi=0$. Since $\\operatorname{cosec}\\pi=\\dfrac{1}{\\sin\\pi}$ has a zero denominator, it is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
