      {
        "id": "p54-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "By writing $\\sin^4 x$ as $(\\sin^2 x)^2$, show that $\\sin^4 x=\\frac38-\\frac12\\cos 2x+\\frac18\\cos 4x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^4 x=\\frac38-\\frac12\\cos 2x+\\frac18\\cos 4x$.",
          "worked": "$$\\begin{aligned}\\sin^4 x&=(\\sin^2 x)^2\\\\&=\\left(\\frac12-\\frac12\\cos 2x\\right)^2\\\\&=\\frac14-\\frac12\\cos 2x+\\frac14\\cos^2 2x\\\\&=\\frac14-\\frac12\\cos 2x+\\frac14\\left(\\frac12+\\frac12\\cos 4x\\right)\\\\&=\\frac38-\\frac12\\cos 2x+\\frac18\\cos 4x.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p54-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find a similar result for $\\cos^4 x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^4 x=\\frac38+\\frac12\\cos 2x+\\frac18\\cos 4x$.",
          "worked": "$$\\begin{aligned}\\cos^4 x&=(\\cos^2 x)^2\\\\&=\\left(\\frac12+\\frac12\\cos 2x\\right)^2\\\\&=\\frac14+\\frac12\\cos 2x+\\frac14\\cos^2 2x\\\\&=\\frac14+\\frac12\\cos 2x+\\frac14\\left(\\frac12+\\frac12\\cos 4x\\right)\\\\&=\\frac38+\\frac12\\cos 2x+\\frac18\\cos 4x.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
