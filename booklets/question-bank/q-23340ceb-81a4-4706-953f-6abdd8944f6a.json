  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": "2",
    "prompt": "Each of the equations below has been written in standard form. Rewrite each of them in gradient-intercept form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+y=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x+1$",
          "worked": "$$\\begin{align*}x+y&=1\\\\y&=-x+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x-y=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-3$",
          "worked": "$$\\begin{align*}2x-y&=3\\\\-y&=-2x+3\\\\y&=2x-3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$-2x+y=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-2$",
          "worked": "$$\\begin{align*}-2x+y&=-2\\\\y&=2x-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$-4x+2y=-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-\\frac32$",
          "worked": "$$\\begin{align*}-4x+2y&=-3\\\\2y&=4x-3\\\\y&=2x-\\frac32.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$6x-3y=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-\\frac23$",
          "worked": "$$\\begin{align*}6x-3y&=2\\\\-3y&=-6x+2\\\\y&=2x-\\frac23.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$2x-3y=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac23x-1$",
          "worked": "$$\\begin{align*}2x-3y&=3\\\\-3y&=-2x+3\\\\y&=\\frac23x-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$-3x-2y=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac32x+1$",
          "worked": "$$\\begin{align*}-3x-2y&=-2\\\\-2y&=3x-2\\\\y&=-\\frac32x+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$-4x-5y=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac45x-\\frac65$",
          "worked": "$$\\begin{align*}-4x-5y&=6\\\\-5y&=4x+6\\\\y&=-\\frac45x-\\frac65.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
