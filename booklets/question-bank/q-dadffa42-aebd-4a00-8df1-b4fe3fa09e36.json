    "children": [
      {
        "id": "p6-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{7x-1}{5}+\\frac{3x-4}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{64x-27}{35}$",
          "worked": "$$\\begin{aligned}\\frac{7x-1}{5}+\\frac{3x-4}{7}&=\\frac{7(7x-1)+5(3x-4)}{35}\\\\\\frac{7x-1}{5}+\\frac{3x-4}{7}&=\\frac{49x-7+15x-20}{35}\\\\\\frac{7x-1}{5}+\\frac{3x-4}{7}&=\\frac{64x-27}{35}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2}{x+1}+\\frac{3}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+7}{(x+1)(x+2)}$",
          "worked": "$$\\begin{aligned}\\frac{2}{x+1}+\\frac{3}{x+2}&=\\frac{2(x+2)+3(x+1)}{(x+1)(x+2)}\\\\\\frac{2}{x+1}+\\frac{3}{x+2}&=\\frac{2x+4+3x+3}{(x+1)(x+2)}\\\\\\frac{2}{x+1}+\\frac{3}{x+2}&=\\frac{5x+7}{(x+1)(x+2)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{x+2}-\\frac{4}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-3x-11}{(x+2)(x-3)}$",
          "worked": "$$\\begin{aligned}\\frac{1}{x+2}-\\frac{4}{x-3}&=\\frac{(x-3)-4(x+2)}{(x+2)(x-3)}\\\\\\frac{1}{x+2}-\\frac{4}{x-3}&=\\frac{x-3-4x-8}{(x+2)(x-3)}\\\\\\frac{1}{x+2}-\\frac{4}{x-3}&=\\frac{-3x-11}{(x+2)(x-3)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q21-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5}{2x^2+3x}-\\frac{1}{2x^2+5x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x+5}{x(x+1)(2x+3)}$",
          "worked": "$$\\begin{aligned}2x^2+3x&=x(2x+3)\\\\2x^2+5x+3&=2x^2+2x+3x+3\\\\2x^2+5x+3&=2x(x+1)+3(x+1)\\\\2x^2+5x+3&=(2x+3)(x+1)\\end{aligned}$$\n$$\\begin{aligned}\\frac{5}{2x^2+3x}-\\frac{1}{2x^2+5x+3}&=\\frac{5(x+1)-x}{x(x+1)(2x+3)}\\\\\\frac{5}{2x^2+3x}-\\frac{1}{2x^2+5x+3}&=\\frac{4x+5}{x(x+1)(2x+3)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p6-q21-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{4}{x^2+x}-\\frac{3}{x^2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-4}{x(x-1)(x+1)}$",
          "worked": "$$\\begin{aligned}x^2+x&=x(x+1)\\\\x^2-1&=(x-1)(x+1)\\end{aligned}$$\n$$\\begin{aligned}\\frac{4}{x^2+x}-\\frac{3}{x^2-1}&=\\frac{4(x-1)-3x}{x(x-1)(x+1)}\\\\\\frac{4}{x^2+x}-\\frac{3}{x^2-1}&=\\frac{4x-4-3x}{x(x-1)(x+1)}\\\\\\frac{4}{x^2+x}-\\frac{3}{x^2-1}&=\\frac{x-4}{x(x-1)(x+1)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p6-q21-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{3}{x^2-9}-\\frac{2}{3+2x-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+9}{(x-3)(x+3)(x+1)}$",
          "worked": "$$\\begin{aligned}x^2-9&=(x-3)(x+3)\\\\3+2x-x^2&=-(x^2-2x-3)\\\\3+2x-x^2&=-(x-3)(x+1)\\end{aligned}$$\n$$\\begin{aligned}\\frac{3}{x^2-9}-\\frac{2}{3+2x-x^2}&=\\frac{3}{(x-3)(x+3)}+\\frac{2}{(x-3)(x+1)}\\\\\\frac{3}{x^2-9}-\\frac{2}{3+2x-x^2}&=\\frac{3(x+1)+2(x+3)}{(x-3)(x+3)(x+1)}\\\\\\frac{3}{x^2-9}-\\frac{2}{3+2x-x^2}&=\\frac{5x+9}{(x-3)(x+3)(x+1)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
