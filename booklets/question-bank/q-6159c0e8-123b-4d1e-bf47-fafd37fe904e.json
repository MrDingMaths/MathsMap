        "label": "a",
        "prompt": "$\\log_2 x=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=16$",
          "worked": "$$\\begin{align*}x&=2^4\\\\x&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_3 x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=27$",
          "worked": "$$\\begin{align*}x&=3^3\\\\x&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\log_4 x=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=64$",
          "worked": "$$\\begin{align*}\\log_4 x&=3\\\\x&=4^3\\\\x&=64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$3+2\\log_5 x=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=25$",
          "worked": "$$\\begin{align*}2\\log_5 x&=4\\\\\\log_5 x&=2\\\\x&=5^2\\\\x&=25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_3\\frac{1}{x}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{27}$",
          "worked": "$$\\begin{align*}\\frac{1}{x}&=3^3\\\\\\frac{1}{x}&=27\\\\x&=\\frac{1}{27}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$2^x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_2 3$",
          "worked": "Using the definition of a logarithm,\n$$x=\\log_2 3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p3-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$3^x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_3 2$",
          "worked": "Using the definition of a logarithm,\n$$x=\\log_3 2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p3-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$5^{2x}=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{2}\\log_5 10$",
          "worked": "$$\\begin{align*}2x&=\\log_5 10\\\\x&=\\frac{1}{2}\\log_5 10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$3^{x/2}=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\log_3 4$",
          "worked": "$$\\begin{align*}\\frac{x}{2}&=\\log_3 4\\\\x&=2\\log_3 4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$3\\times2^x+1=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_2\\frac{4}{3}$",
          "worked": "$$\\begin{align*}3\\times2^x&=4\\\\2^x&=\\frac{4}{3}\\\\x&=\\log_2\\frac{4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
