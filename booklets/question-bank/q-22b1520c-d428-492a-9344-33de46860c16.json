  "content": {
    "id": "p14-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Calculate the values of $p$ if the distance between $(p,3)$ and $(1,p)$ is exactly 10 units.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=9$ or $-5$. Square the distance equation and factorise the resulting quadratic.",
      "worked": "$$\\begin{align*}\\sqrt{(1-p)^2+(p-3)^2}&=10\\\\(1-p)^2+(p-3)^2&=100\\\\1-2p+p^2+p^2-6p+9&=100\\\\2p^2-8p-90&=0\\\\p^2-4p-45&=0\\\\(p-9)(p+5)&=0\\\\p&=9\\text{ or }-5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
