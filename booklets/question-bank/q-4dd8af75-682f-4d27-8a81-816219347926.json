  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Two-thirds of the tiles on a veranda are brown and one-quarter of the tiles are black. What fraction of the tiles are either black or brown?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{11}{12}$",
      "worked": "$$\\begin{align*}\\frac23+\\frac14&=\\frac8{12}+\\frac3{12}\\\\\\frac23+\\frac14&=\\frac{11}{12}\\end{align*}$$\n$\\frac{11}{12}$ of the tiles are black or brown.",
