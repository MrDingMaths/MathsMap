  "content": {
    "id": "v2-009f08ff-p32-topic-j14-090234-root",
    "type": "question",
    "label": null,
    "prompt": "A phone costs $\\$500$. Its price is increased by $20\\%$. The new price is then decreased by $20\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-009f08ff-p32-topic-j14-090234-j14-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the final price.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$480$",
          "worked": "$$\\begin{align*}500\\times1.2&=600\\\\600\\times0.8&=480\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-009f08ff-p32-topic-j14-090234-j14-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the single decimal multiplier that gives the same result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.96$",
          "worked": "$$\\begin{align*}1.2\\times0.8&=0.96\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-009f08ff-p32-topic-j14-090234-j14-q-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the effect of this multiplier?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\%$ decrease",
          "worked": "$$\\begin{align*}0.96\\times100\\%&=96\\%\\\\100\\%-96\\%&=4\\%\\end{align*}$$The final price is $96\\%$ of the original: a $4\\%$ decrease.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
