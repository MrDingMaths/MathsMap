  "content": {
    "id": "p23-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Use similar substitutions to solve:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$25^x-26\\times5^x+25=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=0$.",
          "worked": "Let $u=5^x>0$.\n$$\\begin{align*}u^2-26u+25&=0\\\\(u-1)(u-25)&=0\\\\u&=1\\text{ or }25\\\\5^x&=1\\text{ or }25\\\\x&=0\\text{ or }2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p23-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$9^x-5\\times3^x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=\\log_3 4$.",
          "worked": "Let $u=3^x>0$.\n$$\\begin{align*}u^2-5u+4&=0\\\\(u-1)(u-4)&=0\\\\u&=1\\text{ or }4\\\\3^x&=1\\text{ or }4\\\\x&=0\\text{ or }\\log_3 4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p23-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^{2x}-3^x-20=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_3 5$.",
          "worked": "Let $u=3^x>0$.\n$$\\begin{align*}u^2-u-20&=0\\\\(u-5)(u+4)&=0\\\\u&=5\\text{ or }-4\\end{align*}$$\nReject $u=-4$ because $3^x>0$.\n$$\\begin{align*}3^x&=5\\\\x&=\\log_3 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p23-q4-p",
        "type": "part",
        "label": "d",
        "prompt": "$7^{2x}+7^x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solutions.",
          "worked": "Let $u=7^x>0$. The equation becomes $u^2+u+1=0$. Since $u^2+u+1>0$ for $u>0$, there are no real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p23-q4-q",
        "type": "part",
        "label": "e",
        "prompt": "$2^{2x}-64=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$.",
          "worked": "Let $u=2^x>0$.\n$$\\begin{align*}u^2-64&=0\\\\(u-8)(u+8)&=0\\\\u&=8\\text{ or }-8\\end{align*}$$\nReject $u=-8$ because $2^x>0$.\n$$\\begin{align*}2^x&=8\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p23-q4-r",
        "type": "part",
        "label": "f",
        "prompt": "$2^x-3\\times2^{\\frac{x}{2}}+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=0$.",
          "worked": "Let $u=2^{\\frac{x}{2}}>0$, so $2^x=u^2$.\n$$\\begin{align*}u^2-3u+2&=0\\\\(u-1)(u-2)&=0\\\\u&=1\\text{ or }2\\\\2^{\\frac{x}{2}}&=1\\text{ or }2\\\\\\frac{x}{2}&=0\\text{ or }1\\\\x&=0\\text{ or }2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
