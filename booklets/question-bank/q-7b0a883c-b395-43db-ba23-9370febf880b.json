  "content": {
    "id": "p39-q48-response",
    "type": "question",
    "label": "48",
    "prompt": "Solve the following equation.\n$$2^{2x+2}-9(2^x)+2=0.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=1$ or $x=-2$.\n\nUse $2^{2x+2}=4(2^x)^2$ and let $u=2^x$.",
      "worked": "Let $u=2^x>0$, so $2^{2x+2}=4u^2$.\n$$\\begin{align*}4u^2-9u+2&=0\\\\(4u-1)(u-2)&=0\\\\u&=\\frac14\\text{ or }u=2\\\\2^x&=2^{-2}\\text{ or }2^x=2^1\\\\x&=-2\\text{ or }x=1.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
