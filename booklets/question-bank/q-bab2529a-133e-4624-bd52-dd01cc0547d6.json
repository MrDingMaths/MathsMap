          "inlines": [
            {
              "type": "text",
              "text": "Sharon made 24 milkshakes at a party. The milkshakes were either vanilla or chocolate.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "All the milkshakes were served in an aluminium cup and looked the same.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Murray took one milkshake and had a 1 in 8 chance of taking a vanilla milkshake.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "How many chocolate milkshakes did Sharon make?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "21 chocolate milkshakes.",
      "worked": "$$\\begin{align*}\\text{Vanilla milkshakes}&=\\frac{1}{8}\\times24\\\\\\text{Vanilla milkshakes}&=3\\\\\\text{Chocolate milkshakes}&=24-3\\\\\\text{Chocolate milkshakes}&=21\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
