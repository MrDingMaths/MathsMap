        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2xe^{x^2+1}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=e^{x^2+1}(2x)\\\\&=2xe^{x^2+1}\\end{aligned}$$",
