        "answer": {
          "short": "$\\dfrac{dy}{dx}=ae^{ax+b}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=e^{ax+b}\\frac{d}{dx}(ax+b)\\\\&=ae^{ax+b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
