      },
      {
        "id": "p15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=e^{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2xe^{x^2}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=e^{x^2}(2x)\\\\&=2xe^{x^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
