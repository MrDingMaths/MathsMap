        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-xe^{-x^2/2}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=e^{-x^2/2}\\left(-\\frac12\\times2x\\right)\\\\&=-xe^{-x^2/2}\\end{aligned}$$",
          "solutionDiagrams": []
