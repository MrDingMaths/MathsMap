  "content": {
    "id": "p33-q9",
    "type": "question",
    "label": "9",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "9e4bce40-0745-42bf-bb5f-33a7c1eb5a04",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 0,
          "lineHeight": 1.3199970000068182,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Harry works full-time and earns a salary of $68 600 p.a. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "How much does he earn for each period below? Round your answers to the nearest cent.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1319.23 per week",
          "worked": "$$\\begin{align*}\\text{Weekly pay} &= \\frac{\\text{Annual salary}}{52}\\\\\\text{Weekly pay} &= \\frac{\\$68\\,600}{52}\\\\\\text{Weekly pay} &\\approx \\$1319.23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p33-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Fortnight",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$2638.46 per fortnight",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay} &= \\frac{\\text{Annual salary}}{26}\\\\\\text{Fortnightly pay} &= \\frac{\\$68\\,600}{26}\\\\\\text{Fortnightly pay} &\\approx \\$2638.46\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p33-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Month",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$5716.67 per month",
          "worked": "$$\\begin{align*}\\text{Monthly pay} &= \\frac{\\text{Annual salary}}{12}\\\\\\text{Monthly pay} &= \\frac{\\$68\\,600}{12}\\\\\\text{Monthly pay} &\\approx \\$5716.67\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
