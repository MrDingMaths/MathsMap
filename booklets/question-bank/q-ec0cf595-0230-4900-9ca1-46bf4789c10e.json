      "taskHash": "fc2f1cc11c5ccd42cb48f370401c161749d17d889189295d7bdd6cb9cf361506",
      "evidence": ".booklet-work/reasoning-ratings/calls/enrichment-maths-2-part8-20261009/644f6068ce449fea7839abe9ff2c17da072407bbd532921c0a5044a3af8a8f6a-1792558659635/last-message.txt"
    }
  },
  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve each of the following, writing $x$ as a single logarithm:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^{2x}=36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_2 6$",
          "worked": "$$\\begin{align*}2x&=\\log_2 36\\\\x&=\\frac12\\log_2 36\\\\x&=\\log_2\\sqrt{36}\\\\x&=\\log_2 6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^{3x}=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_5 2$",
          "worked": "$$\\begin{align*}3x&=\\log_5 8\\\\x&=\\frac13\\log_5 8\\\\x&=\\log_5\\sqrt[3]{8}\\\\x&=\\log_5 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^{4x}=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_3 2$",
          "worked": "$$\\begin{align*}4x&=\\log_3 16\\\\x&=\\frac14\\log_3 16\\\\x&=\\log_3\\sqrt[4]{16}\\\\x&=\\log_3 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$2^{x+1}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_2\\frac32$",
          "worked": "$$\\begin{align*}x+1&=\\log_2 3\\\\x&=\\log_2 3-1\\\\x&=\\log_2 3-\\log_2 2\\\\x&=\\log_2\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$5^{x+2}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_5\\frac{2}{25}$",
          "worked": "$$\\begin{align*}x+2&=\\log_5 2\\\\x&=\\log_5 2-2\\\\x&=\\log_5 2-\\log_5 25\\\\x&=\\log_5\\frac{2}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$5^{2x}=\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_5\\frac12$",
          "worked": "$$\\begin{align*}2x&=\\log_5\\frac14\\\\x&=\\frac12\\log_5\\frac14\\\\x&=\\log_5\\sqrt{\\frac14}\\\\x&=\\log_5\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$2^{x-1}=3^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_{\\frac23}2$\n\nDivide the exponential factors to obtain $(\\frac23)^x=2$.",
          "worked": "$$\\begin{align*}\\frac{2^x}{2}&=3^x\\\\\\left(\\frac23\\right)^x&=2\\\\x&=\\log_{\\frac23}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$2^{x+1}=3^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_{\\frac32}2$\n\nDivide the exponential factors to obtain $(\\frac32)^x=2$.",
          "worked": "$$\\begin{align*}2\\times2^x&=3^x\\\\\\left(\\frac32\\right)^x&=2\\\\x&=\\log_{\\frac32}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
