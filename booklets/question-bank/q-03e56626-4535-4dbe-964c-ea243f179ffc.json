    "label": "7",
    "prompt": "A rectangle has length $x$ cm and width $\\frac{x}{3}$ cm.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the area of the rectangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{3}\\text{ cm}^2$",
          "worked": "Area is length multiplied by width.\n\n$$\\begin{align*}A&=x\\times\\frac{x}{3}\\\\A&=\\frac{x^2}{3}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area if $x=9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{9^2}{3}\\\\A&=\\frac{81}{3}\\\\A&=27\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
