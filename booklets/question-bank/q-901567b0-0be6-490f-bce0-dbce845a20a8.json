    "id": "v2-95578-p20-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "A rectangular garden bed has an area of $30\\text{ m}^2$. Its length is $l$ metres and its width is $w$ metres.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-95578-p20-practice-slot-11-slot-11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation relating $l$ and $w$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$l=\\dfrac{30}{w}$",
          "worked": "$$\\begin{align*}\\text{Area}&=lw\\\\lw&=30\\\\l&=\\frac{30}{w}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-95578-p20-practice-slot-11-slot-11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the length when the width is 2.5 m.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "12 m",
          "worked": "$$\\begin{align*}l&=\\frac{30}{2.5}\\\\l&=12\\end{align*}$$\nThe length is 12 m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
