  "content": {
    "id": "p15-q2-root",
    "type": "question",
    "label": "4",
    "prompt": "Let $f(x)=\\sqrt{x}$ and $g(x)=x+4$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x+4}$",
          "worked": "$$\\begin{align*}f(g(x))&=f(x+4)\\\\f(g(x))&=\\sqrt{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $g(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x}+4$",
          "worked": "$$\\begin{align*}g(f(x))&=g(\\sqrt{x})\\\\g(f(x))&=\\sqrt{x}+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $g(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+8$",
          "worked": "$$\\begin{align*}g(g(x))&=g(x+4)\\\\g(g(x))&=(x+4)+4\\\\g(g(x))&=x+8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p15-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "What combination of compositions will produce $\\sqrt{x+8}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(g(x)))$",
          "worked": "Apply $g$ twice, then apply $f$.\n\n$$\\begin{align*}f(g(g(x)))&=f(g(x+4))\\\\f(g(g(x)))&=f(x+8)\\\\f(g(g(x)))&=\\sqrt{x+8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
