  "content": {
    "id": "v2-503cb8-p6-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the tangent to each curve at the given point in exact general form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-503cb8-p6-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2\\cos\\left(x-\\dfrac{\\pi}{3}\\right)$ at the point $\\left(\\dfrac{\\pi}{2},\\sqrt{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+2y-2\\sqrt{3}-\\pi=0$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=-2\\sin\\left(x-\\frac{\\pi}{3}\\right)\\end{align*}$$\nAt $x=\\frac{\\pi}{2}$:\n$$\\begin{align*}m&=-2\\sin\\left(\\frac{\\pi}{6}\\right)=-1\\end{align*}$$\nThe tangent is\n$$\\begin{align*}y-\\sqrt{3}&=-\\left(x-\\frac{\\pi}{2}\\right)\\\\2y-2\\sqrt{3}&=-2x+\\pi\\\\2x+2y-2\\sqrt{3}-\\pi&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-503cb8-p6-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sin\\left(\\dfrac{\\pi}{3}-2x\\right)$ at the point $\\left(\\dfrac{\\pi}{4},-\\dfrac{1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{3}x+4y+2-\\sqrt{3}\\pi=0$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=-2\\cos\\left(\\frac{\\pi}{3}-2x\\right)\\end{align*}$$\nAt $x=\\frac{\\pi}{4}$:\n$$\\begin{align*}m&=-2\\cos\\left(-\\frac{\\pi}{6}\\right)\\\\&=-2\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\&=-\\sqrt{3}\\end{align*}$$\nThe tangent is\n$$\\begin{align*}y+\\frac{1}{2}&=-\\sqrt{3}\\left(x-\\frac{\\pi}{4}\\right)\\\\4y+2&=-4\\sqrt{3}x+\\sqrt{3}\\pi\\\\4\\sqrt{3}x+4y+2-\\sqrt{3}\\pi&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
