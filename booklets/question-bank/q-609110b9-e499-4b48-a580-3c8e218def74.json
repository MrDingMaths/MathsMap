  "content": {
    "id": "p4-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The value of a car, in dollars, is modelled by the equation $V(t)=50000(1.15)^{-t}$, where $t$ is in years.\nWhat is the average rate of change in the value of the car over the first five years? Give your answer to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\$5028.23\\text{/year}$.",
      "worked": "$$\\begin{aligned}V(0)&=50000(1.15)^0=50000\\\\V(5)&=50000(1.15)^{-5}\\\\\\text{Average rate of change}&=\\frac{V(5)-V(0)}{5-0}\\\\&=\\frac{50000(1.15)^{-5}-50000}{5}\\\\&\\approx-\\$5028.23\\text{/year}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
