  "content": {
    "id": "v2-6b115e019-practice-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "Use the product rule to find $f'(x)$ and $f''(x)$ in fully factored form for each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-6b115e019-practice-slot-13-slot-13-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x(x-2)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2(x-2)^2(2x-1)$\n\n$f''(x)=12(x-1)(x-2)$",
          "worked": "$$\\begin{align*}f'(x)&=(x-2)^3+3x(x-2)^2\\\\f'(x)&=(x-2)^2[(x-2)+3x]\\\\f'(x)&=(x-2)^2(4x-2)\\\\f'(x)&=2(x-2)^2(2x-1)\\\\f''(x)&=2[2(x-2)(2x-1)+2(x-2)^2]\\\\f''(x)&=4(x-2)[(2x-1)+(x-2)]\\\\f''(x)&=4(x-2)(3x-3)\\\\f''(x)&=12(x-1)(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-6b115e019-practice-slot-13-slot-13-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=(2x+1)(x-1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=(x-1)^2(8x+1)$\n\n$f''(x)=6(x-1)(4x-1)$",
          "worked": "$$\\begin{align*}f'(x)&=2(x-1)^3+3(2x+1)(x-1)^2\\\\f'(x)&=(x-1)^2[2(x-1)+3(2x+1)]\\\\f'(x)&=(x-1)^2(8x+1)\\\\f''(x)&=2(x-1)(8x+1)+8(x-1)^2\\\\f''(x)&=(x-1)[2(8x+1)+8(x-1)]\\\\f''(x)&=(x-1)(24x-6)\\\\f''(x)&=6(x-1)(4x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
