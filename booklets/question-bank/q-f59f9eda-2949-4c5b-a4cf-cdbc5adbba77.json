  "content": {
    "id": "p33-q11-content",
    "type": "question",
    "label": "11",
    "prompt": "Find the missing algebraic terms to make these equations true.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$3x\\times{\\color{#24282d}\\boxed{\\rule{0pt}{6mm}\\hspace{12mm}}}\\times z=6xyz$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2y$",
          "worked": "$$\\begin{align*}\\square&=\\frac{6xyz}{3x\\times z}\\\\\\square&=\\frac{6xyz}{3xz}\\\\\\square&=2y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p33-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$4a\\times{\\color{#24282d}\\boxed{\\rule{0pt}{6mm}\\hspace{13mm}}}=12ab^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3b^2$",
          "worked": "$$\\begin{align*}\\square&=\\frac{12ab^2}{4a}\\\\\\square&=3b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p33-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$-2q\\times{\\color{#24282d}\\boxed{\\rule{0pt}{6mm}\\hspace{11mm}}}\\times4s=16qs$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\square&=\\frac{16qs}{-2q\\times4s}\\\\\\square&=\\frac{16qs}{-8qs}\\\\\\square&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p33-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{{\\color{#24282d}\\boxed{\\rule{0pt}{6mm}\\hspace{15mm}}}}{4r}=7s$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28rs$",
          "worked": "$$\\begin{align*}\\square&=7s\\times4r\\\\\\square&=28rs\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p33-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{{\\color{#24282d}\\boxed{\\rule{0pt}{6mm}\\hspace{15mm}}}}{2ab}=4b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8ab^2$",
          "worked": "$$\\begin{align*}\\square&=4b\\times2ab\\\\\\square&=8ab^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p33-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{14xy}{{\\color{#24282d}\\boxed{\\rule{0pt}{6mm}\\hspace{13mm}}}}=-2y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7x$",
          "worked": "$$\\begin{align*}\\square&=\\frac{14xy}{-2y}\\\\\\square&=-7x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
  },
