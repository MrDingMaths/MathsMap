      {
        "id": "p10-q46",
        "type": "part",
        "label": "a",
        "prompt": "$x^3-3x^2+3x-y-3=0$ is the result after translating right by 1 unit, and down by 2 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3-y=0$.",
          "worked": "Reverse the translation: replace $x$ by $x+1$ and $y$ by $y-2$ in the given relation.\n$$\\begin{align*}(x+1)^3-3(x+1)^2+3(x+1)-(y-2)-3&=0\\\\x^3+3x^2+3x+1-3x^2-6x-3+3x+3-y+2-3&=0\\\\x^3-y&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q47",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+y^2+6x-4y+12=0$ is the result after translating left by 2 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2x+y^2-4y+4=0$.",
          "worked": "Reverse the left translation: replace $x$ by $x-2$ in the given relation.\n$$\\begin{align*}(x-2)^2+y^2+6(x-2)-4y+12&=0\\\\x^2-4x+4+y^2+6x-12-4y+12&=0\\\\x^2+2x+y^2-4y+4&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
