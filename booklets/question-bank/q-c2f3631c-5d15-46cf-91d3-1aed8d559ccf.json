  "content": {
    "id": "p48-q8",
    "type": "question",
    "label": "8",
    "prompt": "Find the values of $p$ if $px^2+4x+2=0$ has no real solutions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p>2$; no real solutions require $\\Delta<0$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "a29c77c0-67fc-4d08-8ac8-80089cb0840b-compact-0",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "For ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "p\\ne0",
                "display": false
              },
              {
                "type": "text",
                "text": ", no real solutions require ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\Delta<0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "a29c77c0-67fc-4d08-8ac8-80089cb0840b-compact-1",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\Delta&=4^2-4(p)(2)\\\\\\Delta&=16-8p\\\\16-8p&<0\\\\-8p&<-16\\\\p&>2\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "a29c77c0-67fc-4d08-8ac8-80089cb0840b-compact-2",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "When ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "p=0",
                "display": false
              },
              {
                "type": "text",
                "text": ", the equation is linear: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "4x+2=0",
                "display": false
              },
              {
                "type": "text",
                "text": ", with the real solution ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=-\\frac12",
                "display": false
              },
              {
                "type": "text",
                "text": ". Thus the required values are ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "p>2",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
