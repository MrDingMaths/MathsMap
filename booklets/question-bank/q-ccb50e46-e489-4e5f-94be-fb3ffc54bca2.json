    "label": "9",
    "prompt": "Express each quantity as a percentage of the total.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "30 cents out of a dollar",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\%$",
          "worked": "One dollar is 100 cents.\n\n$$\\begin{align*}\\text{Percentage}&=\\frac{30}{100}\\times100\\%\\\\\\text{Percentage}&=30\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "250 m out of 1 km",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$",
          "worked": "$1\\text{ km}=1000\\text{ m}$.\n\n$$\\begin{align*}\\text{Percentage}&=\\frac{250}{1000}\\times100\\%\\\\\\text{Percentage}&=25\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "160 women in a train carrying 200 people",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage of women}&=\\frac{160}{200}\\times100\\%\\\\\\text{Percentage of women}&=80\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
