          "short": "$66\\frac{2}{3}\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage filled}&=\\frac{16}{24}\\times100\\%\\\\\\text{Percentage filled}&=\\frac{2}{3}\\times100\\%\\\\\\text{Percentage filled}&=66\\frac{2}{3}\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
