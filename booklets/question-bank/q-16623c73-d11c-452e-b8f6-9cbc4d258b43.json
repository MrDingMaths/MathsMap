    "children": [
      {
        "id": "p36-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the area of $ABCD$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21.0\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac12(a+b)h\\\\A&=\\frac12(4+10)\\times3\\\\A&=21.0\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p36-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the perimeter of the trapezium.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23.7\\text{ cm}$",
          "worked": "The horizontal distance from $C$ to $D$ is $10-4=6\\text{ cm}$.\n$$\\begin{align*}CD^2&=6^2+3^2\\\\CD&=\\sqrt{45}\\\\P&=3+4+10+\\sqrt{45}\\\\P&\\approx23.7\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p36-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the size of $\\angle CDB$ to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26.6^\\circ$",
          "worked": "Relative to $\\angle CDB$, the opposite side is $3\\text{ cm}$ and the adjacent side is $10-4=6\\text{ cm}$.\n$$\\begin{align*}\\tan\\angle CDB&=\\frac{O}{A}\\\\\\tan\\angle CDB&=\\frac36\\\\\\angle CDB&=\\tan^{-1}\\left(\\frac36\\right)\\\\\\angle CDB&\\approx26.6^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p36-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the size of $\\angle ACD$ to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$153.4^\\circ$",
          "worked": "Since $AC\\parallel BD$, the interior angles on the same side of transversal $CD$ sum to $180^\\circ$.\n$$\\begin{align*}\\tan\\angle CDB&=\\frac36\\\\\\angle CDB&=\\tan^{-1}\\left(\\frac36\\right)\\\\\\angle ACD&=180^\\circ-\\angle CDB\\\\\\angle ACD&=180^\\circ-\\tan^{-1}\\left(\\frac36\\right)\\\\\\angle ACD&\\approx153.4^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
