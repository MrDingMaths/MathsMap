    "type": "question",
    "label": "7",
    "prompt": "Solve $5x + 2 = 17$ by:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Subtracting 2 from both sides first.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x = 15$; $x = 3$.",
          "worked": "Subtract 2 from both sides, then divide both sides by 5.\n$$\\begin{align*}5x &= 15 \\\\ x &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Dividing both sides by 5 first. (Distributive law says to divide every term).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x + \\frac{2}{5} = \\frac{17}{5}$; $x = \\frac{15}{5} = 3$.",
          "worked": "Divide every term on both sides by 5, then subtract $\\frac{2}{5}$ from both sides.\n$$\\begin{align*}x + \\frac{2}{5} &= \\frac{17}{5} \\\\ x &= \\frac{17}{5} - \\frac{2}{5} \\\\ x &= \\frac{15}{5} \\\\ x &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
