  "content": {
    "id": "p24-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "My two dogs were running on the beach when I called them back. The faster dog was $100\\text{ m}$ away and the slower dog was $70\\text{ m}$ away. The faster dog runs twice as fast as the slower dog. How far away was the second dog when the first dog reached me?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20\\text{ m}$",
      "worked": "In the same time, the slower dog runs half the distance of the faster dog.\n$$\\begin{align*}\\text{Slower dog's distance travelled}&=\\frac{100}{2}=50\\text{ m}\\\\\\text{Slower dog's remaining distance}&=70-50=20\\text{ m}\\end{align*}$$\nThe second dog is $20\\text{ m}$ away.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
