  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify\n$$\\frac{x^2-3x+2}{x^2-5x+6}\\times\\frac{x^2-7x+12}{x^2-9x+20}\\times\\frac{x^2-11x+30}{x^2-13x+42}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{x-1}{x-7}$\n\nFactorise all six quadratics, then cancel the common factors across the product.",
      "worked": "Let $P$ denote the given product.\n$$\\begin{align*}P&=\\frac{(x-1)(x-2)}{(x-2)(x-3)}\\times\\frac{(x-3)(x-4)}{(x-4)(x-5)}\\times\\frac{(x-5)(x-6)}{(x-6)(x-7)}\\\\P&=\\frac{x-1}{x-7}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
