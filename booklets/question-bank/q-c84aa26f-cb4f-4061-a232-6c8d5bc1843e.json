  "content": {
    "id": "p31-q31-root",
    "type": "question",
    "label": "31",
    "prompt": "Simplify the following.\n$$\\frac{3x^2-5x-2}{x-2}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3x+1$, $x\\ne2$.",
      "worked": "$$\\begin{align*}\\frac{3x^2-5x-2}{x-2}&=\\frac{(3x+1)(x-2)}{x-2}\\\\\\frac{3x^2-5x-2}{x-2}&=3x+1.\\end{align*}$$\nThe original denominator requires $x\\ne2$.",
      "solutionDiagrams": []
    },
