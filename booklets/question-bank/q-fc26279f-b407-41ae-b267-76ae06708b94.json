    "children": [
      {
        "id": "p17-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $A\\cap B$ does not contain any elements.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The sets are disjoint: they have no elements in common.",
          "worked": "The circles do not overlap, so no element belongs to both $A$ and $B$. Therefore $A\\cap B=\\varnothing$; the sets are disjoint (mutually exclusive).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Give an example of two possible sets $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $A$ is the set of even integers and $B$ is the set of odd integers.",
          "worked": "Let $A$ be the even integers and $B$ be the odd integers. No integer is both even and odd, so these sets have no common elements and fit the diagram.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ],
