  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A car can travel 100 km on 11 litres of petrol when its speed is 50 km/h, but when its speed is 90 km/h it consumes 15 litres per 100 km.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "If the car travels 28 km at 50 km/h and an additional 130 km at 90 km/h, how many litres of petrol will it consume?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "22.58 litres",
          "worked": "$$\\begin{align*}\\text{Petrol consumed}&=\\frac{11}{100}\\times28+\\frac{15}{100}\\times130\\\\&=3.08+19.50\\\\&=22.58\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "The car travels $x$ km at 50 km/h and $5x$ km at 90 km/h. Find a formula for $y$, the number of litres of petrol it consumes on the journey.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=0.86x$",
          "worked": "$$\\begin{align*}y&=\\frac{11}{100}x+\\frac{15}{100}(5x)\\\\y&=0.11x+0.75x\\\\y&=0.86x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
