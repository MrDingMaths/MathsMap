  "content": {
    "id": "p72-q5-node",
    "type": "question",
    "label": "5",
    "prompt": "Suppose $\\angle ABC$ is obtuse. What type of angle is $\\angle DEF$, given that $\\angle ABC=2\\angle DEF$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Acute.",
      "worked": "Since $\\angle ABC$ is obtuse, $90^\\circ<\\angle ABC<180^\\circ$.\n$$\\begin{align*}\\angle ABC&=2\\angle DEF\\\\\\angle DEF&=\\frac{\\angle ABC}{2}\\end{align*}$$\nDividing the bounds by $2$ gives $45^\\circ<\\angle DEF<90^\\circ$.\nTherefore $\\angle DEF$ is acute.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
