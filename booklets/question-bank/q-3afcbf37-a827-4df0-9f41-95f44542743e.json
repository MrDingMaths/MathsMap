  "content": {
    "id": "p54-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The general solution of $y'y=2$ can be expressed as a relation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^2=4x+C$.",
          "worked": "$$\\begin{align*}y\\,dy&=2\\,dx\\\\\\int y\\,dy&=\\int 2\\,dx\\\\\\frac{y^2}{2}&=2x+C_1\\\\y^2&=4x+C\\end{align*}$$\nHere $C=2C_1$ is an arbitrary constant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p54-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Describe the family of curves.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parabolas opening to the right, with vertices on the $x$-axis.",
          "worked": "$$y^2=4\\left(x+\\frac{C}{4}\\right)$$\nThese are parabolas opening to the right, with vertices $\\left(-\\frac{C}{4},0\\right)$ on the $x$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p54-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Evaluate the arbitrary constant given the curve passes through $(0,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=1$, giving $y^2=4x+1$.",
          "worked": "Substitute $(0,1)$ into $y^2=4x+C$:\n$$\\begin{align*}1&=4(0)+C\\\\C&=1\\end{align*}$$\nHence $y^2=4x+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
