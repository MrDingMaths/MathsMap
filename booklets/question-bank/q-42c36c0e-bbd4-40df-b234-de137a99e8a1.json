  "content": {
    "id": "p11-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The length of a large rectangular room is to be 3 m more than twice its width. If the perimeter is to be 36 m, find the length and width of the room.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Length $13\\text{ m}$; width $5\\text{ m}$.",
      "worked": "Let $x$ metres be the width. Then the length is $(2x+3)$ metres.\n\n$$\\begin{align*}x+x+(2x+3)+(2x+3)&=36\\\\6x+6&=36\\\\6x&=30\\\\x&=5\\end{align*}$$\n\nThe length is\n$$\\begin{align*}2x+3&=2(5)+3\\\\2x+3&=13.\\end{align*}$$\n\nTherefore, the length is $13\\text{ m}$ and the width is $5\\text{ m}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 65
  },
