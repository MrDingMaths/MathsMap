  "content": {
    "id": "p10-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Jim earns \\$38.15/h for a 38-hour week. Find his fortnightly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2899.40$",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay} &= \\text{Hourly rate}\\times\\text{Fortnightly hours}\\\\\\text{Fortnightly pay} &= \\$38.15\\times(38\\times2)\\\\\\text{Fortnightly pay} &= \\$2899.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Tim earns \\$1061.34 for a 38-hour week. Find his hourly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$27.93}{\\text{h}}$",
          "worked": "$$\\begin{align*}\\text{Hourly pay} &= \\frac{\\text{Total pay}}{\\text{Hours worked}}\\\\\\text{Hourly pay} &= \\frac{\\$1061.34}{38\\text{ h}}\\\\\\text{Hourly pay} &= \\$27.93/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p10-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Lim earns \\$1408 in a fortnight. He works 25 hours per week. Find his hourly rate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$28.16}{\\text{h}}$",
          "worked": "$$\\begin{align*}\\text{Hourly rate} &= \\frac{\\text{Fortnightly pay}}{\\text{Fortnightly hours}}\\\\\\text{Hourly rate} &= \\frac{\\$1408}{25\\times2\\text{ h}}\\\\\\text{Hourly rate} &= \\$28.16/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p10-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "Tom earns \\$21.96/h and earns \\$746.64 in a week. Find his hours worked.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34\\text{ h}$",
          "worked": "$$\\begin{align*}\\text{Hours worked} &= \\frac{\\text{Total pay}}{\\text{Hourly rate}}\\\\\\text{Hours worked} &= \\frac{\\$746.64}{\\$21.96/\\text{h}}\\\\\\text{Hours worked} &= 34\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p10-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "Dom earns \\$25.65/h for a 15-hour week. Find his fortnightly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$769.50$",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay} &= \\text{Hourly rate}\\times\\text{Fortnightly hours}\\\\\\text{Fortnightly pay} &= \\$25.65\\times(15\\times2)\\\\\\text{Fortnightly pay} &= \\$769.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "Jess earns \\$1634.36 in a fortnight. She is paid \\$31.43/hr. Find how many hours she works in a week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26\\text{ h per week}$",
          "worked": "$$\\begin{align*}\\text{Fortnightly hours} &= \\frac{\\text{Fortnightly pay}}{\\text{Hourly rate}}\\\\\\text{Fortnightly hours} &= \\frac{\\$1634.36}{\\$31.43/\\text{h}}\\\\\\text{Fortnightly hours} &= 52\\text{ h}\\\\\\text{Weekly hours} &= 52\\div2\\\\\\text{Weekly hours} &= 26\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p10-q14-g",
        "type": "part",
        "label": "g",
        "prompt": "Faith earns \\$38.80 per hour. If she earned \\$2754.80 for the fortnight, calculate the number of hours she works in a week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35.5\\text{ h per week}$",
          "worked": "$$\\begin{align*}\\text{Fortnightly hours} &= \\frac{\\text{Fortnightly pay}}{\\text{Hourly rate}}\\\\\\text{Fortnightly hours} &= \\frac{\\$2754.80}{\\$38.80/\\text{h}}\\\\\\text{Fortnightly hours} &= 71\\text{ h}\\\\\\text{Weekly hours} &= 71\\div2\\\\\\text{Weekly hours} &= 35.5\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p10-q14-h",
        "type": "part",
        "label": "h",
        "prompt": "Georgia earns \\$84.15 for 5.5 hours of work. How much would she earn for a 38 hour week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$581.40$",
          "worked": "$$\\begin{align*}\\text{Hourly rate} &= \\frac{\\text{Total pay}}{\\text{Hours worked}}\\\\\\text{Hourly rate} &= \\frac{\\$84.15}{5.5\\text{ h}}\\\\\\text{Hourly rate} &= \\$15.30/\\text{h}\\\\\\text{Weekly pay} &= \\$15.30\\times38\\\\\\text{Weekly pay} &= \\$581.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
