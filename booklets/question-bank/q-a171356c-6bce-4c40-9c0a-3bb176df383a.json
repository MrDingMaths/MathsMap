  "content": {
    "id": "p12-q26-31-root",
    "type": "question",
    "label": "26",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p12-q26-31-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Find the coefficient of the term indicated in the following expansions.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q26-31-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(2x-\\frac{1}{x^2}\\right)^7\\qquad[x^4]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-448$",
          "worked": "$$\\begin{align*}T_k&=\\binom{7}{k}(2x)^{7-k}(-x^{-2})^k\\\\T_k&=\\binom{7}{k}2^{7-k}(-1)^kx^{7-3k}\\end{align*}$$\nFor the $x^4$ term:\n$$\\begin{align*}7-3k&=4\\\\k&=1\\end{align*}$$\nThe coefficient is $\\binom{7}{1}2^6(-1)=-448$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q26-31-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(x^2+\\frac{1}{x}\\right)^9\\qquad[x^6]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$126$",
          "worked": "$$\\begin{align*}T_k&=\\binom{9}{k}(x^2)^{9-k}(x^{-1})^k\\\\T_k&=\\binom{9}{k}x^{18-3k}\\end{align*}$$\nFor the $x^6$ term:\n$$\\begin{align*}18-3k&=6\\\\k&=4\\end{align*}$$\nThe coefficient is $\\binom{9}{4}=126$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q26-31-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(x^2+\\frac{1}{x^2}\\right)^{10}\\qquad[x^{12}]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45$",
          "worked": "$$\\begin{align*}T_k&=\\binom{10}{k}(x^2)^{10-k}(x^{-2})^k\\\\T_k&=\\binom{10}{k}x^{20-4k}\\end{align*}$$\nFor the $x^{12}$ term:\n$$\\begin{align*}20-4k&=12\\\\k&=2\\end{align*}$$\nThe coefficient is $\\binom{10}{2}=45$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q26-31-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3a+\\sqrt{b})^5\\qquad[a^3b]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$270$",
          "worked": "$$\\begin{align*}T_k&=\\binom{5}{k}(3a)^{5-k}(\\sqrt{b})^k\\\\T_k&=\\binom{5}{k}3^{5-k}a^{5-k}b^{k/2}\\end{align*}$$\nFor $a^3b$:\n$$\\begin{align*}5-k&=3\\\\k&=2\\end{align*}$$\nThen $b^{k/2}=b$. The coefficient is $\\binom{5}{2}3^3=270$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p12-q26-31-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(2x-\\frac{1}{x}\\right)^6\\qquad[x^0]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-160$",
          "worked": "$$\\begin{align*}T_k&=\\binom{6}{k}(2x)^{6-k}(-x^{-1})^k\\\\T_k&=\\binom{6}{k}2^{6-k}(-1)^kx^{6-2k}\\end{align*}$$\nFor the constant term:\n$$\\begin{align*}6-2k&=0\\\\k&=3\\end{align*}$$\nThe coefficient is $\\binom{6}{3}2^3(-1)^3=-160$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q26-31-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(x^2+\\frac{1}{x^3}\\right)^7\\qquad[x^{-1}]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$",
          "worked": "$$\\begin{align*}T_k&=\\binom{7}{k}(x^2)^{7-k}(x^{-3})^k\\\\T_k&=\\binom{7}{k}x^{14-5k}\\end{align*}$$\nFor the $x^{-1}$ term:\n$$\\begin{align*}14-5k&=-1\\\\k&=3\\end{align*}$$\nThe coefficient is $\\binom{7}{3}=35$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
