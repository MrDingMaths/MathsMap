  "content": {
    "id": "p7-q6",
    "type": "question",
    "label": "6",
    "prompt": "The length, $x$, of a field is given as 90 m.\nWrite the error interval for $x$ if this measurement is correct to",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "the nearest metre",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$89.5\\le x<90.5$ m",
          "worked": "Precision: 1 m.\n$$\\begin{aligned}\\text{Absolute error}&=\\tfrac12\\times1=0.5\\text{ m}\\\\\\text{Upper bound}&=90+0.5=90.5\\text{ m}\\\\\\text{Lower bound}&=90-0.5=89.5\\text{ m}\\end{aligned}$$\nHence $89.5\\le x<90.5$ m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "the nearest 10 metres",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$85\\le x<95$ m",
          "worked": "Precision: 10 m.\n$$\\begin{aligned}\\text{Absolute error}&=\\tfrac12\\times10=5\\text{ m}\\\\\\text{Upper bound}&=90+5=95\\text{ m}\\\\\\text{Lower bound}&=90-5=85\\text{ m}\\end{aligned}$$\nHence $85\\le x<95$ m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
