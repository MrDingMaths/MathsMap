  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "In a bus, 27 of the 63 passengers are male. What is the ratio of the number of male passengers to the number of female passengers?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3:4$",
      "worked": "Number of female passengers: $63-27=36$.\n\nDivide both terms of the ratio by their highest common factor, $9$.\n\n$$\\begin{align*}\\text{Male}:\\text{female}&=27:36\\\\\\text{Male}:\\text{female}&=3:4\\end{align*}$$",
      "solutionDiagrams": []
    },
