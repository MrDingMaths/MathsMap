  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $y'=\\dfrac{4}{(2-x)(2+x)}$, where $y(0)=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{4}{(2-x)(2+x)}=\\dfrac{1}{2-x}+\\dfrac{1}{2+x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2-x}+\\dfrac{1}{2+x}=\\dfrac{2+x+2-x}{(2-x)(2+x)}=\\dfrac4{(2-x)(2+x)}$.",
          "worked": "$$\\begin{align*}\\text{RHS}&=\\frac{1}{2-x}+\\frac{1}{2+x}\\\\&=\\frac{2+x+2-x}{(2-x)(2+x)}\\\\&=\\frac4{(2-x)(2+x)}=\\text{LHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the general solution of the DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln\\left|\\dfrac{2+x}{2-x}\\right|+C$.",
          "worked": "$$\\begin{align*}y&=\\int\\left(\\frac{1}{2-x}+\\frac{1}{2+x}\\right)\\,dx\\\\&=-\\ln|2-x|+\\ln|2+x|+C\\\\&=\\ln\\left|\\frac{2+x}{2-x}\\right|+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence solve the IVP.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln\\left(\\dfrac{2+x}{2-x}\\right)+1$, $-2<x<2$.",
          "worked": "Substitute $y(0)=1$:\n$$\\begin{align*}1&=\\ln|1|+C\\\\C&=1\\\\y&=\\ln\\left(\\frac{2+x}{2-x}\\right)+1,\\qquad -2<x<2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
