        "answer": {
          "short": "$430^{\\circ}$",
          "worked": "$$\\begin{align*}\\theta&\\equiv70^{\\circ}+360^{\\circ}\\\\\\theta&\\equiv430^{\\circ}\\end{align*}$$",
