    "children": [
      {
        "id": "p71-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "How many different arrangements of ordered pairs are possible?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9900$",
          "worked": "There are 100 choices for the first card and 99 remaining choices for the second.\n$$\\text{Number of ordered pairs}=100\\times99=9900.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p71-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that a particular ordered pair is chosen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{9900}$",
          "worked": "One of the 9900 equally likely ordered pairs is the required pair.\n$$P(\\text{particular ordered pair})=\\frac{1}{9900}.$$",
