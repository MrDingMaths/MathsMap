        "answer": {
          "short": "$a^{17}$",
          "worked": "$$\\begin{align*}(a^3)^4\\times a^5&=a^{12}\\times a^5\\\\(a^3)^4\\times a^5&=a^{12+5}\\\\(a^3)^4\\times a^5&=a^{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p32-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2m^3)^4\\times(3m)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1296m^{16}$",
          "worked": "$$\\begin{align*}(2m^3)^4\\times(3m)^4&=2^4m^{12}\\times3^4m^4\\\\(2m^3)^4\\times(3m)^4&=16m^{12}\\times81m^4\\\\(2m^3)^4\\times(3m)^4&=1296m^{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p32-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{(a^3b^2)^4}{(a^2b^2)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^6b^2$",
          "worked": "$$\\begin{align*}\\frac{(a^3b^2)^4}{(a^2b^2)^3}&=\\frac{a^{12}b^8}{a^6b^6}\\\\\\frac{(a^3b^2)^4}{(a^2b^2)^3}&=a^{12-6}b^{8-6}\\\\\\frac{(a^3b^2)^4}{(a^2b^2)^3}&=a^6b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
