  "content": {
    "id": "v2-b4147-p10-practice-slot-4-130426-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $y'=\\dfrac{6}{(x-1)(x+2)}$, where $y(2)=0$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b4147-p10-practice-slot-4-130426-slot-4-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{6}{(x-1)(x+2)}=\\dfrac{2}{x-1}-\\dfrac{2}{x+2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{x-1}-\\dfrac{2}{x+2}=\\dfrac{2(x+2)-2(x-1)}{(x-1)(x+2)}=\\dfrac{6}{(x-1)(x+2)}$.",
          "worked": "$$\\begin{align*}\\text{RHS}&=\\frac{2}{x-1}-\\frac{2}{x+2}\\\\&=\\frac{2(x+2)-2(x-1)}{(x-1)(x+2)}\\\\&=\\frac{6}{(x-1)(x+2)}=\\text{LHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-b4147-p10-practice-slot-4-130426-slot-4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the general solution of the DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2\\ln\\left|\\dfrac{x-1}{x+2}\\right|+C$.",
          "worked": "$$\\begin{align*}y&=\\int\\left(\\frac{2}{x-1}-\\frac{2}{x+2}\\right)\\,dx\\\\&=2\\ln|x-1|-2\\ln|x+2|+C\\\\&=2\\ln\\left|\\frac{x-1}{x+2}\\right|+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-b4147-p10-practice-slot-4-130426-slot-4-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence solve the IVP.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2\\ln\\left(\\dfrac{x-1}{x+2}\\right)+4\\ln2$, $x>1$.",
          "worked": "Substitute $y(2)=0$:\n$$\\begin{align*}0&=2\\ln\\left|\\frac14\\right|+C\\\\C&=2\\ln4\\\\&=4\\ln2\\\\y&=2\\ln\\left(\\frac{x-1}{x+2}\\right)+4\\ln2,\\qquad x>1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
