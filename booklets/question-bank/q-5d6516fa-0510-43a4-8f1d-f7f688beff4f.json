  "content": {
    "id": "v2-a5908-p60-practice-retro-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "The angle of inclination of a line $l$ is $120^\\circ$ and it passes through the point $(2,3)$.\nA line perpendicular to $l$ passes through $(2,3)$ and $(x,-3)$.\nFind the exact value of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=2-6\\sqrt3$. Use $m_l=\\tan120^\\circ=-\\sqrt3$, so the perpendicular gradient is $\\dfrac1{\\sqrt3}$ and $\\dfrac{-6}{x-2}=\\dfrac1{\\sqrt3}$.",
      "worked": "$$\\begin{align*}m_l&=\\tan120^\\circ=-\\sqrt3\\\\m_\\perp&=-\\frac1{m_l}=\\frac1{\\sqrt3}\\\\m_\\perp&=\\frac{-3-3}{x-2}=\\frac1{\\sqrt3}\\\\\\frac{-6}{x-2}&=\\frac1{\\sqrt3}\\\\x-2&=-6\\sqrt3\\\\x&=2-6\\sqrt3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
