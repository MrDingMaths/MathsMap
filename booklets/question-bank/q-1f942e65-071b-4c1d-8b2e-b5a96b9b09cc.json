  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Write an algebraic fraction for the result of the following operations.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A number $q$ is halved and then the result is tripled.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3q}{2}$",
          "worked": "$$\\begin{align*}\\frac{q}{2}\\times3&=\\frac{3q}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "A number $x$ is multiplied by $\\dfrac{2}{3}$ and the result is divided by $1\\dfrac{1}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{2}$",
          "worked": "$$\\begin{align*}x\\times\\frac{2}{3}\\div1\\frac{1}{3}&=\\frac{2x}{3}\\div\\frac{4}{3}\\\\&=\\frac{2x}{3}\\times\\frac{3}{4}\\\\&=\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "A fraction $\\dfrac{a}{b}$ is multiplied by its reciprocal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{a}{b}\\times\\frac{b}{a}&=\\frac{ab}{ab}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "The number $x$ is reduced by 25% and then halved.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x}{8}$",
          "worked": "After a 25% reduction, 75% remains.\n$$\\begin{align*}\\frac{3x}{4}\\div2&=\\frac{3x}{4}\\times\\frac{1}{2}\\\\&=\\frac{3x}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
