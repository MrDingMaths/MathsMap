  "content": {
    "id": "p26-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "If $x=2\\sqrt{14}$ and $y=4\\sqrt2$, find and rationalise the denominator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt7}{2}$",
          "worked": "$$\\begin{align*}\\frac{x}{y}&=\\frac{2\\sqrt{14}}{4\\sqrt2}\\\\\\frac{x}{y}&=\\frac{2\\sqrt{14}}{4\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}\\\\\\frac{x}{y}&=\\frac{2\\sqrt{28}}{8}\\\\\\frac{x}{y}&=\\frac{4\\sqrt7}{8}=\\frac{\\sqrt7}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{y}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2\\sqrt7}{7}$",
          "worked": "$$\\begin{align*}\\frac{y}{x}&=\\frac{4\\sqrt2}{2\\sqrt{14}}\\\\\\frac{y}{x}&=\\frac{4\\sqrt2}{2\\sqrt{14}}\\times\\frac{\\sqrt{14}}{\\sqrt{14}}\\\\\\frac{y}{x}&=\\frac{4\\sqrt{28}}{28}\\\\\\frac{y}{x}&=\\frac{8\\sqrt7}{28}=\\frac{2\\sqrt7}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2x}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt7$",
          "worked": "$$\\begin{align*}\\frac{2x}{y}&=\\frac{2\\times2\\sqrt{14}}{4\\sqrt2}\\\\\\frac{2x}{y}&=\\frac{\\sqrt{14}}{\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}\\\\\\frac{2x}{y}&=\\frac{\\sqrt{28}}{2}\\\\\\frac{2x}{y}&=\\frac{2\\sqrt7}{2}=\\sqrt7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{\\sqrt2\\,x}{\\sqrt3\\,y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{42}}{6}$\n\nSubstitute the values of $x$ and $y$, simplify the products, then rationalise.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt2\\,x}{\\sqrt3\\,y}&=\\frac{\\sqrt2\\times2\\sqrt{14}}{\\sqrt3\\times4\\sqrt2}\\\\\\frac{\\sqrt2\\,x}{\\sqrt3\\,y}&=\\frac{4\\sqrt7}{4\\sqrt6}\\\\\\frac{\\sqrt2\\,x}{\\sqrt3\\,y}&=\\frac{\\sqrt7}{\\sqrt6}\\times\\frac{\\sqrt6}{\\sqrt6}\\\\\\frac{\\sqrt2\\,x}{\\sqrt3\\,y}&=\\frac{\\sqrt{42}}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
