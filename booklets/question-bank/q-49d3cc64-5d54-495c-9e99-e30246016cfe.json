  "content": {
    "id": "p6-ch4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the gradient of a line that is parallel and of a line that is perpendicular to each line below.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-ch4-q5-a",
        "type": "group",
        "label": "a",
        "prompt": "$y=3x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-ch4-q5-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Parallel",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "Parallel lines have equal gradients, so $m=3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p6-ch4-q5-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Perpendicular",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\frac{1}{3}$",
              "worked": "Perpendicular gradients have product $-1$.\n$$\\begin{aligned}m&=-\\frac{1}{3}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p6-ch4-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "$y=1-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-ch4-q5-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Parallel",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2$",
              "worked": "The coefficient of $x$ is $-2$. Parallel lines have equal gradients, so $m=-2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p6-ch4-q5-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Perpendicular",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{2}$",
              "worked": "Perpendicular gradients have product $-1$.\n$$\\begin{aligned}m&=-\\frac{1}{-2}\\\\m&=\\frac{1}{2}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          }
        ]
      },
      {
        "id": "p6-ch4-q5-c",
        "type": "group",
        "label": "c",
        "prompt": "$y=\\frac{1}{2}x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-ch4-q5-c-i",
            "type": "part",
            "label": "i",
            "prompt": "Parallel",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{2}$",
              "worked": "Parallel lines have equal gradients, so $m=\\frac{1}{2}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p6-ch4-q5-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Perpendicular",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2$",
              "worked": "Perpendicular gradients have product $-1$.\n$$\\begin{aligned}m&=-1\\div\\frac{1}{2}\\\\m&=-2\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p6-ch4-q5-d",
        "type": "group",
        "label": "d",
        "prompt": "$y=-\\frac{2}{3}x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-ch4-q5-d-i",
            "type": "part",
            "label": "i",
            "prompt": "Parallel",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\frac{2}{3}$",
              "worked": "Parallel lines have equal gradients, so $m=-\\frac{2}{3}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p6-ch4-q5-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Perpendicular",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{3}{2}$",
              "worked": "Perpendicular gradients have product $-1$.\n$$\\begin{aligned}m&=-1\\div\\left(-\\frac{2}{3}\\right)\\\\m&=\\frac{3}{2}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      }
    ]
