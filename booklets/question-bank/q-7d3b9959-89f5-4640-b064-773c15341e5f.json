  "content": {
    "id": "p7-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A four digit personal identification number (PIN) consists of four digits from 0 to 9.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "How many PINs are there?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10^4=10\\,000$",
          "worked": "Each of the four positions has 10 choices. A PIN may begin with 0 and digits may repeat.\n$$N=10^4=10\\,000.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "How many PINs are there if no digit is repeated?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{10}P_4=5040$",
          "worked": "Choose and order four distinct digits from ten. A PIN may begin with 0.\n$$\\begin{align*}N&={}^{10}P_4\\\\N&=\\frac{10!}{(10-4)!}\\\\N&=10\\times9\\times8\\times7\\\\N&=5040.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "How many PINs are there that do not start with the digit 0?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\times10^3=9000$",
          "worked": "The first digit has 9 choices, from 1 to 9. Each remaining digit has 10 choices; repetitions are allowed in this part.\n$$N=9\\times10^3=9000.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
