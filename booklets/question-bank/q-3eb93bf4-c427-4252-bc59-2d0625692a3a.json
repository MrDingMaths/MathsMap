    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.\\dot{2}$",
      "worked": "$$\\begin{align*}0.\\dot{6}&=\\frac{6}{9}\\\\&=\\frac{2}{3}\\\\\\frac{1}{3}\\times0.\\dot{6}&=\\frac{1}{3}\\times\\frac{2}{3}\\\\&=\\frac{2}{9}\\\\&=0.\\dot{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
