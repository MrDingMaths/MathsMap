  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A huge desert rock is entirely made up of coarse grains of sandstone, each about $1\\text{ mm}^3$ in size, and is very roughly a rectangular block $3\\text{ km}$ long, $2\\text{ km}$ wide, and $500\\text{ m}$ high.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the approximate volume of the rock in cubic kilometres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\text{ km}^3$",
          "worked": "$500\\text{ m}=0.5\\text{ km}$.\n$$\\begin{align*}V&\\approx3\\times2\\times0.5\\text{ km}^3\\\\V&\\approx3\\text{ km}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How many cubic millimetres are in a cubic kilometre? Answer in index notation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10^{18}$ cubic millimetres",
          "worked": "$1\\text{ km}=10^3\\times10^3\\text{ mm}=10^6\\text{ mm}$.\n$$\\begin{align*}1\\text{ km}^3&=(10^6)^3\\text{ mm}^3\\\\1\\text{ km}^3&=10^{18}\\text{ mm}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the approximate number of grains of sandstone in the rock.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $3\\times10^{18}$ grains.",
          "worked": "The rock has approximate volume $3\\times10^{18}\\text{ mm}^3$, and each grain occupies about $1\\text{ mm}^3$.\n$$\\begin{align*}N&\\approx\\frac{3\\times10^{18}}{1}\\\\N&\\approx3\\times10^{18}\\text{ grains}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
