  "content": {
    "id": "p50-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The remainder when $x^2-x-50$ is divided by $(x-c)$ is $-8$.\nFind the values of $c$ and hence the divisors.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c=7$ or $-6$; divisors $x-7$ or $x+6$.",
      "worked": "By the remainder theorem,\n$\\begin{aligned}c^2-c-50&=-8\\\\c^2-c-42&=0\\\\(c-7)(c+6)&=0\\\\c&=7\\text{ or }-6\\end{aligned}$\nThe divisors are $x-7$ or $x+6$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
