  "content": {
    "id": "v2-86222-p60-practice-slot-10-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Given that $x^2-10x+7=(x+a)^2+b$ for all $x$, find $a$ and $b$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-86222-p60-practice-slot-10-lower-slot-10l-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-5,\\ b=-18$",
          "worked": "$$\\begin{align*}(x+a)^2+b&=x^2+2ax+a^2+b\\end{align*}$$\nEquating coefficients,\n$$\\begin{align*}2a&=-10\\\\a&=-5\\\\a^2+b&=7\\\\25+b&=7\\\\b&=-18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-86222-p60-practice-slot-10-lower-slot-10l-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the minimum value of $x^2-10x+7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum value $-18$.",
          "worked": "$$\\begin{align*}x^2-10x+7&=(x-5)^2-18\\\\&\\geq-18\\end{align*}$$\nThe minimum value is $-18$, occurring at $x=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
