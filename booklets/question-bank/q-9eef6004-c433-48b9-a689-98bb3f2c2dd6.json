      {
        "id": "p47-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{x-6}{x-1}=1-\\dfrac{5}{x-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{RHS}=\\dfrac{(x-1)-5}{x-1}=\\dfrac{x-6}{x-1}=\\mathrm{LHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{RHS}&=1-\\frac{5}{x-1}\\\\&=\\frac{(x-1)-5}{x-1}\\\\&=\\frac{x-6}{x-1}=\\mathrm{LHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p47-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int\\frac{x-6}{x-1}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-5\\ln|x-1|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{x-6}{x-1}\\,dx&=\\int\\left(1-\\frac{5}{x-1}\\right)\\,dx\\\\&=\\int1\\,dx-5\\int\\frac{1}{x-1}\\,dx\\\\&=x-5\\ln|x-1|+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
