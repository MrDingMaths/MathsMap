        "answer": {
          "short": "$35$",
          "worked": "$$\\begin{align*}\\binom{7}{3}&=\\frac{7!}{3!4!}\\\\\\binom{7}{3}&=\\frac{7\\times6\\times5}{6}\\\\\\binom{7}{3}&=35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
