                    "type": "text",
                    "text": "Add the numbers of subsets with 3, 4, 5, 6 or 7 elements.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The possible subset sizes are $3,4,5,6$ and $7$. These cases are disjoint.\n\n$$\\begin{align*}N&=\\binom{7}{3}+\\binom{7}{4}+\\binom{7}{5}+\\binom{7}{6}+\\binom{7}{7}\\\\N&=35+35+21+7+1\\\\N&=99\\end{align*}$$",
