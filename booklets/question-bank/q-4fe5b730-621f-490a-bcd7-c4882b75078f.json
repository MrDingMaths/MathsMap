        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$",
          "worked": "$$\\begin{align*}\\binom{7}{4}&=\\frac{7!}{4!3!}\\\\\\binom{7}{4}&=\\frac{7\\times6\\times5}{6}\\\\\\binom{7}{4}&=35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
