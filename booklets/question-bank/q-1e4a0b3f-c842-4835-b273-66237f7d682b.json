        "id": "p18-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that there was 1 person in a car during this period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{11}$",
          "worked": "$$P(\\text{1 person})=\\frac{60}{165}=\\frac{4}{11}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that there was more than 1 person in a car during this period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{11}$",
          "worked": "$$P(\\text{more than 1 person})=\\frac{50+40+10+5}{165}=\\frac{105}{165}=\\frac{7}{11}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the probability that there were less than 2 people in a car during this period given that there were less than 4 people in the car?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "Restrict the sample space to the $60+50+40=150$ cars with fewer than 4 people. Of these, 60 had fewer than 2 people.\n\n$$P(\\text{fewer than 2}\\mid\\text{fewer than 4})=\\frac{60}{150}=\\frac{2}{5}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the probability that there were 5 people in a car during this period given that there were more than 3 people in the car?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "Restrict the sample space to the $10+5=15$ cars with more than 3 people. Of these, 5 had 5 people.\n\n$$P(\\text{5 people}\\mid\\text{more than 3})=\\frac{5}{15}=\\frac{1}{3}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
