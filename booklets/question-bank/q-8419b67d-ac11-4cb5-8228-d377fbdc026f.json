    "children": [
      {
        "id": "p18-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{b}{a-b}-\\frac{a}{a+b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2ab-a^2+b^2}{(a-b)(a+b)}$",
          "worked": "$$\\begin{align*}\\frac{b}{a-b}-\\frac{a}{a+b}&=\\frac{b(a+b)-a(a-b)}{(a-b)(a+b)}\\\\\\frac{b}{a-b}-\\frac{a}{a+b}&=\\frac{ab+b^2-a^2+ab}{(a-b)(a+b)}\\\\\\frac{b}{a-b}-\\frac{a}{a+b}&=\\frac{2ab-a^2+b^2}{(a-b)(a+b)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p18-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3x+5}{x^2-9}+\\frac{3x-1}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x^2-7x+8}{(x-3)(x+3)}$",
          "worked": "$x^2-9=(x-3)(x+3)$.\n$$\\begin{align*}\\frac{3x+5}{x^2-9}+\\frac{3x-1}{x+3}&=\\frac{3x+5+(3x-1)(x-3)}{(x-3)(x+3)}\\\\\\frac{3x+5}{x^2-9}+\\frac{3x-1}{x+3}&=\\frac{3x+5+3x^2-10x+3}{(x-3)(x+3)}\\\\\\frac{3x+5}{x^2-9}+\\frac{3x-1}{x+3}&=\\frac{3x^2-7x+8}{(x-3)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{4p+q}+\\frac{3}{p-2q}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15p-3q}{(4p+q)(p-2q)}$",
          "worked": "$$\\begin{align*}\\frac{3}{4p+q}+\\frac{3}{p-2q}&=\\frac{3(p-2q)+3(4p+q)}{(4p+q)(p-2q)}\\\\\\frac{3}{4p+q}+\\frac{3}{p-2q}&=\\frac{3p-6q+12p+3q}{(4p+q)(p-2q)}\\\\\\frac{3}{4p+q}+\\frac{3}{p-2q}&=\\frac{15p-3q}{(4p+q)(p-2q)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p18-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{x+5}+\\frac{1}{x-5}+\\frac{5}{x^2-25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x}{(x-5)(x+5)}$",
          "worked": "$x^2-25=(x-5)(x+5)$.\n$$\\begin{align*}\\frac{2}{x+5}+\\frac{1}{x-5}+\\frac{5}{x^2-25}&=\\frac{2(x-5)+(x+5)+5}{(x-5)(x+5)}\\\\\\frac{2}{x+5}+\\frac{1}{x-5}+\\frac{5}{x^2-25}&=\\frac{2x-10+x+5+5}{(x-5)(x+5)}\\\\\\frac{2}{x+5}+\\frac{1}{x-5}+\\frac{5}{x^2-25}&=\\frac{3x}{(x-5)(x+5)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{2}{x+4}+\\frac{3}{x-5}-\\frac{4x-1}{x^2-x-20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+3}{(x+4)(x-5)}$",
          "worked": "$x^2-x-20=(x+4)(x-5)$.\n$$\\begin{align*}\\frac{2}{x+4}+\\frac{3}{x-5}-\\frac{4x-1}{x^2-x-20}&=\\frac{2(x-5)+3(x+4)-(4x-1)}{(x+4)(x-5)}\\\\\\frac{2}{x+4}+\\frac{3}{x-5}-\\frac{4x-1}{x^2-x-20}&=\\frac{2x-10+3x+12-4x+1}{(x+4)(x-5)}\\\\\\frac{2}{x+4}+\\frac{3}{x-5}-\\frac{4x-1}{x^2-x-20}&=\\frac{x+3}{(x+4)(x-5)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{a}{a-b}+\\frac{b}{a+b}-\\frac{a^2+b^2}{a^2-b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2b}{a+b}$\n\nCombine over $(a-b)(a+b)$, then cancel the common factor $a-b$.",
          "worked": "$a^2-b^2=(a-b)(a+b)$.\n$$\\begin{align*}\\frac{a}{a-b}+\\frac{b}{a+b}-\\frac{a^2+b^2}{a^2-b^2}&=\\frac{a(a+b)+b(a-b)-(a^2+b^2)}{(a-b)(a+b)}\\\\\\frac{a}{a-b}+\\frac{b}{a+b}-\\frac{a^2+b^2}{a^2-b^2}&=\\frac{a^2+ab+ab-b^2-a^2-b^2}{(a-b)(a+b)}\\\\\\frac{a}{a-b}+\\frac{b}{a+b}-\\frac{a^2+b^2}{a^2-b^2}&=\\frac{2b(a-b)}{(a-b)(a+b)}\\\\\\frac{a}{a-b}+\\frac{b}{a+b}-\\frac{a^2+b^2}{a^2-b^2}&=\\frac{2b}{a+b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p18-q12-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{1}{a^2-6a+8}-\\frac{1}{a^2-5a+6}-\\frac{1}{a^2-7a+12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{(a-2)(a-4)}$\n\nFactorise all three denominators, combine over their lowest common denominator and cancel $a-3$.",
          "worked": "$$\\begin{align*}a^2-6a+8&=(a-2)(a-4)\\\\a^2-5a+6&=(a-2)(a-3)\\\\a^2-7a+12&=(a-3)(a-4)\\end{align*}$$\n$$\\begin{align*}\\frac{1}{a^2-6a+8}-\\frac{1}{a^2-5a+6}-\\frac{1}{a^2-7a+12}&=\\frac{(a-3)-(a-4)-(a-2)}{(a-2)(a-3)(a-4)}\\\\\\frac{1}{a^2-6a+8}-\\frac{1}{a^2-5a+6}-\\frac{1}{a^2-7a+12}&=\\frac{3-a}{(a-2)(a-3)(a-4)}\\\\\\frac{1}{a^2-6a+8}-\\frac{1}{a^2-5a+6}-\\frac{1}{a^2-7a+12}&=\\frac{-(a-3)}{(a-2)(a-3)(a-4)}\\\\\\frac{1}{a^2-6a+8}-\\frac{1}{a^2-5a+6}-\\frac{1}{a^2-7a+12}&=-\\frac{1}{(a-2)(a-4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 79
      }
    ]
