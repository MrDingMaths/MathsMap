  "content": {
    "id": "p3-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Draw a right-angled triangle with angle $\\theta$ for which $\\sin\\theta=\\frac5{13}$. Find $\\cos\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\cos\\theta=\\frac{12}{13}$",
      "worked": "Choose opposite side $5$ and hypotenuse $13$. Let $x$ be the adjacent side.\n$$\\begin{align*}x^2+5^2&=13^2\\\\x^2&=144\\\\x&=12\\\\\\cos\\theta&=\\frac{12}{13}\\end{align*}$$",
