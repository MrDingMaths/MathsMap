  "content": {
    "id": "p9-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve these quadratic equations by first removing the decimals or fractions.\nYou can do this by multiplying both sides by some common factor.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$0.1x^{2}-0.3x-2.8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$ or $x=-4$",
          "worked": "Multiply both sides by $10$.\n$$\\begin{align*}x^{2}-3x-28&=0\\\\x^{2}+4x-7x-28&=0\\\\x(x+4)-7(x+4)&=0\\\\(x-7)(x+4)&=0\\\\x&=7\\text{ or }-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p9-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$0.01x^{2}+0.12x+0.2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=-10$",
          "worked": "Multiply both sides by $100$.\n$$\\begin{align*}x^{2}+12x+20&=0\\\\x^{2}+2x+10x+20&=0\\\\x(x+2)+10(x+2)&=0\\\\(x+2)(x+10)&=0\\\\x&=-2\\text{ or }-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p9-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$0.25x^{2}+x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$",
          "worked": "Multiply both sides by $4$.\n$$\\begin{align*}x^{2}+4x+4&=0\\\\(x+2)^{2}&=0\\\\x&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{3}x^{2}-2x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "Multiply both sides by $3$.\n$$\\begin{align*}x^{2}-6x+9&=0\\\\(x-3)^{2}&=0\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
