    "children": [
      {
        "id": "p8-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Is it true that $(a^2)^6=(a^6)^2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; both sides equal $a^{12}$.",
          "worked": "$\\begin{align*}(a^2)^6&=a^{2\\times6}\\\\(a^2)^6&=a^{12}\\\\(a^6)^2&=a^{6\\times2}\\\\(a^6)^2&=a^{12}\\end{align*}$\n\nYes, both sides are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Is it true that $(b^4)^7=(b^7)^4$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; both sides equal $b^{28}$.",
          "worked": "$\\begin{align*}(b^4)^7&=b^{4\\times7}\\\\(b^4)^7&=b^{28}\\\\(b^7)^4&=b^{7\\times4}\\\\(b^7)^4&=b^{28}\\end{align*}$\n\nYes, both sides are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "Generalise your result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a^m)^n=(a^n)^m$.\n\nThe order of the two indices does not affect the result.",
          "worked": "$\\begin{align*}(a^m)^n&=a^{mn}\\\\(a^n)^m&=a^{nm}\\end{align*}$\n\nSince $mn=nm$, $(a^m)^n=(a^n)^m$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
