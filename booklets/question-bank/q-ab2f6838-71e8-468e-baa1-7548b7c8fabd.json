  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Solve each pair of simultaneous equations for $x$ and $y$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=x+1\\\\x+2y&=8\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=3$",
          "worked": "Substitute $y=x+1$ into $x+2y=8$.\n$$\\begin{align*}x+2(x+1)&=8\\\\3x+2&=8\\\\3x&=6\\\\x&=2\\\\y&=2+1\\\\y&=3\\end{align*}$$\nCheck: $3=2+1$ and $2+2(3)=8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=2x-1\\\\2x+5y&=7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=1$",
          "worked": "Substitute $y=2x-1$ into $2x+5y=7$.\n$$\\begin{align*}2x+5(2x-1)&=7\\\\12x-5&=7\\\\12x&=12\\\\x&=1\\\\y&=2(1)-1\\\\y&=1\\end{align*}$$\nCheck: $1=2(1)-1$ and $2(1)+5(1)=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}x+y&=1\\\\3x+2y&=8\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6,\\ y=-5$",
          "worked": "Double the first equation:\n$$2x+2y=2.$$\nSubtract this from the second equation.\n$$\\begin{align*}(3x+2y)-(2x+2y)&=8-2\\\\x&=6\\\\6+y&=1\\\\y&=-5\\end{align*}$$\nCheck: $6-5=1$ and $3(6)+2(-5)=8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}2x-3y&=-1\\\\6x+6y&=7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12,\\ y=\\frac23$",
          "worked": "Double the first equation:\n$$4x-6y=-2.$$\nAdd this to the second equation.\n$$\\begin{align*}(4x-6y)+(6x+6y)&=-2+7\\\\10x&=5\\\\x&=\\frac12\\end{align*}$$\nSubstitute into the first equation.\n$$\\begin{align*}2\\left(\\frac12\\right)-3y&=-1\\\\1-3y&=-1\\\\-3y&=-2\\\\y&=\\frac23\\end{align*}$$\nCheck: $2(\\frac12)-3(\\frac23)=-1$ and $6(\\frac12)+6(\\frac23)=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p7-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}5x+3y&=15\\\\3x+2y&=8\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6,\\ y=-5$",
          "worked": "Double the first equation and triple the second:\n$$\\begin{align*}10x+6y&=30\\\\9x+6y&=24\\end{align*}$$\nSubtract the second resulting equation from the first.\n$$\\begin{align*}(10x+6y)-(9x+6y)&=30-24\\\\x&=6\\\\3(6)+2y&=8\\\\2y&=-10\\\\y&=-5\\end{align*}$$\nCheck: $5(6)+3(-5)=15$ and $3(6)+2(-5)=8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p7-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}2x-3y&=-10\\\\3x+2y&=7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac1{13},\\ y=\\frac{44}{13}$",
          "worked": "Double the first equation and triple the second:\n$$\\begin{align*}4x-6y&=-20\\\\9x+6y&=21\\end{align*}$$\nAdd the resulting equations.\n$$\\begin{align*}(4x-6y)+(9x+6y)&=-20+21\\\\13x&=1\\\\x&=\\frac1{13}\\end{align*}$$\nSubstitute into the second equation.\n$$\\begin{align*}3\\left(\\frac1{13}\\right)+2y&=7\\\\2y&=7-\\frac3{13}\\\\2y&=\\frac{88}{13}\\\\y&=\\frac{44}{13}\\end{align*}$$\nCheck: $2(\\frac1{13})-3(\\frac{44}{13})=-10$ and $3(\\frac1{13})+2(\\frac{44}{13})=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      }
