    "id": "p32-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the side length of a cube that has the same volume as a cuboid with dimensions $12\\text{ m}\\times9\\text{ m}\\times2\\text{ m}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6\\text{ m}$",
      "worked": "Let the cube's side length be $s$ metres.\n\n$$\\begin{align*}V&=12\\times9\\times2\\\\V&=216\\text{ m}^3\\\\s^3&=216\\\\s&=6\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
