      {
        "id": "p21-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Factorise $a-b$ using surds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b})$",
          "worked": "$$\\begin{align*}a-b&=(\\sqrt{a})^2-(\\sqrt{b})^2\\\\a-b&=(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, simplify $\\dfrac{a-b}{\\sqrt{a}-\\sqrt{b}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{a}+\\sqrt{b}$",
          "worked": "$$\\begin{align*}\\frac{a-b}{\\sqrt{a}-\\sqrt{b}}&=\\frac{(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b})}{\\sqrt{a}-\\sqrt{b}}\\\\\\frac{a-b}{\\sqrt{a}-\\sqrt{b}}&=\\sqrt{a}+\\sqrt{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
