  "content": {
    "id": "p41-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Two resistors with resistances $r$ and $s$ ohms are connected in parallel.\n\nThe combined resistance is given by $\\dfrac{1}{\\frac{1}{r}+\\frac{1}{s}}$. Simplify this expression.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{rs}{r+s}$ ohms",
      "worked": "Multiply the main numerator and denominator by $rs$.\n\n$$\\begin{align*}\\frac{1}{\\frac{1}{r}+\\frac{1}{s}}&=\\frac{rs}{s+r}\\\\&=\\frac{rs}{r+s}\\text{ ohms}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
