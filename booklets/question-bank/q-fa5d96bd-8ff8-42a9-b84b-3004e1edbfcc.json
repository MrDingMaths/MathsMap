    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$2+\\log_e x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1x$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(2+\\log_e x)&=0+\\frac1x\\\\&=\\frac1x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$5-\\log_e(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac1{x+1}$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}\\bigl(5-\\log_e(x+1)\\bigr)&=0-\\frac1{x+1}\\\\&=-\\frac1{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x+4\\log_e x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\dfrac4x$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(x+4\\log_e x)&=1+4\\left(\\frac1x\\right)\\\\&=1+\\frac4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x^4+1+3\\log_e x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x^3+\\dfrac3x$",
          "worked": "Let $f(x)=2x^4+1+3\\log_e x$.\n$$\\begin{align*}f'(x)&=8x^3+0+3\\left(\\frac1x\\right)\\\\f'(x)&=8x^3+\\frac3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\ln(2x-1)+3x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac2{2x-1}+6x$",
          "worked": "Let $f(x)=\\ln(2x-1)+3x^2$.\n$$\\begin{align*}f'(x)&=\\frac{(2x-1)'}{2x-1}+6x\\\\f'(x)&=\\frac2{2x-1}+6x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^3-3x+4+\\ln(5x-7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^2-3+\\dfrac5{5x-7}$",
          "worked": "Let $f(x)=x^3-3x+4+\\ln(5x-7)$.\n$$\\begin{align*}f'(x)&=3x^2-3+0+\\frac{(5x-7)'}{5x-7}\\\\f'(x)&=3x^2-3+\\frac5{5x-7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
