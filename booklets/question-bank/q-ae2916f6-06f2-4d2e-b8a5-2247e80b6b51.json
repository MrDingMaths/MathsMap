    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-p1-a",
        "type": "part",
        "label": "a",
        "prompt": "the initial velocity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0\\ \\text{m/s}$.",
          "worked": "$$\\begin{align*}v(0)&=50\\left(1-e^0\\right)\\\\v(0)&=0\\ \\text{m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p43-p1-b",
        "type": "part",
        "label": "b",
        "prompt": "the acceleration at any time $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a(t)=25e^{-0.5t}\\ \\text{m/s}^2$.",
          "worked": "$$\\begin{align*}a(t)&=\\frac{dv}{dt}\\\\a(t)&=50\\left(0-(-0.5)e^{-0.5t}\\right)\\\\a(t)&=25e^{-0.5t}\\ \\text{m/s}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p43-p1-c",
        "type": "part",
        "label": "c",
        "prompt": "what happens to $\\frac{dx}{dt}$ as $t\\to\\infty$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{dx}{dt}\\to 50\\ \\text{m/s}$.",
          "worked": "As $t\\to\\infty$, $e^{-0.5t}\\to 0$. Thus\n\n$$\\lim_{t\\to\\infty}\\frac{dx}{dt}=50(1-0)=50\\ \\text{m/s}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p43-p1-d",
        "type": "part",
        "label": "d",
        "prompt": "Draw the graph of $\\frac{dx}{dt}$ against time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The curve rises from $(0,0)$ and approaches $v=50$ from below.",
          "worked": "Plot $v=50(1-e^{-0.5t})$ for $t\\ge 0$. It starts at $(0,0)$. The gradient $25e^{-0.5t}$ is positive and decreases towards zero, so the curve rises and levels off towards $v=50$.",
          "solutionDiagrams": [
