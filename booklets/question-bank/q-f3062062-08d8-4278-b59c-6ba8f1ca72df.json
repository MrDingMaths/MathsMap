  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The probability that a basketball player will shoot a basket is $\\frac{9}{13}$. For the Bernoulli distribution for shooting a basket, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q8-a-node",
        "type": "part",
        "label": "a",
        "prompt": "the mean",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{13}$",
          "worked": "$E(X)=p=\\frac{9}{13}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p16-q8-b-node",
        "type": "part",
        "label": "b",
        "prompt": "the variance",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{36}{169}$",
          "worked": "$\\begin{aligned}\\operatorname{Var}(X)&=p(1-p)\\\\\\operatorname{Var}(X)&=\\frac{9}{13}\\left(\\frac{4}{13}\\right)=\\frac{36}{169}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q8-c-node",
        "type": "part",
        "label": "c",
        "prompt": "the standard deviation",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6}{13}$",
          "worked": "$\\sigma=\\sqrt{\\operatorname{Var}(X)}=\\sqrt{\\frac{36}{169}}=\\frac{6}{13}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
