  "content": {
    "id": "p16-q1",
    "type": "question",
    "label": "1",
    "prompt": "Find the coordinates of the points of intersection of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2$ and $y=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,4)$ and $(-2,4)$.",
          "worked": "$$\\begin{align*}x^2&=4\\\\x&=\\pm2\\\\y&=4\\end{align*}$$\nThe intersections are $(2,4)$ and $(-2,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2$ and $y=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,1)$ and $(-1,1)$.",
          "worked": "$$\\begin{align*}x^2&=1\\\\x&=\\pm1\\\\y&=1\\end{align*}$$\nThe intersections are $(1,1)$ and $(-1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x-1)^2$ and $y=2x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,1)$.",
          "worked": "$$\\begin{align*}(x-1)^2&=2x-3\\\\x^2-2x+1&=2x-3\\\\x^2-4x+4&=0\\\\(x-2)^2&=0\\\\x&=2\\\\y&=2(2)-3=1\\end{align*}$$\nThe intersection is $(2,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^2$ and $y=7x-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,9)$ and $(4,16)$.",
          "worked": "$$\\begin{align*}x^2&=7x-12\\\\x^2-7x+12&=0\\\\(x-3)(x-4)&=0\\\\x&=3\\text{ or }4\\end{align*}$$\nWhen $x=3$, $y=7(3)-12=9$. When $x=4$, $y=7(4)-12=16$.\nThe intersections are $(3,9)$ and $(4,16)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
