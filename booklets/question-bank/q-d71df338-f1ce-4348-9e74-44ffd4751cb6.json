  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The circumference of a circle is $6\\pi\\text{ cm}$. Find the radius of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\text{ cm}$",
      "worked": "$$\\begin{align*}2\\pi r&=6\\pi\\\\r&=\\frac{6\\pi}{2\\pi}\\\\r&=3\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
