  "content": {
    "id": "p32-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Find the first term and common difference of the AP with $a_{10}=18$ and $a_{20}=48$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-9$, $d=3$.",
      "worked": "$$\\begin{align*}a_{10}&=a+9d=18\\qquad\\text{(1)}\\\\a_{20}&=a+19d=48\\qquad\\text{(2)}\\end{align*}$$\nSubtract (1) from (2):\n$$\\begin{align*}10d&=30\\\\d&=3\\end{align*}$$\nSubstitute into (1):\n$$\\begin{align*}a+27&=18\\\\a&=-9\\end{align*}$$\nTherefore $a=-9$ and $d=3$.",
      "solutionDiagrams": []
    },
