  "content": {
    "id": "v2-2e68c-p55-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the tangent to $y=\\dfrac{1}{(3x-1)^2}$ at the point where $x=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3x+4y-4=0$",
      "worked": "$$\\begin{align*}y&=(3x-1)^{-2}\\\\\\frac{dy}{dx}&=-2(3x-1)^{-3}\\times3\\\\\\frac{dy}{dx}&=-\\frac{6}{(3x-1)^3}\\\\m&=-\\frac{6}{2^3}\\\\m&=-\\frac34\\\\y(1)&=\\frac{1}{2^2}\\\\y(1)&=\\frac14\\end{align*}$$\nThe tangent passes through $\\left(1,\\dfrac14\\right)$:\n$$\\begin{align*}y-\\frac14&=-\\frac34(x-1)\\\\4y-1&=-3x+3\\\\3x+4y-4&=0\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
