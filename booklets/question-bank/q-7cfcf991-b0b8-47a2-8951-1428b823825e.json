  "content": {
    "id": "p15-q46-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=\\log_4(x)+\\log_2(x)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q46-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(2)$, $f(4)$ and $f(8)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(2)=\\dfrac32$, $f(4)=3$, $f(8)=\\dfrac92$.",
          "worked": "$4^{1/2}=2$ and $4^{3/2}=8$. Substituting each input gives\n$$\\begin{align*}f(2)&=\\log_4(2)+\\log_2(2)\\\\f(2)&=\\frac12+1\\\\f(2)&=\\frac32\\\\f(4)&=\\log_4(4)+\\log_2(4)\\\\f(4)&=1+2\\\\f(4)&=3\\\\f(8)&=\\log_4(8)+\\log_2(8)\\\\f(8)&=\\frac32+3\\\\f(8)&=\\frac92.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 88
      },
      {
        "id": "p15-q46-b",
        "type": "part",
        "label": "b",
        "prompt": "State the domain of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,\\infty)$",
          "worked": "Both logarithms require a positive argument:\n$$\\begin{align*}x&>0\\\\\\operatorname{Dom}(f)&=(0,\\infty).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
