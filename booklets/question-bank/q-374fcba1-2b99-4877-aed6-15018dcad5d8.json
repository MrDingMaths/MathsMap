  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Determine how many times the line intersects the parabola.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=2-2x\\\\y&=x^2-4x+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Once.",
          "worked": "$$\\begin{align*}x^2-4x+3&=2-2x\\\\x^2-2x+1&=0\\\\\\Delta&=(-2)^2-4(1)(1)\\\\\\Delta&=0\\end{align*}$$\nThe line is tangent to the parabola, so they intersect once.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=3x+4\\\\y&=2x^2-7x+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Twice.",
          "worked": "$$\\begin{align*}2x^2-7x+1&=3x+4\\\\2x^2-10x-3&=0\\\\\\Delta&=(-10)^2-4(2)(-3)\\\\\\Delta&=124>0\\end{align*}$$\nThere are two distinct real solutions, so the line intersects the parabola twice.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=2x-3\\\\y&=5x^2-x+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No intersections.",
          "worked": "$$\\begin{align*}5x^2-x+3&=2x-3\\\\5x^2-3x+6&=0\\\\\\Delta&=(-3)^2-4(5)(6)\\\\\\Delta&=-111<0\\end{align*}$$\nThere are no real solutions, so the line and parabola do not intersect.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=3x-4\\\\y&=x^2-3x+5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Once.",
          "worked": "$$\\begin{align*}x^2-3x+5&=3x-4\\\\x^2-6x+9&=0\\\\\\Delta&=(-6)^2-4(1)(9)\\\\\\Delta&=0\\end{align*}$$\nThe line is tangent to the parabola, so they intersect once.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
