  "content": {
    "id": "p14-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $x$ if $x+\\dfrac1x=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{3\\pm\\sqrt5}{2}$.",
          "worked": "Here $x\\ne0$.\n$$\\begin{align*}x^2+1&=3x\\\\x^2-3x&=-1\\\\x^2-3x+\\frac94&=-1+\\frac94\\\\\\left(x-\\frac32\\right)^2&=\\frac54\\\\x-\\frac32&=\\pm\\frac{\\sqrt5}{2}\\\\x&=\\frac{3\\pm\\sqrt5}{2}.\\end{align*}$$\nBoth roots are nonzero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p14-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "For what integer values of $a$ does $x+\\dfrac1x=a$ have integer solutions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm2$.\n\nAn integer solution must divide $1$, so $x=\\pm1$.",
          "worked": "For an integer solution $x\\ne0$,\n$$\\begin{align*}x^2+1&=ax\\\\x(a-x)&=1.\\end{align*}$$\nBoth factors are integers, so they are both $1$ or both $-1$. Thus $x=1$ gives $a=2$, and $x=-1$ gives $a=-2$. Both values work.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p14-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "If $x+\\dfrac1x$ is an integer, then prove that $x^2+\\dfrac1{x^2}$ is an integer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Let $m=x+\\dfrac1x\\in\\mathbb Z$. Then $x^2+\\dfrac1{x^2}=m^2-2\\in\\mathbb Z$.",
          "worked": "Let $x+\\dfrac1x=m$, where $m\\in\\mathbb Z$.\n$$\\begin{align*}\\left(x+\\frac1x\\right)^2&=m^2\\\\x^2+2+\\frac1{x^2}&=m^2\\\\x^2+\\frac1{x^2}&=m^2-2.\\end{align*}$$\nSince $m$ is an integer, $m^2-2$ is an integer, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p14-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "If $x+\\dfrac1x$ is an integer, then prove that $x^3+\\dfrac1{x^3}$ is an integer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Let $m=x+\\dfrac1x\\in\\mathbb Z$. Then $x^3+\\dfrac1{x^3}=m^3-3m\\in\\mathbb Z$.",
          "worked": "Let $x+\\dfrac1x=m$, where $m\\in\\mathbb Z$.\n$$\\begin{align*}\\left(x+\\frac1x\\right)^3&=m^3\\\\x^3+3x^2\\left(\\frac1x\\right)+3x\\left(\\frac1{x^2}\\right)+\\frac1{x^3}&=m^3\\\\x^3+3x+\\frac3x+\\frac1{x^3}&=m^3\\\\x^3+\\frac1{x^3}+3\\left(x+\\frac1x\\right)&=m^3\\\\x^3+\\frac1{x^3}+3m&=m^3\\\\x^3+\\frac1{x^3}&=m^3-3m.\\end{align*}$$\nSince $m$ is an integer, $m^3-3m$ is an integer, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      }
    ]
  },
