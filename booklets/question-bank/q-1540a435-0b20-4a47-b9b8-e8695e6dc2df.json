          "inlines": [
            {
              "type": "text",
              "text": "Recall that the half-life of a radioactive substance is the amount of time that must elapse for any mass to decay down to exactly half of what it was originally.",
              "marks": []
            }
          ]
        },
        {
          "id": "p23-q15-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Show that the half-life of the radioactive substance is independent of the original mass.",
              "marks": []
            }
