        "prompt": "the number of square centimetres in a square metre",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\,000\\text{ cm}^2$",
          "worked": "A square metre is a square with side length $100\\text{ cm}$.\n\n$$\\begin{align*}A&=100\\times100\\text{ cm}^2\\\\A&=10\\,000\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "the number of hectares in a square kilometre",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100$ hectares",
          "worked": "A square kilometre is a square with side length $1000\\text{ m}$, and $1\\text{ ha}=10\\,000\\text{ m}^2$.\n\n$$\\begin{align*}A&=1000\\times1000\\text{ m}^2\\\\A&=1\\,000\\,000\\text{ m}^2\\\\A&=\\frac{1\\,000\\,000}{10\\,000}\\text{ ha}\\\\A&=100\\text{ ha}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "the number of square metres in a square kilometre",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,000\\,000\\text{ m}^2$",
          "worked": "A square kilometre is a square with side length $1000\\text{ m}$.\n\n$$\\begin{align*}A&=1000\\times1000\\text{ m}^2\\\\A&=1\\,000\\,000\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
