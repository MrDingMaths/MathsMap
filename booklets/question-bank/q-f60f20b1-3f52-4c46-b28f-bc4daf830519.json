        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}(\\sqrt8-\\sqrt2)^2&=(\\sqrt8)^2-2\\sqrt8\\sqrt2+(\\sqrt2)^2\\\\(\\sqrt8-\\sqrt2)^2&=8-2\\sqrt{16}+2\\\\(\\sqrt8-\\sqrt2)^2&=8-8+2\\\\(\\sqrt8-\\sqrt2)^2&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
