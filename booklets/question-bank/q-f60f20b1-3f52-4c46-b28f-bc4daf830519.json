    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt2+3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11+6\\sqrt2$",
          "worked": "$$\\begin{align*}(\\sqrt2+3)^2&=(\\sqrt2)^2+2(\\sqrt2)(3)+3^2\\\\(\\sqrt2+3)^2&=2+6\\sqrt2+9\\\\(\\sqrt2+3)^2&=11+6\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt3+2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+4\\sqrt3$",
          "worked": "$$\\begin{align*}(\\sqrt3+2)^2&=(\\sqrt3)^2+2(\\sqrt3)(2)+2^2\\\\(\\sqrt3+2)^2&=3+4\\sqrt3+4\\\\(\\sqrt3+2)^2&=7+4\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2\\sqrt5+3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$29+12\\sqrt5$",
          "worked": "$$\\begin{align*}(2\\sqrt5+3)^2&=(2\\sqrt5)^2+2(2\\sqrt5)(3)+3^2\\\\(2\\sqrt5+3)^2&=20+12\\sqrt5+9\\\\(2\\sqrt5+3)^2&=29+12\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3\\sqrt7-3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$72-18\\sqrt7$",
          "worked": "$$\\begin{align*}(3\\sqrt7-3)^2&=(3\\sqrt7)^2-2(3\\sqrt7)(3)+3^2\\\\(3\\sqrt7-3)^2&=63-18\\sqrt7+9\\\\(3\\sqrt7-3)^2&=72-18\\sqrt7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt5+\\sqrt2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+2\\sqrt{10}$",
          "worked": "$$\\begin{align*}(\\sqrt5+\\sqrt2)^2&=(\\sqrt5)^2+2\\sqrt5\\sqrt2+(\\sqrt2)^2\\\\(\\sqrt5+\\sqrt2)^2&=5+2\\sqrt{10}+2\\\\(\\sqrt5+\\sqrt2)^2&=7+2\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sqrt3-\\sqrt2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5-2\\sqrt6$",
          "worked": "$$\\begin{align*}(\\sqrt3-\\sqrt2)^2&=(\\sqrt3)^2-2\\sqrt3\\sqrt2+(\\sqrt2)^2\\\\(\\sqrt3-\\sqrt2)^2&=3-2\\sqrt6+2\\\\(\\sqrt3-\\sqrt2)^2&=5-2\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$(\\sqrt5+\\sqrt2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+2\\sqrt{10}$",
          "worked": "$$\\begin{align*}(\\sqrt5+\\sqrt2)^2&=(\\sqrt5)^2+2\\sqrt5\\sqrt2+(\\sqrt2)^2\\\\(\\sqrt5+\\sqrt2)^2&=5+2\\sqrt{10}+2\\\\(\\sqrt5+\\sqrt2)^2&=7+2\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$(\\sqrt8-\\sqrt2)^2$",
        "layout": "list",
        "columns": null,
