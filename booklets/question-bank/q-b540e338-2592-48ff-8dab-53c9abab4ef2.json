    "type": "question",
    "label": "1",
    "prompt": "Calculate the mean and mode of each data set. Give answers correct to 1 decimal place, unless otherwise specified.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$1,1,3,5,5,5,10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mean $=4.3$; mode $=5$.",
          "worked": "$$\\begin{aligned}\\text{Mean}&=\\frac{1+1+3+5+5+5+10}{7}\\\\\\text{Mean}&=\\frac{30}{7}\\\\\\text{Mean}&\\approx4.3\\end{aligned}$$\n\nThe value $5$ occurs three times, more often than any other value, so the mode is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$4,4,4,7,8,8,10,11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mean $=7.0$; mode $=4$.",
          "worked": "$$\\begin{aligned}\\text{Mean}&=\\frac{4+4+4+7+8+8+10+11}{8}\\\\\\text{Mean}&=\\frac{56}{8}\\\\\\text{Mean}&=7.0\\end{aligned}$$\n\nThe value $4$ occurs three times, more often than any other value, so the mode is $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
