  "content": {
    "id": "p69-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A cubic function is in the form $y=k(x-\\alpha)(x-\\beta)(x-\\gamma)$. Find its equation if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p69-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "it has $x$-intercepts $2$, $3$ and $-5$ and passes through the point $(-2,-120)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2(x-2)(x-3)(x+5)$",
          "worked": "Using the $x$-intercepts, $y=k(x-2)(x-3)(x+5)$. Substitute $(-2,-120)$:\n$$\\begin{align*}-120&=k(-2-2)(-2-3)(-2+5)\\\\-120&=k(-4)(-5)(3)\\\\-120&=60k\\\\k&=-2\\\\y&=-2(x-2)(x-3)(x+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p69-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "it has $x$-intercepts $-1$, $4$ and $6$ and passes through the point $(3,96)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=8(x+1)(x-4)(x-6)$",
          "worked": "Using the $x$-intercepts, $y=k(x+1)(x-4)(x-6)$. Substitute $(3,96)$:\n$$\\begin{align*}96&=k(3+1)(3-4)(3-6)\\\\96&=k(4)(-1)(-3)\\\\96&=12k\\\\k&=8\\\\y&=8(x+1)(x-4)(x-6)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p69-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "it has $x$-intercepts $1$ and $3$, $y$-intercept $-27$ and $k=-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3(x-1)(x-3)(x+3)$",
          "worked": "Let the remaining $x$-intercept be $\\gamma$. Then $y=-3(x-1)(x-3)(x-\\gamma)$. Substitute $(0,-27)$:\n$$\\begin{align*}-27&=-3(0-1)(0-3)(0-\\gamma)\\\\-27&=-3(-1)(-3)(-\\gamma)\\\\-27&=9\\gamma\\\\\\gamma&=-3\\\\y&=-3(x-1)(x-3)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
