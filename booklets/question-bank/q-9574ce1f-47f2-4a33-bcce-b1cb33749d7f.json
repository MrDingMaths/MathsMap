  "content": {
    "id": "p2-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Consider the points $A(-1,1)$ and $B(1,k)$. Find $k$ if $AB=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=1\\pm\\sqrt5$.",
      "worked": "$$\\begin{align*}AB&=\\sqrt{(1-(-1))^2+(k-1)^2}\\\\3&=\\sqrt{4+(k-1)^2}\\\\9&=4+(k-1)^2\\\\(k-1)^2&=5\\\\k-1&=\\pm\\sqrt5\\\\k&=1\\pm\\sqrt5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
