      {
        "id": "p22-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{\\sqrt5-\\sqrt7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac12(\\sqrt5+\\sqrt7)$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt5-\\sqrt7}&=\\frac1{\\sqrt5-\\sqrt7}\\times\\frac{\\sqrt5+\\sqrt7}{\\sqrt5+\\sqrt7}\\\\\\frac1{\\sqrt5-\\sqrt7}&=\\frac{\\sqrt5+\\sqrt7}{5-7}\\\\\\frac1{\\sqrt5-\\sqrt7}&=-\\frac12(\\sqrt5+\\sqrt7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sqrt5}{2\\sqrt5-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10+3\\sqrt5}{11}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt5}{2\\sqrt5-3}&=\\frac{\\sqrt5}{2\\sqrt5-3}\\times\\frac{2\\sqrt5+3}{2\\sqrt5+3}\\\\\\frac{\\sqrt5}{2\\sqrt5-3}&=\\frac{10+3\\sqrt5}{20-9}\\\\\\frac{\\sqrt5}{2\\sqrt5-3}&=\\frac{10+3\\sqrt5}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2}{3+\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12(3-\\sqrt5)$",
          "worked": "$$\\begin{align*}\\frac2{3+\\sqrt5}&=\\frac2{3+\\sqrt5}\\times\\frac{3-\\sqrt5}{3-\\sqrt5}\\\\\\frac2{3+\\sqrt5}&=\\frac{2(3-\\sqrt5)}{9-5}\\\\\\frac2{3+\\sqrt5}&=\\frac{3-\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2}{3-\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12(3+\\sqrt5)$",
          "worked": "$$\\begin{align*}\\frac2{3-\\sqrt5}&=\\frac2{3-\\sqrt5}\\times\\frac{3+\\sqrt5}{3+\\sqrt5}\\\\\\frac2{3-\\sqrt5}&=\\frac{2(3+\\sqrt5)}{9-5}\\\\\\frac2{3-\\sqrt5}&=\\frac{3+\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
