            "id": "p20-q4-a-i",
            "type": "part",
            "label": "a",
            "prompt": "Semivertical angle is $45^\\circ$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=h$, $V=\\dfrac{\\pi}{3}h^3$.",
              "worked": "$\\begin{aligned}\\tan45^\\circ&=\\frac{r}{h}=1\\\\r&=h\\\\V&=\\frac13\\pi r^2h\\\\&=\\frac13\\pi(h^2)h\\\\&=\\frac{\\pi}{3}h^3\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p20-q4-a-ii",
            "type": "part",
            "label": "b",
            "prompt": "Semivertical angle is $30^\\circ$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=\\dfrac{h}{\\sqrt3}$, $V=\\dfrac{\\pi}{9}h^3$.",
              "worked": "$\\begin{aligned}\\tan30^\\circ&=\\frac{r}{h}=\\frac1{\\sqrt3}\\\\r&=\\frac{h}{\\sqrt3}\\\\V&=\\frac13\\pi r^2h\\\\&=\\frac13\\pi\\left(\\frac{h}{\\sqrt3}\\right)^2h\\\\&=\\frac{\\pi}{9}h^3\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ],
        "diagramPlacement": "right-of-prompt"
      },
      {
        "id": "p20-q4-b",
        "type": "group",
        "label": "",
        "prompt": "Hence, find the rate the water level rises when the depth is $4\\text{ cm}$, given that",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q4-b-i",
            "type": "part",
            "label": "c",
            "prompt": "the semivertical angle is $45^\\circ$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{2\\pi}\\text{ cm/s}$.",
              "worked": "$\\begin{aligned}V&=\\frac{\\pi}{3}h^3\\\\\\frac{dV}{dt}&=\\pi h^2\\frac{dh}{dt}=8\\\\\\frac{dh}{dt}&=\\frac8{\\pi h^2}\\end{aligned}$\n\nWhen $h=4$:\n\n$\\begin{aligned}\\frac{dh}{dt}&=\\frac8{16\\pi}\\\\&=\\frac1{2\\pi}\\text{ cm/s}.\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          },
          {
            "id": "p20-q4-b-ii",
            "type": "part",
            "label": "d",
            "prompt": "the semivertical angle is $30^\\circ$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{3}{2\\pi}\\text{ cm/s}$.",
              "worked": "$\\begin{aligned}V&=\\frac{\\pi}{9}h^3\\\\\\frac{dV}{dt}&=\\frac{\\pi}{3}h^2\\frac{dh}{dt}=8\\\\\\frac{dh}{dt}&=\\frac{24}{\\pi h^2}\\end{aligned}$\n\nWhen $h=4$:\n\n$\\begin{aligned}\\frac{dh}{dt}&=\\frac{24}{16\\pi}\\\\&=\\frac3{2\\pi}\\text{ cm/s}.\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          }
        ]
