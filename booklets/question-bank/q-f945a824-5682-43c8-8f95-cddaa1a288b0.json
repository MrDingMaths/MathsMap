            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 20 p20-q4-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,3.5);\n\\coordinate (O) at (0,0);\n\\coordinate (L) at (-1.6,0);\n\\coordinate (R) at (1.6,0);\n\\draw[line width=0.8pt] (L)--(A)--(R);\n\\draw[line width=0.8pt] (L) arc[start angle=180,end angle=360,x radius=1.6,y radius=0.28];\n\\draw[dashed,line width=0.4pt] (R) arc[start angle=0,end angle=180,x radius=1.6,y radius=0.28];\n\\draw[dashed,line width=0.4pt] (A)--(O) node[midway,right] {$h$};\n\\draw[dashed,line width=0.4pt] (O)--(R) node[midway,below=12pt] {$r$};\n\\draw[line width=0.4pt,dashed] (0,0.16)--(0.16,0.16)--(0.16,0);\n\\pic[draw,line width=0.4pt,angle radius=7mm] {angle=O--A--R};\n\\coordinate (M) at ($(A)!0.75!(O)$);\n\\draw[line width=0.4pt,->] (0.24,2.78) to[out=35,in=180] (1.15,3.52);\n\\node[anchor=west,align=left] at (1.17,3.52) {semi-vertical angle};\n\\end{tikzpicture}",
            "src": null,
