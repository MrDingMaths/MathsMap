  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Prove that\n$$\\frac{\\cos4\\theta-\\cos2\\theta}{\\sin4\\theta+\\sin2\\theta}=-\\tan\\theta.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\tan\\theta$.\n\nApply the sum-to-product formulas to the numerator and denominator, cancel the common factor, then use the quotient identity.",
      "worked": "$$\\begin{align*}\\frac{\\cos4\\theta-\\cos2\\theta}{\\sin4\\theta+\\sin2\\theta}&=\\frac{-2\\sin3\\theta\\sin\\theta}{2\\sin3\\theta\\cos\\theta}\\\\\\frac{\\cos4\\theta-\\cos2\\theta}{\\sin4\\theta+\\sin2\\theta}&=-\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\frac{\\cos4\\theta-\\cos2\\theta}{\\sin4\\theta+\\sin2\\theta}&=-\\tan\\theta.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
