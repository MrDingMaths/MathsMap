    "type": "question",
    "label": "48",
    "prompt": "Find two possible parametrisations for $y=3x-2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(t,3t-2)$ or $(t+1,3t+1)$, each with $t\\in\\mathbb R$.",
      "worked": "Choose $x=t$:\n$$y=3t-2.$$\nThis gives $(t,3t-2)$.\nChoose $x=t+1$:\n$$\\begin{align*}y&=3(t+1)-2\\\\y&=3t+1\\end{align*}$$\nThis gives $(t+1,3t+1)$. Both use $t\\in\\mathbb R$.",
      "solutionDiagrams": []
    },
