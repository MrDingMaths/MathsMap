    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{(1+\\sqrt{2})+\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3+2\\sqrt{2}-\\sqrt{5}-\\sqrt{10}}{2}$\n\nApply conjugates twice.",
          "worked": "Let $E=\\frac{1}{(1+\\sqrt{2})+\\sqrt{5}}$. Then\n$$\\begin{align*}E&=\\frac{1+\\sqrt{2}-\\sqrt{5}}{(1+\\sqrt{2})^2-5}\\\\E&=\\frac{1+\\sqrt{2}-\\sqrt{5}}{2\\sqrt{2}-2}\\\\E&=\\frac{(1+\\sqrt{2}-\\sqrt{5})(\\sqrt{2}+1)}{2(\\sqrt{2}-1)(\\sqrt{2}+1)}\\\\E&=\\frac{3+2\\sqrt{2}-\\sqrt{10}-\\sqrt{5}}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p43-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{\\sqrt{7}+\\sqrt{3}-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{3}+\\sqrt{21}-3}{12}$\n\nGroup $\\sqrt{3}-2$, apply the conjugate, then multiply numerator and denominator by $\\sqrt{3}$.",
          "worked": "Let $E=\\frac{1}{\\sqrt{7}+\\sqrt{3}-2}$. Then\n$$\\begin{align*}E&=\\frac{\\sqrt{7}-\\sqrt{3}+2}{7-(\\sqrt{3}-2)^2}\\\\E&=\\frac{\\sqrt{7}-\\sqrt{3}+2}{4\\sqrt{3}}\\\\E&=\\frac{(\\sqrt{7}-\\sqrt{3}+2)\\sqrt{3}}{12}\\\\E&=\\frac{\\sqrt{21}-3+2\\sqrt{3}}{12}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
