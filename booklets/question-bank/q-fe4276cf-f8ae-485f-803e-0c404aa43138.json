        "answer": {
          "short": "$S_4=60,\\quad S_5=50,\\quad S_6=30$",
          "worked": "$$\\begin{align*}S_4&=30+20+10+0=60\\\\S_5&=30+20+10+0-10=50\\\\S_6&=30+20+10+0-10-20=30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
