        "answer": {
          "short": "$S_4=120,\\quad S_5=121,\\quad S_6=121\\frac13$",
          "worked": "$$\\begin{align*}S_4&=81+27+9+3=120\\\\S_5&=81+27+9+3+1=121\\\\S_6&=81+27+9+3+1+\\frac13=121\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
