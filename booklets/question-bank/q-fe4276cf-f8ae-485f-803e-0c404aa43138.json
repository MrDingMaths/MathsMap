    "type": "question",
    "label": "2",
    "prompt": "Find the partial sums $S_4$, $S_5$ and $S_6$ for each series (which you will need to continue).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$1-2+3-4+\\cdots$",
