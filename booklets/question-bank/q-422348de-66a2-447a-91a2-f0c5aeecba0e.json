  "content": {
    "id": "p21-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "For each function, find its inverse $f^{-1}(x)$ then verify $f(f^{-1}(x))=x$ and $f^{-1}(f(x))=x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q16-a",
        "type": "group",
        "label": "a",
        "prompt": "$f(x)=x^3+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p21-q16-a-inverse",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f^{-1}(x)=\\sqrt[3]{x-1}$, for $x\\in\\mathbb{R}$.",
              "worked": "$$\\begin{align*}y&=x^3+1\\\\x&=y^3+1\\\\y^3&=x-1\\\\y&=\\sqrt[3]{x-1}\\\\f^{-1}(x)&=\\sqrt[3]{x-1}\\end{align*}$$Both functions have domain $\\mathbb{R}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42,
            "responseSpace": "scaffold"
          },
          {
            "id": "p21-q16-a-verify-forward",
            "type": "part",
            "label": "",
            "prompt": "Verify $f(f^{-1}(x))=x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(f^{-1}(x))=x$, for all real $x$.",
              "worked": "$$\\begin{align*}f(f^{-1}(x))&=\\left(\\sqrt[3]{x-1}\\right)^3+1\\\\&=(x-1)+1\\\\&=x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p21-q16-a-verify-reverse",
            "type": "part",
            "label": "",
            "prompt": "Verify $f^{-1}(f(x))=x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f^{-1}(f(x))=x$, for all real $x$.",
              "worked": "$$\\begin{align*}f^{-1}(f(x))&=\\sqrt[3]{(x^3+1)-1}\\\\&=\\sqrt[3]{x^3}\\\\&=x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          }
        ]
      },
      {
        "id": "p21-q16-b",
        "type": "group",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{1-x}{3+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p21-q16-b-inverse",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f^{-1}(x)=\\dfrac{1-3x}{1+x}$, $x\\ne-1$.",
              "worked": "$$\\begin{align*}y&=\\frac{1-x}{3+x}\\\\x&=\\frac{1-y}{3+y}\\\\x(3+y)&=1-y\\\\3x+xy&=1-y\\\\xy+y&=1-3x\\\\y(x+1)&=1-3x\\\\y&=\\frac{1-3x}{1+x}\\\\f^{-1}(x)&=\\frac{1-3x}{1+x}\\end{align*}$$The domain of $f$ is $\\mathbb{R}\\setminus\\{-3\\}$ and its range is $\\mathbb{R}\\setminus\\{-1\\}$. The inverse has domain $\\mathbb{R}\\setminus\\{-1\\}$ and range $\\mathbb{R}\\setminus\\{-3\\}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 61,
            "responseSpace": "scaffold"
          },
          {
            "id": "p21-q16-b-verify-forward",
            "type": "part",
            "label": "",
            "prompt": "Verify $f(f^{-1}(x))=x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(f^{-1}(x))=x$, for $x\\ne-1$.",
              "worked": "$$\\begin{align*}f(f^{-1}(x))&=\\frac{1-\\frac{1-3x}{1+x}}{3+\\frac{1-3x}{1+x}}\\\\&=\\frac{\\frac{1+x-(1-3x)}{1+x}}{\\frac{3(1+x)+(1-3x)}{1+x}}\\\\&=\\frac{\\frac{4x}{1+x}}{\\frac{4}{1+x}}\\\\&=x\\end{align*}$$Valid for $x\\ne-1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p21-q16-b-verify-reverse",
            "type": "part",
            "label": "",
            "prompt": "Verify $f^{-1}(f(x))=x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f^{-1}(f(x))=x$, for $x\\ne-3$.",
              "worked": "$$\\begin{align*}f^{-1}(f(x))&=\\frac{1-3\\left(\\frac{1-x}{3+x}\\right)}{1+\\frac{1-x}{3+x}}\\\\&=\\frac{\\frac{3+x-3(1-x)}{3+x}}{\\frac{3+x+(1-x)}{3+x}}\\\\&=\\frac{\\frac{4x}{3+x}}{\\frac{4}{3+x}}\\\\&=x\\end{align*}$$Valid for $x\\ne-3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          }
        ]
      },
      {
        "id": "p21-q16-c",
        "type": "group",
        "label": "c",
        "prompt": "$f(x)=\\sqrt[3]{x-7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p21-q16-c-inverse",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f^{-1}(x)=x^3+7$, for $x\\in\\mathbb{R}$.",
              "worked": "$$\\begin{align*}y&=\\sqrt[3]{x-7}\\\\x&=\\sqrt[3]{y-7}\\\\x^3&=y-7\\\\y&=x^3+7\\\\f^{-1}(x)&=x^3+7\\end{align*}$$Both functions have domain $\\mathbb{R}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42,
            "responseSpace": "scaffold"
          },
          {
            "id": "p21-q16-c-verify-forward",
            "type": "part",
            "label": "",
            "prompt": "Verify $f(f^{-1}(x))=x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(f^{-1}(x))=x$, for all real $x$.",
              "worked": "$$\\begin{align*}f(f^{-1}(x))&=\\sqrt[3]{(x^3+7)-7}\\\\&=\\sqrt[3]{x^3}\\\\&=x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p21-q16-c-verify-reverse",
            "type": "part",
            "label": "",
            "prompt": "Verify $f^{-1}(f(x))=x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f^{-1}(f(x))=x$, for all real $x$.",
              "worked": "$$\\begin{align*}f^{-1}(f(x))&=\\left(\\sqrt[3]{x-7}\\right)^3+7\\\\&=(x-7)+7\\\\&=x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          }
        ]
      }
    ]
  },
