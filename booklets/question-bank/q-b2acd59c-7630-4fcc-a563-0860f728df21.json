    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$27^{\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}27^{\\frac{2}{3}}&=(\\sqrt[3]{27})^2\\\\&=3^2\\\\&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$64^{\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$\\begin{align*}64^{\\frac{2}{3}}&=(\\sqrt[3]{64})^2\\\\&=4^2\\\\&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$9^{\\frac{3}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "$$\\begin{align*}9^{\\frac{3}{2}}&=(\\sqrt{9})^3\\\\&=3^3\\\\&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$16^{\\frac{5}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32$",
          "worked": "$$\\begin{align*}16^{\\frac{5}{4}}&=(\\sqrt[4]{16})^5\\\\&=2^5\\\\&=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$4^{\\frac{5}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32$",
          "worked": "$$\\begin{align*}4^{\\frac{5}{2}}&=(\\sqrt{4})^5\\\\&=2^5\\\\&=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$81^{\\frac{3}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$729$",
          "worked": "$$\\begin{align*}81^{\\frac{3}{2}}&=(\\sqrt{81})^3\\\\&=9^3\\\\&=729\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(\\frac{1}{9}\\right)^{\\frac{3}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{27}$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{9}\\right)^{\\frac{3}{2}}&=\\left(\\sqrt{\\frac{1}{9}}\\right)^3\\\\&=\\left(\\frac{1}{3}\\right)^3\\\\&=\\frac{1}{27}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\frac{4}{25}\\right)^{\\frac{5}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{32}{3125}$",
          "worked": "$$\\begin{align*}\\left(\\frac{4}{25}\\right)^{\\frac{5}{2}}&=\\left(\\sqrt{\\frac{4}{25}}\\right)^5\\\\&=\\left(\\frac{2}{5}\\right)^5\\\\&=\\frac{32}{3125}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(\\frac{27}{1000}\\right)^{\\frac{4}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{81}{10000}$",
          "worked": "$$\\begin{align*}\\left(\\frac{27}{1000}\\right)^{\\frac{4}{3}}&=\\left(\\sqrt[3]{\\frac{27}{1000}}\\right)^4\\\\&=\\left(\\frac{3}{10}\\right)^4\\\\&=\\frac{81}{10000}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
