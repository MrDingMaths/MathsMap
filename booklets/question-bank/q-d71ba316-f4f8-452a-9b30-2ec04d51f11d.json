  "content": {
    "id": "p110-q44-root",
    "type": "question",
    "label": null,
    "prompt": "Find the positive integers $x$ and $y$, with $\\frac{x}{y}$ in simplest form, if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p110-q44-a",
        "type": "part",
        "label": "a",
        "prompt": "$$2+\\frac{1}{\\dfrac{x}{y}}=\\frac{25}{11}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=11,\\ y=3$.",
          "worked": "$$\\begin{align*}\\frac{25}{11}&=2\\frac{3}{11}\\\\\\frac{25}{11}&=2+\\frac{1}{\\dfrac{11}{3}}\\\\\\frac{25}{11}&=2+\\frac{1}{\\dfrac{x}{y}}\\end{align*}$$\nHence $x=11$ and $y=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p110-q44-b",
        "type": "part",
        "label": "b",
        "prompt": "$$2+\\frac{1}{3+\\dfrac{x}{y}}=\\frac{25}{11}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=3$.",
          "worked": "$$\\begin{align*}\\frac{25}{11}&=2+\\frac{1}{\\dfrac{11}{3}}\\\\\\frac{25}{11}&=2+\\frac{1}{3+\\dfrac{2}{3}}\\\\\\frac{25}{11}&=2+\\frac{1}{3+\\dfrac{x}{y}}\\end{align*}$$\nHence $x=2$ and $y=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p110-q44-c",
        "type": "part",
        "label": "c",
        "prompt": "$$2+\\frac{1}{3+\\frac{1}{\\dfrac{x}{y}}}=\\frac{25}{11}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=2$.",
          "worked": "$$\\begin{align*}\\dfrac{25}{11}&=2+\\dfrac{1}{3+\\dfrac{2}{3}}\\\\\\dfrac{25}{11}&=2+\\dfrac{1}{3+\\dfrac{1}{\\dfrac{3}{2}}}\\\\\\dfrac{25}{11}&=2+\\dfrac{1}{3+\\dfrac{1}{\\dfrac{x}{y}}}\\end{align*}$$\nHence $x=3$ and $y=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p110-q44-d",
        "type": "part",
        "label": "d",
        "prompt": "$$2+\\frac{1}{3+\\frac{1}{1+\\dfrac{x}{y}}}=\\frac{25}{11}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=2$.",
          "worked": "$$\\begin{align*}\\dfrac{25}{11}&=2+\\dfrac{1}{3+\\dfrac{1}{\\dfrac{3}{2}}}\\\\\\dfrac{25}{11}&=2+\\dfrac{1}{3+\\dfrac{1}{1+\\dfrac{1}{2}}}\\\\\\dfrac{25}{11}&=2+\\dfrac{1}{3+\\dfrac{1}{1+\\dfrac{x}{y}}}\\end{align*}$$\n$\\therefore x=1,\\ y=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
