        "label": "a",
        "prompt": "$\\dfrac{x+3}{2}\\times\\dfrac{4}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\frac{x+3}{2}\\times\\frac{4}{x+3}&=\\frac{4(x+3)}{2(x+3)}\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x+3}{2}\\div\\dfrac{x+3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\frac{x+3}{2}\\div\\frac{x+3}{4}&=\\frac{x+3}{2}\\times\\frac{4}{x+3}\\\\&=\\frac{4}{2}\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x+3}{2}\\times\\dfrac{2}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\frac{x+3}{2}\\times\\frac{2}{x+3}&=\\frac{2(x+3)}{2(x+3)}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x+3}{4}\\div\\dfrac{x+3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{aligned}\\frac{x+3}{4}\\div\\frac{x+3}{2}&=\\frac{x+3}{4}\\times\\frac{2}{x+3}\\\\&=\\frac{2}{4}\\\\&=\\frac{1}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x+3}{4}\\times\\dfrac{4}{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{x+5}$",
          "worked": "$$\\begin{aligned}\\frac{x+3}{4}\\times\\frac{4}{x+5}&=\\frac{4(x+3)}{4(x+5)}\\\\&=\\frac{x+3}{x+5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x+3}{4}\\div\\dfrac{x+5}{4}$",
        "layout": "list",
