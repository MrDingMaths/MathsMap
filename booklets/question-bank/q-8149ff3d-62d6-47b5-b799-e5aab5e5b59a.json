  "content": {
    "id": "p4-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Without using a calculator, prove that $\\dfrac{1}{\\sec30^\\circ-\\tan30^\\circ}=\\sqrt3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{\\sec30^\\circ-\\tan30^\\circ}=\\dfrac{1}{\\frac{1}{\\sqrt3}}=\\sqrt3$.",
      "worked": "$$\\begin{align*}\\frac{1}{\\sec30^\\circ-\\tan30^\\circ}&=\\frac{1}{\\frac{1}{\\cos30^\\circ}-\\tan30^\\circ}\\\\&=\\frac{1}{\\frac{2}{\\sqrt3}-\\frac{1}{\\sqrt3}}\\\\&=\\frac{1}{\\frac{1}{\\sqrt3}}\\\\&=\\sqrt3.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
