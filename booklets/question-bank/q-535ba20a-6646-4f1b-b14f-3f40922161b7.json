  "content": {
    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "For an acute angle $x$, what is the relationship between $\\tan x$ and $\\tan(90^{\\circ}-x)$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "They are reciprocals of each other.",
      "worked": "The opposite and adjacent sides exchange roles for complementary angles, so their tangent ratios are reciprocals:\n$$\\tan(90^{\\circ}-x)=\\frac{1}{\\tan x}.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 10
