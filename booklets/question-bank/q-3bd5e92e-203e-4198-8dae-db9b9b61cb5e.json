  "content": {
    "id": "p12-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A parabola has a turning point at $(1,3)$ and an $x$-intercept at $(-2,0)$. Find the location of the second $x$-intercept.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(4,0)$",
      "worked": "The axis of symmetry is $x=1$, halfway between the two $x$-intercepts. Let the second intercept be $(q,0)$.\n$$\\begin{align*}\\frac{-2+q}{2}&=1\\\\-2+q&=2\\\\q&=4\\end{align*}$$\nThe second $x$-intercept is $(4,0)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
