      {
        "id": "p62-q2",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin75^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt6+\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\sin75^\\circ&=\\sin(45^\\circ+30^\\circ)\\\\\\sin75^\\circ&=\\sin45^\\circ\\cos30^\\circ+\\cos45^\\circ\\sin30^\\circ\\\\\\sin75^\\circ&=\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}+\\frac{\\sqrt2}{2}\\cdot\\frac12\\\\\\sin75^\\circ&=\\frac{\\sqrt6+\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p62-q3",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos105^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{\\sqrt6-\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\cos105^\\circ&=\\cos(60^\\circ+45^\\circ)\\\\\\cos105^\\circ&=\\cos60^\\circ\\cos45^\\circ-\\sin60^\\circ\\sin45^\\circ\\\\\\cos105^\\circ&=\\frac12\\cdot\\frac{\\sqrt2}{2}-\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}\\\\\\cos105^\\circ&=-\\frac{\\sqrt6-\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p62-q4",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan345^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3-2$",
          "worked": "$$\\begin{align*}\\tan345^\\circ&=\\tan(-15^\\circ)\\\\\\tan345^\\circ&=\\tan(30^\\circ-45^\\circ)\\\\\\tan345^\\circ&=\\frac{\\frac1{\\sqrt3}-1}{1+\\frac1{\\sqrt3}}\\\\\\tan345^\\circ&=\\frac{1-\\sqrt3}{\\sqrt3+1}\\\\\\tan345^\\circ&=\\frac{(1-\\sqrt3)(\\sqrt3-1)}{2}\\\\\\tan345^\\circ&=\\sqrt3-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
