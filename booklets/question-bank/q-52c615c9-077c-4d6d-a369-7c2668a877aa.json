        "label": "a",
        "prompt": "$2\\log_9(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}2\\log_9(3)&=\\log_9(3^2)\\\\2\\log_9(3)&=\\log_9(9)\\\\2\\log_9(3)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q19",
        "type": "part",
        "label": "b",
        "prompt": "$3\\log_8(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}3\\log_8(4)&=\\log_8(4^3)\\\\3\\log_8(4)&=\\log_8(64)\\\\3\\log_8(4)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q20",
        "type": "part",
        "label": "c",
        "prompt": "$-2\\log_4(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}-2\\log_4(2)&=\\log_4(2^{-2})\\\\-2\\log_4(2)&=\\log_4\\left(\\frac14\\right)\\\\-2\\log_4(2)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q21",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\log_3(8)}{\\log_3(2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{\\log_3(8)}{\\log_3(2)}&=\\frac{\\log_3(2^3)}{\\log_3(2)}\\\\\\frac{\\log_3(8)}{\\log_3(2)}&=\\frac{3\\log_3(2)}{\\log_3(2)}\\\\\\frac{\\log_3(8)}{\\log_3(2)}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q22",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\log_2(25)}{\\log_2(125)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac23$",
          "worked": "$$\\begin{align*}\\frac{\\log_2(25)}{\\log_2(125)}&=\\frac{\\log_2(5^2)}{\\log_2(5^3)}\\\\\\frac{\\log_2(25)}{\\log_2(125)}&=\\frac{2\\log_2(5)}{3\\log_2(5)}\\\\\\frac{\\log_2(25)}{\\log_2(125)}&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q23",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\log_5(4)}{\\log_{25}(16)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$\n\nChange the denominator to base 5, then use the power law.",
          "worked": "$$\\begin{align*}\\frac{\\log_5(4)}{\\log_{25}(16)}&=\\frac{\\log_5(4)}{\\dfrac{\\log_5(16)}{\\log_5(25)}}\\\\\\frac{\\log_5(4)}{\\log_{25}(16)}&=\\frac{2\\log_5(2)}{\\dfrac{4\\log_5(2)}{2}}\\\\\\frac{\\log_5(4)}{\\log_{25}(16)}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
