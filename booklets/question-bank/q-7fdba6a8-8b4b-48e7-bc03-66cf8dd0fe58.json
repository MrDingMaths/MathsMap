    "type": "question",
    "label": "9",
    "prompt": "Madeline has received $\\$168\\,000$ in total simple interest payments on an investment of $\\$400\\,000$ that she made six years ago. What rate of interest has the bank been paying?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7\\%$ p.a.",
      "worked": "$$\\begin{aligned}I&=PRT\\\\168\\,000&=400\\,000\\times R\\times6\\\\168\\,000&=2\\,400\\,000R\\\\R&=\\frac{168\\,000}{2\\,400\\,000}\\\\R&=0.07\\\\R&=7\\%\\end{aligned}$$\nThe bank has been paying $7\\%$ p.a.",
      "solutionDiagrams": []
    },
