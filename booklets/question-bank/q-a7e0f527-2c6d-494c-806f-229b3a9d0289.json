  "content": {
    "id": "p12-ch18-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Given that $q \\propto p^3$, what is the effect on $q$ when $p$ is doubled?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$q$ is multiplied by $8$.",
      "worked": "Write $q=kp^3$, where $k$ is the constant of proportionality. When $p$ is doubled:\n\n$$\\begin{align*}q_{\\text{new}}&=k(2p)^3\\\\q_{\\text{new}}&=8kp^3\\\\q_{\\text{new}}&=8q.\\end{align*}$$\n\nThus, $q$ is multiplied by $8$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
