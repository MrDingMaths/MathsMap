    "children": [
      {
        "id": "p22-q41-44-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin x\\cos\\frac\\pi6+\\cos x\\sin\\frac\\pi6=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\frac{2\\pi}3,2\\pi$",
          "worked": "$$\\sin\\left(x+\\frac\\pi6\\right)=\\frac12.$$\nSince $0\\le x\\le2\\pi$,\n$$\\frac\\pi6\\le x+\\frac\\pi6\\le\\frac{13\\pi}6.$$\nHence\n$$\\begin{align*}x+\\frac\\pi6&=\\frac\\pi6,\\frac{5\\pi}6,\\frac{13\\pi}6\\\\x&=0,\\frac{2\\pi}3,2\\pi.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p22-q41-44-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos x\\cos\\frac\\pi4+\\sin x\\sin\\frac\\pi4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3\\pi}4,\\frac{7\\pi}4$",
          "worked": "$$\\cos\\left(x-\\frac\\pi4\\right)=0.$$\nSince $0\\le x\\le2\\pi$,\n$$-\\frac\\pi4\\le x-\\frac\\pi4\\le\\frac{7\\pi}4.$$\nHence\n$$\\begin{align*}x-\\frac\\pi4&=\\frac\\pi2,\\frac{3\\pi}2\\\\x&=\\frac{3\\pi}4,\\frac{7\\pi}4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p22-q41-44-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin2x\\cos x+\\cos2x\\sin x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac\\pi6,\\frac{5\\pi}6,\\frac{3\\pi}2$",
          "worked": "$$\\sin(2x+x)=1,\\qquad \\sin3x=1.$$\nSince $0\\le x\\le2\\pi$, $0\\le3x\\le6\\pi$. Thus\n$$\\begin{align*}3x&=\\frac\\pi2,\\frac{5\\pi}2,\\frac{9\\pi}2\\\\x&=\\frac\\pi6,\\frac{5\\pi}6,\\frac{3\\pi}2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p22-q41-44-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1+\\tan x}{1-\\tan x}=\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac\\pi{12},\\frac{13\\pi}{12}$",
          "worked": "$$\\tan\\left(x+\\frac\\pi4\\right)=\\sqrt3=\\tan\\frac\\pi3.$$\nUsing tangent's period,\n$$\\begin{align*}x+\\frac\\pi4&=\\frac\\pi3+k\\pi,\\quad k\\in\\mathbb Z\\\\x&=\\frac\\pi{12}+k\\pi.\\end{align*}$$\nFor $0\\le x\\le2\\pi$,\n$$x=\\frac\\pi{12},\\frac{13\\pi}{12}.$$\nFor both candidates, $\\tan x=2-\\sqrt3$, so the original expression is defined and\n$$\\frac{1+\\tan x}{1-\\tan x}=\\frac{3-\\sqrt3}{\\sqrt3-1}=\\sqrt3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      }
    ]
  },
