  "content": {
    "id": "p45-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The letters of the alphabet are written on 26 separate cards and shuffled. Two players are dealt four cards each. How many ways can the cards be dealt?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\binom{26}{4}\\binom{22}{4}=109\\,359\\,250$",
      "worked": "The first player's hand can be chosen in $\\binom{26}{4}$ ways. The second player's hand can be chosen from the remaining 22 cards in $\\binom{22}{4}$ ways. Order within each hand does not matter.\n\n$$\\begin{align*}N&=\\binom{26}{4}\\binom{22}{4}\\\\N&=14\\,950\\times7315\\\\N&=109\\,359\\,250\\end{align*}$$",
      "solutionDiagrams": []
