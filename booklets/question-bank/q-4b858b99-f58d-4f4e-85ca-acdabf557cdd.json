  "content": {
    "id": "p34-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A parallelepiped is a six-faced polyhedron, each face of which is a parallelogram. A certain parallelepiped with a square base has volume $192\\text{ cm}^3$. Each side of its base is one-third of its height. Find the length of each side of the base.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\text{ cm}$",
      "worked": "Let the base side be $s$ cm. The perpendicular height is $3s$ cm.\n$$\\begin{align*}V&=s^2(3s)\\\\192&=3s^3\\\\s^3&=64\\\\s&=4\\end{align*}$$\nEach side of the base is $4\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
