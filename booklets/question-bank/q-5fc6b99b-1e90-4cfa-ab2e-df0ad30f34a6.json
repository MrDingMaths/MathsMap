    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{4}$",
      "worked": "Let $H$ be studying history and $C$ be studying chemistry.\n$$\\begin{align*}P(C\\mid H)&=\\frac{|H\\cap C|}{|H|}\\\\P(C\\mid H)&=\\frac{5}{20}\\\\P(C\\mid H)&=\\frac{1}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
