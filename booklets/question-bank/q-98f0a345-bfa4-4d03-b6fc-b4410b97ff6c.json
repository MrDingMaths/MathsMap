  "content": {
    "id": "p8-circles-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the area of the annulus formed by two concentric circles, one of diameter $9\\text{ m}$ and the other of diameter $5\\text{ m}$. Leave your answer in terms of $\\pi$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$14\\pi\\text{ m}^2$",
      "worked": "The radii are $\\frac{9}{2}\\text{ m}$ and $\\frac{5}{2}\\text{ m}$. Subtract the inner circle's area from the outer:\n$$A=\\pi\\left((9/2)^2-(5/2)^2\\right)=\\pi(81-25)/4=14\\pi\\text{ m}^2.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 17
