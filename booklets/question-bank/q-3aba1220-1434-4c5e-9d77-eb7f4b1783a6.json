  "content": {
    "id": "v2-bab18-p10-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "The area $A$ of an algal bloom on a reservoir, in square metres, is modelled by $A=40e^{0.05t}$, where $t$ is the time in days.\n\nFind the rate at which the area is increasing after 12 days, to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3.64\\text{ m}^2$ per day.",
      "worked": "$$\\begin{align*}A'(12)&=0.05A(12)\\\\&=0.05\\times40e^{0.05\\times12}\\\\&=2e^{0.6}\\\\&\\approx3.64\\text{ m}^2\\text{ per day}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
