    "type": "question",
    "label": "19",
    "prompt": "Use $\\pi\\approx3.14$ to find the approximate value of the area of a sector with the following dimensions. Give answers to 2 decimal places where rounding is needed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
