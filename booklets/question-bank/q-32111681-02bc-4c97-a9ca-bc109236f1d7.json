      {
        "id": "p11-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Radius $10\\text{ m}$, containing an angle of $30^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26.17\\text{ m}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{30}{360}\\pi\\times10^2\\\\A&\\approx\\frac1{12}\\times3.14\\times100\\\\A&\\approx\\frac{157}{6}\\text{ m}^2\\\\A&\\approx26.17\\text{ m}^2\\quad\\text{(2 d.p.)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Radius $9\\text{ cm}$, containing an angle of $10^\\circ$.",
