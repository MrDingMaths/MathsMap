  "content": {
    "id": "p8-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "First simplify each expression, writing its exponential term in the form $e^{kx}$. Then differentiate.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(e^x)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3e^{3x}$",
          "worked": "$$\\begin{align*}y&=e^{3x}\\\\y'&=e^{3x}\\cdot 3\\\\y'&=3e^{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac{1}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-e^{-x}$",
          "worked": "$$\\begin{align*}y&=e^{-x}\\\\y'&=e^{-x}\\cdot(-1)\\\\y'&=-e^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\sqrt{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac12e^{\\frac{x}{2}}$",
          "worked": "$$\\begin{align*}y&=(e^x)^{\\frac12}\\\\y&=e^{\\frac{x}{2}}\\\\y'&=e^{\\frac{x}{2}}\\cdot\\frac12\\\\y'&=\\frac12e^{\\frac{x}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=e^x\\sqrt{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac32e^{\\frac{3x}{2}}$",
          "worked": "$$\\begin{align*}y&=e^x e^{\\frac{x}{2}}\\\\y&=e^{\\frac{3x}{2}}\\\\y'&=e^{\\frac{3x}{2}}\\cdot\\frac32\\\\y'&=\\frac32e^{\\frac{3x}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{1}{\\sqrt{e^x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac12e^{-\\frac{x}{2}}$",
          "worked": "$$\\begin{align*}y&=\\frac{1}{e^{\\frac{x}{2}}}\\\\y&=e^{-\\frac{x}{2}}\\\\y'&=e^{-\\frac{x}{2}}\\cdot\\left(-\\frac12\\right)\\\\y'&=-\\frac12e^{-\\frac{x}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{e^x+1}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-e^{-x}$\n\nSplit the fraction to obtain $y=1+e^{-x}$, then differentiate.",
          "worked": "$$\\begin{align*}y&=\\frac{e^x}{e^x}+\\frac{1}{e^x}\\\\y&=1+e^{-x}\\\\y'&=0+e^{-x}\\cdot(-1)\\\\y'&=-e^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
