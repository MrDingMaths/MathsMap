  "content": {
    "id": "p18-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Find the formula connecting $x$ and $y$ for each of these statements making $y$ the subject.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$y$ is four more than twice the square of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x^2+4$",
          "worked": "Twice the square of $x$ is $2x^2$. Four more gives $y=2x^2+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p18-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$x$ and $y$ are complementary angles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=90-x$",
          "worked": "Complementary angles add to $90^{\\circ}$. With $x$ and $y$ measured in degrees,$$\\begin{align*}x+y&=90\\\\y&=90-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "A car travelled $x$ km in $y$ hours at a speed of $100$ km/h.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{x}{100}$",
          "worked": "Distance equals speed multiplied by time.$$\\begin{align*}x&=100y\\\\y&=\\frac{x}{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "A car travelled $100$ km in $y$ hours at a speed of $x$ km/h.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{100}{x}$",
          "worked": "Distance equals speed multiplied by time.$$\\begin{align*}100&=xy\\\\y&=\\frac{100}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
