        "label": "a",
        "prompt": "Explain why this is incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It has only 1 significant figure and equals 800 000, rather than 80 000.",
          "worked": "$8\\times10^{5}=800\\,000$, which is ten times the stated number. The coefficient $8$ also has only 1 significant figure, rather than the required 2.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "What should she have written?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.0\\times10^{4}$",
          "worked": "$$\\begin{align*}80\\,000&=8\\times10^{4}\\\\&=8.0\\times10^{4}\\quad\\text{(2 s.f.)}\\end{align*}$$\nThe trailing zero in $8.0$ shows the second significant figure.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
