  "content": {
    "id": "p17-q23",
    "type": "question",
    "label": "23",
    "prompt": "Find $f(k)-f(k-1)$ in simplest form for:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x^2+2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6k-1$",
          "worked": "$$\\begin{aligned}f(k)&=3k^2+2k\\\\f(k-1)&=3(k-1)^2+2(k-1)\\\\&=3k^2-4k+1\\\\f(k)-f(k-1)&=3k^2+2k-(3k^2-4k+1)\\\\&=6k-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p17-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{k(1-k)}$, where $k\\ne0,1$.",
          "worked": "$$\\begin{aligned}f(k)-f(k-1)&=\\frac1k-\\frac1{k-1}\\\\&=\\frac{k-1-k}{k(k-1)}\\\\&=-\\frac1{k(k-1)}\\\\&=\\frac1{k(1-k)}\\end{aligned}$$\nDefined for $k\\ne0,1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p17-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=2^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{k-1}$",
          "worked": "$$\\begin{aligned}f(k)-f(k-1)&=2^k-2^{k-1}\\\\&=2\\cdot2^{k-1}-2^{k-1}\\\\&=2^{k-1}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
