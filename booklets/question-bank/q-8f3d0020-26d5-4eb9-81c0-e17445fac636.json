  "content": {
    "id": "p10-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The letters of the alphabet are written on flashcards and put into a bag. A card is drawn out at random. Find the probability that the letter is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "D",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{26}$",
          "worked": "There are 26 equally likely letter cards and only one is D.\n\n$$P(\\text{D})=\\frac{1}{26}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "not W, X, Y or Z",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{13}$",
          "worked": "Excluding W, X, Y and Z leaves $26-4=22$ favourable letter cards.\n\n$$\\begin{align*}P(\\text{not W, X, Y or Z})&=\\frac{22}{26}\\\\P(\\text{not W, X, Y or Z})&=\\frac{11}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "a vowel",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{26}$",
          "worked": "The five favourable letters are A, E, I, O and U.\n\n$$P(\\text{vowel})=\\frac{5}{26}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "in the word ‘PERTH’",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{26}$",
          "worked": "The favourable letters are P, E, R, T and H: five distinct alphabet cards.\n\n$$P(\\text{letter in PERTH})=\\frac{5}{26}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "in the word ‘CANBERRA’",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{13}$",
          "worked": "The distinct letters are C, A, N, B, E and R. Repeated letters in the word do not create extra alphabet cards, so there are six favourable outcomes.\n\n$$\\begin{align*}P(\\text{letter in CANBERRA})&=\\frac{6}{26}\\\\P(\\text{letter in CANBERRA})&=\\frac{3}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
