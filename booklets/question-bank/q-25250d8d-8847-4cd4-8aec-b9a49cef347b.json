  "content": {
    "id": "p10-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "How many ways can you arrange five biology books, four chemistry books and three physics books on a shelf given that the books on the same topic are grouped together? Write your answer in the form $2^a3^b5^c$ for positive integers $a$, $b$ and $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2^8\\times3^4\\times5$",
      "worked": "Treat each topic as one group. Arrange the three groups in $3!$ ways, then arrange the distinct books within each group.\n\n$$\\begin{align*}N&=3!\\times5!\\times4!\\times3!\\\\N&=(2\\times3)(2^3\\times3\\times5)(2^3\\times3)(2\\times3)\\\\N&=2^8\\times3^4\\times5\\end{align*}$$\n\nThus $a=8$, $b=4$ and $c=1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
