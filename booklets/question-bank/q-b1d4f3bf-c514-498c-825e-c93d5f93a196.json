  "content": {
    "id": "p13-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Use the fact that the derivative of $\\frac{1}{x}$ is $-\\frac{1}{x^2}$ to differentiate:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q8a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\frac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\frac{3}{x^2}$",
          "worked": "$\\begin{aligned}f(x)&=3\\left(\\frac{1}{x}\\right)\\\\f'(x)&=3\\left(-\\frac{1}{x^2}\\right)\\\\&=-\\frac{3}{x^2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p13-q8b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\frac{1}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\frac{1}{3x^2}$",
          "worked": "$\\begin{aligned}f(x)&=\\frac{1}{3}\\left(\\frac{1}{x}\\right)\\\\f'(x)&=\\frac{1}{3}\\left(-\\frac{1}{x^2}\\right)\\\\&=-\\frac{1}{3x^2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p13-q8c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=-\\frac{7}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=\\frac{7}{3x^2}$",
          "worked": "$\\begin{aligned}f(x)&=-\\frac{7}{3}\\left(\\frac{1}{x}\\right)\\\\f'(x)&=-\\frac{7}{3}\\left(-\\frac{1}{x^2}\\right)=\\frac{7}{3x^2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p13-q8d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\frac{a}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\frac{a}{x^2}$",
          "worked": "Treat $a$ as a constant.\n\n$\\begin{aligned}f(x)&=a\\left(\\frac{1}{x}\\right)\\\\f'(x)&=a\\left(-\\frac{1}{x^2}\\right)\\\\&=-\\frac{a}{x^2}\\end{aligned}$",
