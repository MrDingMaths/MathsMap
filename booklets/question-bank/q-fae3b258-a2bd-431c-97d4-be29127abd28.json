    "children": [
      {
        "id": "v2-ac439-p13-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\cos 41^{\\circ}}{\\sin 49^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin 49^{\\circ}&=\\cos(90^{\\circ}-49^{\\circ})\\\\&=\\cos 41^{\\circ}\\\\\\frac{\\cos 41^{\\circ}}{\\sin 49^{\\circ}}&=\\frac{\\cos 41^{\\circ}}{\\cos 41^{\\circ}}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-ac439-p13-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin 35^{\\circ}-\\cos 55^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\cos 55^{\\circ}&=\\sin(90^{\\circ}-55^{\\circ})\\\\&=\\sin 35^{\\circ}\\\\\\sin 35^{\\circ}-\\cos 55^{\\circ}&=\\sin 35^{\\circ}-\\sin 35^{\\circ}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-ac439-p13-practice-slot-2-slot-2-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan 28^{\\circ}\\times\\tan 62^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\tan 62^{\\circ}&=\\tan(90^{\\circ}-28^{\\circ})\\\\&=\\frac{1}{\\tan 28^{\\circ}}\\\\\\tan 28^{\\circ}\\times\\tan 62^{\\circ}&=\\tan 28^{\\circ}\\times\\frac{1}{\\tan 28^{\\circ}}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-ac439-p13-practice-slot-2-slot-2-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sin 18^{\\circ}}{\\cos 72^{\\circ}}+\\cos 33^{\\circ}-\\sin 57^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\cos 72^{\\circ}&=\\sin 18^{\\circ}\\\\\\sin 57^{\\circ}&=\\cos 33^{\\circ}\\\\\\frac{\\sin 18^{\\circ}}{\\cos 72^{\\circ}}+\\cos 33^{\\circ}-\\sin 57^{\\circ}&=1+\\cos 33^{\\circ}-\\cos 33^{\\circ}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
