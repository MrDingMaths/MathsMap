  "content": {
    "id": "p15-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider the function $f(x)=\\frac{x^2}{x-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(x)=x+1+\\frac{1}{x-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Use $x^2=(x-1)(x+1)+1$, then divide by $x-1$.",
          "worked": "$$\\begin{align*}f(x)&=\\frac{(x-1)(x+1)+1}{x-1}\\\\f(x)&=\\frac{(x-1)(x+1)}{x-1}+\\frac{1}{x-1}\\\\f(x)&=x+1+\\frac{1}{x-1},\\qquad x\\ne 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p15-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, differentiate $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=1-\\frac{1}{(x-1)^2}$.",
          "worked": "$$f(x)=x+1+(x-1)^{-1}$$\n\n$$\\begin{align*}f'(x)&=1+0-(x-1)^{-2}\\cdot 1\\\\f'(x)&=1-\\frac{1}{(x-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
