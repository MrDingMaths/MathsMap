    "questionDiagrams": [],
    "children": [
      {
        "id": "routine-bivar-r248-calculator-analysis-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the regression line predicting quiz score $Q$ from study time $T$. Give the coefficients to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q = 9.91 + 2.12T$.",
          "worked": "Enter study times as $x$ and quiz scores as $y$ in the calculator's two-variable statistics mode. Select linear regression $y=a+bx$.\n$$\\begin{align*}a&=9.913043\\ldots\\\\b&=2.119565\\ldots\\\\Q&\\approx9.91+2.12T\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "routine-bivar-r248-calculator-analysis-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Using the rounded equation from part a, predict the quiz score of a student who studies for 10 hours. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An estimated quiz score of $31.1$.",
          "worked": "$$\\begin{align*}Q&=9.91+2.12(10)\\\\Q&=31.11\\\\Q&\\approx31.1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "routine-bivar-r248-calculator-analysis-1-c",
        "type": "part",
        "label": "c",
        "prompt": "Using the rounded equation from part a, predict the study time of a student who scores 40 on the quiz. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An estimated study time of $14.2$ hours.",
          "worked": "$$\\begin{align*}40&=9.91+2.12T\\\\2.12T&=30.09\\\\T&=\\frac{30.09}{2.12}\\\\T&\\approx14.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "routine-bivar-r248-calculator-analysis-1-d",
        "type": "part",
        "label": "d",
        "prompt": "Is part b or c an example of extrapolation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Part c: a quiz score of $40$ is outside the observed range $14$–$36$.",
          "worked": "Part b uses a study time of $10$ hours, within the observed range $2$–$12$, so it is interpolation. Part c uses a quiz score of $40$, above the observed range $14$–$36$, so it is extrapolation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
