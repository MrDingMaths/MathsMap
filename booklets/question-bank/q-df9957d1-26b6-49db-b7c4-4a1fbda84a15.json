      {
        "id": "p8-q6-explanation",
        "type": "part",
        "label": "a",
        "prompt": "Jasmine thinks that $2.7\\%$ is the same as $0.27$. Explain why she is wrong.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.7\\%=0.027$. Divide by $100$, not $10$.",
          "worked": "$$\\begin{align*}2.7\\% &= 2.7\\div100\\\\2.7\\% &= 0.027\\end{align*}$$\nJasmine divided by $10$ instead of $100$. The decimal $0.27$ represents $27\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q6-calculations",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q6-a",
            "type": "part",
            "label": "b",
            "prompt": "Find $2.7\\%$ of $300$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8.1$",
              "worked": "$$\\begin{align*}2.7\\%\\text{ of }300 &= 2.7\\%\\times300\\\\2.7\\%\\text{ of }300 &= 0.027\\times300\\\\2.7\\%\\text{ of }300 &= 8.1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q6-b",
