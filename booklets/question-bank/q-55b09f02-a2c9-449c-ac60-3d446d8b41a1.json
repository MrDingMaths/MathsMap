  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Consider the formula $d = \\dfrac{1}{2}ct$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $c$ when $d = 100$, $t = 8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c = 25$",
          "worked": "$$\\begin{align*}d &= \\frac{1}{2}ct\\\\100 &= \\frac{1}{2}c(8)\\\\100 &= 4c\\\\25 &= c\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $t$ when $d = 320$, $c = 18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t = \\dfrac{320}{9}$",
          "worked": "$$\\begin{align*}d &= \\frac{1}{2}ct\\\\320 &= \\frac{1}{2}(18)t\\\\320 &= 9t\\\\\\frac{320}{9} &= t\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
