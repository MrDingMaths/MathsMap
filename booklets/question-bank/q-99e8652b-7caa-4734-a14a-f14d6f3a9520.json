  "content": {
    "id": "p32-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Explain why you cannot divide by 4 to find weekly income from monthly income.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "A month is not exactly 4 weeks.",
      "worked": "There are 12 months and approximately 52 weeks in a year. Taking each month as 4 weeks would give only $12\\times4=48$ weeks. Using the booklet's convention, weekly income is monthly income multiplied by $12$ and divided by $52$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 16
