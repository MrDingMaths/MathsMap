    "label": "7",
    "prompt": "Evaluate $\\frac{2}{3}\\times\\left(\\frac{3}{4}-\\frac{1}{2}\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{6}$",
      "worked": "$$\\begin{align*}\\frac{2}{3}\\times\\left(\\frac{3}{4}-\\frac{1}{2}\\right)&=\\frac{2}{3}\\times\\left(\\frac{3}{4}-\\frac{2}{4}\\right)\\\\\\frac{2}{3}\\times\\left(\\frac{3}{4}-\\frac{1}{2}\\right)&=\\frac{2}{3}\\times\\frac{1}{4}\\\\\\frac{2}{3}\\times\\left(\\frac{3}{4}-\\frac{1}{2}\\right)&=\\frac{2}{12}\\\\\\frac{2}{3}\\times\\left(\\frac{3}{4}-\\frac{1}{2}\\right)&=\\frac{1}{6}\\end{align*}$$",
      "solutionDiagrams": []
    },
