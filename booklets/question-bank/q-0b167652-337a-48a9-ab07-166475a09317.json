  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p6-q3-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A television costs $500. Its price is ",
              "marks": []
            },
            {
              "type": "text",
              "text": "decreased",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": " by 10%.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What is its new price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$450",
          "worked": "The multiplier for a 10% decrease is $0.9$.\n$$\\begin{align*}\\text{New price}&=\\$500\\times0.9\\\\&=\\$450\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "After a year its price is decreased by another 10%. What is its price now?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$405",
          "worked": "$$\\begin{align*}\\text{Price after both decreases}&=\\$500\\times0.9\\times0.9\\\\&=\\$500\\times0.81\\\\&=\\$405\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find 80% of 500",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$400",
          "worked": "$$\\begin{align*}80\\%\\text{ of }\\$500&=0.8\\times\\$500\\\\&=\\$400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Is decreasing by 10% then 10% again the same as decreasing by 20%?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. Two 10% decreases give a 19% decrease.",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=0.9\\times0.9\\\\&=0.81\\end{align*}$$\nThe final price is 81% of the original, so the overall decrease is 19%. No: two 10% decreases give \\$405, whereas a single 20% decrease gives \\$400.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
