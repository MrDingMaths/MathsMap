    "label": "3",
    "prompt": "Evaluate $(-2)^n$ for $n=1,2,3,4,5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-2,4,-8,16,-32$, respectively.",
      "worked": "$\\begin{align*}(-2)^1&=-2\\\\(-2)^2&=(-2)\\times(-2)=4\\\\(-2)^3&=(-2)\\times(-2)\\times(-2)=-8\\\\(-2)^4&=(-2)\\times(-2)\\times(-2)\\times(-2)=16\\\\(-2)^5&=(-2)\\times(-2)\\times(-2)\\times(-2)\\times(-2)=-32\\end{align*}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
