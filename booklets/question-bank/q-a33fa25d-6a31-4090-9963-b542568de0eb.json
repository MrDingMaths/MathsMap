  "content": {
    "id": "p56-question-6-root",
    "type": "question",
    "label": "6",
    "prompt": "The price $P$ dollars of an item is rising with inflation according to the formula $P=150e^{0.04t}$, where $t$ is the time in years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-question-6-a",
        "type": "part",
        "label": "a",
        "prompt": "When will the price be $\\$300$? Give an exact answer and an approximation to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=25\\ln 2\\approx17.33$ years.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "f3a7e55a-1a5d-4ab0-80b8-6ff3e6dac6fb",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}150e^{0.04t}&=300\\\\e^{0.04t}&=2\\\\0.04t&=\\ln 2\\\\t&=\\frac{\\ln 2}{0.04}=25\\ln 2\\\\t&\\approx17.33\\text{ years}.\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p56-question-6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the rate $\\dfrac{dP}{dt}$ at which the price is rising.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dP}{dt}=6e^{0.04t}$ dollars per year.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "a44a182e-69d5-4118-b589-95bda5757397",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\frac{dP}{dt}&=150(0.04)e^{0.04t}\\\\\\frac{dP}{dt}&=6e^{0.04t}\\text{ dollars per year}.\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p56-question-6-c",
        "type": "part",
        "label": "c",
        "prompt": "When will the price be rising at $\\$300$ per year? Give an exact answer and an approximation to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=25\\ln 50\\approx97.80$ years.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "b776a7e7-4137-43a3-8a0b-dc701fe6dc50",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\frac{dP}{dt}&=300\\\\6e^{0.04t}&=300\\\\e^{0.04t}&=50\\\\0.04t&=\\ln 50\\\\t&=\\frac{\\ln 50}{0.04}=25\\ln 50\\\\t&\\approx97.80\\text{ years}.\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
