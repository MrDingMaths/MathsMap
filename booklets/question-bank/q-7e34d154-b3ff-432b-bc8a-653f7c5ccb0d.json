      {
        "id": "p14-index-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{m^5n^4}{m^2n}\\times\\dfrac{m^6n^7}{m^4n^8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^5n^2$",
          "worked": "$$\\begin{align*}\\frac{m^5n^4}{m^2n}\\times\\frac{m^6n^7}{m^4n^8}&=\\frac{m^{11}n^{11}}{m^6n^9}\\\\\\frac{m^5n^4}{m^2n}\\times\\frac{m^6n^7}{m^4n^8}&=m^{11-6}n^{11-9}\\\\\\frac{m^5n^4}{m^2n}\\times\\frac{m^6n^7}{m^4n^8}&=m^5n^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-index-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{p^4q^5}{pq^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^3q^3$",
          "worked": "$$\\begin{align*}\\frac{p^4q^5}{pq^2}&=p^{4-1}q^{5-2}\\\\\\frac{p^4q^5}{pq^2}&=p^3q^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-index-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3m^2n)^3\\times2m^4n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$54m^{10}n^4$",
          "worked": "$$\\begin{align*}(3m^2n)^3\\times2m^4n&=27m^6n^3\\times2m^4n\\\\(3m^2n)^3\\times2m^4n&=54m^{6+4}n^{3+1}\\\\(3m^2n)^3\\times2m^4n&=54m^{10}n^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p14-index-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{(2m^4n)^3}{4m^5n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2m^7n^2$",
          "worked": "$$\\begin{align*}\\frac{(2m^4n)^3}{4m^5n}&=\\frac{8m^{12}n^3}{4m^5n}\\\\\\frac{(2m^4n)^3}{4m^5n}&=2m^{12-5}n^{3-1}\\\\\\frac{(2m^4n)^3}{4m^5n}&=2m^7n^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p14-index-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{16q^4r^2}{3q^2}\\div\\dfrac{8qr^3}{pq^5r^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2pq^6r^3}{3}$",
          "worked": "$$\\begin{align*}\\frac{16q^4r^2}{3q^2}\\div\\frac{8qr^3}{pq^5r^4}&=\\frac{16q^4r^2}{3q^2}\\times\\frac{pq^5r^4}{8qr^3}\\\\\\frac{16q^4r^2}{3q^2}\\div\\frac{8qr^3}{pq^5r^4}&=\\frac{16pq^9r^6}{24q^3r^3}\\\\\\frac{16q^4r^2}{3q^2}\\div\\frac{8qr^3}{pq^5r^4}&=\\frac{2pq^6r^3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-index-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{7x^2y^4}{2xy}\\div\\dfrac{21xy^5}{4x^3y^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x^3y^4}{3}$",
          "worked": "$$\\begin{align*}\\frac{7x^2y^4}{2xy}\\div\\frac{21xy^5}{4x^3y^6}&=\\frac{7x^2y^4}{2xy}\\times\\frac{4x^3y^6}{21xy^5}\\\\\\frac{7x^2y^4}{2xy}\\div\\frac{21xy^5}{4x^3y^6}&=\\frac{28x^5y^{10}}{42x^2y^6}\\\\\\frac{7x^2y^4}{2xy}\\div\\frac{21xy^5}{4x^3y^6}&=\\frac{2x^3y^4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
