        "prompt": "$\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D=\\mathbb R,\\quad R=[-1,1]$.",
          "worked": "Sine is defined for every real $x$, and its values lie between $-1$ and $1$, inclusive.\n$$\\begin{align*}D&=\\mathbb R\\\\R&=[-1,1]\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p55-ep-11-13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D=\\mathbb R,\\quad R=[-1,1]$.",
          "worked": "Cosine is defined for every real $x$, and its values lie between $-1$ and $1$, inclusive.\n$$\\begin{align*}D&=\\mathbb R\\\\R&=[-1,1]\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p55-ep-11-13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D=\\mathbb R\\setminus\\{\\tfrac{\\pi}{2}+k\\pi:k\\in\\mathbb Z\\}$; $R=\\mathbb R$.",
          "worked": "Tangent is undefined at odd multiples of $\\frac{\\pi}{2}$. Its branches attain every real $y$-value.\n$$\\begin{align*}D&=\\mathbb R\\setminus\\left\\{\\frac{\\pi}{2}+k\\pi:k\\in\\mathbb Z\\right\\}\\\\R&=\\mathbb R\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
