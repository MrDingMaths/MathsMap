    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\sqrt2\\text{ cm}\\approx4.24\\text{ cm}$",
      "worked": "$$\\begin{aligned}\\pi r^2&=\\frac12\\pi(6)^2\\\\r^2&=18\\\\r&=3\\sqrt2\\text{ cm}\\\\r&\\approx4.24\\text{ cm}.\\end{aligned}$$",
