  "content": {
    "id": "p50-task27-question",
    "type": "question",
    "label": null,
    "prompt": "A parabola has equation $y=x^2-2x-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-task27-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $y$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$, at $(0,-1)$.",
          "worked": "Set $x=0$.\n$$\\begin{align*}y &= 0^2-2(0)-1\\\\y &= -1\\end{align*}$$\nThe $y$-intercept is $(0,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-task27-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the $x$-intercepts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-\\sqrt2,0)$ and $(1+\\sqrt2,0)$.",
          "worked": "Set $y=0$ and use the quadratic formula.\n$$\\begin{align*}x^2-2x-1 &= 0\\\\x &= \\frac{2\\pm\\sqrt{(-2)^2-4(1)(-1)}}{2(1)}\\\\x &= 1\\pm\\sqrt2\\end{align*}$$\nThe $x$-intercepts are $(1-\\sqrt2,0)$ and $(1+\\sqrt2,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p50-task27-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of the axis of symmetry.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$.",
          "worked": "Using $x=-\\frac{b}{2a}$:\n$$\\begin{align*}x &= -\\frac{-2}{2(1)}\\\\x &= 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-task27-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the coordinates of the vertex.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-2)$.",
          "worked": "At $x=1$:\n$$\\begin{align*}y &= 1^2-2(1)-1\\\\y &= -2\\end{align*}$$\nThe vertex is $(1,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p50-task27-e",
        "type": "part",
        "label": "e",
        "prompt": "Graph the parabola, showing all important features.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Upward-opening parabola with vertex $(1,-2)$, axis $x=1$, $y$-intercept $(0,-1)$ and $x$-intercepts $(1-\\sqrt2,0)$ and $(1+\\sqrt2,0)$.",
          "worked": "The coefficient of $x^2$ is positive, so the parabola opens upwards. Plot the intercepts from (a) and (b), mark the vertex $(1,-2)$ and draw the parabola symmetrically about $x=1$.",
          "solutionDiagrams": [
            {
              "id": "p50-task27-e-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"parabolaBlue\",\"hex\":\"268CFF\",\"reason\":\"Quadratic function curve and its vertex marker.\"}],\"reference\":\"Student PDF 50, printed 114, Exercise 2E Q27(e); corrected answer graph under the supplied editorial resolution.\"}\n\\begin{tikzpicture}[x=14mm,y=12mm,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{parabolaBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-1.8,-2.85) rectangle (3.8,2.95);\n\\draw[black,line width=0.4pt,dashed] (1,-2) -- (1,2.2);\n\\draw[black,line width=0.4pt,dashed] (0,-2) -- (1,-2);\n\\draw[black,line width=0.5pt,->] (-1.25,0) -- (3.3,0);\n\\draw[black,line width=0.5pt,->] (0,-2.55) -- (0,2.55);\n\\draw[black,line width=0.4pt] (-0.05,-1) -- (0.05,-1);\n\\draw[black,line width=0.4pt] (-0.05,-2) -- (0.05,-2);\n\\draw[parabolaBlue,line width=0.8pt,<->] plot[domain=-1.0615528128:3.0615528128,samples=121] (\\x,{(\\x-1)*(\\x-1)-2});\n\\fill[parabolaBlue] (1,-2) circle[radius=1.4pt];\n\\node[black,above right,xshift=2pt,yshift=3pt] at (3.3,0) {$x$};\n\\node[black,above right,xshift=2pt] at (0,2.55) {$y$};\n\\node[black,below left,xshift=-2pt,yshift=-2pt] at ({1-sqrt(2)},0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1-\\sqrt2$\\special{dvisvgm:raw </g>}};\n\\node[black,below right,xshift=2pt,yshift=-2pt] at ({1+sqrt(2)},0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1+\\sqrt2$\\special{dvisvgm:raw </g>}};\n\\node[black,above right,xshift=2pt,yshift=1pt] at (0,-1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[black,left,xshift=-2pt] at (0,-2) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-2$\\special{dvisvgm:raw </g>}};\n\\node[black,right,xshift=2pt] at (1,1.25) {$x=1$};\n\\node[black,below,yshift=-3pt] at (1,-2) {$(1,-2)$};\n\\end{tikzpicture}",
              "src": null,
