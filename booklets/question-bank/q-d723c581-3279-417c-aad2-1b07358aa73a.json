  "content": {
    "id": "p32-q9",
    "type": "question",
    "label": "9",
    "prompt": "Write $2^{-x}\\times3^{-x}\\times6^{2x}\\times3^{2x}\\times2^{2x}$ as a power of $6$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6^{3x}$\n\nCombine powers with the same base, then use $2^x3^x=6^x$.",
      "worked": "$$\\begin{align*}2^{-x}\\times3^{-x}\\times6^{2x}\\times3^{2x}\\times2^{2x}&=2^{-x+2x}\\times3^{-x+2x}\\times6^{2x}\\\\2^{-x}\\times3^{-x}\\times6^{2x}\\times3^{2x}\\times2^{2x}&=2^x\\times3^x\\times6^{2x}\\\\2^{-x}\\times3^{-x}\\times6^{2x}\\times3^{2x}\\times2^{2x}&=6^x\\times6^{2x}\\\\2^{-x}\\times3^{-x}\\times6^{2x}\\times3^{2x}\\times2^{2x}&=6^{3x}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
