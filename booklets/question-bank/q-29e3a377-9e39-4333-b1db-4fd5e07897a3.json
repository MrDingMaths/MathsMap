  "content": {
    "id": "p16-q7-response",
    "type": "question",
    "label": "",
    "prompt": "What is the value of $p$ so that $\\dfrac{a^2a^{-3}}{\\sqrt{a}}=a^p$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=-1.5$",
      "worked": "$$\\begin{align*}\\frac{a^2a^{-3}}{\\sqrt{a}}&=\\frac{a^{2-3}}{a^{1/2}}\\\\&=a^{2-3-1/2}\\\\&=a^{-3/2}\\\\p&=-\\frac32=-1.5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
