  "content": {
    "id": "p24-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Patricia takes 2 slices of a pie that was cut into 7 equal slices, and 3 slices of another identical pie that was cut into 9 equal slices.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the first pie did she take?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac27$",
          "worked": "She took 2 of the 7 equal slices, so she took $\\frac27$ of the first pie.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p24-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the second pie did she take?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "She took 3 of the 9 equal slices.\n$$\\frac39=\\frac13$$\nShe took $\\frac13$ of the second pie.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p24-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "What fraction of a pie would she have if she put the slices together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{21}$",
          "worked": "The pies are identical, so the fractions refer to the same-sized whole.\n$$\\begin{align*}\\frac27+\\frac13&=\\frac6{21}+\\frac7{21}\\\\\\frac27+\\frac13&=\\frac{13}{21}\\end{align*}$$\nTogether, the slices make $\\frac{13}{21}$ of a pie.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
