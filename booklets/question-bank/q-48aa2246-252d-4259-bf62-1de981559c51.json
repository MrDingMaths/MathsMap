  "content": {
    "id": "p27-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "By writing each integrand as the sum of multiples of powers of $e$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{e^x+1}{e^x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-e^{-x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{e^x+1}{e^x}\\,dx&=\\int(1+e^{-x})\\,dx\\\\&=x+\\frac{e^{-x}}{-1}+C\\\\&=x-e^{-x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p27-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{e^{2x}+1}{e^x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^x-e^{-x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{e^{2x}+1}{e^x}\\,dx&=\\int(e^x+e^{-x})\\,dx\\\\&=e^x+\\frac{e^{-x}}{-1}+C\\\\&=e^x-e^{-x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p27-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{e^x-1}{e^{2x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12e^{-2x}-e^{-x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{e^x-1}{e^{2x}}\\,dx&=\\int(e^{-x}-e^{-2x})\\,dx\\\\&=\\frac{e^{-x}}{-1}-\\frac{e^{-2x}}{-2}+C\\\\&=\\frac12e^{-2x}-e^{-x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p27-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{e^x-3}{e^{3x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^{-3x}-\\frac12e^{-2x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{e^x-3}{e^{3x}}\\,dx&=\\int(e^{-2x}-3e^{-3x})\\,dx\\\\&=\\frac{e^{-2x}}{-2}-\\frac{3e^{-3x}}{-3}+C\\\\&=e^{-3x}-\\frac12e^{-2x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p27-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int\\frac{2e^{2x}-3e^x}{e^{4x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^{-3x}-e^{-2x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{2e^{2x}-3e^x}{e^{4x}}\\,dx&=\\int(2e^{-2x}-3e^{-3x})\\,dx\\\\&=\\frac{2e^{-2x}}{-2}-\\frac{3e^{-3x}}{-3}+C\\\\&=e^{-3x}-e^{-2x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p27-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int\\frac{2e^x-e^{2x}}{e^{3x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^{-x}-e^{-2x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{2e^x-e^{2x}}{e^{3x}}\\,dx&=\\int(2e^{-2x}-e^{-x})\\,dx\\\\&=\\frac{2e^{-2x}}{-2}-\\frac{e^{-x}}{-1}+C\\\\&=e^{-x}-e^{-2x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
