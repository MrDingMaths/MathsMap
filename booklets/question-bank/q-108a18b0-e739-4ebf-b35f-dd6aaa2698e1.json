    "id": "p45-q3-swap",
    "type": "question",
    "label": "",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "4d2879d1-ce2a-46bc-a1bf-38eb65dee7f3",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 0,
          "lineHeight": 1.3199970000068182,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Predict first: if you swap the two numbers, will the answer stay the same or change?",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Then calculate.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q3-swap-calculate",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p45-q3-swap-a",
            "type": "part",
            "label": "a",
            "prompt": "$9-4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5$",
              "worked": "Start at $9$ and move four units left.\n$$\\begin{align*}9-4&=5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p45-q3-swap-b",
            "type": "part",
            "label": "b",
            "prompt": "$4-9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-5$",
              "worked": "Start at $4$ and move nine units left.\n$$\\begin{align*}4-9&=-5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p45-q3-swap-c",
            "type": "part",
            "label": "c",
            "prompt": "$9-(-4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$13$",
              "worked": "$$\\begin{align*}9-(-4)&=9+4\\\\9-(-4)&=13\\end{align*}$$\nMove four units right from $9$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p45-q3-swap-d",
            "type": "part",
            "label": "d",
            "prompt": "$(-4)-9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-13$",
              "worked": "Start at $-4$ and move nine units left.\n$$\\begin{align*}(-4)-9&=-13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      },
      {
        "id": "p45-q3-swap-notice",
        "type": "part",
        "label": "e",
        "prompt": "What happens to the answer when you swap the numbers in a subtraction?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The answer becomes its opposite, for example $5$ and $-5$.",
          "worked": "Each number keeps its own sign; only the order changes. Swapping the numbers gives the opposite answer: $9-4=5$ and $4-9=-5$, and $9-(-4)=13$ and $(-4)-9=-13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p45-q3-swap-e",
        "type": "part",
        "label": "f",
        "prompt": "Use $-7$ and $3$ to write two subtractions: one with answer $10$ and one with answer $-10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-(-7)=10$ and $(-7)-3=-10$.",
          "worked": "$$\\begin{align*}3-(-7)&=3+7\\\\3-(-7)&=10\\end{align*}$$\n$$\\begin{align*}(-7)-3&=-10\\end{align*}$$\nSwapping the numbers gives the opposite answer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
