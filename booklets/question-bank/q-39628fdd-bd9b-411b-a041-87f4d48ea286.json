  "content": {
    "id": "v2-4b59f-p11-practice-j3-112304-root",
    "type": "question",
    "label": null,
    "prompt": "A whole number is rounded to the nearest hundred. The answer is $600$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4b59f-p11-practice-j3-112304-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Which numbers are halfway between $600$ and the hundreds on either side of it?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$550$ and $650$",
          "worked": "$$\\begin{align*}600-50&=550\\\\600+50&=650\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-4b59f-p11-practice-j3-112304-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the smallest and largest whole numbers that could have been rounded to give $600$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Smallest $550$, largest $649$",
          "worked": "$$\\begin{align*}550&\\to600\\quad\\text{(a halfway number rounds up)}\\\\649&\\to600\\\\650&\\to700\\end{align*}$$ The smallest is $550$ and the largest is $649$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
