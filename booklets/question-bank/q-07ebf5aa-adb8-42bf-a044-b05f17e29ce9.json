  "content": {
    "id": "p25-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The population of a city was $1\\,000\\,000$ and it increased by $2\\frac{1}{2}\\%$ of this value in each of 3 successive years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the population at the end of the first year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,025\\,000$ people",
          "worked": "$$\\begin{align*}\\text{Annual increase}&=\\frac{2\\frac{1}{2}}{100}\\times1\\,000\\,000\\\\\\text{Annual increase}&=\\frac{1}{40}\\times1\\,000\\,000\\\\\\text{Annual increase}&=25\\,000\\\\\\text{Population after 1 year}&=1\\,000\\,000+25\\,000\\\\\\text{Population after 1 year}&=1\\,025\\,000\\text{ people}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "What was the population at the end of 3 years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,075\\,000$ people\n\nEach year's increase is calculated from the original population.",
          "worked": "The increase is $25\\,000$ people each year because “of this value” refers to the original population.\n\n$$\\begin{align*}\\text{Increase over 3 years}&=3\\times25\\,000\\\\\\text{Increase over 3 years}&=75\\,000\\\\\\text{Population after 3 years}&=1\\,000\\,000+75\\,000\\\\\\text{Population after 3 years}&=1\\,075\\,000\\text{ people}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
