  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Use the compound-angle formulas to prove these rules:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(90^\\circ+A)=\\cos A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin(90^\\circ+A)=1\\cos A+0\\sin A=\\cos A$.",
          "worked": "$$\\begin{aligned}\\sin(90^\\circ+A)&=\\sin90^\\circ\\cos A+\\cos90^\\circ\\sin A\\\\&=1\\cdot\\cos A+0\\cdot\\sin A\\\\&=\\cos A\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos(90^\\circ-A)=\\sin A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos(90^\\circ-A)=0\\cos A+1\\sin A=\\sin A$.",
          "worked": "$$\\begin{aligned}\\cos(90^\\circ-A)&=\\cos90^\\circ\\cos A+\\sin90^\\circ\\sin A\\\\&=0\\cdot\\cos A+1\\cdot\\sin A\\\\&=\\sin A\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p5-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(360^\\circ-A)=-\\tan A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan(360^\\circ-A)=\\dfrac{0-\\tan A}{1+0}=-\\tan A$.",
          "worked": "$$\\begin{aligned}\\tan(360^\\circ-A)&=\\frac{\\tan360^\\circ-\\tan A}{1+\\tan360^\\circ\\tan A}\\\\&=\\frac{0-\\tan A}{1+0}\\\\&=-\\tan A\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan(180^\\circ+A)=\\tan A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan(180^\\circ+A)=\\dfrac{0+\\tan A}{1-0}=\\tan A$.",
          "worked": "$$\\begin{aligned}\\tan(180^\\circ+A)&=\\frac{\\tan180^\\circ+\\tan A}{1-\\tan180^\\circ\\tan A}\\\\&=\\frac{0+\\tan A}{1-0}\\\\&=\\tan A\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos(270^\\circ-A)=-\\sin A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos(270^\\circ-A)=0\\cos A+(-1)\\sin A=-\\sin A$.",
          "worked": "$$\\begin{aligned}\\cos(270^\\circ-A)&=\\cos270^\\circ\\cos A+\\sin270^\\circ\\sin A\\\\&=0\\cdot\\cos A+(-1)\\cdot\\sin A\\\\&=-\\sin A\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p5-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sin(360^\\circ-A)=-\\sin A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin(360^\\circ-A)=0\\cos A-1\\sin A=-\\sin A$.",
          "worked": "$$\\begin{aligned}\\sin(360^\\circ-A)&=\\sin360^\\circ\\cos A-\\cos360^\\circ\\sin A\\\\&=0\\cdot\\cos A-1\\cdot\\sin A\\\\&=-\\sin A\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
