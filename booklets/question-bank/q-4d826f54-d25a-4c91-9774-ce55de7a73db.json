  "content": {
    "id": "p16-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A regular hexagon has been enlarged by scale factor 4. The image has a perimeter of 36 cm.\nWhat is the length of each side of the original hexagon?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1.5\\text{ cm}$",
      "worked": "A regular hexagon has six equal sides.\n$$\\begin{align*}\\text{Image side length}&=36\\div6\\\\&=6\\text{ cm}\\\\\\text{Original side length}&=6\\div4\\\\&=1.5\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 21
  },
