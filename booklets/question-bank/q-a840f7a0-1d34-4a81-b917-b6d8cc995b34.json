    "type": "question",
    "label": "3",
    "prompt": "Evaluate each expression when $n=-3$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$n^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}n^2&=(-3)^2\\\\n^2&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-n)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}(-n)^2&=\\bigl(-(-3)\\bigr)^2\\\\(-n)^2&=3^2\\\\(-n)^2&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$-n^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9$",
          "worked": "$$\\begin{align*}-n^2&=-(-3)^2\\\\-n^2&=-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$n^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-27$",
          "worked": "$$\\begin{align*}n^3&=(-3)^3\\\\n^3&=(-3)\\times(-3)\\times(-3)\\\\n^3&=-27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-n)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "$$\\begin{align*}(-n)^3&=\\bigl(-(-3)\\bigr)^3\\\\(-n)^3&=3^3\\\\(-n)^3&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(3n)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81$",
          "worked": "$$\\begin{align*}(3n)^2&=\\bigl(3\\times(-3)\\bigr)^2\\\\(3n)^2&=(-9)^2\\\\(3n)^2&=81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q3-g",
        "type": "part",
        "label": "g",
