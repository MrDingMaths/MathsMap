  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Given $\\tan\\theta=\\frac32$, find the value of $\\sin\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sin\\theta=\\pm\\frac{3\\sqrt{13}}{13}$.",
      "worked": "$$\\begin{align*}\\sec^2\\theta&=1+\\tan^2\\theta\\\\\\sec^2\\theta&=1+\\left(\\frac32\\right)^2\\\\\\sec^2\\theta&=\\frac{13}{4}\\\\\\cos\\theta&=\\pm\\frac{2}{\\sqrt{13}}\\\\\\sin\\theta&=\\tan\\theta\\cos\\theta\\\\\\sin\\theta&=\\frac32\\left(\\pm\\frac{2}{\\sqrt{13}}\\right)\\\\\\sin\\theta&=\\pm\\frac{3\\sqrt{13}}{13}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
