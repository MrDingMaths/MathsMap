  "content": {
    "id": "p32-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Find the volume of the largest cylinder that fits inside a cube of side length $10\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$250\\pi\\text{ cm}^3$",
      "worked": "The cylinder has diameter $10\\text{ cm}$ and height $10\\text{ cm}$, so its radius is $5\\text{ cm}$.\n\n$$\\begin{align*}V&=\\pi r^2h\\\\V&=\\pi\\times5^2\\times10\\\\V&=250\\pi\\text{ cm}^3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
