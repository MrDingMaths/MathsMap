        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\text{ cm}$",
          "worked": "$$\\begin{align*}l&=r\\theta\\\\l&=5\\times2\\\\l&=10\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "area of the sector.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{1}{2}r^2\\theta\\\\A&=\\frac{1}{2}\\times5^2\\times2\\\\A&=25\\text{ cm}^2\\end{align*}$$",
