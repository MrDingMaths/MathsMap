    "id": "p6-q2-root",
    "type": "question",
    "label": "4",
    "prompt": "A circle has radius $5$ cm. If the angle subtended at the centre is $2$ radians, find the",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "length of the arc",
        "layout": "list",
