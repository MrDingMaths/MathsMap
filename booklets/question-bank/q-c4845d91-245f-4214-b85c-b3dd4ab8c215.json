  "content": {
    "id": "p8-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Evaluate $\\cos^4\\theta-\\sin^4\\theta+\\sin^2\\theta-\\cos^2\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0$.\n\nFactor $\\cos^4\\theta-\\sin^4\\theta$ as a difference of squares.",
      "worked": "$$\\begin{align*}\\cos^4\\theta-\\sin^4\\theta+\\sin^2\\theta-\\cos^2\\theta&=(\\cos^2\\theta+\\sin^2\\theta)(\\cos^2\\theta-\\sin^2\\theta)+\\sin^2\\theta-\\cos^2\\theta\\\\\\cos^4\\theta-\\sin^4\\theta+\\sin^2\\theta-\\cos^2\\theta&=\\cos^2\\theta-\\sin^2\\theta+\\sin^2\\theta-\\cos^2\\theta\\\\\\cos^4\\theta-\\sin^4\\theta+\\sin^2\\theta-\\cos^2\\theta&=0\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
