  "content": {
    "id": "p4-q11",
    "type": "question",
    "label": "11",
    "prompt": "Let $f(x)=4^x$. Show the following results.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(2x)=16^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(2x)=(4^2)^x=16^x$.",
          "worked": "$$\\begin{align*}f(2x)&=4^{2x}\\\\f(2x)&=(4^2)^x\\\\f(2x)&=16^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p4-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$4f(x)=f(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4f(x)=4\\times4^x=4^{x+1}=f(x+1)$.",
          "worked": "$$\\begin{align*}4f(x)&=4\\times4^x\\\\4f(x)&=4^{x+1}\\\\4f(x)&=f(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p4-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x+1)-f(x)=3\\times f(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x+1)-f(x)=(4-1)4^x=3f(x)$.",
          "worked": "$$\\begin{align*}f(x+1)-f(x)&=4^{x+1}-4^x\\\\f(x+1)-f(x)&=4\\times4^x-4^x\\\\f(x+1)-f(x)&=(4-1)4^x\\\\f(x+1)-f(x)&=3\\times f(x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
