  "content": {
    "id": "p9-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "By writing each function as a piecewise-defined function, or otherwise, write an expression for:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q4-g",
        "type": "part",
        "label": "a",
        "prompt": "$|a|$ when $a\\ge 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a$",
          "worked": "Since $a\\ge 0$, use the non-negative branch:\n$$|a|=a.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q4-h",
        "type": "part",
        "label": "b",
        "prompt": "$|a|$ when $a<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-a$",
          "worked": "Since $a<0$, use the negative branch:\n$$|a|=-a.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q4-i",
        "type": "part",
        "label": "c",
        "prompt": "$|3a|$ when $a<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3a$",
          "worked": "Since $a<0$, $3a<0$.\n$$\\begin{aligned}|3a|&=-(3a)\\\\|3a|&=-3a\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q4-j",
        "type": "part",
        "label": "d",
        "prompt": "$|a+1|$ when $a>-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+1$",
          "worked": "Since $a>-1$, $a+1>0$.\n$$|a+1|=a+1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q4-k",
        "type": "part",
        "label": "e",
        "prompt": "$|a+1|$ when $a<-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-a-1$",
          "worked": "Since $a<-1$, $a+1<0$.\n$$\\begin{aligned}|a+1|&=-(a+1)\\\\|a+1|&=-a-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q4-l",
        "type": "part",
        "label": "f",
        "prompt": "$|x-2|$ when $x>2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2$",
          "worked": "Since $x>2$, $x-2>0$.\n$$|x-2|=x-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
