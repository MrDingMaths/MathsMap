  "content": {
    "id": "p61-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Exam scores are normally distributed with mean 65 and standard deviation 12.\nA student scores better than 80% of the cohort. Find their score to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$75.1$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p61-q3-worked-probability",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "We want a z-score with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "P(Z\\le z)=0.80",
                "display": false
              }
            ]
          },
          {
            "id": "p61-q3-worked-inverse",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using the table, or inverse normal on a calculator, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "z\\approx0.84",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p61-q3-worked-calculation",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}x&=\\mu+z\\sigma\\\\x&\\approx65+0.84(12)\\\\x&\\approx75.1\\quad\\text{(1 d.p.)}\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
