yshift=1.5pt] at (0,3) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\node[black,anchor=south east,xshift=-2pt,yshift=1.5pt] at (0,5) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$5$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
