        "type": "part",
        "label": "a",
        "prompt": "Express $f(x)$ as a piecewise-defined function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p127-q73-a-short-result",
                "type": "paragraph",
                "fontSize": null,
