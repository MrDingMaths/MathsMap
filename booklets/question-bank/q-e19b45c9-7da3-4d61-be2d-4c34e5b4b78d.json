  "content": {
    "id": "p9-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Given that $y$ is inversely proportional to $x^2$ and $y=10$ when $x=2$, find the formula for $y$ in terms of $x$, and find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q4-formula",
        "type": "part",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{40}{x^2}$.",
          "worked": "Write $y=\\frac{k}{x^2}$.\n$$\\begin{align*}10&=\\frac{k}{2^2}\\\\k&=10\\times4\\\\k&=40\\\\y&=\\frac{40}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32,
        "responseSpace": "scaffold"
      },
      {
        "id": "p9-q4-values",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q4-a",
            "type": "part",
            "label": "b",
            "prompt": "$y$ when $x=9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\dfrac{40}{81}$.",
              "worked": "$$\\begin{align*}y&=\\frac{40}{9^2}\\\\y&=\\frac{40}{81}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p9-q4-b",
            "type": "part",
            "label": "c",
            "prompt": "$x$ when $y=9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\pm\\dfrac{2\\sqrt{10}}{3}$.\n\nTake both square roots because no sign restriction is stated.",
              "worked": "$$\\begin{align*}9&=\\frac{40}{x^2}\\\\x^2&=\\frac{40}{9}\\\\x&=\\pm\\sqrt{\\frac{40}{9}}\\\\x&=\\pm\\frac{2\\sqrt{10}}{3}\\end{align*}$$\nBoth values satisfy $y=\\frac{40}{x^2}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          }
        ]
      }
    ]
  },
