          "inlines": [
            {
              "type": "text",
              "text": "The number of plankton in a tank is doubling every 5 days, given by the formula:",
              "marks": []
            }
          ]
        },
        {
          "id": "p29-q1-model",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "P = 15000 \\times 2^{\\frac{t}{5}}",
              "display": true
            }
          ]
        },
        {
          "id": "p29-q1-definitions",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "P",
              "display": false
            },
            {
              "type": "text",
              "text": " is population (number of plankton) after ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "t",
              "display": false
            },
            {
              "type": "text",
              "text": " days from commencement of study.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the initial population when the study commenced?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\,000$ plankton",
          "worked": "At commencement, $t=0$.\n$$\\begin{align*}P &= 15000\\times 2^{\\frac{0}{5}}\\\\P &= 15000\\end{align*}$$\nThe initial population was $15\\,000$ plankton.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p29-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "What was the population after 15 days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120\\,000$ plankton",
          "worked": "$$\\begin{align*}P &= 15000\\times 2^{\\frac{15}{5}}\\\\P &= 15000\\times 8\\\\P &= 120000\\end{align*}$$\nThe population was $120\\,000$ plankton.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p29-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "At what time will the population reach $1\\,920\\,000$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$ days",
          "worked": "$$\\begin{align*}1920000 &= 15000\\times 2^{\\frac{t}{5}}\\\\128 &= 2^{\\frac{t}{5}}\\\\2^7 &= 2^{\\frac{t}{5}}\\\\\\frac{t}{5} &= 7\\\\t &= 35\\text{ days}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
