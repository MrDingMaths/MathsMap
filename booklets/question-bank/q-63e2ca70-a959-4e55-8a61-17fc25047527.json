  "content": {
    "id": "p53-q121-root",
    "type": "question",
    "label": "121",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p53-q121-title",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Geometric definition of a parabola",
              "marks": [
                "bold"
              ],
              "colour": "#8b5cc7"
            }
          ]
        },
        {
          "id": "p53-q121-definition",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A parabola can be defined as the set of all points ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "P(x,y)",
              "display": false
            },
            {
              "type": "text",
              "text": " in the plane that are equidistant from a fixed point ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "S",
              "display": false
            },
            {
              "type": "text",
              "text": " (called the focus) and a fixed line ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\ell",
              "display": false
            },
            {
              "type": "text",
              "text": " (called the directrix).",
              "marks": []
            }
          ]
        },
        {
          "id": "p53-q121-setup",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Suppose the focus is at ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "S=(0,a)",
              "display": false
            },
            {
              "type": "text",
              "text": " and the directrix is the line ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=-a",
              "display": false
            },
            {
              "type": "text",
              "text": ", where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "a>0",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q121-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the distance from a point $P=(x,y)$ to the focus $S=(0,a)$ is $PS=\\sqrt{x^2+(y-a)^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$PS=\\sqrt{x^2+(y-a)^2}$, by the distance formula.",
          "worked": "Using the distance formula,\n$$\\begin{align*}PS&=\\sqrt{(x-0)^2+(y-a)^2}\\\\PS&=\\sqrt{x^2+(y-a)^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p53-q121-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the perpendicular distance from the point $P=(x,y)$ to the directrix $y=-a$ is $PM=y+a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p53-q121-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "PM=y+a",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", for ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "P",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " on the parabola.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p53-q121-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Initially ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "PM=|y+a|",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". Equidistance gives ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "4ay\\ge0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", hence ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y\\ge0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " because ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a>0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The perpendicular foot is $M=(x,-a)$, so $PM=|y+a|$.\n\nFor $P$ on the parabola, $PM=PS$. Part (a) gives $PS\\ge|y-a|$, hence $|y+a|\\ge|y-a|$. Squaring these nonnegative quantities gives\n$$\\begin{align*}(y+a)^2&\\ge(y-a)^2\\\\4ay&\\ge0\\\\y&\\ge0.\\end{align*}$$\nThe last step uses $a>0$. Therefore $y+a>0$, so $PM=y+a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p53-q121-c",
        "type": "part",
        "label": "c",
        "prompt": "Using the definition of a parabola (i.e. $PS=PM$), derive the Cartesian equation of the parabola and simplify it.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p53-q121-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y=\\frac{x^2}{4a}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", equivalently ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x^2=4ay",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p53-q121-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Equate the distances, square both sides and simplify.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Using $PS=PM$ and parts (a) and (b),\n$$\\begin{align*}\\sqrt{x^2+(y-a)^2}&=y+a\\\\x^2+(y-a)^2&=(y+a)^2\\\\x^2+y^2-2ay+a^2&=y^2+2ay+a^2\\\\x^2&=4ay\\\\y&=\\frac{x^2}{4a}.\\end{align*}$$\nSince $a>0$, division by $4a$ is valid.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
