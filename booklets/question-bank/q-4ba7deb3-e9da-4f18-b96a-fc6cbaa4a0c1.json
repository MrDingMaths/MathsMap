    "children": [
      {
        "id": "p10-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\sqrt{2x-1}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3}(2x-1)^{3/2}+C$",
          "worked": "$$\\begin{align*}\\int\\sqrt{2x-1}\\,dx&=\\int(2x-1)^{1/2}\\,dx\\\\&=\\frac{(2x-1)^{3/2}}{2(3/2)}+C\\\\&=\\frac{1}{3}(2x-1)^{3/2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\sqrt{7-4x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{6}(7-4x)^{3/2}+C$",
          "worked": "$$\\begin{align*}\\int\\sqrt{7-4x}\\,dx&=\\int(7-4x)^{1/2}\\,dx\\\\&=\\frac{(7-4x)^{3/2}}{-4(3/2)}+C\\\\&=-\\frac{1}{6}(7-4x)^{3/2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\sqrt[3]{4x-1}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{16}(4x-1)^{4/3}+C$",
          "worked": "$$\\begin{align*}\\int\\sqrt[3]{4x-1}\\,dx&=\\int(4x-1)^{1/3}\\,dx\\\\&=\\frac{(4x-1)^{4/3}}{4(4/3)}+C\\\\&=\\frac{3}{16}(4x-1)^{4/3}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{1}{\\sqrt{3x+5}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{3}\\sqrt{3x+5}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{1}{\\sqrt{3x+5}}\\,dx&=\\int(3x+5)^{-1/2}\\,dx\\\\&=\\frac{(3x+5)^{1/2}}{3(1/2)}+C\\\\&=\\frac{2}{3}\\sqrt{3x+5}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
