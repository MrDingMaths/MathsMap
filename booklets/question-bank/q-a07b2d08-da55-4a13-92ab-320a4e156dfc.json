  "content": {
    "id": "p40-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A coin of radius $1\\text{ cm}$ is tossed onto a plane surface that has been tiled by rectangles measuring $8\\text{ cm}$ by $15\\text{ cm}$. What is the probability that the coin lands within one of the rectangles?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{13}{20}$.\n\nCompare the area available to the coin’s centre with the area of one rectangle.",
      "worked": "The coin lies entirely within a rectangle when its centre is at least $1\\text{ cm}$ from every edge. The allowed region for the centre is a rectangle measuring $(8-2)\\text{ cm}$ by $(15-2)\\text{ cm}$. Since the centre is uniformly distributed, the probability is the ratio of areas.\n\n$$\\begin{align*}\\Pr(E)&=\\frac{(8-2)(15-2)}{8\\times15}\\\\\\Pr(E)&=\\frac{78}{120}\\\\\\Pr(E)&=\\frac{13}{20}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
