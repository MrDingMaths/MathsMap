  "content": {
    "id": "p57-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The point $(x,y)=(8,-12)$ lies on the function $y=f(x)$.\nFind the coordinates of the image point when the function is transformed into:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3f(x-1)+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(9,-31)$",
          "worked": "Translate 1 unit right. Dilate vertically by factor 3, then translate 5 units up.\n$$\\begin{align*}x'&=8+1=9\\\\y'&=3(-12)+5=-31\\end{align*}$$\nThe image point is $(9,-31)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p57-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-f(2x)-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,5)$",
          "worked": "Dilate horizontally by factor $\\tfrac12$. Reflect vertically in the $x$-axis, then translate 7 units down.\n$$\\begin{align*}x'&=\\frac{8}{2}=4\\\\y'&=-(-12)-7=5\\end{align*}$$\nThe image point is $(4,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p57-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2f(x+3)-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5,-25)$",
          "worked": "Translate 3 units left. Dilate vertically by factor 2, then translate 1 unit down.\n$$\\begin{align*}x'&=8-3=5\\\\y'&=2(-12)-1=-25\\end{align*}$$\nThe image point is $(5,-25)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p57-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=6f(-x)+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-8,-67)$",
          "worked": "Reflect horizontally in the $y$-axis. Dilate vertically by factor 6, then translate 5 units up.\n$$\\begin{align*}x'&=-8\\\\y'&=6(-12)+5=-67\\end{align*}$$\nThe image point is $(-8,-67)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p57-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=-2f[2(x-2)]-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(6,21)$",
          "worked": "Dilate horizontally by factor $\\tfrac12$, then translate 2 units right. Dilate vertically by factor 2, reflect in the $x$-axis, then translate 3 units down.\n$$\\begin{align*}x'&=\\frac{8}{2}+2=6\\\\y'&=-2(-12)-3=21\\end{align*}$$\nThe image point is $(6,21)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
