  "content": {
    "id": "p21-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Suppose that the quadratic $x^2-ax+40$ has two positive integer roots. Find the smallest possible value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=13$",
      "worked": "Let the roots be $p$ and $q$. Vieta’s formulas give $pq=40$ and $a=p+q$.\nThe positive integer factor pairs are $(1,40)$, $(2,20)$, $(4,10)$ and $(5,8)$, with sums $41$, $22$, $14$ and $13$ respectively.\nThe smallest possible value is $a=13$, attained by roots $5$ and $8$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
