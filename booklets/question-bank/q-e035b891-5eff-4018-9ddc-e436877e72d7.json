    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$4a^2\\times5a^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{20}{a}$",
          "worked": "$$\\begin{align*}4a^2\\times5a^{-3}&=20a^{2-3}\\\\4a^2\\times5a^{-3}&=20a^{-1}\\\\4a^2\\times5a^{-3}&=\\frac{20}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$8m^2n^{-3}\\times5m^{-4}n^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{40n^3}{m^2}$",
          "worked": "$$\\begin{align*}8m^2n^{-3}\\times5m^{-4}n^6&=40m^{2-4}n^{-3+6}\\\\8m^2n^{-3}\\times5m^{-4}n^6&=40m^{-2}n^3\\\\8m^2n^{-3}\\times5m^{-4}n^6&=\\frac{40n^3}{m^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$14a^{-4}\\div7a^{-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a$",
          "worked": "$$\\begin{align*}14a^{-4}\\div7a^{-5}&=2a^{-4-(-5)}\\\\14a^{-4}\\div7a^{-5}&=2a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{18m^2n^{-3}}{9m^4n^{-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{m^2n^2}$",
          "worked": "$$\\begin{align*}\\frac{18m^2n^{-3}}{9m^4n^{-1}}&=2m^{2-4}n^{-3-(-1)}\\\\\\frac{18m^2n^{-3}}{9m^4n^{-1}}&=2m^{-2}n^{-2}\\\\\\frac{18m^2n^{-3}}{9m^4n^{-1}}&=\\frac{2}{m^2n^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$(4m^2n^{-2})^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{n^6}{64m^6}$",
          "worked": "$$\\begin{align*}(4m^2n^{-2})^{-3}&=4^{-3}m^{-6}n^6\\\\(4m^2n^{-2})^{-3}&=\\frac{1}{64}\\times\\frac{1}{m^6}\\times n^6\\\\(4m^2n^{-2})^{-3}&=\\frac{n^6}{64m^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{(5m^2n)^{-2}}{10m^4n^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{250m^8n^5}$",
          "worked": "$$\\begin{align*}\\frac{(5m^2n)^{-2}}{10m^4n^3}&=\\frac{5^{-2}m^{-4}n^{-2}}{10m^4n^3}\\\\\\frac{(5m^2n)^{-2}}{10m^4n^3}&=\\frac{1}{250}m^{-8}n^{-5}\\\\\\frac{(5m^2n)^{-2}}{10m^4n^3}&=\\frac{1}{250m^8n^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$(3a^4b^{-3})^{-3}\\div6a^2b^{-7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b^{16}}{162a^{14}}$",
          "worked": "$$\\begin{align*}(3a^4b^{-3})^{-3}\\div6a^2b^{-7}&=\\frac{3^{-3}a^{-12}b^9}{6a^2b^{-7}}\\\\(3a^4b^{-3})^{-3}\\div6a^2b^{-7}&=\\frac{1}{162}a^{-14}b^{16}\\\\(3a^4b^{-3})^{-3}\\div6a^2b^{-7}&=\\frac{b^{16}}{162a^{14}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{2m^3n^4}{(5m)^2}\\times\\frac{10m}{3n^{-4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4m^2n^8}{15}$",
          "worked": "$$\\begin{align*}\\frac{2m^3n^4}{(5m)^2}\\times\\frac{10m}{3n^{-4}}&=\\frac{20m^4n^4}{75m^2n^{-4}}\\\\\\frac{2m^3n^4}{(5m)^2}\\times\\frac{10m}{3n^{-4}}&=\\frac{4}{15}m^{4-2}n^{4-(-4)}\\\\\\frac{2m^3n^4}{(5m)^2}\\times\\frac{10m}{3n^{-4}}&=\\frac{4m^2n^8}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{(5a^4b^{-3})^2}{a^{-2}b}\\div\\frac{5(a^{-1}b)^{-3}}{ab^{-4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5a^8}{b^8}$\n\nExpand the powers, then multiply by the reciprocal of the second fraction.",
          "worked": "$$\\begin{align*}\\frac{(5a^4b^{-3})^2}{a^{-2}b}\\div\\frac{5(a^{-1}b)^{-3}}{ab^{-4}}&=\\frac{25a^8b^{-6}}{a^{-2}b}\\div\\frac{5a^3b^{-3}}{ab^{-4}}\\\\\\frac{(5a^4b^{-3})^2}{a^{-2}b}\\div\\frac{5(a^{-1}b)^{-3}}{ab^{-4}}&=25a^{10}b^{-7}\\div5a^2b\\\\\\frac{(5a^4b^{-3})^2}{a^{-2}b}\\div\\frac{5(a^{-1}b)^{-3}}{ab^{-4}}&=25a^{10}b^{-7}\\times\\frac{1}{5a^2b}\\\\\\frac{(5a^4b^{-3})^2}{a^{-2}b}\\div\\frac{5(a^{-1}b)^{-3}}{ab^{-4}}&=5a^8b^{-8}\\\\\\frac{(5a^4b^{-3})^2}{a^{-2}b}\\div\\frac{5(a^{-1}b)^{-3}}{ab^{-4}}&=\\frac{5a^8}{b^8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
