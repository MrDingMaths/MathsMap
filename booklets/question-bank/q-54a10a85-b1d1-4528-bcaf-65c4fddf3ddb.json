  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A particle is projected from the origin with a speed of 20 m/s at an angle of $60^\\circ$ to the horizontal.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Starting with $\\ddot{x}=0$ and $\\ddot{y}=-10$, show that $\\dot{x}=10$ and $\\dot{y}=-10t+10\\sqrt{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dot{x}=10$ and $\\dot{y}=-10t+10\\sqrt{3}$.",
          "worked": "$$\\begin{aligned}\\dot{x}&=C_1\\\\\\dot{x}(0)&=20\\cos60^\\circ\\\\&=10\\\\\\dot{x}&=10.\\end{aligned}$$\n$$\\begin{aligned}\\dot{y}&=-10t+C_2\\\\\\dot{y}(0)&=20\\sin60^\\circ\\\\&=10\\sqrt{3}\\\\\\dot{y}&=-10t+10\\sqrt{3}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $x$ and $y$ in terms of $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10t$, $y=-5t^2+10\\sqrt{3}\\,t$.",
          "worked": "Integrating gives\n$$\\begin{aligned}x&=10t+C_3\\\\y&=-5t^2+10\\sqrt{3}\\,t+C_4.\\end{aligned}$$\nSince $x(0)=y(0)=0$, $C_3=C_4=0$. Thus $x=10t$ and $y=-5t^2+10\\sqrt{3}\\,t$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q5-c",
        "type": "group",
        "label": "c",
        "prompt": "Use Pythagoras' theorem to find, correct to one decimal place:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q5-c-i",
            "type": "part",
            "label": "i",
            "prompt": "the distance of the particle from the origin after one second,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$15.9\\text{ m}$.",
              "worked": "At $t=1$,\n$$\\begin{aligned}x(1)&=10\\\\y(1)&=10\\sqrt{3}-5.\\end{aligned}$$\n$$\\begin{aligned}d&=\\sqrt{x(1)^2+y(1)^2}\\\\&=\\sqrt{10^2+(10\\sqrt{3}-5)^2}\\\\&\\approx15.9\\text{ m}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p17-q5-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the speed of the particle after one second.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12.4\\text{ m/s}$.",
              "worked": "At $t=1$,\n$$\\begin{aligned}\\dot{x}(1)&=10\\\\\\dot{y}(1)&=10\\sqrt{3}-10.\\end{aligned}$$\n$$\\begin{aligned}v&=\\sqrt{\\dot{x}(1)^2+\\dot{y}(1)^2}\\\\&=\\sqrt{100+100(\\sqrt{3}-1)^2}\\\\&\\approx12.4\\text{ m/s}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
    ]
  },
