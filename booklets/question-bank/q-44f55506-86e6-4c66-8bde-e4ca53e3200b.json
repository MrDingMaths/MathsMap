  "content": {
    "id": "p30-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify by making all the bases the same.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$3\\times3^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{x+1}$",
          "worked": "$$\\begin{align*}3\\times3^x&=3^1\\times3^x\\\\&=3^{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p30-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$32\\times2^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{x+5}$",
          "worked": "$$\\begin{align*}32\\times2^x&=2^5\\times2^x\\\\&=2^{x+5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p30-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac12\\times2^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{x-1}$",
          "worked": "$$\\begin{align*}\\frac12\\times2^x&=2^{-1}\\times2^x\\\\&=2^{x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p30-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$5^{2x}\\times5^{3x}\\div25^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{3x}$",
          "worked": "$$\\begin{align*}5^{2x}\\times5^{3x}\\div25^x&=5^{2x}\\times5^{3x}\\div5^{2x}\\\\&=5^{2x+3x-2x}\\\\&=5^{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$7^{3x+4}\\div49^{9-3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{9x-14}$",
          "worked": "$$\\begin{align*}7^{3x+4}\\div49^{9-3x}&=7^{3x+4}\\div7^{18-6x}\\\\&=7^{3x+4-(18-6x)}\\\\&=7^{9x-14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(9^x)^2\\times(3^{3x})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{13x}$",
          "worked": "$$\\begin{align*}(9^x)^2\\times(3^{3x})^3&=(3^{2x})^2\\times3^{9x}\\\\&=3^{4x}\\times3^{9x}\\\\&=3^{13x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$8^{2x}\\div2^{6x}\\times4^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{2x}$",
          "worked": "$$\\begin{align*}8^{2x}\\div2^{6x}\\times4^x&=2^{6x}\\div2^{6x}\\times2^{2x}\\\\&=2^{6x-6x+2x}\\\\&=2^{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$9^{3m+1}\\times3^{4m-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{10m+1}$",
          "worked": "$$\\begin{align*}9^{3m+1}\\times3^{4m-1}&=3^{6m+2}\\times3^{4m-1}\\\\&=3^{6m+2+4m-1}\\\\&=3^{10m+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$32^n\\div8^{2n}\\div4^{3n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{-7n}$",
          "worked": "$$\\begin{align*}32^n\\div8^{2n}\\div4^{3n}&=2^{5n}\\div2^{6n}\\div2^{6n}\\\\&=2^{5n-6n-6n}\\\\&=2^{-7n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$6^x\\times4^x\\div3^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{3x}$",
          "worked": "$$\\begin{align*}6^x\\times4^x\\div3^x&=2^x\\times3^x\\times2^{2x}\\div3^x\\\\&=2^{x+2x}\\times3^{x-x}\\\\&=2^{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$12^x\\times18^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{3x}\\times3^{3x}$",
          "worked": "$$\\begin{align*}12^x\\times18^x&=2^{2x}\\times3^x\\times2^x\\times3^{2x}\\\\&=2^{2x+x}\\times3^{x+2x}\\\\&=2^{3x}\\times3^{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$24^{x+1}\\times8^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{x+1}\\times2^{3x}$",
          "worked": "$$\\begin{align*}24^{x+1}\\times8^{-1}&=2^{3x+3}\\times3^{x+1}\\times2^{-3}\\\\&=2^{3x+3-3}\\times3^{x+1}\\\\&=3^{x+1}\\times2^{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
