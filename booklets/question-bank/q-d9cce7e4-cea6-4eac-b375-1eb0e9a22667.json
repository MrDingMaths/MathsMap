  "content": {
    "id": "p30-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If $10^x=p$, find the following in terms of $p$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$10^{2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10p^2$",
          "worked": "$$\\begin{align*}10^{2x+1}&=10(10^x)^2\\\\10^{2x+1}&=10p^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$10^{1-3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{p^3}$",
          "worked": "$$\\begin{align*}10^{1-3x}&=10(10^x)^{-3}\\\\10^{1-3x}&=10p^{-3}\\\\10^{1-3x}&=\\frac{10}{p^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
