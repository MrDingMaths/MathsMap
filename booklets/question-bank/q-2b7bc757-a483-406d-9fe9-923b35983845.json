    "id": "p13-p1-question",
    "type": "question",
    "label": "1",
    "prompt": "By first simplifying the expression, differentiate $f(x)=\\frac{x^4-1}{x-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(x)=3x^2+2x+1$ for $x\\ne1$.",
      "worked": "$$\\begin{align*}f(x)&=\\frac{(x-1)(x^3+x^2+x+1)}{x-1}\\\\f(x)&=x^3+x^2+x+1,\\qquad x\\ne1\\\\f'(x)&=3x^2+2x+1,\\qquad x\\ne1.\\end{align*}$$",
      "solutionDiagrams": []
    },
