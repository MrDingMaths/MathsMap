  "content": {
    "id": "v2-86222-p60-practice-slot-10-upper-root",
    "type": "question",
    "label": null,
    "prompt": "$4x^2-24x+31=a(x+b)^2+c$. Find $a,b,c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=4,\\ b=-3,\\ c=-5$",
      "worked": "$$\\begin{align*}4x^2-24x+31&=a(x^2+2bx+b^2)+c\\\\4x^2-24x+31&=ax^2+2abx+ab^2+c\\end{align*}$$\nEquate coefficients and constant terms.\n$$\\begin{align*}a&=4\\\\2ab&=-24\\\\8b&=-24\\\\b&=-3\\\\ab^2+c&=31\\\\4(9)+c&=31\\\\c&=-5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
