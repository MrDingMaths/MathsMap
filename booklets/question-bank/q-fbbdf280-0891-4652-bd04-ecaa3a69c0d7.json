  "content": {
    "id": "p30-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Answer the following questions for the equation $I = 0.43 + 1.1s$\nwhere $I$ is the number of insects caught and $s$ is the area of a spider’s web in $\\text{cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Interpret the meaning of the gradient.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An increase of 1.1 predicted insects caught per $1\\text{ cm}^2$ increase in web area.",
          "worked": "For each additional $1\\text{ cm}^2$ of web area, the predicted number of insects caught increases by 1.1.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p30-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Interpret the meaning of the $y$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "0.43 predicted insects caught when the web area is $0\\text{ cm}^2$.",
          "worked": "When $s = 0$, the equation gives $I = 0.43$. It predicts 0.43 insects caught when the web area is $0\\text{ cm}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p30-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Does the $y$-intercept make sense?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. A web with zero area cannot catch insects.",
          "worked": "No. A web with an area of $0\\text{ cm}^2$ cannot catch insects, so the intercept is not meaningful in this context.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p30-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Is the trendline of the data positive or negative?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Positive.",
          "worked": "Positive, because the gradient $1.1$ is greater than zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p30-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "Determine how many insects are likely to be caught if the area of the web is $60\\text{ cm}^2$.\nGive your answer correct to the nearest whole number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "66 insects",
          "worked": "Let $s = 60$.\n$$\\begin{align*}I &= 0.43 + 1.1(60)\\\\I &= 66.43\\end{align*}$$\nApproximately 66 insects are likely to be caught, to the nearest whole number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
