  "content": {
    "id": "v2-481a5-p20-practice-slot-8-upper-root",
    "type": "question",
    "label": null,
    "prompt": "The line $ax+by-8=0$ is parallel to $3x-2y=5$ and passes through $(2,1)$.\nFind the values of $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=6,\\quad b=-4$.",
      "worked": "The gradient of $3x-2y=5$ is $\\dfrac{3}{2}$, so the parallel line has gradient $\\dfrac{3}{2}$.\n$$\\begin{align*}y-1&=\\frac{3}{2}(x-2)\\\\2y-2&=3x-6\\\\3x-2y-4&=0\\end{align*}$$\nMultiplying by $2$ to match the constant term $-8$:\n$$6x-4y-8=0$$\nSo $a=6$ and $b=-4$. Check: $6(2)-4(1)-8=0$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
