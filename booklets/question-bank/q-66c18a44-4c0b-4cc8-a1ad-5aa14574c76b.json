  "content": {
    "id": "p39-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "For $y>0$, show that $\\dfrac{\\sqrt{18y}}{\\sqrt{2y}}$ is an integer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{\\sqrt{18y}}{\\sqrt{2y}}=\\sqrt9=3$, which is an integer.",
      "worked": "$$\\begin{align*}\\frac{\\sqrt{18y}}{\\sqrt{2y}}&=\\frac{\\sqrt{18}\\sqrt y}{\\sqrt2\\sqrt y}\\\\&=\\sqrt{\\frac{18}{2}}\\\\&=3\\end{align*}$$\nTherefore the expression is an integer.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
