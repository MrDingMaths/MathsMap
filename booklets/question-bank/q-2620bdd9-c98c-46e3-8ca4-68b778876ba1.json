            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}5.5t&=90\\\\t&=\\frac{90}{5.5}\\\\t&=\\frac{180}{11}\\\\t&=16\\frac{4}{11}\\end{align*}",
