  "content": {
    "id": "p77-q21-response",
    "type": "question",
    "label": "21",
    "prompt": "How many minutes pass after 12 noon before the angle between the minute and hour hand is exactly $90^\\circ$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16\\frac{4}{11}$ minutes\n\nThe hands separate at $6-0.5=5.5^\\circ$ per minute, so solve $5.5t=90$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
