            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The angle between them is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "6t^\\circ-0.5t^\\circ=5.5t^\\circ",
                "display": false
