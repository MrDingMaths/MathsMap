      {
        "id": "p24-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "An equilateral triangle has each of its sides 10 cm. Find the area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\sqrt3\\text{ cm}^2$.",
          "worked": "Each angle of an equilateral triangle is $60^\\circ$.\n$$\\begin{align*}\\text{Area}&=\\frac12\\times10\\times10\\times\\sin60^\\circ\\\\\\text{Area}&=50\\times\\frac{\\sqrt3}{2}\\\\\\text{Area}&=25\\sqrt3\\text{ cm}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If the area of the equilateral triangle is $9\\sqrt3\\text{ cm}^2$, find the length of each side.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ cm}$.",
          "worked": "Let each side have length $s$ cm. The included angle is $60^\\circ$.\n$$\\begin{align*}\\frac12s^2\\sin60^\\circ&=9\\sqrt3\\\\\\frac{\\sqrt3}{4}s^2&=9\\sqrt3\\\\s^2&=36\\\\s&=6.\\end{align*}$$\nEach side is $6\\text{ cm}$, taking the positive length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
