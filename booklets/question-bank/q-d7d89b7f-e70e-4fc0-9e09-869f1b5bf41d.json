      {
        "id": "p12-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "The first term of an AP is $a=7$ and the fourth term is $a_4=16$.\n\nUse the formula $a_n=a+(n-1)d$ to find the common difference $d$.\n\nThen write down the first four terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=3$; first four terms: $7,10,13,16$.",
          "worked": "$$\\begin{aligned}a_4&=a+(4-1)d\\\\16&=7+3d\\\\9&=3d\\\\d&=3\\end{aligned}$$\nFirst four terms: $7,10,13,16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the 20th term of an AP with first term 28 and 11th term 108.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{20}=180$.",
          "worked": "$$\\begin{aligned}a_{11}&=a+(11-1)d\\\\108&=28+10d\\\\80&=10d\\\\d&=8\\end{aligned}$$\n$$\\begin{aligned}a_{20}&=a+(20-1)d\\\\a_{20}&=28+19(8)\\\\a_{20}&=180\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the 100th term of an AP with first term 32 and 20th term $-6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{100}=-166$.",
          "worked": "$$\\begin{aligned}a_{20}&=a+(20-1)d\\\\-6&=32+19d\\\\-38&=19d\\\\d&=-2\\end{aligned}$$\n$$\\begin{aligned}a_{100}&=a+(100-1)d\\\\a_{100}&=32+99(-2)\\\\a_{100}&=-166\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
