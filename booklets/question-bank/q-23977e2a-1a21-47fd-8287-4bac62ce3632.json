        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$$\\begin{align*}3(x^{2}+2x+1)&=0\\\\3(x+1)^{2}&=0\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
