        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $2$",
          "worked": "$$\\begin{align*}4(x^{2}-5x+6)&=0\\\\4(x-3)(x-2)&=0\\\\x&=3\\text{ or }2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
