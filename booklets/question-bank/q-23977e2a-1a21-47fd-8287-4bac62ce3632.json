        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}7(x^{2}-10x+25)&=0\\\\7(x-5)^{2}&=0\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$5x^{2}=35-30x$",
        "layout": "list",
