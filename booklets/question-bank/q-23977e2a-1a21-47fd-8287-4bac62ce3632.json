        "children": [],
        "answer": {
          "short": "$x=3$ or $-2$",
          "worked": "$$\\begin{align*}2(x^{2}-x-6)&=0\\\\2(x-3)(x+2)&=0\\\\x&=3\\text{ or }-2\\end{align*}$$",
