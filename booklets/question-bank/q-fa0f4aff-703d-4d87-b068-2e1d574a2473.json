        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q3b-formula",
            "type": "part",
            "label": "",
            "prompt": "Formula for $a$ in terms of $b$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=10\\sqrt{b}$",
              "worked": "$$\\begin{align*}a&=k\\sqrt{b}\\\\30&=k\\sqrt{9}\\\\k&=10\\\\a&=10\\sqrt{b}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
