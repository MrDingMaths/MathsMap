      {
        "id": "p6-q3a",
        "type": "group",
        "label": "a",
        "prompt": "Given that $m\\propto n^2$ and that $m=12$ when $n=2$, find the formula for $m$ in terms of $n$ and the exact value of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q3a-formula",
            "type": "part",
            "label": "",
            "prompt": "Formula for $m$ in terms of $n$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$m=3n^2$",
              "worked": "$$\\begin{align*}m&=kn^2\\\\12&=k\\times2^2\\\\k&=3\\\\m&=3n^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p6-q3a-values",
            "type": "group",
            "label": "",
            "prompt": "",
            "layout": "grid",
            "columns": 2,
            "questionDiagrams": [],
            "children": [
              {
                "id": "p6-q3ai",
                "type": "part",
                "label": "i",
                "prompt": "$m$ when $n=5$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$m=75$",
                  "worked": "$$\\begin{align*}m&=3\\times5^2\\\\m&=75\\end{align*}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 18
              },
              {
                "id": "p6-q3aii",
                "type": "part",
                "label": "ii",
                "prompt": "$n$ when $m=27$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$n=3$",
                  "worked": "$$\\begin{align*}27&=3n^2\\\\n^2&=9\\\\n&=3\\end{align*}$$\nSince $n>0$, take the positive square root.",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 27
              }
            ]
          }
        ]
      },
      {
        "id": "p6-q3b",
        "type": "group",
        "label": "b",
        "prompt": "Given that $a\\propto\\sqrt{b}$ and that $a=30$ when $b=9$, find the formula for $a$ in terms of $b$ and the exact value of:",
