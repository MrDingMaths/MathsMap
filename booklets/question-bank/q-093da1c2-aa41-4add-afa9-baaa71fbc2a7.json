  "content": {
    "id": "p10-q17",
    "type": "question",
    "label": "17",
    "prompt": "A quantity is increased by 20% twice.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Work out the single multiplier that can be used to increase a quantity by 20% twice.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\times1.44$",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=1.2\\times1.2\\\\&=1.44\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why this results in an overall increase of more than 40%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The second 20% applies to the larger amount after the first increase, giving a 44% overall increase.",
          "worked": "The second increase is 20% of 120% of the original, which is 24% of the original. The overall increase is therefore $20\\%+24\\%=44\\%$, greater than 40%.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
