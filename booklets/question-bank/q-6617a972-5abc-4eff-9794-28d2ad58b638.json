  "content": {
    "id": "p26-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Given a six-digit number $328xyz$, find the values of $x$, $y$ and $z$ such that the number is divisible by 3, 4 and 5, and is the smallest six-digit number starting with 328 that has this property. How many other numbers have this property?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p26-q2-short-values",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x=0,\\quad y=2,\\quad z=0",
                "display": false
              },
              {
                "type": "text",
                "text": "; the smallest number is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "328\\,020",
                "display": false
              },
              {
                "type": "text",
                "text": ". There are 16 other numbers.",
                "marks": []
              }
            ]
          },
          {
            "id": "p26-q2-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The qualifying numbers are consecutive multiples of 60, from 328 020 to 328 980.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p26-q2-worked-tests",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Divisibility by 5 requires a last digit of 0 or 5. Divisibility by 4 requires an even last digit, so ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "z=0",
                "display": false
              },
              {
                "type": "text",
                "text": ". The last two digits must be divisible by 4, so ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "y\\in\\{0,2,4,6,8\\}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p26-q2-worked-minimum",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Choose ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=0",
                "display": false
              },
              {
                "type": "text",
                "text": " to make the number as small as possible. With ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "y=0",
                "display": false
              },
              {
                "type": "text",
                "text": ", the digit sum is 13, which is not divisible by 3. The next possible value is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "y=2",
                "display": false
              },
              {
                "type": "text",
                "text": ":",
                "marks": []
              }
            ]
          },
          {
            "id": "p26-q2-worked-digit-sum",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "3+2+8+0+2+0=15",
                "display": true
              }
            ]
          },
          {
            "id": "p26-q2-worked-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Thus the smallest number is 328 020, giving ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=0,\\ y=2,\\ z=0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p26-q2-worked-count-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "A number divisible by both 4 and 5 is a multiple of 20. The first such multiples are 20, 40, 60, …; every third is divisible by 3. Hence the required numbers are multiples of 60. Those starting with 328 run from 328 020 to 328 980.",
                "marks": []
              }
            ]
          },
          {
            "id": "p26-q2-worked-count",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\text{Total count}&=\\frac{328\\,980-328\\,020}{60}+1\\\\\\text{Total count}&=17\\\\\\text{Other numbers}&=17-1\\\\\\text{Other numbers}&=16\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
      },
