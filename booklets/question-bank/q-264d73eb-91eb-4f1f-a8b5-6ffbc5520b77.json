    "difficultyReason": "Translate contextual changes and differences into directed number sentences, then interpret the calculated results."
  },
  "content": {
    "id": "p34-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Model each situation with a number sentence, then calculate the final position or the requested difference.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "From ground level, a lift went down 2 floors, then down another 3 floors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0-2-3=-5$; 5 floors below ground level.",
          "worked": "$$\\begin{align*}0-2-3&=-2-3\\\\0-2-3&=-5\\end{align*}$$\nThe lift is 5 floors below ground level.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p34-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "From ground level, a lift went down 3 floors, then up 5 floors, then down 4 floors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0-3+5-4=-2$; 2 floors below ground level.",
          "worked": "$$\\begin{align*}0-3+5-4&=-3+5-4\\\\0-3+5-4&=2-4\\\\0-3+5-4&=-2\\end{align*}$$\nThe lift is 2 floors below ground level.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p34-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "An Olympian dived 5 metres from a board 3 metres above water level. What is her position now?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-5=-2$; 2 m below water level.",
          "worked": "$$\\begin{align*}3-5&=-2\\end{align*}$$\nShe is 2 m below water level.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p34-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "A submarine at sea level dived 50 metres, then dived another 26 m, then rose 32 metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0-50-26+32=-44$; 44 m below sea level.",
          "worked": "$$\\begin{align*}0-50-26+32&=-76+32\\\\0-50-26+32&=-44\\end{align*}$$\nThe submarine is 44 m below sea level.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p34-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "In Norway the highest recorded temperature is $35^\\circ\\mathrm{C}$ and the lowest is $-26^\\circ\\mathrm{C}$. What is the difference between temperatures?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35-(-26)=61$; a difference of $61^\\circ\\mathrm{C}$.",
          "worked": "$$\\begin{align*}35-(-26)&=35+26\\\\35-(-26)&=61\\end{align*}$$\nThe temperature difference is $61^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p34-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "The lowest point in Japan is Lake Hachirogata at $-4$ m and the highest point is Mt Fujiyama at 3776 m. What is the height difference?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3776-(-4)=3780$; a height difference of 3780 m.",
          "worked": "$$\\begin{align*}3776-(-4)&=3776+4\\\\3776-(-4)&=3780\\end{align*}$$\nThe height difference is 3780 m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
