      {
        "id": "p35-q28-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\sqrt{3},\\sqrt{12},\\sqrt{27},\\ldots$ is an arithmetic sequence.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The common difference is $\\sqrt{3}$, so the sequence is arithmetic.",
          "worked": "$$\\begin{aligned}\\sqrt{3},\\sqrt{12},\\sqrt{27}&=\\sqrt{3},2\\sqrt{3},3\\sqrt{3}\\\\a_3-a_2&=3\\sqrt{3}-2\\sqrt{3}\\\\&=\\sqrt{3}\\\\a_2-a_1&=2\\sqrt{3}-\\sqrt{3}\\\\&=\\sqrt{3}\\end{aligned}$$\nThe common difference is $d=\\sqrt{3}$, so the sequence is arithmetic.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p35-q28-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the 50th term in simplest form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\sqrt{3}$",
          "worked": "$a=\\sqrt{3}$ and $d=\\sqrt{3}$.\n$$\\begin{aligned}a_{50}&=a+49d\\\\&=\\sqrt{3}+49\\sqrt{3}\\\\&=50\\sqrt{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
