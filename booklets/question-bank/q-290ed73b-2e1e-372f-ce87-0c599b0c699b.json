  "content": {
    "id": "p52-q36-group-root",
    "type": "question",
    "label": "13",
    "prompt": "Simplify the following sets and write the result as a single interval.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q36-root",
        "type": "part",
        "label": "a",
        "prompt": "$$(-\\infty,3]\\cap(-\\infty,1]$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,1]$",
          "worked": "The common points satisfy both $x\\le3$ and $x\\le1$, so they are exactly the points with $x\\le1$.\n$$(-\\infty,3]\\cap(-\\infty,1]=(-\\infty,1].$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q37-root",
        "type": "part",
        "label": "b",
        "prompt": "$$(1,\\infty)\\cup(-5,5]$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-5,\\infty)$",
          "worked": "The intervals overlap on $(1,5]$ and together contain every real number greater than $-5$. The endpoint $-5$ is excluded.\n$$(1,\\infty)\\cup(-5,5]=(-5,\\infty).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p52-q38-root",
        "type": "part",
        "label": "c",
        "prompt": "$$(4,9]\\cap[2,7)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,7)$",
          "worked": "The common points satisfy $4<x<7$. The first interval excludes $4$ and the second excludes $7$.\n$$(4,9]\\cap[2,7)=(4,7).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q39-root",
        "type": "part",
        "label": "d",
        "prompt": "$$[2,8)\\cup(3,4]$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[2,8)$",
          "worked": "Every point of $(3,4]$ already belongs to $[2,8)$, so the union adds no points.\n$$[2,8)\\cup(3,4]=[2,8).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q40-root",
        "type": "part",
        "label": "e",
        "prompt": "$$(-\\infty,1]\\cup[0,\\infty)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,\\infty)$",
          "worked": "The intervals overlap on $[0,1]$. Together they contain every real number.\n$$(-\\infty,1]\\cup[0,\\infty)=(-\\infty,\\infty).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
