  "content": {
    "id": "p13-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The Secure Locksmith Company had sales last year of $\\$568\\,000$ and costs of $\\$521\\,000$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "What was their profit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$47\\,000$",
          "worked": "$$\\begin{align*}\\text{Profit}&=\\text{sales}-\\text{costs}\\\\\\text{Profit}&=568\\,000-521\\,000\\\\\\text{Profit}&=\\$47\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "What was the profit as a percentage of the cost price? (Calculate the percentage correct to 2 decimal places.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9.02\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage profit}&=\\frac{\\text{profit}}{\\text{cost price}}\\times100\\%\\\\\\text{Percentage profit}&=\\frac{47\\,000}{521\\,000}\\times100\\%\\\\\\text{Percentage profit}&\\approx9.02\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "In the previous year, they made a loss of $4\\%$ of their costs of $\\$250\\,000$. Find their loss and their sales.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Loss: $\\$10\\,000$; sales: $\\$240\\,000$.",
          "worked": "$$\\begin{align*}\\text{Loss}&=250\\,000\\times4\\%\\\\\\text{Loss}&=250\\,000\\times0.04\\\\\\text{Loss}&=\\$10\\,000\\end{align*}$$\n$$\\begin{align*}\\text{Sales}&=\\text{costs}-\\text{loss}\\\\\\text{Sales}&=250\\,000-10\\,000\\\\\\text{Sales}&=\\$240\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
