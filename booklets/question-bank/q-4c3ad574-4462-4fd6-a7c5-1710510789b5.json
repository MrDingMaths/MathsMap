        "label": "a",
        "prompt": "$4\\frac{1}{2}$ hours to minutes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "270 minutes",
          "worked": "$$\\begin{align*}4\\tfrac{1}{2}\\text{ hours}&=(4\\times60+\\tfrac{1}{2}\\times60)\\text{ minutes}\\\\4\\tfrac{1}{2}\\text{ hours}&=270\\text{ minutes}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "289 minutes to hours and minutes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 hours 49 minutes",
          "worked": "$$289\\div60=4\\text{ remainder }49$$\n\nThere are 60 minutes in an hour, so 289 minutes is 4 hours 49 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{4}$ of a year to months",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 months",
          "worked": "There are 12 months in a year.\n\n$$\\tfrac{3}{4}\\times12=9\\text{ months}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "1 week to hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "168 hours",
          "worked": "$$\\begin{align*}1\\text{ week}&=7\\text{ days}\\\\1\\text{ week}&=(7\\times24)\\text{ hours}\\\\1\\text{ week}&=168\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
