        "id": "p17-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $A\\cap B$ does not contain any elements.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The sets are disjoint: they have no elements in common.",
          "worked": "The circles do not overlap, so no element belongs to both $A$ and $B$. Therefore $A\\cap B=\\varnothing$; the sets are disjoint (mutually exclusive).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Give an example of two possible sets $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\{\\text{even numbers}\\}$, $B=\\{\\text{odd numbers}\\}$.",
          "worked": "For example, let $A$ be the set of even numbers and $B$ the set of odd numbers. No number is both even and odd, so $A\\cap B=\\varnothing$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
