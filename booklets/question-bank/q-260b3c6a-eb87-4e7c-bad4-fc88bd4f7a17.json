  "content": {
    "id": "p25-q8-response",
    "type": "question",
    "label": "8",
    "prompt": "Connor uses a microwave oven to reheat a meal.\nThe time taken (in minutes) for heating is inversely proportional to the power setting.\nThe meal takes 3 minutes at a power setting of $60\\%$.\nHow long would it take at a power setting of $80\\%$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "2 min 15 sec",
      "worked": "Let $t$ be the time in minutes and $P$ the power setting expressed as a percentage number.\n$$\\begin{align*}t&=\\frac{k}{P}\\\\3&=\\frac{k}{60}\\\\k&=180\\\\t&=\\frac{180}{P}\\\\t&=\\frac{180}{80}\\\\t&=2.25\\end{align*}$$\n$0.25\\times60=15$ seconds, so the meal takes 2 min 15 sec.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 49
  },
