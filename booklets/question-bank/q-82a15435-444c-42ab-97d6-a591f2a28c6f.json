  "content": {
    "id": "p6-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "In a particular mathematics class, 55% of the students are boys. When five more boys join the class, 64% of the students are now boys. How many students were originally in the class?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
