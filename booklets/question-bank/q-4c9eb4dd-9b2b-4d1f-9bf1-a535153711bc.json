        "label": "a",
        "prompt": "$3+\\sqrt2,\\ 3-\\sqrt2,\\ 3\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "Let $f$ be the base diagonal and $d$ the long diagonal.\n$$\\begin{align*}f^2&=(3+\\sqrt2)^2+(3-\\sqrt2)^2\\\\f^2&=(11+6\\sqrt2)+(11-6\\sqrt2)\\\\f^2&=22\\\\d^2&=f^2+(3\\sqrt3)^2\\\\d^2&=22+27\\\\d&=7.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p41-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "$5+\\sqrt3,\\ 5-\\sqrt3,\\ 2\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "Let $f$ be the base diagonal and $d$ the long diagonal.\n$$\\begin{align*}f^2&=(5+\\sqrt3)^2+(5-\\sqrt3)^2\\\\f^2&=(28+10\\sqrt3)+(28-10\\sqrt3)\\\\f^2&=56\\\\d^2&=f^2+(2\\sqrt2)^2\\\\d^2&=56+8\\\\d&=8.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
