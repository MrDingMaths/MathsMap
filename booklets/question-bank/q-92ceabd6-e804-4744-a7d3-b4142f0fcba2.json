  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Write $y=\\sqrt{x}$ as a power of $x$, then show that $\\dfrac{dy}{dx}=\\dfrac{1}{2\\sqrt{x}}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=x^{\\frac12}$; $\\dfrac{dy}{dx}=\\dfrac{1}{2\\sqrt{x}}$.",
      "worked": "$$\\begin{aligned}y&=x^{\\frac12}\\\\\\frac{dy}{dx}&=\\frac12x^{-\\frac12}\\\\\\frac{dy}{dx}&=\\frac12\\times\\frac{1}{\\sqrt{x}}\\\\\\frac{dy}{dx}&=\\frac{1}{2\\sqrt{x}}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
