  "content": {
    "id": "p61-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "A group of four people A, B, C and D are to be split into two groups of two. Jimmy claims that the answer is $^{4}C_{2}\\times{}^{2}C_{2}=6$: first choose two people out of four to go into one group, then the remaining two people become the other group, by default.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p61-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "By listing the possible combinations, how many possible ways can the four people be split into two groups of two?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{A,B\\}\\text{ and }\\{C,D\\}$; $\\{A,C\\}\\text{ and }\\{B,D\\}$; $\\{A,D\\}\\text{ and }\\{B,C\\}$. There are $3$ ways.",
          "worked": "The distinct splits are:\n$$\\begin{aligned}&\\{A,B\\}\\text{ and }\\{C,D\\}\\\\&\\{A,C\\}\\text{ and }\\{B,D\\}\\\\&\\{A,D\\}\\text{ and }\\{B,C\\}.\\end{aligned}$$\nThere are $3$ ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
