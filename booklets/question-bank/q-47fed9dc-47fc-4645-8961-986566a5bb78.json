  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "In a circle, chords $AB$ and $CD$ intersect at $E$. Given $AE:BE=1:4$ and $CE:DE=4:9$, find the ratio $AB:CD$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AB:CD=15:13$.\n\nUse the intersecting-chords product to relate the scales of the two given ratios.",
      "worked": "Let $AE=x$, $BE=4x$, $CE=4y$ and $DE=9y$, where $x,y>0$. By the Power of a Point Theorem,\n$$\\begin{align*}AE\\times BE&=CE\\times DE\\\\x(4x)&=(4y)(9y)\\\\4x^2&=36y^2\\\\x^2&=9y^2\\\\x&=3y.\\end{align*}$$\nTherefore,\n$$\\begin{align*}AB:CD&=5x:13y\\\\AB:CD&=5(3y):13y\\\\AB:CD&=15:13.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 84
  },
