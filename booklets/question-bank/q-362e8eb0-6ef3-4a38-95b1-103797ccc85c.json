  "content": {
    "id": "v2-1e81b-p72-practice-j9-100327-root",
    "type": "question",
    "label": null,
    "prompt": "Let $A=2^3\\times3\\times5$, $B=2^2\\times3^2\\times7$ and $C=2\\times3\\times5^2$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1e81b-p72-practice-j9-100327-j9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $A$, $B$ and $C$ using the same prime bases $2,3,5,7$, including zero powers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=2^3\\cdot3^1\\cdot5^1\\cdot7^0$, $B=2^2\\cdot3^2\\cdot5^0\\cdot7^1$, $C=2^1\\cdot3^1\\cdot5^2\\cdot7^0$",
          "worked": "$$\\begin{align*}A&=2^3\\cdot3^1\\cdot5^1\\cdot7^0\\\\B&=2^2\\cdot3^2\\cdot5^0\\cdot7^1\\\\C&=2^1\\cdot3^1\\cdot5^2\\cdot7^0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-1e81b-p72-practice-j9-100327-j9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the HCF of $A$, $B$ and $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\operatorname{HCF}(A,B,C)&=2^1\\cdot3^1\\cdot5^0\\cdot7^0\\\\&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-1e81b-p72-practice-j9-100327-j9-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the LCM of $A$, $B$ and $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\,600$",
          "worked": "$$\\begin{align*}\\operatorname{LCM}(A,B,C)&=2^3\\cdot3^2\\cdot5^2\\cdot7^1\\\\&=8\\times9\\times25\\times7\\\\&=12\\,600\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
