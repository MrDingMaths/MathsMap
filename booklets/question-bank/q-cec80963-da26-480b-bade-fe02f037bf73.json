        "id": "p19-q13-part1",
        "type": "part",
        "label": "",
        "prompt": "What is the mean number of hours of sport played by the students per week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Estimated mean: $4.3$ hours per week.",
          "worked": "The class centres are $1$, $4$, $7$ and $10$ hours.\n$$\\begin{align*}\\sum cc\\times f &= 1\\times5+4\\times10+7\\times3+10\\times2\\\\&=86\\\\\\bar{x} &= \\frac{86}{20}\\\\&=4.3\\text{ hours per week}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
