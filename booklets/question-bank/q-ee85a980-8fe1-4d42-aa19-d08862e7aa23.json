  "content": {
    "id": "p22-q42-root",
    "type": "question",
    "label": "",
    "prompt": "Let $y=\\dfrac{9x^2-4}{3x-2}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q42-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y=3x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x+2$ for $x\\ne\\dfrac23$. Factorise the numerator and cancel the common factor.",
          "worked": "$$\\begin{align*}y&=\\dfrac{9x^2-4}{3x-2}\\\\y&=\\dfrac{(3x-2)(3x+2)}{3x-2}\\\\y&=3x+2\\qquad\\left(x\\ne\\dfrac23\\right).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q42-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find $y'$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3$ for $x\\ne\\dfrac23$.",
          "worked": "$$\\begin{align*}y'&=\\dfrac{d}{dx}(3x+2)\\\\y'&=3\\qquad\\left(x\\ne\\dfrac23\\right).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
