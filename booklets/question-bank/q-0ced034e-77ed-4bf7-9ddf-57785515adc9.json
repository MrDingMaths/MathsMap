  "content": {
    "id": "p10-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A box containing a light bulb has a chance of $\\frac{1}{15}$ of holding a defective bulb.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "If 120 boxes were checked, how many would you expect to hold defective bulbs?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8 boxes",
          "worked": "$$\\begin{aligned}f&=np\\\\&=120\\times\\frac{1}{15}\\\\&=8\\end{aligned}$$\nExpect 8 boxes to hold defective bulbs.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p10-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that the box holds a bulb that works?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14}{15}$",
          "worked": "$$\\begin{aligned}P(\\text{works})&=1-P(\\text{defective})\\\\&=1-\\frac{1}{15}\\\\&=\\frac{14}{15}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
