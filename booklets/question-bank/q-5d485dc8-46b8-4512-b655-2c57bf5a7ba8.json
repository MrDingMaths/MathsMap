    "type": "question",
    "label": null,
    "prompt": "The number of visitors to a museum increased by 12% in one year. The next year, the number of visitors decreased by 5%. What was the overall percentage change in the number of visitors?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "6.4% increase",
      "worked": "$$\\begin{align*}\\text{Combined multiplier}&=1.12\\times0.95\\\\&=1.064\\\\\\text{Overall increase}&=106.4\\%-100\\%\\\\&=6.4\\%\\end{align*}$$\nOverall percentage increase of $6.4\\%$.",
      "solutionDiagrams": []
    },
