  "content": {
    "id": "p11-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "State in each case whether or not $A\\subseteq B$ (that is, whether $A$ is a subset of $B$).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\{2,3,5\\},\\quad B=\\{1,2,3,4,5,6,7,8,9\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Each of $2$, $3$ and $5$ is in $B$, so $A\\subseteq B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\{3,6,9,12\\},\\quad B=\\{3,5,9,11\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False; $6$ and $12$ are not in $B$.",
          "worked": "False. $6$ and $12$ are elements of $A$ but are not in $B$, so $A\\nsubseteq B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$A=\\{d,a,n,c,e\\},\\quad B=\\{e,d,u,c,a,t,i,o,n\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Every letter in $A$ is also in $B$, so $A\\subseteq B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$A=\\{a,m,y\\},\\quad B=\\{s,a,r,a,h\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False; $m$ and $y$ are not in $B$.",
          "worked": "False. $m$ and $y$ are elements of $A$ but are not in $B$, so $A\\nsubseteq B$. The repeated $a$ in $B$ represents only one element.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "$A=\\varnothing,\\quad B=\\{51,52,53,54\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True; the empty set is a subset of every set.",
          "worked": "True. The empty set is a subset of every set, so $\\varnothing\\subseteq B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
