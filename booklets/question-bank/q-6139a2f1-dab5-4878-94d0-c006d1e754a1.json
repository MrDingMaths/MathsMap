  "content": {
    "id": "p26-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "By first rationalising the denominators, simplify each expression.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt2}+\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3\\sqrt2}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt2}+\\sqrt2&=\\frac{1}{\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}+\\sqrt2\\\\\\frac{1}{\\sqrt2}+\\sqrt2&=\\frac{\\sqrt2}{2}+\\frac{2\\sqrt2}{2}\\\\\\frac{1}{\\sqrt2}+\\sqrt2&=\\frac{3\\sqrt2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2}{\\sqrt3}+\\frac{3}{2\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7\\sqrt3}{6}$",
          "worked": "$$\\begin{align*}\\frac{2}{\\sqrt3}+\\frac{3}{2\\sqrt3}&=\\frac{2}{\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}+\\frac{3}{2\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}\\\\\\frac{2}{\\sqrt3}+\\frac{3}{2\\sqrt3}&=\\frac{2\\sqrt3}{3}+\\frac{\\sqrt3}{2}\\\\\\frac{2}{\\sqrt3}+\\frac{3}{2\\sqrt3}&=\\frac{4\\sqrt3+3\\sqrt3}{6}\\\\\\frac{2}{\\sqrt3}+\\frac{3}{2\\sqrt3}&=\\frac{7\\sqrt3}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{5\\sqrt2}{3}-\\frac{1}{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5\\sqrt2-\\sqrt3}{3}$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt2}{3}-\\frac{1}{\\sqrt3}&=\\frac{5\\sqrt2}{3}-\\frac{1}{\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}\\\\\\frac{5\\sqrt2}{3}-\\frac{1}{\\sqrt3}&=\\frac{5\\sqrt2}{3}-\\frac{\\sqrt3}{3}\\\\\\frac{5\\sqrt2}{3}-\\frac{1}{\\sqrt3}&=\\frac{5\\sqrt2-\\sqrt3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{4\\sqrt5}{\\sqrt2}-\\frac{2\\sqrt5}{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{10}$",
          "worked": "$$\\begin{align*}\\frac{4\\sqrt5}{\\sqrt2}-\\frac{2\\sqrt5}{\\sqrt2}&=\\frac{4\\sqrt5}{\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}-\\frac{2\\sqrt5}{\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}\\\\\\frac{4\\sqrt5}{\\sqrt2}-\\frac{2\\sqrt5}{\\sqrt2}&=2\\sqrt{10}-\\sqrt{10}\\\\\\frac{4\\sqrt5}{\\sqrt2}-\\frac{2\\sqrt5}{\\sqrt2}&=\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{\\sqrt{72}}{\\sqrt3}+\\frac{3}{\\sqrt2}-\\frac{2}{2\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt6+\\sqrt2$\n\nRationalise each denominator, simplify the roots and collect like surds.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{72}}{\\sqrt3}+\\frac{3}{\\sqrt2}-\\frac{2}{2\\sqrt2}&=\\frac{\\sqrt{72}\\sqrt3}{3}+\\frac{3\\sqrt2}{2}-\\frac{2\\sqrt2}{4}\\\\\\frac{\\sqrt{72}}{\\sqrt3}+\\frac{3}{\\sqrt2}-\\frac{2}{2\\sqrt2}&=\\frac{6\\sqrt6}{3}+\\frac{3\\sqrt2}{2}-\\frac{\\sqrt2}{2}\\\\\\frac{\\sqrt{72}}{\\sqrt3}+\\frac{3}{\\sqrt2}-\\frac{2}{2\\sqrt2}&=2\\sqrt6+\\frac{2\\sqrt2}{2}\\\\\\frac{\\sqrt{72}}{\\sqrt3}+\\frac{3}{\\sqrt2}-\\frac{2}{2\\sqrt2}&=2\\sqrt6+\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1}{\\sqrt3}+\\frac{2}{\\sqrt3}+\\frac{7}{2\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13\\sqrt3}{6}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt3}+\\frac{2}{\\sqrt3}+\\frac{7}{2\\sqrt3}&=\\frac{\\sqrt3}{3}+\\frac{2\\sqrt3}{3}+\\frac{7\\sqrt3}{6}\\\\\\frac{1}{\\sqrt3}+\\frac{2}{\\sqrt3}+\\frac{7}{2\\sqrt3}&=\\frac{2\\sqrt3+4\\sqrt3+7\\sqrt3}{6}\\\\\\frac{1}{\\sqrt3}+\\frac{2}{\\sqrt3}+\\frac{7}{2\\sqrt3}&=\\frac{13\\sqrt3}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
