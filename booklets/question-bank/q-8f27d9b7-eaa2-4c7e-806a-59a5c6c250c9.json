  "content": {
    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The farmers in a particular region of China planted $45\\,000$ hectares of farmland with sorghum in 2005. By 2010, the area had increased by $24\\%$. Find the area planted with sorghum in 2010.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$55\\,800$ hectares",
      "worked": "$$\\begin{align*}\\text{Increase in area}&=\\frac{24}{100}\\times45\\,000\\\\\\text{Increase in area}&=10\\,800\\text{ hectares}\\\\\\text{Area in 2010}&=45\\,000+10\\,800\\\\\\text{Area in 2010}&=55\\,800\\text{ hectares}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
