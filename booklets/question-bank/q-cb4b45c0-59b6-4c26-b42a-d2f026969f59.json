      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "List the first ten multiples of $9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9, 18, 27, 36, 45, 54, 63, 72, 81, 90$",
          "worked": "Multiply $9$ by each whole number from $1$ to $10$:\n$9, 18, 27, 36, 45, 54, 63, 72, 81, 90$.",
