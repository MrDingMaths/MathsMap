  "content": {
    "id": "p18-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The measures of the angles in a quadrilateral are in the ratio $3:4:5:6$. Find the measure of the largest angle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$120^{\\circ}$",
      "worked": "Let the angles be $3x$, $4x$, $5x$ and $6x$ degrees. The interior angles of a quadrilateral sum to $360^{\\circ}$.\n$$\\begin{align*}3x+4x+5x+6x&=360\\\\18x&=360\\\\x&=20\\end{align*}$$\nThe largest angle is $6\\times20^{\\circ}=120^{\\circ}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
