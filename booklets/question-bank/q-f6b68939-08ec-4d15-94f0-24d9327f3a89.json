  "content": {
    "id": "v2-9a430-p49-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "The remainder when $x^2+4x-7$ is divided by $(x-c)$ is $5$.\nFind the values of $c$ and hence the divisors.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c=-6$ or $2$; divisors $x+6$ or $x-2$.",
      "worked": "By the remainder theorem,\n$\\begin{aligned}c^2+4c-7&=5\\\\c^2+4c-12&=0\\\\(c+6)(c-2)&=0\\\\c&=-6\\text{ or }2\\end{aligned}$\nThe divisors are $x+6$ or $x-2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
