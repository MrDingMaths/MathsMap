        "label": "a",
        "prompt": "$y^5+5y^4(x-y)+10y^3(x-y)^2+10y^2(x-y)^3+5y(x-y)^4+(x-y)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}y^5+5y^4(x-y)+10y^3(x-y)^2+10y^2(x-y)^3+5y(x-y)^4+(x-y)^5\\\\&=(y+(x-y))^5\\\\&=x^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^3+3x^2(2y-x)+3x(2y-x)^2+(2y-x)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8y^3$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}x^3+3x^2(2y-x)+3x(2y-x)^2+(2y-x)^3\\\\&=(x+(2y-x))^3\\\\&=(2y)^3\\\\&=8y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
