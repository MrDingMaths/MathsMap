  "content": {
    "id": "p35-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The rate of increase of a population $P$ of green and purple flying bugs is proportional to the excess of the population over $2000$, that is, $\\dfrac{dP}{dt}=k(P-2000)$, for some constant $k$. Initially the population is $3000$, and three weeks later the population is $8000$. Let $t$ be the time in weeks.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $P=2000+Ae^{kt}$ satisfies the differential equation, where $A$ is constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dP}{dt}=Ake^{kt}=k(P-2000)$, so the differential equation is satisfied.",
          "worked": "$$\\begin{align*}P&=2000+Ae^{kt}\\\\\\frac{dP}{dt}&=Ake^{kt}\\end{align*}$$\nAlso,\n$$\\begin{align*}k(P-2000)&=k(2000+Ae^{kt}-2000)\\\\&=k(Ae^{kt})\\\\&=Ake^{kt}.\\end{align*}$$\nThus $\\dfrac{dP}{dt}=k(P-2000)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p35-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "By substituting $t=0$ and $t=3$, find the values of $A$ and $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=1000$, $k=\\dfrac{\\ln 6}{3}$.",
          "worked": "At $t=0$,\n$$\\begin{align*}3000&=2000+Ae^0\\\\A&=1000.\\end{align*}$$\nAt $t=3$,\n$$\\begin{align*}8000&=2000+1000e^{3k}\\\\6000&=1000e^{3k}\\\\e^{3k}&=6\\\\3k&=\\ln 6\\\\k&=\\frac{\\ln 6}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p35-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the population after seven weeks, correct to the nearest ten bugs.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$67\\,420$ bugs.",
          "worked": "Using $k=\\dfrac{\\ln 6}{3}$,\n$$\\begin{align*}P(7)&=2000+1000e^{7k}\\\\&=2000+1000\\times6^{7/3}\\\\&\\approx67\\,420\\text{ bugs}\\quad\\text{(nearest ten).}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p35-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Find when the population reaches $500\\,000$, correct to the nearest $0.1$ weeks.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10.4$ weeks.",
          "worked": "$$\\begin{align*}500\\,000&=2000+1000e^{kt}\\\\498\\,000&=1000e^{kt}\\\\e^{kt}&=498\\\\kt&=\\ln 498\\\\t&=\\frac{\\ln 498}{k}\\\\&=\\frac{3\\ln 498}{\\ln 6}\\\\&\\approx10.4\\text{ weeks}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
