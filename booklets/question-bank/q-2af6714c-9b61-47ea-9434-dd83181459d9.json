  "content": {
    "id": "p53-q41-root",
    "type": "question",
    "label": "14",
    "prompt": "Let $A=\\{1,2,3,4\\}$ and $B=\\{3,4,5,6,7,8,9\\}$. List the following sets.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q41-paired-row",
        "type": "group",
        "label": null,
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p53-q41-a",
            "type": "part",
            "label": "a",
            "prompt": "$A\\cup B$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\{1,2,3,4,5,6,7,8,9\\}$",
              "worked": "Collect the distinct elements occurring in either set.\n$$A\\cup B=\\{1,2,3,4,5,6,7,8,9\\}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p53-q41-b",
            "type": "part",
            "label": "b",
            "prompt": "$A\\cap B$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\{3,4\\}$",
              "worked": "The elements common to both sets are $3$ and $4$.\n$$A\\cap B=\\{3,4\\}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p53-q41-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\{c\\in A\\cup B\\text{ where }c\\text{ is even}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{2,4,6,8\\}$",
          "worked": "$A\\cup B=\\{1,2,3,4,5,6,7,8,9\\}$. Its even elements form $\\{2,4,6,8\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p53-q41-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\{S\\text{ where }S\\subseteq A\\cap B\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{\\varnothing,\\{3\\},\\{4\\},\\{3,4\\}\\}$",
          "worked": "$A\\cap B=\\{3,4\\}$. Include its empty subset, each singleton and the whole set:\n$$\\{\\varnothing,\\{3\\},\\{4\\},\\{3,4\\}\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p53-q41-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\{X\\subseteq A\\text{ where }1\\in X\\text{ and }4\\notin X\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{\\{1\\},\\{1,2\\},\\{1,3\\},\\{1,2,3\\}\\}$",
          "worked": "Include $1$ and exclude $4$. Independently include or omit $2$ and $3$, giving\n$$\\{\\{1\\},\\{1,2\\},\\{1,3\\},\\{1,2,3\\}\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
