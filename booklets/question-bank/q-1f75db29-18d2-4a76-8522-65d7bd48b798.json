      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{45}+\\sqrt{80}-\\sqrt{72}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\sqrt5-6\\sqrt2$",
          "worked": "$$\\begin{align*}\\sqrt{45}+\\sqrt{80}-\\sqrt{72}&=\\sqrt{9\\cdot5}+\\sqrt{16\\cdot5}-\\sqrt{36\\cdot2}\\\\\\sqrt{45}+\\sqrt{80}-\\sqrt{72}&=3\\sqrt5+4\\sqrt5-6\\sqrt2\\\\\\sqrt{45}+\\sqrt{80}-\\sqrt{72}&=7\\sqrt5-6\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$3\\sqrt{24}+6\\sqrt{150}-5\\sqrt{54}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21\\sqrt6$",
          "worked": "$$\\begin{align*}3\\sqrt{24}+6\\sqrt{150}-5\\sqrt{54}&=3(2\\sqrt6)+6(5\\sqrt6)-5(3\\sqrt6)\\\\3\\sqrt{24}+6\\sqrt{150}-5\\sqrt{54}&=6\\sqrt6+30\\sqrt6-15\\sqrt6\\\\3\\sqrt{24}+6\\sqrt{150}-5\\sqrt{54}&=21\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p10-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{4+\\sqrt{12}}2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\sqrt3$",
          "worked": "$$\\begin{align*}\\frac{4+\\sqrt{12}}2&=\\frac{4+2\\sqrt3}{2}\\\\\\frac{4+\\sqrt{12}}2&=2+\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2\\sqrt6\\times3\\sqrt7}{12\\sqrt{21}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2}{2}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt6\\times3\\sqrt7}{12\\sqrt{21}}&=\\frac{6\\sqrt{42}}{12\\sqrt{21}}\\\\\\frac{2\\sqrt6\\times3\\sqrt7}{12\\sqrt{21}}&=\\frac12\\sqrt{\\frac{42}{21}}\\\\\\frac{2\\sqrt6\\times3\\sqrt7}{12\\sqrt{21}}&=\\frac{\\sqrt2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
