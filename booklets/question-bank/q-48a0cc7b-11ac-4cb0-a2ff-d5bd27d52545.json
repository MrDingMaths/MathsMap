        "type": "part",
        "label": "a",
        "prompt": "The ratio of the width to the length of a rectangular courtyard is $3:8$. The width is 12 m. Find the perimeter of the courtyard.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$88\\text{ m}$",
          "worked": "$$\\begin{align*}3\\text{ parts}&=12\\text{ m}\\\\1\\text{ part}&=12\\div3=4\\text{ m}\\\\8\\text{ parts}&=8\\times4=32\\text{ m}\\\\P&=2(12+32)\\\\P&=88\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-56345-p39-practice-retro-slot-3-225344-retro-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The ratio of the length to the width of a rectangular poster is $7:4$. The length is 35 cm. Find the area of the poster.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$700\\text{ cm}^2$",
          "worked": "$$\\begin{align*}7\\text{ parts}&=35\\text{ cm}\\\\1\\text{ part}&=35\\div7=5\\text{ cm}\\\\4\\text{ parts}&=4\\times5=20\\text{ cm}\\\\A&=35\\times20\\\\A&=700\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
