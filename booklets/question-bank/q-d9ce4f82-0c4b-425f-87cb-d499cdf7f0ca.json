  "content": {
    "id": "p12-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The sum of a collection of positive integers, with repetition allowed, is $20$. Find the maximum value of their product, and prove that this is indeed the maximum value achievable.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p12-q10-short-result",
            "type": "paragraph",
