    "id": "p48-q5",
    "type": "question",
    "label": "5",
    "prompt": "Find the value of $p$ for which the quadratic equation $x^2+2x+p=0$ has one solution.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=1$",
      "worked": "Exactly one real solution requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=2^2-4(1)(p)\\\\0&=4-4p\\\\4p&=4\\\\p&=1\\end{align*}$$",
      "solutionDiagrams": []
    },
