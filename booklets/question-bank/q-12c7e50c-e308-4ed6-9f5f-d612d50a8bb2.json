  "content": {
    "id": "p22-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Three friends decide to divide $\\$12\\,000$ amongst them in the ratio $1:2:3$. How much does each receive?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$2000$, $\\$4000$ and $\\$6000$, respectively.",
      "worked": "There are $1+2+3=6$ parts in total.\n$$\\begin{align*}\\text{Value of one part}&=\\$12\\,000\\div6\\\\\\text{Value of one part}&=\\$2000\\\\\\text{First share}&=1\\times\\$2000=\\$2000\\\\\\text{Second share}&=2\\times\\$2000=\\$4000\\\\\\text{Third share}&=3\\times\\$2000=\\$6000\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
