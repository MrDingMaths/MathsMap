  "content": {
    "id": "p37-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Show that among four points on a circle, three of them lie on a semicircle. Hint: Draw a diameter through one of the points.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "A diameter through one chosen point divides the circle into two semicircles. By the pigeonhole principle, one contains at least two of the other three points. Together with the chosen endpoint, these give three points on that semicircle.",
      "worked": "Draw a diameter through one chosen point $P$. Its endpoints belong to both semicircles.\n\nAssign each of the other three points to a semicircle containing it, assigning any point on the diameter to just one semicircle. There are three points and two semicircles, so the pigeonhole principle guarantees that one semicircle contains at least two of these points.\n\nThat semicircle also contains $P$ on its boundary. Hence at least three of the four points lie on one semicircle.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
