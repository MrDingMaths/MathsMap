  "content": {
    "id": "p14-p2-root",
    "type": "question",
    "label": "2",
    "prompt": "Let $f(x)$ and $g(x)$ both be even functions. Define the function\n$$h(x)=f(x)+g(x).$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-p2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $h(-x)=f(x)+g(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h(-x)=f(-x)+g(-x)=f(x)+g(x)$.",
          "worked": "Since $f$ and $g$ are even, $f(-x)=f(x)$ and $g(-x)=g(x)$.\n$$\\begin{align*}h(-x)&=f(-x)+g(-x)\\\\h(-x)&=f(x)+g(x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p14-p2-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, what kind of function is $h(x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even.",
          "worked": "$h(-x)=f(x)+g(x)=h(x)$, so $h$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
