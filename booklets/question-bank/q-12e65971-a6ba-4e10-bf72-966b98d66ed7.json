    "children": [
      {
        "id": "p59-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$xe^{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12e^{x^2}+C$",
          "worked": "The inner function is $x^2$, with derivative $2x$.\n$$\\begin{aligned}\\int xe^{x^2}\\,dx&=\\frac12\\int 2xe^{x^2}\\,dx\\\\&=\\frac12e^{x^2}+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p59-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$4xe^{x^2-7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2e^{x^2-7}+C$",
          "worked": "The inner function is $x^2-7$, with derivative $2x$.\n$$\\begin{aligned}\\int 4xe^{x^2-7}\\,dx&=2\\int 2xe^{x^2-7}\\,dx\\\\&=2e^{x^2-7}+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p59-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the primitives of $(2x-3)e^{4x^2-12x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14e^{4x^2-12x}+C$",
          "worked": "The inner function is $4x^2-12x$, with derivative $8x-12=4(2x-3)$.\n$$\\begin{aligned}\\int(2x-3)e^{4x^2-12x}\\,dx&=\\frac14\\int(8x-12)e^{4x^2-12x}\\,dx\\\\&=\\frac14e^{4x^2-12x}+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p59-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x^2-2x)e^{x^3-3x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13e^{x^3-3x^2}+C$",
          "worked": "The inner function is $x^3-3x^2$, with derivative $3x^2-6x=3(x^2-2x)$.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int(x^2-2x)e^{x^3-3x^2}\\,dx\\\\&=\\frac13\\int(3x^2-6x)e^{x^3-3x^2}\\,dx\\\\&=\\frac13e^{x^3-3x^2}+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p59-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^{-2}e^{x^{-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-e^{x^{-1}}+C$",
          "worked": "The inner function is $x^{-1}$, with derivative $-x^{-2}$.\n$$\\begin{aligned}\\int x^{-2}e^{x^{-1}}\\,dx&=-\\int(-x^{-2})e^{x^{-1}}\\,dx\\\\&=-e^{x^{-1}}+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p59-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$-\\sqrt{x}e^{-x\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23e^{-x\\sqrt{x}}+C$",
          "worked": "The inner function is $-x\\sqrt{x}=-x^{3/2}$, with derivative $-\\frac32\\sqrt{x}$.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int-\\sqrt{x}e^{-x\\sqrt{x}}\\,dx\\\\&=\\frac23\\int\\left(-\\frac32\\sqrt{x}\\right)e^{-x\\sqrt{x}}\\,dx\\\\&=\\frac23e^{-x\\sqrt{x}}+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
