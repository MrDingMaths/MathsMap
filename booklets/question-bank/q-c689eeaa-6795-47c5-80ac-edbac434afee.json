        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p80-q8-c-supplied-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The mode, size ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "7",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", sold most frequently and helps the owner decide which size to stock more of.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The mode is most useful. Size $7$ was sold five times, more than any other size. It identifies the size with the greatest observed demand and helps the owner decide which size to stock more of.",
