              "latex": "S=10\\log_{10}\\frac{I}{I_0}",
              "display": true
            }
          ]
        },
        {
          "id": "p36-q6-definitions",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "S",
              "display": false
            },
            {
              "type": "text",
              "text": " is the sound intensity level in decibels, and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{I}{I_0}",
              "display": false
            },
            {
              "type": "text",
              "text": " is the ratio of sound intensity to the reference intensity at the threshold of human hearing.",
              "marks": []
            }
          ]
        },
        {
          "id": "p36-q6-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Find ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{I}{I_0}",
              "display": false
            },
            {
              "type": "text",
              "text": " for each sound.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q6-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p36-q6-a-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Normal conversation",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "60 dB",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{I}{I_0}=1\\,000\\,000$.",
          "worked": "$$\\begin{align*}60&=10\\log_{10}\\frac{I}{I_0}\\\\6&=\\log_{10}\\frac{I}{I_0}\\\\\\frac{I}{I_0}&=10^6=1\\,000\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p36-q6-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p36-q6-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Whispering",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "20 dB",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{I}{I_0}=100$.",
          "worked": "$$\\begin{align*}20&=10\\log_{10}\\frac{I}{I_0}\\\\2&=\\log_{10}\\frac{I}{I_0}\\\\\\frac{I}{I_0}&=10^2=100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p36-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the intensity ratio of a 60 dB sound to a 20 dB sound?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\,000:1$; the 60 dB sound has $10\\,000$ times the intensity.",
          "worked": "$$\\begin{align*}\\frac{I_{60}}{I_{20}}&=\\frac{10^6}{10^2}\\\\\\frac{I_{60}}{I_{20}}&=10^4\\\\\\frac{I_{60}}{I_{20}}&=10\\,000\\end{align*}$$\nThe 60 dB sound has $10\\,000$ times the intensity of the 20 dB sound.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
