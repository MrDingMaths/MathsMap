  "content": {
    "id": "p15-q35-root",
    "type": "question",
    "label": null,
    "prompt": "Given $g(x)=x^2+x+1$, find the value of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q35-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "$$\\begin{align*}g(3)&=3^2+3+1\\\\g(3)&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q35-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}g(-2)&=(-2)^2+(-2)+1\\\\g(-2)&=4-2+1\\\\g(-2)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q35-c",
        "type": "part",
        "label": "c",
        "prompt": "$g\\left(\\dfrac{1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{4}$",
          "worked": "$$\\begin{align*}g\\left(\\frac{1}{2}\\right)&=\\left(\\frac{1}{2}\\right)^2+\\frac{1}{2}+1\\\\g\\left(\\frac{1}{2}\\right)&=\\frac{1}{4}+\\frac{2}{4}+\\frac{4}{4}\\\\g\\left(\\frac{1}{2}\\right)&=\\frac{7}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
