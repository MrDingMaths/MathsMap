  "content": {
    "id": "v2-x-topic-8-practice-slot-12-root",
    "type": "question",
    "label": null,
    "prompt": "Find the missing numbers.\n\n$\\left(3x^{\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}}\\right)^{\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}}=81x^{20}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\left( 3x^{5} \\right)^{4}$\n\nWrite $81=3^4$ to find the outer index, then solve $4m=20$ for the inner index.",
      "worked": "$81=3^4$, so the outside exponent is $4$. The inside exponent satisfies $4m=20$, so $m=5$. Thus $(3x^5)^4=81x^{20}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
