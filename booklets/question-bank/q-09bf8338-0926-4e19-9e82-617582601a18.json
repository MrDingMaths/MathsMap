            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Use ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\tan^2\\theta=\\sec^2\\theta-1",
                "display": false
              },
              {
                "type": "text",
                "text": " and isolate ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\sec^2\\theta",
                "display": false
              },
              {
                "type": "text",
                "text": ". Both signs are needed because no quadrant is specified.",
                "marks": []
              }
            ]
          },
          {
            "id": "p19-q75-short-exception",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "If ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a+b=a+c=0",
                "display": false
              },
              {
                "type": "text",
                "text": ", any value with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "0<|\\cos\\theta|\\le1",
                "display": false
