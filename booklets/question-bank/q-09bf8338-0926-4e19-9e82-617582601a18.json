  "content": {
    "id": "p19-q75-response",
    "type": "question",
    "label": "75",
    "prompt": "Let $a\\tan^2\\theta+b\\sec^2\\theta=c$. Express $\\cos\\theta$ in terms of $a$, $b$ and $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
