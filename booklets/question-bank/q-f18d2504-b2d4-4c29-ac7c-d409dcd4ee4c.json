  "content": {
    "id": "p80-q32-response",
    "type": "question",
    "label": "32",
    "prompt": "What is the smallest non-zero multiple of 2, 4, 7 and 8 which is a square?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$784$. The LCM is $2^3\\times7$; multiply by $2\\times7$ to make both indices even.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p80-q32-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\operatorname{LCM}(2,4,7,8)=2^3\\times7",
                "display": false,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p80-q32-answer-reason",
            "type": "paragraph",
            "fontSize": null,
