                "latex": "2\\times7",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " to raise the indices from 3 and 1 to 4 and 2, the next even indices. This gives the smallest square multiple.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
