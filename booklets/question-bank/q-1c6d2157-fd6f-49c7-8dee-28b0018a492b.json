  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Suppose $\\cos\\theta=0.6$. Find each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\left(\\frac{\\pi}{2}-\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.6$",
          "worked": "$$\\begin{align*}\\sin\\left(\\frac{\\pi}{2}-\\theta\\right)&=\\cos\\theta\\\\\\sin\\left(\\frac{\\pi}{2}-\\theta\\right)&=0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin\\left(\\frac{\\pi}{2}+\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.6$",
          "worked": "$$\\begin{align*}\\sin\\left(\\frac{\\pi}{2}+\\theta\\right)&=\\sin\\left(\\pi-\\left(\\frac{\\pi}{2}-\\theta\\right)\\right)\\\\\\sin\\left(\\frac{\\pi}{2}+\\theta\\right)&=\\sin\\left(\\frac{\\pi}{2}-\\theta\\right)\\\\\\sin\\left(\\frac{\\pi}{2}+\\theta\\right)&=\\cos\\theta\\\\\\sin\\left(\\frac{\\pi}{2}+\\theta\\right)&=0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p11-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\left(\\frac{3\\pi}{2}-\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.6$",
          "worked": "$$\\begin{align*}\\sin\\left(\\frac{3\\pi}{2}-\\theta\\right)&=\\sin\\left(\\pi+\\left(\\frac{\\pi}{2}-\\theta\\right)\\right)\\\\\\sin\\left(\\frac{3\\pi}{2}-\\theta\\right)&=-\\sin\\left(\\frac{\\pi}{2}-\\theta\\right)\\\\\\sin\\left(\\frac{3\\pi}{2}-\\theta\\right)&=-\\cos\\theta\\\\\\sin\\left(\\frac{3\\pi}{2}-\\theta\\right)&=-0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p11-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\left(\\frac{5\\pi}{2}+\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.6$",
          "worked": "$$\\begin{align*}\\sin\\left(\\frac{5\\pi}{2}+\\theta\\right)&=\\sin\\left(\\frac{\\pi}{2}+\\theta\\right)\\\\\\sin\\left(\\frac{5\\pi}{2}+\\theta\\right)&=\\sin\\left(\\pi-\\left(\\frac{\\pi}{2}-\\theta\\right)\\right)\\\\\\sin\\left(\\frac{5\\pi}{2}+\\theta\\right)&=\\sin\\left(\\frac{\\pi}{2}-\\theta\\right)\\\\\\sin\\left(\\frac{5\\pi}{2}+\\theta\\right)&=\\cos\\theta\\\\\\sin\\left(\\frac{5\\pi}{2}+\\theta\\right)&=0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
