    "children": [
      {
        "id": "p30-q7",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin15^\\circ\\cos15^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "$$\\begin{align*}\\sin15^\\circ\\cos15^\\circ&=\\frac12\\sin30^\\circ\\\\\\sin15^\\circ\\cos15^\\circ&=\\frac12\\times\\frac12\\\\\\sin15^\\circ\\cos15^\\circ&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p30-q8",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin^2 15^\\circ-\\cos^2 15^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\sin^2 15^\\circ-\\cos^2 15^\\circ&=-(\\cos^2 15^\\circ-\\sin^2 15^\\circ)\\\\\\sin^2 15^\\circ-\\cos^2 15^\\circ&=-\\cos30^\\circ\\\\\\sin^2 15^\\circ-\\cos^2 15^\\circ&=-\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q9",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{\\tan22.5^\\circ}{1-\\tan^2 22.5^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\frac{\\tan22.5^\\circ}{1-\\tan^2 22.5^\\circ}&=\\frac12\\tan(2\\times22.5^\\circ)\\\\\\frac{\\tan22.5^\\circ}{1-\\tan^2 22.5^\\circ}&=\\frac12\\tan45^\\circ\\\\\\frac{\\tan22.5^\\circ}{1-\\tan^2 22.5^\\circ}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p30-q10",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac12-\\sin^2 22.5^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\frac12-\\sin^2 22.5^\\circ&=\\frac12(1-2\\sin^2 22.5^\\circ)\\\\\\frac12-\\sin^2 22.5^\\circ&=\\frac12\\cos45^\\circ\\\\\\frac12-\\sin^2 22.5^\\circ&=\\frac12\\times\\frac{\\sqrt2}{2}\\\\\\frac12-\\sin^2 22.5^\\circ&=\\frac{\\sqrt2}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
