  "content": {
    "id": "p9-task-31-34-content",
    "type": "question",
    "label": null,
    "prompt": "Write the following in the form $y = k(a^{x})$ or $y = k(a^{-x})$, where $a > 1$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-part-31",
        "type": "part",
        "label": "a",
        "prompt": "$y = 10^{3x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 10(1000^{x})$",
          "worked": "$$\\begin{align*}y &= 10^{3x}\\times 10^{1}\\\\y &= (10^{3})^{x}\\times 10\\\\y &= 10(1000^{x})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-part-32",
        "type": "part",
        "label": "b",
        "prompt": "$y = 3^{2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 9(3^{-x})$",
          "worked": "$$\\begin{align*}y &= 3^{2}\\times 3^{-x}\\\\y &= 9(3^{-x})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-part-33",
        "type": "part",
        "label": "c",
        "prompt": "$y = \\dfrac{2^{x}}{6^{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 3^{-x}$",
          "worked": "$$\\begin{align*}y &= \\left(\\frac{2}{6}\\right)^{x}\\\\y &= \\left(\\frac{1}{3}\\right)^{x}\\\\y &= 3^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-part-34",
        "type": "part",
        "label": "d",
        "prompt": "$y = 3^{x}5^{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 25(15^{x})$",
          "worked": "$$\\begin{align*}y &= 3^{x}\\times 5^{x}\\times 5^{2}\\\\y &= 25(3\\times 5)^{x}\\\\y &= 25(15^{x})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
