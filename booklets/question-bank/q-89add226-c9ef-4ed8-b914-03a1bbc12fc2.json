  "content": {
    "id": "p22-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A rectangular piece of land measures 260 m by 430 m. Calculate the area of the land in:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "square metres",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$111800\\text{ m}^2$",
          "worked": "$$\\begin{aligned}A&=260\\times430\\\\&=111800\\text{ m}^2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "hectares",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11.18\\text{ ha}$",
          "worked": "One hectare is $10000\\text{ m}^2$.\n$$\\begin{aligned}A&=111800\\div10000\\\\&=11.18\\text{ ha}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
