  "content": {
    "id": "v2-1479f-p27-practice-retro-slot-1-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Write the equation of the circle that has a diameter with endpoints $(-3,2)$ and $(5,6)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-1)^2+(y-4)^2=20$",
      "worked": "The centre is the midpoint of the diameter:\n$$\\begin{align*}\\text{centre}&=\\left(\\frac{-3+5}{2},\\frac{2+6}{2}\\right)\\\\&=(1,4)\\end{align*}$$\nThe radius is the distance from the centre to $(5,6)$:\n$$\\begin{align*}r^2&=(5-1)^2+(6-4)^2\\\\&=16+4\\\\&=20\\end{align*}$$\nUsing $(x-a)^2+(y-b)^2=r^2$:\n$$\\begin{align*}(x-1)^2+(y-4)^2&=20\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
