  "content": {
    "id": "p39-q58-root",
    "type": "question",
    "label": "58",
    "prompt": "Let $f(\\theta)=8\\cos^2\\theta+6\\sin\\theta\\cos\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q58-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $f(\\theta)$ in terms of $\\sin2\\theta$ and $\\cos2\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(\\theta)=4+4\\cos2\\theta+3\\sin2\\theta$.",
          "worked": "$$\\begin{align*}f(\\theta)&=8\\left(\\frac{1+\\cos2\\theta}{2}\\right)+6\\left(\\frac{\\sin2\\theta}{2}\\right)\\\\f(\\theta)&=4+4\\cos2\\theta+3\\sin2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p39-q58-b",
        "type": "part",
        "label": "b",
        "prompt": "Deduce constants $A,B,\\alpha$ with $0<\\alpha<\\frac\\pi2$ such that\n$$f(\\theta)=A+B\\cos(2\\theta-\\alpha).$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=4$, $B=5$, $\\alpha=\\tan^{-1}\\left(\\frac34\\right)$.",
          "worked": "Equating coefficients gives $A=4$, $B\\cos\\alpha=4$ and $B\\sin\\alpha=3$. Since $\\alpha$ is in the first quadrant, $B>0$.\n$$\\begin{align*}B&=\\sqrt{4^2+3^2}=5\\\\\\tan\\alpha&=\\frac34\\\\\\alpha&=\\tan^{-1}\\left(\\frac34\\right).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p39-q58-c",
        "type": "part",
        "label": "c",
        "prompt": "State the maximum and minimum values of $f(\\theta)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Maximum $9$; minimum $-1$.",
          "worked": "Since $-1\\le\\cos(2\\theta-\\alpha)\\le1$, the maximum is $4+5=9$ and the minimum is $4-5=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
