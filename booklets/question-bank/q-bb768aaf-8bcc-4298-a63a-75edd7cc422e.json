  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A rubbish bin is in the shape of an open cylinder.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "If the bin has radius $15\\text{ cm}$ and height $40\\text{ cm}$, find its total surface area (do not include the lid), correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1425\\pi\\text{ cm}^2\\approx4476.8\\text{ cm}^2$",
          "worked": "The open bin has one circular base and a curved surface.\n\n$$\\begin{align*}A_{\\text{curved}}&=2\\pi rh\\\\A_{\\text{curved}}&=2\\times\\pi\\times15\\times40\\\\A_{\\text{curved}}&=1200\\pi\\text{ cm}^2\\end{align*}$$\n\n$$\\begin{align*}A_{\\text{base}}&=\\pi r^2\\\\A_{\\text{base}}&=\\pi\\times15^2\\\\A_{\\text{base}}&=225\\pi\\text{ cm}^2\\end{align*}$$\n\n$$\\begin{align*}S&=1200\\pi+225\\pi\\\\S&=1425\\pi\\text{ cm}^2\\\\S&\\approx4476.8\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "If the bin has radius $15\\text{ cm}$ and curved surface area $3500\\text{ cm}^2$, find the height of the bin, correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{350}{3\\pi}\\text{ cm}\\approx37.1\\text{ cm}$",
          "worked": "$$\\begin{align*}A_{\\text{curved}}&=2\\pi rh\\\\3500&=2\\times\\pi\\times15\\times h\\\\3500&=30\\pi h\\\\h&=\\frac{3500}{30\\pi}\\\\h&=\\frac{350}{3\\pi}\\text{ cm}\\\\h&\\approx37.1\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
