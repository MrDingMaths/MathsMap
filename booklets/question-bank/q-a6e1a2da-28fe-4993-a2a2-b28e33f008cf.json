  "content": {
    "id": "p15-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A square of side length $14\\text{ mm}$ can just fit inside a circle of diameter $20\\text{ mm}$. Find the approximate value of the area of the circle that is not covered by the square. Use $\\pi\\approx3.14$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately $118\\text{ mm}^2$.",
      "worked": "$$\\begin{align*}r&=20\\div2\\\\r&=10\\text{ mm}\\\\A_{\\text{circle}}&=\\pi\\times10^2\\\\A_{\\text{circle}}&\\approx314\\text{ mm}^2\\\\A_{\\text{square}}&=14\\times14\\\\A_{\\text{square}}&=196\\text{ mm}^2\\\\A_{\\text{uncovered}}&=A_{\\text{circle}}-A_{\\text{square}}\\\\A_{\\text{uncovered}}&\\approx314-196\\\\A_{\\text{uncovered}}&\\approx118\\text{ mm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
