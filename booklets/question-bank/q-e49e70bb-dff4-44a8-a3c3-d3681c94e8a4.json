  "content": {
    "id": "p25-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A ship is 300 km from port on a bearing of $070^\\circ\\text{T}$. A second ship is 400 km from the same port and on a bearing of $140^\\circ\\text{T}$. How far apart, correct to the nearest kilometre, are the two ships?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$410\\text{ km}$",
      "worked": "The included angle at the port is $140^\\circ-70^\\circ=70^\\circ$. Let the distance between the ships be $d$ km.\n$$\\begin{align*}d^2&=300^2+400^2-2\\times300\\times400\\cos70^\\circ\\\\d&=\\sqrt{300^2+400^2-2\\times300\\times400\\cos70^\\circ}\\\\d&\\approx410\\text{ km}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
