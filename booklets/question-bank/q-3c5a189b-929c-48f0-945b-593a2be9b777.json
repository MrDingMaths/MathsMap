  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Given $h(x)=\\frac{2}{x+3}$ and $m(x)=4x-1$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-g",
        "type": "part",
        "label": "a",
        "prompt": "$h(m(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2x+1}$",
          "worked": "$$\\begin{align*}h(m(x))&=\\frac{2}{(4x-1)+3}\\\\h(m(x))&=\\frac{2}{4x+2}\\\\h(m(x))&=\\frac{1}{2x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q10-h",
        "type": "part",
        "label": "b",
        "prompt": "$m(h(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5-x}{x+3}$",
          "worked": "$$\\begin{align*}m(h(x))&=4\\left(\\frac{2}{x+3}\\right)-1\\\\m(h(x))&=\\frac{8-(x+3)}{x+3}\\\\m(h(x))&=\\frac{5-x}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q10-i",
        "type": "part",
        "label": "c",
        "prompt": "$h(h(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x+6}{3x+11}$",
          "worked": "$$\\begin{align*}h(h(x))&=\\frac{2}{\\frac{2}{x+3}+3}\\\\h(h(x))&=\\frac{2(x+3)}{2+3(x+3)}\\\\h(h(x))&=\\frac{2x+6}{3x+11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
