  "content": {
    "id": "p57-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The population $P$ of cats on Snake Island is $P=1000e^{0.4t}$, where $t$ is the time in years after time zero when the population was first estimated.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the rate at which the population is increasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dP}{dt}=400e^{0.4t}$ cats per year.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "e1d2c4b3-c60c-463e-b46a-d7643652b8f3",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\frac{dP}{dt}&=1000(0.4)e^{0.4t}\\\\&=400e^{0.4t}\\end{align*}",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "The population is increasing at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "400e^{0.4t}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " cats per year.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p57-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the population, and the rate of increase, when $t=5$, both correct to 2 s.f.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(5)\\approx7.4\\times10^3$ cats; $P'(5)\\approx3.0\\times10^3$ cats per year.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "5963a40d-d680-41c6-88cd-44e5149e35dc",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}P(5)&=1000e^{0.4(5)}\\\\&\\approx7.4\\times10^3\\text{ cats}\\\\P'(5)&=400e^{0.4(5)}\\\\&\\approx3.0\\times10^3\\text{ cats per year}\\end{align*}",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "Both answers are correct to 2 significant figures.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p57-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "When will the cat population reach $20\\,000$ cats, correct to one decimal place?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\dfrac{5}{2}\\ln20\\approx7.5$ years.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "916e4703-6214-4924-a627-efb8ea75a7dc",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}1000e^{0.4t}&=20\\,000\\\\e^{0.4t}&=20\\\\0.4t&=\\ln20\\\\t&=\\frac{\\ln20}{0.4}\\\\&\\approx7.5\\text{ years}\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p57-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "When will the rate of increase reach $20\\,000$ cats per year, correct to one decimal place?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\dfrac{5}{2}\\ln50\\approx9.8$ years.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "8be626f4-2e5f-4be2-abf7-03719fddd41d",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}400e^{0.4t}&=20\\,000\\\\e^{0.4t}&=50\\\\0.4t&=\\ln50\\\\t&=\\frac{\\ln50}{0.4}\\\\&\\approx9.8\\text{ years}\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
