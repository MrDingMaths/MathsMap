  "content": {
    "id": "p26-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Convert these fractions to decimals.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{7}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.7$",
          "worked": "Tenths give one decimal place.\n$$\\begin{align*}\\frac{7}{10}&=0.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{9}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9$",
          "worked": "Tenths give one decimal place.\n$$\\begin{align*}\\frac{9}{10}&=0.9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{31}{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.31$",
          "worked": "Hundredths give two decimal places.\n$$\\begin{align*}\\frac{31}{100}&=0.31\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{79}{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.79$",
          "worked": "Hundredths give two decimal places.\n$$\\begin{align*}\\frac{79}{100}&=0.79\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{121}{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.21$",
          "worked": "There are 100 hundredths in one whole.\n$$\\begin{align*}\\frac{121}{100}&=1+\\frac{21}{100}\\\\\\frac{121}{100}&=1.21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{329}{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.29$",
          "worked": "There are 100 hundredths in one whole.\n$$\\begin{align*}\\frac{329}{100}&=3+\\frac{29}{100}\\\\\\frac{329}{100}&=3.29\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{123}{1000}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.123$",
          "worked": "Thousandths give three decimal places.\n$$\\begin{align*}\\frac{123}{1000}&=0.123\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{3}{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.03$",
          "worked": "Three hundredths has a zero in the tenths place.\n$$\\begin{align*}\\frac{3}{100}&=0.03\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
