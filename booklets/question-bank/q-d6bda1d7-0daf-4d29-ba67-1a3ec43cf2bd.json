  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The cost $C$ dollars of hiring a reception room for a function is given by the formula $C=12n+250$, where $n$ is the number of people attending the function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange the formula to make $n$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac{C-250}{12}$",
          "worked": "$$\\begin{align*}C&=12n+250\\\\C-250&=12n\\\\n&=\\frac{C-250}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p12-q2-b",
        "type": "group",
        "label": "b",
        "prompt": "How many people attended the function if the cost of hiring the reception room was:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q2-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\$730$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "40 people",
              "worked": "$$\\begin{align*}n&=\\frac{730-250}{12}\\\\n&=\\frac{480}{12}\\\\n&=40\\end{align*}$$\n\n40 people attended.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          },
          {
            "id": "p12-q2-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\$1090$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "70 people",
              "worked": "$$\\begin{align*}n&=\\frac{1090-250}{12}\\\\n&=\\frac{840}{12}\\\\n&=70\\end{align*}$$\n\n70 people attended.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          },
          {
            "id": "p12-q2-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\$1210$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "80 people",
              "worked": "$$\\begin{align*}n&=\\frac{1210-250}{12}\\\\n&=\\frac{960}{12}\\\\n&=80\\end{align*}$$\n\n80 people attended.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          },
          {
            "id": "p12-q2-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$\\$1690$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "120 people",
              "worked": "$$\\begin{align*}n&=\\frac{1690-250}{12}\\\\n&=\\frac{1440}{12}\\\\n&=120\\end{align*}$$\n\n120 people attended.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          }
        ]
      }
