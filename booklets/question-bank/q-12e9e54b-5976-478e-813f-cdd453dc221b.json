    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q1-5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos(\\alpha+\\beta)=\\cos\\alpha+\\cos\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. The cosine sum expansion is $\\cos(\\alpha+\\beta)=\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin(\\alpha+\\beta)=\\sin\\alpha+\\sin\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. The sine sum expansion is $\\sin(\\alpha+\\beta)=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-5-c",
        "type": "part",
        "label": "c",
        "prompt": "If $\\tan\\alpha\\tan\\beta=1$, then $\\tan(\\alpha+\\beta)$ is undefined.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. In $\\tan(\\alpha+\\beta)=\\dfrac{\\tan\\alpha+\\tan\\beta}{1-\\tan\\alpha\\tan\\beta}$, the denominator is $1-1=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-5-d",
        "type": "part",
        "label": "d",
        "prompt": "If $\\cos(\\alpha-\\beta)=0$, then $\\cos\\alpha\\cos\\beta=\\sin\\alpha\\sin\\beta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. $$\\begin{align*}\\cos(\\alpha-\\beta)&=\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\\\0&=\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\\\\\cos\\alpha\\cos\\beta&=-\\sin\\alpha\\sin\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-5-e",
        "type": "part",
        "label": "e",
        "prompt": "If $\\sin(\\alpha-\\beta)=0$, then $\\sin\\alpha\\cos\\beta=\\cos\\alpha\\sin\\beta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. $$\\begin{align*}\\sin(\\alpha-\\beta)&=\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\\\0&=\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\\\\\sin\\alpha\\cos\\beta&=\\cos\\alpha\\sin\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
