  "content": {
    "id": "p26-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the value of $t$ such that the vectors are parallel.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\begin{pmatrix}3\\\\t\\end{pmatrix}$ and $\\begin{pmatrix}9\\\\12\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=4$",
          "worked": "For parallel vectors, $2\\begin{pmatrix}3\\\\t\\end{pmatrix}=k\\begin{pmatrix}9\\\\12\\end{pmatrix}$.\n$$\\begin{aligned}6&=9k\\\\k&=\\frac23\\\\2t&=12\\left(\\frac23\\right)\\\\2t&=8\\\\t&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p26-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\begin{pmatrix}t\\\\4\\end{pmatrix}+\\begin{pmatrix}2\\\\-1\\end{pmatrix}$ and $\\begin{pmatrix}12\\\\9\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2$",
          "worked": "$$\\begin{aligned}\\begin{pmatrix}t\\\\4\\end{pmatrix}+\\begin{pmatrix}2\\\\-1\\end{pmatrix}&=\\begin{pmatrix}t+2\\\\3\\end{pmatrix}\\end{aligned}$$\nFor parallel vectors, $\\begin{pmatrix}t+2\\\\3\\end{pmatrix}=k\\begin{pmatrix}12\\\\9\\end{pmatrix}$.\n$$\\begin{aligned}3&=9k\\\\k&=\\frac13\\\\t+2&=12\\left(\\frac13\\right)\\\\t+2&=4\\\\t&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
