  "content": {
    "id": "v2-3f2b3d-p9-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "A bag contains only red, green and yellow marbles. A marble is chosen at random.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-3f2b3d-p9-practice-slot-1-slot1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The ratio of red to green marbles is $3:5$ and there are no yellow marbles. Find the probability that the marble is green.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "The ratio $3:5$ means $3x$ red and $5x$ green marbles, so $8x$ marbles altogether.\n$$\\begin{align*}P(\\text{green})&=\\frac{5x}{8x}\\\\&=\\frac{5}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-3f2b3d-p9-practice-slot-1-slot1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The ratio of red to green marbles is $2:3$ and the ratio of green to yellow marbles is $6:5$. Find the probability that the marble is yellow.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "Write the red to green ratio with green as 6: $2:3=4:6$.\n\nSo red : green : yellow $=4:6:5$, with $15$ parts altogether.\n$$\\begin{align*}P(\\text{yellow})&=\\frac{5}{15}\\\\&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
