  "content": {
    "id": "v2-6f68a-p52-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "Over summer, the volume of water in a dam is expected to fall by 35% from its starting volume of 2400 ML.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-6f68a-p52-practice-slot-8-slot-8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the expected volume at the end of summer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1560\\text{ ML}$",
          "worked": "$$\\begin{align*}\\text{Multiplier}&=(100-35)\\div100\\\\\\text{Multiplier}&=0.65\\\\\\text{Expected volume}&=2400\\times0.65\\\\\\text{Expected volume}&=1560\\text{ ML}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-6f68a-p52-practice-slot-8-slot-8-b",
        "type": "part",
        "label": "b",
        "prompt": "The actual volume at the end of summer is 230 ML less than expected. What percentage of the starting volume has been lost? Give your answer to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$44.58\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Actual volume}&=1560-230\\\\\\text{Actual volume}&=1330\\text{ ML}\\\\\\text{Change}&=1330-2400\\\\\\text{Change}&=-1070\\text{ ML}\\\\\\%\\text{ change}&=\\frac{-1070}{2400}\\times100\\%\\\\\\%\\text{ change}&\\approx-44.58\\%\\end{align*}$$\nThe volume has decreased by $44.58\\%$ of its starting volume.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
