  "content": {
    "id": "p20-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The weight of a single muesli bar is $x$ grams.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the weight of 4 bars? Write an expression.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x$ grams",
          "worked": "$$\\begin{align*}4\\times x&=4x\\end{align*}$$\nThe weight is $4x$ grams.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "If Jamila buys $n$ bars, what is the total weight of her purchase?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$nx$ grams",
          "worked": "$$\\begin{align*}n\\times x&=nx\\end{align*}$$\nThe total weight is $nx$ grams.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Jamila’s cousin Roland buys twice as many bars as Jamila.\nWhat is the total weight of Roland’s purchase?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2nx$ grams",
          "worked": "Roland buys $2n$ bars.\n$$\\begin{align*}2n\\times x&=2nx\\end{align*}$$\nThe total weight is $2nx$ grams.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
