  "content": {
    "id": "p19-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Calculate the amount to which $\\$20\\,000$ grows if invested for 5 years at 3% p.a. interest, compounded monthly. Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$23\\,232.34$",
      "worked": "$$\\begin{align*}r &= \\frac{0.03}{12}=0.0025\\\\n &= 5\\times12=60\\\\FV &= PV(1+r)^n\\\\FV &= 20\\,000(1+0.0025)^{60}\\\\FV &\\approx \\$23\\,232.34\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
