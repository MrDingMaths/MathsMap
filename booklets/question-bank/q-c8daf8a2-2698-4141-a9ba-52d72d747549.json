  "content": {
    "id": "p26-q9-root",
    "type": "question",
    "label": null,
    "prompt": "Use a similar technique to the above question to solve the following inequalities.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x-3)(x+2)<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2<x<3$",
          "worked": "The graph of $y=(x-3)(x+2)$ opens upwards and crosses the $x$-axis at $x=-2$ and $x=3$. It lies below the axis between its intercepts, so $-2<x<3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+4)(x-5)\\ge0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le-4$ or $x\\ge5$",
          "worked": "The graph of $y=(x+4)(x-5)$ opens upwards and crosses the $x$-axis at $x=-4$ and $x=5$. It is on or above the axis outside these intercepts, so $x\\le-4$ or $x\\ge5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2-x)(x+1)\\le0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le-1$ or $x\\ge2$",
          "worked": "The graph of $y=(2-x)(x+1)$ opens downwards and crosses the $x$-axis at $x=-1$ and $x=2$. It is on or below the axis outside these intercepts, so $x\\le-1$ or $x\\ge2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$(1-2x)(1+x)>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1<x<\\frac12$",
          "worked": "The graph of $y=(1-2x)(1+x)$ opens downwards and crosses the $x$-axis at $x=-1$ and $x=\\frac12$. It lies above the axis between its intercepts, so $-1<x<\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p26-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x-2)(2x-4)\\le0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}(x-2)(2x-4)&=2(x-2)^2\\end{align*}$$\nThe upward-opening parabola touches the $x$-axis at $x=2$ and is otherwise above it. Hence it is on or below the axis only when $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-x-2)(x+2)>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "$$\\begin{align*}(-x-2)(x+2)&=-(x+2)^2\\end{align*}$$\nThe downward-opening parabola touches the $x$-axis at $x=-2$ and is otherwise below it. It is never above the axis, so there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
