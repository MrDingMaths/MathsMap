    "children": [
      {
        "id": "v2-d44-p63-foundation-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Which player scores more points on average? Support your answer using a summary statistic.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Kiara has the higher mean: $17$ points compared with Lena's $\\approx15.83$ points.",
          "worked": "$$\\begin{align*}\\bar{x}_{\\text{Kiara}}&=\\frac{14+22+9+17+25+11+18+20}{8}\\\\\\bar{x}_{\\text{Kiara}}&=\\frac{136}{8}\\\\\\bar{x}_{\\text{Kiara}}&=17\\\\\\bar{x}_{\\text{Lena}}&=\\frac{15+17+16+14+18+15}{6}\\\\\\bar{x}_{\\text{Lena}}&=\\frac{95}{6}\\\\\\bar{x}_{\\text{Lena}}&\\approx15.83\\end{align*}$$\n\nKiara scores more points on average because her mean is higher.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-d44-p63-foundation-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Which player is more consistent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Lena has the smaller range: $4$ points compared with Kiara's $16$ points.",
          "worked": "$$\\begin{align*}\\text{Range of Kiara}&=25-9\\\\\\text{Range of Kiara}&=16\\\\\\text{Range of Lena}&=18-14\\\\\\text{Range of Lena}&=4\\end{align*}$$\n\nLena is more consistent because her scores have the smaller range.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
