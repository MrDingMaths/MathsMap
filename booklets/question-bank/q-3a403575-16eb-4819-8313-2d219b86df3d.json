    "type": "question",
    "label": "5",
    "prompt": "Evaluate each expression for $x=-\\frac{3}{4}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\frac{1}{4}$",
          "worked": "$$\\begin{align*}3x&=3\\times\\left(-\\frac34\\right)\\\\3x&=-\\frac94\\\\3x&=-2\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac34$",
          "worked": "$$\\begin{align*}-x&=-\\left(-\\frac34\\right)\\\\-x&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\frac34$",
          "worked": "$$\\begin{align*}x-3&=-\\frac34-3\\\\x-3&=-\\frac{15}{4}\\\\x-3&=-3\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p6-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}4x&=4\\times\\left(-\\frac34\\right)\\\\4x&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-x)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{27}{64}$",
          "worked": "$$\\begin{align*}(-x)^3&=\\left(-\\left(-\\frac34\\right)\\right)^3\\\\(-x)^3&=\\left(\\frac34\\right)^3\\\\(-x)^3&=\\frac{27}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$-x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{27}{64}$",
          "worked": "$$\\begin{align*}-x^3&=-\\left(-\\frac34\\right)^3\\\\-x^3&=-\\left(-\\frac{27}{64}\\right)\\\\-x^3&=\\frac{27}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-q5-g",
        "type": "part",
