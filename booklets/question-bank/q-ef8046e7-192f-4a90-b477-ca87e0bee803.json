    "children": [
      {
        "id": "p16-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\binom{a+b+c}{a}\\binom{b+c}{b}=\\frac{(a+b+c)!}{a!b!c!}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\binom{a+b+c}{a}\\binom{b+c}{b}=\\frac{(a+b+c)!}{a!(b+c)!}\\frac{(b+c)!}{b!c!}=\\frac{(a+b+c)!}{a!b!c!}.$$",
          "worked": "$$\\begin{align*}\\binom{a+b+c}{a}\\binom{b+c}{b}&=\\frac{(a+b+c)!}{a!(b+c)!}\\times\\frac{(b+c)!}{b!c!}\\\\\\binom{a+b+c}{a}\\binom{b+c}{b}&=\\frac{(a+b+c)!}{a!b!c!}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p16-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$$n^2=2\\binom{n}{2}+\\binom{n}{1}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$2\\binom{n}{2}+\\binom{n}{1}=n(n-1)+n=n^2.$$",
          "worked": "$$\\begin{align*}2\\binom{n}{2}+\\binom{n}{1}&=2\\times\\frac{n(n-1)}{2}+n\\\\2\\binom{n}{2}+\\binom{n}{1}&=n(n-1)+n\\\\2\\binom{n}{2}+\\binom{n}{1}&=n^2-n+n\\\\2\\binom{n}{2}+\\binom{n}{1}&=n^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p16-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\binom{a}{b}\\binom{b}{c}=\\binom{a}{b-c}\\binom{a-b+c}{c}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\binom{a}{b-c}\\binom{a-b+c}{c}=\\frac{a!}{(b-c)!c!(a-b)!}=\\binom{a}{b}\\binom{b}{c}.$$",
          "worked": "$$\\begin{align*}\\binom{a}{b-c}\\binom{a-b+c}{c}&=\\frac{a!}{(b-c)!(a-b+c)!}\\times\\frac{(a-b+c)!}{c!(a-b)!}\\\\\\binom{a}{b-c}\\binom{a-b+c}{c}&=\\frac{a!}{(b-c)!c!(a-b)!}\\\\\\binom{a}{b-c}\\binom{a-b+c}{c}&=\\frac{a!}{b!(a-b)!}\\times\\frac{b!}{c!(b-c)!}\\\\\\binom{a}{b-c}\\binom{a-b+c}{c}&=\\binom{a}{b}\\binom{b}{c}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
