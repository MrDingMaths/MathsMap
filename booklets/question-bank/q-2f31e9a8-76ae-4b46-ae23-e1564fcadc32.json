  "content": {
    "id": "p21-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A lion and a lamb are 90 metres apart. This will not be a happy ending. The lion chases the lamb at a speed of $12\\text{ m/s}$. The lamb, delaying the inevitable, runs from the lion at a speed of $4\\text{ m/s}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "How long does it take for the lion to catch the lamb?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{45}{4}\\text{ seconds}$",
          "worked": "The gap closes at the difference between their speeds.\n$$\\begin{align*}s_{\\text{relative}} &= 12-4 = 8\\text{ m/s}\\\\t &= \\frac{d}{s_{\\text{relative}}}\\\\t &= \\frac{90}{8}\\\\t &= \\frac{45}{4}\\text{ seconds}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p21-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "How far does the lion run in catching the lamb?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$135\\text{ m}$",
          "worked": "$$\\begin{align*}d_{\\text{lion}} &= st\\\\d_{\\text{lion}} &= 12\\times\\frac{45}{4}\\\\d_{\\text{lion}} &= 135\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
