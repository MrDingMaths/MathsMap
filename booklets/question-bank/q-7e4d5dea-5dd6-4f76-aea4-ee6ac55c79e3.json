  "content": {
    "id": "index-t2-q14-root",
    "type": "question",
    "label": null,
    "prompt": "Every answer is incorrect, state the error and write the correct answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t2-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{a^{7}}{a^{3}}$ $= a^{\\frac{7}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Divided the powers. Correct: $a^{4}$",
          "worked": "Subtract the indices instead of dividing them: $\\frac{a^7}{a^3}=a^{7-3}=a^4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t2-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$b^{8} \\div b^{5} = 1^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Divided the base too. Correct: $b^{3}$",
          "worked": "Keep the base when applying the division law: $b^8\\div b^5=b^{8-5}=b^3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t2-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{c^{9}}{c^{4}}$ $= c^{13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Added instead of subtracted. Correct: $c^{5}$",
          "worked": "Subtract the indices instead of adding them: $\\frac{c^9}{c^4}=c^{9-4}=c^5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t2-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{d^{3}}{d^{10}}$ $= d^{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Numerator is smaller, answer should have base on the bottom. Correct: $\\frac{1}{d^{7}}$",
          "worked": "Cancelling three factors of $d$ leaves seven in the denominator: $\\frac{d^3}{d^{10}}=\\frac1{d^{10-3}}=\\frac1{d^7}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t2-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$f^{10} \\div f = f^{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Forgot the implied power of 1. Correct: $f^{9}$",
          "worked": "The implied index of $f$ is 1: $f^{10}\\div f=f^{10-1}=f^9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
