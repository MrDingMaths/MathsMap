  "content": {
    "id": "sum-product-quartic-variant-1-root",
    "type": "question",
    "label": null,
    "prompt": "The roots of $x^4-7x^3+px^2-4x+9=0$ are $\\alpha,\\beta,\\gamma$ and $\\delta$, where $p$ is a constant. Given that $\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta=11$, find $\\alpha^2+\\beta^2+\\gamma^2+\\delta^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$27$",
      "worked": "$$\\begin{aligned}\\alpha+\\beta+\\gamma+\\delta&=-\\frac{-7}{1}\\\\&=7\\end{aligned}$$\n$$\\begin{aligned}\\alpha^2+\\beta^2+\\gamma^2+\\delta^2&=(\\alpha+\\beta+\\gamma+\\delta)^2\\\\&\\quad-2(\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta)\\\\&=7^2-2(11)\\\\&=27\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
