  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the equation of the resultant graph when $y=e^x$ is transformed in the following ways.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Translated left by 2 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{x+2}$",
          "worked": "A shift left by 2 replaces $x$ with $x+2$, so $y=e^{x+2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Translated upwards by 1 unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^x+1$",
          "worked": "Add 1 to the output, giving $y=e^x+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Reflected across the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-e^x$",
          "worked": "Negate the output, giving $y=-e^x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Reflected across the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{-x}$",
          "worked": "Replace the input $x$ with $-x$, giving $y=e^{-x}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "Reflected across the $x$-axis, and then across the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-e^{-x}$",
          "worked": "Reflect across the $x$-axis to obtain $y=-e^x$. Then replace $x$ with $-x$ for the reflection across the $y$-axis, giving $y=-e^{-x}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
