  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Consider the sequence: $7, 12, 17, 22, \\ldots$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the first 12 terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7, 12, 17, 22, 27, 32, 37, 42, 47, 52, 57, 62$",
          "worked": "Add $5$ to each term to obtain the next term:\n$$7, 12, 17, 22, 27, 32, 37, 42, 47, 52, 57, 62.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "How many terms are less than 30?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "The terms less than $30$ are $7, 12, 17, 22, 27$. The next term is $32$, so there are $5$ terms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "How many terms lie between 20 and 40?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "The terms between $20$ and $40$ are $22, 27, 32, 37$, so there are $4$ terms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the 10th term?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$52$",
          "worked": "Counting the terms listed in part a gives $a_{10}=52$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "What number term is 37?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "7th term",
          "worked": "Counting from the first term, $7, 12, 17, 22, 27, 32, 37$, gives $a_7=37$. It is the 7th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "Is 87 a term in the sequence?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; 17th term.",
          "worked": "The position-to-term rule is $a_n=5n+2$.\n$$\\begin{align*}5n+2&=87\\\\5n&=85\\\\n&=17\\end{align*}$$\nYes, $87$ is the 17th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "Is 201 a term in the sequence?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; all terms end in 2 or 7.",
          "worked": "Starting at $7$ and repeatedly adding $5$ gives terms ending alternately in $7$ and $2$. Since $201$ ends in $1$, it is not a term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
