        "answer": {
          "short": "$17\\sqrt{3}$",
          "worked": "$$\\begin{align*}2\\sqrt{3}+5\\sqrt{27}&=2\\sqrt{3}+5\\sqrt{9}\\sqrt{3}\\\\&=2\\sqrt{3}+15\\sqrt{3}\\\\&=17\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\sqrt{3}+6\\sqrt{27}$",
        "layout": "list",
