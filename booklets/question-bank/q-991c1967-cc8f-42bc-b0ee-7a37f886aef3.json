        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{30}+18\\sqrt{3}$",
          "worked": "$$\\begin{align*}2\\sqrt{30}+6\\sqrt{27}&=2\\sqrt{30}+6\\sqrt{9}\\sqrt{3}\\\\&=2\\sqrt{30}+18\\sqrt{3}\\end{align*}$$\nThe remaining surds are unlike.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p28-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$2\\sqrt{30}+6\\sqrt{120}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14\\sqrt{30}$",
          "worked": "$$\\begin{align*}2\\sqrt{30}+6\\sqrt{120}&=2\\sqrt{30}+6\\sqrt{4}\\sqrt{30}\\\\&=2\\sqrt{30}+12\\sqrt{30}\\\\&=14\\sqrt{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$6\\sqrt{30}+2\\sqrt{120}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\sqrt{30}$",
          "worked": "$$\\begin{align*}6\\sqrt{30}+2\\sqrt{120}&=6\\sqrt{30}+2\\sqrt{4}\\sqrt{30}\\\\&=6\\sqrt{30}+4\\sqrt{30}\\\\&=10\\sqrt{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$6\\sqrt{60}+2\\sqrt{240}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\sqrt{15}$. Simplify both surds, then collect like terms.",
          "worked": "$$\\begin{align*}6\\sqrt{60}+2\\sqrt{240}&=6\\sqrt{4}\\sqrt{15}+2\\sqrt{16}\\sqrt{15}\\\\&=12\\sqrt{15}+8\\sqrt{15}\\\\&=20\\sqrt{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p28-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$6\\sqrt{6}+2\\sqrt{24}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\sqrt{6}$",
          "worked": "$$\\begin{align*}6\\sqrt{6}+2\\sqrt{24}&=6\\sqrt{6}+2\\sqrt{4}\\sqrt{6}\\\\&=6\\sqrt{6}+4\\sqrt{6}\\\\&=10\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q7-k",
        "type": "part",
        "label": "k",
        "prompt": "$6\\sqrt{6}+2\\sqrt{24}+5\\sqrt{36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\sqrt{6}+30$. Use $\\sqrt{24}=2\\sqrt{6}$ and $\\sqrt{36}=6$.",
          "worked": "$$\\begin{align*}6\\sqrt{6}+2\\sqrt{24}+5\\sqrt{36}&=6\\sqrt{6}+2\\sqrt{4}\\sqrt{6}+5\\times6\\\\&=6\\sqrt{6}+4\\sqrt{6}+30\\\\&=10\\sqrt{6}+30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p28-q7-l",
        "type": "part",
        "label": "l",
        "prompt": "$6\\sqrt{16}+2\\sqrt{24}+5\\sqrt{36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$54+4\\sqrt{6}$. Evaluate the square roots of perfect squares and simplify $\\sqrt{24}$.",
          "worked": "$$\\begin{align*}6\\sqrt{16}+2\\sqrt{24}+5\\sqrt{36}&=6\\times4+2\\sqrt{4}\\sqrt{6}+5\\times6\\\\&=24+4\\sqrt{6}+30\\\\&=54+4\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
