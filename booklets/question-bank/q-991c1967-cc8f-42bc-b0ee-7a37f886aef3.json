        "children": [],
        "answer": {
          "short": "$7\\sqrt{3}$",
          "worked": "$$\\begin{align*}2\\sqrt{3}+5\\sqrt{3}&=(2+5)\\sqrt{3}\\\\&=7\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\sqrt{3}+5\\sqrt{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{3}+5\\sqrt{6}$ (already in simplest form).",
          "worked": "Both surds are simplified. Their radicands differ, so they cannot be collected. The expression remains $2\\sqrt{3}+5\\sqrt{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sqrt{3}+5\\sqrt{12}$",
        "layout": "list",
