        "children": [],
        "answer": {
          "short": "$12\\sqrt{3}$",
          "worked": "$$\\begin{align*}2\\sqrt{3}+5\\sqrt{12}&=2\\sqrt{3}+5\\sqrt{4}\\sqrt{3}\\\\&=2\\sqrt{3}+10\\sqrt{3}\\\\&=12\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\sqrt{3}+5\\sqrt{27}$",
