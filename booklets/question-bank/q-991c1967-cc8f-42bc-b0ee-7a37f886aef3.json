        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\sqrt{3}$",
          "worked": "$$\\begin{align*}2\\sqrt{3}+6\\sqrt{27}&=2\\sqrt{3}+6\\sqrt{9}\\sqrt{3}\\\\&=2\\sqrt{3}+18\\sqrt{3}\\\\&=20\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$2\\sqrt{30}+6\\sqrt{27}$",
