  "content": {
    "id": "p45-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Find the average rate of change of $y=2\\times3^x$ over the interval $x\\in[0,2]$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8$",
      "worked": "Let $f(x)=2\\times3^x$.\n\n$$\\begin{align*}\\frac{f(2)-f(0)}{2-0}&=\\frac{2\\times3^2-2\\times3^0}{2-0}\\\\\\frac{f(2)-f(0)}{2-0}&=\\frac{18-2}{2}\\\\\\frac{f(2)-f(0)}{2-0}&=8.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 17
  },
