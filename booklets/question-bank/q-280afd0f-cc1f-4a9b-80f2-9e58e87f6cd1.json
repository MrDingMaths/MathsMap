      {
        "id": "v2-3cf9e-p17-practice-slot-6-upper-slot-6-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Each exterior angle of a regular polygon is $20^{\\circ}$. Find the number of sides of the polygon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "18 sides",
          "worked": "$$\\begin{align*}20^{\\circ}&=\\frac{360^{\\circ}}{n}\\\\n&=\\frac{360^{\\circ}}{20^{\\circ}}\\\\n&=18\\end{align*}$$\nThe polygon has 18 sides.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-3cf9e-p17-practice-slot-6-upper-slot-6-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the size of each interior angle of the polygon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$160^{\\circ}$",
          "worked": "The interior and exterior angles at each vertex sum to $180^{\\circ}$.\n$$\\begin{aligned}I&=180^{\\circ}-20^{\\circ}\\\\&=160^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-3cf9e-p17-practice-slot-6-upper-slot-6-upper-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the angle sum of the polygon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2880^{\\circ}$",
          "worked": "$$\\begin{aligned}S&=18\\times160^{\\circ}\\\\&=2880^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
