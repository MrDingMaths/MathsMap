  "content": {
    "id": "p16-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Solve these inequalities algebraically.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$|x|\\ge 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le -4$ or $x\\ge 4$",
          "worked": "$x\\ge 4$ or $-x\\ge 4$.\n$$\\begin{aligned}-x&\\ge 4\\\\x&\\le -4\\end{aligned}$$\nThus $x\\le -4$ or $x\\ge 4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$|x+1|<3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4<x<2$",
          "worked": "Both conditions must hold:\n$$\\begin{aligned}x+1&<3\\\\x&<2\\end{aligned}$$\n$$\\begin{aligned}-(x+1)&<3\\\\-x&<4\\\\x&>-4\\end{aligned}$$\nThus $-4<x<2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$|x-3|\\ge 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le 1$ or $x\\ge 5$",
          "worked": "$x-3\\ge 2$ or $-(x-3)\\ge 2$.\n$$\\begin{aligned}x&\\ge 5\\end{aligned}$$\n$$\\begin{aligned}-x+3&\\ge 2\\\\x&\\le 1\\end{aligned}$$\nThus $x\\le 1$ or $x\\ge 5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p16-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$|x-2|<3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1<x<5$",
          "worked": "Both conditions must hold:\n$$\\begin{aligned}x-2&<3\\\\x&<5\\end{aligned}$$\n$$\\begin{aligned}-(x-2)&<3\\\\-x&<1\\\\x&>-1\\end{aligned}$$\nThus $-1<x<5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$|3x-5|\\le 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13\\le x\\le 3$",
          "worked": "Both conditions must hold:\n$$\\begin{aligned}3x-5&\\le 4\\\\3x&\\le 9\\\\x&\\le 3\\end{aligned}$$\n$$\\begin{aligned}-(3x-5)&\\le 4\\\\-3x&\\le -1\\\\x&\\ge \\frac13\\end{aligned}$$\nThus $\\dfrac13\\le x\\le 3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$|x-7|\\ge 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le 5$ or $x\\ge 9$",
          "worked": "$x-7\\ge 2$ or $-(x-7)\\ge 2$.\n$$\\begin{aligned}x&\\ge 9\\end{aligned}$$\n$$\\begin{aligned}-x+7&\\ge 2\\\\x&\\le 5\\end{aligned}$$\nThus $x\\le 5$ or $x\\ge 9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p16-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$|2x+1|<3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2<x<1$",
          "worked": "Both conditions must hold:\n$$\\begin{aligned}2x+1&<3\\\\2x&<2\\\\x&<1\\end{aligned}$$\n$$\\begin{aligned}-(2x+1)&<3\\\\-2x&<4\\\\x&>-2\\end{aligned}$$\nThus $-2<x<1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$|4x-3|>5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-\\dfrac12$ or $x>2$",
          "worked": "$4x-3>5$ or $-(4x-3)>5$.\n$$\\begin{aligned}4x&>8\\\\x&>2\\end{aligned}$$\n$$\\begin{aligned}-4x+3&>5\\\\-4x&>2\\\\x&<-\\frac12\\end{aligned}$$\nThus $x<-\\dfrac12$ or $x>2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$|5x+4|\\ge 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le -2$ or $x\\ge \\dfrac25$",
          "worked": "$5x+4\\ge 6$ or $-(5x+4)\\ge 6$.\n$$\\begin{aligned}5x&\\ge 2\\\\x&\\ge \\frac25\\end{aligned}$$\n$$\\begin{aligned}-5x&\\ge 10\\\\x&\\le -2\\end{aligned}$$\nThus $x\\le -2$ or $x\\ge \\dfrac25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
