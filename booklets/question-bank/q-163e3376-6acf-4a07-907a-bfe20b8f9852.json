  "content": {
    "id": "p39-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Factorise these expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x(x+1)+3(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x+3)$",
          "worked": "$$\\begin{align*}x(x+1)+3(x+1)&=(x+1)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x(x+1)+2(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x+2)$",
          "worked": "$$\\begin{align*}x(x+1)+2(x+1)&=(x+1)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x(x+1)+1(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2$",
          "worked": "$$\\begin{align*}x(x+1)+1(x+1)&=(x+1)(x+1)\\\\&=(x+1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$3x(x+1)+(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(3x+1)$",
          "worked": "$$\\begin{align*}3x(x+1)+(x+1)&=3x(x+1)+1(x+1)\\\\&=(x+1)(3x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x(x+1)-(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(3x-1)$",
          "worked": "$$\\begin{align*}3x(x+1)-(x+1)&=3x(x+1)-1(x+1)\\\\&=(x+1)(3x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x(2x+1)-(2x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(3x-1)$",
          "worked": "$$\\begin{align*}3x(2x+1)-(2x+1)&=3x(2x+1)-1(2x+1)\\\\&=(2x+1)(3x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$3x(1+2x)-(2x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1+2x)(3x-1)$",
          "worked": "$$\\begin{align*}3x(1+2x)-(2x+1)&=3x(1+2x)-(1+2x)\\\\&=(1+2x)(3x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$3x(1-2x)-(1-2x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-2x)(3x-1)$",
          "worked": "$$\\begin{align*}3x(1-2x)-(1-2x)&=3x(1-2x)-1(1-2x)\\\\&=(1-2x)(3x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$2x(1-2x)-(1-2x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-2x)(2x-1)$ or $-(2x-1)^2$",
          "worked": "$$\\begin{align*}2x(1-2x)-(1-2x)&=(1-2x)(2x-1)\\\\&=-(2x-1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$2x(1-2x)-(2x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-2x)(2x+1)$",
          "worked": "$$\\begin{align*}2x(1-2x)-(2x-1)&=2x(1-2x)+(1-2x)\\\\&=(1-2x)(2x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
