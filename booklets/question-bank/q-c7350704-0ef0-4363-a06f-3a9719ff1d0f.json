    "children": [
      {
        "id": "p16-q5a",
        "type": "part",
        "label": "a",
        "prompt": "The polynomial $P(x)=2x^3-5x^2-14x+8$ has zeroes at $-2$ and $4$. Use the sum of zeroes to find the other zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$.",
          "worked": "Let the other zero be $\\gamma$. Using the sum of zeroes,\n$$\\begin{aligned}-2+4+\\gamma&=\\frac52\\\\\\gamma&=\\frac52-2\\\\&=\\frac12.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p16-q5b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose that $x-3$ and $x+1$ are factors of $P(x)=x^3-6x^2+5x+12$. Use the product of the zeroes to find the other factor of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-4$.",
          "worked": "Two zeroes are $3$ and $-1$. Let the other zero be $\\gamma$. Using the product of zeroes,\n$$\\begin{aligned}(3)(-1)\\gamma&=-12\\\\\\gamma&=4.\\end{aligned}$$\nThe other factor is $x-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
