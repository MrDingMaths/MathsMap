  "content": {
    "id": "p16-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "There are 63 patients being treated for a disease using three types of medication, labelled $A$, $B$ and $C$. Some patients receive more than one type of medication, and some receive none. This information is summarised on the Venn diagram below.\n\nIf a patient is randomly selected, find the probability that they take:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p16-q5-venn",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 16, p16-q5-venn\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black] (-2.4,-2.05) rectangle (2.4,2.6);\n\\draw[black] (0,0.95) circle (1.2);\n\\draw[black] (-0.85,-0.5) circle (1.2);\n\\draw[black] (0.85,-0.5) circle (1.2);\n\\node[above] at (2.15,2.6) {$\\Omega$};\n\\node at (0,2.35) {$A$};\n\\node at (-1.95,-1.55) {$B$};\n\\node at (1.95,-1.55) {$C$};\n\\node at (0,1.15) {$10$};\n\\node at (-0.47,0.2) {$5$};\n\\node at (0.47,0.2) {$6$};\n\\node at (0,-0.02) {$2$};\n\\node at (-0.95,-0.7) {$11$};\n\\node at (0.95,-0.7) {$12$};\n\\node at (0,-0.65) {$7$};\n\\node at (0,-1.75) {$10$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 16,
          "sourceRegion": "Question 5, left-column Venn diagram",
          "description": "Three overlapping circles: A above B and C; B lower left and C lower right. All eight region counts and universal-set label retained. Decorative cyan fills omitted.",
          "mathematics": "A only 10; B only 11; C only 12; AB only 5; AC only 6; BC only 7; ABC 2; outside 10. Total 63.",
          "answerVisibility": "All counts are permanent student-visible givens."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p16-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "all three types of medication",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{63}$",
          "worked": "$$\\Pr(A\\cap B\\cap C)=\\frac{2}{63}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "medication $B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{63}$",
          "worked": "$$\\Pr(B)=\\frac{11+5+7+2}{63}=\\frac{25}{63}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "only medication $B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{63}$",
          "worked": "$$\\Pr(B\\cap A'\\cap C')=\\frac{11}{63}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "medication $B$ and $C$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{7}$",
          "worked": "$$\\Pr(B\\cap C)=\\frac{7+2}{63}=\\frac{1}{7}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "medication $A$ or $C$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{align*}\\Pr(A\\cup C)&=\\frac{10+5+6+2+7+12}{63}\\\\\\Pr(A\\cup C)&=\\frac{42}{63}=\\frac{2}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "medication $A$ and $B$ but not $C$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{63}$",
          "worked": "$$\\Pr(A\\cap B\\cap C')=\\frac{5}{63}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "medication $A$ or $B$ but not $C$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{26}{63}$",
          "worked": "$$\\Pr((A\\cup B)\\cap C')=\\frac{10+11+5}{63}=\\frac{26}{63}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "exactly two types of medication",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{7}$",
          "worked": "Exclude the central region, which represents three types.\n\n$$\\Pr(\\text{exactly two types})=\\frac{5+6+7}{63}=\\frac{2}{7}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "medication $A$ given that they take medication $B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{25}$",
          "worked": "Restrict the sample space to the 25 patients taking $B$.\n\n$$\\begin{align*}\\Pr(A\\mid B)&=\\frac{5+2}{11+5+7+2}\\\\\\Pr(A\\mid B)&=\\frac{7}{25}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "medication $B$ given that they take $A$ and $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "Restrict the sample space to the 8 patients taking both $A$ and $C$.\n\n$$\\begin{align*}\\Pr(B\\mid A\\cap C)&=\\frac{2}{6+2}\\\\\\Pr(B\\mid A\\cap C)&=\\frac{1}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
