  "content": {
    "id": "p28-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A bank offers $0.7\\%$ per month compound interest. How much needs to be invested if the investment is to be worth $\\$100\\,000$ in the following periods? Give each answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "10 years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$43\\,297.57$",
          "worked": "There are $10\\times12=120$ monthly periods, with $R=0.007$ per month.\n$$\\begin{align*}A_n&=P(1+R)^n\\\\100\\,000&=P(1.007)^{120}\\\\P&=\\frac{100\\,000}{(1.007)^{120}}\\\\P&\\approx\\$43\\,297.57\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p28-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "25 years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$12\\,335.56$",
          "worked": "There are $25\\times12=300$ monthly periods, with $R=0.007$ per month.\n$$\\begin{align*}A_n&=P(1+R)^n\\\\100\\,000&=P(1.007)^{300}\\\\P&=\\frac{100\\,000}{(1.007)^{300}}\\\\P&\\approx\\$12\\,335.56\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
