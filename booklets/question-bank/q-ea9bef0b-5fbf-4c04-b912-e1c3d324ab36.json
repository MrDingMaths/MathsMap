      {
        "id": "p18-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $(1-2x)^6$ as far as the term in $x^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-12x+60x^2-160x^3+240x^4-\\cdots$",
          "worked": "$$\\begin{aligned}(1-2x)^6&=1+\\binom61(-2x)+\\binom62(-2x)^2+\\binom63(-2x)^3+\\binom64(-2x)^4-\\cdots\\\\&=1-12x+60x^2-160x^3+240x^4-\\cdots.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p18-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the coefficient of $x^4$ in the expansion of $(1-3x)(1-2x)^6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$720$",
          "worked": "$$\\begin{aligned}(1-3x)(1-2x)^6&=(1-3x)\\bigl(1-12x+60x^2-160x^3+240x^4-\\cdots\\bigr).\\end{aligned}$$\nCoefficient of $x^4$:\n$$\\begin{aligned}1(240)+(-3)(-160)&=240+480\\\\&=720.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
