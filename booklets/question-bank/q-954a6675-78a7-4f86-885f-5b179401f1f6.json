  "content": {
    "id": "p24-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A parabola has $x$-intercepts of $-2$ and $3$ and $y$-intercept $-3$. Find its equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\frac12x^2-\\frac12x-3$",
      "worked": "The $y$-intercept gives the point $(0,-3)$.\n$$\\begin{align*}y&=a(x+2)(x-3)\\\\-3&=a(2)(-3)\\\\a&=\\frac12\\\\y&=\\frac12(x+2)(x-3)\\\\y&=\\frac12x^2-\\frac12x-3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
