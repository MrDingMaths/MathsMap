  "content": {
    "id": "p14-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "If $g(x)=3x$, state whether each statement is true or false.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(3)=2g(2)+3g(1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}g(3)&=3\\times3\\\\g(3)&=9\\\\2g(2)+3g(1)&=2(3\\times2)+3(3\\times1)\\\\2g(2)+3g(1)&=21\\end{align*}$$\nSince $9\\ne21$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p14-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(2)=g(1)+2g(0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}g(2)&=3\\times2\\\\g(2)&=6\\\\g(1)+2g(0)&=3\\times1+2(3\\times0)\\\\g(1)+2g(0)&=3\\end{align*}$$\nSince $6\\ne3$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p14-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(x+y)=g(x)+g(y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}g(x+y)&=3(x+y)\\\\g(x+y)&=3x+3y\\\\g(x)+g(y)&=3x+3y\\end{align*}$$\nBoth sides are equal, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p14-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(x+y)=g(x)g(y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$g(x+y)=3x+3y$, whereas $g(x)g(y)=9xy$.\n\nFor example, take $x=y=1$:\n$$\\begin{align*}g(1+1)&=6\\\\g(1)g(1)&=9\\end{align*}$$\nSince $6\\ne9$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p14-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$g(xy)=g(x)g(y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$g(xy)=3xy$, whereas $g(x)g(y)=9xy$.\n\nFor example, take $x=y=1$:\n$$\\begin{align*}g(1\\times1)&=3\\\\g(1)g(1)&=9\\end{align*}$$\nSince $3\\ne9$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p14-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$g(2a)=2g(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}g(2a)&=3(2a)\\\\g(2a)&=6a\\\\2g(a)&=2(3a)\\\\2g(a)&=6a\\end{align*}$$\nBoth sides are equal, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
