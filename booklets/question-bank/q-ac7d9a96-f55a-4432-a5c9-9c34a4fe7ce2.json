  "content": {
    "id": "p5-q18-response",
    "type": "question",
    "label": "18",
    "prompt": "With a fuel tank $60\\%$ full, I set out to drive $650\\text{ km}$ from Alphington to Chelsea. At Broadsville, $165\\text{ km}$ from Alphington, I have $45\\%$ of the tank remaining. Will I make it to Chelsea if I continue using fuel at the same rate?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p5-q18-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Yes.",
                "marks": []
              }
            ]
          },
          {
            "id": "p5-q18-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The remaining fuel allows ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "495\\text{ km}",
                "display": false
              },
              {
                "type": "text",
                "text": " of travel; only ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "485\\text{ km}",
                "display": false
              },
              {
                "type": "text",
                "text": " remains.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\text{Fuel used} &= 60\\%-45\\%\\\\\\text{Fuel used} &= 15\\%\\\\\\text{Remaining travel distance} &= \\frac{45}{15}\\times165\\\\\\text{Remaining travel distance} &= 495\\text{ km}\\\\\\text{Distance to Chelsea} &= 650-165\\\\\\text{Distance to Chelsea} &= 485\\text{ km}\\end{align*}$$\nSince $485\\text{ km}<495\\text{ km}$, there is enough fuel to reach Chelsea.",
      "solutionDiagrams": []
    },
