  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "In a particular class, 20 students study history, 15 study chemistry and 5 study both.\nA student is chosen randomly.\nWhat is the probability that they study chemistry, given that they study history?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{4}$",
      "worked": "Let $H$ represent studying history and $C$ represent studying chemistry.\n$$\\begin{align*}P(C\\mid H)&=\\frac{|H\\cap C|}{|H|}\\\\&=\\frac{5}{20}\\\\&=\\frac{1}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
