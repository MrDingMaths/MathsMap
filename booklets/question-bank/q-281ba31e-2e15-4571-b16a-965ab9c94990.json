  "content": {
    "id": "p26-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Given the points $X(-1,0)$, $Y(1,a)$ and $Z(a,2)$, find $a$ if $\\angle YXZ=90^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-\\dfrac{1}{2}$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p26-q17-answer-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "XY\\perp XZ",
                "display": false
              },
              {
                "type": "text",
                "text": ", so ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "m_{XY}m_{XZ}=-1",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p26-q17-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}m_{XY}&=\\frac{a-0}{1-(-1)}=\\frac{a}{2}\\\\m_{XZ}&=\\frac{2-0}{a-(-1)}=\\frac{2}{a+1}\\\\m_{XY}m_{XZ}&=-1\\\\\\frac{a}{2}\\times\\frac{2}{a+1}&=-1\\\\\\frac{a}{a+1}&=-1\\\\a&=-a-1\\\\2a&=-1\\\\a&=-\\frac{1}{2}\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
