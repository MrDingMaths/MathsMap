    "id": "p36-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Suppose a child is born at 2349 on one day and his twin brother is born at 0008 the next day. How much older is the first child?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "19 minutes.",
      "worked": "From 2349 to midnight is 11 minutes. From midnight to 0008 is 8 minutes.\n\n$$\\begin{align*}\\text{Age difference}&=11+8\\text{ minutes}\\\\\\text{Age difference}&=19\\text{ minutes}\\end{align*}$$\n\nThe first child is 19 minutes older.",
      "solutionDiagrams": []
    },
