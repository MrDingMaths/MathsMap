    "children": [
      {
        "id": "p30-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{(x+3)^2}=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-8$.",
          "worked": "$$\\begin{align*}|x+3|&=5\\\\x+3&=5\\quad\\text{or}\\quad x+3=-5\\\\x&=2\\quad\\text{or}\\quad x=-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p30-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{(3x+2)^2}=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-\\dfrac{10}{3}$.",
          "worked": "$$\\begin{align*}|3x+2|&=8\\\\3x+2&=8\\quad\\text{or}\\quad 3x+2=-8\\\\3x&=6\\quad\\text{or}\\quad 3x=-10\\\\x&=2\\quad\\text{or}\\quad x=-\\frac{10}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p30-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{(x-4)^2}+3=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=11$ or $x=-3$.",
          "worked": "$$\\begin{align*}|x-4|+3&=10\\\\|x-4|&=7\\\\x-4&=7\\quad\\text{or}\\quad x-4=-7\\\\x&=11\\quad\\text{or}\\quad x=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$3\\sqrt{(x+2)^2}-5=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-6$.",
          "worked": "$$\\begin{align*}3|x+2|-5&=7\\\\3|x+2|&=12\\\\|x+2|&=4\\\\x+2&=4\\quad\\text{or}\\quad x+2=-4\\\\x&=2\\quad\\text{or}\\quad x=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p30-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\sqrt{(4x-1)^2}}{3}=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=-\\dfrac72$.",
          "worked": "$$\\begin{align*}\\frac{|4x-1|}{3}&=5\\\\|4x-1|&=15\\\\4x-1&=15\\quad\\text{or}\\quad 4x-1=-15\\\\4x&=16\\quad\\text{or}\\quad 4x=-14\\\\x&=4\\quad\\text{or}\\quad x=-\\frac72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p30-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$2\\sqrt{(x-3)^2}+4=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=9$ or $x=-3$.",
          "worked": "$$\\begin{align*}2|x-3|+4&=16\\\\2|x-3|&=12\\\\|x-3|&=6\\\\x-3&=6\\quad\\text{or}\\quad x-3=-6\\\\x&=9\\quad\\text{or}\\quad x=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p30-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\sqrt{x^2}}{x^2}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\dfrac12$.",
          "worked": "The denominator requires $x\\ne0$. Using $x^2=|x|^2$,\n$$\\begin{align*}\\frac{|x|}{|x|^2}&=2\\\\\\frac{1}{|x|}&=2\\\\|x|&=\\frac12\\\\x&=\\pm\\frac12\\end{align*}$$\nBoth values are nonzero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p30-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\sqrt{(3x)^2}}{x^2}=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\dfrac13$.",
          "worked": "The denominator requires $x\\ne0$. Using $|3x|=3|x|$ and $x^2=|x|^2$,\n$$\\begin{align*}\\frac{3|x|}{|x|^2}&=9\\\\\\frac{3}{|x|}&=9\\\\|x|&=\\frac39\\\\|x|&=\\frac13\\\\x&=\\pm\\frac13\\end{align*}$$\nBoth values are nonzero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p30-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\sqrt{x^2}=x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$.",
          "worked": "$$|x|=x+6$$\nFor $x\\ge0$, this gives $x=x+6$, which has no solution.\n\nFor $x<0$,\n$$\\begin{align*}-x&=x+6\\\\-2x&=6\\\\x&=-3\\end{align*}$$\nThis satisfies $x<0$. Check: $\\sqrt{(-3)^2}=3=-3+6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p30-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\sqrt{(x-2)^2}=x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$.",
          "worked": "$$|x-2|=x+4$$\nFor $x\\ge2$, this gives $x-2=x+4$, which has no solution.\n\nFor $x<2$,\n$$\\begin{align*}-(x-2)&=x+4\\\\-x+2&=x+4\\\\-2x&=2\\\\x&=-1\\end{align*}$$\nThis satisfies $x<2$. Check: $\\sqrt{(-1-2)^2}=3=-1+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
