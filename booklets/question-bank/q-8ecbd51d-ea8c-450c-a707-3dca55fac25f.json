    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(\\alpha+\\beta)\\cos(\\beta)-\\cos(\\alpha+\\beta)\\sin(\\beta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\alpha$",
          "worked": "Using $\\sin(A-B)=\\sin A\\cos B-\\cos A\\sin B$:\n$$\\begin{align*}\\sin(\\alpha+\\beta)\\cos\\beta-\\cos(\\alpha+\\beta)\\sin\\beta&=\\sin((\\alpha+\\beta)-\\beta)\\\\\\sin(\\alpha+\\beta)\\cos\\beta-\\cos(\\alpha+\\beta)\\sin\\beta&=\\sin\\alpha.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin(\\alpha+\\beta)\\sin(\\beta)+\\cos(\\alpha+\\beta)\\cos(\\beta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\alpha$",
          "worked": "Using $\\cos(A-B)=\\cos A\\cos B+\\sin A\\sin B$:\n$$\\begin{align*}\\sin(\\alpha+\\beta)\\sin\\beta+\\cos(\\alpha+\\beta)\\cos\\beta&=\\cos((\\alpha+\\beta)-\\beta)\\\\\\sin(\\alpha+\\beta)\\sin\\beta+\\cos(\\alpha+\\beta)\\cos\\beta&=\\cos\\alpha.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
