  "content": {
    "id": "p44-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Faisal takes the 4 aces from a deck of cards and randomly selects an ace out of these 4 cards over 100 experiments. After each selection, he replaces the card and mixes the cards before selecting again.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the most likely number of times that he selects the ace of hearts?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "25 times.",
          "worked": "Let $X$ count selections of the ace of hearts. Then $X\\sim\\operatorname{Bin}(100,\\frac14)$.\n$$E(X)=np=100\\times\\frac14=25.$$\nFor this binomial distribution, the most likely count is also 25.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p44-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the probability that he selects the ace of hearts this number of times, to 3 s.f.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.0918$",
          "worked": "$$\\begin{aligned}P(X=25)&=\\binom{100}{25}\\left(\\frac14\\right)^{25}\\left(\\frac34\\right)^{75}\\\\P(X=25)&\\approx0.0918\\quad\\text{(3 s.f.)}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
  },
