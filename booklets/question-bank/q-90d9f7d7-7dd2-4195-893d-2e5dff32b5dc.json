  "content": {
    "id": "p6-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "If $f(x)=x^2+5x$, find in simplest form:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{f(1+h)-f(1)}{h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+h$",
          "worked": "$$\\begin{align*}\\frac{f(1+h)-f(1)}{h}&=\\frac{(1+h)^2+5(1+h)-(1^2+5)}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=\\frac{1+2h+h^2+5+5h-6}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=\\frac{h(h+7)}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=h+7\\qquad(h\\ne0).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p6-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{f(p)-f(q)}{p-q}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p+q+5$",
          "worked": "$$\\begin{align*}\\frac{f(p)-f(q)}{p-q}&=\\frac{p^2+5p-(q^2+5q)}{p-q}\\\\\\frac{f(p)-f(q)}{p-q}&=\\frac{p^2-q^2+5(p-q)}{p-q}\\\\\\frac{f(p)-f(q)}{p-q}&=\\frac{(p-q)(p+q+5)}{p-q}\\\\\\frac{f(p)-f(q)}{p-q}&=p+q+5\\qquad(p\\ne q).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p6-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{f(x+h)-f(x)}{h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+h+5$",
          "worked": "$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{(x+h)^2+5(x+h)-(x^2+5x)}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{x^2+2xh+h^2+5x+5h-x^2-5x}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{h(2x+h+5)}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=2x+h+5\\qquad(h\\ne0).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
