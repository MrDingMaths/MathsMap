  "content": {
    "id": "p18-q10-root",
    "type": "question",
    "label": null,
    "prompt": "When the side length of a square increases by 1, its area is doubled. Find the side length of the original square.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p18-q10-short-result",
            "type": "paragraph",
            "fontSize": null,
