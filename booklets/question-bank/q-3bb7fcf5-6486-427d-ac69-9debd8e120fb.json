    "type": "question",
    "label": "21",
    "prompt": "Find the smallest composite number whose positive factors all have a distinct number of digits.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$121$.\n\nIts positive factors are $1,11,121$, with one, two and three digits respectively.",
      "worked": "Since $1$ is a factor, no other factor can have one digit. Thus the smallest prime divisor $p$ must be at least $11$.\n\nFor a composite number $n$, its smallest prime divisor satisfies $p\\le\\sqrt n$. Hence $n\\ge p^2\\ge121$.\n\nThe positive factors of $121=11^2$ are $1,11,121$. Their digit counts are respectively $1,2,3$, so the smallest required number is $121$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
