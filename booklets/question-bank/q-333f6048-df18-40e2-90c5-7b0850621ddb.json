  "content": {
    "id": "p19-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Chelsea has 12 ribbons in her top drawer. Four of them are pink, three are blue, three are green and two are white. If she chooses one ribbon at random, what is the probability that it is green?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{4}$",
      "worked": "There are 3 green ribbons among 12 equally likely ribbons.\n\n$$\\begin{aligned}P(\\text{green})&=\\frac{3}{12}\\\\P(\\text{green})&=\\frac{1}{4}\\end{aligned}$$",
      "solutionDiagrams": []
    },
