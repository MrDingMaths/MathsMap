  "content": {
    "id": "p7-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "When a pack of playing cards is cut, what is the probability that the card showing is not a picture card (picture cards being Jacks, Queens and Kings)?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{10}{13}$",
      "worked": "There are $3\\times4=12$ picture cards in a pack of $52$ cards.\n\n$$\\begin{align*}P(\\text{not a picture card})&=1-P(\\text{picture card})\\\\P(\\text{not a picture card})&=1-\\frac{12}{52}\\\\P(\\text{not a picture card})&=\\frac{40}{52}\\\\P(\\text{not a picture card})&=\\frac{10}{13}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
