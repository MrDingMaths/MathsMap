              "latex": "g",
              "display": false
            },
            {
              "type": "text",
              "text": " all the way around the pig and the length ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "L",
              "display": false
            },
            {
              "type": "text",
              "text": " from tail to head in centimetres. The weight, in kilograms, is:",
              "marks": []
            }
          ]
        },
        {
          "id": "p11-q4-formula",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "w=\\frac{Lg^2}{13781}",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
