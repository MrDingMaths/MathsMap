      {
        "id": "p11-q4-f-node",
        "type": "part",
        "label": "f",
        "prompt": "Why does doubling the girth change the weight more than doubling the length?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Girth is squared: doubling it multiplies the weight by 4, while doubling length multiplies the weight by 2.",
          "worked": "In $w=\\frac{Lg^2}{13781}$, doubling $g$ multiplies $g^2$ by $2^2=4$, so the weight is quadrupled. Doubling $L$ multiplies the weight by 2.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
