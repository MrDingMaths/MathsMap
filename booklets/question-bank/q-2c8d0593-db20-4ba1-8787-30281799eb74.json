    "children": [
      {
        "id": "p11-q4-a-node",
        "type": "part",
        "label": "a",
        "prompt": "A pig has a girth of 173 cm and length of 168 cm.\nEstimate its weight, answer to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$364.86$ kg",
          "worked": "$$\\begin{align*}w&=\\frac{Lg^2}{13781}\\\\w&=\\frac{168(173)^2}{13781}\\\\w&\\approx364.86\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q4-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Estimate the length of a pig that has a weight of 400 kg and a girth of 180 cm.\nAnswer to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$170.14$ cm",
          "worked": "$$\\begin{align*}w&=\\frac{Lg^2}{13781}\\\\400&=\\frac{L(180)^2}{13781}\\\\L&=\\frac{400\\times13781}{180^2}\\\\L&\\approx170.14\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q4-c-node",
        "type": "part",
        "label": "c",
        "prompt": "Estimate the girth of a pig that has a weight of 320 kg and a length of 150 cm.\nAnswer to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$171.46$ cm",
          "worked": "$$\\begin{align*}w&=\\frac{Lg^2}{13781}\\\\320&=\\frac{150g^2}{13781}\\\\g^2&=\\frac{320\\times13781}{150}\\\\g&=\\sqrt{\\frac{320\\times13781}{150}}\\\\g&\\approx171.46\\text{ cm}\\end{align*}$$\nUse the positive square root because girth is a length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p11-q4-d-node",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
