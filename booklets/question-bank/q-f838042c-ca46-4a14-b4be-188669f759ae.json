    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{25s^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5s^2$",
          "worked": "$$\\begin{align*}\\sqrt{25s^4}&=25^{\\frac12}s^{\\frac42}\\\\&=5s^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt[3]{27t^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3t^2$",
          "worked": "$$\\begin{align*}\\sqrt[3]{27t^6}&=27^{\\frac13}t^{\\frac63}\\\\&=3t^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[4]{16t^8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2t^2$",
          "worked": "$$\\begin{align*}\\sqrt[4]{16t^8}&=16^{\\frac14}t^{\\frac84}\\\\&=2t^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[3]{125t^{12}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5t^4$",
          "worked": "$$\\begin{align*}\\sqrt[3]{125t^{12}}&=125^{\\frac13}t^{\\frac{12}{3}}\\\\&=5t^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x^3)^{\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$",
          "worked": "$$\\begin{align*}(x^3)^{\\frac13}&=x^{3\\times\\frac13}\\\\&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$(b^{12})^{\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^4$",
          "worked": "$$\\begin{align*}(b^{12})^{\\frac13}&=b^{12\\times\\frac13}\\\\&=b^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$(16a^2b^8)^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4|a|b^4$",
          "worked": "$$\\begin{align*}(16a^2b^8)^{\\frac12}&=\\sqrt{16a^2b^8}\\\\&=4\\sqrt{a^2}\\sqrt{b^8}\\\\&=4|a|b^4\\end{align*}$$\nThe square root is nonnegative, so $\\sqrt{a^2}=|a|$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$(32x^{10}y^{15})^{\\frac15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2y^3$",
          "worked": "$$\\begin{align*}(32x^{10}y^{15})^{\\frac15}&=32^{\\frac15}x^{\\frac{10}{5}}y^{\\frac{15}{5}}\\\\&=2x^2y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\sqrt[3]{\\frac{8x^3}{27}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{3}$",
          "worked": "$$\\begin{align*}\\sqrt[3]{\\frac{8x^3}{27}}&=\\frac{8^{\\frac13}x^{\\frac33}}{27^{\\frac13}}\\\\&=\\frac{2x}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
