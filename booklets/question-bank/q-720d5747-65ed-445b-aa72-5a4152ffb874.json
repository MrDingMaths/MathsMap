  "content": {
    "id": "p23-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify these ratios by converting all units to be the same first.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$15\\text{ cm}:0.6\\text{ m}:30\\text{ mm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5:20:1$",
          "worked": "$0.6\\text{ m}=600\\text{ mm}$ and $15\\text{ cm}=150\\text{ mm}$.\n\n$$\\begin{align*}15\\text{ cm}:0.6\\text{ m}:30\\text{ mm}&=150:600:30\\\\&=5:20:1\\end{align*}$$\nDivide every part by $30$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\text{ min}:45\\text{ s}:1\\text{ min }25\\text{ s}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24:9:17$",
          "worked": "$2\\text{ min}=120\\text{ s}$ and $1\\text{ min }25\\text{ s}=85\\text{ s}$.\n\n$$\\begin{align*}2\\text{ min}:45\\text{ s}:1\\text{ min }25\\text{ s}&=120:45:85\\\\&=24:9:17\\end{align*}$$\nDivide every part by $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$1.2\\text{ kg}:800\\text{ g}:0.4\\text{ kg}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:2:1$",
          "worked": "$1.2\\text{ kg}=1200\\text{ g}$ and $0.4\\text{ kg}=400\\text{ g}$.\n\n$$\\begin{align*}1.2\\text{ kg}:800\\text{ g}:0.4\\text{ kg}&=1200:800:400\\\\&=3:2:1\\end{align*}$$\nDivide every part by $400$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$600\\text{ L}:4.2\\text{ kL}:0.9\\text{ kL}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:14:3$",
          "worked": "$4.2\\text{ kL}=4200\\text{ L}$ and $0.9\\text{ kL}=900\\text{ L}$.\n\n$$\\begin{align*}600\\text{ L}:4.2\\text{ kL}:0.9\\text{ kL}&=600:4200:900\\\\&=2:14:3\\end{align*}$$\nDivide every part by $300$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\$3.60:45\\text{ c}:\\$2.07$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40:5:23$",
          "worked": "$\\$3.60=360\\text{ c}$ and $\\$2.07=207\\text{ c}$.\n\n$$\\begin{align*}\\$3.60:45\\text{ c}:\\$2.07&=360:45:207\\\\&=40:5:23\\end{align*}$$\nDivide every part by $9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$3\\text{ weeks}:1\\text{ fortnight}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:2$",
          "worked": "$3\\text{ weeks}=21\\text{ days}$ and $1\\text{ fortnight}=14\\text{ days}$.\n\n$$\\begin{align*}3\\text{ weeks}:1\\text{ fortnight}&=21:14\\\\&=3:2\\end{align*}$$\nDivide both parts by $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$6000\\text{ mg}:12\\text{ g}:0.06\\text{ kg}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:2:10$",
          "worked": "$12\\text{ g}=12000\\text{ mg}$ and $0.06\\text{ kg}=60000\\text{ mg}$.\n\n$$\\begin{align*}6000\\text{ mg}:12\\text{ g}:0.06\\text{ kg}&=6000:12000:60000\\\\&=1:2:10\\end{align*}$$\nDivide every part by $6000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$10\\text{ cm}^{2}:200\\text{ mm}^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5:1$",
          "worked": "$1\\text{ cm}^{2}=100\\text{ mm}^{2}$, so $10\\text{ cm}^{2}=1000\\text{ mm}^{2}$.\n\n$$\\begin{align*}10\\text{ cm}^{2}:200\\text{ mm}^{2}&=1000:200\\\\&=5:1\\end{align*}$$\nDivide both parts by $200$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$600\\text{ m}^{2}:1\\text{ ha}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:50$",
          "worked": "$1\\text{ ha}=10000\\text{ m}^{2}$.\n\n$$\\begin{align*}600\\text{ m}^{2}:1\\text{ ha}&=600:10000\\\\&=3:50\\end{align*}$$\nDivide both parts by $200$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
