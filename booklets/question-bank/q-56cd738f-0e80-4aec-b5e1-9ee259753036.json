    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "A new car costs $\\$15000$. After 3 years, the car has lost $35\\%$ of its value. How much is the car worth after 3 years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$9750$",
          "worked": "$$\\begin{align*}\\text{Value lost}&=\\frac{35}{100}\\times\\$15000\\\\\\text{Value lost}&=\\$5250\\\\\\text{Value after 3 years}&=\\$15000-\\$5250\\\\\\text{Value after 3 years}&=\\$9750\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p58-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "A different car costs $\\$18000$ when new and is worth $\\$14000$ after 3 years. What is the percentage decrease in the value of the car?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22.\\dot{2}\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Change in value}&=\\$14000-\\$18000\\\\\\text{Change in value}&=-\\$4000\\\\\\text{Percentage change}&=\\frac{-4000}{18000}\\times100\\%\\\\\\text{Percentage change}&=-22.\\dot{2}\\%\\end{align*}$$\nThe negative result means a $22.\\dot{2}\\%$ decrease.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
