        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "C and D.",
          "worked": "$\\begin{align*}2^{-3}&=\\frac{1}{2^3}\\\\&=\\frac{1}{8}\\\\&=0.125\\end{align*}$\n\nC and D are correct.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "What mistakes have the other students made?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A made $2^3$ negative instead of taking its reciprocal. B used $2\\times3$ instead of $2^3$ in the denominator.",
          "worked": "A treated the negative index as a negative sign, giving $-2^3=-8$. A negative index means take the reciprocal: $2^{-3}=\\frac{1}{2^3}$.\n\nB calculated $\\frac{1}{2\\times3}=\\frac{1}{6}$ instead of $\\frac{1}{2^3}=\\frac{1}{8}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
