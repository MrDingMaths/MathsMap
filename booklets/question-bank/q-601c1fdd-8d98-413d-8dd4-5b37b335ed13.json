  "content": {
    "id": "p13-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "For the function $f(x)=x^2-2x-4$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(1+\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}f(1+\\sqrt{5})&=(1+\\sqrt{5})^2-2(1+\\sqrt{5})-4\\\\f(1+\\sqrt{5})&=1+2\\sqrt{5}+5-2-2\\sqrt{5}-4\\\\f(1+\\sqrt{5})&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p13-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(\\sqrt{3}-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-4\\sqrt{3}$",
          "worked": "$$\\begin{align*}f(\\sqrt{3}-1)&=(\\sqrt{3}-1)^2-2(\\sqrt{3}-1)-4\\\\f(\\sqrt{3}-1)&=3-2\\sqrt{3}+1-2\\sqrt{3}+2-4\\\\f(\\sqrt{3}-1)&=2-4\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
