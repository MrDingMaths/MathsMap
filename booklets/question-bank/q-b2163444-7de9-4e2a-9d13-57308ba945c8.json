    "children": [
      {
        "id": "v2-e5d47-p53-practice-slot-12-s12-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$y'=(y-3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3+\\dfrac{1}{C-x}$, or $y=3$.",
          "worked": "For $y\\ne3$,\n$$\\begin{aligned}\\frac{dx}{dy}&=\\frac1{(y-3)^2}\\\\x&=\\int(y-3)^{-2}\\,dy\\\\x&=-\\frac1{y-3}+C\\\\y-3&=\\frac1{C-x}\\\\y&=3+\\frac1{C-x}.\\end{aligned}$$\nAlso, $y=3$ satisfies the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-e5d47-p53-practice-slot-12-s12-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y'=6-2y,\\quad y(0)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3-2e^{-2x}$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=\\frac1{2(3-y)}\\\\x&=\\int\\frac1{2(3-y)}\\,dy\\\\x&=-\\frac12\\ln|3-y|+C\\\\\\ln|3-y|&=-2x+2C\\\\3-y&=Be^{-2x}\\\\y&=3-Be^{-2x}\\\\1&=3-B\\\\B&=2\\\\y&=3-2e^{-2x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
