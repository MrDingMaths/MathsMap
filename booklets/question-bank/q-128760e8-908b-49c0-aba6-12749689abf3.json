    "prompt": "Differentiate $y=\\dfrac{x^2+x-6}{x-2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y'=1$ for $x\\ne2$. Factorise and cancel $x-2$ first.",
      "worked": "$$\\begin{align*}y&=\\dfrac{x^2+x-6}{x-2}\\\\y&=\\dfrac{(x+3)(x-2)}{x-2}\\\\y&=x+3\\qquad(x\\ne2)\\\\y'&=1\\qquad(x\\ne2).\\end{align*}$$",
      "solutionDiagrams": []
