      {
        "id": "p32-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\displaystyle\\int_0^k x\\,dx=\\frac{k^2}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\int_0^k x\\,dx=\\left[\\frac{x^2}{2}\\right]_0^k=\\frac{k^2}{2}$",
          "worked": "$$\\begin{align*}\\int_0^k x\\,dx&=\\left[\\frac{x^2}{2}\\right]_0^k\\\\&=\\frac{k^2}{2}-\\frac{0^2}{2}\\\\&=\\frac{k^2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p32-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the positive value of $k$ given $\\displaystyle\\int_0^k x\\,dx=18$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=6$",
          "worked": "$$\\begin{align*}\\frac{k^2}{2}&=18\\\\k^2&=36\\\\k&=6\\qquad(k>0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
