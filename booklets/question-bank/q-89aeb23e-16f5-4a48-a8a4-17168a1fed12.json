        "prompt": "$x^{2}+2xy+y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+y)^{2}$",
          "worked": "Square terms: $x^{2}$ and $y^{2}$. Check: $2\\times x\\times y=2xy$.\n$$\\begin{align*}x^{2}+2xy+y^{2}&=(x+y)^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{2}-2xy+y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)^{2}$",
          "worked": "Square terms: $x^{2}$ and $y^{2}$. Check: $2\\times x\\times y=2xy$. The middle term is negative.\n$$\\begin{align*}x^{2}-2xy+y^{2}&=(x-y)^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$4x^{2}+4xy+y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+y)^{2}$",
          "worked": "Square terms: $(2x)^{2}$ and $y^{2}$. Check: $2\\times2x\\times y=4xy$.\n$$\\begin{align*}4x^{2}+4xy+y^{2}&=(2x+y)^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$9x^{2}-6xy+y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-y)^{2}$",
          "worked": "Square terms: $(3x)^{2}$ and $y^{2}$. Check: $2\\times3x\\times y=6xy$. The middle term is negative.\n$$\\begin{align*}9x^{2}-6xy+y^{2}&=(3x-y)^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$25x^{2}+10xy+y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5x+y)^{2}$",
          "worked": "Square terms: $(5x)^{2}$ and $y^{2}$. Check: $2\\times5x\\times y=10xy$.\n$$\\begin{align*}25x^{2}+10xy+y^{2}&=(5x+y)^{2}\\end{align*}$$",
          "solutionDiagrams": []
