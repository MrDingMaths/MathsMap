        "answer": {
          "short": "$AC=13$.",
          "worked": "By Pythagoras in the rectangle, $AC=\\sqrt{12^2+5^2}=\\sqrt{169}=13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q10-b",
        "type": "part",
