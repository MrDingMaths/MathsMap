  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A box $30\\text{ cm}$ long, $30\\text{ cm}$ wide and $30\\text{ cm}$ high holds 50 tennis balls of radius $3\\text{ cm}$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "the volume of one tennis ball, correct to 3 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$113.097\\text{ cm}^3$",
          "worked": "$\\begin{aligned}V&=\\frac43\\pi r^3\\\\&=\\frac43\\pi(3)^3\\\\&=36\\pi\\text{ cm}^3\\\\&\\approx113.097\\text{ cm}^3\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "the volume of 50 tennis balls, correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5654.9\\text{ cm}^3$",
          "worked": "$\\begin{aligned}V_{50}&=50\\times36\\pi\\\\&=1800\\pi\\text{ cm}^3\\\\&\\approx5654.9\\text{ cm}^3\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "the volume of the box not taken up by the tennis balls, correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21345.1\\text{ cm}^3$",
          "worked": "$\\begin{aligned}V_{\\text{box}}&=30\\times30\\times30\\\\&=27000\\text{ cm}^3\\\\V_{\\text{remaining}}&=27000-1800\\pi\\\\&\\approx21345.1\\text{ cm}^3\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
