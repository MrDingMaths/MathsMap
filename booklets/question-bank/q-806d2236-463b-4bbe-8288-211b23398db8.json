  "content": {
    "id": "p23-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Write an algebraic expression for each of the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q3-d",
        "type": "part",
        "label": "a",
        "prompt": "5 is added to $x$, then the result is doubled.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(5+x)$",
          "worked": "Double the whole sum: $2(5+x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p23-q3-e",
        "type": "part",
        "label": "b",
        "prompt": "$a$ is tripled, then 4 is added.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a+4$",
          "worked": "Triple $a$, then add 4: $3a+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q3-f",
        "type": "part",
        "label": "c",
        "prompt": "3 more than half of $n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{n}{2}+3$",
          "worked": "Half of $n$ is $\\frac{n}{2}$; add 3 to obtain $\\frac{n}{2}+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p23-q3-g",
        "type": "part",
        "label": "d",
        "prompt": "6 more than double $n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2n+6$",
          "worked": "Double $n$, then add 6: $2n+6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q3-h",
        "type": "part",
        "label": "e",
        "prompt": "The square of the sum of $m$ and $n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m+n)^2$",
          "worked": "Square the whole sum: $(m+n)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p23-q3-i",
        "type": "part",
        "label": "f",
        "prompt": "The sum of $x$ and $y$ is multiplied by 6.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(x+y)$",
          "worked": "Multiply the whole sum by 6: $6(x+y)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p23-q3-j",
        "type": "part",
        "label": "g",
        "prompt": "$k$ is multiplied by 8, then 3 is subtracted.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8k-3$",
          "worked": "Multiply $k$ by 8, then subtract 3: $8k-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q3-k",
        "type": "part",
        "label": "h",
        "prompt": "The cube of the sum of $m$ and $n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m+n)^3$",
          "worked": "Cube the whole sum: $(m+n)^3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p23-q3-l",
        "type": "part",
        "label": "i",
        "prompt": "The sum of $x$ and $y$ is divided by 5",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+y}{5}$",
          "worked": "Divide the whole sum by 5: $\\frac{x+y}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p23-q3-m",
        "type": "part",
        "label": "j",
        "prompt": "$x$ is multiplied by 7 and the result is halved.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{2}$",
          "worked": "Halve the product $7x$: $\\frac{7x}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p23-q3-n",
        "type": "part",
        "label": "k",
        "prompt": "$k$ is multiplied by 6, then 5 is subtracted.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6k-5$",
          "worked": "Multiply $k$ by 6, then subtract 5: $6k-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q3-o",
        "type": "part",
        "label": "l",
        "prompt": "10 less than the product of 4 and $x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x-10$",
          "worked": "Subtract 10 from the product $4x$: $4x-10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q3-p",
        "type": "part",
        "label": "m",
        "prompt": "The square root of the sum of $x$ and $y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x+y}$",
          "worked": "Take the square root of the whole sum: $\\sqrt{x+y}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p23-q3-q",
        "type": "part",
        "label": "n",
        "prompt": "The product of $x$ and $y$ is subtracted from 12.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12-xy$",
          "worked": "Subtract the product $xy$ from 12: $12-xy$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q3-r",
        "type": "part",
        "label": "o",
        "prompt": "3 is subtracted from $k$, then the result is multiplied by 8.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8(k-3)$",
          "worked": "Multiply the whole difference by 8: $8(k-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
