    "id": "ftc-reciprocal-r7-1-root",
    "type": "question",
    "label": null,
    "prompt": "Evaluate $$\\int_1^2\\left(x^3-\\frac{1}{x^3}\\right)^2\\,dx$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{18297}{1120}$",
      "worked": "$$\\begin{align*}\\int_1^2\\left(x^3-\\frac{1}{x^3}\\right)^2\\,dx&=\\int_1^2(x^6-2+x^{-6})\\,dx\\\\&=\\left[\\frac{x^7}{7}-2x-\\frac{1}{5x^5}\\right]_1^2\\\\&=\\left(\\frac{128}{7}-4-\\frac1{160}\\right)-\\left(\\frac17-2-\\frac15\\right)\\\\&=\\frac{127}{7}-2+\\frac{31}{160}\\\\&=\\frac{18297}{1120}\\end{align*}$$",
      "solutionDiagrams": []
    },
