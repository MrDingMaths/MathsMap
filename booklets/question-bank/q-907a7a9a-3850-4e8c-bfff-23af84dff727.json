  "content": {
    "id": "p5-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Expand the following by repeated application of the distributive law:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+2)(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+6x+8$",
          "worked": "$$\\begin{align*}(x+2)(x+4)&=x(x+2)+4(x+2)\\\\(x+2)(x+4)&=x^2+2x+4x+8\\\\(x+2)(x+4)&=x^2+6x+8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$(n+3)(n-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^2-n-12$",
          "worked": "$$\\begin{align*}(n+3)(n-4)&=n(n+3)-4(n+3)\\\\(n+3)(n-4)&=n^2+3n-4n-12\\\\(n+3)(n-4)&=n^2-n-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$(a-4)(a+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+a-20$",
          "worked": "$$\\begin{align*}(a-4)(a+5)&=a(a-4)+5(a-4)\\\\(a-4)(a+5)&=a^2-4a+5a-20\\\\(a-4)(a+5)&=a^2+a-20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x-5)(x-6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-11x+30$",
          "worked": "$$\\begin{align*}(x-5)(x-6)&=x(x-5)-6(x-5)\\\\(x-5)(x-6)&=x^2-5x-6x+30\\\\(x-5)(x-6)&=x^2-11x+30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$(a+b)(c+d+e)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ac+ad+ae+bc+bd+be$",
          "worked": "$$\\begin{align*}(a+b)(c+d+e)&=c(a+b)+d(a+b)+e(a+b)\\\\(a+b)(c+d+e)&=ac+bc+ad+bd+ae+be\\\\(a+b)(c+d+e)&=ac+ad+ae+bc+bd+be\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x+y)(x-y+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2x-y^2+2y$",
          "worked": "$$\\begin{align*}(x+y)(x-y+2)&=x(x+y)-y(x+y)+2(x+y)\\\\(x+y)(x-y+2)&=x^2+xy-xy-y^2+2x+2y\\\\(x+y)(x-y+2)&=x^2+2x-y^2+2y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
