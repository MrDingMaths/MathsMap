  "content": {
    "id": "p6-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Consider the piecewise defined function and evaluate:\n$$f(x)=\\begin{cases}x^2-2;&x\\geq 3\\\\4;&0<x<3\\\\4x;&x\\leq 0\\end{cases}$$",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "Since $4\\geq3$, use $f(x)=x^2-2$.\n$$\\begin{aligned}f(4)&=4^2-2\\\\&=14\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(0.5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Since $0<0.5<3$, use the constant branch.\n$$f(0.5)=4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12$",
          "worked": "Since $-3\\leq0$, use $f(x)=4x$.\n$$\\begin{aligned}f(-3)&=4(-3)\\\\&=-12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(a)$, where $a$ is negative",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a$",
          "worked": "Since $a<0$, use $f(x)=4x$.\n$$f(a)=4a$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
