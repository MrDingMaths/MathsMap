  "content": {
    "id": "p13-ch20-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The function $f$ is defined by $f(x)=\\dfrac{4}{x}$, $x\\ne0$. Find:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-ch20-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f\\left(\\dfrac12\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}f\\left(\\frac12\\right)&=\\frac{4}{\\frac12}\\\\f\\left(\\frac12\\right)&=4\\times2\\\\f\\left(\\frac12\\right)&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-ch20-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}f(2)&=\\frac42\\\\f(2)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-ch20-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$$\\begin{align*}f(8)&=\\frac48\\\\f(8)&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-ch20-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}f(-2)&=\\frac4{-2}\\\\f(-2)&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
