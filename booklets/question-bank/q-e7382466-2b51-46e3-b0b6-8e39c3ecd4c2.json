  "content": {
    "id": "p24-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the value of $a$ if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q8-parts",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q8-a",
            "type": "part",
            "label": "a",
            "prompt": "$y=\\dfrac{a}{7}x+b$ is parallel to $y=2x-4$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=14$",
              "worked": "Parallel lines have equal gradients.\n$$\\begin{align*}\\frac{a}{7}&=2\\\\a&=14\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p24-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "$y=\\dfrac{2a+1}{3}x+b$ is parallel to $y=-x-3$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=-2$",
              "worked": "Parallel lines have equal gradients.\n$$\\begin{align*}\\frac{2a+1}{3}&=-1\\\\2a+1&=-3\\\\a&=-2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p24-q8-c",
            "type": "part",
            "label": "c",
            "prompt": "$y=\\left(\\dfrac{1-a}{2}\\right)x+b$ is perpendicular to $y=\\dfrac{1}{2}x-\\dfrac{3}{5}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=5$",
              "worked": "The product of perpendicular gradients is $-1$.\n$$\\begin{align*}\\left(\\frac{1-a}{2}\\right)\\left(\\frac{1}{2}\\right)&=-1\\\\\\frac{1-a}{4}&=-1\\\\1-a&=-4\\\\a&=5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 37
          },
          {
            "id": "p24-q8-d",
            "type": "part",
            "label": "d",
            "prompt": "$ay=3x+b$ is perpendicular to $y=-\\dfrac{3}{7}x-1$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=\\dfrac{9}{7}$",
              "worked": "$$\\begin{align*}y&=\\frac{3}{a}x+\\frac{b}{a}\\\\\\left(\\frac{3}{a}\\right)\\left(-\\frac{3}{7}\\right)&=-1\\\\-\\frac{9}{7a}&=-1\\\\9&=7a\\\\a&=\\frac{9}{7}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      },
      {
        "id": "p24-q8-explanation",
        "type": "part",
        "label": "e",
        "prompt": "Explain why your answers above don’t depend on the value of $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel and perpendicular relationships depend only on the gradients.",
          "worked": "Parallel lines have equal gradients, and perpendicular lines have gradients whose product is $-1$. The value of $b$ changes the intercept but does not change either gradient, so it does not affect the values of $a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
