      {
        "id": "p39-q72a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{f(x)}{g(x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-\\dfrac12$.",
          "worked": "$$\\begin{align*}y(1)&=\\frac{f(1)}{g(1)}=\\frac12,\\\\y'(1)&=\\frac{f'(1)g(1)-f(1)g'(1)}{g(1)^2}=\\frac{2(2)-1(0)}{2^2}=1,\\\\y-\\frac12&=1(x-1),\\\\y&=x-\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p39-q72b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{g(x)}{f(x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4x+6$.",
          "worked": "$$\\begin{align*}y(1)&=\\frac{g(1)}{f(1)}=2,\\\\y'(1)&=\\frac{g'(1)f(1)-g(1)f'(1)}{f(1)^2}=\\frac{0(1)-2(2)}{1^2}=-4,\\\\y-2&=-4(x-1),\\\\y&=-4x+6.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
