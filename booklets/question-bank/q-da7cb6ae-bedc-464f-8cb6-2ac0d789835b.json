  "content": {
    "id": "p49-q3",
    "type": "question",
    "label": "3",
    "prompt": "For what value of $k$ will $(x^4-2x^3+x^2-x+k)\\div(x+2)$ have zero remainder?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=-38$",
      "worked": "Let $P(-2)=0$.\n$$\\begin{align*}(-2)^4-2(-2)^3+(-2)^2-(-2)+k&=0\\\\16+16+4+2+k&=0\\\\38+k&=0\\\\k&=-38\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
