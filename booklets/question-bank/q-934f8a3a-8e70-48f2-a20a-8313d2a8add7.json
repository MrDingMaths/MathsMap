  "content": {
    "id": "p2-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The width of a rectangle is $4\\text{ cm}$ longer than its length. Find the rectangle’s dimensions if its perimeter is $36\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Length $7\\text{ cm}$, width $11\\text{ cm}$.",
      "worked": "Let the length and width be $x\\text{ cm}$ and $(x+4)\\text{ cm}$, respectively.\n\n$$\\begin{align*}2x+2(x+4)&=36\\\\4x+8&=36\\\\4x&=28\\\\x&=7\\end{align*}$$\n\nThe length is $7\\text{ cm}$ and the width is $7+4=11\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
