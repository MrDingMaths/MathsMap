    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan20^\\circ+\\cot70^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\tan20^\\circ$ or $2\\cot70^\\circ$",
          "worked": "$$\\begin{align*}\\tan20^\\circ+\\cot70^\\circ&=\\tan20^\\circ+\\tan20^\\circ\\\\\\tan20^\\circ+\\cot70^\\circ&=2\\tan20^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p13-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan20^\\circ\\tan70^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\tan20^\\circ\\tan70^\\circ&=\\tan20^\\circ\\cot20^\\circ\\\\\\tan20^\\circ\\tan70^\\circ&=\\tan20^\\circ\\times\\frac1{\\tan20^\\circ}\\\\\\tan20^\\circ\\tan70^\\circ&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan35^\\circ-\\frac1{\\tan55^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\tan35^\\circ-\\frac1{\\tan55^\\circ}&=\\tan35^\\circ-\\cot55^\\circ\\\\\\tan35^\\circ-\\frac1{\\tan55^\\circ}&=\\tan35^\\circ-\\tan35^\\circ\\\\\\tan35^\\circ-\\frac1{\\tan55^\\circ}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p13-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}&=\\frac{\\sin20^\\circ+\\sin20^\\circ}{\\sin20^\\circ}\\\\\\frac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "$$\\begin{align*}\\frac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}&=\\frac{\\sin48^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}\\\\\\frac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}&=\\frac{3\\sin48^\\circ}{5\\sin48^\\circ}\\\\\\frac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}&=\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2\\tan56^\\circ+3\\cot34^\\circ}{7\\tan56^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac57$",
          "worked": "$$\\begin{align*}\\frac{2\\tan56^\\circ+3\\cot34^\\circ}{7\\tan56^\\circ}&=\\frac{2\\tan56^\\circ+3\\tan56^\\circ}{7\\tan56^\\circ}\\\\\\frac{2\\tan56^\\circ+3\\cot34^\\circ}{7\\tan56^\\circ}&=\\frac{5\\tan56^\\circ}{7\\tan56^\\circ}\\\\\\frac{2\\tan56^\\circ+3\\cot34^\\circ}{7\\tan56^\\circ}&=\\frac57\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
