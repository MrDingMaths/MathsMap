  "content": {
    "id": "p19-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Determine if $A$ and $B$ are independent given\n$$\\Pr(A)=\\frac25,\\quad \\Pr(B)=\\frac34,\\quad \\Pr(A\\cap B)=\\frac3{10}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Independent.",
      "worked": "$$\\Pr(A)\\Pr(B)=\\frac25\\times\\frac34=\\frac3{10}=\\Pr(A\\cap B).$$\nTherefore, $A$ and $B$ are independent.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 22
  },
