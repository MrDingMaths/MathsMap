  "content": {
    "id": "p23-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Natalie runs three times as fast as she walks. She walks for three hours and runs for the two hours, covering a total distance of $18$ km. What is her walking speed?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2$ km/h",
      "worked": "Let $s$ km/h be Natalie's walking speed. Her running speed is $3s$ km/h. She walks $3s$ km and runs $2(3s)$ km.\n$$\\begin{align*}3s+2(3s)&=18\\\\3s+6s&=18\\\\9s&=18\\\\s&=2\\end{align*}$$\nNatalie's walking speed is $2$ km/h.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
