  "content": {
    "id": "p8-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A young girl is making a bracelet by arranging $n$ different coloured beads along a cord. How many different arrangements can she make? Note that two arrangements are considered the same if one can be obtained from the other by a rotation and/or reflection.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{(n-1)!}{2}$ arrangements.\n\nFix one bead to remove rotations, then divide by $2$ for reflections.",
      "worked": "Fix one bead to remove equivalent rotations. The remaining $n-1$ beads can be arranged in $(n-1)!$ ways. Each arrangement and its reflection represent the same bracelet, so divide by $2$.\n\n$$\\begin{align*}\\text{Number of bracelets}&=\\frac{(n-1)!}{2}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
