  "content": {
    "id": "p20-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$3x^0+x^0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "For $x\\ne0$, $x^0=1$.\n\n$$\\begin{align*}3x^0+x^0&=3(1)+1\\\\3x^0+x^0&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p20-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^{\\frac{3}{8}}\\times a^{\\frac{5}{8}}\\times a^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a}$",
          "worked": "The original expression requires $a>0$.\n\n$$\\begin{align*}a^{\\frac{3}{8}}\\times a^{\\frac{5}{8}}\\times a^{-2}&=a^{\\frac{3}{8}+\\frac{5}{8}-2}\\\\a^{\\frac{3}{8}}\\times a^{\\frac{5}{8}}\\times a^{-2}&=a^{-1}\\\\a^{\\frac{3}{8}}\\times a^{\\frac{5}{8}}\\times a^{-2}&=\\frac{1}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3x^2)^2\\div(6x^4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{2}$",
          "worked": "For $x\\ne0$,\n\n$$\\begin{align*}(3x^2)^2\\div(6x^4)&=\\frac{(3x^2)^2}{6x^4}\\\\(3x^2)^2\\div(6x^4)&=\\frac{9x^4}{6x^4}\\\\(3x^2)^2\\div(6x^4)&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p20-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{9^{m-1}\\times2^{m+3}}{6^{m+2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times3^{m-4}$",
          "worked": "$$\\begin{align*}\\frac{9^{m-1}\\times2^{m+3}}{6^{m+2}}&=\\frac{3^{2m-2}\\times2^{m+3}}{2^{m+2}\\times3^{m+2}}\\\\\\frac{9^{m-1}\\times2^{m+3}}{6^{m+2}}&=2^{(m+3)-(m+2)}\\times3^{(2m-2)-(m+2)}\\\\\\frac{9^{m-1}\\times2^{m+3}}{6^{m+2}}&=2\\times3^{m-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
