      {
        "id": "p13-q2-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 13 p13-q2-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,draw=black,text=black,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,3.2);\n\\coordinate (B) at (0,0);\n\\coordinate (C) at (2.1,0);\n\\draw (A)--(B)--(C)--cycle;\n\\draw[line width=0.4pt] ($(B)!0.25cm!(A)$)--($(B)!0.25cm!(A)+(B)!0.25cm!(C)-(B)$)--($(B)!0.25cm!(C)$);\n\\path (A)--(B) node[midway,left] {$c$};\n\\path (B)--(C) node[midway,below] {$a$};\n\\path (A)--(C) node[midway,above right] {$b$};\n\\node[above left] at (A) {$A$};\n\\node[below left] at (B) {$B$};\n\\node[below right] at (C) {$C$};\n\\pic[draw,line width=0.4pt,angle radius=0.7cm] {angle=B--A--C};\n\\path (A)--($(A)!0.48cm!(B)$) coordinate (AxOne);\n\\path (A)--($(A)!0.48cm!(C)$) coordinate (AxTwo);\n\\node at ($(A)+(0.34,-1.08)$) {$x$};\n\\pic[draw,line width=0.4pt,angle radius=0.72cm] {angle=A--C--B};\n\\path (C)--($(C)!1.03cm!(A)$) coordinate (CxOne);\n\\path (C)--($(C)!1.03cm!(B)$) coordinate (CxTwo);\n\\node[anchor=west] at ($(C)+(0.18,0.65)$) {$90^{\\circ}-x$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 36,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 13,
          "sourceRegion": "Question 2, triangle to the left of the six response cells",
          "description": "Unshaded right triangle ABC with A above B and C to the right of B. Vertex and side labels, both angle arcs and the right-angle square are preserved.",
          "mathematics": "AB=c, BC=a, AC=b. Angle B is a right angle, angle A is x and angle C is 90°−x. Coordinates establish schematic proportions only; no numerical side lengths are asserted.",
          "answerVisibility": "All geometry and labels are permanent student givens; no response answers appear in the diagram."
