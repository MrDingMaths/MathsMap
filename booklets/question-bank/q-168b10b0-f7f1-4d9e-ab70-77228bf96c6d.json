    "children": [
      {
        "id": "p13-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a}{b}$",
          "worked": "$$\\begin{align*}\\sin x&=\\frac{\\text{opposite}}{\\text{hypotenuse}}\\\\\\sin x&=\\frac{a}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{c}{b}$",
          "worked": "$$\\begin{align*}\\cos x&=\\frac{\\text{adjacent}}{\\text{hypotenuse}}\\\\\\cos x&=\\frac{c}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a}{c}$",
          "worked": "$$\\begin{align*}\\tan x&=\\frac{\\text{opposite}}{\\text{adjacent}}\\\\\\tan x&=\\frac{a}{c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin(90^{\\circ}-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{c}{b}$",
          "worked": "For angle $90^{\\circ}-x$, the opposite side is $c$.\n$$\\begin{align*}\\sin(90^{\\circ}-x)&=\\frac{\\text{opposite}}{\\text{hypotenuse}}\\\\\\sin(90^{\\circ}-x)&=\\frac{c}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos(90^{\\circ}-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a}{b}$",
          "worked": "For angle $90^{\\circ}-x$, the adjacent side is $a$.\n$$\\begin{align*}\\cos(90^{\\circ}-x)&=\\frac{\\text{adjacent}}{\\text{hypotenuse}}\\\\\\cos(90^{\\circ}-x)&=\\frac{a}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan(90^{\\circ}-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{c}{a}$",
          "worked": "For angle $90^{\\circ}-x$, the opposite side is $c$ and the adjacent side is $a$.\n$$\\begin{align*}\\tan(90^{\\circ}-x)&=\\frac{\\text{opposite}}{\\text{adjacent}}\\\\\\tan(90^{\\circ}-x)&=\\frac{c}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
