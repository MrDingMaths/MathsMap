    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the inverse function of $f(x)=\\frac{1-x}{1+x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=\\frac{1-x}{1+x}$, $x\\ne-1$.",
          "worked": "$$\\begin{align*}y&=\\frac{1-x}{1+x}\\\\x&=\\frac{1-y}{1+y}\\\\x(1+y)&=1-y\\\\x+xy&=1-y\\\\y(x+1)&=1-x\\\\y&=\\frac{1-x}{1+x}\\\\f^{-1}(x)&=\\frac{1-x}{1+x}\\end{align*}$$\nThe inverse has domain $x\\ne-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p23-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "What does this tell you about $f(f(x))$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(f(x))=x$ for $x\\ne-1$: applying $f$ twice returns the original input.",
          "worked": "Since $f=f^{-1}$, applying $f$ twice undoes the first application.\n$$\\begin{align*}f(f(x))&=f^{-1}(f(x))\\\\&=x\\end{align*}$$\nThis holds for $x\\ne-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "What does this tell you about the graph of $f(x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It is symmetrical about the line $y=x$.",
          "worked": "The graph of an inverse is the reflection of the original graph in $y=x$. Since $f=f^{-1}$, this reflection leaves the graph unchanged, so it is symmetrical about $y=x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
