  "content": {
    "id": "p41-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find the volume of a hemisphere whose surface area is $\\dfrac{9\\pi}{2}\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{\\sqrt6\\pi}{2}\\text{ cm}^3$",
      "worked": "The surface area includes the circular base.\n\n$$\\begin{align*}3\\pi r^2&=\\frac{9\\pi}{2}\\\\r^2&=\\frac32\\\\r&=\\frac{\\sqrt6}{2}\\text{ cm}\\\\V&=\\frac23\\pi r^3\\\\V&=\\frac23\\pi\\left(\\frac{\\sqrt6}{2}\\right)^3\\\\V&=\\frac{\\sqrt6\\pi}{2}\\text{ cm}^3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 66
  },
