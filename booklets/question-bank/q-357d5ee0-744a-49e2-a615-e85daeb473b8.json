  "content": {
    "id": "p64-q11",
    "type": "question",
    "label": "11",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p64-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $a(x+b)^2+c=3x^2-12x+15$ for all $x$, find $a,b$, and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3,\\ b=-2,\\ c=3$.",
          "worked": "$$\\begin{align*}\na(x+b)^2+c&=ax^2+2abx+ab^2+c.\n\\end{align*}$$\nEquating coefficients,\n$$\\begin{align*}\na&=3\\\\\n2ab&=-12\\\\\n6b&=-12\\\\\nb&=-2\\\\\nab^2+c&=15\\\\\n3(-2)^2+c&=15\\\\\nc&=3.\n\\end{align*}$$\nThus $3x^2-12x+15=3(x-2)^2+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p64-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the minimum value of $3x^2-12x+15$ and state the value of $x$ at which it occurs.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum value $3$, occurring at $x=2$.",
          "worked": "Since $(x-2)^2\\geq0$,\n$$\\begin{align*}\n3x^2-12x+15&=3(x-2)^2+3\\\\\n&\\geq3.\n\\end{align*}$$\nEquality occurs when $(x-2)^2=0$, so $x=2$. The minimum value is $3$. Equivalently, the parabola has its minimum turning point at $(2,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
