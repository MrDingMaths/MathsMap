  "content": {
    "id": "p54-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Use order of operations to calculate the answer to the following. Show each step of working out. Check your answer using a calculator.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$2+3\\times(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7$",
          "worked": "$$\\begin{align*}2+3\\times(-3)&=2+(-9)\\\\&=2-9\\\\&=-7\\end{align*}$$\nCalculator check: $2+3\\times(-3)=-7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$9+10\\div(-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}9+10\\div(-5)&=9+(-2)\\\\&=9-2\\\\&=7\\end{align*}$$\nCalculator check: $9+10\\div(-5)=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$20+(-4)\\div4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19$",
          "worked": "$$\\begin{align*}20+(-4)\\div4&=20+(-1)\\\\&=20-1\\\\&=19\\end{align*}$$\nCalculator check: $20+(-4)\\div4=19$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$18+(-9)\\times1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}18+(-9)\\times1&=18+(-9)\\\\&=18-9\\\\&=9\\end{align*}$$\nCalculator check: $18+(-9)\\times1=9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$10-2\\times(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$\\begin{align*}10-2\\times(-3)&=10-(-6)\\\\&=10+6\\\\&=16\\end{align*}$$\nCalculator check: $10-2\\times(-3)=16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$10-1\\times(-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{align*}10-1\\times(-4)&=10-(-4)\\\\&=10+4\\\\&=14\\end{align*}$$\nCalculator check: $10-1\\times(-4)=14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$-8-(-7)\\times2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}-8-(-7)\\times2&=-8-(-14)\\\\&=-8+14\\\\&=6\\end{align*}$$\nCalculator check: $-8-(-7)\\times2=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$-2\\times4+8\\times(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-32$",
          "worked": "$$\\begin{align*}-2\\times4+8\\times(-3)&=-8+8\\times(-3)\\\\&=-8+(-24)\\\\&=-8-24\\\\&=-32\\end{align*}$$\nCalculator check: $-2\\times4+8\\times(-3)=-32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p54-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$12\\div(-6)+4\\div(-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}12\\div(-6)+4\\div(-2)&=-2+4\\div(-2)\\\\&=-2+(-2)\\\\&=-2-2\\\\&=-4\\end{align*}$$\nCalculator check: $12\\div(-6)+4\\div(-2)=-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p54-q6-j",
        "type": "part",
        "label": "j",
        "prompt": "$-30\\div5-6\\times2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-18$",
          "worked": "$$\\begin{align*}-30\\div5-6\\times2&=-6-6\\times2\\\\&=-6-12\\\\&=-18\\end{align*}$$\nCalculator check: $-30\\div5-6\\times2=-18$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p54-q6-k",
        "type": "part",
        "label": "k",
        "prompt": "$-2\\times3-4\\div(-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}-2\\times3-4\\div(-2)&=-6-4\\div(-2)\\\\&=-6-(-2)\\\\&=-6+2\\\\&=-4\\end{align*}$$\nCalculator check: $-2\\times3-4\\div(-2)=-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p54-q6-l",
        "type": "part",
        "label": "l",
        "prompt": "$8\\times(-2)-(-3)\\times2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10$",
          "worked": "$$\\begin{align*}8\\times(-2)-(-3)\\times2&=-16-(-3)\\times2\\\\&=-16-(-6)\\\\&=-16+6\\\\&=-10\\end{align*}$$\nCalculator check: $8\\times(-2)-(-3)\\times2=-10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
