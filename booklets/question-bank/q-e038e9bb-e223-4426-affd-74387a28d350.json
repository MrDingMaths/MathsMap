  "content": {
    "id": "p37-q14-pairs-root",
    "type": "question",
    "label": "14",
    "prompt": "Find two numbers which have:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q14-pairs-a",
        "type": "part",
        "label": "a",
        "prompt": "a sum of $-2$ and a difference of $8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3,\\ -5$",
          "worked": "The numbers are $3$ and $-5$. Check both conditions:\n$$\\begin{align*}3+(-5)&=3-5\\\\3+(-5)&=-2\\\\3-(-5)&=3+5\\\\3-(-5)&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q14-pairs-b",
        "type": "part",
        "label": "b",
        "prompt": "a sum of $-6$ and a difference of $12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9,\\ 3$",
          "worked": "The numbers are $-9$ and $3$. Check both conditions:\n$$\\begin{align*}3+(-9)&=3-9\\\\3+(-9)&=-6\\\\3-(-9)&=3+9\\\\3-(-9)&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q14-pairs-c",
        "type": "part",
        "label": "c",
        "prompt": "a sum of $0$ and a difference of $16$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8,\\ -8$",
          "worked": "The numbers are $8$ and $-8$. Check both conditions:\n$$\\begin{align*}8+(-8)&=8-8\\\\8+(-8)&=0\\\\8-(-8)&=8+8\\\\8-(-8)&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q14-pairs-d",
        "type": "part",
        "label": "d",
        "prompt": "a sum of $-8$ and a difference of $2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3,\\ -5$",
          "worked": "The numbers are $-3$ and $-5$. Check both conditions:\n$$\\begin{align*}-3+(-5)&=-3-5\\\\-3+(-5)&=-8\\\\-3-(-5)&=-3+5\\\\-3-(-5)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
