    "id": "v2-27c600-p5-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Mia rides up a bike track that rises 8 m for each 40 m across.\nHer brother Noah rides up a nearby track that rises 6 m for each 20 m across.\nWhich track is steeper?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Noah’s track: $\\dfrac{6}{20}>\\dfrac{8}{40}$.",
      "worked": "Mia:\n$$\\begin{align*}m&=\\frac{8}{40}\\\\m&=\\frac{1}{5}\\end{align*}$$\nNoah:\n$$\\begin{align*}m&=\\frac{6}{20}\\\\m&=\\frac{3}{10}\\end{align*}$$\nNoah’s track is steeper because $\\dfrac{3}{10}>\\dfrac{2}{10}$, so it has the greater gradient.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
