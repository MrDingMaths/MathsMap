  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Factorise each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^3+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x^2-x+1)$",
          "worked": "$$\\begin{align*}x^3+1&=x^3+1^3\\\\x^3+1&=(x+1)(x^2-x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^3-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-2)(a^2+2a+4)$",
          "worked": "$$\\begin{align*}a^3-8&=a^3-2^3\\\\a^3-8&=(a-2)(a^2+2a+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^3+125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+5)(x^2-5x+25)$",
          "worked": "$$\\begin{align*}x^3+125&=x^3+5^3\\\\x^3+125&=(x+5)(x^2-5x+25).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$8-b^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2-b)(b^2+2b+4)$",
          "worked": "$$\\begin{align*}8-b^3&=2^3-b^3\\\\8-b^3&=(2-b)(4+2b+b^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$8x^3+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(4x^2-2x+1)$",
          "worked": "$$\\begin{align*}8x^3+1&=(2x)^3+1^3\\\\8x^3+1&=(2x+1)((2x)^2-2x+1)\\\\8x^3+1&=(2x+1)(4x^2-2x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$27a^3-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3a-2)(9a^2+6a+4)$",
          "worked": "$$\\begin{align*}27a^3-8&=(3a)^3-2^3\\\\27a^3-8&=(3a-2)((3a)^2+(3a)(2)+2^2)\\\\27a^3-8&=(3a-2)(9a^2+6a+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^3+64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)(x^2-4x+16)$",
          "worked": "$$\\begin{align*}x^3+64&=x^3+4^3\\\\x^3+64&=(x+4)(x^2-4x+16).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$8m^3-n^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2m-n)(4m^2+2mn+n^2)$",
          "worked": "$$\\begin{align*}8m^3-n^3&=(2m)^3-n^3\\\\8m^3-n^3&=(2m-n)((2m)^2+2mn+n^2)\\\\8m^3-n^3&=(2m-n)(4m^2+2mn+n^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$64x^3-27y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x-3y)(16x^2+12xy+9y^2)$",
          "worked": "$$\\begin{align*}64x^3-27y^3&=(4x)^3-(3y)^3\\\\64x^3-27y^3&=(4x-3y)((4x)^2+(4x)(3y)+(3y)^2)\\\\64x^3-27y^3&=(4x-3y)(16x^2+12xy+9y^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$8a^3-27b^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2a-3b)(4a^2+6ab+9b^2)$",
          "worked": "$$\\begin{align*}8a^3-27b^3&=(2a)^3-(3b)^3\\\\8a^3-27b^3&=(2a-3b)((2a)^2+(2a)(3b)+(3b)^2)\\\\8a^3-27b^3&=(2a-3b)(4a^2+6ab+9b^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$27x^3-125y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-5y)(9x^2+15xy+25y^2)$",
          "worked": "$$\\begin{align*}27x^3-125y^3&=(3x)^3-(5y)^3\\\\27x^3-125y^3&=(3x-5y)((3x)^2+(3x)(5y)+(5y)^2)\\\\27x^3-125y^3&=(3x-5y)(9x^2+15xy+25y^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$8a^3b^3-27c^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2ab-3c)(4a^2b^2+6abc+9c^2)$",
          "worked": "$$\\begin{align*}8a^3b^3-27c^3&=(2ab)^3-(3c)^3\\\\8a^3b^3-27c^3&=(2ab-3c)((2ab)^2+(2ab)(3c)+(3c)^2)\\\\8a^3b^3-27c^3&=(2ab-3c)(4a^2b^2+6abc+9c^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
