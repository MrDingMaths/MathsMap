  "content": {
    "id": "p18-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Four extra seats are added to each row of seats in a theatre. There were originally $x$ seats in each row and there are 20 rows of seats. How many seats are there now, in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20(x+4)$ seats",
      "worked": "There are $x+4$ seats in each row and 20 rows, so the total is\n$$20\\times(x+4)=20(x+4)\\text{ seats}.$$",
      "solutionDiagrams": []
    },
