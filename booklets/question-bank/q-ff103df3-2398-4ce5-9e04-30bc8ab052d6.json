  "content": {
    "id": "p14-q8",
    "type": "question",
    "label": "8",
    "prompt": "The height of a plant increases by $150\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the new height if the original height was $70\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$175\\text{ cm}$",
          "worked": "$$\\begin{align*}100\\%+150\\%&=250\\%\\\\\\text{New height}&=250\\%\\times70\\\\\\text{New height}&=2.5\\times70\\\\\\text{New height}&=175\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why multiplying by $1.5$ is incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "To increase, we add $150\\%$ to $100\\%$, which is $250\\%$. Therefore, we should multiply by $2.5$.",
          "worked": "Multiplying by $1.5$ gives $150\\%$ of the original, which is only a $50\\%$ increase. A $150\\%$ increase retains the original $100\\%$ and adds $150\\%$, giving $250\\%$ of the original. The required multiplier is $2.5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
