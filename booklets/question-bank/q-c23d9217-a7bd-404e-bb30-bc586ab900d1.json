          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "For this question, you may assume the identity ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\tan2\\theta=\\frac{2\\tan\\theta}{1-\\tan^2\\theta}",
              "display": false
            },
            {
              "type": "text",
