    "id": "v2-a52cc-p10-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "What sum of money needs to be invested to accumulate a total of $\\$30\\,000$ after 5 years at 3.6% p.a. interest compounding annually? Answer to the nearest dollar.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$25\\,138$",
      "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\30\\,000 &= PV(1+0.036)^5\\\\\\frac{30\\,000}{(1+0.036)^5} &= PV\\\\PV &\\approx \\$25\\,138\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
