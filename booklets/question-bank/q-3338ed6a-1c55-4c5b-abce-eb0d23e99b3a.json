      "evidence": ".booklet-work/reasoning-ratings/calls/logarithms-v1/4c2e5995df7310707f7cf78e360e5e650ce98f11f544c8f1f8c5f7b44f3af96e-1792560614807/last-message.txt"
    }
  },
  "content": {
    "id": "p15-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Given that $\\log_2 3\\approx1.58$ and $\\log_2 5\\approx2.32$, use the log laws to find approximations for",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx3.90$",
          "worked": "$$\\begin{align*}\\log_2 15&=\\log_2(3\\times5)\\\\&=\\log_2 3+\\log_2 5\\\\&\\approx1.58+2.32\\\\&=3.90\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p15-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx3.16$",
          "worked": "$$\\begin{align*}\\log_2 9&=\\log_2(3^2)\\\\&=2\\log_2 3\\\\&\\approx2(1.58)\\\\&=3.16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p15-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2 10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx3.32$",
          "worked": "$$\\begin{align*}\\log_2 10&=\\log_2(2\\times5)\\\\&=\\log_2 2+\\log_2 5\\\\&\\approx1+2.32\\\\&=3.32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p15-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_2 50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx5.64$",
          "worked": "$$\\begin{align*}\\log_2 50&=\\log_2(2\\times5^2)\\\\&=\\log_2 2+2\\log_2 5\\\\&\\approx1+2(2.32)\\\\&=5.64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p15-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_2\\left(\\frac{3}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx0.58$",
          "worked": "$$\\begin{align*}\\log_2\\left(\\frac{3}{2}\\right)&=\\log_2 3-\\log_2 2\\\\&\\approx1.58-1\\\\&=0.58\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p15-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_2\\left(\\frac{3}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx-0.74$",
          "worked": "$$\\begin{align*}\\log_2\\left(\\frac{3}{5}\\right)&=\\log_2 3-\\log_2 5\\\\&\\approx1.58-2.32\\\\&=-0.74\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p15-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_2\\left(\\frac{2}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx-0.58$",
          "worked": "$$\\begin{align*}\\log_2\\left(\\frac{2}{3}\\right)&=\\log_2 2-\\log_2 3\\\\&\\approx1-1.58\\\\&=-0.58\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p15-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_2 75$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx6.22$",
          "worked": "$$\\begin{align*}\\log_2 75&=\\log_2(3\\times5^2)\\\\&=\\log_2 3+2\\log_2 5\\\\&\\approx1.58+2(2.32)\\\\&=6.22\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
