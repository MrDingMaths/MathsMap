    "id": "routine-bivar-r248-spreadsheet-analysis-2-root",
    "type": "question",
    "label": null,
    "prompt": "A spreadsheet gives the equation of the regression line $y=2.74x+6.3$, where $x$ is the number of weeks since a seedling was planted and $y$ is the height of the seedling in cm. Use the equation of the regression line to predict the height of the seedling after 13 weeks. Round to the nearest whole.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "42 cm",
      "worked": "Let $x=13$.\n$$\\begin{aligned}y&=2.74(13)+6.3\\\\y&=41.92\\\\y&\\approx42\\text{ cm}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
