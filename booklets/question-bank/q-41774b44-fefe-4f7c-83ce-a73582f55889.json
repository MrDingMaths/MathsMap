  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The number $10\\,000$ is a perfect square. Which perfect squares lie immediately before and after $10\\,000$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9801$ and $10\\,201$.",
      "worked": "$$\\begin{align*}100^2 &= 10\\,000\\\\99^2 &= 9801\\\\101^2 &= 10\\,201\\end{align*}$$\nThe neighbouring positive integers are $99$ and $101$, so the perfect squares immediately before and after $10\\,000$ are $9801$ and $10\\,201$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
