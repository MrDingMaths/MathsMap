  "content": {
    "id": "v2-607fa7aa7-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "A uniform discrete random variable $X$ has the values given. Find the expected value for $X$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-607fa7aa7-practice-slot-3-slot3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$x\\in\\{1,2,3,4,5,6\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=3.5$",
          "worked": "Each of the six outcomes has probability $\\frac16$.\n\n$$\\begin{align*}E(X)&=1\\times\\frac16+2\\times\\frac16+3\\times\\frac16+4\\times\\frac16+5\\times\\frac16+6\\times\\frac16\\\\E(X)&=\\frac{21}{6}\\\\E(X)&=3.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-607fa7aa7-practice-slot-3-slot3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\in\\{3,6,9,12,15\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=9$",
          "worked": "Each of the five outcomes has probability $\\frac15$.\n\n$$\\begin{align*}E(X)&=3\\times\\frac15+6\\times\\frac15+9\\times\\frac15+12\\times\\frac15+15\\times\\frac15\\\\E(X)&=\\frac{45}{5}\\\\E(X)&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
