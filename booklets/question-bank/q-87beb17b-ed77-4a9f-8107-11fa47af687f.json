  "content": {
    "id": "p102-q17-content",
    "type": "question",
    "label": "17",
    "prompt": "Two fractions are equally spaced between $\\frac{1}{4}$ and $\\frac{4}{5}$. Find the two fractions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{13}{30}$ and $\\frac{37}{60}$. Each gap is $\\left(\\frac45-\\frac14\\right)\\div3=\\frac{11}{60}$.",
      "worked": "The two fractions divide the interval into three equal gaps.\n$$\\begin{align*}\n\\text{Total gap}&=\\frac45-\\frac14\\\\\n&=\\frac{11}{20}\\\\\n\\text{Equal gap}&=\\frac{11}{20}\\div3\\\\\n&=\\frac{11}{60}\\\\\n\\text{First fraction}&=\\frac14+\\frac{11}{60}\\\\\n&=\\frac{15}{60}+\\frac{11}{60}\\\\\n&=\\frac{26}{60}=\\frac{13}{30}\\\\\n\\text{Second fraction}&=\\frac{26}{60}+\\frac{11}{60}\\\\\n&=\\frac{37}{60}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
