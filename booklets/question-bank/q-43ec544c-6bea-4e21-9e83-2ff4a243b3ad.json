            {
              "type": "text",
              "text": "Ali buys a car for $18000.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "The value of the car depreciates by 16% in the first year and 12% each year after the first.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Work out the value of the car at the end of 3 years. Give your answer to the nearest cent.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
