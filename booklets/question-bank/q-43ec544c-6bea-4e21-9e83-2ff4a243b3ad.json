    "answer": {
      "short": "\\$11,708.93",
      "worked": "The multipliers are $0.84$ for the first year and $0.88$ for each following year.\n$$\\begin{align*}\\text{Value after 3 years}&=18000\\times0.84\\times0.88\\times0.88\\\\\\text{Value after 3 years}&=11708.928\\\\\\text{Value after 3 years}&\\approx\\$11{,}708.93\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
