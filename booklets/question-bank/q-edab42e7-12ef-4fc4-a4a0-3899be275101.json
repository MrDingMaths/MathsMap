        "children": [
          {
            "id": "p29-q8-a",
            "type": "part",
            "label": "a",
            "prompt": "Explain why this is a polynomial of the form $y=a(x+1)^2(x-2)^3$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The graph shows a double root at $x=-1$ and a triple root at $x=2$.",
              "worked": "The curve touches and turns at $x=-1$, indicating a double root and the factor $(x+1)^2$. It crosses with horizontal flattening at $x=2$, indicating a triple root and the factor $(x-2)^3$. Hence its form is $y=a(x+1)^2(x-2)^3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p29-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "Find the value of $a$ by using the $y$-intercept.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=\\frac12$",
              "worked": "The $y$-intercept is $(0,-4)$.\n$$\\begin{align*}-4&=a(0+1)^2(0-2)^3\\\\-4&=-8a\\\\a&=\\frac12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ],
        "diagramPlacement": "beside-prompt"
      },
      {
        "id": "p29-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, state the equation of the polynomial.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=\\frac12(x+1)^2(x-2)^3$",
          "worked": "Using $a=\\frac12$,\n$$P(x)=\\frac12(x+1)^2(x-2)^3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
