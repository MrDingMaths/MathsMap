            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"polynomial graph series\"}],\"reference\":\"source page 29, p29-q8-graph\"}\n\\begin{tikzpicture}[x=1.1cm,y=0.48cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\draw[black,line width=0.5pt,->] (-2,0)--(3.25,0) node[right] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-7.3)--(0,5.8) node[above] {$y$};\n\\draw[black,line width=0.4pt] (-1,-0.12)--(-1,0.12);\n\\draw[black,line width=0.4pt] (2,-0.12)--(2,0.12);\n\\draw[black,line width=0.4pt] (-0.08,-4)--(0.08,-4);\n\\node[above] at (-1,0.12) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[below] at (2,-0.12) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\node[left] at (-0.08,-4) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-4$\\special{dvisvgm:raw </g>}};\n\\draw[curveBlue,line width=0.8pt,<->,domain=-1.55:2.9,samples=240] plot (\\x,{0.5*(\\x+1)^2*(\\x-2)^3});\n\\end{tikzpicture}",
