  "content": {
    "id": "p3-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Let $P(x)=x^3-x^2+x-1$. Find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}P(2)&=2^3-2^2+2-1\\\\P(2)&=8-4+2-1\\\\P(2)&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p3-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-40$",
          "worked": "$$\\begin{align*}P(-3)&=(-3)^3-(-3)^2+(-3)-1\\\\P(-3)&=-27-9-3-1\\\\P(-3)&=-40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p3-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(2a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8a^3-4a^2+2a-1$",
          "worked": "$$\\begin{align*}P(2a)&=(2a)^3-(2a)^2+2a-1\\\\P(2a)&=8a^3-4a^2+2a-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
