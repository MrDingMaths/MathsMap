    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1-\\sin\\theta)(1+\\sin\\theta)=\\cos^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1-\\sin^2\\theta=\\cos^2\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=1^2-\\sin^2\\theta\\\\&=1-\\sin^2\\theta\\\\&=\\cos^2\\theta\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(1+\\tan^2\\alpha)\\cos^2\\alpha=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sec^2\\alpha\\cos^2\\alpha=1=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\sec^2\\alpha\\cos^2\\alpha\\\\&=\\left(\\frac{1}{\\cos^2\\alpha}\\right)\\cos^2\\alpha\\\\&=1\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p31-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\sin A+\\cos A)^2=1+2\\sin A\\cos A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sin^2 A+2\\sin A\\cos A+\\cos^2 A=1+2\\sin A\\cos A=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\sin^2 A+2\\sin A\\cos A+\\cos^2 A\\\\&=(\\sin^2 A+\\cos^2 A)+2\\sin A\\cos A\\\\&=1+2\\sin A\\cos A\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p31-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos^2 x-\\sin^2 x=1-2\\sin^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{RHS}=(\\sin^2 x+\\cos^2 x)-2\\sin^2 x=\\cos^2 x-\\sin^2 x=\\mathrm{LHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{RHS}&=(\\sin^2 x+\\cos^2 x)-2\\sin^2 x\\\\&=\\cos^2 x-\\sin^2 x\\\\&=\\mathrm{LHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p31-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\tan^2\\varphi\\cos^2\\varphi+\\cot^2\\varphi\\sin^2\\varphi=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sin^2\\varphi+\\cos^2\\varphi=1=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\left(\\frac{\\sin^2\\varphi}{\\cos^2\\varphi}\\right)\\cos^2\\varphi+\\left(\\frac{\\cos^2\\varphi}{\\sin^2\\varphi}\\right)\\sin^2\\varphi\\\\&=\\sin^2\\varphi+\\cos^2\\varphi\\\\&=1\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p31-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$3\\cos^2\\theta-2=1-3\\sin^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{RHS}=1-3(1-\\cos^2\\theta)=3\\cos^2\\theta-2=\\mathrm{LHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{RHS}&=1-3(1-\\cos^2\\theta)\\\\&=1-3+3\\cos^2\\theta\\\\&=3\\cos^2\\theta-2\\\\&=\\mathrm{LHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$2\\tan^2 A-1=2\\sec^2 A-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{RHS}=2(1+\\tan^2 A)-3=2\\tan^2 A-1=\\mathrm{LHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{RHS}&=2(1+\\tan^2 A)-3\\\\&=2+2\\tan^2 A-3\\\\&=2\\tan^2 A-1\\\\&=\\mathrm{LHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$1-\\tan^2\\alpha+\\sec^2\\alpha=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1-\\tan^2\\alpha+(1+\\tan^2\\alpha)=2=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=1-\\tan^2\\alpha+\\sec^2\\alpha\\\\&=1-\\tan^2\\alpha+(1+\\tan^2\\alpha)\\\\&=2\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\cos^4 x+\\cos^2 x\\sin^2 x=\\cos^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\cos^2 x(\\cos^2 x+\\sin^2 x)=\\cos^2 x=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\cos^2 x(\\cos^2 x+\\sin^2 x)\\\\&=\\cos^2 x\\cdot1\\\\&=\\cos^2 x\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\cot\\theta(\\sec^2\\theta-1)=\\tan\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\cot\\theta\\tan^2\\theta=\\tan\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\cot\\theta\\cdot\\tan^2\\theta\\\\&=\\left(\\frac{1}{\\tan\\theta}\\right)\\tan^2\\theta\\\\&=\\tan\\theta\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p31-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$2\\cos^2\\theta-1=1-2\\sin^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\cos^2\\theta-\\sin^2\\theta=(1-\\sin^2\\theta)-\\sin^2\\theta=1-2\\sin^2\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=2\\cos^2\\theta-(\\sin^2\\theta+\\cos^2\\theta)\\\\&=2\\cos^2\\theta-\\sin^2\\theta-\\cos^2\\theta\\\\&=\\cos^2\\theta-\\sin^2\\theta\\\\&=(1-\\sin^2\\theta)-\\sin^2\\theta\\\\&=1-2\\sin^2\\theta\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p31-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\tan\\theta\\sin\\theta+\\cos\\theta=\\sec\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sin^2\\theta+\\cos^2\\theta}{\\cos\\theta}=\\dfrac{1}{\\cos\\theta}=\\sec\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sin\\theta}{\\cos\\theta}\\cdot\\sin\\theta+\\cos\\theta\\\\&=\\frac{\\sin^2\\theta}{\\cos\\theta}+\\cos\\theta\\\\&=\\frac{\\sin^2\\theta+\\cos^2\\theta}{\\cos\\theta}\\\\&=\\frac{1}{\\cos\\theta}\\\\&=\\sec\\theta\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
