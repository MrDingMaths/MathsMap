        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 4$",
          "worked": "Since $\\sqrt{x}\\ge 0$,\n$$\\begin{align*}-\\sqrt{x}+4&\\le 4\\\\y&\\le 4.\\end{align*}$$\nThe maximum is attained at $x=0$, and there is no lower bound.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q13-f",
        "type": "part",
