  "content": {
    "id": "p89-task-1-4-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p89-task-1-4-root-category-instruction-0",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "In each of the following, state the equations of the horizontal and vertical asymptotes.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p89-task-1-4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{4}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal: $y=0$; vertical: $x=0$.",
          "worked": "The denominator is zero at $x=0$, so the vertical asymptote is $x=0$.\n\nAs $x\\to\\pm\\infty$, $\\dfrac{4}{x}\\to0$, so the horizontal asymptote is $y=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p89-task-1-4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{2}{x+3}+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal: $y=1$; vertical: $x=-3$.",
          "worked": "The denominator $x+3$ is zero at $x=-3$, so the vertical asymptote is $x=-3$.\n\nAs $x\\to\\pm\\infty$, $\\dfrac{2}{x+3}\\to0$ and $y\\to1$, so the horizontal asymptote is $y=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p89-task-1-4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-\\dfrac{3}{x-1}+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal: $y=4$; vertical: $x=1$.",
          "worked": "The denominator $x-1$ is zero at $x=1$, so the vertical asymptote is $x=1$.\n\nAs $x\\to\\pm\\infty$, $-\\dfrac{3}{x-1}\\to0$ and $y\\to4$, so the horizontal asymptote is $y=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p89-task-1-4-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=-\\dfrac{5}{2-x}-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal: $y=-3$; vertical: $x=2$.",
          "worked": "The denominator $2-x$ is zero at $x=2$, so the vertical asymptote is $x=2$.\n\nAs $x\\to\\pm\\infty$, $-\\dfrac{5}{2-x}\\to0$ and $y\\to-3$, so the horizontal asymptote is $y=-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
