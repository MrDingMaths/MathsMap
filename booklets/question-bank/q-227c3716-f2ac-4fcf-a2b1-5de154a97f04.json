  "content": {
    "id": "p33-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A line passes through the point $(1,5)$ and crosses the $y$-axis at the point $(0,3)$. At what point does it cross the $x$-axis?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\left(-\\frac{3}{2},0\\right)$",
      "worked": "The gradient is\n$$\\begin{align*}m&=\\frac{5-3}{1-0}\\\\m&=2.\\end{align*}$$\nLet the point on the $x$-axis be $(x,0)$. Using $(0,3)$,\n$$\\begin{align*}\\frac{0-3}{x-0}&=2\\\\-3&=2x\\\\x&=-\\frac{3}{2}.\\end{align*}$$\nThe line crosses the $x$-axis at $\\left(-\\frac{3}{2},0\\right)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 58
  },
