      {
        "id": "p7-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down all rational numbers in the interval $[0,\\pi]$ with denominators less than $4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0,\\frac13,\\frac12,\\frac23,1,\\frac43,\\frac32,\\frac53,2,\\frac73,\\frac52,\\frac83,3$",
          "worked": "Use positive denominators $1$, $2$ and $3$. Since $3<\\pi<\\frac{10}{3}$, the possible numerators are $0$ to $3$ for denominator $1$, $0$ to $6$ for denominator $2$, and $0$ to $9$ for denominator $3$. Remove repeated values to obtain\n\n$0,\\frac13,\\frac12,\\frac23,1,\\frac43,\\frac32,\\frac53,2,\\frac73,\\frac52,\\frac83,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the lowest common denominator required to calculate $\\frac1{12}+\\frac1{30}+\\frac1{75}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$300$",
          "worked": "$$\\begin{align*}12&=2^2\\times3\\\\30&=2\\times3\\times5\\\\75&=3\\times5^2\\\\\\operatorname{LCM}(12,30,75)&=2^2\\times3\\times5^2\\\\\\operatorname{LCM}(12,30,75)&=300\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
