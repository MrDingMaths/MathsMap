          {
            "id": "p12-q11-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$(31)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$961$",
              "worked": "$$\\begin{align*}31^2&=(31-1)(31+1)+1^2\\\\31^2&=30\\times32+1\\\\31^2&=961.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p12-q11-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$(42)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1764$",
              "worked": "$$\\begin{align*}42^2&=(42-2)(42+2)+2^2\\\\42^2&=40\\times44+4\\\\42^2&=1764.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p12-q11-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$(101)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10\\,201$",
              "worked": "$$\\begin{align*}101^2&=(101-1)(101+1)+1^2\\\\101^2&=100\\times102+1\\\\101^2&=10\\,201.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p12-q11-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$(3003)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9\\,018\\,009$\n\nUse $m=3$ to make one factor $3000$.",
              "worked": "$$\\begin{align*}3003^2&=(3003-3)(3003+3)+3^2\\\\3003^2&=3000\\times3006+9\\\\3003^2&=9\\,018\\,000+9\\\\3003^2&=9\\,018\\,009.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      }
