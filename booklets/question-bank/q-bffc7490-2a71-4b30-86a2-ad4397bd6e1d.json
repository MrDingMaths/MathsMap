        "type": "part",
        "label": "a",
        "prompt": "Prove that $n^2=(n-m)(n+m)+m^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n-m)(n+m)+m^2=n^2-m^2+m^2=n^2$.",
          "worked": "$$\\begin{align*}(n-m)(n+m)+m^2&=n^2-m^2+m^2\\\\(n-m)(n+m)+m^2&=n^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q11-b",
        "type": "group",
        "label": "b",
        "prompt": {
