  "content": {
    "id": "p19-q6",
    "type": "question",
    "label": "6",
    "prompt": "Christopher runs 120 m in 15 s.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation relating distance $d$ and time $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d = 8t$, where $d$ is in metres and $t$ is in seconds.",
          "worked": "Assuming constant speed,\n$$\\begin{align*}d &= kt\\\\120 &= k\\times15\\\\k &= \\frac{120}{15}\\\\k &= 8\\\\d &= 8t\\end{align*}$$\nHere $d$ is in metres and $t$ is in seconds.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p19-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "What does the constant of variation represent in this scenario? Include units in your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Christopher's speed: 8 metres per second.",
          "worked": "The constant $k=8$ represents Christopher's speed: he travels 8 metres each second, so its units are metres per second.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Use your equation to show that Christopher runs 4800 metres in 10 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\text{ minutes}=600\\text{ seconds}$, so $d=8\\times600=4800\\text{ m}$.",
          "worked": "$$\\begin{align*}t &= 10\\times60\\\\t &= 600\\text{ s}\\\\d &= 8\\times600\\\\d &= 4800\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Considering your answer to part **b**, what is a limitation of the linear model?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The model assumes constant speed. Christopher may slow down as he tires, so it may be unsuitable for longer durations.",
          "worked": "The equation $d=8t$ assumes Christopher maintains a speed of 8 metres per second. He may slow down as he gets tired, so the model may overestimate the distance he runs over longer durations.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
