  "content": {
    "id": "p61-q9-root",
    "type": "question",
    "label": null,
    "prompt": "$PQR$ is a triangle. The point $M$ is the midpoint of $QR$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p61-q9-figure",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 61 question 9\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (P) at (0,0);\\coordinate (Q) at (1.7,2.8);\\coordinate (R) at (2.4,0.2);\\coordinate (M) at ($(Q)!0.5!(R)$);\n\\draw (P)--(Q)--(R)--cycle;\n\\draw[->] (P)--($(P)!0.55!(Q)$);\n\\draw[->] (P)--($(P)!0.55!(R)$);\n\\fill (M) circle (1.4pt);\n\\node[below left] at (P) {$P$};\\node[above] at (Q) {$Q$};\\node[right] at (R) {$R$};\\node[right] at (M) {$M$};\n\\path (P)--(Q) node[midway,left] {$\\underset{\\sim}{a}+4\\underset{\\sim}{b}$};\n\\path (P)--(R) node[midway,below] {$\\underset{\\sim}{a}+2\\underset{\\sim}{b}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 44,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 61,
          "sourceRegion": "Question 9 diagram",
          "description": "Triangle PQR with midpoint M on QR and directed sides PQ and PR.",
          "mathematics": "PQ=a+4b; PR=a+2b; QM=MR.",
          "answerVisibility": "Givens only."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p61-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $\\overrightarrow{QM}$ in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{QR}&=\\overrightarrow{PR}-\\overrightarrow{PQ}\\\\\\overrightarrow{QR}&=(\\underset{\\sim}{a}+2\\underset{\\sim}{b})-(\\underset{\\sim}{a}+4\\underset{\\sim}{b})\\\\\\overrightarrow{QR}&=-2\\underset{\\sim}{b}\\\\\\overrightarrow{QM}&=\\tfrac12\\overrightarrow{QR}=-\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p61-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Write $\\overrightarrow{PM}$ in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{a}+3\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{PM}&=\\overrightarrow{PQ}+\\overrightarrow{QM}\\\\\\overrightarrow{PM}&=(\\underset{\\sim}{a}+4\\underset{\\sim}{b})-\\underset{\\sim}{b}\\\\\\overrightarrow{PM}&=\\underset{\\sim}{a}+3\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
