  "content": {
    "id": "p10-q5",
    "type": "question",
    "label": "5",
    "prompt": "Consider this dataset: $0, 2, 2, 3, 4, 5, 6, 8$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5a",
        "type": "part",
        "label": "a",
        "prompt": "What is the mode?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$2$ occurs twice; every other value occurs once. The mode is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 7
      },
      {
        "id": "p10-q5b",
        "type": "part",
        "label": "b",
        "prompt": "Change one score to make the mode 3. List the new scores.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $0, 2, 3, 3, 4, 5, 6, 8$.",
          "worked": "Change one $2$ to $3$: $0, 2, 3, 3, 4, 5, 6, 8$. Now $3$ occurs twice and every other value occurs once, so the mode is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 7
      },
      {
        "id": "p10-q5c",
        "type": "part",
        "label": "c",
        "prompt": "Change the scores to make the mode 5. List the new scores.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $0, 2, 3, 4, 5, 5, 5, 8$.",
          "worked": "Change one $2$ and the $6$ to $5$. In ascending order, the new scores are $0, 2, 3, 4, 5, 5, 5, 8$. Now $5$ occurs three times and every other value occurs once, so the mode is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 7
      },
      {
        "id": "p10-q5d",
        "type": "part",
        "label": "d",
        "prompt": "Change the scores to make the modes 5 and 6. List the new scores.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $0, 2, 5, 3, 4, 5, 6, 6$.",
          "worked": "Change one $2$ to $5$ and $8$ to $6$. In ascending order, the new scores are $0, 2, 3, 4, 5, 5, 6, 6$. Both $5$ and $6$ occur twice; every other value occurs once. The modes are $5$ and $6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 7
      },
      {
        "id": "p10-q5e",
        "type": "part",
        "label": "e",
        "prompt": "Change the scores to have no mode. List your new scores.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $0, 1, 2, 3, 4, 5, 6, 8$.",
          "worked": "Change one $2$ to $1$: $0, 1, 2, 3, 4, 5, 6, 8$. Every value occurs once, so there is no mode.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 7
      }
    ]
  },
