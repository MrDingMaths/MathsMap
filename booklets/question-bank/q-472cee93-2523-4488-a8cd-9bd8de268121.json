    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x^2-1}{x^2-x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-1}{x-2}$",
          "worked": "$\\begin{align*}\\frac{x^2-1}{x^2-x-2}&=\\frac{(x-1)(x+1)}{(x-2)(x+1)}\\\\\\frac{x^2-1}{x^2-x-2}&=\\frac{x-1}{x-2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x^2-4}{x^2-3x-10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-2}{x-5}$",
          "worked": "$\\begin{align*}\\frac{x^2-4}{x^2-3x-10}&=\\frac{(x-2)(x+2)}{(x-5)(x+2)}\\\\\\frac{x^2-4}{x^2-3x-10}&=\\frac{x-2}{x-5}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x^2+4x-5}{x^2-2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+5}{x-1}$",
          "worked": "$\\begin{align*}\\frac{x^2+4x-5}{x^2-2x+1}&=\\frac{(x+5)(x-1)}{(x-1)^2}\\\\\\frac{x^2+4x-5}{x^2-2x+1}&=\\frac{x+5}{x-1}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x^2+x-12}{x^2-3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+4}{x}$",
          "worked": "$\\begin{align*}\\frac{x^2+x-12}{x^2-3x}&=\\frac{(x+4)(x-3)}{x(x-3)}\\\\\\frac{x^2+x-12}{x^2-3x}&=\\frac{x+4}{x}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x^2-x-20}{x^2+x-12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-5}{x-3}$",
          "worked": "$\\begin{align*}\\frac{x^2-x-20}{x^2+x-12}&=\\frac{(x-5)(x+4)}{(x+4)(x-3)}\\\\\\frac{x^2-x-20}{x^2+x-12}&=\\frac{x-5}{x-3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{x^2+6x+9}{x^2+x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+3}{x-2}$",
          "worked": "$\\begin{align*}\\frac{x^2+6x+9}{x^2+x-6}&=\\frac{(x+3)^2}{(x+3)(x-2)}\\\\\\frac{x^2+6x+9}{x^2+x-6}&=\\frac{x+3}{x-2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{2x^2-18}{3x^2+3x-18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(x-3)}{3(x-2)}$",
          "worked": "$\\begin{align*}\\frac{2x^2-18}{3x^2+3x-18}&=\\frac{2(x^2-9)}{3(x^2+x-6)}\\\\\\frac{2x^2-18}{3x^2+3x-18}&=\\frac{2(x-3)(x+3)}{3(x+3)(x-2)}\\\\\\frac{2x^2-18}{3x^2+3x-18}&=\\frac{2(x-3)}{3(x-2)}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x^2-5x+6}{x^2-4x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-3}{x-2}$",
          "worked": "$\\begin{align*}\\frac{x^2-5x+6}{x^2-4x+4}&=\\frac{(x-2)(x-3)}{(x-2)^2}\\\\\\frac{x^2-5x+6}{x^2-4x+4}&=\\frac{x-3}{x-2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{3x^2+3x-36}{x^2+8x+16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3(x-3)}{x+4}$",
          "worked": "$\\begin{align*}\\frac{3x^2+3x-36}{x^2+8x+16}&=\\frac{3(x^2+x-12)}{(x+4)^2}\\\\\\frac{3x^2+3x-36}{x^2+8x+16}&=\\frac{3(x+4)(x-3)}{(x+4)^2}\\\\\\frac{3x^2+3x-36}{x^2+8x+16}&=\\frac{3(x-3)}{x+4}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
