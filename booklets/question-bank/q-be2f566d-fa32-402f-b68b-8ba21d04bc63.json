  "content": {
    "id": "p87-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Consider the digits 1, 2, 3, 4 and 5.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p87-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How many four-digit passwords can be formed if there is no repetition?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "$$\\begin{aligned}{}^{5}P_{4}&=5\\times4\\times3\\times2\\\\&=120.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p87-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How many five-digit passwords can be formed, if there is no repetition?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "$$\\begin{aligned}{}^{5}P_{5}&=5\\times4\\times3\\times2\\times1\\\\&=120.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p87-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why the answers from a and b are the same, even though there are differing numbers of digits.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each four-digit password has exactly one unused digit, so it extends to exactly one five-digit password.",
          "worked": "Deleting the last digit of a five-digit password gives a four-digit password. Conversely, each four-digit password extends uniquely by appending its one unused digit. This gives a one-to-one correspondence, so the counts are equal. Algebraically, ${}^{5}P_{4}={}^{5}P_{5}=5!=120$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
