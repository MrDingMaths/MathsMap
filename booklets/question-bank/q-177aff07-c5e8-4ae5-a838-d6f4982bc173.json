  "content": {
    "id": "p5-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A number is chosen at random from the first 25 positive whole numbers. What is the probability that it is not a prime number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{16}{25}$",
      "worked": "The primes from 1 to 25 are $2,3,5,7,11,13,17,19,23$, giving 9 prime outcomes. The number 1 is not prime.\n\nThere are $25-9=16$ non-prime outcomes.\n\n$$P(\\text{not prime})=\\frac{16}{25}.$$",
      "solutionDiagrams": []
    },
