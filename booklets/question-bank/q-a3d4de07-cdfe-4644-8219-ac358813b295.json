  "content": {
    "id": "p131-task29-32-root",
    "type": "question",
    "label": null,
    "prompt": "Show that the following functions are odd.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p131-task29-32-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=(-x)^5=-x^5=-f(x)$. Hence $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^5\\\\f(-x)&=-x^5\\\\f(-x)&=-f(x).\\end{align*}$$\nHence $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p131-task29-32-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^3-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x^3+x=-(x^3-x)=-f(x)$. Hence $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^3-(-x)\\\\f(-x)&=-x^3+x\\\\f(-x)&=-(x^3-x)\\\\f(-x)&=-f(x).\\end{align*}$$\nHence $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p131-task29-32-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3^x-3^{-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=3^{-x}-3^x=-(3^x-3^{-x})=-f(x)$. Hence $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=3^{-x}-3^{-(-x)}\\\\f(-x)&=3^{-x}-3^x\\\\f(-x)&=-(3^x-3^{-x})\\\\f(-x)&=-f(x).\\end{align*}$$\nHence $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p131-task29-32-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{x}{|x|}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $x\\ne0$, $f(-x)=\\dfrac{-x}{|-x|}=-\\dfrac{x}{|x|}=-f(x)$. Hence $f$ is odd.",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}f(-x)&=\\frac{-x}{|-x|}\\\\f(-x)&=-\\frac{x}{|x|}\\\\f(-x)&=-f(x).\\end{align*}$$\nHence $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
