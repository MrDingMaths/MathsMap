  "content": {
    "id": "v2-2cc74-p20-practice-slot-4-092959-root",
    "type": "question",
    "label": null,
    "prompt": "Find the values of $\\lambda_1$ and $\\lambda_2$ such that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-2cc74-p20-practice-slot-4-092959-slot-4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\binom{7}{7}=\\lambda_1\\binom{2}{-1}+\\lambda_2\\binom{1}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\lambda_1=2,\\ \\lambda_2=3$",
          "worked": "$$\\begin{aligned}\\binom{7}{7}&=\\binom{2\\lambda_1+\\lambda_2}{-\\lambda_1+3\\lambda_2}\\\\2\\lambda_1+\\lambda_2&=7\\qquad(1)\\\\-\\lambda_1+3\\lambda_2&=7\\qquad(2)\\end{aligned}$$\n(1) + 2×(2):\n$$\\begin{aligned}7\\lambda_2&=21\\\\\\lambda_2&=3\\end{aligned}$$\nSubstitute $\\lambda_2=3$ into (1):\n$$\\begin{aligned}2\\lambda_1+3&=7\\\\\\lambda_1&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-2cc74-p20-practice-slot-4-092959-slot-4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\binom{-11}{16}=\\lambda_1\\binom{3}{2}+\\lambda_2\\binom{-1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\lambda_1=-2,\\ \\lambda_2=5$",
          "worked": "$$\\begin{aligned}\\binom{-11}{16}&=\\binom{3\\lambda_1-\\lambda_2}{2\\lambda_1+4\\lambda_2}\\\\3\\lambda_1-\\lambda_2&=-11\\qquad(1)\\\\2\\lambda_1+4\\lambda_2&=16\\qquad(2)\\end{aligned}$$\n4×(1) + (2):\n$$\\begin{aligned}14\\lambda_1&=-28\\\\\\lambda_1&=-2\\end{aligned}$$\nSubstitute $\\lambda_1=-2$ into (1):\n$$\\begin{aligned}-6-\\lambda_2&=-11\\\\\\lambda_2&=5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
