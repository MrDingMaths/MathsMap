        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "By expanding $(A+B)(A+B)$, prove the special expansion $(A+B)^2=A^2+2AB+B^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(A+B)^2=A^2+AB+AB+B^2=A^2+2AB+B^2$.",
          "worked": "$$\\begin{align*}(A+B)^2&=A(A+B)+B(A+B)\\\\(A+B)^2&=A^2+AB+AB+B^2\\\\(A+B)^2&=A^2+2AB+B^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "Similarly, prove the special expansions:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p4-q5-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$(A-B)^2=A^2-2AB+B^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(A-B)^2=A^2-AB-AB+B^2=A^2-2AB+B^2$.",
              "worked": "$$\\begin{align*}(A-B)^2&=A(A-B)-B(A-B)\\\\(A-B)^2&=A^2-AB-AB+B^2\\\\(A-B)^2&=A^2-2AB+B^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p4-q5-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$(A-B)(A+B)=A^2-B^2$",
            "layout": "list",
