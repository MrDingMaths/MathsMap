            "children": [],
            "answer": {
              "short": "$(A-B)(A+B)=A^2+AB-AB-B^2=A^2-B^2$.",
              "worked": "$$\\begin{align*}(A-B)(A+B)&=A(A+B)-B(A+B)\\\\(A-B)(A+B)&=A^2+AB-AB-B^2\\\\(A-B)(A+B)&=A^2-B^2\\end{align*}$$",
