    "type": "question",
    "label": "7",
    "prompt": "A piece of string is to be divided in the ratio $5:3$. The shorter length is $222$ cm. What is the length of the other part?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$370$ cm.",
      "worked": "The shorter length represents $3$ parts; the other length represents $5$ parts.\n$$\\begin{align*}\\text{Length of one part}&=222\\div3\\text{ cm}\\\\\\text{Length of one part}&=74\\text{ cm}\\\\\\text{Other length}&=5\\times74\\text{ cm}\\\\\\text{Other length}&=370\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
