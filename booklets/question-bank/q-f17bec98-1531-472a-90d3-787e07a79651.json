  "content": {
    "id": "p18-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Suppose that $a>0$ and $c<0$. Explain why $ax^2+bx+c=0$ will always have two solutions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$ac<0$, so $\\Delta=b^2-4ac>0$. Hence there are two distinct real solutions.",
      "worked": "Since $a>0$ and $c<0$, we have $ac<0$ and therefore $-4ac>0$. Also $b^2\\ge0$, so\n$$\\Delta=b^2-4ac>0.$$\nThus the quadratic has two distinct real solutions.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
