          "inlines": [
            {
              "type": "math",
              "latex": "\\frac{2}{w}+\\frac{a}{w}=\\frac{9}{w}",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Work out the value of $a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "The denominators are the same, so add the numerators.\n$$\\begin{align*}2+a&=9\\\\a&=9-2\\\\a&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why the value of $w$ doesn’t matter.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All the denominators are the same, so we only add the numerators.",
          "worked": "The common denominator stays the same, so the numerators satisfy $2+a=9$ regardless of the nonzero value of $w$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$w$ is a positive integer. For what values of $w$ is $\\frac{9}{w}$ an improper fraction?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=1,2,3,4,5,6,7,8,9$",
          "worked": "An improper fraction has a numerator greater than or equal to its denominator. Therefore $w\\leq9$. Since $w$ is a positive integer,\n$$w=1,2,3,4,5,6,7,8,9.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
