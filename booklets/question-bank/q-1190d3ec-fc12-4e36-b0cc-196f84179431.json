    "answer": {
      "short": "$\\dfrac{3n-m}{2}$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p46-q13-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}&=\\left(\\frac{2m(m+2n)-3n(m+2n)+9n^2-2m^2}{m(m+2n)}\\right)\\div\\left(\\frac{1}{m}-\\frac{1}{\\frac{(m-2n)(m+n)-4n^2}{m+n}}\\right)\\\\&=\\left(\\frac{2m^2+4mn-3mn-6n^2+9n^2-2m^2}{m(m+2n)}\\right)\\div\\left(\\frac{1}{m}-\\frac{m+n}{m^2-mn-6n^2}\\right)\\\\&=\\frac{n(m+3n)}{m(m+2n)}\\div\\left(\\frac{1}{m}-\\frac{m+n}{(m-3n)(m+2n)}\\right)\\\\&=\\frac{n(m+3n)}{m(m+2n)}\\div\\left(\\frac{(m-3n)(m+2n)-m(m+n)}{m(m-3n)(m+2n)}\\right)\\\\&=\\frac{n(m+3n)}{m(m+2n)}\\div\\left(\\frac{m^2-mn-6n^2-m^2-mn}{m(m-3n)(m+2n)}\\right)\\\\&=\\frac{n(m+3n)}{m(m+2n)}\\div\\frac{-2n(m+3n)}{m(m-3n)(m+2n)}\\\\&=\\frac{n(m+3n)}{m(m+2n)}\\times\\frac{m(m-3n)(m+2n)}{-2n(m+3n)}\\\\&=\\frac{m-3n}{-2}\\\\&=\\frac{3n-m}{2}\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
