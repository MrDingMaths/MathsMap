  "content": {
    "id": "p44-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Show that $\\log_2 96,\\log_2 24,\\log_2 6,\\ldots$ is an AP, and show that $a_n=7-2n+\\log_2 3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$d=-2$, so the sequence is an AP; $a_n=7-2n+\\log_2 3$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p44-q18-differences",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}a_2-a_1&=\\log_2 24-\\log_2 96=\\log_2\\left(\\frac{24}{96}\\right)=\\log_2\\left(\\frac14\\right)=-2\\\\a_3-a_2&=\\log_2 6-\\log_2 24=\\log_2\\left(\\frac6{24}\\right)=\\log_2\\left(\\frac14\\right)=-2\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p44-q18-common-difference",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Common difference ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "d=-2",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ", so the sequence is an AP.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p44-q18-general-term",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}a_n&=a+(n-1)d\\\\a_n&=(5+\\log_2 3)+(n-1)(-2)\\\\a_n&=5+\\log_2 3-2n+2\\\\a_n&=7-2n+\\log_2 3\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
