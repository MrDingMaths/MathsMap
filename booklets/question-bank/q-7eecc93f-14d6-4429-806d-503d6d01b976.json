        "answer": {
          "short": "$2^{\\frac{2}{5}}$",
          "worked": "$$\\begin{align*}2^{\\frac{3}{5}}\\div2^{\\frac{1}{5}}&=2^{\\frac{3}{5}-\\frac{1}{5}}\\\\2^{\\frac{3}{5}}\\div2^{\\frac{1}{5}}&=2^{\\frac{2}{5}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$7^{\\frac{11}{3}}\\div7^{\\frac{8}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}7^{\\frac{11}{3}}\\div7^{\\frac{8}{3}}&=7^{\\frac{11}{3}-\\frac{8}{3}}\\\\7^{\\frac{11}{3}}\\div7^{\\frac{8}{3}}&=7^1=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$8^{\\frac{1}{4}}\\div8^{\\frac{1}{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{\\frac{9}{28}}$",
          "worked": "$$\\begin{align*}8^{\\frac{1}{4}}\\div8^{\\frac{1}{7}}&=8^{\\frac{1}{4}-\\frac{1}{7}}\\\\8^{\\frac{1}{4}}\\div8^{\\frac{1}{7}}&=8^{\\frac{3}{28}}\\\\8^{\\frac{1}{4}}\\div8^{\\frac{1}{7}}&=(2^3)^{\\frac{3}{28}}\\\\8^{\\frac{1}{4}}\\div8^{\\frac{1}{7}}&=2^{\\frac{9}{28}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$7^{\\frac{2}{3}}\\div7^{\\frac{1}{2}}$",
