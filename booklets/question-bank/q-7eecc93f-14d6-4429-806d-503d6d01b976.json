        "answer": {
          "short": "$7^{\\frac{1}{6}}$",
          "worked": "$$\\begin{align*}7^{\\frac{2}{3}}\\div7^{\\frac{1}{2}}&=7^{\\frac{2}{3}-\\frac{1}{2}}\\\\7^{\\frac{2}{3}}\\div7^{\\frac{1}{2}}&=7^{\\frac{4}{6}-\\frac{3}{6}}\\\\7^{\\frac{2}{3}}\\div7^{\\frac{1}{2}}&=7^{\\frac{1}{6}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
