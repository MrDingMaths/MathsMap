                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "f(x)=1.5x",
                    "display": false
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}f(x)&=x+\\frac{50}{100}x\\\\f(x)&=1.5x\\end{align*}$$",
