        "type": "part",
        "label": "a",
        "prompt": "Let $f(x)$ be the function “increase $x$ by 50%”. Write the equation for $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p23-q21-a-answer",
                "type": "paragraph",
                "fontSize": null,
