  "content": {
    "id": "p16-q15-response",
    "type": "question",
    "label": "15",
    "prompt": "A rectangular painting is to have a total area (including the frame) of 1200 cm².\nIf the painting has length 30 cm and breadth 20 cm, find the uniform width of the frame.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5\\text{ cm}$. Solve $(30+2x)(20+2x)=1200$, taking the positive root.",
      "worked": "Let $x$ centimetres be the uniform width of the frame. The outer dimensions are $(30+2x)$ cm and $(20+2x)$ cm.\n$$\\begin{align*}(2x+30)(2x+20)&=1200\\\\4x^2+100x+600&=1200\\\\4x^2+100x-600&=0\\\\x^2+25x-150&=0\\\\(x+30)(x-5)&=0\\\\x&=-30\\text{ or }5\\end{align*}$$\nSince $x>0$, the frame is $5\\text{ cm}$ wide.\nCheck: $(30+10)(20+10)=40\\times30=1200\\text{ cm}^2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
