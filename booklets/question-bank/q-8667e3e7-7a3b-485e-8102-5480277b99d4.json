  "content": {
    "id": "p25-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "All students at a school were asked what their method of transport to school was. The results were: 40% walk to school, 20% come by car, 12% use public transport and the rest ride a bicycle.\n\nA student is chosen at random. Find the probability that this student:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "walks to school",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "$$P(\\text{walks})=\\frac{40}{100}=\\frac{2}{5}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p25-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "rides a bicycle to school",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{25}$",
          "worked": "$$\\begin{align*}P(\\text{bicycle})&=1-\\frac{40+20+12}{100}\\\\P(\\text{bicycle})&=\\frac{28}{100}\\\\P(\\text{bicycle})&=\\frac{7}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p25-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "does not use public transport",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{22}{25}$",
          "worked": "$$\\begin{align*}P(\\text{not public transport})&=1-\\frac{12}{100}\\\\P(\\text{not public transport})&=\\frac{88}{100}\\\\P(\\text{not public transport})&=\\frac{22}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
