  "content": {
    "id": "v2-f9808-p34-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "A netball player scores from a free shot with probability $0.8$. She takes 8 free shots. Find, correct to four decimal places, the probability that she misses more than one of them.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.4967$",
      "worked": "Let $Y$ be the number of misses. Then $Y\\sim\\operatorname{Bin}(8,0.2)$. Missing more than one shot means $Y\\ge2$.\n$$\\begin{align*}P(Y\\ge2)&=1-P(Y=0)-P(Y=1)\\\\&=1-(0.8)^8-\\binom81(0.2)(0.8)^7\\\\&=1-0.16777216-0.33554432\\\\&=0.49668352\\\\&\\approx0.4967.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
