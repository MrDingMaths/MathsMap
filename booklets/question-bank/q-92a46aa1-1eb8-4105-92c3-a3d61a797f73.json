          "worked": "$$\\begin{aligned}\\overrightarrow{DB}-\\overrightarrow{DA}&=\\overrightarrow{AD}+\\overrightarrow{DB}\\\\\\overrightarrow{DB}-\\overrightarrow{DA}&=\\overrightarrow{AB}\\end{aligned}$$",
          "solutionDiagrams": []
