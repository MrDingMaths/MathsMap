  "content": {
    "id": "p11-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "When each side of a square with side length $10\\text{ cm}$ is increased by the same amount, the area increases by $44\\%$. Find the amount by which each side is increased.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\text{ cm}$.\n\nMultiply the original area by $1.44$, then find the new side length.",
      "worked": "$$\\begin{align*}\\text{Original area} &= 10^2 = 100\\text{ cm}^2\\\\\\text{New area} &= 1.44\\times100 = 144\\text{ cm}^2\\\\\\text{New side length} &= \\sqrt{144} = 12\\text{ cm}\\\\\\text{Increase in each side} &= 12-10 = 2\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
