  "content": {
    "id": "p37-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Determine the stationary point on $y=x-x^2$ and show that it is a maximum point.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\left(\\frac12,\\frac14\\right)$, maximum.",
      "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=1-2x\\\\1-2x&=0\\\\x&=\\frac12\\\\y&=\\frac12-\\left(\\frac12\\right)^2\\\\y&=\\frac14\\\\\\frac{d^2y}{dx^2}&=-2<0\\end{aligned}$$\nTherefore the stationary point is $\\left(\\frac12,\\frac14\\right)$, a maximum.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
