  "content": {
    "id": "p31-q9",
    "type": "question",
    "label": "9",
    "prompt": "$PT$ and $PQ$ are the tangents from $P$ to a circle with centre $O$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove $\\triangle PTO\\equiv\\triangle PQO$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p31-q9-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 31 p31-q9-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\\coordinate (P) at (4,0);\\coordinate (T) at (0.5625,1.39054);\\coordinate (Q) at (0.5625,-1.39054);\n\\draw (O) circle (1.5);\n\\draw ($(T)!-0.18!(P)$)--(P)--($(Q)!-0.18!(P)$);\n\\draw (T)--(O)--(Q);\\draw (O)--(P);\n\\fill (O) circle (1.4pt);\n\\node[left] at (O) {$O$};\\node[right] at (P) {$P$};\\node[above] at (T) {$T$};\\node[below] at (Q) {$Q$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 70,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 31,
              "sourceRegion": "Question 9a",
              "description": "Circle and paired right triangles sharing OP. Tangency points are derived from a radius of 1.5 and an external point at distance 4; these drawing coordinates are not numerical givens.",
              "mathematics": "OT = OQ; OT is perpendicular to PT and OQ is perpendicular to PQ. OP is common.",
              "answerVisibility": "Construction and point labels remain visible; no proof answers are drawn."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$\\triangle PTO\\equiv\\triangle PQO$ by RHS.",
          "worked": "$\\angle OTP=\\angle OQP=90^\\circ$ because tangents meet radii at right angles.\n\n$OT=OQ$ because they are radii of the same circle.\n\n$OP$ is common.\n\nTherefore $\\triangle PTO\\equiv\\triangle PQO$ by RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p31-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence prove $PT=PQ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$PT=PQ$ (corresponding sides of congruent triangles).",
          "worked": "$PT=PQ$ because corresponding sides of the congruent triangles $PTO$ and $PQO$ are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
