      {
        "id": "p13-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "A company made a profit of $\\$18\\,000$, which was a $2.4\\%$ profit on its costs. Find the costs and the total sales.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Costs: $\\$750\\,000$; total sales: $\\$768\\,000$.",
          "worked": "$$\\begin{align*}\\text{Profit}&=\\text{costs}\\times2.4\\%\\\\\\text{Costs}&=\\text{profit}\\div2.4\\%\\\\\\text{Costs}&=18\\,000\\div0.024\\\\\\text{Costs}&=\\$750\\,000\\\\\\text{Total sales}&=\\text{costs}+\\text{profit}\\\\\\text{Total sales}&=750\\,000+18\\,000\\\\\\text{Total sales}&=\\$768\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "A company made a loss of $\\$657\\,000$, which was a $4.5\\%$ loss on its costs. Find the costs and the total sales.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Costs: $\\$14\\,600\\,000$; total sales: $\\$13\\,943\\,000$.",
          "worked": "$$\\begin{align*}\\text{Loss}&=\\text{costs}\\times4.5\\%\\\\\\text{Costs}&=\\text{loss}\\div4.5\\%\\\\\\text{Costs}&=657\\,000\\div0.045\\\\\\text{Costs}&=\\$14\\,600\\,000\\\\\\text{Total sales}&=\\text{costs}-\\text{loss}\\\\\\text{Total sales}&=14\\,600\\,000-657\\,000\\\\\\text{Total sales}&=\\$13\\,943\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "A company made a loss of $\\$250\\,800$, which was a $3.8\\%$ loss on its costs. Find the costs and the total sales.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Costs: $\\$6\\,600\\,000$; total sales: $\\$6\\,349\\,200$.",
          "worked": "$$\\begin{align*}\\text{Loss}&=\\text{costs}\\times3.8\\%\\\\\\text{Costs}&=\\text{loss}\\div3.8\\%\\\\\\text{Costs}&=250\\,800\\div0.038\\\\\\text{Costs}&=\\$6\\,600\\,000\\\\\\text{Total sales}&=\\text{costs}-\\text{loss}\\\\\\text{Total sales}&=6\\,600\\,000-250\\,800\\\\\\text{Total sales}&=\\$6\\,349\\,200\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
