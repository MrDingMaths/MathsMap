  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A man walks 200 m in 2 minutes. How far will he walk in an hour?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6000\\text{ m}$",
      "worked": "One hour is $60$ minutes.\n$$\\begin{align*}\\text{Distance in 1 minute}&=200\\div2\\text{ m}\\\\\\text{Distance in 1 minute}&=100\\text{ m}\\\\\\text{Distance in 60 minutes}&=100\\times60\\text{ m}\\\\\\text{Distance in 60 minutes}&=6000\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
