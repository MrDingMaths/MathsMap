  "content": {
    "id": "p45-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Give probabilities to 3 decimal places and standard deviations to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "If a player throws 6 dice, what is the probability of getting at least two sixes? Let the random variable $X$ record the number of sixes. What is the expected value and standard deviation for $X$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(X\\ge2)\\approx0.263$, $E(X)=1$, $\\sigma=\\sqrt{\\frac56}\\approx0.91$.",
          "worked": "Let $X\\sim B\\left(6,\\frac16\\right)$.\n$$\\begin{align*}P(X\\ge2)&=1-P(X=0)-P(X=1)\\\\P(X\\ge2)&=1-\\left(\\frac56\\right)^6-6\\left(\\frac16\\right)\\left(\\frac56\\right)^5\\\\P(X\\ge2)&\\approx0.263\\\\E(X)&=np=6\\left(\\frac16\\right)=1\\\\\\sigma&=\\sqrt{np(1-p)}\\\\\\sigma&=\\sqrt{\\frac56}\\approx0.91\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p45-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Repeat the question for 24 dice.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(X\\ge2)\\approx0.927$, $E(X)=4$, $\\sigma=\\sqrt{\\frac{10}{3}}\\approx1.83$.",
          "worked": "For 24 dice, $X\\sim B\\left(24,\\frac16\\right)$.\n$$\\begin{align*}P(X\\ge2)&=1-P(X=0)-P(X=1)\\\\P(X\\ge2)&=1-\\left(\\frac56\\right)^{24}-24\\left(\\frac16\\right)\\left(\\frac56\\right)^{23}\\\\P(X\\ge2)&\\approx0.927\\\\E(X)&=np=24\\left(\\frac16\\right)=4\\\\\\sigma&=\\sqrt{24\\left(\\frac16\\right)\\left(\\frac56\\right)}\\\\\\sigma&=\\sqrt{\\frac{10}{3}}\\approx1.83\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
