  "content": {
    "id": "p17-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A line has equation $ax-3y+15=0$ and gradient $4$. Find the value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=12$.",
      "worked": "$$\\begin{aligned}3y&=ax+15\\\\y&=\\frac{a}{3}x+5\\end{aligned}$$\nThe gradient is $\\frac{a}{3}$, so\n$$\\begin{aligned}\\frac{a}{3}&=4\\\\a&=12\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
