  "content": {
    "id": "p105-q27-content",
    "type": "question",
    "label": "27",
    "prompt": "In the elections for year 7 representatives, two-fifths of the votes went to Julian, one-quarter to Georgina, one-sixth to Ruffy and the remaining 11 votes were cast for Deborah.\nHow many students are there in year 7?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "60 students",
      "worked": "Let $x$ be the number of students in year 7.\n$$\\begin{align*}\\frac{2}{5}x+\\frac{1}{4}x+\\frac{1}{6}x+11&=x\\\\49x+660&=60x\\\\11x&=660\\\\x&=60\\end{align*}$$\nThere are 60 students in year 7.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
