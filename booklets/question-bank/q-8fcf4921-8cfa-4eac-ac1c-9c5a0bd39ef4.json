    "label": "9",
    "prompt": "How many litres does a cylinder of radius 20 cm and height 1 m hold?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$40\\pi\\text{ L}$",
      "worked": "Convert the height to $100\\text{ cm}$.\n\n$$\\begin{aligned}V&=\\pi r^2h=\\pi\\times20^2\\times100\\\\&=40\\,000\\pi\\text{ cm}^3\\\\\\text{Capacity}&=40\\,000\\pi\\div1000=40\\pi\\text{ L}\\end{aligned}$$",
      "solutionDiagrams": []
    },
