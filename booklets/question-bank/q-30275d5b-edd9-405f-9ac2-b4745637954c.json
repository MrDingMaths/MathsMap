  "content": {
    "id": "p40-q37-root",
    "type": "question",
    "label": "37",
    "prompt": "Find the constant $k$ such that $\\binom{2n}{n}=k\\binom{2n-1}{n-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=2$.",
      "worked": "$$\\begin{align*}k&=\\frac{\\binom{2n}{n}}{\\binom{2n-1}{n-1}}\\\\k&=\\frac{(2n)!}{n!n!}\\times\\frac{(n-1)!n!}{(2n-1)!}\\\\k&=\\frac{2n}{n}\\\\k&=2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
