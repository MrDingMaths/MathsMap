    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "The turning point of a parabola is $(2,3)$. From this information alone, is it possible to determine the equation of the parabola?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. There are infinitely many possibilities: $y=c(x-2)^2+3$, where $c\\ne0$.",
          "worked": "The turning point gives $y=c(x-2)^2+3$, where $c\\ne0$. The value of $c$ is unknown, so infinitely many parabolas have this turning point. The equation cannot be determined from this information alone.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "The turning point of a parabola is $(2,3)$. The parabola also passes through the point $(3,5)$. Find the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2(x-2)^2+3$",
          "worked": "The turning point gives $y=c(x-2)^2+3$. Substitute $(3,5)$:\n$$\\begin{align*}5&=c(3-2)^2+3\\\\5&=c+3\\\\c&=2\\end{align*}$$\nTherefore, $y=2(x-2)^2+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "The turning point of a parabola is $(-3,2)$. The parabola also passes through the point $(0,0)$. Find the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{2}{9}(x+3)^2+2$",
          "worked": "The turning point gives $y=c(x+3)^2+2$. Substitute $(0,0)$:\n$$\\begin{align*}0&=c(0+3)^2+2\\\\0&=9c+2\\\\9c&=-2\\\\c&=-\\frac{2}{9}\\end{align*}$$\nTherefore, $y=-\\dfrac{2}{9}(x+3)^2+2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
