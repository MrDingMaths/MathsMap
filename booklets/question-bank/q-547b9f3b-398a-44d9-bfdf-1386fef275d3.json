  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A bag contains eight red balls, seven yellow balls and three green balls. A ball is selected at random. Find the probability that it is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "red",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{9}$",
          "worked": "There are $8+7+3=18$ balls.\n\n$$\\begin{align*}P(\\text{red})&=\\frac{8}{18}\\\\P(\\text{red})&=\\frac{4}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "yellow or green",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{9}$",
          "worked": "There are $18$ balls, of which $7+3$ are yellow or green.\n\n$$\\begin{align*}P(\\text{yellow or green})&=\\frac{7+3}{18}\\\\P(\\text{yellow or green})&=\\frac{10}{18}\\\\P(\\text{yellow or green})&=\\frac{5}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "not yellow",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{18}$",
          "worked": "Not yellow means red or green. There are $18$ balls in total.\n\n$$\\begin{align*}P(\\text{not yellow})&=\\frac{8+3}{18}\\\\P(\\text{not yellow})&=\\frac{11}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
