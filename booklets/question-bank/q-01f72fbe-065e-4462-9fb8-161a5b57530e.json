        "children": [
          {
            "id": "p38-q8-a",
            "type": "part",
            "label": "a",
            "prompt": "$2x+6=12$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=3$",
              "worked": "Dividing first:\n$$\\begin{align*}\\frac{2x}{2}+\\frac{6}{2}&=\\frac{12}{2}\\\\x+3&=6\\\\x&=3\\end{align*}$$\nSubtracting first:\n$$\\begin{align*}2x&=12-6\\\\2x&=6\\\\x&=3\\end{align*}$$\nBoth methods give $x=3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
          {
            "id": "p38-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "$4x+12=16$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=1$",
              "worked": "Dividing first:\n$$\\begin{align*}\\frac{4x}{4}+\\frac{12}{4}&=\\frac{16}{4}\\\\x+3&=4\\\\x&=1\\end{align*}$$\nSubtracting first:\n$$\\begin{align*}4x&=16-12\\\\4x&=4\\\\x&=1\\end{align*}$$\nBoth methods give $x=1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
          {
            "id": "p38-q8-c",
            "type": "part",
            "label": "c",
            "prompt": "$10x+30=50$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=2$",
              "worked": "Dividing first:\n$$\\begin{align*}\\frac{10x}{10}+\\frac{30}{10}&=\\frac{50}{10}\\\\x+3&=5\\\\x&=2\\end{align*}$$\nSubtracting first:\n$$\\begin{align*}10x&=50-30\\\\10x&=20\\\\x&=2\\end{align*}$$\nBoth methods give $x=2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
          {
            "id": "p38-q8-d",
            "type": "part",
            "label": "d",
            "prompt": "$2x+5=13$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=4$",
              "worked": "Dividing first:\n$$\\begin{align*}\\frac{2x}{2}+\\frac{5}{2}&=\\frac{13}{2}\\\\x+\\frac{5}{2}&=\\frac{13}{2}\\\\x&=\\frac{13}{2}-\\frac{5}{2}\\\\x&=4\\end{align*}$$\nSubtracting first:\n$$\\begin{align*}2x&=13-5\\\\2x&=8\\\\x&=4\\end{align*}$$\nBoth methods give $x=4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          },
          {
            "id": "p38-q8-e",
            "type": "part",
            "label": "e",
            "prompt": "$5x+4=19$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=3$",
              "worked": "Dividing first:\n$$\\begin{align*}\\frac{5x}{5}+\\frac{4}{5}&=\\frac{19}{5}\\\\x+\\frac{4}{5}&=\\frac{19}{5}\\\\x&=\\frac{19}{5}-\\frac{4}{5}\\\\x&=3\\end{align*}$$\nSubtracting first:\n$$\\begin{align*}5x&=19-4\\\\5x&=15\\\\x&=3\\end{align*}$$\nBoth methods give $x=3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          },
          {
            "id": "p38-q8-f",
            "type": "part",
            "label": "f",
            "prompt": "$3+2x=5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=1$",
              "worked": "Dividing first:\n$$\\begin{align*}\\frac{3}{2}+\\frac{2x}{2}&=\\frac{5}{2}\\\\\\frac{3}{2}+x&=\\frac{5}{2}\\\\x&=\\frac{5}{2}-\\frac{3}{2}\\\\x&=1\\end{align*}$$\nSubtracting first:\n$$\\begin{align*}2x&=5-3\\\\2x&=2\\\\x&=1\\end{align*}$$\nBoth methods give $x=1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          },
          {
            "id": "p38-q8-g",
            "type": "part",
            "label": "g",
            "prompt": "$8=2x+4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=2$",
              "worked": "Dividing first:\n$$\\begin{align*}\\frac{8}{2}&=\\frac{2x}{2}+\\frac{4}{2}\\\\4&=x+2\\\\2&=x\\\\x&=2\\end{align*}$$\nSubtracting first:\n$$\\begin{align*}8-4&=2x\\\\4&=2x\\\\x&=2\\end{align*}$$\nBoth methods give $x=2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
          {
            "id": "p38-q8-h",
            "type": "part",
            "label": "h",
            "prompt": "$10=4x+10$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=0$",
              "worked": "Dividing first:\n$$\\begin{align*}\\frac{10}{4}&=\\frac{4x}{4}+\\frac{10}{4}\\\\\\frac{5}{2}&=x+\\frac{5}{2}\\\\0&=x\\\\x&=0\\end{align*}$$\nSubtracting first:\n$$\\begin{align*}10-10&=4x\\\\0&=4x\\\\x&=0\\end{align*}$$\nBoth methods give $x=0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          }
