    "type": "question",
    "label": "10",
    "prompt": "A car travels 200 metres in 10 seconds. How far will it go in:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "a minute?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1200\\text{ m}$",
          "worked": "There are $60$ seconds in a minute.\n$$\\begin{align*}\\text{Distance in 1 second}&=200\\div10\\text{ m}\\\\\\text{Distance in 1 second}&=20\\text{ m}\\\\\\text{Distance in 1 minute}&=20\\times60\\text{ m}\\\\\\text{Distance in 1 minute}&=1200\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "an hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$72\\text{ km}$",
          "worked": "There are $60\\times60=3600$ seconds in an hour.\n$$\\begin{align*}\\text{Distance in 1 second}&=200\\div10\\text{ m}\\\\\\text{Distance in 1 second}&=20\\text{ m}\\\\\\text{Distance in 1 hour}&=20\\times3600\\text{ m}\\\\\\text{Distance in 1 hour}&=72000\\text{ m}\\\\\\text{Distance in 1 hour}&=72000\\div1000\\text{ km}\\\\\\text{Distance in 1 hour}&=72\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
