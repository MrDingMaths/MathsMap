  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Factorise each of the following expressions by first taking out a common factor:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$2a^2-12a+18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(a-3)^2$",
          "worked": "$$\\begin{align*}2a^2-12a+18&=2(a^2-6a+9)\\\\2a^2-12a+18&=2[a^2-2(a)(3)+3^2]\\\\2a^2-12a+18&=2(a-3)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$3x^2+30x+75$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x+5)^2$",
          "worked": "$$\\begin{align*}3x^2+30x+75&=3(x^2+10x+25)\\\\3x^2+30x+75&=3[x^2+2(x)(5)+5^2]\\\\3x^2+30x+75&=3(x+5)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$2m^2-16m+32$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(m-4)^2$",
          "worked": "$$\\begin{align*}2m^2-16m+32&=2(m^2-8m+16)\\\\2m^2-16m+32&=2[m^2-2(m)(4)+4^2]\\\\2m^2-16m+32&=2(m-4)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x^2+24x+72$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x+6)^2$",
          "worked": "$$\\begin{align*}2x^2+24x+72&=2(x^2+12x+36)\\\\2x^2+24x+72&=2[x^2+2(x)(6)+6^2]\\\\2x^2+24x+72&=2(x+6)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$18a^2-12a+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(3a-1)^2$",
          "worked": "$$\\begin{align*}18a^2-12a+2&=2(9a^2-6a+1)\\\\18a^2-12a+2&=2[(3a)^2-2(3a)(1)+1^2]\\\\18a^2-12a+2&=2(3a-1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$48x^2+24x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(4x+1)^2$",
          "worked": "$$\\begin{align*}48x^2+24x+3&=3(16x^2+8x+1)\\\\48x^2+24x+3&=3[(4x)^2+2(4x)(1)+1^2]\\\\48x^2+24x+3&=3(4x+1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
