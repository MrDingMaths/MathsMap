    "children": [
      {
        "id": "p23-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "the HCF of 36 and 45",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}36&=2^2\\times3^2\\\\45&=3^2\\times5\\end{align*}$$\n\nTake the smallest power of each common prime factor.\n\n$$\\operatorname{HCF}(36,45)=3^2=9.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "the LCM of 36 and 45",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180$",
          "worked": "$$\\begin{align*}36&=2^2\\times3^2\\\\45&=3^2\\times5\\end{align*}$$\n\nTake the greatest power of each prime factor.\n\n$$\\operatorname{LCM}(36,45)=2^2\\times3^2\\times5=180.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "the HCF of 112 and 21",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}112&=2^4\\times7\\\\21&=3\\times7\\end{align*}$$\n\nThe only common prime factor is $7$.\n\n$$\\operatorname{HCF}(112,21)=7.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "the LCM of 112 and 21",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$336$",
          "worked": "$$\\begin{align*}112&=2^4\\times7\\\\21&=3\\times7\\end{align*}$$\n\nTake the greatest power of each prime factor.\n\n$$\\operatorname{LCM}(112,21)=2^4\\times3\\times7=336.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "the LCM of 12, 15 and 40",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "$$\\begin{align*}12&=2^2\\times3\\\\15&=3\\times5\\\\40&=2^3\\times5\\end{align*}$$\n\nTake the greatest power of each prime factor.\n\n$$\\operatorname{LCM}(12,15,40)=2^3\\times3\\times5=120.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "the LCM of 24, 72 and 108",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$216$",
          "worked": "$$\\begin{align*}24&=2^3\\times3\\\\72&=2^3\\times3^2\\\\108&=2^2\\times3^3\\end{align*}$$\n\nTake the greatest power of each prime factor.\n\n$$\\operatorname{LCM}(24,72,108)=2^3\\times3^3=216.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "the HCF of 72 and 126",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}72&=2^3\\times3^2\\\\126&=2\\times3^2\\times7\\end{align*}$$\n\nTake the smallest power of each common prime factor.\n\n$$\\operatorname{HCF}(72,126)=2\\times3^2=18.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "the HCF of 24, 60 and 112",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}24&=2^3\\times3\\\\60&=2^2\\times3\\times5\\\\112&=2^4\\times7\\end{align*}$$\n\nOnly $2$ is common to all three prime factorisations; its smallest power is $2^2$.\n\n$$\\operatorname{HCF}(24,60,112)=2^2=4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "the HCF of 70, 105 and 280",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$",
          "worked": "$$\\begin{align*}70&=2\\times5\\times7\\\\105&=3\\times5\\times7\\\\280&=2^3\\times5\\times7\\end{align*}$$\n\nTake the smallest power of each prime factor common to all three numbers.\n\n$$\\operatorname{HCF}(70,105,280)=5\\times7=35.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
