  "content": {
    "id": "p23-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Dimitri earns \\$7.20 for each box of fruit picked.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "How many boxes must he pick to earn at least \\$200?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "28 boxes; round up to reach at least \\$200.",
          "worked": "$$\\begin{align*}\\text{Number of boxes} &= \\frac{200}{7.20}\\\\\\text{Number of boxes} &= \\frac{250}{9}\\\\\\text{Number of boxes} &= 27\\frac79\\end{align*}$$\nHe must pick **28 boxes**, rounding up because 27 boxes earn only \\$194.40.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p23-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "If he takes 4 hours to pick 12 boxes, what is his hourly rate of pay?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$21.60/h",
          "worked": "$$\\begin{align*}\\text{Pay for 12 boxes} &= \\$7.20\\times12\\\\\\text{Pay for 12 boxes} &= \\$86.40\\\\\\text{Hourly rate} &= \\frac{\\$86.40}{4}\\\\\\text{Hourly rate} &= \\$21.60\\text{/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
