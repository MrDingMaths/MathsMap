        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\underset{\\sim}{a}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{LM}&=-\\overrightarrow{ML}\\\\\\overrightarrow{LM}&=-3\\underset{\\sim}{a}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p60-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{NM}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\underset{\\sim}{a}+\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{NM}&=\\overrightarrow{NL}+\\overrightarrow{LM}\\\\\\overrightarrow{NM}&=(\\underset{\\sim}{a}+\\underset{\\sim}{b})-3\\underset{\\sim}{a}\\\\\\overrightarrow{NM}&=-2\\underset{\\sim}{a}+\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
