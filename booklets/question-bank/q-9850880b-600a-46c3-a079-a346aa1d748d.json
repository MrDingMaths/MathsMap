  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Let $\\theta$ be the angle at the centre of a circle with radius $10$ cm that subtends an arc of length $8$ cm. Find the value of $\\theta$ in",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "radians.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}\\text{ rad}$",
          "worked": "$$\\begin{align*}l&=r\\theta\\\\8&=10\\theta\\\\\\theta&=\\frac{8}{10}\\\\\\theta&=\\frac{4}{5}\\text{ rad}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "degrees, to the nearest minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45^\\circ50'$",
          "worked": "$$\\begin{align*}\\theta&=\\frac{4}{5}\\times\\frac{180}{\\pi}\\text{ degrees}\\\\\\theta&=\\frac{144}{\\pi}\\text{ degrees}\\\\\\theta&\\approx45.836624^\\circ\\end{align*}$$\nThe fractional degree gives $0.836624\\times60\\approx50.1974$ minutes, so $\\theta\\approx45^\\circ50'$ to the nearest minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
