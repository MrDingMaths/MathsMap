    "children": [
      {
        "id": "p8-q3a",
        "type": "part",
        "label": "a",
        "prompt": "If 20% of a farmer’s crop is 620 tonnes, what is the total crop?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3100\\text{ tonnes}$",
          "worked": "$$\\begin{align*}\\text{Crop for }1\\%&=620\\div20=31\\text{ tonnes}\\\\\\text{Crop for }100\\%&=31\\times100=3100\\text{ tonnes}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q3b",
        "type": "part",
        "label": "b",
        "prompt": "Nina is in hospital and has drunk 840 mL of water, which is 70% of her daily allowance. What is her daily allowance?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1200\\text{ mL}$",
          "worked": "$$\\begin{align*}\\text{Water for }1\\%&=840\\div70=12\\text{ mL}\\\\\\text{Water for }100\\%&=12\\times100=1200\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q3c",
        "type": "part",
        "label": "c",
        "prompt": "If 120% of an amount is $\\$156$, what was the original amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$130$",
          "worked": "$$\\begin{align*}\\text{Amount for }1\\%&=\\$156\\div120=\\$1.30\\\\\\text{Amount for }100\\%&=\\$1.30\\times100=\\$130\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q3d",
        "type": "part",
        "label": "d",
        "prompt": "Hail destroyed 58% of a crop of plums, and only 10 500 kg was sent to market. How much would have been sent to market if there had been no hailstorm?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\,000\\text{ kg}$",
          "worked": "$$\\begin{align*}\\text{Percentage remaining}&=100\\%-58\\%=42\\%\\\\\\text{Mass for }1\\%&=10\\,500\\div42=250\\text{ kg}\\\\\\text{Mass for }100\\%&=250\\times100=25\\,000\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q3e",
        "type": "part",
        "label": "e",
        "prompt": "A farmer has used 6000 L of petrol harvesting his crop, and has so far harvested 35%. How much more petrol, correct to the nearest 100 L, will he need to harvest the whole crop?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11\\,100\\text{ L}$ more.\n\nThe remaining 65% requires $\\frac{65}{35}$ times the petrol already used.",
          "worked": "$$\\begin{align*}\\text{Percentage remaining}&=100\\%-35\\%=65\\%\\\\\\text{Petrol for }1\\%&=6000\\div35=\\frac{1200}{7}\\text{ L}\\\\\\text{Petrol for }65\\%&=\\frac{1200}{7}\\times65\\\\\\text{Petrol for }65\\%&=\\frac{78\\,000}{7}\\text{ L}\\\\\\text{Petrol for }65\\%&\\approx11\\,100\\text{ L}\\end{align*}$$\nThe farmer needs 11 100 L more petrol, correct to the nearest 100 L.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
