  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Consider points $A(1,1)$ and $B(4,7)$. Find the point $N$ that divides the line segment $AB$ in the ratio $1:2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$N(2,3)$.",
      "worked": "$N$ is $\\frac13$ of the way from $A$ to $B$.\n$$\\begin{align*}x_N&=1+\\frac13(4-1)\\\\x_N&=2\\\\y_N&=1+\\frac13(7-1)\\\\y_N&=3.\\end{align*}$$\nTherefore, $N(2,3)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
