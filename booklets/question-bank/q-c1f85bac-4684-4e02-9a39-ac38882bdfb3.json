    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "1330 people",
      "worked": "$$\\begin{aligned}1534-204&=1534-200-4\\\\1534-204&=1334-4\\\\1534-204&=1330\\end{aligned}$$\nMelissa expected 1330 people to attend.",
