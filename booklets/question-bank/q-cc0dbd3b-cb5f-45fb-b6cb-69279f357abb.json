      {
        "id": "p51-q2-identity",
        "type": "part",
        "label": "a",
        "prompt": "Express $\\cos^2\\theta$ in terms of $\\cos 2\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^2\\theta=\\frac12+\\frac12\\cos 2\\theta$",
          "worked": "$$\\begin{aligned}\\cos 2\\theta&=2\\cos^2\\theta-1\\\\2\\cos^2\\theta&=1+\\cos 2\\theta\\\\\\cos^2\\theta&=\\frac12+\\frac12\\cos 2\\theta\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p51-q2-integrals",
        "type": "group",
        "label": "",
        "prompt": "Hence find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p51-q2-a",
            "type": "part",
            "label": "b",
            "prompt": "$\\displaystyle\\int\\cos^2x\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{x}{2}+\\frac14\\sin 2x+C$",
              "worked": "$$\\begin{aligned}\\int\\cos^2x\\,dx&=\\frac12\\int(1+\\cos 2x)\\,dx\\\\&=\\frac12\\left(x+\\frac12\\sin 2x\\right)+C\\\\&=\\frac{x}{2}+\\frac14\\sin 2x+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p51-q2-b",
            "type": "part",
            "label": "c",
            "prompt": "$\\displaystyle\\int\\cos^2 6x\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{x}{2}+\\frac1{24}\\sin 12x+C$",
              "worked": "$$\\begin{aligned}\\int\\cos^2 6x\\,dx&=\\frac12\\int(1+\\cos 12x)\\,dx\\\\&=\\frac12\\left(x+\\frac1{12}\\sin 12x\\right)+C\\\\&=\\frac{x}{2}+\\frac1{24}\\sin 12x+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p51-q2-c",
            "type": "part",
            "label": "d",
            "prompt": "$\\displaystyle\\int\\cos^2\\!\\left(\\frac12x\\right)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{x}{2}+\\frac12\\sin x+C$",
              "worked": "$$\\begin{aligned}\\int\\cos^2\\!\\left(\\frac{x}{2}\\right)\\,dx&=\\frac12\\int(1+\\cos x)\\,dx\\\\&=\\frac12(x+\\sin x)+C\\\\&=\\frac{x}{2}+\\frac12\\sin x+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p51-q2-d",
            "type": "part",
            "label": "e",
            "prompt": "$\\displaystyle\\int\\cos^2 10x\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{x}{2}+\\frac1{40}\\sin 20x+C$",
              "worked": "$$\\begin{aligned}\\int\\cos^2 10x\\,dx&=\\frac12\\int(1+\\cos 20x)\\,dx\\\\&=\\frac12\\left(x+\\frac1{20}\\sin 20x\\right)+C\\\\&=\\frac{x}{2}+\\frac1{40}\\sin 20x+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
