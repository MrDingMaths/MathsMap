      {
        "id": "p10-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can three boys and four girls be arranged in a line so that the boys and girls alternate?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$144$",
          "worked": "The only possible pattern is girl, boy, girl, boy, girl, boy, girl. Arrange the four girls in their four positions and the three boys in their three positions.\n\n$$\\begin{align*}N&=4!\\times3!\\\\N&=144.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How many ways can three boys and three girls be arranged in a line so that the boys and girls alternate?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$72$",
          "worked": "There are two alternating patterns: boy, girl, boy, girl, boy, girl, or girl, boy, girl, boy, girl, boy. For each pattern, arrange the boys in $3!$ ways and the girls in $3!$ ways.\n\n$$\\begin{align*}N&=2\\times3!\\times3!\\\\N&=72.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
