        "id": "p4-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $a$ if $2x+5y-6=0$ passes through $(a,-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=8$.",
          "worked": "Substitute $(x,y)=(a,-2)$.\n$$\\begin{align*}2a+5(-2)-6&=0\\\\2a-16&=0\\\\2a&=16\\\\a&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $a$ if $ax-8y+3=0$ passes through $(-7,3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-3$.",
          "worked": "Substitute $(x,y)=(-7,3)$.\n$$\\begin{align*}a(-7)-8(3)+3&=0\\\\-7a-21&=0\\\\-7a&=21\\\\a&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
