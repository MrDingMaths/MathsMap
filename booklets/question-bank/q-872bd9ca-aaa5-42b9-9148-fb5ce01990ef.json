    "children": [
      {
        "id": "p56-q4a",
        "type": "group",
        "label": "a",
        "prompt": "Find how many possible combinations there are if, from a group of ten people:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p56-q4ai",
            "type": "part",
            "label": "i",
            "prompt": "two people are chosen,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "${}^{10}C_2=45$",
              "worked": "$$\\begin{aligned}{}^{10}C_2&=\\frac{10!}{2!8!}\\\\&=45\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p56-q4aii",
            "type": "part",
            "label": "ii",
            "prompt": "eight people are chosen.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "${}^{10}C_8=45$",
              "worked": "$$\\begin{aligned}{}^{10}C_8&=\\frac{10!}{8!2!}\\\\&=45\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      },
      {
        "id": "p56-q4b",
        "type": "part",
        "label": "b",
        "prompt": "Why are the answers identical?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each choice of 2 people uniquely determines the 8 left behind, so ${}^{10}C_2={}^{10}C_8$.",
          "worked": "Choosing 2 people to include uniquely determines the 8 people left behind. Conversely, choosing the 8 to leave behind uniquely determines the 2 included. The selections therefore have the same count. This illustrates ${}^{n}C_r={}^{n}C_{n-r}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
