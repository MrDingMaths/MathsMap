    "id": "p32-q67-group-root",
    "type": "question",
    "label": "12",
    "prompt": "Factorise the following expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q67-root",
        "type": "part",
        "label": "a",
        "prompt": "$$x^2+2xy+y^2-9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+y-3)(x+y+3)$.",
          "worked": "$$\\begin{align*}x^2+2xy+y^2-9&=(x+y)^2-3^2\\\\x^2+2xy+y^2-9&=(x+y-3)(x+y+3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q68-root",
        "type": "part",
        "label": "b",
        "prompt": "$$4a^2-4ab+b^2-16$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2a-b-4)(2a-b+4)$.",
          "worked": "$$\\begin{align*}4a^2-4ab+b^2-16&=(2a-b)^2-4^2\\\\4a^2-4ab+b^2-16&=(2a-b-4)(2a-b+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q69-root",
        "type": "part",
        "label": "c",
        "prompt": "$$25-9u^2+12uv-4v^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5-3u+2v)(5+3u-2v)$.",
          "worked": "$$\\begin{align*}25-9u^2+12uv-4v^2&=5^2-(9u^2-12uv+4v^2)\\\\25-9u^2+12uv-4v^2&=5^2-(3u-2v)^2\\\\25-9u^2+12uv-4v^2&=(5-3u+2v)(5+3u-2v).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
