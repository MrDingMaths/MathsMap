  "content": {
    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Factorise the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-9x-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-10)(x+1)$",
          "worked": "The numbers $-10$ and $1$ add to $-9$ and multiply to $-10$.\n\n$$x^2-9x-10=(x-10)(x+1)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p20-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+2x-63$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+9)(x-7)$",
          "worked": "The numbers $9$ and $-7$ add to $2$ and multiply to $-63$.\n\n$$x^2+2x-63=(x+9)(x-7)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p20-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$5x(x-2)-4(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(5x-4)$",
          "worked": "Take out the common factor $x-2$.\n\n$$5x(x-2)-4(x-2)=(x-2)(5x-4)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$5x^2-2x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5x+3)(x-1)$",
          "worked": "$$\\begin{align*}5x^2-2x-3&=5x^2-5x+3x-3\\\\5x^2-2x-3&=5x(x-1)+3(x-1)\\\\5x^2-2x-3&=(5x+3)(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p20-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$20-3x-2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5-2x)(x+4)$",
          "worked": "$$\\begin{align*}20-3x-2x^2&=20+5x-8x-2x^2\\\\20-3x-2x^2&=5(x+4)-2x(x+4)\\\\20-3x-2x^2&=(5-2x)(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p20-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$5(x-5)-x(5-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)(x+5)$",
          "worked": "$$\\begin{align*}5(x-5)-x(5-x)&=5(x-5)+x(x-5)\\\\5(x-5)-x(5-x)&=(x-5)(x+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p20-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$25-(x-1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(6-x)(4+x)$",
          "worked": "$$\\begin{align*}25-(x-1)^2&=[5-(x-1)][5+(x-1)]\\\\25-(x-1)^2&=(6-x)(4+x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p20-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2-y^2+3x-3y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(x+y+3)$",
          "worked": "$$\\begin{align*}x^2-y^2+3x-3y&=(x-y)(x+y)+3(x-y)\\\\x^2-y^2+3x-3y&=(x-y)(x+y+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p20-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$(x+y)^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+y-2)(x+y+2)$",
          "worked": "Use the difference of squares with $x+y$ and $2$.\n\n$$(x+y)^2-4=(x+y-2)(x+y+2)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p20-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$80x^4-5y^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(4x^2+y^2)(2x-y)(2x+y)$",
          "worked": "$$\\begin{align*}80x^4-5y^4&=5(16x^4-y^4)\\\\80x^4-5y^4&=5(4x^2+y^2)(4x^2-y^2)\\\\80x^4-5y^4&=5(4x^2+y^2)(2x-y)(2x+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$x^3-3x^2-4x+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x-2)(x+2)$",
          "worked": "$$\\begin{align*}x^3-3x^2-4x+12&=x^2(x-3)-4(x-3)\\\\x^3-3x^2-4x+12&=(x-3)(x^2-4)\\\\x^3-3x^2-4x+12&=(x-3)(x-2)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$2x^2-xy-3y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-3y)(x+y)$",
          "worked": "$$\\begin{align*}2x^2-xy-3y^2&=2x^2+2xy-3xy-3y^2\\\\2x^2-xy-3y^2&=2x(x+y)-3y(x+y)\\\\2x^2-xy-3y^2&=(2x-3y)(x+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
