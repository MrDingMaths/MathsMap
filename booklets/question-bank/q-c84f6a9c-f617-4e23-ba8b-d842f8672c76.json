        "type": "part",
        "label": "a",
        "prompt": "Given that $P=xy$ and $2x+y=12$, write $P$ as a function of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=12x-2x^2$.",
          "worked": "$$\\begin{align*}y&=12-2x\\\\P(x)&=x(12-2x)\\\\P(x)&=12x-2x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
