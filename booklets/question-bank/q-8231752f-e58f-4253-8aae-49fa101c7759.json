  "content": {
    "id": "p37-q6-root",
    "type": "question",
    "label": null,
    "prompt": "A fair coin is tossed four times. Find the probability of getting exactly:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "no heads",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{16}$",
          "worked": "Let $X$ be the number of heads. There are $4$ independent tosses, with $p=\\frac12$.\n$$\\begin{align*}P(X=0)&=\\binom40\\left(\\frac12\\right)^0\\left(\\frac12\\right)^4\\\\P(X=0)&=\\frac1{16}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "one head",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "Let $X$ be the number of heads, with $n=4$ and $p=\\frac12$.\n$$\\begin{align*}P(X=1)&=\\binom41\\left(\\frac12\\right)^1\\left(\\frac12\\right)^3\\\\P(X=1)&=\\frac4{16}=\\frac14.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "two heads",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac38$",
          "worked": "Let $X$ be the number of heads, with $n=4$ and $p=\\frac12$.\n$$\\begin{align*}P(X=2)&=\\binom42\\left(\\frac12\\right)^2\\left(\\frac12\\right)^2\\\\P(X=2)&=\\frac6{16}=\\frac38.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "three heads",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "Let $X$ be the number of heads, with $n=4$ and $p=\\frac12$.\n$$\\begin{align*}P(X=3)&=\\binom43\\left(\\frac12\\right)^3\\left(\\frac12\\right)^1\\\\P(X=3)&=\\frac4{16}=\\frac14.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "four heads.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{16}$",
          "worked": "Let $X$ be the number of heads, with $n=4$ and $p=\\frac12$.\n$$\\begin{align*}P(X=4)&=\\binom44\\left(\\frac12\\right)^4\\left(\\frac12\\right)^0\\\\P(X=4)&=\\frac1{16}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
