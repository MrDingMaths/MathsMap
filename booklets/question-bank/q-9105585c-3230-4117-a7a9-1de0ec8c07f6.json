  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The surface area of a cylinder is 25.13 m² and the radius of the base is 1 m. Find the height of the cylinder, correct to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3.00\\text{ m}$",
      "worked": "$$\\begin{aligned}25.13&=2\\pi(1)h+2\\pi(1)^2\\\\h&=\\frac{25.13-2\\pi}{2\\pi}\\\\h&\\approx3.00\\text{ m}.\\end{aligned}$$",
