  "content": {
    "id": "v2-a2942-p15-practice-slot-4-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Is the graph of $y=3\\tan^{-1}(2x)$ concave up or concave down at $x=-\\dfrac12$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Concave up, since $y''\\left(-\\frac12\\right)=6>0$.",
      "worked": "$$\\begin{align*}y'&=\\frac{6}{1+4x^2}\\\\&=6(1+4x^2)^{-1}\\\\y''&=-6(1+4x^2)^{-2}\\cdot8x\\\\&=-\\frac{48x}{(1+4x^2)^2}\\end{align*}$$\nAt $x=-\\frac12$:\n$$\\begin{align*}y''&=\\frac{24}{(1+1)^2}\\\\&=6>0\\end{align*}$$\nThe graph is concave up at $x=-\\frac12$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
