        "id": "p20-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the cost of hiring the yacht for one person?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$320$",
          "worked": "$$\\begin{aligned}C&=\\frac{320}{1}\\\\C&=\\$320\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the cost per person of hiring the yacht if 8 people share the total cost?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$40$",
          "worked": "$$\\begin{aligned}C&=\\frac{320}{8}\\\\C&=\\$40\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "How many people are required to share the cost of hiring a yacht so that the cost per person is $\\$80$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 people",
          "worked": "$$\\begin{aligned}80&=\\frac{320}{n}\\\\n&=\\frac{320}{80}\\\\n&=4\\end{aligned}$$\n4 people are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p20-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Is it possible for the cost per person to be $\\$1$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, if 320 people share the cost, although this is unlikely.",
          "worked": "$$\\begin{aligned}1&=\\frac{320}{n}\\\\n&=320\\end{aligned}$$\nYes, according to the model, 320 people would each pay $\\$1$. This number of people sharing a yacht is unlikely.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
