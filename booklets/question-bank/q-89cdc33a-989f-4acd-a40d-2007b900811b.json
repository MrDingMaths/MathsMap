    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_5 2-\\log_5 50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_5 2-\\log_5 50&=\\log_5\\frac{2}{50}\\\\\\log_5 2-\\log_5 50&=\\log_5(5^{-2})\\\\\\log_5 2-\\log_5 50&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2 6-\\log_2 48$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}\\log_2 6-\\log_2 48&=\\log_2\\frac{6}{48}\\\\\\log_2 6-\\log_2 48&=\\log_2(2^{-3})\\\\\\log_2 6-\\log_2 48&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_3 8-\\log_3 6-\\log_3 12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_3 8-\\log_3 6-\\log_3 12&=\\log_3\\frac{8}{6\\times12}\\\\\\log_3 8-\\log_3 6-\\log_3 12&=\\log_3\\frac19\\\\\\log_3 8-\\log_3 6-\\log_3 12&=\\log_3(3^{-2})\\\\\\log_3 8-\\log_3 6-\\log_3 12&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p22-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_5 12-\\log_5 20-\\log_5 15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_5 12-\\log_5 20-\\log_5 15&=\\log_5\\frac{12}{20\\times15}\\\\\\log_5 12-\\log_5 20-\\log_5 15&=\\log_5\\frac1{25}\\\\\\log_5 12-\\log_5 20-\\log_5 15&=\\log_5(5^{-2})\\\\\\log_5 12-\\log_5 20-\\log_5 15&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p22-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_6\\frac13-\\log_6 12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_6\\frac13-\\log_6 12&=\\log_6\\left(\\frac13\\div12\\right)\\\\\\log_6\\frac13-\\log_6 12&=\\log_6\\frac1{36}\\\\\\log_6\\frac13-\\log_6 12&=\\log_6(6^{-2})\\\\\\log_6\\frac13-\\log_6 12&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p22-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_7\\frac19+\\log_7 63$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_7\\frac19+\\log_7 63&=\\log_7\\left(\\frac19\\times63\\right)\\\\\\log_7\\frac19+\\log_7 63&=\\log_7 7\\\\\\log_7\\frac19+\\log_7 63&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
