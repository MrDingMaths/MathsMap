    "children": [
      {
        "id": "p10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of the tangent to $y=e^{-x}$ at the point $P(-1,e)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-e$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=-e^{-x}\\\\m_{\\mathrm{tangent}}&=-e^{-(-1)}\\\\&=-e^1\\\\&=-e\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Thus write down the gradient of the normal at this point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{e}$",
          "worked": "The normal is perpendicular to the tangent.\n$$m_{\\mathrm{normal}}=-\\frac{1}{-e}=\\frac{1}{e}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence determine the equation of this normal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{x}{e}+\\dfrac{1}{e}+e$",
          "worked": "$$\\begin{align*}y-e&=\\frac{1}{e}(x+1)\\\\y&=\\frac{x}{e}+\\frac{1}{e}+e\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the $x$- and $y$-intercepts of the normal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $(-1-e^2,0)$; $y$-intercept: $\\left(0,\\dfrac{1}{e}+e\\right)$.",
          "worked": "At the $x$-intercept, $y=0$:\n$$\\begin{align*}0&=\\frac{x}{e}+\\frac{1}{e}+e\\\\0&=x+1+e^2\\\\x&=-1-e^2.\\end{align*}$$\nAt the $y$-intercept, $x=0$:\n$$y=\\frac{1}{e}+e.$$\nThe intercepts are $(-1-e^2,0)$ and $\\left(0,\\frac{1}{e}+e\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p10-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the area of the triangle whose vertices lie at the intercepts and the origin.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(1+e^2)^2}{2e}$ square units.",
          "worked": "The perpendicular sides lie along the coordinate axes.\n$$\\begin{align*}A&=\\frac12\\times|1+e^2|\\times\\left|\\frac1e+e\\right|\\\\&=\\frac12(1+e^2)\\frac{1+e^2}{e}\\\\&=\\frac{(1+e^2)^2}{2e}\\text{ square units}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
