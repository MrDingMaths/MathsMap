            {
              "type": "text",
              "text": "A class of 30 students is surveyed about how they travel to school: by bus ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "(B)",
              "display": false
            },
            {
              "type": "text",
              "text": ", by train ",
