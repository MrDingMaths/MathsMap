        {
          "id": "p14-q39-givens",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Four students use all three modes. Three students use none. In total, 17 travel by bus, 16 by train, 15 walk, and 8 travel by both bus and walking (possibly also train). Exactly three travel by train and walk but not by bus.",
              "marks": []
            }
          ]
        },
        {
          "id": "p14-q39-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Find the probability that a randomly selected student travels by bus and train but not on foot.",
              "marks": []
            }
          ]
        }
      ]
