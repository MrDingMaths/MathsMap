  "content": {
    "id": "p22-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Find the smallest number each of whose digits are either $2$ or $4$ that is divisible by $36$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$24\\,444$.\n\nIts digit sum is $18$, its final two digits are $44$, and $24\\,444=36\\times679$.",
      "worked": "Since $36=4\\times9$, the number must be divisible by both $4$ and $9$. Its digit sum is even, so the smallest possible positive digit sum divisible by $9$ is $18$. Four or fewer digits have sum at most $16$, so at least five digits are needed. With five digits, sum $18$ requires one $2$ and four $4$s. The smallest arrangement is $24\\,444$. Its final two digits, $44$, are divisible by $4$, and its digit sum is $18$, so it is divisible by $36$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
