        "answer": {
          "short": "$-21kx-14k$",
          "worked": "$$\\begin{align*}-7k(3x+2)&=(-7k)(3x)+(-7k)(2)\\\\&=-21kx-14k\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q5-i",
