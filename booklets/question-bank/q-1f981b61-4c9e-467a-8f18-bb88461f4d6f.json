  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Expand these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x(y-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy-3x$",
          "worked": "$$\\begin{align*}x(y-3)&=x(y)-x(3)\\\\&=xy-3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$d(x+9s)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$dx+9ds$",
          "worked": "$$\\begin{align*}d(x+9s)&=d(x)+d(9s)\\\\&=dx+9ds\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$5a(2x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10ax+15a$",
          "worked": "$$\\begin{align*}5a(2x+3)&=5a(2x)+5a(3)\\\\&=10ax+15a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$5c(2w-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10cw-20c$",
          "worked": "$$\\begin{align*}5c(2w-4)&=5c(2w)-5c(4)\\\\&=10cw-20c\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$-7y(4x+7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-28xy-49y$",
          "worked": "$$\\begin{align*}-7y(4x+7)&=(-7y)(4x)+(-7y)(7)\\\\&=-28xy-49y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$5j(r+7p)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5jr+35jp$",
          "worked": "$$\\begin{align*}5j(r+7p)&=5j(r)+5j(7p)\\\\&=5jr+35jp\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$-8d(t-3d)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8dt+24d^{2}$",
          "worked": "$$\\begin{align*}-8d(t-3d)&=(-8d)(t)+(-8d)(-3d)\\\\&=-8dt+24d^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q5-h",
