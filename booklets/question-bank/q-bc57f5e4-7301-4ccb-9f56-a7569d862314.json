  "content": {
    "id": "p25-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Three regular dice are rolled. The resulting numbers are multiplied together. Find the probability that the product is a multiple of 5.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{91}{216}$.\n\nCount the outcomes with no 5 and subtract from the total.",
      "worked": "The product is a multiple of 5 exactly when at least one die shows 5. There are $6^3=216$ equally likely ordered outcomes. Each die has five outcomes other than 5, so $5^3=125$ outcomes contain no 5.\n\n$$\\begin{align*}N(\\text{at least one 5})&=216-125\\\\N(\\text{at least one 5})&=91\\\\\\Pr(\\text{product is a multiple of 5})&=\\frac{91}{216}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
