  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The numbers 1 to 25 are written on 25 cards. If a card is selected at random, find the probability that the number on the card is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "14",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{25}$.",
          "worked": "Only one card is 14, out of 25 equally likely cards, so $P=\\frac{1}{25}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "greater than 20",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac15$.",
          "worked": "The favourable numbers are 21,22,23,24,25, so $P=\\frac{5}{25}=\\frac{1}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "even",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12}{25}$.",
          "worked": "There are 12 even numbers 2,4,...,24, so $P=\\frac{12}{25}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "a multiple of 5",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac15$.",
          "worked": "The multiples of 5 are 5,10,15,20,25, so $P=\\frac{5}{25}=\\frac{1}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "odd and a multiple of 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac4{25}$.",
          "worked": "The odd multiples of 3 are 3,9,15,21, so $P=\\frac{4}{25}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "neither even nor a multiple of 5",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac25$.",
          "worked": "There are 13 odd numbers in 1–25. Exclude the odd multiples of 5:5,15,25. This leaves 10 numbers 1,3,7,9,11,13,17,19,21,23, so $P=\\frac{10}{25}=\\frac{2}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
