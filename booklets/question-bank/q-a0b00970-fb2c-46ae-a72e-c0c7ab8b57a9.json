        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}2^{\\frac13}\\times12^{\\frac23}\\times6^{\\frac13}&=(2\\times6)^{\\frac13}\\times12^{\\frac23}\\\\2^{\\frac13}\\times12^{\\frac23}\\times6^{\\frac13}&=12^{\\frac13+\\frac23}\\\\2^{\\frac13}\\times12^{\\frac23}\\times6^{\\frac13}&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p33-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{-3}\\times4^{\\frac12}\\times8^{\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}2^{-3}\\times4^{\\frac12}\\times8^{\\frac13}&=\\frac18\\times2\\times2\\\\2^{-3}\\times4^{\\frac12}\\times8^{\\frac13}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$8^{-\\frac43}\\times32^{\\frac65}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}8^{-\\frac43}\\times32^{\\frac65}&=(2^3)^{-\\frac43}\\times(2^5)^{\\frac65}\\\\8^{-\\frac43}\\times32^{\\frac65}&=2^{-4}\\times2^6\\\\8^{-\\frac43}\\times32^{\\frac65}&=2^2\\\\8^{-\\frac43}\\times32^{\\frac65}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p33-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "$8^{-\\frac23}\\times16^{-\\frac54}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{128}$",
          "worked": "$$\\begin{align*}8^{-\\frac23}\\times16^{-\\frac54}&=(2^3)^{-\\frac23}\\times(2^4)^{-\\frac54}\\\\8^{-\\frac23}\\times16^{-\\frac54}&=2^{-2}\\times2^{-5}\\\\8^{-\\frac23}\\times16^{-\\frac54}&=2^{-7}\\\\8^{-\\frac23}\\times16^{-\\frac54}&=\\frac1{128}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q17-e",
        "type": "part",
        "label": "e",
        "prompt": "$16^{-\\frac34}\\times4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}16^{-\\frac34}\\times4&=(2^4)^{-\\frac34}\\times2^2\\\\16^{-\\frac34}\\times4&=2^{-3+2}\\\\16^{-\\frac34}\\times4&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
