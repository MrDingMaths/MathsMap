    "type": "question",
    "label": "35",
    "prompt": "In which axis was the graph of $xy=1$ reflected to give $xy=-1$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Either the $x$-axis or the $y$-axis.",
      "worked": "For reflection in the $x$-axis, replace $y$ by $-y$:\n$$\\begin{align*}x(-y)&=1\\\\xy&=-1\\end{align*}$$\nFor reflection in the $y$-axis, replace $x$ by $-x$:\n$$\\begin{align*}(-x)y&=1\\\\xy&=-1\\end{align*}$$\nEither axis gives the required graph.",
      "solutionDiagrams": []
    },
