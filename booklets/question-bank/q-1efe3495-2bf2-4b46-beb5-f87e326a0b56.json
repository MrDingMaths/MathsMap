        "label": "a",
        "prompt": "By using the sum of roots, find the roots.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac52,\\ -5$",
          "worked": "Let the roots be $\\alpha$ and $2\\alpha$. Using their sum,\n$$\\begin{align*}\\alpha+2\\alpha&=-\\frac{15}{2}\\\\3\\alpha&=-\\frac{15}{2}\\\\\\alpha&=-\\frac52\\\\2\\alpha&=-5.\\end{align*}$$\nThe roots are $-\\dfrac52$ and $-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p41-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the product of roots to find the value of $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=25$",
          "worked": "Using the product of the roots,\n$$\\begin{align*}\\frac c2&=\\left(-\\frac52\\right)(-5)\\\\\\frac c2&=\\frac{25}{2}\\\\c&=25.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
