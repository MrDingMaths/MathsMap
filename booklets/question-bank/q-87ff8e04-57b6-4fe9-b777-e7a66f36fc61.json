                    "latex": "\\begin{aligned}\\mathrm{LHS}&=\\bigl[1+27+125+\\cdots+(2k-1)^3\\bigr]+(2k+1)^3\\\\&=k^2(2k^2-1)+(2k+1)^3\\quad\\text{using assumption}\\\\&=2k^4-k^2+8k^3+12k^2+6k+1\\\\&=2k^4+8k^3+11k^2+6k+1\\\\&=\\mathrm{RHS}\\end{aligned}",
                    "display": true,
