  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the size of an interior angle for these regular polygons with the given angle sum.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "regular octagon ($1080^{\\circ}$)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$135^{\\circ}$",
          "worked": "The eight interior angles are equal.\n$\\begin{aligned}I&=\\frac{1080^{\\circ}}{8}\\\\I&=135^{\\circ}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "regular nonagon ($1260^{\\circ}$)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$140^{\\circ}$",
          "worked": "The nine interior angles are equal.\n$\\begin{aligned}I&=\\frac{1260^{\\circ}}{9}\\\\I&=140^{\\circ}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "regular decagon ($1440^{\\circ}$)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$144^{\\circ}$",
          "worked": "The ten interior angles are equal.\n$\\begin{aligned}I&=\\frac{1440^{\\circ}}{10}\\\\I&=144^{\\circ}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
