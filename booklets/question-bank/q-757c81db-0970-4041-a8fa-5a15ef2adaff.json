  "classification": {
    "primarySkillId": "parametric-equations-concept",
    "secondarySkillIds": [],
    "reasoningScore": 42,
    "difficulty": "Development",
    "difficultyReason": "Distinguishes a curve from its parametrisation, parameter domain and repeated parameter values."
  },
  "content": {
    "id": "p66-q01-05-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p66-q01-05-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "True or False?",
              "marks": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p66-q01-05-a",
        "type": "part",
        "label": "a",
        "prompt": "A Cartesian equation can only have one parametric representation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. A Cartesian equation may have multiple parametric representations.",
          "worked": "False. Both $(t,t^2)$ and $(2t,4t^2)$ describe the whole curve $y=x^2$ for $t\\in\\mathbb{R}$. Therefore the parametrisation is not unique.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p66-q01-05-b",
        "type": "part",
        "label": "b",
        "prompt": "Restricting the domain of the parameter will produce only a section of the whole curve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. A restricted parameter interval can still trace the whole curve.",
          "worked": "False. For $(\\cos t,\\sin t)$, the restricted interval $0\\leq t\\leq2\\pi$ includes one full period and traces the entire unit circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p66-q01-05-c",
        "type": "part",
        "label": "c",
        "prompt": "The parametrisation $(\\cos t,\\cos t)$ represents only a portion of $y=x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True. It traces $y=x$ for $-1\\leq x\\leq1$.",
          "worked": "True. Since $x=y=\\cos t$ and $-1\\leq\\cos t\\leq1$, the curve is the segment of $y=x$ from $(-1,-1)$ to $(1,1)$, including both endpoints.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p66-q01-05-d",
        "type": "part",
        "label": "d",
        "prompt": "Each unique point on the curve has a unique value of the parameter.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. Different parameter values can give the same point.",
          "worked": "False. For $(\\cos t,\\sin t)$, both $t=0$ and $t=2\\pi$ give $(1,0)$. Thus one point can correspond to more than one parameter value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p66-q01-05-e",
        "type": "part",
        "label": "e",
        "prompt": "The parametrisation $(\\tan t,\\tan t)$ represents $y=x$ with holes in the graph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. It traces the whole line $y=x$.",
          "worked": "False. The range of $\\tan t$ is all real numbers, so every point $(x,x)$ is reached. Undefined parameter values do not remove any points from the line $y=x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
