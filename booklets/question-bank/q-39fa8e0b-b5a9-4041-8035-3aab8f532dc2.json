  "content": {
    "id": "p36-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A piece of meat is taken out of the freezer at $-9^\\circ\\mathrm{C}$ into the air at $25^\\circ\\mathrm{C}$. The rate at which the meat warms follows Newton's law of cooling $\\dfrac{dT}{dt}=-k(T-25)$, with time $t$ measured in minutes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $T=25-Ae^{-kt}$ is a solution of this equation, and find the value of $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dT}{dt}=Ake^{-kt}=-k(T-25)$; $A=34$.",
          "worked": "$$\\begin{aligned}\\frac{dT}{dt}&=Ake^{-kt}\\\\-k(T-25)&=-k(-Ae^{-kt})\\\\&=Ake^{-kt}.\\end{aligned}$$\nBoth sides are equal, so the differential equation is satisfied. At $t=0$,\n$$\\begin{aligned}-9&=25-A\\\\A&=34.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p36-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "The meat reaches $8^\\circ\\mathrm{C}$ in $45$ minutes. Find the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac{\\ln 2}{45}\\ \\mathrm{min}^{-1}$.",
          "worked": "$$\\begin{aligned}8&=25-34e^{-45k}\\\\-17&=-34e^{-45k}\\\\e^{-45k}&=\\frac{1}{2}\\\\-45k&=\\ln\\!\\left(\\frac{1}{2}\\right)\\\\k&=\\frac{\\ln 2}{45}\\ \\mathrm{min}^{-1}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p36-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the temperature it reaches after another $45$ minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16.5^\\circ\\mathrm{C}$.",
          "worked": "After another $45$ minutes, $t=90$ minutes. Using $k=\\dfrac{\\ln 2}{45}$,\n$$\\begin{aligned}T(90)&=25-34e^{-90k}\\\\&=25-34e^{-2\\ln 2}\\\\&=25-34\\left(\\frac{1}{4}\\right)\\\\&=16.5^\\circ\\mathrm{C}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
