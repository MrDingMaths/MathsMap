  "content": {
    "id": "p4-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Evaluate each expression for $m=5$ and $n=10$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{m}{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{m}{n}&=\\frac{5}{10}\\\\\\frac{m}{n}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p4-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{n-m}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{n-m}{5}&=\\frac{10-5}{5}\\\\\\frac{n-m}{5}&=\\frac{5}{5}\\\\\\frac{n-m}{5}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p4-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{20}{m}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\frac{20}{m}+3&=\\frac{20}{5}+3\\\\\\frac{20}{m}+3&=4+3\\\\\\frac{20}{m}+3&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p4-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3m-n}{m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{3m-n}{m}&=\\frac{3\\times5-10}{5}\\\\\\frac{3m-n}{m}&=\\frac{15-10}{5}\\\\\\frac{3m-n}{m}&=\\frac{5}{5}\\\\\\frac{3m-n}{m}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
