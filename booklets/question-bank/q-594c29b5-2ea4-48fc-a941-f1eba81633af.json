  "content": {
    "id": "p18-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A triangle with perimeter 10 has angles $30^{\\circ}$, $60^{\\circ}$ and $90^{\\circ}$. Find the area of the triangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{25(2\\sqrt{3}-3)}{3}$ square units.\n\nUse the side ratio $1:\\sqrt{3}:2$, then calculate half the product of the perpendicular sides.",
      "worked": "The sides of a $30^{\\circ}$–$60^{\\circ}$–$90^{\\circ}$ triangle are $k$, $k\\sqrt{3}$ and $2k$.\n\n$$\\begin{align*}k+k\\sqrt{3}+2k&=10\\\\k(3+\\sqrt{3})&=10\\\\k&=\\frac{10}{3+\\sqrt{3}}\\end{align*}$$\n\n$$\\begin{align*}A&=\\frac12 k(k\\sqrt{3})\\\\A&=\\frac{50\\sqrt{3}}{(3+\\sqrt{3})^2}\\\\A&=\\frac{25\\sqrt{3}}{3(2+\\sqrt{3})}\\\\A&=\\frac{25(2\\sqrt{3}-3)}{3}\\text{ square units}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
