  "content": {
    "id": "p7-q9",
    "type": "question",
    "label": "9",
    "prompt": "Find the coordinates of point $P$ that divides $A(-4,9)$ and $B(1,-1)$ in the ratio $2:3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P(-2,5)$\n\nMove two fifths of each coordinate difference from A towards B.",
      "worked": "$P$ is two fifths of the distance from $A$ to $B$.\n$$\\begin{align*}x_P &= -4+\\frac{2}{5}\\bigl(1-(-4)\\bigr)\\\\x_P &= -2\\\\y_P &= 9+\\frac{2}{5}(-1-9)\\\\y_P &= 5\\end{align*}$$\n$P(-2,5)$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
  },
