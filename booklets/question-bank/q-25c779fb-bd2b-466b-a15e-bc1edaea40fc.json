                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\mathrm{WTP:}\\quad 1^2+3^2+5^2+\\cdots+(2k-1)^2+(2(k+1)-1)^2&=\\frac13(k+1)(2(k+1)-1)(2(k+1)+1)\\\\&=\\frac13(k+1)(2k+1)(2k+3)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p25-k-derivation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\mathrm{LHS}&=1^2+3^2+5^2+\\cdots+(2k-1)^2+(2(k+1)-1)^2\\\\&=\\frac13k(2k-1)(2k+1)+(2(k+1)-1)^2\\quad\\text{using assumption}\\\\&=\\frac13k(2k-1)(2k+1)+(2k+2-1)^2\\\\&=\\frac13k(2k-1)(2k+1)+(2k+1)^2\\\\&=(2k+1)\\left(\\frac13k(2k-1)+(2k+1)\\right)\\\\&=\\frac13(2k+1)\\left(k(2k-1)+3(2k+1)\\right)\\\\&=\\frac13(2k+1)(2k^2-k+6k+3)\\\\&=\\frac13(2k+1)(2k^2+5k+3)\\\\&=\\frac13(2k+1)(k+1)(2k+3)\\\\&=\\frac13(k+1)(2k+1)(2k+3)\\\\&=\\mathrm{RHS}\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
