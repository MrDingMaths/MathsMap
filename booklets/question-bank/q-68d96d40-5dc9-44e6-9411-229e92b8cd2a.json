  "content": {
    "id": "p15-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "$y''=6x+4$. When $x=1$, $y'=2$ and $y=4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $y'$ and use the condition $y'=2$ when $x=1$ to find the constant of integration.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C_1=-5$, so $y'=3x^2+4x-5$.",
          "worked": "$$y'=3x^2+4x+C_1$$\nSubstitute $x=1$, $y'=2$:\n$$\\begin{align*}2&=3+4+C_1\\\\C_1&=-5\\\\y'&=3x^2+4x-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $y$ and use the condition $y=4$ when $x=1$ to find the second constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C_2=6$, so $y=x^3+2x^2-5x+6$.",
          "worked": "$$y=x^3+2x^2-5x+C_2$$\nSubstitute $x=1$, $y=4$:\n$$\\begin{align*}4&=1+2-5+C_2\\\\C_2&=6\\\\y&=x^3+2x^2-5x+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
