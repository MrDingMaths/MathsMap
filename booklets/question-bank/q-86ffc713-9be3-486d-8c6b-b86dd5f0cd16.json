  "content": {
    "id": "p51-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Filipo is thinking of two numbers, $x$ and $y$.\nHe decreases $x$ by a quarter and increases $y$ by 20%. The new numbers are equal.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q9-equation",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p51-q9-equation-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Write this information as an equation of the form: ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "0.75",
                  "width": 15
                },
                {
                  "type": "math",
                  "latex": "x=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "1.2",
                  "width": 15
                },
                {
                  "type": "math",
                  "latex": "y",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.75x=1.2y$",
          "worked": "Decreasing $x$ by a quarter gives multiplier $1-\\frac14=0.75$. Increasing $y$ by 20% gives multiplier $1+0.20=1.2$. The new numbers are equal, so $0.75x=1.2y$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p51-q9-value",
        "type": "part",
        "label": "b",
        "prompt": "If $y=60$, find the value of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=96$",
          "worked": "$$\\begin{align*}0.75x&=1.2\\times60\\\\0.75x&=72\\\\x&=72\\div0.75\\\\x&=96\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
