  "content": {
    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The $n$th term of a sequence is given by $a_n=10n+4$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q8a",
        "type": "part",
        "label": "a",
        "prompt": "Put $a_n<100$, find how many terms are less than 100.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 terms: $a_1$ to $a_9$.",
          "worked": "$$\\begin{align*}10n+4&<100\\\\10n&<96\\\\n&<9.6\\end{align*}$$\nSince $n$ is a positive integer, $n=1,2,\\ldots,9$. There are 9 terms less than 100.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q8b",
        "type": "part",
        "label": "b",
        "prompt": "Put $a_n>56$, find the first term greater than 56. State its position number and value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Position 6; $a_6=64$.",
          "worked": "$$\\begin{align*}10n+4&>56\\\\10n&>52\\\\n&>5.2\\end{align*}$$\nThe smallest integer position is $n=6$.\n$$\\begin{align*}a_6&=10(6)+4\\\\a_6&=64\\end{align*}$$\nThe first term greater than 56 is the 6th term, with value 64.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
