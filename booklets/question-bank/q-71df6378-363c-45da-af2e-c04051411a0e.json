      {
        "id": "p18-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $y=\\log_2 x$. Hence find the gradient of the tangent to the curve at $x=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1}{x\\ln 2}$; gradient at $x=1$ is $\\dfrac{1}{\\ln 2}$.",
          "worked": "$$\\begin{align*}y'&=\\frac{1}{x\\ln 2}\\\\y'(1)&=\\frac{1}{1\\ln 2}\\\\y'(1)&=\\frac{1}{\\ln 2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the equation of the tangent there.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "dependsOn": [
          "p18-q3-a"
        ],
        "answer": {
          "short": "$y=\\dfrac{x-1}{\\ln 2}$.",
          "worked": "At $x=1$, $y=\\log_2 1=0$, so the tangent passes through $(1,0)$.\n$$\\begin{align*}y-0&=\\frac{1}{\\ln 2}(x-1)\\\\y&=\\frac{x-1}{\\ln 2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
