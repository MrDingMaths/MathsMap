  "content": {
    "id": "v2-84f2e-p13-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "$f(x)=2x+5$ and $g(x)=x-3$. Find the value of $x$ for which:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-84f2e-p13-practice-slot-2-s2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(g(x))=11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6$",
          "worked": "$$\\begin{align*}f(g(x))&=2(x-3)+5\\\\&=2x-1\\\\2x-1&=11\\\\x&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-84f2e-p13-practice-slot-2-s2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(f(x))=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}g(f(x))&=(2x+5)-3\\\\&=2x+2\\\\2x+2&=12\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
