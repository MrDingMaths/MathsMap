      "evidence": ".booklet-work/reasoning-ratings/calls/logarithms-v1/4c2e5995df7310707f7cf78e360e5e650ce98f11f544c8f1f8c5f7b44f3af96e-1792560614807/last-message.txt"
    }
  },
  "content": {
    "id": "p17-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Write in terms of $\\log_a x$, assuming $x>0$ and $a>0$, $a\\ne1$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a x^3&=3\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p17-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\frac1x&=\\log_a x^{-1}\\\\&=-\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p17-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\sqrt x&=\\log_a x^{\\frac12}\\\\&=\\frac12\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p17-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_a\\frac{1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\frac1{x^2}&=\\log_a x^{-2}\\\\&=-2\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p17-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_a x^3-\\log_a x^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a x^3-\\log_a x^5&=3\\log_a x-5\\log_a x\\\\&=-2\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p17-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a x^4+\\log_a\\frac{1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a x^4+\\log_a\\frac1{x^2}&=4\\log_a x-2\\log_a x\\\\&=2\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p17-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$2\\log_a a^4-\\log_a x^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8-8\\log_a x$",
          "worked": "$$\\begin{align*}2\\log_a a^4-\\log_a x^8&=2\\times4\\log_a a-8\\log_a x\\\\&=8-8\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p17-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_a\\frac{1}{\\sqrt{x}}+3\\log_a\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\frac1{\\sqrt x}+3\\log_a\\sqrt x&=\\log_a x^{-\\frac12}+3\\log_a x^{\\frac12}\\\\&=-\\frac12\\log_a x+\\frac32\\log_a x\\\\&=\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
