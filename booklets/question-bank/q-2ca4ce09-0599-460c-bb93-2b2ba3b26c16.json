    "type": "question",
    "label": "9",
    "prompt": "If $y=(a+1)x+7$ is perpendicular to $y=2x-4$, find the value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-\\frac{3}{2}$",
      "worked": "The gradients are $a+1$ and $2$. Perpendicular gradients have product $-1$.\n$$\\begin{align*}2(a+1)&=-1\\\\a+1&=-\\frac{1}{2}\\\\a&=-\\frac{3}{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
