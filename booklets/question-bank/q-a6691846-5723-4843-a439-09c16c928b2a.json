              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Two years ago, Tiff's father was three times his own age 28 years ago.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "How old is Tiff's father now?",
                  "marks": []
