  "content": {
    "id": "p15-q36-root",
    "type": "question",
    "label": null,
    "prompt": "Given $f(x)=x^2+\\sqrt{x}$, find the values of the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q36-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}f(4)&=4^2+\\sqrt{4}\\\\f(4)&=16+2\\\\f(4)&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q36-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(25)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$630$",
          "worked": "$$\\begin{align*}f(25)&=25^2+\\sqrt{25}\\\\f(25)&=625+5\\\\f(25)&=630\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q36-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25+\\sqrt{5}$",
          "worked": "$$\\begin{align*}f(5)&=5^2+\\sqrt{5}\\\\f(5)&=25+\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
