    "type": "question",
    "label": "4",
    "prompt": "The step function is defined by\n$$f(x)=\\begin{cases}0,&x<0,\\\\1,&x\\ge0.\\end{cases}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
