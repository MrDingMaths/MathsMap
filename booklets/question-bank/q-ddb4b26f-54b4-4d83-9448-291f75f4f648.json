      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=0$ for $x<0$ and $y=1$ for $x\\ge0$, with an open endpoint at $(0,0)$ and a closed endpoint at $(0,1)$.",
          "worked": "For $x<0$, draw the horizontal branch $y=0$ with an open endpoint at $(0,0)$. For $x\\ge0$, draw the horizontal branch $y=1$ with a closed endpoint at $(0,1)$.",
