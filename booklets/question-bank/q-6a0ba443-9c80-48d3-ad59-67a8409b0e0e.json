  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A rectangle is five times as long as it is wide. The perimeter of the rectangle is 120 cm. Find the length and the width of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Length: $50\\text{ cm}$; width: $10\\text{ cm}$.",
      "worked": "Let the width be $x$ cm. The length is $5x$ cm.\n\n$$\\begin{align*}5x+5x+x+x&=120\\\\12x&=120\\\\x&=\\frac{120}{12}\\\\x&=10\\end{align*}$$\n\nThe width is $10\\text{ cm}$ and the length is $5\\times10=50\\text{ cm}$.\n\nCheck: $2(50+10)=120\\text{ cm}$ and $50=5\\times10$.",
      "solutionDiagrams": []
    },
