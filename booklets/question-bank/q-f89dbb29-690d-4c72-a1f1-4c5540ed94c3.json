    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Suppose the weight hangs over the midpoint $M$ of $BC$. Prove that $\\triangle ABM\\cong\\triangle ACM$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\triangle ABM\\cong\\triangle ACM$ by SSS.",
          "worked": "$$\\begin{align*}AB&=AC &&\\text{(isosceles triangle)}\\\\AM&=AM &&\\text{(shared side)}\\\\BM&=CM &&\\text{(midpoint)}\\end{align*}$$\nTherefore $\\triangle ABM\\cong\\triangle ACM$ by SSS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Why is $\\angle AMB=\\angle AMC$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "They are corresponding angles in congruent triangles.",
          "worked": "$\\triangle ABM\\cong\\triangle ACM$ from part (a), so their corresponding angles at $M$ are equal: $\\angle AMB=\\angle AMC$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Why does this then mean that $AM$ is perpendicular to $MB$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The equal adjacent angles sum to $180^\\circ$, so each is $90^\\circ$. Hence $AM\\perp MB$.",
          "worked": "$B$, $M$ and $C$ lie on a straight line, so $\\angle AMB+\\angle AMC=180^\\circ$. The angles are equal by part (b), giving $\\angle AMB=\\angle AMC=90^\\circ$. Therefore $AM\\perp MB$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
