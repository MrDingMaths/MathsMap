        "answer": {
          "short": "$25\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A &= \\frac{1}{2}r^2\\theta\\\\A &= \\frac{1}{2}\\times 5^2\\times 2\\\\A &= 25\\text{ cm}^2\\end{align*}$$",
