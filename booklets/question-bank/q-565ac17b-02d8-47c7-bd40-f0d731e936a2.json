        "answer": {
          "short": "$10\\text{ cm}$",
          "worked": "$$\\begin{align*}l &= r\\theta\\\\l &= 5\\times 2\\\\l &= 10\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
