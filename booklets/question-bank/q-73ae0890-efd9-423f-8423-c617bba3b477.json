  "content": {
    "id": "p9-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Solve these equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x(x-2)=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $x=-1$.",
          "worked": "$$\\begin{align*}2x^2-4x&=6\\\\2x^2-4x-6&=0\\\\x^2-2x-3&=0\\\\(x-3)(x+1)&=0\\end{align*}$$\nBy the null factor law, $x=3$ or $x=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p9-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$3x(x+6)=4(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$ or $x=-\\frac{2}{3}$.",
          "worked": "P: $24$; S: $14$; F: $12,2$.\n$$\\begin{align*}3x^2+18x&=4x-8\\\\3x^2+14x+8&=0\\\\3x^2+12x+2x+8&=0\\\\3x(x+4)+2(x+4)&=0\\\\(3x+2)(x+4)&=0\\end{align*}$$\nBy the null factor law, $x=-\\frac{2}{3}$ or $x=-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p9-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$4x(x+5)=6x-4x^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{1}{4}$ or $x=-\\frac{3}{2}$.",
          "worked": "P: $24$; S: $14$; F: $12,2$.\n$$\\begin{align*}4x^2+20x&=6x-4x^2-3\\\\8x^2+14x+3&=0\\\\8x^2+12x+2x+3&=0\\\\4x(2x+3)+(2x+3)&=0\\\\(4x+1)(2x+3)&=0\\end{align*}$$\nBy the null factor law, $x=-\\frac{1}{4}$ or $x=-\\frac{3}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p9-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{20-3x}{x}=2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5}{2}$ or $x=-4$. Multiply by $x$, then factorise.",
          "worked": "$x\\ne0$. Multiply both sides by $x$.\nP: $-40$; S: $3$; F: $8,-5$.\n$$\\begin{align*}20-3x&=2x^2\\\\2x^2+3x-20&=0\\\\2x^2+8x-5x-20&=0\\\\2x(x+4)-5(x+4)&=0\\\\(2x-5)(x+4)&=0\\end{align*}$$\nBy the null factor law, $x=\\frac{5}{2}$ or $x=-4$. Both satisfy $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p9-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{6x+8}{5x}=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-\\frac{4}{5}$. Multiply by $5x$, then factorise.",
          "worked": "$x\\ne0$. Multiply both sides by $5x$.\nP: $-40$; S: $-6$; F: $-10,4$.\n$$\\begin{align*}6x+8&=5x^2\\\\5x^2-6x-8&=0\\\\5x^2-10x+4x-8&=0\\\\5x(x-2)+4(x-2)&=0\\\\(5x+4)(x-2)&=0\\end{align*}$$\nBy the null factor law, $x=-\\frac{4}{5}$ or $x=2$. Both satisfy $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p9-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{7x+10}{2x}=3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-\\frac{5}{6}$. Multiply by $2x$, then factorise.",
          "worked": "$x\\ne0$. Multiply both sides by $2x$.\nP: $-60$; S: $-7$; F: $-12,5$.\n$$\\begin{align*}7x+10&=6x^2\\\\6x^2-7x-10&=0\\\\6x^2-12x+5x-10&=0\\\\6x(x-2)+5(x-2)&=0\\\\(6x+5)(x-2)&=0\\end{align*}$$\nBy the null factor law, $x=-\\frac{5}{6}$ or $x=2$. Both satisfy $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p10-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{4}{x-2}=x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $x=-2$. Multiply by $x-2$, then factorise.",
          "worked": "$x\\ne2$. Multiply both sides by $x-2$.\n$$\\begin{align*}4&=(x+1)(x-2)\\\\4&=x^2-x-2\\\\x^2-x-6&=0\\\\(x-3)(x+2)&=0\\end{align*}$$\nBy the null factor law, $x=3$ or $x=-2$. Both satisfy $x\\ne2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p10-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{1}{x}=3-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{2}$ or $x=1$. Multiply by $x$, then factorise.",
          "worked": "$x\\ne0$. Multiply both sides by $x$.\nP: $2$; S: $-3$; F: $-2,-1$.\n$$\\begin{align*}1&=3x-2x^2\\\\2x^2-3x+1&=0\\\\2x^2-2x-x+1&=0\\\\2x(x-1)-(x-1)&=0\\\\(2x-1)(x-1)&=0\\end{align*}$$\nBy the null factor law, $x=\\frac{1}{2}$ or $x=1$. Both satisfy $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p10-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{x^2+12}{x}=-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=-6$. Multiply by $x$, then factorise.",
          "worked": "$x\\ne0$. Multiply both sides by $x$.\n$$\\begin{align*}x^2+12&=-8x\\\\x^2+8x+12&=0\\\\(x+2)(x+6)&=0\\end{align*}$$\nBy the null factor law, $x=-2$ or $x=-6$. Both satisfy $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p10-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{2x^2-12}{x}=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{3}{2}$ or $x=4$. Multiply by $x$, then factorise.",
          "worked": "$x\\ne0$. Multiply both sides by $x$.\nP: $-24$; S: $-5$; F: $-8,3$.\n$$\\begin{align*}2x^2-12&=5x\\\\2x^2-5x-12&=0\\\\2x^2-8x+3x-12&=0\\\\2x(x-4)+3(x-4)&=0\\\\(2x+3)(x-4)&=0\\end{align*}$$\nBy the null factor law, $x=-\\frac{3}{2}$ or $x=4$. Both satisfy $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p10-q7-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{x+4}{2}-\\frac{3}{x-3}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=-3$. Multiply by $2(x-3)$, then factorise.",
          "worked": "$x\\ne3$. Multiply both sides by $2(x-3)$.\n$$\\begin{align*}(x+4)(x-3)-6&=2(x-3)\\\\x^2+x-18&=2x-6\\\\x^2-x-12&=0\\\\(x-4)(x+3)&=0\\end{align*}$$\nBy the null factor law, $x=4$ or $x=-3$. Both satisfy $x\\ne3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p10-q7-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{x}{x-2}-\\frac{x+1}{x+4}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$ or $x=-2$. Multiply by $(x-2)(x+4)$, then factorise.",
          "worked": "$x\\ne2,-4$. Multiply both sides by $(x-2)(x+4)$.\n$$\\begin{align*}x(x+4)-(x+1)(x-2)&=(x-2)(x+4)\\\\x^2+4x-(x^2-x-2)&=x^2+2x-8\\\\5x+2&=x^2+2x-8\\\\x^2-3x-10&=0\\\\(x-5)(x+2)&=0\\end{align*}$$\nBy the null factor law, $x=5$ or $x=-2$. Neither is an excluded value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
