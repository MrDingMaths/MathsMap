        "answer": {
          "short": "$130^\\circ$",
          "worked": "$AC$ is a diameter, so $\\angle AOC$ is a straight angle.\n$$\\begin{align*}\\angle AOD&=180^\\circ-50^\\circ\\\\&=130^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
