  "content": {
    "id": "p11-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A circular disc expands as it is being heated. The area of the disc after $t$ minutes is given by $A=3t^2+t$, where $A$ is in cm².",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the rate at which the area increases after 4 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\text{ cm}^2/\\text{min}$",
          "worked": "$$\\begin{align*}\\frac{dA}{dt}&=6t+1\\\\\\left.\\frac{dA}{dt}\\right|_{t=4}&=6(4)+1\\\\\\left.\\frac{dA}{dt}\\right|_{t=4}&=25\\text{ cm}^2/\\text{min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the average rate of change during the 4th minute. (The 4th minute is between $t=3$ and $t=4$.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22\\text{ cm}^2/\\text{min}$",
          "worked": "$$\\begin{align*}A(3)&=3(3)^2+3\\\\A(3)&=30\\text{ cm}^2\\\\A(4)&=3(4)^2+4\\\\A(4)&=52\\text{ cm}^2\\end{align*}$$\n$$\\begin{align*}\\text{Average rate}&=\\frac{A(4)-A(3)}{4-3}\\\\\\text{Average rate}&=\\frac{52-30}{1}\\\\\\text{Average rate}&=22\\text{ cm}^2/\\text{min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
