  "content": {
    "id": "p25-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Write in the form $(x+a)^2+c$ by completing the square.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+6x+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)^2+1$",
          "worked": "$\\begin{align*}x^2+6x+10&=x^2+6x+3^2-3^2+10\\\\&=(x+3)^2-9+10\\\\&=(x+3)^2+1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+6x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)^2-6$",
          "worked": "$\\begin{align*}x^2+6x+3&=x^2+6x+3^2-3^2+3\\\\&=(x+3)^2-9+3\\\\&=(x+3)^2-6\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+6x+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)^2$",
          "worked": "$\\begin{align*}x^2+6x+9&=x^2+6x+3^2-3^2+9\\\\&=(x+3)^2-9+9\\\\&=(x+3)^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2+6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)^2-9$",
          "worked": "$\\begin{align*}x^2+6x&=x^2+6x+3^2-3^2\\\\&=(x+3)^2-3^2\\\\&=(x+3)^2-9\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+6x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)^2-4$",
          "worked": "$\\begin{align*}x^2+6x+5&=x^2+6x+3^2-3^2+5\\\\&=(x+3)^2-9+5\\\\&=(x+3)^2-4\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2+6x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)^2-13$",
          "worked": "$\\begin{align*}x^2+6x-4&=x^2+6x+3^2-3^2-4\\\\&=(x+3)^2-9-4\\\\&=(x+3)^2-13\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
