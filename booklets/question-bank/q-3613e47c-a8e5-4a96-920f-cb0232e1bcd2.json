    "children": [
      {
        "id": "p31-q6-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p31-q6-a-given",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "7, 8 and 9 are consecutive whole numbers. ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "8^2-7\\times9=1",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            },
            {
              "id": "p31-q6-a-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Prove that this result holds for any three consecutive numbers ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "n-1",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "n",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "n+1",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ". That is, ‘If the product of the outer numbers is subtracted from the square of the middle number, the result is one’.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^2-(n-1)(n+1)=1$.\n\nExpand the outer product as a difference of squares.",
          "worked": "$$\\begin{align*}n^2-(n-1)(n+1)&=n^2-(n^2-1)\\\\n^2-(n-1)(n+1)&=1\\end{align*}$$\nThus the result holds for every three consecutive whole numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p31-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$a-d$, $a$ and $a+d$ are three numbers. Show that if the product of the outer pair is subtracted from the square of the middle term, the result is $d^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-(a-d)(a+d)=d^2$.\n\nUse the difference of squares for the outer product.",
          "worked": "$$\\begin{align*}a^2-(a-d)(a+d)&=a^2-(a^2-d^2)\\\\a^2-(a-d)(a+d)&=d^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
