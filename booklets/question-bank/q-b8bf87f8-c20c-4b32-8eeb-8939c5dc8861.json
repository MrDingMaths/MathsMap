    "label": "2",
    "prompt": "Find $4\\sin195^{\\circ}\\cos45^{\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1-\\sqrt3$",
      "worked": "$$\\begin{align*}4\\sin195^{\\circ}\\cos45^{\\circ}&=2[\\sin(195^{\\circ}+45^{\\circ})+\\sin(195^{\\circ}-45^{\\circ})]\\\\4\\sin195^{\\circ}\\cos45^{\\circ}&=2(\\sin240^{\\circ}+\\sin150^{\\circ})\\\\4\\sin195^{\\circ}\\cos45^{\\circ}&=2\\left(-\\frac{\\sqrt3}{2}+\\frac12\\right)\\\\4\\sin195^{\\circ}\\cos45^{\\circ}&=1-\\sqrt3.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
