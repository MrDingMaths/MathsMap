    "type": "question",
    "label": null,
    "prompt": "Prove that $\\displaystyle\\frac{\\tan\\theta}{1+\\tan\\theta}+\\frac{\\tan\\theta}{1-\\tan\\theta}=\\tan2\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Combine the fractions to obtain $\\dfrac{2\\tan\\theta}{1-\\tan^2\\theta}=\\tan2\\theta$.",
      "worked": "$$\\begin{align*}\\frac{\\tan\\theta}{1+\\tan\\theta}+\\frac{\\tan\\theta}{1-\\tan\\theta}&=\\frac{\\tan\\theta(1-\\tan\\theta)+\\tan\\theta(1+\\tan\\theta)}{(1+\\tan\\theta)(1-\\tan\\theta)}\\\\\\frac{\\tan\\theta}{1+\\tan\\theta}+\\frac{\\tan\\theta}{1-\\tan\\theta}&=\\frac{\\tan\\theta-\\tan^2\\theta+\\tan\\theta+\\tan^2\\theta}{1-\\tan^2\\theta}\\\\\\frac{\\tan\\theta}{1+\\tan\\theta}+\\frac{\\tan\\theta}{1-\\tan\\theta}&=\\frac{2\\tan\\theta}{1-\\tan^2\\theta}\\\\\\frac{\\tan\\theta}{1+\\tan\\theta}+\\frac{\\tan\\theta}{1-\\tan\\theta}&=\\tan2\\theta.\\end{align*}$$",
      "solutionDiagrams": []
    },
