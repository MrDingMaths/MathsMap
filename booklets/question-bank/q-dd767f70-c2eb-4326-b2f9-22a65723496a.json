  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "How many strings of length 2 or 3 can be formed using letters from the set $\\{a,b,c,d,e\\}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8a",
        "type": "part",
        "label": "a",
        "prompt": "without restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$150$\n\nAdd the counts for lengths 2 and 3.",
          "worked": "There are five choices at each position. Strings of different lengths are separate cases.\n$$\\begin{align*}N&=5^2+5^3\\\\N&=25+125\\\\N&=150\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q8b",
        "type": "part",
        "label": "b",
        "prompt": "without repetition",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80$\n\nAdd the ordered selections of lengths 2 and 3.",
          "worked": "Without repetition, each successive position has one fewer choice. Add the two length cases.\n$$\\begin{align*}N&=5\\times4+5\\times4\\times3\\\\N&=20+60\\\\N&=80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
