    "type": "question",
    "label": "9",
    "prompt": "Calculate the perimeter of $\\triangle PQR$ with vertices $P(3,1)$, $Q(8,6)$ and $R(10,0)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10\\sqrt2+2\\sqrt{10}$.\n\nFind the three side lengths using the distance formula and add them.",
      "worked": "$$\\begin{align*}PQ^2&=(8-3)^2+(6-1)^2=50\\\\PQ&=5\\sqrt2\\\\QR^2&=(10-8)^2+(0-6)^2=40\\\\QR&=2\\sqrt{10}\\\\RP^2&=(3-10)^2+(1-0)^2=50\\\\RP&=5\\sqrt2\\\\\\text{Perimeter}&=5\\sqrt2+2\\sqrt{10}+5\\sqrt2\\\\\\text{Perimeter}&=10\\sqrt2+2\\sqrt{10}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
