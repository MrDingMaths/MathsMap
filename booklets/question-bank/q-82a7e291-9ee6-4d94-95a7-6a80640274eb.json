  "content": {
    "id": "p22-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Let $f:\\mathbb{R}\\to\\mathbb{R}$ and $g:\\mathbb{R}\\to\\mathbb{R}$ be given by $f(x)=x^2+2$ and $g(x)=x+1$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(f\\circ g)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2x+3$",
          "worked": "$$\\begin{align*}(f\\circ g)(x)&=f(g(x))\\\\(f\\circ g)(x)&=f(x+1)\\\\(f\\circ g)(x)&=(x+1)^2+2\\\\(f\\circ g)(x)&=x^2+2x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(g\\circ f)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+3$",
          "worked": "$$\\begin{align*}(g\\circ f)(x)&=g(f(x))\\\\(g\\circ f)(x)&=g(x^2+2)\\\\(g\\circ f)(x)&=(x^2+2)+1\\\\(g\\circ f)(x)&=x^2+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(f\\circ f)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+4x^2+6$",
          "worked": "$$\\begin{align*}(f\\circ f)(x)&=f(f(x))\\\\(f\\circ f)(x)&=f(x^2+2)\\\\(f\\circ f)(x)&=(x^2+2)^2+2\\\\(f\\circ f)(x)&=x^4+4x^2+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(g\\circ g)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$",
          "worked": "$$\\begin{align*}(g\\circ g)(x)&=g(g(x))\\\\(g\\circ g)(x)&=g(x+1)\\\\(g\\circ g)(x)&=(x+1)+1\\\\(g\\circ g)(x)&=x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(f\\circ(g\\circ f))(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+6x^2+11$\n\nApply the functions from the innermost outwards.",
          "worked": "$$\\begin{align*}(f\\circ(g\\circ f))(x)&=f(g(f(x)))\\\\(f\\circ(g\\circ f))(x)&=f(g(x^2+2))\\\\(f\\circ(g\\circ f))(x)&=f(x^2+3)\\\\(f\\circ(g\\circ f))(x)&=(x^2+3)^2+2\\\\(f\\circ(g\\circ f))(x)&=x^4+6x^2+11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p22-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(g\\circ(f\\circ g))(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2x+4$\n\nApply the functions from the innermost outwards.",
          "worked": "$$\\begin{align*}(g\\circ(f\\circ g))(x)&=g(f(g(x)))\\\\(g\\circ(f\\circ g))(x)&=g(f(x+1))\\\\(g\\circ(f\\circ g))(x)&=g(x^2+2x+3)\\\\(g\\circ(f\\circ g))(x)&=(x^2+2x+3)+1\\\\(g\\circ(f\\circ g))(x)&=x^2+2x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
