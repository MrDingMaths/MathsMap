    "children": [
      {
        "id": "p7-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the perimeter of the rectangle if $n=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{20}{3}$.",
          "worked": "The rectangle has length $n$ and width $\\frac1n$.\n$$\\begin{align*}P&=2\\left(n+\\frac1n\\right)\\\\P&=2\\left(3+\\frac13\\right)\\\\P&=\\frac{20}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $n$ if the perimeter of the rectangle is $\\frac{37}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=6$.\n\nUse $P=2(n+\\frac{1}{n})$ and retain the positive integer solution.",
          "worked": "$$\\begin{align*}2\\left(n+\\frac1n\\right)&=\\frac{37}{3}\\\\6n^2+6&=37n\\\\6n^2-37n+6&=0\\\\(6n-1)(n-6)&=0\\\\n&=\\frac16\\text{ or }6\\end{align*}$$\nAs $n$ counts strips, it must be a positive integer. Hence $n=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
