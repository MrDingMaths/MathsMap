  "content": {
    "id": "p10-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Suppose that two numbers $x$ and $y$ have sum 4 and product 2.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $x^2+y^2$. Hint: Square both sides of the expression $x+y=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$.",
          "worked": "$$\\begin{align*}(x+y)^2&=4^2\\\\x^2+y^2&=16-2xy\\\\x^2+y^2&=16-2(2)\\\\x^2+y^2&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find $x^3+y^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$.",
          "worked": "$$\\begin{align*}x^3+y^3&=(x+y)(x^2-xy+y^2)\\\\x^3+y^3&=4(12-2)\\\\x^3+y^3&=40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
