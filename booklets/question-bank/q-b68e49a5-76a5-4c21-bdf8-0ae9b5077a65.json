        "id": "p6-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "For a data set, the minimum value is 8 and the range is 27. Find the maximum value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$",
          "worked": "$$\\begin{align*}\\text{Maximum value}&=\\text{minimum value}+\\text{range}\\\\\\text{Maximum value}&=8+27\\\\\\text{Maximum value}&=35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "For a particular data set, the upper quartile is 25.6, and the interquartile range is 11.9. Find the lower quartile.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13.7$",
          "worked": "$$\\begin{align*}Q_1&=Q_3-\\text{IQR}\\\\Q_1&=25.6-11.9\\\\Q_1&=13.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
