    "children": [
      {
        "id": "p51-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Faith made one stop on the journey.\nFor how long did she stop?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 h",
          "worked": "The horizontal segment runs from 11 a.m. to 12 noon, so her stop lasted 1 h.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p51-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find Faith's average speed between 9 a.m. and 3 p.m., including her stop.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40\\text{ km/h}$",
          "worked": "The total elapsed time, including the stop, is 6 h.\n$$\\begin{align*}\\text{Average speed}&=\\frac{\\text{total distance}}{\\text{total time}}\\\\\\text{Average speed}&=\\frac{240\\text{ km}}{6\\text{ h}}\\\\\\text{Average speed}&=40\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "What was Faith's speed between 9 a.m. and 11 a.m.?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{Speed}&=\\frac{\\text{distance travelled}}{\\text{time taken}}\\\\\\text{Speed}&=\\frac{(100-0)\\text{ km}}{2\\text{ h}}\\\\\\text{Speed}&=50\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p51-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "What was Faith's speed between 12 noon and 3 p.m.?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$46.\\dot{6}\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{Speed}&=\\frac{\\text{distance travelled}}{\\text{time taken}}\\\\\\text{Speed}&=\\frac{(240-100)\\text{ km}}{3\\text{ h}}\\\\\\text{Speed}&=\\frac{140}{3}\\text{ km/h}\\\\\\text{Speed}&=46.\\dot{6}\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Find Faith's average speed for the time she was actually driving, not including her stop.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{Driving time}&=6\\text{ h}-1\\text{ h}\\\\\\text{Driving time}&=5\\text{ h}\\\\\\text{Average speed}&=\\frac{\\text{total distance}}{\\text{driving time}}\\\\\\text{Average speed}&=\\frac{240\\text{ km}}{5\\text{ h}}\\\\\\text{Average speed}&=48\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
