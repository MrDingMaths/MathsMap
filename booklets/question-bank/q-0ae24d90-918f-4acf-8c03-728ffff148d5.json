  "content": {
    "id": "p51-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Faith travelled 240 km to visit her father.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p51-q4-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"journeyBlue\",\"hex\":\"268CFF\",\"reason\":\"journey graph series\"}],\"reference\":\"source page 51, p51-q4-graph\"}\n\\begin{tikzpicture}[x=0.85cm,y=0.012cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{journeyBlue}{HTML}{268CFF}\n\\definecolor{gridGrey}{HTML}{CCCCCC}\n\\foreach \\x in {0,1,2,3,4,5,6}{\\draw[gridGrey,dashed,line width=0.25pt] (\\x,0)--(\\x,250);}\n\\foreach \\y in {0,50,100,150,200,250}{\\draw[gridGrey,dashed,line width=0.25pt] (-0.3,\\y)--(6.3,\\y);}\n\\draw[black,line width=0.5pt] (-0.3,0) rectangle (6.3,250);\n\\draw[journeyBlue,line width=0.8pt] (0,0)--(2,100)--(3,100)--(6,240);\n\\foreach \\y in {0,50,100,150,200,250}{\\draw[black,line width=0.4pt] (-0.3,\\y)--(-0.37,\\y);\\node[anchor=east,inner sep=2pt] at (-0.37,\\y) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\y\\special{dvisvgm:raw </g>}};}\n\\foreach \\x/\\lab in {0/{9\\\\a.m.},1/{10\\\\a.m.},2/{11\\\\a.m.},3/{12\\\\noon},4/{1\\\\p.m.},5/{2\\\\p.m.},6/{3\\\\p.m.}}{\\draw[black,line width=0.4pt] (\\x,0)--(\\x,-4);\\node[anchor=north,align=center,inner sep=2pt] at (\\x,-4) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\lab\\special{dvisvgm:raw </g>}};}\n\\node[black,rotate=90,anchor=south] at (-0.95,125) {Distance (km)};\n\\node[black,anchor=north] at (3,-100) {Time};\n\\end{tikzpicture}",
