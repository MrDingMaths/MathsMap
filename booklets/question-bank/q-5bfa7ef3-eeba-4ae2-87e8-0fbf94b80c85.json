        "children": [
          {
            "id": "p39-q9-ken-explain",
            "type": "part",
            "label": "i",
            "prompt": "In the first step, Ken combined $6x$ and $5x$. Why didn’t he also add the $3$ to get $14x$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "3 is not a like term.",
              "worked": "$6x$ and $5x$ are like terms. $3$ is a constant term, so it cannot be combined with the $x$ terms.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p39-q9-ken-solve",
            "type": "part",
            "label": "ii",
            "prompt": "Solve:\n$$-11=-6x-3x-2$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=1$",
              "worked": "$$\\begin{align*}-11&=-9x-2\\\\-9&=-9x\\\\x&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      }
    ]
