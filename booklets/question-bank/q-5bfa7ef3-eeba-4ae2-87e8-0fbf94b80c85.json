          {
            "id": "p38-q9-explain",
            "type": "part",
            "label": "i",
            "prompt": "If Mackenzie wanted to start by getting rid of the $2$ in $2k$, what should she have done differently?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Divide every term by 2, including the 3.",
              "worked": "Divide every term by 2, including the 3: $$\\frac{6}{2}=\\frac{3}{2}+\\frac{2k}{2}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p38-q9-solve",
            "type": "part",
            "label": "ii",
            "prompt": "Solve:\n$$6=-3+2k$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=4.5$",
              "worked": "$$\\begin{align*}\\frac{6}{2}&=\\frac{-3}{2}+\\frac{2k}{2}\\\\3&=-\\frac{3}{2}+k\\\\3+\\frac{3}{2}&=k\\\\k&=\\frac{9}{2}=4.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      },
      {
        "id": "p39-q9-ken-group",
        "type": "group",
        "label": "b",
        "prompt": {
