  "content": {
    "id": "p20-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Using the common logarithm, evaluate each of the following correct to three significant figures:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$1.23\\times2.34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.88$",
          "worked": "Using the common-logarithm table:\n$$\\begin{align*}\\log_{10}(1.23\\times2.34)&=\\log_{10}1.23+\\log_{10}2.34\\\\\\log_{10}(1.23\\times2.34)&\\approx0.0899+0.3692\\\\\\log_{10}(1.23\\times2.34)&\\approx0.4591\\end{align*}$$\nUsing the table in reverse:\n$$1.23\\times2.34\\approx10^{0.4591}\\approx2.88\\quad\\text{(3 significant figures).}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$1.11\\times5.55$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.16$",
          "worked": "Using the common-logarithm table:\n$$\\begin{align*}\\log_{10}(1.11\\times5.55)&=\\log_{10}1.11+\\log_{10}5.55\\\\\\log_{10}(1.11\\times5.55)&\\approx0.0453+0.7443\\\\\\log_{10}(1.11\\times5.55)&\\approx0.7896\\end{align*}$$\nUsing the table in reverse:\n$$1.11\\times5.55\\approx10^{0.7896}\\approx6.16\\quad\\text{(3 significant figures).}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$2.46\\times3.57$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.78$",
          "worked": "Using the common-logarithm table:\n$$\\begin{align*}\\log_{10}(2.46\\times3.57)&=\\log_{10}2.46+\\log_{10}3.57\\\\\\log_{10}(2.46\\times3.57)&\\approx0.3909+0.5527\\\\\\log_{10}(2.46\\times3.57)&\\approx0.9436\\end{align*}$$\nUsing the table in reverse:\n$$2.46\\times3.57\\approx10^{0.9436}\\approx8.78\\quad\\text{(3 significant figures).}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$4.15\\times2.17$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9.01$",
          "worked": "Using the common-logarithm table:\n$$\\begin{align*}\\log_{10}(4.15\\times2.17)&=\\log_{10}4.15+\\log_{10}2.17\\\\\\log_{10}(4.15\\times2.17)&\\approx0.6180+0.3365\\\\\\log_{10}(4.15\\times2.17)&\\approx0.9545\\end{align*}$$\nUsing the table in reverse:\n$$4.15\\times2.17\\approx10^{0.9545}\\approx9.01\\quad\\text{(3 significant figures).}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
