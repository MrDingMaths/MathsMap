  "content": {
    "id": "p19-q48-root",
    "type": "question",
    "label": null,
    "prompt": "The graph of $f(x)=\\dfrac{1}{1+2^x}$ was reflected in the $y$-axis to produce the graph of $g(x)$.\n\nShow that $f(x)+g(x)=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p19-q48-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "f(x)+g(x)=\\frac{1+2^x}{1+2^x}=1",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p19-q48-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Use ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "g(x)=f(-x)=\\frac{2^x}{1+2^x}",
                "display": false
              },
              {
                "type": "text",
                "text": ", then add the fractions.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "For a reflection in the $y$-axis, replace $x$ by $-x$:\n$$\\begin{align*}g(x)&=f(-x)\\\\g(x)&=\\frac{1}{1+2^{-x}}\\\\g(x)&=\\frac{2^x}{2^x+1}\\end{align*}$$\nHence,\n$$\\begin{align*}f(x)+g(x)&=\\frac{1}{1+2^x}+\\frac{2^x}{1+2^x}\\\\f(x)+g(x)&=1\\end{align*}$$",
      "solutionDiagrams": []
    },
