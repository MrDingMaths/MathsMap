  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Kat has six different balls. She chooses four of these balls, and then allocates these to two different buckets. How many ways can this be done?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$240$ ways.",
      "worked": "The four balls can be chosen in $\\binom{6}{4}$ ways. Each chosen ball has two choices of bucket, giving $2^4$ allocations for each selection.\n\n$$\\begin{align*}N&=\\binom{6}{4}\\times2^4\\\\N&=15\\times16\\\\N&=240.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
