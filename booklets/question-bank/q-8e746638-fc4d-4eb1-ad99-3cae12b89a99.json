  "content": {
    "id": "p13-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Given that $x-y=8\\sqrt{2}$ and $xy=137$, where $x$ and $y$ are both positive, find the value of $x+y$ without finding $x$ or $y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$26$\n\nUse $(x+y)^2=(x-y)^2+4xy$ and take the positive square root.",
      "worked": "$$\\begin{align*}(x+y)^2&=x^2+2xy+y^2\\\\(x+y)^2&=(x-y)^2+4xy\\\\(x+y)^2&=(8\\sqrt{2})^2+4(137)\\\\(x+y)^2&=128+548\\\\(x+y)^2&=676\\end{align*}$$\nSince $x$ and $y$ are positive, $x+y>0$, so $x+y=\\sqrt{676}=26$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
