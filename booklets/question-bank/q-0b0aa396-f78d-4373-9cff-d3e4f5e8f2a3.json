    "type": "question",
    "label": "21",
    "prompt": "Find the value of $x$ if $2^x$ is half of $2^{100}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=99$.",
      "worked": "$$\\begin{align*}2^x&=\\frac{2^{100}}{2}\\\\2^x&=2^{100-1}\\\\2^x&=2^{99}\\\\x&=99\\end{align*}$$",
