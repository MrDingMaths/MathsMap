        "children": [],
        "answer": {
          "short": "$200$",
          "worked": "$$\\begin{align*}33\\frac{1}{3}\\%\\text{ of }120&=120\\div3=40\\\\66\\frac{2}{3}\\%\\text{ of }120&=40\\times2=80\\\\166\\frac{2}{3}\\%\\text{ of }120&=120+80=200\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
