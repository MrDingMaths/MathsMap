        "id": "p25-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$75\\%$ of $4.4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.3$",
          "worked": "$$\\begin{align*}50\\%\\text{ of }4.4&=4.4\\div2=2.2\\\\25\\%\\text{ of }4.4&=2.2\\div2=1.1\\\\75\\%\\text{ of }4.4&=2.2+1.1=3.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$49\\%$ of $180$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$88.2$",
          "worked": "$$\\begin{align*}50\\%\\text{ of }180&=180\\div2=90\\\\1\\%\\text{ of }180&=180\\div100=1.8\\\\49\\%\\text{ of }180&=90-1.8=88.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$110\\%$ of $6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.6$",
          "worked": "$$\\begin{align*}10\\%\\text{ of }6&=6\\div10=0.6\\\\110\\%\\text{ of }6&=6+0.6=6.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p25-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$150\\%$ of $50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75$",
          "worked": "$$\\begin{align*}50\\%\\text{ of }50&=50\\div2=25\\\\150\\%\\text{ of }50&=50+25=75\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p25-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$200\\%$ of $30$",
