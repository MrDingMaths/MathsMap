        "children": [],
        "answer": {
          "short": "$60$",
          "worked": "$$200\\%\\text{ of }30=30\\times2=60$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p25-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$120\\%$ of $90$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$108$",
          "worked": "$$\\begin{align*}20\\%\\text{ of }90&=90\\div5=18\\\\120\\%\\text{ of }90&=90+18=108\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
