    "children": [
      {
        "id": "p24-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Using the change of base law, show that $\\log_a b=\\frac{1}{\\log_b a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a b=\\frac{\\log_b b}{\\log_b a}=\\frac{1}{\\log_b a}$, for $a,b>0$ and $a,b\\ne1$.",
          "worked": "For $a,b>0$ and $a,b\\ne1$,\n$$\\begin{align*}\\log_a b&=\\frac{\\log_b b}{\\log_b a}\\\\\\log_a b&=\\frac{1}{\\log_b a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the value of $\\log_{\\sqrt{27}}(3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "Using part a and $\\sqrt{27}=3^{\\frac{3}{2}}$,\n$$\\begin{align*}\\log_{\\sqrt{27}}(3)&=\\frac{1}{\\log_3\\sqrt{27}}\\\\\\log_{\\sqrt{27}}(3)&=\\frac{1}{\\left(\\frac32\\right)}\\\\\\log_{\\sqrt{27}}(3)&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
