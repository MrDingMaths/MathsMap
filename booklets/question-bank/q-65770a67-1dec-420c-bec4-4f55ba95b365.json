  "content": {
    "id": "p29-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "The surface area of a cylinder of radius $2\\text{ cm}$ is $20\\pi\\text{ cm}^2$. Find the height of the cylinder.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\text{ cm}$",
      "worked": "$$\\begin{align*}2\\pi r^2+2\\pi rh&=20\\pi\\\\2\\pi(2)^2+2\\pi(2)h&=20\\pi\\\\8+4h&=20\\\\4h&=12\\\\h&=3\\end{align*}$$\nThe height is $3\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
