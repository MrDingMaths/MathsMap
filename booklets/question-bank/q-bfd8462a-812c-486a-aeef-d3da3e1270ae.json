    "type": "question",
    "label": "10",
    "prompt": "At a supermarket, 250 g of chocolate costs $\\$4.50$, while the price is $\\$12$ for 1 kg 50 g of the same chocolate. Which is the more economical option?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
