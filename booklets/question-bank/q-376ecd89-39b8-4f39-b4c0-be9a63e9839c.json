      {
        "id": "p33-q7a",
        "type": "part",
        "label": "a",
        "prompt": "Express $\\dfrac{4}{x}+\\dfrac{8}{5x}$ as a single fraction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{28}{5x}$",
          "worked": "$$\\begin{align*}\\frac{4}{x}+\\frac{8}{5x}&=\\frac{20}{5x}+\\frac{8}{5x}\\\\\\frac{4}{x}+\\frac{8}{5x}&=\\frac{20+8}{5x}\\\\\\frac{4}{x}+\\frac{8}{5x}&=\\frac{28}{5x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-q7b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equation $\\dfrac{4}{x}+\\dfrac{8}{5x}=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{28}{5}$",
          "worked": "Using part a, and multiplying both sides by $5x$ ($x\\ne0$):\n$$\\begin{align*}\\frac{28}{5x}&=1\\\\28&=5x\\\\\\frac{28}{5}&=x\\\\x&=\\frac{28}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
