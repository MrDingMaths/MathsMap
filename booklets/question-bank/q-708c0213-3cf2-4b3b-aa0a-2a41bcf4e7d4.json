  "content": {
    "id": "p51-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "When the polynomial $x^4+x^2+1$ is divided by $x^2+a$, the remainder is $3$. Find the possible values of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=2$ or $a=-1$.",
      "worked": "The division transformation identity gives\n$$\\begin{align*}x^4+x^2+1&=(x^2+a)(x^2+1-a)+(a^2-a+1).\n\\end{align*}$$\nThe remainder is $3$, so\n$$\\begin{align*}a^2-a+1&=3\\\\a^2-a-2&=0\\\\(a-2)(a+1)&=0\\\\a&=2\\text{ or }a=-1.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
