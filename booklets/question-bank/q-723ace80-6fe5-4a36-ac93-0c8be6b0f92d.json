  "content": {
    "id": "p39-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "For $m=3$ and $n=7$, find the value of:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{6m+n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\sqrt{6m+n}&=\\sqrt{6(3)+7}\\\\\\sqrt{6m+n}&=\\sqrt{25}\\\\\\sqrt{6m+n}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p39-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{10(m+n)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\sqrt{10(m+n)}&=\\sqrt{10(3+7)}\\\\\\sqrt{10(m+n)}&=\\sqrt{10(10)}\\\\\\sqrt{10(m+n)}&=\\sqrt{100}\\\\\\sqrt{10(m+n)}&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p39-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{4(n-m)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\sqrt{4(n-m)}&=\\sqrt{4(7-3)}\\\\\\sqrt{4(n-m)}&=\\sqrt{4(4)}\\\\\\sqrt{4(n-m)}&=\\sqrt{16}\\\\\\sqrt{4(n-m)}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p39-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{7m+4n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\sqrt{7m+4n}&=\\sqrt{7(3)+4(7)}\\\\\\sqrt{7m+4n}&=\\sqrt{21+28}\\\\\\sqrt{7m+4n}&=\\sqrt{49}\\\\\\sqrt{7m+4n}&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
