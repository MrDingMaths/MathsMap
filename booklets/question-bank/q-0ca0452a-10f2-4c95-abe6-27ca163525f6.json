  "content": {
    "id": "p54-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "The lengths jumped by Year 8 long-jump competitors follow a normal distribution with a mean of 432 cm and a standard deviation of 14 cm.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q19-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the probability that a competitor jumps. Use the standard normal table, rounding z-scores to 2 decimal places and giving probabilities to 4 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q19-a-i",
            "type": "part",
            "label": "i",
            "prompt": "more than 445 cm",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.1762$",
              "worked": "Let $X$ be the jump length in centimetres.\n$$\\begin{align*}z&=\\frac{445-432}{14}\\\\&=\\frac{13}{14}\\\\&\\approx0.93\\\\P(X>445)&\\approx P(Z>0.93)\\\\&=1-P(Z\\le0.93)\\\\&=1-0.8238\\\\&=0.1762\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p54-q19-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "at least 410 cm",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.9418$",
              "worked": "$$\\begin{align*}z&=\\frac{410-432}{14}\\\\&=-\\frac{11}{7}\\\\&\\approx-1.57\\\\P(X\\ge410)&\\approx P(Z\\ge-1.57)\\\\&=P(Z\\le1.57)\\\\&=0.9418\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p54-q19-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "between 420 cm and 458 cm.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.7737$",
              "worked": "$$\\begin{align*}z_{420}&=\\frac{420-432}{14}\\\\&=-\\frac67\\approx-0.86\\\\z_{458}&=\\frac{458-432}{14}\\\\&=\\frac{13}{7}\\approx1.86\\\\P(420<X<458)&\\approx P(-0.86<Z<1.86)\\\\&=P(Z\\le1.86)-P(Z\\le-0.86)\\\\&=0.9686-(1-0.8051)\\\\&=0.7737\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p54-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "A competitor jumps 486 cm. Is this unusual?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. The jump is nearly four standard deviations above the mean, so it is unusual.",
          "worked": "$$\\begin{align*}z&=\\frac{486-432}{14}\\\\&=\\frac{27}{7}\\\\&\\approx3.86\\end{align*}$$\nYes. A jump of 486 cm is nearly four standard deviations above the mean. The probability of a jump this large or larger is very small.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
