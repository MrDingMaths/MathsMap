  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Katsu has earned marks of 88, 94, 92 and 98 on maths tests so far. What must his next mark be in order for his average mark to be 80?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "28 marks",
      "worked": "Let $x$ be Katsu’s mark in the fifth test.\n\n$$\\begin{align*}\\frac{x+88+94+92+98}{5}&=80\\\\\\frac{x+372}{5}&=80\\\\x+372&=400\\\\x&=28\\end{align*}$$\n\nKatsu’s next mark must be 28.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
