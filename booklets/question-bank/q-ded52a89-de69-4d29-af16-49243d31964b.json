        "type": "part",
        "label": "a",
        "prompt": "$\\cos x\\cos y-\\sin x\\sin y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos(x+y)$",
          "worked": "$$\\begin{aligned}\\cos x\\cos y-\\sin x\\sin y&=\\cos(x+y)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p5-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin3\\alpha\\cos2\\beta+\\cos3\\alpha\\sin2\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin(3\\alpha+2\\beta)$",
          "worked": "$$\\begin{aligned}\\sin3\\alpha\\cos2\\beta+\\cos3\\alpha\\sin2\\beta&=\\sin(3\\alpha+2\\beta)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p5-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\tan40^\\circ-\\tan20^\\circ}{1+\\tan40^\\circ\\tan20^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan20^\\circ$",
          "worked": "$$\\begin{aligned}\\frac{\\tan40^\\circ-\\tan20^\\circ}{1+\\tan40^\\circ\\tan20^\\circ}&=\\tan(40^\\circ-20^\\circ)\\\\&=\\tan20^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin5A\\cos2A-\\cos5A\\sin2A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin3A$",
          "worked": "$$\\begin{aligned}\\sin5A\\cos2A-\\cos5A\\sin2A&=\\sin(5A-2A)\\\\&=\\sin3A\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p5-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos70^\\circ\\cos20^\\circ+\\sin70^\\circ\\sin20^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos50^\\circ$",
          "worked": "$$\\begin{aligned}\\cos70^\\circ\\cos20^\\circ+\\sin70^\\circ\\sin20^\\circ&=\\cos(70^\\circ-20^\\circ)\\\\&=\\cos50^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p5-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\tan\\alpha+\\tan10^\\circ}{1-\\tan\\alpha\\tan10^\\circ}$",
