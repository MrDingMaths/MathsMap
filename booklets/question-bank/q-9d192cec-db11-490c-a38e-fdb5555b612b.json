  "content": {
    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Expand these differences of two squares.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+\\sqrt{7})(x-\\sqrt{7})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-7$",
          "worked": "Use $a=x$ and $b=\\sqrt{7}$.\n$$\\begin{align*}(x+\\sqrt{7})(x-\\sqrt{7})&=x^2-(\\sqrt{7})^2\\\\&=x^2-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-\\sqrt{5})(x+\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-5$",
          "worked": "Use $a=x$ and $b=\\sqrt{5}$.\n$$\\begin{align*}(x-\\sqrt{5})(x+\\sqrt{5})&=x^2-(\\sqrt{5})^2\\\\&=x^2-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3x+\\sqrt{17})(3x-\\sqrt{17})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-17$",
          "worked": "Use $a=3x$ and $b=\\sqrt{17}$.\n$$\\begin{align*}(3x+\\sqrt{17})(3x-\\sqrt{17})&=(3x)^2-(\\sqrt{17})^2\\\\&=9x^2-17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x^2+\\sqrt{21})(x^2-\\sqrt{21})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-21$",
          "worked": "Use $a=x^2$ and $b=\\sqrt{21}$.\n$$\\begin{align*}(x^2+\\sqrt{21})(x^2-\\sqrt{21})&=(x^2)^2-(\\sqrt{21})^2\\\\&=x^4-21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2x^3-\\sqrt{10})(2x^3+\\sqrt{10})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^6-10$",
          "worked": "Use $a=2x^3$ and $b=\\sqrt{10}$.\n$$\\begin{align*}(2x^3-\\sqrt{10})(2x^3+\\sqrt{10})&=(2x^3)^2-(\\sqrt{10})^2\\\\&=4x^6-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sqrt{6}+3x)(\\sqrt{6}-3x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6-9x^2$",
          "worked": "Use $a=\\sqrt{6}$ and $b=3x$.\n$$\\begin{align*}(\\sqrt{6}+3x)(\\sqrt{6}-3x)&=(\\sqrt{6})^2-(3x)^2\\\\&=6-9x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
