        "children": [],
        "answer": {
          "short": "Row 1: arc length $\\frac{7\\pi}{2}$ cm; angle $\\frac{\\pi}{4}$ radians.",
          "worked": "$$\\begin{align*}\\theta&=45\\times\\frac{\\pi}{180}\\\\\\theta&=\\frac{\\pi}{4}\\text{ radians}\\end{align*}$$\n$$\\begin{align*}l&=r\\theta\\\\l&=14\\times\\frac{\\pi}{4}\\\\l&=\\frac{7\\pi}{2}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p6-q1-row2",
        "type": "part",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Row 2: angle $30^\\circ$; radius $\\frac{60}{\\pi}$ cm.",
          "worked": "$$\\begin{align*}\\text{Angle in degrees}&=\\frac{\\pi}{6}\\times\\frac{180}{\\pi}\\\\\\text{Angle in degrees}&=30^\\circ\\end{align*}$$\n$$\\begin{align*}r&=\\frac{l}{\\theta}\\\\r&=\\frac{10}{\\frac{\\pi}{6}}\\\\r&=\\frac{60}{\\pi}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p6-q1-row3",
        "type": "part",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Row 3: angle $\\frac{2}{5}$ radians, or $22^\\circ55'$ to the nearest minute.",
          "worked": "$$\\begin{align*}\\theta&=\\frac{l}{r}\\\\\\theta&=\\frac{8}{20}\\\\\\theta&=\\frac{2}{5}\\text{ radians}\\end{align*}$$\n$$\\begin{align*}\\text{Angle in degrees}&=\\frac{2}{5}\\times\\frac{180}{\\pi}\\\\\\text{Angle in degrees}&=\\frac{72}{\\pi}\\text{ degrees}\\\\\\text{Angle in degrees}&\\approx22.9183^\\circ\\end{align*}$$\nThe fractional degree gives $(\\frac{72}{\\pi}-22)\\times60\\approx55.0987$ minutes, so the angle is $22^\\circ55'$ to the nearest minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p6-q1-row4",
        "type": "part",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Row 4: arc length $9\\pi$ cm; angle $135^\\circ$.",
          "worked": "$$\\begin{align*}l&=r\\theta\\\\l&=12\\times\\frac{3\\pi}{4}\\\\l&=9\\pi\\text{ cm}\\end{align*}$$\n$$\\begin{align*}\\text{Angle in degrees}&=\\frac{3\\pi}{4}\\times\\frac{180}{\\pi}\\\\\\text{Angle in degrees}&=135^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
