                      {
                        "type": "math",
                        "latex": "\\begin{aligned}u&=\\sqrt{x-1}\\\\u^2&=x-1\\\\x&=u^2+1\\\\2x&=2(u^2+1)\\\\\\frac{dx}{du}&=2u\\\\dx&=2u\\,du\\end{aligned}",
