                      {
                        "type": "math",
                        "latex": "\\begin{aligned}\\int\\frac{1}{2x\\sqrt{x-1}}\\,dx&=\\int\\frac{2u}{2(u^2+1)u}\\,du\\\\&=\\int\\frac{1}{u^2+1}\\,du\\\\&=\\tan^{-1}u+C\\\\&=\\tan^{-1}\\sqrt{x-1}+C\\end{aligned}",
                        "display": true
                      }
                    ]
