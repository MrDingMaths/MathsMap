    "label": "8",
    "prompt": "Find the indefinite integrals.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\int \\sqrt{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}x^{3/2}+C$",
          "worked": "$$\\begin{align*}\\int \\sqrt{x}\\,dx&=\\int x^{1/2}\\,dx\\\\&=\\frac{x^{3/2}}{3/2}+C\\\\&=\\frac{2}{3}x^{3/2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\int \\sqrt[3]{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{4}x^{4/3}+C$",
          "worked": "$$\\begin{align*}\\int \\sqrt[3]{x}\\,dx&=\\int x^{1/3}\\,dx\\\\&=\\frac{x^{4/3}}{4/3}+C\\\\&=\\frac{3}{4}x^{4/3}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\int \\frac{1}{\\sqrt{x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{x}+C$",
          "worked": "$$\\begin{align*}\\int \\frac{1}{\\sqrt{x}}\\,dx&=\\int x^{-1/2}\\,dx\\\\&=\\frac{x^{1/2}}{1/2}+C\\\\&=2\\sqrt{x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\int \\sqrt[3]{x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}x^{5/3}+C$",
          "worked": "$$\\begin{align*}\\int \\sqrt[3]{x^2}\\,dx&=\\int x^{2/3}\\,dx\\\\&=\\frac{x^{5/3}}{5/3}+C\\\\&=\\frac{3}{5}x^{5/3}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
