  "content": {
    "id": "p37-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Calculate the monthly rate of pay.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "\\$24/h for a 16-hour week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1664/month",
          "worked": "$$\\begin{align*}\\text{Weekly pay} &= \\$24\\times16\\\\\\text{Weekly pay} &= \\$384\\\\\\text{Annual pay} &= \\$384\\times52=\\$19\\,968\\\\\\text{Monthly pay} &= \\frac{\\$19\\,968}{12}=\\$1664\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p37-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "\\$48/h for a 38-hour week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$7904/month",
          "worked": "$$\\begin{align*}\\text{Weekly pay} &= \\$48\\times38\\\\\\text{Weekly pay} &= \\$1824\\\\\\text{Annual pay} &= \\$1824\\times52=\\$94\\,848\\\\\\text{Monthly pay} &= \\frac{\\$94\\,848}{12}=\\$7904\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
