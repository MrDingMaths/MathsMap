              "type": "text",
              "text": "Chocolate contains cocoa and sugar.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "In milk chocolate, 20% of the mass is cocoa and 55% is sugar.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the mass of cocoa in a chocolate bar weighing 250 g?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\text{ g}$",
          "worked": "$$\\begin{align*}\\text{Mass of cocoa}&=\\frac{20}{100}\\times250\\text{ g}\\\\&=50\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p54-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "A bar of milk chocolate contains 50 g of cocoa. How many grams of sugar does it have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$137.5\\text{ g}$",
          "worked": "$$\\begin{align*}20\\%\\text{ of the bar}&=50\\text{ g}\\\\1\\%\\text{ of the bar}&=50\\div20\\text{ g}=2.5\\text{ g}\\\\55\\%\\text{ of the bar}&=2.5\\times55\\text{ g}=137.5\\text{ g}\\end{align*}$$\nThe bar contains 137.5 g of sugar.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p54-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "What fraction of the bar is neither cocoa nor sugar?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\text{Remaining percentage}&=100\\%-20\\%-55\\%\\\\&=25\\%\\\\\\text{Remaining fraction}&=\\frac{25}{100}=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p54-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the ratio of sugar to cocoa in a bar of chocolate, in simplest form?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11:4$",
          "worked": "$$\\begin{align*}\\text{Sugar}:\\text{cocoa}&=55:20\\\\&=11:4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
