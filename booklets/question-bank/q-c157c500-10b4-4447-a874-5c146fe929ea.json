  "content": {
    "id": "v2-a15da-p29-practice-slot-15-root",
    "type": "question",
    "label": null,
    "prompt": "The time a barista takes to make a coffee has a mean of 90 seconds and a standard deviation of 10 seconds. The times are normally distributed.\n\nWhat percentage of coffees take:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a15da-p29-practice-slot-15-slot-15-q-a",
        "type": "part",
        "label": "a",
        "prompt": "between 80 and 100 seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$68\\%$",
          "worked": "$$\\begin{aligned}80&=90-10\\\\100&=90+10\\end{aligned}$$\nThe interval is within one standard deviation of the mean, so approximately $68\\%$ of coffees lie in it.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-a15da-p29-practice-slot-15-slot-15-q-b",
        "type": "part",
        "label": "b",
        "prompt": "between 60 and 120 seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$99.7\\%$",
          "worked": "$$\\begin{aligned}60&=90-3\\times10\\\\120&=90+3\\times10\\end{aligned}$$\nThe interval is within three standard deviations of the mean, so approximately $99.7\\%$ of coffees lie in it.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-a15da-p29-practice-slot-15-slot-15-q-c",
        "type": "part",
        "label": "c",
        "prompt": "between 70 and 110 seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$95\\%$",
          "worked": "$$\\begin{aligned}70&=90-2\\times10\\\\110&=90+2\\times10\\end{aligned}$$\nThe interval is within two standard deviations of the mean, so approximately $95\\%$ of coffees lie in it.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-a15da-p29-practice-slot-15-slot-15-q-d",
        "type": "part",
        "label": "d",
        "prompt": "more than 90 seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\%$",
          "worked": "The normal distribution is symmetric about its mean of 90 seconds. Half the coffees therefore take more than 90 seconds: $50\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
