  "content": {
    "id": "p35-q4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the magnitude and direction of each vector. Give your answers in exact form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=2i+2j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{2},\\ 45^\\circ$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{a}|&=\\sqrt{2^2+2^2}\\\\&=2\\sqrt{2}\\\\A&=\\tan^{-1}\\left(\\frac{2}{2}\\right)\\\\&=45^\\circ\\end{aligned}$$\nThe vector is in quadrant I, so its angle of inclination is $45^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p35-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{b}=\\begin{pmatrix}1\\\\-\\sqrt{3}\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2,\\ 300^\\circ$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{b}|&=\\sqrt{1^2+(-\\sqrt{3})^2}\\\\&=2\\\\A&=\\tan^{-1}\\left(\\frac{\\sqrt{3}}{1}\\right)\\\\&=60^\\circ\\end{aligned}$$\nThe vector is in quadrant IV.\n$$\\begin{aligned}\\theta&=360^\\circ-60^\\circ\\\\&=300^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p35-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{c}=-3\\sqrt{3}i+3j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6,\\ 150^\\circ$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{c}|&=\\sqrt{(-3\\sqrt{3})^2+3^2}\\\\&=6\\\\A&=\\tan^{-1}\\left(\\frac{3}{3\\sqrt{3}}\\right)\\\\&=30^\\circ\\end{aligned}$$\nThe vector is in quadrant II.\n$$\\begin{aligned}\\theta&=180^\\circ-30^\\circ\\\\&=150^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p35-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\underset{\\sim}{d}=\\begin{pmatrix}-\\sqrt{6}\\\\-\\sqrt{6}\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{3},\\ 225^\\circ$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{d}|&=\\sqrt{(-\\sqrt{6})^2+(-\\sqrt{6})^2}\\\\&=2\\sqrt{3}\\\\A&=\\tan^{-1}\\left(\\frac{\\sqrt{6}}{\\sqrt{6}}\\right)\\\\&=45^\\circ\\end{aligned}$$\nThe vector is in quadrant III.\n$$\\begin{aligned}\\theta&=180^\\circ+45^\\circ\\\\&=225^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
