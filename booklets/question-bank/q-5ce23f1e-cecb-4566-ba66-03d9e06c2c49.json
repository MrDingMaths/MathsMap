  "content": {
    "id": "p24-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "4 workers can resurface a road in 6 hours.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How long would it take to resurface the same road if 6 people worked together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 hours",
          "worked": "Let $N$ be the number of workers and $t$ the time in hours. For the same road, $N$ varies inversely with $t$.\n$$\\begin{aligned}N&=\\frac{k}{t}\\\\4&=\\frac{k}{6}\\\\k&=24\\\\N&=\\frac{24}{t}\\\\6&=\\frac{24}{t}\\\\6t&=24\\\\t&=4\\end{aligned}$$\nIt would take 4 hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p24-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How many workers are needed if the road is to be resurfaced in 3 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8 workers",
          "worked": "Let $N$ be the number of workers and $t$ the time in hours. For the same road, $N$ varies inversely with $t$.\n$$\\begin{aligned}N&=\\frac{k}{t}\\\\4&=\\frac{k}{6}\\\\k&=24\\\\N&=\\frac{24}{t}\\\\N&=\\frac{24}{3}\\\\N&=8\\end{aligned}$$\n8 workers are needed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
