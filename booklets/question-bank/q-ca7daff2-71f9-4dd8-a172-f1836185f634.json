  "content": {
    "id": "p34-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A parabola has $x$-intercepts of $-5$ and $3$ and passes through the point $(1,-12)$. Find its equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=x^2+2x-15$",
      "worked": "The intercepts give factors $x+5$ and $x-3$, so write $y=a(x+5)(x-3)$. Substitute $(1,-12)$:\n$$\\begin{align*}-12&=a(1+5)(1-3)\\\\-12&=-12a\\\\a&=1\\end{align*}$$\nHence,\n$$\\begin{align*}y&=(x+5)(x-3)\\\\y&=x^2+2x-15\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
