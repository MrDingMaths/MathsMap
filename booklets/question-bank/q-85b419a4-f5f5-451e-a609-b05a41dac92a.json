  "content": {
    "id": "p20-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the general term in the expansion of $\\left(\\frac{x}{2}-\\frac{5}{x}\\right)^{15}$ is $\\binom{15}{j}(-1)^j5^j2^{j-15}x^{15-2j}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{15}{j}(-1)^j5^j2^{j-15}x^{15-2j}$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\binom{15}{j}\\left(\\frac{x}{2}\\right)^{15-j}\\left(-\\frac{5}{x}\\right)^j\\\\&=\\binom{15}{j}x^{15-j}2^{-(15-j)}(-5)^jx^{-j}\\\\&=\\binom{15}{j}(-1)^j5^j2^{j-15}x^{15-2j}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p20-q18-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence find, without simplifying, the coefficients of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q18-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x^{11}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\binom{15}{2}\\times5^2\\times2^{-13}$",
              "worked": "$$\\begin{aligned}15-2j&=11\\\\j&=2.\\end{aligned}$$\nThe coefficient is $\\binom{15}{2}(-1)^2 5^2 2^{2-15}=\\binom{15}{2}\\times5^2\\times2^{-13}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p20-q18-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\binom{15}{7}\\times5^7\\times2^{-8}$",
              "worked": "$$\\begin{aligned}15-2j&=1\\\\j&=7.\\end{aligned}$$\nThe coefficient is $\\binom{15}{7}(-1)^7 5^7 2^{7-15}=-\\binom{15}{7}\\times5^7\\times2^{-8}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p20-q18-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$x^{-5}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\binom{15}{10}\\times5^{10}\\times2^{-5}$",
              "worked": "$$\\begin{aligned}15-2j&=-5\\\\j&=10.\\end{aligned}$$\nThe coefficient is $\\binom{15}{10}(-1)^{10}5^{10}2^{10-15}=\\binom{15}{10}\\times5^{10}\\times2^{-5}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
  },
