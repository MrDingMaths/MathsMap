  "content": {
    "id": "p39-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "It cost the owners of the Corner Newsagency $\\$3500000$ to run their business last year. They recorded a profit of 4.5%.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "What was their profit last year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$157500$",
          "worked": "$$\\begin{align*}\\text{Profit}&=3500000\\times4.5\\%\\\\\\text{Profit}&=3500000\\times0.045\\\\\\text{Profit}&=\\$157500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p39-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "What was the total of their sales?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$3657500$",
          "worked": "$$\\begin{align*}\\text{Total sales}&=\\text{total costs}+\\text{profit}\\\\\\text{Total sales}&=3500000+157500\\\\\\text{Total sales}&=\\$3657500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p39-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "In the previous year, their costs were $\\$2750000$ and their sales were only $\\$2635000$. What percentage loss did they make on their costs? Round to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.2\\%$",
          "worked": "$$\\begin{align*}\\text{Loss}&=2750000-2635000\\\\\\text{Loss}&=\\$115000\\\\\\text{Percentage loss}&=\\frac{115000}{2750000}\\times100\\%\\\\\\text{Percentage loss}&\\approx4.2\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
