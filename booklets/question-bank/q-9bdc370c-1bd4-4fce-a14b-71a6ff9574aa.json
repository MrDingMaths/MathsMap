    "type": "question",
    "label": "19",
    "prompt": "Jim receives holiday loading of 17.5% of 4 weeks’ pay.\nHis loading was \\$996.80.\nFind his normal hourly pay if he works 40 hours a week.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$35.60/h.",
      "worked": "$$\\begin{align*}\\text{4 weeks’ normal pay}&=996.80\\div0.175=\\$5696\\\\\\text{Weekly pay}&=5696\\div4=\\$1424\\\\\\text{Hourly pay}&=1424\\div40=\\$35.60\\text{/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
