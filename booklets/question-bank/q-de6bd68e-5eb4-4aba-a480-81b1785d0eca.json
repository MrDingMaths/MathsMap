  "content": {
    "id": "p15-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Rearrange these equations to make $a$ the subject.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(a+b)^2=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-b\\pm\\sqrt{\\frac{c}{2}}$",
          "worked": "$$\\begin{align*}2(a+b)^2&=c\\\\(a+b)^2&=\\frac{c}{2}\\\\a+b&=\\pm\\sqrt{\\frac{c}{2}}\\\\a&=-b\\pm\\sqrt{\\frac{c}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$2(a-2b)^2+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2b\\pm\\sqrt{\\frac{c-b}{2}}$",
          "worked": "$$\\begin{align*}2(a-2b)^2+b&=c\\\\2(a-2b)^2&=c-b\\\\(a-2b)^2&=\\frac{c-b}{2}\\\\a-2b&=\\pm\\sqrt{\\frac{c-b}{2}}\\\\a&=2b\\pm\\sqrt{\\frac{c-b}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$2(3a-bc)^2-b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{bc\\pm\\sqrt{\\frac{c+b}{2}}}{3}$",
          "worked": "$$\\begin{align*}2(3a-bc)^2-b&=c\\\\2(3a-bc)^2&=c+b\\\\(3a-bc)^2&=\\frac{c+b}{2}\\\\3a-bc&=\\pm\\sqrt{\\frac{c+b}{2}}\\\\3a&=bc\\pm\\sqrt{\\frac{c+b}{2}}\\\\a&=\\frac{bc\\pm\\sqrt{\\frac{c+b}{2}}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p15-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$4(a+def)^2-b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm\\sqrt{\\frac{c+b}{4}}-def$",
          "worked": "$$\\begin{align*}4(a+def)^2-b&=c\\\\4(a+def)^2&=c+b\\\\(a+def)^2&=\\frac{c+b}{4}\\\\a+def&=\\pm\\sqrt{\\frac{c+b}{4}}\\\\a&=\\pm\\sqrt{\\frac{c+b}{4}}-def\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "$m(a-de^3)^2-b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=de^3\\pm\\sqrt{\\frac{c+b}{m}}$",
          "worked": "$$\\begin{align*}m(a-de^3)^2-b&=c\\\\m(a-de^3)^2&=c+b\\\\(a-de^3)^2&=\\frac{c+b}{m}\\\\a-de^3&=\\pm\\sqrt{\\frac{c+b}{m}}\\\\a&=de^3\\pm\\sqrt{\\frac{c+b}{m}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q15-f",
        "type": "part",
        "label": "f",
        "prompt": "$p(a+m)^3-yb=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\sqrt[3]{\\frac{c+yb}{p}}-m$",
          "worked": "$$\\begin{align*}p(a+m)^3-yb&=c\\\\p(a+m)^3&=c+yb\\\\(a+m)^3&=\\frac{c+yb}{p}\\\\a+m&=\\sqrt[3]{\\frac{c+yb}{p}}\\\\a&=\\sqrt[3]{\\frac{c+yb}{p}}-m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q15-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{\\sqrt{a+b}}{2}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4c^2-b$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{a+b}}{2}&=c\\\\\\sqrt{a+b}&=2c\\\\a+b&=4c^2\\\\a&=4c^2-b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p15-q15-h",
        "type": "part",
        "label": "h",
        "prompt": "$2\\sqrt{a-de}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{c^2}{4}+de$",
          "worked": "$$\\begin{align*}2\\sqrt{a-de}&=c\\\\\\sqrt{a-de}&=\\frac{c}{2}\\\\a-de&=\\frac{c^2}{4}\\\\a&=\\frac{c^2}{4}+de\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q15-i",
        "type": "part",
        "label": "i",
        "prompt": "$2\\sqrt{a-gh}+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\left(\\frac{c-b}{2}\\right)^2+gh$",
          "worked": "$$\\begin{align*}2\\sqrt{a-gh}+b&=c\\\\2\\sqrt{a-gh}&=c-b\\\\\\sqrt{a-gh}&=\\frac{c-b}{2}\\\\a-gh&=\\left(\\frac{c-b}{2}\\right)^2\\\\a&=\\left(\\frac{c-b}{2}\\right)^2+gh\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q15-j",
        "type": "part",
        "label": "j",
        "prompt": "$2\\sqrt{3a-4}+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{\\left(\\frac{c-b}{2}\\right)^2+4}{3}$",
          "worked": "$$\\begin{align*}2\\sqrt{3a-4}+b&=c\\\\2\\sqrt{3a-4}&=c-b\\\\\\sqrt{3a-4}&=\\frac{c-b}{2}\\\\3a-4&=\\left(\\frac{c-b}{2}\\right)^2\\\\3a&=\\left(\\frac{c-b}{2}\\right)^2+4\\\\a&=\\frac{\\left(\\frac{c-b}{2}\\right)^2+4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p15-q15-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\sqrt[3]{a-b}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=c^3+b$",
          "worked": "$$\\begin{align*}\\sqrt[3]{a-b}&=c\\\\a-b&=c^3\\\\a&=c^3+b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q15-l",
        "type": "part",
        "label": "l",
        "prompt": "$2\\sqrt[3]{\\frac{a}{b}}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{bc^3}{8}$",
          "worked": "$$\\begin{align*}2\\sqrt[3]{\\frac{a}{b}}&=c\\\\\\sqrt[3]{\\frac{a}{b}}&=\\frac{c}{2}\\\\\\frac{a}{b}&=\\frac{c^3}{8}\\\\a&=\\frac{bc^3}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
