            "children": [],
            "answer": {
              "short": "$36\\,300$",
              "worked": "Choose 3 of the 11 men and 3 of the 12 women.\n$$\\begin{aligned}N&={}^{11}C_{3}\\times{}^{12}C_{3}\\\\&=165\\times220\\\\&=36\\,300\\end{aligned}$$",
              "solutionDiagrams": []
