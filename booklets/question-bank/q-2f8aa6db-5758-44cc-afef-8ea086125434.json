            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$26\\,334$",
              "worked": "Include Anna, then choose the other 5 members from the remaining 22 people.\n$$\\begin{aligned}N&={}^{22}C_{5}\\\\&=26\\,334\\end{aligned}$$",
