        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+2)^2$",
          "worked": "A translation 2 units left replaces $x$ by $x+2$.\n\n$$y=(x+2)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p33-q10-b",
