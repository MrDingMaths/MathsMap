  "content": {
    "id": "p33-q11",
    "type": "question",
    "label": "11",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "144948a2-499c-4829-98a2-1d60870ffc58",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 0,
          "lineHeight": 1.3199970000068182,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Jeffrey earns $5205.50 per month. Calculate how much he earns per: ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Give answers to the nearest cent where necessary.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Year",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$62 466 per year.",
          "worked": "There are 12 months in a year.\n$$\\begin{align*}\\text{Annual pay} &= \\$5205.50\\times12\\\\\\text{Annual pay} &= \\$62\\,466\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p33-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1201.27 per week.",
          "worked": "Convert to annual pay, then divide by 52 weeks.\n$$\\begin{align*}\\text{Annual pay} &= \\$5205.50\\times12\\\\\\text{Annual pay} &= \\$62\\,466\\\\\\text{Weekly pay} &= \\frac{\\$62\\,466}{52}\\\\\\text{Weekly pay} &\\approx \\$1201.27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Fortnight",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$2402.54 per fortnight.",
          "worked": "Convert to annual pay, then divide by 26 fortnights.\n$$\\begin{align*}\\text{Annual pay} &= \\$5205.50\\times12\\\\\\text{Annual pay} &= \\$62\\,466\\\\\\text{Fortnightly pay} &= \\frac{\\$62\\,466}{26}\\\\\\text{Fortnightly pay} &\\approx \\$2402.54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
