      "evidence": ".booklet-work/reasoning-ratings/calls/logarithms-v1/2ede82b1b16b93e8bde8a998aeb8cfbd282f3530b2bbd6c5a149d9f78d98e862-1792560650912/last-message.txt"
    }
  },
  "content": {
    "id": "p40-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "State whether these functions are increasing or decreasing.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y = \\log_3 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "increasing",
          "worked": "The base $3>1$, so the function is increasing on $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = \\log_3(x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "increasing",
          "worked": "For $x>4$, the positive argument $x-4$ increases as $x$ increases. Since the base $3>1$, the function is increasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y = \\log_3(5x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "increasing",
          "worked": "For $x>0$, the positive argument $5x$ increases as $x$ increases. Since the base $3>1$, the function is increasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y = \\log_{\\frac13} x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "decreasing",
          "worked": "The base satisfies $0<\\frac13<1$, so the function is decreasing on $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$y = \\log_{0.3}(x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "decreasing",
          "worked": "For $x>4$, the positive argument $x-4$ increases as $x$ increases. Since $0<0.3<1$, the logarithm decreases as its argument increases. Hence the function is decreasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$y = \\log_{25}(5x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "increasing",
          "worked": "For $x>0$, the positive argument $5x$ increases as $x$ increases. Since the base $25>1$, the function is increasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$y = \\log_{1.01} x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "increasing",
          "worked": "The base $1.01>1$, so the function is increasing on $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$y = \\log_{0.99} x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "decreasing",
          "worked": "The base satisfies $0<0.99<1$, so the function is decreasing on $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$y = \\log_3(-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "decreasing",
          "worked": "For $x<0$, the positive argument $-x$ decreases as $x$ increases. A logarithm with base $3>1$ increases with its argument, so $\\log_3(-x)$ decreases as $x$ increases.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
