  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "For $\\left(1-\\frac{3}{x}\\right)^4$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the term in $x^{-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{12}{x}$",
          "worked": "$$T_r=\\binom{4}{r}(-3)^rx^{-r}$$\nFor $x^{-1}$, let $-r=-1$, so $r=1$.\n$$\\begin{align*}T_1&=\\binom{4}{1}(-3)^1x^{-1}\\\\T_1&=-\\frac{12}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the term in $x^{-2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{54}{x^2}$",
          "worked": "$$T_r=\\binom{4}{r}(-3)^rx^{-r}$$\nFor $x^{-2}$, let $-r=-2$, so $r=2$.\n$$\\begin{align*}T_2&=\\binom{4}{2}(-3)^2x^{-2}\\\\T_2&=\\frac{54}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
