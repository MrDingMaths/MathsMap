    "type": "question",
    "label": "1",
    "prompt": "20% of the children in a swimming pool are boys. There are 8 boys. How many children are there in the swimming pool?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "40 children",
      "worked": "$$\\begin{align*}20\\%\\text{ of the children}&=8\\\\1\\%\\text{ of the children}&=8\\div20=0.4\\\\100\\%\\text{ of the children}&=0.4\\times100=40\\end{align*}$$\nThere are 40 children in the swimming pool.",
