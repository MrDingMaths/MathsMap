  "content": {
    "id": "p50-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Rationalise these denominators.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{4\\sqrt{7}}{5\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4\\sqrt{21}}{15}$",
          "worked": "$$\\begin{align*}\\frac{4\\sqrt{7}}{5\\sqrt{3}}&=\\frac{4\\sqrt{7}}{5\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\&=\\frac{4\\sqrt{21}}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p50-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2\\sqrt{3}}{3\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{6}}{3}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{3}}{3\\sqrt{2}}&=\\frac{2\\sqrt{3}}{3\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\&=\\frac{2\\sqrt{6}}{6}\\\\&=\\frac{\\sqrt{6}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p50-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{5\\sqrt{7}}{3\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{35}}{3}$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt{7}}{3\\sqrt{5}}&=\\frac{5\\sqrt{7}}{3\\sqrt{5}}\\times\\frac{\\sqrt{5}}{\\sqrt{5}}\\\\&=\\frac{5\\sqrt{35}}{15}\\\\&=\\frac{\\sqrt{35}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p50-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{5\\sqrt{12}}{3\\sqrt{27}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{9}$; multiply by $\\dfrac{\\sqrt{27}}{\\sqrt{27}}$ and use $\\sqrt{324}=18$.",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt{12}}{3\\sqrt{27}}&=\\frac{5\\sqrt{12}}{3\\sqrt{27}}\\times\\frac{\\sqrt{27}}{\\sqrt{27}}\\\\&=\\frac{5\\sqrt{324}}{81}\\\\&=\\frac{90}{81}\\\\&=\\frac{10}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p50-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{9\\sqrt{6}}{2\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9\\sqrt{2}}{2}$",
          "worked": "$$\\begin{align*}\\frac{9\\sqrt{6}}{2\\sqrt{3}}&=\\frac{9\\sqrt{6}}{2\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\&=\\frac{9\\sqrt{18}}{6}\\\\&=\\frac{27\\sqrt{2}}{6}\\\\&=\\frac{9\\sqrt{2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p50-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{7\\sqrt{90}}{2\\sqrt{70}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3\\sqrt{7}}{2}$; multiply by $\\dfrac{\\sqrt{70}}{\\sqrt{70}}$ and use $\\sqrt{6300}=30\\sqrt{7}$.",
          "worked": "$$\\begin{align*}\\frac{7\\sqrt{90}}{2\\sqrt{70}}&=\\frac{7\\sqrt{90}}{2\\sqrt{70}}\\times\\frac{\\sqrt{70}}{\\sqrt{70}}\\\\&=\\frac{7\\sqrt{6300}}{140}\\\\&=\\frac{210\\sqrt{7}}{140}\\\\&=\\frac{3\\sqrt{7}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
