  "content": {
    "id": "p28-q1-response",
    "type": "question",
    "label": "1",
    "prompt": "Evaluate $\\binom{6}{4}$, $\\binom{5}{4}$ and $\\binom{5}{3}$, and verify that the first is the sum of the other two.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\binom{6}{4}=15$, $\\binom{5}{4}=5$ and $\\binom{5}{3}=10$; $15=5+10$.",
      "worked": "$$\\begin{align*}\\binom{6}{4}&=\\frac{6!}{4!\\,2!}=15\\\\\\binom{5}{4}&=\\frac{5!}{4!\\,1!}=5\\\\\\binom{5}{3}&=\\frac{5!}{3!\\,2!}=10\\\\\\binom{5}{4}+\\binom{5}{3}&=5+10=15=\\binom{6}{4}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
