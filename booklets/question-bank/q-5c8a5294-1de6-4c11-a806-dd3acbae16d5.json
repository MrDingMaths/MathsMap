            {
              "type": "text",
              "text": "The first and second term of the Fibonacci sequence are both 1. Each subsequent term is then found by adding the previous two terms:",
              "marks": []
            }
          ]
        },
        {
          "id": "p25-q7-sequence",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
