    "type": "question",
    "label": null,
    "prompt": "How many two-digit numbers are divisible by 5? Explain how you arrived at your answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "18; the two-digit multiples of 5 run from $5\\times2=10$ to $5\\times19=95$.",
      "worked": "A number divisible by 5 is a multiple of 5. The first two-digit multiple is $5\\times2=10$, and the last is $5\\times19=95$.\n\n$$\\begin{align*}\\text{Number of multiples}&=19-2+1\\\\&=18\\end{align*}$$",
      "solutionDiagrams": []
    },
