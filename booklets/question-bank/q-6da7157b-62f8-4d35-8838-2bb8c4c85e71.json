  "content": {
    "id": "p5-practice-2-root",
    "type": "question",
    "label": "",
    "prompt": "Consider the arithmetic sequence: $17,13,9,5,\\ldots$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-practice-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $n$th term formula for the sequence.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=21-4n$",
          "worked": "$a=17$, $d=13-17=-4$.\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=17-4(n-1)\\\\a_n&=21-4n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-practice-2-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the 15th term?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{15}=-39$",
          "worked": "$$\\begin{align*}a_{15}&=21-4(15)\\\\a_{15}&=-39\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p5-practice-2-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the first term less than $-50$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The 18th term: $a_{18}=-51$.",
          "worked": "$$\\begin{align*}21-4n&<-50\\\\-4n&<-71\\\\n&>\\frac{71}{4}\\end{align*}$$\nThe smallest integer index is $n=18$.\n$$\\begin{align*}a_{18}&=21-4(18)\\\\a_{18}&=-51\\end{align*}$$\nTherefore, the first term less than $-50$ is the 18th term, $-51$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
