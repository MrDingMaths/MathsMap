  "content": {
    "id": "p147-q29-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x-2$ and $g(x)=2x+7$. Find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p147-q29-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(g(2))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}f(g(2))&=f(2(2)+7)\\\\f(g(2))&=f(11)\\\\f(g(2))&=11-2\\\\f(g(2))&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p147-q29-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(g(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+5$",
          "worked": "$$\\begin{align*}f(g(x))&=f(2x+7)\\\\f(g(x))&=(2x+7)-2\\\\f(g(x))&=2x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p147-q29-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(f(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+3$",
          "worked": "$$\\begin{align*}g(f(x))&=g(x-2)\\\\g(f(x))&=2(x-2)+7\\\\g(f(x))&=2x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
