          "worked": "$$\\begin{align*}6-3a&=6-3\\times(-3)\\\\6-3a&=6+9\\\\6-3a&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
