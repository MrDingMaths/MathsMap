    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$5+2a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}5+2a&=5+2\\times(-3)\\\\5+2a&=5-6\\\\5+2a&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
