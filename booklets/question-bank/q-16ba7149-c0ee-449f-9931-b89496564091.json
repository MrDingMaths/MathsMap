          "short": "$7$",
          "worked": "$$\\begin{align*}4-a&=4-(-3)\\\\4-a&=4+3\\\\4-a&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-a)^3$",
