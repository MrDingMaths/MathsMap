      {
        "id": "p8-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\sin(A+B)\\sin(A-B)=\\sin^2A-\\sin^2B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sin^2A-\\sin^2B=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\sin(A+B)\\sin(A-B)\\\\&=(\\sin A\\cos B+\\cos A\\sin B)(\\sin A\\cos B-\\cos A\\sin B)\\\\&=\\sin^2A\\cos^2B-\\cos^2A\\sin^2B\\\\&=\\sin^2A(1-\\sin^2B)-(1-\\sin^2A)\\sin^2B\\\\&=\\sin^2A-\\sin^2A\\sin^2B-\\sin^2B+\\sin^2A\\sin^2B\\\\&=\\sin^2A-\\sin^2B\\\\&=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p8-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence simplify $\\sin^275^\\circ-\\sin^215^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3}{2}$",
          "worked": "$$\\begin{aligned}\\sin^275^\\circ-\\sin^215^\\circ&=\\sin(75^\\circ+15^\\circ)\\sin(75^\\circ-15^\\circ)\\\\&=\\sin90^\\circ\\sin60^\\circ\\\\&=\\frac{\\sqrt3}{2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
