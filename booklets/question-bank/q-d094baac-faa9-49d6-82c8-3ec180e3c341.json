        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab^{2}$",
          "worked": "Cancel matching factors in the numerator and denominator.\n\n$$\\begin{align*}\\frac{ab^9}{b^7}&=ab^{9-7} \\\\ &=ab^{2}\\end{align*}$$",
          "solutionDiagrams": []
