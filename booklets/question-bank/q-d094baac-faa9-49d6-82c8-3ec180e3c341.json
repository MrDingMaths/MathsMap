        "type": "part",
        "label": "b",
        "prompt": "$\\frac{b^9}{ab^7}=\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}$",
