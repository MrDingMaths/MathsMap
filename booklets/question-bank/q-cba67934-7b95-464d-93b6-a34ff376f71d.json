  "content": {
    "id": "p38-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Factorise the following expressions by noticing the binomial factor.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$4(x+3)+x(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(4+x)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}4(x+3)+x(x+3)\\\\&=(x+3)(4+x)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$3(x+1)+x(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(3+x)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}3(x+1)+x(x+1)\\\\&=(x+1)(3+x)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$7(m-3)+m(m-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m-3)(7+m)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}7(m-3)+m(m-3)\\\\&=(m-3)(7+m)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x(x-7)+2(x-7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-7)(x+2)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}x(x-7)+2(x-7)\\\\&=(x-7)(x+2)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$8(a+4)-a(a+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+4)(8-a)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}8(a+4)-a(a+4)\\\\&=(a+4)(8-a)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$y(y+3)-2(y+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y+3)(y-2)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}y(y+3)-2(y+3)\\\\&=(y+3)(y-2)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$a(x+2)+(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(a+1)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}a(x+2)+(x+2)\\\\&=a(x+2)+1(x+2)\\\\&=(x+2)(a+1)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$t(2t+5)+3(2t+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2t+5)(t+3)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}t(2t+5)+3(2t+5)\\\\&=(2t+5)(t+3)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$y(4y-1)-(4y-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4y-1)(y-1)$",
          "worked": "$\\begin{aligned}&\\mathrel{\\phantom{=}}y(4y-1)-(4y-1)\\\\&=y(4y-1)-1(4y-1)\\\\&=(4y-1)(y-1)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
