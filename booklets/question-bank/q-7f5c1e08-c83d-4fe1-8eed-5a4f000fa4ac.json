  "content": {
    "id": "p20-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Consider $n$ points in space, with no three collinear. By connecting these points, how many:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "distinct lines can be formed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{n}{2}$",
          "worked": "Each pair of points determines one line. With no three points collinear, different pairs determine different lines.\n\n$$L=\\binom{n}{2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "triangles can be formed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{n}{3}$",
          "worked": "Choose three vertices. Since no three points are collinear, every selection forms a triangle.\n\n$$T=\\binom{n}{3}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
