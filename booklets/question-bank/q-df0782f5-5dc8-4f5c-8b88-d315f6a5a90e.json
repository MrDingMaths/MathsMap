  "content": {
    "id": "p125-task25-30-root",
    "type": "question",
    "label": null,
    "prompt": "Solve the following equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p125-task25-30-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\lvert x+4\\rvert=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6$ or $x=-14$.",
          "worked": "$$\\begin{align*}x+4&=\\pm10\\\\x&=-4\\pm10\\\\x&=6\\text{ or }x=-14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p125-task25-30-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\lvert 2x-3\\rvert=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=-1$.",
          "worked": "$$\\begin{align*}2x-3&=\\pm5\\\\2x&=3\\pm5\\\\x&=\\frac{3\\pm5}{2}\\\\x&=4\\text{ or }x=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p125-task25-30-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\lvert -3x+2\\rvert=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-\\frac{2}{3}$.",
          "worked": "$$\\begin{align*}-3x+2&=\\pm4\\\\-3x&=-2\\pm4\\\\x&=\\frac{-2\\pm4}{-3}\\\\x&=2\\text{ or }x=-\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p125-task25-30-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\lvert 5-x\\rvert=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $x=7$.",
          "worked": "$$\\begin{align*}5-x&=\\pm2\\\\-x&=-5\\pm2\\\\x&=5\\mp2\\\\x&=3\\text{ or }x=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p125-task25-30-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\lvert x+4\\rvert=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$.",
          "worked": "An absolute value is zero only when its argument is zero.\n\n$$\\begin{align*}x+4&=0\\\\x&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p125-task25-30-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left\\lvert\\frac{3x-2}{4}\\right\\rvert=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-\\frac{2}{3}$.",
          "worked": "$$\\begin{align*}\\frac{3x-2}{4}&=\\pm1\\\\3x-2&=\\pm4\\\\3x&=2\\pm4\\\\x&=\\frac{2\\pm4}{3}\\\\x&=2\\text{ or }x=-\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
