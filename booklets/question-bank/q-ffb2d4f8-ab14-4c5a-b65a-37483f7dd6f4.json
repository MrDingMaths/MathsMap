    "children": [
      {
        "id": "p15-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{(a-b)^2-c^2}{ab-b^2-bc}\\times\\dfrac{c}{a^2+ab-ac}\\div\\dfrac{ac-bc+c^2}{a^2-(b-c)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a-b+c}{ab}$",
          "worked": "$$\\begin{align*}\\frac{(a-b)^2-c^2}{ab-b^2-bc}\\times\\frac{c}{a^2+ab-ac}\\div\\frac{ac-bc+c^2}{a^2-(b-c)^2}&=\\frac{(a-b-c)(a-b+c)}{b(a-b-c)}\\times\\frac{c}{a(a+b-c)}\\div\\frac{c(a-b+c)}{(a-b+c)(a+b-c)}\\\\\\frac{(a-b)^2-c^2}{ab-b^2-bc}\\times\\frac{c}{a^2+ab-ac}\\div\\frac{ac-bc+c^2}{a^2-(b-c)^2}&=\\frac{a-b+c}{b}\\times\\frac{c}{a(a+b-c)}\\times\\frac{a+b-c}{c}\\\\\\frac{(a-b)^2-c^2}{ab-b^2-bc}\\times\\frac{c}{a^2+ab-ac}\\div\\frac{ac-bc+c^2}{a^2-(b-c)^2}&=\\frac{a-b+c}{ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p15-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{8x^2+14x+3}{8x^2-10x+3}\\times\\dfrac{12x^2-6x}{4x^2+5x+1}\\div\\dfrac{18x^2-6x}{4x^2+x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+3}{3x-1}$",
          "worked": "$$\\begin{align*}\\frac{8x^2+14x+3}{8x^2-10x+3}\\times\\frac{12x^2-6x}{4x^2+5x+1}\\div\\frac{18x^2-6x}{4x^2+x-3}&=\\frac{(4x+1)(2x+3)}{(4x-3)(2x-1)}\\times\\frac{6x(2x-1)}{(4x+1)(x+1)}\\times\\frac{(4x-3)(x+1)}{6x(3x-1)}\\\\\\frac{8x^2+14x+3}{8x^2-10x+3}\\times\\frac{12x^2-6x}{4x^2+5x+1}\\div\\frac{18x^2-6x}{4x^2+x-3}&=\\frac{2x+3}{3x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p15-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{4y}{x^2+2xy}-\\dfrac{3x}{xy+2y^2}+\\dfrac{3x-2y}{xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{x+2y}$",
          "worked": "$$\\begin{align*}\\frac{4y}{x^2+2xy}-\\frac{3x}{xy+2y^2}+\\frac{3x-2y}{xy}&=\\frac{4y}{x(x+2y)}-\\frac{3x}{y(x+2y)}+\\frac{3x-2y}{xy}\\\\\\frac{4y}{x^2+2xy}-\\frac{3x}{xy+2y^2}+\\frac{3x-2y}{xy}&=\\frac{4y^2-3x^2+(3x-2y)(x+2y)}{xy(x+2y)}\\\\\\frac{4y}{x^2+2xy}-\\frac{3x}{xy+2y^2}+\\frac{3x-2y}{xy}&=\\frac{4y^2-3x^2+3x^2+4xy-4y^2}{xy(x+2y)}\\\\\\frac{4y}{x^2+2xy}-\\frac{3x}{xy+2y^2}+\\frac{3x-2y}{xy}&=\\frac{4}{x+2y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p15-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{x-1}+\\dfrac{2}{x+1}-\\dfrac{3x-2}{x^2-1}-\\dfrac{1}{x^2+2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{(x+1)^2(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x-1}+\\frac{2}{x+1}-\\frac{3x-2}{x^2-1}-\\frac{1}{x^2+2x+1}&=\\frac{x+1+2(x-1)-(3x-2)}{(x-1)(x+1)}-\\frac{1}{(x+1)^2}\\\\\\frac{1}{x-1}+\\frac{2}{x+1}-\\frac{3x-2}{x^2-1}-\\frac{1}{x^2+2x+1}&=\\frac{1}{(x-1)(x+1)}-\\frac{1}{(x+1)^2}\\\\\\frac{1}{x-1}+\\frac{2}{x+1}-\\frac{3x-2}{x^2-1}-\\frac{1}{x^2+2x+1}&=\\frac{(x+1)-(x-1)}{(x-1)(x+1)^2}\\\\\\frac{1}{x-1}+\\frac{2}{x+1}-\\frac{3x-2}{x^2-1}-\\frac{1}{x^2+2x+1}&=\\frac{2}{(x-1)(x+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
  },
