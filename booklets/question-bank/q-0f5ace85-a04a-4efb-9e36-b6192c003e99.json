    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p61-q14-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Mr Ding makes maths booklets that are on average 25 sheets of paper.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Each ream of printing paper is 500 sheets.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "A single sustainably farmed tree can produce approximately 10 000 sheets of paper.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Each ream of paper is $9.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "He teaches 4 classes and prints a new booklet for each student once every two weeks.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Each class has on average 20 students.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "How many trees does he use in a 38-week academic year, and how much do these booklets cost in paper?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately $3.8$ trees; $\\$684$ in paper.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p61-q14-answer-sheets-label",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "First find how many sheets are used per year:",
                "marks": []
              }
            ]
          },
          {
            "id": "p61-q14-answer-sheets-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\text{Sheets used}&=\\frac{20\\text{ students}}{\\text{class}}\\times4\\text{ classes}\\times\\frac{25\\text{ sheets}}{\\text{book}}\\times\\frac{0.5\\text{ books}}{\\text{student}\\cdot\\text{week}}\\times38\\text{ weeks}\\\\\\text{Sheets used}&=38\\,000\\text{ sheets}\\end{aligned}",
                "display": false
              }
            ]
          },
          {
            "id": "p61-q14-answer-trees-label",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Therefore, trees used per year:",
                "marks": []
              }
            ]
          },
          {
            "id": "p61-q14-answer-trees-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\text{Trees used}&=38\\,000\\text{ sheets}\\div\\frac{10\\,000\\text{ sheets}}{\\text{tree}}\\\\\\text{Trees used}&\\approx3.8\\text{ trees}\\end{aligned}",
                "display": false
              }
            ]
          },
          {
            "id": "p61-q14-answer-cost-label",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Cost per year:",
                "marks": []
              }
            ]
          },
          {
            "id": "p61-q14-answer-cost-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\text{Cost}&=38\\,000\\text{ sheets}\\div\\frac{500\\text{ sheets}}{\\text{ream}}\\times\\frac{\\$9}{\\text{ream}}\\\\\\text{Cost}&=\\$684\\end{aligned}",
                "display": false
              }
            ]
          }
        ]
      },
