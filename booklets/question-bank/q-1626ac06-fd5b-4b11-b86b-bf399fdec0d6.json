        "answer": {
          "short": "$90\\text{ m}^2$",
          "worked": "$$\\begin{align*}A_{ABC}&=A_{ABD}+A_{ADC}\\\\A_{ABC}&=54+36\\\\A_{ABC}&=90\\text{ m}^2\\end{align*}$$",
