  "content": {
    "id": "p5-p1-root",
    "type": "question",
    "label": "1",
    "prompt": "Suppose $f(x)=\\sin(2x)$, $g(x)=x+2$, and $h(x)=\\cos(x)$. Find, correct to two decimal places, the value of",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-p1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(1)+h(1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.45$",
          "worked": "$$\\begin{align*}f(1)+h(1)&=\\sin(2)+\\cos(1)\\\\f(1)+h(1)&\\approx1.45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p5-p1-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(g(1))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.28$",
          "worked": "$$\\begin{align*}g(1)&=1+2=3\\\\f(g(1))&=\\sin(2\\times3)\\\\f(g(1))&\\approx-0.28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p5-p1-c",
        "type": "part",
        "label": "c",
        "prompt": "$h(g(0))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.42$",
          "worked": "$$\\begin{align*}g(0)&=0+2=2\\\\h(g(0))&=\\cos(2)\\\\h(g(0))&\\approx-0.42\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p5-p1-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(f(1))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.91$",
          "worked": "$$\\begin{align*}f(1)&=\\sin(2)\\\\g(f(1))&=\\sin(2)+2\\\\g(f(1))&\\approx2.91\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
