      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "How much did Tom grow over these ten years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$65\\text{ cm}$",
          "worked": "$$185-120=65\\text{ cm}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find Tom’s average rate of growth per year between 10 and 20 years of age.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.5\\text{ cm/year}$",
          "worked": "$$\\begin{align*}\\text{Growth}&=185-120=65\\text{ cm}\\\\\\text{Time}&=20-10=10\\text{ years}\\\\\\text{Average rate}&=\\frac{65\\text{ cm}}{10\\text{ years}}=6.5\\text{ cm/year}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
