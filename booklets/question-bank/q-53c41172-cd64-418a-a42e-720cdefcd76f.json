  "content": {
    "id": "p29-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "The surface area of a cylinder of height $2\\text{ cm}$ is $30\\pi\\text{ cm}^2$. Find the radius of the cylinder.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\text{ cm}$",
      "worked": "$$\\begin{align*}2\\pi r^2+2\\pi rh&=30\\pi\\\\2\\pi r^2+2\\pi r(2)&=30\\pi\\\\r^2+2r&=15\\\\r^2+2r-15&=0\\\\(r+5)(r-3)&=0\\end{align*}$$\nSince $r>0$, the radius is $3\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
