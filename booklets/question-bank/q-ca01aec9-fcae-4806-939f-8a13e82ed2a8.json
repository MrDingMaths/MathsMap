  "content": {
    "id": "p15-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find the equation of the line that passes through each of the following pairs of points.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1,1),\\ (2,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x$",
          "worked": "$$\\begin{align*}m&=\\frac{2-1}{2-1}\\\\m&=1\\end{align*}$$\nUsing $(1,1)$ in $y=x+c$:\n$$\\begin{align*}1&=1+c\\\\c&=0\\\\y&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p15-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$(3,4),\\ (4,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x+7$",
          "worked": "$$\\begin{align*}m&=\\frac{3-4}{4-3}\\\\m&=-1\\end{align*}$$\nUsing $(3,4)$ in $y=-x+c$:\n$$\\begin{align*}4&=-3+c\\\\c&=7\\\\y&=-x+7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p15-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1,3),\\ (2,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+1$",
          "worked": "$$\\begin{align*}m&=\\frac{5-3}{2-1}\\\\m&=2\\end{align*}$$\nUsing $(1,3)$ in $y=2x+c$:\n$$\\begin{align*}3&=2(1)+c\\\\c&=1\\\\y&=2x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p15-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$(-1,1),\\ (1,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+3$",
          "worked": "$$\\begin{align*}m&=\\frac{5-1}{1-(-1)}\\\\m&=2\\end{align*}$$\nUsing $(1,5)$ in $y=2x+c$:\n$$\\begin{align*}5&=2(1)+c\\\\c&=3\\\\y&=2x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p15-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-2,-3),\\ (1,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x+3$",
          "worked": "$$\\begin{align*}m&=\\frac{6-(-3)}{1-(-2)}\\\\m&=3\\end{align*}$$\nUsing $(1,6)$ in $y=3x+c$:\n$$\\begin{align*}6&=3(1)+c\\\\c&=3\\\\y&=3x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p15-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$(1,2),\\ (5,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{x}{2}+\\frac32$",
          "worked": "$$\\begin{align*}m&=\\frac{4-2}{5-1}\\\\m&=\\frac12\\end{align*}$$\nUsing $(1,2)$ in $y=\\frac12x+c$:\n$$\\begin{align*}2&=\\frac12(1)+c\\\\c&=2-\\frac12\\\\c&=\\frac32\\\\y&=\\frac12x+\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p15-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$(-1,1),\\ (1,-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x-1$",
          "worked": "$$\\begin{align*}m&=\\frac{-3-1}{1-(-1)}\\\\m&=-2\\end{align*}$$\nUsing $(1,-3)$ in $y=-2x+c$:\n$$\\begin{align*}-3&=-2(1)+c\\\\c&=-1\\\\y&=-2x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p15-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$(3,-1),\\ (-1,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac34x+\\frac54$",
          "worked": "$$\\begin{align*}m&=\\frac{2-(-1)}{-1-3}\\\\m&=-\\frac34\\end{align*}$$\nUsing $(-1,2)$ in $y=-\\frac34x+c$:\n$$\\begin{align*}2&=-\\frac34(-1)+c\\\\c&=2-\\frac34\\\\c&=\\frac54\\\\y&=-\\frac34x+\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
  },
