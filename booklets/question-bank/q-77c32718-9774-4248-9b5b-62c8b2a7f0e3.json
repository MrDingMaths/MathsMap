  "content": {
    "id": "p5-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Given the relationship $s=ut+\\frac{1}{2}at^2$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate $s$ when $u=20.8$, $t=1.5$ and $a=9.8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=42.225$",
          "worked": "$$\\begin{align*}s&=20.8\\times1.5+\\frac{1}{2}\\times9.8\\times(1.5)^2\\\\s&=31.2+4.9\\times2.25\\\\s&=31.2+11.025\\\\s&=42.225\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Rearrange the formula to make $a$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{2(s-ut)}{t^2}$",
          "worked": "$$\\begin{align*}s-ut&=\\frac{1}{2}at^2\\\\2(s-ut)&=at^2\\\\a&=\\frac{2(s-ut)}{t^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
