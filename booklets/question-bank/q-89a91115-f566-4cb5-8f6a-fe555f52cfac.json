  "content": {
    "id": "p4-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Evaluate each expression for $w=-2$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$-20w$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$",
          "worked": "$$\\begin{align*}-20w&=-20\\times(-2)\\\\-20w&=40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$-w^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-16$",
          "worked": "$$\\begin{align*}-w^4&=-(-2)^4\\\\-w^4&=-16\\end{align*}$$\n\nEvaluate the fourth power before applying the leading minus sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$10-2w$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{align*}10-2w&=10-2\\times(-2)\\\\10-2w&=10+4\\\\10-2w&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$(-2w)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64$",
          "worked": "$$\\begin{align*}(-2w)^3&=\\bigl(-2\\times(-2)\\bigr)^3\\\\(-2w)^3&=4^3\\\\(-2w)^3&=64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-w)^3+w^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}(-w)^3+w^2&=\\bigl(-(-2)\\bigr)^3+(-2)^2\\\\(-w)^3+w^2&=2^3+4\\\\(-w)^3+w^2&=8+4\\\\(-w)^3+w^2&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$w^3-10w^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-48$",
          "worked": "$$\\begin{align*}w^3-10w^2&=(-2)^3-10\\times(-2)^2\\\\w^3-10w^2&=-8-40\\\\w^3-10w^2&=-48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
