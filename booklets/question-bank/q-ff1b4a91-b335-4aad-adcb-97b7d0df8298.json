  "content": {
    "id": "p27-q35-root",
    "type": "question",
    "label": null,
    "prompt": "The graph of $y=\\sqrt{x}$ is dilated horizontally by a factor of 4. What is the equivalent vertical dilation factor to give the same result?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{2}$.",
      "worked": "Replace $x$ by $\\frac{x}{4}$.\n\n$$\\begin{align*}y&=\\sqrt{\\frac{x}{4}}\\\\y&=\\frac{\\sqrt{x}}{2}\\\\y&=\\frac{1}{2}\\sqrt{x}\\end{align*}$$\n\nThe equivalent vertical dilation factor is $\\dfrac{1}{2}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
