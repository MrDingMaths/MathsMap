            },
            {
              "type": "math",
              "latex": "x^3",
              "display": false
            },
            {
              "type": "text",
              "text": ". Which of the following are positive cubic functions?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p79-task2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x+1)(x+2)(x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Positive.",
          "worked": "The coefficient of $x^3$ is $1\\times1\\times1=1$. It is positive, so this is a positive cubic.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p79-task2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2(x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Positive.",
          "worked": "The leading term is $x^2\\times x=x^3$. Its coefficient is $1$, so this is a positive cubic.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p79-task2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(1-x)(2+x)(3+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not positive.",
          "worked": "The coefficient of $x^3$ is $(-1)\\times1\\times1=-1$. It is negative, so this is a negative cubic.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p79-task2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(1-x)(2-x)(3+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Positive.",
          "worked": "The coefficient of $x^3$ is $(-1)\\times(-1)\\times1=1$. It is positive, so this is a positive cubic.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p79-task2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=(1-x)(2-x)(3-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not positive.",
          "worked": "The coefficient of $x^3$ is $(-1)\\times(-1)\\times(-1)=-1$. It is negative, so this is a negative cubic.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p79-task2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=(1-x)^2(2+x)$",
