  "content": {
    "id": "p32-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "It took David an hour to ride 20 km from his house to the nearest town. He then spent 40 minutes on the return journey. What was his average speed?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
