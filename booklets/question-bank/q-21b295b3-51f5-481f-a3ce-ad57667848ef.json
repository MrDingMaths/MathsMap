            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Divide the total distance by the total journey time.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\text{Total distance}&=20+20=40\\text{ km}\\\\\\text{Total time}&=1+\\frac{40}{60}=\\frac{5}{3}\\text{ h}\\\\\\text{Average speed}&=\\frac{\\text{total distance}}{\\text{total time}}\\\\\\text{Average speed}&=40\\div\\frac{5}{3}\\\\\\text{Average speed}&=40\\times\\frac{3}{5}\\\\\\text{Average speed}&=24\\text{ km/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
