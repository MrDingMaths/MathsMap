    "children": [
      {
        "id": "p12-q7a",
        "type": "part",
        "label": "a",
        "prompt": "For a particular geometric sequence of positive terms, $a_3=4$ and $a_5=6$. Find $a_7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}r^2&=\\frac{a_5}{a_3}\\\\r^2&=\\frac{6}{4}=\\frac32\\end{align*}$$\n$$\\begin{align*}a_7&=a_5r^2\\\\a_7&=6\\times\\frac32\\\\a_7&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p12-q7b",
        "type": "part",
        "label": "b",
        "prompt": "For a particular geometric sequence, $a_2=2$ and $a_5=54$. Find $a_7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$486$",
          "worked": "$$\\begin{align*}r^3&=\\frac{a_5}{a_2}\\\\r^3&=\\frac{54}{2}\\\\r^3&=27\\\\r&=3\\end{align*}$$\n$$\\begin{align*}a_7&=a_5r^2\\\\a_7&=54\\times3^2\\\\a_7&=486\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p12-q7c",
        "type": "part",
        "label": "c",
        "prompt": "For a particular geometric sequence of positive terms, $a_2=3$ and $a_6=27$. Find $a_1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3$",
          "worked": "$$\\begin{align*}r^4&=\\frac{a_6}{a_2}\\\\r^4&=\\frac{27}{3}\\\\r^4&=9\\end{align*}$$\nThe terms are positive, so $r=\\sqrt3$.\n$$\\begin{align*}a_1&=\\frac{a_2}{r}\\\\a_1&=\\frac{3}{\\sqrt3}\\\\a_1&=\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
