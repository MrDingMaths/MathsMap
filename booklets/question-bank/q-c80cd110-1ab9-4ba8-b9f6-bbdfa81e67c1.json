        "children": [],
        "answer": {
          "short": "$60$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int_3^5(3x^2-6x+5)\\,dx\\\\&=[x^3-3x^2+5x]_3^5\\\\&=(5^3-3\\times5^2+5\\times5)-(3^3-3\\times3^2+5\\times3)\\\\&=75-15\\\\&=60\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
