  "content": {
    "id": "p29-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\int_3^6(2x+1)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$$\\begin{aligned}\\int_3^6(2x+1)\\,dx&=[x^2+x]_3^6\\\\&=(6^2+6)-(3^2+3)\\\\&=42-12\\\\&=30\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p29-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\int_2^4(2x-3)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{aligned}\\int_2^4(2x-3)\\,dx&=[x^2-3x]_2^4\\\\&=(4^2-3\\times4)-(2^2-3\\times2)\\\\&=4-(-2)\\\\&=6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p29-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\int_0^3(4x+5)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33$",
          "worked": "$$\\begin{aligned}\\int_0^3(4x+5)\\,dx&=[2x^2+5x]_0^3\\\\&=(2\\times3^2+5\\times3)-(2\\times0^2+5\\times0)\\\\&=33-0\\\\&=33\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p29-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\int_2^3(3x^2-1)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{aligned}\\int_2^3(3x^2-1)\\,dx&=[x^3-x]_2^3\\\\&=(3^3-3)-(2^3-2)\\\\&=24-6\\\\&=18\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p29-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\int_1^4(6x^2+2)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$132$",
          "worked": "$$\\begin{aligned}\\int_1^4(6x^2+2)\\,dx&=[2x^3+2x]_1^4\\\\&=(2\\times4^3+2\\times4)-(2\\times1^3+2\\times1)\\\\&=136-4\\\\&=132\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p29-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\int_0^1(3x^2+2x)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\int_0^1(3x^2+2x)\\,dx&=[x^3+x^2]_0^1\\\\&=(1^3+1^2)-(0^3+0^2)\\\\&=2-0\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p29-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\int_1^2(4x^3+3x^2+1)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int_1^2(4x^3+3x^2+1)\\,dx\\\\&=[x^4+x^3+x]_1^2\\\\&=(2^4+2^3+2)-(1^4+1^3+1)\\\\&=26-3\\\\&=23\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p29-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\int_0^2(2x+3x^2+8x^3)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$44$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int_0^2(2x+3x^2+8x^3)\\,dx\\\\&=[x^2+x^3+2x^4]_0^2\\\\&=(2^2+2^3+2\\times2^4)-(0^2+0^3+2\\times0^4)\\\\&=44-0\\\\&=44\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p29-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\int_3^5(3x^2-6x+5)\\,dx$$",
        "layout": "list",
