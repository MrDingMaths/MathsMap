  "content": {
    "id": "p22-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "In a class of 30 students, the ratio of boys to girls is $2:3$. If 6 boys join the class, find the new ratio of boys to girls in the class.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1:1$",
      "worked": "There are $2+3=5$ parts in the original class.\n$$\\begin{align*}\\text{One part}&=30\\div5=6\\text{ students}\\\\\\text{Original number of boys}&=2\\times6=12\\\\\\text{Number of girls}&=3\\times6=18\\\\\\text{New number of boys}&=12+6=18\\\\\\text{New ratio of boys to girls}&=18:18\\\\\\text{New ratio of boys to girls}&=1:1\\end{align*}$$",
      "solutionDiagrams": []
    },
