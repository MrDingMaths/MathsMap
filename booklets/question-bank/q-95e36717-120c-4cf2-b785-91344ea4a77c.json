  "content": {
    "id": "p21-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify each of the following by factorising the numerator and denominator and then cancelling:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2x+4}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$",
          "worked": "$$\\begin{align*}\\frac{2x+4}{2}&=\\frac{2(x+2)}{2}\\\\\\frac{2x+4}{2}&=x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p21-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3}{6a-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2a-3}$",
          "worked": "$$\\begin{align*}\\frac{3}{6a-9}&=\\frac{3}{3(2a-3)}\\\\\\frac{3}{6a-9}&=\\frac{1}{2a-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{8x-12}{6x-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{3}$",
          "worked": "$$\\begin{align*}\\frac{8x-12}{6x-9}&=\\frac{4(2x-3)}{3(2x-3)}\\\\\\frac{8x-12}{6x-9}&=\\frac{4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2b^2-3b}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2b-3$",
          "worked": "$$\\begin{align*}\\frac{2b^2-3b}{b}&=\\frac{b(2b-3)}{b}\\\\\\frac{2b^2-3b}{b}&=2b-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p21-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3x}{3x^2+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{3x+1}$",
          "worked": "$$\\begin{align*}\\frac{3x}{3x^2+x}&=\\frac{3x}{x(3x+1)}\\\\\\frac{3x}{3x^2+x}&=\\frac{3}{3x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{x-4}{4-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{x-4}{4-x}&=\\frac{x-4}{-(x-4)}\\\\\\frac{x-4}{4-x}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p21-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{a-2}{4-2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{a-2}{4-2a}&=\\frac{a-2}{-2(a-2)}\\\\\\frac{a-2}{4-2a}&=-\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{8d+6}{4d^2+3d}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{d}$",
          "worked": "$$\\begin{align*}\\frac{8d+6}{4d^2+3d}&=\\frac{2(4d+3)}{d(4d+3)}\\\\\\frac{8d+6}{4d^2+3d}&=\\frac{2}{d}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{x+y-1}{1-x-y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{x+y-1}{1-x-y}&=\\frac{x+y-1}{-(x+y-1)}\\\\\\frac{x+y-1}{1-x-y}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p21-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{a+2b-3}{6-2a-4b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{a+2b-3}{6-2a-4b}&=\\frac{a+2b-3}{-2(a+2b-3)}\\\\\\frac{a+2b-3}{6-2a-4b}&=-\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{4xy-6x^2}{6y^2-9xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{3y}$",
          "worked": "$$\\begin{align*}\\frac{4xy-6x^2}{6y^2-9xy}&=\\frac{2x(2y-3x)}{3y(2y-3x)}\\\\\\frac{4xy-6x^2}{6y^2-9xy}&=\\frac{2x}{3y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{6x^2y^2-10xy}{15x-9x^2y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2y}{3}$\n\nFactorise both expressions and use $5-3xy=-(3xy-5)$.",
          "worked": "$$\\begin{align*}\\frac{6x^2y^2-10xy}{15x-9x^2y}&=\\frac{2xy(3xy-5)}{3x(5-3xy)}\\\\\\frac{6x^2y^2-10xy}{15x-9x^2y}&=\\frac{2xy(3xy-5)}{-3x(3xy-5)}\\\\\\frac{6x^2y^2-10xy}{15x-9x^2y}&=-\\frac{2y}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
