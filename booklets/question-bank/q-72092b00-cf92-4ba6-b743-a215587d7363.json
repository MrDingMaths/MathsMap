  "content": {
    "id": "p16-q86-90-root",
    "type": "question",
    "label": null,
    "prompt": "Find the domain of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q86",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=4\\log_2(2x-6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,\\infty)$",
          "worked": "The logarithm's argument must be positive.\n$$\\begin{align*}2x-6&>0\\\\2x&>6\\\\x&>3\\end{align*}$$\nThe domain is $(3,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p16-q87",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\log_8(2x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,\\infty)$",
          "worked": "The logarithm's argument must be positive.\n$$\\begin{align*}2x+4&>0\\\\2x&>-4\\\\x&>-2\\end{align*}$$\nThe domain is $(-2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p16-q88",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3\\log_4(1-2x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,\\tfrac12)$",
          "worked": "The logarithm's argument must be positive. Dividing by $-2$ reverses the inequality.\n$$\\begin{align*}1-2x&>0\\\\-2x&>-1\\\\x&<\\frac12\\end{align*}$$\nThe domain is $(-\\infty,\\tfrac12)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p16-q89",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\ln\\left(\\frac{2x-1}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\tfrac12,\\infty)$",
          "worked": "The logarithm's argument must be positive.\n$$\\begin{align*}\\frac{2x-1}{3}&>0\\\\2x-1&>0\\\\x&>\\frac12\\end{align*}$$\nThe domain is $(\\tfrac12,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p16-q90",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\ln\\left(\\frac{3-x}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,3)$",
          "worked": "The logarithm's argument must be positive.\n$$\\begin{align*}\\frac{3-x}{2}&>0\\\\3-x&>0\\\\x&<3\\end{align*}$$\nThe domain is $(-\\infty,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
