    "type": "question",
    "label": null,
    "prompt": "Tiles are to be placed in a circle. In how many ways can this be done if there are",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-ab1d0-p48-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "six white, four blue and one red tile,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$210$",
          "worked": "Fix the unique red tile. Arrange the other ten tiles, dividing by $6!$ and $4!$ for identical colours.\n$$\\begin{align*}N&=\\frac{10!}{6!\\,4!}\\\\&=210\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-ab1d0-p48-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "five white, three blue, one red and one green tile?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$504$",
          "worked": "Fix the red tile. Arrange the other nine tiles (the green tile is unique), dividing by $5!$ and $3!$ for identical colours.\n$$\\begin{align*}N&=\\frac{9!}{5!\\,3!}\\\\&=\\frac{362\\,880}{720}\\\\&=504\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
