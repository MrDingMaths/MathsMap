  "content": {
    "id": "p25-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A metal stud is created by rotating about the $x$-axis the region between the curve $y=e^x-e^{-x}$ and the $x$-axis from $x=0$ to $x=\\frac12$. Show that the volume of the stud is $\\frac{\\pi}{2}(e-2-e^{-1})\\,\\text{u}^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{\\pi}{2}(e-2-e^{-1})\\,\\text{u}^3$",
      "worked": "$$\\begin{align*}y^2&=(e^x-e^{-x})^2\\\\&=e^{2x}-2+e^{-2x}.\\end{align*}$$\n$$\\begin{align*}V&=\\pi\\int_0^{1/2}(e^{2x}-2+e^{-2x})\\,dx\\\\&=\\pi\\left[\\frac{e^{2x}}2-2x-\\frac{e^{-2x}}2\\right]_0^{1/2}\\\\&=\\pi\\left[\\left(\\frac e2-1-\\frac{e^{-1}}2\\right)-\\left(\\frac12-\\frac12\\right)\\right]\\\\&=\\frac{\\pi}{2}(e-2-e^{-1})\\,\\text{u}^3.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 39
  },
