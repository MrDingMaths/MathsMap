  "content": {
    "id": "p19-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Suppose that $x^2+x+1=a(x-1)^2+b(x-1)+c$ for all values of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Equate the coefficients of $x^2$ to find the value of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$",
          "worked": "Equating the coefficients of $x^2$ gives $a=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute $x=1$ into the identity to find the value of $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=3$",
          "worked": "Substitute $x=1$:\n$$\\begin{align*}1^2+1+1&=a(0)^2+b(0)+c\\\\3&=c\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Substitute $x=2$ into the identity to find the value of $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=3$",
          "worked": "Substitute $x=2$, using $a=1$ and $c=3$:\n$$\\begin{align*}2^2+2+1&=1(2-1)^2+b(2-1)+3\\\\7&=1+b+3\\\\b&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Why was the value $x=2$ chosen in part c?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It makes each bracket on the right-hand side equal to $1$.",
          "worked": "When $x=2$, $x-1=1$ and $(x-1)^2=1$, so the right-hand side becomes $a+b+c$. With $a$ and $c$ known, this makes finding $b$ straightforward.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
