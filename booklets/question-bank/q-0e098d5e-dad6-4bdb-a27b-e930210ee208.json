    "children": [
      {
        "id": "p21-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $x$ if the terms in $x^{10}$ and $x^{11}$ in the expansion of $(5+2x)^{15}$ are equal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=\\dfrac{11}{2}$.",
          "worked": "The two terms are\n$$\\begin{aligned}T_{10}&=\\binom{15}{10}5^5 2^{10}x^{10},\\\\T_{11}&=\\binom{15}{11}5^4 2^{11}x^{11}.\\end{aligned}$$\nEquating terms and dividing by $5^4 2^{10}$ gives\n$$\\begin{aligned}5\\binom{15}{10}x^{10}&=2\\binom{15}{11}x^{11}\\\\15015x^{10}&=2730x^{11}\\\\x^{10}(15015-2730x)&=0.\\end{aligned}$$\nHence $x=0$, or\n$$\\begin{aligned}2730x&=15015\\\\x&=\\frac{11}{2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p21-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $x$ if the terms in $x^{13}$ and $x^{14}$ in the expansion of $(2-3x)^{17}$ are equal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=-\\dfrac{7}{3}$.",
          "worked": "The two terms are\n$$\\begin{aligned}T_{13}&=\\binom{17}{13}2^4(-3)^{13}x^{13},\\\\T_{14}&=\\binom{17}{14}2^3(-3)^{14}x^{14}.\\end{aligned}$$\nEquating terms and dividing by $2^3(-3)^{13}$ gives\n$$\\begin{aligned}2\\binom{17}{13}x^{13}&=-3\\binom{17}{14}x^{14}\\\\4760x^{13}&=-2040x^{14}\\\\x^{13}(4760+2040x)&=0.\\end{aligned}$$\nHence $x=0$, or\n$$\\begin{aligned}2040x&=-4760\\\\x&=-\\frac{7}{3}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
  },
