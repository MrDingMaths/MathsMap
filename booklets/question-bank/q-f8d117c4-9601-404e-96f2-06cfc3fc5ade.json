    "label": "15",
    "prompt": "Solve $\\log_{10}A=bt+\\log_{10}P$ for $A$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$A=P\\times10^{bt}$\n\nCombine the logarithms using the quotient law, then convert to index form.",
      "worked": "$$\\begin{align*}\\log_{10}A-\\log_{10}P&=bt\\\\\\log_{10}\\left(\\frac{A}{P}\\right)&=bt\\\\\\frac{A}{P}&=10^{bt}\\\\A&=P\\times10^{bt}\\end{align*}$$",
      "solutionDiagrams": []
    },
