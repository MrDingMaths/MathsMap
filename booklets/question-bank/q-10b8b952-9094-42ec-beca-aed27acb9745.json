  "content": {
    "id": "p32-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify the following. Change denominators to be the same first.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{5}{x}+\\dfrac{2}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7x+20}{x(x+4)}$",
          "worked": "$$\\begin{align*}\\frac{5}{x}+\\frac{2}{x+4}&=\\frac{5(x+4)}{x(x+4)}+\\frac{2x}{x(x+4)}\\\\&=\\frac{5x+20+2x}{x(x+4)}\\\\&=\\frac{7x+20}{x(x+4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p32-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{4}{x-7}+\\dfrac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7(x-3)}{x(x-7)}$",
          "worked": "$$\\begin{align*}\\frac{4}{x-7}+\\frac{3}{x}&=\\frac{4x}{x(x-7)}+\\frac{3(x-7)}{x(x-7)}\\\\&=\\frac{4x+3x-21}{x(x-7)}\\\\&=\\frac{7x-21}{x(x-7)}\\\\&=\\frac{7(x-3)}{x(x-7)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p32-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{x-3}+\\dfrac{2}{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x-1}{(x-3)(x+5)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x-3}+\\frac{2}{x+5}&=\\frac{x+5}{(x-3)(x+5)}+\\frac{2(x-3)}{(x-3)(x+5)}\\\\&=\\frac{x+5+2x-6}{(x-3)(x+5)}\\\\&=\\frac{3x-1}{(x-3)(x+5)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p32-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3}{x+3}-\\dfrac{2}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-18}{(x-4)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+3}-\\frac{2}{x-4}&=\\frac{3(x-4)}{(x-4)(x+3)}-\\frac{2(x+3)}{(x-4)(x+3)}\\\\&=\\frac{3x-12-2x-6}{(x-4)(x+3)}\\\\&=\\frac{x-18}{(x-4)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p32-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{6}{2x-1}-\\dfrac{3}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-21}{(x-4)(2x-1)}$",
          "worked": "$$\\begin{align*}\\frac{6}{2x-1}-\\frac{3}{x-4}&=\\frac{6(x-4)}{(x-4)(2x-1)}-\\frac{3(2x-1)}{(x-4)(2x-1)}\\\\&=\\frac{6x-24-6x+3}{(x-4)(2x-1)}\\\\&=\\frac{-21}{(x-4)(2x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p32-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{4}{x-5}+\\dfrac{2}{3x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(7x-13)}{(x-5)(3x-4)}$",
          "worked": "$$\\begin{align*}\\frac{4}{x-5}+\\frac{2}{3x-4}&=\\frac{4(3x-4)}{(x-5)(3x-4)}+\\frac{2(x-5)}{(x-5)(3x-4)}\\\\&=\\frac{12x-16+2x-10}{(x-5)(3x-4)}\\\\&=\\frac{14x-26}{(x-5)(3x-4)}\\\\&=\\frac{2(7x-13)}{(x-5)(3x-4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p32-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{5}{2x-1}-\\dfrac{6}{x+7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{41-7x}{(x+7)(2x-1)}$",
          "worked": "$$\\begin{align*}\\frac{5}{2x-1}-\\frac{6}{x+7}&=\\frac{5(x+7)}{(x+7)(2x-1)}-\\frac{6(2x-1)}{(x+7)(2x-1)}\\\\&=\\frac{5x+35-12x+6}{(x+7)(2x-1)}\\\\&=\\frac{41-7x}{(x+7)(2x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p32-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{8}{3x-2}-\\dfrac{3}{1-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{14-17x}{(1-x)(3x-2)}$",
          "worked": "$$\\begin{align*}\\frac{8}{3x-2}-\\frac{3}{1-x}&=\\frac{8(1-x)}{(1-x)(3x-2)}-\\frac{3(3x-2)}{(1-x)(3x-2)}\\\\&=\\frac{8-8x-9x+6}{(1-x)(3x-2)}\\\\&=\\frac{14-17x}{(1-x)(3x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
