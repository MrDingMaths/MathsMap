  "content": {
    "id": "p40-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The original asking price for a farm dropped by 30% a year ago, but did not attract a buyer. The price has now been further reduced by 15%.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "By what percentage has the original asking price been reduced?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "40.5%.",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=0.70\\times0.85\\\\\\text{Combined multiplier}&=0.595\\\\\\text{Percentage reduction}&=100\\%-59.5\\%\\\\\\text{Percentage reduction}&=40.5\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p40-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "If the farm is now for sale at $\\$2677500$, what was the original asking price of the farm?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$4500000$",
          "worked": "$$\\begin{align*}\\text{Original price}&=2677500\\div(0.70\\times0.85)\\\\\\text{Original price}&=2677500\\div0.595\\\\\\text{Original price}&=\\$4500000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
