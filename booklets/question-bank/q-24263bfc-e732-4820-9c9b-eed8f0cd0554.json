  "content": {
    "id": "p5-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Factorise each of the following expressions by recognising each as a perfect square:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^2+6a+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+3)^2$",
          "worked": "$$\\begin{align*}a^2+6a+9&=a^2+2(a)(3)+3^2\\\\a^2+6a+9&=(a+3)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-10x+25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)^2$",
          "worked": "$$\\begin{align*}x^2-10x+25&=x^2-2(x)(5)+5^2\\\\x^2-10x+25&=(x-5)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$m^2+8m+16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m+4)^2$",
          "worked": "$$\\begin{align*}m^2+8m+16&=m^2+2(m)(4)+4^2\\\\m^2+8m+16&=(m+4)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-12x+36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-6)^2$",
          "worked": "$$\\begin{align*}x^2-12x+36&=x^2-2(x)(6)+6^2\\\\x^2-12x+36&=(x-6)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$9a^2+6a+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3a+1)^2$",
          "worked": "$$\\begin{align*}9a^2+6a+1&=(3a)^2+2(3a)(1)+1^2\\\\9a^2+6a+1&=(3a+1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p5-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$16x^2-8x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x-1)^2$",
          "worked": "$$\\begin{align*}16x^2-8x+1&=(4x)^2-2(4x)(1)+1^2\\\\16x^2-8x+1&=(4x-1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p5-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$9x^2+24xy+16y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+4y)^2$",
          "worked": "$$\\begin{align*}9x^2+24xy+16y^2&=(3x)^2+2(3x)(4y)+(4y)^2\\\\9x^2+24xy+16y^2&=(3x+4y)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$25x^2-30xy+9y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5x-3y)^2$",
          "worked": "$$\\begin{align*}25x^2-30xy+9y^2&=(5x)^2-2(5x)(3y)+(3y)^2\\\\25x^2-30xy+9y^2&=(5x-3y)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$m^2-m+\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(m-\\frac12\\right)^2$",
          "worked": "$$\\begin{align*}m^2-m+\\frac14&=m^2-2(m)\\left(\\frac12\\right)+\\left(\\frac12\\right)^2\\\\m^2-m+\\frac14&=\\left(m-\\frac12\\right)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{m^2}{9}-\\frac{2m}{3}+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac m3-1\\right)^2$",
          "worked": "$$\\begin{align*}\\frac{m^2}{9}-\\frac{2m}{3}+1&=\\left(\\frac m3\\right)^2-2\\left(\\frac m3\\right)(1)+1^2\\\\\\frac{m^2}{9}-\\frac{2m}{3}+1&=\\left(\\frac m3-1\\right)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p5-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$x^4-18x^2+81$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2(x+3)^2$\n\nRecognise $(x^2-9)^2$, then factorise $x^2-9$.",
          "worked": "$$\\begin{align*}x^4-18x^2+81&=(x^2)^2-2(x^2)(9)+9^2\\\\x^4-18x^2+81&=(x^2-9)^2\\\\x^4-18x^2+81&=[(x-3)(x+3)]^2\\\\x^4-18x^2+81&=(x-3)^2(x+3)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$a^4-50a^2+625$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-5)^2(a+5)^2$\n\nRecognise $(a^2-25)^2$, then factorise $a^2-25$.",
          "worked": "$$\\begin{align*}a^4-50a^2+625&=(a^2)^2-2(a^2)(25)+25^2\\\\a^4-50a^2+625&=(a^2-25)^2\\\\a^4-50a^2+625&=[(a-5)(a+5)]^2\\\\a^4-50a^2+625&=(a-5)^2(a+5)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
