        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(A\\mid\\overline{B})=\\dfrac15$.\n\nSubtract $P(A\\cap B)$ from $P(A)$, then divide by $P(\\overline{B})$.",
          "worked": "$$\\begin{align*}P(B)&=\\frac12P(A)\\\\P(B)&=\\frac18\\\\P(A\\cap\\overline{B})&=P(A)-P(A\\cap B)\\\\P(A\\cap\\overline{B})&=\\frac14-\\frac3{10}\\times\\frac14\\\\P(A\\cap\\overline{B})&=\\frac7{40}\\\\P(\\overline{B})&=1-\\frac18\\\\P(\\overline{B})&=\\frac78\\\\P(A\\mid\\overline{B})&=\\frac{P(A\\cap\\overline{B})}{P(\\overline{B})}\\\\P(A\\mid\\overline{B})&=\\frac{7/40}{7/8}\\\\P(A\\mid\\overline{B})&=\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 92
