  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "For what value of $k$ will these pairs of simultaneous equations have no solution?",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=-4x-7\\\\y&=kx+2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-4$.",
          "worked": "For no solution, the gradients must be equal and the intercepts different.\n$$k=-4$$\nThe intercepts are $-7$ and $2$, so the lines are distinct and parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=kx+4\\\\3x-2y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\frac32$.",
          "worked": "$$\\begin{aligned}3x-2y&=5\\\\2y&=3x-5\\\\y&=\\frac32x-\\frac52\\end{aligned}$$\nEqual gradients require $k=\\frac32$. The intercepts $4$ and $-\\frac52$ differ, so there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}kx-3y&=k\\\\y&=4x+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=12$.",
          "worked": "$$\\begin{aligned}kx-3y&=k\\\\3y&=kx-k\\\\y&=\\frac{k}{3}x-\\frac{k}{3}\\end{aligned}$$\nEqual gradients require\n$$\\begin{aligned}\\frac{k}{3}&=4\\\\k&=12\\end{aligned}$$\nThe intercepts are then $-4$ and $1$, so the lines are distinct and parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
