  "content": {
    "id": "p6-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Consider a triangle $\\triangle XYZ$ with vertices $X(0,-4)$, $Y(4,2)$ and $Z(-2,6)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p6-q5-coordinate-scaffold",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 6, p6-q5-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,black,line width=0.5pt] (-2.7,0)--(2.7,0) node[right] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-2.7)--(0,2.7) node[above] {$y$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 6,
          "sourceRegion": "Question 5, blank coordinate scaffold below the parts on the left",
          "description": "Two perpendicular Cartesian axes with arrowheads at both ends and positive-end x and y labels; no origin label, ticks, grid or plotted triangle.",
          "mathematics": "Unscaled blank Cartesian coordinate cue; no numerical bounds are supplied.",
          "answerVisibility": "Permanent blank scaffold in the question; supplied calculations appear only in answers."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p6-q5-part-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the side lengths.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$XY=YZ=2\\sqrt{13}$ units; $XZ=2\\sqrt{26}$ units.",
          "worked": "$$\\begin{align*}XY&=\\sqrt{(4-0)^2+(2-(-4))^2}\\\\XY&=\\sqrt{52}=2\\sqrt{13}\\\\YZ&=\\sqrt{(-2-4)^2+(6-2)^2}\\\\YZ&=\\sqrt{52}=2\\sqrt{13}\\\\XZ&=\\sqrt{(-2-0)^2+(6-(-4))^2}\\\\XZ&=\\sqrt{104}=2\\sqrt{26}\\end{align*}$$\nAll lengths are in units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p6-q5-part-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\triangle XYZ$ is a right-angled isosceles triangle by showing that its side lengths satisfy Pythagoras’ theorem.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$XY=YZ$ and $XY^2+YZ^2=52+52=104=XZ^2$. The triangle is isosceles and right-angled at $Y$.",
          "worked": "$XY=YZ=2\\sqrt{13}$, so $\\triangle XYZ$ is isosceles.\n$$\\begin{align*}XY^2+YZ^2&=52+52\\\\XY^2+YZ^2&=104\\\\XZ^2&=104\\end{align*}$$\nThus $XY^2+YZ^2=XZ^2$. By the converse of Pythagoras’ theorem, $\\triangle XYZ$ is right-angled at $Y$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p6-q5-part-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find the area of $\\triangle XYZ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26$ square units.",
          "worked": "$XY\\perp YZ$, so these sides are the base and perpendicular height.\n$$\\begin{align*}A&=\\frac12(XY)(YZ)\\\\A&=\\frac12(2\\sqrt{13})(2\\sqrt{13})\\\\A&=26\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
