            {
              "type": "text",
              "text": "Annie collected data on the length of time, in minutes, that people spent in a coffee shop one morning. The times are shown below:",
              "marks": []
            }
          ]
        },
        {
          "id": "p73-q4-data",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
