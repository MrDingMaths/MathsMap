  "content": {
    "id": "p41-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A sphere and a cube both have a volume equal to $1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q16a",
        "type": "part",
        "label": "a",
        "prompt": "Find the surface area of the sphere.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[3]{36\\pi}$.",
          "worked": "$$\\begin{align*}\\frac43\\pi r^3&=1\\\\r^3&=\\frac{3}{4\\pi}\\\\r&=\\sqrt[3]{\\frac{3}{4\\pi}}\\\\A_{\\text{sphere}}&=4\\pi\\left(\\frac{3}{4\\pi}\\right)^{2/3}\\\\A_{\\text{sphere}}&=\\sqrt[3]{36\\pi}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p41-q16b",
        "type": "part",
        "label": "b",
        "prompt": "Find the surface area of the cube.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$.",
          "worked": "Let the cube's edge length be $s$.\n$$\\begin{align*}s^3&=1\\\\s&=1\\\\A_{\\text{cube}}&=6(1)^2\\\\A_{\\text{cube}}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p41-q16c",
        "type": "part",
        "label": "c",
        "prompt": "Which has the smaller surface area, the sphere or the cube? Answer this without using your calculator.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The sphere.\n\nSince $\\pi<6$, $\\sqrt[3]{36\\pi}<\\sqrt[3]{216}=6$.",
          "worked": "Since $\\pi<4<6$, we have $36\\pi<216$. Therefore,\n$$\\sqrt[3]{36\\pi}<\\sqrt[3]{216}=6.$$\nThe sphere has the smaller surface area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
