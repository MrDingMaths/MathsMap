  "content": {
    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A card is selected from a standard deck of 52 playing cards (4 suits, no jokers).\n\nLet $A$ be the event 'the card is a diamond' and $B$ be the event 'the card is a jack'.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q5-a",
        "type": "group",
        "label": "a",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q5-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(A)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{4}$",
              "worked": "There are 13 diamonds.\n\n$$\\begin{aligned}P(A)&=\\frac{13}{52}\\\\P(A)&=\\frac{1}{4}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p24-q5-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(A')$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{3}{4}$",
              "worked": "$$\\begin{aligned}P(A')&=1-P(A)\\\\P(A')&=1-\\frac{1}{4}\\\\P(A')&=\\frac{3}{4}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p24-q5-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(A\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{52}$",
              "worked": "The jack of diamonds is the only card in both events.\n\n$$P(A\\cap B)=\\frac{1}{52}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p24-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the addition rule to find $P(A\\cup B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{13}$",
          "worked": "$$\\begin{aligned}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=\\frac{13}{52}+\\frac{4}{52}-\\frac{1}{52}\\\\P(A\\cup B)&=\\frac{4}{13}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the probability that the card is a jack or not a diamond.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{13}$",
          "worked": "There are 39 cards that are not diamonds and 3 jacks that are not diamonds.\n\n$$\\begin{aligned}P(B\\cup A')&=P(B)+P(A')-P(B\\cap A')\\\\P(B\\cup A')&=\\frac{4}{52}+\\frac{39}{52}-\\frac{3}{52}\\\\P(B\\cup A')&=\\frac{10}{13}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
