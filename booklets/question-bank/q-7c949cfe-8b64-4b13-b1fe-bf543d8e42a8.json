  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "On a particular road map, a distance of 0.5 cm on the map represents an actual distance of 8 km. What actual distance would a distance of 6.5 cm on the map represent?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$104\\text{ km}$",
      "worked": "Let $d$ be the actual distance in kilometres and $x$ the map distance in centimetres. Since $d$ is directly proportional to $x$,\n$$\\begin{align*}d &= kx\\\\8 &= k\\times0.5\\\\k &= \\frac{8}{0.5}\\\\k &= 16\\\\d &= 16\\times6.5\\\\d &= 104\\end{align*}$$\nThe actual distance is $104\\text{ km}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
