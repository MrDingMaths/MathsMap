  "content": {
    "id": "p24-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "How many circular arrangements of the word **HILBERT** are there if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6!=720$",
          "worked": "There are seven distinct letters.\n$$\\begin{align*}N&=(7-1)!\\\\N&=6!\\\\N&=720\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "B, E and R are together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3!\\times4!=144$",
          "worked": "Treat B, E and R as one block. With H, I, L and T, there are five circular entities. The three letters within the block have $3!$ orders.\n$$\\begin{align*}N&=(5-1)!\\times3!\\\\N&=4!\\times3!\\\\N&=144\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "H and T are not together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p24-q10-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "6!-2!\\times5!=480",
                    "display": false
                  }
                ]
              },
              {
                "id": "p24-q10-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Subtract arrangements with H and T together from all arrangements.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "There are $6!$ unrestricted circular arrangements. When H and T are together, their block and the other five letters form six entities, with $2!$ internal block orders.\n$$\\begin{align*}N&=6!-2!\\times(6-1)!\\\\N&=720-240\\\\N&=480\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
