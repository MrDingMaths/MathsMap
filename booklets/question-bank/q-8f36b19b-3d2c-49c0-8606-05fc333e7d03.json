  "content": {
    "id": "p53-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Without division, find which of the following are factors of $F(x)=x^4-2x^3-25x^2+26x+120$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{aligned}F(2)&=2^4-2(2)^3-25(2)^2+26(2)+120\\\\&=88\\ne0\\end{aligned}$$\nTherefore $x-2$ is not a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p53-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{aligned}F(-2)&=(-2)^4-2(-2)^3-25(-2)^2+26(-2)+120\\\\&=0\\end{aligned}$$\nTherefore $x+2$ is a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p53-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{aligned}F(-3)&=(-3)^4-2(-3)^3-25(-3)^2+26(-3)+120\\\\&=-48\\ne0\\end{aligned}$$\nTherefore $x+3$ is not a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p53-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{aligned}F(4)&=4^4-2(4)^3-25(4)^2+26(4)+120\\\\&=-48\\ne0\\end{aligned}$$\nTherefore $x-4$ is not a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p53-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{aligned}F(-4)&=(-4)^4-2(-4)^3-25(-4)^2+26(-4)+120\\\\&=0\\end{aligned}$$\nTherefore $x+4$ is a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p53-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$x-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{aligned}F(5)&=5^4-2(5)^3-25(5)^2+26(5)+120\\\\&=0\\end{aligned}$$\nTherefore $x-5$ is a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
