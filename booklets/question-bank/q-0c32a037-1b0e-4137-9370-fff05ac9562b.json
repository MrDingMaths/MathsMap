        "id": "p60-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(x)=xe^{-x^2}$ is an odd function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-xe^{-x^2}=-f(x)$, so $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)e^{-(-x)^2}\\\\&=-xe^{-x^2}\\\\&=-f(x).\\end{align*}$$\nTherefore $f$ is an odd function.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p60-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence evaluate $\\displaystyle\\int_{-\\sqrt{2}}^{\\sqrt{2}}xe^{-x^2}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "Since $f(x)=xe^{-x^2}$ is odd and the limits are symmetric about $0$,\n$$\\int_{-\\sqrt{2}}^{\\sqrt{2}}xe^{-x^2}\\,dx=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
