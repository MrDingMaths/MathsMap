                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac{1}{2}(x+3),\\quad x>-1$.",
              "worked": "$$\\begin{align*}\\frac{1}{2}(x+3)&>1\\\\x+3&>2\\\\x&>-1\\end{align*}$$\nThus $y=\\frac{1}{2}(x+3)$, with domain $x>-1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p11-q10-b",
