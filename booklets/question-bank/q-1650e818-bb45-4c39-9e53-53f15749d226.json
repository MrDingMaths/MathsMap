                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Find the inverse of",
                      "marks": []
                    },
                    {
                      "type": "break"
                    },
                    {
                      "type": "math",
                      "latex": "y=2x-3",
                      "display": false
                    },
                    {
                      "type": "text",
                      "text": ", where ",
                      "marks": []
                    },
                    {
                      "type": "math",
                      "latex": "x>1",
                      "display": false
                    }
                  ]
                },
                {
                  "id": "p11-q9-a-scaffold",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "x=2y-3,\\quad y>1",
                      "display": false,
                      "colour": "#268cff"
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac{x+3}{2},\\quad y>1$",
              "worked": "$$\\begin{align*}x&=2y-3,\\quad y>1\\\\x+3&=2y\\\\y&=\\frac{x+3}{2},\\quad y>1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p11-q9-b",
            "type": "part",
            "label": "b",
            "prompt": "Find the inverse of\n$y=3x-10$, where $x<2$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac{x+10}{3},\\quad y<2$",
              "worked": "$$\\begin{align*}x&=3y-10,\\quad y<2\\\\x+10&=3y\\\\y&=\\frac{x+10}{3},\\quad y<2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p11-q9-c",
            "type": "part",
            "label": "c",
            "prompt": "Find the inverse of\n$y=x^3+2$, where $x<3$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\sqrt[3]{x-2},\\quad y<3$",
              "worked": "$$\\begin{align*}x&=y^3+2,\\quad y<3\\\\x-2&=y^3\\\\y&=\\sqrt[3]{x-2},\\quad y<3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p11-q9-d",
            "type": "part",
            "label": "d",
            "prompt": "Find the inverse of\n$y=13-6x$, where $x\\geq3$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac{13-x}{6},\\quad y\\geq3$",
              "worked": "$$\\begin{align*}x&=13-6y,\\quad y\\geq3\\\\6y&=13-x\\\\y&=\\frac{13-x}{6},\\quad y\\geq3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      },
      {
        "id": "p11-q10-root",
        "type": "group",
        "label": null,
        "prompt": "For each of parts a–d, the inverse has a restriction in terms of $y$. By solving the inequality, rewrite the restriction in terms of $x$.",
        "layout": "grid",
