        "type": "part",
        "label": "a",
        "prompt": "Use the product rule to show that if $y=x(x-2)^3$, then $y'=2(2x-1)(x-2)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x-2)^3+3x(x-2)^2=2(2x-1)(x-2)^2$.",
          "worked": "$$\\begin{align*}y'&=1\\cdot(x-2)^3+x\\cdot3(x-2)^2\\\\y'&=(x-2)^2\\bigl[(x-2)+3x\\bigr]\\\\y'&=(x-2)^2(4x-2)\\\\y'&=2(2x-1)(x-2)^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
