  "content": {
    "id": "p6-q13-root",
    "type": "question",
    "label": null,
    "prompt": "If $x=1$, find the value of $3^x+3^{1-x}+3^{x-2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{13}{3}$",
      "worked": "For $x=1$:\n\n$\\begin{align*}3^x+3^{1-x}+3^{x-2}&=3^1+3^0+3^{-1}\\\\3^x+3^{1-x}+3^{x-2}&=3+1+\\frac13\\\\3^x+3^{1-x}+3^{x-2}&=\\frac{13}{3}\\end{align*}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
