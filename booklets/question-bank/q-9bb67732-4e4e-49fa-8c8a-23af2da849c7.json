  "content": {
    "id": "p34-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A parabola has vertex $(2,-4)$ and passes through the point $(1,7)$. Find its equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=11(x-2)^2-4$",
      "worked": "The vertex gives the form $y=a(x-2)^2-4$. Substituting $(1,7)$:\n$$\\begin{align*}7&=a(1-2)^2-4\\\\7&=a-4\\\\a&=11\\\\y&=11(x-2)^2-4\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
