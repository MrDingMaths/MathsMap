  "content": {
    "id": "p8-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Three-letter codes are formed from the letters of the word RINGS. Find the number of possible codes if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^5P_3=60$",
          "worked": "Choose three distinct letters in order.\n$$\\begin{align*}N&={}^5P_3\\\\N&=5\\times4\\times3\\\\N&=60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "the letter I is chosen.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times4\\times3=36$",
          "worked": "Choose one of the three positions for I. Fill the other two positions with distinct letters from the remaining four.\n$$\\begin{align*}N&=3\\times4\\times3\\\\N&=36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "the letters are in alphabetical order.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^5P_3\\times\\dfrac{1}{3!}=10$",
          "worked": "For each selection of three letters, exactly one of its $3!$ orders is alphabetical.\n$$\\begin{align*}N&=\\frac{{}^5P_3}{3!}\\\\N&=\\frac{60}{6}\\\\N&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
