  "content": {
    "id": "p32-q2",
    "type": "question",
    "label": "2",
    "prompt": "Convert these units of speed to kilometres per hour.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$8\\text{ m/s}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28.8\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{speed}&=\\frac{8\\text{ m}}{1\\text{ s}}\\\\\\text{speed}&=\\frac{(8\\div1000)\\text{ km}}{(1\\div60\\div60)\\text{ h}}\\\\\\text{speed}&=28.8\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$15\\text{ m/s}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$54\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{speed}&=\\frac{15\\text{ m}}{1\\text{ s}}\\\\\\text{speed}&=\\frac{(15\\div1000)\\text{ km}}{(1\\div60\\div60)\\text{ h}}\\\\\\text{speed}&=54\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$12.5\\text{ m/s}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{speed}&=\\frac{12.5\\text{ m}}{1\\text{ s}}\\\\\\text{speed}&=\\frac{(12.5\\div1000)\\text{ km}}{(1\\div60\\div60)\\text{ h}}\\\\\\text{speed}&=45\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$25\\text{ m/s}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{speed}&=\\frac{25\\text{ m}}{1\\text{ s}}\\\\\\text{speed}&=\\frac{(25\\div1000)\\text{ km}}{(1\\div60\\div60)\\text{ h}}\\\\\\text{speed}&=90\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
