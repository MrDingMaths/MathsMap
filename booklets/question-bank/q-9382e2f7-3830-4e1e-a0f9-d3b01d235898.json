  "content": {
    "id": "p25-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Show that each of the following functions are surjective:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$f:\\mathbb{R}\\to\\mathbb{R}$ where $f(x)=4x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surjective: each $y\\in\\mathbb{R}$ has preimage $x=\\dfrac{y-5}{4}$.",
          "worked": "Let $y\\in\\mathbb{R}$. Choose $x=\\dfrac{y-5}{4}\\in\\mathbb{R}$. Then\n$$\\begin{align*}f(x)&=4\\left(\\frac{y-5}{4}\\right)+5\\\\f(x)&=y.\\end{align*}$$\nEvery real number has a preimage, so $f$ is surjective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p25-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$f:\\mathbb{Z}\\to\\mathbb{Z}$ where $f(n)=n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surjective: each $m\\in\\mathbb{Z}$ has preimage $n=m-1$.",
          "worked": "Let $m\\in\\mathbb{Z}$. Choose $n=m-1\\in\\mathbb{Z}$. Then\n$$\\begin{align*}f(n)&=(m-1)+1\\\\f(n)&=m.\\end{align*}$$\nEvery integer has a preimage, so $f$ is surjective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p25-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$f:\\{1,2,3\\}\\to\\{1,2,3\\}$ where $f=\\{(1,2),(2,3),(3,1)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surjective: $f(3)=1$, $f(1)=2$ and $f(2)=3$.",
          "worked": "The codomain is $\\{1,2,3\\}$, and\n$$\\begin{align*}f(3)&=1,\\\\f(1)&=2,\\\\f(2)&=3.\\end{align*}$$\nEvery element of the codomain has a preimage, so $f$ is surjective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p25-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$f:\\mathbb{R}\\to\\mathbb{R}$ where $f(x)=x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surjective: each $y\\in\\mathbb{R}$ has preimage $x=\\sqrt[3]{y}$.",
          "worked": "Let $y\\in\\mathbb{R}$. Choose $x=\\sqrt[3]{y}\\in\\mathbb{R}$. Then\n$$\\begin{align*}f(x)&=\\left(\\sqrt[3]{y}\\right)^3\\\\f(x)&=y.\\end{align*}$$\nEvery real number has a preimage, so $f$ is surjective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p25-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$f:\\mathbb{R}\\to[0,\\infty)$ where $f(x)=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surjective: each $y\\in[0,\\infty)$ has preimage $x=\\sqrt{y}$.",
          "worked": "Let $y\\in[0,\\infty)$. Choose $x=\\sqrt{y}\\in\\mathbb{R}$. Then\n$$\\begin{align*}f(x)&=\\left(\\sqrt{y}\\right)^2\\\\f(x)&=y.\\end{align*}$$\nEvery element of $[0,\\infty)$ has a preimage, so $f$ is surjective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
