  "content": {
    "id": "p13-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Factorise each of the following expressions by grouping in pairs:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^3+2x^2-25x-50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x-5)(x+5)$",
          "worked": "$$\\begin{align*}x^3+2x^2-25x-50&=x^2(x+2)-25(x+2)\\\\x^3+2x^2-25x-50&=(x+2)(x^2-25)\\\\x^3+2x^2-25x-50&=(x+2)(x-5)(x+5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^3+2x^2-4x-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(x+2)^2$",
          "worked": "$$\\begin{align*}x^3+2x^2-4x-8&=x^2(x+2)-4(x+2)\\\\x^3+2x^2-4x-8&=(x+2)(x^2-4)\\\\x^3+2x^2-4x-8&=(x+2)(x-2)(x+2)\\\\x^3+2x^2-4x-8&=(x-2)(x+2)^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^3+3x^2-9x-27$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x+3)^2$",
          "worked": "$$\\begin{align*}x^3+3x^2-9x-27&=x^2(x+3)-9(x+3)\\\\x^3+3x^2-9x-27&=(x+3)(x^2-9)\\\\x^3+3x^2-9x-27&=(x+3)(x-3)(x+3)\\\\x^3+3x^2-9x-27&=(x-3)(x+3)^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^3-3x^2-25x+75$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x-5)(x+5)$",
          "worked": "$$\\begin{align*}x^3-3x^2-25x+75&=x^2(x-3)-25(x-3)\\\\x^3-3x^2-25x+75&=(x-3)(x^2-25)\\\\x^3-3x^2-25x+75&=(x-3)(x-5)(x+5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
