                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}na&=-\\frac{10}{3}\\\\\\frac{n(n-1)}{2}a^2&=5\\end{aligned}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p23-q24-b-division",
                "type": "paragraph",
