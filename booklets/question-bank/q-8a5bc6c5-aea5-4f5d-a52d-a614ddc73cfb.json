  "content": {
    "id": "p23-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "The expression $(1+ax)^n$ is expanded in increasing powers of $x$.\nFind the values of $a$ and $n$ if the first three terms are:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "$1+28x+364x^2+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2,\\ n=14$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p23-q24-a-expansion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(1+ax)^n=1+nax+\\frac{n(n-1)}{2}a^2x^2+\\cdots",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p23-q24-a-coefficients",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Equating coefficients of ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "x^2",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ":",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p23-q24-a-coefficient-equations",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}na&=28\\\\\\frac{n(n-1)}{2}a^2&=364\\end{aligned}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p23-q24-a-division",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Dividing the second equation by the first:",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p23-q24-a-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{(n-1)a}{2}&=\\frac{364}{28}\\\\\\frac{(n-1)a}{2}&=13\\\\(n-1)a&=26\\\\na-a&=26\\\\28-a&=26\\\\a&=2\\\\n&=\\frac{28}{2}\\\\n&=14\\end{aligned}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
