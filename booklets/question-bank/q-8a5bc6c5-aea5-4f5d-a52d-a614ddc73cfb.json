                  }
                ]
              },
              {
                "id": "p23-q24-b-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{(n-1)a}{2}&=\\frac{5}{-\\frac{10}{3}}\\\\\\frac{(n-1)a}{2}&=-\\frac32\\\\(n-1)a&=-3\\\\na-a&=-3\\\\-\\frac{10}{3}-a&=-3\\\\a&=-\\frac13\\\\n&=\\frac{-\\frac{10}{3}}{-\\frac{1}{3}}\\\\n&=10\\end{aligned}",
                    "display": false,
