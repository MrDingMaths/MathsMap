  "content": {
    "id": "p17-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The quantity $y$ is directly proportional to $x$ and the cube of $z$. If $y=108$ when $x=3$ and $z=2$, find $x$ when $y=24$ and $z=\\frac{1}{2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\dfrac{128}{3}$.",
      "worked": "Since $y\\propto xz^3$, write $y=kxz^3$.\n$$\\begin{align*}108&=k\\times3\\times2^3\\\\108&=24k\\\\k&=\\frac{9}{2}\\end{align*}$$\nThus $y=\\frac{9}{2}xz^3$. When $y=24$ and $z=\\frac12$,\n$$\\begin{align*}24&=\\frac92\\times x\\times\\left(\\frac12\\right)^3\\\\24&=\\frac{9x}{16}\\\\x&=24\\times\\frac{16}{9}\\\\x&=\\frac{128}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 58
  },
