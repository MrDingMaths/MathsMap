  "content": {
    "id": "p4-q8",
    "type": "question",
    "label": "8",
    "prompt": "Consider the piece-wise defined function\n$$f(x)=\\begin{cases}2-x,&x<-2,\\\\4,&-2\\le x\\le2,\\\\x+2,&x>2.\\end{cases}$$\nFind the following.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Since $-2\\le0\\le2$, $f(0)=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p4-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "Since $5>2$, use $f(x)=x+2$.\n$$\\begin{align*}f(5)&=5+2\\\\f(5)&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Since $-3<-2$, use $f(x)=2-x$.\n$$\\begin{align*}f(-3)&=2-(-3)\\\\f(-3)&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(3)-f(-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Use $f(3)=3+2$ and $f(-1)=4$.\n$$\\begin{align*}f(3)-f(-1)&=(3+2)-4\\\\f(3)-f(-1)&=5-4\\\\f(3)-f(-1)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
