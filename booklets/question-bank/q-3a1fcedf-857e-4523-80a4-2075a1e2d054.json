      {
        "id": "p20-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $A$ and $B$ such that $Am^2+B(m-1)^2=2m-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=1$, $B=-1$.",
          "worked": "$$\\begin{align*}Am^2+B(m-1)^2&=(A+B)m^2-2Bm+B.\n\\end{align*}$$\nEquating coefficients with $2m-1$ gives\n$$\\begin{align*}A+B&=0\\\\-2B&=2\\\\B&=-1\\\\A&=1.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the sum of $1+3+5+\\cdots+61$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$961$.\n\nUse $2m-1=m^2-(m-1)^2$ so that consecutive square terms cancel.",
          "worked": "From part a, $2m-1=m^2-(m-1)^2$. The last term satisfies\n$$\\begin{align*}2m-1&=61\\\\m&=31.\n\\end{align*}$$\nThus\n$$\\begin{align*}1+3+5+\\cdots+61&=(1^2-0^2)+(2^2-1^2)+\\cdots+(31^2-30^2)\\\\1+3+5+\\cdots+61&=31^2-0^2\\\\1+3+5+\\cdots+61&=961.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
