  "content": {
    "id": "v2-2e5df0-p5-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "For the polynomial $P(x)=(a+2)x^3+(a+b)x^2+(b-c)x+9$, find $a$, $b$, $c$ given that:\n\nThe degree is 2, the leading coefficient is 5, and there is no $x$ term.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-2,\\ b=7,\\ c=7$.",
      "worked": "The degree is 2, so the coefficient of $x^3$ is zero. The leading coefficient is the coefficient of $x^2$. There is no $x$ term, so its coefficient is zero.\n\n$$\\begin{align*}a+2&=0\\\\a&=-2\\\\a+b&=5\\\\-2+b&=5\\\\b&=7\\\\b-c&=0\\\\c&=7\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
