  "content": {
    "id": "v2-b2ef9-p32-practice-slot-15-root",
    "type": "question",
    "label": null,
    "prompt": "The line $y=-2x+2$ meets the cubic $y=x^3-5x^2+4x$ at $F(1,0)$ and also at points $A$ and $B$. Let $\\alpha$ and $\\beta$ be the $x$-coordinates of $A$ and $B$, respectively.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b2ef9-p32-practice-slot-15-slot-15-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\alpha$ and $\\beta$ satisfy $x^3-5x^2+6x-2=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3-5x^2+6x-2=0$.",
          "worked": "$$\\begin{align*}x^3-5x^2+4x&=-2x+2\\\\x^3-5x^2+6x-2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-b2ef9-p32-practice-slot-15-slot-15-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\alpha+\\beta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha+\\beta=4$.",
          "worked": "The third root is $1$, from $F(1,0)$. Using the sum of roots,\n$$\\begin{align*}\\alpha+\\beta+1&=5\\\\\\alpha+\\beta&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-b2ef9-p32-practice-slot-15-slot-15-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\alpha\\beta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha\\beta=2$.",
          "worked": "Using the product of the three roots,\n$$\\begin{align*}\\alpha\\beta(1)&=-\\frac{-2}{1}\\\\\\alpha\\beta&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-b2ef9-p32-practice-slot-15-slot-15-d",
        "type": "part",
        "label": "d",
        "prompt": "Use the identity $(\\alpha-\\beta)^2=(\\alpha+\\beta)^2-4\\alpha\\beta$ to show that the horizontal distance $|\\alpha-\\beta|$ between $A$ and $B$ is $2\\sqrt{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\alpha-\\beta|=2\\sqrt{2}$.",
          "worked": "$$\\begin{align*}(\\alpha-\\beta)^2&=(\\alpha+\\beta)^2-4\\alpha\\beta\\\\&=4^2-4(2)\\\\&=8\\\\|\\alpha-\\beta|&=\\sqrt8\\\\&=2\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-b2ef9-p32-practice-slot-15-slot-15-e",
        "type": "part",
        "label": "e",
        "prompt": "Hence find the exact length of $AB$ using the horizontal distance and the gradient.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=2\\sqrt{10}$.",
          "worked": "The gradient is $-2$, so the vertical distance is $2(2\\sqrt2)=4\\sqrt2$. By Pythagoras,\n$$\\begin{align*}AB&=\\sqrt{(2\\sqrt2)^2+(4\\sqrt2)^2}\\\\&=\\sqrt{8+32}\\\\&=\\sqrt{40}\\\\&=2\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
