        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"User-approved feedback 19 October 2026\"}\n\\begin{tikzpicture}[x=12mm,y=12mm,draw=black,text=black,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw (0,0) circle[radius=1];\n\\fill (0,0) circle[radius=0.5mm];\n\\draw[-latex] (0,0)--(1,0) node[midway,above] {$12\\,\\mathrm{m}$};\n\\end{tikzpicture}",
