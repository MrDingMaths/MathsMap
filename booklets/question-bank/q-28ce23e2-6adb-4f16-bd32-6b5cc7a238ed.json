  "content": {
    "id": "p50-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A group of 7 people sit around a table. In how many ways can they be arranged",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "with no restrictions",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$720$",
          "worked": "Fix one person's position to account for rotation. Arrange the remaining six people:\n$$\\begin{aligned}(7-1)!&=6!\\\\&=720.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p50-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "if 2 particular people want to sit together",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$240$",
          "worked": "Treat the pair as one unit. The six units can be arranged around the circle in $5!$ ways. The pair has $2!$ internal arrangements.\n$$\\begin{aligned}2!\\times5!&=2\\times120\\\\&=240.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p50-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "if 2 particular people cannot sit together",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$480$",
          "worked": "Subtract the arrangements with the specified pair together from all circular arrangements:\n$$\\begin{aligned}6!-2!\\times5!&=720-240\\\\&=480.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p50-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "if 3 particular people sit together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$144$",
          "worked": "Treat the three people as one unit. The five units can be arranged around the circle in $4!$ ways. The three people have $3!$ internal arrangements.\n$$\\begin{aligned}3!\\times4!&=6\\times24\\\\&=144.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
