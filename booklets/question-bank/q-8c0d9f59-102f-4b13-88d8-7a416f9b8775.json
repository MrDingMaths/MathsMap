  "content": {
    "id": "p26-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "If $a=-1\\frac{1}{4}$ and $b=3\\frac{1}{2}$, evaluate:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$a+b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\frac{1}{4}$",
          "worked": "$$\\begin{align*}a+b&=\\left(-\\frac{5}{4}\\right)+\\frac{7}{2}\\\\a+b&=-\\frac{5}{4}+\\frac{14}{4}\\\\a+b&=\\frac{9}{4}\\\\a+b&=2\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p26-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$a-b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4\\frac{3}{4}$",
          "worked": "$$\\begin{align*}a-b&=\\left(-\\frac{5}{4}\\right)-\\frac{7}{2}\\\\a-b&=-\\frac{5}{4}-\\frac{14}{4}\\\\a-b&=-\\frac{19}{4}\\\\a-b&=-4\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p26-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$b-a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\frac{3}{4}$",
          "worked": "$$\\begin{align*}b-a&=\\frac{7}{2}-\\left(-\\frac{5}{4}\\right)\\\\b-a&=\\frac{14}{4}+\\frac{5}{4}\\\\b-a&=\\frac{19}{4}\\\\b-a&=4\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p26-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4\\frac{3}{8}$",
          "worked": "$$\\begin{align*}ab&=\\left(-\\frac{5}{4}\\right)\\times\\frac{7}{2}\\\\ab&=-\\frac{35}{8}\\\\ab&=-4\\frac{3}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{a}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{5}{14}$",
          "worked": "$$\\begin{align*}\\frac{a}{b}&=\\left(-\\frac{5}{4}\\right)\\div\\frac{7}{2}\\\\\\frac{a}{b}&=-\\frac{5}{4}\\times\\frac{2}{7}\\\\\\frac{a}{b}&=-\\frac{5}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q19-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{b}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\frac{4}{5}$",
          "worked": "$$\\begin{align*}\\frac{b}{a}&=\\frac{7}{2}\\div\\left(-\\frac{5}{4}\\right)\\\\\\frac{b}{a}&=\\frac{7}{2}\\times\\left(-\\frac{4}{5}\\right)\\\\\\frac{b}{a}&=-\\frac{14}{5}\\\\\\frac{b}{a}&=-2\\frac{4}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p26-q19-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{a+2}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{14}$\n\nEvaluate the numerator first, then divide by $b$.",
          "worked": "$$\\begin{align*}\\frac{a+2}{b}&=\\frac{-\\frac{5}{4}+2}{\\frac{7}{2}}\\\\\\frac{a+2}{b}&=\\frac{\\frac{3}{4}}{\\frac{7}{2}}\\\\\\frac{a+2}{b}&=\\frac{3}{4}\\times\\frac{2}{7}\\\\\\frac{a+2}{b}&=\\frac{3}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p26-q19-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{b-a}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{5}{14}$\n\nEvaluate the numerator first, then divide by $b$.",
          "worked": "$$\\begin{align*}\\frac{b-a}{b}&=\\frac{\\frac{7}{2}-\\left(-\\frac{5}{4}\\right)}{\\frac{7}{2}}\\\\\\frac{b-a}{b}&=\\frac{\\frac{19}{4}}{\\frac{7}{2}}\\\\\\frac{b-a}{b}&=\\frac{19}{4}\\times\\frac{2}{7}\\\\\\frac{b-a}{b}&=\\frac{19}{14}\\\\\\frac{b-a}{b}&=1\\frac{5}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
