  "content": {
    "id": "v2-f5ff6-p11-practice-slot-6-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Find the degree of $Q(x)$ when",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-f5ff6-p11-practice-slot-6-upper-slot-6-upper-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)$ is cubic and $(P(x))^2\\times Q(x)$ has degree $11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$(P(x))^2$ has degree $3+3=6$. Then $6+\\deg Q=11$, so $Q(x)$ has degree $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-f5ff6-p11-practice-slot-6-upper-slot-6-upper-b",
        "type": "part",
        "label": "b",
        "prompt": "$(P(x))^2\\times Q(x)$ has degree $18$ and $P(x)\\times Q(x)$ has degree $11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}2p+q&=18\\\\p+q&=11\\\\p&=7\\\\q&=11-7=4\\end{align*}$$ where $p=\\deg P$ and $q=\\deg Q$. So $Q(x)$ has degree $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
