        "answer": {
          "short": "$0.0056\\times10^{8},\\quad 6.3\\times10^{5},\\quad 672\\,000$",
          "worked": "$$\\begin{aligned}6.3\\times10^{5}&=630\\,000\\\\0.0056\\times10^{8}&=560\\,000\\end{aligned}$$\n\n$560\\,000<630\\,000<672\\,000$.\n\nAscending order: $0.0056\\times10^{8},\\quad 6.3\\times10^{5},\\quad 672\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$0.000234,\\quad 2.341\\times10^{-3},\\quad 234.01\\times10^{-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.000234,\\quad 234.01\\times10^{-5},\\quad 2.341\\times10^{-3}$",
          "worked": "$$\\begin{aligned}2.341\\times10^{-3}&=0.002341\\\\234.01\\times10^{-5}&=0.0023401\\end{aligned}$$\n\n$0.000234<0.0023401<0.002341$.\n\nAscending order: $0.000234,\\quad 234.01\\times10^{-5},\\quad 2.341\\times10^{-3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
