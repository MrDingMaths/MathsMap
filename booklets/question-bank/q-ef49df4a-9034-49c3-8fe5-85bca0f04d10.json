    "id": "p11-ch7-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the $x$-intercepts of the graph for each equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-ch7-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+4x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,-3$",
          "worked": "At an $x$-intercept, $y=0$.\n$$\\begin{align*}0&=x^2+4x+3\\\\0&=(x+1)(x+3)\\\\x&=-1\\text{ or }-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-ch7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2x^2-11x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac12,6$",
          "worked": "At an $x$-intercept, $y=0$.\n$$\\begin{align*}0&=2x^2-11x-6\\\\0&=(2x+1)(x-6)\\\\x&=-\\frac12\\text{ or }6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-ch7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x+4)^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4\\pm\\sqrt3$",
          "worked": "At an $x$-intercept, $y=0$.\n$$\\begin{align*}0&=(x+4)^2-3\\\\(x+4)^2&=3\\\\x+4&=\\pm\\sqrt3\\\\x&=-4\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p11-ch7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=3(x-2)^2-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\pm\\sqrt2$",
          "worked": "At an $x$-intercept, $y=0$.\n$$\\begin{align*}0&=3(x-2)^2-6\\\\3(x-2)^2&=6\\\\(x-2)^2&=2\\\\x-2&=\\pm\\sqrt2\\\\x&=2\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
