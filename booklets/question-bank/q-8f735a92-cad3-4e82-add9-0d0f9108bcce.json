  "content": {
    "id": "p10-q22",
    "type": "question",
    "label": "22",
    "prompt": "How many different ways can 38 cookies be placed into bags of 3 or 4 so that there are no cookies left over?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "3 ways.",
      "worked": "Subtract 4 successively from 38 to find the possible numbers of cookies remaining for bags of 3:\n$$38,34,30,26,22,18,14,10,6,2.$$\nOnly $30$, $18$ and $6$ are multiples of 3. The corresponding combinations are:\n$$\\begin{align*}38&=10\\times3+2\\times4\\\\38&=6\\times3+5\\times4\\\\38&=2\\times3+8\\times4.\\end{align*}$$\nTherefore, there are 3 ways.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
