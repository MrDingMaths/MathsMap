                ]
              }
            ]
          },
          "worked": "For $\\sin\\theta\\ne0$:\n$$\\begin{align*}\n\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{\\sin\\theta(1+\\cos\\theta)}{(1-\\cos\\theta)(1+\\cos\\theta)}+\\frac{1-\\cos\\theta}{\\sin\\theta}\\\\\n\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{1+\\cos\\theta}{\\sin\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}\\\\\n\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{2}{\\sin\\theta}\\\\\n\\frac{\\sin\\theta}{1-\\cos\\theta}+\\frac{1-\\cos\\theta}{\\sin\\theta}&=2\\operatorname{cosec}\\theta.\n\\end{align*}$$",
