                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "For $\\cos\\theta\\ne0,-1$:\n$$\\begin{align*}\n\\frac{1-\\sec\\theta}{1+\\sec\\theta}&=\\frac{1-\\frac{1}{\\cos\\theta}}{1+\\frac{1}{\\cos\\theta}}\\\\\n\\frac{1-\\sec\\theta}{1+\\sec\\theta}&=\\frac{\\cos\\theta\\left(1-\\frac{1}{\\cos\\theta}\\right)}{\\cos\\theta\\left(1+\\frac{1}{\\cos\\theta}\\right)}\\\\\n\\frac{1-\\sec\\theta}{1+\\sec\\theta}&=\\frac{\\cos\\theta-1}{\\cos\\theta+1}.\n\\end{align*}$$",
