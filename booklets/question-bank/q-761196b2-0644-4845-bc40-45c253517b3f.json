  "content": {
    "id": "p32-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The probability of a woman being alive at 80 years of age is 0.2, and the probability of her husband being alive at 80 years of age is 0.05. Assume that these survival events are independent. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "they will both live to be 80 years of age,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.01$",
          "worked": "$$\\begin{align*}P(\\text{both alive at 80})&=0.2\\times0.05\\\\P(\\text{both alive at 80})&=0.01\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p32-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "only one of them will live to be 80.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.23$",
          "worked": "Exactly one means the woman survives and her husband does not, or her husband survives and the woman does not. These cases are mutually exclusive.\n$$\\begin{align*}P(\\text{only one alive at 80})&=0.2(1-0.05)+(1-0.2)0.05\\\\P(\\text{only one alive at 80})&=0.2\\times0.95+0.8\\times0.05\\\\P(\\text{only one alive at 80})&=0.19+0.04\\\\P(\\text{only one alive at 80})&=0.23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
