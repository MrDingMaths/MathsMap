  "content": {
    "id": "v2-foundation-section-slot-12-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A jar contains 4 red, 6 yellow and 10 green lollies. One lolly is picked at random and put back. This is done 300 times.\n\nEstimate how many times the lolly picked will be",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-foundation-section-slot-12-lower-slot-12-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "green",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "150 times",
          "worked": "$$\\begin{align*}P(\\text{green})&=\\frac{10}{20}\\\\P(\\text{green})&=\\frac12\\\\f&=np\\\\f&=300\\times\\frac12\\\\f&=150\\end{align*}$$Expected frequency: 150 times.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-foundation-section-slot-12-lower-slot-12-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "yellow.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "90 times",
          "worked": "$$\\begin{align*}P(\\text{yellow})&=\\frac{6}{20}\\\\P(\\text{yellow})&=\\frac{3}{10}\\\\f&=np\\\\f&=300\\times\\frac{3}{10}\\\\f&=90\\end{align*}$$Expected frequency: 90 times.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
