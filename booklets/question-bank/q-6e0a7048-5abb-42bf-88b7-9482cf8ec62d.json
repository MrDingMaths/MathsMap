  "content": {
    "id": "p18-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Write each expression as the sum of simple powers of $e$, then differentiate it.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{e^{2x}-1}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^x-e^{-x}$; $y'=e^x+e^{-x}$.",
          "worked": "$$\\begin{align*}y&=e^{2x-x}-e^{-x}\\\\y&=e^x-e^{-x}\\\\y'&=e^x+e^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p18-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{e^{2x}+e^x}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^x+1$; $y'=e^x$.",
          "worked": "$$\\begin{align*}y&=e^{2x-x}+e^{x-x}\\\\y&=e^x+1\\\\y'&=e^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p18-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{2-e^x}{e^{2x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2e^{-2x}-e^{-x}$; $y'=e^{-x}-4e^{-2x}$.",
          "worked": "$$\\begin{align*}y&=2e^{-2x}-e^{x-2x}\\\\y&=2e^{-2x}-e^{-x}\\\\y'&=-4e^{-2x}+e^{-x}\\\\y'&=e^{-x}-4e^{-2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p18-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{3+e^x}{e^{4x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3e^{-4x}+e^{-3x}$; $y'=-12e^{-4x}-3e^{-3x}$.",
          "worked": "$$\\begin{align*}y&=3e^{-4x}+e^{x-4x}\\\\y&=3e^{-4x}+e^{-3x}\\\\y'&=-12e^{-4x}-3e^{-3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{e^x+e^{2x}-3e^{4x}}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1+e^x-3e^{3x}$; $y'=e^x-9e^{3x}$.",
          "worked": "$$\\begin{align*}y&=e^{x-x}+e^{2x-x}-3e^{4x-x}\\\\y&=1+e^x-3e^{3x}\\\\y'&=e^x-9e^{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{e^{2x}+2e^x+1}{e^{2x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1+2e^{-x}+e^{-2x}$; $y'=-2e^{-x}-2e^{-2x}$.",
          "worked": "$$\\begin{align*}y&=e^{2x-2x}+2e^{x-2x}+e^{-2x}\\\\y&=1+2e^{-x}+e^{-2x}\\\\y'&=-2e^{-x}-2e^{-2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
