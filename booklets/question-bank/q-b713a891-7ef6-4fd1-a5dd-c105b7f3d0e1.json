                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the distances travelled during the two stages, using ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "3-x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " hours for the remaining time.",
                    "marks": []
