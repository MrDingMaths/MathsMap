  "content": {
    "id": "p27-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Gary’s salary increases from \\$22 500 to \\$23 400.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Work out the percentage increase in Gary’s salary.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\%$",
          "worked": "$$\\begin{align*}\\text{Increase}&=\\$23\\,400-\\$22\\,500\\\\&=\\$900\\\\\\text{Percentage increase}&=\\frac{900}{22\\,500}\\times100\\%\\\\&=4\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q5-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p27-q5-b-scenario",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Gary and Beca both get a pay rise of the same percentage.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Beca's salary increases to $23 920.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Use your answer to part ",
