                  "marks": [
                    "italic"
                  ]
                },
                {
                  "type": "text",
                  "text": " her pay increase.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$23\\,000$",
          "worked": "After a $4\\%$ increase, \\$23 920 represents $104\\%$ of the original salary.\n$$\\begin{align*}104\\%&=\\$23\\,920\\\\1\\%&=\\frac{\\$23\\,920}{104}=\\$230\\\\100\\%&=\\$230\\times100=\\$23\\,000\\end{align*}$$\nBeca's salary before the increase was \\$23 000.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
