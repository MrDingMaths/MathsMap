    "children": [
      {
        "id": "p68-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Any even number added to another even number is an even number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2k+2m=2(k+m)$, which is even, for integers $k$ and $m$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p68-q10-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Write even numbers as ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2k",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2m",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", where k and m are integers.",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "2k+2m=2(k+m)",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", which is even.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p68-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "The sum of two odd numbers is an even number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2k+1)+(2m+1)=2(k+m+1)$, which is even, for integers $k$ and $m$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p68-q10-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Write odd numbers as ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2k+1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2m+1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", where k and m are integers.",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "(2k+1)+(2m+1)=2(k+m+1)",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", which is even.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p68-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "The product of two odd numbers is an odd number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2k+1)(2m+1)=2(2km+k+m)+1$, which is odd, for integers $k$ and $m$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p68-q10-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let k and m be integers.",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(2k+1)(2m+1)&=4km+2k+2m+1\\\\(2k+1)(2m+1)&=2(2km+k+m)+1\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": "This is odd because 2km + k + m is an integer.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p68-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "The sum of an integer and its square is even. Hint: consider integers either as odd or even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Odd case: $(2k+1)+(2k+1)^2=2(2k^2+3k+1)$. Even case: $2k+(2k)^2=2(k+2k^2)$. Both are even for integer $k$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p68-q10-d-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let k be an integer. Case 1: the integer is odd, ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2k+1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(2k+1)+(2k+1)^2&=4k^2+6k+2\\\\(2k+1)+(2k+1)^2&=2(2k^2+3k+1)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": "This is even.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p68-q10-d-answer-even",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Case 2: the integer is even, ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2k",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}2k+(2k)^2&=2k+4k^2\\\\2k+(2k)^2&=2(k+2k^2)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": "This is even. Every integer is odd or even, so the statement holds in both cases.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
