  "content": {
    "id": "p32-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Consider the line $y=-2x+k$ and the parabola $y=x^2-6x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the $x$-coordinates of the points of intersection satisfy the equation\n$$x^2-4x-k=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-4x-k=0$.",
          "worked": "$$\\begin{aligned}-2x+k&=x^2-6x\\\\x^2-4x-k&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p32-q2-b",
        "type": "group",
        "label": "b",
        "prompt": "Suppose that the line is a tangent to the parabola; in other words, the two roots of the quadratic equation are equal. Let the roots be $\\alpha$ and $\\alpha$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p32-q2-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Using sum of roots, show that $\\alpha=2$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\alpha=2$.",
              "worked": "$$\\begin{aligned}\\alpha+\\alpha&=-\\frac{b}{a}\\\\2\\alpha&=-\\frac{-4}{1}\\\\2\\alpha&=4\\\\\\alpha&=2\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q2-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Using product of roots, show that $\\alpha^2=-k$ and hence find $k$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\alpha^2=-k$; $k=-4$.",
              "worked": "$$\\begin{aligned}\\alpha\\times\\alpha&=\\frac{c}{a}\\\\\\alpha^2&=-k\\\\2^2&=-k\\\\k&=-4\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p32-q2-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Therefore, state the equation of the tangent line and find its point of contact with the parabola.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Tangent line: $y=-2x-4$. Point of contact: $(2,-8)$.",
              "worked": "The tangent line is $y=-2x-4$.\nAt the point of contact,\n$$\\begin{aligned}x^2-4x+4&=0\\\\(x-2)^2&=0\\\\x&=2\\end{aligned}$$\n$$\\begin{aligned}y&=-2(2)-4\\\\&=-8\\end{aligned}$$\nThe point of contact is $(2,-8)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p32-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Use DESMOS to visualise what is happening by sketching $y=-2x-4$ and $y=x^2-6x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The graphs touch at $(2,-8)$.",
          "worked": "Plot both equations in DESMOS. The parabola has vertex $(3,-9)$ and intercepts $(0,0)$ and $(6,0)$. The line passes through $(0,-4)$ and $(-2,0)$ and touches the parabola at $(2,-8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      }
    ]
  },
