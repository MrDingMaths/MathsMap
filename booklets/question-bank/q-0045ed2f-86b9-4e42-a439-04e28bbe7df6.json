  "content": {
    "id": "p32-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The ratio of radius to height of a cylinder is $2:3$. Find the radius and height of the cylinder if its volume is $96\\pi\\text{ cm}^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Radius $4\\text{ cm}$; height $6\\text{ cm}$.",
      "worked": "Let $r=2k$ and $h=3k$, with lengths in centimetres.\n$$\\begin{align*}\\pi(2k)^2(3k)&=96\\pi\\\\12\\pi k^3&=96\\pi\\\\k^3&=8\\\\k&=2\\\\r&=2\\times2=4\\text{ cm}\\\\h&=3\\times2=6\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
