  "content": {
    "id": "p12-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve each of the following, writing $x$ as a single logarithm:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^{x-2}=2^{-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_6 9$\n\nTake logarithms, collect the terms in $x$, then use change of base.",
          "worked": "$$\\begin{align*}(x-2)\\log_3 3&=-x\\log_3 2\\\\x-2&=-x\\log_3 2\\\\x(1+\\log_3 2)&=2\\\\x\\log_3 6&=\\log_3 9\\\\x&=\\frac{\\log_3 9}{\\log_3 6}\\\\x&=\\log_6 9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{x-1}=5^{-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_{50}2$\n\nTake logarithms, collect the terms in $x$, then use change of base.",
          "worked": "$$\\begin{align*}(x-1)\\log_2 2&=-2x\\log_2 5\\\\x-1&=-2x\\log_2 5\\\\x(1+2\\log_2 5)&=1\\\\x\\log_2 50&=1\\\\x&=\\frac{\\log_2 2}{\\log_2 50}\\\\x&=\\log_{50}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^{x-1}=3^{-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_{18}2$\n\nTake logarithms, collect the terms in $x$, then use change of base.",
          "worked": "$$\\begin{align*}(x-1)\\log_2 2&=-2x\\log_2 3\\\\x-1&=-2x\\log_2 3\\\\x(1+2\\log_2 3)&=1\\\\x\\log_2 18&=1\\\\x&=\\frac{\\log_2 2}{\\log_2 18}\\\\x&=\\log_{18}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p12-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$5^{-2x+1}=2^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_{100}5$\n\nTake logarithms, collect the terms in $x$, then use change of base.",
          "worked": "$$\\begin{align*}(-2x+1)\\log_2 5&=2x\\log_2 2\\\\(-2x+1)\\log_2 5&=2x\\\\x(2+2\\log_2 5)&=\\log_2 5\\\\x\\log_2 100&=\\log_2 5\\\\x&=\\frac{\\log_2 5}{\\log_2 100}\\\\x&=\\log_{100}5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p12-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$3^{-x-2}=2^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\log_{12}9$\n\nTake logarithms, collect the terms in $x$, then use change of base.",
          "worked": "$$\\begin{align*}(-x-2)\\log_3 3&=2x\\log_3 2\\\\-x-2&=2x\\log_3 2\\\\x(1+2\\log_3 2)&=-2\\\\x\\log_3 12&=-\\log_3 9\\\\x&=-\\frac{\\log_3 9}{\\log_3 12}\\\\x&=-\\log_{12}9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
