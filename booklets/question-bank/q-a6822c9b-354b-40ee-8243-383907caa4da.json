  "content": {
    "id": "p15-q7-root",
    "type": "question",
    "label": "7",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "bfa86fd7-1df9-44d6-ac65-46d39db24cfd",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 0,
          "lineHeight": 1.3199970000068182,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Calculate the following total weekly wages. Round final answers to the nearest cent. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Do not round intermediate values.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "38 hours at \\$22.10 per hour, plus 2 hours at time-and-a-half.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$906.10",
          "worked": "$$\\begin{align*}\\text{Normal pay} &= 22.10\\times38 = \\$839.80\\\\\\text{Overtime pay} &= 22.10\\times2\\times1.5 = \\$66.30\\\\\\text{Total pay} &= 839.80+66.30\\\\\\text{Total pay} &= \\$906.10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "40 hours at \\$17.85 per hour, plus 3 hours at time-and-a-half.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$794.33",
          "worked": "$$\\begin{align*}\\text{Normal pay} &= 17.85\\times40 = \\$714.00\\\\\\text{Overtime pay} &= 17.85\\times3\\times1.5 = \\$80.325\\\\\\text{Total pay} &= 714+80.325\\\\\\text{Total pay} &= \\$794.325\\\\\\text{Total pay} &\\approx \\$794.33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "37 hours at \\$18.32 per hour, plus 3 hours at time-and-a-half and 2 hours at double time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$833.56",
          "worked": "$$\\begin{align*}\\text{Normal pay} &= 18.32\\times37 = \\$677.84\\\\\\text{Time-and-a-half pay} &= 18.32\\times3\\times1.5 = \\$82.44\\\\\\text{Double-time pay} &= 18.32\\times2\\times2 = \\$73.28\\\\\\text{Total pay} &= 677.84+82.44+73.28\\\\\\text{Total pay} &= \\$833.56\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
