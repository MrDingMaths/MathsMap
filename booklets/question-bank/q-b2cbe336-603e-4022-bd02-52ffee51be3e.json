    "children": [
      {
        "id": "v2-f3075-p38-practice-slot-2-upper-slot-2-upper-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the minimum value of $y=3x^2-5x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum value $y=-\\dfrac{13}{12}$.",
          "worked": "$$\\begin{align*}x&=-\\frac{-5}{2(3)}\\\\x&=\\frac56\\\\y&=3\\left(\\frac56\\right)^2-5\\left(\\frac56\\right)+1\\\\y&=\\frac{25}{12}-\\frac{50}{12}+\\frac{12}{12}\\\\y&=-\\frac{13}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-f3075-p38-practice-slot-2-upper-slot-2-upper-b",
        "type": "part",
        "label": "b",
        "prompt": "The parabola $y=x^2+bx+7$ has its minimum value when $x=3$. Find $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-6$",
          "worked": "$$\\begin{align*}-\\frac{b}{2(1)}&=3\\\\b&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f3075-p38-practice-slot-2-upper-slot-2-upper-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find the minimum value of $y=x^2+bx+7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum value $y=-2$.",
          "worked": "$$\\begin{align*}y&=3^2-6(3)+7\\\\y&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
