    "children": [
      {
        "id": "v2-d44-p63-foundation-topup-slot-1-topup-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Which cyclist is quicker on average? Support your answer using a summary statistic.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cyclist X has the lower mean time: X $\\approx25.17\\,\\text{min}$, Y $\\approx25.43\\,\\text{min}$.",
          "worked": "$$\\begin{align*}\\bar{x}_X&=\\frac{24.5+26.0+23.8+25.2+27.1+24.4}{6}\\,\\text{min}\\\\\\bar{x}_X&=\\frac{151}{6}\\,\\text{min}\\\\\\bar{x}_X&\\approx25.17\\,\\text{min}\\\\\\bar{x}_Y&=\\frac{23.9+28.4+22.7+26.3+29.0+22.5+25.2}{7}\\,\\text{min}\\\\\\bar{x}_Y&=\\frac{178}{7}\\,\\text{min}\\\\\\bar{x}_Y&\\approx25.43\\,\\text{min}\\end{align*}$$\n\nCyclist X is quicker on average because the mean time is lower.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-d44-p63-foundation-topup-slot-1-topup-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Which cyclist is more consistent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cyclist X has the smaller range: $3.3\\,\\text{min}$ compared with Y's $6.5\\,\\text{min}$.",
          "worked": "$$\\begin{align*}\\text{Range of X}&=(27.1-23.8)\\,\\text{min}\\\\\\text{Range of X}&=3.3\\,\\text{min}\\\\\\text{Range of Y}&=(29.0-22.5)\\,\\text{min}\\\\\\text{Range of Y}&=6.5\\,\\text{min}\\end{align*}$$\n\nCyclist X is more consistent because the times have the smaller range.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-d44-p63-foundation-topup-slot-1-topup-slot-1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Make a comment comparing the two cyclists.\nRefer to the summary statistics you've just calculated.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cyclist X was quicker on average (mean $\\approx25.17$ min versus $\\approx25.43$ min) and more consistent (range $3.3$ min versus $6.5$ min).",
          "worked": "Cyclist X was quicker on average, with a mean of about $25.17$ min compared with about $25.43$ min for Y. Cyclist X was also more consistent, with a range of $3.3$ min compared with $6.5$ min.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
