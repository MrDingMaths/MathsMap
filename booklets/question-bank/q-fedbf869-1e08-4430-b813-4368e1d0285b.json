  "content": {
    "id": "p25-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The average of three numbers is 14. When the smallest of these is removed, the average of the two numbers that remain is 18. When the largest of these numbers is removed, the average of the two numbers that remain is 9. What are the numbers?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6,12,24$.",
      "worked": "Let $x$, $y$ and $z$ be the numbers in increasing order. The averages give\n$$\\begin{align*}x+y+z&=42 &&(1)\\\\y+z&=36 &&(2)\\\\x+y&=18 &&(3)\\end{align*}$$\nSubtract (2) from (1), then substitute into (3) and (2):\n$$\\begin{align*}x&=42-36\\\\x&=6\\\\6+y&=18\\\\y&=12\\\\12+z&=36\\\\z&=24\\end{align*}$$\nThe numbers are $6,12,24$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 100
  },
