      {
        "id": "p4-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the gradient of the line perpendicular to $y=3x-4$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac13$",
          "worked": "The gradient is the negative reciprocal of $3$: $m=-\\frac13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p4-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the equation of the line that passes through $(4,6)$ and is perpendicular to $y=3x-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3y-22=0$",
          "worked": "Using $m=-\\frac13$ from part (a):\n$$\\begin{align*}y-6&=-\\frac13(x-4)\\\\3y-18&=-x+4\\\\x+3y-22&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
