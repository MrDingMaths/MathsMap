  "content": {
    "id": "p13-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Rationalise the denominator for each of the numbers below:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{10}}{10}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{10}}&=\\frac{1}{\\sqrt{10}}\\times\\frac{\\sqrt{10}}{\\sqrt{10}}\\\\\\frac{1}{\\sqrt{10}}&=\\frac{\\sqrt{10}}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}\\frac{2}{\\sqrt{3}}&=\\frac{2}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\frac{2}{\\sqrt{3}}&=\\frac{2\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3\\sqrt{2}}{2}$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{2}}&=\\frac{3}{\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\\\frac{3}{\\sqrt{2}}&=\\frac{3\\sqrt{2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{6}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{6}{\\sqrt{3}}&=\\frac{6}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\frac{6}{\\sqrt{3}}&=\\frac{6\\sqrt{3}}{3}\\\\\\frac{6}{\\sqrt{3}}&=2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{8}{\\sqrt{8}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{8}{\\sqrt{8}}&=\\frac{8}{\\sqrt{8}}\\times\\frac{\\sqrt{8}}{\\sqrt{8}}\\\\\\frac{8}{\\sqrt{8}}&=\\sqrt{8}\\\\\\frac{8}{\\sqrt{8}}&=2\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5}{4\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5\\sqrt{3}}{12}$",
          "worked": "$$\\begin{align*}\\frac{5}{4\\sqrt{3}}&=\\frac{5}{4\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\frac{5}{4\\sqrt{3}}&=\\frac{5\\sqrt{3}}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{7}{4\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7\\sqrt{2}}{8}$",
          "worked": "$$\\begin{align*}\\frac{7}{4\\sqrt{2}}&=\\frac{7}{4\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\\\frac{7}{4\\sqrt{2}}&=\\frac{7\\sqrt{2}}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{5}{3\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{5}}{3}$",
          "worked": "$$\\begin{align*}\\frac{5}{3\\sqrt{5}}&=\\frac{5}{3\\sqrt{5}}\\times\\frac{\\sqrt{5}}{\\sqrt{5}}\\\\\\frac{5}{3\\sqrt{5}}&=\\frac{5\\sqrt{5}}{15}\\\\\\frac{5}{3\\sqrt{5}}&=\\frac{\\sqrt{5}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{9}{2\\sqrt{18}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3\\sqrt{2}}{4}$",
          "worked": "$$\\begin{align*}\\frac{9}{2\\sqrt{18}}&=\\frac{9}{6\\sqrt{2}}\\\\\\frac{9}{2\\sqrt{18}}&=\\frac{9}{6\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\\\frac{9}{2\\sqrt{18}}&=\\frac{9\\sqrt{2}}{12}\\\\\\frac{9}{2\\sqrt{18}}&=\\frac{3\\sqrt{2}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{4}{2\\sqrt{12}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}\\frac{4}{2\\sqrt{12}}&=\\frac{1}{\\sqrt{3}}\\\\\\frac{4}{2\\sqrt{12}}&=\\frac{1}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\frac{4}{2\\sqrt{12}}&=\\frac{\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{15}{2\\sqrt{50}}$",
