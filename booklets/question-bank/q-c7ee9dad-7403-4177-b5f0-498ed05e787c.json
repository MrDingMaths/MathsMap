  "content": {
    "id": "v2-d7528-p52-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the position vector of the point $B$ in each case.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d7528-p52-practice-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$A$ is the point $(-3,4)$ and $\\overrightarrow{AB}=\\begin{pmatrix}5\\\\-7\\end{pmatrix}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{OB}=\\begin{pmatrix}2\\\\-3\\end{pmatrix}$",
          "worked": "$$\\begin{align*}\\overrightarrow{OA}&=\\begin{pmatrix}-3\\\\4\\end{pmatrix}\\\\\\overrightarrow{OB}&=\\overrightarrow{OA}+\\overrightarrow{AB}\\\\&=\\begin{pmatrix}-3\\\\4\\end{pmatrix}+\\begin{pmatrix}5\\\\-7\\end{pmatrix}\\\\&=\\begin{pmatrix}2\\\\-3\\end{pmatrix}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-d7528-p52-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$A$ is the point $(6,2)$ and $\\overrightarrow{BA}=\\begin{pmatrix}-4\\\\9\\end{pmatrix}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{OB}=\\begin{pmatrix}10\\\\-7\\end{pmatrix}$",
          "worked": "$$\\begin{align*}\\overrightarrow{OA}&=\\begin{pmatrix}6\\\\2\\end{pmatrix}\\\\\\overrightarrow{BA}&=\\overrightarrow{OA}-\\overrightarrow{OB}\\\\\\overrightarrow{OB}&=\\overrightarrow{OA}-\\overrightarrow{BA}\\\\&=\\begin{pmatrix}6\\\\2\\end{pmatrix}-\\begin{pmatrix}-4\\\\9\\end{pmatrix}\\\\&=\\begin{pmatrix}10\\\\-7\\end{pmatrix}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
