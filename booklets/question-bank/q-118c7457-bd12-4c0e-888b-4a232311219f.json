      {
        "id": "p14-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "What transformation maps $y=x^2-2x$ to $y=2x-x^2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Reflection in the $x$-axis.",
          "worked": "Since $2x-x^2=-(x^2-2x)$, every point $(x,y)$ maps to $(x,-y)$. This is reflection in the $x$-axis.",
