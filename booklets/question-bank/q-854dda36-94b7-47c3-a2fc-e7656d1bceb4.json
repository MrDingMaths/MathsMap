  "content": {
    "id": "p41-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Solve $2\\cos 2\\theta=2\\sin 2\\theta$ for $0\\le\\theta\\le2\\pi$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\theta=\\dfrac{\\pi}{8},\\dfrac{5\\pi}{8},\\dfrac{9\\pi}{8},\\dfrac{13\\pi}{8}$.",
      "worked": "If $\\cos2\\theta=0$, then $\\sin2\\theta=\\pm1$, so the original equation is not satisfied. Hence division by $\\cos2\\theta$ loses no solutions.\n$$\\begin{align*}2\\cos2\\theta&=2\\sin2\\theta\\\\\\tan2\\theta&=1\\end{align*}$$\nSince $0\\le\\theta\\le2\\pi$, the doubled angle satisfies $0\\le2\\theta\\le4\\pi$.\n$$\\begin{align*}2\\theta&=\\frac{\\pi}{4},\\frac{5\\pi}{4},\\frac{9\\pi}{4},\\frac{13\\pi}{4}\\\\\\theta&=\\frac{\\pi}{8},\\frac{5\\pi}{8},\\frac{9\\pi}{8},\\frac{13\\pi}{8}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
