  "content": {
    "id": "p33-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Prove:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\sin\\theta\\cos\\theta\\operatorname{cosec}^{2}\\theta=\\cot\\theta$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\cos\\theta}{\\sin\\theta}=\\cot\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\sin\\theta\\cos\\theta\\cdot\\left(\\frac{1}{\\sin^{2}\\theta}\\right)\\\\&=\\frac{\\cos\\theta}{\\sin\\theta}\\\\&=\\cot\\theta\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p33-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$$(\\cos\\varphi+\\cot\\varphi)\\sec\\varphi=1+\\operatorname{cosec}\\varphi$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1+\\dfrac{1}{\\sin\\varphi}=1+\\operatorname{cosec}\\varphi=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\cos\\varphi\\sec\\varphi+\\cot\\varphi\\sec\\varphi\\\\&=\\cos\\varphi\\cdot\\left(\\frac{1}{\\cos\\varphi}\\right) +\\left(\\frac{\\cos\\varphi}{\\sin\\varphi}\\right)\\cdot\\left(\\frac{1}{\\cos\\varphi}\\right)\\\\&=1+\\frac{1}{\\sin\\varphi}\\\\&=1+\\operatorname{cosec}\\varphi\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\sin^{4}A-\\cos^{4}A=\\sin^{2}A-\\cos^{2}A$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=(\\sin^{2}A-\\cos^{2}A)(\\sin^{2}A+\\cos^{2}A)=\\sin^{2}A-\\cos^{2}A=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=(\\sin^{2}A)^{2}-(\\cos^{2}A)^{2}\\\\&=(\\sin^{2}A-\\cos^{2}A)(\\sin^{2}A+\\cos^{2}A)\\\\&=(\\sin^{2}A-\\cos^{2}A)\\cdot1\\\\&=\\sin^{2}A-\\cos^{2}A\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\sin\\beta+\\cot\\beta\\cos\\beta=\\operatorname{cosec}\\beta$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sin^{2}\\beta+\\cos^{2}\\beta}{\\sin\\beta}=\\dfrac{1}{\\sin\\beta}=\\operatorname{cosec}\\beta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\sin\\beta+\\frac{\\cos\\beta}{\\sin\\beta}\\cdot\\cos\\beta\\\\&=\\sin\\beta+\\frac{\\cos^{2}\\beta}{\\sin\\beta}\\\\&=\\frac{\\sin^{2}\\beta+\\cos^{2}\\beta}{\\sin\\beta}\\\\&=\\frac{1}{\\sin\\beta}\\\\&=\\operatorname{cosec}\\beta\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p33-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{1+\\tan^{2}x}{1+\\cot^{2}x}=\\tan^{2}x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sec^{2}x}{\\operatorname{cosec}^{2}x}=\\dfrac{\\sin^{2}x}{\\cos^{2}x}=\\tan^{2}x=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\dfrac{\\sec^{2}x}{\\operatorname{cosec}^{2}x}\\\\&=\\dfrac{\\left(\\dfrac{1}{\\cos^{2}x}\\right)}{\\left(\\dfrac{1}{\\sin^{2}x}\\right)}\\\\&=\\dfrac{\\sin^{2}x}{\\cos^{2}x}\\\\&=\\tan^{2}x\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p33-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{1+\\cot x}{1+\\tan x}=\\cot x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sin x+\\cos x}{\\sin x}\\cdot\\dfrac{\\cos x}{\\cos x+\\sin x}=\\dfrac{\\cos x}{\\sin x}=\\cot x=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\dfrac{\\left(1+\\dfrac{\\cos x}{\\sin x}\\right)}{\\left(1+\\dfrac{\\sin x}{\\cos x}\\right)}\\\\&=\\dfrac{\\left(\\dfrac{\\sin x+\\cos x}{\\sin x}\\right)}{\\left(\\dfrac{\\cos x+\\sin x}{\\cos x}\\right)}\\\\&=\\dfrac{\\sin x+\\cos x}{\\sin x}\\cdot\\dfrac{\\cos x}{\\cos x+\\sin x}\\\\&=\\dfrac{\\cos x}{\\sin x}\\\\&=\\cot x\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p33-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{1}{1+\\sin\\theta}+\\frac{1}{1-\\sin\\theta}=2\\sec^{2}\\theta$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{2}{1-\\sin^{2}\\theta}=\\dfrac{2}{\\cos^{2}\\theta}=2\\sec^{2}\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{1-\\sin\\theta+1+\\sin\\theta}{(1+\\sin\\theta)(1-\\sin\\theta)}\\\\&=\\frac{2}{1-\\sin^{2}\\theta}\\\\&=\\frac{2}{\\cos^{2}\\theta}\\\\&=2\\sec^{2}\\theta\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p33-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac{1}{\\sec\\varphi-\\tan\\varphi}-\\frac{1}{\\sec\\varphi+\\tan\\varphi}=2\\tan\\varphi$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{2\\tan\\varphi}{\\sec^{2}\\varphi-\\tan^{2}\\varphi}=2\\tan\\varphi=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{(\\sec\\varphi+\\tan\\varphi)-(\\sec\\varphi-\\tan\\varphi)}{(\\sec\\varphi-\\tan\\varphi)(\\sec\\varphi+\\tan\\varphi)}\\\\&=\\frac{2\\tan\\varphi}{\\sec^{2}\\varphi-\\tan^{2}\\varphi}\\\\&=\\frac{2\\tan\\varphi}{1}\\\\&=2\\tan\\varphi\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
