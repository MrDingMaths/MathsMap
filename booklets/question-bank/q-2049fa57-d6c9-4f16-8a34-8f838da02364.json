    "children": [
      {
        "id": "p31-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the graph to find $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=200,\\quad b=120$.",
          "worked": "The curve meets the axis at $x=200$, so $a=200$. It touches the axis at $x=120$, corresponding to the squared factor, so $b=120$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Given the rollercoaster is 4 m above the ground after travelling 100 m, find the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=1\\,000\\,000$.",
          "worked": "Using $a=200$, $b=120$ and $h(100)=4$:\n$$\\begin{align*}4&=\\frac{-100(100-200)(100-120)^2}{k}\\\\4&=\\frac{4\\,000\\,000}{k}\\\\k&=1\\,000\\,000.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p31-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the height of the rollercoaster above the ground after it has travelled 150 m.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.75\\ \\mathrm{m}$.",
          "worked": "$$\\begin{align*}h(150)&=\\frac{-150(150-200)(150-120)^2}{1\\,000\\,000}\\\\h(150)&=\\frac{6\\,750\\,000}{1\\,000\\,000}\\\\h(150)&=6.75.\\end{align*}$$\nThe rollercoaster is $6.75\\ \\mathrm{m}$ above the ground.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
