        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 31,
          "sourceRegion": "Question 12, lower-left graph",
          "description": "Rectangular blue grid with 20 m horizontal steps and 5 m vertical steps. Both axes have arrows at both ends. An open origin marker and filled endpoint at x=200 are retained. The curve crosses at the origin, touches at x=120 and ends at x=200.",
          "mathematics": "h(x)=-x(x-200)(x-120)^2/1000000 for 0<=x<=200. Horizontal grid range -40 to 260; vertical grid range -10 to 55. Printed numeric labels are x=100,200 and h=20,40.",
          "answerVisibility": "The graph is a permanent student-visible given; parameter values and the equation used to reconstruct it are not printed."
