  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "The side length $x$ of a square increases at a constant rate of 2 units per second.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down an expression for the area $A$ of the square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=x^2$",
          "worked": "$$A=x^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\dfrac{dA}{dt}$ in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dA}{dt}=4x$",
          "worked": "$$\\begin{align*}\\frac{dA}{dt}&=\\frac{dA}{dx}\\frac{dx}{dt}\\\\\\frac{dA}{dt}&=2x(2)\\\\\\frac{dA}{dt}&=4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p10-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the rate that the area is increasing when $x=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ units}^2/\\text{s}$",
          "worked": "When $x=5$:\n$$\\begin{align*}\\frac{dA}{dt}&=4(5)\\\\\\frac{dA}{dt}&=20\\text{ units}^2/\\text{s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
