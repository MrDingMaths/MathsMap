  "content": {
    "id": "p38-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the discriminant $\\Delta=b^2-4ac$ for each quadratic. Use this and the concavity to state how many zeroes the function has, without drawing its graph.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2+3x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=17$; concave up; two distinct zeroes.",
          "worked": "$$\\Delta=3^2-4(1)(-2)=17>0.$$\nSince $a=1>0$, the graph is concave up. The positive discriminant gives two distinct zeroes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=9x^2-6x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=0$; concave up; one double zero.",
          "worked": "$$\\Delta=(-6)^2-4(9)(1)=0.$$\nSince $a=9>0$, the graph is concave up. Its vertex lies on the $x$-axis, giving one double zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=-2x^2+5x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=-7$; concave down; no zeroes.",
          "worked": "$$\\Delta=5^2-4(-2)(-4)=-7<0.$$\nSince $a=-2<0$, the graph is concave down. The negative discriminant gives no real zeroes; the entire graph lies below the $x$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
