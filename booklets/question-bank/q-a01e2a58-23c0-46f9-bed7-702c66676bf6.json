  "content": {
    "id": "p12-q6-response",
    "type": "question",
    "label": "6",
    "prompt": "The top of the Sydney Harbour Bridge is measured to be 138.4 m above sea level.\n\nWhat is the percentage error in this measurement? Give your answer to three decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.036\\%$",
      "worked": "Precision: $0.1\\text{ m}$.\n\n$$\\begin{aligned}\\text{Absolute error}&=\\tfrac12\\times0.1\\text{ m}=0.05\\text{ m}\\\\\\text{Percentage error}&=\\frac{0.05}{138.4}\\times100\\%\\approx0.036\\%\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
