    "answer": {
      "short": "Store A offers the larger percentage discount: $15\\%$, compared with Store B's $12.5\\%$.",
      "worked": "$$\\begin{align*}\\text{Store A percentage change}&=\\frac{51-60}{60}\\times100\\%\\\\\\text{Store A percentage change}&=-15\\%\\\\\\text{Store B percentage change}&=\\frac{73.50-84}{84}\\times100\\%\\\\\\text{Store B percentage change}&=-12.5\\%\\end{align*}$$\nStore A offers the larger percentage discount: $15\\%>12.5\\%$.",
      "solutionDiagrams": []
    },
