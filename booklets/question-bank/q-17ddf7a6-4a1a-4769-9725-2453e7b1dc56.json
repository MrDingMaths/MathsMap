  "content": {
    "id": "p12-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "Find the ratio of the coefficient of $x^4$ to $x^5$ in the expansion of $(3x-5)^7$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-25:9$",
      "worked": "$$\\begin{align*}T_k&=\\binom{7}{k}(3x)^{7-k}(-5)^k\\\\T_k&=\\binom{7}{k}3^{7-k}(-5)^kx^{7-k}.\\end{align*}$$\nLet $c_4$ and $c_5$ be the coefficients of $x^4$ and $x^5$, respectively.\n$$\\begin{align*}c_4&=\\binom{7}{3}3^4(-5)^3=-354\\,375\\\\c_5&=\\binom{7}{2}3^5(-5)^2=127\\,575\\\\c_4:c_5&=-354\\,375:127\\,575\\\\c_4:c_5&=-25:9.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
