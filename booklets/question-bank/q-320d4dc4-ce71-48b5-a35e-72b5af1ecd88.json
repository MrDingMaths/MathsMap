  "content": {
    "id": "v2-641694-p7-practice-slot-3-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Ava earns \\$312.80 for 16 hours of work. At the same hourly rate, find her pay for a fortnight in which she works 38 hours each week.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$1485.80",
      "worked": "$$\\begin{align*}\\text{Hourly rate}&=\\frac{\\text{Total pay}}{\\text{Hours}}\\\\\\text{Hourly rate}&=\\frac{\\$312.80}{16\\text{ h}}\\\\\\text{Hourly rate}&=\\$19.55/\\text{h}\\\\\\text{Fortnightly pay}&=\\$19.55\\times(38\\times2)\\\\\\text{Fortnightly pay}&=\\$1485.80\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
