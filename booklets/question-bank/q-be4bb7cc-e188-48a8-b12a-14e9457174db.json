  "content": {
    "id": "p40-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the range of $y=9-x^2$ and hence find the maximum value of $y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Range: $y\\leq9$. Maximum value: $9$.",
          "worked": "$$\\begin{align*}x^2&\\geq0\\\\9-x^2&\\leq9\\end{align*}$$\nThe range is $y\\leq9$. The maximum value is $9$, attained when $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p40-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the range of $f(x)=\\sqrt{9-x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0\\leq y\\leq3$.",
          "worked": "For the square root to be defined, $9-x^2\\geq0$. From part a,\n$$\\begin{align*}0&\\leq9-x^2\\leq9\\\\0&\\leq\\sqrt{9-x^2}\\leq3\\end{align*}$$\nBoth endpoints are attained, so the range is $0\\leq y\\leq3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p40-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Use a similar technique to find the range of $y=\\sqrt{4-x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0\\leq y\\leq2$.",
          "worked": "$$\\begin{align*}x^2&\\geq0\\\\4-x^2&\\leq4\\end{align*}$$\nThe square root also requires $4-x^2\\geq0$, so\n$$\\begin{align*}0&\\leq4-x^2\\leq4\\\\0&\\leq\\sqrt{4-x^2}\\leq2\\end{align*}$$\nBoth endpoints are attained, so the range is $0\\leq y\\leq2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p40-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence determine the range of $y=\\dfrac{1}{\\sqrt{4-x^2}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\geq\\dfrac12$.",
          "worked": "The denominator cannot be zero. Using part c,\n$$0<\\sqrt{4-x^2}\\leq2.$$\nTaking reciprocals reverses the inequality:\n$$\\frac{1}{\\sqrt{4-x^2}}\\geq\\frac12.$$\nThe minimum is $\\frac12$ at $x=0$. Values increase without bound as the denominator approaches zero, so the range is $y\\geq\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p40-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "By considering the minimum value, find the range of $y=\\sqrt{9+x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\geq3$.",
          "worked": "The minimum value of $9+x^2$ is $9$, since $x^2\\geq0$.\n$$\\begin{align*}9+x^2&\\geq9\\\\\\sqrt{9+x^2}&\\geq3\\end{align*}$$\nThe minimum is $3$ at $x=0$, and there is no upper bound. The range is $y\\geq3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p40-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "Hence find the range of $y=\\dfrac{1}{\\sqrt{9+x^2}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "dependsOn": [
          "p40-q13-e"
        ],
        "answer": {
          "short": "$0<y\\leq\\dfrac13$.",
          "worked": "From part e,\n$$3\\leq\\sqrt{9+x^2}<\\infty.$$\nTaking reciprocals reverses the inequality:\n$$0<\\frac{1}{\\sqrt{9+x^2}}\\leq\\frac13.$$\nThe maximum is $\\frac13$ at $x=0$. The value approaches zero but never equals it, so the range is $0<y\\leq\\frac13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
