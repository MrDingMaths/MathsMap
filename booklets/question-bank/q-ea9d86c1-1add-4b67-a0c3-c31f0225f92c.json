                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{243}{32}x^5-\\frac{135}{8}x^3+15x-\\frac{20}{3x}+\\frac{40}{27x^3}-\\frac{32}{243x^5}",
                    "display": false
