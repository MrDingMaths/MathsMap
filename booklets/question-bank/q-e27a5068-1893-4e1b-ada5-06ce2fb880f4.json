  "content": {
    "id": "p43-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The mean of a binomial distribution is $12.92$ and the probability of failure is $0.32$.\nFind the number of trials.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$19$ trials",
      "worked": "$$\\begin{aligned}p&=1-0.32\\\\p&=0.68\\end{aligned}$$\nUsing $E(X)=np$:\n$$\\begin{aligned}n&=\\frac{12.92}{0.68}\\\\n&=19\\end{aligned}$$",
      "solutionDiagrams": []
    },
