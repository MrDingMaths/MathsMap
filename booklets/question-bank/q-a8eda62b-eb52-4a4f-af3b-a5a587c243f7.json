  "content": {
    "id": "p22-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "In another state, the percentage decrease in rainfall over the last five years has been quite variable, and in some cases, rainfall has actually increased. Find the rate of decrease or increase if the annual rainfall five years ago and now are, respectively, the following. Round non-exact percentages to 1 decimal place.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$500\\text{ mm}$ and $410\\text{ mm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Decrease}&=500-410=90\\text{ mm}\\\\\\text{Percentage decrease}&=\\frac{90}{500}\\times100\\%\\\\\\text{Percentage decrease}&=18\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$920\\text{ mm}$ and $960\\text{ mm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.3\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Increase}&=960-920=40\\text{ mm}\\\\\\text{Percentage increase}&=\\frac{40}{920}\\times100\\%\\\\\\text{Percentage increase}&\\approx4.3\\%\\end{align*}$$",
          "solutionDiagrams": []
