  "content": {
    "id": "p60-q14",
    "type": "question",
    "label": "14",
    "prompt": "A retailer buys T-shirts for \\$8 each and sells them for \\$14.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the percentage profit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit} &= \\$14-\\$8\\\\\\text{Profit} &= \\$6\\\\\\text{Percentage profit} &= \\frac{6}{8}\\times100\\%\\\\\\text{Percentage profit} &= 75\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p60-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "How much profit is made from selling 50 T-shirts?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$300$",
          "worked": "$$\\begin{align*}\\text{Profit per T-shirt} &= \\$14-\\$8\\\\\\text{Profit per T-shirt} &= \\$6\\\\\\text{Total profit} &= 50\\times\\$6\\\\\\text{Total profit} &= \\$300\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
