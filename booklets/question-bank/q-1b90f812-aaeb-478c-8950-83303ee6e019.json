  "content": {
    "id": "p14-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Expand these expressions, then simplify the result.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(x+1)+3(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x+14$",
          "worked": "$$\\begin{align*}2(x+1)+3(x+4)&=2x+2+3x+12\\\\2(x+1)+3(x+4)&=5x+14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$3(x+4)+2(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x+14$",
          "worked": "$$\\begin{align*}3(x+4)+2(x+1)&=3x+12+2x+2\\\\3(x+4)+2(x+1)&=5x+14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$x(x-1)+1(x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-1$",
          "worked": "$$\\begin{align*}x(x-1)+1(x-1)&=x^2-x+x-1\\\\x(x-1)+1(x-1)&=x^2-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$a(b+3)+2(b+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab+3a+2b+6$",
          "worked": "$$a(b+3)+2(b+3)=ab+3a+2b+6$$\nThere are no like terms to collect.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
