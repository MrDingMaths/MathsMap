        "prompt": "Use first principles differentiation to find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=0$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{c-c}{h}\\\\f'(x)&=\\lim_{h\\to0}0\\\\f'(x)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Interpret your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The rate of change of a horizontal line is 0.",
          "worked": "The graph of $f(x)=c$ is a horizontal line. Its tangent has gradient 0 at every point, so its rate of change is 0.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
