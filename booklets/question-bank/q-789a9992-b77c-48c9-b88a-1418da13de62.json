  "content": {
    "id": "p10-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "How many ways can you arrange the digits in the number $12345$ so that the even digits are separated by at least one odd digit?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$72$.\n\nSubtract arrangements with the even digits together from all arrangements.",
      "worked": "There are $5!$ unrestricted arrangements. Grouping the even digits $2$ and $4$ together leaves four objects to arrange, with $2!$ orders within the group.\n\n$$\\begin{align*}N_{\\text{total}} &= 5! = 120\\\\N_{\\text{together}} &= 4!\\times2! = 48\\\\N_{\\text{separated}} &= 120-48 = 72\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
