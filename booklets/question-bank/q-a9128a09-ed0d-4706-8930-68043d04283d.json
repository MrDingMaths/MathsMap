  "content": {
    "id": "p24-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Consider the four points $A(1,4)$, $B(2,\\sqrt{13})$, $C(3,2\\sqrt{2})$ and $D(4,1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the distance of each point from the origin O.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$OA=OB=OC=OD=\\sqrt{17}$",
          "worked": "$$\\begin{align*}OA&=\\sqrt{1^2+4^2}=\\sqrt{17}\\\\OB&=\\sqrt{2^2+(\\sqrt{13})^2}=\\sqrt{17}\\\\OC&=\\sqrt{3^2+(2\\sqrt{2})^2}=\\sqrt{17}\\\\OD&=\\sqrt{4^2+1^2}=\\sqrt{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p24-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence explain why the four points lie on a circle with centre the origin and state the equation of the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All four points are $\\sqrt{17}$ from the origin, so they lie on the circle $x^2+y^2=17$.",
          "worked": "All four points are equidistant from the origin, so they lie on a circle with centre $(0,0)$ and radius $\\sqrt{17}$.\n$$\\begin{align*}x^2+y^2&=(\\sqrt{17})^2\\\\x^2+y^2&=17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p24-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the radius, diameter, circumference and area of this circle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\sqrt{17}$, $d=2\\sqrt{17}$, $C=2\\pi\\sqrt{17}$, $A=17\\pi$.",
          "worked": "$$\\begin{align*}r&=\\sqrt{17}\\\\d&=2r=2\\sqrt{17}\\\\C&=2\\pi r=2\\pi\\sqrt{17}\\\\A&=\\pi r^2=\\pi(\\sqrt{17})^2=17\\pi\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
