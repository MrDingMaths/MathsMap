    "type": "question",
    "label": null,
    "prompt": "The length of a rectangle is $\\frac{6x}{5}$ cm and its width is $\\frac{10}{9y}$ cm.\n\nWrite an expression for the area of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "v2-49160-p14-practice-j14-213223-j14-d1",
        "role": "question",
        "format": "tikz",
        "code": "\\begin{tikzpicture}\n\\draw (0,0) rectangle (3.4,1.8);\n\\node[below] at (1.7,0) {$\\frac{6x}{5}$ cm};\n\\node[right] at (3.4,0.9) {$\\frac{10}{9y}$ cm};\n\\end{tikzpicture}",
        "src": null,
