    "children": [],
    "answer": {
      "short": "$\\frac{4x}{3y}\\text{ cm}^2$",
      "worked": "$$\\begin{align*}\\text{Area}&=\\frac{6x}{5}\\times\\frac{10}{9y}\\\\&=\\frac{60x}{45y}\\\\&=\\frac{4x}{3y}\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
