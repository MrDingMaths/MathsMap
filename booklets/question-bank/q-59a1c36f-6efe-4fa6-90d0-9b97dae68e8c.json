  "content": {
    "id": "p54-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "If $A$ and $B$ are the points $(1,-1)$ and $(7,3)$ respectively, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{AB}$ in component form,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\mathbf{i}+4\\mathbf{j}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}&=\\overrightarrow{OA}=\\mathbf{i}-\\mathbf{j}\\\\\\underset{\\sim}{b}&=\\overrightarrow{OB}=7\\mathbf{i}+3\\mathbf{j}\\\\\\overrightarrow{AB}&=\\overrightarrow{OB}-\\overrightarrow{OA}\\\\&=(7\\mathbf{i}+3\\mathbf{j})-(\\mathbf{i}-\\mathbf{j})\\\\&=6\\mathbf{i}+4\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p54-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$|\\overrightarrow{AB}|$,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{13}$",
          "worked": "$$\\begin{aligned}|\\overrightarrow{AB}|&=\\sqrt{6^2+4^2}\\\\&=2\\sqrt{13}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p54-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "the unit vector in the direction of $\\overrightarrow{AB}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{\\sqrt{13}}\\mathbf{i}+\\dfrac{2}{\\sqrt{13}}\\mathbf{j}$",
          "worked": "$$\\begin{aligned}\\widehat{AB}&=\\frac{\\overrightarrow{AB}}{|\\overrightarrow{AB}|}\\\\&=\\frac{6\\mathbf{i}+4\\mathbf{j}}{2\\sqrt{13}}\\\\&=\\frac{3}{\\sqrt{13}}\\mathbf{i}+\\frac{2}{\\sqrt{13}}\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
