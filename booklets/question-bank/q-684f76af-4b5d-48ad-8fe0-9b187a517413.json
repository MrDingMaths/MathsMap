              ]
            },
            {
              "id": "p3-q12-b-hint",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Hint: Use part (a).",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=d$, $b=e$ and $c=f$.\n\nApply part (a) to $(a-d)x^2+(b-e)x+(c-f)=0$.",
          "worked": "Rearrange:\n$$\\begin{align*}ax^2+bx+c-dx^2-ex-f&=0\\\\(a-d)x^2+(b-e)x+(c-f)&=0\\end{align*}$$\nThis equation has three distinct solutions. By part (a), $a-d=0$, $b-e=0$ and $c-f=0$. Hence $a=d$, $b=e$ and $c=f$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
