  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The line passing through the points $(-4,6)$ and $(b,2)$ has gradient $\\frac{1}{2}$. Find the value of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=-12$",
      "worked": "Using $m=\\dfrac{y_2-y_1}{x_2-x_1}$:\n$$\\begin{align*}\\frac{1}{2}&=\\frac{2-6}{b-(-4)}\\\\\\frac{1}{2}&=\\frac{-4}{b+4}\\\\b+4&=-8\\\\b&=-12\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
