  "content": {
    "id": "p16-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Suppose $a$, $b$ and $c$ are positive numbers for which $ab=2$, $bc=4$ and $ac=18$. Find the value of\n$$\\frac{1}{a}+\\frac{1}{b}+\\frac{1}{c}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2$\n\nCombine the pairwise products to find $a=3$, $b=\\frac{2}{3}$ and $c=6$, then add their reciprocals.",
      "worked": "$$\\begin{align*}a^2&=\\frac{(ab)(ac)}{bc}\\\\a^2&=\\frac{2\\times18}{4}\\\\a^2&=9\\end{align*}$$\nSince $a>0$, $a=3$.\n$$\\begin{align*}b&=\\frac{2}{3}\\\\c&=\\frac{18}{3}\\\\c&=6\\end{align*}$$\n$$\\begin{align*}\\frac{1}{a}+\\frac{1}{b}+\\frac{1}{c}&=\\frac{1}{3}+\\frac{3}{2}+\\frac{1}{6}\\\\\\frac{1}{a}+\\frac{1}{b}+\\frac{1}{c}&=\\frac{2+9+1}{6}\\\\\\frac{1}{a}+\\frac{1}{b}+\\frac{1}{c}&=2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 90
  },
