    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+6x+8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)(x+2)$",
          "worked": "$4+2=6$ and $4\\times2=8$.\n\n$$\\begin{align*}x^2+6x+8&=(x+4)(x+2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$m^2+8m+15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m+3)(m+5)$",
          "worked": "$3+5=8$ and $3\\times5=15$.\n\n$$\\begin{align*}m^2+8m+15&=(m+3)(m+5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+15x+36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x+12)$",
          "worked": "$3+12=15$ and $3\\times12=36$.\n\n$$\\begin{align*}x^2+15x+36&=(x+3)(x+12).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+4x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2$",
          "worked": "$2+2=4$ and $2\\times2=4$.\n\n$$\\begin{align*}x^2+4x+4&=(x+2)^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$a^2-7a+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-2)(a-5)$",
          "worked": "$-2+(-5)=-7$ and $(-2)(-5)=10$.\n\n$$\\begin{align*}a^2-7a+10&=(a-2)(a-5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2-10x+24$",
        "layout": "list",
        "columns": null,
