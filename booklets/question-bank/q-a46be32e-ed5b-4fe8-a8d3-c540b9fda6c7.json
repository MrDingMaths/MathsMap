  "content": {
    "id": "p11-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "If $A=\\{1,3,5\\}$, $B=\\{3,4\\}$ and universal set $U=\\{1,2,3,4,5\\}$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$A\\cup B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{1,3,4,5\\}$",
          "worked": "The union contains every element in either set, without repeats.\n\n$A\\cup B=\\{1,3,4,5\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$|A\\cup B|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|A\\cup B|=4$",
          "worked": "$A\\cup B=\\{1,3,4,5\\}$ contains four elements, so $|A\\cup B|=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$A\\cap B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cap B=\\{3\\}$",
          "worked": "Only $3$ is in both sets.\n\n$A\\cap B=\\{3\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$|A\\cap B|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|A\\cap B|=1$",
          "worked": "$A\\cap B=\\{3\\}$ contains one element, so $|A\\cap B|=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\overline{A}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overline{A}=\\{2,4\\}$",
          "worked": "The elements in $U$ that are not in $A$ are $2$ and $4$.\n\n$\\overline{A}=\\{2,4\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q16-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\overline{B}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overline{B}=\\{1,2,5\\}$",
          "worked": "The elements in $U$ that are not in $B$ are $1$, $2$ and $5$.\n\n$\\overline{B}=\\{1,2,5\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
