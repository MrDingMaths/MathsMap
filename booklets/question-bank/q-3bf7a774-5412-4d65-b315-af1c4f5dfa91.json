              "type": "text",
              "text": "If you double the height of a cylinder, do you double its surface area?",
              "marks": []
            }
          ]
        },
        {
          "id": "p23-q12-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Explain why.",
              "marks": []
