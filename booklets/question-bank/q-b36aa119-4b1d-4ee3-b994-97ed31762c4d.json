  "content": {
    "id": "simple-cubic-r26-backfill-4-root",
    "type": "question",
    "label": null,
    "prompt": "A rectangular prism has dimensions in the ratio $1:3:5$. Calculate the side lengths if the volume is $100\\text{ m}^3$. Round your answers to 2 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1.88\\text{ m},\\ 5.65\\text{ m},\\ 9.41\\text{ m}$",
      "worked": "Let the side lengths be $x$, $3x$ and $5x$ metres.\n$$\\begin{align*}x\\times3x\\times5x&=100\\\\15x^3&=100\\\\x^3&=\\frac{20}{3}\\\\x&=\\sqrt[3]{\\frac{20}{3}}\\\\x&\\approx1.882\\end{align*}$$\nThe side lengths are approximately $1.88\\text{ m}$, $5.65\\text{ m}$ and $9.41\\text{ m}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
