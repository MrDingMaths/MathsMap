  "content": {
    "id": "p3-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Let $P(x)=x^2+2x+1$ and $Q(x)=x^2-1$. Find each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(P+Q)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2+2x$",
          "worked": "$$\\begin{align*}(P+Q)(x)&=(x^2+2x+1)+(x^2-1)\\\\(P+Q)(x)&=2x^2+2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p3-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(P-Q)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+2$",
          "worked": "$$\\begin{align*}(P-Q)(x)&=(x^2+2x+1)-(x^2-1)\\\\(P-Q)(x)&=x^2+2x+1-x^2+1\\\\(P-Q)(x)&=2x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(P\\cdot Q)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+2x^3-2x-1$",
          "worked": "$$\\begin{align*}(P\\cdot Q)(x)&=(x^2+2x+1)(x^2-1)\\\\(P\\cdot Q)(x)&=x^4-x^2+2x^3-2x+x^2-1\\\\(P\\cdot Q)(x)&=x^4+2x^3-2x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(Q\\circ P)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+4x^3+6x^2+4x$",
          "worked": "$$\\begin{align*}(Q\\circ P)(x)&=Q(P(x))\\\\(Q\\circ P)(x)&=(x^2+2x+1)^2-1\\\\(Q\\circ P)(x)&=x^4+4x^3+6x^2+4x+1-1\\\\(Q\\circ P)(x)&=x^4+4x^3+6x^2+4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(P\\circ Q)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4$",
          "worked": "$$\\begin{align*}(P\\circ Q)(x)&=P(Q(x))\\\\(P\\circ Q)(x)&=(x^2-1)^2+2(x^2-1)+1\\\\(P\\circ Q)(x)&=x^4-2x^2+1+2x^2-2+1\\\\(P\\circ Q)(x)&=x^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\dfrac{P}{Q}\\right)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x-1}$, $x\\ne\\pm1$.",
          "worked": "$$\\begin{align*}\\left(\\frac{P}{Q}\\right)(x)&=\\frac{x^2+2x+1}{x^2-1}\\\\\\left(\\frac{P}{Q}\\right)(x)&=\\frac{(x+1)^2}{(x-1)(x+1)}\\\\\\left(\\frac{P}{Q}\\right)(x)&=\\frac{x+1}{x-1}\\end{align*}$$\n\nThe original denominator requires $x\\ne\\pm1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
