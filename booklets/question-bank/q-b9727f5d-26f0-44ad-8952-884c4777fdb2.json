  "content": {
    "id": "p55-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The equation for the arch of a bridge is $h=-\\frac{1}{500}(x-100)^2+20$, where $h$ is the height above the base in metres and $x$ is distance from the left end of the bridge.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p55-q4-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 55 p55-q4-diagram\"}\n\\begin{tikzpicture}[x=0.25mm,y=1mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,line width=0.5pt] (-35,0)--(235,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-9)--(0,27) node[above] {$h$};\n\\draw[line width=0.8pt,domain=0:200,samples=81] plot (\\x,{-(\\x-100)*(\\x-100)/500+20});\n\\fill (0,0) circle (1.4pt);\n\\fill (100,20) circle (1.4pt);\n\\fill (200,0) circle (1.4pt);\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
