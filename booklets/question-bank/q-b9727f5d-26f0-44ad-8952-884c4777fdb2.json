    "children": [
      {
        "id": "p55-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the coordinate of the turning point of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(100,20)$",
          "worked": "In vertex form $h=a(x-100)^2+20$, the turning point is $(100,20)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p55-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine the $x$-intercepts of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ and $x=200$",
          "worked": "Let $h=0$.\n$$\\begin{align*}0&=-\\frac1{500}(x-100)^2+20\\\\\\frac1{500}(x-100)^2&=20\\\\(x-100)^2&=10000\\\\x-100&=\\pm100\\\\x&=100\\pm100\\\\x&=0\\text{ or }200.\\end{align*}$$\nThe intercepts are $(0,0)$ and $(200,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p55-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine the span (horizontal length) of the arch.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$200\\text{ m}$",
          "worked": "$$\\begin{align*}\\text{Span}&=200-0\\\\\\text{Span}&=200\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p55-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the maximum height of the arch?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ m}$",
          "worked": "The parabola is concave down, so its vertex $(100,20)$ gives the maximum height of $20\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
