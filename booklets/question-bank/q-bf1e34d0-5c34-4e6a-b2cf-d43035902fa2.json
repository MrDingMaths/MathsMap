  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Alex has seven different caps in the bottom of his wardrobe. Four of them are black, two of them are blue and one is red. If he pulls out a cap at random, what is the probability it is blue?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{7}$",
      "worked": "There are 2 blue caps among 7 equally likely caps.\n$$P(\\text{blue})=\\frac{\\text{number of blue caps}}{\\text{total number of caps}}=\\frac{2}{7}.$$",
      "solutionDiagrams": []
    },
