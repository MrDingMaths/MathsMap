  "content": {
    "id": "v2-ac439-p13-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "The points $A(-2,-2)$ and $B(1,7)$ lie on a line. The point $(k,k^2)$ also lies on this line.\n\nFind the possible values of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=4$ or $k=-1$",
      "worked": "$$\\begin{align*}m&=\\frac{7-(-2)}{1-(-2)}=3\\\\y-7&=3(x-1)\\\\y&=3x+4\\end{align*}$$\nSubstituting $(k,k^2)$:\n$$\\begin{align*}k^2&=3k+4\\\\k^2-3k-4&=0\\\\(k-4)(k+1)&=0\\end{align*}$$\nSo $k=4$ or $k=-1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
