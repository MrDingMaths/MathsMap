  "content": {
    "id": "p15-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Find $f(t)-2$ and $f(t-2)$ for:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=5x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5t$; $5t-8$",
          "worked": "$$\\begin{align*}f(t)-2&=5t+2-2\\\\&=5t\\end{align*}$$\n$$\\begin{align*}f(t-2)&=5(t-2)+2\\\\&=5t-10+2\\\\&=5t-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{t}-2$; $\\sqrt{t-2}$",
          "worked": "$$f(t)-2=\\sqrt{t}-2$$\n$$f(t-2)=\\sqrt{t-2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=2-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-t^2$; $-t^2+4t-2$",
          "worked": "$$\\begin{align*}f(t)-2&=2-t^2-2\\\\&=-t^2\\end{align*}$$\n$$\\begin{align*}f(t-2)&=2-(t-2)^2\\\\&=2-(t^2-4t+4)\\\\&=-t^2+4t-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
