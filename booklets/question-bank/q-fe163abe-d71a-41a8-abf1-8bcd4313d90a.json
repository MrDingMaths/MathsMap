      {
        "id": "p23-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "I flip three fair coins. What is the probability that I get a head on each?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$\\begin{align*}P(\\text{three heads})&=\\frac{1}{2}\\times\\frac{1}{2}\\times\\frac{1}{2}\\\\&=\\frac{1}{8}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "I have already flipped two coins and both are heads.\nExplain why the probability that the next coin I flip will also be heads is $\\frac{1}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The flips are independent, so previous heads do not change the next flip's probability of heads, $\\frac{1}{2}$.",
          "worked": "Coin flips are independent. The first two results do not affect the next flip, so a fair coin still has probability $\\frac{1}{2}$ of landing heads.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
