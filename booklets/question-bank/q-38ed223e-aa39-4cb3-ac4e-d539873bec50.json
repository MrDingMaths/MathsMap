  "content": {
    "id": "p41-q13-root",
    "type": "question",
    "label": null,
    "prompt": "For each DE, find the solution curve passing through the given point.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{dy}{dx}=\\dfrac{x}{y}$, through $(0,1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^2=x^2+1$, with $y>0$.",
          "worked": "$$\\begin{align*}y\\,dy&=x\\,dx\\\\\\int y\\,dy&=\\int x\\,dx\\\\\\frac{y^2}{2}&=\\frac{x^2}{2}+C\\\\y^2&=x^2+D\\end{align*}$$\nUsing $(0,1)$ gives $1=D$.\n$$y^2=x^2+1.$$\nThe branch through $(0,1)$ has $y>0$, so $y=\\sqrt{x^2+1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p41-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{dy}{dx}=(1+x)(1+y^2)$, with $y(-1)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\tan\\left(\\dfrac{x^2}{2}+x+\\dfrac12\\right)$",
          "worked": "$$\\begin{align*}\\frac{1}{1+y^2}\\,dy&=(1+x)\\,dx\\\\\\int\\frac{1}{1+y^2}\\,dy&=\\int(1+x)\\,dx\\\\\\arctan y&=x+\\frac{x^2}{2}+C\\end{align*}$$\nUsing $y(-1)=0$:\n$$\\begin{align*}0&=-1+\\frac12+C\\\\C&=\\frac12\\\\y&=\\tan\\left(\\frac{x^2}{2}+x+\\frac12\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p41-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{dy}{dx}=-2y^2x$, with $y(1)=\\dfrac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{x^2+1}$",
          "worked": "$$\\begin{align*}y^{-2}\\,dy&=-2x\\,dx\\\\\\int y^{-2}\\,dy&=\\int-2x\\,dx\\\\-\\frac1y&=-x^2+C\\end{align*}$$\nUsing $y(1)=\\frac12$:\n$$\\begin{align*}-2&=-1+C\\\\C&=-1\\\\-\\frac1y&=-x^2-1\\\\y&=\\frac{1}{x^2+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p41-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{dy}{dx}=e^{-y}\\sec^2x$, through $\\left(\\dfrac\\pi4,\\log 2\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln(\\tan x+1)$",
          "worked": "$$\\begin{align*}e^y\\,dy&=\\sec^2x\\,dx\\\\\\int e^y\\,dy&=\\int\\sec^2x\\,dx\\\\e^y&=\\tan x+C\\end{align*}$$\nUsing $\\left(\\frac\\pi4,\\ln2\\right)$:\n$$\\begin{align*}2&=1+C\\\\C&=1\\\\e^y&=\\tan x+1\\\\y&=\\ln(\\tan x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
