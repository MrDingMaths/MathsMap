    "label": "27",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p30-q25-electric",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Electric cars use on average 17 kWh per 100 km. Electricity costs $0.28 per kWh.",
              "marks": []
            }
          ]
        },
        {
          "id": "p30-q25-petrol",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Petrol cars use on average 9 L per 100 km. Petrol costs $1.98 per litre.",
              "marks": []
            }
          ]
        },
        {
          "id": "p30-q25-purchase",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "The electric car costs on average $10 000 more than a petrol car.",
              "marks": []
            }
          ]
        },
        {
          "id": "p30-q25-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "How far do you have to drive the electric car until you start to save money? Give your answer to the nearest 10 km.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately $76\\,570\\text{ km}$; savings begin beyond the break-even distance.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p30-q25-answer-cost-label",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Running costs and savings per 100 km:",
                "marks": []
              }
            ]
          },
          {
            "id": "p30-q25-answer-costs",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\text{Electric cost}&=17\\times\\$0.28=\\$4.76\\\\\\text{Petrol cost}&=9\\times\\$1.98=\\$17.82\\\\\\text{Savings}&=\\$17.82-\\$4.76=\\$13.06\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p30-q25-answer-distance-label",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let the break-even distance be ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x",
                "display": false
              },
              {
                "type": "text",
                "text": " km. Set up equivalent rates, take reciprocals and multiply both sides by 10 000.",
                "marks": []
              }
            ]
          },
          {
            "id": "p30-q25-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\frac{\\$13.06}{100\\text{ km}}&=\\frac{\\$10\\,000}{x\\text{ km}}\\\\\\frac{100\\text{ km}}{\\$13.06}&=\\frac{x\\text{ km}}{\\$10\\,000}\\\\x&=\\frac{100\\times10\\,000}{13.06}\\\\x&=\\frac{50\\,000\\,000}{653}\\\\x&\\approx76\\,570\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p30-q25-answer-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The break-even distance is approximately 76 570 km, to the nearest 10 km. Driving beyond the break-even distance produces an overall saving.",
                "marks": []
              }
            ]
          }
        ]
      },
