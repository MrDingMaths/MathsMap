    "children": [
      {
        "id": "p42-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "State the domain.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>3$",
          "worked": "$$\\begin{align*}x-3&>0\\\\x&>3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p42-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "State the equation of the asymptote.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "The vertical asymptote occurs where the logarithm’s argument is zero.\n$$\\begin{align*}x-3&=0\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p42-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine the $x$-intercept by letting $y=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3.25,0)$",
          "worked": "$$\\begin{align*}0&=\\log_2(x-3)+2\\\\\\log_2(x-3)&=-2\\\\x-3&=2^{-2}\\\\x-3&=\\frac14\\\\x&=\\frac{13}{4}=3.25\\end{align*}$$\nThe $x$-intercept is $(3.25,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p42-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "State the horizontal and vertical translations applied to the graph of $\\log_2 x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Right by 3, up by 2.",
          "worked": "Replacing $x$ with $x-3$ translates the graph 3 units right. Adding 2 translates it 2 units up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
