    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coefficient of $x^4$ in the expansion of $(x+1)(x+2)^5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50$",
          "worked": "The $x^4$ terms arise from $x$ times the $x^3$ term and $1$ times the $x^4$ term of $(x+2)^5$.\n$$\\begin{align*}\n\\text{Coefficient of }x^4&=\\binom{5}{3}2^2+\\binom{5}{4}2\\\\\n\\text{Coefficient of }x^4&=40+10\\\\\n\\text{Coefficient of }x^4&=50.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coefficient of $x^3$ in the expansion of $(2x+3)(x+1)^6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90$",
          "worked": "The $x^3$ terms arise from $2x$ times the $x^2$ term and $3$ times the $x^3$ term of $(x+1)^6$.\n$$\\begin{align*}\n\\text{Coefficient of }x^3&=2\\binom{6}{2}+3\\binom{6}{3}\\\\\n\\text{Coefficient of }x^3&=30+60\\\\\n\\text{Coefficient of }x^3&=90.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the coefficient of $x^5$ in the expansion of $(3x-2)(x+2)^6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$156$",
          "worked": "The $x^5$ terms arise from $3x$ times the $x^4$ term and $-2$ times the $x^5$ term of $(x+2)^6$.\n$$\\begin{align*}\n\\text{Coefficient of }x^5&=3\\binom{6}{4}2^2-2\\binom{6}{5}2\\\\\n\\text{Coefficient of }x^5&=180-24\\\\\n\\text{Coefficient of }x^5&=156.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the coefficient of $x^3$ in the expansion of $(4x-4)(2x-1)^6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$880$",
          "worked": "The $x^3$ terms arise from $4x$ times the $x^2$ term and $-4$ times the $x^3$ term of $(2x-1)^6$.\n$$\\begin{align*}\n\\text{Coefficient of }x^3&=4\\binom{6}{2}2^2(-1)^4-4\\binom{6}{3}2^3(-1)^3\\\\\n\\text{Coefficient of }x^3&=240+640\\\\\n\\text{Coefficient of }x^3&=880.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
