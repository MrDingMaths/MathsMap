        "answer": {
          "short": "$7+\\cfrac{1}{3+\\cfrac{1}{1+\\cfrac14}}=\\frac{138}{19}$.",
          "worked": "$$\\begin{align*}7+\\cfrac{1}{3+\\cfrac{1}{1+\\cfrac14}}&=7+\\cfrac{1}{3+\\cfrac{1}{5/4}}\\\\7+\\cfrac{1}{3+\\cfrac{1}{1+\\cfrac14}}&=7+\\cfrac{1}{3+\\frac45}\\\\7+\\cfrac{1}{3+\\cfrac{1}{1+\\cfrac14}}&=7+\\cfrac{1}{19/5}\\\\7+\\cfrac{1}{3+\\cfrac{1}{1+\\cfrac14}}&=7+\\frac5{19}\\\\7+\\cfrac{1}{3+\\cfrac{1}{1+\\cfrac14}}&=\\frac{138}{19}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p38-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Express $\\frac{153}{11}$ as a continued fraction with all numerators $1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13+\\cfrac{1}{1+\\cfrac{1}{10}}$.",
          "worked": "$$\\begin{align*}\\frac{153}{11}&=13+\\frac{10}{11}\\\\\\frac{153}{11}&=13+\\cfrac{1}{11/10}\\\\\\frac{153}{11}&=13+\\cfrac{1}{1+\\cfrac{1}{10}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
