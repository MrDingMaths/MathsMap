  "content": {
    "id": "p23-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve for $x$ or $n$, as appropriate.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$7^{x+9}=49$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7$",
          "worked": "$$\\begin{align*}7^{x+9}&=7^2\\\\x+9&=2\\\\x&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{x+1}=8^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$",
          "worked": "$$\\begin{align*}2^{x+1}&=2^{3x}\\\\x+1&=3x\\\\2x&=1\\\\x&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$9^{x+12}=81^{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}3^{2(x+12)}&=3^{4(x+5)}\\\\2x+24&=4x+20\\\\4&=2x\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$27^{x+3}=9^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=9$",
          "worked": "$$\\begin{align*}3^{3(x+3)}&=3^{4x}\\\\3x+9&=4x\\\\x&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$32^{2x+3}=128^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{15}{4}$",
          "worked": "$$\\begin{align*}2^{5(2x+3)}&=2^{14x}\\\\10x+15&=14x\\\\4x&=15\\\\x&=\\frac{15}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$25^{x+3}=125^{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac67$",
          "worked": "$$\\begin{align*}5^{2(x+3)}&=5^{9x}\\\\2x+6&=9x\\\\7x&=6\\\\x&=\\frac67\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$27^{2x+3}=9^{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{11}{2}$",
          "worked": "$$\\begin{align*}3^{3(2x+3)}&=3^{2(2x-1)}\\\\6x+9&=4x-2\\\\2x&=-11\\\\x&=-\\frac{11}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$9^{x-1}=27^{2x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}3^{2(x-1)}&=3^{3(2x-6)}\\\\2x-2&=6x-18\\\\4x&=16\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$49^{2x-3}=343^{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac32$",
          "worked": "$$\\begin{align*}7^{2(2x-3)}&=7^{3(2x-1)}\\\\4x-6&=6x-3\\\\2x&=-3\\\\x&=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$6^{2n-6}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=3$",
          "worked": "$$\\begin{align*}6^{2n-6}&=6^0\\\\2n-6&=0\\\\n&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$11^{3n-1}=11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac23$",
          "worked": "$$\\begin{align*}11^{3n-1}&=11^1\\\\3n-1&=1\\\\3n&=2\\\\n&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$8^{5n-1}=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac{2}{15}$",
          "worked": "$$\\begin{align*}2^{3(5n-1)}&=2^{-1}\\\\15n-3&=-1\\\\15n&=2\\\\n&=\\frac{2}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
