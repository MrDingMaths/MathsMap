        "answer": {
          "short": "$1$",
          "worked": "$\\begin{aligned}\\frac{n(n-1)!}{n!}&=\\frac{n(n-1)!}{n(n-1)!}\\\\&=1\\end{aligned}$",
          "solutionDiagrams": []
