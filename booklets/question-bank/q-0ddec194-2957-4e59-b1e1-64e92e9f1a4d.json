        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n$",
          "worked": "$\\begin{aligned}\\frac{n!}{(n-1)!}&=\\frac{n(n-1)!}{(n-1)!}\\\\&=n\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
