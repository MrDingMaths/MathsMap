          "short": "$(n+1)(n+2)$",
          "worked": "$\\begin{aligned}\\frac{(n+2)!}{n!}&=\\frac{(n+2)(n+1)n!}{n!}\\\\&=(n+1)(n+2)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
