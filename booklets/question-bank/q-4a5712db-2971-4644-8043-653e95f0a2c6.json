  "content": {
    "id": "p11-ch17-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Twenty-one less than a number is equal to 100 divided by the number. What can the number be?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$25$ or $-4$.",
      "worked": "Let the number be $x$, where $x\\ne0$.\n\n$$\\begin{align*}x-21&=\\frac{100}{x}\\\\x(x-21)&=100\\\\x^2-21x-100&=0\\\\(x-25)(x+4)&=0\\\\x-25&=0\\quad\\text{or}\\quad x+4=0\\\\x&=25\\quad\\text{or}\\quad x=-4\\end{align*}$$\n\nCheck: $25-21=4=100\\div25$ and $-4-21=-25=100\\div(-4)$. Both numbers satisfy the question.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 57
  },
