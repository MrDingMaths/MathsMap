    "children": [
      {
        "id": "p20-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac47\\left(\\frac12+\\frac34\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac57$",
          "worked": "$$\\begin{align*}\\frac47\\left(\\frac12+\\frac34\\right)&=\\frac47\\left(\\frac24+\\frac34\\right)\\\\\\frac47\\left(\\frac12+\\frac34\\right)&=\\frac47\\times\\frac54\\\\\\frac47\\left(\\frac12+\\frac34\\right)&=\\frac{1\\times5}{7\\times1}\\\\\\frac47\\left(\\frac12+\\frac34\\right)&=\\frac57\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac25\\left(\\frac34-\\frac38\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{20}$",
          "worked": "$$\\begin{align*}\\frac25\\left(\\frac34-\\frac38\\right)&=\\frac25\\left(\\frac68-\\frac38\\right)\\\\\\frac25\\left(\\frac34-\\frac38\\right)&=\\frac25\\times\\frac38\\\\\\frac25\\left(\\frac34-\\frac38\\right)&=\\frac{1\\times3}{5\\times4}\\\\\\frac25\\left(\\frac34-\\frac38\\right)&=\\frac3{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac23+\\left(\\frac34\\times\\frac89\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac43$",
          "worked": "$$\\begin{align*}\\frac23+\\left(\\frac34\\times\\frac89\\right)&=\\frac23+\\frac{1\\times2}{1\\times3}\\\\\\frac23+\\left(\\frac34\\times\\frac89\\right)&=\\frac23+\\frac23\\\\\\frac23+\\left(\\frac34\\times\\frac89\\right)&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac45-\\left(\\frac35\\div\\frac69\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac1{10}$",
          "worked": "$$\\begin{align*}\\frac45-\\left(\\frac35\\div\\frac69\\right)&=\\frac45-\\left(\\frac35\\times\\frac96\\right)\\\\\\frac45-\\left(\\frac35\\div\\frac69\\right)&=\\frac45-\\frac9{10}\\\\\\frac45-\\left(\\frac35\\div\\frac69\\right)&=\\frac8{10}-\\frac9{10}\\\\\\frac45-\\left(\\frac35\\div\\frac69\\right)&=-\\frac1{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
