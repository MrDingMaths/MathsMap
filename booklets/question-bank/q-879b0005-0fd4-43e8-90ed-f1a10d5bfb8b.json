  "content": {
    "id": "p40-q76-response",
    "type": "question",
    "label": "76",
    "prompt": "Let $f(x)=\\dfrac{(1+x)^m}{(1-x)^n}$, where $m$ and $n$ are integers greater than $1$, with $m\\ne n$. Find the value(s) of $x$ such that $f'(x)=0$.",
