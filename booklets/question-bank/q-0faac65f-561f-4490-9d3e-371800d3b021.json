    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q20-a",
        "type": "group",
        "label": "a",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q20-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\phi^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{3+\\sqrt5}{2}$",
              "worked": "$$\\begin{align*}\\phi^2&=\\left(\\frac{\\sqrt5+1}{2}\\right)^2\\\\\\phi^2&=\\frac{5+2\\sqrt5+1}{4}\\\\\\phi^2&=\\frac{3+\\sqrt5}{2}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p23-q20-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\dfrac1\\phi$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{\\sqrt5-1}{2}$",
              "worked": "$$\\begin{align*}\\frac1\\phi&=\\frac2{\\sqrt5+1}\\\\\\frac1\\phi&=\\frac{2(\\sqrt5-1)}{5-1}\\\\\\frac1\\phi&=\\frac{\\sqrt5-1}{2}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p23-q20-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$1+\\dfrac1\\phi$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1+\\sqrt5}{2}$",
              "worked": "$$\\begin{align*}1+\\frac1\\phi&=1+\\frac{\\sqrt5-1}{2}\\\\1+\\frac1\\phi&=\\frac{1+\\sqrt5}{2}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p23-q20-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$\\phi^3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2+\\sqrt5$",
              "worked": "$$\\begin{align*}\\phi^3&=\\frac{3+\\sqrt5}{2}\\cdot\\frac{1+\\sqrt5}{2}\\\\\\phi^3&=\\frac{3+3\\sqrt5+\\sqrt5+5}{4}\\\\\\phi^3&=2+\\sqrt5.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p23-q20-a-v",
            "type": "part",
            "label": "v",
            "prompt": "$\\phi+\\dfrac1{\\phi^2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$$\\begin{align*}\\frac1{\\phi^2}&=\\left(\\frac{\\sqrt5-1}{2}\\right)^2\\\\\\frac1{\\phi^2}&=\\frac{3-\\sqrt5}{2}\\\\\\phi+\\frac1{\\phi^2}&=\\frac{1+\\sqrt5}{2}+\\frac{3-\\sqrt5}{2}\\\\\\phi+\\frac1{\\phi^2}&=2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      },
      {
        "id": "p23-q20-b",
        "type": "group",
        "label": "b",
        "prompt": "Show that:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q20-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\phi^2=\\phi+1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\phi^2=\\dfrac{3+\\sqrt5}{2}=\\phi+1$.",
              "worked": "Using part a,\n$$\\begin{align*}\\phi+1&=\\frac{1+\\sqrt5}{2}+1\\\\\\phi+1&=\\frac{3+\\sqrt5}{2}\\\\\\phi+1&=\\phi^2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p23-q20-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\phi^3=\\phi^2+\\phi$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\phi^3=2+\\sqrt5=\\phi^2+\\phi$.",
              "worked": "Using part a,\n$$\\begin{align*}\\phi^2+\\phi&=\\frac{3+\\sqrt5}{2}+\\frac{1+\\sqrt5}{2}\\\\\\phi^2+\\phi&=2+\\sqrt5\\\\\\phi^2+\\phi&=\\phi^3.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p23-q20-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\phi=1+\\dfrac1\\phi$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1+\\dfrac1\\phi=\\dfrac{1+\\sqrt5}{2}=\\phi$.",
              "worked": "Using part a,\n$$\\begin{align*}1+\\frac1\\phi&=1+\\frac{\\sqrt5-1}{2}\\\\1+\\frac1\\phi&=\\frac{1+\\sqrt5}{2}\\\\1+\\frac1\\phi&=\\phi.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
