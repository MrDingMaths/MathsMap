  "content": {
    "id": "p62-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "$P(x)=x^3-3x-2$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p62-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $(x+1)$ is a factor of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-1)=(-1)^3-3(-1)-2=0$, so $(x+1)$ is a factor.",
          "worked": "$$\\begin{align*}P(-1)&=(-1)^3-3(-1)-2\\\\P(-1)&=-1+3-2\\\\P(-1)&=0\\end{align*}$$\nBy the factor theorem, $(x+1)$ is a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p62-q1-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p62-q1-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Hence by using long division, write: ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "P(x)=(x+1)(",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$x^2-x-2$",
                  "width": 22
                },
                {
                  "type": "math",
                  "latex": ")",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x+1)(x^2-x-2)$.",
          "worked": "Insert the missing $x^2$ term with coefficient zero. Subtract each product row from the row above it.\n$$\\begin{array}{rrrrr}&x^2&-x&-2&\\\\\\hline x+1&x^3&+0x^2&-3x&-2\\\\&x^3&+x^2&&\\\\\\hline &&-x^2&-3x&-2\\\\&&-x^2&-x&\\\\\\hline &&&-2x&-2\\\\&&&-2x&-2\\\\\\hline &&&&0\\end{array}$$\nTherefore $P(x)=(x+1)(x^2-x-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p62-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "By factorising the resultant quadratic, express $P(x)$ as a product of linear factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x+1)^2(x-2)$.",
          "worked": "$$\\begin{align*}x^2-x-2&=(x+1)(x-2)\\\\P(x)&=(x+1)(x+1)(x-2)\\\\P(x)&=(x+1)^2(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
