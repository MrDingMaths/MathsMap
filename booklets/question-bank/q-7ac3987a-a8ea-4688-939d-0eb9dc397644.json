      {
        "id": "p45-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Interpret the gradient and $y$-intercept",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Average height tends to increase by approximately $0.1524$ cm per year. The intercept gives a formal model height of $-134.57$ cm at year $0$; this has no realistic interpretation.",
          "worked": "The gradient is approximately $0.1524$ cm per year, so the model estimates that average height of 17-year-old girls increases by this amount each year over the observed period.\n\nAt $x = 0$, the model gives $y \\approx -134.57$ cm. Year $0$ is far outside 1850–1990 and a negative height is impossible, so the intercept is a formal model value with no realistic predictive meaning.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
