  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Expand these differences of two squares involving fractional terms.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(x+\\frac{1}{3}\\right)\\left(x-\\frac{1}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{2}-\\frac{1}{9}$",
          "worked": "$a=x$, $b=\\frac{1}{3}$.\n$$\\begin{align*}\\left(x+\\frac{1}{3}\\right)\\left(x-\\frac{1}{3}\\right)&=x^{2}-\\left(\\frac{1}{3}\\right)^{2}\\\\&=x^{2}-\\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(x+\\frac{3}{4}\\right)\\left(x-\\frac{3}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{2}-\\frac{9}{16}$",
          "worked": "$a=x$, $b=\\frac{3}{4}$.\n$$\\begin{align*}\\left(x+\\frac{3}{4}\\right)\\left(x-\\frac{3}{4}\\right)&=x^{2}-\\left(\\frac{3}{4}\\right)^{2}\\\\&=x^{2}-\\frac{9}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{x}{3}+\\frac{4}{5}\\right)\\left(\\frac{x}{3}-\\frac{4}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^{2}}{9}-\\frac{16}{25}$",
          "worked": "$a=\\frac{x}{3}$, $b=\\frac{4}{5}$.\n$$\\begin{align*}\\left(\\frac{x}{3}+\\frac{4}{5}\\right)\\left(\\frac{x}{3}-\\frac{4}{5}\\right)&=\\left(\\frac{x}{3}\\right)^{2}-\\left(\\frac{4}{5}\\right)^{2}\\\\&=\\frac{x^{2}}{9}-\\frac{16}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{x}{2}+\\frac{y}{7}\\right)\\left(\\frac{x}{2}-\\frac{y}{7}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^{2}}{4}-\\frac{y^{2}}{49}$",
          "worked": "$a=\\frac{x}{2}$, $b=\\frac{y}{7}$.\n$$\\begin{align*}\\left(\\frac{x}{2}+\\frac{y}{7}\\right)\\left(\\frac{x}{2}-\\frac{y}{7}\\right)&=\\left(\\frac{x}{2}\\right)^{2}-\\left(\\frac{y}{7}\\right)^{2}\\\\&=\\frac{x^{2}}{4}-\\frac{y^{2}}{49}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(2x-\\frac{3}{7}\\right)\\left(2x+\\frac{3}{7}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^{2}-\\frac{9}{49}$",
          "worked": "$a=2x$, $b=\\frac{3}{7}$.\n$$\\begin{align*}\\left(2x-\\frac{3}{7}\\right)\\left(2x+\\frac{3}{7}\\right)&=(2x)^{2}-\\left(\\frac{3}{7}\\right)^{2}\\\\&=4x^{2}-\\frac{9}{49}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{7}{3}-5x\\right)\\left(\\frac{7}{3}+5x\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{49}{9}-25x^{2}$",
          "worked": "$a=\\frac{7}{3}$, $b=5x$.\n$$\\begin{align*}\\left(\\frac{7}{3}-5x\\right)\\left(\\frac{7}{3}+5x\\right)&=\\left(\\frac{7}{3}\\right)^{2}-(5x)^{2}\\\\&=\\frac{49}{9}-25x^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
