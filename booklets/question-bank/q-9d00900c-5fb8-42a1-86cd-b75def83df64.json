    "children": [
      {
        "id": "p110-q45-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{a^2+b^2}$ if $a=\\frac14$ and $b=\\frac13$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{12}$",
          "worked": "$$\\begin{align*}\\sqrt{a^2+b^2}&=\\sqrt{\\left(\\frac14\\right)^2+\\left(\\frac13\\right)^2}\\\\&=\\sqrt{\\frac{9+16}{16\\times9}}\\\\&=\\sqrt{\\frac{5^2}{4^2\\times3^2}}\\\\&=\\frac{5}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p110-q45-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{a^2+b^2}$ if $a=\\frac15$ and $b=\\frac1{12}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{60}$",
          "worked": "$$\\begin{align*}\\sqrt{a^2+b^2}&=\\sqrt{\\left(\\frac15\\right)^2+\\left(\\frac1{12}\\right)^2}\\\\&=\\sqrt{\\frac{144+25}{25\\times144}}\\\\&=\\sqrt{\\frac{13^2}{5^2\\times12^2}}\\\\&=\\frac{13}{60}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
