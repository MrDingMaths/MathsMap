  "content": {
    "id": "p23-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Hunter ran at $8$ km/h and walked at a speed of $3$ km/h. He spent $2$ hours more walking than running but covered the same distance. How long does he spend walking?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{16}{5}$ h",
      "worked": "Let $t$ h be Hunter's walking time. His running time is $(t-2)$ h. The walking and running distances are $3t$ km and $8(t-2)$ km.\n$$\\begin{align*}3t&=8(t-2)\\\\3t&=8t-16\\\\5t&=16\\\\t&=\\frac{16}{5}\\end{align*}$$\nHunter spends $\\frac{16}{5}$ h walking.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
