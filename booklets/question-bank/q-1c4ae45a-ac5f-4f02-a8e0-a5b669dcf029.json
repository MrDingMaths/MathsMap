  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "$ABC$ is an equilateral triangle, each of whose sides is 2 units. $D$ is the midpoint of $BC$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p13-q9-figure",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 13 question 9 diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (B) at (0,0);\\coordinate (C) at (4,0);\\coordinate (D) at (2,0);\\coordinate (A) at (2,{2*sqrt(3)});\n\\draw (B)--node[left]{$2$}(A)--node[right]{$2$}(C)--(B);\n\\draw (A)--(D);\n\\draw[line width=0.4pt] (1,-0.1)--(1,0.1) (3,-0.1)--(3,0.1);\n\\node[above] at (A) {$A$};\\node[below left] at (B) {$B$};\\node[below right] at (C) {$C$};\\node[below] at (D) {$D$};\n\\path (B)--node[below=8mm]{$2$}(C);\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 39.5,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 13,
          "sourceRegion": "Question 9 figure beside parts",
          "description": "Equilateral ABC with midpoint D and segment AD; all three side-length labels and midpoint ticks retained. No right-angle mark is supplied.",
          "mathematics": "AB=AC=BC=2 and BD=DC.",
          "answerVisibility": "givens-only"
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p13-q9-a-node",
        "type": "part",
        "label": "a",
        "prompt": "What are the angles $\\angle ABD$, $\\angle BAD$ and $\\angle ADB$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60^\\circ$, $30^\\circ$, $90^\\circ$, respectively.",
          "worked": "Each angle of equilateral triangle $ABC$ is $60^\\circ$. Triangles $ABD$ and $ACD$ are congruent by SSS, since $AB=AC$, $BD=DC$ and $AD$ is common. Hence $AD$ bisects $\\angle BAC$ and meets $BC$ at right angles. Thus $\\angle ABD=60^\\circ$, $\\angle BAD=30^\\circ$ and $\\angle ADB=90^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-b-node",
        "type": "part",
        "label": "b",
        "prompt": "What is the length of $BD$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$ unit.",
          "worked": "Since $D$ is the midpoint of $BC$, $BD=\\frac{BC}{2}=\\frac22=1$ unit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p13-q9-c-node",
        "type": "part",
        "label": "c",
        "prompt": "Find the length of $AD$ in surd form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3$ units.",
          "worked": "By Pythagoras' theorem in right-angled triangle $ABD$:\n$$\\begin{align*}AD^2&=AB^2-BD^2\\\\AD^2&=2^2-1^2\\\\AD^2&=3\\\\AD&=\\sqrt3\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
