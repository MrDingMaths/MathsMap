  "content": {
    "id": "p19-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Remi can paint a house three times as fast as Sage, and Tara can paint a house four times as fast as Sage. Together, they take 5 days to paint a house. How long would Sage take if she worked alone?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$40$ days.",
      "worked": "In the same time, Sage, Remi and Tara paint houses in the ratio $1:3:4$. Their combined rate is eight times Sage’s rate.\n\n$$\\begin{align*}\\text{Houses painted together in 5 days} &= 1\\\\\\text{Houses painted by Sage in 5 days} &= \\frac{1}{8}\\\\\\text{Time for Sage to paint one house} &= 5\\times8\\\\\\text{Time for Sage to paint one house} &= 40\\text{ days}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
