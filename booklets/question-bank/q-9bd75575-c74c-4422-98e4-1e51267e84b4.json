  "content": {
    "id": "p25-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Write in the form $(x+a)^2+c$ by completing the square.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2+2$",
          "worked": "$a=\\frac{2}{2}=1$.\n$$\\begin{align*}x^2+2x+3&=x^2+2x+1^2-1^2+3\\\\&=(x+1)^2+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+8x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2-13$",
          "worked": "$a=\\frac{8}{2}=4$.\n$$\\begin{align*}x^2+8x+3&=x^2+8x+4^2-4^2+3\\\\&=(x+4)^2-13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+4x+3$",
