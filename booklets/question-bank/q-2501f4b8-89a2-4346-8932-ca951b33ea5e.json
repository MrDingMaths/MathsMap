  "content": {
    "id": "p33-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "James has $\\$240$. Calculate:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$35\\%$ of his money",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$84$",
          "worked": "$$\\begin{align*}35\\%\\times240&=0.35\\times240\\\\35\\%\\times240&=84\\end{align*}$$\n$35\\%$ of his money is $\\$84$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p33-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "How much he has after spending $35\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$156$",
          "worked": "$$\\begin{align*}100\\%-35\\%&=65\\%\\\\65\\%\\times240&=0.65\\times240\\\\65\\%\\times240&=156\\end{align*}$$\nHe has $\\$156$ remaining.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p33-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "How much he has after receiving an extra $35\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$324$",
          "worked": "$$\\begin{align*}100\\%+35\\%&=135\\%\\\\135\\%\\times240&=1.35\\times240\\\\135\\%\\times240&=324\\end{align*}$$\nHe has $\\$324$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p33-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "How much he has after giving away $65\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$84$",
          "worked": "$$\\begin{align*}100\\%-65\\%&=35\\%\\\\35\\%\\times240&=0.35\\times240\\\\35\\%\\times240&=84\\end{align*}$$\nHe has $\\$84$ remaining.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
