          "inlines": [
            {
              "type": "text",
              "text": "Consider the ",
              "marks": []
            },
            {
              "type": "text",
              "text": "digit sum function ",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "math",
              "latex": "S(n)",
              "display": false
            },
            {
              "type": "text",
              "text": ". The input for this function is a natural number ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "n",
              "display": false
            },
            {
              "type": "text",
              "text": ", and the output is the sum of its digits.",
              "marks": []
            }
          ]
        },
        {
          "id": "p5-q9-example-paragraph",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "For example, ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "S(123)=1+2+3=6",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
