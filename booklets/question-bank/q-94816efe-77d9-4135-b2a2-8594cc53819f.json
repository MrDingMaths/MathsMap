    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $S(1234)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}S(1234)&=1+2+3+4\\\\S(1234)&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the smallest natural number $n$ such that $S(n)=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19$",
          "worked": "A one-digit number has digit sum at most $9$, so at least two digits are needed. Use the smallest possible tens digit, $1$, leaving $9$ for the units digit.\n\n$$S(19)=1+9=10.$$\n\nTherefore the smallest number is $19$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the smallest natural number $n$ such that $S(n)=100$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p5-q9-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "199\\,999\\,999\\,999",
                    "display": false
                  }
                ]
              },
              {
                "id": "p5-q9-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "At least 12 digits are needed; the smallest leading digit is 1, followed by eleven 9s.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Eleven digits have digit sum at most $11\\times9=99$, so at least twelve digits are needed. For twelve digits, the last eleven digits contribute at most $99$, so the leading digit must be at least $100-99=1$. Taking the leading digit as $1$ forces all eleven remaining digits to be $9$.\n\n$$S(199\\,999\\,999\\,999)=1+11\\times9=100.$$\n\nTherefore the smallest number is $199\\,999\\,999\\,999$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
