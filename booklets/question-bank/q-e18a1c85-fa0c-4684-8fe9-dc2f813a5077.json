  "content": {
    "id": "p22-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Two side lengths of a triangle are $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the maximum possible area of the triangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12 ab$.",
          "worked": "Let $C$ be the angle between the given sides. Since $\\sin C\\leq 1$,\n$$\\begin{align*}\\text{Area}&=\\frac12 ab\\sin C\\\\\\text{Area}&\\leq\\frac12 ab.\\end{align*}$$\nEquality holds when $C=90^\\circ$, so the maximum area is $\\dfrac12 ab$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "What type of triangle gives this maximum area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A right-angled triangle.",
          "worked": "The maximum requires $\\sin C=1$, so $C=90^\\circ$. Thus the triangle is right-angled, with the given sides $a$ and $b$ meeting at the right angle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
