        "id": "p17-areas-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of triangles $BWA$ and $CWX$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$BWA: 3\\text{ cm}^2$; $CWX: 0.75\\text{ cm}^2$.",
          "worked": "$BA=3\\text{ cm}$ and the perpendicular distance of $W$ from $BA$ is $BY=2\\text{ cm}$.\n$$\\begin{align*}\\operatorname{Area}(BWA)&=\\tfrac12\\times3\\times2\\\\\\operatorname{Area}(BWA)&=3\\text{ cm}^2\\end{align*}$$\n$CX=1.5\\text{ cm}$ and the perpendicular distance of $W$ from $CX$ is $YC=3-2=1\\text{ cm}$.\n$$\\begin{align*}\\operatorname{Area}(CWX)&=\\tfrac12\\times1.5\\times1\\\\\\operatorname{Area}(CWX)&=0.75\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p17-areas-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of triangle $BAC$ and hence the area of triangle $BWC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$BAC: 4.5\\text{ cm}^2$; $BWC: 1.5\\text{ cm}^2$.",
          "worked": "$BA$ and $BC$ are perpendicular sides of the square.\n$$\\begin{align*}\\operatorname{Area}(BAC)&=\\tfrac12\\times3\\times3\\\\\\operatorname{Area}(BAC)&=4.5\\text{ cm}^2\\\\\\operatorname{Area}(BWC)&=\\operatorname{Area}(BAC)-\\operatorname{Area}(BWA)\\\\\\operatorname{Area}(BWC)&=4.5-3\\\\\\operatorname{Area}(BWC)&=1.5\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-areas-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the area of the shaded region.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.75\\text{ cm}^2$.",
          "worked": "Subtract the three unshaded triangles from the square.\n$$\\begin{align*}\\operatorname{Area}(AWXD)&=3\\times3-(3+1.5+0.75)\\\\\\operatorname{Area}(AWXD)&=9-5.25\\\\\\operatorname{Area}(AWXD)&=3.75\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
