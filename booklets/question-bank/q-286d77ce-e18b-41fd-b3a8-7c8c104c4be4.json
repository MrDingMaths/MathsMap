    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q2-compare-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $\\sqrt{9\\times16}$ and $\\sqrt{9}\\times\\sqrt{16}$. What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both are $12$: $\\sqrt{9\\times16}=\\sqrt{9}\\times\\sqrt{16}$.",
          "worked": "$$\\begin{align*}\\sqrt{9\\times16}&=\\sqrt{144}\\\\&=12\\\\\\sqrt{9}\\times\\sqrt{16}&=3\\times4\\\\&=12\\end{align*}$$\nThe two answers are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p45-q2-compare-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate $\\sqrt{9+16}$ and $\\sqrt{9}+\\sqrt{16}$. What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{9+16}=5$ but $\\sqrt{9}+\\sqrt{16}=7$, so they are not equal.",
          "worked": "$$\\begin{align*}\\sqrt{9+16}&=\\sqrt{25}\\\\&=5\\\\\\sqrt{9}+\\sqrt{16}&=3+4\\\\&=7\\end{align*}$$\nThe two answers are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
