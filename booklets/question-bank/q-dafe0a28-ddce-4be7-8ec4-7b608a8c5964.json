  "content": {
    "id": "p13-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}$ and hence determine in each part whether the vectors $\\underset{\\sim}{u}$ and $\\underset{\\sim}{v}$ are perpendicular.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{u}=\\begin{pmatrix}-4\\\\5\\end{pmatrix},\\quad\\underset{\\sim}{v}=\\begin{pmatrix}7\\\\6\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=2$; not perpendicular.",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=(-4)(7)+5(6)\\\\&=-28+30\\\\&=2\\end{aligned}$$\n\nThe vectors are not perpendicular because their dot product is not zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{u}=\\begin{pmatrix}-4\\\\-6\\end{pmatrix},\\quad\\underset{\\sim}{v}=\\begin{pmatrix}18\\\\-12\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=0$; perpendicular.",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=(-4)(18)+(-6)(-12)\\\\&=-72+72\\\\&=0\\end{aligned}$$\n\nThe vectors are perpendicular because their dot product is zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{u}=\\begin{pmatrix}-1\\\\a^{-2}\\end{pmatrix},\\quad\\underset{\\sim}{v}=\\begin{pmatrix}a^{-1}\\\\a\\end{pmatrix}$, where $a\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=0$; perpendicular.",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=(-1)a^{-1}+a^{-2}a\\\\&=-a^{-1}+a^{-1}\\\\&=0\\end{aligned}$$\n\nThe vectors are perpendicular because their dot product is zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
