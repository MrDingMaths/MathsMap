            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}A&=\\pi R^2-\\pi r^2\\\\36\\pi-\\pi r^2&=50\\\\-\\pi r^2&=50-36\\pi\\\\r^2&=\\frac{50-36\\pi}{-\\pi}\\\\r&=\\sqrt{36-\\frac{50}{\\pi}}\\\\r&\\approx4.48\\text{ cm}\\\\d&=2\\sqrt{36-\\frac{50}{\\pi}}\\\\d&\\approx8.96\\text{ cm}\\end{align*}",
