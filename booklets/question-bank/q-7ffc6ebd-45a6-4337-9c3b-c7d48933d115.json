  "content": {
    "id": "p6-q11",
    "type": "question",
    "label": "11",
    "prompt": "The interval $AB$ joins the points $A(2,6)$ and $B(8,6)$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "the distance $AB$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "The endpoints have the same $y$-coordinate, so the interval is horizontal.\n$$AB=8-2=6$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "the midpoint of $AB$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5,6)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{2+8}{2},\\frac{6+6}{2}\\right)\\\\M&=(5,6)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "the equation of the circle with diameter $AB$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)^2+(y-6)^2=9$",
          "worked": "The centre is the midpoint $(5,6)$ of the diameter.\n$$\\begin{align*}r&=\\frac{6}{2}\\\\r&=3\\\\(x-5)^2+(y-6)^2&=3^2\\\\(x-5)^2+(y-6)^2&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
