  "content": {
    "id": "p32-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Use trigonometry to find the length of the projection of $\\overrightarrow{OA}$ onto $\\overrightarrow{OB}$ if:\n\nHint: draw a diagram.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$|\\overrightarrow{OA}|=6$ and $\\angle AOB=30^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt3$",
          "worked": "Let $H$ be the perpendicular foot from $A$ to the line $OB$. The projection has length $OH$.\n\n$$\\begin{aligned}\\cos30^\\circ&=\\frac{OH}{6}\\\\OH&=6\\cos30^\\circ\\\\OH&=6\\left(\\frac{\\sqrt3}{2}\\right)\\\\OH&=3\\sqrt3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p32-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$|\\overrightarrow{OA}|=6\\sqrt6$ and $\\angle AOB=45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\sqrt3$",
          "worked": "Let $H$ be the perpendicular foot from $A$ to the line $OB$. The projection has length $OH$.\n\n$$\\begin{aligned}\\cos45^\\circ&=\\frac{OH}{6\\sqrt6}\\\\OH&=6\\sqrt6\\cos45^\\circ\\\\OH&=6\\sqrt6\\left(\\frac{\\sqrt2}{2}\\right)\\\\OH&=3\\sqrt{12}\\\\OH&=6\\sqrt3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
