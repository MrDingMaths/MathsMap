  "content": {
    "id": "p14-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Consider the graphs of $f(x)=(2x+1)^2$ and $g(x)=(2x-5)^2$.\nJimmy says that $y=g(x)$ is $y=f(x)$ shifted right by 6 units.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that Jimmy is incorrect by actually shifting $f(x)$ to the right by 6 units, $f(x-6)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x-6)=(2x-11)^2\\ne g(x)$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q11-a-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}f(x-6)&=(2(x-6)+1)^2\\\\f(x-6)&=(2x-11)^2\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p14-q11-a-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "This differs from ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "g(x)=(2x-5)^2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so Jimmy is incorrect.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine how many units to the right $f(x)$ needs to be translated to obtain $g(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 units right.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q11-b-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "f(x-b)=g(x)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p14-q11-b-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(2(x-b)+1)^2&=(2x-5)^2\\\\(2x-2b+1)^2&=(2x-5)^2\\\\-2b+1&=-5\\\\b&=3\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p14-q11-b-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Therefore, 3 units right.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
