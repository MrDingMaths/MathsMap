  "content": {
    "id": "p8-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find $\\dfrac{dy}{dx}$ using the chain rule. Remember that $\\cos^2 x$ means $(\\cos x)^2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sin(x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2x\\cos(x^2)$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\cos(x^2)\\times 2x\\\\&=2x\\cos(x^2)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p8-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sin(1-x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-2x\\cos(1-x^2)$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\cos(1-x^2)\\times(-2x)\\\\&=-2x\\cos(1-x^2)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p8-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\cos(x^3+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-3x^2\\sin(x^3+1)$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=-\\sin(x^3+1)\\times 3x^2\\\\&=-3x^2\\sin(x^3+1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p8-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\sin\\left(\\dfrac{1}{x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-\\dfrac{1}{x^2}\\cos\\left(\\dfrac{1}{x}\\right)$",
          "worked": "$\\dfrac{d}{dx}(x^{-1})=-x^{-2}$.\n$$\\begin{aligned}\\frac{dy}{dx}&=\\cos\\left(\\frac{1}{x}\\right)\\times\\left(-\\frac{1}{x^2}\\right)\\\\&=-\\frac{1}{x^2}\\cos\\left(\\frac{1}{x}\\right)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\cos^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-2\\cos x\\sin x$",
          "worked": "$y=(\\cos x)^2$.\n$$\\begin{aligned}\\frac{dy}{dx}&=2\\cos x\\times(-\\sin x)\\\\&=-2\\cos x\\sin x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p8-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\sin^3 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=3\\sin^2 x\\cos x$",
          "worked": "$y=(\\sin x)^3$.\n$$\\begin{aligned}\\frac{dy}{dx}&=3(\\sin x)^2\\times\\cos x\\\\&=3\\sin^2 x\\cos x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p8-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\tan^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2\\tan x\\sec^2 x$",
          "worked": "$y=(\\tan x)^2$.\n$$\\begin{aligned}\\frac{dy}{dx}&=2\\tan x\\times\\sec^2 x\\\\&=2\\tan x\\sec^2 x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p8-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\tan\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{1}{2\\sqrt{x}}\\sec^2\\sqrt{x}$",
          "worked": "$\\dfrac{d}{dx}(x^{1/2})=\\dfrac12x^{-1/2}=\\dfrac{1}{2\\sqrt{x}}$.\n$$\\begin{aligned}\\frac{dy}{dx}&=\\sec^2\\sqrt{x}\\times\\frac{1}{2\\sqrt{x}}\\\\&=\\frac{1}{2\\sqrt{x}}\\sec^2\\sqrt{x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
