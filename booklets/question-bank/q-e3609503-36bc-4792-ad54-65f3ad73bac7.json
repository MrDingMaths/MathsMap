          {
            "id": "p17-q4-check",
            "type": "part",
            "label": "a",
            "prompt": "By substituting $x=0$ into the original equation, show that this solution is incorrect.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4-2(0+2)=0\\ne8$, so $x=0$ is incorrect.",
              "worked": "$$\\begin{aligned}\\text{LHS}&=4-2(0+2)\\\\&=4-4\\\\&=0\\end{aligned}$$\nThe right-hand side is $8$. Since $0\\ne8$, $x=0$ is incorrect.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p17-q4-explain",
            "type": "part",
            "label": "b",
            "prompt": "Explain the mistake this student made when expanding, then solve the equation correctly.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The student used $+4$ instead of $-4$: $-2(x+2)=-2x-4$. The correct solution is $x=-4$.",
              "worked": "The student did not multiply both terms in the brackets by $-2$. In particular, $-2\\times2=-4$, so $-2(x+2)=-2x-4$.\n$$\\begin{aligned}4-2x-4&=8\\\\-2x&=8\\\\x&=-4\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 47
          }
        ]
      }
    ]
