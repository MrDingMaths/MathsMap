    "id": "v2-383dbf-p4-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Half of a number plus one-sixth of the number is the same as three-quarters of the number decreased by 2. Find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "24",
      "worked": "Let the number be $x$.\n\n$$\\begin{aligned}\\frac{x}{2}+\\frac{x}{6}&=\\frac{3x}{4}-2\\\\\\frac{6x}{12}+\\frac{2x}{12}&=\\frac{9x}{12}-2\\\\8x&=9x-24\\quad\\text{(multiply by 12)}\\\\24&=x\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
