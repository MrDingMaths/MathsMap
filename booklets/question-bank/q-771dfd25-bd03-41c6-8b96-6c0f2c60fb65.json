  "content": {
    "id": "p32-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Work out the value of each of these expressions when $x = 3$ and $y = 0$",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}x+y &= 3+0\\\\x+y &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p32-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$x+2y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}x+2y &= 3+2(0)\\\\x+2y &= 3+0\\\\x+2y &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p32-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$x-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}x-y &= 3-0\\\\x-y &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p32-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$x-2y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}x-2y &= 3-2(0)\\\\x-2y &= 3-0\\\\x-2y &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p32-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}xy &= 3\\times0\\\\xy &= 0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p32-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{y}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\frac{y}{x} &= \\frac{0}{3}\\\\\\frac{y}{x} &= 0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p32-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{x}{2+y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5$",
          "worked": "$$\\begin{align*}\\frac{x}{2+y} &= \\frac{3}{2+0}\\\\\\frac{x}{2+y} &= \\frac{3}{2}\\\\\\frac{x}{2+y} &= 1.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p32-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x}{2-y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5$",
          "worked": "$$\\begin{align*}\\frac{x}{2-y} &= \\frac{3}{2-0}\\\\\\frac{x}{2-y} &= \\frac{3}{2}\\\\\\frac{x}{2-y} &= 1.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p32-q11-i",
        "type": "part",
        "label": "i",
        "prompt": "$x^2+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}x^2+y &= 3^2+0\\\\x^2+y &= 9+0\\\\x^2+y &= 9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p32-q11-j",
        "type": "part",
        "label": "j",
        "prompt": "$(x+y)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}(x+y)^2 &= (3+0)^2\\\\(x+y)^2 &= 3^2\\\\(x+y)^2 &= 9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p32-q11-k",
        "type": "part",
        "label": "k",
        "prompt": "$x+y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}x+y^2 &= 3+0^2\\\\x+y^2 &= 3+0\\\\x+y^2 &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p32-q11-l",
        "type": "part",
        "label": "l",
        "prompt": "$x(y+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}x(y+2) &= 3(0+2)\\\\x(y+2) &= 3(2)\\\\x(y+2) &= 6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
