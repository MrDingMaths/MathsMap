  "content": {
    "id": "p4-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Let $f(x)=2x+1$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}f(3)&=2(3)+1\\\\f(3)&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "the image of $-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}f(-2)&=2(-2)+1\\\\f(-2)&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(a+b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a+2b+1$",
          "worked": "$$\\begin{align*}f(a+b)&=2(a+b)+1\\\\f(a+b)&=2a+2b+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(ab)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2ab+1$",
          "worked": "$$f(ab)=2ab+1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$x$ given $f(x)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}2x+1&=3\\\\2x&=2\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$x$ given $f(x)=-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac32$",
          "worked": "$$\\begin{align*}2x+1&=-2\\\\2x&=-3\\\\x&=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
