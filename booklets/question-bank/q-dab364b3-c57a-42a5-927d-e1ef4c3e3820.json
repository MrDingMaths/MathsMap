      {
        "id": "p19-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "For each method, describe what was done to work out the perimeter.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Method 1: Move the inside edges out to form a rectangle. Method 2: Find the missing sides by subtraction, then add all six sides.",
          "worked": "Method 1: Move the two inside edges out to complete a rectangle. Their lengths are unchanged, so the perimeter is $12+10+12+10=44$.\n\nMethod 2: Find the missing sides, $12-5=7$ and $10-4=6$, then add all six sides: $12+10+6+5+4+7=44$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Which method do you think is more efficient?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Method 1.",
          "worked": "Method 1 is more efficient because it uses the overall width and height directly, without first calculating the missing sides. A justified preference for Method 2 is also acceptable.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
