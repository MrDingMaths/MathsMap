  "content": {
    "id": "p88-q66-root",
    "type": "question",
    "label": "66",
    "prompt": "Find the smallest positive whole number $n$ such that $\\sqrt{2016n}$ is a whole number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=14$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p88-q66-answer-factorisation",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "2016n=2^{5}\\times3^{2}\\times7\\times n",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p88-q66-answer-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "For the square root to be a whole number, the product must be a perfect square. Every prime exponent must be even.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p88-q66-answer-minimum",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The factors 2 and 7 each need one more copy, so the smallest positive multiplier is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "n=2\\times7=14",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p88-q66-answer-product-check",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}2016\\times14&=2^{6}\\times3^{2}\\times7^{2}\\\\2016\\times14&=28224\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p88-q66-answer-root-check",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\sqrt{2016\\times14}&=2^{3}\\times3\\times7\\\\\\sqrt{2016\\times14}&=168\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
