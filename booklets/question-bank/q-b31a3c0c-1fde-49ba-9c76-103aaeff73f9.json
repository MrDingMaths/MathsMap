  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "For $m=6$ and $n=\\frac{1}{2}$, evaluate these expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$3\\left(\\frac{m}{n}+10\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$66$",
          "worked": "$$\\begin{align*}3\\left(\\frac{m}{n}+10\\right)&=3\\left(6\\div\\frac{1}{2}+10\\right)\\\\3\\left(\\frac{m}{n}+10\\right)&=3(12+10)\\\\3\\left(\\frac{m}{n}+10\\right)&=3\\times22\\\\3\\left(\\frac{m}{n}+10\\right)&=66\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$n\\left(\\frac{35-m}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\frac{5}{6}$",
          "worked": "$$\\begin{align*}n\\left(\\frac{35-m}{3}\\right)&=\\frac{1}{2}\\times\\frac{35-6}{3}\\\\n\\left(\\frac{35-m}{3}\\right)&=\\frac{1}{2}\\times\\frac{29}{3}\\\\n\\left(\\frac{35-m}{3}\\right)&=\\frac{29}{6}\\\\n\\left(\\frac{35-m}{3}\\right)&=4\\frac{5}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$m+\\frac{3m-34n}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\frac{1}{4}$",
          "worked": "$$\\begin{align*}m+\\frac{3m-34n}{4}&=6+\\frac{3\\times6-34\\times\\frac{1}{2}}{4}\\\\m+\\frac{3m-34n}{4}&=6+\\frac{18-17}{4}\\\\m+\\frac{3m-34n}{4}&=6+\\frac{1}{4}\\\\m+\\frac{3m-34n}{4}&=6\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{m+23}{n}-4m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34$",
          "worked": "$$\\begin{align*}\\frac{m+23}{n}-4m&=(6+23)\\div\\frac{1}{2}-4\\times6\\\\\\frac{m+23}{n}-4m&=29\\div\\frac{1}{2}-24\\\\\\frac{m+23}{n}-4m&=58-24\\\\\\frac{m+23}{n}-4m&=34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
