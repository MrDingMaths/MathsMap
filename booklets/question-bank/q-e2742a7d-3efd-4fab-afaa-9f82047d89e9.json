    "children": [
      {
        "id": "p23-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "In the first 10 seconds, what is its maximum distance from the origin and when does it occur?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\text{ m}$ at $t=3\\text{ s}$.",
          "worked": "The graph is on or above the time axis, so the distance from the origin is $x$. In the first 10 seconds, its greatest value is $8\\text{ m}$, occurring at $t=3\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p23-q14-b",
        "type": "group",
        "label": "b",
        "prompt": "By examining the gradient, find when the particle is:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q14-b-i",
            "type": "part",
            "label": "i",
            "prompt": "stationary,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t=3\\text{ s}$ and $t=9\\text{ s}$.",
              "worked": "The particle is stationary when $v=0$, so the displacement graph has zero gradient. Its horizontal tangents occur at $t=3\\text{ s}$ and $t=9\\text{ s}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p23-q14-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "moving to the right,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0\\le t<3$ and $t>9$, with $t$ in seconds.",
              "worked": "Moving to the right means $v>0$. The displacement graph has positive gradient for $0\\le t<3$ and $t>9$, with $t$ in seconds.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p23-q14-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "moving to the left.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3<t<9$, with $t$ in seconds.",
              "worked": "Moving to the left means $v<0$. The displacement graph has negative gradient for $3<t<9$, with $t$ in seconds.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p23-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "When does it return to the origin and what is its velocity then?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=9\\text{ s}$; velocity $0\\text{ m/s}$.",
          "worked": "The particle returns to the origin where $x=0$ after the start, at $t=9\\text{ s}$. The graph has a horizontal tangent there, so its gradient and hence its velocity are $0\\text{ m/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
