    "id": "p11-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "State in each case whether or not $A\\subset B$ (that is, whether $A$ is a proper subset of $B$).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\{2,3,5\\},\\qquad B=\\{1,2,3,4,5,6,7,8,9\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Every element of $A$ is in $B$, and $A\\ne B$. Therefore $A\\subset B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p11-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\{3,6,9,12\\},\\qquad B=\\{3,5,9,11\\}$",
