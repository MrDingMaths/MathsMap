        "children": [],
        "answer": {
          "short": "False; $6$ and $12$ are not in $B$.",
          "worked": "$6$ and $12$ belong to $A$ but not to $B$, so $A$ is not a subset of $B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p11-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$A=\\{d,a,n,c,e\\},\\qquad B=\\{e,d,u,c,a,t,i,o,n\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Every element of $A$ is in $B$. Also, $u,t,i,o$ are in $B$ but not in $A$, so $A\\ne B$. Therefore $A\\subset B$.",
          "solutionDiagrams": []
