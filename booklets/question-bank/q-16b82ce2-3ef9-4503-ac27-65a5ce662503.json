  "content": {
    "id": "p9-f6-root",
    "type": "question",
    "label": "6",
    "prompt": "Rationalise the denominator of each fraction. Assume $a$, $b$ and $c$ are positive integers. In parts (c)–(f), assume the conjugate of each denominator is nonzero.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-f6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac1{\\sqrt a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt a}{a}$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt a}&=\\frac1{\\sqrt a}\\cdot\\frac{\\sqrt a}{\\sqrt a}\\\\\\frac1{\\sqrt a}&=\\frac{\\sqrt a}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-f6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac1{b\\sqrt a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt a}{ab}$",
          "worked": "$$\\begin{align*}\\frac1{b\\sqrt a}&=\\frac1{b\\sqrt a}\\cdot\\frac{\\sqrt a}{\\sqrt a}\\\\\\frac1{b\\sqrt a}&=\\frac{\\sqrt a}{ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-f6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac1{a+\\sqrt b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a-\\sqrt b}{a^2-b}$",
          "worked": "$$\\begin{align*}\\frac1{a+\\sqrt b}&=\\frac1{a+\\sqrt b}\\cdot\\frac{a-\\sqrt b}{a-\\sqrt b}\\\\\\frac1{a+\\sqrt b}&=\\frac{a-\\sqrt b}{a^2-(\\sqrt b)^2}\\\\\\frac1{a+\\sqrt b}&=\\frac{a-\\sqrt b}{a^2-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-f6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac1{\\sqrt a+\\sqrt b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt a-\\sqrt b}{a-b}$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt a+\\sqrt b}&=\\frac1{\\sqrt a+\\sqrt b}\\cdot\\frac{\\sqrt a-\\sqrt b}{\\sqrt a-\\sqrt b}\\\\\\frac1{\\sqrt a+\\sqrt b}&=\\frac{\\sqrt a-\\sqrt b}{(\\sqrt a)^2-(\\sqrt b)^2}\\\\\\frac1{\\sqrt a+\\sqrt b}&=\\frac{\\sqrt a-\\sqrt b}{a-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-f6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac1{a+b\\sqrt c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a-b\\sqrt c}{a^2-b^2c}$",
          "worked": "$$\\begin{align*}\\frac1{a+b\\sqrt c}&=\\frac1{a+b\\sqrt c}\\cdot\\frac{a-b\\sqrt c}{a-b\\sqrt c}\\\\\\frac1{a+b\\sqrt c}&=\\frac{a-b\\sqrt c}{a^2-(b\\sqrt c)^2}\\\\\\frac1{a+b\\sqrt c}&=\\frac{a-b\\sqrt c}{a^2-b^2c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p9-f6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac1{\\sqrt a+b\\sqrt c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt a-b\\sqrt c}{a-b^2c}$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt a+b\\sqrt c}&=\\frac1{\\sqrt a+b\\sqrt c}\\cdot\\frac{\\sqrt a-b\\sqrt c}{\\sqrt a-b\\sqrt c}\\\\\\frac1{\\sqrt a+b\\sqrt c}&=\\frac{\\sqrt a-b\\sqrt c}{(\\sqrt a)^2-(b\\sqrt c)^2}\\\\\\frac1{\\sqrt a+b\\sqrt c}&=\\frac{\\sqrt a-b\\sqrt c}{a-b^2c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
