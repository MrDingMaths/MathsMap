  "content": {
    "id": "p13-q12",
    "type": "question",
    "label": "12",
    "prompt": "Calculate the amount to which $\\$30\\,000$ will grow in 4 years if it is invested at 5.6% p.a.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "simple interest",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$36\\,720$",
          "worked": "$$\\begin{align*} I &= Prn \\\\ I &= 30\\,000\\times0.056\\times4 \\\\ I &= \\$6720 \\\\ FV &= \\$30\\,000+\\$6720 \\\\ FV &= \\$36\\,720 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "compound interest, compounded annually. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$37\\,305.85$",
          "worked": "$$\\begin{align*} FV &= PV(1+r)^n \\\\ FV &= 30\\,000(1+0.056)^4 \\\\ FV &= \\$37\\,305.84895488 \\\\ FV &\\approx \\$37\\,305.85 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p13-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Which method of calculating interest produces the greater amount and by how much? Give the difference to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Compound interest produces $\\$585.85$ more than simple interest.",
          "worked": "$$\\begin{align*} \\text{Difference} &= 37\\,305.84895488-36\\,720 \\\\ \\text{Difference} &= \\$585.84895488 \\\\ \\text{Difference} &\\approx \\$585.85 \\end{align*}$$\nCompound interest produces the greater amount, by $\\$585.85$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
