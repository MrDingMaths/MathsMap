  "content": {
    "id": "p80-q33-root",
    "type": "question",
    "label": "33",
    "prompt": "How many five-letter codes can be formed from the letters of the word COFFEE.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "180",
      "worked": "Omit one letter from COFFEE. The distinct cases are omitting C, O, F or E. Omitting C or O leaves two pairs of repeated letters; omitting F or E leaves one pair.\n$$\\begin{aligned}N&=\\frac{5!}{2!\\,2!}+\\frac{5!}{2!\\,2!}+\\frac{5!}{2!}+\\frac{5!}{2!}\\\\&=30+30+60+60\\\\&=180.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
