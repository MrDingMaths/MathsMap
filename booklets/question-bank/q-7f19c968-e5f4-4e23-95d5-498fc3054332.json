    "children": [
      {
        "id": "p39-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f(x)=x^3$ and $g(x)=x^4$, find $f'(x)$, $f''(x)$, $g'(x)$ and $g''(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=3x^2$, $f''(x)=6x$, $g'(x)=4x^3$, $g''(x)=12x^2$.",
          "worked": "$$\\begin{align*}f'(x)&=3x^2\\\\f''(x)&=6x\\\\g'(x)&=4x^3\\\\g''(x)&=12x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p39-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Both $f(x)$ and $g(x)$ have a stationary point at $(0,0)$. Evaluate $f''(x)$ and $g''(x)$ when $x=0$. Can you determine the nature of the stationary points from this calculation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f''(0)=0$ and $g''(0)=0$. No; the second-derivative test is inconclusive.",
          "worked": "$$\\begin{align*}f''(0)&=6(0)=0\\\\g''(0)&=12(0)^2=0\\end{align*}$$\n\nNo. A zero second derivative does not determine the nature of a stationary point.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p39-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Use tables of values of $f'(x)$ and $g'(x)$ to determine the nature of the stationary points.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $f(x)=x^3$, $(0,0)$ is a horizontal (stationary) point of inflection. For $g(x)=x^4$, $(0,0)$ is a minimum turning point.",
