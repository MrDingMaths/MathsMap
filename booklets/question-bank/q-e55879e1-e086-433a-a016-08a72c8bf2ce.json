              "type": "text",
              "text": "The table shows how many products a store sold in a day. Complete the table.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q8-predictions",
        "type": "group",
        "label": null,
        "prompt": "Based on the data, if 350 products were sold, how many would be:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p26-q8-a",
            "type": "part",
            "label": "a",
            "prompt": "Toasters?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "75 toasters.",
              "worked": "$$\\begin{align*}\\text{Expected toasters}&=\\text{Relative frequency}\\times\\text{Trials}\\\\&=\\frac{3}{14}\\times350\\\\&=75\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p26-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "Phones?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "60 phones.",
              "worked": "$$\\begin{align*}\\text{Expected phones}&=\\frac{6}{35}\\times350\\\\&=60\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p26-q8-c",
            "type": "part",
            "label": "c",
            "prompt": "Kettles or toasters?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "165 products.",
              "worked": "$$\\begin{align*}\\text{Expected kettles}&=\\frac{9}{35}\\times350\\\\&=90\\\\\\text{Expected kettles or toasters}&=90+75\\\\&=165\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p26-q8-d",
            "type": "part",
            "label": "d",
            "prompt": "Not toasters?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "275 products.",
              "worked": "$$\\begin{align*}\\text{Expected products other than toasters}&=350-75\\\\&=275\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
