  "content": {
    "id": "p7-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "One letter is chosen from the letters of the alphabet. What is the probability that it is not a vowel?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{21}{26}$",
      "worked": "There are 26 letters and five vowels: A, E, I, O and U.\n\n$$\\begin{align*}P(\\text{vowel})&=\\frac{5}{26}\\\\P(\\text{not a vowel})&=1-\\frac{5}{26}\\\\P(\\text{not a vowel})&=\\frac{21}{26}\\end{align*}$$",
      "solutionDiagrams": []
    },
