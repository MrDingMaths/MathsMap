    "id": "p58-q22-response",
    "type": "question",
    "label": "22",
    "prompt": "Find the real number $a$ such that $(x-1-a)$ is a factor of $P(x)=x^3-3ax-9$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=2$.",
      "worked": "By the factor theorem, $P(1+a)=0$.\n$$\\begin{align*}P(1+a)&=(1+a)^3-3a(1+a)-9\\\\0&=1+3a+3a^2+a^3-3a-3a^2-9\\\\0&=a^3-8\\\\a^3&=8\\\\a&=2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
