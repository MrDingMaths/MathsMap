        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 26, p26-q9-diagram\"}\n\\begin{tikzpicture}[x=0.16cm,y=0.16cm,line cap=round,line join=round,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (16,12);\n\\coordinate (C) at (30,12);\n\\coordinate (D) at (35,0);\n\\coordinate (F) at (16,0);\n\\coordinate (G) at (30,0);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--(D)--cycle;\n\\draw[black,dashed,line width=0.4pt] (B)--(F) (C)--(G);\n\\draw[black,line width=0.4pt] (F)++(0,1)--++(1,0)--++(0,-1);\n\\draw[black,line width=0.4pt] (G)++(0,1)--++(-1,0)--++(0,-1);\n\\draw[black,<->,line width=0.4pt] (0,-1.5)--node[midway,below,text=black] {? cm} (16,-1.5);\n\\draw[black,<->,line width=0.4pt] (30,-1.5)--node[midway,below,text=black] {? cm} (35,-1.5);\n\\node[above] at (23,12) {$14\\text{ cm}$};\n\\draw[black,thin] (0,-0.2)--(0,-5) (35,-0.2)--(35,-5);\n\\draw[black,<->,thin] (0,-4.5)--node[below] {$35\\text{ cm}$} (35,-4.5);\n\\end{tikzpicture}",
