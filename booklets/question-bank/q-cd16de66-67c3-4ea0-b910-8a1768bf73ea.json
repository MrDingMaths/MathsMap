  "content": {
    "id": "p13-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A girl buys two scarves, one costing $\\$2.50$ more than the other. If the total cost of the two scarves was $\\$19.00$, then what was the cost of each scarf?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$8.25$ and $\\$10.75$.",
      "worked": "Let the cheaper scarf cost $x$ dollars. The other costs $x+2.50$ dollars.\n$$\\begin{align*}x+(x+2.50)&=19.00\\\\2x+2.50&=19.00\\\\2x&=16.50\\\\x&=8.25\\end{align*}$$\nThe other scarf costs $8.25+2.50=10.75$ dollars. The scarves cost $\\$8.25$ and $\\$10.75$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
