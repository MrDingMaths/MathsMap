    "type": "question",
    "label": "9",
    "prompt": "A particular type of rope costs $\\$2.50$ for 25 cm. How much does 2 m of rope cost?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$20$",
      "worked": "$$\\begin{align*}2\\text{ m}&=200\\text{ cm}\\\\\\text{Cost of 1 cm}&=\\$2.50\\div25\\\\\\text{Cost of 1 cm}&=\\$0.10\\\\\\text{Cost of 200 cm}&=\\$0.10\\times200\\\\\\text{Cost of 200 cm}&=\\$20\\end{align*}$$",
      "solutionDiagrams": []
    },
