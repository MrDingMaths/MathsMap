  "content": {
    "id": "p39-q1-root",
    "type": "question",
    "label": "4",
    "prompt": "A particle moves so that its displacement $x$ metres at time $t$ seconds is given by\n\n$$x=5-2t$$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the position of the particle initially.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\,\\text{m}$",
          "worked": "$$\\begin{align*}x(0)&=5-2(0)\\\\x(0)&=5\\,\\text{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the velocity of the particle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=-2\\,\\text{m/s}$",
          "worked": "$$\\begin{align*}v&=\\frac{\\mathrm{d}}{\\mathrm{d}t}(5-2t)\\\\v&=-2\\,\\text{m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p39-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "In what direction is the particle moving?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "To the left.",
          "worked": "The velocity is negative ($v=-2\\,\\text{m/s}$), so the particle moves to the left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p39-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the displacement of the particle when $t=3$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\,\\text{m}$",
          "worked": "$$\\begin{align*}x(3)&=5-2(3)\\\\x(3)&=-1\\,\\text{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "When does the particle have displacement $x=-3$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=4\\,\\text{s}$",
          "worked": "$$\\begin{align*}5-2t&=-3\\\\2t&=5+3\\\\2t&=8\\\\t&=4\\,\\text{s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p39-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "When does the particle pass through the origin?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2.5\\,\\text{s}$",
          "worked": "At the origin, $x=0$.\n\n$$\\begin{align*}5-2t&=0\\\\2t&=5\\\\t&=\\frac{5}{2}\\\\t&=2.5\\,\\text{s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
