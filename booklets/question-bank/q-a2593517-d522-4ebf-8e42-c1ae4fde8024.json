  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify the following expressions. Remember to follow the order of operations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2ab\\times3bc\\times4cd}{4a\\times3bc\\times2d}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$bc$",
          "worked": "$\\begin{align*}\\frac{2ab\\times3bc\\times4cd}{4a\\times3bc\\times2d}&=\\frac{24ab^{2}c^{2}d}{24abcd}\\\\&=bc\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{12a^{2}b+4a^{2}b}{4b+2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8a^{2}}{3}$",
          "worked": "$\\begin{align*}\\frac{12a^{2}b+4a^{2}b}{4b+2b}&=\\frac{16a^{2}b}{6b}\\\\&=\\frac{8a^{2}}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{7x^{2}y-5yx^{2}}{12xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{6}$",
          "worked": "$\\begin{align*}\\frac{7x^{2}y-5yx^{2}}{12xy}&=\\frac{2x^{2}y}{12xy}\\\\&=\\frac{x}{6}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{8a^{2}b+(4a\\times2ba)}{3ba-2ba}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16a$",
          "worked": "$\\begin{align*}\\frac{8a^{2}b+(4a\\times2ba)}{3ba-2ba}&=\\frac{8a^{2}b+8a^{2}b}{ab}\\\\&=\\frac{16a^{2}b}{ab}\\\\&=16a\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p7-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{10abc+5cba+5a\\times bc}{4c\\times10ab}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$\\begin{align*}\\frac{10abc+5cba+5a\\times bc}{4c\\times10ab}&=\\frac{10abc+5abc+5abc}{40abc}\\\\&=\\frac{20abc}{40abc}\\\\&=\\frac{1}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p7-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{10x^{2}y-(4x\\times6xy)}{7xy^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2x}{y}$",
          "worked": "$\\begin{align*}\\frac{10x^{2}y-(4x\\times6xy)}{7xy^{2}}&=\\frac{10x^{2}y-24x^{2}y}{7xy^{2}}\\\\&=\\frac{-14x^{2}y}{7xy^{2}}\\\\&=-\\frac{2x}{y}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
