  "content": {
    "id": "p26-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Work out these percentages of $180$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$75\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$135$",
          "worked": "$$\\begin{align*}25\\%\\text{ of }180&=180\\div4=45\\\\75\\%\\text{ of }180&=3\\times45=135\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$175\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$315$",
          "worked": "$$\\begin{align*}50\\%\\text{ of }180&=180\\div2=90\\\\25\\%\\text{ of }180&=90\\div2=45\\\\175\\%\\text{ of }180&=180+90+45=315\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p26-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$200\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360$",
          "worked": "$$\\begin{align*}200\\%\\text{ of }180&=2\\times180=360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q14-d",
