        "children": [],
        "answer": {
          "short": "$450$",
          "worked": "$$\\begin{align*}50\\%\\text{ of }180&=180\\div2=90\\\\250\\%\\text{ of }180&=2\\times180+90=450\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q14-e",
        "type": "part",
        "label": "e",
