  "content": {
    "id": "p21-q4-response",
    "type": "question",
    "label": "4",
    "prompt": "How many spheres of $15\\text{ cm}$ diameter can be painted with $1\\text{ L}$ of glitter paint if the paint covers $10\\text{ m}^2$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$141$ spheres",
      "worked": "$$\\begin{align*}r &= 15\\div 2 = 7.5\\text{ cm}\\\\A &= 4\\pi r^2\\\\A &= 4\\pi(7.5)^2 = 225\\pi\\text{ cm}^2\\\\\\text{Paint coverage} &= 10\\times100^2 = 100\\,000\\text{ cm}^2\\\\\\text{Number of spheres} &= \\frac{100\\,000}{225\\pi}\\approx141.47\\end{align*}$$\nRound down to give $141$ completely painted spheres.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
