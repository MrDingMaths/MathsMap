  "content": {
    "id": "p10-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "You are standing next to a large bin and are tasked with placing 100 rocks into the bin, but can only carry one at a time. The rocks are in a line in front of you. The first is 1 metre away, and each subsequent rock is 1 metre further away from the previous rock. How many kilometres must you cover to complete the task?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10.1\\text{ km}$",
      "worked": "Each rock requires a journey from the bin to the rock and back. Let $D$ be the total distance in metres.\n$$\\begin{align*}D&=2(1+2+\\cdots+100)\\\\D&=2\\times\\frac{100}{2}(1+100)\\\\D&=10100\\text{ m}\\\\D&=10.1\\text{ km}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
