  "content": {
    "id": "p3-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Five letters are randomly placed in five letterboxes. Find the probability that one letter is in each letterbox.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{24}{625}$.\n\nThere are $5!$ favourable placements out of $5^5$ equally likely placements.",
      "worked": "Each of the five letters has five possible letterboxes, giving $5^5$ equally likely placements. For exactly one letter in each box, the successive letters have $5,4,3,2,1$ choices.\n\n$$\\begin{align*}\\Pr(\\text{one letter in each box})&=\\frac{5\\times4\\times3\\times2\\times1}{5^5}\\\\\\Pr(\\text{one letter in each box})&=\\frac{120}{3125}\\\\\\Pr(\\text{one letter in each box})&=\\frac{24}{625}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
