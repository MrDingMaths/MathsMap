  "content": {
    "id": "p31-q36-group-root",
    "type": "question",
    "label": "8",
    "prompt": "Rewrite each non-monic quadratic expression in completed square form, $a(x+h)^2+k$, where $a\\ne1$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q36-root",
        "type": "part",
        "label": "a",
        "prompt": "$$2x^2+8x+3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x+2)^2-5$",
          "worked": "$$\\begin{align*}2x^2+8x+3&=2\\left(x^2+4x+\\frac32\\right)\\\\2x^2+8x+3&=2\\left((x+2)^2-4+\\frac32\\right)\\\\2x^2+8x+3&=2(x+2)^2-5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q37-root",
        "type": "part",
        "label": "b",
        "prompt": "$$3x^2-18x+8$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x-3)^2-19$",
          "worked": "$$\\begin{align*}3x^2-18x+8&=3\\left(x^2-6x+\\frac83\\right)\\\\3x^2-18x+8&=3\\left((x-3)^2-9+\\frac83\\right)\\\\3x^2-18x+8&=3(x-3)^2-19.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q38-root",
        "type": "part",
        "label": "c",
        "prompt": "$$5x^2+10x+2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(x+1)^2-3$",
          "worked": "$$\\begin{align*}5x^2+10x+2&=5\\left(x^2+2x+\\frac25\\right)\\\\5x^2+10x+2&=5\\left((x+1)^2-1+\\frac25\\right)\\\\5x^2+10x+2&=5(x+1)^2-3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q39-root",
        "type": "part",
        "label": "d",
        "prompt": "$$4x^2-20x+1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\left(x-\\frac52\\right)^2-24$\n\nFactor out $4$, then complete the square inside the brackets.",
          "worked": "$$\\begin{align*}4x^2-20x+1&=4\\left(x^2-5x+\\frac14\\right)\\\\4x^2-20x+1&=4\\left(\\left(x-\\frac52\\right)^2-\\frac{25}{4}+\\frac14\\right)\\\\4x^2-20x+1&=4\\left(x-\\frac52\\right)^2-24.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
