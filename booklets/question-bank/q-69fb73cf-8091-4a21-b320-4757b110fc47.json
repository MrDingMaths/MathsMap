        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even.",
          "worked": "$$\\begin{aligned}f(-x)&=(-x)^2+1\\\\&=x^2+1\\\\&=f(x)\\end{aligned}$$\nEven.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^2+x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Neither.",
          "worked": "$$\\begin{aligned}f(-x)&=(-x)^2+(-x)\\\\&=x^2-x\\end{aligned}$$\nThis equals neither $f(x)$ nor $-f(x)$, so the function is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^3$",
