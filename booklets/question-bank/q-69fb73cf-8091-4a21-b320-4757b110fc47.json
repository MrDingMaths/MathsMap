        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Odd.",
          "worked": "$$\\begin{aligned}f(-x)&=(-x)^3\\\\&=-x^3\\\\&=-f(x)\\end{aligned}$$\nOdd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q1-e",
