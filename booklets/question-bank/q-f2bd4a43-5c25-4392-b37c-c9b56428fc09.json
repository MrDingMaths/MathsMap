  "content": {
    "id": "p6-p1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the value(s) of $a$ if $ax+y=6$ passes through $(a,5a)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-6$ or $a=1$.",
      "worked": "Substitute $x=a$ and $y=5a$ into the equation.\n$$\\begin{align*}a(a)+5a&=6\\\\a^2+5a-6&=0\\\\(a+6)(a-1)&=0\\end{align*}$$\nHence $a=-6$ or $a=1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
