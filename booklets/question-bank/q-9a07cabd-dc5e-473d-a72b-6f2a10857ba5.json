  "content": {
    "id": "v2-ac439-p13-practice-slot-3-lower-root",
    "type": "question",
    "label": null,
    "prompt": "The line $5x+2y-20=0$ crosses the $x$-axis at $A$ and the $y$-axis at $B$. Find the exact distance $AB$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AB=2\\sqrt{29}$",
      "worked": "$$\\begin{aligned}y=0:\\ 5x-20&=0\\\\x&=4\\\\x=0:\\ 2y-20&=0\\\\y&=10\\end{aligned}$$\n$A=(4,0)$ and $B=(0,10)$.\n$$\\begin{aligned}AB&=\\sqrt{(4-0)^2+(0-10)^2}\\\\&=\\sqrt{116}\\\\&=2\\sqrt{29}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
