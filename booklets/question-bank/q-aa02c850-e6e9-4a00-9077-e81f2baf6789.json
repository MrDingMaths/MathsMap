    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-jing-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why Jing’s final answer, $0.113$, is not equivalent to $\\frac{113}{100}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.113$ is less than one whole; $\\frac{113}{100}$ is more than one whole.",
          "worked": "$0.113<1$, whereas $\\frac{113}{100}>1$. They cannot be equivalent. In fact, $\\frac{113}{100}=1.13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-jing-b",
        "type": "part",
        "label": "b",
        "prompt": "In the step marked with an arrow, look at the values of the numerator and the denominator. How could Jing have known the answer should be greater than $1$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The numerator is greater than the denominator, so the decimal must be greater than one.",
          "worked": "The numerator, $113$, is greater than the denominator, $100$, so $\\frac{113}{100}>1$. Its equivalent decimal must also be greater than $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-jing-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p14-jing-c-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Solve. Write your answer as a decimal.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p14-jing-c-expression",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{4}{10}+\\frac{95}{100}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.35$",
          "worked": "$$\\begin{align*}\\frac{4}{10}+\\frac{95}{100}&=\\frac{40}{100}+\\frac{95}{100}\\\\&=\\frac{135}{100}\\\\&=1.35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
