        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jamie.",
          "worked": "Jamie: his minimum is 35 marks, compared with Maryanne's 45 marks.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p20-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "What was the range of marks for each student?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jamie: 55 marks; Maryanne: 30 marks.",
          "worked": "Range = maximum − minimum.\n\nJamie: $90-35=55$ marks.\n\nMaryanne: $75-45=30$ marks.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Who had the greater spread of marks?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jamie.",
          "worked": "Jamie has the greater range: $55>30$ marks. His IQR is also greater.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p20-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "What was the interquartile range for each student?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jamie: 25 marks; Maryanne: 20 marks.",
          "worked": "$\\text{IQR}=Q_3-Q_1$.\n\nJamie: $80-55=25$ marks.\n\nMaryanne: $70-50=20$ marks.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "Whose marks were the more consistent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Maryanne's; she has a smaller range and IQR.",
          "worked": "Maryanne's marks are more consistent: her IQR is 20 marks compared with Jamie's 25 marks, and her range is 30 marks compared with his 55 marks.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "Who had more marks over 70?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jamie.",
          "worked": "70 is Jamie's median and Maryanne's upper quartile. Using the quartile comparison, 50% of Jamie's marks are above 70, compared with 25% of Maryanne's. Both students completed eight assessments, so Jamie had more marks over 70.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
