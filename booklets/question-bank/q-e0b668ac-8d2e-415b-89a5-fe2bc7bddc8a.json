  "content": {
    "id": "v2-221dc-p46-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Find the points of intersection of $y=\\frac{12}{x}$ and $y=7-x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(3,4)$ and $(4,3)$",
      "worked": "$$\\begin{align*}\\frac{12}{x}&=7-x\\\\12&=7x-x^{2}\\\\x^{2}-7x+12&=0\\\\(x-3)(x-4)&=0\\\\x&=3\\text{ or }4\\end{align*}$$\nWhen $x=3$, $y=7-3=4$. When $x=4$, $y=7-4=3$.\nThe points of intersection are $(3,4)$ and $(4,3)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
