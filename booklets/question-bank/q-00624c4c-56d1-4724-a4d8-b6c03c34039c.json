        "answer": {
          "short": "$\\dfrac{4}{u^{2}}$",
          "worked": "$$\\begin{aligned}\\frac{2}{u}\\div\\frac{u}{2}&=\\frac{2}{u}\\times\\frac{2}{u}\\\\&=\\frac{4}{u^{2}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p19-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{d}{3}\\div\\frac{4}{d}$",
