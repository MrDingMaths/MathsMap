        "answer": {
          "short": "$\\dfrac{d^{2}}{12}$",
          "worked": "$$\\begin{aligned}\\frac{d}{3}\\div\\frac{4}{d}&=\\frac{d}{3}\\times\\frac{d}{4}\\\\&=\\frac{d^{2}}{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
