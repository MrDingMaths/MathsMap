          "worked": "$$\\begin{aligned}\\frac{2n}{3}\\div\\frac{5}{x}&=\\frac{2n}{3}\\times\\frac{x}{5}\\\\&=\\frac{2nx}{15}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
