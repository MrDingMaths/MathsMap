          "worked": "$$\\begin{aligned}\\frac{y}{3}\\div\\frac{1}{2}&=\\frac{y}{3}\\times2\\\\&=\\frac{2y}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p19-q1-f",
