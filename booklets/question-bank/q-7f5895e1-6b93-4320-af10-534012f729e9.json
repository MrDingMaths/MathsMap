              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Given a student picked at random studies German, find the probability that they also study French.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{11}$",
          "worked": "German is the restricted sample space: $22$ students study German and $10$ of these also study French.\n$$\\begin{align*}P(F\\mid G)&=\\frac{|F\\cap G|}{|G|}\\\\P(F\\mid G)&=\\frac{10}{22}=\\frac{5}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
