  "content": {
    "id": "p60-q11-root",
    "type": "question",
    "label": null,
    "prompt": "Find $f(-x)$ for each function, and then decide whether the function is odd, even or neither.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x+3$; neither.",
          "worked": "$$\\begin{align*}f(-x)&=-x+3\\\\-f(x)&=-x-3\\end{align*}$$\nThus $f(-x)$ equals neither $f(x)$ nor $-f(x)$, so the function is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p60-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2x^2-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=2x^2-5$; even.",
          "worked": "$$\\begin{align*}f(-x)&=2(-x)^2-5\\\\f(-x)&=2x^2-5\\\\f(-x)&=f(x)\\end{align*}$$\nThe function is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p60-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac1x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-\\dfrac1x$; odd.",
          "worked": "$$\\begin{align*}f(-x)&=\\frac1{-x}\\\\f(-x)&=-\\frac1x\\\\f(-x)&=-f(x)\\end{align*}$$\nThe function is odd on its domain $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p60-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{x}{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-\\dfrac{x}{x^2+1}$; odd.",
          "worked": "$$\\begin{align*}f(-x)&=\\frac{-x}{(-x)^2+1}\\\\f(-x)&=-\\frac{x}{x^2+1}\\\\f(-x)&=-f(x)\\end{align*}$$\nThe function is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
