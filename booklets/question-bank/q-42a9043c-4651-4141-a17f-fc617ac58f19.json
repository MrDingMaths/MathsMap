  "content": {
    "id": "p28-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find a formula for the general term of each of the following linear recurrence relations:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q2a",
        "type": "part",
        "label": "a",
        "prompt": "$a_{n+1}=2a_n+2$, given that $a_1=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=3\\times2^{n-1}-2$",
          "worked": "Write $a_n=p2^{n-1}+q$.\n$$\\begin{align*}a_2&=2(1)+2=4\\\\p+q&=1\\\\2p+q&=4\\\\p&=3\\\\q&=1-3=-2\\\\a_n&=3\\times2^{n-1}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p28-q2b",
        "type": "part",
        "label": "b",
        "prompt": "$a_{n+1}=2a_n+3$, given that $a_1=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=9\\times2^{n-1}-3$",
          "worked": "Write $a_n=p2^{n-1}+q$.\n$$\\begin{align*}a_2&=2(6)+3=15\\\\p+q&=6\\\\2p+q&=15\\\\p&=9\\\\q&=6-9=-3\\\\a_n&=9\\times2^{n-1}-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p28-q2c",
        "type": "part",
        "label": "c",
        "prompt": "$a_{n+1}=3a_n+1$, given that $a_1=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=\\dfrac{21}{2}\\times3^{n-1}-\\dfrac12$",
          "worked": "Write $a_n=p3^{n-1}+q$.\n$$\\begin{align*}a_2&=3(10)+1=31\\\\p+q&=10\\\\3p+q&=31\\\\2p&=21\\\\p&=\\frac{21}{2}\\\\q&=10-\\frac{21}{2}=-\\frac12\\\\a_n&=\\frac{21}{2}\\times3^{n-1}-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p28-q2d",
        "type": "part",
        "label": "d",
        "prompt": "$a_{n+1}=5a_n+1$, given that $a_1=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=\\dfrac54\\times5^{n-1}-\\dfrac14$",
          "worked": "Write $a_n=p5^{n-1}+q$.\n$$\\begin{align*}a_2&=5(1)+1=6\\\\p+q&=1\\\\5p+q&=6\\\\4p&=5\\\\p&=\\frac54\\\\q&=1-\\frac54=-\\frac14\\\\a_n&=\\frac54\\times5^{n-1}-\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p28-q2e",
        "type": "part",
        "label": "e",
        "prompt": "$a_{n+1}=2a_n-1$, given that $a_1=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=3\\times2^{n-1}+1$",
          "worked": "Write $a_n=p2^{n-1}+q$.\n$$\\begin{align*}a_2&=2(4)-1=7\\\\p+q&=4\\\\2p+q&=7\\\\p&=3\\\\q&=4-3=1\\\\a_n&=3\\times2^{n-1}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p28-q2f",
        "type": "part",
        "label": "f",
        "prompt": "$a_{n+1}=-a_n+4$, given that $a_1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=-2(-1)^{n-1}+2$",
          "worked": "Write $a_n=p(-1)^{n-1}+q$.\n$$\\begin{align*}a_2&=-0+4=4\\\\p+q&=0\\\\-p+q&=4\\\\-2p&=4\\\\p&=-2\\\\q&=2\\\\a_n&=-2(-1)^{n-1}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p28-q2g",
        "type": "part",
        "label": "g",
        "prompt": "$a_{n+1}=-2a_n+3$, given that $a_1=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=1$",
          "worked": "Write $a_n=p(-2)^{n-1}+q$.\n$$\\begin{align*}a_2&=-2(1)+3=1\\\\p+q&=1\\\\-2p+q&=1\\\\-3p&=0\\\\p&=0\\\\q&=1\\\\a_n&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p28-q2h",
        "type": "part",
        "label": "h",
        "prompt": "$a_{n+1}=-2a_n+3$, given that $a_1=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=(-2)^{n-1}+1$",
          "worked": "Write $a_n=p(-2)^{n-1}+q$.\n$$\\begin{align*}a_2&=-2(2)+3=-1\\\\p+q&=2\\\\-2p+q&=-1\\\\-3p&=-3\\\\p&=1\\\\q&=2-1=1\\\\a_n&=(-2)^{n-1}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
