  "content": {
    "id": "p15-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A fair ten-sided die is rolled and the face value is recorded. Find the probability that the number:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "is odd given that it is prime",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac34$",
          "worked": "The prime outcomes are $2,3,5,7$, of which $3,5,7$ are odd.\n$$\\Pr(\\text{odd}\\mid\\text{prime})=\\frac34.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "is prime given that it is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "The odd outcomes are $1,3,5,7,9$, of which $3,5,7$ are prime.\n$$\\Pr(\\text{prime}\\mid\\text{odd})=\\frac35.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
