  "content": {
    "id": "p50-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "When $P(x)=x^3+ax^2+1$ is divided by $x+2$, the remainder is $5$. Find $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=3$",
      "worked": "By the remainder theorem, $P(-2)=5$.\n$$\\begin{align*}P(-2)&=(-2)^3+a(-2)^2+1\\\\P(-2)&=4a-7\\\\4a-7&=5\\\\a&=3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
