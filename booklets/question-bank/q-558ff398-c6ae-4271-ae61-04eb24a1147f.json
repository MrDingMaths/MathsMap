    "questionDiagrams": [],
    "children": [
      {
        "id": "p107-q33-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{1-\\frac{1}{2}}{1-\\frac{1}{5}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "$$\\begin{align*}\\frac{1-\\frac{1}{2}}{1-\\frac{1}{5}}&=\\frac{\\frac{1}{2}}{\\frac{4}{5}}\\\\&=\\left(\\frac{1}{2}\\right)\\times\\left(\\frac{5}{4}\\right)\\\\&=\\frac{5}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p107-q33-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{1}{1-\\frac{1}{1-\\frac{1}{2}}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{1}{1-\\frac{1}{1-\\frac{1}{2}}}&=\\frac{1}{1-\\frac{1}{\\frac{1}{2}}}\\\\&=\\frac{1}{1-2}\\\\&=\\frac{1}{-1}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p107-q33-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{\\frac{2}{3}+\\frac{1}{5}}{1-\\left(\\frac{2}{3}\\right)\\left(\\frac{1}{5}\\right)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Multiply the numerator and denominator of the outer fraction by $15$, the LCM of $3$ and $5$.\n$$\\begin{align*}\\frac{\\frac{2}{3}+\\frac{1}{5}}{1-\\left(\\frac{2}{3}\\right)\\left(\\frac{1}{5}\\right)}&=\\frac{10+3}{15-2}\\\\&=\\frac{13}{13}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
