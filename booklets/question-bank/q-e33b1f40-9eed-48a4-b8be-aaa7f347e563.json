  "content": {
    "id": "p7-ex17b-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the sum $P(x)+Q(x)$ and the difference $P(x)-Q(x)$, given that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-ex17b-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=x^3+3x+5$ and $Q(x)=2x^3-3x^2-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=3x^3-3x^2-x+5$\n\n$P(x)-Q(x)=-x^3+3x^2+7x+5$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(x^3+3x+5)+(2x^3-3x^2-4x)\\\\P(x)+Q(x)&=3x^3-3x^2-x+5\\end{align*}$$\n$$\\begin{align*}P(x)-Q(x)&=(x^3+3x+5)-(2x^3-3x^2-4x)\\\\P(x)-Q(x)&=x^3+3x+5-2x^3+3x^2+4x\\\\P(x)-Q(x)&=-x^3+3x^2+7x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-ex17b-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=2x^3-3x^2-4x+5$ and $Q(x)=-2x^3+3x^2+5x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=x+3$\n\n$P(x)-Q(x)=4x^3-6x^2-9x+7$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(2x^3-3x^2-4x+5)+(-2x^3+3x^2+5x-2)\\\\P(x)+Q(x)&=x+3\\end{align*}$$\n$$\\begin{align*}P(x)-Q(x)&=(2x^3-3x^2-4x+5)-(-2x^3+3x^2+5x-2)\\\\P(x)-Q(x)&=2x^3-3x^2-4x+5+2x^3-3x^2-5x+2\\\\P(x)-Q(x)&=4x^3-6x^2-9x+7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-ex17b-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=4x^2-3x+6$ and $Q(x)=4x^2-3x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=8x^2-6x$\n\n$P(x)-Q(x)=12$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(4x^2-3x+6)+(4x^2-3x-6)\\\\P(x)+Q(x)&=8x^2-6x\\end{align*}$$\n$$\\begin{align*}P(x)-Q(x)&=(4x^2-3x+6)-(4x^2-3x-6)\\\\P(x)-Q(x)&=4x^2-3x+6-4x^2+3x+6\\\\P(x)-Q(x)&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-ex17b-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(x)=x^4-x^2+x-1$ and $Q(x)=x^3-x^2+x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=x^4+x^3-2x^2+2x-2$\n\n$P(x)-Q(x)=x^4-x^3$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(x^4-x^2+x-1)+(x^3-x^2+x-1)\\\\P(x)+Q(x)&=x^4+x^3-2x^2+2x-2\\end{align*}$$\n$$\\begin{align*}P(x)-Q(x)&=(x^4-x^2+x-1)-(x^3-x^2+x-1)\\\\P(x)-Q(x)&=x^4-x^2+x-1-x^3+x^2-x+1\\\\P(x)-Q(x)&=x^4-x^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-ex17b-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(x)=5x^3+2x^2-x-5$ and $Q(x)=5-5x^3-2x^2+x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=0$\n\n$P(x)-Q(x)=10x^3+4x^2-2x-10$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(5x^3+2x^2-x-5)+(5-5x^3-2x^2+x)\\\\P(x)+Q(x)&=0\\end{align*}$$\n$$\\begin{align*}P(x)-Q(x)&=(5x^3+2x^2-x-5)-(5-5x^3-2x^2+x)\\\\P(x)-Q(x)&=5x^3+2x^2-x-5-5+5x^3+2x^2-x\\\\P(x)-Q(x)&=10x^3+4x^2-2x-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
