    "type": "question",
    "label": "1",
    "prompt": "Determine by substitution whether each given ordered pair is a solution of the simultaneous equations.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1,2)$; $x+y=3$ and $y=x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $(1,2)$ satisfies both equations.",
          "worked": "Substitute $x=1$ and $y=2$.\n$$\\begin{align*}x+y&=1+2=3\\\\x+1&=1+1=2=y\\end{align*}$$\nBoth equations hold, so $(1,2)$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p3-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-1,6)$; $x+y=3$ and $y=x+7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No, $-1+6=5\\ne3$.",
          "worked": "Substitute $x=-1$ and $y=6$.\n$$\\begin{align*}x+y&=-1+6=5\\ne3\\\\x+7&=-1+7=6=y\\end{align*}$$\nThe first equation does not hold, so $(-1,6)$ is not a solution of the simultaneous equations.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
