  "content": {
    "id": "v2-ceb80-p39-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "The masses of eggs are normally distributed with mean 60 g and standard deviation 4 g. In a delivery of 500 eggs, how many are expected to have a mass between 56 g and 64 g?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately 340 eggs.",
      "worked": "$$\\begin{aligned}z(56)&=\\frac{56-60}{4}=-1\\\\z(64)&=\\frac{64-60}{4}=1\\\\P(-1<Z<1)&\\approx0.68\\\\\\text{Expected number}&=0.68\\times500=340\\text{ eggs}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
