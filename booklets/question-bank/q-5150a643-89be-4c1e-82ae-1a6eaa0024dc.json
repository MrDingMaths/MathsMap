    "children": [
      {
        "id": "p29-q74-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that if $f(x)$ is even, then $f'(x)$ is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(-x)=-f'(x)$. Differentiate $f(-x)=f(x)$ using the chain rule.",
          "worked": "Since $f$ is even, $f(-x)=f(x)$. Differentiating both sides with respect to $x$ gives $-f'(-x)=f'(x)$ by the chain rule. Hence $f'(-x)=-f'(x)$, so $f'$ is odd wherever it exists.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p29-q74-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose now that $f(x)$ is odd. Is $f'(x)$ even?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. Differentiating $f(-x)=-f(x)$ gives $f'(-x)=f'(x)$.",
          "worked": "Since $f$ is odd, $f(-x)=-f(x)$. Differentiating both sides gives $-f'(-x)=-f'(x)$ by the chain rule. Thus $f'(-x)=f'(x)$, so $f'$ is even wherever it exists.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
