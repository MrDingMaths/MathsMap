    "type": "question",
    "label": "9",
    "prompt": "Find $x$ if $\\frac{1}{3}+\\frac{1}{4}+\\frac{1}{x}=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac{12}{5}$.",
      "worked": "$$\\begin{align*}\\frac{1}{x}&=1-\\left(\\frac{1}{3}+\\frac{1}{4}\\right)\\\\\\frac{1}{x}&=1-\\frac{7}{12}\\\\\\frac{1}{x}&=\\frac{5}{12}\\\\x&=\\frac{12}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
