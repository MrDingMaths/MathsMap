  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the equation of the line passing through the points:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2,0)$ and $(0,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+2y=6$",
          "worked": "$$\\begin{align*}m&=\\frac{3-0}{0-2}\\\\m&=-\\frac32\\end{align*}$$\nUsing $(0,3)$:\n$$\\begin{align*}y-3&=-\\frac32(x-0)\\\\2y-6&=-3x\\\\3x+2y&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2,2)$ and $(0,1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2y-x=2$",
          "worked": "$$\\begin{align*}m&=\\frac{1-2}{0-2}\\\\m&=\\frac12\\end{align*}$$\nUsing $(0,1)$:\n$$\\begin{align*}y-1&=\\frac12(x-0)\\\\2y-2&=x\\\\2y-x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1,3)$ and $(2,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3$",
          "worked": "Both points have $y$-coordinate $3$, so the line is horizontal. Its equation is $y=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$(5,3)$ and $(5,-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "Both points have $x$-coordinate $5$, so the line is vertical. Its equation is $x=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$(1,1)$ and $(2,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-1$",
          "worked": "$$\\begin{align*}m&=\\frac{3-1}{2-1}\\\\m&=2\\end{align*}$$\nUsing $(1,1)$:\n$$\\begin{align*}y-1&=2(x-1)\\\\y-1&=2x-2\\\\y&=2x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-2,3)$ and $(2,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1-x$",
          "worked": "$$\\begin{align*}m&=\\frac{-1-3}{2-(-2)}\\\\m&=-1\\end{align*}$$\nUsing $(-2,3)$:\n$$\\begin{align*}y-3&=-(x+2)\\\\y-3&=-x-2\\\\y&=1-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
