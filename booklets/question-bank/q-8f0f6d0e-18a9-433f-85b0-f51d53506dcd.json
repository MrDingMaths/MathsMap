  "content": {
    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the common ratio of each GP, find a formula for $a_n$, and find $a_6$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q8a",
        "type": "part",
        "label": "a",
        "prompt": "$1,-1,1,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=-1,\\quad a_n=(-1)^{n-1},\\quad a_6=-1$",
          "worked": "$$\\begin{align*}r&=\\frac{-1}{1}=-1\\\\a_n&=ar^{n-1}\\\\a_n&=(-1)^{n-1}\\\\a_6&=(-1)^5=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q8b",
        "type": "part",
        "label": "b",
        "prompt": "$-2,4,-8,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=-2,\\quad a_n=(-2)^n,\\quad a_6=64$",
          "worked": "$$\\begin{align*}r&=\\frac{4}{-2}=-2\\\\a_n&=ar^{n-1}\\\\a_n&=-2(-2)^{n-1}=(-2)^n\\\\a_6&=(-2)^6=64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q8c",
        "type": "part",
        "label": "c",
        "prompt": "$-8,24,-72,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=-3,\\quad a_n=-8(-3)^{n-1},\\quad a_6=1944$",
          "worked": "$$\\begin{align*}r&=\\frac{24}{-8}=-3\\\\a_n&=ar^{n-1}\\\\a_n&=-8(-3)^{n-1}\\\\a_6&=-8(-3)^5\\\\a_6&=-8(-243)=1944\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q8d",
        "type": "part",
        "label": "d",
        "prompt": "$60,-30,15,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=-\\frac12,\\quad a_n=60\\left(-\\frac12\\right)^{n-1},\\quad a_6=-\\frac{15}{8}$",
          "worked": "$$\\begin{align*}r&=\\frac{-30}{60}=-\\frac12\\\\a_n&=ar^{n-1}\\\\a_n&=60\\left(-\\frac12\\right)^{n-1}\\\\a_6&=60\\left(-\\frac12\\right)^5\\\\a_6&=-\\frac{60}{32}=-\\frac{15}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q8e",
        "type": "part",
        "label": "e",
        "prompt": "$-1024,512,-256,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=-\\frac12,\\quad a_n=-1024\\left(-\\frac12\\right)^{n-1},\\quad a_6=32$",
          "worked": "$$\\begin{align*}r&=\\frac{512}{-1024}=-\\frac12\\\\a_n&=ar^{n-1}\\\\a_n&=-1024\\left(-\\frac12\\right)^{n-1}\\\\a_6&=-1024\\left(-\\frac12\\right)^5\\\\a_6&=\\frac{1024}{32}=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q8f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac1{16},-\\frac38,\\frac94,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=-6,\\quad a_n=\\frac1{16}(-6)^{n-1},\\quad a_6=-486$",
          "worked": "$$\\begin{align*}r&=-\\frac38\\div\\frac1{16}=-6\\\\a_n&=ar^{n-1}\\\\a_n&=\\frac1{16}(-6)^{n-1}\\\\a_6&=\\frac1{16}(-6)^5\\\\a_6&=\\frac{-7776}{16}=-486\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
