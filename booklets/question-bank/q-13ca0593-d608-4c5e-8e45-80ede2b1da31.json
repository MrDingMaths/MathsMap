      {
        "id": "p78-q62-a",
        "type": "part",
        "label": "a",
        "prompt": "Make $x$ the subject in $y=3x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{y-2}{3}$.",
          "worked": "$$\\begin{align*}y&=3x+2\\\\3x&=y-2\\\\x&=\\frac{y-2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p78-q62-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $|2y-7|\\ge 15$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Substituting $x=\\dfrac{y-2}{3}$ gives $\\left|\\dfrac{2y-7}{3}\\right|\\ge 5$, so $|2y-7|\\ge 15$.",
          "worked": "Substitute $x=\\dfrac{y-2}{3}$ into the domain restriction.\n$$\\begin{align*}\\left|2\\left(\\frac{y-2}{3}\\right)-1\\right|&\\ge 5\\\\\\left|\\frac{2y-7}{3}\\right|&\\ge 5\\\\|2y-7|&\\ge 15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p78-q62-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,-4]\\cup[11,\\infty)$.",
          "worked": "$$\\begin{align*}2y-7&\\le -15\\quad\\text{or}\\quad 2y-7\\ge 15\\\\2y&\\le -8\\quad\\text{or}\\quad 2y\\ge 22\\\\y&\\le -4\\quad\\text{or}\\quad y\\ge 11\\end{align*}$$\nThe range is $(-\\infty,-4]\\cup[11,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
