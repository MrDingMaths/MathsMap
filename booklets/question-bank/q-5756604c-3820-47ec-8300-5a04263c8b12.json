    "type": "question",
    "label": "6",
    "prompt": "A circle is inscribed inside a semicircle. Find the circle’s area as a fraction of the semicircle’s area.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p20-q6-diagram",
