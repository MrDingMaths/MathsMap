        "answer": {
          "short": "$\\displaystyle\\frac{|x|}{x}=\\begin{cases}1,&x>0,\\\\-1,&x<0.\\end{cases}$",
          "worked": "For $x>0$, $|x|=x$, so $\\dfrac{|x|}{x}=\\dfrac{x}{x}=1$.\n\nFor $x<0$, $|x|=-x$, so $\\dfrac{|x|}{x}=\\dfrac{-x}{x}=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
