  "content": {
    "id": "p102-q16-content",
    "type": "question",
    "label": "16",
    "prompt": "Which of the two fractions $\\frac{3004}{3005}$ and $\\frac{3005}{3006}$ is larger? Carefully explain why.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3005}{3006}$ is larger: it is $\\frac{1}{3006}$ below 1, which is less than $\\frac{1}{3005}$.",
      "worked": "$$\\begin{align*}\\frac{3004}{3005}&=1-\\frac{1}{3005}\\\\\\frac{3005}{3006}&=1-\\frac{1}{3006}\\end{align*}$$\nSince $\\frac{1}{3006}<\\frac{1}{3005}$, subtracting the smaller fraction from 1 gives the larger result:\n$$1-\\frac{1}{3006}>1-\\frac{1}{3005}.$$\nTherefore, $\\frac{3005}{3006}$ is larger.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
