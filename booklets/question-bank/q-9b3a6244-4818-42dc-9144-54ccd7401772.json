        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "How far from Sydney is the boat at 4 p.m.?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$375\\text{ km}$",
              "worked": "From 11 a.m. to 4 p.m. is 5 hours. The boat travels towards Sydney, so subtract the distance travelled.\n\n$$\\begin{align*}d&=500-25\\times5\\\\d&=500-125\\\\d&=375\\text{ km}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p13-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "How far from Sydney is the boat after travelling for $n$ hours after 11 a.m. (up to the time it reaches Sydney)?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(500-25n)\\text{ km}$",
              "worked": "In $n$ hours the boat travels $25n$ km towards Sydney. Subtract this from its initial distance.\n\n$$d=(500-25n)\\text{ km}$$",
