  "content": {
    "id": "p20-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Given that for two events $A$ and $B$, $P(B)=0.5$, $P(A\\mid B)=0.2$ and $P(A\\cup B)=0.7$. Find $P(A)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P(A)=0.3$",
      "worked": "Using conditional probability:\n$$\\begin{align*}P(A\\cap B)&=P(A\\mid B)\\times P(B)\\\\P(A\\cap B)&=0.2\\times0.5\\\\P(A\\cap B)&=0.1\\end{align*}$$\nUsing the addition rule:\n$$\\begin{align*}P(A)&=P(A\\cup B)-P(B)+P(A\\cap B)\\\\P(A)&=0.7-0.5+0.1\\\\P(A)&=0.3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
