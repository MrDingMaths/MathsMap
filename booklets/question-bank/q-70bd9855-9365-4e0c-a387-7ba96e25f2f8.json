  "content": {
    "id": "p20-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Expand and simplify the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(t+\\frac{1}{t}\\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t^{2}+2+\\frac{1}{t^{2}}$",
          "worked": "$$\\begin{align*}\\left(t+\\frac{1}{t}\\right)^{2}&=t^{2}+2t\\left(\\frac{1}{t}\\right)+\\left(\\frac{1}{t}\\right)^{2}\\\\&=t^{2}+2+\\frac{1}{t^{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(t-\\frac{1}{t}\\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t^{2}-2+\\frac{1}{t^{2}}$",
          "worked": "$$\\begin{align*}\\left(t-\\frac{1}{t}\\right)^{2}&=t^{2}-2t\\left(\\frac{1}{t}\\right)+\\left(\\frac{1}{t}\\right)^{2}\\\\&=t^{2}-2+\\frac{1}{t^{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(t+\\frac{1}{t}\\right)\\left(t-\\frac{1}{t}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t^{2}-\\frac{1}{t^{2}}$",
          "worked": "$$\\begin{align*}\\left(t+\\frac{1}{t}\\right)\\left(t-\\frac{1}{t}\\right)&=t^{2}-\\left(\\frac{1}{t}\\right)^{2}\\\\&=t^{2}-\\frac{1}{t^{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{4}{m}-m\\right)\\left(\\frac{4}{m}+m\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{16}{m^{2}}-m^{2}$",
          "worked": "$$\\begin{align*}\\left(\\frac{4}{m}-m\\right)\\left(\\frac{4}{m}+m\\right)&=\\left(\\frac{4}{m}\\right)^{2}-m^{2}\\\\&=\\frac{16}{m^{2}}-m^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(xy-\\frac{1}{y}\\right)\\left(xy+\\frac{1}{y}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{2}y^{2}-\\frac{1}{y^{2}}$",
          "worked": "$$\\begin{align*}\\left(xy-\\frac{1}{y}\\right)\\left(xy+\\frac{1}{y}\\right)&=(xy)^{2}-\\left(\\frac{1}{y}\\right)^{2}\\\\&=x^{2}y^{2}-\\frac{1}{y^{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{4a}{3}+2\\right)\\left(\\frac{4a}{3}-2\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{16a^{2}}{9}-4$",
          "worked": "$$\\begin{align*}\\left(\\frac{4a}{3}+2\\right)\\left(\\frac{4a}{3}-2\\right)&=\\left(\\frac{4a}{3}\\right)^{2}-2^{2}\\\\&=\\frac{16a^{2}}{9}-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
