  "content": {
    "id": "p19-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "For the graph of $f(x)=4-x^2$,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the graph, showing intercepts and vertex.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Downward-opening parabola; intercepts $(-2,0)$, $(2,0)$ and $(0,4)$; vertex $(0,4)$.",
          "worked": "For the $x$-intercepts:\n$$\\begin{aligned}4-x^2&=0\\\\x^2&=4\\\\x&=\\pm2\\end{aligned}$$\nAt $x=0$, $y=4$. The vertex is $(0,4)$ and the parabola opens downwards.",
          "solutionDiagrams": [
            {
              "id": "p19-q4-a-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"page 19 p19-q4-a-graph\"}\n\\begin{tikzpicture}[x=6mm,y=3mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-4.4,-8.8) rectangle (4.8,8.5);\n\\draw[<->,line width=0.5pt] (-4,-0) -- (4,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-8) -- (0,8) node[above] {$y$};\n\\draw[<->,line width=0.8pt,samples=81,domain=-3.4:3.4] plot (\\x,{4-\\x*\\x});\n\\node[below left] at (-2,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-2$\\special{dvisvgm:raw </g>}};\n\\node[below right] at (2,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\node[above right] at (0,4) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$4$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 55,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 19,
                "sourceRegion": "Question 4a supplied answer",
                "description": "Unscaled coordinate sketch with both-ended axis arrows, curve-end arrows and labelled intercepts; no grid or tick marks.",
                "mathematics": "y=4-x^2; roots -2 and 2; vertex and y-intercept (0,4).",
                "answerVisibility": "answer-only"
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p19-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the equation of the graph after:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$180^\\circ$ rotation about the origin",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-f(-x)=x^2-4$.",
              "worked": "Replace both $x$ and $y$ by their negatives:\n$$\\begin{aligned}-y&=4-(-x)^2\\\\-y&=4-x^2\\\\y&=x^2-4\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p19-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Reflection across the $x$-axis",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-f(x)=x^2-4$.",
              "worked": "Replace $y$ by $-y$:\n$$\\begin{aligned}-y&=4-x^2\\\\y&=x^2-4\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p19-q4-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Reflection across the $y$-axis",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(-x)=4-x^2$.",
              "worked": "Replace $x$ by $-x$:\n$$\\begin{aligned}y&=4-(-x)^2\\\\y&=4-x^2\\end{aligned}$$\nThe graph is unchanged because it is symmetric about the $y$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
