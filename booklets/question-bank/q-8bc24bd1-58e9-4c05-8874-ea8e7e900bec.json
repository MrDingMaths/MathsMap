  "content": {
    "id": "p34-q11-root",
    "type": "question",
    "label": "11",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p34-q11-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "From the letters of the word ",
              "marks": []
            },
            {
              "type": "text",
              "text": "CELLULAR",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": ", six-letter codes are formed. Find the number of codes if",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "the code does not contain the letter L.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$; only five non-L letters are available.",
          "worked": "The non-L letters are C, E, U, A and R. Five letters cannot form a six-letter code without repetition beyond the supplied letters, so there are $0$ codes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p34-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "the code contains exactly one L.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$720$",
          "worked": "All five non-L letters and one L must be used. The six letters are distinct.\n$$\\begin{align*}N&=6!\\\\N&=720\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "the code contains exactly two L’s.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1800$",
          "worked": "Choose four of the five non-L letters, then arrange the six letters, dividing by $2!$ for the identical Ls.\n$$\\begin{align*}N&=\\binom{5}{4}\\frac{6!}{2!}\\\\N&=1800\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "the code contains all three L’s.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1200$",
          "worked": "Choose three of the five non-L letters, then arrange the six letters, dividing by $3!$ for the identical Ls.\n$$\\begin{align*}N&=\\binom{5}{3}\\frac{6!}{3!}\\\\N&=1200\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p34-q11-e-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "3720",
                    "display": false
                  }
                ]
              },
              {
                "id": "p34-q11-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the cases with one, two or three Ls.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Every code contains one, two or three Ls. These cases are disjoint.\n$$\\begin{align*}N&=720+1800+1200\\\\N&=3720\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
