  "content": {
    "id": "p19-q22-response",
    "type": "question",
    "label": "22",
    "prompt": "Sally earned \\$329.40 in a week. If she worked 10 hours during the week and 6 hours on Saturday at time and a half and 4 hours on Sunday at double time, what was her hourly rate of pay?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$12.20/h",
      "worked": "$$\\begin{align*}\\text{Equivalent normal hours} &= 10 + (6 \\times 1.5) + (4 \\times 2)\\\\\\text{Equivalent normal hours} &= 27\\\\\\text{Normal hourly rate} &= \\frac{329.40}{27}\\\\\\text{Normal hourly rate} &= \\$12.20/\\text{h}\\end{align*}$$",
      "solutionDiagrams": []
    },
