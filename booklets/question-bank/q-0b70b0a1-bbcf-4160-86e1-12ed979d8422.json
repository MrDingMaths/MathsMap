    "children": [
      {
        "id": "p18-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that a randomly chosen student is female?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "$$\\begin{align*}P(\\text{female})&=\\frac{60}{100}\\\\P(\\text{female})&=\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p18-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that a randomly chosen student intends to go overseas?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{20}$",
          "worked": "$$\\begin{align*}P(\\text{Yes})&=\\frac{55}{100}\\\\P(\\text{Yes})&=\\frac{11}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p18-q10-c",
        "type": "group",
        "label": "c",
        "prompt": "Calculate the probability that a randomly chosen female student intends on going overseas by using the",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q10-c-i",
            "type": "part",
            "label": "i",
            "prompt": "table.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac12$",
              "worked": "Use the Female row. Of the 60 female students, 30 answered Yes.\n\n$$\\begin{align*}P(\\text{Yes}\\mid\\text{female})&=\\frac{30}{60}\\\\P(\\text{Yes}\\mid\\text{female})&=\\frac12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p18-q10-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "conditional probability formula.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac12$",
              "worked": "Let $Y$ mean the student answered Yes and $F$ mean the student is female.\n\n$$\\begin{align*}P(Y\\mid F)&=\\frac{P(Y\\cap F)}{P(F)}\\\\P(Y\\mid F)&=\\frac{30/100}{60/100}\\\\P(Y\\mid F)&=\\frac12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p18-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the probability that a randomly chosen student is female, given that we know they intend on going overseas?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac6{11}$",
          "worked": "Of the 55 students who answered Yes, 30 are female.\n\n$$\\begin{align*}P(\\text{female}\\mid\\text{Yes})&=\\frac{30}{55}\\\\P(\\text{female}\\mid\\text{Yes})&=\\frac6{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p18-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "Let $Y$ be the event of choosing a student who says “Yes”, and let $F$ be the event of choosing a female student. Is $P(Y\\mid F)=P(F\\mid Y)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No. $P(Y\\mid F)=\\frac12$ and $P(F\\mid Y)=\\frac6{11}$. The first probability uses the 60 female students as its sample space. The second uses the 55 students who answered Yes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "What is the probability that a randomly chosen student is male, given that we know they intend on going overseas?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac5{11}$",
          "worked": "Of the 55 students who answered Yes, 25 are male.\n\n$$\\begin{align*}P(\\text{male}\\mid\\text{Yes})&=\\frac{25}{55}\\\\P(\\text{male}\\mid\\text{Yes})&=\\frac5{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p18-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "What is the probability that a randomly chosen student intends on going overseas, given that they are male?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac58$",
          "worked": "Of the 40 male students, 25 answered Yes.\n\n$$\\begin{align*}P(\\text{Yes}\\mid\\text{male})&=\\frac{25}{40}\\\\P(\\text{Yes}\\mid\\text{male})&=\\frac58\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
