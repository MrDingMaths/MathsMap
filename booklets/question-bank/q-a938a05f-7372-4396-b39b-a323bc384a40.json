  "content": {
    "id": "p8-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Given that $\\cos\\theta=\\dfrac{5}{13}$ where $0<\\theta<\\dfrac{\\pi}{2}$, find $\\sin 2\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{120}{169}$",
      "worked": "Since $\\theta$ is in Quadrant I, $\\sin\\theta>0$.\n$$\\begin{align*}\\sin^2\\theta&=1-\\cos^2\\theta\\\\\\sin^2\\theta&=1-\\left(\\frac{5}{13}\\right)^2\\\\\\sin^2\\theta&=\\frac{144}{169}\\\\\\sin\\theta&=\\frac{12}{13}\\end{align*}$$\n$$\\begin{align*}\\sin 2\\theta&=2\\sin\\theta\\cos\\theta\\\\\\sin 2\\theta&=2\\left(\\frac{12}{13}\\right)\\left(\\frac{5}{13}\\right)\\\\\\sin 2\\theta&=\\frac{120}{169}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
