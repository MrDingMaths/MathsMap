  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A right-angled triangle has one side of length 5 and another side of length 6. There are two possible side lengths for the third side of this triangle. What are they?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p16-q6-short-result",
