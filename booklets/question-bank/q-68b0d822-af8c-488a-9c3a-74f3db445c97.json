    "children": [
      {
        "id": "p30-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{8^n\\times3^{2n}}{2^n\\times6^n\\times9^n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\dfrac{2}{3}\\right)^n$\n\nRewrite the composite bases using powers of 2 and 3.",
          "worked": "$$\\begin{align*}\\frac{8^n\\times3^{2n}}{2^n\\times6^n\\times9^n}&=\\frac{2^{3n}3^{2n}}{2^n2^n3^n3^{2n}}\\\\\\frac{8^n\\times3^{2n}}{2^n\\times6^n\\times9^n}&=2^{3n-2n}3^{2n-3n}\\\\\\frac{8^n\\times3^{2n}}{2^n\\times6^n\\times9^n}&=\\left(\\frac23\\right)^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p30-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2^{n+1}}{(2^n)^{n+1}}\\div\\dfrac{(2^{2n+1})^{n-1}}{4^n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{-3n^2+3n+2}$\n\nMultiply indices within each power, then subtract the exponent of the divisor.",
          "worked": "$$\\begin{align*}\\frac{2^{n+1}}{(2^n)^{n+1}}\\div\\frac{(2^{2n+1})^{n-1}}{4^n}&=2^{n+1-n(n+1)}\\div2^{(2n+1)(n-1)-2n}\\\\\\frac{2^{n+1}}{(2^n)^{n+1}}\\div\\frac{(2^{2n+1})^{n-1}}{4^n}&=2^{1-n^2-(2n^2-3n-1)}\\\\\\frac{2^{n+1}}{(2^n)^{n+1}}\\div\\frac{(2^{2n+1})^{n-1}}{4^n}&=2^{-3n^2+3n+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p30-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2^{n+3}-4\\times2^n}{2^{2n}-4^{n-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16}{3\\times2^n}$\n\nExtract common powers from the numerator and denominator.",
          "worked": "$$\\begin{align*}\\frac{2^{n+3}-4\\times2^n}{2^{2n}-4^{n-1}}&=\\frac{2^n(8-4)}{2^{2n}-2^{2n-2}}\\\\\\frac{2^{n+3}-4\\times2^n}{2^{2n}-4^{n-1}}&=\\frac{4\\times2^n}{2^{2n-2}(4-1)}\\\\\\frac{2^{n+3}-4\\times2^n}{2^{2n}-4^{n-1}}&=\\frac{2^{4-n}}3\\\\\\frac{2^{n+3}-4\\times2^n}{2^{2n}-4^{n-1}}&=\\frac{16}{3\\times2^n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p30-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a^2x^m-b^2x^{m+4}}{a-bx^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^m(a+bx^2)$\n\nExtract $x^m$ and factorise the difference of two squares.",
          "worked": "$$\\begin{align*}\\frac{a^2x^m-b^2x^{m+4}}{a-bx^2}&=\\frac{x^m(a^2-b^2x^4)}{a-bx^2}\\\\\\frac{a^2x^m-b^2x^{m+4}}{a-bx^2}&=\\frac{x^m(a-bx^2)(a+bx^2)}{a-bx^2}\\\\\\frac{a^2x^m-b^2x^{m+4}}{a-bx^2}&=x^m(a+bx^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
