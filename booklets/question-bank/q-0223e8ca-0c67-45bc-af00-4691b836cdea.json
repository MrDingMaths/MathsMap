              "type": "text",
              "text": "A machine worth $400 000 loses 15% of its value per year.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "After how many whole years will its value first fall below $20 000?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "19 years",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "dd6a6991-f443-4c88-8178-3ef90a69624b",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": " be the number of years, with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": " a nonnegative integer.",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{align*}400000(0.85)^n &< 20000\\\\(0.85)^n &< 0.05\\\\n &> \\log_{0.85}(0.05)\\end{align*}",
                "display": true
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Taking logarithms to base ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "0.85",
                "display": false
              },
              {
                "type": "text",
                "text": " reverses the inequality because ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "0<0.85<1",
                "display": false
              },
              {
                "type": "text",
                "text": ". Since ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "18<\\log_{0.85}(0.05)<19",
                "display": false
              },
              {
                "type": "text",
                "text": ", the value first falls below $20 000 after 19 whole years.",
                "marks": []
              }
            ]
          }
