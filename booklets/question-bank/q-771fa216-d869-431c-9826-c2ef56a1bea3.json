          "worked": "$$\\begin{align*}20&=\\frac{m+6}{2}\\\\40&=m+6\\\\m&=34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "For the formula $A=\\frac{PRT}{100}$, find $P$ if $A=1600$, $R=4$ and $T=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=4000$",
          "worked": "$$\\begin{align*}1600&=\\frac{P\\times4\\times10}{100}\\\\160000&=40P\\\\P&=\\frac{160000}{40}\\\\P&=4000\\end{align*}$$",
          "solutionDiagrams": []
