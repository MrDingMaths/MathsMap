        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "For the formula $I=\\frac{180n-360}{n}$, find $n$ if $I=120$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=6$",
          "worked": "$$\\begin{align*}120&=\\frac{180n-360}{n}\\\\120n&=180n-360\\\\60n&=360\\\\n&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p5-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "For the formula $a=\\frac{m+n}{2}$, find $m$ if $a=20$ and $n=6$.",
