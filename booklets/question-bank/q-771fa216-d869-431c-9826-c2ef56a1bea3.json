      {
        "id": "p5-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "For the formula $S=2(\\ell w+\\ell h+hw)$, find $h$ if $S=592$, $\\ell=10$ and $w=8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=12$",
          "worked": "$$\\begin{align*}592&=2(10\\times8+10h+8h)\\\\296&=80+18h\\\\216&=18h\\\\h&=\\frac{216}{18}\\\\h&=12\\end{align*}$$",
          "solutionDiagrams": []
