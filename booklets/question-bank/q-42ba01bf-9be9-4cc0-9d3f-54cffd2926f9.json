    "id": "p14-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "A solid metal ball is melted down and made into similar balls with $\\frac{1}{5}$ the radius.\n\nHow many smaller solid balls can be made?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "125 smaller solid balls.",
      "worked": "Each smaller ball has $\\left(\\frac{1}{5}\\right)^3=\\frac{1}{125}$ of the original volume.\n\n$$\\begin{align*}\\text{Number of balls}&=1\\div\\frac{1}{125}\\\\&=125\\end{align*}$$\n\nTherefore, 125 smaller solid balls can be made.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
