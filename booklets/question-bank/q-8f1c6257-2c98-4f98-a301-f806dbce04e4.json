        "type": "part",
        "label": "a",
        "prompt": "Convert 50 km/h into metres per second.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{125}{9}\\text{ m/s}=13\\frac{8}{9}\\text{ m/s}$",
          "worked": "$$\\begin{align*}50\\text{ km/h}&=50000\\text{ m/h}\\\\50\\text{ km/h}&=\\frac{50000}{60}\\text{ m/min}\\\\50\\text{ km/h}&=\\frac{50000}{60\\times60}\\text{ m/s}\\\\50\\text{ km/h}&=\\frac{125}{9}\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q3b",
        "type": "part",
        "label": "b",
        "prompt": "Convert 10 m/s into kilometres per hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36\\text{ km/h}$",
          "worked": "$$\\begin{align*}10\\text{ m/s}&=10\\times60\\times60\\text{ m/h}\\\\10\\text{ m/s}&=\\frac{36000}{1000}\\text{ km/h}\\\\10\\text{ m/s}&=36\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q3c",
        "type": "part",
        "label": "c",
        "prompt": "Convert 9.5 m/s into kilometres per hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34.2\\text{ km/h}$",
          "worked": "$$\\begin{align*}9.5\\text{ m/s}&=9.5\\times60\\times60\\text{ m/h}\\\\9.5\\text{ m/s}&=\\frac{34200}{1000}\\text{ km/h}\\\\9.5\\text{ m/s}&=34.2\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
