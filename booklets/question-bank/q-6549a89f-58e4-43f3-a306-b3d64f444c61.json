  "content": {
    "id": "v2-1ddc9-p55-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Solve $\\sin\\theta=-\\dfrac{1}{\\sqrt{2}}$ for $0\\leq\\theta<360^{\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\theta=225^{\\circ}$ or $315^{\\circ}$. Reference angle $45^{\\circ}$; Q3 or Q4.",
      "worked": "Reference angle:\n$$\\begin{align*}A&=\\sin^{-1}\\left(\\frac{1}{\\sqrt{2}}\\right)\\\\A&=45^{\\circ}\\end{align*}$$\n$\\sin\\theta<0$, so $\\theta$ is in Q3 or Q4.\n$$\\begin{align*}\\theta&=180^{\\circ}+45^{\\circ}\\\\\\theta&=225^{\\circ}\\\\\\text{or }\\theta&=360^{\\circ}-45^{\\circ}\\\\\\theta&=315^{\\circ}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
