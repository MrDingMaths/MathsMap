      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1$ on $[a,b]$ with closed endpoints; $y=0$ outside $[a,b]$ with open endpoints at $a$ and $b$.",
          "worked": "For $a\\le x\\le b$, draw the horizontal segment $y=1$, including $(a,1)$ and $(b,1)$. For $x<a$ and $x>b$, draw $y=0$, excluding $(a,0)$ and $(b,0)$.",
