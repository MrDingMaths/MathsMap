    "id": "p20-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "$ABCD$ is a parallelogram with vertices $A(4,4)$, $B(2,6)$ and $C(8,9)$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
