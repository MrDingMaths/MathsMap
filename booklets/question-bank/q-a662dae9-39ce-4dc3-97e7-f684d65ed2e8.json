  "content": {
    "id": "p84-q23-node",
    "type": "question",
    "label": "7",
    "prompt": "Find the tangent to $y=\\sqrt{x+1}$ at $x=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\dfrac{x}{4}+\\dfrac{5}{4}$\n\nAt $x=3$, the point is $(3,2)$ and the tangent gradient is $\\tfrac14$.",
      "worked": "$$\\begin{align*}y'&=\\frac{1}{2\\sqrt{x+1}}\\\\y'(3)&=\\frac14\\\\y-2&=\\frac14(x-3)\\\\y&=\\frac{x}{4}+\\frac54\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
