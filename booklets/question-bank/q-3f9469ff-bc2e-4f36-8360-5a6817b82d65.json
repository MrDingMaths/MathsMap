    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$3.62$ per kg",
      "worked": "$$\\begin{align*}\\text{Price now}&=2.80\\times1.05\\times1.1\\times1.12\\\\\\text{Price now}&=3.62208\\\\\\text{Price now}&\\approx\\$3.62\\text{ per kg}\\end{align*}$$",
