  "content": {
    "id": "p48-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Define $f(x)=\\frac32x^2$, domain $[-1,1]$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p48-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Confirm it is a valid PDF.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)\\ge0$ on $[-1,1]$ and $\\displaystyle\\int_{-1}^{1}f(x)\\,dx=1$, so it is a valid PDF.",
          "worked": "$$\\begin{align*}\\int_{-1}^{1}\\frac32x^2\\,dx&=\\frac32\\left[\\frac{x^3}{3}\\right]_{-1}^{1}\\\\&=\\frac32\\left(\\frac23\\right)\\\\&=1\\end{align*}$$\nAlso, $f(x)=\\frac32x^2\\ge0$ for every $x\\in[-1,1]$. Hence $f$ is a valid PDF.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p48-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $E(X)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=0$.",
          "worked": "$$\\begin{align*}E(X)&=\\int_{-1}^{1}x\\left(\\frac32x^2\\right)\\,dx\\\\&=\\frac32\\int_{-1}^{1}x^3\\,dx\\\\&=\\frac32\\left[\\frac{x^4}{4}\\right]_{-1}^{1}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p48-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\operatorname{Var}(X)$ and $\\sigma$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{Var}(X)=\\frac35$, $\\sigma=\\frac{\\sqrt{15}}5$.",
          "worked": "$$\\begin{align*}E(X^2)&=\\frac32\\int_{-1}^{1}x^4\\,dx\\\\&=\\frac32\\left[\\frac{x^5}{5}\\right]_{-1}^{1}\\\\&=\\frac32\\left(\\frac25\\right)\\\\&=\\frac35\\end{align*}$$\n$$\\begin{align*}\\operatorname{Var}(X)&=E(X^2)-\\bigl(E(X)\\bigr)^2\\\\&=\\frac35-0\\\\&=\\frac35\\end{align*}$$\n$$\\begin{align*}\\sigma&=\\sqrt{\\frac35}\\\\&=\\frac{\\sqrt{15}}5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p48-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Calculate $\\displaystyle\\int_{\\mu-\\sigma}^{\\mu+\\sigma}f(x)\\,dx$ to find the percentage of the population within one standard deviation of the mean. Give the percentage to the nearest whole percent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $46\\%$.",
          "worked": "$$\\begin{align*}P\\left(-\\frac{\\sqrt{15}}5\\le X\\le\\frac{\\sqrt{15}}5\\right)&=\\frac32\\int_{-\\sqrt{15}/5}^{\\sqrt{15}/5}x^2\\,dx\\\\&=3\\left[\\frac{x^3}{3}\\right]_{0}^{\\sqrt{15}/5}\\\\&=\\left(\\frac{\\sqrt{15}}5\\right)^3\\\\&=\\frac{3\\sqrt{15}}{25}\\\\&\\approx0.46\\end{align*}$$\nTherefore approximately $46\\%$ of the population is within one standard deviation of the mean.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
