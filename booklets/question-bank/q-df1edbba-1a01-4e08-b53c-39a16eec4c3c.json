  "content": {
    "id": "p3-q7",
    "type": "question",
    "label": "7",
    "prompt": "Edward wants to travel from Melbourne to Brisbane via Sydney. There are 3 flights and 2 trains from Melbourne to Sydney. There are 2 flights and 3 trains from Sydney to Brisbane. How many ways can Edward travel from Melbourne to Brisbane?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "25",
      "worked": "There are $3+2=5$ choices for the first stage and $2+3=5$ choices for the second.\n$$\\begin{align*}\\text{Number of journeys}&=(3+2)(2+3)\\\\\\text{Number of journeys}&=25\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
