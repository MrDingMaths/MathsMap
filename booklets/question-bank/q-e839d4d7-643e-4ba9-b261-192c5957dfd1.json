  "content": {
    "id": "p61-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Chloe buys 200 bracelets for \\$120.\nAt the summer fete, she sells one-quarter of the bracelets for \\$2 each.\nShe then reduces the price of the remaining bracelets by 25%.\nAt the end of the day, she has 20 bracelets left. Work out:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p61-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "the number of bracelets that she sold at the reduced price.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "130 bracelets",
          "worked": "$$\\begin{align*}\\text{Number sold at }\\$2\\text{ each}&=\\frac14\\times200\\\\\\text{Number sold at }\\$2\\text{ each}&=50\\\\\\text{Number sold at the reduced price}&=200-50-20\\\\\\text{Number sold at the reduced price}&=130\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p61-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "Chloe's total income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$295",
          "worked": "$$\\begin{align*}\\text{Price reduction}&=\\frac{25}{100}\\times\\$2\\\\\\text{Price reduction}&=\\$0.50\\\\\\text{Reduced price}&=\\$2-\\$0.50\\\\\\text{Reduced price}&=\\$1.50\\\\\\text{Total income}&=50\\times\\$2+130\\times\\$1.50\\\\\\text{Total income}&=\\$100+\\$195\\\\\\text{Total income}&=\\$295\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p61-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "the percentage profit that she made. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$145.83\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit}&=\\$295-\\$120\\\\\\text{Profit}&=\\$175\\\\\\text{Percentage profit}&=\\frac{175}{120}\\times100\\%\\\\\\text{Percentage profit}&\\approx145.83\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
