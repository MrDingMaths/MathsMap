  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A sector has angle $50^\\circ$ and radius $9\\text{ cm}$. Find its perimeter.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(18+\\frac{5\\pi}{2})\\text{ cm}$",
      "worked": "$$\\begin{align*}P&=2r+\\frac{\\theta}{360^\\circ}\\times2\\pi r\\\\P&=2\\times9+\\frac{50}{360}\\times18\\pi\\\\P&=\\left(18+\\frac{5\\pi}{2}\\right)\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
