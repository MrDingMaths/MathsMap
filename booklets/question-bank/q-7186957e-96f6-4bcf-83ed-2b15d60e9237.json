  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A function $f(x)$ has second derivative $f''(x)=2x-10$. Its graph passes through the point $(3,-34)$, and at this point the tangent has a gradient of $20$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f'(x)=x^2-10x+41$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=x^2-10x+41$.",
          "worked": "$$\\begin{align*}f''(x)&=2x-10\\\\f'(x)&=x^2-10x+C\\end{align*}$$\nThe tangent gradient gives $f'(3)=20$.\n$$\\begin{align*}20&=9-30+C\\\\C&=41\\\\f'(x)&=x^2-10x+41\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p15-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $f(x)$, and show that its graph cuts the $y$-axis at $(0,-121)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\dfrac{x^3}{3}-5x^2+41x-121$; the $y$-intercept is $(0,-121)$.",
          "worked": "$$f(x)=\\frac{x^3}{3}-5x^2+41x+C$$\nSubstitute $(3,-34)$:\n$$\\begin{align*}-34&=9-45+123+C\\\\C&=-121\\\\f(x)&=\\frac{x^3}{3}-5x^2+41x-121\\end{align*}$$\nWhen $x=0$, $f(0)=-121$, so the graph cuts the $y$-axis at $(0,-121)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
