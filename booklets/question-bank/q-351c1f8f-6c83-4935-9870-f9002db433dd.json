  "content": {
    "id": "p12-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Solve these quadratic equations by first rearranging to $ax^{2}+bx+c=0$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{2}=3x+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$ or $-2$",
          "worked": "$$\\begin{align*}x^{2}-3x-10&=0\\\\(x-5)(x+2)&=0\\\\x&=5\\text{ or }-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{2}=7x-10$",
        "layout": "list",
        "columns": null,
