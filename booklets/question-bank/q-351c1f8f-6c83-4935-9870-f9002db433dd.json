          "worked": "$$\\begin{align*}x^{2}-6x+9&=0\\\\(x-3)^{2}&=0\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
