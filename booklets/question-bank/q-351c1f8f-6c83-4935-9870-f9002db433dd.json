        "children": [],
        "answer": {
          "short": "$x=5$ or $2$",
          "worked": "$$\\begin{align*}x^{2}-7x+10&=0\\\\(x-5)(x-2)&=0\\\\x&=5\\text{ or }2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^{2}=6x-9$",
