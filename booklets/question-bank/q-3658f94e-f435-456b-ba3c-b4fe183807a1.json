  "content": {
    "id": "p15-practice-2-root",
    "type": "question",
    "label": "",
    "prompt": "What is the minimum number of terms of the series $2+6+18+\\cdots$ needed to give a sum of at least one billion?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$19$ terms.",
      "worked": "$a=2$ and $r=3$.\n$$\\begin{align*}S_n&=\\frac{2(3^n-1)}{3-1}\\\\S_n&=3^n-1\\\\3^n-1&\\ge 1\\,000\\,000\\,000\\\\3^n&\\ge 1\\,000\\,000\\,001\\end{align*}$$\nCheck consecutive integer values:\n$$\\begin{align*}S_{18}&=3^{18}-1=387\\,420\\,488\\\\S_{19}&=3^{19}-1=1\\,162\\,261\\,466\\end{align*}$$\nThe partial sums increase, so the minimum number of terms is $19$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 37
  },
