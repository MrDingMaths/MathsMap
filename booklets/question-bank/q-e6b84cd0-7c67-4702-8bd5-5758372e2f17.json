  "content": {
    "id": "p65-q25-root",
    "type": "question",
    "label": "",
    "prompt": "In $\\triangle ABC$, the point $M$ is the midpoint of $BC$.\nIf $\\overrightarrow{AC}=\\underset{\\sim}{u}$ and $\\overrightarrow{BC}=\\underset{\\sim}{v}$, write in terms of $\\underset{\\sim}{u}$ and $\\underset{\\sim}{v}$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p65-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{AB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{u}-\\underset{\\sim}{v}$",
          "worked": "$$\\begin{align*}\\overrightarrow{AB}&=\\overrightarrow{AC}+\\overrightarrow{CB}\\\\\\overrightarrow{AB}&=\\overrightarrow{AC}-\\overrightarrow{BC}\\\\\\overrightarrow{AB}&=\\underset{\\sim}{u}-\\underset{\\sim}{v}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p65-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{AM}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{u}-\\dfrac12\\underset{\\sim}{v}$",
          "worked": "$$\\begin{align*}\\overrightarrow{AM}&=\\overrightarrow{AC}+\\overrightarrow{CM}\\\\\\overrightarrow{AM}&=\\overrightarrow{AC}-\\overrightarrow{MC}\\\\\\overrightarrow{AM}&=\\overrightarrow{AC}-\\frac12\\overrightarrow{BC}\\\\\\overrightarrow{AM}&=\\underset{\\sim}{u}-\\frac12\\underset{\\sim}{v}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
