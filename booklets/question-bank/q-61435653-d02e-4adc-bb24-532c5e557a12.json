      {
        "id": "p9-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sin x\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\cos^2x-\\sin^2x$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=(\\cos x)(\\cos x)+(\\sin x)(-\\sin x)\\\\&=\\cos^2x-\\sin^2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sin^2 7x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=14\\sin 7x\\cos 7x$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2\\sin 7x(7\\cos 7x)\\\\&=14\\sin 7x\\cos 7x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\cos^5 3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-15\\cos^4 3x\\sin 3x$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=5\\cos^4 3x(-3\\sin 3x)\\\\&=-15\\cos^4 3x\\sin 3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(1-\\cos 3x)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=9\\sin 3x(1-\\cos 3x)^2$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3(1-\\cos 3x)^2(3\\sin 3x)\\\\&=9\\sin 3x(1-\\cos 3x)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p9-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\sin 2x\\sin 4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2(\\cos 2x\\sin 4x+2\\sin 2x\\cos 4x)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2\\cos 2x\\sin 4x+4\\sin 2x\\cos 4x\\\\&=2(\\cos 2x\\sin 4x+2\\sin 2x\\cos 4x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p9-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\tan^3(5x-4)$",
        "layout": "list",
