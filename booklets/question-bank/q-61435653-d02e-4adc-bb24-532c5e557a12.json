        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=15\\tan^2(5x-4)\\sec^2(5x-4)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3\\tan^2(5x-4)\\times5\\sec^2(5x-4)\\\\&=15\\tan^2(5x-4)\\sec^2(5x-4)\\end{align*}$$",
          "solutionDiagrams": []
        },
