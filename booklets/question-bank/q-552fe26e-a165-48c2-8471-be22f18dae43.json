        "id": "p14-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "If $x+y=z$, show that $z$ must equal $90^{\\circ}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z+z=180^{\\circ}$, so $z=90^{\\circ}$.",
          "worked": "Angles in a triangle sum to $180^{\\circ}$. Using $x+y=z$:\n$$\\begin{align*}x+y+z&=180^{\\circ}\\\\z+z&=180^{\\circ}\\\\2z&=180^{\\circ}\\\\z&=90^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "If $x+y=2z$, show that $z$ must be equal to $60^{\\circ}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2z+z=180^{\\circ}$, so $z=60^{\\circ}$.",
          "worked": "Angles in a triangle sum to $180^{\\circ}$. Using $x+y=2z$:\n$$\\begin{align*}x+y+z&=180^{\\circ}\\\\2z+z&=180^{\\circ}\\\\3z&=180^{\\circ}\\\\z&=60^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
