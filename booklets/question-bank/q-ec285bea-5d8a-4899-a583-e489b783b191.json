  "content": {
    "id": "p20-q11-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x+\\dfrac1x$. Find and simplify",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$f\\left(\\dfrac1x\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+\\dfrac1x$",
          "worked": "$$\\begin{align*}f\\left(\\frac1x\\right)&=\\frac1x+\\frac1{1/x}\\\\f\\left(\\frac1x\\right)&=x+\\frac1x.\\end{align*}$$\nHere $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$f\\left(x+\\dfrac1x\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+\\dfrac1x+\\dfrac{x}{x^2+1}$",
          "worked": "$$\\begin{align*}f\\left(x+\\frac1x\\right)&=x+\\frac1x+\\frac1{x+1/x}\\\\f\\left(x+\\frac1x\\right)&=x+\\frac1x+\\frac{x}{x^2+1}.\\end{align*}$$\nHere $x\\ne0$. For real $x$, $x^2+1>0$, so the argument $x+\\frac{1}{x}$ is nonzero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p20-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(2+\\sqrt3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}f(2+\\sqrt3)&=2+\\sqrt3+\\frac1{2+\\sqrt3}\\\\f(2+\\sqrt3)&=2+\\sqrt3+\\frac{2-\\sqrt3}{4-3}\\\\f(2+\\sqrt3)&=4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
