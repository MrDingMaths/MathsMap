    "id": "v2-1b91c-p15-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Maya has $8\\frac{3}{4}$ metres of fabric. She uses $2\\frac{1}{3}$ metres to make a cushion cover. How much fabric is left?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6\\frac{5}{12}$ metres",
      "worked": "$$\\begin{align*}8\\frac{3}{4}-2\\frac{1}{3}&=\\frac{35}{4}-\\frac{7}{3}\\\\&=\\frac{105}{12}-\\frac{28}{12}\\\\&=\\frac{77}{12}\\\\&=6\\frac{5}{12}\\end{align*}$$\nMaya has $6\\frac{5}{12}$ metres of fabric left.",
      "solutionDiagrams": []
    },
