  "content": {
    "id": "p15-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "In each part, find a formula from the information given.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A hire car firm charges $\\$20$ per day plus 40 cents per km. What is the total cost $\\$C$ for a day in which $x$ km was travelled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=20+0.4x$",
          "worked": "The distance charge is $\\$0.40$ per kilometre.\n$$\\begin{align*}C&=20+0.40\\times x\\\\C&=20+0.4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "If there are 50 litres of petrol in the tank of a car and petrol is used at the rate of 4 litres per day, what is the number of litres $y$ that remains after $x$ days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=50-4x$",
          "worked": "After $x$ days, $4x$ litres have been used.\n$$\\begin{align*}y&=50-4\\times x\\\\y&=50-4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Cooking instructions for a forequarter of lamb are as follows: preheat oven to $220^{\\circ}\\mathrm{C}$ and cook for 45 min per kg plus an additional 20 min. What is the formula relating the cooking time $T$ minutes and weight $w$ kg?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$T=20+45w$",
          "worked": "The weight-dependent cooking time is $45w$ minutes.\n$$\\begin{align*}T&=45w+20\\\\T&=20+45w\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "In a sequence of numbers the first number is 2, the second number is 4, the third is 8, the fourth is 16, etc. Assuming the doubling pattern continues, what is the formula you would use to calculate $t$, the $n$th number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p16-q6-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "t=2^n",
                    "display": false
                  }
                ]
              },
              {
                "id": "p16-q6-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The nth term contains n factors of 2.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$2=2^1$, $4=2^2$, $8=2^3$ and $16=2^4$. The exponent matches the term number, so\n$$t=2^n.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p16-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "A piece of wire of length $x$ cm is bent into a circle of area $A$ cm$^2$. What is the formula relating $A$ and $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p16-q6-e-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "A=\\frac{x^2}{4\\pi}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p16-q6-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Express the radius using the wire's circumference, then substitute into the area formula.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The wire length is the circumference of the circle.\n$$\\begin{align*}x&=2\\pi r\\\\r&=\\frac{x}{2\\pi}\\end{align*}$$\n$$\\begin{align*}A&=\\pi r^2\\\\A&=\\pi\\left(\\frac{x}{2\\pi}\\right)^2\\\\A&=\\frac{x^2}{4\\pi}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
