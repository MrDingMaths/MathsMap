        "prompt": "$7x^2-16x=15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac57$ or $x=3$",
          "worked": "$$\\begin{align*}7x^2-16x-15&=0\\\\7x^2+5x-21x-15&=0\\\\x(7x+5)-3(7x+5)&=0\\\\(7x+5)(x-3)&=0\\\\7x+5&=0\\quad\\text{or}\\quad x-3=0\\\\x&=-\\frac57\\quad\\text{or}\\quad x=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2+3x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=\\frac12$",
          "worked": "$$\\begin{align*}2x^2+3x-2&=0\\\\2x^2+4x-x-2&=0\\\\2x(x+2)-(x+2)&=0\\\\(x+2)(2x-1)&=0\\\\x+2&=0\\quad\\text{or}\\quad 2x-1=0\\\\x&=-2\\quad\\text{or}\\quad x=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
