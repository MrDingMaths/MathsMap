    "children": [
      {
        "id": "p19-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Name the angle at the centre of the circle subtended by $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle AOB$",
          "worked": "$\\angle AOB$, with vertex at the centre $O$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p19-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Name the angle at the circumference subtended by $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle ACB$",
          "worked": "$\\angle ACB$, with vertex $C$ on the circumference.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p19-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "If $\\angle ACB = 40^\\circ$, find $\\angle AOB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80^\\circ$",
          "worked": "$$\\begin{align*}\\angle AOB &= 2\\times40^\\circ\\\\\\angle AOB &= 80^\\circ\\end{align*}$$\nThe angle at the centre is twice the angle at the circumference standing on the same arc.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "If $\\angle AOB = 122^\\circ$, find $\\angle ACB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$61^\\circ$",
          "worked": "$$\\begin{align*}\\angle ACB &= 122^\\circ\\div2\\\\\\angle ACB &= 61^\\circ\\end{align*}$$\nThe angle at the circumference is half the angle at the centre standing on the same arc.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ],
