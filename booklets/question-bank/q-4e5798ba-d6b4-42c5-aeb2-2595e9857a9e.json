        "type": "part",
        "label": "a",
        "prompt": "The temperature in Thredbo at 6 am is $-2^\\circ\\text{C}$. By 10 am it has risen by $6^\\circ\\text{C}$. By 3 pm it has fallen by $10^\\circ\\text{C}$. Find the temperature at 3 pm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6^\\circ\\text{C}$",
          "worked": "$$\\begin{align*}-2+6-10&=4-10\\\\-2+6-10&=-6\\end{align*}$$\nThe temperature at 3 pm is $-6^\\circ\\text{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-a5b8c-p19-practice-slot-10-upper-slot-10-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "A diver at Jervis Bay is $8$ m below sea level. She rises $3$ m, then dives down $6$ m. Find her position relative to sea level.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-11$ m (11 m below sea level)",
          "worked": "$$\\begin{align*}-8+3-6&=-5-6\\\\-8+3-6&=-11\\end{align*}$$\nThe diver is $11$ m below sea level.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
