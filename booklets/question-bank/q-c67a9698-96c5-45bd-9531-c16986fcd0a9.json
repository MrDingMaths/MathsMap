  "content": {
    "id": "p7-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "If you roll an ordinary six-sided die, what is the probability that you will not get a score of 5 or more?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{3}$",
      "worked": "Let $A$ be the event ‘a score of 5 or more’. Its outcomes are $5$ and $6$.\n$$\\begin{align*}P(A)&=\\frac{2}{6}\\\\P(A)&=\\frac{1}{3}\\end{align*}$$\nThe required event is the complement of $A$.\n$$\\begin{align*}P(A^c)&=1-P(A)\\\\P(A^c)&=1-\\frac{1}{3}\\\\P(A^c)&=\\frac{2}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
