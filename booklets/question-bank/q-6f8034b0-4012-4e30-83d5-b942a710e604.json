  "content": {
    "id": "p40-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "The distance from Broken Hill to Tibooburra is 360 km. A motorist travels from Broken Hill to Tibooburra at a mean speed of 90 km/h and returns at a mean speed of 60 km/h.\nWhat is the average speed of the motorist for the whole journey?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$72\\text{ km/h}$",
      "worked": "Using $t=\\dfrac{d}{s}$ for each stage:\n$$\\begin{align*}t_{\\text{out}}&=\\frac{360}{90}\\\\t_{\\text{out}}&=4\\text{ h}\\\\t_{\\text{return}}&=\\frac{360}{60}\\\\t_{\\text{return}}&=6\\text{ h}\\\\d_{\\text{total}}&=360+360\\\\d_{\\text{total}}&=720\\text{ km}\\\\t_{\\text{total}}&=4+6\\\\t_{\\text{total}}&=10\\text{ h}\\\\s_{\\text{average}}&=\\frac{d_{\\text{total}}}{t_{\\text{total}}}\\\\s_{\\text{average}}&=\\frac{720}{10}\\\\s_{\\text{average}}&=72\\text{ km/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
