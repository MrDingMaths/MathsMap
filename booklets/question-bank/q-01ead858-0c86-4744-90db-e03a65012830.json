    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-statistics-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Draw a stem-and-leaf plot of the data.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{array}{r|l}\\text{Stem}&\\text{Leaves}\\\\\\hline 2&2\\ 3\\ 4\\ 4\\ 6\\ 7\\\\3&1\\ 3\\ 5\\ 6\\ 8\\ 8\\ 9\\\\4&0\\ 1\\ 1\\ 1\\ 4\\ 6\\end{array}$$\n\nKey: $2\\mid4$ represents 24 wombats.",
          "worked": "Use the tens digit as the stem and the units digit as the leaf. Order the leaves from smallest to largest, retaining repeated values.\n\n$$\\begin{array}{r|l}\\text{Stem}&\\text{Leaves}\\\\\\hline 2&2\\ 3\\ 4\\ 4\\ 6\\ 7\\\\3&1\\ 3\\ 5\\ 6\\ 8\\ 8\\ 9\\\\4&0\\ 1\\ 1\\ 1\\ 4\\ 6\\end{array}$$\n\nKey: $2\\mid4$ represents 24 wombats.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-statistics-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the median of the data.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "36 wombats.",
          "worked": "There are 19 values, so the median is the 10th ordered value. The stem-and-leaf plot has six values in the twenties; the fourth value in the thirties is 36. Hence the median is 36 wombats.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p10-statistics-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the range of the data.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "24 wombats.",
          "worked": "$$\\begin{align*}\\text{Range}&=\\text{largest value}-\\text{smallest value}\\\\\\text{Range}&=46-22\\\\\\text{Range}&=24\\text{ wombats}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
