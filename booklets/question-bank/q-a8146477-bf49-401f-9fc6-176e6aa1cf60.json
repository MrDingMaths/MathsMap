  "content": {
    "id": "p29-q4",
    "type": "question",
    "label": "4",
    "prompt": "A right-angled triangle has one shorter side 5 m long and its longest side is exactly $\\sqrt{61}$ m long. How long is the other side?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6\\text{ m}$",
      "worked": "Let $a$ be the other shorter side.\n$$\\begin{align*}a &= \\sqrt{(\\sqrt{61})^2-5^2}\\\\a &= \\sqrt{61-25}\\\\a &= 6\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
