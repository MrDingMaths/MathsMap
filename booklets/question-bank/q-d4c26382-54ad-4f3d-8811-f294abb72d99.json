  "content": {
    "id": "p3-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "In a triathlon race, Luca ran at an average speed 5 times his average swimming speed. Also, when his average running speed was multiplied by 4, this number was 3 less than his average speed for the cycling leg.\n\nIf $x$ km/h is Luca’s average swimming speed, find expressions in terms of $x$ for his:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "average running speed",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x$ km/h",
          "worked": "Luca’s average running speed is 5 times his average swimming speed.\n\n$$\\text{Running speed}=5x\\text{ km/h}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p3-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "average cycling speed",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(20x+3)$ km/h",
          "worked": "Four times the running speed is 3 km/h less than the cycling speed, so add 3 km/h.\n\n$$\\begin{align*}\\text{Cycling speed}&=4(5x)+3\\\\\\text{Cycling speed}&=(20x+3)\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
