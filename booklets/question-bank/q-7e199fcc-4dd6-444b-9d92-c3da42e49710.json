        "children": [],
        "answer": {
          "short": "$t=4$ months.",
          "worked": "The graph has its steepest positive tangent at $t=4$ months, so this is when the share price is increasing most rapidly.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p14-q18-e",
        "type": "part",
        "label": "e",
        "prompt": "When is the share price increasing at an increasing rate?",
        "layout": "list",
