        "children": [],
        "answer": {
          "short": "$t=0$ and $t=6$ months.",
          "worked": "The greatest height on the graph occurs initially and again at $t=6$ months. Thus the price is maximum at $t=0$ and $t=6$ months.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p14-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "When is the price increasing and when is it decreasing?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increasing for $2<t<6$; decreasing for $0<t<2$ and $t>6$.",
          "worked": "The graph rises for $2<t<6$, so the price is increasing. It falls for $0<t<2$ and $t>6$, so the price is decreasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p14-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "When is the share price increasing most rapidly?",
