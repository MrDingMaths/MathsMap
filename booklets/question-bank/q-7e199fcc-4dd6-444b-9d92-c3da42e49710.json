        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2$ and $t=6$ months.",
          "worked": "The tangents are horizontal at the two turning points, so the price is stationary at $t=2$ and $t=6$ months.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
