        "type": "part",
        "label": "a",
        "prompt": "write the rule for the sum of interior angles $(S)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S=180(n-2)^{\\circ}$",
          "worked": "A polygon with $n$ sides can be divided into $n-2$ triangles.\n$$S=180(n-2)^{\\circ}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "write the rule for the size of each interior angle $(I)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=\\dfrac{180(n-2)^{\\circ}}{n}$",
          "worked": "The $n$ interior angles of a regular polygon are equal.\n$$\\begin{aligned}I&=\\frac{S}{n}\\\\I&=\\frac{180(n-2)^{\\circ}}{n}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p19-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "write the rule for the size of each exterior angle $(E)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E=\\dfrac{360^{\\circ}}{n}$",
          "worked": "The exterior angles sum to $360^{\\circ}$ and are equal in a regular polygon.\n$$E=\\frac{360^{\\circ}}{n}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
