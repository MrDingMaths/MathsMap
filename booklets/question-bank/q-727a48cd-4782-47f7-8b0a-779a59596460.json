    "id": "v2-588be-p18-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Write the equation for each relation after the given reflections have been applied in order.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-588be-p18-practice-slot-4-slot-4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2^x-3$\n\nacross the $y$-axis, then the $x$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3-2^{-x}$",
          "worked": "Across the $y$-axis, replace $x$ by $-x$. Then across the $x$-axis, replace $y$ by $-y$.\n$$\\begin{align*}y&=2^{-x}-3\\\\-y&=2^{-x}-3\\\\y&=3-2^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-588be-p18-practice-slot-4-slot-4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(x+1)^3$\n\nacross the $x$-axis, then the $y$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-1)^3$",
          "worked": "Across the $x$-axis, replace $y$ by $-y$. Then across the $y$-axis, replace $x$ by $-x$.\n$$\\begin{align*}y&=-(x+1)^3\\\\y&=-(-x+1)^3\\\\y&=-\\bigl(-(x-1)\\bigr)^3\\\\y&=(x-1)^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
