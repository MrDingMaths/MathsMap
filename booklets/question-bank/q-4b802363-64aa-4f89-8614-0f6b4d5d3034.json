  "content": {
    "id": "p5-q1-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the following limits by substituting the given value.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\lim_{x\\to6}(4-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\lim_{x\\to6}(4-x)&=4-6\\\\\\lim_{x\\to6}(4-x)&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p5-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\lim_{x\\to3}(x^2-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\lim_{x\\to3}(x^2-x)&=3^2-3\\\\\\lim_{x\\to3}(x^2-x)&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p5-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\lim_{x\\to4}\\left(\\frac{12}{x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\lim_{x\\to4}\\left(\\frac{12}{x}\\right)&=\\frac{12}{4}\\\\\\lim_{x\\to4}\\left(\\frac{12}{x}\\right)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p5-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\lim_{x\\to-2}\\left(\\sqrt{x+2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "The square root is continuous on its domain $x\\ge-2$, so substitute $x=-2$ at the endpoint.\n\n$$\\begin{align*}\\lim_{x\\to-2^+}\\sqrt{x+2}&=\\sqrt{-2+2}\\\\\\lim_{x\\to-2^+}\\sqrt{x+2}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
