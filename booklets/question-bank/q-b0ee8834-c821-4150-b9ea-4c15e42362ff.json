        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{3\\sqrt{x}}{2}$",
          "worked": "$$\\begin{aligned}y&=x\\times x^{1/2}\\\\y&=x^{3/2}\\\\\\frac{dy}{dx}&=\\frac32x^{1/2}\\\\\\frac{dy}{dx}&=\\frac{3\\sqrt{x}}2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q6b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{1}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-\\dfrac{1}{2x\\sqrt{x}}$",
          "worked": "$$\\begin{aligned}y&=x^{-1/2}\\\\\\frac{dy}{dx}&=-\\frac12x^{-3/2}\\\\\\frac{dy}{dx}&=-\\frac{1}{2x\\sqrt{x}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q6c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{1}{x\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-\\dfrac{3}{2x^2\\sqrt{x}}$",
          "worked": "$$\\begin{aligned}y&=\\frac{1}{x\\times x^{1/2}}\\\\y&=x^{-3/2}\\\\\\frac{dy}{dx}&=-\\frac32x^{-5/2}\\\\\\frac{dy}{dx}&=-\\frac{3}{2x^2\\sqrt{x}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
