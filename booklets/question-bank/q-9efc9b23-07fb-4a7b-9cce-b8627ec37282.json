  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Write each expression as a single fraction.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac1{n!}+\\dfrac1{(n-1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n+1}{n!}$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\frac1{n!}+\\frac1{(n-1)!}\\\\&=\\frac1{n!}+\\frac n{n!}\\\\&=\\frac{1+n}{n!}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac1{n!}-\\dfrac1{(n+1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac n{(n+1)!}$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\frac1{n!}-\\frac1{(n+1)!}\\\\&=\\frac{n+1}{(n+1)!}-\\frac1{(n+1)!}\\\\&=\\frac n{(n+1)!}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac1{(n+1)!}-\\dfrac1{(n-1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1-n-n^2}{(n+1)!}$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\frac1{(n+1)!}-\\frac1{(n-1)!}\\\\&=\\frac1{(n+1)!}-\\frac{n(n+1)}{(n+1)!}\\\\&=\\frac{1-n(n+1)}{(n+1)!}\\\\&=\\frac{1-n-n^2}{(n+1)!}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
