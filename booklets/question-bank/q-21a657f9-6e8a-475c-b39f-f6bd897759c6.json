  "content": {
    "id": "p16-q16-response",
    "type": "question",
    "label": "16",
    "prompt": "There are three positive odd consecutive integers such that the product of the first and third is 15 less than 12 times the middle integer. Find the integers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9, 11, 13$.",
      "worked": "Let the integers be $x$, $x+2$ and $x+4$, where $x$ is positive and odd.\n$$\\begin{align*}\nx(x+4)&=12(x+2)-15\\\\\nx^2+4x&=12x+9\\\\\nx^2-8x-9&=0\\\\\n(x-9)(x+1)&=0\\\\\nx&=9\\text{ or }-1\n\\end{align*}$$\nSince $x>0$, reject $x=-1$. The integers are $9$, $11$ and $13$.\nCheck: $9\\times13=117$ and $12\\times11-15=117$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 65
  },
