  "content": {
    "id": "v2-f24b16-p6-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "The roots of $2x^2-5x+k=0$ are $\\alpha$ and $\\beta$. Given that $\\alpha^2+\\beta^2=\\dfrac{13}{4}$, find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=3$",
      "worked": "$$\\begin{align*}\\alpha+\\beta&=\\frac52,\\quad\\alpha\\beta=\\frac k2\\\\\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\\\frac{13}{4}&=\\frac{25}{4}-2\\left(\\frac k2\\right)\\\\\\frac{13}{4}&=\\frac{25}{4}-k\\\\k&=3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
