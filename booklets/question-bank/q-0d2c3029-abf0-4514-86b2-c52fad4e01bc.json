              {
                "type": "math",
                "latex": "\\begin{align*}b+b+b+\\left(\\frac35-b\\right)+\\frac{3b}{5}&=1\\\\\\frac{13b}{5}&=\\frac25\\\\b&=\\frac{2}{13}\\end{align*}",
