    "label": "23",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p40-q23-scenario",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "History and Geography are two subjects students may decide to study.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "For a group of 40 students:",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "7 students study neither History nor Geography",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "20 students study History",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "18 students study Geography",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the probability that the student studies both History and Geography.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p40-q23-diagram",
        "answer": {
          "short": "$\\dfrac{1}{8}$",
          "worked": "Let $H$ and $G$ denote studying History and Geography.\n$$\\begin{align*}|H\\cup G|&=40-7=33\\\\|H\\cap G|&=20+18-33=5\\\\P(H\\cap G)&=\\frac{5}{40}=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that the student studies Geography, what is the probability that the student does NOT study History?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p40-q23-diagram",
        "answer": {
          "short": "$\\dfrac{13}{18}$",
          "worked": "$$\\begin{align*}|\\bar H\\cap G|&=18-5=13\\\\P(\\bar H\\mid G)&=\\frac{P(\\bar H\\cap G)}{P(G)}\\\\P(\\bar H\\mid G)&=\\frac{13/40}{18/40}=\\frac{13}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "Two different students are chosen at random, one after the other. What is the probability that the first student studies History and the second student does NOT study History?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{39}$",
          "worked": "There are $40-20=20$ students who do not study History. After selecting a History student, all 20 remain among the 39 students left.\n$$\\begin{align*}P(H_1\\cap\\bar H_2)&=P(H_1)\\times P(\\bar H_2\\mid H_1)\\\\P(H_1\\cap\\bar H_2)&=\\frac{20}{40}\\times\\frac{20}{39}\\\\P(H_1\\cap\\bar H_2)&=\\frac{10}{39}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ],
