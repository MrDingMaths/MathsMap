  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A two-digit number is randomly created from the set of digits: $3$, $4$, $5$, $6$ and $7$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "If each digit is allowed to be used more than once, what is the probability that it will be:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "an even number greater than $50$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{6}{25}$",
              "worked": "There are $5\\times5=25$ equally likely two-digit numbers. The favourable numbers are $54$, $56$, $64$, $66$, $74$ and $76$.\n\n$$P(\\text{even and greater than }50)=\\frac{6}{25}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p24-q4-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "an odd number less than $60$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{9}{25}$",
              "worked": "There are $25$ equally likely two-digit numbers. The favourable numbers are $33$, $35$, $37$, $43$, $45$, $47$, $53$, $55$ and $57$.\n\n$$P(\\text{odd and less than }60)=\\frac{9}{25}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      },
      {
        "id": "p24-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "If each digit is allowed to be used only once, what is the probability that it will be:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "an even number greater than $50$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{4}$",
              "worked": "There are $5\\times4=20$ equally likely two-digit numbers with different digits. The favourable numbers are $54$, $56$, $64$, $74$ and $76$.\n\n$$\\begin{aligned}P(\\text{even and greater than }50)&=\\frac{5}{20}\\\\P(\\text{even and greater than }50)&=\\frac{1}{4}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p24-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "divisible by $11$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0$",
              "worked": "A two-digit multiple of $11$ has identical digits. Repetition is not allowed, so none of the $20$ possible numbers is favourable.\n\n$$P(\\text{divisible by }11)=\\frac{0}{20}=0.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
    ]
