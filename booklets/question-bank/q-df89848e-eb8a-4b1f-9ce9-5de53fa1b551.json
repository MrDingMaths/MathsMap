  "content": {
    "id": "p10-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Evaluate each expression for $x=2$ and $y=3$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x^2}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{x^2}{2}&=\\frac{2^2}{2}\\\\\\frac{x^2}{2}&=\\frac{4}{2}\\\\\\frac{x^2}{2}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x^2y}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\frac{x^2y}{2}&=\\frac{2^2\\times3}{2}\\\\\\frac{x^2y}{2}&=\\frac{12}{2}\\\\\\frac{x^2y}{2}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{5x^2y^2}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$$\\begin{align*}\\frac{5x^2y^2}{6}&=\\frac{5\\times2^2\\times3^2}{6}\\\\\\frac{5x^2y^2}{6}&=\\frac{5\\times4\\times9}{6}\\\\\\frac{5x^2y^2}{6}&=\\frac{180}{6}\\\\\\frac{5x^2y^2}{6}&=30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3x+y}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{3x+y}{3x}&=\\frac{3\\times2+3}{3\\times2}\\\\\\frac{3x+y}{3x}&=\\frac{9}{6}\\\\\\frac{3x+y}{3x}&=\\frac{3}{2}\\\\\\frac{3x+y}{3x}&=1\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{6}{xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{6}{xy}&=\\frac{6}{2\\times3}\\\\\\frac{6}{xy}&=\\frac{6}{6}\\\\\\frac{6}{xy}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{3x^2}{2y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{align*}\\frac{3x^2}{2y^2}&=\\frac{3\\times2^2}{2\\times3^2}\\\\\\frac{3x^2}{2y^2}&=\\frac{3\\times4}{2\\times9}\\\\\\frac{3x^2}{2y^2}&=\\frac{12}{18}\\\\\\frac{3x^2}{2y^2}&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
