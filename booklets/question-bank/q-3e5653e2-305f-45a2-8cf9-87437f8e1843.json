    "children": [
      {
        "id": "v2-fafc9-p54-practice-j14-104354-j14-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{\\sqrt{5}+\\sqrt{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{6}-\\sqrt{5}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{5}+\\sqrt{6}}&=\\frac{1}{\\sqrt{5}+\\sqrt{6}}\\times\\frac{\\sqrt{5}-\\sqrt{6}}{\\sqrt{5}-\\sqrt{6}}\\\\&=\\frac{\\sqrt{5}-\\sqrt{6}}{5-6}\\\\&=\\sqrt{6}-\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-fafc9-p54-practice-j14-104354-j14-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{\\sqrt{3}+\\sqrt{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{3}+\\sqrt{4}}&=\\frac{1}{\\sqrt{3}+\\sqrt{4}}\\times\\frac{\\sqrt{3}-\\sqrt{4}}{\\sqrt{3}-\\sqrt{4}}\\\\&=\\frac{\\sqrt{3}-2}{3-4}\\\\&=2-\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-fafc9-p54-practice-j14-104354-j14-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{\\sqrt{8}+\\sqrt{9}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-2\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{8}+\\sqrt{9}}&=\\frac{1}{\\sqrt{8}+\\sqrt{9}}\\times\\frac{\\sqrt{8}-\\sqrt{9}}{\\sqrt{8}-\\sqrt{9}}\\\\&=\\frac{2\\sqrt{2}-3}{8-9}\\\\&=3-2\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
