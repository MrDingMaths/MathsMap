  "content": {
    "id": "p33-q10-root",
    "type": "question",
    "label": null,
    "prompt": "Find the projection of $\\overrightarrow{AB}$ onto $-6\\mathbf{i}+4\\mathbf{j}$ given $A(-3,-7)$ and $B(1,5)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\dfrac{36}{13}\\mathbf{i}+\\dfrac{24}{13}\\mathbf{j}$",
      "worked": "$$\\begin{aligned}\\overrightarrow{AB}&=(1-(-3),\\,5-(-7))=(4,12)\\\\\\underset{\\sim}{b}&=-6\\mathbf{i}+4\\mathbf{j}\\\\\\overrightarrow{AB}\\cdot\\underset{\\sim}{b}&=4(-6)+12(4)=-24+48=24\\\\|\\underset{\\sim}{b}|^2&=36+16=52\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\overrightarrow{AB}&=\\frac{24}{52}(-6\\mathbf{i}+4\\mathbf{j})\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\overrightarrow{AB}&=\\frac{6}{13}(-6\\mathbf{i}+4\\mathbf{j})\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\overrightarrow{AB}&=-\\frac{36}{13}\\mathbf{i}+\\frac{24}{13}\\mathbf{j}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
