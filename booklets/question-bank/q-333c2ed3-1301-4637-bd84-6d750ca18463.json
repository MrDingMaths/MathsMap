    "label": "9",
    "prompt": "Find the number that when divided by $\\frac34$ gives $\\frac89$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac23$",
      "worked": "Multiply the quotient by the divisor to find the original number.\n$$\\begin{align*}x&=\\frac89\\times\\frac34\\\\x&=\\frac{2\\times1}{3\\times1}\\\\x&=\\frac23\\end{align*}$$",
      "solutionDiagrams": []
    },
