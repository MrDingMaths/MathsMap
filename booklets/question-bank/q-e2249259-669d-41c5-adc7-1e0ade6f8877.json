    "children": [
      {
        "id": "p5-q2a",
        "type": "part",
        "label": "a",
        "prompt": "The 3rd term of an arithmetic sequence is 11 and the 7th term is 27. Find the 11th term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$43$",
          "worked": "$$\\begin{align*}4d &= a_7-a_3\\\\4d &= 27-11=16\\\\d &= 4\\\\a_{11} &= a_7+4d\\\\a_{11} &= 27+4(4)=43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p5-q2b",
        "type": "part",
        "label": "b",
        "prompt": "The 2nd term of an arithmetic sequence is 17 and the 10th term is 65. Find the 6th term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$41$",
          "worked": "$$\\begin{align*}8d &= a_{10}-a_2\\\\8d &= 65-17=48\\\\d &= 6\\\\a_6 &= a_2+4d\\\\a_6 &= 17+4(6)=41\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p5-q2c",
        "type": "part",
        "label": "c",
        "prompt": "The 4th term of an arithmetic sequence is 3 and the 7th term is 4. Find the 16th term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}3d &= a_7-a_4\\\\3d &= 4-3=1\\\\d &= \\frac{1}{3}\\\\a_{16} &= a_7+9d\\\\a_{16} &= 4+9\\left(\\frac{1}{3}\\right)=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p5-q2d",
        "type": "part",
        "label": "d",
        "prompt": "The 6th term of an arithmetic sequence is $-13$ and the 10th term is $-33$. Find the 1st term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}4d &= a_{10}-a_6\\\\4d &= -33-(-13)=-20\\\\d &= -5\\\\a_1 &= a_6-5d\\\\a_1 &= -13-5(-5)=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
