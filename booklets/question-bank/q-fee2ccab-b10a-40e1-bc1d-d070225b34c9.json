    "children": [
      {
        "id": "p39-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{45}+\\sqrt{80}-\\sqrt{72}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\sqrt{5}-6\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sqrt{45}+\\sqrt{80}-\\sqrt{72}&=\\sqrt{9}\\sqrt{5}+\\sqrt{16}\\sqrt{5}-\\sqrt{36}\\sqrt{2}\\\\&=3\\sqrt{5}+4\\sqrt{5}-6\\sqrt{2}\\\\&=7\\sqrt{5}-6\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p39-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$3\\sqrt{24}+6\\sqrt{150}-5\\sqrt{54}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21\\sqrt{6}$",
          "worked": "$$\\begin{align*}3\\sqrt{24}+6\\sqrt{150}-5\\sqrt{54}&=3\\sqrt{4}\\sqrt{6}+6\\sqrt{25}\\sqrt{6}-5\\sqrt{9}\\sqrt{6}\\\\&=6\\sqrt{6}+30\\sqrt{6}-15\\sqrt{6}\\\\&=21\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{4+\\sqrt{12}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{4+\\sqrt{12}}{2}&=\\frac{4+2\\sqrt{3}}{2}\\\\&=\\frac{4}{2}+\\frac{2\\sqrt{3}}{2}\\\\&=2+\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2\\sqrt{6}\\times3\\sqrt{7}}{12\\sqrt{21}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{2}}{2}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{6}\\times3\\sqrt{7}}{12\\sqrt{21}}&=\\frac{6\\sqrt{42}}{12\\sqrt{21}}\\\\&=\\frac{6}{12}\\sqrt{\\frac{42}{21}}\\\\&=\\frac{\\sqrt{2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
