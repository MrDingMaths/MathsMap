  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The perimeter of a semicircle is $3\\text{ m}$. Find the radius of the semicircle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{2+\\pi}\\text{ m}$",
      "worked": "$$\\begin{align*}\\pi r+2r&=3\\\\(\\pi+2)r&=3\\\\r&=\\frac{3}{2+\\pi}\\text{ m}\\end{align*}$$",
