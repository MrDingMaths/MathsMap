  "content": {
    "id": "v2-d025a-p23-practice-j10-094516-root",
    "type": "question",
    "label": null,
    "prompt": "A Ballarat factory has 4 identical machines packing boxes of apples.\nEach machine packs 90 boxes every 3 hours.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d025a-p23-practice-j10-094516-j10-machines-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the combined rate of the 4 machines, in boxes per hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120\\text{ boxes/hour}$",
          "worked": "$$\\begin{align*}\\text{Rate of one machine}&=\\frac{90}{3}=30\\text{ boxes/hour}\\\\\\text{Combined rate}&=4\\times30\\\\\\text{Combined rate}&=120\\text{ boxes/hour}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-d025a-p23-practice-j10-094516-j10-machines-b",
        "type": "part",
        "label": "b",
        "prompt": "How long will the 4 machines take to pack 840 boxes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\text{ hours}$",
          "worked": "$$\\begin{align*}\\text{Time}&=\\frac{840\\text{ boxes}}{120\\text{ boxes/hour}}\\\\\\text{Time}&=7\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
