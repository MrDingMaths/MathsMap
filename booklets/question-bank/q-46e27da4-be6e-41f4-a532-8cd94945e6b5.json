  },
  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify each of the following, expressing your answers using positive indices:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(m^2)^3\\times(m^{-2})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^2$",
          "worked": "$$\\begin{align*}(m^2)^3\\times(m^{-2})^2&=m^6\\times m^{-4}\\\\(m^2)^3\\times(m^{-2})^2&=m^{6-4}\\\\(m^2)^3\\times(m^{-2})^2&=m^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2p^2)^3\\times p^{-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}(2p^2)^3\\times p^{-6}&=8p^6\\times p^{-6}\\\\(2p^2)^3\\times p^{-6}&=8p^0\\\\(2p^2)^3\\times p^{-6}&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(a^2b)^{-2}\\times ab^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b^4}{a^3}$",
          "worked": "$$\\begin{align*}(a^2b)^{-2}\\times ab^6&=a^{-4}b^{-2}\\times ab^6\\\\(a^2b)^{-2}\\times ab^6&=a^{-3}b^4\\\\(a^2b)^{-2}\\times ab^6&=\\frac{b^4}{a^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(n^{-3})^3\\times(n^2)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{n^{13}}$",
          "worked": "$$\\begin{align*}(n^{-3})^3\\times(n^2)^{-2}&=n^{-9}\\times n^{-4}\\\\(n^{-3})^3\\times(n^2)^{-2}&=n^{-13}\\\\(n^{-3})^3\\times(n^2)^{-2}&=\\frac{1}{n^{13}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(a^3)^2\\div(a^{-3})^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}(a^3)^2\\div(a^{-3})^{-2}&=a^6\\div a^6\\\\(a^3)^2\\div(a^{-3})^{-2}&=a^0\\\\(a^3)^2\\div(a^{-3})^{-2}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(2x^2)^{-2}\\times(2x^{-3})^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{16}$",
          "worked": "$$\\begin{align*}(2x^2)^{-2}\\times(2x^{-3})^{-2}&=2^{-2}x^{-4}\\times2^{-2}x^6\\\\(2x^2)^{-2}\\times(2x^{-3})^{-2}&=2^{-4}x^2\\\\(2x^2)^{-2}\\times(2x^{-3})^{-2}&=\\frac{x^2}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$2x^2y^{-3}\\times(2x^{-2}y^3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8y^3}{x^2}$",
          "worked": "$$\\begin{align*}2x^2y^{-3}\\times(2x^{-2}y^3)^2&=2x^2y^{-3}\\times4x^{-4}y^6\\\\2x^2y^{-3}\\times(2x^{-2}y^3)^2&=8x^{-2}y^3\\\\2x^2y^{-3}\\times(2x^{-2}y^3)^2&=\\frac{8y^3}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x^2}{y}\\div x^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x^3y}$",
          "worked": "$$\\begin{align*}\\frac{x^2}{y}\\div x^5&=\\frac{x^2}{y}\\times\\frac{1}{x^5}\\\\\\frac{x^2}{y}\\div x^5&=\\frac{x^{2-5}}{y}\\\\\\frac{x^2}{y}\\div x^5&=\\frac{1}{x^3y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p6-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$(x^{-3}y)^3\\div\\dfrac{x^{-2}}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y^4}{x^7}$",
          "worked": "$$\\begin{align*}(x^{-3}y)^3\\div\\frac{x^{-2}}{y}&=x^{-9}y^3\\times\\frac{y}{x^{-2}}\\\\(x^{-3}y)^3\\div\\frac{x^{-2}}{y}&=x^{-7}y^4\\\\(x^{-3}y)^3\\div\\frac{x^{-2}}{y}&=\\frac{y^4}{x^7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{x^2}{y^{-1}}\\div\\dfrac{x^3}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y^2}{x}$",
          "worked": "$$\\begin{align*}\\frac{x^2}{y^{-1}}\\div\\frac{x^3}{y}&=\\frac{x^2}{y^{-1}}\\times\\frac{y}{x^3}\\\\\\frac{x^2}{y^{-1}}\\div\\frac{x^3}{y}&=x^{-1}y^{1-(-1)}\\\\\\frac{x^2}{y^{-1}}\\div\\frac{x^3}{y}&=\\frac{y^2}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{(3x^{-3})^2}{9x^7}\\times(3x^{-2})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27}{x^{19}}$\n\nExpand the powers, then combine the indices of $x$.",
          "worked": "$$\\begin{align*}\\frac{(3x^{-3})^2}{9x^7}\\times(3x^{-2})^3&=\\frac{9x^{-6}}{9x^7}\\times27x^{-6}\\\\\\frac{(3x^{-3})^2}{9x^7}\\times(3x^{-2})^3&=27x^{-13}x^{-6}\\\\\\frac{(3x^{-3})^2}{9x^7}\\times(3x^{-2})^3&=27x^{-19}\\\\\\frac{(3x^{-3})^2}{9x^7}\\times(3x^{-2})^3&=\\frac{27}{x^{19}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p6-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{(2x^{-2})^3}{3y^{-2}}\\div\\dfrac{2x^{-2}}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4y^3}{3x^4}$\n\nMultiply by the reciprocal of the second fraction, then combine indices.",
          "worked": "$$\\begin{align*}\\frac{(2x^{-2})^3}{3y^{-2}}\\div\\frac{2x^{-2}}{y}&=\\frac{8x^{-6}}{3y^{-2}}\\times\\frac{y}{2x^{-2}}\\\\\\frac{(2x^{-2})^3}{3y^{-2}}\\div\\frac{2x^{-2}}{y}&=\\frac{4}{3}x^{-6-(-2)}y^{1-(-2)}\\\\\\frac{(2x^{-2})^3}{3y^{-2}}\\div\\frac{2x^{-2}}{y}&=\\frac{4}{3}x^{-4}y^3\\\\\\frac{(2x^{-2})^3}{3y^{-2}}\\div\\frac{2x^{-2}}{y}&=\\frac{4y^3}{3x^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
