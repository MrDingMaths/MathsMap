      "taskHash": "43a5a7354c10d0e7e3742a9bb4071b3caa94dd2c8a6ab31595f6bf3a6423f7f1",
      "evidence": ".booklet-work/full-imports/enrichment-maths-1-part9-20261008/semantic-packets/assignments/assignment-d6963c0f22f66ef8db86/1/generation.json"
