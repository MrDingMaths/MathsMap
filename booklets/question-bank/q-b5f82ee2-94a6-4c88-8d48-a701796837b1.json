  "content": {
    "id": "p23-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The graph of $y=x^3$ undergoes each of the given pairs of transformations. In each case, find the equation of the resulting cubic.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "A reflection in the $x$-axis followed by a translation of 1 unit to the right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-1)^3$",
          "worked": "Reflection in the $x$-axis gives $y=-x^3$. Translation 1 unit right replaces $x$ by $x-1$:\n$$y=-(x-1)^3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "A translation of 2 units to the left followed by a reflection in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x+2)^3$",
          "worked": "Translation 2 units left gives $y=(x+2)^3$. Reflection in the $x$-axis negates the output:\n$$y=-(x+2)^3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "A dilation by a factor of 2 from the $x$-axis followed by a reflection in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x^3$",
          "worked": "Dilation by a factor of 2 from the $x$-axis gives $y=2x^3$. Reflection in the $x$-axis negates the output:\n$$y=-2x^3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "A dilation by a factor of $\\frac13$ from the $x$-axis followed by a translation by 3 units down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac13x^3-3$",
          "worked": "Dilation by a factor of $\\frac13$ from the $x$-axis gives $y=\\frac13x^3$. Translation 3 units down subtracts 3 from the output:\n$$y=\\frac13x^3-3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p23-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "A dilation by a factor of 4 from the $x$-axis followed by a translation of 3 units to the left.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4(x+3)^3$",
          "worked": "Dilation by a factor of 4 from the $x$-axis gives $y=4x^3$. Translation 3 units left replaces $x$ by $x+3$:\n$$y=4(x+3)^3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
