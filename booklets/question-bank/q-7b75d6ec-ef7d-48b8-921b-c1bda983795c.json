        "prompt": "$\\sqrt{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x+1)^{3/2}}{3}+c$",
          "worked": "$$\\begin{align*}f'(x)&=(x+1)^{1/2}\\\\f(x)&=\\frac{(x+1)^{3/2}}{1\\left(\\frac32\\right)}+c\\\\&=\\frac{2(x+1)^{3/2}}{3}+c\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x-5)^{3/2}}{3}+c$",
          "worked": "$$\\begin{align*}f'(x)&=(x-5)^{1/2}\\\\f(x)&=\\frac{(x-5)^{3/2}}{1\\left(\\frac32\\right)}+c\\\\&=\\frac{2(x-5)^{3/2}}{3}+c\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{1-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2(1-x)^{3/2}}{3}+c$",
          "worked": "$$\\begin{align*}f'(x)&=(1-x)^{1/2}\\\\f(x)&=\\frac{(1-x)^{3/2}}{-1\\left(\\frac32\\right)}+c\\\\&=-\\frac{2(1-x)^{3/2}}{3}+c\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p11-q2-d",
