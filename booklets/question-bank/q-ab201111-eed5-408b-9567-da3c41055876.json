        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}32^{-3/5}&=\\frac{1}{32^{3/5}}\\\\32^{-3/5}&=\\frac{1}{(\\sqrt[5]{32})^3}\\\\32^{-3/5}&=\\frac{1}{2^3}\\\\32^{-3/5}&=\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
