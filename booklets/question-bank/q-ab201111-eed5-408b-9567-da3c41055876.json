        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$25^{-1/2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$$\\begin{align*}25^{-1/2}&=\\frac{1}{25^{1/2}}\\\\25^{-1/2}&=\\frac{1}{\\sqrt{25}}\\\\25^{-1/2}&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$64^{-1/2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}64^{-1/2}&=\\frac{1}{64^{1/2}}\\\\64^{-1/2}&=\\frac{1}{\\sqrt{64}}\\\\64^{-1/2}&=\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q3-c",
        "type": "part",
