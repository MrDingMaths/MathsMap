        "prompt": "$8^{-1/3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}8^{-1/3}&=\\frac{1}{8^{1/3}}\\\\8^{-1/3}&=\\frac{1}{\\sqrt[3]{8}}\\\\8^{-1/3}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$16^{-1/4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}16^{-1/4}&=\\frac{1}{16^{1/4}}\\\\16^{-1/4}&=\\frac{1}{\\sqrt[4]{16}}\\\\16^{-1/4}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$27^{-2/3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "$$\\begin{align*}27^{-2/3}&=\\frac{1}{27^{2/3}}\\\\27^{-2/3}&=\\frac{1}{(\\sqrt[3]{27})^2}\\\\27^{-2/3}&=\\frac{1}{3^2}\\\\27^{-2/3}&=\\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$16^{-3/4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}16^{-3/4}&=\\frac{1}{16^{3/4}}\\\\16^{-3/4}&=\\frac{1}{(\\sqrt[4]{16})^3}\\\\16^{-3/4}&=\\frac{1}{2^3}\\\\16^{-3/4}&=\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$1000^{-2/3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{100}$",
          "worked": "$$\\begin{align*}1000^{-2/3}&=\\frac{1}{1000^{2/3}}\\\\1000^{-2/3}&=\\frac{1}{(\\sqrt[3]{1000})^2}\\\\1000^{-2/3}&=\\frac{1}{10^2}\\\\1000^{-2/3}&=\\frac{1}{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p12-q3-h",
        "type": "part",
        "label": "h",
