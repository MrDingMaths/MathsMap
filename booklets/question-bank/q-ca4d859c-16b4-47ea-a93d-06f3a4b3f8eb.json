        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.54$",
          "worked": "The train can be taken on a rainy day or a dry day. These cases are mutually exclusive.\n$$\\begin{align*}P(A\\cap B)&=0.4\\times0.9=0.36\\\\P(A\\cap\\overline B)&=0.6\\times0.3=0.18\\\\P(A)&=P(A\\cap B)+P(A\\cap\\overline B)\\\\P(A)&=0.36+0.18\\\\P(A)&=0.54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p32-q14-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
