    "id": "v2-68501-p12-practice-retro-slot-4-222415-root",
    "type": "question",
    "label": null,
    "prompt": "An integer is greater than $-7$ and less than $3$.\n\nList all the possible integers in ascending order.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-6,\\,-5,\\,-4,\\,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2$",
      "worked": "Exclude $-7$ and $3$ because the bounds are strict. Reading the integers between them from left to right on a number line, including $0$, gives $-6,\\,-5,\\,-4,\\,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2$.",
