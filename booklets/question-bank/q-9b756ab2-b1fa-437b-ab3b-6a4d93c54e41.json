  "content": {
    "id": "p32-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A normal distribution has a mean of 95. If 2.5% of the scores are below 73, find the standard deviation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$11$",
      "worked": "By the empirical rule, 2.5% of scores lie below two standard deviations below the mean. Thus 73 represents a $z$-score of $-2$.\n\nThe difference between the mean, 95, and the score, 73, is $95-73=22$.\n\nThis represents two standard deviations, so\n$$\\begin{aligned}2\\sigma&=22\\\\\\sigma&=11.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 23
