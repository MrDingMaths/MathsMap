  "content": {
    "id": "v2-725bd-p30-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Solve for $k$ in each vector equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-725bd-p30-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "For $\\underset{\\sim}{a}=3i+j$ and $\\underset{\\sim}{b}=2i-j$, if $\\underset{\\sim}{a}+k\\underset{\\sim}{b}=7i-j$, find $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=2$",
          "worked": "$$\\begin{aligned}(3i+j)+k(2i-j)&=7i-j\\\\(3+2k)i+(1-k)j&=7i-j\\end{aligned}$$\nEquate $i$-components:\n$$\\begin{aligned}3+2k&=7\\\\k&=2\\end{aligned}$$\nEquate $j$-components:\n$$\\begin{aligned}1-k&=-1\\\\k&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-725bd-p30-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "For $\\underset{\\sim}{a}=5i-2j$ and $\\underset{\\sim}{b}=-i+4j$, if $\\underset{\\sim}{a}-k\\underset{\\sim}{b}=8i-14j$, find $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=3$",
          "worked": "$$\\begin{aligned}(5i-2j)-k(-i+4j)&=8i-14j\\\\(5+k)i+(-2-4k)j&=8i-14j\\end{aligned}$$\nEquate $i$-components:\n$$\\begin{aligned}5+k&=8\\\\k&=3\\end{aligned}$$\nEquate $j$-components:\n$$\\begin{aligned}-2-4k&=-14\\\\k&=3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
