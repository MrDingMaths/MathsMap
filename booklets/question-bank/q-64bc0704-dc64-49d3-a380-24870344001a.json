    "children": [
      {
        "id": "p64-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $\\overrightarrow{AC}$ in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\underset{\\sim}{a}-2\\underset{\\sim}{b}$",
          "worked": "By the triangle law,\n$$\\begin{aligned}\\overrightarrow{AC}&=\\overrightarrow{AB}+\\overrightarrow{BC}\\\\&=(2\\underset{\\sim}{a}+\\underset{\\sim}{b})+(2\\underset{\\sim}{a}-3\\underset{\\sim}{b})\\\\&=4\\underset{\\sim}{a}-2\\underset{\\sim}{b}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p64-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\overrightarrow{AC}$ is parallel to $2\\underset{\\sim}{a}-\\underset{\\sim}{b}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AC}=2(2\\underset{\\sim}{a}-\\underset{\\sim}{b})$, so the vectors are parallel.",
          "worked": "$$\\begin{aligned}\\overrightarrow{AC}&=4\\underset{\\sim}{a}-2\\underset{\\sim}{b}\\\\&=2(2\\underset{\\sim}{a}-\\underset{\\sim}{b}).\\end{aligned}$$\nTherefore $\\overrightarrow{AC}$ is parallel to $2\\underset{\\sim}{a}-\\underset{\\sim}{b}$ because it is a scalar multiple.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ],
