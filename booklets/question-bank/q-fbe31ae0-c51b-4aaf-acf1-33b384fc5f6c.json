        "label": "a",
        "prompt": "A combination is a selection of distinct objects without order.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. A combination is an unordered selection of distinct objects.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p18-q1-3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\binom{3}{0}=0$ because the number of ways to select nothing from 3 distinct objects is zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. There is exactly one selection containing no objects: the empty set. Therefore $\\binom{3}{0}=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p18-q1-3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\binom{3}{1}=3$ because there are 3 ways to select one object from 3 distinct objects.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Each of the 3 objects gives a different one-object selection, so $\\binom{3}{1}=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
