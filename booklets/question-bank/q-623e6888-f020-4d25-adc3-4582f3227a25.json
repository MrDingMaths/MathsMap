    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the volume after 2 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3988\\text{ L}$",
          "worked": "Time in seconds: $2\\times60=120$.\n$$\\begin{align*}V &= 4000 - 0.1t\\\\V &= 4000 - 0.1(120)\\\\V &= 3988\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "How long, to the nearest minute, does it take to empty the tank?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$667\\text{ minutes}$",
          "worked": "The tank is empty when $V=0$.\n$$\\begin{align*}V &= 4000 - 0.1t\\\\0 &= 4000 - 0.1t\\\\0.1t &= 4000\\\\t &= 40000\\text{ seconds}\\end{align*}$$\nTime in minutes:\n$$\\frac{40000}{60}=\\frac{2000}{3}\\approx667\\text{ minutes}$$\nThe tank empties after 667 minutes, to the nearest minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
