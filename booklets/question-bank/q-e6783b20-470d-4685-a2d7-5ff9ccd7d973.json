  "content": {
    "id": "p8-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Expand the following perfect squares.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(x+\\frac{1}{3}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+\\frac{2x}{3}+\\frac{1}{9}$",
          "worked": "$a=x$, $b=\\frac{1}{3}$.\n$$\\begin{align*}\\left(x+\\frac{1}{3}\\right)^2&=x^2+2(x)\\left(\\frac{1}{3}\\right)+\\left(\\frac{1}{3}\\right)^2\\\\&=x^2+\\frac{2x}{3}+\\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(x-\\frac{2}{5}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-\\frac{4x}{5}+\\frac{4}{25}$",
          "worked": "$a=x$, $b=-\\frac{2}{5}$.\n$$\\begin{align*}\\left(x-\\frac{2}{5}\\right)^2&=x^2+2(x)\\left(-\\frac{2}{5}\\right)+\\left(-\\frac{2}{5}\\right)^2\\\\&=x^2-\\frac{4x}{5}+\\frac{4}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(3x+\\frac{5}{7}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2+\\frac{30x}{7}+\\frac{25}{49}$",
          "worked": "$a=3x$, $b=\\frac{5}{7}$.\n$$\\begin{align*}\\left(3x+\\frac{5}{7}\\right)^2&=(3x)^2+2(3x)\\left(\\frac{5}{7}\\right)+\\left(\\frac{5}{7}\\right)^2\\\\&=9x^2+\\frac{30x}{7}+\\frac{25}{49}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(3x+\\frac{2}{5}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2+\\frac{12x}{5}+\\frac{4}{25}$",
          "worked": "$a=3x$, $b=\\frac{2}{5}$.\n$$\\begin{align*}\\left(3x+\\frac{2}{5}\\right)^2&=(3x)^2+2(3x)\\left(\\frac{2}{5}\\right)+\\left(\\frac{2}{5}\\right)^2\\\\&=9x^2+\\frac{12x}{5}+\\frac{4}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\frac{x}{5}-\\frac{3}{8}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{25}-\\frac{3x}{20}+\\frac{9}{64}$",
          "worked": "$a=\\frac{x}{5}$, $b=-\\frac{3}{8}$.\n$$\\begin{align*}\\left(\\frac{x}{5}-\\frac{3}{8}\\right)^2&=\\left(\\frac{x}{5}\\right)^2+2\\left(\\frac{x}{5}\\right)\\left(-\\frac{3}{8}\\right)+\\left(-\\frac{3}{8}\\right)^2\\\\&=\\frac{x^2}{25}-\\frac{6x}{40}+\\frac{9}{64}\\\\&=\\frac{x^2}{25}-\\frac{3x}{20}+\\frac{9}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p8-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{2x}{3}+\\frac{9y}{8}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x^2}{9}+\\frac{3xy}{2}+\\frac{81y^2}{64}$",
          "worked": "$a=\\frac{2x}{3}$, $b=\\frac{9y}{8}$.\n$$\\begin{align*}\\left(\\frac{2x}{3}+\\frac{9y}{8}\\right)^2&=\\left(\\frac{2x}{3}\\right)^2+2\\left(\\frac{2x}{3}\\right)\\left(\\frac{9y}{8}\\right)+\\left(\\frac{9y}{8}\\right)^2\\\\&=\\frac{4x^2}{9}+\\frac{36xy}{24}+\\frac{81y^2}{64}\\\\&=\\frac{4x^2}{9}+\\frac{3xy}{2}+\\frac{81y^2}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
