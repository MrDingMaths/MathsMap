              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"exponential curve\"},{\"name\":\"tangentRed\",\"hex\":\"EF6068\",\"reason\":\"tangent lines\"}],\"reference\":\"source page 15 question 4b completed graph\"}\n\\begin{tikzpicture}[x=2.6cm,y=2.6cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\definecolor{tangentRed}{HTML}{EF6068}\n\\definecolor{gridGrey}{HTML}{CCCCCC}\n\\path[use as bounding box] (-3.22,-0.5) rectangle (2.3,3.55);\n\\draw[gridGrey,line width=0.15pt,step=0.1] (-3,-0.3) grid (2,3.3);\n\\draw[gridGrey,line width=0.25pt,step=1] (-3,-0.3) grid (2,3.3);\n\\draw[black,line width=0.5pt,<->] (-3.15,0)--(2.15,0) node[right] {$x$};\n\\draw[black,line width=0.5pt,<->] (0,-0.43)--(0,3.45) node[above] {$y$};\n\\foreach \\x in {-3,-2.9,...,2} {\\draw[black,line width=0.4pt] (\\x,-0.025)--(\\x,0.025);}\n\\foreach \\y in {-0.3,-0.2,...,3.3} {\\draw[black,line width=0.4pt] (-0.025,\\y)--(0.025,\\y);}\n\\foreach \\x in {-3,-2,-1,1,2} {\\node[below,yshift=-3pt] at (\\x,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\x$\\special{dvisvgm:raw </g>}};}\n\\foreach \\y in {1,2,3} {\\node[left,xshift=-3pt] at (0,\\y) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\y$\\special{dvisvgm:raw </g>}};}\n\\draw[curveBlue,line width=0.8pt,<->,domain=-3.14:1.23,samples=120] plot (\\x,{exp(\\x)});\n\\draw[tangentRed,line width=0.8pt,<->] (-1.43,-0.43)--(2.15,3.15);\n\\begin{scope}\n\\clip (-3,-0.3) rectangle (2,3.3);\n\\foreach \\v in {0.5,2,3} {\\draw[tangentRed,line width=0.8pt,dashed,domain=-3:2,samples=2] plot (\\x,{\\v*(\\x-ln(\\v)+1)});\\fill[tangentRed] ({ln(\\v)},\\v) circle (0.025);}\n\\end{scope}\n\\end{tikzpicture}",
