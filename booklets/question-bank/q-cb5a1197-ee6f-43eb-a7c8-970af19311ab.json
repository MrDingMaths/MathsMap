          "inlines": [
            {
              "type": "text",
              "text": "A bag contains marbles. When one marble is chosen at random from the bag, the probability that it is red is ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{7}{19}",
              "display": false
            },
            {
              "type": "text",
              "text": " and the probability that it is blue is ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{4}{19}",
              "display": false
            },
            {
              "type": "text",
              "text": ". ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "What is the probability that it is neither red nor blue?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{8}{19}$",
      "worked": "$$\\begin{align*}P(\\text{neither red nor blue})&=1-\\bigl(P(\\text{red})+P(\\text{blue})\\bigr)\\\\P(\\text{neither red nor blue})&=1-\\left(\\frac{7}{19}+\\frac{4}{19}\\right)\\\\P(\\text{neither red nor blue})&=1-\\frac{11}{19}\\\\P(\\text{neither red nor blue})&=\\frac{8}{19}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
