  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A dripping tap fills a 9-litre bucket in 3 hours. How long would it take to fill a 21-litre bucket?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7\\text{ h}$",
      "worked": "Let $x$ be the time in hours. Set up equivalent rates and take the reciprocal of both sides.\n$$\\begin{align*}\\frac{9}{3}&=\\frac{21}{x}\\\\\\frac{3}{9}&=\\frac{x}{21}\\\\x&=\\frac{3\\times21}{9}\\\\x&=7\\end{align*}$$\nThe bucket takes $7\\text{ h}$ to fill.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
