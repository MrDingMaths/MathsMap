  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Express each of the following sets using set-builder notation:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\{2,4,8,16,32,64,\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{2^n:n\\in\\mathbb N\\}$",
          "worked": "The elements are $2^1,2^2,2^3,\\ldots$, so the set is $\\{2^n:n\\in\\mathbb N\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\{\\ldots,-6,-3,0,3,6,9,12,15,\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{3n:n\\in\\mathbb Z\\}$",
          "worked": "The elements are all integer multiples of $3$, so the set is $\\{3n:n\\in\\mathbb Z\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\{\\ldots,-8,-3,2,7,12,17,\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{5n+2:n\\in\\mathbb Z\\}$",
          "worked": "Successive elements differ by $5$, and $2$ occurs when $n=0$. Taking every integer $n$ in $5n+2$ gives the set $\\{5n+2:n\\in\\mathbb Z\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\{1,4,9,16,25,36,\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{n^2:n\\in\\mathbb N\\}$",
          "worked": "The elements are $1^2,2^2,3^2,\\ldots$, so the set is $\\{n^2:n\\in\\mathbb N\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\{3,6,11,18,27,38,\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{n^2+2:n\\in\\mathbb N\\}$",
          "worked": "Subtracting $2$ from the listed elements gives $1,4,9,16,25,36,\\ldots$, the squares of natural numbers. Thus the set is $\\{n^2+2:n\\in\\mathbb N\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\{4,16,36,64,100,\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(2n)^2:n\\in\\mathbb N\\}$",
          "worked": "The elements are $2^2,4^2,6^2,8^2,10^2,\\ldots$, so the set is $\\{(2n)^2:n\\in\\mathbb N\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\{3,4,5,6,7,8\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{n\\in\\mathbb N:3\\le n\\le8\\}$",
          "worked": "The elements are the natural numbers from $3$ to $8$, inclusive: $\\{n\\in\\mathbb N:3\\le n\\le8\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\{-4,-3,-2,-1,0,1,2\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{n\\in\\mathbb Z:-4\\le n\\le2\\}$",
          "worked": "The elements are the integers from $-4$ to $2$, inclusive: $\\{n\\in\\mathbb Z:-4\\le n\\le2\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\{\\ldots,\\tfrac18,\\tfrac14,\\tfrac12,1,2,4,8,\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{2^n:n\\in\\mathbb Z\\}$",
          "worked": "The elements include $2^{-3},2^{-2},2^{-1},2^0,2^1,2^2,2^3,\\ldots$. All integer powers occur, so the set is $\\{2^n:n\\in\\mathbb Z\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\{\\ldots,-\\tfrac{3\\pi}{2},-\\pi,-\\tfrac\\pi2,0,\\tfrac\\pi2,\\pi,\\tfrac{3\\pi}{2},\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{\\tfrac{n\\pi}{2}:n\\in\\mathbb Z\\}$",
          "worked": "The elements are all integer multiples of $\\frac\\pi2$, so the set is $\\{\\frac{n\\pi}{2}:n\\in\\mathbb Z\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\{\\ldots,-3\\pi,-\\pi,\\pi,3\\pi,\\ldots\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{(2n+1)\\pi:n\\in\\mathbb Z\\}$",
          "worked": "The coefficients of $\\pi$ are all odd integers. These have the form $2n+1$ for $n\\in\\mathbb Z$, so the set is $\\{(2n+1)\\pi:n\\in\\mathbb Z\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
