  "content": {
    "id": "p38-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the distance in km travelled by a car with these average speed and time.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$3\\text{ h }30\\text{ min}$ at $64\\text{ km/h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$224\\text{ km}$",
          "worked": "$$\\begin{align*}t&=3+\\frac{30}{60}\\\\t&=3.5\\text{ h}\\\\d&=st\\\\d&=64\\times3.5\\\\d&=224\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p38-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$3\\text{ h }20\\text{ min}$ at $56\\text{ km/h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$186.\\overline{6}\\text{ km}$",
          "worked": "$$\\begin{align*}t&=3+\\frac{20}{60}\\\\t&=\\frac{10}{3}\\text{ h}\\\\d&=st\\\\d&=56\\times\\frac{10}{3}\\\\d&=\\frac{560}{3}\\text{ km}\\\\d&=186.\\overline{6}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p38-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$5\\text{ h }47\\text{ min}$ at $82\\text{ km/h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$474.2\\overline{3}\\text{ km}$",
          "worked": "$$\\begin{align*}t&=5+\\frac{47}{60}\\\\t&=\\frac{347}{60}\\text{ h}\\\\d&=st\\\\d&=82\\times\\frac{347}{60}\\\\d&=\\frac{14227}{30}\\text{ km}\\\\d&=474.2\\overline{3}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p38-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\text{ h }13\\text{ min}$ at $75\\text{ km/h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$166.25\\text{ km}$",
          "worked": "$$\\begin{align*}t&=2+\\frac{13}{60}\\\\t&=\\frac{133}{60}\\text{ h}\\\\d&=st\\\\d&=75\\times\\frac{133}{60}\\\\d&=166.25\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p38-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\frac{3}{4}$ hours at $56\\text{ km/h}$",
