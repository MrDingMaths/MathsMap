        "answer": {
          "short": "$154\\text{ km}$",
          "worked": "$$\\begin{align*}t&=2\\frac{3}{4}=2.75\\text{ h}\\\\d&=st\\\\d&=56\\times2.75\\\\d&=154\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
