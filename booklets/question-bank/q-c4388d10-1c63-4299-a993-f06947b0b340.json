        "code": "\\begin{tikzpicture}[x=9mm,y=9mm,line width=0.8pt,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\coordinate (A) at (0,0);\\coordinate (B) at (5,0);\\coordinate (C) at (3,1.5);\\coordinate (D) at (0,1.5);\n\\coordinate (Bv) at (6.2,0.8);\\coordinate (Cv) at (4.2,2.3);\\coordinate (Dv) at (1.2,2.3);\n\\draw[fill=white] (D)--(C)--(Cv)--(Dv)--cycle;\n\\draw[fill=white] (C)--(B)--(Bv)--(Cv)--cycle;\n\\draw[fill=white] (A)--(B)--(C)--(D)--cycle;\n\\draw[dashed,line width=0.4pt] (3,0)--(C);\n\\draw[line width=0.4pt] (0,0)--(0,-0.8) (3,0)--(3,-0.8) (5,0)--(5,-0.8);\n\\draw[<->,line width=0.4pt] (0,-0.6)--(3,-0.6) node[midway,below] {$3\\text{ m}$};\n\\draw[<->,line width=0.4pt] (3,-0.6)--(5,-0.6) node[midway,below] {$2\\text{ m}$};\n\\node[left] at (0,0.75) {$1.5\\text{ m}$};\n\\node[below right] at (5.6,0.4) {$4\\text{ m}$};\n\\end{tikzpicture}",
