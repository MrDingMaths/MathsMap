  "content": {
    "id": "p4-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find $h(-3)$, $h(1)$ and $h(5)$ for each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$h(x)=2x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4,\\ 4,\\ 12$",
          "worked": "$$\\begin{align*}h(-3)&=2(-3)+2\\\\h(-3)&=-4\\\\h(1)&=2(1)+2\\\\h(1)&=4\\\\h(5)&=2(5)+2\\\\h(5)&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p4-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$h(x)=\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac13,\\ 1,\\ \\frac15$",
          "worked": "$$\\begin{align*}h(-3)&=\\frac{1}{-3}\\\\h(-3)&=-\\frac13\\\\h(1)&=\\frac11\\\\h(1)&=1\\\\h(5)&=\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p4-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$h(x)=3x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-18,\\ 2,\\ -10$",
          "worked": "$$\\begin{align*}h(-3)&=3(-3)-(-3)^2\\\\h(-3)&=-9-9\\\\h(-3)&=-18\\\\h(1)&=3(1)-1^2\\\\h(1)&=2\\\\h(5)&=3(5)-5^2\\\\h(5)&=15-25\\\\h(5)&=-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p4-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$h(x)=\\sqrt{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\ \\sqrt5,\\ 3$",
          "worked": "$$\\begin{align*}h(-3)&=\\sqrt{-3+4}\\\\h(-3)&=1\\\\h(1)&=\\sqrt{1+4}\\\\h(1)&=\\sqrt5\\\\h(5)&=\\sqrt{5+4}\\\\h(5)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
