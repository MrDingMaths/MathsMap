  "content": {
    "id": "p56-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Simplify the following by rationalising the denominator.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{5+\\sqrt2}{5-\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27+10\\sqrt2}{23}$",
          "worked": "$$\\begin{align*}\\frac{5+\\sqrt2}{5-\\sqrt2}&=\\frac{5+\\sqrt2}{5-\\sqrt2}\\times\\frac{5+\\sqrt2}{5+\\sqrt2}\\\\&=\\frac{25+10\\sqrt2+2}{25-2}\\\\&=\\frac{27+10\\sqrt2}{23}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p56-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{\\sqrt3+1}+\\dfrac{\\sqrt3-1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3\\sqrt3-3}{4}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt3+1}+\\frac{\\sqrt3-1}{4}&=\\frac{\\sqrt3-1}{3-1}+\\frac{\\sqrt3-1}{4}\\\\&=\\frac{\\sqrt3-1}{2}+\\frac{\\sqrt3-1}{4}\\\\&=\\frac{2\\sqrt3-2+\\sqrt3-1}{4}\\\\&=\\frac{3\\sqrt3-3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p56-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{42}{\\sqrt{63}}-\\dfrac{6}{\\sqrt7+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$. Rationalising gives $2\\sqrt7-(2\\sqrt7-4)$.",
          "worked": "$$\\begin{align*}\\frac{42}{\\sqrt{63}}-\\frac{6}{\\sqrt7+2}&=\\frac{14}{\\sqrt7}-\\frac{6}{\\sqrt7+2}\\\\&=\\frac{14\\sqrt7}{7}-\\frac{6(\\sqrt7-2)}{7-4}\\\\&=2\\sqrt7-2(\\sqrt7-2)\\\\&=2\\sqrt7-2\\sqrt7+4\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
