        "answer": {
          "short": "$a=-7$ or $7$",
          "worked": "$$\\begin{align*}(a-7)(a+7)&=0\\\\a-7=0\\quad&\\text{or}\\quad a+7=0\\\\a=7\\quad&\\text{or}\\quad a=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
