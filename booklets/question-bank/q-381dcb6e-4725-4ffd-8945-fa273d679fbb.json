        "type": "part",
        "label": "b",
        "prompt": "$b^2+7b=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-7$ or $0$",
          "worked": "$$\\begin{align*}b(b+7)&=0\\\\b=0\\quad&\\text{or}\\quad b+7=0\\\\b=0\\quad&\\text{or}\\quad b=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p25-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$c^2+7c+6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=-6$ or $-1$",
          "worked": "$$\\begin{align*}(c+1)(c+6)&=0\\\\c+1=0\\quad&\\text{or}\\quad c+6=0\\\\c=-1\\quad&\\text{or}\\quad c=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p25-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$d^2+6d-7=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=-7$ or $1$",
          "worked": "$$\\begin{align*}(d+7)(d-1)&=0\\\\d+7=0\\quad&\\text{or}\\quad d-1=0\\\\d=-7\\quad&\\text{or}\\quad d=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p25-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$e^2-5e+6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e=2$ or $3$",
          "worked": "$$\\begin{align*}(e-2)(e-3)&=0\\\\e-2=0\\quad&\\text{or}\\quad e-3=0\\\\e=2\\quad&\\text{or}\\quad e=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p25-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$2f^2-f-6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f=-\\frac{3}{2}$ or $2$",
          "worked": "$$\\begin{align*}2f^2+3f-4f-6&=0\\\\f(2f+3)-2(2f+3)&=0\\\\(f-2)(2f+3)&=0\\\\f-2=0\\quad&\\text{or}\\quad 2f+3=0\\\\f=2\\quad&\\text{or}\\quad f=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p25-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$2g^2-13g+6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g=\\frac{1}{2}$ or $6$",
          "worked": "$$\\begin{align*}2g^2-g-12g+6&=0\\\\g(2g-1)-6(2g-1)&=0\\\\(g-6)(2g-1)&=0\\\\g-6=0\\quad&\\text{or}\\quad 2g-1=0\\\\g=6\\quad&\\text{or}\\quad g=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p25-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$3h^2+2h-8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=-2$ or $\\frac{4}{3}$",
          "worked": "$$\\begin{align*}3h^2+6h-4h-8&=0\\\\3h(h+2)-4(h+2)&=0\\\\(3h-4)(h+2)&=0\\\\3h-4=0\\quad&\\text{or}\\quad h+2=0\\\\h=\\frac43\\quad&\\text{or}\\quad h=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
