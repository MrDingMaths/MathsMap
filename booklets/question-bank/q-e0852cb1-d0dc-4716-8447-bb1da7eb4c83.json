      {
        "id": "p14-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\left(x+\\frac{1}{x}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2x-2x^{-3}$",
          "worked": "$$\\begin{aligned}y&=x^2+2+\\frac{1}{x^2}\\\\y&=x^2+2+x^{-2}\\\\\\frac{dy}{dx}&=2x-2x^{-3}\\\\\\frac{dy}{dx}&=2x-\\frac{2}{x^3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\left(1+\\frac{1}{x}\\right)^2-\\left(x-\\frac{1}{x}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-\\dfrac{2}{x^2}-2x$",
          "worked": "$$\\begin{aligned}y&=1+\\frac{2}{x}+\\frac{1}{x^2}\\\\&\\quad-\\left(x^2-2+\\frac{1}{x^2}\\right)\\\\y&=3+\\frac{2}{x}-x^2\\\\y&=3+2x^{-1}-x^2\\\\\\frac{dy}{dx}&=-2x^{-2}-2x\\\\\\frac{dy}{dx}&=-\\frac{2}{x^2}-2x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p14-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\left(\\sqrt{x}-\\frac{1}{\\sqrt{x}}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=1-\\dfrac{1}{x^2}$",
          "worked": "$$\\begin{aligned}y&=x-2+\\frac{1}{x}\\\\y&=x-2+x^{-1}\\\\\\frac{dy}{dx}&=1-x^{-2}\\\\\\frac{dy}{dx}&=1-\\frac{1}{x^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
