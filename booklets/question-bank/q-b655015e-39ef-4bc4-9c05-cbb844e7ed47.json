    "type": "question",
    "label": "2",
    "prompt": "Nick’s share portfolio consists of shares, with value $\\$10000$, in the banking industry, $\\$3000$ in mining shares and $\\$15000$ in the gold market. Round percentages to 1 decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage of his share portfolio is made up of shares in the mining sector?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10.7\\%$",
          "worked": "$$\\begin{align*}\\text{Portfolio value}&=10000+3000+15000\\\\\\text{Portfolio value}&=\\$28000\\\\\\text{Mining percentage}&=\\frac{3000}{28000}\\times100\\%\\\\\\text{Mining percentage}&\\approx10.7\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p39-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage of Nick’s share portfolio are not banking shares?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64.3\\%$",
          "worked": "$$\\begin{align*}\\text{Non-banking value}&=3000+15000\\\\\\text{Non-banking value}&=\\$18000\\\\\\text{Non-banking percentage}&=\\frac{18000}{28000}\\times100\\%\\\\\\text{Non-banking percentage}&\\approx64.3\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
