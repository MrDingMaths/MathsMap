        "label": "a",
        "prompt": "Simplify $\\frac{9y^{4}}{3y^{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{y^{3}}$",
          "worked": "$$\\begin{align*}\\frac{9y^4}{3y^7}&=\\frac3{y^{7-4}} \\\\ &=\\frac3{y^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $9y^{4} \\times 3y^{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27y^{11}$",
          "worked": "$$\\begin{align*}9y^4\\times3y^7&=27y^{4+7} \\\\ &=27y^{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q10-e",
        "type": "part",
        "label": "c",
        "prompt": "Work out the value of $\\left( 9 \\times 10^{4} \\right) \\times \\left( 3 \\times 10^{7} \\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27 \\times 10^{11}$",
          "worked": "$$\\begin{align*}(9\\times10^4)(3\\times10^7)&=27\\times10^{4+7} \\\\ &=27\\times10^{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q10-c",
        "type": "part",
        "label": "d",
        "prompt": "Simplify $\\frac{9 \\times 10^{4}}{3 \\times 10^{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10^{3}}$",
          "worked": "$$\\begin{align*}\\frac{9\\times10^4}{3\\times10^7}&=\\frac3{10^{7-4}} \\\\ &=\\frac3{10^3}\\end{align*}$$",
