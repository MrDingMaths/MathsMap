        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40\\text{ km/h}$",
          "worked": "$$\\begin{align*}t_{\\text{total}}&=\\frac{60}{60}+\\frac{60}{30}\\\\t_{\\text{total}}&=3\\text{ h}\\\\s_{\\text{average}}&=\\frac{120}{3}\\\\s_{\\text{average}}&=40\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
