  "content": {
    "id": "v2-24c92-p37-practice-j18-092930-root",
    "type": "question",
    "label": null,
    "prompt": "A motorist drives 60 km out of town at 60 km/h, then returns along the same 60 km. Find the average speed in km/h for the whole journey if the return speed is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-24c92-p37-practice-j18-092930-j18-q-a",
        "type": "part",
        "label": "a",
        "prompt": "60 km/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60\\text{ km/h}$",
          "worked": "$$\\begin{align*}t_{\\text{total}}&=\\frac{60}{60}+\\frac{60}{60}\\\\t_{\\text{total}}&=2\\text{ h}\\\\s_{\\text{average}}&=\\frac{120}{2}\\\\s_{\\text{average}}&=60\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-24c92-p37-practice-j18-092930-j18-q-b",
        "type": "part",
