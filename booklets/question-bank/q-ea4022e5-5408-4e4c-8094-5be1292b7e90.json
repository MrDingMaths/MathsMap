  "content": {
    "id": "p58-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "In each case find the value of $a$ that makes the function continuous.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$$f(x)=\\begin{cases}ax^2,&\\text{for }x\\leq1,\\\\6-x,&\\text{for }x>1.\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=5$.",
          "worked": "For continuity at $x=1$, the two branches must have the same value there.\n$$\\begin{align*}a(1)^2&=6-1\\\\a&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$$g(x)=\\begin{cases}\\dfrac{a(x^2-9)}{x+3},&\\text{for }x\\ne-3,\\\\12,&\\text{for }x=-3.\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-2$.",
          "worked": "For $x\\ne-3$,\n$$\\begin{align*}g(x)&=\\frac{a(x-3)(x+3)}{x+3}\\\\g(x)&=a(x-3).\\end{align*}$$\nAs $x$ approaches $-3$, this branch approaches $-6a$. Continuity requires this to equal $g(-3)=12$.\n$$\\begin{align*}-6a&=12\\\\a&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
