  "content": {
    "id": "p27-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Today, in a ten-member committee, an old member was replaced by a young member. The average age is now the same as it was four years ago. Find the difference in ages between the old member and the young member.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "40 years.\n\nThe replacement reduces the total age by $10\\times4=40$ years.",
      "worked": "Let $s$ be the total age of the ten members before the replacement, and $d$ the difference between the old member’s and young member’s ages. Four years ago, the total age was $s-40$; after the replacement, it is $s-d$.\n\n$$\\begin{align*}\\frac{s-d}{10}&=\\frac{s-40}{10}\\\\s-d&=s-40\\\\-d&=-40\\\\d&=40\\end{align*}$$\n\nThe old member is 40 years older than the young member.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
