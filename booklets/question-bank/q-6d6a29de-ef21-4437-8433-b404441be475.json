  "content": {
    "id": "p35-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A council is running two raffles. The probability of winning in each raffle is 1 in 100.\n\nJared buys one ticket for each raffle. Answer these questions without drawing a tree diagram.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that he wins both?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10000}$",
          "worked": "$$\\begin{align*}P(\\text{both})&=\\frac{1}{100}\\times\\frac{1}{100}\\\\&=\\frac{1}{10000}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability he wins at least one?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{199}{10000}$",
          "worked": "$$\\begin{align*}P(\\text{at least one})&=1-P(\\text{neither})\\\\&=1-\\left(\\frac{99}{100}\\times\\frac{99}{100}\\right)\\\\&=1-\\frac{9801}{10000}\\\\&=\\frac{199}{10000}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
