  "content": {
    "id": "p35-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "An investor bought an antique table for $\\$6000$. He paid $5\\%$ as a deposit and borrowed the remainder from a bank for two years at $18\\%$ p.a. simple interest, payable monthly. How much interest does he have to pay each month?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$85.50$ per month.",
      "worked": "$$\\begin{align*}\\text{Deposit}&=6000\\times0.05\\\\\\text{Deposit}&=\\$300\\\\P&=6000-300\\\\P&=\\$5700\\\\I&=PRT\\\\I&=5700\\times0.18\\times2\\\\I&=\\$2052\\\\\\text{Monthly interest}&=\\frac{2052}{2\\times12}\\\\\\text{Monthly interest}&=\\$85.50\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
