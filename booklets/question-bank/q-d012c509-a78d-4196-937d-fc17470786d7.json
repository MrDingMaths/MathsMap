      {
        "id": "p51-q1-identity",
        "type": "part",
        "label": "a",
        "prompt": "Express $\\sin^2\\theta$ in terms of $\\cos 2\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2\\theta=\\frac12-\\frac12\\cos 2\\theta$",
          "worked": "$$\\begin{aligned}\\cos 2\\theta&=1-2\\sin^2\\theta\\\\2\\sin^2\\theta&=1-\\cos 2\\theta\\\\\\sin^2\\theta&=\\frac12-\\frac12\\cos 2\\theta\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p51-q1-integrals",
        "type": "group",
        "label": "",
        "prompt": "Hence find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p51-q1-a",
            "type": "part",
            "label": "b",
            "prompt": "$\\displaystyle\\int\\sin^2x\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{x}{2}-\\frac14\\sin 2x+C$",
              "worked": "$$\\begin{aligned}\\int\\sin^2x\\,dx&=\\frac12\\int(1-\\cos 2x)\\,dx\\\\&=\\frac12\\left(x-\\frac12\\sin 2x\\right)+C\\\\&=\\frac{x}{2}-\\frac14\\sin 2x+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p51-q1-b",
            "type": "part",
            "label": "c",
            "prompt": "$\\displaystyle\\int\\sin^2 2x\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{x}{2}-\\frac18\\sin 4x+C$",
              "worked": "$$\\begin{aligned}\\int\\sin^2 2x\\,dx&=\\frac12\\int(1-\\cos 4x)\\,dx\\\\&=\\frac12\\left(x-\\frac14\\sin 4x\\right)+C\\\\&=\\frac{x}{2}-\\frac18\\sin 4x+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p51-q1-c",
            "type": "part",
            "label": "d",
            "prompt": "$\\displaystyle\\int\\sin^2\\!\\left(\\frac14x\\right)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{x}{2}-\\sin\\left(\\frac{x}{2}\\right)+C$",
              "worked": "$$\\begin{aligned}\\int\\sin^2\\!\\left(\\frac{x}{4}\\right)\\,dx&=\\frac12\\int\\left(1-\\cos\\frac{x}{2}\\right)\\,dx\\\\&=\\frac12\\left(x-2\\sin\\frac{x}{2}\\right)+C\\\\&=\\frac{x}{2}-\\sin\\frac{x}{2}+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p51-q1-d",
            "type": "part",
            "label": "e",
            "prompt": "$\\displaystyle\\int\\sin^2 3x\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{x}{2}-\\frac1{12}\\sin 6x+C$",
              "worked": "$$\\begin{aligned}\\int\\sin^2 3x\\,dx&=\\frac12\\int(1-\\cos 6x)\\,dx\\\\&=\\frac12\\left(x-\\frac16\\sin 6x\\right)+C\\\\&=\\frac{x}{2}-\\frac1{12}\\sin 6x+C\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
    ]
