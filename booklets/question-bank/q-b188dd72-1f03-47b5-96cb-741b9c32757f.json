  "content": {
    "id": "p16-q2-root",
    "type": "question",
    "label": "9",
    "prompt": "The leading driver in an Indy car race is having engine trouble. He has had to cut his speed to 140 km/h but is 500 m ahead of the car in second place. The driver in second place maintains a speed of 150 km/h. How long does it take for the second driver to catch up with the leader?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "3 minutes.",
      "worked": "Use the gap $500\\text{ m}=0.5\\text{ km}$. The closing speed is $150-140=10\\text{ km/h}$, so $t=\\frac{0.5}{10}=0.05\\text{ h}=3\\text{ min}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 14
  },
