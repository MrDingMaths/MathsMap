  "content": {
    "id": "sum-product-b1-1-root",
    "type": "question",
    "label": null,
    "prompt": "If $\\alpha$ and $\\beta$ are the zeroes of $3x^2+4x-2=0$, find:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "sum-product-b1-1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac43$",
          "worked": "$$\\begin{aligned}\\alpha+\\beta&=-\\frac ba\\\\\\alpha+\\beta&=-\\frac43\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "sum-product-b1-1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac23$",
          "worked": "$$\\begin{aligned}\\alpha\\beta&=\\frac ca\\\\\\alpha\\beta&=\\frac{-2}{3}\\\\\\alpha\\beta&=-\\frac23\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "sum-product-b1-1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha^2+\\beta^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{28}{9}$",
          "worked": "$$\\begin{aligned}\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\\\alpha^2+\\beta^2&=\\left(-\\frac43\\right)^2-2\\left(-\\frac23\\right)\\\\\\alpha^2+\\beta^2&=\\frac{16}{9}+\\frac{12}{9}\\\\\\alpha^2+\\beta^2&=\\frac{28}{9}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "sum-product-b1-1-d",
        "type": "part",
        "label": "d",
        "prompt": "$|\\alpha-\\beta|$\n\n(hint: square it)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{10}}{3}$",
          "worked": "$$\\begin{aligned}(\\alpha-\\beta)^2&=(\\alpha+\\beta)^2-4\\alpha\\beta\\\\(\\alpha-\\beta)^2&=\\left(-\\frac43\\right)^2-4\\left(-\\frac23\\right)\\\\(\\alpha-\\beta)^2&=\\frac{16}{9}+\\frac{24}{9}\\\\(\\alpha-\\beta)^2&=\\frac{40}{9}\\\\|\\alpha-\\beta|&=\\frac{\\sqrt{40}}{3}\\\\|\\alpha-\\beta|&=\\frac{2\\sqrt{10}}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
