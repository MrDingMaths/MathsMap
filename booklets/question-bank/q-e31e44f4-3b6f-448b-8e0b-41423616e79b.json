  "content": {
    "id": "p16-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A triangle has sides whose lengths are 7, 24 and 25. Determine if this triangle has a right angle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes, since $7^2+24^2=25^2$.",
      "worked": "$$\\begin{align*}7^2+24^2&=49+576\\\\7^2+24^2&=625\\\\25^2&=625\\end{align*}$$\nSince the sum of the squares of the shorter sides equals the square of the longest side, the triangle has a right angle.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
