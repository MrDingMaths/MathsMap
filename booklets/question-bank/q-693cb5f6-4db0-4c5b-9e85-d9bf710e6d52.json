  "content": {
    "id": "p15-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Find the common difference of each AP. Then find a formula for the $n$th term $a_n$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_3 2,\\ \\log_3 4,\\ \\log_3 8,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=\\log_3 2;\\quad a_n=n\\log_3 2$.",
          "worked": "$$\\begin{align*}d&=\\log_3 4-\\log_3 2\\\\d&=\\log_3\\left(\\frac42\\right)\\\\d&=\\log_3 2\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=\\log_3 2+(n-1)\\log_3 2\\\\a_n&=n\\log_3 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a 54,\\ \\log_a 18,\\ \\log_a 6,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=-\\log_a 3;\\quad a_n=\\log_a 2+(4-n)\\log_a 3$.",
          "worked": "$$\\begin{align*}d&=\\log_a 18-\\log_a 54\\\\d&=\\log_a\\left(\\frac{18}{54}\\right)\\\\d&=\\log_a\\left(\\frac13\\right)\\\\d&=-\\log_a 3\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=\\log_a 54+(n-1)(-\\log_a 3)\\\\a_n&=\\log_a 54-(n-1)\\log_a 3\\\\a_n&=\\log_a(2\\times3^3)+(1-n)\\log_a 3\\\\a_n&=\\log_a 2+3\\log_a 3+(1-n)\\log_a 3\\\\a_n&=\\log_a 2+(4-n)\\log_a 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$x-3y,\\ 2x+y,\\ 3x+5y,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=x+4y;\\quad a_n=nx+(4n-7)y$.",
          "worked": "$$\\begin{align*}d&=(2x+y)-(x-3y)\\\\d&=x+4y\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=(x-3y)+(n-1)(x+4y)\\\\a_n&=x-3y+nx+4ny-x-4y\\\\a_n&=nx+(4n-7)y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p15-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$5-6\\sqrt5,\\ 1+\\sqrt5,\\ -3+8\\sqrt5,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=-4+7\\sqrt5;\\quad a_n=9-4n+(7n-13)\\sqrt5$.",
          "worked": "$$\\begin{align*}d&=(1+\\sqrt5)-(5-6\\sqrt5)\\\\d&=-4+7\\sqrt5\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=(5-6\\sqrt5)+(n-1)(-4+7\\sqrt5)\\\\a_n&=5-6\\sqrt5-4n+4+7n\\sqrt5-7\\sqrt5\\\\a_n&=9-4n+(7n-13)\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p15-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "$1.36,\\ -0.52,\\ -2.4,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=-1.88;\\quad a_n=3.24-1.88n$.",
          "worked": "$$\\begin{align*}d&=-0.52-1.36\\\\d&=-1.88\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=1.36+(n-1)(-1.88)\\\\a_n&=1.36-1.88n+1.88\\\\a_n&=3.24-1.88n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p15-q19-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a 3x^2,\\ \\log_a 3x,\\ \\log_a 3,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=-\\log_a x;\\quad a_n=\\log_a 3+(3-n)\\log_a x$.",
          "worked": "$$\\begin{align*}d&=\\log_a(3x)-\\log_a(3x^2)\\\\d&=\\log_a\\left(\\frac{3x}{3x^2}\\right)\\\\d&=\\log_a\\left(\\frac1x\\right)\\\\d&=-\\log_a x\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=\\log_a(3x^2)+(n-1)(-\\log_a x)\\\\a_n&=\\log_a 3+2\\log_a x-(n-1)\\log_a x\\\\a_n&=\\log_a 3+(3-n)\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
