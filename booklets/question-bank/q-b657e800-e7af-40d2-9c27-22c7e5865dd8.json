        "children": [],
        "answer": {
          "short": "A matches 2, B matches 1 and C matches 3.",
          "worked": "A is the darkest photograph, so it matches graph 2, which has very few pixels above the middle of the brightness scale. B has many nearly white pixels, so it matches graph 1, which spikes near $255$. C matches graph 3, which extends farther into the brighter values than graph 2 and tapers before $255$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p26-p5-b",
        "type": "part",
        "label": "b",
        "prompt": "The three images contain the same number of pixels. Explain why the area under each graph is equal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each image contains the same total number of pixels, and all brightness bins have width $1$.",
          "worked": "Each pixel is counted once, in the bin for its brightness. Each bin has width $1$, so its area equals its pixel count. The total area therefore equals the total number of pixels, which is the same for all three images.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
