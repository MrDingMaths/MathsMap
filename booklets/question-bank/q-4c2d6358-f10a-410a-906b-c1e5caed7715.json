  "content": {
    "id": "p63-q35-root",
    "type": "question",
    "label": "35",
    "prompt": "Consider $f(x)=\\dfrac{\\sqrt{x}+1}{x-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p63-q35-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{\\sqrt{x}+1}{x-1}=\\dfrac{1}{\\sqrt{x}-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{x}+1}{x-1}=\\dfrac{\\sqrt{x}+1}{(\\sqrt{x}-1)(\\sqrt{x}+1)}=\\dfrac{1}{\\sqrt{x}-1}$.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{x}+1}{x-1}&=\\frac{\\sqrt{x}+1}{(\\sqrt{x}-1)(\\sqrt{x}+1)}\\\\&=\\frac{1}{\\sqrt{x}-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p63-q35-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence differentiate $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\dfrac{1}{2\\sqrt{x}(\\sqrt{x}-1)^2}$",
          "worked": "Using part a,\n$$\\begin{align*}f(x)&=(\\sqrt{x}-1)^{-1}\\\\f'(x)&=-(\\sqrt{x}-1)^{-2}\\times\\frac{1}{2\\sqrt{x}}\\\\&=-\\frac{1}{2\\sqrt{x}(\\sqrt{x}-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
