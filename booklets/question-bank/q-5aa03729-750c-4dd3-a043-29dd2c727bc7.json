        "type": "part",
        "label": "a",
        "prompt": "What does it mean when we say two angles are supplementary?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Their angles sum to $180^\\circ$.",
          "worked": "Two supplementary angles sum to $180^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
