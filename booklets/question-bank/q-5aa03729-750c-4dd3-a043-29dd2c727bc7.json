            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 26 p26-q1-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont},angle/.style={draw,line width=0.4pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\\coordinate (A) at (155:2);\\coordinate (B) at (65:2);\\coordinate (C) at (30:2);\\coordinate (D) at (280:2);\n\\draw (O) circle (2);\\draw (A)--(B)--(C)--(D)--cycle;\n\\node[left] at (A){$A$};\\node[above] at (B){$B$};\\node[right] at (C){$C$};\\node[below] at (D){$D$};\n\\node at ($(A)+(0.66,-0.13)$){$71^\\circ$};\\node at ($(D)+(-0.06,0.69)$){$63^\\circ$};\n\\end{tikzpicture}",
