            "label": "b",
            "prompt": "Find $\\angle ABC$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$117^\\circ$",
              "worked": "Opposite angles in a cyclic quadrilateral are supplementary.\n$$\\begin{aligned}\\angle ABC+63^\\circ&=180^\\circ\\\\\\angle ABC&=117^\\circ\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p26-q1-c",
            "type": "part",
            "label": "c",
            "prompt": "Find $\\angle BCD$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$109^\\circ$",
              "worked": "Opposite angles in a cyclic quadrilateral are supplementary.\n$$\\begin{aligned}\\angle BCD+71^\\circ&=180^\\circ\\\\\\angle BCD&=109^\\circ\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p26-q1-d",
            "type": "part",
            "label": "d",
            "prompt": "Check that\n$$\\angle ABC+\\angle BCD+\\angle CDA+\\angle DAB=360^\\circ$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$117^\\circ+109^\\circ+63^\\circ+71^\\circ=360^\\circ$",
              "worked": "$$\\begin{aligned}\\angle ABC+\\angle BCD+\\angle CDA+\\angle DAB&=117^\\circ+109^\\circ+63^\\circ+71^\\circ\\\\&=360^\\circ\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
