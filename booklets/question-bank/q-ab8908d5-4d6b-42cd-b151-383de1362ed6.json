  "content": {
    "id": "v2-a3cd93-p7-practice-j9-231818-root",
    "type": "question",
    "label": null,
    "prompt": "A number is rounded to 1 decimal place and the result is $3.4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a3cd93-p7-practice-j9-231818-j9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the smallest number with 2 decimal places that rounds to $3.4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.35$",
          "worked": "$$\\begin{align*}3.34&\\to3.3\\\\3.35&\\to3.4\\end{align*}$$ The smallest is $3.35$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-a3cd93-p7-practice-j9-231818-j9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the largest number with 2 decimal places that rounds to $3.4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.44$",
          "worked": "$$\\begin{align*}3.44&\\to3.4\\\\3.45&\\to3.5\\end{align*}$$ The largest is $3.44$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-a3cd93-p7-practice-j9-231818-j9-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Write all possible values of the original number $x$ in the form $\\square\\le x<\\square$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.35\\le x<3.45$",
          "worked": "$$\\begin{align*}3.35&\\to3.4\\text{ (included)}\\\\3.45&\\to3.5\\text{ (excluded)}\\\\3.35&\\le x<3.45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-a3cd93-p7-practice-j9-231818-j9-q-d",
        "type": "part",
        "label": "d",
        "prompt": "A watermelon has mass $m$ kg. Its mass is $4.3\\text{ kg}$ rounded to the nearest $100\\text{ g}$. Write all possible values of $m$ in the form $\\square\\le m<\\square$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.25\\le m<4.35$",
          "worked": "$$\\begin{align*}100\\text{ g}&=0.1\\text{ kg}\\\\4.25&\\to4.3\\text{ (included)}\\\\4.35&\\to4.4\\text{ (excluded)}\\\\4.25&\\le m<4.35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
