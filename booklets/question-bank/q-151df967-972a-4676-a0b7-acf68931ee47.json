  "content": {
    "id": "p41-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Let the roots of $2x^2+4x+1=0$ be $\\alpha$ and $\\beta$. Find the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\alpha+\\beta&=-\\frac{4}{2}\\\\\\alpha+\\beta&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p41-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\alpha\\beta=\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p41-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha^2+\\beta^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\\\alpha^2+\\beta^2&=(-2)^2-2\\left(\\frac{1}{2}\\right)\\\\\\alpha^2+\\beta^2&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p41-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{\\alpha^2}+\\dfrac{1}{\\beta^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}\\frac{1}{\\alpha^2}+\\frac{1}{\\beta^2}&=\\frac{\\alpha^2+\\beta^2}{(\\alpha\\beta)^2}\\\\\\frac{1}{\\alpha^2}+\\frac{1}{\\beta^2}&=\\frac{3}{\\left(\\frac{1}{2}\\right)^2}\\\\\\frac{1}{\\alpha^2}+\\frac{1}{\\beta^2}&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
