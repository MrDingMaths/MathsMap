  "content": {
    "id": "p29-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A brand of medication for babies bases the dosage on the age (in months) of the child.\n\nThe regression equation for this situation is $M = 0.312A + 0.157$, where $M$ is the amount of medication in mL and $A$ is the age in months.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Identify the independent variable and dependent variable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Independent: age in months. Dependent: amount of medication in mL.",
          "worked": "The independent variable is age, $A$, in months. The dependent variable is the amount of medication, $M$, in mL, because the dosage depends on the child's age.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p29-q1-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p29-q1-b-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Calculate the amount of medication required for a child aged 6 months.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p29-q1-b-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Let ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$A$",
                  "width": 9
                },
                {
                  "type": "math",
                  "latex": "= 6",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.029\\text{ mL}$",
          "worked": "Let $A = 6$.\n$$\\begin{align*}M &= 0.312(6) + 0.157\\\\M &= 2.029\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p29-q1-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p29-q1-c-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Determine the age of a child who requires 2.5 mL of the medication.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p29-q1-c-rounding",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Give your answer correct to 1 decimal place.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p29-q1-c-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Let ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$M$",
                  "width": 9
                },
                {
                  "type": "math",
                  "latex": "= 2.5",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.5\\text{ months}$",
          "worked": "Let $M = 2.5$.\n$$\\begin{align*}2.5 &= 0.312A + 0.157\\\\2.5 - 0.157 &= 0.312A\\\\\\frac{2.343}{0.312} &= A\\\\A &\\approx 7.5\\text{ months}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
