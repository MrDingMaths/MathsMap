    "type": "question",
    "label": "18",
    "prompt": "A bottle is filled with water and oil in the ratio $3:2$. An identical bottle is filled with water and oil in the ratio $5:6$. Find the ratio of water to oil when their contents are combined.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
