  "content": {
    "id": "p19-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Use first principles differentiation to find the derivative function $f'(x)$ for $9-4x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(x)=-8x$",
      "worked": "$$\\begin{aligned}f(x+h)&=9-4(x+h)^2\\\\&=9-4x^2-8xh-4h^2\\\\f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\&=\\lim_{h\\to0}\\frac{9-4x^2-8xh-4h^2-(9-4x^2)}{h}\\\\&=\\lim_{h\\to0}\\frac{-8xh-4h^2}{h}\\\\&=\\lim_{h\\to0}(-8x-4h)\\\\&=-8x\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
