      {
        "id": "p37-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^{\\pi/2}\\cos x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/2}\\cos x\\,dx&=\\left[\\sin x\\right]_0^{\\pi/2}\\\\&=\\sin\\frac{\\pi}{2}-\\sin0\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^{\\pi/6}\\cos x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/6}\\cos x\\,dx&=\\left[\\sin x\\right]_0^{\\pi/6}\\\\&=\\sin\\frac{\\pi}{6}-\\sin0\\\\&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p37-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{\\pi/4}^{\\pi/2}\\sin x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{\\sqrt2}$",
          "worked": "$$\\begin{align*}\\int_{\\pi/4}^{\\pi/2}\\sin x\\,dx&=\\left[-\\cos x\\right]_{\\pi/4}^{\\pi/2}\\\\&=-\\cos\\frac{\\pi}{2}+\\cos\\frac{\\pi}{4}\\\\&=\\frac{1}{\\sqrt2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p37-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_0^{\\pi/3}\\sec^2x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/3}\\sec^2x\\,dx&=\\left[\\tan x\\right]_0^{\\pi/3}\\\\&=\\tan\\frac{\\pi}{3}-\\tan0\\\\&=\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p37-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_0^{\\pi/4}2\\cos2x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/4}2\\cos2x\\,dx&=\\left[\\sin2x\\right]_0^{\\pi/4}\\\\&=\\sin\\frac{\\pi}{2}-\\sin0\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p37-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_0^{\\pi/3}\\sin2x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac34$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/3}\\sin2x\\,dx&=\\left[-\\frac12\\cos2x\\right]_0^{\\pi/3}\\\\&=-\\frac12\\left(\\cos\\frac{2\\pi}{3}-\\cos0\\right)\\\\&=-\\frac12\\left(-\\frac12-1\\right)\\\\&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p37-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\displaystyle\\int_0^{\\pi/2}\\sec^2\\left(\\frac{x}{2}\\right)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/2}\\sec^2\\left(\\frac{x}{2}\\right)\\,dx&=\\left[2\\tan\\frac{x}{2}\\right]_0^{\\pi/2}\\\\&=2\\left(\\tan\\frac{\\pi}{4}-\\tan0\\right)\\\\&=2(1-0)\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p37-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\displaystyle\\int_{\\pi/3}^{\\pi}\\cos\\left(\\frac{x}{2}\\right)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\int_{\\pi/3}^{\\pi}\\cos\\left(\\frac{x}{2}\\right)\\,dx&=\\left[2\\sin\\frac{x}{2}\\right]_{\\pi/3}^{\\pi}\\\\&=2\\left(\\sin\\frac{\\pi}{2}-\\sin\\frac{\\pi}{6}\\right)\\\\&=2\\left(1-\\frac12\\right)\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\displaystyle\\int_0^\\pi(2\\sin x-\\sin2x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\int_0^\\pi(2\\sin x-\\sin2x)\\,dx&=\\left[-2\\cos x+\\frac12\\cos2x\\right]_0^\\pi\\\\&=\\left(2+\\frac12\\right)\\\\&\\quad-\\left(-2+\\frac12\\right)\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
