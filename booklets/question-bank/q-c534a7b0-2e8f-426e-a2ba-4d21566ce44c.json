    "id": "p12-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Decide which elements would need to be removed from event $A$ if the two events $A$ and $B$ described below are to become mutually exclusive.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\{1,2,3,4\\},\\qquad B=\\{4,5,6,7\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remove $4$ from $A$.",
          "worked": "$A\\cap B=\\{4\\}$. Remove $4$ from $A$ so that the two events have no elements in common.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\{10,12,14,16,18\\},\\qquad B=\\{9,10,11,12\\}$",
