        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remove $10$ and $12$ from $A$.",
          "worked": "$A\\cap B=\\{10,12\\}$. Remove $10$ and $12$ from $A$ so that the two events have no elements in common.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
