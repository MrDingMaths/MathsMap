          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "$A=\\{1,3,5,8,10,15,20,22,23\\},\\qquad B=\\{7,9,14,16,19,21,26\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No elements need removing; the events are already mutually exclusive.",
          "worked": "$A\\cap B=\\varnothing$. The events have no elements in common, so no elements need to be removed.",
