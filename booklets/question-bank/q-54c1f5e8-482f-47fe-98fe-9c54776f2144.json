      {
        "id": "v2-47966955a96ba42-p4-slot-2-slot-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y=\\sin^4 x-\\cos^4 x$ has derivative $y'=2\\sin 2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2\\sin 2x$.",
          "worked": "$$\\begin{align*}y'&=4\\sin^3x\\cos x-4\\cos^3x(-\\sin x)\\\\&=4\\sin x\\cos x(\\sin^2x+\\cos^2x)\\\\&=4\\sin x\\cos x\\\\&=2\\sin 2x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-47966955a96ba42-p4-slot-2-slot-2-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $y=\\tan^2 x$ has derivative $y'=2\\tan x+2\\tan^3 x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2\\tan x+2\\tan^3x$.",
          "worked": "$$\\begin{align*}y'&=2\\tan x\\sec^2x\\\\&=2\\tan x(1+\\tan^2x)\\\\&=2\\tan x+2\\tan^3x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-47966955a96ba42-p4-slot-2-slot-2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the derivative of $y=\\sin^2 x\\cos^2 x$ in the form $y'=k\\sin 4x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac12\\sin 4x$.",
          "worked": "$$\\begin{align*}y'&=2\\sin x\\cos x\\cdot\\cos^2x+\\sin^2x\\cdot2\\cos x(-\\sin x)\\\\&=2\\sin x\\cos x(\\cos^2x-\\sin^2x)\\\\&=\\sin 2x\\cos 2x\\\\&=\\frac12\\sin 4x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
