    "type": "question",
    "label": "8",
    "prompt": "Find $y$ if $\\dfrac{dy}{dt}=8t^3-6t^2+5$, and $y=4$ when $t=0$. Hence find $y$ when $t=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=2t^4-2t^3+5t+4$; when $t=2$, $y=30$.",
      "worked": "$$\\begin{aligned}y&=2t^4-2t^3+5t+C\\\\4&=2(0)^4-2(0)^3+5(0)+C\\\\C&=4\\\\y&=2t^4-2t^3+5t+4\\\\y(2)&=2(2)^4-2(2)^3+5(2)+4\\\\y(2)&=30\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
