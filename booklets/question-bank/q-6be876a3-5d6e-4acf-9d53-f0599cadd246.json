  "content": {
    "id": "p14-ep-14-17-root",
    "type": "question",
    "label": "14",
    "prompt": "Differentiate the following functions by first principles.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-ep-14-17-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=4x$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{2(x+h)^2-2x^2}{h}\\\\&=\\lim_{h\\to0}\\frac{4xh+2h^2}{h}\\\\&=\\lim_{h\\to0}(4x+2h)\\\\&=4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p14-ep-14-17-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=3x^2+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=6x$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{3(x+h)^2+5-(3x^2+5)}{h}\\\\&=\\lim_{h\\to0}\\frac{6xh+3h^2}{h}\\\\&=\\lim_{h\\to0}(6x+3h)\\\\&=6x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p14-ep-14-17-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=2-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-2x$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{2-(x+h)^2-(2-x^2)}{h}\\\\&=\\lim_{h\\to0}\\frac{-2xh-h^2}{h}\\\\&=\\lim_{h\\to0}(-2x-h)\\\\&=-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p14-ep-14-17-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^2-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x-1$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{(x+h)^2-(x+h)-(x^2-x)}{h}\\\\&=\\lim_{h\\to0}\\frac{2xh+h^2-h}{h}\\\\&=\\lim_{h\\to0}(2x+h-1)\\\\&=2x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
