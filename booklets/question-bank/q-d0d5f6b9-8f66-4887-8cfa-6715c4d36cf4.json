  "content": {
    "id": "p47-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A particle is projected from the origin and its parabolic path has equation $y=-\\dfrac{5}{324}x^2+\\dfrac{4}{3}x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the height when the particle has travelled a horizontal distance of 12 m. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13.8\\text{ m}$",
          "worked": "$$\\begin{aligned}y(12)&=-\\frac{5}{324}(12)^2+\\frac{4}{3}(12)\\\\&=-\\frac{20}{9}+16\\\\&=\\frac{124}{9}\\text{ m}\\\\&\\approx13.8\\text{ m}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p47-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find how far the particle has travelled horizontally when its height is 19 m.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18\\text{ m}$ or $68.4\\text{ m}$.",
          "worked": "$$\\begin{aligned}-\\frac{5}{324}x^2+\\frac{4}{3}x&=19\\\\5x^2-432x+6156&=0.\\end{aligned}$$\nUsing the quadratic formula:\n$$\\begin{aligned}x&=\\frac{432\\pm\\sqrt{(-432)^2-4(5)(6156)}}{2(5)}\\\\&=\\frac{432\\pm252}{10}\\\\&=18\\text{ m}\\quad\\text{or}\\quad68.4\\text{ m}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p47-q5-c",
        "type": "group",
        "label": "c",
        "prompt": "Find $\\dfrac{dy}{dx}$ and hence show that:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p47-q5-c-derivative",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{dy}{dx}=-\\dfrac{5}{162}x+\\dfrac{4}{3}$.",
              "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=-\\frac{10}{324}x+\\frac{4}{3}\\\\&=-\\frac{5}{162}x+\\frac{4}{3}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14,
            "responseSpace": "scaffold"
          },
          {
            "id": "p47-q5-c-i",
            "type": "part",
            "label": "i",
            "prompt": "the angle of projection is $\\tan^{-1}\\!\\left(\\dfrac{4}{3}\\right)$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\theta=\\tan^{-1}\\!\\left(\\dfrac{4}{3}\\right)$ above the horizontal.",
              "worked": "At projection, $x=0$:\n$$\\begin{aligned}\\left.\\frac{dy}{dx}\\right|_{x=0}&=-\\frac{5}{162}(0)+\\frac{4}{3}\\\\&=\\frac{4}{3}.\\end{aligned}$$\nSince $\\tan\\theta=\\dfrac{dy}{dx}$, the angle of projection is $\\theta=\\tan^{-1}\\!\\left(\\dfrac{4}{3}\\right)$ above the horizontal.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p47-q5-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "when $x=18\\text{ m}$, the direction of motion is $\\tan^{-1}\\!\\left(\\dfrac{7}{9}\\right)$ above the horizontal,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\tan^{-1}\\!\\left(\\dfrac{7}{9}\\right)$ above the horizontal.",
              "worked": "At $x=18$:\n$$\\begin{aligned}\\frac{dy}{dx}&=-\\frac{5}{162}(18)+\\frac{4}{3}\\\\&=-\\frac{90}{162}+\\frac{4}{3}\\\\&=\\frac{7}{9}.\\end{aligned}$$\nThe positive gradient gives a direction $\\tan^{-1}\\!\\left(\\dfrac{7}{9}\\right)$ above the horizontal.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p47-q5-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "when $x=54\\text{ m}$, the direction of motion is $\\tan^{-1}\\!\\left(\\dfrac{1}{3}\\right)$ below the horizontal.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\tan^{-1}\\!\\left(\\dfrac{1}{3}\\right)$ below the horizontal.",
              "worked": "At $x=54$:\n$$\\begin{aligned}\\frac{dy}{dx}&=-\\frac{5}{162}(54)+\\frac{4}{3}\\\\&=-\\frac{270}{162}+\\frac{4}{3}\\\\&=-\\frac{1}{3}.\\end{aligned}$$\nThe negative gradient gives a direction $\\tan^{-1}\\!\\left(\\dfrac{1}{3}\\right)$ below the horizontal.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
    ]
  },
