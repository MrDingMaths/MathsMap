        "answer": {
          "short": "$14$.",
          "worked": "$$\\begin{align*}h'(2)&=f'(2)g(2)+f(2)g'(2)\\\\h'(2)&=3(4)+(-1)(-2)\\\\h'(2)&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-q27-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the equation of the tangent when $x=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=14x-32$.",
          "worked": "$$\\begin{align*}h(2)&=f(2)g(2)\\\\h(2)&=(-1)(4)=-4\\\\y-(-4)&=14(x-2)\\\\y&=14x-32\\end{align*}$$",
