  "content": {
    "id": "p8-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Factorise and hence simplify the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^8-3^7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times3^7$",
          "worked": "$$\\begin{align*}3^8-3^7&=3^7(3-1)\\\\3^8-3^7&=2\\times3^7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^n+2^{n+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times2^n$",
          "worked": "$$\\begin{align*}2^n+2^{n+1}&=2^n(1+2)\\\\2^n+2^{n+1}&=3\\times2^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p8-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^{2n}-3^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^n(3^n-1)$",
          "worked": "Take out the common factor $3^n$.\n\n$$3^{2n}-3^n=3^n(3^n-1)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p8-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$6^n-3^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^n(2^n-1)$",
          "worked": "$$\\begin{align*}6^n-3^n&=2^n\\times3^n-3^n\\\\6^n-3^n&=3^n(2^n-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p8-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$3^{3n}-3^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^n(3^n+1)(3^n-1)$",
          "worked": "$$\\begin{align*}3^{3n}-3^n&=3^n(3^{2n}-1)\\\\3^{3n}-3^n&=3^n\\bigl((3^n)^2-1^2\\bigr)\\\\3^{3n}-3^n&=3^n(3^n+1)(3^n-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
