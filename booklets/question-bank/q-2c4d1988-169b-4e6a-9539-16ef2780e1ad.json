    "type": "question",
    "label": null,
    "prompt": "A baker uses $2\\frac{1}{3}$ kg of flour for bread and $1\\frac{5}{6}$ kg of flour for pastries. How much flour does the baker use in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\frac{1}{6}$ kg",
      "worked": "$$\\begin{align*}2\\frac{1}{3}+1\\frac{5}{6}&=\\frac{7}{3}+\\frac{11}{6}\\\\&=\\frac{14}{6}+\\frac{11}{6}\\\\&=\\frac{25}{6}\\\\&=4\\frac{1}{6}\\text{ kg}\\end{align*}$$",
      "solutionDiagrams": []
    },
