  "content": {
    "id": "v2-6-practice-section-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Evaluate $\\arctan\\left(\\sqrt{3}\\tan\\left(\\frac{5\\pi}{6}\\right)\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\frac{\\pi}{4}$",
      "worked": "$$\\begin{align*}\\tan\\left(\\frac{5\\pi}{6}\\right)&=-\\tan\\left(\\frac{\\pi}{6}\\right)=-\\frac{1}{\\sqrt3}\\\\\\sqrt3\\tan\\left(\\frac{5\\pi}{6}\\right)&=\\sqrt3\\left(-\\frac{1}{\\sqrt3}\\right)=-1\\\\\\arctan(-1)&=-\\frac{\\pi}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
