  "content": {
    "id": "p44-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "In the equilateral triangle $\\triangle ABC$ with side lengths $2\\text{ cm}$, $D$, $E$ and $F$ are points on $AB$, $BC$ and $CA$ respectively such that $AD=BE=CF=x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p44-q10-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source PDF page 44, p44-q10-diagram\"}\n\\begin{tikzpicture}[x=27mm,y=27mm,draw=black,text=black,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (2,0);\n\\coordinate (C) at (1,{sqrt(3)});\n\\coordinate (D) at ($(A)!0.4!(B)$);\n\\coordinate (E) at ($(B)!0.4!(C)$);\n\\coordinate (F) at ($(C)!0.4!(A)$);\n\\draw (A)--(B)--(C)--cycle;\n\\draw[dashed,line width=0.8pt] (D)--(E)--(F)--cycle;\n\\fill[black] (D) circle[radius=1.3pt];\n\\fill[black] (E) circle[radius=1.3pt];\n\\fill[black] (F) circle[radius=1.3pt];\n\\node[below left,inner sep=1.5pt] at (A) {$A$};\n\\node[below right,inner sep=1.5pt] at (B) {$B$};\n\\node[above,inner sep=1.5pt] at (C) {$C$};\n\\node[below,inner sep=1.5pt] at (D) {$D$};\n\\node[right,inner sep=1.5pt] at (E) {$E$};\n\\node[left,inner sep=1.5pt] at (F) {$F$};\n\\path (A)--node[below,inner sep=1.5pt] {$x$} (D);\n\\path (B)--node[right,inner sep=1.5pt] {$x$} (E);\n\\path (C)--node[left,inner sep=1.5pt] {$x$} (F);\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 46.7,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
