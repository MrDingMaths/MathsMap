  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Given that $\\log_{10}7\\approx0.85$, find the approximate value of each expression to 2 decimal places:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{10}49$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.70$",
          "worked": "$$\\begin{align*}\\log_{10}49&=2\\log_{10}7\\\\\\log_{10}49&\\approx2(0.85)\\\\\\log_{10}49&\\approx1.70\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}70$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.85$",
          "worked": "$$\\begin{align*}\\log_{10}70&=\\log_{10}7+\\log_{10}10\\\\\\log_{10}70&=\\log_{10}7+1\\\\\\log_{10}70&\\approx0.85+1\\\\\\log_{10}70&\\approx1.85\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{10}700$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.85$",
          "worked": "$$\\begin{align*}\\log_{10}700&=\\log_{10}7+\\log_{10}100\\\\\\log_{10}700&=\\log_{10}7+2\\\\\\log_{10}700&\\approx0.85+2\\\\\\log_{10}700&\\approx2.85\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{10}0.7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.15$",
          "worked": "$$\\begin{align*}\\log_{10}0.7&=\\log_{10}7-\\log_{10}10\\\\\\log_{10}0.7&=\\log_{10}7-1\\\\\\log_{10}0.7&\\approx0.85-1\\\\\\log_{10}0.7&\\approx-0.15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{10}0.07$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1.15$",
          "worked": "$$\\begin{align*}\\log_{10}0.07&=\\log_{10}7-\\log_{10}100\\\\\\log_{10}0.07&=\\log_{10}7-2\\\\\\log_{10}0.07&\\approx0.85-2\\\\\\log_{10}0.07&\\approx-1.15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_{10}0.049$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1.30$",
          "worked": "$$\\begin{align*}\\log_{10}0.049&=\\log_{10}49-\\log_{10}1000\\\\\\log_{10}0.049&=2\\log_{10}7-3\\\\\\log_{10}0.049&\\approx2(0.85)-3\\\\\\log_{10}0.049&\\approx-1.30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
