    "type": "question",
    "label": null,
    "prompt": "How many values of $\\theta$ satisfy $\\sin\\theta=-1.5$? Give a reason.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "None. $-1.5$ is not in the range $[-1,1]$ of $y=\\sin\\theta$.",
      "worked": "For all real $\\theta$, $-1\\leq\\sin\\theta\\leq1$. Since $-1.5<-1$, no values of $\\theta$ satisfy $\\sin\\theta=-1.5$.",
