  "content": {
    "id": "p36-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "$PQRS$ is a cyclic quadrilateral. The diagonal $PR$ bisects both $\\angle SPQ$ and $\\angle SRQ$. Prove that $\\angle PQR$ is a right angle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\angle PQR=90^\\circ$.",
      "worked": "Let $\\angle QPR=\\angle RPS=\\beta$ and $\\angle QRP=\\angle PRS=\\alpha$.\n\nThe opposite angles at $P$ and $R$ of the cyclic quadrilateral are supplementary:\n$$2\\beta+2\\alpha=180^\\circ,\\qquad\\alpha+\\beta=90^\\circ.$$\n\nIn $\\triangle PQR$,\n$$\\angle PQR=180^\\circ-\\alpha-\\beta=90^\\circ.$$ ",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
