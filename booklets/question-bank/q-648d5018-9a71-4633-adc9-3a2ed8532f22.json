  "content": {
    "id": "p45-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Five students from school A and four students from school B are to sit in a row. Find the number of possible ways to seat the nine students if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9!=362\\,880$",
          "worked": "Arrange the nine distinct students in a row.\n\n$$9!=362\\,880.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p45-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "students from the same school must sit together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2!\\times5!\\times4!=5760$\n\nTreat each school as one block.",
          "worked": "Treat each school as one block. The two blocks can be ordered in $2!$ ways. Within them, the students can be arranged in $5!$ and $4!$ ways.\n\n$$2!\\times5!\\times4!=5760.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p45-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "students from different schools must alternate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5!\\times4!=2880$\n\nThe school pattern must be ABABABABA.",
          "worked": "Since there is one more student from school A, the school pattern must be ABABABABA. Arrange the five A students in their positions and the four B students in theirs.\n\n$$5!\\times4!=2880.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
