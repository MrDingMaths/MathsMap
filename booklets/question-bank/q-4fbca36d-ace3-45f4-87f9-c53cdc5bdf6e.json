        "id": "index-t7-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3ve^3\\times5e}{2e^3v^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15e}{2v^{4}}$",
          "worked": "$$\\begin{align*}\n\\frac{3ve^3\\times5e}{2e^3v^5} &= \\frac{3\\times5\\,e^{3 + 1 - 3}}{2\\,v^{- 1 + 5}} \\\\\n&= \\frac{15e}{2v^{4}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2n^2w\\times6n^4}{3n^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4n^{3}w$",
          "worked": "$$\\begin{align*}\n\\frac{2n^2w\\times6n^4}{3n^3} &= \\frac{2\\times6\\,n^{2 + 4 - 3}\\,w}{3} \\\\\n&= 4n^{3}w\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2x^2y^3\\times5y^4}{10x\\times2y^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{xy^{4}}{2}$",
          "worked": "$$\\begin{align*}\n\\frac{2x^2y^3\\times5y^4}{10x\\times2y^3} &= \\frac{2\\times5\\,x^{2 - 1}\\,y^{3 + 4 - 3}}{10\\times2} \\\\\n&= \\frac{xy^{4}}{2}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q23-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5m^2e^3\\times m^2}{2m^4\\times e^4m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{2me}$",
          "worked": "$$\\begin{align*}\n\\frac{5m^2e^3\\times m^2}{2m^4\\times e^4m} &= \\frac{5}{2\\,m^{- 2 - 2 + 4 + 1}\\,e^{- 3 + 4}} \\\\\n&= \\frac{5}{2me}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q23-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{6h^2q\\times3q^2}{2hq^4\\times h^2q^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{hq^{3}}$",
          "worked": "$$\\begin{align*}\n\\frac{6h^2q\\times3q^2}{2hq^4\\times h^2q^2} &= \\frac{6\\times3}{2\\,h^{- 2 + 1 + 2}\\,q^{- 1 - 2 + 4 + 2}} \\\\\n&= \\frac{9}{hq^{3}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q23-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5y^2x^5\\times4y^2}{y^4x^3\\times10x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\n\\frac{5y^2x^5\\times4y^2}{y^4x^3\\times10x^2} &= \\frac{5\\times4\\,y^{2 + 2 - 4}\\,x^{5 - 3 - 2}}{10} \\\\\n&= 2\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
