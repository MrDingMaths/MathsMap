  "content": {
    "id": "p26-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Consider the quadratic function $f(x)=x^2-2x-8$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Factor the quadratic and hence find the equation of the axis of symmetry.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=(x-4)(x+2)$; axis of symmetry: $x=1$.",
          "worked": "$$\\begin{align*}f(x)&=x^2-2x-8\\\\f(x)&=(x-4)(x+2)\\end{align*}$$\nThe zeroes are $4$ and $-2$. The axis lies halfway between them:\n$$\\begin{align*}x&=\\frac{4+(-2)}{2}\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q16-b",
        "type": "group",
        "label": "b",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p26-q16-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Expand and simplify $f(1+h)$ and $f(1-h)$. What do you notice?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(1+h)=h^2-9$ and $f(1-h)=h^2-9$. They are equal.",
              "worked": "$$\\begin{align*}f(1+h)&=(1+h)^2-2(1+h)-8\\\\f(1+h)&=1+2h+h^2-2-2h-8\\\\f(1+h)&=h^2-9\\\\f(1-h)&=(1-h)^2-2(1-h)-8\\\\f(1-h)&=1-2h+h^2-2+2h-8\\\\f(1-h)&=h^2-9\\end{align*}$$\nThus $f(1+h)=f(1-h)$ for every real $h$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 60
          },
          {
            "id": "p26-q16-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What geometric feature of the parabola does this result demonstrate?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The parabola is symmetric about the line $x=1$.",
              "worked": "The inputs $1+h$ and $1-h$ are equally far from $x=1$ and have equal function values. Their points on the parabola are reflections in the line $x=1$, demonstrating its axis of symmetry.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      }
    ]
  },
