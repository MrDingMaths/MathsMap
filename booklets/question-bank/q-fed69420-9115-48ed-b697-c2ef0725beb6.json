        "answer": {
          "short": "$0,\\ 0.7,\\ 1,\\ 1.4,\\ 1.7,\\ 2,\\ 2.2$, in table order.",
          "worked": "$$\\begin{align*}R(0)&=\\sqrt0=0\\\\R\\left(\\frac12\\right)&=\\sqrt{\\frac12}\\approx0.7\\\\R(1)&=\\sqrt1=1\\\\R(2)&=\\sqrt2\\approx1.4\\\\R(3)&=\\sqrt3\\approx1.7\\\\R(4)&=\\sqrt4=2\\\\R(5)&=\\sqrt5\\approx2.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
