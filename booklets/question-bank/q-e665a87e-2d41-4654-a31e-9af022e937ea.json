    "type": "question",
    "label": "18",
    "prompt": "Show algebraically that ${}^{n}P_n={}^{n}P_{n-1}=n!$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "${}^{n}P_n=\\dfrac{n!}{0!}=n!$ and ${}^{n}P_{n-1}=\\dfrac{n!}{1!}=n!$.",
      "worked": "$$\\begin{align*}{}^{n}P_n&=\\frac{n!}{(n-n)!}\\\\&=\\frac{n!}{0!}\\\\&=n!\\end{align*}$$\n$$\\begin{align*}{}^{n}P_{n-1}&=\\frac{n!}{(n-(n-1))!}\\\\&=\\frac{n!}{1!}\\\\&=n!\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
