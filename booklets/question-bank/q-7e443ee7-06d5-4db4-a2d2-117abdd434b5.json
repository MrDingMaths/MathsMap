    "children": [
      {
        "id": "p5-q1-5-a",
        "type": "part",
        "label": "a",
        "prompt": "True bearings are measured from the North.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "A true bearing is measured clockwise from North.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p5-q1-5-b",
        "type": "part",
        "label": "b",
        "prompt": "True bearings are measured anti-clockwise.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "True bearings are measured clockwise from North.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p5-q1-5-c",
        "type": "part",
        "label": "c",
        "prompt": "True bearings are always given using three digits.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True bearings use three digits, including leading zeros when needed; for example, $065^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p5-q1-5-d",
        "type": "part",
        "label": "d",
        "prompt": "Compass bearings start with either $N$ or $S$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "A compass bearing measures an acute angle from North or South towards East or West.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p5-q1-5-e",
        "type": "part",
        "label": "e",
        "prompt": "The permitted range for the angle $\\theta$ in a compass bearing is $[0^\\circ,90^\\circ]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False; $0^\\circ<\\theta<90^\\circ$.",
          "worked": "The source convention requires an acute angle: $0^\\circ<\\theta<90^\\circ$. At the endpoints, use the cardinal direction $N$, $E$, $S$ or $W$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
