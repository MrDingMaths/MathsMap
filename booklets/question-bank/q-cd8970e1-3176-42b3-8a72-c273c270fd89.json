        "label": "",
        "prompt": "Calculate David’s gross (total) pay for last week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$414",
          "worked": "Deduct each unpaid break from the shift length.\n$$\\begin{align*}\n\\text{Friday hours} &= 4.5-0.5=4\\text{ h}\\\\\n\\text{Saturday hours} &= 7-1=6\\text{ h}\\\\\n\\text{Sunday hours} &= 6-1=5\\text{ h}\\\\\n\\text{Friday pay} &= 18\\times4=\\$72\\\\\n\\text{Saturday pay} &= 18\\times6\\times1.5=\\$162\\\\\n\\text{Sunday pay} &= 18\\times5\\times2=\\$180\\\\\n\\text{Gross pay} &= 72+162+180\\\\\n\\text{Gross pay} &= \\$414\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-q30-task2",
        "type": "part",
        "label": "",
        "prompt": "David decides not to work on Saturdays. He wants to keep his weekly gross pay the same.\nHow many extra hours at the weekday rate must he work?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 hours",
          "worked": "Replace the Saturday earnings with weekday earnings.\n$$\\begin{align*}\n\\text{Saturday pay} &= 18\\times6\\times1.5=\\$162\\\\\n\\text{Extra weekday hours} &= \\frac{162}{18}\\\\\n\\text{Extra weekday hours} &= 9\\text{ h}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
