  "content": {
    "id": "p26-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The general form of a quadratic with zeroes $x=2$ and $x=8$ is $y=a(x-2)(x-8)$. Find the equation of such a quadratic for which:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "the coefficient of $x^2$ is $3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3(x-2)(x-8)$",
          "worked": "The coefficient of $x^2$ in $a(x-2)(x-8)$ is $a$.\n$$\\begin{align*}a&=3\\\\y&=3(x-2)(x-8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p26-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "the $y$-intercept is $-16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-2)(x-8)$",
          "worked": "Substitute $(0,-16)$.\n$$\\begin{align*}-16&=a(0-2)(0-8)\\\\-16&=16a\\\\a&=-1\\\\y&=-(x-2)(x-8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p26-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "the vertex is $(5,-12)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{4}{3}(x-2)(x-8)$",
          "worked": "Substitute the vertex $(5,-12)$.\n$$\\begin{align*}-12&=a(5-2)(5-8)\\\\-12&=-9a\\\\a&=\\frac{4}{3}\\\\y&=\\frac{4}{3}(x-2)(x-8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p26-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "the curve passes through $(1,-20)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{20}{7}(x-2)(x-8)$",
          "worked": "Substitute $(1,-20)$.\n$$\\begin{align*}-20&=a(1-2)(1-8)\\\\-20&=7a\\\\a&=-\\frac{20}{7}\\\\y&=-\\frac{20}{7}(x-2)(x-8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
