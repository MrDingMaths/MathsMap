  "content": {
    "id": "p11-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "$\\$540$ is divided among three people $A$, $B$ and $C$, so that $A$ gets three times as much as $C$, and $B$ gets twice as much as $C$. How much does $C$ get?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$90$",
      "worked": "Let $x$ dollars be the amount $C$ gets. Then $A$ gets $3x$ dollars and $B$ gets $2x$ dollars.\n\n$$\\begin{align*}3x+2x+x&=540\\\\6x&=540\\\\x&=90\\end{align*}$$\n\nTherefore, $C$ gets $\\$90$.",
      "solutionDiagrams": []
    },
