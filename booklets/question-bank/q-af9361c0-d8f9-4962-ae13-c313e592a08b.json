    "id": "p3-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Draw a right-angled triangle with angle $\\theta$ for which $\\tan\\theta=\\frac43$. Find $\\cos\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\cos\\theta=\\frac35$",
      "worked": "Choose opposite side $4$ and adjacent side $3$.\n$$\\begin{align*}h^2&=4^2+3^2\\\\h^2&=25\\\\h&=5\\\\\\cos\\theta&=\\frac35\\end{align*}$$",
