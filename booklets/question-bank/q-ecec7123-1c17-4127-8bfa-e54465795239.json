      {
        "id": "index-t6-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$3x^{2}y \\times 4x^{3}y^{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x^{5}y^{5}$",
          "worked": "$$\\begin{align*}\n3x^{2}y \\times 4x^{3}y^{4} &= 3\\times4\\,x^{2 + 3}\\,y^{1 + 4} \\\\\n&= 12x^{5}y^{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{12m^{7}n^{4}}{4m^{2}n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3m^{5}n^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{12m^{7}n^{4}}{4m^{2}n} &= \\frac{12\\,m^{7 - 2}\\,n^{4 - 1}}{4} \\\\\n&= 3m^{5}n^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$2xy^{3} \\times 6x^{4}y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x^{5}y^{4}$",
          "worked": "$$\\begin{align*}\n2xy^{3} \\times 6x^{4}y &= 2\\times6\\,x^{1 + 4}\\,y^{3 + 1} \\\\\n&= 12x^{5}y^{4}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$5a^{4}b^{2} \\times 2ab^{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10a^{5}b^{7}$",
          "worked": "$$\\begin{align*}\n5a^{4}b^{2} \\times 2ab^{5} &= 5\\times2\\,a^{4 + 1}\\,b^{2 + 5} \\\\\n&= 10a^{5}b^{7}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{20p^{3}q^{5}}{5pq^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4p^{2}q^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{20p^{3}q^{5}}{5pq^{2}} &= \\frac{20\\,p^{3 - 1}\\,q^{5 - 2}}{5} \\\\\n&= 4p^{2}q^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{15a^{9}b^{3}}{3a^{4}b^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5a^{5}b$",
          "worked": "$$\\begin{align*}\n\\frac{15a^{9}b^{3}}{3a^{4}b^{2}} &= \\frac{15\\,a^{9 - 4}\\,b^{3 - 2}}{3} \\\\\n&= 5a^{5}b\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
