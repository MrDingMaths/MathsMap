    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x+4}{5}+\\frac{x-5}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8x-13}{15}$",
          "worked": "$$\\begin{align*}\\frac{x+4}{5}+\\frac{x-5}{3}&=\\frac{3(x+4)+5(x-5)}{15}\\\\\\frac{x+4}{5}+\\frac{x-5}{3}&=\\frac{3x+12+5x-25}{15}\\\\\\frac{x+4}{5}+\\frac{x-5}{3}&=\\frac{8x-13}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{5}{x+4}+\\frac{3}{x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8x-13}{(x+4)(x-5)}$",
          "worked": "$$\\begin{align*}\\frac{5}{x+4}+\\frac{3}{x-5}&=\\frac{5(x-5)+3(x+4)}{(x+4)(x-5)}\\\\\\frac{5}{x+4}+\\frac{3}{x-5}&=\\frac{5x-25+3x+12}{(x+4)(x-5)}\\\\\\frac{5}{x+4}+\\frac{3}{x-5}&=\\frac{8x-13}{(x+4)(x-5)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x+1}{2}-\\frac{x-4}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x+13}{10}$",
          "worked": "$$\\begin{align*}\\frac{x+1}{2}-\\frac{x-4}{5}&=\\frac{5(x+1)-2(x-4)}{10}\\\\\\frac{x+1}{2}-\\frac{x-4}{5}&=\\frac{5x+5-2x+8}{10}\\\\\\frac{x+1}{2}-\\frac{x-4}{5}&=\\frac{3x+13}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{x+1}-\\frac{5}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-3x-13}{(x+1)(x-4)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x+1}-\\frac{5}{x-4}&=\\frac{2(x-4)-5(x+1)}{(x+1)(x-4)}\\\\\\frac{2}{x+1}-\\frac{5}{x-4}&=\\frac{2x-8-5x-5}{(x+1)(x-4)}\\\\\\frac{2}{x+1}-\\frac{5}{x-4}&=\\frac{-3x-13}{(x+1)(x-4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x}{2}-\\frac{x+3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-3}{4}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}-\\frac{x+3}{4}&=\\frac{2x-(x+3)}{4}\\\\\\frac{x}{2}-\\frac{x+3}{4}&=\\frac{2x-x-3}{4}\\\\\\frac{x}{2}-\\frac{x+3}{4}&=\\frac{x-3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2}{x}-\\frac{4}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-2x+6}{x(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x}-\\frac{4}{x+3}&=\\frac{2(x+3)-4x}{x(x+3)}\\\\\\frac{2}{x}-\\frac{4}{x+3}&=\\frac{2x+6-4x}{x(x+3)}\\\\\\frac{2}{x}-\\frac{4}{x+3}&=\\frac{-2x+6}{x(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
