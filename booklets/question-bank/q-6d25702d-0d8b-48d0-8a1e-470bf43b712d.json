  "content": {
    "id": "p21-q13",
    "type": "question",
    "label": "13",
    "prompt": "Heidi’s funds in a superannuation scheme have a future value of $\\$740\\,000$ in 20 years’ time. The interest rate is 4% per annum and earnings are calculated six-monthly.\n\nWhat single amount could be invested now to produce the same result over the same period at the same interest rate? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$335\\,138.91$",
      "worked": "The rate per period is $r=0.04\\div2=0.02$ and the number of periods is $n=20\\times2=40$.\n\n$$\\begin{align*}FV&=PV(1+r)^n\\\\740\\,000&=PV\\left(1+\\frac{0.04}{2}\\right)^{20\\times2}\\\\PV&=\\frac{740\\,000}{(1.02)^{40}}\\\\PV&\\approx\\$335\\,138.91\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
