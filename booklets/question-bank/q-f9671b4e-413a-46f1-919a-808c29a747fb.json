  "content": {
    "id": "v2-c0487-p28-practice-slot-20-root",
    "type": "question",
    "label": null,
    "prompt": "Priya is a sales representative. She earns a basic wage of \\$1200 per month and receives commission on all sales. Last month she sold \\$45 000 worth of goods and earned \\$2550.\nWhat was Priya’s rate of commission?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\%$",
      "worked": "Let $r$ be the commission rate as a decimal.\n$$\\begin{align*}\\text{Pay} &= \\text{Retainer} + r\\times\\text{Sales}\\\\2550 &= 1200 + r\\times45\\,000\\\\1350 &= r\\times45\\,000\\\\r &= \\frac{1350}{45\\,000}\\\\r &= 0.03\\end{align*}$$\nPriya’s rate of commission is $3\\%$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
