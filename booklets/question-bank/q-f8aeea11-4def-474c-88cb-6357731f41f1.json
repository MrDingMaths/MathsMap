              "type": "text",
              "text": "Exam results are normally distributed with mean 68 and standard deviation 9.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "In a cohort of 2000, how many students will score:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "more than 95",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 3 students.",
          "worked": "$$\\begin{aligned}z&=\\frac{95-68}{9}=3\\\\P(Z>3)&\\approx0.0015\\\\\\text{Expected number}&=0.0015\\times2000=3\\text{ students}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p41-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "less than 50",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 50 students.",
          "worked": "$$\\begin{aligned}z&=\\frac{50-68}{9}=-2\\\\P(Z<-2)&\\approx0.025\\\\\\text{Expected number}&=0.025\\times2000=50\\text{ students}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p41-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "between 59 and 86?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 1630 students.",
          "worked": "$$\\begin{aligned}z(59)&=\\frac{59-68}{9}=-1\\\\z(86)&=\\frac{86-68}{9}=2\\\\P(-1<Z<2)&\\approx0.34+0.475=0.815\\\\\\text{Expected number}&=0.815\\times2000=1630\\text{ students}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
