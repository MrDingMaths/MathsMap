  "content": {
    "id": "p8-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Express each of the following as a single fraction.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x+1}{4}+\\frac{x+3}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7x+15}{12}$",
          "worked": "$$\\begin{align*}\\frac{x+1}{4}+\\frac{x+3}{3}&=\\frac{3(x+1)+4(x+3)}{12}\\\\\\frac{x+1}{4}+\\frac{x+3}{3}&=\\frac{3x+3+4x+12}{12}\\\\\\frac{x+1}{4}+\\frac{x+3}{3}&=\\frac{7x+15}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{x-2}{2}+\\frac{x-1}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x-8}{6}$",
          "worked": "$$\\begin{align*}\\frac{x-2}{2}+\\frac{x-1}{3}&=\\frac{3(x-2)+2(x-1)}{6}\\\\\\frac{x-2}{2}+\\frac{x-1}{3}&=\\frac{3x-6+2x-2}{6}\\\\\\frac{x-2}{2}+\\frac{x-1}{3}&=\\frac{5x-8}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{2x+1}{3}-\\frac{x+1}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x+1}{12}$",
          "worked": "$$\\begin{align*}\\frac{2x+1}{3}-\\frac{x+1}{4}&=\\frac{4(2x+1)-3(x+1)}{12}\\\\\\frac{2x+1}{3}-\\frac{x+1}{4}&=\\frac{8x+4-3x-3}{12}\\\\\\frac{2x+1}{3}-\\frac{x+1}{4}&=\\frac{5x+1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{3x-1}{4}-\\frac{2x-1}{6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x-1}{12}$",
          "worked": "$$\\begin{align*}\\frac{3x-1}{4}-\\frac{2x-1}{6}&=\\frac{3(3x-1)-2(2x-1)}{12}\\\\\\frac{3x-1}{4}-\\frac{2x-1}{6}&=\\frac{9x-3-4x+2}{12}\\\\\\frac{3x-1}{4}-\\frac{2x-1}{6}&=\\frac{5x-1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
