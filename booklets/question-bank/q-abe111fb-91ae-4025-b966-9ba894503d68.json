  "content": {
    "id": "p22-q67-root",
    "type": "question",
    "label": "19",
    "prompt": "Let $x=\\dfrac{3-\\sqrt2}{3+\\sqrt2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q67-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $x$ with a rational denominator.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{11-6\\sqrt2}{7}$",
          "worked": "$$\\begin{align*}x&=\\frac{(3-\\sqrt2)^2}{(3+\\sqrt2)(3-\\sqrt2)}\\\\x&=\\frac{9-6\\sqrt2+2}{9-2}\\\\x&=\\frac{11-6\\sqrt2}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q67-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, show that $x+\\dfrac1x$ is a rational number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p22-q67-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x+\\frac1x=\\frac{22}{7}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", which is rational.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p22-q67-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Rationalise the reciprocal and add it to part (a); the surd terms cancel.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac1x&=\\frac{3+\\sqrt2}{3-\\sqrt2}\\\\\\frac1x&=\\frac{(3+\\sqrt2)^2}{9-2}\\\\\\frac1x&=\\frac{11+6\\sqrt2}{7}\\end{align*}$$\nUsing part (a),\n$$\\begin{align*}x+\\frac1x&=\\frac{11-6\\sqrt2}{7}+\\frac{11+6\\sqrt2}{7}\\\\x+\\frac1x&=\\frac{22}{7}\\end{align*}$$\nThis is a ratio of integers with nonzero denominator, so it is rational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
