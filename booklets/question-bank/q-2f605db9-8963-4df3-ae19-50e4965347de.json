    "children": [
      {
        "id": "p9-q2-explain",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $-2x-4$ is incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2(x-2)=-2x+4$; both terms must be multiplied by $-2$.",
          "worked": "Both terms inside the brackets must be multiplied by $-2$. The constant term is $(-2)(-2)=4$, so $-2(x-2)=-2x+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q2-simplify",
        "type": "part",
        "label": "b",
        "prompt": "Hence simplify the fractions correctly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{33x+4}{10}$",
          "worked": "$$\\begin{align*}\\frac{7x}{2}-\\frac{x-2}{5}&=\\frac{35x}{10}-\\frac{2(x-2)}{10}\\\\&=\\frac{35x-2(x-2)}{10}\\\\&=\\frac{35x-2x+4}{10}\\\\&=\\frac{33x+4}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
