                        "type": "math",
                        "latex": "\\begin{aligned}\\frac{7x}{2}-\\frac{x-2}{5}&=\\frac{35x}{10}-\\frac{2(x-2)}{10}\\\\&=\\frac{35x+{\\color{#ef6068}\\boxed{-2x-4}}}{10}\\\\&=\\frac{33x-4}{10}\\end{aligned}",
                        "display": true
                      }
                    ]
                  },
