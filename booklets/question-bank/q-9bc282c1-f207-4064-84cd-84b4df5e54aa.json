      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "For a fixed distance, to which variable is time inversely proportional?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Speed, $S$.",
          "worked": "With $D$ fixed, $T=\\dfrac{D}{S}$, so time is inversely proportional to speed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "For a fixed distance, to which variable is speed inversely proportional?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Time, $T$.",
          "worked": "With $D$ fixed, $S=\\dfrac{D}{T}$, so speed is inversely proportional to time.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q4-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p8-q4-c-intro",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Suppose distance is constant, so the relationship between speed and time is",
                  "marks": []
                }
              ]
            },
            {
              "id": "p8-q4-c-formula",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "T=\\frac{k}{S}.",
                  "display": false
                }
              ]
            },
            {
              "id": "p8-q4-c-data",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "It takes 3 hours to travel to a destination at 100 km/hr. Find the value of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "k",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=300$.",
          "worked": "$$\\begin{align*}k&=ST\\\\k&=100\\times3\\\\k&=300\\end{align*}$$The constant represents the journey's distance, $300\\text{ km}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "How long will the same journey take at 120 km/hr instead?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\dfrac12$ hours.",
          "worked": "$$\\begin{align*}T&=\\frac{300}{S}\\\\T&=\\frac{300}{120}\\\\T&=\\frac52\\text{ hours}\\end{align*}$$The journey takes $2\\dfrac12$ hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p8-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "The journey takes 4 hours, what was the speed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75\\text{ km/h}$.",
          "worked": "$$\\begin{align*}S&=\\frac{300}{T}\\\\S&=\\frac{300}{4}\\\\S&=75\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
