    "label": "19",
    "prompt": "Write down the factors of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$111$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\ 3,\\ 37,\\ 111$",
          "worked": "$$\\begin{align*}111&=1\\times111\\\\111&=3\\times37\\end{align*}$$\n\nSince $3$ and $37$ are prime, the factors are $1,3,37,111$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$1001$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\ 7,\\ 11,\\ 13,\\ 77,\\ 91,\\ 143,\\ 1001$",
          "worked": "$$\\begin{align*}1001&=7\\times143\\\\1001&=7\\times11\\times13\\end{align*}$$\n\nThe factor pairs are\n$$\\begin{align*}1001&=1\\times1001\\\\1001&=7\\times143\\\\1001&=11\\times91\\\\1001&=13\\times77\\end{align*}$$\n\nThe factors are $1,7,11,13,77,91,143,1001$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p25-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$1111$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\ 11,\\ 101,\\ 1111$",
          "worked": "$$\\begin{align*}1111&=1\\times1111\\\\1111&=11\\times101\\end{align*}$$\n\nBoth $11$ and $101$ are prime. For $101$, none of $2,3,5,7$ divides it, and $\\sqrt{101}<11$.\n\nThe factors are $1,11,101,1111$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
