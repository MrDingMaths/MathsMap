    "type": "question",
    "label": "22",
    "prompt": "Find the time $T$ involved in each simple interest investment.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Interest of $\\$2500$ on $\\$1000$ at $5\\%$ p.a.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50 years",
          "worked": "$$\\begin{align*}I&=PRT\\\\2500&=1000\\times0.05\\times T\\\\2500&=50T\\\\T&=\\frac{2500}{50}\\\\T&=50\\text{ years}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Interest of $\\$91\\,200$ on $\\$30\\,000$ at $8\\%$ p.a.",
        "layout": "list",
