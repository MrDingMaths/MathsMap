    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $(x^3+1)^2$ by first expanding and then differentiating term-by-term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^5+6x^2$",
          "worked": "$$(x^3+1)^2=x^6+2x^3+1$$\n$$\\begin{align*}\\frac{d}{dx}(x^3+1)^2&=\\frac{d}{dx}(x^6+2x^3+1)\\\\\\frac{d}{dx}(x^3+1)^2&=6x^5+6x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Differentiate $(x^3+1)^2$ using the chain rule.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2(x^3+1)$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(x^3+1)^2&=2(x^3+1)\\times3x^2\\\\\\frac{d}{dx}(x^3+1)^2&=6x^2(x^3+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p14-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Verify that the answers in (a) and (b) are the same.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2(x^3+1)=6x^5+6x^2$",
          "worked": "$$6x^2(x^3+1)=6x^5+6x^2$$\nExpanding the answer in (b) gives the answer in (a).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
