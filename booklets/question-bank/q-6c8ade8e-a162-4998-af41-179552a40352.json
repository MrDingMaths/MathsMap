  "content": {
    "id": "p12-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "Find $A\\cup B$ and $A\\cap B$ for each pair of sets.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\{1,3,5\\}$, $B=\\{3,5,7\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{1,3,5,7\\}$; $A\\cap B=\\{3,5\\}$.",
          "worked": "The union contains every element in either set, listed once. The intersection contains the elements common to both sets.\n\n$$\\begin{aligned}A\\cup B&=\\{1,3,5,7\\}\\\\A\\cap B&=\\{3,5\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\{1,3,4,8,9\\}$, $B=\\{2,4,5,6,9,10\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{1,2,3,4,5,6,8,9,10\\}$; $A\\cap B=\\{4,9\\}$.",
          "worked": "List every element in either set once for the union. Only $4$ and $9$ occur in both sets.\n\n$$\\begin{aligned}A\\cup B&=\\{1,2,3,4,5,6,8,9,10\\}\\\\A\\cap B&=\\{4,9\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "$A=\\{h,o,b,a,r,t\\}$, $B=\\{b,i,c,h,e,n,o\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{h,o,b,a,r,t,i,c,e,n\\}$; $A\\cap B=\\{h,o,b\\}$.",
          "worked": "Combine the letters without repetition for the union. The letters $h$, $o$ and $b$ occur in both sets.\n\n$$\\begin{aligned}A\\cup B&=\\{h,o,b,a,r,t,i,c,e,n\\}\\\\A\\cap B&=\\{h,o,b\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-d",
        "type": "part",
        "label": "d",
        "prompt": "$A=\\{j,a,c,k\\}$, $B=\\{e,m,m,a\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{j,a,c,k,e,m\\}$; $A\\cap B=\\{a\\}$.",
          "worked": "The repeated $m$ represents one element. Combine the distinct letters for the union; only $a$ occurs in both sets.\n\n$$\\begin{aligned}A\\cup B&=\\{j,a,c,k,e,m\\}\\\\A\\cap B&=\\{a\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-e",
        "type": "part",
        "label": "e",
        "prompt": "$A=\\{\\text{prime numbers less than }10\\}$, $B=\\{\\text{odd numbers less than }10\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{1,2,3,5,7,9\\}$; $A\\cap B=\\{3,5,7\\}$.",
          "worked": "$$\\begin{aligned}A&=\\{2,3,5,7\\}\\\\B&=\\{1,3,5,7,9\\}\\end{aligned}$$\n\nList every element in either set once for the union, and the elements common to both for the intersection.\n\n$$\\begin{aligned}A\\cup B&=\\{1,2,3,5,7,9\\}\\\\A\\cap B&=\\{3,5,7\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
