  "content": {
    "id": "p15-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "A certain number has sixty factors, including $6,7,8,9$ and $10$. Determine the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p15-q20-short-result",
