  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A number, $x$, is multiplied by $\\frac{4}{7}$, and 5 is subtracted from the result. Write this using algebraic notation. If $x=10$, find the final result.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{4x}{7}-5$; when $x=10$, $\\frac{5}{7}$.",
      "worked": "The algebraic expression is $\\frac{4x}{7}-5$.\n\nFor $x=10$:\n$$\\begin{align*}\\frac{4x}{7}-5&=\\frac{4\\times10}{7}-5\\\\\\frac{4x}{7}-5&=\\frac{40}{7}-\\frac{35}{7}\\\\\\frac{4x}{7}-5&=\\frac{5}{7}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
