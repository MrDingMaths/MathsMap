  "content": {
    "id": "p10-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Consider the sample space $\\Omega=\\{1,2,\\ldots,10\\}$ and events $A=\\{5,6,7,8\\}$ and $B=\\{1,2,5,7,9\\}$. An element from $\\Omega$ is randomly chosen. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\Pr(A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "There are four outcomes in $A$ out of ten equally likely outcomes.\n$$\\begin{align*}\\Pr(A)&=\\frac{4}{10}\\\\\\Pr(A)&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\Pr(B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "There are five outcomes in $B$ out of ten equally likely outcomes.\n$$\\begin{align*}\\Pr(B)&=\\frac{5}{10}\\\\\\Pr(B)&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\Pr(A\\cap B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$A\\cap B=\\{5,7\\}$ contains two outcomes.\n$$\\begin{align*}\\Pr(A\\cap B)&=\\frac{2}{10}\\\\\\Pr(A\\cap B)&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\Pr(A\\cup B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{10}$",
          "worked": "$A\\cup B=\\{1,2,5,6,7,8,9\\}$ contains seven outcomes; common elements are counted once.\n$$\\Pr(A\\cup B)=\\frac{7}{10}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
