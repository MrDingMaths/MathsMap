  "content": {
    "id": "p17-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A rectangle has length $9\\text{ cm}$ and width $4\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p17-q10-feedback-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\": 1, \"kind\": \"geometry\", \"base\": [], \"semantic\": [], \"reference\": \"Authorised feedback p17-q10-feedback-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=2pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.8pt] (0,0) rectangle (38,23);\n\\node[below] at (19.0,0) {$9\\,\\mathrm{cm}$};\n\\node[right] at (38,11.5) {$4\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 58,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p17-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A &= lw\\\\A &= 9\\times4\\\\A &= 36\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "The length increases by $1\\text{ cm}$. By how much does the area increase?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\times4=40\\text{ cm}^2$. Increase $=4\\text{ cm}^2$.",
          "worked": "$$\\begin{align*}A_{\\text{new}} &= (9+1)\\times4\\\\A_{\\text{new}} &= 40\\text{ cm}^2\\\\\\text{Increase} &= 40-36\\\\\\text{Increase} &= 4\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "The width increases by $1\\text{ cm}$ instead. By how much does the area increase?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\times5=45\\text{ cm}^2$. Increase $=9\\text{ cm}^2$.",
          "worked": "$$\\begin{align*}A_{\\text{new}} &= 9\\times(4+1)\\\\A_{\\text{new}} &= 45\\text{ cm}^2\\\\\\text{Increase} &= 45-36\\\\\\text{Increase} &= 9\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Which dimension gives a greater area increase when increased by $1\\text{ cm}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The width (the smaller dimension): increasing it gives an increase of $9\\text{ cm}^2$, compared with $4\\text{ cm}^2$ for the length.",
          "worked": "Increasing the width gives an area increase of $9\\text{ cm}^2$. Increasing the length gives an increase of $4\\text{ cm}^2$. Therefore increasing the width gives the greater increase.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "Should you increase the smaller dimension or the larger dimension to get the greatest area increase?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The smaller dimension.",
          "worked": "Increase the smaller dimension. For the same increase in a dimension, the area increase equals that increase multiplied by the other dimension. Increasing the smaller dimension therefore gives the greater area increase.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
