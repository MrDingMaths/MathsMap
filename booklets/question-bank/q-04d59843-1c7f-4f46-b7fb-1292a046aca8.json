  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A piece of land is divided among Jan, David and Greg. Jan is allocated $\\frac{7}{12}$ of the land and David receives $\\frac{1}{6}$ of the land.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the land does Greg receive?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}1-\\frac{7}{12}-\\frac{1}{6}&=\\frac{12}{12}-\\frac{7}{12}-\\frac{2}{12}\\\\1-\\frac{7}{12}-\\frac{1}{6}&=\\frac{3}{12}=\\frac{1}{4}\\end{align*}$$\nGreg receives $\\frac{1}{4}$ of the land.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "The land is worth $\\$96000$. What is the value of each person’s share?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jan: $\\$56000$; David: $\\$16000$; Greg: $\\$24000$.",
          "worked": "Jan: $\\frac{7}{12}\\times\\$96000=7\\times\\$8000=\\$56000$.\n\nDavid: $\\frac{1}{6}\\times\\$96000=\\$16000$.\n\nGreg: $\\frac{1}{4}\\times\\$96000=\\$24000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
