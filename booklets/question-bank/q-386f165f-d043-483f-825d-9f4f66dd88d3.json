  "content": {
    "id": "p20-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "At an agricultural show in the 1950s, freshly hatched chickens were dyed yellow, red and blue. The ratio of the numbers of the different-coloured chickens was yellow : red : blue $=6:4:5$. If there were 45 chickens in total, how many were there of each colour?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "18 yellow, 12 red and 15 blue chickens.",
      "worked": "There are $6+4+5=15$ parts in total.\n\n$$\\begin{align*}\\text{Chickens in one part}&=45\\div15\\\\\\text{Chickens in one part}&=3\\\\\\text{Yellow chickens}&=6\\times3=18\\\\\\text{Red chickens}&=4\\times3=12\\\\\\text{Blue chickens}&=5\\times3=15\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
