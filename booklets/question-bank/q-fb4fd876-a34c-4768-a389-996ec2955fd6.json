  "content": {
    "id": "p8-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A person's weight is measured as $79.3\\text{ kg}$. What is the absolute error of this measurement?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.05\\text{ kg}$",
      "worked": "$$\\begin{align*}\\text{Precision}&=0.1\\text{ kg}\\\\\\text{Absolute error}&=\\tfrac12\\times0.1=0.05\\text{ kg}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 16
  },
