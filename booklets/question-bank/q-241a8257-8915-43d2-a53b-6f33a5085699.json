  "content": {
    "id": "p20-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Explain why all terminating decimals are rational numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q4-explanation",
        "type": "part",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A terminating decimal can be written as an integer over a power of $10$.",
          "worked": "A terminating decimal has finitely many decimal places. Multiplying it by a suitable power of $10$ gives an integer, so it can be written as a fraction with integer numerator and non-zero integer denominator.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8,
        "responseSpace": "scaffold"
      },
      {
        "id": "p20-q4-conversions",
        "type": "group",
        "label": "",
        "prompt": "Write these terminating decimals in the form $\\frac{a}{b}$ where $a$ and $b$ are integers.",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q4-a",
            "type": "part",
            "label": "b",
            "prompt": "$0.4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{5}$",
              "worked": "$$\\begin{align*}0.4&=\\frac{4}{10}\\\\0.4&=\\frac{2}{5}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p20-q4-b",
            "type": "part",
            "label": "c",
            "prompt": "$0.42$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{21}{50}$",
              "worked": "$$\\begin{align*}0.42&=\\frac{42}{100}\\\\0.42&=\\frac{21}{50}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p20-q4-c",
            "type": "part",
            "label": "d",
            "prompt": "$0.425$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{17}{40}$",
              "worked": "$$\\begin{align*}0.425&=\\frac{425}{1000}\\\\0.425&=\\frac{17}{40}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p20-q4-d",
            "type": "part",
            "label": "e",
            "prompt": "$-1.0008$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\frac{1251}{1250}$",
              "worked": "$$\\begin{align*}-1.0008&=-\\frac{10008}{10000}\\\\-1.0008&=-\\left(1+\\frac{8}{10000}\\right)\\\\-1.0008&=-\\left(1+\\frac{1}{1250}\\right)\\\\-1.0008&=-\\frac{1251}{1250}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
