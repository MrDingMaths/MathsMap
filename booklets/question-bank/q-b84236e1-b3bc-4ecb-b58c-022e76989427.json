  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Make $x$ the subject of these formulas.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\frac{x}{a}+c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a(y-c)$",
          "worked": "$$\\begin{align*}y-c&=\\frac{x}{a}\\\\a(y-c)&=x\\\\x&=a(y-c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-\\frac{x}{a}+c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-a(y-c)$",
          "worked": "$$\\begin{align*}y-c&=-\\frac{x}{a}\\\\-a(y-c)&=x\\\\x&=-a(y-c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{x}{a^{2}}-c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a^{2}(y+c)$",
          "worked": "$$\\begin{align*}y+c&=\\frac{x}{a^{2}}\\\\a^{2}(y+c)&=x\\\\x&=a^{2}(y+c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=-\\frac{x}{a^{2}}-c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-a^{2}(y+c)$",
          "worked": "$$\\begin{align*}y+c&=-\\frac{x}{a^{2}}\\\\-a^{2}(y+c)&=x\\\\x&=-a^{2}(y+c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{x}{bc}+\\sqrt{qrs}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=bc(y-\\sqrt{qrs})$",
          "worked": "$$\\begin{align*}y-\\sqrt{qrs}&=\\frac{x}{bc}\\\\bc(y-\\sqrt{qrs})&=x\\\\x&=bc(y-\\sqrt{qrs})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=-\\frac{x}{bc}-\\sqrt{qrs}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-bc(y+\\sqrt{qrs})$",
          "worked": "$$\\begin{align*}y+\\sqrt{qrs}&=-\\frac{x}{bc}\\\\-bc(y+\\sqrt{qrs})&=x\\\\x&=-bc(y+\\sqrt{qrs})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
