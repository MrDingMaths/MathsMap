  "content": {
    "id": "p13-q4",
    "type": "question",
    "label": "4",
    "prompt": "Consider a quadrilateral $ABCD$. $A(4,9)$, $B(0,4)$, $C(-2,3)$ and $D(2,8)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q4a",
        "type": "part",
        "label": "a",
        "prompt": "Find the midpoint of the interval joining $A(4,9)$ and $C(-2,3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,6)$",
          "worked": "$$\\begin{align*}\\text{Midpoint of }AC&=\\left(\\frac{4+(-2)}{2},\\frac{9+3}{2}\\right)=(1,6)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q4b",
        "type": "part",
        "label": "b",
        "prompt": "Find the midpoint of the interval joining $B(0,4)$ and $D(2,8)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,6)$",
          "worked": "$$\\begin{align*}\\text{Midpoint of }BD&=\\left(\\frac{0+2}{2},\\frac{4+8}{2}\\right)=(1,6)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q4c",
        "type": "part",
        "label": "c",
        "prompt": "What can you conclude about the diagonals of the quadrilateral?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The diagonals bisect each other.",
          "worked": "Both diagonals have midpoint $(1,6)$, so the diagonals bisect each other.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p13-q4d",
        "type": "part",
        "label": "d",
        "prompt": "Explain why $ABCD$ must be a parallelogram.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Its diagonals bisect each other, so $ABCD$ is a parallelogram.",
          "worked": "Since the diagonals bisect each other, $ABCD$ is a parallelogram.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
