    "type": "question",
    "label": "16",
    "prompt": "The expression $\\dfrac{6x+k}{3}$ simplifies to $2x+4$. Find $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=12$",
      "worked": "$$\\begin{align*}\\frac{6x+k}{3}&=2x+\\frac{k}{3}\\\\\\frac{k}{3}&=4\\\\k&=12\\end{align*}$$",
      "solutionDiagrams": []
