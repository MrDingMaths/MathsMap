  "content": {
    "id": "p4-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A ginger cat is sitting on a thin railing 2 metres horizontally from a desk lamp, producing a shadow of the cat on a wall 3 metres behind the cat. What is the enlargement factor of the shadow with respect to the profile of the cat?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{5}{2}$",
      "worked": "The lamp is the centre of enlargement. The lamp-to-wall distance is $2+3=5\\text{ m}$.\n\n$$\\begin{align*}k&=\\frac{\\text{distance from lamp to wall}}{\\text{distance from lamp to cat}}\\\\k&=\\frac{5}{2}=2.5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 27
