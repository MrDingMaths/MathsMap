  "content": {
    "id": "p13-q13",
    "type": "question",
    "label": "13",
    "prompt": "The speed of light in a vacuum is $299\\,792\\,458\\text{ m/s}$. Round this number to:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q13-rounding",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q13-a",
            "type": "part",
            "label": "a",
            "prompt": "1 s.f.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$300\\,000\\,000\\text{ m/s}$ (1 s.f.)",
              "worked": "The first significant digit is $2$, in the hundred millions place. The next digit is $9$, so round up.\n$$299\\,792\\,458\\text{ m/s}\\approx300\\,000\\,000\\text{ m/s}\\quad(1\\text{ s.f.})$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p13-q13-b",
            "type": "part",
            "label": "b",
            "prompt": "2 s.f.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$300\\,000\\,000\\text{ m/s}$ (2 s.f.)",
              "worked": "The second significant digit is $9$, in the ten millions place. The next digit is $9$, so round up.\n$$299\\,792\\,458\\text{ m/s}\\approx300\\,000\\,000\\text{ m/s}\\quad(2\\text{ s.f.})$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p13-q13-c",
            "type": "part",
            "label": "c",
            "prompt": "3 s.f.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$300\\,000\\,000\\text{ m/s}$ (3 s.f.)",
              "worked": "The third significant digit is $9$, in the millions place. The next digit is $7$, so round up.\n$$299\\,792\\,458\\text{ m/s}\\approx300\\,000\\,000\\text{ m/s}\\quad(3\\text{ s.f.})$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p13-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All three rounded values are the same.",
          "worked": "Rounding to 1, 2 or 3 significant figures gives the same numerical value, $300\\,000\\,000\\text{ m/s}$, although the stated precision differs.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
