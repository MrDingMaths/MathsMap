    "type": "question",
    "label": "38",
    "prompt": "Rewrite each non-monic quadratic expression in completed square form, $a(x+h)^2+k$, where $a\\ne1$.\n$$5x^2+10x+2$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5(x+1)^2-3$",
      "worked": "$$\\begin{align*}5x^2+10x+2&=5\\left(x^2+2x+\\frac25\\right)\\\\5x^2+10x+2&=5\\left((x+1)^2-1+\\frac25\\right)\\\\5x^2+10x+2&=5(x+1)^2-3.\\end{align*}$$",
      "solutionDiagrams": []
    },
