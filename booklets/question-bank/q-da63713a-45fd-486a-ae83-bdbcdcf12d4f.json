  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the exact value of $\\sec\\left(-\\frac{3\\pi}{4}\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\sqrt{2}$",
      "worked": "The angle $-\\frac{3\\pi}{4}$ has its terminal arm in quadrant III, with reference angle $\\frac{\\pi}{4}$. Cosine is negative.\n\n$$\\begin{aligned}\\cos\\left(-\\frac{3\\pi}{4}\\right)&=-\\frac{1}{\\sqrt2}\\\\\\sec\\left(-\\frac{3\\pi}{4}\\right)&=\\frac{1}{\\cos\\left(-\\frac{3\\pi}{4}\\right)}\\\\&=\\frac{1}{-1/\\sqrt2}\\\\&=-\\sqrt2\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
