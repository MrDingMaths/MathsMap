  "content": {
    "id": "p59-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Find the equation of the tangent to the curve $y=(2x-1)^8$ at the point where $x=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16x-y-15=0$",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=8(2x-1)^7\\times2\\\\\\frac{dy}{dx}&=16(2x-1)^7\n\\end{align*}$$\nAt $x=1$:\n$$\\begin{align*}m&=16(2(1)-1)^7\\\\m&=16\\\\y(1)&=(2(1)-1)^8\\\\y(1)&=1\n\\end{align*}$$\nThe tangent passes through $(1,1)$:\n$$\\begin{align*}y-1&=16(x-1)\\\\y&=16x-15\\\\16x-y-15&=0\\end{align*}$$",
      "solutionDiagrams": []
    },
