              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "-\\frac{1}{3}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;-\\frac{1}{2}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$>$",
          "worked": "$\\begin{aligned}-\\frac{1}{3}&=-\\frac{2}{6}\\\\-\\frac{1}{2}&=-\\frac{3}{6}\\end{aligned}$\n\nSince $-2>-3$, $-\\frac{1}{3}>-\\frac{1}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p43-q8-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p43-q8-b-comparison",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "-3\\frac{1}{5}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;-2\\frac{3}{7}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$<$",
          "worked": "$\\begin{aligned}-3\\frac{1}{5}&=-\\frac{16}{5}\\\\-2\\frac{3}{7}&=-\\frac{17}{7}\\\\-\\frac{16}{5}&=-\\frac{112}{35}\\\\-\\frac{17}{7}&=-\\frac{85}{35}\\end{aligned}$\n\nSince $-112<-85$, $-3\\frac{1}{5}<-2\\frac{3}{7}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p43-q8-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
