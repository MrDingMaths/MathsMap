              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{1}{4}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;-\\frac{1}{2}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$>$",
          "worked": "$-\\frac{1}{2}=-\\frac{2}{4}$.\n\nSince $1>-2$, $\\frac{1}{4}>-\\frac{1}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
