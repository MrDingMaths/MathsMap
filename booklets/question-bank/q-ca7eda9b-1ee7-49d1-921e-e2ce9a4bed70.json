              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "-\\frac{3}{5}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{1}{11}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$<$",
          "worked": "$\\begin{aligned}-\\frac{3}{5}&=-\\frac{33}{55}\\\\\\frac{1}{11}&=\\frac{5}{55}\\end{aligned}$\n\nSince $-33<5$, $-\\frac{3}{5}<\\frac{1}{11}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
