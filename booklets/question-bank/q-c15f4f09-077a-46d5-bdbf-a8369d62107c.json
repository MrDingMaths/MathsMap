    "type": "question",
    "label": "4",
    "prompt": "When $1\\frac{1}{2}$ is added to twice a certain number, the result is $4\\frac{3}{4}$. What is the number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{13}{8}$",
      "worked": "Let $x$ be the number.\n\n$$\\begin{align*}2x+\\frac{3}{2}&=\\frac{19}{4}\\\\2x&=\\frac{19}{4}-\\frac{6}{4}\\\\2x&=\\frac{13}{4}\\\\x&=\\frac{13}{8}\\end{align*}$$",
      "solutionDiagrams": []
    },
