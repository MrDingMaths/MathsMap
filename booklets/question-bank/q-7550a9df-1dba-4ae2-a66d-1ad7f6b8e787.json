    "reasoningScore": 78,
    "difficulty": "Mastery",
    "difficultyReason": "Use factor pairs of 210 to minimise a rectangle's perimeter and find dimensions satisfying a perimeter constraint."
  },
  "content": {
    "id": "p79-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "Suppose that 210 square tiles, each with side length 1 unit, are arranged without overlap into a rectangular shape.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p79-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the smallest perimeter that the rectangle can have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$58$ units.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p79-q26-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "210=2\\times3\\times5\\times7",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p79-q26-a-factor-pairs",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Factor pairs: ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "1\\times210,\\ 2\\times105,\\ 3\\times70,\\ 5\\times42,\\ 6\\times35,\\ 7\\times30,\\ 10\\times21,\\ 14\\times15",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p79-q26-a-minimum-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For a fixed area, choose the whole-number factor pair with side lengths as close as possible to minimise the perimeter. The closest factor pair is 14 and 15.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p79-q26-a-perimeter",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P_{\\min}&=2(14+15)\\\\P_{\\min}&=58\\text{ units}\\end{aligned}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p79-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that the perimeter of the rectangle is 62 units, find its dimensions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$ units $\\times\\ 21$ units.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p79-q26-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let the side lengths be ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "a",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "b",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " units.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p79-q26-b-side-sum",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}2(a+b)&=62\\\\a+b&=31\\\\ab&=210\\end{aligned}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p79-q26-b-factor-pair",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The factor pair of 210 with sum 31 is 10 and 21.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p79-q26-b-dimensions",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Dimensions: ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "10\\text{ units}\\times21\\text{ units}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
