  "content": {
    "id": "p11-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Suppose $\\tan\\theta=0.3$. Find each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cot\\left(\\frac{\\pi}{2}-\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3$",
          "worked": "$$\\begin{align*}\\cot\\left(\\frac{\\pi}{2}-\\theta\\right)&=\\tan\\theta\\\\\\cot\\left(\\frac{\\pi}{2}-\\theta\\right)&=0.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cot\\left(\\frac{\\pi}{2}+\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.3$",
          "worked": "$$\\begin{align*}\\cot\\left(\\frac{\\pi}{2}+\\theta\\right)&=\\tan(-\\theta)\\\\\\cot\\left(\\frac{\\pi}{2}+\\theta\\right)&=-\\tan\\theta\\\\\\cot\\left(\\frac{\\pi}{2}+\\theta\\right)&=-0.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cot\\left(\\frac{3\\pi}{2}-\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3$",
          "worked": "$$\\begin{align*}\\cot\\left(\\frac{3\\pi}{2}-\\theta\\right)&=\\cot\\left(\\frac{\\pi}{2}-\\theta\\right)\\\\\\cot\\left(\\frac{3\\pi}{2}-\\theta\\right)&=\\tan\\theta\\\\\\cot\\left(\\frac{3\\pi}{2}-\\theta\\right)&=0.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cot\\left(\\frac{5\\pi}{2}+\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.3$",
          "worked": "$$\\begin{align*}\\cot\\left(\\frac{5\\pi}{2}+\\theta\\right)&=\\cot\\left(\\frac{\\pi}{2}+\\theta\\right)\\\\\\cot\\left(\\frac{5\\pi}{2}+\\theta\\right)&=\\tan(-\\theta)\\\\\\cot\\left(\\frac{5\\pi}{2}+\\theta\\right)&=-\\tan\\theta\\\\\\cot\\left(\\frac{5\\pi}{2}+\\theta\\right)&=-0.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
