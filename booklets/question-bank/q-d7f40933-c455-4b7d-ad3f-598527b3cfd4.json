    "type": "question",
    "label": "4",
    "prompt": "Check whether or not each point lies on the circle $x^2+y^2=169$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q4-a",
