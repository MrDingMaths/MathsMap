        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}x^2+y^2&=5^2+12^2\\\\x^2+y^2&=25+144\\\\x^2+y^2&=169\\end{align*}$$\nThe point lies on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
