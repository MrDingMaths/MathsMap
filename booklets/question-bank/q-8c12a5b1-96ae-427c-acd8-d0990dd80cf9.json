  "content": {
    "id": "v2-b02ad-p42-practice-slot-8-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Ava invests $\\$8000$ at 4.5% p.a. compound interest. Ben invests $\\$6500$ at 7% p.a. compound interest.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b02ad-p42-practice-slot-8-upper-slot-8-upper-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation for the future value, $FV_A$ dollars, of Ava's investment after $n$ years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$FV_A=8000(1.045)^n$",
          "worked": "$$\\begin{align*}1+0.045&=1.045\\\\FV_A&=8000(1.045)^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-b02ad-p42-practice-slot-8-upper-slot-8-upper-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an equation for the future value, $FV_B$ dollars, of Ben's investment after $n$ years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$FV_B=6500(1.07)^n$",
          "worked": "$$\\begin{align*}1+0.07&=1.07\\\\FV_B&=6500(1.07)^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-b02ad-p42-practice-slot-8-upper-slot-8-upper-c",
        "type": "part",
        "label": "c",
        "prompt": "Whose investment is worth more after 5 years, and by how much? Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ava's, by $\\$852.87$.",
          "worked": "$$\\begin{align*}FV_A&=8000(1.045)^5\\approx\\$9969.46\\\\FV_B&=6500(1.07)^5\\approx\\$9116.59\\\\\\text{Difference}&\\approx9969.46-9116.59\\\\&=\\$852.87\\end{align*}$$\nAva's investment is worth more.",
