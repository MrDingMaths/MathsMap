  "content": {
    "id": "p49-q1",
    "type": "question",
    "label": "1",
    "prompt": "Without division, find the remainder when $P(x)=x^3-x^2+2x+1$ is divided by:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q1-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p49-q1-a-divisor",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "x-1",
                  "display": false
                }
              ]
            },
            {
              "id": "p49-q1-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "P(1)=",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}P(1)&=1^3-1^2+2(1)+1\\\\P(1)&=3\\end{align*}$$\nThe remainder is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25$",
          "worked": "$$\\begin{align*}P(3)&=3^3-3^2+2(3)+1\\\\P(3)&=25\\end{align*}$$\nThe remainder is $25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-15$",
          "worked": "$$\\begin{align*}P(-2)&=(-2)^3-(-2)^2+2(-2)+1\\\\P(-2)&=-15\\end{align*}$$\nThe remainder is $-15$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p49-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}P(-1)&=(-1)^3-(-1)^2+2(-1)+1\\\\P(-1)&=-3\\end{align*}$$\nThe remainder is $-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p49-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$x-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$111$",
          "worked": "$$\\begin{align*}P(5)&=5^3-5^2+2(5)+1\\\\P(5)&=111\\end{align*}$$\nThe remainder is $111$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-41$",
          "worked": "$$\\begin{align*}P(-3)&=(-3)^3-(-3)^2+2(-3)+1\\\\P(-3)&=-41\\end{align*}$$\nThe remainder is $-41$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
