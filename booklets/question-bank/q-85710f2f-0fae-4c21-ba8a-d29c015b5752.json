  "content": {
    "id": "p4-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Let $g(x)=\\dfrac1x$ for $x\\ne0$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$g(1)=\\frac11=1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p4-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac12$",
          "worked": "$$g(-2)=\\frac1{-2}=-\\frac12$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p4-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$g\\left(\\dfrac12\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}g\\left(\\frac12\\right)&=1\\div\\frac12\\\\g\\left(\\frac12\\right)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$g\\left(\\dfrac34\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac43$",
          "worked": "$$\\begin{align*}g\\left(\\frac34\\right)&=1\\div\\frac34\\\\g\\left(\\frac34\\right)&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$x$ given $g(x)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac13$",
          "worked": "$$\\begin{align*}\\frac1x&=3\\\\1&=3x\\\\x&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p4-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$x$ given $g(x)=\\dfrac45$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac54$",
          "worked": "$$\\begin{align*}\\frac1x&=\\frac45\\\\5&=4x\\\\x&=\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
