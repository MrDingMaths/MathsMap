                }
              ]
            },
            {
              "id": "p32-q1-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\text{Pay per period}=\\frac{\\text{Total pay}}{\\text{Number of periods}}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$4000 per month",
          "worked": "$$\\begin{align*}\\text{Pay per month}&=\\frac{\\text{Annual pay}}{12}\\\\\\text{Pay per month}&=\\frac{\\$48\\,000}{12}\\\\\\text{Pay per month}&=\\$4000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p32-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "1 week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$923.08 per week",
          "worked": "$$\\begin{align*}\\text{Pay per week}&=\\frac{\\text{Annual pay}}{52}\\\\\\text{Pay per week}&=\\frac{\\$48\\,000}{52}\\\\\\text{Pay per week}&\\approx\\$923.08\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
