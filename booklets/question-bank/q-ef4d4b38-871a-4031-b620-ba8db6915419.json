  "content": {
    "id": "p32-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Adam earns \\$48 000 a year. How much does he earn in the following periods? Round monetary answers to the nearest cent where necessary.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q1-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p32-q1-a-period",
              "type": "paragraph",
              "fontSize": null,
