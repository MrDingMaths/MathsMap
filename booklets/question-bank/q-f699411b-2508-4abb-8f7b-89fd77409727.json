        "label": "a",
        "prompt": "Find two consecutive odd numbers whose sum is 120.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$59,61$.",
          "worked": "Let the numbers be $x$ and $x+2$.\n$$\\begin{align*}x+(x+2)&=120\\\\2x+2&=120\\\\2x&=118\\\\x&=59\\end{align*}$$\nThe numbers are $59$ and $61$, both odd, and $59+61=120$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p2-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find three consecutive even numbers whose sum is 120.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$38,40,42$.",
          "worked": "Let the numbers be $x$, $x+2$ and $x+4$.\n$$\\begin{align*}x+(x+2)+(x+4)&=120\\\\3x+6&=120\\\\3x&=114\\\\x&=38\\end{align*}$$\nThe numbers are $38$, $40$ and $42$, all even, and $38+40+42=120$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
