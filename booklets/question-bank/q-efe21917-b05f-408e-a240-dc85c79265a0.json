  "content": {
    "id": "p15-q8",
    "type": "question",
    "label": "8",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "A line with gradient $4$ passes through $(1,5)$ and $(-2,k)$. Find the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-7$",
          "worked": "$\\begin{align*}4&=\\frac{k-5}{-2-1}\\\\-12&=k-5\\\\k&=-7\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $a$ if $2x+5y-6=0$ passes through $(a,-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=8$",
          "worked": "$\\begin{align*}2a+5(-2)-6&=0\\\\2a&=16\\\\a&=8\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the value of $a$ if $ax-8y+3=0$ passes through $(-7,3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-3$",
          "worked": "$\\begin{align*}a(-7)-8(3)+3&=0\\\\-7a&=21\\\\a&=-3\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the value(s) of $a$ if $ax+y=6$ passes through $(a,5a)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-6$ or $a=1$",
          "worked": "$\\begin{align*}a(a)+5a&=6\\\\a^2+5a-6&=0\\\\(a+6)(a-1)&=0\\end{align*}$\n\n$a=-6$ or $a=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
