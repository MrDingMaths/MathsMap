  "content": {
    "id": "p6-q1-root",
    "type": "question",
    "label": "",
    "prompt": "What is the domain of each function?",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2x-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real numbers.",
          "worked": "$2x-5$ is defined for every real value of $x$, so the domain is all real numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real numbers.",
          "worked": "$x^2+5$ is defined for every real value of $x$, so the domain is all real numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{5}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne0$.",
          "worked": "The denominator must not be zero, so the domain is $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{1}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne2$.",
          "worked": "The denominator must not be zero.\n$$\\begin{align*}x-2&\\ne0\\\\x&\\ne2\\end{align*}$$\nThe domain is $x\\ne2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{3}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne-4$.",
          "worked": "The denominator must not be zero.\n$$\\begin{align*}x+4&\\ne0\\\\x&\\ne-4\\end{align*}$$\nThe domain is $x\\ne-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{4}{3x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne2$.",
          "worked": "The denominator is zero when\n$$\\begin{align*}3x-6&=0\\\\3x&=6\\\\x&=2\\end{align*}$$\nThe denominator must not be zero, so the domain is $x\\ne2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\frac{7}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne2$ and $x\\ne-2$.",
          "worked": "The denominator is zero when\n$$\\begin{align*}x^2-4&=0\\\\x^2&=4\\\\x&=2\\text{ or }x=-2\\end{align*}$$\nExclude these values. The domain is all real numbers except $2$ and $-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\frac{3x+2}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne3$ and $x\\ne-3$.",
          "worked": "The denominator is zero when\n$$\\begin{align*}x^2-9&=0\\\\x^2&=9\\\\x&=3\\text{ or }x=-3\\end{align*}$$\nExclude these values. The domain is all real numbers except $3$ and $-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
