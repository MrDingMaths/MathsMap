  "content": {
    "id": "p16-q6",
    "type": "question",
    "label": "6",
    "prompt": "Here is the graph of $y=x+a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p16-q6-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 16 p16-q6-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.5pt,->] (-2.1,0)--(2.2,0) node[right] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-2.1)--(0,2.2) node[above] {$y$};\n\\draw[black,line width=0.8pt] (-1.1,-1.9)--(1.9,1.1);\n\\node[above left] at (1.9,1.1) {$y=x+a$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 16,
          "sourceRegion": "Question 6 supplied sketch, lower left",
          "description": "Unscaled perpendicular axes labelled x and y, with no ticks or grid. The labelled line rises from left to right, crosses the y-axis below the origin and crosses the x-axis to its right. Schematic drawing coordinates carry no numerical givens.",
          "mathematics": "The line has gradient 1 and an unspecified negative y-intercept a.",
          "answerVisibility": "Permanent supplied graph; no answers or additional lines appear in the question diagram."
