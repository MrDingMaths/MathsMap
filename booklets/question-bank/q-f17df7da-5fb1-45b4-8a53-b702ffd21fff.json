    ],
    "children": [
      {
        "id": "p16-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $a$ is negative.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The $y$-intercept is below the $x$-axis.",
          "worked": "In $y=x+a$, $a$ is the $y$-intercept. The line crosses the $y$-axis below the $x$-axis, so $a<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "If the value of $a$ is $-5$, on the same axis, sketch $y=x+3$ and $y=x-12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x+3$ is parallel to and above the original line, with $y$-intercept $3$. $y=x-12$ is parallel to and below the original line, with $y$-intercept $-12$.",
          "worked": "The original line is $y=x-5$. Plot $(0,3)$ for $y=x+3$ and $(0,-12)$ for $y=x-12$. From each point, move right 1 unit and up 1 unit, then draw and extend the line. Both new lines have gradient 1, so they are parallel to the original line.",
          "solutionDiagrams": [
            {
              "id": "p16-q6-b-solution-diagram",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"upperBlue\",\"hex\":\"268CFF\",\"reason\":\"new line y=x+3\"},{\"name\":\"lowerPurple\",\"hex\":\"8B5CC7\",\"reason\":\"new line y=x-12\"}],\"reference\":\"source page 16 p16-q6-b-solution-diagram\"}\n\\begin{tikzpicture}[x=0.22cm,y=0.22cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{upperBlue}{HTML}{268CFF}\n\\definecolor{lowerPurple}{HTML}{8B5CC7}\n\\draw[black,line width=0.5pt,->] (-8,0)--(16,0) node[right] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-16)--(0,9) node[above] {$y$};\n\\draw[black,line width=0.8pt,<->] plot[domain=-8:13,samples=2] (\\x,{\\x-5});\n\\draw[upperBlue,line width=0.8pt,<->] plot[domain=-8:5,samples=2] (\\x,{\\x+3});\n\\draw[lowerPurple,line width=0.8pt,dashed,<->] plot[domain=-3:15,samples=2] (\\x,{\\x-12});\n\\node[black,right] at (13,8) {$y=x-5$};\n\\node[upperBlue,anchor=west] at (6.5,10.5) {$y=x+3$};\n\\node[lowerPurple,right] at (15,3) {$y=x-12$};\n\\fill[upperBlue] (0,3) circle (1.2pt);\n\\fill[black] (0,-5) circle (1.2pt);\n\\fill[lowerPurple] (0,-12) circle (1.2pt);\n\\node[upperBlue,left] at (0,3) {$3$};\n\\node[black,left] at (0,-5) {$-5$};\n\\node[lowerPurple,left] at (0,-12) {$-12$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 65,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 16,
                "sourceRegion": "Question 6 part b",
                "description": "Complete answer figure showing the original line and both requested parallel lines on shared axes. Coloured intercept markers and labels identify the new lines; the lower new line is also dashed. Axes remain without a grid or graduated ticks.",
                "mathematics": "All three lines have gradient 1. Their y-intercepts are 3, -5 and -12, respectively.",
                "answerVisibility": "Answer-only completed sketch."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
