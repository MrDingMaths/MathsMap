  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Of a group of 50 students, $\\frac{3}{5}$ are girls.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the group is boys?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "$$1-\\frac{3}{5}=\\frac{2}{5}$$\nThe fraction of the group who are boys is $\\frac{2}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How many of the students are boys?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 boys.",
          "worked": "$$\\begin{align*}\\frac{2}{5}\\times50&=2\\times10\\\\\\frac{2}{5}\\times50&=20\\end{align*}$$\nThere are 20 boys.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
