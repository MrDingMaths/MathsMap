    "id": "v2-eb332-p29-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "The equation of the line of best fit connecting the battery charge ($B$), in per cent, of a phone and the number of hours of video streaming ($h$) is $B = -12.5h + 96$. Predict the most number of hours of streaming if you want the battery charge to be at least 46%.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "4 hours",
      "worked": "Find the number of hours when $B = 46$.\n$$\\begin{align*}46 &= -12.5h + 96\\\\-50 &= -12.5h\\\\h &= 4\\end{align*}$$\nThe battery charge decreases as the number of hours of streaming increases, so the number of hours must be at most this value for the predicted charge to be at least 46%.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
