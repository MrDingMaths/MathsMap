  "content": {
    "id": "p19-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Evaluate the following, and write each result using scientific notation:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3\\times10^6)\\times(2\\times10^4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.2\\times10^{15}$",
          "worked": "$$\\begin{align*}(3\\times10^6)\\times(2\\times10^4)^2&=3\\times2^2\\times10^{6+4\\times2}\\\\(3\\times10^6)\\times(2\\times10^4)^2&=12\\times10^{14}\\\\(3\\times10^6)\\times(2\\times10^4)^2&=1.2\\times10^{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p19-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2\\times10^5)^3\\times(3\\times10^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.4\\times10^{19}$",
          "worked": "$$\\begin{align*}(2\\times10^5)^3\\times(3\\times10^3)&=2^3\\times3\\times10^{5\\times3+3}\\\\(2\\times10^5)^3\\times(3\\times10^3)&=24\\times10^{18}\\\\(2\\times10^5)^3\\times(3\\times10^3)&=2.4\\times10^{19}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p19-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2\\times10^6)^2\\div(5\\times10^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\times10^9$",
          "worked": "$$\\begin{align*}(2\\times10^6)^2\\div(5\\times10^2)&=\\frac{2^2}{5}\\times10^{6\\times2-2}\\\\(2\\times10^6)^2\\div(5\\times10^2)&=0.8\\times10^{10}\\\\(2\\times10^6)^2\\div(5\\times10^2)&=8\\times10^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p19-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$(5\\times10^8)^3\\div(5\\times10^4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\times10^{16}$",
          "worked": "$$\\begin{align*}(5\\times10^8)^3\\div(5\\times10^4)^2&=\\frac{5^3}{5^2}\\times10^{8\\times3-4\\times2}\\\\(5\\times10^8)^3\\div(5\\times10^4)^2&=5\\times10^{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
