  "content": {
    "id": "p10-problem-1-root",
    "type": "question",
    "label": "1",
    "prompt": "Let $a$ be a positive constant.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-problem-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $e^{x\\ln(a)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^x$",
          "worked": "$$\\begin{align*} e^{x\\ln(a)}&=\\bigl(e^{\\ln(a)}\\bigr)^x \\\\ e^{x\\ln(a)}&=a^x. \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-problem-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, show that\n\n$$\\frac{d}{dx}(a^x)=a^x\\times\\ln(a).$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(a^x)=a^x\\ln(a)$.\n\nUse part (a) to rewrite $a^x$ as $e^{x\\ln(a)}$, then apply the chain rule.",
          "worked": "$$\\begin{align*} \\frac{d}{dx}(a^x)&=\\frac{d}{dx}\\bigl(e^{x\\ln(a)}\\bigr) \\\\ \\frac{d}{dx}(a^x)&=e^{x\\ln(a)}\\ln(a) \\\\ \\frac{d}{dx}(a^x)&=a^x\\ln(a). \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
