        "type": "part",
        "label": "a",
        "prompt": "Convert $60\\text{ km/h}$ to metres per second.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\frac{2}{3}\\text{ m/s}$",
          "worked": "There are $1000$ metres in a kilometre and $3600$ seconds in an hour.\n$$\\begin{align*}60\\text{ km/h}&=\\frac{60\\times1000}{3600}\\text{ m/s}\\\\60\\text{ km/h}&=\\frac{50}{3}\\text{ m/s}\\\\60\\text{ km/h}&=16\\frac{2}{3}\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p39-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Convert $x\\text{ km/h}$ to metres per second.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x}{18}\\text{ m/s}$",
          "worked": "$$\\begin{align*}x\\text{ km/h}&=\\frac{1000x}{3600}\\text{ m/s}\\\\x\\text{ km/h}&=\\frac{5x}{18}\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
