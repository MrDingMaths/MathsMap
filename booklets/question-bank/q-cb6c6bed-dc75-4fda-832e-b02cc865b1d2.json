  "content": {
    "id": "p37-q4",
    "type": "question",
    "label": "4",
    "prompt": "Simplify $\\dfrac{\\sqrt{12}}{\\sqrt{3}}$ by:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Simplifying each surd then dividing",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{3}}{\\sqrt{3}}=2$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{12}}{\\sqrt{3}}&=\\frac{\\sqrt{4}\\sqrt{3}}{\\sqrt{3}}\\\\&=\\frac{2\\sqrt{3}}{\\sqrt{3}}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p37-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Dividing the surds then simplifying.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{4}=2$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{12}}{\\sqrt{3}}&=\\sqrt{\\frac{12}{3}}\\\\&=\\sqrt{4}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
