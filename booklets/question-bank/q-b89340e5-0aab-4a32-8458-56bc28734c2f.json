  "content": {
    "id": "p21-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A coffee cart sells a total of 60 coffees for a total of $\\$250$. Each regular coffee costs $\\$3.50$ and each large coffee costs $\\$5.50$. How many regular and how many large coffees are sold?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "40 regular coffees and 20 large coffees.",
      "worked": "Let $r$ be the number of regular coffees and $l$ the number of large coffees.\n$$\\begin{align*}r+l&=60 &&(1)\\\\3.5r+5.5l&=250 &&(2)\\\\3.5r+3.5l&=210 &&3.5\\times(1)\\\\2l&=40 &&(2)-3.5\\times(1)\\\\l&=20\\\\r&=60-20\\\\r&=40\\end{align*}$$\nTherefore, 40 regular coffees and 20 large coffees are sold.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
