    "id": "v2-5bb25-p34-practice-slot-12-root",
    "type": "question",
    "label": null,
    "prompt": "Given $\\underset{\\sim}{a}=\\begin{pmatrix}4\\\\-3\\end{pmatrix}$ and $\\underset{\\sim}{b}=\\begin{pmatrix}-2\\\\5\\end{pmatrix}$, find $2\\underset{\\sim}{a}-3\\underset{\\sim}{b}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\begin{pmatrix}14\\\\-21\\end{pmatrix}$",
      "worked": "$$\\begin{aligned}2\\underset{\\sim}{a}-3\\underset{\\sim}{b}&=2\\begin{pmatrix}4\\\\-3\\end{pmatrix}-3\\begin{pmatrix}-2\\\\5\\end{pmatrix}\\\\&=\\begin{pmatrix}8\\\\-6\\end{pmatrix}-\\begin{pmatrix}-6\\\\15\\end{pmatrix}\\\\&=\\begin{pmatrix}14\\\\-21\\end{pmatrix}\\end{aligned}$$",
      "solutionDiagrams": []
    },
