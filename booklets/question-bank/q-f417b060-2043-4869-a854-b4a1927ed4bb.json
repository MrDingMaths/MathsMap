    "type": "question",
    "label": null,
    "prompt": "The cost per student $c$ dollars of hiring a bus for an excursion is given by $c=\\frac{T}{n}$, where $T$ is the total hire cost in dollars and $n$ is the number of students. Rearrange to make $n$ the subject.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=\\frac{T}{c}$",
      "worked": "$$\\begin{align*}c&=\\frac{T}{n}\\\\cn&=T\\\\n&=\\frac{T}{c}\\end{align*}$$",
      "solutionDiagrams": []
    },
