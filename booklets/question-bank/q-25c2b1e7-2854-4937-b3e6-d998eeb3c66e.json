        "type": "part",
        "label": "a",
        "prompt": "The area is $36\\text{ cm}^2$.\nFind the radius to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "v2-9f44a-p25-practice-slot-14-lower-slot-14-lower-q-a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"slot-14-lower-q-a-diagram\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (A) at (20:1.8);\n\\coordinate (B) at (90:1.8);\n\\draw[black,line width=0.8pt] (O)--(A) arc[start angle=20,end angle=90,radius=1.8]--cycle;\n\\draw[black,line width=0.4pt] (20:0.5) arc[start angle=20,end angle=90,radius=0.5];\n\\node at (55:0.85) {$70^\\circ$};\n\\path (O)--(A) node[midway,below] {$r$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 30,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "derived": false
          }
        ],
        "children": [],
        "answer": {
          "short": "$r\\approx7.68\\text{ cm}$",
          "worked": "$$\\begin{align*}A&=\\frac{\\theta}{360}\\pi r^2\\\\36&=\\frac{70}{360}\\pi r^2\\\\12960&=70\\pi r^2\\\\\\frac{12960}{70\\pi}&=r^2\\\\r&=\\sqrt{\\frac{12960}{70\\pi}}\\\\r&\\approx7.68\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-9f44a-p25-practice-slot-14-lower-slot-14-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The area is $150\\text{ m}^2$.\nFind the angle to the nearest degree.",
        "layout": "list",
