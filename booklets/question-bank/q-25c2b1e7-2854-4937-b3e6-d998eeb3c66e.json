        "children": [],
        "answer": {
          "short": "$\\theta\\approx172^\\circ$",
          "worked": "$$\\begin{align*}A&=\\frac{\\theta}{360}\\pi r^2\\\\150&=\\frac{\\theta}{360}\\pi(10)^2\\\\54000&=100\\pi\\theta\\\\540&=\\pi\\theta\\\\\\frac{540}{\\pi}&=\\theta\\\\\\theta&\\approx172^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
