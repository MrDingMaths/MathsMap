            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"slot-14-lower-q-b-diagram\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (A) at (8:1.8);\n\\coordinate (B) at (180:1.8);\n\\draw[black,line width=0.8pt] (O)--(A) arc[start angle=8,end angle=180,radius=1.8]--cycle;\n\\draw[black,line width=0.4pt] (8:0.45) arc[start angle=8,end angle=180,radius=0.45];\n\\node at (94:0.8) {$\\theta$};\n\\path (O)--(B) node[midway,below] {$10\\text{ m}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 40,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
