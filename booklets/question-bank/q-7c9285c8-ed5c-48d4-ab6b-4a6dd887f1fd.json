  "content": {
    "id": "v2-ad2e22-p6-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Verify whether $y=5e^{2x}$ is a solution of the differential equation $y'=2y+1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No.",
      "worked": "$$\\begin{align*}y'&=10e^{2x}\\\\\\mathrm{LHS}&=y'\\\\&=10e^{2x}\\\\\\mathrm{RHS}&=2y+1\\\\&=2(5e^{2x})+1\\\\&=10e^{2x}+1\\end{align*}$$\nLHS $\\ne$ RHS, so it is not a solution.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
  },
