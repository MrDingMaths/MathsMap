  "content": {
    "id": "p34-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Sophie did these calculations. Identify her errors and give the correct answers:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "“To find $30\\%$ of $50$, I multiplied by $1.3$ and got $65$”",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "She increased $50$ by $30\\%$ instead of finding $30\\%$ of $50$. Use $0.3$; the correct answer is $15$.",
          "worked": "The multiplier $1.3$ increases an amount by $30\\%$. Finding $30\\%$ requires the multiplier $0.3$.\n$$\\begin{align*}30\\%\\text{ of }50 &= 0.3\\times50\\\\&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p34-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "“To increase $80$ by $25\\%$, I multiplied by $0.25$ and got $20$”",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "She found $25\\%$ of $80$ instead of increasing it by $25\\%$. Use $1.25$; the correct answer is $100$.",
          "worked": "The multiplier $0.25$ finds only the extra amount. The original must also be retained.\n$$\\begin{align*}\\text{Required percentage} &= 100\\%+25\\%\\\\&=125\\%\\\\\\text{New amount} &=1.25\\times80\\\\&=100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p34-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "“To decrease $120$ by $40\\%$, I multiplied by $0.4$ and got $48$”",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "She found $40\\%$ of $120$ instead of decreasing it by $40\\%$. Use $0.6$; the correct answer is $72$.",
          "worked": "The multiplier $0.4$ finds the amount removed. The remaining amount is $60\\%$ of the original.\n$$\\begin{align*}\\text{Remaining percentage} &=100\\%-40\\%\\\\&=60\\%\\\\\\text{New amount} &=0.6\\times120\\\\&=72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
