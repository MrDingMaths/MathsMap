  "content": {
    "id": "p39-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider the differential equation $\\dfrac{dy}{dx}=-y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the constant solution?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=0$.",
          "worked": "For a constant solution, $y'=0$. Thus $0=-y$, giving $y=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p39-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Use separation of variables to solve the DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln|y|=-x+C$ for $y\\ne0$.",
          "worked": "For $y\\ne0$,\n$$\\begin{align*}\\frac1y\\,dy&=-dx\\\\\\int\\frac1y\\,dy&=\\int-1\\,dx\\\\\\ln|y|&=-x+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p39-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Make $y$ the subject, simplifying the constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=Ae^{-x}$, where $A\\in\\mathbb R$.",
          "worked": "$$\\begin{align*}|y|&=e^{-x+C}\\\\|y|&=e^C e^{-x}\\\\y&=Ae^{-x}.\\end{align*}$$\nThe nonzero solutions have $A=\\pm e^C$; including the constant solution allows any real $A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Check that the constant solution is included in part c.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=0$ gives $y=0$.",
          "worked": "Setting $A=0$ gives $y=0e^{-x}=0$, the constant solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p39-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the solution for $y(0)=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2e^{-x}$.",
          "worked": "Substitute $y(0)=2$:\n$$\\begin{align*}2&=Ae^0\\\\A&=2\\\\y&=2e^{-x}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
