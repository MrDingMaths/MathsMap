  "content": {
    "id": "p18-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Simplify by first factorising.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2-x-6}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$",
          "worked": "$$\\begin{align*}\\frac{x^2-x-6}{x-3}&=\\frac{(x-3)(x+2)}{x-3}\\\\&=x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2+8x+16}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+4$",
          "worked": "$$\\begin{align*}\\frac{x^2+8x+16}{x+4}&=\\frac{(x+4)^2}{x+4}\\\\&=x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2-7x+12}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-3$",
          "worked": "$$\\begin{align*}\\frac{x^2-7x+12}{x-4}&=\\frac{(x-3)(x-4)}{x-4}\\\\&=x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x-2}{x^2+x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{x-2}{x^2+x-6}&=\\frac{x-2}{(x+3)(x-2)}\\\\&=\\frac{1}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x+7}{x^2+5x-14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x-2}$",
          "worked": "$$\\begin{align*}\\frac{x+7}{x^2+5x-14}&=\\frac{x+7}{(x+7)(x-2)}\\\\&=\\frac{1}{x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x-9}{x^2-19x+90}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x-10}$",
          "worked": "$$\\begin{align*}\\frac{x-9}{x^2-19x+90}&=\\frac{x-9}{(x-9)(x-10)}\\\\&=\\frac{1}{x-10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{c^2+11c+30}{6c+30}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{c+6}{6}$",
          "worked": "$$\\begin{align*}\\frac{c^2+11c+30}{6c+30}&=\\frac{(c+5)(c+6)}{6(c+5)}\\\\&=\\frac{c+6}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{he-hd+pe-pd}{e^2-d^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{h+p}{e+d}$",
          "worked": "$$\\begin{align*}\\frac{he-hd+pe-pd}{e^2-d^2}&=\\frac{h(e-d)+p(e-d)}{(e-d)(e+d)}\\\\&=\\frac{(h+p)(e-d)}{(e-d)(e+d)}\\\\&=\\frac{h+p}{e+d}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p18-q13-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{k^2+5k-24}{2k^2-18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{k+8}{2(k+3)}$",
          "worked": "$$\\begin{align*}\\frac{k^2+5k-24}{2k^2-18}&=\\frac{(k+8)(k-3)}{2(k^2-9)}\\\\&=\\frac{(k+8)(k-3)}{2(k-3)(k+3)}\\\\&=\\frac{k+8}{2(k+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q13-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{r^2-2r-24}{r^2+12r+32}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{r-6}{r+8}$",
          "worked": "$$\\begin{align*}\\frac{r^2-2r-24}{r^2+12r+32}&=\\frac{(r-6)(r+4)}{(r+4)(r+8)}\\\\&=\\frac{r-6}{r+8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q13-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{6m-30-pm+5p}{m^2+3m-40}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6-p}{m+8}$",
          "worked": "$$\\begin{align*}\\frac{6m-30-pm+5p}{m^2+3m-40}&=\\frac{6(m-5)-p(m-5)}{(m+8)(m-5)}\\\\&=\\frac{(6-p)(m-5)}{(m+8)(m-5)}\\\\&=\\frac{6-p}{m+8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p18-q13-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{n^3-5n^2+4n}{n^2-2n+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n(n-4)}{n-1}$",
          "worked": "$$\\begin{align*}\\frac{n^3-5n^2+4n}{n^2-2n+1}&=\\frac{n(n^2-5n+4)}{(n-1)^2}\\\\&=\\frac{n(n-1)(n-4)}{(n-1)^2}\\\\&=\\frac{n(n-4)}{n-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
