  "content": {
    "id": "p18-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Find the values of $x$ for which:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^3-x^2-x-1$ is decreasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{3}<x<1$.",
          "worked": "$$\\begin{align*}y'&=3x^2-2x-1\\\\y'&=(3x+1)(x-1)\\end{align*}$$\nFor the function to be decreasing, $y'<0$:\n$$\\begin{align*}(3x+1)(x-1)&<0\\\\-\\frac{1}{3}<x&<1.\\end{align*}$$\nThe upward-opening quadratic derivative is negative between its zeros.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^3-3x^2-24x+15$ is increasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-2$ or $x>4$.",
          "worked": "$$\\begin{align*}y'&=3x^2-6x-24\\\\y'&=3(x+2)(x-4)\\end{align*}$$\nFor the function to be increasing, $y'>0$:\n$$3(x+2)(x-4)>0.$$\nThe upward-opening quadratic derivative is positive outside its zeros, so $x<-2$ or $x>4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
