  "content": {
    "id": "p38-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find each indefinite integral using the given substitution.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{e^{2x}}{\\sqrt{1+e^{2x}}}\\,dx,\\quad u=e^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{1+e^{2x}}+C$",
          "worked": "Let $u=e^{2x}$.\n$$\\begin{aligned}\\frac{du}{dx}&=2e^{2x}\\\\dx&=\\frac{du}{2e^{2x}}\\end{aligned}$$\n$$\\begin{aligned}\\int\\frac{e^{2x}}{\\sqrt{1+e^{2x}}}\\,dx&=\\frac12\\int(1+u)^{-1/2}\\,du\\\\&=\\sqrt{1+u}+C\\\\&=\\sqrt{1+e^{2x}}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p38-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{1}{x\\ln x}\\,dx,\\quad u=\\ln x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln|\\ln x|+C$",
          "worked": "Let $u=\\ln x$.\n$$\\begin{aligned}\\frac{du}{dx}&=\\frac1x\\\\dx&=x\\,du\\end{aligned}$$\n$$\\begin{aligned}\\int\\frac{1}{x\\ln x}\\,dx&=\\int\\frac1u\\,du\\\\&=\\ln|u|+C\\\\&=\\ln|\\ln x|+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p38-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{\\tan x}{\\ln(\\cos x)}\\,dx,\\quad u=\\ln(\\cos x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\ln|\\ln(\\cos x)|+C$",
          "worked": "Let $u=\\ln(\\cos x)$.\n$$\\begin{aligned}\\frac{du}{dx}&=\\frac{-\\sin x}{\\cos x}\\\\&=-\\tan x\\\\dx&=-\\frac{du}{\\tan x}\\end{aligned}$$\n$$\\begin{aligned}\\int\\frac{\\tan x}{\\ln(\\cos x)}\\,dx&=-\\int\\frac1u\\,du\\\\&=-\\ln|u|+C\\\\&=-\\ln|\\ln(\\cos x)|+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p38-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\tan^3x\\sec^4x\\,dx,\\quad u=\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14\\tan^4x+\\dfrac16\\tan^6x+C$",
          "worked": "Let $u=\\tan x$.\n$$\\begin{aligned}\\frac{du}{dx}&=\\sec^2x\\\\dx&=\\frac{du}{\\sec^2x}\\\\\\sec^2x&=1+u^2\\end{aligned}$$\n$$\\begin{aligned}\\int\\tan^3x\\sec^4x\\,dx&=\\int u^3(1+u^2)\\,du\\\\&=\\int(u^3+u^5)\\,du\\\\&=\\frac{u^4}{4}+\\frac{u^6}{6}+C\\\\&=\\frac14\\tan^4x+\\frac16\\tan^6x+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
