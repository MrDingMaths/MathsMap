  "content": {
    "id": "p10-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The temperature in Warsaw on a winter’s day went from a minimum of $-17^{\\circ}\\mathrm{C}$ to a maximum of $-1^{\\circ}\\mathrm{C}$. By how much did the temperature rise?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16^{\\circ}\\mathrm{C}$",
      "worked": "Temperature rise = maximum temperature − minimum temperature.\n\n$$\\begin{align*}-1-(-17)&=-1+17\\\\-1-(-17)&=16\\end{align*}$$\n\nThe temperature rose by $16^{\\circ}\\mathrm{C}$.",
      "solutionDiagrams": []
    },
