  "content": {
    "id": "p16-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "In the expansion of $\\left(1+\\dfrac{2}{3x}\\right)^7$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "find the term in $x^{-5}$,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{224}{81x^5}$",
          "worked": "$$\\begin{aligned}T_r&=\\binom{7}{r}\\left(\\frac{2}{3x}\\right)^r\\\\&=\\binom{7}{r}2^r3^{-r}x^{-r}\\end{aligned}$$\nFor $x^{-5}$, let $r=5$.\n$$\\begin{aligned}T_5&=\\binom{7}{5}2^5 3^{-5}x^{-5}\\\\&=\\frac{224}{81x^5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "find the term in $x^{-6}$,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{448}{729x^6}$",
          "worked": "For $x^{-6}$, let $r=6$.\n$$\\begin{aligned}T_6&=\\binom{7}{6}2^6 3^{-6}x^{-6}\\\\&=\\frac{448}{729x^6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "find the ratio of the term in $x^{-5}$ to the term in $x^{-6}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9x}{2}$",
          "worked": "$$\\begin{aligned}\\frac{T_5}{T_6}&=\\frac{224}{81x^5}\\div\\frac{448}{729x^6}\\\\&=\\frac{224}{81x^5}\\times\\frac{729x^6}{448}\\\\&=\\frac{9x}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
