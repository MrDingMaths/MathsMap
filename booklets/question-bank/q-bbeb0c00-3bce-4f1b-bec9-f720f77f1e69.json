      {
        "id": "p62-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^\\pi \\sin x\\cos^8x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac29$",
          "worked": "$$\\begin{align*}\\int_0^\\pi\\sin x\\cos^8x\\,dx&=\\left[-\\frac{\\cos^9x}{9}\\right]_0^\\pi\\\\&=-\\frac{(-1)^9}{9}+\\frac{1^9}{9}\\\\&=\\frac29\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p62-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^{\\pi/2}\\sin x\\cos^nx\\,dx$, where $n>-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{n+1}$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/2}\\sin x\\cos^nx\\,dx&=\\left[-\\frac{\\cos^{n+1}x}{n+1}\\right]_0^{\\pi/2}\\\\&=0-\\left(-\\frac1{n+1}\\right)\\\\&=\\frac1{n+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p62-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{-\\pi/2}^{\\pi/2}\\cos x\\sin^7x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\int_{-\\pi/2}^{\\pi/2}\\cos x\\sin^7x\\,dx&=\\left[\\frac{\\sin^8x}{8}\\right]_{-\\pi/2}^{\\pi/2}\\\\&=\\frac18-\\frac{(-1)^8}{8}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p62-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_0^{\\pi/6}\\cos x\\sin^nx\\,dx$, where $n>-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{2^{n+1}(n+1)}$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/6}\\cos x\\sin^nx\\,dx&=\\left[\\frac{\\sin^{n+1}x}{n+1}\\right]_0^{\\pi/6}\\\\&=\\frac{(\\frac12)^{n+1}-0}{n+1}\\\\&=\\frac1{2^{n+1}(n+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p62-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_0^{\\pi/3}\\sec^2x\\tan^7x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\frac18$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/3}\\sec^2x\\tan^7x\\,dx&=\\left[\\frac{\\tan^8x}{8}\\right]_0^{\\pi/3}\\\\&=\\frac{(\\sqrt3)^8}{8}\\\\&=\\frac{81}{8}\\\\&=10\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p62-q19-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_0^{\\pi/4}\\sec^2x\\tan^nx\\,dx$, where $n>-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{n+1}$",
          "worked": "$$\\begin{align*}\\int_0^{\\pi/4}\\sec^2x\\tan^nx\\,dx&=\\left[\\frac{\\tan^{n+1}x}{n+1}\\right]_0^{\\pi/4}\\\\&=\\frac{1^{n+1}-0}{n+1}\\\\&=\\frac1{n+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
