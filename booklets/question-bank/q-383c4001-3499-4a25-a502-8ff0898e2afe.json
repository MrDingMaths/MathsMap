    "children": [
      {
        "id": "p21-q8-11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\left(\\theta+\\frac{\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt3}{2}\\sin\\theta+\\frac12\\cos\\theta$",
          "worked": "$$\\begin{align*}\\sin\\left(\\theta+\\frac{\\pi}{6}\\right)&=\\sin\\theta\\cos\\frac{\\pi}{6}+\\cos\\theta\\sin\\frac{\\pi}{6}\\\\\\sin\\left(\\theta+\\frac{\\pi}{6}\\right)&=\\sin\\theta\\times\\frac{\\sqrt3}{2}+\\cos\\theta\\times\\frac12\\\\\\sin\\left(\\theta+\\frac{\\pi}{6}\\right)&=\\frac{\\sqrt3}{2}\\sin\\theta+\\frac12\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q8-11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\left(\\theta+\\frac{\\pi}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\cos\\theta-\\sin\\theta}{\\sqrt2}$",
          "worked": "$$\\begin{align*}\\cos\\left(\\theta+\\frac{\\pi}{4}\\right)&=\\cos\\theta\\cos\\frac{\\pi}{4}-\\sin\\theta\\sin\\frac{\\pi}{4}\\\\\\cos\\left(\\theta+\\frac{\\pi}{4}\\right)&=\\frac{\\cos\\theta}{\\sqrt2}-\\frac{\\sin\\theta}{\\sqrt2}\\\\\\cos\\left(\\theta+\\frac{\\pi}{4}\\right)&=\\frac{\\cos\\theta-\\sin\\theta}{\\sqrt2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q8-11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\left(\\theta+\\frac{\\pi}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\tan\\theta+\\sqrt3}{1-\\sqrt3\\tan\\theta}$",
          "worked": "$$\\begin{align*}\\tan\\left(\\theta+\\frac{\\pi}{3}\\right)&=\\frac{\\tan\\theta+\\tan\\frac{\\pi}{3}}{1-\\tan\\theta\\tan\\frac{\\pi}{3}}\\\\\\tan\\left(\\theta+\\frac{\\pi}{3}\\right)&=\\frac{\\tan\\theta+\\sqrt3}{1-\\sqrt3\\tan\\theta}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q8-11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cot\\left(\\theta+\\frac{\\pi}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\cot\\theta-1}{\\cot\\theta+1}$",
          "worked": "$$\\begin{align*}\\cot\\left(\\theta+\\frac{\\pi}{4}\\right)&=\\frac{1}{\\tan\\left(\\theta+\\frac{\\pi}{4}\\right)}\\\\\\cot\\left(\\theta+\\frac{\\pi}{4}\\right)&=\\frac{1-\\tan\\theta}{\\tan\\theta+1}\\\\\\cot\\left(\\theta+\\frac{\\pi}{4}\\right)&=\\frac{1-\\frac1{\\cot\\theta}}{\\frac1{\\cot\\theta}+1}\\\\\\cot\\left(\\theta+\\frac{\\pi}{4}\\right)&=\\frac{\\cot\\theta-1}{\\cot\\theta+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
