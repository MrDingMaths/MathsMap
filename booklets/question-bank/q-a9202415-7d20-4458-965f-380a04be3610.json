  "content": {
    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the equation of the line that passes through the two given points in each case.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q5a",
        "type": "part",
        "label": "a",
        "prompt": "$(0,-4)$ and $(4,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-4$",
          "worked": "$$\\begin{align*}m&=\\frac{0-(-4)}{4-0}\\\\m&=1\\\\y-(-4)&=1(x-0)\\\\y+4&=x\\\\y&=x-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p20-q5b",
        "type": "part",
        "label": "b",
        "prompt": "$(-3,0)$ and $(0,-9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3x-9$",
          "worked": "$$\\begin{align*}m&=\\frac{-9-0}{0-(-3)}\\\\m&=-3\\\\y-0&=-3(x-(-3))\\\\y&=-3(x+3)\\\\y&=-3x-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p20-q5c",
        "type": "part",
        "label": "c",
        "prompt": "$(2,4)$ and $(-6,12)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x+6$",
          "worked": "$$\\begin{align*}m&=\\frac{12-4}{-6-2}\\\\m&=-1\\\\y-4&=-(x-2)\\\\y-4&=-x+2\\\\y&=-x+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p20-q5d",
        "type": "part",
        "label": "d",
        "prompt": "$(6,3)$ and $(7,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3$",
          "worked": "$$\\begin{align*}m&=\\frac{3-3}{7-6}\\\\m&=0\\\\y-3&=0(x-6)\\\\y&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q5e",
        "type": "part",
        "label": "e",
        "prompt": "$(1,4)$ and $(1,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "Both points have $x$-coordinate $1$, so the line is vertical. Its equation is $x=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q5f",
        "type": "part",
        "label": "f",
        "prompt": "$(0,-3)$ and $(4,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac94x-3$",
          "worked": "$$\\begin{align*}m&=\\frac{6-(-3)}{4-0}\\\\m&=\\frac94\\\\y-(-3)&=\\frac94(x-0)\\\\y+3&=\\frac94x\\\\y&=\\frac94x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
