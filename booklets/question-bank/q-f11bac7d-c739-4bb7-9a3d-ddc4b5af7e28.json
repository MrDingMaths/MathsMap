  "content": {
    "id": "p32-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Evaluate these expressions when $g = 80$.",
    "layout": "grid",
    "columns": 5,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{g}{10}+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "$$\\begin{align*}\\frac{g}{10}+5 &= \\frac{80}{10}+5\\\\\\frac{g}{10}+5 &= 8+5\\\\\\frac{g}{10}+5 &= 13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p32-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{g}{10}-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{g}{10}-5 &= \\frac{80}{10}-5\\\\\\frac{g}{10}-5 &= 8-5\\\\\\frac{g}{10}-5 &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p32-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$10g+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$805$",
          "worked": "$$\\begin{align*}10g+5 &= 10(80)+5\\\\10g+5 &= 800+5\\\\10g+5 &= 805\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p32-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$5+\\frac{g}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "$$\\begin{align*}5+\\frac{g}{10} &= 5+\\frac{80}{10}\\\\5+\\frac{g}{10} &= 5+8\\\\5+\\frac{g}{10} &= 13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p32-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$10g-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$795$",
          "worked": "$$\\begin{align*}10g-5 &= 10(80)-5\\\\10g-5 &= 800-5\\\\10g-5 &= 795\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p32-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$10-\\frac{g}{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}10-\\frac{g}{20} &= 10-\\frac{80}{20}\\\\10-\\frac{g}{20} &= 10-4\\\\10-\\frac{g}{20} &= 6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p32-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$10-\\frac{20}{g}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\frac{3}{4}$",
          "worked": "$$\\begin{align*}10-\\frac{20}{g} &= 10-\\frac{20}{80}\\\\10-\\frac{20}{g} &= 10-\\frac{1}{4}\\\\10-\\frac{20}{g} &= 9\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p32-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$10+\\frac{40}{g}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10.5$",
          "worked": "$$\\begin{align*}10+\\frac{40}{g} &= 10+\\frac{40}{80}\\\\10+\\frac{40}{g} &= 10+\\frac{1}{2}\\\\10+\\frac{40}{g} &= 10.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{10}{g}+40$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40\\frac{1}{8}$",
          "worked": "$$\\begin{align*}\\frac{10}{g}+40 &= \\frac{10}{80}+40\\\\\\frac{10}{g}+40 &= \\frac{1}{8}+40\\\\\\frac{10}{g}+40 &= 40\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p32-q9-j",
        "type": "part",
        "label": "j",
        "prompt": "$g^2-1400$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5000$",
          "worked": "$$\\begin{align*}g^2-1400 &= 80^2-1400\\\\g^2-1400 &= 6400-1400\\\\g^2-1400 &= 5000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
