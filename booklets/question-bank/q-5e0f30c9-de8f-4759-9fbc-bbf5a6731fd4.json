  "content": {
    "id": "p14-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "If $x=2+\\sqrt{3}$ and $y=2-\\sqrt{3}$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}x+y&=(2+\\sqrt{3})+(2-\\sqrt{3})\\\\x+y&=2+2+\\sqrt{3}-\\sqrt{3}\\\\x+y&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$x+2y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6-\\sqrt{3}$",
          "worked": "$$\\begin{align*}x+2y&=(2+\\sqrt{3})+2(2-\\sqrt{3})\\\\x+2y&=2+\\sqrt{3}+4-2\\sqrt{3}\\\\x+2y&=6-\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x+2y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10+\\sqrt{3}$",
          "worked": "$$\\begin{align*}3x+2y&=3(2+\\sqrt{3})+2(2-\\sqrt{3})\\\\3x+2y&=6+3\\sqrt{3}+4-2\\sqrt{3}\\\\3x+2y&=10+\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$x-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{3}$",
          "worked": "$$\\begin{align*}x-y&=(2+\\sqrt{3})-(2-\\sqrt{3})\\\\x-y&=2+\\sqrt{3}-2+\\sqrt{3}\\\\x-y&=2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$x-2y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{3}-2$",
          "worked": "$$\\begin{align*}x-2y&=(2+\\sqrt{3})-2(2-\\sqrt{3})\\\\x-2y&=2+\\sqrt{3}-4+2\\sqrt{3}\\\\x-2y&=3\\sqrt{3}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}xy&=(2+\\sqrt{3})(2-\\sqrt{3})\\\\xy&=4-2\\sqrt{3}+2\\sqrt{3}-3\\\\xy&=4-3\\\\xy&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q14-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt{3}xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\sqrt{3}xy&=\\sqrt{3}(2+\\sqrt{3})(2-\\sqrt{3})\\\\\\sqrt{3}xy&=\\sqrt{3}(4-2\\sqrt{3}+2\\sqrt{3}-3)\\\\\\sqrt{3}xy&=\\sqrt{3}\\times1\\\\\\sqrt{3}xy&=\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q14-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sqrt{xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sqrt{xy}&=\\sqrt{(2+\\sqrt{3})(2-\\sqrt{3})}\\\\\\sqrt{xy}&=\\sqrt{4-2\\sqrt{3}+2\\sqrt{3}-3}\\\\\\sqrt{xy}&=\\sqrt{1}\\\\\\sqrt{xy}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
