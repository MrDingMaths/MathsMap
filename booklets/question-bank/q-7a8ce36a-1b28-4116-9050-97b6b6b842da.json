              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "You should have found that the above system of equations has integer solutions. Show that this is not a coincidence by proving that the system",
                  "marks": []
                }
              ]
            },
            {
              "id": "p23-q26-b-system",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}\\frac{x}{n-1}+\\frac{y}{n}&=1\\\\\\frac{x}{n}+\\frac{y}{n+1}&=1\\end{aligned}",
                  "display": true
                }
              ]
            },
            {
              "id": "p23-q26-b-condition",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "always",
                  "marks": [
                    "italic"
                  ]
                },
                {
                  "type": "text",
                  "text": " has integer solutions, provided that ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "n",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " is an integer other than ",
                  "marks": []
