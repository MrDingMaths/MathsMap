  "content": {
    "id": "p16-q12",
    "type": "question",
    "label": "12",
    "prompt": "Julio is paid \\$956.08 for a regular 38-hour week.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "What is his hourly rate of pay?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$25.16/h",
          "worked": "$\\begin{align*}\\text{Hourly rate}&=956.08\\div38\\\\\\text{Hourly rate}&=\\frac{\\$25.16}{\\text{h}}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "How many hours of overtime does he work if he works 41 hours that week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 hours",
          "worked": "$\\begin{align*}\\text{Overtime hours}&=41-38\\\\\\text{Overtime hours}&=3\\text{ hours}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "What is his wage for a week in which he works 41 hours, if overtime hours is paid at time-and-a-half?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1069.30",
          "worked": "$\\begin{align*}\\text{Overtime pay}&=25.16\\times3\\times1.5\\\\\\text{Overtime pay}&=\\$113.22\\\\\\text{Total wage}&=956.08+113.22\\\\\\text{Total wage}&=\\$1069.30\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
