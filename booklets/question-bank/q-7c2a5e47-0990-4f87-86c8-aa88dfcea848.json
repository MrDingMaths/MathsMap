  "content": {
    "id": "p35-q2",
    "type": "question",
    "label": "2",
    "prompt": "Find each indefinite integral using the given substitution.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int 2(2x+3)^3\\,dx,\\quad u=2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14(2x+3)^4+C$",
          "worked": "$$\\begin{aligned}u&=2x+3\\\\\\frac{du}{dx}&=2\\\\dx&=\\frac12\\,du\\end{aligned}$$\n$$\\begin{aligned}\\int 2(2x+3)^3\\,dx&=\\int 2u^3\\cdot\\frac12\\,du\\\\&=\\int u^3\\,du\\\\&=\\frac{u^4}{4}+C\\\\&=\\frac14(2x+3)^4+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p35-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int 3x^2(1+x^3)^4\\,dx,\\quad u=1+x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac15(1+x^3)^5+C$",
          "worked": "$$\\begin{aligned}u&=1+x^3\\\\\\frac{du}{dx}&=3x^2\\\\du&=3x^2\\,dx\\end{aligned}$$\n$$\\begin{aligned}\\int 3x^2(1+x^3)^4\\,dx&=\\int u^4\\,du\\\\&=\\frac{u^5}{5}+C\\\\&=\\frac15(1+x^3)^5+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p35-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{2x}{(1+x^2)^2}\\,dx,\\quad u=1+x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{1+x^2}+C$",
          "worked": "$$\\begin{aligned}u&=1+x^2\\\\\\frac{du}{dx}&=2x\\\\du&=2x\\,dx\\end{aligned}$$\n$$\\begin{aligned}\\int\\frac{2x}{(1+x^2)^2}\\,dx&=\\int u^{-2}\\,du\\\\&=-u^{-1}+C\\\\&=-\\frac{1}{1+x^2}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p35-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{3}{\\sqrt{3x-5}}\\,dx,\\quad u=3x-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{3x-5}+C$",
          "worked": "$$\\begin{aligned}u&=3x-5\\\\\\frac{du}{dx}&=3\\\\dx&=\\frac13\\,du\\end{aligned}$$\n$$\\begin{aligned}\\int\\frac{3}{\\sqrt{3x-5}}\\,dx&=\\int\\frac{3}{\\sqrt u}\\cdot\\frac13\\,du\\\\&=\\int u^{-1/2}\\,du\\\\&=2u^{1/2}+C\\\\&=2\\sqrt{3x-5}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p35-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int\\sin^3x\\cos x\\,dx,\\quad u=\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14\\sin^4x+C$",
          "worked": "$$\\begin{aligned}u&=\\sin x\\\\\\frac{du}{dx}&=\\cos x\\\\du&=\\cos x\\,dx\\end{aligned}$$\n$$\\begin{aligned}\\int\\sin^3x\\cos x\\,dx&=\\int u^3\\,du\\\\&=\\frac{u^4}{4}+C\\\\&=\\frac14\\sin^4x+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p35-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int\\frac{4x^3}{1+x^4}\\,dx,\\quad u=1+x^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln(1+x^4)+C$",
          "worked": "$$\\begin{aligned}u&=1+x^4\\\\\\frac{du}{dx}&=4x^3\\\\du&=4x^3\\,dx\\end{aligned}$$\n$$\\begin{aligned}\\int\\frac{4x^3}{1+x^4}\\,dx&=\\int\\frac1u\\,du\\\\&=\\ln|u|+C\\\\&=\\ln(1+x^4)+C\\end{aligned}$$\nSince $1+x^4>0$, absolute value signs are unnecessary in the final answer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      }
    ]
  },
