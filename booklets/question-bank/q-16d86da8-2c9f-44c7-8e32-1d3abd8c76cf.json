    "children": [
      {
        "id": "p16-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2+5x+6}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$",
          "worked": "$$\\begin{aligned}\\frac{x^2+5x+6}{x+2}&=\\frac{(x+2)(x+3)}{x+2}\\\\&=x+3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x+2}{x^2+5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x+3}$",
          "worked": "$$\\begin{aligned}\\frac{x+2}{x^2+5x+6}&=\\frac{x+2}{(x+2)(x+3)}\\\\&=\\frac{1}{x+3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2-9}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$",
          "worked": "$$\\begin{aligned}\\frac{x^2-9}{x-3}&=\\frac{(x-3)(x+3)}{x-3}\\\\&=x+3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x-3}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x+3}$",
          "worked": "$$\\begin{aligned}\\frac{x-3}{x^2-9}&=\\frac{x-3}{(x-3)(x+3)}\\\\&=\\frac{1}{x+3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x^2-9}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-3$",
          "worked": "$$\\begin{aligned}\\frac{x^2-9}{x+3}&=\\frac{(x-3)(x+3)}{x+3}\\\\&=x-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x+3}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
