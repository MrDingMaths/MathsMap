    "children": [
      {
        "id": "v2-4-practice-section-slot-18-035337-slot-18-a",
        "type": "part",
        "label": "a",
        "prompt": "The mass of a drug in the bloodstream is $M=M_0e^{-kt}$, where $t$ is the time in hours after a dose and $M_0$ is the original mass. After 5 hours, $40\\%$ of the dose remains. Find $k$ exactly, and hence find, correct to two decimal places, when only $10\\%$ of the dose remains.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\frac15\\ln\\!\\left(\\frac52\\right)\\approx0.1833$; $t=\\dfrac{5\\ln10}{\\ln2.5}\\approx12.56$ hours.",
          "worked": "$$\\begin{align*}0.4M_0&=M_0e^{-5k}\\\\e^{-5k}&=0.4\\\\-5k&=\\ln(0.4)\\\\k&=-\\frac15\\ln(0.4)=\\frac15\\ln\\!\\left(\\frac52\\right)\\end{align*}$$\nWhen $10\\%$ remains:\n$$\\begin{align*}e^{-kt}&=0.1\\\\-kt&=\\ln(0.1)\\\\t&=\\frac{\\ln10}{k}\\\\&=\\frac{5\\ln10}{\\ln2.5}\\\\&\\approx12.56\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-4-practice-section-slot-18-035337-slot-18-b",
        "type": "part",
        "label": "b",
        "prompt": "A pesticide breaks down in soil so that its mass is $M=M_0e^{-0.08t}$, where $t$ is the time in days. How many days after half of the pesticide has broken down until only $10\\%$ remains? Give your answer correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12.5\\ln5\\approx20.12$ days.",
          "worked": "Half remains:\n$$\\begin{align*}e^{-0.08t_1}&=0.5\\\\t_1&=-\\frac{\\ln0.5}{0.08}\\end{align*}$$\n$10\\%$ remains:\n$$\\begin{align*}e^{-0.08t_2}&=0.1\\\\t_2&=-\\frac{\\ln0.1}{0.08}\\end{align*}$$\n$$\\begin{align*}t_2-t_1&=\\frac{\\ln0.5-\\ln0.1}{0.08}\\\\&=\\frac{\\ln5}{0.08}\\\\&\\approx20.12\\text{ days}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
