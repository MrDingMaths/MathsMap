  "content": {
    "id": "p31-q7-root",
    "type": "question",
    "label": "7",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p31-q7-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A container of hot water is placed in a refrigerator running at ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "0^\\circ\\mathrm{C}",
              "display": false
            },
            {
              "type": "text",
              "text": ". The water is known to cool according to Newton’s Law of Cooling; with a given starting temperature of ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "96^\\circ\\mathrm{C}",
              "display": false
            },
            {
              "type": "text",
              "text": " its temperature halves every 20 minutes. The formula is given by",
              "marks": []
            }
          ]
        },
        {
          "id": "p31-q7-formula",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "T=96\\times\\left(\\frac{1}{2}\\right)^{3n}",
              "display": false
            },
            {
              "type": "text",
              "text": ", where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "n",
              "display": false
            },
            {
              "type": "text",
              "text": " is in hours",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the temperature after 2 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5^\\circ\\mathrm{C}$",
          "worked": "$$\\begin{align*}T&=96\\times\\left(\\frac12\\right)^{3n}\\\\T&=96\\times\\left(\\frac12\\right)^{3\\times2}\\\\T&=96\\times\\left(\\frac12\\right)^6\\\\T&=1.5^\\circ\\mathrm{C}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p31-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "How long does it take, correct to the nearest minute, for the temperature to fall to $1^\\circ\\mathrm{C}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "132 minutes",
          "worked": "$$\\begin{align*}T&=96\\times\\left(\\frac12\\right)^{3n}\\\\1&=96\\times\\left(\\frac12\\right)^{3n}\\\\\\frac1{96}&=\\left(\\frac12\\right)^{3n}\\\\\\log_{\\frac12}\\left(\\frac1{96}\\right)&=3n\\\\n&=\\frac{\\log_{\\frac12}\\left(\\frac1{96}\\right)}{3}\\end{align*}$$\nThe time in minutes is\n$$\\begin{align*}60n&=20\\log_{\\frac12}\\left(\\frac1{96}\\right)\\\\60n&\\approx132\\end{align*}$$\nThe temperature falls to $1^\\circ\\mathrm{C}$ after 132 minutes, to the nearest minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
