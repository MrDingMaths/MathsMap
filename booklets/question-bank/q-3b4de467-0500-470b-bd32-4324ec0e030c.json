    "children": [
      {
        "id": "v2-49160-p14-practice-j20-213223-j20-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x}{3}+\\dfrac{x}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{2}$",
          "worked": "$$\\begin{align*}\\frac{x}{3}+\\frac{x}{6}&=\\frac{2x}{6}+\\frac{x}{6}\\\\&=\\frac{3x}{6}\\\\&=\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-49160-p14-practice-j20-213223-j20-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$1\\div\\left(\\dfrac{x}{3}+\\dfrac{x}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{x}$",
          "worked": "$$\\begin{align*}1\\div\\left(\\frac{x}{3}+\\frac{x}{6}\\right)&=1\\div\\frac{x}{2}\\\\&=1\\times\\frac{2}{x}\\\\&=\\frac{2}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-49160-p14-practice-j20-213223-j20-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$1\\div\\dfrac{x}{3}+1\\div\\dfrac{x}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9}{x}$",
          "worked": "$$\\begin{align*}1\\div\\frac{x}{3}+1\\div\\frac{x}{6}&=\\frac{3}{x}+\\frac{6}{x}\\\\&=\\frac{9}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-49160-p14-practice-j20-213223-j20-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$1\\div\\left(\\dfrac{1}{x}+\\dfrac{1}{2x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x}{3}$",
          "worked": "$$\\begin{align*}1\\div\\left(\\frac{1}{x}+\\frac{1}{2x}\\right)&=1\\div\\left(\\frac{2}{2x}+\\frac{1}{2x}\\right)\\\\&=1\\div\\frac{3}{2x}\\\\&=1\\times\\frac{2x}{3}\\\\&=\\frac{2x}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
