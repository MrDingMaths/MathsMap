          {
            "id": "p24-q7c",
            "type": "part",
            "label": "c",
            "prompt": "Calculate $x$ using the cosine ratio. Round your answer to 2 decimal places.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x\\approx1.69$",
              "worked": "$x$ is adjacent to $\\angle C=65^{\\circ}$ and the hypotenuse is $4$.\n$$\\begin{align*}\\cos\\theta&=\\frac{A}{H}\\\\\\cos65^{\\circ}&=\\frac{x}{4}\\\\4\\cos65^{\\circ}&=x\\\\x&\\approx1.69\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 43
          }
        ]
