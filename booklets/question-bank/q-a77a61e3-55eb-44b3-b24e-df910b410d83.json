      {
        "id": "p10-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{x^2-4x}{12}=\\frac{x-4}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=6$",
          "worked": "Multiply by $12$.\n$$\\begin{align*}x^2-4x&=6(x-4)\\\\x^2-4x&=6x-24\\\\x^2-10x+24&=0\\\\(x-4)(x-6)&=0\\\\x-4&=0\\quad\\text{or}\\quad x-6=0\\\\x&=4\\quad\\text{or}\\quad x=6\\end{align*}$$",
          "solutionDiagrams": []
