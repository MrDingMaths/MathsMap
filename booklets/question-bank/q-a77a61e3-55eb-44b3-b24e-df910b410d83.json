      {
        "id": "p10-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+5=\\frac{14}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7$ or $x=2$",
          "worked": "For $x\\ne0$, multiply by $x$.\n$$\\begin{align*}x^2+5x&=14\\\\x^2+5x-14&=0\\\\(x+7)(x-2)&=0\\\\x+7&=0\\quad\\text{or}\\quad x-2=0\\\\x&=-7\\quad\\text{or}\\quad x=2\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{15}{x}=x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $x=5$",
          "worked": "For $x\\ne0$, multiply by $x$.\n$$\\begin{align*}15&=x(x-2)\\\\x^2-2x-15&=0\\\\(x+3)(x-5)&=0\\\\x+3&=0\\quad\\text{or}\\quad x-5=0\\\\x&=-3\\quad\\text{or}\\quad x=5\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{6}{x}-x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $x=2$",
          "worked": "For $x\\ne0$, multiply by $x$.\n$$\\begin{align*}6-x^2&=x\\\\x^2+x-6&=0\\\\(x+3)(x-2)&=0\\\\x+3&=0\\quad\\text{or}\\quad x-2=0\\\\x&=-3\\quad\\text{or}\\quad x=2\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x+\\frac{6}{x}=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $x=6$",
          "worked": "For $x\\ne0$, multiply by $x$.\n$$\\begin{align*}x^2+6&=7x\\\\x^2-7x+6&=0\\\\(x-1)(x-6)&=0\\\\x-1&=0\\quad\\text{or}\\quad x-6=0\\\\x&=1\\quad\\text{or}\\quad x=6\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$x+\\frac{32}{x}=18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=16$",
          "worked": "For $x\\ne0$, multiply by $x$.\n$$\\begin{align*}x^2+32&=18x\\\\x^2-18x+32&=0\\\\(x-2)(x-16)&=0\\\\x-2&=0\\quad\\text{or}\\quad x-16=0\\\\x&=2\\quad\\text{or}\\quad x=16\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{x+1}{3}=\\frac{10}{x}$",
