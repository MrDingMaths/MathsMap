  "content": {
    "id": "p12-q32-root",
    "type": "question",
    "label": "32",
    "prompt": "Find the coefficient of $x^5$ in the expansion of $\\left(\\frac{x^2}{2}-\\frac{3}{x^3}\\right)^{10}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\frac{405}{16}$",
      "worked": "$$\\begin{align*}T_k&=\\binom{10}{k}\\left(\\frac{x^2}{2}\\right)^{10-k}\\left(-\\frac{3}{x^3}\\right)^k\\\\T_k&=\\binom{10}{k}\\left(\\frac12\\right)^{10-k}(-3)^kx^{20-5k}\\end{align*}$$\nFor the $x^5$ term:\n$$\\begin{align*}20-5k&=5\\\\k&=3\\end{align*}$$\n$$\\begin{align*}\\text{Coefficient of }x^5&=\\binom{10}{3}\\left(\\frac12\\right)^7(-3)^3\\\\\\text{Coefficient of }x^5&=-\\frac{405}{16}\\end{align*}$$",
      "solutionDiagrams": []
    },
