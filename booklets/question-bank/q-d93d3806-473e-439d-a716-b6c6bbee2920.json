  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Let $P(x)=4x^3-8x^2-11x-3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x=-\\dfrac12$ is a double root of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-\\tfrac12)=P'(-\\tfrac12)=0$ and $P''(-\\tfrac12)=-28\\ne0$, so $-\\tfrac12$ is a double root.",
          "worked": "$$\\begin{aligned}P\\left(-\\frac12\\right)&=4\\left(-\\frac12\\right)^3-8\\left(-\\frac12\\right)^2-11\\left(-\\frac12\\right)-3\\\\&=-\\frac12-2+\\frac{11}{2}-3\\\\&=0\\\\P'(x)&=12x^2-16x-11\\\\P'\\left(-\\frac12\\right)&=3+8-11\\\\&=0\\\\P''(x)&=24x-16\\\\P''\\left(-\\frac12\\right)&=-28\\ne0.\\end{aligned}$$Therefore $x=-\\dfrac12$ is a double root.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the third root.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$.",
          "worked": "Let the third root be $r$. Using the sum of roots,\n$$\\begin{aligned}-\\frac12-\\frac12+r&=-\\frac{-8}{4}\\\\-1+r&=2\\\\r&=3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
