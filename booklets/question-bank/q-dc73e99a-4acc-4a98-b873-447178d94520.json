    "children": [
      {
        "id": "p9-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "By restricting $f(x)$ to a monotonic increasing domain, find the inverse of $f(x)=x^2+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Restrict to $x\\geq0$. Then $f^{-1}(x)=\\sqrt{x-1}$, for $x\\geq1$.",
          "worked": "Restrict $f$ to $x\\geq0$, where it is monotonically increasing. Swap $x$ and $y$:\n$$\\begin{aligned}x&=y^2+1\\\\y^2&=x-1\\\\y&=\\sqrt{x-1}\\\\f^{-1}(x)&=\\sqrt{x-1},\\qquad x\\geq1.\\end{aligned}$$\nThe positive square root is required because the inverse has range $y\\geq0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p9-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the derivative of the inverse function $(f^{-1})'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f^{-1})'(x)=\\dfrac{1}{2\\sqrt{x-1}}$, for $x>1$.",
          "worked": "$$\\begin{aligned}(f^{-1})'(x)&=\\frac12(x-1)^{-1/2}\\\\&=\\frac{1}{2\\sqrt{x-1}},\\qquad x>1.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $(5,2)$ lies on $f^{-1}$, find the gradient of the tangent at this point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14$.",
          "worked": "$$\\begin{aligned}f'(x)&=2x\\\\(f^{-1})'(5)&=\\frac{1}{f'(2)}\\\\&=\\frac{1}{2(2)}\\\\&=\\frac14.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
