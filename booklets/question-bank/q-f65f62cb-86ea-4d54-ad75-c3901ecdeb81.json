  "content": {
    "id": "p29-q06-root",
    "type": "question",
    "label": "6",
    "prompt": "One more than a certain positive number is five less than the number squared. Find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3$",
      "worked": "Let $x$ be the positive number.\n$$\\begin{align*}x+1&=x^2-5\\\\0&=x^2-x-6\\\\0&=(x-3)(x+2)\\\\x&=3\\text{ or }-2\\end{align*}$$\nSince the number is positive, it is $3$. Check: $3+1=4$ and $3^2-5=4$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
