    "children": [
      {
        "id": "p22-q58-response",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac5{\\sqrt[3]2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\sqrt[3]4}{2}$",
          "worked": "$$\\begin{align*}\\frac5{\\sqrt[3]2}&=\\frac{5\\sqrt[3]4}{\\sqrt[3]2\\times\\sqrt[3]4}\\\\\\frac5{\\sqrt[3]2}&=\\frac{5\\sqrt[3]4}{\\sqrt[3]8}\\\\\\frac5{\\sqrt[3]2}&=\\frac{5\\sqrt[3]4}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q59-response",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac4{\\sqrt[3]3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4\\sqrt[3]9}{3}$",
          "worked": "$$\\begin{align*}\\frac4{\\sqrt[3]3}&=\\frac{4\\sqrt[3]9}{\\sqrt[3]3\\times\\sqrt[3]9}\\\\\\frac4{\\sqrt[3]3}&=\\frac{4\\sqrt[3]9}{\\sqrt[3]{27}}\\\\\\frac4{\\sqrt[3]3}&=\\frac{4\\sqrt[3]9}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q60-response",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac8{\\sqrt[3]4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt[3]2$",
          "worked": "$$\\begin{align*}\\frac8{\\sqrt[3]4}&=\\frac{8\\sqrt[3]2}{\\sqrt[3]4\\times\\sqrt[3]2}\\\\\\frac8{\\sqrt[3]4}&=\\frac{8\\sqrt[3]2}{2}\\\\\\frac8{\\sqrt[3]4}&=4\\sqrt[3]2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q61-response",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac1{\\sqrt[3]9}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt[3]3}{3}$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt[3]9}&=\\frac{\\sqrt[3]3}{\\sqrt[3]9\\times\\sqrt[3]3}\\\\\\frac1{\\sqrt[3]9}&=\\frac{\\sqrt[3]3}{\\sqrt[3]{27}}\\\\\\frac1{\\sqrt[3]9}&=\\frac{\\sqrt[3]3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
