    "children": [
      {
        "id": "v2-14b8f-p29-practice-slot-5-slot-5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^2(3x^2+4x-1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{align*}\\int_0^2(3x^2+4x-1)\\,dx&=\\left[x^3+2x^2-x\\right]_0^2\\\\&=(8+8-2)-0\\\\&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-14b8f-p29-practice-slot-5-slot-5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^2\\left(x^3-\\frac{2}{x^2}\\right)dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11}{4}$",
          "worked": "$$\\begin{align*}\\int_1^2\\left(x^3-\\frac{2}{x^2}\\right)dx&=\\int_1^2(x^3-2x^{-2})\\,dx\\\\&=\\left[\\frac{x^4}{4}+\\frac2x\\right]_1^2\\\\&=(4+1)-\\left(\\frac14+2\\right)\\\\&=\\frac{11}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-14b8f-p29-practice-slot-5-slot-5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_1^3(x+2)(x-1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{26}{3}$",
          "worked": "$$\\begin{align*}\\int_1^3(x+2)(x-1)\\,dx&=\\int_1^3(x^2+x-2)\\,dx\\\\&=\\left[\\frac{x^3}{3}+\\frac{x^2}{2}-2x\\right]_1^3\\\\&=\\left(9+\\frac92-6\\right)-\\left(\\frac13+\\frac12-2\\right)\\\\&=\\frac{15}{2}+\\frac76\\\\&=\\frac{26}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
