  "content": {
    "id": "p2-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A line has gradient $2$ and passes through the point $(-1,6)$. Find the equation of the line.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=2x+8$",
      "worked": "Using $y=mx+c$ with $m=2$ and the point $(-1,6)$:\n$$\\begin{align*}6&=2(-1)+c\\\\6&=-2+c\\\\c&=8\\end{align*}$$\nTherefore $y=2x+8$.",
      "solutionDiagrams": []
    },
