        "id": "p16-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "How many diagonals does a regular octagon have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20",
          "worked": "Each pair of vertices determines a side or a diagonal. Exclude the 8 sides.\n$$\\begin{align*}\n\\text{Number of diagonals} &= \\binom{8}{2}-8\\\\\n\\text{Number of diagonals} &= \\frac{8\\times7}{2}-8\\\\\n\\text{Number of diagonals} &= 20.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "How many diagonals does a regular $n$-sided polygon have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p16-q10-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{n(n-3)}{2}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p16-q10-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Choose two vertices and subtract the ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "n",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " sides.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Each pair of vertices determines a side or a diagonal. Exclude the $n$ sides.\n$$\\begin{align*}\n\\text{Number of diagonals} &= \\binom{n}{2}-n\\\\\n\\text{Number of diagonals} &= \\frac{n(n-1)}{2}-n\\\\\n\\text{Number of diagonals} &= \\frac{n(n-1)-2n}{2}\\\\\n\\text{Number of diagonals} &= \\frac{n(n-3)}{2}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
