      {
        "id": "p26-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$2m^4n^3\\times5m^6n^7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10m^{10}n^{10}$",
          "worked": "$$\\begin{align*}2m^4n^3\\times5m^6n^7&=10m^{4+6}n^{3+7}\\\\2m^4n^3\\times5m^6n^7&=10m^{10}n^{10}\\end{align*}$$",
