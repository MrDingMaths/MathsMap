        },
        "answerSpaceMm": 28
      },
      {
        "id": "p26-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{8m^4n^2}{7m^3n}\\div\\dfrac{3m^3n^5}{14m^9n^{16}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16m^7n^{12}}{3}$\n\nMultiply by the reciprocal, then simplify using the index laws.",
          "worked": "$$\\begin{align*}\\frac{8m^4n^2}{7m^3n}\\div\\frac{3m^3n^5}{14m^9n^{16}}&=\\frac{8m^4n^2}{7m^3n}\\times\\frac{14m^9n^{16}}{3m^3n^5}\\\\\\frac{8m^4n^2}{7m^3n}\\div\\frac{3m^3n^5}{14m^9n^{16}}&=\\frac{112m^{13}n^{18}}{21m^6n^6}\\\\\\frac{8m^4n^2}{7m^3n}\\div\\frac{3m^3n^5}{14m^9n^{16}}&=\\frac{16m^7n^{12}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{(2x^2y)^3}{5x^6y^2}\\times\\left(\\dfrac{x^3}{2y^2}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^9}{5y^5}$\n\nRaise every factor to its indicated power, then simplify.",
          "worked": "$$\\begin{align*}\\frac{(2x^2y)^3}{5x^6y^2}\\times\\left(\\frac{x^3}{2y^2}\\right)^3&=\\frac{8x^6y^3}{5x^6y^2}\\times\\frac{x^9}{8y^6}\\\\\\frac{(2x^2y)^3}{5x^6y^2}\\times\\left(\\frac{x^3}{2y^2}\\right)^3&=\\frac{8x^{15}y^3}{40x^6y^8}\\\\\\frac{(2x^2y)^3}{5x^6y^2}\\times\\left(\\frac{x^3}{2y^2}\\right)^3&=\\frac{x^9}{5y^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{(4ab)^3\\times5a^2b}{(10ab^2)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16a^3}{5}$",
          "worked": "$$\\begin{align*}\\frac{(4ab)^3\\times5a^2b}{(10ab^2)^2}&=\\frac{64a^3b^3\\times5a^2b}{100a^2b^4}\\\\\\frac{(4ab)^3\\times5a^2b}{(10ab^2)^2}&=\\frac{320a^5b^4}{100a^2b^4}\\\\\\frac{(4ab)^3\\times5a^2b}{(10ab^2)^2}&=\\frac{16a^3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p26-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{(3x^2y)^3\\times2(xy^2)^3}{(3xy)^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x^5y^5}{3}$",
          "worked": "$$\\begin{align*}\\frac{(3x^2y)^3\\times2(xy^2)^3}{(3xy)^4}&=\\frac{27x^6y^3\\times2x^3y^6}{81x^4y^4}\\\\\\frac{(3x^2y)^3\\times2(xy^2)^3}{(3xy)^4}&=\\frac{54x^9y^9}{81x^4y^4}\\\\\\frac{(3x^2y)^3\\times2(xy^2)^3}{(3xy)^4}&=\\frac{2x^5y^5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
