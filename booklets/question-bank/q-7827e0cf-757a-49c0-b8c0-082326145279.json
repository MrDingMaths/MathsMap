        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{20a^4b^2}{5a^2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2b$",
          "worked": "$$\\begin{align*}\\frac{20a^4b^2}{5a^2b}&=4a^{4-2}b^{2-1}\\\\\\frac{20a^4b^2}{5a^2b}&=4a^2b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{24m^9n^4}{18m^6n^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4m^3n^2}{3}$",
          "worked": "$$\\begin{align*}\\frac{24m^9n^4}{18m^6n^2}&=\\frac{4}{3}m^{9-6}n^{4-2}\\\\\\frac{24m^9n^4}{18m^6n^2}&=\\frac{4m^3n^2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$(3a^3b)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81a^{12}b^4$",
          "worked": "$$\\begin{align*}(3a^3b)^4&=3^4a^{3\\times4}b^4\\\\(3a^3b)^4&=81a^{12}b^4\\end{align*}$$",
