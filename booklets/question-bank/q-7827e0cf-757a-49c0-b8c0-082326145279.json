        "children": [],
        "answer": {
          "short": "$100a^8b^5$",
          "worked": "$$\\begin{align*}(5a^2b)^2\\times4a^4b^3&=25a^4b^2\\times4a^4b^3\\\\(5a^2b)^2\\times4a^4b^3&=100a^{4+4}b^{2+3}\\\\(5a^2b)^2\\times4a^4b^3&=100a^8b^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{5a^6b^7}{4a^3b^2}\\times\\dfrac{12a^{10}b^9}{a^6b^7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15a^7b^7$",
          "worked": "$$\\begin{align*}\\frac{5a^6b^7}{4a^3b^2}\\times\\frac{12a^{10}b^9}{a^6b^7}&=\\frac{60a^{16}b^{16}}{4a^9b^9}\\\\\\frac{5a^6b^7}{4a^3b^2}\\times\\frac{12a^{10}b^9}{a^6b^7}&=15a^7b^7\\end{align*}$$",
