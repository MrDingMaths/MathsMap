  "content": {
    "id": "v2-c147d-p51-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Evaluate $$\\int_0^{\\pi/3}\\tan x\\,dx$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\ln 2$",
      "worked": "$$\\begin{align*}\\int_0^{\\pi/3}\\tan x\\,dx&=\\int_0^{\\pi/3}\\frac{\\sin x}{\\cos x}\\,dx\\\\&=\\int\\frac{\\sin x}{u}\\cdot\\frac{du}{-\\sin x}\\qquad(u=\\cos x,\\ du=-\\sin x\\,dx)\\\\&=-\\int\\frac{1}{u}\\,du\\\\&=-\\ln|u|\\\\&=\\Big[-\\ln|\\cos x|\\Big]_0^{\\pi/3}\\\\&=-\\ln\\tfrac12+\\ln 1\\\\&=\\ln 2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
