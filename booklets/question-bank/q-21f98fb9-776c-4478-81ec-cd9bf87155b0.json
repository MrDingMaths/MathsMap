            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}A&=\\frac{xy}{2}\\\\12&=\\frac{x^2}{2}\\\\x^2&=24\\\\x&=2\\sqrt{6}\\text{ cm}.\\end{aligned}",
                "display": true
              }
            ]
          },
          {
