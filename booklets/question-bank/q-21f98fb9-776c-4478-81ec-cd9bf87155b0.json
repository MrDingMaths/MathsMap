          {
            "id": "p35-q9-method2-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using Pythagoras, the diagonal has length",
                "marks": []
              }
            ]
          },
          {
            "id": "p35-q9-method2-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}d&=\\sqrt{(\\sqrt{12})^2+(\\sqrt{12})^2}\\\\d&=\\sqrt{12+12}\\\\d&=\\sqrt{24}\\\\d&=2\\sqrt{6}\\text{ cm}.\\end{aligned}",
