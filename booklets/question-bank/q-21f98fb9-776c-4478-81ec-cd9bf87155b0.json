  "content": {
    "id": "p35-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the length of the diagonal of a square, which has an area of $12\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\sqrt{6}\\text{ cm}$. The diagonal satisfies $d^2=12+12=24$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p35-q9-answer",
            "type": "paragraph",
