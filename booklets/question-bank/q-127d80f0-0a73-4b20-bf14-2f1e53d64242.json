          "inlines": [
            {
              "type": "text",
              "text": "Two vehicles are 150 km apart and travel towards each other at 60 km/h and 40 km/h. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Both vehicles reduce the gap, so add the distances they travel in the same time.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-closing-rate-bridge-a",
        "type": "part",
        "label": "a",
        "prompt": "How much of the gap do they close in one hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\text{ km}$",
          "worked": "$$60+40=100\\text{ km}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p29-closing-rate-bridge-b",
        "type": "part",
        "label": "b",
        "prompt": "What is their combined closing rate?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\text{ km/h}$",
          "worked": "$$\\frac{100\\text{ km}}{1\\text{ h}}=100\\text{ km/h}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p29-closing-rate-bridge-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the closing rate to find how long they take to meet.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5\\text{ h}$",
          "worked": "$$\\begin{align*}\\frac{150\\text{ km}}{t\\text{ h}}&=\\frac{100\\text{ km}}{1\\text{ h}}\\\\\\frac{t}{150}&=\\frac{1}{100}\\\\t&=1.5\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
