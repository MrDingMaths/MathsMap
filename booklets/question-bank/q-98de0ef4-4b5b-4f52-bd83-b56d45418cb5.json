        "prompt": "$$\\begin{aligned}x+y&=5\\\\3x+y&=9\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=3$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(3x+y)-(x+y)&=9-5\\\\2x&=4\\\\x&=2\\\\2+y&=5\\\\y&=3\\end{align*}$$\nCheck: $2+3=5$ and $3(2)+3=9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}3x+4y&=15\\\\x+4y&=13\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=3$",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}(3x+4y)-(x+4y)&=15-13\\\\2x&=2\\\\x&=1\\\\1+4y&=13\\\\4y&=12\\\\y&=3\\end{align*}$$\nCheck: $3(1)+4(3)=15$ and $1+4(3)=13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}2x-y&=7\\\\4x-y&=15\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4,\\ y=1$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(4x-y)-(2x-y)&=15-7\\\\2x&=8\\\\x&=4\\\\8-y&=7\\\\y&=1\\end{align*}$$\nCheck: $2(4)-1=7$ and $4(4)-1=15$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}3x-2y&=1\\\\5x-2y&=7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=4$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(5x-2y)-(3x-2y)&=7-1\\\\2x&=6\\\\x&=3\\\\9-2y&=1\\\\-2y&=-8\\\\y&=4\\end{align*}$$\nCheck: $3(3)-2(4)=1$ and $5(3)-2(4)=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}2x+y&=6\\\\2x-3y&=-4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac74,\\ y=\\frac52$",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}(2x+y)-(2x-3y)&=6-(-4)\\\\4y&=10\\\\y&=\\frac52\\\\2x+\\frac52&=6\\\\2x&=\\frac72\\\\x&=\\frac74\\end{align*}$$\nCheck: $2(\\frac74)+\\frac52=6$ and $2(\\frac74)-3(\\frac52)=-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p12-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}3x-5y&=10\\\\3x+6y&=21\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5,\\ y=1$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(3x+6y)-(3x-5y)&=21-10\\\\11y&=11\\\\y&=1\\\\3x-5&=10\\\\3x&=15\\\\x&=5\\end{align*}$$\nCheck: $3(5)-5(1)=10$ and $3(5)+6(1)=21$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}2x+3y&=1\\\\-x+3y&=4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ y=1$",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}(2x+3y)-(-x+3y)&=1-4\\\\3x&=-3\\\\x&=-1\\\\-2+3y&=1\\\\3y&=3\\\\y&=1\\end{align*}$$\nCheck: $2(-1)+3(1)=1$ and $-(-1)+3(1)=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}x-2y&=-8\\\\3x-2y&=-12\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ y=3$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}(3x-2y)-(x-2y)&=-12-(-8)\\\\2x&=-4\\\\x&=-2\\\\-2-2y&=-8\\\\-2y&=-6\\\\y&=3\\end{align*}$$\nCheck: $-2-2(3)=-8$ and $3(-2)-2(3)=-12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q2-i",
