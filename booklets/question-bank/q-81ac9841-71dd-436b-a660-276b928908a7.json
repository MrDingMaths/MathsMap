  "content": {
    "id": "p3-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A container is continuously filled with water, and the volume of water after $t$ minutes is given by\n$$V(t)=t^2+t+1,$$\nwhere $V$ is measured in litres.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the volume of water in the container initially $(t=0)$ and when $t=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Initially $1\\text{ L}$; when $t=3$, $13\\text{ L}$.",
          "worked": "$$\\begin{align*}V(0)&=0^2+0+1=1\\text{ L},\\\\V(3)&=3^2+3+1=13\\text{ L}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p3-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the average rate of change of $V$ over the interval $t\\in[0,3]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\text{ L/min}$.",
          "worked": "$$\\begin{align*}\\text{Average rate}&=\\frac{V(3)-V(0)}{3-0}\\\\\\text{Average rate}&=\\frac{13-1}{3}=4\\text{ L/min}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p3-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the average rate of change of $V$ over the interval $t\\in[1,4]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ L/min}$.",
          "worked": "$$\\begin{align*}V(1)&=1^2+1+1=3,\\\\V(4)&=4^2+4+1=21,\\\\\\text{Average rate}&=\\frac{V(4)-V(1)}{4-1}\\\\\\text{Average rate}&=\\frac{21-3}{3}=6\\text{ L/min}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
