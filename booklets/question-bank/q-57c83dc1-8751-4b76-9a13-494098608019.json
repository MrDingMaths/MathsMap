  "content": {
    "id": "p6-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Determine whether the following are true or false.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_6\\left(\\frac16\\right)=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True, since $6^{-1}=\\frac16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_6(1)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True, since $6^0=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_6(6)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True, since $6^1=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac12\\log_3(10)=\\log_3(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. The power law gives $\\tfrac12\\log_3(10)=\\log_3(\\sqrt{10})$, and $\\sqrt{10}\\ne 5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log(5)+\\log(2)=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False.\n\n$$\\begin{align*}\\log(5)+\\log(2)&=\\log(10)\\\\\\log(5)+\\log(2)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log(a)-\\log(b)=\\frac{\\log(a)}{\\log(b)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. For $a=b=10$, the left side is $1-1=0$ and the right side is $\\frac11=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log(a)-\\log(b)=\\log\\left(\\frac{a}{b}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True by the quotient law for $a,b>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_3(9)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. Since $3^2=9$, $\\log_3(9)=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\log_9(3)=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True, since $9^{1/2}=\\sqrt9=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\log_5(20)=1+\\log_5(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True.\n\n$$\\begin{align*}\\log_5(20)&=\\log_5(5\\cdot4)\\\\\\log_5(20)&=\\log_5(5)+\\log_5(4)\\\\\\log_5(20)&=1+\\log_5(4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\log_5\\left(\\frac{1}{25}\\right)=-\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. Since $5^{-2}=\\frac1{25}$, $\\log_5\\left(\\frac1{25}\\right)=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\log_6(2)\\times\\log_6(3)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. Both $2$ and $3$ lie between $6^0$ and $6^1$, so both logarithms lie between $0$ and $1$. Their product is less than $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\log_6(2)+\\log_6(3)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True.\n\n$$\\begin{align*}\\log_6(2)+\\log_6(3)&=\\log_6(2\\cdot3)\\\\\\log_6(2)+\\log_6(3)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{\\log(x^4)}{\\log(x)}=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True where the quotient is defined, for $x>0$ and $x\\ne1$.\n\n$$\\begin{align*}\\frac{\\log(x^4)}{\\log(x)}&=\\frac{4\\log(x)}{\\log(x)}\\\\\\frac{\\log(x^4)}{\\log(x)}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\frac{\\log_c(a)}{\\log_c(b)}=\\log_b(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True by the change-of-base rule for valid bases $b$ and $c$ and argument $a>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
