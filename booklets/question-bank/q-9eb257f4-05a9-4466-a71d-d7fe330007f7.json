  "content": {
    "id": "p33-q1-3",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p33-true-false-stem",
          "type": "paragraph",
          "fontSize": null,
