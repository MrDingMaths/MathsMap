  "content": {
    "id": "p36-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A circular disc expands as it is being heated. The area of the disc after $t$ minutes is given by $$A=3t^2+t,$$ where $A$ is in $\\mathrm{cm^2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the rate at which the area increases after 4 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\ \\mathrm{cm^2/min}$",
          "worked": "$$\\begin{align*}A'(t)&=6t+1\\\\A'(4)&=6(4)+1\\\\A'(4)&=25\\ \\mathrm{cm^2/min}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p36-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the average rate of change during the 4th minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22\\ \\mathrm{cm^2/min}$",
          "worked": "The fourth minute runs from $t=3$ to $t=4$. $$\\begin{align*}A(3)&=3(3)^2+3=30\\ \\mathrm{cm^2}\\\\A(4)&=3(4)^2+4=52\\ \\mathrm{cm^2}\\\\\\text{Average rate}&=\\frac{A(4)-A(3)}{4-3}\\\\\\text{Average rate}&=\\frac{52-30}{4-3}=22\\ \\mathrm{cm^2/min}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
