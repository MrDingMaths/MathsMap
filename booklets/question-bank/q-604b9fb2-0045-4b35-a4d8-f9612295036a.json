  "content": {
    "id": "p29-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the equation of the parabola in the following.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "A parabola has $x$-intercepts at $x=-2$ and $x=5$ and passes through $\\left(0,\\frac52\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac14(x+2)(x-5)$",
          "worked": "Use the intercepts to write $y=A(x+2)(x-5)$. Substitute $\\left(0,\\frac52\\right)$:\n$$\\begin{align*}\\frac52&=A(0+2)(0-5)\\\\\\frac52&=-10A\\\\A&=-\\frac14.\\end{align*}$$\nHence $y=-\\frac14(x+2)(x-5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p29-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "The coordinates of the vertex are $(2,-3)$ and the parabola passes through the point $(3,-5)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2(x-2)^2-3$",
          "worked": "Use the vertex to write $y=A(x-2)^2-3$. Substitute $(3,-5)$:\n$$\\begin{align*}-5&=A(3-2)^2-3\\\\-5&=A-3\\\\A&=-2.\\end{align*}$$\nHence $y=-2(x-2)^2-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
