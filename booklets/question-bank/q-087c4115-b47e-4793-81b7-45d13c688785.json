  "content": {
    "id": "p20-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The expression $\\dfrac{x^2+5x+6}{x^2+ax+b}$ simplifies to $\\dfrac{x+2}{x+5}$. Find $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=8,\\ b=15$",
      "worked": "$$\\begin{align*}x^2+5x+6&=(x+2)(x+3)\\end{align*}$$\nThe factor $x+3$ cancels, leaving $x+5$ in the denominator. Hence\n$$\\begin{align*}x^2+ax+b&=(x+3)(x+5)\\\\x^2+ax+b&=x^2+8x+15\\end{align*}$$\nComparing coefficients gives $a=8$ and $b=15$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
