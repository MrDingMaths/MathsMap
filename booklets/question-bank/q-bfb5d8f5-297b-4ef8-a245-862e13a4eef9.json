  "content": {
    "id": "p37-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "In a class of 21 students, a teacher writes six numbers on the board. Each student selects three of these numbers. Prove that at least two students have chosen the same three numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "There are only $\\binom{6}{3}=20$ possible selections. By the pigeonhole principle, at least two of the 21 students choose the same selection.",
      "worked": "The number of possible selections of three numbers is\n$$\\binom{6}{3}=20.$$\nUse these 20 selections as the pigeonholes and assign each student to the selection they chose. Since there are 21 students and only 20 pigeonholes, the pigeonhole principle guarantees that at least two students have chosen the same three numbers.",
      "solutionDiagrams": []
    },
