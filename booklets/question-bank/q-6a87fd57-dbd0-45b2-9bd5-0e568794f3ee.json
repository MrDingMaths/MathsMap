  "content": {
    "id": "p10-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Consider the formula $y = 2x + 4$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $x$ that makes $y = 16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 6$",
          "worked": "$$\\begin{align*}y &= 2x + 4\\\\16 &= 2x + 4\\\\12 &= 2x\\\\6 &= x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $x$ if $y = 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -2$",
          "worked": "$$\\begin{align*}y &= 2x + 4\\\\0 &= 2x + 4\\\\-4 &= 2x\\\\-2 &= x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
