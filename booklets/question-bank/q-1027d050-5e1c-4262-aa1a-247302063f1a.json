        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$2x+y-22=0$.",
          "worked": "$$\\begin{align*}x-2y+4&=0\\\\y&=\\frac12x+2\\end{align*}$$\nThe gradient of $l$ is $\\frac12$, so the perpendicular gradient is $-2$.\n$$\\begin{align*}y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-6&=-2(x-8)\\\\y-6&=-2x+16\\\\2x+y-22&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p25-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coordinates of $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(11,0)$.",
          "worked": "On the $x$-axis, $y=0$.\n$$\\begin{align*}2x+0-22&=0\\\\2x&=22\\\\x&=11\\end{align*}$$\nHence $C=(11,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
