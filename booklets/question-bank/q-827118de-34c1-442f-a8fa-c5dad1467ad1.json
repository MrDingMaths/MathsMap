        "answer": {
          "short": "$1.2\\times10^2$",
          "worked": "$$\\begin{align*}\\frac{8.4\\times10^4}{\\sqrt{4.9\\times10^5}}&=\\frac{8.4\\times10^4}{\\sqrt{49\\times10^4}}\\\\\\frac{8.4\\times10^4}{\\sqrt{4.9\\times10^5}}&=\\frac{8.4\\times10^4}{7\\times10^2}\\\\\\frac{8.4\\times10^4}{\\sqrt{4.9\\times10^5}}&=1.2\\times10^{4-2}\\\\\\frac{8.4\\times10^4}{\\sqrt{4.9\\times10^5}}&=1.2\\times10^2\\end{align*}$$",
          "solutionDiagrams": []
