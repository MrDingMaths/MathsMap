    "children": [
      {
        "id": "p32-q10a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify the sum\n$$\\frac{1}{1}+\\frac{1}{1+2}+\\cdots+\\frac{1}{1+2+\\cdots+n}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2n}{n+1}$.\n\nUse $1+2+\\cdots+k=\\dfrac{k(k+1)}{2}$, then telescope the partial fractions.",
          "worked": "Since $1+2+\\cdots+k=\\dfrac{k(k+1)}{2}$,\n$$\\begin{align*}\n\\frac{1}{1+2+\\cdots+k}&=\\frac{2}{k(k+1)}\\\\\n\\frac{1}{1+2+\\cdots+k}&=2\\left(\\frac{1}{k}-\\frac{1}{k+1}\\right).\n\\end{align*}$$\nLet $S_n$ denote the required sum. Adjacent terms cancel:\n$$\\begin{align*}\nS_n&=2\\sum_{k=1}^{n}\\left(\\frac{1}{k}-\\frac{1}{k+1}\\right)\\\\\nS_n&=2\\left[\\left(1-\\frac12\\right)+\\left(\\frac12-\\frac13\\right)+\\cdots+\\left(\\frac1n-\\frac1{n+1}\\right)\\right]\\\\\nS_n&=2\\left(1-\\frac1{n+1}\\right)\\\\\nS_n&=\\frac{2n}{n+1}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p32-q10b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, evaluate\n$$\\frac{1}{1}+\\frac{1}{1+2}+\\cdots+\\frac{1}{1+2+\\cdots+100}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{200}{101}$.",
          "worked": "Substitute $n=100$ into part (a):\n$$\\begin{align*}\nS_{100}&=\\frac{2\\times100}{100+1}\\\\\nS_{100}&=\\frac{200}{101}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
