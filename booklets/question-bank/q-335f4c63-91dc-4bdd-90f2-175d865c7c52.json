        "answer": {
          "short": "$\\frac{3xy}{2}$",
          "worked": "$\\begin{align*}\\frac{27x^2y^3}{18xy^2}&=\\frac{27}{18}\\times x^{2-1}y^{3-2}\\\\\\frac{27x^2y^3}{18xy^2}&=\\frac{3xy}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
