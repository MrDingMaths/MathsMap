        "label": "a",
        "prompt": "$\\frac{a^3b^2}{a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab^2$",
          "worked": "$\\begin{align*}\\frac{a^3b^2}{a^2}&=a^{3-2}b^2\\\\\\frac{a^3b^2}{a^2}&=ab^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x^3y^2}{xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2y$",
          "worked": "$\\begin{align*}\\frac{x^3y^2}{xy}&=x^{3-1}y^{2-1}\\\\\\frac{x^3y^2}{xy}&=x^2y\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{a^5b^3}{a^4b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab^2$",
          "worked": "$\\begin{align*}\\frac{a^5b^3}{a^4b}&=a^{5-4}b^{3-1}\\\\\\frac{a^5b^3}{a^4b}&=ab^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p7-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x^4y^7}{x^3y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy^5$",
          "worked": "$\\begin{align*}\\frac{x^4y^7}{x^3y^2}&=x^{4-3}y^{7-2}\\\\\\frac{x^4y^7}{x^3y^2}&=xy^5\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p7-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{12a^6b^2}{4a^2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a^4b$",
          "worked": "$\\begin{align*}\\frac{12a^6b^2}{4a^2b}&=\\frac{12}{4}\\times a^{6-2}b^{2-1}\\\\\\frac{12a^6b^2}{4a^2b}&=3a^4b\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{15xy^3}{3y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5xy$",
          "worked": "$\\begin{align*}\\frac{15xy^3}{3y^2}&=\\frac{15}{3}\\times xy^{3-2}\\\\\\frac{15xy^3}{3y^2}&=5xy\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{16a^4b^3}{12a^2b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4a^2b}{3}$",
          "worked": "$\\begin{align*}\\frac{16a^4b^3}{12a^2b^2}&=\\frac{16}{12}\\times a^{4-2}b^{3-2}\\\\\\frac{16a^4b^3}{12a^2b^2}&=\\frac{4a^2b}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{27x^2y^3}{18xy^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
