          "inlines": [
            {
              "type": "text",
              "text": "At first, NASA scientists concluded that the aliens were terrible at arithmetic. Then they realised that the aliens might be using a different base. How many fingers do you think the aliens might have?",
              "marks": []
            }
          ]
        }
      ]
    },
