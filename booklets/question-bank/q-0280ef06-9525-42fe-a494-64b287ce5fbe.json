        "id": "v2-cdb2ac-p6-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f(x)=x^7$, find $f'''(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$210x^4$",
          "worked": "$$\\begin{align*}f'(x)&=7x^6\\\\f''(x)&=7\\times6x^5=42x^5\\\\f'''(x)&=42\\times5x^4\\\\&=210x^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-cdb2ac-p6-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "If $g(x)=x^5$, find $g^{(5)}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "$$\\begin{align*}g'(x)&=5x^4\\\\g''(x)&=20x^3\\\\g'''(x)&=60x^2\\\\g^{(4)}(x)&=120x\\\\g^{(5)}(x)&=120\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
