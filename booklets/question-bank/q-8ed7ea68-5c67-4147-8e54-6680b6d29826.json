  "content": {
    "id": "p38-ep-17-20",
    "type": "question",
    "label": "",
    "prompt": "Differentiate the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-ep-17-20-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{x^2}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x(x+2)}{(x+1)^2}$.",
          "worked": "$$\\begin{aligned}y'&=\\dfrac{2x(x+1)-x^2}{(x+1)^2}\\\\y'&=\\dfrac{x^2+2x}{(x+1)^2}\\\\y'&=\\dfrac{x(x+2)}{(x+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p38-ep-17-20-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x}{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1-x^2}{(x^2+1)^2}$.",
          "worked": "$$\\begin{aligned}y'&=\\dfrac{(x^2+1)-x(2x)}{(x^2+1)^2}\\\\y'&=\\dfrac{1-x^2}{(x^2+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p38-ep-17-20-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{x^2}{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2x}{(x^2+1)^2}$.",
          "worked": "$$\\begin{aligned}y'&=\\dfrac{2x(x^2+1)-x^2(2x)}{(x^2+1)^2}\\\\y'&=\\dfrac{2x}{(x^2+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p38-ep-17-20-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{x^2+1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x^2+2x-1}{(x+1)^2}$.",
          "worked": "$$\\begin{aligned}y'&=\\dfrac{2x(x+1)-(x^2+1)}{(x+1)^2}\\\\y'&=\\dfrac{x^2+2x-1}{(x+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
