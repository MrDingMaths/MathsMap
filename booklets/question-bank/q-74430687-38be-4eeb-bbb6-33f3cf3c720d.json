  "content": {
    "id": "p9-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Consider the function $y=\\dfrac{\\tan^3 x}{3}-\\tan x+x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{dy}{dx}=\\tan^2 x\\sec^2 x-\\sec^2 x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac13(3\\tan^2 x\\sec^2 x)-\\sec^2 x+1=\\tan^2 x\\sec^2 x-\\sec^2 x+1$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac13\\left(3\\tan^2 x\\sec^2 x\\right)-\\sec^2 x+1\\\\&=\\tan^2 x\\sec^2 x-\\sec^2 x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence use the identity $\\sec^2 x=1+\\tan^2 x$ to show that $\\dfrac{dy}{dx}=\\tan^4 x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\tan^2 x(1+\\tan^2 x)-(1+\\tan^2 x)+1=\\tan^4 x$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\tan^2 x(1+\\tan^2 x)-(1+\\tan^2 x)+1\\\\&=\\tan^2 x+\\tan^4 x-1-\\tan^2 x+1\\\\&=\\tan^4 x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
