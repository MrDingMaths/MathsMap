  "content": {
    "id": "p24-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "How many ways can five uniquely coloured balls be placed into four distinct buckets?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1024$",
      "worked": "Each of the five distinct balls has four choices of bucket. By the multiplication principle,\n$$\\begin{align*}\\text{Number of ways}&=4\\times4\\times4\\times4\\times4\\\\\\text{Number of ways}&=4^5\\\\\\text{Number of ways}&=1024.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
