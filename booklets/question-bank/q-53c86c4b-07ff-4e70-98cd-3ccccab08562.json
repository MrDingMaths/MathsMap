  "content": {
    "id": "p16-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Prove these identities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cot 2\\alpha+\\tan\\alpha=\\operatorname{cosec}2\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1}{\\sin2\\alpha}=\\operatorname{cosec}2\\alpha=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{\\cos2\\alpha}{\\sin2\\alpha}+\\frac{\\sin\\alpha}{\\cos\\alpha}\\\\&=\\frac{1-2\\sin^2\\alpha+2\\sin^2\\alpha}{2\\sin\\alpha\\cos\\alpha}\\\\&=\\frac1{\\sin2\\alpha}\\\\&=\\operatorname{cosec}2\\alpha\\\\&=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p16-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sin3A}{\\sin A}+\\dfrac{\\cos3A}{\\cos A}=4\\cos2A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=4\\cos2A=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{\\sin3A\\cos A+\\cos3A\\sin A}{\\sin A\\cos A}\\\\&=\\frac{\\sin4A}{\\frac12\\sin2A}\\\\&=\\frac{2\\sin2A\\cos2A}{\\frac12\\sin2A}\\\\&=4\\cos2A\\\\&=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p16-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan2x\\cot x=1+\\sec2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sec2x+1=\\mathrm{RHS}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{\\sin2x\\cos x}{\\cos2x\\sin x}\\\\&=\\frac{2\\sin x\\cos^2x}{\\cos2x\\sin x}\\\\&=\\frac{2\\sin x\\left(\\frac12(1+\\cos2x)\\right)}{\\cos2x\\sin x}\\\\&=\\frac{\\sin x+\\sin x\\cos2x}{\\cos2x\\sin x}\\\\&=\\frac1{\\cos2x}+1\\\\&=\\sec2x+1\\\\&=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p16-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sin2\\theta-\\cos2\\theta+1}{\\sin2\\theta+\\cos2\\theta-1}=\\tan\\left(\\theta+\\dfrac\\pi4\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both sides equal $\\dfrac{1+\\tan\\theta}{1-\\tan\\theta}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{2\\sin\\theta\\cos\\theta-(1-2\\sin^2\\theta)+1}{2\\sin\\theta\\cos\\theta+(1-2\\sin^2\\theta)-1}\\\\&=\\frac{2\\sin\\theta\\cos\\theta+2\\sin^2\\theta}{2\\sin\\theta\\cos\\theta-2\\sin^2\\theta}\\\\&=\\frac{2\\sin\\theta(\\cos\\theta+\\sin\\theta)}{2\\sin\\theta(\\cos\\theta-\\sin\\theta)}\\\\&=\\frac{\\cos\\theta+\\sin\\theta}{\\cos\\theta-\\sin\\theta}.\\end{aligned}$$\nDivide numerator and denominator by $\\cos\\theta$:\n$$\\begin{aligned}\\mathrm{LHS}&=\\frac{1+\\tan\\theta}{1-\\tan\\theta}.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{RHS}&=\\frac{\\tan\\theta+\\tan\\frac\\pi4}{1-\\tan\\theta\\tan\\frac\\pi4}\\\\&=\\frac{\\tan\\theta+1}{1-\\tan\\theta}.\\end{aligned}$$\nTherefore $\\mathrm{LHS}=\\mathrm{RHS}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 98
      },
      {
        "id": "p16-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1+\\sin2\\alpha}{1+\\cos2\\alpha}=\\dfrac12(1+\\tan\\alpha)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both sides equal $\\dfrac12+\\tan\\alpha+\\dfrac12\\tan^2\\alpha$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{1+2\\sin\\alpha\\cos\\alpha}{2\\cos^2\\alpha}\\\\&=\\frac1{2\\cos^2\\alpha}+\\frac{\\sin\\alpha}{\\cos\\alpha}\\\\&=\\frac12\\sec^2\\alpha+\\tan\\alpha\\\\&=\\frac12(1+\\tan^2\\alpha)+\\tan\\alpha\\\\&=\\frac12+\\frac12\\tan^2\\alpha+\\tan\\alpha.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{RHS}&=\\frac12(1+2\\tan\\alpha+\\tan^2\\alpha)\\\\&=\\frac12+\\tan\\alpha+\\frac12\\tan^2\\alpha.\\end{aligned}$$\nTherefore $\\mathrm{LHS}=\\mathrm{RHS}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 83
      },
      {
        "id": "p16-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\operatorname{cosec}4A+\\cot4A=\\dfrac12(\\cot A-\\tan A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both sides equal $\\dfrac{\\cos^2A-\\sin^2A}{2\\sin A\\cos A}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac1{\\sin4A}+\\frac{\\cos4A}{\\sin4A}\\\\&=\\frac{1+2\\cos^2(2A)-1}{2\\sin2A\\cos2A}\\\\&=\\frac{\\cos2A}{\\sin2A}\\\\&=\\frac{\\cos^2A-\\sin^2A}{2\\sin A\\cos A}.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{RHS}&=\\frac12\\left(\\frac{\\cos A}{\\sin A}-\\frac{\\sin A}{\\cos A}\\right)\\\\&=\\frac12\\left(\\frac{\\cos^2A-\\sin^2A}{\\sin A\\cos A}\\right)\\\\&=\\frac{\\cos^2A-\\sin^2A}{2\\sin A\\cos A}.\\end{aligned}$$\nTherefore $\\mathrm{LHS}=\\mathrm{RHS}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      }
    ]
  },
