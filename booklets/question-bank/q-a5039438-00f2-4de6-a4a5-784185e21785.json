      {
        "id": "p22-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Work out an expression for $f^{-1}(x)$, assuming $a\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=\\dfrac{x-8}{a}$, where $a\\ne0$.",
          "worked": "$$\\begin{align*}y&=ax+8\\\\x&=ay+8\\\\ay&=x-8\\\\y&=\\frac{x-8}{a}\\\\f^{-1}(x)&=\\frac{x-8}{a}\\end{align*}$$This requires $a\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q18-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
