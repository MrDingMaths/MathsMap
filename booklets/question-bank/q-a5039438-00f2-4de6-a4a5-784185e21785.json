        "answer": {
          "short": "$a=5$.",
          "worked": "$$\\begin{align*}g(2)&=2(2)-3\\\\g(2)&=1\\\\f(g(2))&=f(1)\\\\f(1)&=a+8\\\\a+8&=13\\\\a&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
