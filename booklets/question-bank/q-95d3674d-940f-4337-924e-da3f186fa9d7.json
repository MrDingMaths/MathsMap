          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Hint: Let the roots be ",
              "marks": [
                "italic"
              ]
            },
            {
              "type": "math",
              "latex": "\\alpha-1,\\alpha,\\alpha+1",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": [
                "italic"
              ]
            }
          ]
