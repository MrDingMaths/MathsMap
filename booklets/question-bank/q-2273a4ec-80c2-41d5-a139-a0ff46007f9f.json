  "content": {
    "id": "p30-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A cube has a volume of $343\\text{ cm}^3$. The cube is enlarged by a factor of $5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the volume of the resulting cube?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$42\\,875\\text{ cm}^3$",
          "worked": "Volume is multiplied by the cube of the enlargement factor.\n$$\\begin{align*}V_{\\text{new}}&=343\\times5^3\\\\V_{\\text{new}}&=42\\,875\\text{ cm}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the surface area of the resulting cube.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7350\\text{ cm}^2$",
          "worked": "$$\\begin{align*}s_{\\text{original}}&=\\sqrt[3]{343}\\\\s_{\\text{original}}&=7\\text{ cm}\\\\s_{\\text{new}}&=5\\times7\\\\s_{\\text{new}}&=35\\text{ cm}\\\\S_{\\text{new}}&=6\\times35^2\\\\S_{\\text{new}}&=7350\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
