    "type": "question",
    "label": "15",
    "prompt": "Find two positive integers whose sum is 60 and whose greatest common divisor is 6.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$18$ and $42$.",
      "worked": "Both integers must be multiples of $6$. Choose $18$ and $42$, and check:\n$$\\begin{align*}18+42&=60\\\\18&=2\\times3^2\\\\42&=2\\times3\\times7\\\\\\operatorname{GCD}(18,42)&=2\\times3=6.\\end{align*}$$\nThus $18$ and $42$ satisfy both conditions.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
