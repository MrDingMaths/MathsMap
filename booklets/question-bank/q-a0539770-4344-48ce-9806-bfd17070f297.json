      {
        "id": "p4-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write 10 and 14 as products of two prime numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10=2\\times5$, $14=2\\times7$",
          "worked": "$10=2\\times5$\n\n$14=2\\times7$\n\nEach factor is prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Write 30 and 42 as products of three prime numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30=2\\times3\\times5$, $42=2\\times3\\times7$",
          "worked": "$$\\begin{align*}30&=2\\times15\\\\30&=2\\times3\\times5\\end{align*}$$\n\n$$\\begin{align*}42&=2\\times21\\\\42&=2\\times3\\times7\\end{align*}$$\n\nEach final factor is prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Write each of 8 and 9 as a power of a prime number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8=2^3$, $9=3^2$",
          "worked": "$$\\begin{align*}8&=2\\times2\\times2\\\\8&=2^3\\end{align*}$$\n\n$$\\begin{align*}9&=3\\times3\\\\9&=3^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
