  "content": {
    "id": "p32-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the projection of $\\underset{\\sim}{a}$ onto $\\underset{\\sim}{b}$ if:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=\\begin{pmatrix}2\\\\1\\end{pmatrix},\\ \\underset{\\sim}{b}=\\begin{pmatrix}4\\\\0\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}2\\\\0\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=2(4)+1(0)=8\\\\|\\underset{\\sim}{b}|^2&=4^2+0^2=16\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac{8}{16}\\begin{pmatrix}4\\\\0\\end{pmatrix}\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\begin{pmatrix}2\\\\0\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p32-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\begin{aligned}\\underset{\\sim}{a}&=3\\underset{\\sim}{i}+3\\underset{\\sim}{j}\\\\\\underset{\\sim}{b}&=2\\underset{\\sim}{j}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\underset{\\sim}{j}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=3(0)+3(2)=6\\\\|\\underset{\\sim}{b}|^2&=2^2=4\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac64(2\\underset{\\sim}{j})\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=3\\underset{\\sim}{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p32-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{a}=\\begin{pmatrix}5\\\\-3\\end{pmatrix},\\ \\underset{\\sim}{b}=\\begin{pmatrix}-6\\\\0\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}5\\\\0\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=5(-6)+(-3)(0)\\\\\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=-30\\\\|\\underset{\\sim}{b}|^2&=(-6)^2+0^2=36\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac{-30}{36}\\begin{pmatrix}-6\\\\0\\end{pmatrix}\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\begin{pmatrix}5\\\\0\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
