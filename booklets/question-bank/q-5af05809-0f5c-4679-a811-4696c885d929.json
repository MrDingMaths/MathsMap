  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A letter is randomly selected from the 26 letters in the English alphabet.\nFind the probability that the letter is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "the letter S",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{26}$",
          "worked": "There is one S among the 26 letters.\n$$P(S)=\\frac{1}{26}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p10-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "a vowel",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{26}$",
          "worked": "The vowels are A, E, I, O and U: 5 letters.\n$$P(\\text{vowel})=\\frac{5}{26}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p10-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "a consonant",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{26}$",
          "worked": "There are $26-5=21$ consonants.\n$$P(\\text{consonant})=\\frac{21}{26}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p10-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "the letter $\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$; $\\delta$ is not in the English alphabet.",
          "worked": "$\\delta$ is a Greek letter, so there are no favourable outcomes.\n$$P(\\delta)=\\frac{0}{26}=0$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p10-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "either C, D or E",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{26}$",
          "worked": "There are 3 favourable letters: C, D and E.\n$$P(\\text{C, D or E})=\\frac{3}{26}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p10-q7-f",
