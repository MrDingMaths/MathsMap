  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If $P(x)=3x-2$ and $Q(x)=x^2-2x+1$, find expressions for:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)+Q(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+x-1$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(3x-2)+(x^2-2x+1)\\\\&=x^2+x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)-Q(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x^2+5x-3$",
          "worked": "$$\\begin{align*}P(x)-Q(x)&=(3x-2)-(x^2-2x+1)\\\\&=3x-2-x^2+2x-1\\\\&=-x^2+5x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$Q(x)-P(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-5x+3$",
          "worked": "$$\\begin{align*}Q(x)-P(x)&=(x^2-2x+1)-(3x-2)\\\\&=x^2-2x+1-3x+2\\\\&=x^2-5x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$2Q(x)-3P(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2-13x+8$",
          "worked": "$$\\begin{align*}2Q(x)-3P(x)&=2(x^2-2x+1)-3(3x-2)\\\\&=2x^2-4x+2-9x+6\\\\&=2x^2-13x+8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(x)Q(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^3-8x^2+7x-2$",
          "worked": "$$\\begin{align*}P(x)Q(x)&=(3x-2)(x^2-2x+1)\\\\&=3x(x^2-2x+1)-2(x^2-2x+1)\\\\&=3x^3-6x^2+3x-2x^2+4x-2\\\\&=3x^3-8x^2+7x-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$P(x)Q(x)+2Q(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^3-6x^2+3x$",
          "worked": "Using the product from part e:\n$$\\begin{align*}P(x)Q(x)+2Q(x)&=3x^3-8x^2+7x-2+2(x^2-2x+1)\\\\&=3x^3-8x^2+7x-2+2x^2-4x+2\\\\&=3x^3-6x^2+3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
