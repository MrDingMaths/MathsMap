  "content": {
    "id": "v2-204eb-p25-practice-slot-12-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Show that $x^2+7x+14=0$ has no real solution.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^2+7x+14=\\left(x+\\frac72\\right)^2+\\frac74>0$, so it is never $0$.",
      "worked": "$$\\begin{align*}x^2+7x+14&=x^2+7x+\\left(\\frac72\\right)^2-\\left(\\frac72\\right)^2+14\\\\&=\\left(x+\\frac72\\right)^2+\\frac74\\end{align*}$$\nSince $\\left(x+\\frac72\\right)^2\\ge0$, we have $\\left(x+\\frac72\\right)^2+\\frac74\\ge\\frac74>0$. So $x^2+7x+14$ is never $0$ and the equation has no real solution.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
