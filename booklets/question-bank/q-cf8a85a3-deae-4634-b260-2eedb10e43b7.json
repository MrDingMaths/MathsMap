  "content": {
    "id": "p18-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The temperature in a freezer drops by $2x^\\circ\\mathrm{C}$ every hour after 6 p.m. until it reaches $-5^\\circ\\mathrm{C}$. The temperature in the freezer at 6 p.m. is $20^\\circ\\mathrm{C}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q7-a",
        "type": "group",
        "label": "a",
        "prompt": "What will the temperature be at:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q7-a-i",
            "type": "part",
            "label": "i",
            "prompt": "7 p.m.?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(20-2x)^\\circ\\mathrm{C}$",
              "worked": "7 p.m. is 1 hour after 6 p.m.\n\n$$\\begin{align*}\\text{Temperature}&=(20-1\\times2x)^\\circ\\mathrm{C}\\\\\\text{Temperature}&=(20-2x)^\\circ\\mathrm{C}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p18-q7-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "11 p.m.?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(20-10x)^\\circ\\mathrm{C}$",
              "worked": "11 p.m. is 5 hours after 6 p.m.\n\n$$\\begin{align*}\\text{Temperature}&=(20-5\\times2x)^\\circ\\mathrm{C}\\\\\\text{Temperature}&=(20-10x)^\\circ\\mathrm{C}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p18-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If $x=\\frac{1}{2}$, what will the temperature be in 8 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12^\\circ\\mathrm{C}$",
          "worked": "$$\\begin{align*}\\text{Temperature}&=\\left(20-8\\times2\\times\\frac{1}{2}\\right)^\\circ\\mathrm{C}\\\\\\text{Temperature}&=(20-8)^\\circ\\mathrm{C}\\\\\\text{Temperature}&=12^\\circ\\mathrm{C}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "If $x=2$, what will the temperature be in 5 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0^\\circ\\mathrm{C}$",
          "worked": "$$\\begin{align*}\\text{Temperature}&=(20-5\\times2\\times2)^\\circ\\mathrm{C}\\\\\\text{Temperature}&=(20-20)^\\circ\\mathrm{C}\\\\\\text{Temperature}&=0^\\circ\\mathrm{C}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "If $x=2\\frac{1}{2}$, when does the temperature reach $-5^\\circ\\mathrm{C}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "11 p.m.",
          "worked": "$$\\begin{align*}\\text{Hourly drop}&=2\\times2\\frac{1}{2}=5^\\circ\\mathrm{C}\\\\\\text{Total drop}&=20-(-5)=25^\\circ\\mathrm{C}\\\\\\text{Time taken}&=25\\div5=5\\text{ hours}\\end{align*}$$\n\nFive hours after 6 p.m. is 11 p.m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
