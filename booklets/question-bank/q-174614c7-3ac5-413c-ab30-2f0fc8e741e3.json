  "content": {
    "id": "p34-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Apple diameters are normally distributed with mean 7.5 cm and standard deviation 0.3 cm. Only apples within 2 standard deviations are allowed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage of apples are allowed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $95\\%$.",
          "worked": "By the empirical rule, approximately $95\\%$ of normally distributed values lie within 2 standard deviations of the mean. Therefore, approximately $95\\%$ of apples are allowed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p34-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the largest diameter allowed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.1\\text{ cm}$",
          "worked": "$$\\begin{aligned}x_{\\max}&=\\mu+2\\sigma\\\\&=7.5+2(0.3)\\\\&=8.1\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p34-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the smallest diameter allowed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.9\\text{ cm}$",
          "worked": "$$\\begin{aligned}x_{\\min}&=\\mu-2\\sigma\\\\&=7.5-2(0.3)\\\\&=6.9\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
