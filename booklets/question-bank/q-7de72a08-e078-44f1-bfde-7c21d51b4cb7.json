  "content": {
    "id": "p15-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "A rectangle has perimeter $56\\text{ cm}$. The ratio of the length to the width is $5:2$. Find the length and the width.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Length $=20\\text{ cm}$; width $=8\\text{ cm}$.",
      "worked": "The perimeter contains two lengths and two widths.\n$$\\begin{align*}\\text{Length}+\\text{width}&=56\\div2=28\\text{ cm}\\\\\\text{Number of parts}&=5+2=7\\\\\\text{One part}&=28\\div7=4\\text{ cm}\\\\\\text{Length}&=5\\times4=20\\text{ cm}\\\\\\text{Width}&=2\\times4=8\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
