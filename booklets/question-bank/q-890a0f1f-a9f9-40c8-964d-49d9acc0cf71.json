  "content": {
    "id": "p15-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Write down the result when each expression is multiplied by its conjugate.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q2a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{3}-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}(\\sqrt{3}-1)(\\sqrt{3}+1)&=(\\sqrt{3})^2-1^2\\\\(\\sqrt{3}-1)(\\sqrt{3}+1)&=3-1\\\\(\\sqrt{3}-1)(\\sqrt{3}+1)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q2b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\sqrt{5}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$",
          "worked": "$$\\begin{align*}(2\\sqrt{5}+3)(2\\sqrt{5}-3)&=(2\\sqrt{5})^2-3^2\\\\(2\\sqrt{5}+3)(2\\sqrt{5}-3)&=20-9\\\\(2\\sqrt{5}+3)(2\\sqrt{5}-3)&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q2c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{7}-\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}(\\sqrt{7}-\\sqrt{2})(\\sqrt{7}+\\sqrt{2})&=(\\sqrt{7})^2-(\\sqrt{2})^2\\\\(\\sqrt{7}-\\sqrt{2})(\\sqrt{7}+\\sqrt{2})&=7-2\\\\(\\sqrt{7}-\\sqrt{2})(\\sqrt{7}+\\sqrt{2})&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q2d",
        "type": "part",
        "label": "d",
        "prompt": "$3\\sqrt{11}+4\\sqrt{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}(3\\sqrt{11}+4\\sqrt{6})(3\\sqrt{11}-4\\sqrt{6})&=(3\\sqrt{11})^2-(4\\sqrt{6})^2\\\\(3\\sqrt{11}+4\\sqrt{6})(3\\sqrt{11}-4\\sqrt{6})&=9\\times11-16\\times6\\\\(3\\sqrt{11}+4\\sqrt{6})(3\\sqrt{11}-4\\sqrt{6})&=99-96\\\\(3\\sqrt{11}+4\\sqrt{6})(3\\sqrt{11}-4\\sqrt{6})&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
