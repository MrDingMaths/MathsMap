  "content": {
    "id": "p99-q40-response",
    "type": "question",
    "label": "40",
    "prompt": "A remote research station has 48 staff and enough supplies to last 25 days. An additional 32 staff arrive and the supplies are shared equally. Assuming inverse variation, how much less time will the supplies last?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "10 days less; the supplies last 15 days.",
      "worked": "Let $w$ be the number of staff and $t$ the number of days the supplies last. Since time varies inversely with the number of staff,\n$$\\begin{align*}t&=\\frac{k}{w}\\\\25&=\\frac{k}{48}\\\\k&=1200.\\end{align*}$$\nWith the additional staff,\n$$\\begin{align*}t&=\\frac{1200}{48+32}\\\\t&=15.\\end{align*}$$\nThe supplies last $25-15=10$ days less.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
