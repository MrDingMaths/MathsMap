    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sqrt{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{x/2},\\quad \\frac{dy}{dx}=\\frac12e^{x/2}$",
          "worked": "$$\\begin{aligned}y&=(e^x)^{1/2}\\\\y&=e^{x/2}\\\\\\frac{dy}{dx}&=\\frac12e^{x/2}\\\\\\frac{dy}{dx}&=\\frac{\\sqrt{e^x}}2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sqrt[3]{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{x/3},\\quad \\frac{dy}{dx}=\\frac13e^{x/3}$",
          "worked": "$$\\begin{aligned}y&=(e^x)^{1/3}\\\\y&=e^{x/3}\\\\\\frac{dy}{dx}&=\\frac13e^{x/3}\\\\\\frac{dy}{dx}&=\\frac{\\sqrt[3]{e^x}}3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac1{\\sqrt{e^x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{-x/2},\\quad \\frac{dy}{dx}=-\\frac12e^{-x/2}$",
          "worked": "$$\\begin{aligned}y&=(e^x)^{-1/2}\\\\y&=e^{-x/2}\\\\\\frac{dy}{dx}&=-\\frac12e^{-x/2}\\\\\\frac{dy}{dx}&=-\\frac1{2\\sqrt{e^x}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
