  "content": {
    "id": "p56-q11-root",
    "type": "question",
    "label": null,
    "prompt": "The acceleration $a$ due to gravity varies inversely with the square of the distance $r$ to the centre of the earth.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{k}{r^2}$.",
          "worked": "$$a=\\frac{k}{r^2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p56-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "At the surface of the earth the acceleration due to gravity is approximately $9.81\\text{ m s}^{-2}$. The radius of the earth at sea level is approximately $6\\,378\\,137\\text{ m}$. Find the value of $k$ correct to 3 significant figures.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k\\approx3.99\\times10^{14}\\text{ m}^3\\text{ s}^{-2}$.",
          "worked": "$$\\begin{align*}k&=ar^2\\\\k&=9.81(6\\,378\\,137)^2\\\\k&\\approx3.99\\times10^{14}\\text{ m}^3\\text{ s}^{-2}\\quad\\text{(3 significant figures)}.\\end{align*}$$ Retain the unrounded value $9.81(6\\,378\\,137)^2$ for subsequent calculations.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p56-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Galileo dropped a cannonball from the tower of Pisa Cathedral, approximately $55\\text{ m}$ above sea level. Show that the acceleration due to gravity at this height is still $9.81\\text{ m s}^{-2}$ correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=6\\,378\\,192\\text{ m}$ and $a\\approx9.81\\text{ m s}^{-2}$.",
          "worked": "$$\\begin{align*}r&=6\\,378\\,137+55\\\\r&=6\\,378\\,192\\text{ m}.\\end{align*}$$$$\\begin{align*}a&=\\frac{9.81(6\\,378\\,137)^2}{(6\\,378\\,192)^2}\\\\a&\\approx9.8098308\\text{ m s}^{-2}\\\\a&\\approx9.81\\text{ m s}^{-2}\\quad\\text{(2 decimal places)}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p56-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "A satellite is in geosynchronous orbit above the equator at an altitude of $35\\,786\\text{ km}$ above sea level. What is the acceleration due to gravity at this height? Give your answer correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.22\\text{ m s}^{-2}$.",
          "worked": "$$\\begin{align*}r&=6\\,378\\,137+35\\,786\\,000\\\\r&=42\\,164\\,137\\text{ m}.\\end{align*}$$$$\\begin{align*}a&=\\frac{9.81(6\\,378\\,137)^2}{(42\\,164\\,137)^2}\\\\a&\\approx0.2244762\\text{ m s}^{-2}\\\\a&\\approx0.22\\text{ m s}^{-2}\\quad\\text{(2 decimal places)}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p56-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "What happens to $a$ when the distance from the centre of the earth is doubled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a$ is quartered.",
          "worked": "$$a_{\\text{new}}=\\frac{k}{(2r)^2}=\\frac14\\frac{k}{r^2}=\\frac14a.$$ The acceleration is quartered.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
