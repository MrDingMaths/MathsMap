  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify without a calculator.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos22^\\circ-\\sin68^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$\\begin{align*}\\cos22^\\circ-\\sin68^\\circ&=\\sin68^\\circ-\\sin68^\\circ\\\\&=0\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{-\\sin57^\\circ}{\\cos53^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{\\cos33^\\circ}{\\cos53^\\circ}$",
          "worked": "$\\begin{align*}\\frac{-\\sin57^\\circ}{\\cos53^\\circ}&=-\\frac{\\cos33^\\circ}{\\cos53^\\circ}\\end{align*}$\nThe numerator and denominator are unequal, so this does not simplify to $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\cos28^\\circ+\\sin62^\\circ}{\\sin62^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$, using $\\cos28^\\circ=\\sin62^\\circ$.",
          "worked": "$\\begin{align*}\\frac{\\cos28^\\circ+\\sin62^\\circ}{\\sin62^\\circ}&=\\frac{\\sin62^\\circ+\\sin62^\\circ}{\\sin62^\\circ}\\\\&=\\frac{2\\sin62^\\circ}{\\sin62^\\circ}\\\\&=2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p13-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$, using $\\cos70^\\circ=\\sin20^\\circ$.",
          "worked": "$\\begin{align*}\\frac{\\sin20^\\circ+\\cos70^\\circ}{\\sin20^\\circ}&=\\frac{\\sin20^\\circ+\\sin20^\\circ}{\\sin20^\\circ}\\\\&=\\frac{2\\sin20^\\circ}{\\sin20^\\circ}\\\\&=2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p13-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac35$, using $\\cos42^\\circ=\\sin48^\\circ$.",
          "worked": "$\\begin{align*}\\frac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}&=\\frac{\\sin48^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}\\\\&=\\frac{3\\sin48^\\circ}{5\\sin48^\\circ}\\\\&=\\frac35\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p13-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sin20^\\circ\\cos70^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2 20^\\circ$",
          "worked": "$\\begin{align*}\\sin20^\\circ\\cos70^\\circ&=\\sin20^\\circ\\sin20^\\circ\\\\&=\\sin^2 20^\\circ\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
