              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Solve:",
                  "marks": []
                }
              ]
            },
            {
              "id": "p43-q2-solve-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "8-k=3",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=5$",
          "worked": "$$\\begin{align*}8-k-8&=3-8\\\\-k&=-5\\\\\\frac{-k}{-1}&=\\frac{-5}{-1}\\\\k&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
