      {
        "id": "p43-q2-subtract",
        "type": "part",
        "label": "a",
        "prompt": "Why did Eliza subtract 6 from both sides of the equation? Why didn’t she add 6?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Subtracting 6 cancels the positive 6 term; adding 6 would not cancel it.",
          "worked": "The constant term is $+6$, so subtracting 6 from both sides leaves $-k=-9$. Adding 6 would leave $12-k$ on the left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p43-q2-divide",
        "type": "part",
        "label": "b",
        "prompt": "Why did Eliza divide by $-1$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-k$ means $-1\\times k$, so dividing by $-1$ isolates $k$.",
          "worked": "The coefficient of $k$ is $-1$. Dividing both sides of $-k=-9$ by $-1$ gives $k=9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p43-q2-solve",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p43-q2-solve-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
