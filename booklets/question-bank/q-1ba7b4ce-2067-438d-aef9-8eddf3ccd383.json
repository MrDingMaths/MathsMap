          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Health authorities track the cumulative total number of confirmed cases ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "C(t)",
              "display": false
            },
            {
              "type": "text",
              "text": " of an infectious disease over time ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "t",
              "display": false
            },
            {
              "type": "text",
              "text": " (measured in days). Each day, a new data point is added and a continuous curve ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=C(t)",
              "display": false
            },
            {
              "type": "text",
              "text": " is updated.",
              "marks": []
            }
          ]
        },
        {
          "id": "p69-q42-description",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "The graph of ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=C(t)",
              "display": false
            },
            {
              "type": "text",
              "text": " is always increasing and has a distinctive shape, where it starts off slowly, rises steeply, then levels off eventually.",
              "marks": []
            }
          ]
        }
      ]
    },
