    "children": [
      {
        "id": "p69-q42-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the significance of $L$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$L$ is the limiting total number of confirmed cases as time passes.",
          "worked": "As the cumulative graph levels off, $C(t)$ approaches $L$. Thus $L$ represents the eventual total number of confirmed cases in this model.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p69-q42-b",
        "type": "part",
        "label": "b",
        "prompt": "On the same set of axes, sketch $y=C'(t)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C'(t)$ is positive, rises to one peak near the steepest part of $C(t)$, then approaches $0$ as $C(t)$ levels off.",
          "worked": "The gradient of $C(t)$ is initially small and positive, greatest where the cumulative graph is steepest, and then decreases towards $0$. Sketch a positive, single-peaked curve on the supplied axes.",
          "solutionDiagrams": [
            {
              "id": "p69-q42-b-solution-diagram",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"seriesBlue\",\"hex\":\"268CFF\",\"reason\":\"original cumulative-case data points\"},{\"name\":\"seriesRed\",\"hex\":\"EF6068\",\"reason\":\"distinguishes derivative curve from cumulative data\"}],\"reference\":\"source PDF page 69, question 42; answer-book PDF page 54 reported but pixels unavailable\"}\n\\begin{tikzpicture}[x=0.68cm,y=0.68cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{seriesBlue}{HTML}{268CFF}\n\\definecolor{seriesRed}{HTML}{EF6068}\n\\path[use as bounding box] (-0.9,-0.65) rectangle (9.7,4.8);\n\\draw[black,line width=0.5pt,-{Stealth[length=1.5mm]}] (0,-0.55)--(0,4.35);\n\\draw[black,line width=0.5pt,-{Stealth[length=1.5mm]}] (-0.65,0)--(9.25,0);\n\\draw[black,dashed,line width=0.4pt] (0,3.45)--(8.65,3.45);\n\\node[anchor=south] at (0,4.35) {$C(t)$};\n\\node[anchor=west] at (9.25,0) {$t$};\n\\node[anchor=east] at (-0.08,3.45) {$L$};\n\\foreach \\x/\\y in {0/0.30,0.45/0.37,0.9/0.48,1.35/0.62,1.8/0.80,2.25/1.02,2.7/1.31,3.15/1.63,3.6/1.98,4.05/2.31,4.5/2.60,4.95/2.83,5.4/3.00,5.85/3.12,6.3/3.21,6.75/3.27,7.2/3.31,7.65/3.34,8.1/3.36,8.55/3.37}{\\fill[seriesBlue] (\\x,\\y) circle[radius=1.3pt];}\n\\draw[seriesRed,line width=0.8pt] plot[smooth] coordinates {(0,0.14) (0.7,0.29) (1.4,0.52) (2.1,0.90) (2.8,1.37) (3.5,1.68) (4.0,1.73) (4.5,1.60) (5.2,1.22) (5.9,0.78) (6.6,0.45) (7.3,0.25) (8.0,0.13) (8.6,0.07)};\n\\node[seriesRed,anchor=west] at (5.15,1.42) {$C'(t)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 70,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 69,
                "sourceRegion": "question 42 graph with derivative sketch",
                "description": "A red positive hump is drawn on the same axes as the blue cumulative data.",
                "mathematics": "The derivative is greatest near the cumulative curve's steepest region and tends to zero as cumulative cases level off.",
                "answerVisibility": "Solution only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
