        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p69-q42-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain the significance of $C'(t)$ in the given context and hence, describe roughly which part of the curve indicates when the outbreak is spreading at its fastest.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C'(t)$ is the rate of new confirmed cases per day. The outbreak spreads fastest where $C(t)$ is steepest, near its inflection point, at roughly $C(t)=\\frac{L}{2}$.",
          "worked": "$C'(t)$ is the gradient of the cumulative-case graph, so it gives the number of new confirmed cases per day. Its greatest value occurs near the steepest part of $C(t)$, around the inflection point where the cumulative total is roughly $\\frac{L}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ],
