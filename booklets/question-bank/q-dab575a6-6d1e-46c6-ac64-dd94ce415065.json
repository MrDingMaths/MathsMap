    "children": [
      {
        "id": "p52-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain how the graph shows that Chloe drove at a constant speed for the whole journey.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Her line is a straight line with constant steepness.",
          "worked": "Chloe’s line is straight with constant steepness, so she travels equal distances in equal time intervals. Her speed is constant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p52-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate Chloe’s speed, round to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$250\\div1.5\\approx166.7\\text{ km/h}$",
          "worked": "From 9:30 am to 11:00 am, the time taken is $1.5\\text{ h}$.\n$$\\begin{align*}\\text{Speed}&=\\frac{\\text{distance travelled}}{\\text{time taken}}\\\\\\text{Speed}&=\\frac{250}{1.5}\\\\\\text{Speed}&=\\frac{500}{3}\\text{ km/h}\\\\\\text{Speed}&\\approx166.7\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Flo stopped to fix a puncture.\nFor how long did she stop?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\text{ min}$",
          "worked": "Flo’s horizontal segment runs from 10:00 am to 10:30 am, so she stopped for $30\\text{ min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p52-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Find Flo’s speed for the remainder of the journey after she fixed the puncture.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$150\\text{ km/h}$",
          "worked": "From 10:30 am to 11:30 am, Flo travels from $100\\text{ km}$ to $250\\text{ km}$ in $1\\text{ h}$.\n$$\\begin{align*}\\text{Speed}&=\\frac{\\text{distance travelled}}{\\text{time taken}}\\\\\\text{Speed}&=\\frac{250-100}{1}\\\\\\text{Speed}&=150\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p52-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "Find Flo’s average speed for the whole journey, not including when she was stopped.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$250\\div2=125\\text{ km/h}$",
          "worked": "Flo drives for $1\\text{ h}$ before the stop and $1\\text{ h}$ after it.\n$$\\begin{align*}\\text{Driving time}&=1+1=2\\text{ h}\\\\\\text{Average speed}&=\\frac{\\text{total distance}}{\\text{driving time}}\\\\\\text{Average speed}&=\\frac{250}{2}\\\\\\text{Average speed}&=125\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
