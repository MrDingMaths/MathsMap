    "children": [
      {
        "id": "p60-q91-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y'=\\dfrac{2ab}{(ax+b)^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2ab}{(ax+b)^2}$, by the quotient rule.",
          "worked": "$$\\begin{aligned}y'&=\\frac{a(ax+b)-a(ax-b)}{(ax+b)^2}\\\\y'&=\\frac{2ab}{(ax+b)^2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p60-q91-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, explain why $y'>0$ for any value of $x$ in the domain of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2ab>0$ and $(ax+b)^2>0$ on the domain, so $y'>0$.",
          "worked": "Since $a,b>0$, the numerator $2ab$ is positive. For every $x$ in the domain, $ax+b\\ne0$, so $(ax+b)^2>0$. Hence $y'=\\dfrac{2ab}{(ax+b)^2}>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
