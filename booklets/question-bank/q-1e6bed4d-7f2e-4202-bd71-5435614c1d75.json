        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\frac{0-3}{x-1}&=3\\\\-3&=3(x-1)\\\\-1&=x-1\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
