  "content": {
    "id": "p12-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A line passes through the point $(1,3)$ and has gradient $3$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "the $x$-coordinate of the point on the line when $y=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\frac{12-3}{x-1}&=3\\\\9&=3(x-1)\\\\3&=x-1\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
