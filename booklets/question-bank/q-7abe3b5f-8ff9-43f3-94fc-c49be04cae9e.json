    "id": "p22-q66-response",
    "type": "question",
    "label": "66",
    "prompt": "Let $a$ and $b$ be rational numbers. Find the value(s) of $a$ and $b$ for each of the following equations. $$(1+a\\sqrt2+b\\sqrt3)^2=15+2\\sqrt2-4\\sqrt3-4\\sqrt6$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
