  "content": {
    "id": "p17-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the area of a square with diagonals of length $\\sqrt{2}\\text{ cm}$. Hint: a square is a kite.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1\\text{ cm}^2$.",
      "worked": "The diagonals have equal length, so use $A=\\frac{p^2}{2}$.\n$$\\begin{align*}A&=\\frac{p^2}{2}\\\\A&=\\frac{(\\sqrt{2})^2}{2}\\\\A&=\\frac{2}{2}\\\\A&=1\\text{ cm}^2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
