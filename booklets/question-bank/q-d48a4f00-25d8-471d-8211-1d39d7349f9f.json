          "short": "$25x^2$",
          "worked": "$$\\begin{align*}|5x|^2&=(5x)^2\\\\&=25x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p29-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$|x-2|^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2$",
          "worked": "$$\\begin{align*}|x-2|^2&=(x-2)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p29-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{(2x-1)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
