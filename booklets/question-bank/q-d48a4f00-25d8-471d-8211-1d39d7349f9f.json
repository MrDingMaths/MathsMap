  "content": {
    "id": "p29-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify each expression using $\\sqrt{x^2}=|x|$ and $|x|^2=x^2$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|a|$",
          "worked": "$$\\begin{align*}\\sqrt{a^2}&=|a|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p29-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{9x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3|x|$",
          "worked": "$$\\begin{align*}\\sqrt{9x^2}&=\\sqrt{(3x)^2}\\\\&=|3x|\\\\&=3|x|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p29-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{(x+3)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|x+3|$",
          "worked": "$$\\begin{align*}\\sqrt{(x+3)^2}&=|x+3|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p29-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$|5x|^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
