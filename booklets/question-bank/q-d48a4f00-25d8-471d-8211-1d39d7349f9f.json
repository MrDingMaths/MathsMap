          "short": "$|2x-1|$",
          "worked": "$$\\begin{align*}\\sqrt{(2x-1)^2}&=|2x-1|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p29-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt{x^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
