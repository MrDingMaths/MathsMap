        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14b^2$",
          "worked": "$$\\begin{align*}2a^{-1}b^5\\times7ab^{-3}&=14a^{-1+1}b^{5-3}\\\\2a^{-1}b^5\\times7ab^{-3}&=14a^0b^2\\\\2a^{-1}b^5\\times7ab^{-3}&=14b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$7a^3m^{-4}\\times8a^{-5}m^{-3}$",
