        "id": "p13-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{-6}y^4\\times x^2y^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y^2}{x^4}$",
          "worked": "$$\\begin{align*}x^{-6}y^4\\times x^2y^{-2}&=x^{-6+2}y^{4-2}\\\\x^{-6}y^4\\times x^2y^{-2}&=x^{-4}y^2\\\\x^{-6}y^4\\times x^2y^{-2}&=\\frac{y^2}{x^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p13-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^{-3}b^{-5}\\times a^5b^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^2}{b^8}$",
          "worked": "$$\\begin{align*}a^{-3}b^{-5}\\times a^5b^{-3}&=a^{-3+5}b^{-5-3}\\\\a^{-3}b^{-5}\\times a^5b^{-3}&=a^2b^{-8}\\\\a^{-3}b^{-5}\\times a^5b^{-3}&=\\frac{a^2}{b^8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p13-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x^{-2}y^5\\times5x^{-7}y^{-2}$",
