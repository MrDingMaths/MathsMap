  "content": {
    "id": "v2-ac439-p13-practice-slot-3-upper-root",
    "type": "question",
    "label": null,
    "prompt": "A line with gradient $-\\frac23$ passes through $(3,4)$. Find the exact distance between its $x$-intercept and its $y$-intercept.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\sqrt{13}$",
      "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-4&=-\\frac23(x-3)\\\\y&=-\\frac{2x}{3}+6\\end{aligned}$$\nWhen $y=0$, $x=9$. When $x=0$, $y=6$.\nThe intercepts are $(9,0)$ and $(0,6)$.\n$$\\begin{aligned}d&=\\sqrt{(9-0)^2+(0-6)^2}\\\\&=\\sqrt{117}\\\\&=3\\sqrt{13}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
