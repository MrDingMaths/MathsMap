        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\frac{1}{7}$\n\nMultiply by the reciprocal when dividing by a fraction.",
          "worked": "$$\\begin{aligned}-\\frac{4}{3}\\times\\frac{3}{4}\\div\\frac{7}{8}&=-1\\div\\frac{7}{8}\\\\-\\frac{4}{3}\\times\\frac{3}{4}\\div\\frac{7}{8}&=-1\\times\\frac{8}{7}\\\\-\\frac{4}{3}\\times\\frac{3}{4}\\div\\frac{7}{8}&=-\\frac{8}{7}\\\\-\\frac{4}{3}\\times\\frac{3}{4}\\div\\frac{7}{8}&=-1\\frac{1}{7}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$-\\frac{2}{3}\\times\\frac{3}{4}\\times(-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}-\\frac{2}{3}\\times\\frac{3}{4}\\times(-2)&=-\\frac{6}{12}\\times(-2)\\\\-\\frac{2}{3}\\times\\frac{3}{4}\\times(-2)&=-\\frac{1}{2}\\times(-2)\\\\-\\frac{2}{3}\\times\\frac{3}{4}\\times(-2)&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{4}\\times\\left(-\\frac{4}{5}\\right)\\times\\frac{1}{2}$",
