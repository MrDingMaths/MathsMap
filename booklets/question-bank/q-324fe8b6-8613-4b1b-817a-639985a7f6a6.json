  "content": {
    "id": "p18-q18-root",
    "type": "question",
    "label": null,
    "prompt": "A rectangle has dimensions $60\\text{ m}\\times66\\text{ m}$. It is to be tiled with square tiles of equal size. What is the least number of tiles required?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$110$ tiles.",
      "worked": "The least number of tiles uses the largest possible square tiles. Their side length is the greatest common divisor of the rectangle’s dimensions.\n\n$$\\begin{align*}60&=2^2\\times3\\times5\\\\66&=2\\times3\\times11\\\\\\operatorname{GCD}(60,66)&=2\\times3=6.\\end{align*}$$\n\nEach tile has side length $6\\text{ m}$. There are $60\\div6=10$ tiles along one side and $66\\div6=11$ along the other.\n\n$$\\text{Number of tiles}=10\\times11=110.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
