  "content": {
    "id": "p13-p1",
    "type": "question",
    "label": "1",
    "prompt": "Solve the following equations for $x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-p1-a",
        "type": "part",
        "label": "a",
        "prompt": "$3\\times9^{x+1}=27^{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=9$",
          "worked": "$$\\begin{align*}3\\times(3^2)^{x+1}&=(3^3)^{x-2}\\\\3^{2x+3}&=3^{3x-6}\\\\2x+3&=3x-6\\\\x&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-p1-b",
        "type": "part",
        "label": "b",
        "prompt": "$16^{2-x}=\\sqrt{8^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{16}{11}$",
          "worked": "$$\\begin{align*}(2^4)^{2-x}&=\\big((2^3)^x\\big)^{1/2}\\\\2^{8-4x}&=2^{3x/2}\\\\8-4x&=\\frac{3x}{2}\\\\16&=11x\\\\x&=\\frac{16}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-p1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{8}{27}\\right)^x=\\left(\\frac{9}{4}\\right)^{2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$",
          "worked": "$$\\begin{align*}\\frac{8}{27}&=\\left(\\frac{2}{3}\\right)^3\\\\\\frac{9}{4}&=\\left(\\frac{2}{3}\\right)^{-2}\\\\\\left(\\frac{2}{3}\\right)^{3x}&=\\left(\\frac{2}{3}\\right)^{2x-4}\\\\3x&=2x-4\\\\x&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
