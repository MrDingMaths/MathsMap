          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}f(x)&=x^3+ax^2+bx\\\\g(x)&=ax^3+x^2+bx\\\\h(x)&=ax^3+bx^2+x\\end{aligned}",
              "display": true
            }
          ]
        },
        {
          "id": "p82-q59-parameter-assumption",
          "type": "paragraph",
