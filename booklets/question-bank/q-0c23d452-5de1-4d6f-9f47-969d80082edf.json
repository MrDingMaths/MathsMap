  "content": {
    "id": "p8-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "If $f(x)=\\dfrac{1}{x}$, find:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$f'(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x^{-2}$",
          "worked": "$$\\begin{align*}f(x)&=x^{-1}\\\\f'(x)&=-1\\times x^{-2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$f''(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1)^2\\times2!\\times x^{-3}=2x^{-3}$",
          "worked": "$$\\begin{align*}f'(x)&=-x^{-2}\\\\f''(x)&=(-1)(-2)x^{-3}\\\\&=(-1)^2\\times2!\\times x^{-3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$f^{(5)}(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1)^5\\times5!\\times x^{-6}$",
          "worked": "$$\\begin{align*}f'(x)&=-x^{-2}\\\\f''(x)&=2x^{-3}\\\\f^{(3)}(x)&=-6x^{-4}\\\\f^{(4)}(x)&=24x^{-5}\\\\f^{(5)}(x)&=-120x^{-6}\\\\&=(-1)^5\\times5!\\times x^{-6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p8-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$f^{(n)}(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1)^n\\times n!\\times x^{-(n+1)}$",
          "worked": "Each differentiation multiplies by the current negative exponent and reduces that exponent by 1. After $n$ differentiations, the coefficient is $(-1)(-2)\\cdots(-n)=(-1)^n n!$, so\n$$f^{(n)}(x)=(-1)^n\\times n!\\times x^{-(n+1)}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
