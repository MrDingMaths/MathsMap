        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{3}}&=\\frac{3\\sqrt{3}}{3}\\\\\\frac{3}{\\sqrt{3}}&=\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2\\sqrt{5}}{\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{5}}{\\sqrt{5}}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2}{4\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{3}}{6}$",
          "worked": "$$\\begin{align*}\\frac{2}{4\\sqrt{3}}&=\\frac{2\\sqrt{3}}{12}\\\\\\frac{2}{4\\sqrt{3}}&=\\frac{\\sqrt{3}}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{5\\sqrt{3}}{3\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\sqrt{6}}{6}$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt{3}}{3\\sqrt{2}}&=\\frac{5\\sqrt{3}\\sqrt{2}}{3\\times2}\\\\\\frac{5\\sqrt{3}}{3\\sqrt{2}}&=\\frac{5\\sqrt{6}}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
