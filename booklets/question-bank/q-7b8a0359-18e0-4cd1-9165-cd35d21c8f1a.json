  "content": {
    "id": "p38-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "An ice-block with temperature $-14^\\circ\\mathrm C$ is left out in the sun. The air temperature is a constant $25^\\circ\\mathrm C$ and after 40 seconds the temperature of the ice-block has reached $-5^\\circ\\mathrm C$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "its predicted temperature after 2 minutes, to the nearest $0.1^\\circ\\mathrm C$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.2^\\circ\\mathrm C$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p38-q9-answer-intro",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Using ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "T=25+Ae^{kt}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", with t in seconds:",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p38-q9-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}-14&=25+A\\\\A&=-39\\\\-5&=25-39e^{40k}\\\\-30&=-39e^{40k}\\\\e^{40k}&=\\frac{10}{13}\\\\k&=\\frac{1}{40}\\ln\\left(\\frac{10}{13}\\right)\\\\T(t)&=25-39e^{kt}\\\\T(120)&=25-39e^{120k}\\\\T(120)&=25-39\\left(\\frac{10}{13}\\right)^3\\\\T(120)&\\approx7.2^\\circ\\mathrm C\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p38-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "when the ice-block will start to melt (i.e. when its temperature will reach $0^\\circ\\mathrm C$), to the nearest second.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "68 seconds after being left out.",
          "worked": "Using $T(t)=25-39e^{kt}$, where $k=\\frac{1}{40}\\ln\\left(\\frac{10}{13}\\right)$ and $t$ is in seconds:\n$$\\begin{aligned}0&=25-39e^{kt}\\\\25&=39e^{kt}\\\\e^{kt}&=\\frac{25}{39}\\\\t&=\\frac{\\ln(25/39)}{k}\\\\t&\\approx68\\text{ s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
