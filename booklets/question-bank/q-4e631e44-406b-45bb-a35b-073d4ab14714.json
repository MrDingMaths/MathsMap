  "content": {
    "id": "p71-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A password consists of 2 letters followed by 5 numbers.\nWhat is the probability that Izak randomly guesses the correct password?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{26^2\\times10^5}=\\dfrac{1}{67\\,600\\,000}$",
      "worked": "There are 26 choices for each letter and 10 choices for each digit, with repetition allowed.\n$$\\text{Number of passwords}=26^2\\times10^5=67\\,600\\,000.$$\nOnly one password is correct, so\n$$P(\\text{correct password})=\\frac{1}{26^2\\times10^5}=\\frac{1}{67\\,600\\,000}.$$",
      "solutionDiagrams": []
    },
