  "content": {
    "id": "p58-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Factorise the following expressions. Take out a common factor first.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$3a^2-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(a+2)(a-2)$",
          "worked": "$$\\begin{align*}3a^2-12&=3(a^2-4)\\\\&=3(a+2)(a-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p58-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^3-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x+1)(x-1)$",
          "worked": "$$\\begin{align*}x^3-x&=x(x^2-1)\\\\&=x(x+1)(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p58-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$25y-y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-y(y+5)(y-5)$",
          "worked": "$$\\begin{align*}25y-y^3&=-y(y^2-25)\\\\&=-y(y+5)(y-5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p58-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$9d^2-2\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\left(d+\\frac12\\right)\\left(d-\\frac12\\right)$",
          "worked": "$$\\begin{align*}9d^2-2\\frac14&=9d^2-\\frac94\\\\&=9\\left(d^2-\\frac14\\right)\\\\&=9\\left(d+\\frac12\\right)\\left(d-\\frac12\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p58-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x^4-27p^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x^2+3p)(x^2-3p)$",
          "worked": "$$\\begin{align*}3x^4-27p^2&=3(x^4-9p^2)\\\\&=3(x^2+3p)(x^2-3p)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p58-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$4x^2+14x-30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(2x-3)(x+5)$",
          "worked": "$$4x^2+14x-30=2(2x^2+7x-15)$$\nProduct: $2(-15)=-30$. Sum: $7$. Factor pair: $10,-3$.\n$$\\begin{align*}4x^2+14x-30&=2(2x^2+10x-3x-15)\\\\&=2\\bigl(2x(x+5)-3(x+5)\\bigr)\\\\&=2(2x-3)(x+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p58-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$a^4+a^3+a^2+a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a(a+1)(a^2+1)$",
          "worked": "$$\\begin{align*}a^4+a^3+a^2+a&=a(a^3+a^2+a+1)\\\\&=a\\bigl(a^2(a+1)+(a+1)\\bigr)\\\\&=a(a+1)(a^2+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p58-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^3-8x^2+7x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x-1)(x-7)$",
          "worked": "$$x^3-8x^2+7x=x(x^2-8x+7)$$\n$(-1)(-7)=7$ and $-1+(-7)=-8$.\n$$x^3-8x^2+7x=x(x-1)(x-7)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p58-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$ax^2-a-2x^2+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-2)(x+1)(x-1)$",
          "worked": "$$\\begin{align*}ax^2-a-2x^2+2&=a(x^2-1)-2(x^2-1)\\\\&=(a-2)(x^2-1)\\\\&=(a-2)(x+1)(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p58-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$5x^2+10x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(x+1)^2$",
          "worked": "$$5x^2+10x+5=5(x^2+2x+1)$$\nCheck: $2\\times x\\times1=2x$.\n$$5x^2+10x+5=5(x+1)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p58-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$2x^3-8x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x(x+2)(x-2)$",
          "worked": "$$\\begin{align*}2x^3-8x&=2x(x^2-4)\\\\&=2x(x+2)(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p58-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$10x^2-40x+40$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10(x-2)^2$",
          "worked": "$$10x^2-40x+40=10(x^2-4x+4)$$\nCheck: $2\\times x\\times2=4x$; the middle term is negative.\n$$10x^2-40x+40=10(x-2)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
