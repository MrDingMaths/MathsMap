        "prompt": "there was only one person in a car during this period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{11}$",
          "worked": "Total number of cars $=60+50+40+10+5=165$.\n\n$$\\begin{align*}P(\\text{one person})&=\\frac{60}{165}\\\\P(\\text{one person})&=\\frac{4}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "there was more than one person in a car during this period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{11}$",
          "worked": "Total number of cars $=165$.\n\nNumber with more than one person $=50+40+10+5=105$.\n\n$$\\begin{align*}P(\\text{more than one person})&=\\frac{105}{165}\\\\P(\\text{more than one person})&=\\frac{7}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p11-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "there were fewer than four people in a car during this period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{11}$",
          "worked": "Total number of cars $=165$.\n\nNumber with fewer than four people $=60+50+40=150$.\n\n$$\\begin{align*}P(\\text{fewer than four people})&=\\frac{150}{165}\\\\P(\\text{fewer than four people})&=\\frac{10}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p11-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "there were five people in a car during this period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{33}$",
          "worked": "Total number of cars $=165$; five cars had five people.\n\n$$\\begin{align*}P(\\text{five people})&=\\frac{5}{165}\\\\P(\\text{five people})&=\\frac{1}{33}\\end{align*}$$",
