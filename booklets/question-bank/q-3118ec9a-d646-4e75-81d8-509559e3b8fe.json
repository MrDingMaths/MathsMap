  "content": {
    "id": "p25-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A ball is drawn from a box containing 6 red balls, 4 white balls and 10 blue balls. Find the probability of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "getting a blue ball or a red ball",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}$",
          "worked": "There are $6+4+10=20$ balls in total.\n\n$$\\begin{align*}P(\\text{blue or red})&=\\frac{10+6}{20}\\\\P(\\text{blue or red})&=\\frac{4}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "not getting a red ball",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{10}$",
          "worked": "There are $6+4+10=20$ balls in total. A ball that is not red is white or blue.\n\n$$\\begin{align*}P(\\text{not red})&=\\frac{4+10}{20}\\\\P(\\text{not red})&=\\frac{7}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
