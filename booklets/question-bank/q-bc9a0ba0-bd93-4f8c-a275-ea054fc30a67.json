  "content": {
    "id": "p44-q52-root",
    "type": "question",
    "label": "52",
    "prompt": "Given $4x^4-20x^3+kx^2-20x+4=0$ has two pairs of double roots that are reciprocals of each other, find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p44-q52-short-result",
            "type": "paragraph",
