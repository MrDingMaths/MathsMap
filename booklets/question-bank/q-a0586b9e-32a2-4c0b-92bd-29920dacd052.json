  "content": {
    "id": "p16-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A classroom has a length 6 m shorter than its width and a perimeter of 30 m. Find the length and width of the classroom. Form an equation and solve.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Length $4.5\\text{ m}$; width $10.5\\text{ m}$.",
      "worked": "Let $w$ metres be the width. The length is $(w-6)$ metres.\n\n$$\\begin{align*}w+w+(w-6)+(w-6)&=30\\\\4w-12&=30\\\\4w&=42\\\\w&=10.5\\end{align*}$$\n\nThe length is $10.5-6=4.5\\text{ m}$. Thus the length is $4.5\\text{ m}$ and the width is $10.5\\text{ m}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
