  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The difference of two numbers is $\\frac{3}{4}$. The sum of the two numbers is $9\\frac{1}{4}$. Find the numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5$ and $4\\frac{1}{4}$.",
      "worked": "Let the larger number be $x$. The smaller number is $x-\\frac{3}{4}$.\n\n$$\\begin{align*}x+x-\\frac{3}{4}&=9\\frac{1}{4}\\\\2x-\\frac{3}{4}&=9\\frac{1}{4}\\\\2x&=10\\\\x&=5\\end{align*}$$\n\nThe smaller number is $5-\\frac{3}{4}=4\\frac{1}{4}$.\n\nCheck: $5-4\\frac{1}{4}=\\frac{3}{4}$ and $5+4\\frac{1}{4}=9\\frac{1}{4}$.",
      "solutionDiagrams": []
    },
