      {
        "id": "p17-q51-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\{2.718\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.718$",
          "worked": "Since $\\lfloor2.718\\rfloor=2$,\n$$\\begin{align*}\\{2.718\\}&=2.718-2\\\\\\{2.718\\}&=0.718.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q51-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\{-4.15\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.85$",
          "worked": "Since $-5\\le-4.15<-4$, $\\lfloor-4.15\\rfloor=-5$.\n$$\\begin{align*}\\{-4.15\\}&=-4.15-(-5)\\\\\\{-4.15\\}&=0.85.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q51-c",
        "type": "part",
        "label": "c",
        "prompt": "Sketch the graph of $y=\\{x\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-n$ for $n\\le x<n+1$, $n\\in\\mathbb Z$.\n\nEach segment starts at a filled point $(n,0)$ and ends at an open point $(n+1,1)$. Repeat for every integer $n$.",
          "worked": "For each integer $n$, $\\lfloor x\\rfloor=n$ when $n\\le x<n+1$.\n$$\\begin{align*}\\{x\\}&=x-\\lfloor x\\rfloor\\\\\\{x\\}&=x-n.\\end{align*}$$\nDraw the segment from $(n,0)$ to $(n+1,1)$, including the lower endpoint and excluding the upper endpoint. Repeat for every integer $n$. The dashed vertical lines are guides, not part of the graph.",
          "solutionDiagrams": [
            {
              "id": "p17-q51-c-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"fractionalPartBlue\",\"hex\":\"268CFF\",\"reason\":\"Function segments and endpoint markers are distinguished from black axes and dashed guides.\"}],\"reference\":\"Answer PDF 11, printed 589, Exercise 2B Q51(c)\"}\n\\begin{tikzpicture}[x=8mm,y=28mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{fractionalPartBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-4,-0.62) rectangle (5.2,1.75);\n\\draw[black,line width=0.5pt,->] (-3.8,0) -- (4.7,0);\n\\draw[black,line width=0.5pt,->] (0,-0.5) -- (0,1.6);\n\\node[anchor=north,yshift=-3pt,inner sep=1pt] at (4.7,0) {$x$};\n\\node[anchor=east,xshift=-3pt,inner sep=1pt] at (0,1.6) {$y$};\n\\foreach \\n in {-2,-1,1,2,3,4} {\n  \\draw[black,line width=0.4pt,dash pattern=on 2pt off 2pt] (\\n,0) -- (\\n,1);\n}\n\\foreach \\n in {-3,-2,-1,1,2,3,4} {\n  \\draw[black,line width=0.4pt] (\\n,-0.035) -- (\\n,0.035);\n  \\node[anchor=north,yshift=-3pt,inner sep=1pt] at (\\n,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\n$\\special{dvisvgm:raw </g>}};\n}\n\\draw[black,line width=0.4pt] (-0.08,1) -- (0.08,1);\n\\node[anchor=east,xshift=-3pt,inner sep=1pt] at (0,1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\foreach \\n in {-3,-2,-1,0,1,2,3} {\n  \\pgfmathsetmacro{\\rightEnd}{\\n+1}\n  \\draw[fractionalPartBlue,line width=0.8pt] plot[domain=\\n:\\rightEnd,samples=2] (\\x,{\\x-\\n});\n}\n\\foreach \\n in {-3,-2,-1,0,1,2,3} {\n  \\pgfmathsetmacro{\\rightEnd}{\\n+1}\n  \\filldraw[draw=fractionalPartBlue,fill=fractionalPartBlue,line width=0.8pt] (\\n,0) circle[radius=1.5pt];\n  \\filldraw[draw=fractionalPartBlue,fill=white,line width=0.8pt] (\\rightEnd,1) circle[radius=1.5pt];\n}\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 82,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
