        "id": "p40-q47-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $(k+1)!-k!=k\\times k!$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(k+1)!-k!=k![(k+1)-1]=k\\times k!$.",
          "worked": "$$\\begin{align*}(k+1)!-k!&=(k+1)k!-k!\\\\(k+1)!-k!&=k![(k+1)-1]\\\\(k+1)!-k!&=k\\times k!.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p40-q47-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, simplify\n$$1\\times1!+2\\times2!+3\\times3!+\\cdots+n\\times n!.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p40-q47-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(n+1)!-1",
                    "display": false
                  }
                ]
              },
              {
                "id": "p40-q47-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Replace each term using part (a); the intermediate factorials cancel.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Using part (a),\n$$\\begin{align*}\\sum_{k=1}^{n}k\\times k!&=(2!-1!)+(3!-2!)+\\cdots+((n+1)!-n!)\\\\\\sum_{k=1}^{n}k\\times k!&=(n+1)!-1!\\\\\\sum_{k=1}^{n}k\\times k!&=(n+1)!-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
