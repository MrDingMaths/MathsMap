    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "As positive $k$ increases, the graph is stretched vertically. The amplitude is $k$.",
      "worked": "Each $y$-value of $y=\\cos x$ is multiplied by $k$, so the amplitude is $k$. As $k$ increases, the graph is stretched vertically. The period remains $2\\pi$.",
