  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Two dice are thrown and the values on the uppermost faces recorded. What is the probability of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "obtaining an even number on both dice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "There are 36 equally likely ordered outcomes. Both values must belong to $\\{2,4,6\\}$, giving 9 favourable pairs.\n\n$$P(\\text{both even})=\\frac{9}{36}=\\frac{1}{4}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "obtaining exactly one 6?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{18}$",
          "worked": "The favourable ordered pairs are $(6,1),(6,2),(6,3),(6,4),(6,5)$ and $(1,6),(2,6),(3,6),(4,6),(5,6)$. The pair $(6,6)$ is excluded because it contains two sixes.\n\n$$P(\\text{exactly one 6})=\\frac{10}{36}=\\frac{5}{18}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "obtaining a 3 on one die and an even number on the other?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "The favourable ordered pairs are $(3,2),(3,4),(3,6),(2,3),(4,3),(6,3)$.\n\n$$P(\\text{a 3 and an even number})=\\frac{6}{36}=\\frac{1}{6}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
