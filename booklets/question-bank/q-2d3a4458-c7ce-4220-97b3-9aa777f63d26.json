  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Sketch $y=-x(x+2)$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave down.",
          "worked": "$a=-1<0$, so the parabola is concave down.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,0)$.",
          "worked": "Let $x=0$.\n$$\\begin{align*}y&=-0(0+2)\\\\y&=0\\end{align*}$$\nThe $y$-intercept is $(0,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,0)$ and $(0,0)$.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-x(x+2)\\\\x&=0\\quad\\text{or}\\quad x+2=0\\\\x&=0\\quad\\text{or}\\quad x=-2\\end{align*}$$\nThe $x$-intercepts are $(-2,0)$ and $(0,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,1)$.",
          "worked": "Use the mean of the $x$-intercepts.\n$$\\begin{align*}x&=\\frac{-2+0}{2}\\\\x&=-1\\end{align*}$$\nSubstitute $x=-1$.\n$$\\begin{align*}y&=-(-1)(-1+2)\\\\y&=1\\end{align*}$$\nThe vertex is $(-1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ],
    "sharedSolutionDiagrams": [
      {
        "id": "p8-q5-graph",
        "role": "solution",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"quadratic function curve\"}],\"reference\":\"source page 8 p8-q5-graph\"}\n\\begin{tikzpicture}[x=0.28cm,y=0.28cm,>=stealth]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-11.5,-11.5) rectangle (12,12);\n\\draw[<->,black,line width=0.5pt] (-11,0)--(11,0) node[right] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-11)--(0,11) node[above] {$y$};\n\\draw[<->,curveBlue,line width=0.8pt,domain=-4.4:2.4,samples=100] plot (\\x,{-\\x*(\\x+2)});\n\\node[below left,black] at (-2,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-2$\\special{dvisvgm:raw </g>}};\n\\node[below right,black] at (0,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$0$\\special{dvisvgm:raw </g>}};\n\\coordinate (mmPoint1) at (-1,1);\n\\node[name=mmLabel1,above left,xshift=-6mm,yshift=12mm,black] at (-1,1) {$(-1,1)$};\n\\draw[housegrid,dashed,line width=0.25pt] (mmPoint1)--(mmPoint1 |- mmLabel1.south east)--(mmLabel1.south east);\n\\end{tikzpicture}",
