  "content": {
    "id": "p42-q7",
    "type": "question",
    "label": null,
    "prompt": "In this question, the function $Q(x)=(x-1)^2$ is composed with $R(x)=-x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the domain and range of $y=Q(x)$. A sketch may help.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $x\\in\\mathbb R$. Range: $y\\geq0$.",
          "worked": "$(x-1)^2$ is defined for every real $x$ and is non-negative, with minimum 0 at $x=1$.\n\nDomain: $x\\in\\mathbb R$. Range: $y\\geq0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p42-q7-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the values of:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q7-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$Q(R(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9$",
              "worked": "$$\\begin{align*}R(2)&=-2\\\\Q(R(2))&=Q(-2)\\\\Q(R(2))&=(-2-1)^2=9\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q7-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$R(Q(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1$",
              "worked": "$$\\begin{align*}Q(2)&=(2-1)^2=1\\\\R(Q(2))&=R(1)\\\\R(Q(2))&=-1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p42-q7-c",
        "type": "group",
        "label": "c",
        "prompt": "Find expressions for:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q7-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$Q(R(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$Q(R(x))=(x+1)^2$",
              "worked": "$$\\begin{align*}Q(R(x))&=Q(-x)\\\\Q(R(x))&=(-x-1)^2\\\\Q(R(x))&=(x+1)^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q7-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$R(Q(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$R(Q(x))=-(x-1)^2$",
              "worked": "$$\\begin{align*}R(Q(x))&=-Q(x)\\\\R(Q(x))&=-(x-1)^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          }
        ]
      },
      {
        "id": "p42-q7-d",
        "type": "group",
        "label": "d",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q7-d-i",
            "type": "part",
            "label": "i",
            "prompt": "What transformation maps the graph of $y=Q(x)$ to the graph of $y=Q(R(x))$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Reflect in the $y$-axis.",
              "worked": "$Q(R(x))=Q(-x)$. Replacing $x$ by $-x$ reflects the graph in the $y$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p42-q7-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Hence write down the domain and range of $y=Q(R(x))$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Domain: $x\\in\\mathbb R$. Range: $y\\geq0$.",
              "worked": "Reflection in the $y$-axis leaves the domain as all real numbers and preserves all output values.\n\nDomain: $x\\in\\mathbb R$. Range: $y\\geq0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p42-q7-e",
        "type": "group",
        "label": "e",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q7-e-i",
            "type": "part",
            "label": "i",
            "prompt": "What transformation maps the graph of $y=Q(x)$ to the graph of $y=R(Q(x))$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Reflect in the $x$-axis.",
              "worked": "$R(Q(x))=-Q(x)$, so each output changes sign. This reflects the graph in the $x$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p42-q7-e-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Hence write down the domain and range of $y=R(Q(x))$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Domain: $x\\in\\mathbb R$. Range: $y\\leq0$.",
              "worked": "Reflection in the $x$-axis preserves the domain and changes the non-negative outputs to non-positive outputs.\n\nDomain: $x\\in\\mathbb R$. Range: $y\\leq0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      }
