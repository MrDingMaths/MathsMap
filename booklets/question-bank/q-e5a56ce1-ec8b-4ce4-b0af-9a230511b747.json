  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve the following equations using the Factor Theorem:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^3+2x^2-5x-6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,-1,2$",
          "worked": "Let $P(x)=x^3+2x^2-5x-6$.\n$$\\begin{align*}P(-1)&=-1+2+5-6\\\\P(-1)&=0\\end{align*}$$\nBy the Factor Theorem, $x+1$ is a factor.\n$$\\begin{align*}P(x)&=(x+1)(x^2+x-6)\\\\P(x)&=(x+1)(x+3)(x-2)\\end{align*}$$\nThe null factor law gives $x=-3,-1,2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^3+2x^2-9x-18=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,-2,3$",
          "worked": "Let $P(x)=x^3+2x^2-9x-18$.\n$$\\begin{align*}P(-2)&=-8+8+18-18\\\\P(-2)&=0\\end{align*}$$\nBy the Factor Theorem, $x+2$ is a factor.\n$$\\begin{align*}P(x)&=(x+2)(x^2-9)\\\\P(x)&=(x+2)(x+3)(x-3)\\end{align*}$$\nThe null factor law gives $x=-3,-2,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p17-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^3+7x^2+14x+8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4,-2,-1$",
          "worked": "Let $P(x)=x^3+7x^2+14x+8$.\n$$\\begin{align*}P(-1)&=-1+7-14+8\\\\P(-1)&=0\\end{align*}$$\nBy the Factor Theorem, $x+1$ is a factor.\n$$\\begin{align*}P(x)&=(x+1)(x^2+6x+8)\\\\P(x)&=(x+1)(x+2)(x+4)\\end{align*}$$\nThe null factor law gives $x=-4,-2,-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p17-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^3+5x^2-17x-21=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7,-1,3$",
          "worked": "Let $P(x)=x^3+5x^2-17x-21$.\n$$\\begin{align*}P(-1)&=-1+5+17-21\\\\P(-1)&=0\\end{align*}$$\nBy the Factor Theorem, $x+1$ is a factor.\n$$\\begin{align*}P(x)&=(x+1)(x^2+4x-21)\\\\P(x)&=(x+1)(x+7)(x-3)\\end{align*}$$\nThe null factor law gives $x=-7,-1,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p17-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^3+4x^2-9x-36=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4,-3,3$",
          "worked": "Let $P(x)=x^3+4x^2-9x-36$.\n$$\\begin{align*}P(-4)&=-64+64+36-36\\\\P(-4)&=0\\end{align*}$$\nBy the Factor Theorem, $x+4$ is a factor.\n$$\\begin{align*}P(x)&=(x+4)(x^2-9)\\\\P(x)&=(x+4)(x+3)(x-3)\\end{align*}$$\nThe null factor law gives $x=-4,-3,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p17-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^3+3x^2-40x-84=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7,-2,6$",
          "worked": "Let $P(x)=x^3+3x^2-40x-84$.\n$$\\begin{align*}P(-2)&=-8+12+80-84\\\\P(-2)&=0\\end{align*}$$\nBy the Factor Theorem, $x+2$ is a factor.\n$$\\begin{align*}P(x)&=(x+2)(x^2+x-42)\\\\P(x)&=(x+2)(x+7)(x-6)\\end{align*}$$\nThe null factor law gives $x=-7,-2,6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
