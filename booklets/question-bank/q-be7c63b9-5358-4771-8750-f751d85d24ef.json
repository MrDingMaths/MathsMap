  "content": {
    "id": "p23-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The quantity $V$ grams of vitamins present in a patient's bloodstream $t$ hours after taking vitamin tablets is given by $V=4t^2-t^3$, for $0\\leq t\\leq3$. Find $\\dfrac{dV}{dt}$ and hence determine when the quantity of vitamins in the patient's bloodstream is at its maximum.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{dV}{dt}=8t-3t^2$. The maximum occurs after $\\dfrac83$ hours (2 h 40 min).",
