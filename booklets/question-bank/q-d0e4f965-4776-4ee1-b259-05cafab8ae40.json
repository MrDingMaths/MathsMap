  "content": {
    "id": "p32-q19-root",
    "type": "question",
    "label": null,
    "prompt": "Solve the following quadratic inequalities.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+4x+5>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real $x$.",
          "worked": "$$\\begin{align*}x^2+4x+5&=(x+2)^2+1\\\\x^2+4x+5&\\geq1\\end{align*}$$\nThe expression is positive for every real $x$. Hence the solution is all real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p32-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+6x+10<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solutions.",
          "worked": "$$\\begin{align*}x^2+6x+10&=(x+3)^2+1\\\\x^2+6x+10&\\geq1\\end{align*}$$\nThe expression cannot be negative. There are no solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p32-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$4x^2+4x+1\\leq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac12$.",
          "worked": "$$\\begin{align*}4x^2+4x+1&=(2x+1)^2\\end{align*}$$\nA square is non-negative, so the inequality holds only when it is zero.\n$$\\begin{align*}2x+1&=0\\\\x&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
