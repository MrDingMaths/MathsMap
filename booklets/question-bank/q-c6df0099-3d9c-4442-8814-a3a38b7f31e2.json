    "id": "p23-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "One acre is approximately 0.4 ha. A rectangular block of land measures $50\\text{ m}\\times150\\text{ m}$. Calculate the area of the block of land in:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "hectares",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.75\\text{ ha}$",
          "worked": "$$\\begin{aligned}A&=50\\times150=7500\\text{ m}^2\\\\A&=7500\\div10000=0.75\\text{ ha}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p23-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "acres (approximately)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.875\\text{ acres (approximately)}$",
          "worked": "$$\\begin{aligned}A&\\approx0.75\\div0.4\\\\A&\\approx1.875\\text{ acres}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
