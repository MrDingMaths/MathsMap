    "children": [
      {
        "id": "v2-1856e-p52-practice-j5-095050-j5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the amount of income over \\$90 000.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$20 000",
          "worked": "$$\\begin{align*}\\text{Excess} &= 110\\,000-90\\,000\\\\\\text{Excess} &= \\$20\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-1856e-p52-practice-j5-095050-j5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "How much of the \\$28 400 is tax on the income over \\$90 000?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$8400",
          "worked": "$$\\begin{align*}\\text{Tax on excess} &= 28\\,400-20\\,000\\\\\\text{Tax on excess} &= \\$8400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-1856e-p52-practice-j5-095050-j5-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the value of $r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=42$",
          "worked": "$$\\begin{align*}28\\,400&=20\\,000+\\frac{r}{100}\\times20\\,000\\\\8400&=\\frac{r}{100}\\times20\\,000\\\\r&=\\frac{8400}{20\\,000}\\times100\\\\r&=42\\end{align*}$$\nThe rate is 42 cents for each \\$1 over \\$90 000.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
