  "content": {
    "id": "p18-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "$35\\%$ of students come to school by car. If $559$ students do not come to school by car, how many students are at the school?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$860$ students",
      "worked": "$$\\begin{align*}\\text{Percentage not coming by car}&=100\\%-35\\%=65\\%\\\\\\text{Students for }1\\%&=\\frac{559}{65}=\\frac{43}{5}\\\\\\text{Total students}&=\\frac{43}{5}\\times100=860\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
