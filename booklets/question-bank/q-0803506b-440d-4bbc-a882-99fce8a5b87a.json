  "content": {
    "id": "p21-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2}{3-\\frac45}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{11}$",
          "worked": "$$\\begin{align*}\\frac{2}{3-\\frac45}&=\\frac{2}{\\frac{15}{5}-\\frac45}\\\\\\frac{2}{3-\\frac45}&=2\\div\\frac{11}{5}\\\\\\frac{2}{3-\\frac45}&=2\\times\\frac{5}{11}\\\\\\frac{2}{3-\\frac45}&=\\frac{10}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2}{3+\\frac34}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8}{15}$",
          "worked": "$$\\begin{align*}\\frac{2}{3+\\frac34}&=\\frac{2}{\\frac{12}{4}+\\frac34}\\\\\\frac{2}{3+\\frac34}&=2\\div\\frac{15}{4}\\\\\\frac{2}{3+\\frac34}&=2\\times\\frac{4}{15}\\\\\\frac{2}{3+\\frac34}&=\\frac{8}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1+\\frac23}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{12}$",
          "worked": "$$\\begin{align*}\\frac{1+\\frac23}{4}&=\\frac{\\frac33+\\frac23}{4}\\\\\\frac{1+\\frac23}{4}&=\\frac53\\div4\\\\\\frac{1+\\frac23}{4}&=\\frac53\\times\\frac14\\\\\\frac{1+\\frac23}{4}&=\\frac{5}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p21-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2-\\frac35}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{10}$",
          "worked": "$$\\begin{align*}\\frac{2-\\frac35}{2}&=\\frac{\\frac{10}{5}-\\frac35}{2}\\\\\\frac{2-\\frac35}{2}&=\\frac75\\div2\\\\\\frac{2-\\frac35}{2}&=\\frac75\\times\\frac12\\\\\\frac{2-\\frac35}{2}&=\\frac{7}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p21-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\frac12+\\frac13}{\\frac12-\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\frac{\\frac12+\\frac13}{\\frac12-\\frac13}&=\\frac{\\frac36+\\frac26}{\\frac36-\\frac26}\\\\\\frac{\\frac12+\\frac13}{\\frac12-\\frac13}&=\\frac56\\div\\frac16\\\\\\frac{\\frac12+\\frac13}{\\frac12-\\frac13}&=\\frac56\\times6\\\\\\frac{\\frac12+\\frac13}{\\frac12-\\frac13}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p21-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\frac12+\\frac14}{1-(\\frac12)(\\frac14)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac67$",
          "worked": "$$\\begin{align*}\\frac{\\frac12+\\frac14}{1-(\\frac12)(\\frac14)}&=\\frac{\\frac24+\\frac14}{1-\\frac18}\\\\\\frac{\\frac12+\\frac14}{1-(\\frac12)(\\frac14)}&=\\frac34\\div\\frac78\\\\\\frac{\\frac12+\\frac14}{1-(\\frac12)(\\frac14)}&=\\frac34\\times\\frac87\\\\\\frac{\\frac12+\\frac14}{1-(\\frac12)(\\frac14)}&=\\frac67\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p21-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{3}{\\frac13+\\frac16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\frac{3}{\\frac13+\\frac16}&=\\frac{3}{\\frac26+\\frac16}\\\\\\frac{3}{\\frac13+\\frac16}&=3\\div\\frac12\\\\\\frac{3}{\\frac13+\\frac16}&=3\\times2\\\\\\frac{3}{\\frac13+\\frac16}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\frac56+\\frac78}{\\frac23-\\frac14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{41}{10}$",
          "worked": "$$\\begin{align*}\\frac{\\frac56+\\frac78}{\\frac23-\\frac14}&=\\frac{\\frac{20}{24}+\\frac{21}{24}}{\\frac8{12}-\\frac3{12}}\\\\\\frac{\\frac56+\\frac78}{\\frac23-\\frac14}&=\\frac{41}{24}\\div\\frac5{12}\\\\\\frac{\\frac56+\\frac78}{\\frac23-\\frac14}&=\\frac{41}{24}\\times\\frac{12}{5}\\\\\\frac{\\frac56+\\frac78}{\\frac23-\\frac14}&=\\frac{41}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p21-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{\\frac34+\\frac25}{\\frac14-\\frac15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23$",
          "worked": "$$\\begin{align*}\\frac{\\frac34+\\frac25}{\\frac14-\\frac15}&=\\frac{\\frac{15}{20}+\\frac8{20}}{\\frac5{20}-\\frac4{20}}\\\\\\frac{\\frac34+\\frac25}{\\frac14-\\frac15}&=\\frac{23}{20}\\div\\frac1{20}\\\\\\frac{\\frac34+\\frac25}{\\frac14-\\frac15}&=\\frac{23}{20}\\times20\\\\\\frac{\\frac34+\\frac25}{\\frac14-\\frac15}&=23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p21-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{\\frac34+\\frac12}{2-(\\frac34)(\\frac12)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{13}$",
          "worked": "$$\\begin{align*}\\frac{\\frac34+\\frac12}{2-(\\frac34)(\\frac12)}&=\\frac{\\frac34+\\frac24}{2-\\frac38}\\\\\\frac{\\frac34+\\frac12}{2-(\\frac34)(\\frac12)}&=\\frac54\\div\\frac{13}{8}\\\\\\frac{\\frac34+\\frac12}{2-(\\frac34)(\\frac12)}&=\\frac54\\times\\frac8{13}\\\\\\frac{\\frac34+\\frac12}{2-(\\frac34)(\\frac12)}&=\\frac{10}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
