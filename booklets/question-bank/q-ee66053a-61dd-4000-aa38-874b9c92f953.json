  "content": {
    "id": "p14-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Four-fifths of the jelly beans in a jar are black. There are 288 black jelly beans in the jar. How many jelly beans are there in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "360 jelly beans.",
      "worked": "The total is the black jelly bean count divided by $\\frac{4}{5}$.\n\n$$\\begin{align*}288\\div\\frac{4}{5}&=288\\times\\frac{5}{4}\\\\288\\div\\frac{4}{5}&=72\\times5\\\\288\\div\\frac{4}{5}&=360\\end{align*}$$\n\nThere are 360 jelly beans in total.",
      "solutionDiagrams": []
    },
