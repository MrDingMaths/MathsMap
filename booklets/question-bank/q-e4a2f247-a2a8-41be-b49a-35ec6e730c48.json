          {
            "id": "p28-q3-j",
            "type": "part",
            "label": "j",
            "prompt": "$\\dfrac{24x^2y^3}{2x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12xy^3$",
              "worked": "$$\\begin{align*}\\frac{24x^2y^3}{2x}&=\\frac{2x\\times12xy^3}{2x}\\\\\\frac{24x^2y^3}{2x}&=12xy^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-k",
            "type": "part",
            "label": "k",
            "prompt": "$\\dfrac{24x^2y^3}{2y}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12x^2y^2$",
              "worked": "$$\\begin{align*}\\frac{24x^2y^3}{2y}&=\\frac{2y\\times12x^2y^2}{2y}\\\\\\frac{24x^2y^3}{2y}&=12x^2y^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-l",
            "type": "part",
            "label": "l",
            "prompt": "$\\dfrac{24x^2y^3}{2y^2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12x^2y$",
              "worked": "$$\\begin{align*}\\frac{24x^2y^3}{2y^2}&=\\frac{2y^2\\times12x^2y}{2y^2}\\\\\\frac{24x^2y^3}{2y^2}&=12x^2y\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-m",
            "type": "part",
            "label": "m",
            "prompt": "$\\dfrac{24x^2y^3}{2xy}$",
            "layout": "list",
