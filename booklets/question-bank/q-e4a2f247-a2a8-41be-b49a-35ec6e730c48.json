              "worked": "$$2\\times3x=6x$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-c",
            "type": "part",
            "label": "c",
            "prompt": "$2x\\times3x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6x^2$",
              "worked": "$$\\begin{align*}2x\\times3x&=6\\times x\\times x\\\\2x\\times3x&=6x^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-d",
            "type": "part",
            "label": "d",
            "prompt": "$2x\\times3x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6x^3$",
              "worked": "$$\\begin{align*}2x\\times3x^2&=6\\times x\\times x^2\\\\2x\\times3x^2&=6x^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-e",
            "type": "part",
            "label": "e",
            "prompt": "$2x\\times3x^2\\times4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$24x^3$",
              "worked": "$$\\begin{align*}2x\\times3x^2\\times4&=(2\\times3\\times4)x^{1+2}\\\\2x\\times3x^2\\times4&=24x^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-f",
            "type": "part",
            "label": "f",
            "prompt": "$2x\\times3x^2\\times4y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$24x^3y$",
              "worked": "$$\\begin{align*}2x\\times3x^2\\times4y&=(2\\times3\\times4)x^{1+2}y\\\\2x\\times3x^2\\times4y&=24x^3y\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-g",
            "type": "part",
            "label": "g",
            "prompt": "$2y\\times3x^2\\times4y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$24x^2y^2$",
              "worked": "$$\\begin{align*}2y\\times3x^2\\times4y&=(2\\times3\\times4)x^2y^{1+1}\\\\2y\\times3x^2\\times4y&=24x^2y^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-h",
            "type": "part",
            "label": "h",
            "prompt": "$2y^2\\times3x^2\\times4y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$24x^2y^3$",
              "worked": "$$\\begin{align*}2y^2\\times3x^2\\times4y&=(2\\times3\\times4)x^2y^{2+1}\\\\2y^2\\times3x^2\\times4y&=24x^2y^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\dfrac{2y^2\\times3x^2\\times4y}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12x^2y^3$",
              "worked": "$$\\begin{align*}\\frac{2y^2\\times3x^2\\times4y}{2}&=\\frac{24x^2y^3}{2}\\\\\\frac{2y^2\\times3x^2\\times4y}{2}&=12x^2y^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p28-q3-right",
        "type": "group",
        "label": "",
