            "answer": {
              "short": "$12xy^2$",
              "worked": "$$\\begin{align*}\\frac{24x^2y^3}{2xy}&=\\frac{2xy\\times12xy^2}{2xy}\\\\\\frac{24x^2y^3}{2xy}&=12xy^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-n",
            "type": "part",
            "label": "n",
            "prompt": "$\\dfrac{24x^2y^3}{6xy}$",
