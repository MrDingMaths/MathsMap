            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4xy^2$",
              "worked": "$$\\begin{align*}\\frac{24x^2y^3}{6xy}&=\\frac{6xy\\times4xy^2}{6xy}\\\\\\frac{24x^2y^3}{6xy}&=4xy^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-o",
            "type": "part",
            "label": "o",
            "prompt": "$\\dfrac{24x^2y^3}{6x^2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4y^3$",
              "worked": "$$\\begin{align*}\\frac{24x^2y^3}{6x^2}&=\\frac{6x^2\\times4y^3}{6x^2}\\\\\\frac{24x^2y^3}{6x^2}&=4y^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-p",
            "type": "part",
            "label": "p",
            "prompt": "$\\dfrac{24x^2y^3}{6y^2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4x^2y$",
              "worked": "$$\\begin{align*}\\frac{24x^2y^3}{6y^2}&=\\frac{6y^2\\times4x^2y}{6y^2}\\\\\\frac{24x^2y^3}{6y^2}&=4x^2y\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-q",
            "type": "part",
            "label": "q",
            "prompt": "$\\dfrac{24x^2y^3}{6x^2y}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4y^2$",
              "worked": "$$\\begin{align*}\\frac{24x^2y^3}{6x^2y}&=\\frac{6x^2y\\times4y^2}{6x^2y}\\\\\\frac{24x^2y^3}{6x^2y}&=4y^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p28-q3-r",
            "type": "part",
            "label": "r",
            "prompt": "$\\dfrac{24x^2y^3}{24x^2y^3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\frac{24x^2y^3}{24x^2y^3}=1$$\nA nonzero term divided by itself is $1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
