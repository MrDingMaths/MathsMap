  "content": {
    "id": "p24-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^1 e^x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e-1$",
          "worked": "$$\\begin{aligned}\\int_0^1 e^x\\,dx&=[e^x]_0^1\\\\&=e^1-e^0\\\\&=e-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^2 e^x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^2-e$",
          "worked": "$$\\begin{aligned}\\int_1^2 e^x\\,dx&=[e^x]_1^2\\\\&=e^2-e^1\\\\&=e^2-e\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{-1}^3 e^{-x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e-e^{-3}$",
          "worked": "$$\\begin{aligned}\\int_{-1}^3 e^{-x}\\,dx&=[-e^{-x}]_{-1}^3\\\\&=-(e^{-3}-e)\\\\&=e-e^{-3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{-2}^0 e^{-x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^2-1$",
          "worked": "$$\\begin{aligned}\\int_{-2}^0 e^{-x}\\,dx&=[-e^{-x}]_{-2}^0\\\\&=-(1-e^2)\\\\&=e^2-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_0^2 e^{2x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(e^4-1)$",
          "worked": "$$\\begin{aligned}\\int_0^2 e^{2x}\\,dx&=\\left[\\frac{e^{2x}}2\\right]_0^2\\\\&=\\frac12(e^4-e^0)\\\\&=\\frac12(e^4-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p24-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_{-1}^2 20e^{-5x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(e^5-e^{-10})$",
          "worked": "$$\\begin{aligned}\\int_{-1}^2 20e^{-5x}\\,dx&=[-4e^{-5x}]_{-1}^2\\\\&=-4(e^{-10}-e^5)\\\\&=4(e^5-e^{-10})\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p24-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\displaystyle\\int_{-3}^1 8e^{-4x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(e^{12}-e^{-4})$",
          "worked": "$$\\begin{aligned}\\int_{-3}^1 8e^{-4x}\\,dx&=[-2e^{-4x}]_{-3}^1\\\\&=-2(e^{-4}-e^{12})\\\\&=2(e^{12}-e^{-4})\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p24-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\displaystyle\\int_{-1}^3 9e^{6x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac32(e^{18}-e^{-6})$",
          "worked": "$$\\begin{aligned}\\int_{-1}^3 9e^{6x}\\,dx&=\\left[\\frac32e^{6x}\\right]_{-1}^3\\\\&=\\frac32(e^{18}-e^{-6})\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\displaystyle\\int_{-1}^1 e^{2x+1}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(e^3-e^{-1})$",
          "worked": "$$\\begin{aligned}\\int_{-1}^1 e^{2x+1}\\,dx&=\\left[\\frac12e^{2x+1}\\right]_{-1}^1\\\\&=\\frac12(e^{2(1)+1}-e^{2(-1)+1})\\\\&=\\frac12(e^3-e^{-1})\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\displaystyle\\int_{-2}^0 e^{4x-3}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14(e^{-3}-e^{-11})$",
          "worked": "$$\\begin{aligned}\\int_{-2}^0 e^{4x-3}\\,dx&=\\left[\\frac14e^{4x-3}\\right]_{-2}^0\\\\&=\\frac14(e^{4(0)-3}-e^{4(-2)-3})\\\\&=\\frac14(e^{-3}-e^{-11})\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\displaystyle\\int_{-2}^{-1} e^{3x+2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13(e^{-1}-e^{-4})$",
          "worked": "$$\\begin{aligned}\\int_{-2}^{-1} e^{3x+2}\\,dx&=\\left[\\frac13e^{3x+2}\\right]_{-2}^{-1}\\\\&=\\frac13(e^{3(-1)+2}-e^{3(-2)+2})\\\\&=\\frac13(e^{-1}-e^{-4})\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\displaystyle\\int_{-\\frac12}^{\\frac12} e^{3-2x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{e^2}{2}(e^2-1)$",
          "worked": "$$\\begin{aligned}\\int_{-\\frac12}^{\\frac12}e^{3-2x}\\,dx&=\\left[-\\frac12e^{3-2x}\\right]_{-\\frac12}^{\\frac12}\\\\&=-\\frac12(e^2-e^4)\\\\&=\\frac12(e^4-e^2)\\\\&=\\frac{e^2}{2}(e^2-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p24-q2-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\displaystyle\\int_{-\\frac13}^{\\frac13} e^{2+3x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac e3(e^2-1)$",
          "worked": "$$\\begin{aligned}\\int_{-\\frac13}^{\\frac13}e^{2+3x}\\,dx&=\\left[\\frac13e^{2+3x}\\right]_{-\\frac13}^{\\frac13}\\\\&=\\frac13(e^3-e)\\\\&=\\frac e3(e^2-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p24-q2-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\displaystyle\\int_1^2 6e^{3x+1}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2e^4(e^3-1)$",
          "worked": "$$\\begin{aligned}\\int_1^2 6e^{3x+1}\\,dx&=[2e^{3x+1}]_1^2\\\\&=2(e^7-e^4)\\\\&=2e^4(e^3-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p24-q2-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\displaystyle\\int_2^3 12e^{4x-5}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3e^3(e^4-1)$",
          "worked": "$$\\begin{aligned}\\int_2^3 12e^{4x-5}\\,dx&=[3e^{4x-5}]_2^3\\\\&=3(e^7-e^3)\\\\&=3e^3(e^4-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p24-q2-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\displaystyle\\int_1^2 12e^{8-3x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4e^2(e^3-1)$",
          "worked": "$$\\begin{aligned}\\int_1^2 12e^{8-3x}\\,dx&=[-4e^{8-3x}]_1^2\\\\&=-4(e^2-e^5)\\\\&=4(e^5-e^2)\\\\&=4e^2(e^3-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
