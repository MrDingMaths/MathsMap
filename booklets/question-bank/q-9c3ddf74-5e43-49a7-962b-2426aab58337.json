                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Convert 57 and 63 to z-scores: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a=\\frac{57-75}{12}=-1.5,\\qquad b=\\frac{63-75}{12}=-1",
                    "display": false
                  }
                ]
