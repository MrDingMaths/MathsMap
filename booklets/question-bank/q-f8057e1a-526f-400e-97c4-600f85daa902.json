        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{1}{e^x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-e^{-x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{1}{e^x}\\,dx&=\\int e^{-x}\\,dx\\\\&=\\frac{e^{-x}}{-1}+C\\\\&=-e^{-x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p25-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{1}{e^{2x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12e^{-2x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{1}{e^{2x}}\\,dx&=\\int e^{-2x}\\,dx\\\\&=\\frac{e^{-2x}}{-2}+C\\\\&=-\\frac12e^{-2x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p25-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{1}{e^{3x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac13e^{-3x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{1}{e^{3x}}\\,dx&=\\int e^{-3x}\\,dx\\\\&=\\frac{e^{-3x}}{-3}+C\\\\&=-\\frac13e^{-3x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p25-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle-\\int\\frac{3}{e^{3x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^{-3x}+C$",
          "worked": "$$\\begin{align*}-\\int\\frac{3}{e^{3x}}\\,dx&=-3\\int e^{-3x}\\,dx\\\\&=-3\\left(\\frac{e^{-3x}}{-3}\\right)+C\\\\&=e^{-3x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p25-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int\\frac{6}{e^{2x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3e^{-2x}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{6}{e^{2x}}\\,dx&=6\\int e^{-2x}\\,dx\\\\&=6\\left(\\frac{e^{-2x}}{-2}\\right)+C\\\\&=-3e^{-2x}+C\\end{align*}$$",
          "solutionDiagrams": []
