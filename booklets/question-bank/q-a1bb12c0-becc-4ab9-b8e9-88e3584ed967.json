  "content": {
    "id": "p21-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "In 1985, Marita Koch ran 400 m in 47.60 seconds. In this race, what was her average speed in kilometres per hour? Answer accurate to two decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$30.25\\text{ km/h}$",
      "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{400}{47.60}\\text{ m/s}\\\\s&=\\frac{400}{47.60}\\times3.6\\text{ km/h}\\\\s&\\approx30.25\\text{ km/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
