    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\tan\\theta$, given $\\cos\\theta=-\\frac{2}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta=\\pm\\frac{\\sqrt5}{2}$",
          "worked": "The reference triangle has adjacent side $2$ and hypotenuse $3$.\n\n$$\\begin{aligned}\\text{Opp}&=\\sqrt{3^2-2^2}\\\\&=\\sqrt5\\end{aligned}$$\n\nCosine is negative in quadrants II and III. Tangent is negative in quadrant II and positive in quadrant III.\n\n$$\\tan\\theta=\\pm\\frac{\\sqrt5}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\tan\\theta$, given $\\sin\\theta=-\\frac{12}{13}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta=\\pm\\frac{12}{5}$",
          "worked": "The reference triangle has opposite side $12$ and hypotenuse $13$.\n\n$$\\begin{aligned}\\text{Adj}&=\\sqrt{13^2-12^2}\\\\&=5\\end{aligned}$$\n\nSine is negative in quadrants III and IV. Tangent is positive in quadrant III and negative in quadrant IV.\n\n$$\\tan\\theta=\\pm\\frac{12}{5}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\cos\\theta$, given $\\tan\\theta=-\\frac{2}{\\sqrt3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta=\\pm\\frac{\\sqrt3}{\\sqrt7}$",
          "worked": "The reference triangle has opposite side $2$ and adjacent side $\\sqrt3$.\n\n$$\\begin{aligned}\\text{Hyp}&=\\sqrt{2^2+(\\sqrt3)^2}\\\\&=\\sqrt7\\end{aligned}$$\n\nTangent is negative in quadrants II and IV. Cosine is negative in quadrant II and positive in quadrant IV.\n\n$$\\cos\\theta=\\pm\\frac{\\sqrt3}{\\sqrt7}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
