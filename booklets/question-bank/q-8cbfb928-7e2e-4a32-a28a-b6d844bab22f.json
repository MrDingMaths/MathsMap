  "content": {
    "id": "p7-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Ella picks half a basket of grapes, Jonah picks $2\\frac{1}{3}$ baskets and Barry picks $\\frac{1}{4}$ of a basket. How many baskets were picked in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\frac{1}{12}$ baskets",
      "worked": "$$\\begin{align*}\\frac12+2\\frac13+\\frac14&=2+\\frac6{12}+\\frac4{12}+\\frac3{12}\\\\\\frac12+2\\frac13+\\frac14&=2+\\frac{13}{12}\\\\\\frac12+2\\frac13+\\frac14&=3\\frac1{12}\\end{align*}$$\nA total of $3\\frac1{12}$ baskets was picked.",
      "solutionDiagrams": []
    },
