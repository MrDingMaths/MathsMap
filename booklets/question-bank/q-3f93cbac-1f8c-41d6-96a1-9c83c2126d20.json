  "content": {
    "id": "p43-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A golf shop is having a Boxing Day sale.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the percentage discount on a putter which is reduced from \\$120 to \\$102?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\%$",
          "worked": "$$\\begin{align*}\\text{Discount} &= \\$120-\\$102\\\\&=\\$18\\\\\\text{Percentage discount} &=\\frac{18}{120}\\times100\\%\\\\&=15\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p43-q9-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p43-q9-b-storewide",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "The same discount applies storewide.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p43-q9-b-task",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What discount amount is applicable to a box of golf balls whose original price was $25?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$3.75$",
          "worked": "$$\\begin{align*}\\text{Discount} &=\\frac{15}{100}\\times\\$25\\\\&=\\$3.75\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p43-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the sale price of a golf bag which originally cost \\$160?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$136$",
          "worked": "$$\\begin{align*}\\text{Discount} &=\\frac{15}{100}\\times\\$160\\\\&=\\$24\\\\\\text{Sale price} &=\\$160-\\$24\\\\&=\\$136\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
