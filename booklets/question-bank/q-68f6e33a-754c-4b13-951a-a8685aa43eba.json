  "content": {
    "id": "p7-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "For $f(x)=x^3$, find the average rate of change between the following points.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1,1)$ and $(2,8)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\text{Average rate of change}&=\\frac{8-1}{2-1}\\\\&=7.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "where $x=1$ and $x=1.1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.31$",
          "worked": "$$\\begin{align*}\\text{Average rate of change}&=\\frac{f(1.1)-f(1)}{1.1-1}\\\\&=\\frac{1.331-1}{0.1}\\\\&=3.31.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "where $x=1$ and $x=1.001$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.003001$",
          "worked": "$$\\begin{align*}\\text{Average rate of change}&=\\frac{f(1.001)-f(1)}{1.001-1}\\\\&=\\frac{1.003003001-1}{0.001}\\\\&=3.003001.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
