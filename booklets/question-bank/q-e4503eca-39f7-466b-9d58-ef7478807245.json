          "worked": "$$\\begin{align*}\\frac{t}{3}&=1-4\\\\\\frac{t}{3}&=-3\\\\t&=-3\\times3\\\\t&=-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p36-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$5=\\frac{a}{9}-2$",
        "layout": "list",
        "columns": null,
