        "children": [],
        "answer": {
          "short": "$a=63$",
          "worked": "$$\\begin{align*}5+2&=\\frac{a}{9}\\\\7&=\\frac{a}{9}\\\\7\\times9&=a\\\\a&=63\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p36-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$3=\\frac{n}{6}+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-6$",
          "worked": "$$\\begin{align*}3-4&=\\frac{n}{6}\\\\-1&=\\frac{n}{6}\\\\-1\\times6&=n\\\\n&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
