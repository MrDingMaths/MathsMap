        "children": [],
        "answer": {
          "short": "$k=65$",
          "worked": "$$\\begin{align*}\\frac{k}{5}&=10+3\\\\\\frac{k}{5}&=13\\\\k&=13\\times5\\\\k&=65\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p36-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$6+\\frac{p}{2}=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=4$",
          "worked": "$$\\begin{align*}\\frac{p}{2}&=8-6\\\\\\frac{p}{2}&=2\\\\p&=2\\times2\\\\p&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p36-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$4+\\frac{t}{3}=1$",
