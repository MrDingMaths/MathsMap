  "content": {
    "id": "p9-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "There are 20 terms in an arithmetic sequence whose sum is 860. The first term is 5. What is the last term?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$81$",
      "worked": "Let $l$ be the last term. Using $S_n=\\dfrac{n}{2}(a+l)$,\n$$\\begin{align*}860&=\\frac{20}{2}(5+l)\\\\860&=10(5+l)\\\\86&=5+l\\\\l&=81.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
