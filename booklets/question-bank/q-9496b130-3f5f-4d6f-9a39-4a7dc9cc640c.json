  "content": {
    "id": "p21-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The function $f(x)=x^3-x^2-6x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Factorise $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x(x-3)(x+2)$.",
          "worked": "$$\\begin{align*}f(x)&=x(x^2-x-6)\\\\f(x)&=x(x-3)(x+2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve $f(x)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\,0,\\,3$.",
          "worked": "$$x(x-3)(x+2)=0.$$\nBy the zero-product property, $x=0$, $x-3=0$ or $x+2=0$. Therefore $x=-2,\\,0,\\,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Using technology, or otherwise, determine how many solutions would exist for $f(x)=-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 solutions.",
          "worked": "Graph $y=x^3-x^2-6x$ and $y=-4$. The horizontal line intersects the cubic at three distinct points, so $f(x)=-4$ has 3 real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
