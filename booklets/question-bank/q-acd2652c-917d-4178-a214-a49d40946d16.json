  "content": {
    "id": "p46-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Consider $I=\\displaystyle\\int\\frac{1}{\\sqrt{5-4x-x^2}}\\,dx$, with $x=u-2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p46-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $I=\\displaystyle\\int\\frac{1}{\\sqrt{9-u^2}}\\,du$, and hence find $I$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=\\sin^{-1}\\left(\\dfrac{x+2}{3}\\right)+C$.",
          "worked": "$x=u-2$, so $dx=du$.\n$$\\begin{aligned}5-4x-x^2&=5-4(u-2)-(u-2)^2\\\\&=5-4u+8-u^2+4u-4\\\\&=9-u^2.\\end{aligned}$$\n$$\\begin{aligned}I&=\\int\\frac{1}{\\sqrt{9-u^2}}\\,du\\\\&=\\sin^{-1}\\left(\\frac{u}{3}\\right)+C\\\\&=\\sin^{-1}\\left(\\frac{x+2}{3}\\right)+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p46-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Also solve by completing the square for the denominator.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=\\sin^{-1}\\left(\\dfrac{x+2}{3}\\right)+C$.",
          "worked": "Completing the square:\n$$\\begin{aligned}5-4x-x^2&=-(x^2+4x-5)\\\\&=-\\bigl((x+2)^2-9\\bigr)\\\\&=9-(x+2)^2.\\end{aligned}$$\n$$\\begin{aligned}I&=\\int\\frac{1}{\\sqrt{9-(x+2)^2}}\\,dx\\\\&=\\sin^{-1}\\left(\\frac{x+2}{3}\\right)+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p46-q7-followup-group",
        "type": "group",
        "label": "",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p46-q7-followup-instruction",
              "type": "paragraph",
