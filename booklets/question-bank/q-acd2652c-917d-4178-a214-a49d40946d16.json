              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Use a similar approach to find:",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p46-q7-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\displaystyle\\int\\frac{1}{x^2+2x+4}\\,dx,\\quad x=u-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{\\sqrt3}\\tan^{-1}\\left(\\dfrac{x+1}{\\sqrt3}\\right)+C$",
              "worked": "$x=u-1$, so $dx=du$.\n$$\\begin{aligned}x^2+2x+4&=(u-1)^2+2(u-1)+4\\\\&=u^2+3.\\end{aligned}$$\n$$\\begin{aligned}\\int\\frac{1}{x^2+2x+4}\\,dx&=\\int\\frac{1}{u^2+3}\\,du\\\\&=\\frac{1}{\\sqrt3}\\tan^{-1}\\left(\\frac{u}{\\sqrt3}\\right)+C\\\\&=\\frac{1}{\\sqrt3}\\tan^{-1}\\left(\\frac{x+1}{\\sqrt3}\\right)+C.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p46-q7-d",
            "type": "part",
            "label": "d",
            "prompt": "$\\displaystyle\\int\\frac{1}{\\sqrt{4-2x-x^2}}\\,dx,\\quad x=u-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sin^{-1}\\left(\\dfrac{x+1}{\\sqrt5}\\right)+C$",
              "worked": "$x=u-1$, so $dx=du$.\n$$\\begin{aligned}4-2x-x^2&=4-2(u-1)-(u-1)^2\\\\&=5-u^2.\\end{aligned}$$\n$$\\begin{aligned}\\int\\frac{1}{\\sqrt{4-2x-x^2}}\\,dx&=\\int\\frac{1}{\\sqrt{5-u^2}}\\,du\\\\&=\\sin^{-1}\\left(\\frac{u}{\\sqrt5}\\right)+C\\\\&=\\sin^{-1}\\left(\\frac{x+1}{\\sqrt5}\\right)+C.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p46-q7-e",
            "type": "part",
            "label": "e",
            "prompt": "$\\displaystyle\\int_1^2\\frac{1}{\\sqrt{3+2x-x^2}}\\,dx,\\quad x=u+1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{\\pi}{6}$",
              "worked": "$x=u+1$, so $dx=du$. When $x=1$, $u=0$; when $x=2$, $u=1$.\n$$\\begin{aligned}3+2x-x^2&=3+2(u+1)-(u+1)^2\\\\&=4-u^2.\\end{aligned}$$\n$$\\begin{aligned}\\int_1^2\\frac{1}{\\sqrt{3+2x-x^2}}\\,dx&=\\int_0^1\\frac{1}{\\sqrt{4-u^2}}\\,du\\\\&=\\left[\\sin^{-1}\\left(\\frac{u}{2}\\right)\\right]_0^1\\\\&=\\sin^{-1}\\left(\\frac12\\right)-\\sin^{-1}(0)\\\\&=\\frac{\\pi}{6}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 41
          },
          {
            "id": "p46-q7-f",
            "type": "part",
            "label": "f",
            "prompt": "$\\displaystyle\\int_3^7\\frac{1}{x^2-6x+25}\\,dx,\\quad x=u+3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{\\pi}{16}$",
              "worked": "$x=u+3$, so $dx=du$. When $x=3$, $u=0$; when $x=7$, $u=4$.\n$$\\begin{aligned}x^2-6x+25&=(u+3)^2-6(u+3)+25\\\\&=u^2+16.\\end{aligned}$$\n$$\\begin{aligned}\\int_3^7\\frac{1}{x^2-6x+25}\\,dx&=\\int_0^4\\frac{1}{u^2+16}\\,du\\\\&=\\frac14\\left[\\tan^{-1}\\left(\\frac{u}{4}\\right)\\right]_0^4\\\\&=\\frac14\\left(\\frac{\\pi}{4}-0\\right)\\\\&=\\frac{\\pi}{16}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 41
          }
        ]
      }
    ]
