  "content": {
    "id": "p11-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Solve these quadratics in disguise by using an appropriate substitution.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{4}-29x^{2}+100=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm2,\\ \\pm5$. Use $u=x^{2}$.",
          "worked": "Let $u=x^{2}$.\n$$\\begin{align*}u^{2}-29u+100&=0\\\\(u-4)(u-25)&=0\\\\u&=4\\text{ or }25\\\\x^{2}&=4\\text{ or }25\\\\x&=\\pm2\\text{ or }\\pm5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p11-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{6}-14x^{3}-32=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\sqrt[3]{2},\\ 2\\sqrt[3]{2}$. Use $u=x^{3}$.",
          "worked": "Let $u=x^{3}$.\n$$\\begin{align*}u^{2}-14u-32&=0\\\\(u-16)(u+2)&=0\\\\u&=16\\text{ or }-2\\\\x^{3}&=16\\text{ or }-2\\\\x&=2\\sqrt[3]{2}\\text{ or }-\\sqrt[3]{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p11-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+2)^{2}-9(x+2)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ 7$. Use $u=x+2$.",
          "worked": "Let $u=x+2$.\n$$\\begin{align*}u^{2}-9u&=0\\\\u(u-9)&=0\\\\u&=0\\text{ or }9\\\\x+2&=0\\text{ or }9\\\\x&=-2\\text{ or }7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p11-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{x^{2}}+\\dfrac{1}{x}-30=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac16,\\ \\dfrac15$. Use $u=\\dfrac1x$, with $x\\ne0$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "5e4a288b-9305-42a9-b40d-013fab3175a4-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x\\ne0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "u=\\dfrac1x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "5e4a288b-9305-42a9-b40d-013fab3175a4-compact-1",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}u^{2}+u-30&=0\\\\(u+6)(u-5)&=0\\\\u&=-6\\text{ or }5\\\\\\frac1x&=-6\\text{ or }5\\\\x&=-\\frac16\\text{ or }\\frac15\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "5e4a288b-9305-42a9-b40d-013fab3175a4-compact-2",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Both solutions are nonzero.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 63
      },
      {
        "id": "p11-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$x-2\\sqrt{x}-8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=16$. Use $u=\\sqrt{x}\\ge0$; reject $u=-2$.",
          "worked": "Let $u=\\sqrt{x}$, so $u\\ge0$ and $x=u^{2}$.\n$$\\begin{align*}u^{2}-2u-8&=0\\\\(u-4)(u+2)&=0\\\\u&=4\\text{ or }-2\\end{align*}$$\nReject $u=-2$ because $\\sqrt{x}\\ge0$.\n$$\\begin{align*}\\sqrt{x}&=4\\\\x&=16\\end{align*}$$\nCheck: $16-2\\sqrt{16}-8=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p11-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$9^{x}-82\\times3^{x}+81=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\ 4$. Use $u=3^{x}$ and $9^{x}=u^{2}$.",
          "worked": "Let $u=3^{x}>0$. Then $9^{x}=(3^{x})^{2}=u^{2}$.\n$$\\begin{align*}u^{2}-82u+81&=0\\\\(u-1)(u-81)&=0\\\\u&=1\\text{ or }81\\\\3^{x}&=3^{0}\\text{ or }3^{4}\\\\x&=0\\text{ or }4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 59
      }
    ]
  },
