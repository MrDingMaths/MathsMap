              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "f(x)=3x+2",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-ep-11-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down $f(x+h)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+3h+2$",
          "worked": "$$\\begin{align*}f(x+h)&=3(x+h)+2\\\\&=3x+3h+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-ep-11-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $f(x+h)-f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3h$",
          "worked": "$$\\begin{align*}f(x+h)-f(x)&=(3x+3h+2)-(3x+2)\\\\&=3h\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-ep-11-c",
        "type": "part",
        "label": "c",
        "prompt": "Simplify $\\dfrac{f(x+h)-f(x)}{h}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{3h}{h}\\\\&=3\\quad(h\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-ep-11-d",
        "type": "part",
        "label": "d",
        "prompt": "Find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=3$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\&=\\lim_{h\\to0}3\\\\&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
