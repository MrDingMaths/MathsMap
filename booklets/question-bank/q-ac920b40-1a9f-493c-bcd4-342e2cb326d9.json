  "content": {
    "id": "p8-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The area of a rectangle is $6x^2\\text{ cm}^2$. The width of the rectangle is $2\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the length of the rectangle, in terms of $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^2\\text{ cm}$",
          "worked": "Length is area divided by width.\n$$\\begin{align*}l&=\\frac{6x^2}{2}\\\\l&=3x^2\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the length of the rectangle if $x=4$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\text{ cm}$",
          "worked": "Substitute $x=4$ into $l=3x^2$.\n$$\\begin{align*}l&=3\\times4^2\\\\l&=3\\times16\\\\l&=48\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
