  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Substitute $m=-4$, $n=\\frac{1}{3}$ and $p=-\\frac{1}{2}$ to evaluate.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$m+n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\frac{2}{3}$",
          "worked": "$$\\begin{align*}m+n&=-4+\\frac{1}{3}\\\\m+n&=-\\frac{12}{3}+\\frac{1}{3}\\\\m+n&=-3\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$m+p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4\\frac{1}{2}$",
          "worked": "$$\\begin{align*}m+p&=-4+\\left(-\\frac{1}{2}\\right)\\\\m+p&=-4-\\frac{1}{2}\\\\m+p&=-4\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$m-p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\frac{1}{2}$",
          "worked": "$$\\begin{align*}m-p&=-4-\\left(-\\frac{1}{2}\\right)\\\\m-p&=-4+\\frac{1}{2}\\\\m-p&=-3\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$mp$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}mp&=(-4)\\times\\left(-\\frac{1}{2}\\right)\\\\mp&=\\frac{4}{2}\\\\mp&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$np$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{6}$",
          "worked": "$$\\begin{align*}np&=\\frac{1}{3}\\times\\left(-\\frac{1}{2}\\right)\\\\np&=-\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{p}{m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}\\frac{p}{m}&=\\left(-\\frac{1}{2}\\right)\\div(-4)\\\\\\frac{p}{m}&=\\frac{1}{2}\\times\\frac{1}{4}\\\\\\frac{p}{m}&=\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$mnp$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{align*}mnp&=(-4)\\times\\frac{1}{3}\\times\\left(-\\frac{1}{2}\\right)\\\\mnp&=\\frac{4}{6}\\\\mnp&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{p}{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{p}{n}&=\\left(-\\frac{1}{2}\\right)\\div\\frac{1}{3}\\\\\\frac{p}{n}&=-\\left(\\frac{1}{2}\\times\\frac{3}{1}\\right)\\\\\\frac{p}{n}&=-\\frac{3}{2}\\\\\\frac{p}{n}&=-1\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
