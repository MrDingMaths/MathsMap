  "content": {
    "id": "v2-5ec005-p5-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Show that the triangle with vertices $A(1,1)$, $B(4,5)$ and $C(-7,7)$ is right-angled using Pythagoras’ theorem.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AB^2=25$, $BC^2=125$, $CA^2=100$. Since $125=25+100$, the triangle is right-angled at $A$.",
      "worked": "$$\\begin{align*}AB^2&=(4-1)^2+(5-1)^2\\\\AB^2&=25\\\\BC^2&=(-7-4)^2+(7-5)^2\\\\BC^2&=125\\\\CA^2&=(1-(-7))^2+(1-7)^2\\\\CA^2&=100\\\\AB^2+CA^2&=25+100\\\\AB^2+CA^2&=125\\\\BC^2&=AB^2+CA^2\\end{align*}$$\nBy the converse of Pythagoras’ theorem, the triangle is right-angled at $A$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
