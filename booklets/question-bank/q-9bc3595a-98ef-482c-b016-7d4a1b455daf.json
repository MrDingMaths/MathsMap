  "content": {
    "id": "p24-q11",
    "type": "question",
    "label": "11",
    "prompt": "An average adult has about $20\\,000\\,000\\,000\\,000$ red blood cells.\nEach red blood cell has a mass of about $0.000\\,000\\,000\\,1$ gram.\nWork out the total mass of the red blood cells in an average adult.\nGive your answer in scientific notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\times10^3\\text{ g}$. Multiply the number of cells by the mass of each cell.",
      "worked": "The number of cells is $2\\times10^{13}$ and each cell has mass $1\\times10^{-10}\\text{ g}$.\n$$\\begin{align*}\\text{Total mass}&=(2\\times10^{13})(1\\times10^{-10})\\text{ g}\\\\&=(2\\times1)\\times10^{13-10}\\text{ g}\\\\&=2\\times10^3\\text{ g}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
