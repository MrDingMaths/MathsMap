  "content": {
    "id": "p9-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "By swapping $x$ and $y$, find the inverse of these functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=1+\\cos x$, $0\\le x\\le\\pi$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\cos^{-1}(x-1)$, $0\\le x\\le2$.",
          "worked": "$$\\begin{aligned}y&=1+\\cos x\\\\x&=1+\\cos y\\\\x-1&=\\cos y\\\\y&=\\cos^{-1}(x-1)\\end{aligned}$$\nThe inverse has domain $[0,2]$ and range $[0,\\pi]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=1-2\\sin\\left(\\frac x3\\right)$, $-\\frac{3\\pi}{2}\\le x\\le\\frac{3\\pi}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3\\sin^{-1}\\left(\\frac{1-x}{2}\\right)$, $-1\\le x\\le3$.",
          "worked": "$$\\begin{aligned}x&=1-2\\sin\\left(\\frac y3\\right)\\\\x-1&=-2\\sin\\left(\\frac y3\\right)\\\\\\frac{1-x}{2}&=\\sin\\left(\\frac y3\\right)\\\\\\frac y3&=\\sin^{-1}\\left(\\frac{1-x}{2}\\right)\\\\y&=3\\sin^{-1}\\left(\\frac{1-x}{2}\\right)\\end{aligned}$$\nThe inverse has domain $[-1,3]$ and range $\\left[-\\frac{3\\pi}{2},\\frac{3\\pi}{2}\\right]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
