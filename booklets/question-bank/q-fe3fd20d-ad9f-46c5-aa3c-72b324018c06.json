  "content": {
    "id": "p18-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A die is tossed. What is the probability that an outcome greater than 4 is obtained, given that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "an even number is obtained?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "The restricted sample space is $\\{2,4,6\\}$. Only $6$ is greater than $4$.\n\n$$P(\\text{greater than }4\\mid\\text{even})=\\frac{1}{3}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "a number greater than 2 is obtained?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The restricted sample space is $\\{3,4,5,6\\}$. The favourable outcomes are $5$ and $6$.\n\n$$\\begin{align*}P(\\text{greater than }4\\mid\\text{greater than }2)&=\\frac{2}{4}\\\\P(\\text{greater than }4\\mid\\text{greater than }2)&=\\frac{1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
