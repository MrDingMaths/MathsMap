            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$278$",
              "worked": "$$\\begin{align*}\\$428-6\\times\\$25&=\\$428-\\$150\\\\&=\\$278\\end{align*}$$\nHer balance is $\\$278$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p62-q13-a-ii",
            "type": "part",
            "label": "ii",
