              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "After how many weeks will her account be in overdraft (i.e. be negative)?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "18th week.",
          "worked": "$$\\begin{align*}428-25\\times17&=428-425\\\\428-25\\times17&=3\\\\428-25\\times18&=428-450\\\\428-25\\times18&=-22\\end{align*}$$\nThe balance decreases each week. It is $\\$3$ after 17 weeks and $-\\$22$ after 18 weeks, so she first enters overdraft in the 18th week.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
