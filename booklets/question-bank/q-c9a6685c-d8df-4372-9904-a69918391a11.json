  "content": {
    "id": "p6-q20-response",
    "type": "question",
    "label": "20",
    "prompt": "A boat sails $33\\text{ km}$ on a bearing of $200^\\circ$. How far west did it sail? Give your answer correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$11.3\\text{ km}$",
      "worked": "The direction is $200^\\circ-180^\\circ=20^\\circ$ west of south. Let $w$ be the distance west in kilometres.\n\n$$\\begin{align*}\\sin 20^\\circ &= \\frac{w}{33}\\\\w &= 33\\sin 20^\\circ\\\\w &\\approx 11.3\\end{align*}$$\n\nThe boat sailed $11.3\\text{ km}$ west.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
