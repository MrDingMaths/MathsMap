  "content": {
    "id": "p41-t-root",
    "type": "question",
    "label": "t",
    "prompt": "Darius has been saving to buy a laptop. The laptop originally cost \\$800 but has increased in price by 25%. Darius has saved \\$900. How much more does he need to save?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$100",
      "worked": "The multiplier for a 25% increase is $1.25$.\n$$\\begin{align*}\\text{New price} &= \\$800\\times1.25\\\\&=\\$1000\\\\\\text{Amount still needed} &=\\$1000-\\$900\\\\&=\\$100\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
