  "content": {
    "id": "v2-82bc9-p35-practice-j2-224300-root",
    "type": "question",
    "label": null,
    "prompt": "Find the natural domain of $f(x)=\\dfrac{1}{x^2-9}$ by first factorising the denominator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-82bc9-p35-practice-j2-224300-j2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Factorise $x^2-9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x+3)$",
          "worked": "$$\\begin{align*}x^2-9&=(x-3)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-82bc9-p35-practice-j2-224300-j2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "State the values of $x$ that make the denominator zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ and $x=-3$",
          "worked": "$$\\begin{align*}(x-3)(x+3)&=0\\\\x=3\\ &\\text{or}\\ x=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-82bc9-p35-practice-j2-224300-j2-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence state the natural domain of $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne3$ and $x\\ne-3$",
          "worked": "The denominator cannot be zero.\nDomain: all real $x$ except $3$ and $-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-82bc9-p35-practice-j2-224300-j2-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the natural domain of $f(x)=\\dfrac{1}{x^2-3x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne0$ and $x\\ne3$",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x^2-3x&\\ne0\\\\x(x-3)&\\ne0\\end{align*}$$\nDomain: all real $x$ except $0$ and $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
