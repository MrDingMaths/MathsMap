  "content": {
    "id": "p12-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Given that $(1+2x)^{22}=1+Ax+Bx^2+Cx^3+\\cdots$, find the values of $A$, $B$ and $C$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$A=44,\\ B=924,\\ C=12\\,320$",
      "worked": "$$T_k=\\binom{22}{k}(2x)^k=\\binom{22}{k}2^kx^k.$$\nMatching the coefficients of $x$, $x^2$ and $x^3$ gives\n$$\\begin{align*}A&=\\binom{22}{1}2=44\\\\B&=\\binom{22}{2}2^2=924\\\\C&=\\binom{22}{3}2^3=12\\,320.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
