    "children": [
      {
        "id": "p26-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\alpha\\operatorname{cosec}\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin\\alpha\\operatorname{cosec}\\alpha&=\\sin\\alpha\\times\\frac{1}{\\sin\\alpha}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cot\\beta\\tan\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\cot\\beta\\tan\\beta&=\\frac{1}{\\tan\\beta}\\times\\tan\\beta\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos\\theta\\sec\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\cos\\theta\\sec\\theta&=\\cos\\theta\\times\\frac{1}{\\cos\\theta}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{\\sec^2\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^2\\theta$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sec^2\\theta}&=\\left(\\frac{1}{\\sec\\theta}\\right)^2\\\\&=\\cos^2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\sin^2\\beta}{\\cos^2\\beta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^2\\beta$",
          "worked": "$$\\begin{align*}\\frac{\\sin^2\\beta}{\\cos^2\\beta}&=\\left(\\frac{\\sin\\beta}{\\cos\\beta}\\right)^2\\\\&=\\tan^2\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\cos^2\\beta}{\\sin^2\\beta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot^2\\beta$",
          "worked": "$$\\begin{align*}\\frac{\\cos^2\\beta}{\\sin^2\\beta}&=\\left(\\frac{\\cos\\beta}{\\sin\\beta}\\right)^2\\\\&=\\cot^2\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\cos\\alpha}{\\sec\\alpha}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^2\\alpha$",
          "worked": "$$\\begin{align*}\\frac{\\cos\\alpha}{\\sec\\alpha}&=\\cos\\alpha\\times\\frac{1}{\\sec\\alpha}\\\\&=\\cos\\alpha\\times\\cos\\alpha\\\\&=\\cos^2\\alpha\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p26-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\sin\\alpha}{\\operatorname{cosec}\\alpha}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2\\alpha$",
          "worked": "$$\\begin{align*}\\frac{\\sin\\alpha}{\\operatorname{cosec}\\alpha}&=\\sin\\alpha\\times\\frac{1}{\\operatorname{cosec}\\alpha}\\\\&=\\sin\\alpha\\times\\sin\\alpha\\\\&=\\sin^2\\alpha\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p26-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{\\tan A}{\\sec A}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin A$",
          "worked": "$$\\begin{align*}\\frac{\\tan A}{\\sec A}&=\\tan A\\times\\cos A\\\\&=\\frac{\\sin A}{\\cos A}\\times\\cos A\\\\&=\\sin A\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
