  "content": {
    "id": "p3-q6-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=\\dfrac{1}{x^2}$. Find the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$f\\left(\\dfrac{1}{x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2$",
          "worked": "$$\\begin{align*}f\\left(\\frac{1}{x}\\right)&=\\frac{1}{\\left(\\frac{1}{x}\\right)^2}\\\\f\\left(\\frac{1}{x}\\right)&=\\frac{1}{\\frac{1}{x^2}}\\\\f\\left(\\frac{1}{x}\\right)&=x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$f\\left(\\dfrac{1}{\\sqrt{x}}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$",
          "worked": "$$\\begin{align*}f\\left(\\frac{1}{\\sqrt{x}}\\right)&=\\frac{1}{\\left(\\frac{1}{\\sqrt{x}}\\right)^2}\\\\f\\left(\\frac{1}{\\sqrt{x}}\\right)&=\\frac{1}{\\frac{1}{x}}\\\\f\\left(\\frac{1}{\\sqrt{x}}\\right)&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p3-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(xy)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x^2y^2}$",
          "worked": "$$\\begin{align*}f(xy)&=\\frac{1}{(xy)^2}\\\\f(xy)&=\\frac{1}{x^2y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p3-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x+y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{(x+y)^2}$",
          "worked": "$$f(x+y)=\\frac{1}{(x+y)^2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
