  "content": {
    "id": "p41-25j-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A fair die is rolled three times, forming a three-digit number using the outcomes in the order rolled. Find the probability the digits are strictly increasing.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{5}{54}$\n\nEach selection of three distinct digits has exactly one increasing order.",
      "worked": "There are $6^3=216$ equally likely ordered outcomes. Choose three distinct digits from $1,\\ldots,6$; each selection has exactly one strictly increasing order.\n\n$$\\begin{align*}\\text{Number of favourable outcomes}&=\\binom{6}{3}=20\\\\\\Pr(\\text{strictly increasing})&=\\frac{20}{216}\\\\\\Pr(\\text{strictly increasing})&=\\frac{5}{54}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
