  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Expand the following expressions by first reordering terms:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x-1)(x+3)(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3+3x^2-x-3$",
          "worked": "$$\\begin{align*}(x-1)(x+3)(x+1)&=(x-1)(x+1)(x+3)\\\\(x-1)(x+3)(x+1)&=(x^2-1)(x+3)\\\\(x-1)(x+3)(x+1)&=x^3+3x^2-x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$(m+n)(m+2)(m-n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^3+2m^2-mn^2-2n^2$",
          "worked": "$$\\begin{align*}(m+n)(m+2)(m-n)&=(m+n)(m-n)(m+2)\\\\(m+n)(m+2)(m-n)&=(m^2-n^2)(m+2)\\\\(m+n)(m+2)(m-n)&=m^3+2m^2-mn^2-2n^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(a-3)(a-2)(a+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^3-2a^2-9a+18$",
          "worked": "$$\\begin{align*}(a-3)(a-2)(a+3)&=(a-3)(a+3)(a-2)\\\\(a-3)(a-2)(a+3)&=(a^2-9)(a-2)\\\\(a-3)(a-2)(a+3)&=a^3-2a^2-9a+18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2b-3)(b+2)(2b+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4b^3+8b^2-9b-18$",
          "worked": "$$\\begin{align*}(2b-3)(b+2)(2b+3)&=(2b-3)(2b+3)(b+2)\\\\(2b-3)(b+2)(2b+3)&=((2b)^2-3^2)(b+2)\\\\(2b-3)(b+2)(2b+3)&=(4b^2-9)(b+2)\\\\(2b-3)(b+2)(2b+3)&=4b^3+8b^2-9b-18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2a+b)(a+b)(2a-b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^3+4a^2b-ab^2-b^3$",
          "worked": "$$\\begin{align*}(2a+b)(a+b)(2a-b)&=(2a+b)(2a-b)(a+b)\\\\(2a+b)(a+b)(2a-b)&=((2a)^2-b^2)(a+b)\\\\(2a+b)(a+b)(2a-b)&=(4a^2-b^2)(a+b)\\\\(2a+b)(a+b)(2a-b)&=4a^3+4a^2b-ab^2-b^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$(m+3n)(m^2+9n^2)(m-3n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^4-81n^4$",
          "worked": "$$\\begin{align*}(m+3n)(m^2+9n^2)(m-3n)&=(m+3n)(m-3n)(m^2+9n^2)\\\\(m+3n)(m^2+9n^2)(m-3n)&=(m^2-9n^2)(m^2+9n^2)\\\\(m+3n)(m^2+9n^2)(m-3n)&=(m^2)^2-(9n^2)^2\\\\(m+3n)(m^2+9n^2)(m-3n)&=m^4-81n^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
