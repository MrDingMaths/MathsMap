  "content": {
    "id": "p23-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the equation of the line that is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Perpendicular to $y=\\dfrac{2x-1}{3}$ passing through $(0,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{3x}{2}+5$",
          "worked": "$$\\begin{align*}m_{\\mathrm{original}}&=\\frac{2}{3}\\\\m_{\\mathrm{new}}&=-\\frac{3}{2}\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-5&=-\\frac{3}{2}(x-0)\\\\y&=-\\frac{3x}{2}+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p23-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Parallel to $y=\\dfrac{3-5x}{7}$ passing through $(1,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{5x}{7}+\\dfrac{54}{7}$",
          "worked": "$$\\begin{align*}m_{\\mathrm{new}}&=-\\frac{5}{7}\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-7&=-\\frac{5}{7}(x-1)\\\\y-7&=-\\frac{5x}{7}+\\frac{5}{7}\\\\y&=-\\frac{5x}{7}+\\frac{54}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p23-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Parallel to $3y-2x=3$ passing through $(-2,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2x}{3}+\\dfrac{16}{3}$",
          "worked": "$$\\begin{align*}3y&=2x+3\\\\y&=\\frac{2x}{3}+1\\\\m_{\\mathrm{new}}&=\\frac{2}{3}\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-4&=\\frac{2}{3}(x+2)\\\\y-4&=\\frac{2x}{3}+\\frac{4}{3}\\\\y&=\\frac{2x}{3}+\\frac{16}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p23-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Perpendicular to $7x-y=-1$ passing through $(-3,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{x}{7}-\\dfrac{10}{7}$",
          "worked": "$$\\begin{align*}y&=7x+1\\\\m_{\\mathrm{original}}&=7\\\\m_{\\mathrm{new}}&=-\\frac{1}{7}\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y+1&=-\\frac{1}{7}(x+3)\\\\y+1&=-\\frac{x}{7}-\\frac{3}{7}\\\\y&=-\\frac{x}{7}-\\frac{10}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p23-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Parallel to $y=-\\dfrac{3}{7}$ passing through $\\left(\\dfrac{2}{3},\\dfrac{1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{2}$",
          "worked": "The given line is horizontal, so the parallel line has gradient $0$.\n$$\\begin{align*}y-\\frac{1}{2}&=0\\left(x-\\frac{2}{3}\\right)\\\\y&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "Perpendicular to $3x+4y-3=0$ passing through $(-2,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{4x}{3}+\\dfrac{11}{3}$",
          "worked": "$$\\begin{align*}4y&=-3x+3\\\\y&=-\\frac{3x}{4}+\\frac{3}{4}\\\\m_{\\mathrm{original}}&=-\\frac{3}{4}\\\\m_{\\mathrm{new}}&=\\frac{4}{3}\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-1&=\\frac{4}{3}(x+2)\\\\y-1&=\\frac{4x}{3}+\\frac{8}{3}\\\\y&=\\frac{4x}{3}+\\frac{11}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p23-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "parallel to the $x$-axis passing through $(-2,6)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=6$",
          "worked": "A line parallel to the $x$-axis is horizontal, with constant $y$. Through $(-2,6)$, its equation is $y=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p23-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "parallel to the $y$-axis passing through $(3,5)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "A line parallel to the $y$-axis is vertical, with constant $x$. Through $(3,5)$, its equation is $x=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
