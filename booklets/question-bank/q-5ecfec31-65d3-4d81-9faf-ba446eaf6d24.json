    "children": [
      {
        "id": "p13-q6-a",
        "type": "group",
        "label": "a",
        "prompt": "Let $A=\\{\\text{mammals}\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q6-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Write down a subset $S$ of $A$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Sample answer: $S=\\{\\text{rodents}\\}$.",
              "worked": "Choose $S=\\{\\text{rodents}\\}$. Every rodent is a mammal, so $S\\subseteq A$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p13-q6-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Write down another subset $T$ of $A$ so that $S$ and $T$ are disjoint.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Sample answer: $T=\\{\\text{primates}\\}$, using $S=\\{\\text{rodents}\\}$.",
              "worked": "With $S=\\{\\text{rodents}\\}$, choose $T=\\{\\text{primates}\\}$. Every primate is a mammal, and no mammal is both a rodent and a primate. Thus $T\\subseteq A$ and $S\\cap T=\\varnothing$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      },
      {
        "id": "p13-q6-b",
        "type": "group",
        "label": "b",
        "prompt": "Let $N=\\{\\text{whole numbers}\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q6-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Write down an infinite subset $S$ of $N$ where $S\\ne N$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Sample answer: $S=\\{0,2,4,6,\\ldots\\}$.",
              "worked": "Choose $S=\\{0,2,4,6,\\ldots\\}$, the even whole numbers. These are whole numbers and continue without end. Since $1\\in N$ but $1\\notin S$, $S\\ne N$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p13-q6-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Write down another infinite subset $T$ of $N$ so that $S$ and $T$ are disjoint.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Sample answer: $T=\\{1,3,5,7,\\ldots\\}$, using the even whole numbers for $S$.",
              "worked": "With $S=\\{0,2,4,6,\\ldots\\}$, choose $T=\\{1,3,5,7,\\ldots\\}$, the odd whole numbers. This is an infinite subset of $N$. No whole number is both even and odd, so $S\\cap T=\\varnothing$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      }
    ]
