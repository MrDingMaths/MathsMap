  "content": {
    "id": "p45-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The curve $y=ax^3-x^2-3x+5$ has a gradient of $5$ when $x=-1$. Find the value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=2$",
      "worked": "$$\\begin{align*}y'&=3ax^2-2x-3\\end{align*}$$\n\nAt $x=-1$, the derivative is $5$.\n\n$$\\begin{align*}3a(-1)^2-2(-1)-3&=5\\\\3a-1&=5\\\\3a&=6\\\\a&=2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
