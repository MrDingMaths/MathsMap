  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Suppose that $a$ is directly proportional to $b$ and the cube of $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Write a formula for $a$ in terms of $b$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=kbc^3$.",
          "worked": "Since $a\\propto bc^3$, the formula is $a=kbc^3$ for some positive constant $k$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "If $a=96$ when $b=3$ and $c=2$, find $b$ when $a=16$ and $c=\\frac{1}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=32$.",
          "worked": "Using $a=kbc^3$:\n$$\\begin{align*}96&=k\\times3\\times2^3\\\\k&=\\frac{96}{24}\\\\k&=4\\end{align*}$$\nThus, $a=4bc^3$. When $a=16$ and $c=\\frac12$:\n$$\\begin{align*}16&=4b\\left(\\frac12\\right)^3\\\\16&=\\frac b2\\\\b&=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
