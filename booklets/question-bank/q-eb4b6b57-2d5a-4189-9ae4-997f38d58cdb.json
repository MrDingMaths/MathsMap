        "prompt": "$3x-7>5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>4$",
          "worked": "$$\\begin{align*}3x-7&>5\\\\3x&>12\\\\x&>4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$4(2x-3)\\geq2x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\geq\\frac{11}{6}$",
          "worked": "$$\\begin{align*}8x-12&\\geq2x-1\\\\6x-12&\\geq-1\\\\6x&\\geq11\\\\x&\\geq\\frac{11}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x-1}{4}-\\frac{x-2}{5}<2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<37$",
          "worked": "Multiply both sides by 20, which is positive.\n\n$$\\begin{align*}5(x-1)-4(x-2)&<40\\\\5x-5-4x+8&<40\\\\x+3&<40\\\\x&<37\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p4-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x+5}{3}-\\frac{3x+1}{2}\\geq4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq-\\frac{17}{7}$",
          "worked": "Multiply both sides by 6, which is positive.\n\n$$\\begin{align*}2(x+5)-3(3x+1)&\\geq24\\\\2x+10-9x-3&\\geq24\\\\-7x+7&\\geq24\\\\-7x&\\geq17\\\\x&\\leq-\\frac{17}{7}\\end{align*}$$\n\nReverse the inequality when dividing by $-7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p4-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{4(2-x)}{3}-2\\geq\\frac{22}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq-5$",
          "worked": "Multiply both sides by 3, which is positive.\n\n$$\\begin{align*}4(2-x)-6&\\geq22\\\\8-4x-6&\\geq22\\\\2-4x&\\geq22\\\\-4x&\\geq20\\\\x&\\leq-5\\end{align*}$$\n\nReverse the inequality when dividing by $-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$4(3-x)<3-3(4-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>3$",
          "worked": "$$\\begin{align*}12-4x&<3-12+3x\\\\12-4x&<-9+3x\\\\21-4x&<3x\\\\21&<7x\\\\3&<x\\end{align*}$$\n\nThus $x>3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
