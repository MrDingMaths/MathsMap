  "content": {
    "id": "p54-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "When $P(x)$ is divided by $(x^2-9)$, the remainder is $(2x+5)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the above in the form of $P(x)=D(x)Q(x)+R(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x^2-9)Q(x)+(2x+5)$",
          "worked": "$$P(x)=(x^2-9)Q(x)+(2x+5)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p54-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the remainder when $P(x)$ is divided by $(x+3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}P(-3)&=\\bigl((-3)^2-9\\bigr)Q(-3)+2(-3)+5\\\\P(-3)&=-1\\end{align*}$$\nBy the remainder theorem, the remainder is $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
