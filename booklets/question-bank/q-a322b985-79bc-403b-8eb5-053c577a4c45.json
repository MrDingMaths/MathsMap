  "content": {
    "id": "p41-25j-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A regular tetrahedron with vertices $A,B,C,D$ and unit-length edges is given. An insect starts at $A$ and moves along edges, choosing randomly at each vertex. Find the probability it returns to $A$ after 5 steps.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p41-25j-q8-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\frac{20}{81}",
                "display": false
              }
            ]
          },
          {
            "id": "p41-25j-q8-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "At each step, the probability of returning to A is one third of the probability of being away from A.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Let $p_r$ be the probability that the insect is at $A$ after $r$ steps. From $A$ it must move away; from any other vertex it moves to $A$ with probability $\\frac13$. Hence $p_{r+1}=\\frac{1-p_r}{3}$, with $p_0=1$.\n$$\\begin{align*}p_1&=0\\\\p_2&=\\frac{1-0}{3}=\\frac13\\\\p_3&=\\frac{1-\\frac13}{3}=\\frac29\\\\p_4&=\\frac{1-\\frac29}{3}=\\frac7{27}\\\\p_5&=\\frac{1-\\frac7{27}}{3}=\\frac{20}{81}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 70
