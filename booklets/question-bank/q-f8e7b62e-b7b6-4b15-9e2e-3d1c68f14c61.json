    "label": null,
    "prompt": "Simplify $\\operatorname{cosec}^2\\theta\\cos^2\\theta(1+\\tan^2\\theta)$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\operatorname{cosec}^2\\theta$",
      "worked": "$$\\begin{aligned}\\operatorname{cosec}^2\\theta\\cos^2\\theta(1+\\tan^2\\theta)&=\\operatorname{cosec}^2\\theta\\cos^2\\theta\\sec^2\\theta\\\\&=\\operatorname{cosec}^2\\theta\\cos^2\\theta\\times\\frac{1}{\\cos^2\\theta}\\\\&=\\operatorname{cosec}^2\\theta\\end{aligned}$$",
      "solutionDiagrams": []
    },
