  "content": {
    "id": "nr-p53-q11-content",
    "type": "question",
    "label": "11",
    "prompt": "A ship sails 85 km from $A$ to $B$ on a bearing of $060^\\circ\\text{ T}$.\nIt then turns and sails 120 km to $C$ on a bearing of $130^\\circ\\text{ T}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "nr-p53-q11-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[\"sourceTeal\"],\"semantic\":[{\"name\":\"sourceMagenta\",\"hex\":\"EF6068\",\"reason\":\"Compass reference directions distinguished from the route\"}],\"reference\":\"nr-p53-q11-diagram\"}\n\\begin{tikzpicture}[every node/.style={font=\\large}]\n% mathsmap-standard-palette 2026-09-11\n\\definecolor{ink}{HTML}{24282D}\n\\definecolor{blue}{HTML}{268CFF}\n\\definecolor{red}{HTML}{EF6068}\n\\definecolor{green}{HTML}{4F9B63}\n\\definecolor{orange}{HTML}{EF8B2C}\n\\definecolor{tableLabel}{HTML}{D3E8FC}\n\\definecolor{housegrid}{HTML}{CCCCCC}\n\\definecolor{skipped}{HTML}{C7C7C7}\n\\definecolor{housemuted}{HTML}{777777}\n\\definecolor{blueFill}{HTML}{D4E8FF}\n\\definecolor{redFill}{HTML}{FCDFE1}\n\\definecolor{greenFill}{HTML}{DCEBE0}\n\\definecolor{orangeFill}{HTML}{FCE8D5}\n\\usetikzlibrary{calc,arrows.meta}\n\\definecolor{sourceTeal}{HTML}{000000}\n\\definecolor{sourceMagenta}{HTML}{EF6068}\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\" data-graph-source-palette=\"00819F,CD1780\" data-graph-source-reference=\"PDF page 53, nr-p53-q11-diagram\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (30:2.975);\n\\coordinate (C) at ($(B)+(-40:4.2)$);\n\\draw[sourceTeal,line width=0.8pt] (A)--(B) node[midway,above left,text=black] {$85\\text{ km}$};\n\\draw[sourceTeal,line width=0.8pt] (B)--(C) node[midway,above right,text=black] {$120\\text{ km}$};\n\\draw[sourceTeal,dashed,line width=0.8pt] (A)--(C);\n\\draw[sourceMagenta,dashed,line width=0.5pt,-{Stealth}] ($(A)+(0,-0.9)$)--($(A)+(0,1.8)$) node[above] {$N$};\n\\draw[sourceMagenta,dashed,line width=0.5pt,-{Stealth}] (B)--($(B)+(0,1.35)$) node[above] {$N$};\n\\draw[sourceTeal,line width=0.4pt,-{Stealth}] ($(A)+(90:0.85)$) arc[start angle=90,end angle=30,radius=0.85];\n\\node at ($(A)+(60:0.52)$) {$60^\\circ$};\n\\draw[sourceTeal,line width=0.4pt,-{Stealth}] ($(B)+(90:0.48)$) arc[start angle=90,end angle=-40,radius=0.48];\n\\node at ($(B)+(25:0.88)$) {$130^\\circ$};\n\\node[left] at (A) {$A$};\n\\node[above left] at (B) {$B$};\n\\node[right] at (C) {$C$};\n\\special{dvisvgm:raw <metadata data-diagram-colours=\"1\" data-diagram-kind=\"geometry\" data-diagram-base=\"sourceTeal\" data-diagram-semantic-palette=\"CD1780\" data-diagram-semantic-reference=\"nr-p53-q11-diagram\" data-diagram-semantic-reasons=\"sourceMagenta: Compass reference directions distinguished from the route\"/>}\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 82,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": true,
