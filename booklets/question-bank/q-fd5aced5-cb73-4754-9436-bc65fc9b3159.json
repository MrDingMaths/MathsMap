    ],
    "children": [
      {
        "id": "nr-p53-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the size of $\\angle ABC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$110^\\circ$",
          "worked": "$$\\begin{align*}\n\\text{Bearing of }A\\text{ from }B &= 60^\\circ+180^\\circ=240^\\circ \\\\\n\\angle ABC &= 240^\\circ-130^\\circ \\\\\n&=110^\\circ\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "nr-p53-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How far is the ship from its starting point?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$169\\text{ km}$",
          "worked": "$$\\begin{align*}\nAC^2 &= 85^2+120^2-2(85)(120)\\cos110^\\circ \\\\\nAC &= \\sqrt{85^2+120^2-2(85)(120)\\cos110^\\circ} \\\\\nAC &\\approx169\\text{ km}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "nr-p53-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate $\\angle BAC$, to the nearest minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$41^\\circ49'$",
          "worked": "$$\\begin{align*}\n\\frac{\\sin\\angle BAC}{120} &= \\frac{\\sin110^\\circ}{AC} \\\\\n\\angle BAC &= \\sin^{-1}\\left(\\frac{120\\sin110^\\circ}{\\sqrt{85^2+120^2-2(85)(120)\\cos110^\\circ}}\\right) \\\\\n\\angle BAC &\\approx41^\\circ49'\n\\end{align*}$$\nThe angle is acute because $\\angle ABC=110^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "nr-p53-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the bearing of the ship from its starting point to the nearest minute?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$101^\\circ49'\\text{ T}$",
          "worked": "$$\\begin{align*}\n\\text{Bearing of }C\\text{ from }A &= 60^\\circ+\\angle BAC \\\\\n&\\approx101^\\circ49'\\text{ T}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
