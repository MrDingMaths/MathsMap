  "content": {
    "id": "p6-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The area $A$ cm² of a square with side length $x$ cm is given by $A=x^2$. If $A=20$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "the value of $x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\sqrt{5}$ cm",
          "worked": "$$\\begin{align*}x^2&=20\\\\x&=\\sqrt{20}\\\\x&=2\\sqrt{5}\\end{align*}$$\nTake the positive square root because $x$ is a side length. The side length is $2\\sqrt{5}$ cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "the value of $x$ correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx4.47$ cm",
          "worked": "$$\\begin{align*}x&=2\\sqrt{5}\\\\x&\\approx4.47\\end{align*}$$\nThe side length is $4.47$ cm, correct to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
