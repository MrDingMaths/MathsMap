          {
            "id": "p19-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\sqrt{9}+\\sqrt{16}\\ne\\sqrt{25}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3+4=7\\ne5$",
              "worked": "$\\begin{aligned}\\sqrt{9}+\\sqrt{16}&=3+4\\\\&=7\\\\\\sqrt{25}&=5\\end{aligned}$\n\nSince $7\\ne5$, $\\sqrt{9}+\\sqrt{16}\\ne\\sqrt{25}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p19-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\sqrt{16}-\\sqrt{9}\\ne\\sqrt{7}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4-3=1\\ne\\sqrt{7}$",
              "worked": "$\\begin{aligned}\\sqrt{16}-\\sqrt{9}&=4-3\\\\&=1\\end{aligned}$\n\nSince $1^2=1\\ne7$, $1\\ne\\sqrt{7}$. Hence $\\sqrt{16}-\\sqrt{9}\\ne\\sqrt{7}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          }
        ]
      }
    ]
