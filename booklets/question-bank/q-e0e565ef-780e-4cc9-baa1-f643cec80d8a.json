        "answer": {
          "short": "$280$",
          "worked": "Fix a blue token first. Arrange the remaining 1 white, 3 black and 4 blue tokens.\n$$\\begin{align*}N&=\\frac{8!}{3!4!}\\\\N&=280\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
