        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$504$",
          "worked": "There are 9 tokens, with 3 identical black tokens and 5 identical blue tokens.\n$$\\begin{align*}N&=\\frac{9!}{3!5!}\\\\N&=504\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
