        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "By the Power of a Point Theorem,\n$$\\begin{align*}(2x)x&=6\\times3\\\\2x^2&=18\\\\x^2&=9\\\\x&=3.\\end{align*}$$\nTake the positive root since $x$ is a length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60,
        "responseSpace": "scaffold"
