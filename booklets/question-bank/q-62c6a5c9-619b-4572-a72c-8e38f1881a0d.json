        "answer": {
          "short": "$x=\\dfrac{16}{5}$",
          "worked": "By the Power of a Point Theorem,\n$$\\begin{align*}5x&=4\\times4\\\\5x&=16\\\\x&=\\frac{16}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36,
        "responseSpace": "scaffold"
