            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 17 p17-q1b-diagram\"}\n\\begin{tikzpicture}[font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (130:1.5);\\coordinate (B) at (-45:1.5);\\coordinate (C) at (205:1.5);\\coordinate (D) at (0:1.5);\\coordinate (E) at (0.29,-0.269);\n\\draw[line width=0.8pt] (0,0) circle (1.5) (A)--(B) (C)--(D);\n\\path (A)--(E) node[midway,right] {$2x$};\\path (E)--(B) node[midway,left] {$x$};\\path (C)--(E) node[midway,above] {$6$};\\path (E)--(D) node[midway,above] {$3$};\n\\end{tikzpicture}",
