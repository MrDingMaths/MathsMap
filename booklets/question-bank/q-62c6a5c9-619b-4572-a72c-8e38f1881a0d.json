            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 17 p17-q1a-diagram\"}\n\\begin{tikzpicture}[font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (130:1.5);\\coordinate (B) at (-60:1.5);\\coordinate (C) at (190:1.5);\\coordinate (D) at (10:1.5);\\coordinate (E) at (0.11,0.019);\n\\draw[line width=0.8pt] (0,0) circle (1.5) (A)--(B) (C)--(D);\n\\path (A)--(E) node[midway,right] {$5$};\\path (E)--(B) node[midway,left,xshift=-2mm] {$x$};\\path (C)--(E) node[midway,below] {$4$};\\path (E)--(D) node[midway,above] {$4$};\n\\end{tikzpicture}",
