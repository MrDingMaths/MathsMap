  "content": {
    "id": "p17-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "$y$ is inversely proportional to $x$. If $x=5$ when $y=8$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y$ when $x=\\frac{3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{80}{3}$",
          "worked": "Since $y$ is inversely proportional to $x$, $xy=k$.\n$$\\begin{align*}k&=5\\times8\\\\k&=40\\\\y&=\\frac{40}{x}\\\\y&=\\frac{40}{3/2}\\\\y&=\\frac{80}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p17-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$x$ when $y=\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=60$",
          "worked": "Since $y$ is inversely proportional to $x$, $xy=k$.\n$$\\begin{align*}k&=5\\times8\\\\k&=40\\\\x&=\\frac{40}{y}\\\\x&=\\frac{40}{2/3}\\\\x&=60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
