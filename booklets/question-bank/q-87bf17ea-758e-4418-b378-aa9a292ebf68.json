  "content": {
    "id": "p4-stem-9-14-root",
    "type": "question",
    "label": "2",
    "prompt": "State the values of $\\theta\\in[0^\\circ,360^\\circ]$ where the following are undefined.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q9",
        "type": "part",
        "label": "a",
        "prompt": "$\\sec\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=90^\\circ,270^\\circ$.",
          "worked": "$\\sec\\theta=\\dfrac{1}{\\cos\\theta}$ is undefined when $\\cos\\theta=0$.\n\nOn $[0^\\circ,360^\\circ]$, $\\theta=90^\\circ,270^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q10",
        "type": "part",
        "label": "b",
        "prompt": "$\\operatorname{cosec}\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0^\\circ,180^\\circ,360^\\circ$.",
          "worked": "$\\operatorname{cosec}\\theta=\\dfrac{1}{\\sin\\theta}$ is undefined when $\\sin\\theta=0$.\n\nOn $[0^\\circ,360^\\circ]$, $\\theta=0^\\circ,180^\\circ,360^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q11",
        "type": "part",
        "label": "c",
        "prompt": "$\\cot\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0^\\circ,180^\\circ,360^\\circ$.",
          "worked": "$\\cot\\theta=\\dfrac{\\cos\\theta}{\\sin\\theta}$ is undefined when $\\sin\\theta=0$.\n\nOn $[0^\\circ,360^\\circ]$, $\\theta=0^\\circ,180^\\circ,360^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q12",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{\\operatorname{cosec}\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0^\\circ,180^\\circ,360^\\circ$.",
          "worked": "$\\operatorname{cosec}\\theta$ is undefined when $\\sin\\theta=0$ and is never zero where defined. Its reciprocal therefore remains undefined at those sine zeros.\n\nOn $[0^\\circ,360^\\circ]$, $\\theta=0^\\circ,180^\\circ,360^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p4-q13",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1}{\\sec\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=90^\\circ,270^\\circ$.",
          "worked": "$\\sec\\theta$ is undefined when $\\cos\\theta=0$ and is never zero where defined. Its reciprocal therefore remains undefined at those cosine zeros.\n\nOn $[0^\\circ,360^\\circ]$, $\\theta=90^\\circ,270^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p4-q14",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1}{\\tan\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0^\\circ,90^\\circ,180^\\circ,270^\\circ,360^\\circ$.",
          "worked": "$\\tan\\theta$ is undefined at $90^\\circ,270^\\circ$, so its reciprocal is undefined there. It is zero at $0^\\circ,180^\\circ,360^\\circ$, so its reciprocal is also undefined there.\n\nThus $\\theta=0^\\circ,90^\\circ,180^\\circ,270^\\circ,360^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
