  "content": {
    "id": "p18-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Round lengths to one decimal place where necessary.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q3-a",
        "type": "group",
        "label": "a",
        "prompt": "A chord subtends an angle of $90^\\circ$ at the centre of a circle of radius $12$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q3-a-i",
            "type": "part",
            "label": "i",
            "prompt": "How long is the chord?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12\\sqrt2\\text{ cm}\\approx17.0\\text{ cm}$.",
              "worked": "The two radii and chord form a right-angled isosceles triangle. Thus chord length $=\\sqrt{12^2+12^2}=12\\sqrt2\\text{ cm}\\approx17.0\\text{ cm}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p18-q3-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "How far is the midpoint of the chord from the centre?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6\\sqrt2\\text{ cm}\\approx8.5\\text{ cm}$.",
              "worked": "The perpendicular from the centre bisects the chord. Its half-length is $6\\sqrt2$, so the distance is $\\sqrt{12^2-(6\\sqrt2)^2}=6\\sqrt2\\text{ cm}\\approx8.5\\text{ cm}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      },
      {
        "id": "p18-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "In a circle of radius $20$ cm, the midpoint of a chord is $16$ cm from the centre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q3-b-i",
            "type": "part",
            "label": "iii",
            "prompt": "How long is the chord?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$24$ cm.",
              "worked": "The midpoint-to-centre line is perpendicular to the chord. Half the chord is $\\sqrt{20^2-16^2}=12$ cm, so the chord is $24$ cm.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p18-q3-b-ii",
            "type": "part",
            "label": "iv",
            "prompt": "What angle does the chord subtend at the centre, correct to one decimal place?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$73.7^\\circ$.",
              "worked": "The midpoint line bisects the central angle. Its half-angle satisfies $\\sin\\theta=\\frac{12}{20}$, so the whole angle is $2\\sin^{-1}(\\frac{12}{20})\\approx73.7^\\circ$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      },
      {
        "id": "p18-q3-c",
        "type": "group",
        "label": "c",
        "prompt": "In a circle of radius $10$ cm, a chord has length $16$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q3-c-i",
            "type": "part",
            "label": "v",
            "prompt": "What is the perpendicular distance from the chord to the centre?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6$ cm.",
              "worked": "The perpendicular from the centre bisects the chord, giving half-length $8$ cm. Hence distance $=\\sqrt{10^2-8^2}=6$ cm.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p18-q3-c-ii",
            "type": "part",
            "label": "vi",
            "prompt": "What angle does the chord subtend at the centre, correct to one decimal place?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$106.3^\\circ$.",
              "worked": "Half the central angle satisfies $\\sin\\theta=\\frac{8}{10}$, so the whole angle is $2\\sin^{-1}(\\frac{8}{10})\\approx106.3^\\circ$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      }
    ]
