  "content": {
    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find any points on these curves where the tangent has gradient $-1$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,1)$ and $(-1,-1)$",
          "worked": "$$\\begin{align*}y&=x^{-1}\\\\\\frac{dy}{dx}&=-x^{-2}\\\\-\\frac{1}{x^2}&=-1\\\\x^2&=1\\\\x&=\\pm1\\end{align*}$$\nWhen $x=1$, $y=1$. When $x=-1$, $y=-1$.\nThe points are $(1,1)$ and $(-1,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p20-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x^{-2}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(1,\\dfrac12\\right)$",
          "worked": "$$\\begin{align*}y&=\\frac12x^{-2}\\\\\\frac{dy}{dx}&=-x^{-3}\\\\-\\frac{1}{x^3}&=-1\\\\x^3&=1\\\\x&=1\\\\y&=\\frac{1^{-2}}{2}\\\\y&=\\frac12\\end{align*}$$\nThe point is $\\left(1,\\dfrac12\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
