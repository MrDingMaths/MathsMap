    "type": "question",
    "label": "5",
    "prompt": "Is the sum of eight consecutive integers always a multiple of 8?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No. For example, $1+2+3+4+5+6+7+8=36$, which is not a multiple of 8.",
      "worked": "No. Consider the eight consecutive integers from 1 to 8:\n$$1+2+3+4+5+6+7+8=36.$$\nSince 36 is not a multiple of 8, this counterexample disproves the claim.",
