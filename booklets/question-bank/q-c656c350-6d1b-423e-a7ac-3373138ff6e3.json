  "content": {
    "id": "p47-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A number is chosen from the set of positive integers between 1 and 20 inclusive.\n$A$ is the set of multiples of 3 less than 20, and $B$ is the set of factors of 15.\nFind the probabilities:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(A\\cap B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{10}$",
          "worked": "$$A\\cap B=\\{3,15\\}$$\n$$\\begin{aligned}P(A\\cap B)&=\\frac{2}{20}\\\\&=\\frac{1}{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p47-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(A\\cup B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{5}$",
          "worked": "$$\\begin{aligned}A\\cup B&=\\{1,3,5,6,9,\\\\&\\qquad 12,15,18\\}\\end{aligned}$$\n$$\\begin{aligned}P(A\\cup B)&=\\frac{8}{20}\\\\&=\\frac{2}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p47-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(\\overline{A})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{10}$",
          "worked": "$$\\begin{aligned}\\overline{A}&=\\{1,2,4,5,7,8,\\\\&\\qquad 10,11,13,14,\\\\&\\qquad 16,17,19,20\\}\\end{aligned}$$\n$$\\begin{aligned}P(\\overline{A})&=\\frac{14}{20}\\\\&=\\frac{7}{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p47-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(A\\cap\\overline{B})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{5}$",
          "worked": "$$A\\cap\\overline{B}=\\{6,9,12,18\\}$$\n$$\\begin{aligned}P(A\\cap\\overline{B})&=\\frac{4}{20}\\\\&=\\frac{1}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
