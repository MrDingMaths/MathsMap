  "content": {
    "id": "v2-8d9c0-p24-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Find $f(x)$, given that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8d9c0-p24-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f''(x)=4e^{2x}$, $f'(0)=3$ and $f(0)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=e^{2x}+x+2$",
          "worked": "$$\\begin{align*}f'(x)&=2e^{2x}+C\\end{align*}$$\nUsing $f'(0)=3$:\n$$\\begin{align*}2+C&=3\\\\C&=1\\\\f'(x)&=2e^{2x}+1\\\\f(x)&=e^{2x}+x+D\\end{align*}$$\nUsing $f(0)=3$:\n$$\\begin{align*}1+D&=3\\\\D&=2\\\\f(x)&=e^{2x}+x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-8d9c0-p24-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$f''(x)=9e^{-3x}$, $f'(0)=1$ and $f(0)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=e^{-3x}+4x+1$",
          "worked": "$$\\begin{align*}f'(x)&=-3e^{-3x}+C\\end{align*}$$\nUsing $f'(0)=1$:\n$$\\begin{align*}-3+C&=1\\\\C&=4\\\\f'(x)&=-3e^{-3x}+4\\\\f(x)&=e^{-3x}+4x+D\\end{align*}$$\nUsing $f(0)=2$:\n$$\\begin{align*}1+D&=2\\\\D&=1\\\\f(x)&=e^{-3x}+4x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
