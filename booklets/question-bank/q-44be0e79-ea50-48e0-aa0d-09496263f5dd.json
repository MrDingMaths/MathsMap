    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{4}{x}+\\frac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{x}$",
          "worked": "$$\\begin{align*}\\frac{4}{x}+\\frac{3}{x}&=\\frac{4+3}{x}\\\\\\frac{4}{x}+\\frac{3}{x}&=\\frac{7}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{5}{x}+\\frac{6}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{x}$",
          "worked": "$$\\begin{align*}\\frac{5}{x}+\\frac{6}{x}&=\\frac{5+6}{x}\\\\\\frac{5}{x}+\\frac{6}{x}&=\\frac{11}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{x}+\\frac{4}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{x}$",
          "worked": "$$\\begin{align*}\\frac{3}{x}+\\frac{4}{2x}&=\\frac{6}{2x}+\\frac{4}{2x}\\\\\\frac{3}{x}+\\frac{4}{2x}&=\\frac{10}{2x}\\\\\\frac{3}{x}+\\frac{4}{2x}&=\\frac{5}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5}{x^2}+\\frac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5+3x}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{5}{x^2}+\\frac{3}{x}&=\\frac{5}{x^2}+\\frac{3x}{x^2}\\\\\\frac{5}{x^2}+\\frac{3}{x}&=\\frac{5+3x}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{5}{x}-\\frac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{x}$",
          "worked": "$$\\begin{align*}\\frac{5}{x}-\\frac{3}{x}&=\\frac{5-3}{x}\\\\\\frac{5}{x}-\\frac{3}{x}&=\\frac{2}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{7}{x^2}-\\frac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7-3x}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{7}{x^2}-\\frac{3}{x}&=\\frac{7}{x^2}-\\frac{3x}{x^2}\\\\\\frac{7}{x^2}-\\frac{3}{x}&=\\frac{7-3x}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{4}{x}+\\frac{3}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{2x}$",
          "worked": "$$\\begin{align*}\\frac{4}{x}+\\frac{3}{2x}&=\\frac{8}{2x}+\\frac{3}{2x}\\\\\\frac{4}{x}+\\frac{3}{2x}&=\\frac{11}{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{7}{2x}-\\frac{4}{3x}$",
