        "children": [],
        "answer": {
          "short": "$\\frac{13}{6x}$",
          "worked": "$$\\begin{align*}\\frac{7}{2x}-\\frac{4}{3x}&=\\frac{21}{6x}-\\frac{8}{6x}\\\\\\frac{7}{2x}-\\frac{4}{3x}&=\\frac{21-8}{6x}\\\\\\frac{7}{2x}-\\frac{4}{3x}&=\\frac{13}{6x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q2-i",
