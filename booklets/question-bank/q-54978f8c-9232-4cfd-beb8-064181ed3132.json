  "content": {
    "id": "p15-q1-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p15-q1-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "State the quadrants in the Cartesian plane for which the following are positive.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x$-coordinates",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "First and fourth quadrants.",
          "worked": "The $x$-coordinate is positive to the right of the $y$-axis: the first and fourth quadrants.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-coordinates",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "First and second quadrants.",
          "worked": "The $y$-coordinate is positive above the $x$-axis: the first and second quadrants.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p15-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "gradient of $y=mx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "First and third quadrants.",
          "worked": "The gradient is $m=\\dfrac{y}{x}$. It is positive when $x$ and $y$ have the same sign: the first and third quadrants.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p15-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "First and fourth quadrants.",
          "worked": "On the unit circle, $\\cos\\theta$ is the $x$-coordinate. It is positive in the first and fourth quadrants.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p15-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "First and second quadrants.",
          "worked": "On the unit circle, $\\sin\\theta$ is the $y$-coordinate. It is positive in the first and second quadrants.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p15-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "First and third quadrants.",
          "worked": "On the unit circle, $\\tan\\theta=\\dfrac{y}{x}$. It is positive when $x$ and $y$ have the same sign: the first and third quadrants.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
