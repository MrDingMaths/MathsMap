  "content": {
    "id": "p9-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Consider the graph of $y=(x+3)^2+2$. Find the equation of the resulting curve after the graph is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "reflected in the $y$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-3)^2+2$",
          "worked": "Reflection in the $y$-axis replaces $x$ with $-x$.\n$$\\begin{align*}y&=(-x+3)^2+2\\\\y&=(x-3)^2+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "reflected in the $x$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x+3)^2-2$",
          "worked": "Reflection in the $x$-axis negates each $y$-value.\n$$\\begin{align*}y&=-\\big((x+3)^2+2\\big)\\\\y&=-(x+3)^2-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "rotated by $180^\\circ$ about the origin",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-3)^2-2$",
          "worked": "A $180^\\circ$ rotation about the origin reflects the graph in both axes, replacing $(x,y)$ with $(-x,-y)$.\n$$\\begin{align*}y&=-\\big((-x+3)^2+2\\big)\\\\y&=-(x-3)^2-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
