                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Divide the equilateral triangle into four congruent equilateral triangles, and remove the central triangle.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "p24-q23-step2-item",
              "type": "list-item",
              "blocks": [
