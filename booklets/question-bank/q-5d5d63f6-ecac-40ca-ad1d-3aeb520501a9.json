                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Repeat Step 1 for each of the remaining smaller equilateral triangles, and iterate ad infinitum.",
                      "marks": []
                    }
                  ]
                }
              ]
            }
          ]
        },
