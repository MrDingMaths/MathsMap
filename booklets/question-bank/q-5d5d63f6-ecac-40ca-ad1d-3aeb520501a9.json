        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 24 p24-q23-diagram-2\"}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[fill=black,draw=black,line width=0.8pt] (0,0)--(1,0)--(0.5,{sqrt(3)/2})--cycle;\n\\path[fill=white] (0.5,0)--(0.75,{sqrt(3)/4})--(0.25,{sqrt(3)/4})--cycle;\n\\path[fill=white] (0.25,0)--(0.375,{sqrt(3)/8})--(0.125,{sqrt(3)/8})--cycle;\n\\path[fill=white] (0.75,0)--(0.875,{sqrt(3)/8})--(0.625,{sqrt(3)/8})--cycle;\n\\path[fill=white] (0.5,{sqrt(3)/4})--(0.625,{3*sqrt(3)/8})--(0.375,{3*sqrt(3)/8})--cycle;\n\\end{tikzpicture}",
