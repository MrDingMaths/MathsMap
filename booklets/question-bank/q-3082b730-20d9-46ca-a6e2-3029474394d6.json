    "type": "question",
    "label": "10",
    "prompt": "The population of the mountain town of Granite Peak has been growing at $7.4\\%$ every year and has now reached $80\\,000$. Find the population, correct to the nearest person:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
