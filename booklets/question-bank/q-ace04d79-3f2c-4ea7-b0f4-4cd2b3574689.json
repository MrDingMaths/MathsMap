  "content": {
    "id": "p28-q13-root",
    "type": "question",
    "label": "",
    "prompt": "Given that $f(x)=\\dfrac{x}{1+x^2}-\\tan^{-1}x$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(0)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{aligned}f(0)&=\\frac{0}{1+0}-\\tan^{-1}(0)\\\\&=0.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p28-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $f'(x)=\\dfrac{-2x^2}{(1+x^2)^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\dfrac{2x^2}{(1+x^2)^2}$.",
          "worked": "$$\\begin{aligned}f'(x)&=\\frac{d}{dx}\\left(\\frac{x}{1+x^2}\\right)-\\frac{1}{1+x^2}\\\\&=\\frac{(1+x^2)-x\\cdot2x}{(1+x^2)^2}-\\frac{1}{1+x^2}\\\\&=\\frac{1-x^2}{(1+x^2)^2}-\\frac{1+x^2}{(1+x^2)^2}\\\\&=\\frac{-2x^2}{(1+x^2)^2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p28-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence explain why $f(x)<0$ for all $x>0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(0)=0$ and $f'(x)<0$ for $x>0$, so $f(x)<0$ for $x>0$.",
          "worked": "$f(0)=0$ and $f'(x)=-\\dfrac{2x^2}{(1+x^2)^2}\\leq0$ for all $x$, with equality only at $x=0$. Thus $f$ is non-increasing, and is strictly decreasing for $x>0$. Since it starts at $0$, $f(x)<0$ for every $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find $\\displaystyle\\int_0^1\\frac{x^2}{(1+x^2)^2}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\pi}{8}-\\dfrac14$",
          "worked": "Using part (b),\n$$\\begin{aligned}\\int_0^1\\frac{-2x^2}{(1+x^2)^2}\\,dx&=\\left[\\frac{x}{1+x^2}-\\tan^{-1}x\\right]_0^1\\\\&=\\left(\\frac12-\\frac\\pi4\\right)-0.\\end{aligned}$$\nTherefore,\n$$\\begin{aligned}\\int_0^1\\frac{x^2}{(1+x^2)^2}\\,dx&=\\frac12\\left(\\frac\\pi4-\\frac12\\right)\\\\&=\\frac\\pi8-\\frac14.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
