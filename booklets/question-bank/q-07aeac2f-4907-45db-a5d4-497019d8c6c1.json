        "answer": {
          "short": "$x^2-y^2+2yz-z^2$",
          "worked": "$$\\begin{align*}(x+y-z)(x-y+z)&=x^2-(y-z)^2\\\\(x+y-z)(x-y+z)&=x^2-(y^2-2yz+z^2)\\\\(x+y-z)(x-y+z)&=x^2-y^2+2yz-z^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$(a-b+c)(a+b-c)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-b^2+2bc-c^2$",
          "worked": "$$\\begin{align*}(a-b+c)(a+b-c)&=a^2-(b-c)^2\\\\(a-b+c)(a+b-c)&=a^2-(b^2-2bc+c^2)\\\\(a-b+c)(a+b-c)&=a^2-b^2+2bc-c^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x-y+z)(2x+y-z)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
