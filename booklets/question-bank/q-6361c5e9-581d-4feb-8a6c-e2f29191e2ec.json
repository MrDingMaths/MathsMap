  "content": {
    "id": "p17-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The following points lie on the line with equation $y=-\\frac{1}{2}x-4$. Find the value of each pronumeral.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$(0,a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-4$",
          "worked": "$$\\begin{aligned}a&=-\\frac{1}{2}\\times0-4\\\\a&=-4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p17-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$(b,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-8$",
          "worked": "$$\\begin{aligned}0&=-\\frac{1}{2}b-4\\\\4&=-\\frac{1}{2}b\\\\b&=-8\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q12-c",
        "type": "part",
