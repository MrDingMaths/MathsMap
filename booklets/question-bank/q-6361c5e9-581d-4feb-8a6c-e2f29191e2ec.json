          "worked": "$$\\begin{aligned}-6&=-\\frac{1}{2}d-4\\\\-2&=-\\frac{1}{2}d\\\\d&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
