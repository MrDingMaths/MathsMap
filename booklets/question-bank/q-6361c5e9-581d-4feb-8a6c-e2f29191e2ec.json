          "worked": "$$\\begin{aligned}c&=-\\frac{1}{2}\\times1-4\\\\c&=-\\frac{1}{2}-4\\\\c&=-\\frac{9}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
