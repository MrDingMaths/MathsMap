  "content": {
    "id": "p52-q2-root",
    "type": "question",
    "label": null,
    "prompt": "Last year, a tennis club had 150 members. This year, the tennis club has only 126 members.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "How many fewer members does the club have than last year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "24 members.",
          "worked": "$$150-126=24$$\nThe club has 24 fewer members.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p52-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Work out the percentage reduction in the number of members.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\%$ decrease.",
          "worked": "$$\\begin{align*}\\text{Change}&=126-150\\\\&=-24\\\\\\%\\text{ change}&=\\frac{-24}{150}\\times100\\\\&=-16\\%\\end{align*}$$\nThe membership decreased by $16\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
