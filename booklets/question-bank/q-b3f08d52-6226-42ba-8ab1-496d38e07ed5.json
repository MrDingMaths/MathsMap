  "content": {
    "id": "p16-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Ms Minas earns $\\$3600$ more than Mr Brown, and Ms Lee earns $\\$2000$ less than Mr Brown.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q10-a",
        "type": "group",
        "label": "a",
        "prompt": "If $\\$x$ represents Mr Brown’s salary, express the salary of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q10-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Ms Minas in terms of $x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(x+3600)$",
              "worked": "Ms Minas earns $\\$3600$ more than Mr Brown, so her salary is $\\$(x+3600)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p16-q10-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Ms Lee in terms of $x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(x-2000)$",
              "worked": "Ms Lee earns $\\$2000$ less than Mr Brown, so her salary is $\\$(x-2000)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      },
      {
        "id": "p16-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If the total of the three incomes is $\\$151600$, find the income of each person. Form an equation and solve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ms Minas earns $\\$53600$, Mr Brown earns $\\$50000$ and Ms Lee earns $\\$48000$.",
          "worked": "Let $\\$x$ be Mr Brown’s salary. The three incomes total $\\$151600$.\n\n$$\\begin{align*}(x+3600)+x+(x-2000)&=151600\\\\3x+1600&=151600\\\\3x&=150000\\\\x&=50000\\end{align*}$$\n\nMr Brown earns $\\$50000$.\n\n$$\\begin{align*}\\text{Ms Minas's salary}&=50000+3600\\\\\\text{Ms Minas's salary}&=53600\\\\\\text{Ms Lee's salary}&=50000-2000\\\\\\text{Ms Lee's salary}&=48000\\end{align*}$$\n\nSo Ms Minas earns $\\$53600$ and Ms Lee earns $\\$48000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
    ]
