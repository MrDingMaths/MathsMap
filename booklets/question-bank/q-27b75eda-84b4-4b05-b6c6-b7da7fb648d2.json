  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x\\times\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$\\begin{aligned}x\\times\\frac{1}{x}&=\\frac{x}{x}\\\\&=1\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\div\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2$",
          "worked": "$\\begin{aligned}x\\div\\frac{1}{x}&=x\\times x\\\\&=x^2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x\\div3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{3}$",
          "worked": "$\\begin{aligned}x\\div3&=x\\times\\frac{1}{3}\\\\&=\\frac{x}{3}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{a}{b}\\div c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a}{bc}$",
          "worked": "$\\begin{aligned}\\frac{a}{b}\\div c&=\\frac{a}{b}\\times\\frac{1}{c}\\\\&=\\frac{a}{bc}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$a\\div\\frac{b}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{ac}{b}$",
          "worked": "$\\begin{aligned}a\\div\\frac{b}{c}&=a\\times\\frac{c}{b}\\\\&=\\frac{ac}{b}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$x\\div\\frac{x}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$",
          "worked": "$\\begin{aligned}x\\div\\frac{x}{y}&=x\\times\\frac{y}{x}\\\\&=\\frac{xy}{x}\\\\&=y\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
