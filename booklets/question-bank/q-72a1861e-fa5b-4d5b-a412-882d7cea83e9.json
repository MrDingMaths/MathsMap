  "content": {
    "id": "v2-p34-classification-slot-1-upper-root",
    "type": "question",
    "label": null,
    "prompt": "A café recorded the number of customers on eight mornings.\n\n$23,\\ 18,\\ 31,\\ 18,\\ 27,\\ 35,\\ 18,\\ x$\n\nThe mean number of customers is $24$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-p34-classification-slot-1-upper-slot-1-upper-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=22$",
          "worked": "$$\\begin{align*}\\frac{\\text{sum of data values}}{8}&=24\\\\\\text{sum of data values}&=192\\\\170+x&=192\\\\x&=22\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-p34-classification-slot-1-upper-slot-1-upper-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17$",
          "worked": "$$\\begin{align*}\\text{Range}&=35-18\\\\\\text{Range}&=17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-p34-classification-slot-1-upper-slot-1-upper-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the mode.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$18$ occurs three times; every other value occurs once. The mode is $18$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-p34-classification-slot-1-upper-slot-1-upper-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the median.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22.5$",
          "worked": "In order, the values are $18,18,18,22,23,27,31,35$.\n\n$$\\begin{align*}\\text{Position}&=\\frac{8+1}{2}\\\\\\text{Position}&=4.5\\end{align*}$$\n\nThe median is between the $4^{\\mathrm{th}}$ and $5^{\\mathrm{th}}$ scores.\n\n$$\\begin{align*}\\text{Median}&=\\frac{22+23}{2}\\\\\\text{Median}&=22.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
