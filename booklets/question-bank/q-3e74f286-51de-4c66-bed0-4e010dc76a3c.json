        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$85.6\\text{ m}^2$",
          "worked": "$$\\begin{align*}A_{\\text{sector}}&=\\frac{100}{360}\\pi(15)^2\\\\A_{\\text{segment}}&=A_{\\text{sector}}-A_{\\triangle OAB}\\\\A_{\\text{segment}}&=\\frac{100}{360}\\pi(15)^2-\\frac12(15)(15)\\sin100^\\circ\\\\A_{\\text{segment}}&\\approx85.6\\text{ m}^2\\end{align*}$$",
