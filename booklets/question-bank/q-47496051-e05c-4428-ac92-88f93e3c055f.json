  "content": {
    "id": "p18-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Multiplying a number by 3 and adding 8 gives the same result as multiplying the number by 2 and subtracting 8. Find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-16$.\n\nEquate the two expressions and collect the unknown terms.",
      "worked": "Let $x$ be the number.\n\n$$\\begin{align*}3x+8&=2x-8\\\\x+8&=-8\\\\x&=-16\\end{align*}$$\n\nCheck: $3(-16)+8=-40$ and $2(-16)-8=-40$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 49
