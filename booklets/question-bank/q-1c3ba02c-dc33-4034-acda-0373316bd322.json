    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+9x=-14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7,\\ -2$",
          "worked": "$$\\begin{align*}x^2+9x+14&=0\\\\(x+7)(x+2)&=0\\\\x&=-7,\\ -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
