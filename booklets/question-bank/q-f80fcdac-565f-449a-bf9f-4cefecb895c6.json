        "answer": {
          "short": "$\\frac{7}{50}$",
          "worked": "$$\\begin{align*}\\text{Greek only}&=15-8\\\\&=7\\\\P(\\text{Greek only})&=\\frac{7}{50}\\end{align*}$$",
          "solutionDiagrams": []
