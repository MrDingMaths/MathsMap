  "content": {
    "id": "p16-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "In a group of 50 students, there are 26 who study Latin, 15 who study Greek and 8 who study both languages. Draw a Venn diagram and find the probability that a student chosen at random:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "studies only Latin,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p16-q18-solution-venn",
        "answer": {
          "short": "$\\frac{9}{25}$",
          "worked": "$$\\begin{align*}\\text{Latin only}&=26-8\\\\&=18\\\\P(\\text{Latin only})&=\\frac{18}{50}\\\\&=\\frac{9}{25}\\end{align*}$$",
          "solutionDiagrams": [
            {
              "id": "p16-q18-solution-venn",
              "role": "solution",
              "format": "tikz",
