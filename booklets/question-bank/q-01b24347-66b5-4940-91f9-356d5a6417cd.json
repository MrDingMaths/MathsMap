  "content": {
    "id": "p18-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Multiplying a number by 2 and subtracting 6 gives the same result as multiplying the number by 10 and adding 8. Find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-1\\frac34$.\n\nEquate the expressions and collect the unknown terms on one side.",
      "worked": "Let $x$ be the number.\n\n$$\\begin{align*}2x-6&=10x+8\\\\-6&=8x+8\\\\-14&=8x\\\\x&=-\\frac{14}{8}\\\\x&=-1\\frac34\\end{align*}$$\n\nCheck: $2(-\\frac74)-6=-\\frac{19}{2}$ and $10(-\\frac74)+8=-\\frac{19}{2}$.",
      "solutionDiagrams": []
    },
