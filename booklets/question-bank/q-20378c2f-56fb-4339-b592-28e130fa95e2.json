        "id": "p20-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$6abcd\\leq a^2b^2+a^2c^2+a^2d^2+b^2c^2+b^2d^2+c^2d^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
