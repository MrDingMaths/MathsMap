        "label": "a",
        "prompt": "Identify why the two triangles are similar",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "At least two pairs of equal corresponding angles: alternate angles are equal because $AB\\parallel DE$.",
          "worked": "$\\angle BAC=\\angle CED$ and $\\angle ABC=\\angle EDC$ (alternate angles, $AB\\parallel DE$). Therefore $\\triangle ABC\\sim\\triangle EDC$, since at least two pairs of corresponding angles are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "find the value of $x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=15\\text{ mm}$",
          "worked": "$AB$ corresponds to $ED$, and $AC$ corresponds to $EC$.\n$$\\begin{align*}\\frac{x}{5}&=\\frac{9}{3}\\\\x&=5\\times\\frac{9}{3}\\\\x&=15\\text{ mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
