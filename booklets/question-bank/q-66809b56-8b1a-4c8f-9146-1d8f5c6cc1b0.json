  "content": {
    "id": "p8-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "If $\\theta$ is the angle between $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$, find $\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}$ given:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$|\\underset{\\sim}{a}|=6$, $|\\underset{\\sim}{b}|=5$ and $\\theta=60^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=|\\underset{\\sim}{a}||\\underset{\\sim}{b}|\\cos\\theta\\\\&=6\\times5\\cos60^\\circ\\\\&=15\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$|\\underset{\\sim}{a}|=4$, $|\\underset{\\sim}{b}|=3$ and $\\theta=45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\sqrt2$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=|\\underset{\\sim}{a}||\\underset{\\sim}{b}|\\cos\\theta\\\\&=4\\times3\\times\\frac{\\sqrt2}{2}\\\\&=6\\sqrt2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
