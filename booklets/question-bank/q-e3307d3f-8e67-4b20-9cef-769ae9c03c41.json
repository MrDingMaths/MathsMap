  "content": {
    "id": "p62-q12-root",
    "type": "question",
    "label": null,
    "prompt": "Prove that $\\displaystyle\\tan^2\\left(\\frac\\pi4+\\theta\\right)=\\frac{1+\\sin2\\theta}{1-\\sin2\\theta}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Use the tangent sum formula, square the quotient, then multiply numerator and denominator by $\\cos^2\\theta$ and apply $\\sin2\\theta=2\\sin\\theta\\cos\\theta$.",
      "worked": "$$\\begin{align*}\\tan^2\\left(\\frac\\pi4+\\theta\\right)&=\\left(\\frac{1+\\tan\\theta}{1-\\tan\\theta}\\right)^2\\\\\\tan^2\\left(\\frac\\pi4+\\theta\\right)&=\\frac{(1+\\tan\\theta)^2\\cos^2\\theta}{(1-\\tan\\theta)^2\\cos^2\\theta}\\\\\\tan^2\\left(\\frac\\pi4+\\theta\\right)&=\\frac{(\\cos\\theta+\\sin\\theta)^2}{(\\cos\\theta-\\sin\\theta)^2}\\\\\\tan^2\\left(\\frac\\pi4+\\theta\\right)&=\\frac{\\cos^2\\theta+2\\sin\\theta\\cos\\theta+\\sin^2\\theta}{\\cos^2\\theta-2\\sin\\theta\\cos\\theta+\\sin^2\\theta}\\\\\\tan^2\\left(\\frac\\pi4+\\theta\\right)&=\\frac{1+\\sin2\\theta}{1-\\sin2\\theta}.\\end{align*}$$",
      "solutionDiagrams": []
    },
