  "content": {
    "id": "p19-q10",
    "type": "question",
    "label": "10",
    "prompt": "Let $f(x)=2x-8$ and $g(x)=\\frac{1}{2}x+4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q10-a",
        "type": "group",
        "label": "a",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q10-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$g(f(5))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5$",
              "worked": "$$\\begin{align*}f(5)&=2(5)-8=2\\\\g(f(5))&=g(2)\\\\g(f(5))&=\\frac{1}{2}(2)+4\\\\g(f(5))&=5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p19-q10-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$f(g(5))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5$",
              "worked": "$$\\begin{align*}g(5)&=\\frac{1}{2}(5)+4=\\frac{13}{2}\\\\f(g(5))&=f\\left(\\frac{13}{2}\\right)\\\\f(g(5))&=2\\left(\\frac{13}{2}\\right)-8\\\\f(g(5))&=5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      },
      {
        "id": "p19-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q10-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x$",
              "worked": "$$\\begin{align*}g(f(x))&=\\frac{1}{2}(2x-8)+4\\\\g(f(x))&=x-4+4\\\\g(f(x))&=x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p19-q10-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x$",
              "worked": "$$\\begin{align*}f(g(x))&=2\\left(\\frac{1}{2}x+4\\right)-8\\\\f(g(x))&=x+8-8\\\\f(g(x))&=x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p19-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "What can you conclude about $f(x)$ and $g(x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g$ is the inverse of $f$, and vice versa.",
          "worked": "Since $g(f(x))=x$ and $f(g(x))=x$ for all real $x$, $g$ is the inverse of $f$, and vice versa.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
