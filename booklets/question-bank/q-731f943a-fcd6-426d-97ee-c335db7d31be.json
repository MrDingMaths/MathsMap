  "content": {
    "id": "p3-q25-root",
    "type": "question",
    "label": "25",
    "prompt": "Claire travels $40\\text{ km}$ by train in $\\frac34$ of an hour and then cycles for $10\\text{ km}$ in $48$ minutes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "How long is she travelling in total?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 hour 33 minutes",
          "worked": "The train trip takes $\\frac34\\times60=45$ minutes. Total time $45+48=93$ minutes, which is 1 hour 33 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p3-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "What is her average speed during the train trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$53\\frac13\\text{ km/h}$",
          "worked": "$$\\text{Train speed}=40\\div\\frac34=\\frac{160}{3}=53\\frac13\\text{ km/h}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p3-q25-c",
        "type": "part",
        "label": "c",
        "prompt": "What is her average speed during the bike trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\frac12\\text{ km/h}$",
          "worked": "The cycling time is $48\\div60=\\frac45$ hour.\n$$\\text{Bike speed}=10\\div\\frac45=\\frac{25}{2}=12\\frac12\\text{ km/h}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p3-q25-d",
        "type": "part",
        "label": "d",
        "prompt": "What is her average speed over the whole trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32.26\\text{ km/h}$",
          "worked": "Total distance is $40+10=50\\text{ km}$. Total time is $93\\div60=1.55$ hours.\n$$\\text{Average speed}=50\\div1.55\\approx32.26\\text{ km/h}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
