  "content": {
    "id": "v2-24c92-p37-practice-j4-092930-root",
    "type": "question",
    "label": null,
    "prompt": "Sisters Mia and Zoe start riding from home to the beach, which is 36 km away.\nMia rode at 18 km/h and Zoe took 24 minutes longer to complete the trip.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-24c92-p37-practice-j4-092930-j4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "How long did Mia take, in hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\text{ h}$",
          "worked": "$$\\begin{align*}t&=\\frac{d}{s}\\\\t&=\\frac{36}{18}\\\\t&=2\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-24c92-p37-practice-j4-092930-j4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "How long did Zoe take, in hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.4\\text{ h}$",
          "worked": "$$\\begin{align*}t_{\\text{Zoe}}&=2+\\frac{24}{60}\\\\t_{\\text{Zoe}}&=2.4\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "v2-24c92-p37-practice-j4-092930-j4-q-c",
        "type": "part",
        "label": "c",
        "prompt": "How fast was Zoe riding?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\text{ km/h}$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{36}{2.4}\\\\s&=15\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
