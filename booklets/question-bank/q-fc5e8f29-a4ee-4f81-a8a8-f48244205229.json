    "type": "question",
    "label": "4",
    "prompt": "What is the difference between a relation and a function?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "A function is a relation that assigns exactly one output to every input in its domain. A general relation need not satisfy this requirement.",
      "worked": "A relation from $A$ to $B$ may leave an element of $A$ unassigned or associate it with several elements of $B$. A function from $A$ to $B$ must associate every element of $A$ with exactly one element of $B$.\n\nFor a real function, this means every vertical line intersects its graph at most once.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
