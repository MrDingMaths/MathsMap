      {
        "id": "p8-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "What do you notice? Why does this happen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The LCM is $12$, the larger original number, because $12$ is a multiple of $6$.",
          "worked": "The LCM equals $12$, one of the original numbers. Since $12=2\\times6$, every multiple of $12$ is also a multiple of $6$. The smallest positive common multiple is therefore $12$. When one number is a multiple of the other, the LCM is the larger number.",
