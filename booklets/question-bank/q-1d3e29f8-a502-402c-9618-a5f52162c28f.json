  "content": {
    "id": "p27-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "What are the smallest and largest three-digit numbers that are:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "multiples of 9?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Smallest: $108$; largest: $999$.",
          "worked": "$$\\begin{align*}9\\times11&=99\\\\9\\times12&=108\\\\9\\times111&=999\\\\9\\times112&=1008\\end{align*}$$\nThe three-digit multiples therefore run from $108$ to $999$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p27-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "multiples of 23?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Smallest: $115$; largest: $989$.",
          "worked": "$$\\begin{align*}23\\times4&=92\\\\23\\times5&=115\\\\23\\times43&=989\\\\23\\times44&=1012\\end{align*}$$\nThe three-digit multiples therefore run from $115$ to $989$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p27-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "multiples of both 9 and 23?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Smallest: $207$; largest: $828$.\n\nUse multiples of the LCM, $207$.",
          "worked": "Multiples of $23$ begin $23,46,69,92,115,138,161,184,207$. The first divisible by $9$ is $207$, whose digit sum is $9$. Thus the LCM is $207$.\n$$\\begin{align*}207\\times1&=207\\\\207\\times4&=828\\\\207\\times5&=1035\\end{align*}$$\nThe smallest three-digit common multiple is $207$ and the largest is $828$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
