  "content": {
    "id": "p67-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Prove that every square number divided by 4 leaves a remainder of 1 or 0.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "For an integer $n$, $(2n)^2=4n^2$ has remainder 0, while $(2n+1)^2=4(n^2+n)+1$ has remainder 1. Every integer is even or odd, so these are the only possible remainders.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p67-q8-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Every integer is either even ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(2n)",
                "display": false
              },
              {
                "type": "text",
                "text": " or odd ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(2n+1)",
                "display": false
              },
              {
                "type": "text",
                "text": ", for an integer ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p67-q8-answer-even",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "(2n)^2=4n^2",
                "display": false
              },
              {
                "type": "text",
                "text": ", remainder 0.",
                "marks": []
              }
            ]
          },
          {
            "id": "p67-q8-answer-odd",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "(2n+1)^2=4n^2+4n+1",
                "display": false
              },
              {
                "type": "text",
                "text": ", remainder 1, since ",
