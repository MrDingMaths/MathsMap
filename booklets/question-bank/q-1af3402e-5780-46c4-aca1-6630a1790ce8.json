        "answer": {
          "short": "$3x^{2}-5x-2>0$",
          "worked": "$$\\begin{align*}3x^{2}&>5x+2\\\\3x^{2}-5x-2&>0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-1e331-p64-practice-82a85b58-j3-20261111-82a85b58-j3-b",
        "type": "part",
        "label": "b",
        "prompt": "Factorise $3x^{2}-5x-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+1)(x-2)$",
          "worked": "$$\\begin{align*}3x^{2}-5x-2&=3x^{2}-6x+x-2\\\\&=3x(x-2)+(x-2)\\\\&=(3x+1)(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
