      {
        "id": "index-t1-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^{x} \\times 3^{x} = 3^{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "Combine matching bases, then equate the indices.\n\n$$\\begin{align*}3^{x+x}&=3^{10} \\\\ 2x&=10 \\\\ x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t1-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^{x + 1} \\times 5^{2x} = 5^{13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "Combine matching bases, then equate the indices.\n\n$$\\begin{align*}5^{x+1+2x}&=5^{13} \\\\ 3x+1&=13 \\\\ 3x&=12 \\\\ x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t1-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$a^{x} \\times a^{4x} \\times a^{2} = a^{32}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6$",
          "worked": "Combine matching bases, then equate the indices.\n\n$$\\begin{align*}a^{x+4x+2}&=a^{32} \\\\ 5x+2&=32 \\\\ 5x&=30 \\\\ x&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t1-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$7^{x - 5} \\times 49 = 7^{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=9$",
          "worked": "Combine matching bases, then equate the indices.\n\n$$\\begin{align*}7^{x-5}\\times7^2&=7^6 \\\\ x-5+2&=6 \\\\ x&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t1-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$m^{2x} \\times m^{x - 2} = m^{x} \\times m^{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "Combine matching bases, then equate the indices.\n\n$$\\begin{align*}m^{2x+x-2}&=m^{x+4} \\\\ 3x-2&=x+4 \\\\ 2x&=6 \\\\ x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
