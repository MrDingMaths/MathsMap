  "content": {
    "id": "p24-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Three friends are seated around a circular table. Later, three more friends arrive and sit with them. How many seating arrangements are possible if all six friends may rearrange their seats?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5!=120$",
      "worked": "There are six distinct friends in the final unrestricted circular arrangement. The arrival time does not change the count.\n\n$$N=(6-1)!=5!=120.$$",
      "solutionDiagrams": []
    },
