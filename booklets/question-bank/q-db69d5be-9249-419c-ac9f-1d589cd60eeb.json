  "content": {
    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "In triangles $PQR$ and $XYZ$, $\\angle P=\\angle Z$ and $PQ\\times YZ=PR\\times XZ$. Name the other pairs of equal angles in the triangles.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\angle Q=\\angle X$ and $\\angle R=\\angle Y$.",
      "worked": "The given product equality gives\n\n$$\\frac{PQ}{XZ}=\\frac{PR}{YZ}.$$\n\nAlso $\\angle QPR=\\angle XZY$ (given), so $\\triangle PQR\\sim\\triangle ZXY$ (SAS).\n\nHence $\\angle Q=\\angle X$ and $\\angle R=\\angle Y$ (matching angles of similar triangles).",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
