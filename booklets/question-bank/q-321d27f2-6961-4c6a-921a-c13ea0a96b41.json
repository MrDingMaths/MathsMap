  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Simplify, expressing the answer with positive indices.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt[3]{8a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a^{\\frac23}$",
          "worked": "$$\\begin{align*}\\sqrt[3]{8a^2}&=(8a^2)^{\\frac13}\\\\\\sqrt[3]{8a^2}&=8^{\\frac13}a^{\\frac23}\\\\\\sqrt[3]{8a^2}&=2a^{\\frac23}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt[5]{32a^5b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2ab^{\\frac15}$",
          "worked": "$$\\begin{align*}\\sqrt[5]{32a^5b}&=(32a^5b)^{\\frac15}\\\\\\sqrt[5]{32a^5b}&=32^{\\frac15}a^{5\\times\\frac15}b^{\\frac15}\\\\\\sqrt[5]{32a^5b}&=2ab^{\\frac15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[4]{16a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a^{\\frac12}$",
          "worked": "$$\\begin{align*}\\sqrt[4]{16a^2}&=(16a^2)^{\\frac14}\\\\\\sqrt[4]{16a^2}&=16^{\\frac14}a^{\\frac24}\\\\\\sqrt[4]{16a^2}&=2a^{\\frac12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[3]{5x^5}\\times\\sqrt[3]{25x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x^{\\frac83}$",
          "worked": "$$\\begin{align*}\\sqrt[3]{5x^5}\\times\\sqrt[3]{25x^3}&=5^{\\frac13}x^{\\frac53}\\times25^{\\frac13}x\\\\\\sqrt[3]{5x^5}\\times\\sqrt[3]{25x^3}&=125^{\\frac13}x^{\\frac53+1}\\\\\\sqrt[3]{5x^5}\\times\\sqrt[3]{25x^3}&=5x^{\\frac83}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x^{\\frac32}\\times2x^{\\frac52}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^4$",
          "worked": "$$\\begin{align*}3x^{\\frac32}\\times2x^{\\frac52}&=6x^{\\frac32+\\frac52}\\\\3x^{\\frac32}\\times2x^{\\frac52}&=6x^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$(32a^{10}b^5)^{\\frac25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^4b^2$",
          "worked": "$$\\begin{align*}(32a^{10}b^5)^{\\frac25}&=32^{\\frac25}a^{10\\times\\frac25}b^{5\\times\\frac25}\\\\(32a^{10}b^5)^{\\frac25}&=(32^{\\frac15})^2a^4b^2\\\\(32a^{10}b^5)^{\\frac25}&=4a^4b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{(12x^3y^5)^{\\frac23}}{(4y)^{\\frac13}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6^{\\frac23}x^2y^3$",
          "worked": "$$\\begin{align*}\\frac{(12x^3y^5)^{\\frac23}}{(4y)^{\\frac13}}&=\\frac{12^{\\frac23}x^2y^{\\frac{10}3}}{4^{\\frac13}y^{\\frac13}}\\\\\\frac{(12x^3y^5)^{\\frac23}}{(4y)^{\\frac13}}&=\\left(\\frac{12^2}{4}\\right)^{\\frac13}x^2y^{\\frac{10}3-\\frac13}\\\\\\frac{(12x^3y^5)^{\\frac23}}{(4y)^{\\frac13}}&=36^{\\frac13}x^2y^3\\\\\\frac{(12x^3y^5)^{\\frac23}}{(4y)^{\\frac13}}&=6^{\\frac23}x^2y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p15-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$6a^{\\frac32}b^{\\frac13}\\times2a^{\\frac12}b^{\\frac53}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12a^2b^2$",
          "worked": "$$\\begin{align*}6a^{\\frac32}b^{\\frac13}\\times2a^{\\frac12}b^{\\frac53}&=12a^{\\frac32+\\frac12}b^{\\frac13+\\frac53}\\\\6a^{\\frac32}b^{\\frac13}\\times2a^{\\frac12}b^{\\frac53}&=12a^2b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
