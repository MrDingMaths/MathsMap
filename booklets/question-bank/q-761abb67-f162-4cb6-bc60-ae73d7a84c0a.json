  "content": {
    "id": "p27-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The sum of the first 10 terms of an AP is zero, and the 10th term is $-9$.\n\nFind the first and second terms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "First term: $9$; second term: $7$.",
      "worked": "Given $S_{10}=0$ and $a_{10}=-9$,\n$$\\begin{align*}S_{10}&=\\frac{10}{2}(a_1+a_{10})\\\\0&=5(a_1-9)\\\\a_1&=9.\\end{align*}$$\n$$\\begin{align*}a_{10}&=a_1+9d\\\\-9&=9+9d\\\\-18&=9d\\\\d&=-2.\\end{align*}$$\n$$\\begin{align*}a_2&=a_1+d\\\\a_2&=9-2\\\\a_2&=7.\\end{align*}$$\nThe first and second terms are $9$ and $7$.",
      "solutionDiagrams": []
    },
