                  "text": "On which day will his bank balance become positive?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "14th day.",
          "worked": "Balances in dollars.\n\nAfter 13 days:\n$$\\begin{align*}-120+13\\times9&=-120+117\\\\-120+13\\times9&=-117+117-3\\\\-120+13\\times9&=-3\\end{align*}$$\nAfter 14 days:\n$$\\begin{align*}-120+14\\times9&=-120+126\\\\-120+14\\times9&=-120+120+6\\\\-120+14\\times9&=6\\end{align*}$$\nThe balance increases each day. It is negative on day 13 and positive on day 14, so it first becomes positive on the 14th day.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p62-q14-b",
        "type": "part",
        "label": "b",
        "prompt": {
