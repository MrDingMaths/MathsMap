                  "inlines": [
                    {
                      "type": "math",
                      "latex": "\\begin{aligned}2^{-t}&=\\frac15\\\\\\ln(2^{-t})&=\\ln\\left(\\frac15\\right)\\\\-t\\ln(2)&=\\ln\\left(\\frac15\\right)\\\\\\therefore t&=-\\frac{\\ln\\left(\\frac15\\right)}{\\ln(2)}\\end{aligned}",
                      "display": true
                    }
                  ]
                }
