  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Arrange these fractions in ascending order:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2}{9},\\ \\frac{5}{18},\\ \\frac{1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{9}<\\frac{1}{4}<\\frac{5}{18}$",
          "worked": "The lowest common denominator is $36$.\n$$\\begin{align*}\\frac{2}{9}&=\\frac{8}{36}\\\\\\frac{5}{18}&=\\frac{10}{36}\\\\\\frac{1}{4}&=\\frac{9}{36}\\end{align*}$$\nSince $8<9<10$,\n$$\\frac{2}{9}<\\frac{1}{4}<\\frac{5}{18}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{7}{15},\\ \\frac{9}{20},\\ \\frac{5}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{12}<\\frac{9}{20}<\\frac{7}{15}$",
          "worked": "The lowest common denominator is $60$.\n$$\\begin{align*}\\frac{7}{15}&=\\frac{28}{60}\\\\\\frac{9}{20}&=\\frac{27}{60}\\\\\\frac{5}{12}&=\\frac{25}{60}\\end{align*}$$\nSince $25<27<28$,\n$$\\frac{5}{12}<\\frac{9}{20}<\\frac{7}{15}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p16-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{13}{48},\\ \\frac{21}{80},\\ \\frac{4}{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{80}<\\frac{4}{15}<\\frac{13}{48}$",
          "worked": "The lowest common denominator is $240$.\n$$\\begin{align*}\\frac{13}{48}&=\\frac{65}{240}\\\\\\frac{21}{80}&=\\frac{63}{240}\\\\\\frac{4}{15}&=\\frac{64}{240}\\end{align*}$$\nSince $63<64<65$,\n$$\\frac{21}{80}<\\frac{4}{15}<\\frac{13}{48}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p16-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5}{12},\\ \\frac{7}{18},\\ \\frac{9}{20},\\ \\frac{13}{30}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{18}<\\frac{5}{12}<\\frac{13}{30}<\\frac{9}{20}$",
          "worked": "The lowest common denominator is $180$.\n$$\\begin{align*}\\frac{5}{12}&=\\frac{75}{180}\\\\\\frac{7}{18}&=\\frac{70}{180}\\\\\\frac{9}{20}&=\\frac{81}{180}\\\\\\frac{13}{30}&=\\frac{78}{180}\\end{align*}$$\nSince $70<75<78<81$,\n$$\\frac{7}{18}<\\frac{5}{12}<\\frac{13}{30}<\\frac{9}{20}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      }
    ]
  },
