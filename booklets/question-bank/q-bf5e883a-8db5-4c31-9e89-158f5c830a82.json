        "answer": {
          "short": "$x=\\frac{49}{50}$",
          "worked": "$$\\begin{align*}\\frac{3(6x-5)}{12}-\\frac{4(7-8x)}{12}&=\\frac{6}{12}\\\\\\frac{18x-15-28+32x}{12}&=\\frac{6}{12}\\\\\\frac{50x-43}{12}&=\\frac{6}{12}\\\\50x-43&=6\\\\50x&=49\\\\x&=\\frac{49}{50}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
