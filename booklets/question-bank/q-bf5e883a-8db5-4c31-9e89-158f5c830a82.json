                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{75}{14}$",
          "worked": "$$\\begin{align*}\\frac{4(a-10)}{20}-\\frac{5(5-2a)}{20}&=\\frac{10}{20}\\\\\\frac{4a-40-25+10a}{20}&=\\frac{10}{20}\\\\\\frac{14a-65}{20}&=\\frac{10}{20}\\\\14a-65&=10\\\\14a&=75\\\\a&=\\frac{75}{14}\\end{align*}$$",
          "solutionDiagrams": []
