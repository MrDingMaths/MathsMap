  "content": {
    "id": "p16-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "The quadrilateral $ABCD$ has vertices $A(-3,-6)$, $B(1,-4)$, $C(-2,2)$ and $D(-6,0)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\overrightarrow{AB}=\\overrightarrow{DC}$ and $\\overrightarrow{AD}=\\overrightarrow{BC}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AB}=\\overrightarrow{DC}=(4,2)$ and $\\overrightarrow{AD}=\\overrightarrow{BC}=(-3,6)$.",
          "worked": "$$\\begin{align*}\\overrightarrow{AB}&=\\overrightarrow{OB}-\\overrightarrow{OA}\\\\\\overrightarrow{AB}&=(1-(-3),-4-(-6))\\\\\\overrightarrow{AB}&=(4,2)\\\\\\overrightarrow{DC}&=(-2-(-6),2-0)\\\\\\overrightarrow{DC}&=(4,2).\\end{align*}$$\n\nThus $\\overrightarrow{AB}=\\overrightarrow{DC}$. Similarly,\n\n$$\\begin{align*}\\overrightarrow{AD}&=(-6-(-3),0-(-6))=(-3,6),\\\\\\overrightarrow{BC}&=(-2-1,2-(-4))=(-3,6).\\end{align*}$$\n\nThus $\\overrightarrow{AD}=\\overrightarrow{BC}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\overrightarrow{AB}\\cdot\\overrightarrow{AD}=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AB}\\cdot\\overrightarrow{AD}=4(-3)+2(6)=0$.",
          "worked": "$$\\begin{align*}\\overrightarrow{AB}\\cdot\\overrightarrow{AD}&=4(-3)+2(6)\\\\\\overrightarrow{AB}\\cdot\\overrightarrow{AD}&=-12+12\\\\\\overrightarrow{AB}\\cdot\\overrightarrow{AD}&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "What type of special quadrilateral is $ABCD$? Give reasons for your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rectangle: opposite sides are equal and parallel, and adjacent sides are perpendicular. It is not a square because adjacent sides have different lengths.",
          "worked": "Part a shows that both pairs of opposite sides are equal and parallel, so $ABCD$ is a parallelogram. Part b shows that its adjacent sides $AB$ and $AD$ are perpendicular, so it is a rectangle. Also, $|\\overrightarrow{AB}|=\\sqrt{20}$ and $|\\overrightarrow{AD}|=\\sqrt{45}$ are unequal, so it is not a square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
