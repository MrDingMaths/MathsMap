    "id": "p36-q34-root",
    "type": "question",
    "label": "34",
    "prompt": "A frog jumps $0.5$ metres. On each subsequent jump it travels $0.2$ of the previous distance.\nFind the total distance through which the frog jumps.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.625\\text{ m}$",
      "worked": "$a=0.5$\n\n$r=0.2$\n$$\\begin{aligned}S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{0.5}{1-0.2}\\\\S_\\infty&=\\frac{0.5}{0.8}\\\\S_\\infty&=0.625\\text{ m}\\end{aligned}$$",
      "solutionDiagrams": []
    },
