  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Suppose $a>0$. Solve:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$ax+b>c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\dfrac{c-b}{a}$",
          "worked": "$$\\begin{align*}ax+b&>c\\\\ax&>c-b\\\\x&>\\frac{c-b}{a}\\end{align*}$$\nSince $a>0$, dividing by $a$ preserves the inequality direction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$b-ax\\le c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge\\dfrac{b-c}{a}$",
          "worked": "$$\\begin{align*}b-ax&\\le c\\\\-ax&\\le c-b\\\\x&\\ge\\frac{c-b}{-a}\\\\x&\\ge\\frac{b-c}{a}\\end{align*}$$\nSince $-a<0$, dividing by $-a$ reverses the inequality direction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p11-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$a(x+b)\\ge c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge\\dfrac{c}{a}-b$",
          "worked": "$$\\begin{align*}a(x+b)&\\ge c\\\\x+b&\\ge\\frac{c}{a}\\\\x&\\ge\\frac{c}{a}-b\\end{align*}$$\nSince $a>0$, dividing by $a$ preserves the inequality direction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p11-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$a(b-x)<c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>b-\\dfrac{c}{a}$",
          "worked": "$$\\begin{align*}a(b-x)&<c\\\\b-x&<\\frac{c}{a}\\\\-x&<\\frac{c}{a}-b\\\\x&>b-\\frac{c}{a}\\end{align*}$$\nDividing by positive $a$ preserves the direction; multiplying by $-1$ reverses it.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
