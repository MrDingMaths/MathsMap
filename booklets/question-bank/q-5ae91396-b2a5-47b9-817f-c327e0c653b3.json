  "content": {
    "id": "v2-1479f-p27-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "A circle has diameter $AB$, where $A=(-3,2)$ and $B=(5,8)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1479f-p27-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the centre of the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,5)$",
          "worked": "The centre is the midpoint of the diameter.\n$$\\begin{align*}\\text{Centre}&=\\left(\\frac{-3+5}{2},\\frac{2+8}{2}\\right)\\\\&=(1,5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-1479f-p27-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the radius of the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "The radius is the distance from the centre $(1,5)$ to $B(5,8)$. Using Pythagoras,\n$$\\begin{align*}r^2&=(5-1)^2+(8-5)^2\\\\&=16+9\\\\&=25\\\\r&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
