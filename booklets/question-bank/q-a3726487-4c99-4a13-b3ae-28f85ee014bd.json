    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{5\\sqrt{3}}{3}$",
      "worked": "$$\\begin{align*}\\frac{5}{\\sqrt{3}}&=\\frac{5}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\frac{5}{\\sqrt{3}}&=\\frac{5\\sqrt{3}}{3}\\end{align*}$$",
