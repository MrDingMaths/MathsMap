  "content": {
    "id": "p9-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Nami is a hairdresser who earns \\$24.20 per hour. She works an 8-hour day.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How much does Nami earn per day?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$193.60",
          "worked": "$$\\begin{align*}\\text{Daily pay}&=\\$24.20\\times8\\\\\\text{Daily pay}&=\\$193.60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How much does Nami earn per week? She works 5 days a week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$968",
          "worked": "$$\\begin{align*}\\text{Weekly pay}&=\\$193.60\\times5\\\\\\text{Weekly pay}&=\\$968\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "How much does Nami earn per fortnight?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1936",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay}&=\\$968\\times2\\\\\\text{Fortnightly pay}&=\\$1936\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "How much does Nami earn per year? There are 52 weeks in the year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$50 336",
          "worked": "$$\\begin{align*}\\text{Annual pay}&=\\$968\\times52\\\\\\text{Annual pay}&=\\$50\\,336\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
