  "content": {
    "id": "p25-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Given that $V = \\frac{r}{\\sqrt{h}}$, find the value of $r$ in scientific notation when $V = 5 \\times 10^4$ and $h = 9 \\times 10^6$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1.5 \\times 10^8$",
      "worked": "$$\\begin{align*}r &= V\\sqrt{h}\\\\r &= (5 \\times 10^4)\\sqrt{9 \\times 10^6}\\\\r &= (5 \\times 10^4)(3 \\times 10^3)\\\\r &= 1.5 \\times 10^8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
