          {
            "id": "p52-q3-a",
            "type": "part",
            "label": "a",
            "prompt": "Differentiate using the chain rule by treating the expression as $y=(3x-2)^{-1}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y'=-\\dfrac{3}{(3x-2)^2}$",
              "worked": "$$\\begin{align*}y'&=-(3x-2)^{-2}(3)\\\\y'&=-\\frac{3}{(3x-2)^2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p52-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "Differentiate using the quotient rule with $u=1$ and $v=3x-2$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y'=-\\dfrac{3}{(3x-2)^2}$",
              "worked": "$u'=0$, $v'=3$.\n$$\\begin{align*}y'&=\\frac{0(3x-2)-1(3)}{(3x-2)^2}\\\\y'&=-\\frac{3}{(3x-2)^2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          }
        ]
      },
      {
        "id": "p52-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Which method is easier?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The chain rule in part a.",
          "worked": "The chain rule in part a is easier because it requires fewer calculations.",
