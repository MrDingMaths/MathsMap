        "label": "a",
        "prompt": "$\\sqrt{3^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\sqrt{3^2}&=\\sqrt{9}\\\\\\sqrt{3^2}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{4^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\sqrt{4^2}&=\\sqrt{16}\\\\\\sqrt{4^2}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q2-c",
