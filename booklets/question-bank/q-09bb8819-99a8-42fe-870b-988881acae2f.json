  "content": {
    "id": "p24-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "I can ride my bike three times as fast as Tania can jog. Tania starts jogging $40$ minutes before I start to chase her on my bike. How long does it take for me to catch Tania?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20$ minutes after I start cycling.",
      "worked": "Let Tania's speed be $v$ metres per minute and let $t$ minutes be the time spent cycling. When I catch her, our distances are equal; Tania has jogged for $t+40$ minutes.\n$$\\begin{align*}3vt&=v(t+40)\\\\3t&=t+40\\\\2t&=40\\\\t&=20\\end{align*}$$\nI catch Tania $20$ minutes after I start cycling.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
