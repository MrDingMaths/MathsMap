  "content": {
    "id": "p47-cc-1-6",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p47-cc-1-6-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "True or False?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-cc-1",
        "type": "part",
        "label": "a",
        "prompt": "Tangents can only intersect the curve once.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. A tangent can meet the curve again.",
          "worked": "False. Tangency describes the line at one point; it does not rule out another intersection with the curve.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p47-cc-2",
        "type": "part",
        "label": "b",
        "prompt": "The normal is always steeper than the tangent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. A steep tangent has a shallower normal.",
          "worked": "False. For example, a tangent with gradient $2$ has a normal with gradient $-\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p47-cc-3",
        "type": "part",
        "label": "c",
        "prompt": "The tangent to $y=x^2$ has gradient $2$ when $x=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. $\\frac{dy}{dx}=2x$, so the tangent gradient at $x=1$ is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p47-cc-4",
        "type": "part",
        "label": "d",
        "prompt": "The tangent to $y=\\sqrt{x^4}$ is horizontal when $x=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Since $\\sqrt{x^4}=x^2$, its derivative is $2x$, which is $0$ at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p47-cc-5",
        "type": "part",
        "label": "e",
        "prompt": "The gradient of the tangent and normal are reciprocals.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. Where both gradients are defined, they are negative reciprocals.",
          "worked": "False. For non-zero finite gradients, $m_Tm_N=-1$, so $m_N=-\\frac{1}{m_T}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p47-cc-6",
        "type": "part",
        "label": "f",
        "prompt": "The normal to a curve at a point is perpendicular to the tangent at the point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. This is the definition of the normal at a point on a curve.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
