  "content": {
    "id": "p27-q25-content",
    "type": "question",
    "label": "25",
    "prompt": "Let $f(x)=(x^2+2x+1)\\sqrt{x+1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(x)=(x+1)^{\\frac52}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p27-q25-a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "f(x)=(x+1)^{\\frac52}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p27-q25-a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Factor ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x^2+2x+1=(x+1)^2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", then add the indices.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}x^2+2x+1&=(x+1)^2\\\\f(x)&=(x+1)^2(x+1)^{\\frac12}\\\\f(x)&=(x+1)^{\\frac52}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p27-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=\\dfrac52(x+1)^{\\frac32}$",
          "worked": "$$\\begin{align*}f'(x)&=\\frac52(x+1)^{\\frac32}\\times 1\\\\f'(x)&=\\frac52(x+1)^{\\frac32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
