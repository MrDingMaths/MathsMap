    "id": "v2-91d46e-p8-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Evaluate $\\tan\\left(\\cos^{-1}\\left(-\\frac{1}{\\sqrt2}\\right)\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-1$",
      "worked": "$$\\begin{aligned}\\cos^{-1}\\left(-\\frac1{\\sqrt2}\\right)&=\\frac{3\\pi}{4}\\\\\\tan\\left(\\cos^{-1}\\left(-\\frac1{\\sqrt2}\\right)\\right)&=\\tan\\left(\\frac{3\\pi}{4}\\right)\\\\&=-\\tan\\left(\\frac{\\pi}{4}\\right)\\\\&=-1\\end{aligned}$$",
      "solutionDiagrams": []
    },
