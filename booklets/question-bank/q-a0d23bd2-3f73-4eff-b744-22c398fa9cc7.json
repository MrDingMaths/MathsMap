  "content": {
    "id": "p12-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Rearrange each of these formulas to make the pronumeral in brackets the subject.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=mx+c\\qquad(c)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=y-mx$",
          "worked": "$$\\begin{align*}y-mx&=c\\\\c&=y-mx\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=mx+c\\qquad(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{y-c}{m}$",
          "worked": "$$\\begin{align*}y-c&=mx\\\\x&=\\frac{y-c}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$A=\\frac12 bh\\qquad(b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\frac{2A}{h}$",
          "worked": "$$\\begin{align*}2A&=bh\\\\b&=\\frac{2A}{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$C=2\\pi r\\qquad(r)$",
