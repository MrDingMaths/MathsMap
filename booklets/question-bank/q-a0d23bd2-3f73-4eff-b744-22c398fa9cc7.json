        "children": [],
        "answer": {
          "short": "$h=\\frac{3V}{\\pi r^2}$",
          "worked": "$$\\begin{align*}3V&=\\pi r^2h\\\\h&=\\frac{3V}{\\pi r^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$s=\\frac n2(a+\\ell)\\qquad(a)$",
        "layout": "list",
