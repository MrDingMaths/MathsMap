          "short": "$r=\\frac{C}{2\\pi}$",
          "worked": "$$\\begin{align*}\\frac{C}{2\\pi}&=r\\\\r&=\\frac{C}{2\\pi}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p12-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$P=A+2\\ell h\\qquad(\\ell)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ell=\\frac{P-A}{2h}$",
          "worked": "$$\\begin{align*}P-A&=2\\ell h\\\\\\ell&=\\frac{P-A}{2h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$s=ut+\\frac12 at^2\\qquad(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{2(s-ut)}{t^2}$",
          "worked": "$$\\begin{align*}s-ut&=\\frac12 at^2\\\\2(s-ut)&=at^2\\\\a&=\\frac{2(s-ut)}{t^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$A=2\\pi r^2+2\\pi rh\\qquad(h)$",
