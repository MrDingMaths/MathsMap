        "answer": {
          "short": "$h=\\frac{A-2\\pi r^2}{2\\pi r}$",
          "worked": "$$\\begin{align*}A-2\\pi r^2&=2\\pi rh\\\\h&=\\frac{A-2\\pi r^2}{2\\pi r}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$V=\\frac13\\pi r^2h\\qquad(h)$",
        "layout": "list",
