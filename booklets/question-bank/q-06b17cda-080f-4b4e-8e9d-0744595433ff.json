    "children": [
      {
        "id": "p32-q1a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $$\\frac12\\left(\\frac1n-\\frac1{n+2}\\right).$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{n(n+2)}$",
          "worked": "$$\\begin{align*}\\frac12\\left(\\frac1n-\\frac1{n+2}\\right)&=\\frac12\\left(\\frac{n+2-n}{n(n+2)}\\right)\\\\\\frac12\\left(\\frac1n-\\frac1{n+2}\\right)&=\\frac1{n(n+2)}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p32-q1b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, evaluate $$\\frac1{1\\times3}+\\frac1{3\\times5}+\\cdots+\\frac1{97\\times99}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{49}{99}$\n\nRewrite each term using part (a); the intermediate reciprocals cancel.",
          "worked": "Using part (a), write each term as a difference of reciprocals. Let $S$ denote the required sum.\n\n$$\\begin{align*}S&=\\frac12\\left(1-\\frac13\\right)+\\frac12\\left(\\frac13-\\frac15\\right)+\\cdots+\\frac12\\left(\\frac1{97}-\\frac1{99}\\right)\\\\S&=\\frac12\\left(1-\\frac1{99}\\right)\\\\S&=\\frac12\\times\\frac{98}{99}\\\\S&=\\frac{49}{99}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
