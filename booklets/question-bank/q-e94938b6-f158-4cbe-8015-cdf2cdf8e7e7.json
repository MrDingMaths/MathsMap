  "content": {
    "id": "p28-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "The sum of the 1st and 4th terms of an AP is 16, and the sum of the third and eighth terms is 4. Find the sum of the first 10 terms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20$",
      "worked": "$$\\begin{align*}a_1+a_4&=16\\qquad(1)\\\\a_3+a_8&=4\\qquad(2)\\\\a_1+(a_1+3d)&=16\\\\2a_1+3d&=16\\qquad(3)\\\\(a_1+2d)+(a_1+7d)&=4\\\\2a_1+9d&=4\\qquad(4)\\end{align*}$$\n\nSubtract (3) from (4):\n\n$$\\begin{align*}6d&=-12\\\\d&=-2\\end{align*}$$\n\nSubstitute into (3):\n\n$$\\begin{align*}2a_1+3(-2)&=16\\\\2a_1&=22\\\\a_1&=11\\end{align*}$$\n\n$$\\begin{align*}S_{10}&=\\frac{10}{2}\\bigl(2(11)+9(-2)\\bigr)\\\\S_{10}&=20\\end{align*}$$",
      "solutionDiagrams": []
    },
