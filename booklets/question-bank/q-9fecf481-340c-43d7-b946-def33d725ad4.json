  "content": {
    "id": "p14-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2+5x+6}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$",
          "worked": "$$\\begin{align*}\\frac{x^2+5x+6}{x+2}&=\\frac{(x+2)(x+3)}{x+2}\\\\&=x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x+3}{x^2+5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{x^2+5x+6}&=\\frac{x+3}{(x+2)(x+3)}\\\\&=\\frac{1}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2+5x+6}{x^2+7x+12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{x+4}$",
          "worked": "$$\\begin{align*}\\frac{x^2+5x+6}{x^2+7x+12}&=\\frac{(x+2)(x+3)}{(x+3)(x+4)}\\\\&=\\frac{x+2}{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x^2+7x+12}{x^2+5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+4}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{x^2+7x+12}{x^2+5x+6}&=\\frac{(x+3)(x+4)}{(x+2)(x+3)}\\\\&=\\frac{x+4}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
