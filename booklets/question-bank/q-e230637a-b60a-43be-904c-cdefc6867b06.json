            "blocks": [
              {
                "id": "p22-q5-worked-history-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For History, 30 is the upper quartile ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "Q_3",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so 25% of students scored above 30.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p22-q5-worked-history-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\text{History students above }30&=0.25\\times112\\\\\\text{History students above }30&=28\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p22-q5-worked-geography-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The same number, 28, scored above 30 in Geography. For Geography, 30 is the median ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "Q_2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so these students represent 50% of the total.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p22-q5-worked-geography-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}50\\%\\text{ of Geography students}&=28\\\\\\text{Total Geography students}&=28\\times2\\\\\\text{Total Geography students}&=56\\end{aligned}",
                    "display": true
                  }
                ]
              },
