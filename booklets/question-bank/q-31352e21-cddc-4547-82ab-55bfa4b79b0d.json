  "content": {
    "id": "p28-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{a^2+2ab+b^2}{a(a+b)}\\div\\frac{a^2-b^2}{a^2-2ab+b^2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a-b}{a}$",
          "worked": "$$\\begin{align*}\\frac{a^2+2ab+b^2}{a(a+b)}\\div\\frac{a^2-b^2}{a^2-2ab+b^2}&=\\frac{(a+b)^2}{a(a+b)}\\times\\frac{(a-b)^2}{(a-b)(a+b)}\\\\&=\\frac{a+b}{a}\\times\\frac{a-b}{a+b}\\\\&=\\frac{a-b}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p28-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{a^2-2ab+b^2}{a^2-b^2}\\div\\frac{a^2-b^2}{a^2+2ab+b^2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{a^2-2ab+b^2}{a^2-b^2}\\div\\frac{a^2-b^2}{a^2+2ab+b^2}&=\\frac{(a-b)^2}{(a-b)(a+b)}\\times\\frac{(a+b)^2}{(a-b)(a+b)}\\\\&=\\frac{a-b}{a+b}\\times\\frac{a+b}{a-b}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p28-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{a^2-b^2}{a^2-2ab+b^2}\\div\\frac{a^2-b^2}{a^2+2ab+b^2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(a+b)^2}{(a-b)^2}$",
          "worked": "$$\\begin{align*}\\frac{a^2-b^2}{a^2-2ab+b^2}\\div\\frac{a^2-b^2}{a^2+2ab+b^2}&=\\frac{(a-b)(a+b)}{(a-b)^2}\\times\\frac{(a+b)^2}{(a-b)(a+b)}\\\\&=\\frac{a+b}{a-b}\\times\\frac{a+b}{a-b}\\\\&=\\frac{(a+b)^2}{(a-b)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p28-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{a^2+2ab+b^2}{a(a+b)}\\div\\frac{a(a-b)}{a^2-2ab+b^2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(a+b)(a-b)}{a^2}$",
          "worked": "$$\\begin{align*}\\frac{a^2+2ab+b^2}{a(a+b)}\\div\\frac{a(a-b)}{a^2-2ab+b^2}&=\\frac{(a+b)^2}{a(a+b)}\\times\\frac{(a-b)^2}{a(a-b)}\\\\&=\\frac{a+b}{a}\\times\\frac{a-b}{a}\\\\&=\\frac{(a+b)(a-b)}{a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
