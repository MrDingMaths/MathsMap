  "content": {
    "id": "p21-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Michael and Sonia stand some distance apart. Michael runs towards Sonia at a speed of 5 metres per second and Sonia runs towards Michael at a speed of 6 metres per second. It takes them 20 seconds to meet.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "How far apart did Michael and Sonia stand?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$220\\text{ m}$",
          "worked": "Their relative speed is the sum of their speeds.\n$$\\begin{align*}s_{\\text{relative}} &= 5+6 = 11\\text{ m/s}\\\\d &= st\\\\d &= 11\\times20\\\\d &= 220\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p21-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "How far did Sonia run?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120\\text{ m}$",
          "worked": "$$\\begin{align*}d_{\\text{Sonia}} &= st\\\\d_{\\text{Sonia}} &= 6\\times20\\\\d_{\\text{Sonia}} &= 120\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
