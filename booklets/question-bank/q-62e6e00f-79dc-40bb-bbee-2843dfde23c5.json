  "content": {
    "id": "p24-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "A bag contains 4 red marbles and 6 blue marbles. Three marbles are selected at random without replacement.\n\nWhat is the probability that at least one of the marbles selected is red?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{6}$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p24-q22-blue-definition",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let B denote selecting a blue marble. With no replacement, the numbers of blue marbles and total marbles decrease after each selection.",
                "marks": []
              }
            ]
          },
          {
            "id": "p24-q22-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}P(\\text{at least one red})&=1-P(\\text{no red})\\\\&=1-P(BBB)\\\\&=1-\\frac{6}{10}\\times\\frac{5}{9}\\times\\frac{4}{8}\\\\&=\\frac{5}{6}\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
