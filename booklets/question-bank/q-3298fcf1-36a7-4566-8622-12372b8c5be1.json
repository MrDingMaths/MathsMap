    "id": "v2-piecework-practice-slot-15-root",
    "type": "question",
    "label": null,
    "prompt": "Leila is paid \\$3.40 for each cushion cover she sews. If she sews 9 covers in 90 minutes, what is her hourly rate of pay?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$20.40/\\text{h}$",
      "worked": "$$\\begin{align*}\\text{Pay for 9 covers}&=\\$3.40\\times9\\\\&=\\$30.60\\\\\\text{Time}&=90\\text{ min}=1.5\\text{ h}\\\\\\text{Hourly rate}&=\\frac{\\$30.60}{1.5}\\\\&=\\$20.40/\\text{h}\\end{align*}$$",
      "solutionDiagrams": []
    },
