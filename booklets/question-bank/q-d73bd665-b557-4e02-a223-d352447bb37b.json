  "content": {
    "id": "p18-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Factorise each of the following expressions:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$6x^2+5x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(3x+1)$",
          "worked": "$$\\begin{align*}6x^2+5x+1&=6x^2+2x+3x+1\\\\6x^2+5x+1&=2x(3x+1)+(3x+1)\\\\6x^2+5x+1&=(2x+1)(3x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$12x^2+13x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+1)(4x+3)$",
          "worked": "$$\\begin{align*}12x^2+13x+3&=12x^2+9x+4x+3\\\\12x^2+13x+3&=3x(4x+3)+(4x+3)\\\\12x^2+13x+3&=(3x+1)(4x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$20x^2+23x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5x+2)(4x+3)$",
          "worked": "$$\\begin{align*}20x^2+23x+6&=20x^2+15x+8x+6\\\\20x^2+23x+6&=5x(4x+3)+2(4x+3)\\\\20x^2+23x+6&=(5x+2)(4x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$3x^2+x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(3x-2)$",
          "worked": "$$\\begin{align*}3x^2+x-2&=3x^2+3x-2x-2\\\\3x^2+x-2&=3x(x+1)-2(x+1)\\\\3x^2+x-2&=(x+1)(3x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x^2+2x-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(3x-4)$",
          "worked": "$$\\begin{align*}3x^2+2x-8&=3x^2+6x-4x-8\\\\3x^2+2x-8&=3x(x+2)-4(x+2)\\\\3x^2+2x-8&=(x+2)(3x-4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$10x^2+7x-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5x-4)(2x+3)$",
          "worked": "$$\\begin{align*}10x^2+7x-12&=10x^2+15x-8x-12\\\\10x^2+7x-12&=5x(2x+3)-4(2x+3)\\\\10x^2+7x-12&=(5x-4)(2x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$2x^2-11x+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-3)(x-4)$",
          "worked": "$$\\begin{align*}2x^2-11x+12&=2x^2-8x-3x+12\\\\2x^2-11x+12&=2x(x-4)-3(x-4)\\\\2x^2-11x+12&=(2x-3)(x-4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$6x^2-11x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(3x-4)$",
          "worked": "$$\\begin{align*}6x^2-11x+4&=6x^2-8x-3x+4\\\\6x^2-11x+4&=2x(3x-4)-(3x-4)\\\\6x^2-11x+4&=(2x-1)(3x-4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$12x^2-25x+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-4)(4x-3)$",
          "worked": "$$\\begin{align*}12x^2-25x+12&=12x^2-9x-16x+12\\\\12x^2-25x+12&=3x(4x-3)-4(4x-3)\\\\12x^2-25x+12&=(3x-4)(4x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$-x^2-x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+3)(x-2)$",
          "worked": "$$\\begin{align*}-x^2-x+6&=-(x^2+x-6)\\\\-x^2-x+6&=-(x+3)(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
