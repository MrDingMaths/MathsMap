  "content": {
    "id": "p5-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "In each case, state if the function is a polynomial. If so, write down its leading coefficient.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $2$.",
          "worked": "The powers of $x$ are non-negative integers, so this is a polynomial. The leading term is $2x$, so the leading coefficient is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=-x^3-4x^2+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $-1$.",
          "worked": "The powers of $x$ are non-negative integers, so this is a polynomial. The leading term is $-x^3$, so the leading coefficient is $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3x^2-x^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "The term $-x^{-1}$ has a negative exponent, so this is not a polynomial.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\sqrt{x}+x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Since $\\sqrt{x}=x^{\\frac{1}{2}}$, the expression contains a fractional exponent of $x$. It is not a polynomial.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=-\\frac{x^3}{6}-x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $-\\frac{1}{6}$.",
          "worked": "The powers of $x$ are non-negative integers, so this is a polynomial. The leading term is $-\\frac{1}{6}x^3$, so the leading coefficient is $-\\frac{1}{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p5-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\sqrt{x^2-9}+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "The expression $\\sqrt{x^2-9}$ cannot be written as a finite sum of terms with non-negative integer powers of $x$. Therefore, this is not a polynomial.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
