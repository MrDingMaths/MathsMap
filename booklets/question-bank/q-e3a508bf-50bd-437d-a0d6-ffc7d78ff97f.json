  "content": {
    "id": "p8-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{n-m}{m-n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$\\begin{align*}\\frac{n-m}{m-n}&=\\frac{-(m-n)}{m-n}\\\\\\frac{n-m}{m-n}&=-1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{k^2-k\\ell}{\\ell-k}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-k$",
          "worked": "$\\begin{align*}\\frac{k^2-k\\ell}{\\ell-k}&=\\frac{k(k-\\ell)}{-(k-\\ell)}\\\\\\frac{k^2-k\\ell}{\\ell-k}&=-k\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{6x^2+6xy}{y^2-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6x}{y-x}$",
          "worked": "$\\begin{align*}\\frac{6x^2+6xy}{y^2-x^2}&=\\frac{6x(x+y)}{(y-x)(y+x)}\\\\\\frac{6x^2+6xy}{y^2-x^2}&=\\frac{6x}{y-x}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{18k^2-8\\ell^2}{6k-4\\ell}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3k+2\\ell$",
          "worked": "$\\begin{align*}\\frac{18k^2-8\\ell^2}{6k-4\\ell}&=\\frac{2(9k^2-4\\ell^2)}{2(3k-2\\ell)}\\\\\\frac{18k^2-8\\ell^2}{6k-4\\ell}&=\\frac{(3k-2\\ell)(3k+2\\ell)}{3k-2\\ell}\\\\\\frac{18k^2-8\\ell^2}{6k-4\\ell}&=3k+2\\ell\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{12p^2-27q^2}{6p^2-9pq}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2p+3q}{p}$",
          "worked": "$\\begin{align*}\\frac{12p^2-27q^2}{6p^2-9pq}&=\\frac{3(4p^2-9q^2)}{3p(2p-3q)}\\\\\\frac{12p^2-27q^2}{6p^2-9pq}&=\\frac{(2p-3q)(2p+3q)}{p(2p-3q)}\\\\\\frac{12p^2-27q^2}{6p^2-9pq}&=\\frac{2p+3q}{p}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p8-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{pq}{p^2q^2+pq}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{pq+1}$",
          "worked": "$\\begin{align*}\\frac{pq}{p^2q^2+pq}&=\\frac{pq}{pq(pq+1)}\\\\\\frac{pq}{p^2q^2+pq}&=\\frac{1}{pq+1}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{m^2+mn}{n^2+nm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{m}{n}$",
          "worked": "$\\begin{align*}\\frac{m^2+mn}{n^2+nm}&=\\frac{m(m+n)}{n(n+m)}\\\\\\frac{m^2+mn}{n^2+nm}&=\\frac{m}{n}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{s^2-t^2}{t-s}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(s+t)$",
          "worked": "$\\begin{align*}\\frac{s^2-t^2}{t-s}&=\\frac{(s-t)(s+t)}{-(s-t)}\\\\\\frac{s^2-t^2}{t-s}&=-(s+t)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{3x-3y}{xy-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3}{x}$",
          "worked": "$\\begin{align*}\\frac{3x-3y}{xy-x^2}&=\\frac{3(x-y)}{-x(x-y)}\\\\\\frac{3x-3y}{xy-x^2}&=-\\frac{3}{x}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{3p^3-3pq^2}{p^2+pq}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(p-q)$",
          "worked": "$\\begin{align*}\\frac{3p^3-3pq^2}{p^2+pq}&=\\frac{3p(p^2-q^2)}{p(p+q)}\\\\\\frac{3p^3-3pq^2}{p^2+pq}&=\\frac{3p(p-q)(p+q)}{p(p+q)}\\\\\\frac{3p^3-3pq^2}{p^2+pq}&=3(p-q)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{x^3-xy^2}{2x+2y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x(x-y)}{2}$",
          "worked": "$\\begin{align*}\\frac{x^3-xy^2}{2x+2y}&=\\frac{x(x^2-y^2)}{2(x+y)}\\\\\\frac{x^3-xy^2}{2x+2y}&=\\frac{x(x-y)(x+y)}{2(x+y)}\\\\\\frac{x^3-xy^2}{2x+2y}&=\\frac{x(x-y)}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p8-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{m^3-m^2n}{n-m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-m^2$",
          "worked": "$\\begin{align*}\\frac{m^3-m^2n}{n-m}&=\\frac{m^2(m-n)}{-(m-n)}\\\\\\frac{m^3-m^2n}{n-m}&=-m^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
