  "content": {
    "id": "v2-8a2d627b5-practice-slot-2-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Determine where the function is discontinuous.\n$$f(x)=\\frac{7}{x^2+2x-8}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-4,2$",
      "worked": "$$\\begin{aligned}x^2+2x-8&=0\\\\(x+4)(x-2)&=0\\\\x&=-4,2\\end{aligned}$$\nThe function is undefined at these values, so it is discontinuous there.",
      "solutionDiagrams": []
    },
