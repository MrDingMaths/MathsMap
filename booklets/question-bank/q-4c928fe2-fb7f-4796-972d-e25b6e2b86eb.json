  "content": {
    "id": "p2-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the first four terms of these recursively defined sequences:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$a_1=3$ and $a_n=a_{n-1}+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3,5,7,9$",
          "worked": "$a_1=3$.\n$$\\begin{align*}a_2&=3+2=5\\\\a_3&=5+2=7\\\\a_4&=7+2=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$a_1=2$ and $a_n=3a_{n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2,6,18,54$",
          "worked": "$a_1=2$.\n$$\\begin{align*}a_2&=3\\times2=6\\\\a_3&=3\\times6=18\\\\a_4&=3\\times18=54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$a_1=4$ and $a_n=2a_{n-1}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4,11,25,53$",
          "worked": "$a_1=4$.\n$$\\begin{align*}a_2&=2\\times4+3=11\\\\a_3&=2\\times11+3=25\\\\a_4&=2\\times25+3=53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$a_1=1$, $a_2=1$ and $a_n=2a_{n-1}+a_{n-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,1,3,7$",
          "worked": "$a_1=1$ and $a_2=1$.\n$$\\begin{align*}a_3&=2\\times1+1=3\\\\a_4&=2\\times3+1=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$a_1=1$ and $a_n=na_{n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,2,6,24$",
          "worked": "$a_1=1$.\n$$\\begin{align*}a_2&=2\\times1=2\\\\a_3&=3\\times2=6\\\\a_4&=4\\times6=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$a_1=1$ and $a_n=a_{n-1}+n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,3,6,10$",
          "worked": "$a_1=1$.\n$$\\begin{align*}a_2&=1+2=3\\\\a_3&=3+3=6\\\\a_4&=6+4=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$a_1=1$, $a_2=2$ and $a_n=a_{n-1}a_{n-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,2,2,4$",
          "worked": "$a_1=1$ and $a_2=2$.\n$$\\begin{align*}a_3&=2\\times1=2\\\\a_4&=2\\times2=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$a_1=1$ and $a_n=\\dfrac{a_{n-1}}{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\dfrac12,\\dfrac16,\\dfrac1{24}$",
          "worked": "$a_1=1$.\n$$\\begin{align*}a_2&=\\frac12\\\\a_3&=\\frac{\\frac12}{3}=\\frac16\\\\a_4&=\\frac{\\frac16}{4}=\\frac1{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p2-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$a_1=1$ and $a_n=1+\\dfrac1{a_{n-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,2,\\dfrac32,\\dfrac53$",
          "worked": "$a_1=1$.\n$$\\begin{align*}a_2&=1+\\frac11=2\\\\a_3&=1+\\frac12=\\frac32\\\\a_4&=1+\\frac1{\\frac32}=1+\\frac23=\\frac53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
