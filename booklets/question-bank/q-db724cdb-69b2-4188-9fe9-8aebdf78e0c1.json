  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The average of 7 numbers is 12. An 8th number is added, and the average becomes 12.5. What number was added?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "16",
      "worked": "$$\\begin{align*}\\text{Original total}&=7\\times12=84\\\\\\text{New total}&=8\\times12.5=100\\\\\\text{Number added}&=100-84=16\\end{align*}$$",
      "solutionDiagrams": []
    },
