    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q11-response",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x^2-25}{x^2-5x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+5}{x}$, $x\\ne0,5$.",
          "worked": "$$\\begin{align*}\\frac{x^2-25}{x^2-5x}&=\\frac{(x-5)(x+5)}{x(x-5)}\\\\\\frac{x^2-25}{x^2-5x}&=\\frac{x+5}{x}\\end{align*}$$\nOriginal domain: $x\\ne0,5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q12-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3x^2+6x}{6x^2-3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+2}{2x-1}$, $x\\ne0,\\frac12$.",
          "worked": "$$\\begin{align*}\\frac{3x^2+6x}{6x^2-3x}&=\\frac{3x(x+2)}{3x(2x-1)}\\\\\\frac{3x^2+6x}{6x^2-3x}&=\\frac{x+2}{2x-1}\\end{align*}$$\nOriginal domain: $x\\ne0,\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q13-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{y^2-4}{2y-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y+2}{2}$, $y\\ne2$.",
          "worked": "$$\\begin{align*}\\frac{y^2-4}{2y-4}&=\\frac{(y-2)(y+2)}{2(y-2)}\\\\\\frac{y^2-4}{2y-4}&=\\frac{y+2}{2}\\end{align*}$$\nOriginal domain: $y\\ne2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q14-response",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{a^2-9a}{a(a-3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a-9}{a-3}$, $a\\ne0,3$.",
          "worked": "$$\\begin{align*}\\frac{a^2-9a}{a(a-3)}&=\\frac{a(a-9)}{a(a-3)}\\\\\\frac{a^2-9a}{a(a-3)}&=\\frac{a-9}{a-3}\\end{align*}$$\nOriginal domain: $a\\ne0,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
