  "content": {
    "id": "v2-3ab5c-p29-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Find the exact value of the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-3ab5c-p29-practice-slot-9-slot-9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos 180^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "On the unit circle, the point at $180^{\\circ}$ is $(-1,0)$.\n$$\\begin{align*}\\cos 180^{\\circ}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "v2-3ab5c-p29-practice-slot-9-slot-9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin 180^{\\circ}+\\cos 120^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}\\sin 180^{\\circ}&=0\\\\A&=180^{\\circ}-120^{\\circ}=60^{\\circ}\\\\\\cos 120^{\\circ}&=-\\cos 60^{\\circ}=-\\frac{1}{2}\\\\\\sin 180^{\\circ}+\\cos 120^{\\circ}&=0-\\frac{1}{2}\\\\&=-\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-3ab5c-p29-practice-slot-9-slot-9-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin 150^{\\circ}-\\cos 180^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2}$",
          "worked": "$$\\begin{align*}A&=180^{\\circ}-150^{\\circ}=30^{\\circ}\\\\\\sin 150^{\\circ}&=\\sin 30^{\\circ}=\\frac{1}{2}\\\\\\cos 180^{\\circ}&=-1\\\\\\sin 150^{\\circ}-\\cos 180^{\\circ}&=\\frac{1}{2}-(-1)\\\\&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-3ab5c-p29-practice-slot-9-slot-9-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan 135^{\\circ}-\\tan 180^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}A&=180^{\\circ}-135^{\\circ}=45^{\\circ}\\\\\\tan 135^{\\circ}&=-\\tan 45^{\\circ}=-1\\\\\\tan 180^{\\circ}&=\\frac{\\sin 180^{\\circ}}{\\cos 180^{\\circ}}=\\frac{0}{-1}=0\\\\\\tan 135^{\\circ}-\\tan 180^{\\circ}&=-1-0\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
