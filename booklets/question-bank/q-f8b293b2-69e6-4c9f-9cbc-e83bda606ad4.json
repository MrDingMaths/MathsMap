  "content": {
    "id": "p21-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A point moving in a straight line has displacement $x$ m from the origin $O$ at time $t$ seconds, where\n$$x=2t^3-15t^2+36t.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the velocity and acceleration at any time $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dot{x}=6t^2-30t+36$ m/s; $\\ddot{x}=12t-30$ m/s².",
          "worked": "Differentiate displacement to obtain velocity, then differentiate velocity to obtain acceleration.\n$$\\begin{align*}\\dot{x}(t)&=6t^2-30t+36\\quad\\text{m/s}\\\\\\ddot{x}(t)&=12t-30\\quad\\text{m/s}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p21-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the initial velocity and acceleration.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Initial velocity: $36$ m/s; initial acceleration: $-30$ m/s².",
          "worked": "Initially, $t=0$.\n$$\\begin{align*}\\dot{x}(0)&=6(0)^2-30(0)+36=36\\quad\\text{m/s}\\\\\\ddot{x}(0)&=12(0)-30=-30\\quad\\text{m/s}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p21-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "At what times is the velocity zero?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2$ s and $t=3$ s.",
          "worked": "$$\\begin{align*}6t^2-30t+36&=0\\\\6(t-2)(t-3)&=0\\\\t&=2\\text{ or }3\\end{align*}$$\nThe velocity is zero at $2$ s and $3$ s.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p21-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "At what time is the acceleration zero? Find the velocity and position at this time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2.5$ s; velocity $=-1.5$ m/s; position $=27.5$ m.",
          "worked": "$$\\begin{align*}12t-30&=0\\\\t&=\\frac52\\quad\\text{s}\\end{align*}$$\n$$\\begin{align*}\\dot{x}\\left(\\frac52\\right)&=6\\left(\\frac52\\right)^2-30\\left(\\frac52\\right)+36\\\\\\dot{x}\\left(\\frac52\\right)&=-\\frac32\\quad\\text{m/s}\\\\x\\left(\\frac52\\right)&=2\\left(\\frac52\\right)^3-15\\left(\\frac52\\right)^2+36\\left(\\frac52\\right)\\\\x\\left(\\frac52\\right)&=\\frac{55}{2}\\quad\\text{m}\\end{align*}$$\nThus, at $2.5$ s the velocity is $-1.5$ m/s and the position is $27.5$ m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p21-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "During what interval of time is the velocity negative?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2<t<3$ seconds.",
          "worked": "$$\\begin{align*}6t^2-30t+36&<0\\\\(t-2)(t-3)&<0\\end{align*}$$\nThe factors have opposite signs between the roots, so the velocity is negative for $2<t<3$ seconds.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
