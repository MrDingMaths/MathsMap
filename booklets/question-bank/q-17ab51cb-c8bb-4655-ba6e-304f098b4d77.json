  "content": {
    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "After cycling $\\frac{5}{9}$ of a journey, a cyclist has 32 km further to go. What is the length of the journey?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$72\\text{ km}$",
      "worked": "The fraction of the journey remaining is\n$$\\begin{align*}1-\\frac{5}{9}&=\\frac{4}{9}.\\end{align*}$$\nFour ninths of the journey is 32 km, so one ninth is\n$$\\begin{align*}32\\div4&=8\\text{ km}.\\end{align*}$$\nThe whole journey is\n$$\\begin{align*}8\\times9&=72\\text{ km}.\\end{align*}$$",
      "solutionDiagrams": []
    },
