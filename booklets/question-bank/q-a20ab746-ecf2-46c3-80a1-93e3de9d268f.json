  "content": {
    "id": "p17-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Simplify:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_a a^2&=2\\log_a a\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\log_a a^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}5\\log_a a^3&=5\\times3\\log_a a\\\\&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a\\frac{1}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\log_a\\frac1a&=\\log_a a^{-1}\\\\&=-\\log_a a\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p17-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$12\\log_a\\sqrt{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}12\\log_a\\sqrt a&=12\\log_a a^{\\frac12}\\\\&=12\\times\\frac12\\log_a a\\\\&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
