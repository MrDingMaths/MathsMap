  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the exact value of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin^{-1}\\left(-\\frac12\\right)+\\cos^{-1}\\left(-\\frac12\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{2}$",
          "worked": "$$\\begin{aligned}\\sin^{-1}\\left(-\\frac12\\right)+\\cos^{-1}\\left(-\\frac12\\right)&=-\\frac{\\pi}{6}+\\frac{2\\pi}{3}\\\\&=\\frac{\\pi}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin(\\cos^{-1}0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\cos^{-1}0&=\\frac{\\pi}{2}\\\\\\sin(\\cos^{-1}0)&=\\sin\\left(\\frac{\\pi}{2}\\right)\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos^{-1}\\left(\\sin\\left(\\frac{\\pi}{3}\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{6}$",
          "worked": "$$\\begin{aligned}\\sin\\left(\\frac{\\pi}{3}\\right)&=\\frac{\\sqrt3}{2}\\\\\\cos^{-1}\\left(\\sin\\left(\\frac{\\pi}{3}\\right)\\right)&=\\cos^{-1}\\left(\\frac{\\sqrt3}{2}\\right)\\\\&=\\frac{\\pi}{6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p13-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\left(\\cos^{-1}\\left(-\\frac{\\sqrt3}{2}\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{aligned}\\cos^{-1}\\left(-\\frac{\\sqrt3}{2}\\right)&=\\frac{5\\pi}{6}\\\\\\sin\\left(\\cos^{-1}\\left(-\\frac{\\sqrt3}{2}\\right)\\right)&=\\sin\\left(\\frac{5\\pi}{6}\\right)\\\\&=\\frac12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p13-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos\\left(2\\tan^{-1}(-1)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{aligned}\\tan^{-1}(-1)&=-\\frac{\\pi}{4}\\\\\\cos\\left(2\\tan^{-1}(-1)\\right)&=\\cos\\left(2\\left(-\\frac{\\pi}{4}\\right)\\right)\\\\&=\\cos\\left(-\\frac{\\pi}{2}\\right)\\\\&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p13-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\arctan\\left(\\sqrt6\\sin\\left(\\frac{\\pi}{4}\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{3}$",
          "worked": "$$\\begin{aligned}\\sin\\left(\\frac{\\pi}{4}\\right)&=\\frac{1}{\\sqrt2}\\\\\\sqrt6\\sin\\left(\\frac{\\pi}{4}\\right)&=\\frac{\\sqrt6}{\\sqrt2}\\\\&=\\sqrt3\\\\\\arctan\\left(\\sqrt6\\sin\\left(\\frac{\\pi}{4}\\right)\\right)&=\\arctan(\\sqrt3)\\\\&=\\frac{\\pi}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
