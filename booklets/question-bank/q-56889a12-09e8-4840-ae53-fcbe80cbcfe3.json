  "content": {
    "id": "p31-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A rectangle has length $8\\text{ cm}$ and width $4\\text{ cm}$. Another rectangle has length $12\\text{ cm}$ and width $6\\text{ cm}$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "the ratio of the lengths",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:3$",
          "worked": "$$\\begin{align*}\\text{Length ratio}&=8:12\\\\\\text{Length ratio}&=2:3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p31-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "the ratio of the widths",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:3$",
          "worked": "$$\\begin{align*}\\text{Width ratio}&=4:6\\\\\\text{Width ratio}&=2:3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p31-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "the ratio of the perimeters",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:3$",
          "worked": "$$\\begin{align*}P_1&=2(8+4)=24\\text{ cm}\\\\P_2&=2(12+6)=36\\text{ cm}\\\\\\text{Perimeter ratio}&=24:36\\\\\\text{Perimeter ratio}&=2:3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p31-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "the ratio of the areas",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4:9$",
          "worked": "$$\\begin{align*}A_1&=8\\times4=32\\text{ cm}^2\\\\A_2&=12\\times6=72\\text{ cm}^2\\\\\\text{Area ratio}&=32:72\\\\\\text{Area ratio}&=4:9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
