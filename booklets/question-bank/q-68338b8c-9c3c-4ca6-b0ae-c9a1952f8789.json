            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "45 hand shakes.",
              "worked": "Each of 10 guests shakes hands with 9 others. This counts every hand shake twice.\n\n$\\dfrac{10\\times9}{2}=45$ hand shakes.",
