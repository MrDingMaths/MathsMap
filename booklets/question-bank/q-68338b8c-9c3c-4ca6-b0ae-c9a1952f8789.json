            "answer": {
              "short": "1 hand shake.",
              "worked": "Each guest shakes hands with the other guest; this is one pair, so there is 1 hand shake.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p26-q7-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "3 guests?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "3 hand shakes.",
              "worked": "Count each pair once: the first guest shakes hands with 2 others, and the second has 1 remaining hand shake.\n\n$2+1=3$ hand shakes.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p26-q7-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "4 guests?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "6 hand shakes.",
              "worked": "Count each pair once: $3+2+1=6$ hand shakes.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p26-q7-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "10 guests?",
            "layout": "list",
