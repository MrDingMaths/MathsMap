    "type": "question",
    "label": "2",
    "prompt": "If $\\dfrac{dy}{dx}=x^3-3x^2+5$ and $y=4$ when $x=1$, find an equation for $y$ in terms of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\dfrac{x^4}{4}-x^3+5x-\\dfrac14$",
      "worked": "$$\\begin{align*}y&=\\frac{x^4}{4}-x^3+5x+C\\\\4&=\\frac{1^4}{4}-1^3+5(1)+C\\\\4&=\\frac{17}{4}+C\\\\C&=-\\frac14\\\\y&=\\frac{x^4}{4}-x^3+5x-\\frac14\\end{align*}$$",
      "solutionDiagrams": []
    },
