  "content": {
    "id": "p12-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Cameron and Wendy together earn \\$1156 per week after tax. Of this, they pay \\$460 off their mortgage, \\$185 for groceries, and \\$260 for their car and transport, and they save \\$124.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Express each amount as a percentage of their weekly income, correct to the nearest 1%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mortgage $40\\%$; groceries $16\\%$; car/transport $22\\%$; savings $11\\%$.",
          "worked": "Divide each amount by 1156 and multiply by 100: $\\frac{460}{1156}\\times100\\%\\approx40\\%$, $\\frac{185}{1156}\\times100\\%\\approx16\\%$, $\\frac{260}{1156}\\times100\\%\\approx22\\%$, $\\frac{124}{1156}\\times100\\%\\approx11\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find how much is unaccounted for in the list above, and what percentage it is of their weekly income. Give the percentage to the nearest 1%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$127$, about $11\\%$.",
          "worked": "Accounted for: $460+185+260+124=1029$. Remainder $=1156-1029=\\$127$; $\\frac{127}{1156}\\times100\\%\\approx11\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
