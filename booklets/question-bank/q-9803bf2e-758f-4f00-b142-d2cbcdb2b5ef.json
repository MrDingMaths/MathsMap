  "content": {
    "id": "p11-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Given $P(x)=x+5$ and $Q(x)=2x-1$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q14-row1",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q14-a",
            "type": "part",
            "label": "a",
            "prompt": "$P(3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8$",
              "worked": "$$\\begin{align*}P(3)&=3+5\\\\P(3)&=8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p11-q14-b",
            "type": "part",
            "label": "b",
            "prompt": "$Q(-2)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-5$",
              "worked": "$$\\begin{align*}Q(-2)&=2(-2)-1\\\\Q(-2)&=-5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p11-q14-c",
            "type": "part",
            "label": "c",
            "prompt": "$P(3)+Q(-2)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "$$\\begin{align*}P(3)+Q(-2)&=(3+5)+(2(-2)-1)\\\\P(3)+Q(-2)&=8+(-5)\\\\P(3)+Q(-2)&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p11-q14-row2",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q14-d",
            "type": "part",
            "label": "d",
            "prompt": "The degree of $P(x)+Q(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}P(x)+Q(x)&=(x+5)+(2x-1)\\\\P(x)+Q(x)&=3x+4\\end{align*}$$\nThe highest power of $x$ is $1$, so the degree is $1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p11-q14-e",
            "type": "part",
            "label": "e",
            "prompt": "The degree of $P(x)Q(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$$\\begin{align*}P(x)Q(x)&=(x+5)(2x-1)\\\\P(x)Q(x)&=2x^2-x+10x-5\\\\P(x)Q(x)&=2x^2+9x-5\\end{align*}$$\nThe highest power of $x$ is $2$, so the degree is $2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      }
    ]
  },
