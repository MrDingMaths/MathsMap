                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The common intercept forces the factor to be 1; then equality at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " would require ",
