    "id": "p6-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "For the formula $s=ut+\\frac{1}{2}at^2$, find the value of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$u$, when $s=10$, $t=20$ and $a=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=-19.5$",
          "worked": "$$\\begin{align*}10&=20u+\\frac{1}{2}\\times2\\times20^2\\\\10&=20u+400\\\\20u&=10-400\\\\20u&=-390\\\\u&=-19.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$a$, when $s=20$, $u=5$ and $t=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=5$",
          "worked": "$$\\begin{align*}20&=5\\times2+\\frac{1}{2}\\times a\\times2^2\\\\20&=10+2a\\\\2a&=10\\\\a&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
