  "content": {
    "id": "p7-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Try to solve the equation $2(3x + 6) = 3(2x + 4)$. How many solutions does the equation have?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Infinitely many solutions: every real value of $x$.\n\nExpanding gives identical expressions on both sides.",
      "worked": "$$\\begin{align*}6x+12 &= 6x+12\\\\6x+12-6x &= 6x+12-6x\\\\12 &= 12\\end{align*}$$\nThis is true for every real value of $x$, so the equation has infinitely many solutions.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
