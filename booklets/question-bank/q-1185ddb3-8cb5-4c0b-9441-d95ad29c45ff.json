  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Let $k(x)=x^2-4x$. Find $x$ if:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$k(x)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=4$",
          "worked": "$$\\begin{align*}x^2-4x&=0\\\\x(x-4)&=0\\end{align*}$$\n$x=0$ or $x=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$k(x)=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}x^2-4x&=-4\\\\x^2-4x+4&=0\\\\(x-2)^2&=0\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$k(x)=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $x=5$",
          "worked": "$$\\begin{align*}x^2-4x&=5\\\\x^2-4x-5&=0\\\\(x-5)(x+1)&=0\\end{align*}$$\n$x=-1$ or $x=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$k(x)=-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real values of $x$.",
          "worked": "$$\\begin{align*}x^2-4x&=-5\\\\x^2-4x+4&=-1\\\\(x-2)^2&=-1\\end{align*}$$\nA real square cannot be negative, so there are no real values of $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$k(x)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2-\\sqrt5$ or $x=2+\\sqrt5$.\n\nComplete the square and take both square roots.",
          "worked": "$$\\begin{align*}x^2-4x&=1\\\\x^2-4x+4&=5\\\\(x-2)^2&=5\\\\x-2&=\\pm\\sqrt5\\\\x&=2\\pm\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$k(x)=k(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $x=3$",
          "worked": "$$\\begin{align*}k(3)&=3^2-4(3)=-3\\\\x^2-4x&=-3\\\\x^2-4x+3&=0\\\\(x-1)(x-3)&=0\\end{align*}$$\n$x=1$ or $x=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
