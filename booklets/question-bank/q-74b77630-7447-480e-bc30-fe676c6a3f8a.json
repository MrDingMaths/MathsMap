  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "If a year (365 days) is divided into lunar months of 28 days, how many months will there be in a year? Express your answer as a mixed numeral.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$13\\frac{1}{28}$ months",
      "worked": "$$\\begin{align*}\\text{Number of months}&=\\frac{365}{28}\\\\\\text{Number of months}&=\\frac{13\\times28+1}{28}\\\\\\text{Number of months}&=13\\frac{1}{28}.\\end{align*}$$\nTherefore, there are $13\\frac{1}{28}$ lunar months in a year.",
      "solutionDiagrams": []
    },
