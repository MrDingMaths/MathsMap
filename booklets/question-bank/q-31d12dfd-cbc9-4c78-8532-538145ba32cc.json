    "id": "p8-ex9b-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Dartmouth Dam has a capacity of 4 million megalitres. If the dam is currently holding half of its capacity, how many litres is this?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\,000\\,000\\,000\\,000\\text{ L}$",
      "worked": "$$\\begin{align*}\\text{Volume held}&=4\\,000\\,000\\div2\\text{ ML}\\\\\\text{Volume held}&=2\\,000\\,000\\text{ ML}\\\\\\text{Volume held}&=2\\,000\\,000\\times1\\,000\\,000\\text{ L}\\\\\\text{Volume held}&=2\\,000\\,000\\,000\\,000\\text{ L}\\end{align*}$$",
      "solutionDiagrams": []
    },
