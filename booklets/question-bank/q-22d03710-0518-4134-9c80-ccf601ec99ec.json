    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2x-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $5$; $y$-intercept: $-10$.",
          "worked": "For the $x$-intercept, set $y=0$.\n$$\\begin{align*}2x-10&=0\\\\2x&=10\\\\x&=5\\end{align*}$$\nFor the $y$-intercept, set $x=0$.\n$$\\begin{align*}y&=2(0)-10\\\\y&=-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=3x+11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $-\\frac{11}{3}$; $y$-intercept: $11$.",
          "worked": "For the $x$-intercept, set $y=0$.\n$$\\begin{align*}3x+11&=0\\\\3x&=-11\\\\x&=-\\frac{11}{3}\\end{align*}$$\nFor the $y$-intercept, set $x=0$.\n$$\\begin{align*}y&=3(0)+11\\\\y&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p16-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x+8y=48$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $16$; $y$-intercept: $6$.",
          "worked": "For the $x$-intercept, set $y=0$.\n$$\\begin{align*}3x+8(0)&=48\\\\x&=16\\end{align*}$$\nFor the $y$-intercept, set $x=0$.\n$$\\begin{align*}3(0)+8y&=48\\\\y&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$5x-4y+80=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $-16$; $y$-intercept: $20$.",
          "worked": "For the $x$-intercept, set $y=0$.\n$$\\begin{align*}5x+80&=0\\\\5x&=-80\\\\x&=-16\\end{align*}$$\nFor the $y$-intercept, set $x=0$.\n$$\\begin{align*}-4y+80&=0\\\\-4y&=-80\\\\y&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
