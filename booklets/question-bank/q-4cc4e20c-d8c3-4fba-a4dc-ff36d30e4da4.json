    "id": "p34-challenge-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Given $t>0$ and $t\\ne1$, find the value of $x$ if $t^x=\\sqrt[3]{\\frac{t}{\\sqrt t}}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac16$.",
      "worked": "$$\\begin{align*}\\sqrt[3]{\\frac{t}{\\sqrt t}}&=\\left(\\frac{t}{t^{1/2}}\\right)^{1/3}\\\\\\sqrt[3]{\\frac{t}{\\sqrt t}}&=\\left(t^{1/2}\\right)^{1/3}\\\\\\sqrt[3]{\\frac{t}{\\sqrt t}}&=t^{1/6}\\end{align*}$$\nEquating indices gives $x=\\frac16$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
