            {
              "type": "text",
              "text": "Mary sketches ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=\\cot x",
              "display": false
            },
            {
              "type": "text",
              "text": " in the domain ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x\\in[0,2\\pi]",
              "display": false
            },
            {
              "type": "text",
              "text": ", and Bob is asked to sketch ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=\\frac{1}{\\tan x}",
              "display": false
            },
            {
              "type": "text",
              "text": " in the same domain. Bob argues the following.",
              "marks": []
            }
          ]
        },
        {
          "id": "p15-p3-supplied-working",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}y&=\\frac{1}{\\tan x}\\\\[9pt]&=\\frac{1}{\\frac{\\sin x}{\\cos x}}\\\\[9pt]&=\\frac{\\cos x}{\\sin x}\\\\[9pt]&=\\cot x\\end{aligned}",
              "display": true
            }
          ]
        }
      ]
