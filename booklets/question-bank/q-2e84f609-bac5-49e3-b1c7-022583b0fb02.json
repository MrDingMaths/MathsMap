  "content": {
    "id": "p14-q23-root",
    "type": "question",
    "label": null,
    "prompt": "Let $P(x)=x^3-ax^2+5x+3$. When $P(x)$ is divided by $x-2$, the remainder is $1$. Find $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=5$",
      "worked": "By the remainder theorem, $P(2)=1$.\n$$\\begin{align*}2^3-a(2)^2+5(2)+3&=1\\\\21-4a&=1\\\\-4a&=-20\\\\a&=5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
