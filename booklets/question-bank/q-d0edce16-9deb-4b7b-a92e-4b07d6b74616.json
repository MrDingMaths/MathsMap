  "content": {
    "id": "p7-q9",
    "type": "question",
    "label": "9",
    "prompt": "Simplify, if possible.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{5x+10}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$",
          "worked": "$\\begin{aligned}\\frac{5x+10}{5}&=\\frac{5(x+2)}{5}\\\\&=x+2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5x+10}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$\\begin{aligned}\\frac{5x+10}{x+2}&=\\frac{5(x+2)}{x+2}\\\\&=5\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{5x+10}{x+10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cannot simplify.",
          "worked": "$\\dfrac{5x+10}{x+10}=\\dfrac{5(x+2)}{x+10}$\n\nThe numerator and denominator have no common factor other than 1, so the fraction cannot be simplified.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x^2+4x}{4x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+4}{4}$",
          "worked": "$\\begin{aligned}\\frac{x^2+4x}{4x}&=\\frac{x(x+4)}{4x}\\\\&=\\frac{x+4}{4}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x^2+4x}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+4$",
          "worked": "$\\begin{aligned}\\frac{x^2+4x}{x}&=\\frac{x(x+4)}{x}\\\\&=x+4\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x^2+4}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cannot simplify.",
          "worked": "$x$ is not a factor of $x^2+4$. The numerator and denominator have no common factor other than 1, so the fraction cannot be simplified.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x^2+4}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cannot simplify.",
          "worked": "$x^2+4$ is a sum of squares and does not have $x+2$ as a factor. There is no common factor to cancel, so the fraction cannot be simplified.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x^2+4x+4}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$",
          "worked": "$\\begin{aligned}\\frac{x^2+4x+4}{x+2}&=\\frac{(x+2)(x+2)}{x+2}\\\\&=x+2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{4(2x-1)}{2(1-2x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$\\begin{aligned}\\frac{4(2x-1)}{2(1-2x)}&=\\frac{4(2x-1)}{-2(2x-1)}\\\\&=-2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
