  "content": {
    "id": "p72-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A basketball team of 5 players is selected at random from a group of 12 PE students.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p72-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "In how many ways can the team be selected?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$792$",
          "worked": "Order does not matter.\n$$\\binom{12}{5}=792$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p72-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the probability that Erik is selected as one of the team members.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{12}$",
          "worked": "Include Erik and choose the remaining 4 players from the other 11 students.\n$$P(\\text{Erik selected})=\\frac{\\binom{11}{4}}{\\binom{12}{5}}=\\frac{330}{792}=\\frac5{12}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p72-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the probability that Erik and Jens are both selected.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{33}$",
          "worked": "Include Erik and Jens and choose the remaining 3 players from the other 10 students.\n$$P(\\text{both selected})=\\frac{\\binom{10}{3}}{\\binom{12}{5}}=\\frac{120}{792}=\\frac5{33}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
