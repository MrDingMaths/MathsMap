    "label": "20",
    "prompt": "Simplify $\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2^{10x}$.\n\nWrite each factor in base 2, add the indices and halve the resulting index.",
      "worked": "$$\\begin{align*}\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}&=\\sqrt{2^{4x}\\times2^{4x}\\times2^{12x}}\\\\\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}&=(2^{20x})^{\\frac{1}{2}}\\\\\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}&=2^{10x}\\end{align*}$$",
      "solutionDiagrams": []
    },
