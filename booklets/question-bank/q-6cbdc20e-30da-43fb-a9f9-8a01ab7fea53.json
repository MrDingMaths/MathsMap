  "content": {
    "id": "p12-q82-response",
    "type": "question",
    "label": "22",
    "prompt": "Given two numbers that sum to $12$ and the difference of their squares is $30$, find the difference between the two numbers, without solving for them.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac52$.\n\nDivide the difference of their squares by their sum.",
      "worked": "Let the numbers be $u$ and $v$, with $u+v=12$ and $u^2-v^2=30$.\n$$\\begin{align*}(u-v)(u+v)&=u^2-v^2\\\\12(u-v)&=30\\\\u-v&=\\frac{30}{12}\\\\u-v&=\\frac52.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
