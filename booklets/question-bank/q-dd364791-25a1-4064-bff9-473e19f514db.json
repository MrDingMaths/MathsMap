  "content": {
    "id": "p14-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The total population of a state is $2\\,500\\,000$. The population of the capital city is $1\\,500\\,000$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage of the population of the state lives in the capital city?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage in capital city}&=\\frac{1\\,500\\,000}{2\\,500\\,000}\\times100\\%\\\\\\text{Percentage in capital city}&=\\frac35\\times100\\%\\\\\\text{Percentage in capital city}&=60\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage of the population of the state lives outside the capital city?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage outside capital city}&=100\\%-60\\%\\\\\\text{Percentage outside capital city}&=40\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
