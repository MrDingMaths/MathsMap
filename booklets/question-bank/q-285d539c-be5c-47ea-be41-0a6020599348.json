  "content": {
    "id": "v2-dfadbc-p6-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "A baker has 15.5 kg of flour. Each loaf uses 600 g of flour. How many full loaves can the baker make?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$25$ loaves",
      "worked": "$$\\begin{align*}15.5\\text{ kg}&=15.5\\times1000\\text{ g}\\\\&=15\\,500\\text{ g}\\\\\\text{Number of loaves}&=15\\,500\\div600\\\\&=25.83\\ldots\\end{align*}$$\nThe baker can make $25$ full loaves.",
      "solutionDiagrams": []
    },
