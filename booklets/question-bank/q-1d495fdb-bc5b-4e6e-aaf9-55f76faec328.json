  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "It is not possible to determine the area of a quadrilateral if all you know are its side lengths. Explain why.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "A square and a rhombus with the same side lengths can have different areas.",
      "worked": "A square of side length $a$ has area $a^2$. A rhombus with the same side lengths, but with angles different from $90^\\circ$, has perpendicular height $h<a$, so its area is $ah<a^2$. Thus side lengths alone do not determine a quadrilateral’s area.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
