        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^2}{6}+\\frac{7a}{6}+2$",
          "worked": "$$\\begin{align*}\\left(\\frac a2+2\\right)\\left(\\frac a3+1\\right)&=\\frac{a^2}{6}+\\frac a2+\\frac{2a}{3}+2\\\\\\left(\\frac a2+2\\right)\\left(\\frac a3+1\\right)&=\\frac{a^2}{6}+\\frac{3a+4a}{6}+2\\\\\\left(\\frac a2+2\\right)\\left(\\frac a3+1\\right)&=\\frac{a^2}{6}+\\frac{7a}{6}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
