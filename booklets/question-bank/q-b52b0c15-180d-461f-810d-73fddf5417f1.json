    "children": [
      {
        "id": "v2-7a-p17-denominator-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{1}{f}=\\frac{1}{u}+\\frac{1}{v}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=\\frac{fu}{u-f}$",
          "worked": "$$\\begin{align*}\\frac{1}{v}&=\\frac{1}{f}-\\frac{1}{u}\\\\\\frac{1}{v}&=\\frac{u-f}{fu}\\\\v&=\\frac{fu}{u-f}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-7a-p17-denominator-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{2}{F}=\\frac{1}{u}-\\frac{1}{v}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=\\frac{uF}{F-2u}$",
          "worked": "$$\\begin{align*}\\frac{1}{v}&=\\frac{1}{u}-\\frac{2}{F}\\\\\\frac{1}{v}&=\\frac{F-2u}{uF}\\\\v&=\\frac{uF}{F-2u}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
