  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "$AB$ and $DC$ are parallel sides of a trapezium $ABCD$. The diagonals of the trapezium intersect at $O$. Prove that $\\dfrac{BO}{OD}=\\dfrac{AO}{OC}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{BO}{OD}=\\dfrac{AO}{OC}$.",
      "worked": "As $AB\\parallel DC$, alternate angles give $\\angle ABO=\\angle CDO$ and $\\angle BAO=\\angle DCO$. Also $\\angle AOB=\\angle COD$ (vertically opposite). Thus $\\triangle AOB\\sim\\triangle COD$ by AAA. Matching sides give $\\frac{BO}{OD}=\\frac{AO}{OC}$, as required.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 17
  },
