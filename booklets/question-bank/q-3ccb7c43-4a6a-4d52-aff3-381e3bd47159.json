  "content": {
    "id": "v2-19076-p14-practice-j6-031945-root",
    "type": "question",
    "label": null,
    "prompt": "The exchange rates are $\\mathrm{A}\\$1=\\mathrm{US}\\$0.65$ and $\\mathrm{A}\\$1=$ €$0.60$.\n\nHow many euros is $\\$260$ US?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "240 euros",
      "worked": "Let $A$ be Australian dollars, $U$ US dollars and $E$ euros.\n$$\\begin{align*}U&=0.65A\\\\260&=0.65A\\\\A&=\\frac{260}{0.65}\\\\A&=400\\end{align*}$$\n$$\\begin{align*}E&=0.6A\\\\E&=0.6\\times400\\\\E&=240\\end{align*}$$\n240 euros.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
