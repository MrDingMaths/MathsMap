    "children": [
      {
        "id": "p20-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(AB)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{24}$",
          "worked": "$$\\begin{align*}P(AB)&=P(A)\\times P(B)\\\\P(AB)&=\\frac{1}{8}\\times\\frac{1}{3}\\\\P(AB)&=\\frac{1}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q8-b",
        "type": "part",
        "label": "b",
