        "children": [],
        "answer": {
          "short": "$\\frac{1}{28}$",
          "worked": "$$\\begin{align*}P(AD)&=P(A)\\times P(D)\\\\P(AD)&=\\frac{1}{8}\\times\\frac{2}{7}\\\\P(AD)&=\\frac{1}{28}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(BC)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{12}$",
          "worked": "$$\\begin{align*}P(BC)&=P(B)\\times P(C)\\\\P(BC)&=\\frac{1}{3}\\times\\frac{1}{4}\\\\P(BC)&=\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(ABC)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{96}$",
          "worked": "$$\\begin{align*}P(ABC)&=P(A)\\times P(B)\\times P(C)\\\\P(ABC)&=\\frac{1}{8}\\times\\frac{1}{3}\\times\\frac{1}{4}\\\\P(ABC)&=\\frac{1}{96}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p20-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(BCD)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{42}$",
          "worked": "$$\\begin{align*}P(BCD)&=P(B)\\times P(C)\\times P(D)\\\\P(BCD)&=\\frac{1}{3}\\times\\frac{1}{4}\\times\\frac{2}{7}\\\\P(BCD)&=\\frac{1}{42}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p20-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$P(ABCD)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{336}$",
          "worked": "$$\\begin{align*}P(ABCD)&=P(ABC)\\times P(D)\\\\P(ABCD)&=\\left(\\frac{1}{8}\\times\\frac{1}{3}\\times\\frac{1}{4}\\right)\\times\\frac{2}{7}\\\\P(ABCD)&=\\frac{1}{96}\\times\\frac{2}{7}\\\\P(ABCD)&=\\frac{1}{336}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
