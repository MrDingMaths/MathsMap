      {
        "id": "p16-q7-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{\\sqrt{10}-\\sqrt{6}}{\\sqrt{10}+\\sqrt{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4-\\sqrt{15}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{10}-\\sqrt{6}}{\\sqrt{10}+\\sqrt{6}}&=\\frac{(\\sqrt{10}-\\sqrt{6})^2}{(\\sqrt{10}+\\sqrt{6})(\\sqrt{10}-\\sqrt{6})}\\\\\\frac{\\sqrt{10}-\\sqrt{6}}{\\sqrt{10}+\\sqrt{6}}&=\\frac{10-2\\sqrt{60}+6}{10-6}\\\\\\frac{\\sqrt{10}-\\sqrt{6}}{\\sqrt{10}+\\sqrt{6}}&=\\frac{16-4\\sqrt{15}}{4}\\\\\\frac{\\sqrt{10}-\\sqrt{6}}{\\sqrt{10}+\\sqrt{6}}&=4-\\sqrt{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
