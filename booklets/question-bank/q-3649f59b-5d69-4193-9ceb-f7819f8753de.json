    "children": [
      {
        "id": "p16-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{\\sqrt{5}+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3\\sqrt{5}-3}{4}$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{5}+1}&=\\frac{3(\\sqrt{5}-1)}{(\\sqrt{5}+1)(\\sqrt{5}-1)}\\\\\\frac{3}{\\sqrt{5}+1}&=\\frac{3\\sqrt{5}-3}{5-1}\\\\\\frac{3}{\\sqrt{5}+1}&=\\frac{3\\sqrt{5}-3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{4}{2\\sqrt{2}-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8\\sqrt{2}+4\\sqrt{3}}{5}$",
          "worked": "$$\\begin{align*}\\frac{4}{2\\sqrt{2}-\\sqrt{3}}&=\\frac{4(2\\sqrt{2}+\\sqrt{3})}{(2\\sqrt{2}-\\sqrt{3})(2\\sqrt{2}+\\sqrt{3})}\\\\\\frac{4}{2\\sqrt{2}-\\sqrt{3}}&=\\frac{8\\sqrt{2}+4\\sqrt{3}}{4\\times2-3}\\\\\\frac{4}{2\\sqrt{2}-\\sqrt{3}}&=\\frac{8\\sqrt{2}+4\\sqrt{3}}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p16-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{\\sqrt{7}}{5-\\sqrt{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5\\sqrt{7}+7}{18}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{7}}{5-\\sqrt{7}}&=\\frac{\\sqrt{7}(5+\\sqrt{7})}{(5-\\sqrt{7})(5+\\sqrt{7})}\\\\\\frac{\\sqrt{7}}{5-\\sqrt{7}}&=\\frac{5\\sqrt{7}+7}{25-7}\\\\\\frac{\\sqrt{7}}{5-\\sqrt{7}}&=\\frac{5\\sqrt{7}+7}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3\\sqrt{15}-9}{2}$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}&=\\frac{3\\sqrt{3}(\\sqrt{5}-\\sqrt{3})}{(\\sqrt{5}+\\sqrt{3})(\\sqrt{5}-\\sqrt{3})}\\\\\\frac{3\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}&=\\frac{3\\sqrt{15}-9}{5-3}\\\\\\frac{3\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}&=\\frac{3\\sqrt{15}-9}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p16-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{2\\sqrt{7}}{2\\sqrt{7}-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{28+10\\sqrt{7}}{3}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{7}}{2\\sqrt{7}-5}&=\\frac{2\\sqrt{7}(2\\sqrt{7}+5)}{(2\\sqrt{7}-5)(2\\sqrt{7}+5)}\\\\\\frac{2\\sqrt{7}}{2\\sqrt{7}-5}&=\\frac{28+10\\sqrt{7}}{4\\times7-25}\\\\\\frac{2\\sqrt{7}}{2\\sqrt{7}-5}&=\\frac{28+10\\sqrt{7}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p16-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{\\sqrt{5}}{\\sqrt{10}-\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}+1$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{5}}{\\sqrt{10}-\\sqrt{5}}&=\\frac{\\sqrt{5}(\\sqrt{10}+\\sqrt{5})}{(\\sqrt{10}-\\sqrt{5})(\\sqrt{10}+\\sqrt{5})}\\\\\\frac{\\sqrt{5}}{\\sqrt{10}-\\sqrt{5}}&=\\frac{\\sqrt{50}+5}{10-5}\\\\\\frac{\\sqrt{5}}{\\sqrt{10}-\\sqrt{5}}&=\\frac{5\\sqrt{2}+5}{5}\\\\\\frac{\\sqrt{5}}{\\sqrt{10}-\\sqrt{5}}&=\\sqrt{2}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p16-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{\\sqrt{3}-1}{\\sqrt{3}+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}-1}{\\sqrt{3}+1}&=\\frac{(\\sqrt{3}-1)^2}{(\\sqrt{3}+1)(\\sqrt{3}-1)}\\\\\\frac{\\sqrt{3}-1}{\\sqrt{3}+1}&=\\frac{3-2\\sqrt{3}+1}{3-1}\\\\\\frac{\\sqrt{3}-1}{\\sqrt{3}+1}&=2-\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{\\sqrt{5}+\\sqrt{2}}{\\sqrt{5}-\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7+2\\sqrt{10}}{3}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{5}+\\sqrt{2}}{\\sqrt{5}-\\sqrt{2}}&=\\frac{(\\sqrt{5}+\\sqrt{2})^2}{(\\sqrt{5}-\\sqrt{2})(\\sqrt{5}+\\sqrt{2})}\\\\\\frac{\\sqrt{5}+\\sqrt{2}}{\\sqrt{5}-\\sqrt{2}}&=\\frac{5+2\\sqrt{10}+2}{5-2}\\\\\\frac{\\sqrt{5}+\\sqrt{2}}{\\sqrt{5}-\\sqrt{2}}&=\\frac{7+2\\sqrt{10}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p16-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{3-\\sqrt{7}}{3+\\sqrt{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8-3\\sqrt{7}$",
          "worked": "$$\\begin{align*}\\frac{3-\\sqrt{7}}{3+\\sqrt{7}}&=\\frac{(3-\\sqrt{7})^2}{(3+\\sqrt{7})(3-\\sqrt{7})}\\\\\\frac{3-\\sqrt{7}}{3+\\sqrt{7}}&=\\frac{9-6\\sqrt{7}+7}{9-7}\\\\\\frac{3-\\sqrt{7}}{3+\\sqrt{7}}&=8-3\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{3\\sqrt{2}+\\sqrt{5}}{3\\sqrt{2}-\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{23+6\\sqrt{10}}{13}$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt{2}+\\sqrt{5}}{3\\sqrt{2}-\\sqrt{5}}&=\\frac{(3\\sqrt{2}+\\sqrt{5})^2}{(3\\sqrt{2}-\\sqrt{5})(3\\sqrt{2}+\\sqrt{5})}\\\\\\frac{3\\sqrt{2}+\\sqrt{5}}{3\\sqrt{2}-\\sqrt{5}}&=\\frac{18+6\\sqrt{10}+5}{18-5}\\\\\\frac{3\\sqrt{2}+\\sqrt{5}}{3\\sqrt{2}-\\sqrt{5}}&=\\frac{23+6\\sqrt{10}}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
