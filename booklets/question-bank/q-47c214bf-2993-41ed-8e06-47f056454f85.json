  "content": {
    "id": "p13-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Factorise each of the following expressions by grouping in pairs:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$xy+4x+4y+16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)(y+4)$",
          "worked": "$$\\begin{align*}xy+4x+4y+16&=x(y+4)+4(y+4)\\\\xy+4x+4y+16&=(x+4)(y+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$mp+mq+np+nq$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m+n)(p+q)$",
          "worked": "$$\\begin{align*}mp+mq+np+nq&=m(p+q)+n(p+q)\\\\mp+mq+np+nq&=(m+n)(p+q).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+ax+bx+ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+x)(b+x)$",
          "worked": "$$\\begin{align*}x^2+ax+bx+ab&=x(x+a)+b(x+a)\\\\x^2+ax+bx+ab&=(x+a)(x+b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+bx-ax-ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-a)(x+b)$",
          "worked": "$$\\begin{align*}x^2+bx-ax-ab&=x(x+b)-a(x+b)\\\\x^2+bx-ax-ab&=(x-a)(x+b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-bx-ax+ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-a)(x-b)$",
          "worked": "$$\\begin{align*}x^2-bx-ax+ab&=x(x-b)-a(x-b)\\\\x^2-bx-ax+ab&=(x-a)(x-b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$6xy+2bx+3ay+ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+a)(3y+b)$",
          "worked": "$$\\begin{align*}6xy+2bx+3ay+ab&=2x(3y+b)+a(3y+b)\\\\6xy+2bx+3ay+ab&=(2x+a)(3y+b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$6xy+4bx+9ay+6ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+3a)(3y+2b)$",
          "worked": "$$\\begin{align*}6xy+4bx+9ay+6ab&=2x(3y+2b)+3a(3y+2b)\\\\6xy+4bx+9ay+6ab&=(2x+3a)(3y+2b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$6xy-9bx+4ay-6ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+2a)(2y-3b)$",
          "worked": "$$\\begin{align*}6xy-9bx+4ay-6ab&=3x(2y-3b)+2a(2y-3b)\\\\6xy-9bx+4ay-6ab&=(3x+2a)(2y-3b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
