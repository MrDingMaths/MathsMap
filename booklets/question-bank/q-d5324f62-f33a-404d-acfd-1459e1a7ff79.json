      {
        "id": "p12-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$3x^{\\frac12}y\\times3x^{\\frac12}y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9xy^3$",
          "worked": "$$\\begin{align*}3x^{\\frac12}y\\times3x^{\\frac12}y^2&=9x^{\\frac12+\\frac12}y^{1+2}\\\\3x^{\\frac12}y\\times3x^{\\frac12}y^2&=9xy^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$5a^{\\frac13}b^{\\frac23}\\times7a^{-\\frac13}b^{\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35b$",
          "worked": "$$\\begin{align*}5a^{\\frac13}b^{\\frac23}\\times7a^{-\\frac13}b^{\\frac13}&=35a^{\\frac13-\\frac13}b^{\\frac23+\\frac13}\\\\5a^{\\frac13}b^{\\frac23}\\times7a^{-\\frac13}b^{\\frac13}&=35a^0b\\\\5a^{\\frac13}b^{\\frac23}\\times7a^{-\\frac13}b^{\\frac13}&=35b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p12-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac18s^{2\\frac12}\\times24s^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3s^{\\frac12}$",
          "worked": "$$\\begin{align*}\\frac18s^{2\\frac12}\\times24s^{-2}&=3s^{\\frac52-2}\\\\\\frac18s^{2\\frac12}\\times24s^{-2}&=3s^{\\frac12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2y^3\\div x^{\\frac12}y^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac32}y^{\\frac52}$",
          "worked": "$$\\begin{align*}x^2y^3\\div x^{\\frac12}y^{\\frac12}&=x^{2-\\frac12}y^{3-\\frac12}\\\\x^2y^3\\div x^{\\frac12}y^{\\frac12}&=x^{\\frac32}y^{\\frac52}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$a^{\\frac12}b^{\\frac12}\\div a^{-\\frac12}b^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a$",
          "worked": "$$\\begin{align*}a^{\\frac12}b^{\\frac12}\\div a^{-\\frac12}b^{\\frac12}&=a^{\\frac12-(-\\frac12)}b^{\\frac12-\\frac12}\\\\a^{\\frac12}b^{\\frac12}\\div a^{-\\frac12}b^{\\frac12}&=ab^0\\\\a^{\\frac12}b^{\\frac12}\\div a^{-\\frac12}b^{\\frac12}&=a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(a^{-2}b^4\\right)^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{-1}b^2$",
          "worked": "$$\\begin{align*}\\left(a^{-2}b^4\\right)^{\\frac12}&=a^{-2\\times\\frac12}b^{4\\times\\frac12}\\\\\\left(a^{-2}b^4\\right)^{\\frac12}&=a^{-1}b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(8x^3y^{-6}\\right)^{\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2xy^{-2}$",
          "worked": "$$\\begin{align*}\\left(8x^3y^{-6}\\right)^{\\frac13}&=8^{\\frac13}x^{3\\times\\frac13}y^{-6\\times\\frac13}\\\\\\left(8x^3y^{-6}\\right)^{\\frac13}&=2xy^{-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(p^{\\frac15}q^{-\\frac35}\\right)^{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^2q^{-6}$",
          "worked": "$$\\begin{align*}\\left(p^{\\frac15}q^{-\\frac35}\\right)^{10}&=p^{\\frac15\\times10}q^{-\\frac35\\times10}\\\\\\left(p^{\\frac15}q^{-\\frac35}\\right)^{10}&=p^2q^{-6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q13-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(x^{\\frac34}\\right)^4\\times\\left(x^{\\frac43}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^7$",
          "worked": "$$\\begin{align*}\\left(x^{\\frac34}\\right)^4\\times\\left(x^{\\frac43}\\right)^3&=x^{\\frac34\\times4}x^{\\frac43\\times3}\\\\\\left(x^{\\frac34}\\right)^4\\times\\left(x^{\\frac43}\\right)^3&=x^{3+4}\\\\\\left(x^{\\frac34}\\right)^4\\times\\left(x^{\\frac43}\\right)^3&=x^7\\end{align*}$$",
