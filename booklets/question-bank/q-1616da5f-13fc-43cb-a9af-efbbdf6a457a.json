  "content": {
    "id": "p46-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "An item is discounted by 30% and then a further discount of 20% is applied to the reduced price. What is the total percentage discount?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "44% discount.",
      "worked": "Let the original cost be $x$.\n\n$$\\begin{align*}\\text{Reduced price} &= x\\times0.7\\times0.8\\\\\\text{Reduced price} &= 0.56x\\end{align*}$$\n\nThe reduced price is 56% of the original.\n\n$$\\begin{align*}\\text{Total discount} &= 100\\%-56\\%\\\\\\text{Total discount} &= 44\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
