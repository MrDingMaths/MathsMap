    "children": [
      {
        "id": "p11-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{\\log_e x}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1-\\log_e x}{x^2}$",
          "worked": "$$\\begin{aligned}y'&=\\frac{x\\left(\\frac1x\\right)-\\log_e x(1)}{x^2}\\\\y'&=\\frac{1-\\log_e x}{x^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{\\log_e x}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1-2\\log_e x}{x^3}$",
          "worked": "$$\\begin{aligned}y'&=\\frac{x^2\\left(\\frac1x\\right)-\\log_e x(2x)}{x^4}\\\\y'&=\\frac{1-2\\log_e x}{x^3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{x}{\\log_e x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{\\log_e x-1}{(\\log_e x)^2}$",
          "worked": "$$\\begin{aligned}y'&=\\frac{\\log_e x(1)-x\\left(\\frac1x\\right)}{(\\log_e x)^2}\\\\y'&=\\frac{\\log_e x-1}{(\\log_e x)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{x^2}{\\log_e x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x(2\\log_e x-1)}{(\\log_e x)^2}$",
          "worked": "$$\\begin{aligned}y'&=\\frac{\\log_e x(2x)-x^2\\left(\\frac1x\\right)}{(\\log_e x)^2}\\\\y'&=\\frac{x(2\\log_e x-1)}{(\\log_e x)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{\\log_e x}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1-x\\log_e x}{xe^x}$",
          "worked": "$$\\begin{aligned}y'&=\\frac{e^x\\left(\\frac1x\\right)-\\log_e x(e^x)}{e^{2x}}\\\\y'&=\\frac{1-x\\log_e x}{xe^x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p11-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{e^x}{\\log_e x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{e^x(x\\log_e x-1)}{x(\\log_e x)^2}$",
          "worked": "$$\\begin{aligned}y'&=\\frac{\\log_e x(e^x)-e^x\\left(\\frac1x\\right)}{(\\log_e x)^2}\\\\y'&=\\frac{e^x(x\\log_e x-1)}{x(\\log_e x)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
