  "content": {
    "id": "p73-q3",
    "type": "question",
    "label": "3",
    "prompt": "The mean mass of a team of rugby players is $95\\text{ kg}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p73-q3a",
        "type": "part",
        "label": "a",
        "prompt": "Would the mean increase or decrease if a new player of mass $80\\text{ kg}$ joined the team?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Decrease.",
          "worked": "The new player's mass of $80\\text{ kg}$ is below the current mean of $95\\text{ kg}$, so adding this player decreases the mean.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p73-q3b",
        "type": "part",
        "label": "b",
        "prompt": "Describe how the mean would change if a player of mass $95\\text{ kg}$ joins the team.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No change.",
          "worked": "The new player's mass equals the current mean, so the mean remains $95\\text{ kg}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p73-q3c",
        "type": "part",
        "label": "c",
        "prompt": "Describe how the mean would change if a player of mass $105\\text{ kg}$ joins the team.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increase.",
          "worked": "The new player's mass of $105\\text{ kg}$ is above the current mean of $95\\text{ kg}$, so adding this player increases the mean.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p73-q3d",
        "type": "part",
        "label": "d",
        "prompt": "How would the mean change if the smallest item is removed from a data set?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increases unless all values are equal; then no change, provided at least one value remains.",
          "worked": "If the values are not all equal, the smallest value is below the mean. Removing it increases the mean. If all values are equal, removing one leaves the mean unchanged, provided at least one value remains.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p73-q3e",
        "type": "part",
        "label": "e",
        "prompt": "How would the mean change if the largest item is removed from a data set?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Decreases unless all values are equal; then no change, provided at least one value remains.",
          "worked": "If the values are not all equal, the largest value is above the mean. Removing it decreases the mean. If all values are equal, removing one leaves the mean unchanged, provided at least one value remains.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
