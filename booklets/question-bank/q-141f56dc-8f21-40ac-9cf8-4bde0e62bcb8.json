  "content": {
    "id": "p6-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The angle sum of a regular polygon is $2520^{\\circ}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q8a-node",
        "type": "part",
        "label": "a",
        "prompt": "How many sides does it have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "16",
          "worked": "$$\\begin{aligned}S&=180(n-2)\\\\2520&=180(n-2)\\\\14&=n-2\\\\n&=16\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q8b-node",
        "type": "part",
        "label": "b",
        "prompt": "Find the size of each angle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$157.5^{\\circ}$",
          "worked": "The interior angles of a regular polygon are equal.\n$$\\begin{aligned}\\text{Each interior angle}&=\\frac{2520^{\\circ}}{16}\\\\&=157.5^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
