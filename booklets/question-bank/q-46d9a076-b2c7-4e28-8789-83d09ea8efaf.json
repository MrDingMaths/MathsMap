  "content": {
    "id": "p27-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The surface area of a cube is $54\\text{ cm}^2$. Find the side length of the cube.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\text{ cm}$",
      "worked": "Let $a$ cm be the side length.\n$$\\begin{align*}6a^2&=54\\\\a^2&=9\\\\a&=3\\end{align*}$$\nThe side length is $3\\text{ cm}$, since $a>0$.",
      "solutionDiagrams": []
    },
