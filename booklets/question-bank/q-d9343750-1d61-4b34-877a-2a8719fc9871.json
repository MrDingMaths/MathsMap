  "content": {
    "id": "p19-q5",
    "type": "question",
    "label": "5",
    "prompt": "The resistance, $R$ ohms, to the flow of electricity in a wire varies directly with the length, $l$ cm, of the wire and, when $l=20$ cm, $R=0.08$ ohms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $R$ when $l=85$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "0.34 ohms",
          "worked": "$$\\begin{align*}R&=kl\\\\0.08&=k\\times20\\\\k&=\\frac{0.08}{20}=0.004\\\\R&=0.004l\\\\R&=0.004\\times85\\\\R&=0.34\\end{align*}$$\nThe resistance is 0.34 ohms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $l$ when $R=6$ ohms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1500 cm",
          "worked": "Using $R=0.004l$ from part a:\n$$\\begin{align*}6&=0.004l\\\\l&=\\frac{6}{0.004}\\\\l&=1500\\end{align*}$$\nThe wire is 1500 cm long.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
