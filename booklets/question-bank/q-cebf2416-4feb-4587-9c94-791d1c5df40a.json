  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Solve each of the following equations for $\\theta\\in[0,2\\pi]$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0,\\ 2\\pi$.",
          "worked": "Cosine is 1 on the positive $x$-axis. Both endpoints belong to the interval.\n$$\\theta=0,\\ 2\\pi.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin\\theta=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{3\\pi}{2}$.",
          "worked": "Sine is $-1$ on the negative $y$-axis.\n$$\\theta=\\frac{3\\pi}{2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{\\pi}{4},\\ \\dfrac{5\\pi}{4}$.",
          "worked": "The reference angle is $\\frac{\\pi}{4}$. Tangent is positive in Quadrants I and III.\n$$\\begin{align*}\\theta&=\\frac{\\pi}{4},\\ \\pi+\\frac{\\pi}{4}\\\\\\theta&=\\frac{\\pi}{4},\\ \\frac{5\\pi}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\theta=\\dfrac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{\\pi}{3},\\ \\dfrac{5\\pi}{3}$.",
          "worked": "The reference angle is $\\frac{\\pi}{3}$. Cosine is positive in Quadrants I and IV.\n$$\\begin{align*}\\theta&=\\frac{\\pi}{3},\\ 2\\pi-\\frac{\\pi}{3}\\\\\\theta&=\\frac{\\pi}{3},\\ \\frac{5\\pi}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin\\theta=-\\dfrac{1}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{5\\pi}{4},\\ \\dfrac{7\\pi}{4}$.",
          "worked": "The reference angle is $\\frac{\\pi}{4}$. Sine is negative in Quadrants III and IV.\n$$\\begin{align*}\\theta&=\\pi+\\frac{\\pi}{4},\\ 2\\pi-\\frac{\\pi}{4}\\\\\\theta&=\\frac{5\\pi}{4},\\ \\frac{7\\pi}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan\\theta=\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{\\pi}{3},\\ \\dfrac{4\\pi}{3}$.",
          "worked": "The reference angle is $\\frac{\\pi}{3}$. Tangent is positive in Quadrants I and III.\n$$\\begin{align*}\\theta&=\\frac{\\pi}{3},\\ \\pi+\\frac{\\pi}{3}\\\\\\theta&=\\frac{\\pi}{3},\\ \\frac{4\\pi}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\cos\\theta=-\\dfrac{\\sqrt{3}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{5\\pi}{6},\\ \\dfrac{7\\pi}{6}$.",
          "worked": "The reference angle is $\\frac{\\pi}{6}$. Cosine is negative in Quadrants II and III.\n$$\\begin{align*}\\theta&=\\pi-\\frac{\\pi}{6},\\ \\pi+\\frac{\\pi}{6}\\\\\\theta&=\\frac{5\\pi}{6},\\ \\frac{7\\pi}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sin\\theta=\\dfrac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{\\pi}{6},\\ \\dfrac{5\\pi}{6}$.",
          "worked": "The reference angle is $\\frac{\\pi}{6}$. Sine is positive in Quadrants I and II.\n$$\\begin{align*}\\theta&=\\frac{\\pi}{6},\\ \\pi-\\frac{\\pi}{6}\\\\\\theta&=\\frac{\\pi}{6},\\ \\frac{5\\pi}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\tan\\theta=-\\dfrac{1}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{5\\pi}{6},\\ \\dfrac{11\\pi}{6}$.",
          "worked": "The reference angle is $\\frac{\\pi}{6}$. Tangent is negative in Quadrants II and IV.\n$$\\begin{align*}\\theta&=\\pi-\\frac{\\pi}{6},\\ 2\\pi-\\frac{\\pi}{6}\\\\\\theta&=\\frac{5\\pi}{6},\\ \\frac{11\\pi}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\cos\\theta=-\\dfrac{1}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{3\\pi}{4},\\ \\dfrac{5\\pi}{4}$.",
          "worked": "The reference angle is $\\frac{\\pi}{4}$. Cosine is negative in Quadrants II and III.\n$$\\begin{align*}\\theta&=\\pi-\\frac{\\pi}{4},\\ \\pi+\\frac{\\pi}{4}\\\\\\theta&=\\frac{3\\pi}{4},\\ \\frac{5\\pi}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$2\\sin\\theta=\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{\\pi}{3},\\ \\dfrac{2\\pi}{3}$.",
          "worked": "$$\\sin\\theta=\\frac{\\sqrt{3}}{2}.$$\nThe reference angle is $\\frac{\\pi}{3}$. Sine is positive in Quadrants I and II.\n$$\\begin{align*}\\theta&=\\frac{\\pi}{3},\\ \\pi-\\frac{\\pi}{3}\\\\\\theta&=\\frac{\\pi}{3},\\ \\frac{2\\pi}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p14-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\tan\\theta=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{3\\pi}{4},\\ \\dfrac{7\\pi}{4}$.",
          "worked": "The reference angle is $\\frac{\\pi}{4}$. Tangent is negative in Quadrants II and IV.\n$$\\begin{align*}\\theta&=\\pi-\\frac{\\pi}{4},\\ 2\\pi-\\frac{\\pi}{4}\\\\\\theta&=\\frac{3\\pi}{4},\\ \\frac{7\\pi}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
