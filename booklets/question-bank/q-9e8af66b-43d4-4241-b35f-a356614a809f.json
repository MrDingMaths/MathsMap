  "content": {
    "id": "v2-4505d-p26-practice-slot-12-root",
    "type": "question",
    "label": null,
    "prompt": "Complete the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4505d-p26-practice-slot-12-slot-12-q-a",
        "type": "part",
        "label": "a",
        "prompt": "If $\\alpha,\\beta,\\gamma,$ and $\\delta$ are the roots of $x^4-3x^3+2x^2-5x+1=0$, find $(\\alpha+1)^2+(\\beta+1)^2+(\\gamma+1)^2+(\\delta+1)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}\\alpha+\\beta+\\gamma+\\delta&=-\\frac{-3}{1}=3\\\\\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta&=\\frac21=2\\end{align*}$$\n$$\\begin{align*}\\alpha^2+\\beta^2+\\gamma^2+\\delta^2&=(\\alpha+\\beta+\\gamma+\\delta)^2\\\\&\\quad-2(\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta)\\\\&=3^2-2(2)\\\\&=5\\end{align*}$$\n$$\\begin{align*}(\\alpha+1)^2+(\\beta+1)^2+(\\gamma+1)^2+(\\delta+1)^2&=(\\alpha^2+\\beta^2+\\gamma^2+\\delta^2)\\\\&\\quad+2(\\alpha+\\beta+\\gamma+\\delta)+4\\\\&=5+2(3)+4\\\\&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-4505d-p26-practice-slot-12-slot-12-q-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\alpha,\\beta,\\gamma,$ and $\\delta$ are the roots of $2x^4+6x^3-x^2+3x-4=0$, find $(\\alpha-2)^2+(\\beta-2)^2+(\\gamma-2)^2+(\\delta-2)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$38$",
          "worked": "$$\\begin{align*}\\alpha+\\beta+\\gamma+\\delta&=-\\frac62=-3\\\\\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta&=-\\frac12\\end{align*}$$\n$$\\begin{align*}\\alpha^2+\\beta^2+\\gamma^2+\\delta^2&=(\\alpha+\\beta+\\gamma+\\delta)^2\\\\&\\quad-2(\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta)\\\\&=(-3)^2-2\\left(-\\frac12\\right)\\\\&=10\\end{align*}$$\n$$\\begin{align*}(\\alpha-2)^2+(\\beta-2)^2+(\\gamma-2)^2+(\\delta-2)^2&=(\\alpha^2+\\beta^2+\\gamma^2+\\delta^2)\\\\&\\quad-4(\\alpha+\\beta+\\gamma+\\delta)+16\\\\&=10-4(-3)+16\\\\&=38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
