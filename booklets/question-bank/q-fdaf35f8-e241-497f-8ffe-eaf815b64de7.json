  "content": {
    "id": "p15-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the least positive integer value of $n$ for which:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^n>30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=4$",
          "worked": "$$\\begin{align*}3^3&=27<30\\\\3^4&=81>30\\end{align*}$$\nThe least value is $n=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^n>50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=6$",
          "worked": "$$\\begin{align*}2^5&=32<50\\\\2^6&=64>50\\end{align*}$$\nThe least value is $n=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$5^n>1000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=5$",
          "worked": "$$\\begin{align*}5^4&=625<1000\\\\5^5&=3125>1000\\end{align*}$$\nThe least value is $n=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{2^n}<\\frac{1}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=4$",
          "worked": "$$\\begin{align*}\\frac{1}{2^3}&=\\frac18>\\frac1{10}\\\\\\frac{1}{2^4}&=\\frac1{16}<\\frac1{10}\\end{align*}$$\nThe least value is $n=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{3^n}<\\frac{1}{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=5$",
          "worked": "$$\\begin{align*}\\frac{1}{3^4}&=\\frac1{81}>\\frac1{100}\\\\\\frac{1}{3^5}&=\\frac1{243}<\\frac1{100}\\end{align*}$$\nThe least value is $n=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1}{5^n}<\\frac{1}{1000}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=5$",
          "worked": "$$\\begin{align*}\\frac{1}{5^4}&=\\frac1{625}>\\frac1{1000}\\\\\\frac{1}{5^5}&=\\frac1{3125}<\\frac1{1000}\\end{align*}$$\nThe least value is $n=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
