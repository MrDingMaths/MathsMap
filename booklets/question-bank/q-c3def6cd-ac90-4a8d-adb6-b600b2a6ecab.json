    "difficultyReason": "Convert an annual salary to monthly and fortnightly pay using the supplied formula."
  },
  "content": {
    "id": "p32-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Amy earns \\$19 884.80 per annum for part-time work. Round to the nearest cent where necessary. Find how much she earns:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q5-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p32-q5-a-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Per month",
                  "marks": []
                }
              ]
            },
            {
              "id": "p32-q5-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\text{Pay per period}=\\frac{\\text{Total pay}}{\\text{Number of periods}}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1657.07 per month.",
          "worked": "$$\\begin{align*}\\text{Monthly pay}&=\\frac{\\text{Total pay}}{\\text{Number of periods}}\\\\\\text{Monthly pay}&=\\frac{\\$19\\,884.80}{12}\\\\\\text{Monthly pay}&\\approx\\$1657.07\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Per fortnight",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$764.80 per fortnight.",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay}&=\\frac{\\text{Total pay}}{\\text{Number of periods}}\\\\\\text{Fortnightly pay}&=\\frac{\\$19\\,884.80}{26}\\\\\\text{Fortnightly pay}&=\\$764.80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
