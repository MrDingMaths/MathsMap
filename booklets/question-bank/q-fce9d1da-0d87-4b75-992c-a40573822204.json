  "content": {
    "id": "p9-q39-content",
    "type": "question",
    "label": null,
    "prompt": "Let $y = 4e^{x} - 2x$. Find the equation of the normal to the curve at $x = 0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
