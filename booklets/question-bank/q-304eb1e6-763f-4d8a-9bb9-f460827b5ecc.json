  "content": {
    "id": "p15-q17-root",
    "type": "question",
    "label": null,
    "prompt": "Determine whether the following statements are true or false.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(180^\\circ+\\beta)=-\\sin(\\beta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The related-angle identity is $\\sin(180^\\circ+\\beta)=-\\sin\\beta$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos(90^\\circ-\\beta)=\\sin\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Cosine of the complementary angle equals sine of the angle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\beta=\\cot(90^\\circ-\\beta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. $$\\begin{align*}\\cot(90^\\circ-\\beta)&=\\frac{\\cos(90^\\circ-\\beta)}{\\sin(90^\\circ-\\beta)}\\\\\\cot(90^\\circ-\\beta)&=\\frac{\\sin\\beta}{\\cos\\beta}\\\\\\cot(90^\\circ-\\beta)&=\\tan\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos(180^\\circ-\\beta)=-\\sin\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. The correct identity is $\\cos(180^\\circ-\\beta)=-\\cos\\beta$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q17-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cot(180^\\circ-\\beta)\\tan(360^\\circ-\\beta)<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}\\cot(180^\\circ-\\beta)\\tan(360^\\circ-\\beta)&=(-\\cot\\beta)(-\\tan\\beta)\\\\\\cot(180^\\circ-\\beta)\\tan(360^\\circ-\\beta)&=1\\end{align*}$$The product is positive, so the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q17-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\sec(-\\beta)}{\\cos(360^\\circ-\\beta)}>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}\\frac{\\sec(-\\beta)}{\\cos(360^\\circ-\\beta)}&=\\frac{\\sec\\beta}{\\cos\\beta}\\\\\\frac{\\sec(-\\beta)}{\\cos(360^\\circ-\\beta)}&=\\frac{1}{\\cos^2\\beta}>0\\end{align*}$$The statement is true wherever the expression is defined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
