              "type": "text",
              "text": "Seb buys a book for $12 and sells it for $15. He works out his percentage profit:",
              "marks": []
            }
          ]
        },
        {
          "id": "p60-q15-demonstration-profit",
          "type": "paragraph",
          "fontSize": null,
