          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\text{Profit}=15-12=3",
              "display": false
            }
          ]
        },
        {
          "id": "p60-q15-demonstration-percentage",
          "type": "paragraph",
          "fontSize": null,
