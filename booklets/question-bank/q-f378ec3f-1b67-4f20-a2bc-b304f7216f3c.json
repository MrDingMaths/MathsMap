  "content": {
    "id": "p19-practice-1-root",
    "type": "question",
    "label": "",
    "prompt": "The 6th term of an arithmetic sequence is 23 and the sum of the first 10 terms is 210.\nFind the sum of the first 20 terms of the sequence.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$820$",
      "worked": "Let $a$ be the first term and $d$ the common difference.\n$$\\begin{aligned}a+5d&=23&&\\text{(1)}\\\\\\frac{10}{2}[2a+9d]&=210\\\\2a+9d&=42&&\\text{(2)}\\end{aligned}$$\nTwice (1) gives $2a+10d=46$. Subtracting (2):\n$$\\begin{align*}d&=4\\\\a&=23-5(4)\\\\a&=3\\\\S_{20}&=\\frac{20}{2}[2(3)+(20-1)(4)]\\\\S_{20}&=10(82)\\\\S_{20}&=820\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 59
  },
