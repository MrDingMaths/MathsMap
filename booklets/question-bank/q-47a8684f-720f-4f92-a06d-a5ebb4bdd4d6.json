  "content": {
    "id": "p15-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $\\alpha,\\beta,$ and $\\gamma$ are the roots of $x^3+2x^2-11x-12=0$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta+\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$\\alpha+\\beta+\\gamma=-\\dfrac b a=-\\dfrac21=-2$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-11$",
          "worked": "$\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma=\\dfrac ca=\\dfrac{-11}{1}=-11$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha\\beta\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$\\alpha\\beta\\gamma=-\\dfrac da=-\\dfrac{-12}{1}=12$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac1\\alpha+\\dfrac1\\beta+\\dfrac1\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{11}{12}$",
          "worked": "$\\begin{aligned}\\frac1\\alpha+\\frac1\\beta+\\frac1\\gamma&=\\frac{\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma}{\\alpha\\beta\\gamma}\\\\&=-\\frac{11}{12}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac1{\\alpha\\beta}+\\dfrac1{\\alpha\\gamma}+\\dfrac1{\\beta\\gamma}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac16$",
          "worked": "$\\begin{aligned}\\frac1{\\alpha\\beta}+\\frac1{\\alpha\\gamma}+\\frac1{\\beta\\gamma}&=\\frac{\\alpha+\\beta+\\gamma}{\\alpha\\beta\\gamma}\\\\&=\\frac{-2}{12}\\\\&=-\\frac16\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\alpha+1)(\\beta+1)(\\gamma+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$\\begin{aligned}(\\alpha+1)(\\beta+1)(\\gamma+1)&=\\alpha\\beta\\gamma+(\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma)\\\\&\\quad +(\\alpha+\\beta+\\gamma)+1\\\\&=12-11-2+1\\\\&=0\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p15-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\alpha^2\\beta^2\\gamma+\\alpha^2\\gamma^2\\beta+\\beta^2\\gamma^2\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-132$",
          "worked": "$\\begin{aligned}\\alpha^2\\beta^2\\gamma+\\alpha^2\\gamma^2\\beta+\\beta^2\\gamma^2\\alpha&=\\alpha\\beta\\gamma(\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma)\\\\&=12(-11)\\\\&=-132\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\alpha^2+\\beta^2+\\gamma^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26$",
          "worked": "$\\begin{aligned}\\alpha^2+\\beta^2+\\gamma^2&=(\\alpha+\\beta+\\gamma)^2\\\\&\\quad-2(\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma)\\\\&=(-2)^2-2(-11)\\\\&=26\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$(\\alpha\\beta)^{-2}+(\\alpha\\gamma)^{-2}+(\\beta\\gamma)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13}{72}$",
          "worked": "$\\begin{aligned}(\\alpha\\beta)^{-2}+(\\alpha\\gamma)^{-2}+(\\beta\\gamma)^{-2}&=\\frac{\\gamma^2+\\beta^2+\\alpha^2}{(\\alpha\\beta\\gamma)^2}\\\\&=\\frac{26}{12^2}\\\\&=\\frac{13}{72}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
