    "children": [
      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{2x}{3}+1\\right)\\left(\\frac{2x}{3}-1\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x^2}{9}-1$",
          "worked": "$$\\begin{align*}\\left(\\frac{2x}{3}+1\\right)\\left(\\frac{2x}{3}-1\\right)&=\\left(\\frac{2x}{3}\\right)^2-1^2\\\\\\left(\\frac{2x}{3}+1\\right)\\left(\\frac{2x}{3}-1\\right)&=\\frac{4x^2}{9}-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p24-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{x}{2}+3\\right)\\left(\\frac{x}{2}-3\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{4}-9$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{2}+3\\right)\\left(\\frac{x}{2}-3\\right)&=\\left(\\frac{x}{2}\\right)^2-3^2\\\\\\left(\\frac{x}{2}+3\\right)\\left(\\frac{x}{2}-3\\right)&=\\frac{x^2}{4}-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p24-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{x}{3}+\\frac{1}{2}\\right)\\left(\\frac{x}{3}-\\frac{1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{9}-\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{3}+\\frac{1}{2}\\right)\\left(\\frac{x}{3}-\\frac{1}{2}\\right)&=\\left(\\frac{x}{3}\\right)^2-\\left(\\frac{1}{2}\\right)^2\\\\\\left(\\frac{x}{3}+\\frac{1}{2}\\right)\\left(\\frac{x}{3}-\\frac{1}{2}\\right)&=\\frac{x^2}{9}-\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{2x}{5}+\\frac{3}{4}\\right)\\left(\\frac{2x}{5}-\\frac{3}{4}\\right)$",
