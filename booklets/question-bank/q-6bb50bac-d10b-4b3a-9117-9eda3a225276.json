  "content": {
    "id": "p42-q16",
    "type": "question",
    "label": "16",
    "prompt": "Explain why, for an odd function, a vertical reflection is the same as a horizontal reflection.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Since $f(-x)=-f(x)$, a vertical reflection is the same as a horizontal reflection.",
      "worked": "A horizontal reflection replaces $x$ with $-x$, giving $y=f(-x)$. A vertical reflection replaces $y$ with $-y$, giving $y=-f(x)$. For an odd function, $f(-x)=-f(x)$, so these are the same graph.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
