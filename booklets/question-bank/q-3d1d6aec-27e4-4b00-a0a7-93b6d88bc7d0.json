  "content": {
    "id": "p28-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find, in terms of $x$, an expression for the limiting sum of the series on the LHS of each equation. Then solve the equation to find $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$5+5x+5x^2+\\cdots=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=\\dfrac{5}{1-x}$ for $|x|<1$; $x=\\dfrac12$.",
          "worked": "$a=5$, $r=x$.\n$$\\begin{align*}S_\\infty&=\\frac{a}{1-r}\\\\&=\\frac{5}{1-x}\\end{align*}$$\n$$\\begin{align*}\\frac{5}{1-x}&=10\\\\5&=10-10x\\\\10x&=5\\\\x&=\\frac12\\end{align*}$$\nSince $\\left|\\frac12\\right|<1$, the limiting sum exists.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p28-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$5-5x+5x^2-\\cdots=15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=\\dfrac{5}{1+x}$ for $|x|<1$; $x=-\\dfrac23$.",
          "worked": "$a=5$, $r=-x$.\n$$\\begin{align*}S_\\infty&=\\frac{a}{1-r}\\\\&=\\frac{5}{1-(-x)}\\\\&=\\frac{5}{1+x}\\end{align*}$$\n$$\\begin{align*}\\frac{5}{1+x}&=15\\\\5&=15+15x\\\\15x&=-10\\\\x&=-\\frac23\\end{align*}$$\nHere $r=\\frac23$, so $|r|<1$ and the limiting sum exists.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p28-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$x+\\dfrac{x}{3}+\\dfrac{x}{9}+\\cdots=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=\\dfrac{3x}{2}$; $x=\\dfrac43$.",
          "worked": "$a=x$, $r=\\frac13$, so $|r|<1$.\n$$\\begin{align*}S_\\infty&=\\frac{x}{1-\\frac13}\\\\&=\\frac{3x}{2}\\end{align*}$$\n$$\\begin{align*}\\frac{3x}{2}&=2\\\\3x&=4\\\\x&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p28-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$x-\\dfrac{x}{3}+\\dfrac{x}{9}-\\cdots=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=\\dfrac{3x}{4}$; $x=\\dfrac83$.",
          "worked": "$a=x$, $r=-\\frac13$, so $|r|<1$.\n$$\\begin{align*}S_\\infty&=\\frac{x}{1-\\left(-\\frac13\\right)}\\\\&=\\frac{3x}{4}\\end{align*}$$\n$$\\begin{align*}\\frac{3x}{4}&=2\\\\3x&=8\\\\x&=\\frac83\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
