  "content": {
    "id": "p22-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Do not use a calculator.\n\nUse the log law $\\log_a x^n=n\\log_a x$ to write each expression in terms of $\\log_a x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\log_a x$",
          "worked": "$$\\log_a x^3=3\\log_a x$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p22-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a\\frac1x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\frac1x&=\\log_a x^{-1}\\\\\\log_a\\frac1x&=-\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a\\sqrt x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\sqrt x&=\\log_a x^{1/2}\\\\\\log_a\\sqrt x&=\\frac12\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_a\\frac1{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\frac1{x^2}&=\\log_a x^{-2}\\\\\\log_a\\frac1{x^2}&=-2\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_a x^3-\\log_a x^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a x^3-\\log_a x^5&=3\\log_a x-5\\log_a x\\\\\\log_a x^3-\\log_a x^5&=-2\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a x^4+\\log_a\\frac1{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a x^4+\\log_a\\frac1{x^2}&=4\\log_a x-2\\log_a x\\\\\\log_a x^4+\\log_a\\frac1{x^2}&=2\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$2\\log_a a^4-\\log_a x^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8-8\\log_a x$",
          "worked": "$$\\begin{align*}2\\log_a a^4-\\log_a x^8&=8\\log_a a-8\\log_a x\\\\2\\log_a a^4-\\log_a x^8&=8-8\\log_a x\\end{align*}$$\nHere $\\log_a a=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p22-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_a\\frac1{\\sqrt x}+3\\log_a\\sqrt x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\frac1{\\sqrt x}+3\\log_a\\sqrt x&=\\log_a x^{-1/2}+3\\log_a x^{1/2}\\\\\\log_a\\frac1{\\sqrt x}+3\\log_a\\sqrt x&=-\\frac12\\log_a x+\\frac32\\log_a x\\\\\\log_a\\frac1{\\sqrt x}+3\\log_a\\sqrt x&=\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
