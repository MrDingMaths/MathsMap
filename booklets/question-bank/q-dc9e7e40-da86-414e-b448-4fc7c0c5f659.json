  "content": {
    "id": "p18-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Calculate the following products, and write each result using scientific notation:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2\\times10^2)\\times(3\\times10^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\times10^5$",
          "worked": "$$\\begin{align*}(2\\times10^2)\\times(3\\times10^3)&=(2\\times3)\\times10^{2+3}\\\\(2\\times10^2)\\times(3\\times10^3)&=6\\times10^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$(5\\times10^6)\\times(3\\times10^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5\\times10^9$",
          "worked": "$$\\begin{align*}(5\\times10^6)\\times(3\\times10^2)&=(5\\times3)\\times10^{6+2}\\\\(5\\times10^6)\\times(3\\times10^2)&=15\\times10^8\\\\(5\\times10^6)\\times(3\\times10^2)&=1.5\\times10^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1.9\\times10^3)\\times(2\\times10^5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.8\\times10^8$",
          "worked": "$$\\begin{align*}(1.9\\times10^3)\\times(2\\times10^5)&=(1.9\\times2)\\times10^{3+5}\\\\(1.9\\times10^3)\\times(2\\times10^5)&=3.8\\times10^8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$(4.2\\times10^2)\\times(3\\times10^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.26\\times10^6$",
          "worked": "$$\\begin{align*}(4.2\\times10^2)\\times(3\\times10^3)&=(4.2\\times3)\\times10^{2+3}\\\\(4.2\\times10^2)\\times(3\\times10^3)&=12.6\\times10^5\\\\(4.2\\times10^2)\\times(3\\times10^3)&=1.26\\times10^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$34\\,000\\times20\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.8\\times10^8$",
          "worked": "$$\\begin{align*}34\\,000\\times20\\,000&=(3.4\\times10^4)\\times(2\\times10^4)\\\\34\\,000\\times20\\,000&=(3.4\\times2)\\times10^{4+4}\\\\34\\,000\\times20\\,000&=6.8\\times10^8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$4\\,000\\,000\\times160\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.4\\times10^{11}$",
          "worked": "$$\\begin{align*}4\\,000\\,000\\times160\\,000&=(4\\times10^6)\\times(1.6\\times10^5)\\\\4\\,000\\,000\\times160\\,000&=(4\\times1.6)\\times10^{6+5}\\\\4\\,000\\,000\\times160\\,000&=6.4\\times10^{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
