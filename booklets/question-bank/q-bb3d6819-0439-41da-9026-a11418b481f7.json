      {
        "id": "p37-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $p=\\frac23$ or $p=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\frac23$ or $p=1$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "f96af4be-8b06-42b5-97d2-dc6becb4beb4",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The probabilities sum to 1.",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{align*}0.2+0.6p^2+0.1+1-p+0.1&=1\\\\0.6p^2-p+0.4&=0\\\\6p^2-10p+4&=0\\\\3p^2-5p+2&=0\\\\(p-1)(3p-2)&=0\\end{align*}",
                    "display": true
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Therefore ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "p=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " or ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "p=\\frac23",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p37-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $p=\\frac23$, calculate $E(X)$ in exact form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{28}{15}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "a45f69e8-1171-433a-9d5a-da69b2b9a585",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "p=\\frac23",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "P(X=1)=0.6\\left(\\frac23\\right)^2=\\frac4{15}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "P(X=3)=1-\\frac23=\\frac13",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{align*}E(X)&=0\\left(\\frac15\\right)+1\\left(\\frac4{15}\\right)+2\\left(\\frac1{10}\\right)+3\\left(\\frac13\\right)+4\\left(\\frac1{10}\\right)\\\\E(X)&=\\frac4{15}+\\frac15+1+\\frac25\\\\E(X)&=\\frac{28}{15}\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p37-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $P(X\\ge E(X))$ for $p=\\frac23$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac8{15}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "4878bb85-71e6-431f-882e-9e142a563420",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "E(X)=\\frac{28}{15}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", the outcomes satisfying ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "X\\ge E(X)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " are 2, 3 and 4. Using ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "p=\\frac23",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ",",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{align*}P\\left(X\\ge\\frac{28}{15}\\right)&=P(X=2)+P(X=3)+P(X=4)\\\\P\\left(X\\ge\\frac{28}{15}\\right)&=\\frac1{10}+\\frac13+\\frac1{10}\\\\P\\left(X\\ge\\frac{28}{15}\\right)&=\\frac8{15}\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
