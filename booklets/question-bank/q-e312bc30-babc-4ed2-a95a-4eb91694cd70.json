  "content": {
    "id": "p44-q3",
    "type": "question",
    "label": "3",
    "prompt": "Consider $J=\\int x\\sqrt{x+1}\\,dx$, with $x=u^2-1$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $dx=2u\\,du$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$dx=2u\\,du$.",
          "worked": "$$\\begin{aligned}x&=u^2-1\\\\\\frac{dx}{du}&=2u\\\\dx&=2u\\,du\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p44-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $J=2\\int(u^4-u^2)\\,du$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$J=2\\int(u^4-u^2)\\,du$.",
          "worked": "Take $u\\geq0$, so $\\sqrt{x+1}=u$.\n$$\\begin{aligned}J&=\\int(u^2-1)u(2u)\\,du\\\\&=2\\int(u^4-u^2)\\,du\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p44-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find $J$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$J=\\frac25(x+1)^{5/2}-\\frac23(x+1)^{3/2}+C$.",
          "worked": "$$\\begin{aligned}J&=2\\left(\\frac{u^5}{5}-\\frac{u^3}{3}\\right)+C\\\\&=\\frac25u^5-\\frac23u^3+C\\\\&=\\frac25(x+1)^{5/2}-\\frac23(x+1)^{3/2}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p44-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Check by differentiating.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dJ}{dx}=x\\sqrt{x+1}$, as required.",
          "worked": "$$\\begin{aligned}\\frac{dJ}{dx}&=\\frac{d}{dx}\\left[\\frac25(x+1)^{5/2}-\\frac23(x+1)^{3/2}+C\\right]\\\\&=(x+1)^{3/2}-(x+1)^{1/2}\\\\&=\\sqrt{x+1}\\bigl((x+1)-1\\bigr)\\\\&=x\\sqrt{x+1}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
