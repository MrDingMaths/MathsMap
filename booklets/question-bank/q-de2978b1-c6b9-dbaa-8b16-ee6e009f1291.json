  "content": {
    "id": "p47-q70-group-root",
    "type": "question",
    "label": "21",
    "prompt": "Let $A$ be a subset of $\\mathbb R$. Define the following.\n$$\\begin{aligned}\\max A&=x\\in A\\text{ where }x\\ge a\\text{ for any }a\\in A\\\\\\min A&=x\\in A\\text{ where }x\\le a\\text{ for any }a\\in A\\end{aligned}$$\nFind",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q70-response",
        "type": "part",
        "label": "a",
        "prompt": "$\\max\\{-2,7,10\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$10$ belongs to the set and is at least every other element. Hence $\\max\\{-2,7,10\\}=10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p47-q71-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\min\\{-4,9,-9,8\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9$",
          "worked": "$-9$ belongs to the set and is no greater than any other element. Hence $\\min\\{-4,9,-9,8\\}=-9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p47-q72-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\max[-1,4]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "The closed interval includes $4$, and every member is at most $4$. Thus $\\max[-1,4]=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p47-q73-response",
        "type": "part",
        "label": "d",
        "prompt": "$\\min[-5,7]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "The closed interval includes $-5$, and every member is at least $-5$. Thus $\\min[-5,7]=-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
