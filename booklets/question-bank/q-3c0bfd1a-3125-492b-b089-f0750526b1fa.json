  "content": {
    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The mean height for a group of students is 180 cm with a standard deviation of 6 cm. What is Julie’s standardised score (z-score) if her height is 171 cm?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-1.5$",
      "worked": "$$\\begin{aligned}z&=\\frac{x-\\mu}{\\sigma}\\\\z&=\\frac{171-180}{6}\\\\z&=-1.5\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
