          "short": "$13$",
          "worked": "$$\\begin{align*}3(a-b)+4&=3(6-3)+4\\\\3(a-b)+4&=3\\times3+4\\\\3(a-b)+4&=9+4\\\\3(a-b)+4&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
