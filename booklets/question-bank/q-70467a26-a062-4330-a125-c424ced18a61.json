        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}3+2(a-b)&=3+2(6-3)\\\\3+2(a-b)&=3+2\\times3\\\\3+2(a-b)&=3+6\\\\3+2(a-b)&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
