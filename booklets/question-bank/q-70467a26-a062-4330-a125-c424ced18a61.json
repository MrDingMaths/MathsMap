          "short": "$10$",
          "worked": "$$\\begin{align*}b(a-3)+1&=3(6-3)+1\\\\b(a-3)+1&=3\\times3+1\\\\b(a-3)+1&=9+1\\\\b(a-3)+1&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q5-f",
