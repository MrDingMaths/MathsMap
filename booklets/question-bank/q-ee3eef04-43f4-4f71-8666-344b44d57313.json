    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q11-a-node",
        "type": "part",
        "label": "a",
        "prompt": "Given a cubic polynomial $P(x)=ax^3+bx^2+cx+d$, let $Q(x)=x^3P\\left(\\frac{1}{x}\\right)$. Find a fully simplified expression for $Q(x)$. What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(x)=dx^3+cx^2+bx+a$.\n\nThe order of the coefficients is reversed.",
          "worked": "$$\\begin{align*}Q(x)&=x^3P\\left(\\frac{1}{x}\\right)\\\\Q(x)&=x^3\\left(\\frac{a}{x^3}+\\frac{b}{x^2}+\\frac{c}{x}+d\\right)\\\\Q(x)&=a+bx+cx^2+dx^3\\\\Q(x)&=dx^3+cx^2+bx+a.\\end{align*}$$\nThe order of the coefficients is reversed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p17-q11-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Suppose the cubic polynomial $P(x)=ax^3+bx^2+cx+d$ has non-zero roots $p,q,r$. Find a cubic polynomial with roots $\\frac{1}{p},\\frac{1}{q},\\frac{1}{r}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(x)=dx^3+cx^2+bx+a$.\n\nUse $Q(x)=x^3P(\\frac{1}{x})$ to replace each non-zero root by its reciprocal.",
          "worked": "Take $Q(x)=x^3P(\\frac{1}{x})$. By part (a),\n$$Q(x)=dx^3+cx^2+bx+a.$$\nFor any root $t\\in\\{p,q,r\\}$,\n$$\\begin{align*}Q\\left(\\frac{1}{t}\\right)&=\\frac{1}{t^3}P(t)\\\\Q\\left(\\frac{1}{t}\\right)&=0.\\end{align*}$$\nThus the roots are $\\frac{1}{p},\\frac{1}{q},\\frac{1}{r}$. Also $d=-apqr\\ne0$, so $Q$ is cubic.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
