  "content": {
    "id": "p18-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Suppose that $k\\ne0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q17a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x^2+kx+k^2=0$ has no solutions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=-3k^2<0$, so there are no real solutions.",
          "worked": "Since $k\\ne0$, $k^2>0$.\n$$\\begin{align*}\\Delta&=k^2-4(1)(k^2)\\\\\\Delta&=k^2-4k^2\\\\\\Delta&=-3k^2<0.\\end{align*}$$\nTherefore, there are no real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q17b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $x^2+kx-k^2=0$ has two solutions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=5k^2>0$, so there are two distinct real solutions.",
          "worked": "Since $k\\ne0$, $k^2>0$.\n$$\\begin{align*}\\Delta&=k^2-4(1)(-k^2)\\\\\\Delta&=k^2+4k^2\\\\\\Delta&=5k^2>0.\\end{align*}$$\nTherefore, there are two distinct real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q17c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $x^2+2kx+k^2=0$ has one solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=0$, so there is one real solution.",
          "worked": "$$\\begin{align*}\\Delta&=(2k)^2-4(1)(k^2)\\\\\\Delta&=4k^2-4k^2\\\\\\Delta&=0.\\end{align*}$$\nTherefore, there is one real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
