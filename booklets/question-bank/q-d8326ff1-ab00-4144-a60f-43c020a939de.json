  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "",
    "prompt": "Let the roots of $4x^2-5x-1=0$ be $\\alpha$ and $\\beta$. Find the value of the following, without explicitly solving for $\\alpha$ and $\\beta$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac54$",
          "worked": "$\\begin{aligned}\\alpha+\\beta&=-\\frac{b}{a}\\\\&=-\\frac{-5}{4}\\\\&=\\frac54\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p6-q3b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac14$",
          "worked": "$\\begin{aligned}\\alpha\\beta&=\\frac{c}{a}\\\\&=-\\frac14\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p6-q3c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac1\\alpha+\\dfrac1\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$\\begin{aligned}\\frac1\\alpha+\\frac1\\beta&=\\frac{\\alpha+\\beta}{\\alpha\\beta}\\\\&=\\frac{\\frac{5}{4}}{-\\frac{1}{4}}\\\\&=-5\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q3d",
        "type": "part",
        "label": "d",
        "prompt": "$(\\alpha-3)(\\beta-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$\\begin{aligned}(\\alpha-3)(\\beta-3)&=\\alpha\\beta-3(\\alpha+\\beta)+9\\\\&=-\\frac14-3\\left(\\frac54\\right)+9\\\\&=-\\frac14-\\frac{15}{4}+\\frac{36}{4}\\\\&=5\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p6-q3e",
        "type": "part",
        "label": "e",
        "prompt": "$\\alpha^2+\\beta^2+2\\alpha\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{16}$",
          "worked": "$\\begin{aligned}\\alpha^2+\\beta^2+2\\alpha\\beta&=(\\alpha+\\beta)^2\\\\&=\\left(\\frac54\\right)^2\\\\&=\\frac{25}{16}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3f",
        "type": "part",
        "label": "f",
        "prompt": "$\\alpha^2\\beta+\\beta^2\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac5{16}$",
          "worked": "$\\begin{aligned}\\alpha^2\\beta+\\beta^2\\alpha&=\\alpha\\beta(\\alpha+\\beta)\\\\&=-\\frac14\\times\\frac54\\\\&=-\\frac5{16}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
