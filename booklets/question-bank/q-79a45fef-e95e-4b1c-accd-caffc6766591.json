    "answer": {
      "short": "\\$918.50",
      "worked": "$$\\begin{align*}\\text{Hours per day} &= 40\\div5=8\\\\\\text{Normal pay} &= 21.40\\times8\\times5=\\$856.00\\\\\\text{Allowance} &= 12.50\\times5=\\$62.50\\\\\\text{Total pay} &= 856.00+62.50=\\$918.50\\end{align*}$$",
