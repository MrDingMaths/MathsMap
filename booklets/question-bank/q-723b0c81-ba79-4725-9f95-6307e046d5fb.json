  "content": {
    "id": "p18-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The perimeter $P$ of a semicircle of radius $r$ is given by the formula $P=\\pi r+2r$. Find $r$, correct to two decimal places, if $P=15$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$r=2.92$",
      "worked": "$$\\begin{align*}15&=\\pi r+2r\\\\15&=(\\pi+2)r\\\\r&=\\frac{15}{\\pi+2}\\\\r&\\approx2.92\\end{align*}$$\nCorrect to two decimal places.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
