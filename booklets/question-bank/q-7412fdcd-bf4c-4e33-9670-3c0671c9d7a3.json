                "inlines": [
                  {
                    "type": "text",
                    "text": "Apply the addition rule twice, using ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(A\\cup B)\\cap C=(A\\cap C)\\cup(B\\cap C)",
                    "display": false
                  },
