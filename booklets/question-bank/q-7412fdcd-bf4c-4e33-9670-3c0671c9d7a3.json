                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Apply the addition rule to $A\\cup B$. Also, $(A\\cup B)\\cap C=(A\\cap C)\\cup(B\\cap C)$.\n\n$$\\begin{align*}P(A\\cup B)&=0.50+0.45-0.20\\\\P(A\\cup B)&=0.75\\\\P((A\\cup B)\\cap C)&=0.15+0.10-P(A\\cap B\\cap C)\\\\P((A\\cup B)\\cap C)&=0.25-P(A\\cap B\\cap C)\\\\P(A\\cup B\\cup C)&=0.75+0.40-\\bigl(0.25-P(A\\cap B\\cap C)\\bigr)\\\\P(A\\cup B\\cup C)&=0.9+P(A\\cap B\\cap C).\\end{align*}$$",
          "solutionDiagrams": []
        },
