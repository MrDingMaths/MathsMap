  "content": {
    "id": "p32-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Show that the projection of $\\underset{\\sim}{a}=\\begin{pmatrix}10\\\\-2\\end{pmatrix}$ onto $\\underset{\\sim}{b}=\\begin{pmatrix}1\\\\-7\\end{pmatrix}$ has length $\\dfrac{12\\sqrt2}{5}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\left|\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}\\right|=\\dfrac{24}{5\\sqrt2}=\\dfrac{12\\sqrt2}{5}$",
      "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=10(1)+(-2)(-7)=24\\\\|\\underset{\\sim}{b}|&=\\sqrt{1^2+(-7)^2}=\\sqrt{50}=5\\sqrt2\\\\\\left|\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}\\right|&=\\frac{|\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}|}{|\\underset{\\sim}{b}|}\\\\\\left|\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}\\right|&=\\frac{24}{5\\sqrt2}\\\\\\left|\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}\\right|&=\\frac{24\\sqrt2}{10}\\\\\\left|\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}\\right|&=\\frac{12\\sqrt2}{5}\\end{aligned}$$",
      "solutionDiagrams": []
    },
