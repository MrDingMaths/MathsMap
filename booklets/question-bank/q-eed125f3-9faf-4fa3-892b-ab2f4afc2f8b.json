        "prompt": "6 magazines, if 8 magazines cost $\\$100$ (assuming that all the magazines have the same price)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$75$",
          "worked": "$$\\begin{align*}\\text{Cost of 1 magazine}&=\\$100\\div8=\\$12.50\\\\\\text{Cost of 6 magazines}&=6\\times\\$12.50=\\$75\\end{align*}$$",
