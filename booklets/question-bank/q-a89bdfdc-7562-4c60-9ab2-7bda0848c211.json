  "content": {
    "id": "p9-q6-root",
    "type": "question",
    "label": null,
    "prompt": "Differentiate the following by using the fact that $e^{\\ln x}=x$ for $x>0$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$e^{\\ln(x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}e^{\\ln x}&=x\\\\ \\frac{d}{dx}(e^{\\ln x})&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$e^{-\\ln(x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{x^2}$",
          "worked": "$$\\begin{align*}e^{-\\ln x}&=(e^{\\ln x})^{-1}\\\\ e^{-\\ln x}&=x^{-1}\\\\ \\frac{d}{dx}(e^{-\\ln x})&=-x^{-2}\\\\ \\frac{d}{dx}(e^{-\\ln x})&=-\\frac{1}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$e^{2\\ln(x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$",
          "worked": "$$\\begin{align*}e^{2\\ln x}&=(e^{\\ln x})^2\\\\ e^{2\\ln x}&=x^2\\\\ \\frac{d}{dx}(e^{2\\ln x})&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$e^{0.5\\ln(x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2\\sqrt{x}}$",
          "worked": "$$\\begin{align*}e^{0.5\\ln x}&=(e^{\\ln x})^{1/2}\\\\ e^{0.5\\ln x}&=x^{1/2}\\\\ \\frac{d}{dx}(e^{0.5\\ln x})&=\\frac12 x^{-1/2}\\\\ \\frac{d}{dx}(e^{0.5\\ln x})&=\\frac{1}{2\\sqrt{x}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
