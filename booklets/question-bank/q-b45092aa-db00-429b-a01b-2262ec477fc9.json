  "content": {
    "id": "p60-q10-response",
    "type": "question",
    "label": "10",
    "prompt": "A patient is to receive 1.1 L of fluid over 9 h.\nFind the drip rate in drops/min if there are 18 drops/mL. Round to the nearest whole.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$37\\text{ drops/min}$",
      "worked": "Quantities: volume, time and drops.\n$$\\begin{align*}\n\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{\\text{Drops}}{\\text{Volume}}\\times\\frac{\\text{Volume}}{\\text{Time}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{18\\text{ drops}}{1\\text{ mL}}\\times\\frac{1.1\\text{ L}}{9\\text{ h}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{18\\text{ drops}}{1\\text{ mL}}\\times\\frac{1100\\text{ mL}}{540\\text{ min}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{110}{3}\\text{ drops/min}\\\\\n\\frac{\\text{Drops}}{\\text{Time}}&\\approx37\\text{ drops/min}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 58
  },
