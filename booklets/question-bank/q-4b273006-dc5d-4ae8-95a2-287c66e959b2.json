  "content": {
    "id": "p50-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The remainder when $P(x)=(mx^4-16x^3+6x)$ is divided by $(2x+1)$ is $-\\frac14$.\nFind the value of $m$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=12$",
      "worked": "$\\begin{aligned}P\\left(-\\frac12\\right)&=-\\frac14\\\\m\\left(-\\frac12\\right)^4-16\\left(-\\frac12\\right)^3+6\\left(-\\frac12\\right)&=-\\frac14\\\\\\frac{m}{16}+2-3&=-\\frac14\\\\\\frac{m}{16}&=\\frac34\\\\m&=12\\end{aligned}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
