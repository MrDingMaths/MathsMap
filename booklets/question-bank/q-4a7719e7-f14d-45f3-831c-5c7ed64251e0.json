  "content": {
    "id": "p26-q24-response",
    "type": "question",
    "label": "7",
    "prompt": "An isosceles triangle has two sides of length $x$ cm and a base of $10$ cm. What values can $x$ take?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x>5$; the equal sides must each exceed $5$ cm.",
      "worked": "The sum of the equal sides must exceed the base.\n\n$$\\begin{align*}x+x&>10\\\\2x&>10\\\\x&>5\\end{align*}$$\n\nThe other two triangle inequalities reduce to $10>0$. Thus each equal side must exceed $5$ cm.",
      "solutionDiagrams": []
    },
