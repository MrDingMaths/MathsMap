          "inlines": [
            {
              "type": "text",
              "text": "Zach works 4 days a week. Each working day, he works from 9 a.m. to 4 p.m.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "He is paid $20 per hour.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "How much does he earn for the week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$560$ without bonus",
          "worked": "$$\\begin{align*}\\text{Hours each day} &= 16-9 \\\\ &= 7 \\\\ \\text{Hours each week} &= 4\\times7 \\\\ &= 28 \\\\ \\text{Weekly earnings} &= 28\\times\\$20 \\\\ &= \\$560\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p14-q7-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "At the end of this week, he is given a 20% bonus on his earnings.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Work out how much Zach earns.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$672$ with bonus",
          "worked": "$$\\begin{align*}\\text{Earnings with bonus} &= (100+20)\\%\\times\\$560 \\\\ &= 120\\%\\times\\$560 \\\\ &= 1.2\\times\\$560 \\\\ &= \\$672\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
