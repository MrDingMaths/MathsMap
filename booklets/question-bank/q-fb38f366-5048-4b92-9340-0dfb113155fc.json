                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(RR)&=\\frac37\\times\\frac26=\\frac37\\times\\frac13=\\frac17\\\\P(RG)&=\\frac37\\times\\frac46=\\frac37\\times\\frac23=\\frac27\\\\P(GR)&=\\frac47\\times\\frac36=\\frac47\\times\\frac12=\\frac27\\\\P(GG)&=\\frac47\\times\\frac36=\\frac47\\times\\frac12=\\frac27\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
