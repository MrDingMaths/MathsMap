  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider the piecewise-defined function:\n$$f(x)=\\begin{cases}2-x,&\\text{for }x<-2\\\\4,&\\text{for }-2\\le x\\le2\\\\x+2,&\\text{for }x>2\\end{cases}$$\nEvaluate:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Since $-2\\le0\\le2$, use the middle branch:\n$$f(0)=4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "Since $5>2$,\n$$\\begin{aligned}f(5)&=5+2\\\\f(5)&=7.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Since $-3<-2$,\n$$\\begin{aligned}f(-3)&=2-(-3)\\\\f(-3)&=5.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(3)-f(-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $3>2$, $f(3)=3+2=5$. Since $-2\\le-1\\le2$, $f(-1)=4$.\n$$\\begin{aligned}f(3)-f(-1)&=5-4\\\\f(3)-f(-1)&=1.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
