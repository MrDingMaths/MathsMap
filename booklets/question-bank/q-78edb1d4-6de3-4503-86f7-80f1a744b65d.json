  "content": {
    "id": "p37-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A marksman shoots at a target five times. He has a probability of $\\frac{1}{3}$ of hitting the target. Find the probability that he hits the target:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "exactly once",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{80}{243}$",
          "worked": "Let $X$ be the number of hits. The five independent shots have success probability $p=\\frac{1}{3}$.\n$$\\begin{align*}\\Pr(X=1)&=\\binom{5}{1}\\left(\\frac{1}{3}\\right)\\left(\\frac{2}{3}\\right)^4\\\\\\Pr(X=1)&=\\frac{80}{243}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p37-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "exactly twice",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{80}{243}$",
          "worked": "Let $X$ be the number of hits, with $n=5$ and $p=\\frac{1}{3}$.\n$$\\begin{align*}\\Pr(X=2)&=\\binom{5}{2}\\left(\\frac{1}{3}\\right)^2\\left(\\frac{2}{3}\\right)^3\\\\\\Pr(X=2)&=\\frac{80}{243}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p37-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "at least one time",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{211}{243}$",
          "worked": "Let $X$ be the number of hits. Use the complement of no hits.\n$$\\begin{align*}\\Pr(X\\ge1)&=1-\\Pr(X=0)\\\\\\Pr(X\\ge1)&=1-\\left(\\frac{2}{3}\\right)^5\\\\\\Pr(X\\ge1)&=1-\\frac{32}{243}\\\\\\Pr(X\\ge1)&=\\frac{211}{243}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p37-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "at least two times.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{131}{243}$",
          "worked": "Let $X$ be the number of hits. Use the complement of zero or one hit.\n$$\\begin{align*}\\Pr(X\\ge2)&=1-\\Pr(X=0)-\\Pr(X=1)\\\\\\Pr(X\\ge2)&=1-\\left(\\frac{2}{3}\\right)^5-5\\left(\\frac{1}{3}\\right)\\left(\\frac{2}{3}\\right)^4\\\\\\Pr(X\\ge2)&=1-\\frac{32}{243}-\\frac{80}{243}\\\\\\Pr(X\\ge2)&=\\frac{131}{243}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
