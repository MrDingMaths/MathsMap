  "content": {
    "id": "p10-q17",
    "type": "question",
    "label": "",
    "prompt": "Let $\\alpha$ and $\\beta$ be the roots of $x^2-x+4=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $\\alpha^2+\\beta^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7$.",
          "worked": "$\\alpha+\\beta=1$, $\\alpha\\beta=4$.\n\n$$\\begin{aligned}\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\&=1^2-2(4)\\\\&=-7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence explain why the roots of this quadratic are not real.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The sum of two real squares cannot be negative, but $\\alpha^2+\\beta^2=-7$.",
          "worked": "If both roots were real, $\\alpha^2\\geq0$ and $\\beta^2\\geq0$, so their sum would be non-negative. Since $\\alpha^2+\\beta^2=-7$, the roots are not real.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
