  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "$P=\\frac{F}{A}$ is a formula that connects pressure ($P$), force ($F$) and area ($A$).",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $F$ in terms of $P$ and $A$ (make $F$ the subject).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F=AP$",
          "worked": "$$\\begin{align*}P&=\\frac{F}{A}\\\\AP&=F\\\\F&=AP\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p4-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Express $A$ in terms of $P$ and $F$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\frac{F}{P}$",
          "worked": "$$\\begin{align*}P&=\\frac{F}{A}\\\\AP&=F\\\\A&=\\frac{F}{P}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
