  "content": {
    "id": "p23-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A cylindrical water tank has a diameter of 3 m and a height of 2 m. Calculate, to the nearest 100 mL, the volume of the tank in:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "cubic metres",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14.1372\\text{ m}^3$",
          "worked": "The radius is $\\frac{3}{2}=1.5$ m and 100 mL is $0.0001\\text{ m}^3$.\n$$\\begin{aligned}V&=\\pi(1.5)^2(2)=4.5\\pi\\text{ m}^3\\\\V&\\approx14.1372\\text{ m}^3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "litres",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14137.2\\text{ L}$",
          "worked": "Use the unrounded volume and round to 0.1 L.\n$$\\begin{aligned}V&=4500\\pi\\text{ L}\\\\V&\\approx14137.2\\text{ L}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
