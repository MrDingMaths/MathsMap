  "content": {
    "id": "p42-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the median of each continuous random variable correct to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{3x^2}{511}$, interval $1\\le x\\le8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m\\approx6.35$",
          "worked": "$$\\begin{align*}F(x)&=\\int_1^x\\frac{3t^2}{511}\\,dt\\\\F(x)&=\\left[\\frac{t^3}{511}\\right]_1^x\\\\F(x)&=\\frac{x^3-1}{511}\\\\\\frac{m^3-1}{511}&=\\frac12\\\\m^3&=\\frac{513}{2}\\\\m&\\approx6.35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p42-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{3(x-3)^2}{16}$, domain $[1,5]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=3.00$",
          "worked": "$$\\begin{align*}F(x)&=\\int_1^x\\frac{3(t-3)^2}{16}\\,dt\\\\F(x)&=\\left[\\frac{(t-3)^3}{16}\\right]_1^x\\\\F(x)&=\\frac{(x-3)^3+8}{16}\\\\\\frac{(m-3)^3+8}{16}&=\\frac12\\\\(m-3)^3&=0\\\\m&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p42-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{(2x-1)^4}{16105}$, domain $[1,6]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m\\approx5.29$",
          "worked": "$$\\begin{align*}F(x)&=\\int_1^x\\frac{(2t-1)^4}{16105}\\,dt\\\\F(x)&=\\left[\\frac{(2t-1)^5}{161050}\\right]_1^x\\\\F(x)&=\\frac{(2x-1)^5-1}{161050}\\\\\\frac{(2m-1)^5-1}{161050}&=\\frac12\\\\(2m-1)^5&=80526\\\\m&=\\frac{1+\\sqrt[5]{80526}}2\\\\m&\\approx5.29\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p42-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{x(x^2-3)^3}{3570}$, domain $[2,4]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m\\approx3.73$",
          "worked": "$$\\begin{align*}F(x)&=\\int_2^x\\frac{t(t^2-3)^3}{3570}\\,dt\\\\F(x)&=\\left[\\frac{(t^2-3)^4}{28560}\\right]_2^x\\\\F(x)&=\\frac{(x^2-3)^4-1}{28560}\\\\\\frac{(m^2-3)^4-1}{28560}&=\\frac12\\\\(m^2-3)^4&=14281\\\\m&=\\sqrt{3+\\sqrt[4]{14281}}\\\\m&\\approx3.73\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
