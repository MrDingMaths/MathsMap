    "label": "3",
    "prompt": "What number when subtracted from $115\\frac{7}{11}$ will leave $37\\frac{3}{4}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$77\\frac{39}{44}$\n\nSubtract the remaining amount from the original amount.",
      "worked": "The required number is the original amount minus the amount left.\n$$\\begin{align*}115\\frac{7}{11}-37\\frac{3}{4}&=115\\frac{28}{44}-37\\frac{33}{44}\\\\115\\frac{7}{11}-37\\frac{3}{4}&=114+\\frac{72}{44}-37-\\frac{33}{44}\\\\115\\frac{7}{11}-37\\frac{3}{4}&=77+\\frac{39}{44}\\\\115\\frac{7}{11}-37\\frac{3}{4}&=77\\frac{39}{44}\\end{align*}$$",
      "solutionDiagrams": []
    },
