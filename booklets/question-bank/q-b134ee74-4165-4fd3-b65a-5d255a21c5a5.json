    "label": "4",
    "prompt": "A diagonal line is drawn from corner to corner of a $9\\times6$ square grid. The diagonal line passes through a total of four grid points, and these have been marked on the grid. It also passes through the inside of 12 squares. These have also been marked on the grid.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p19-g-q4-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"crossedCellRed\",\"hex\":\"FCDFE1\",\"reason\":\"Identifies cell interiors traversed by the diagonal\"}],\"reference\":\"source page 19 p19-g-q4-diagram\"}\n\\begin{tikzpicture}[x=0.7cm,y=0.7cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{crossedCellRed}{HTML}{FCDFE1}\n\\foreach \\x/\\y in {0/0,1/0,1/1,2/1,3/2,4/2,4/3,5/3,6/4,7/4,7/5,8/5}{\\fill[crossedCellRed] (\\x,\\y) rectangle +(1,1);}\n\\draw[black,densely dotted,line width=0.25pt,step=1] (0,0) grid (9,6);\n\\draw[black,line width=0.8pt] (0,0)--(9,6);\n\\foreach \\x/\\y in {0/0,3/2,6/4,9/6}{\\fill[black] (\\x,\\y) circle[radius=1.5pt];}\n\\end{tikzpicture}",
