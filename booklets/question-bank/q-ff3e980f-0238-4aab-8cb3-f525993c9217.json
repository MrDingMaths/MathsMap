  "content": {
    "id": "p48-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The altitude, $h$ metres, of a helicopter $t$ seconds after it begins its descent is given by\n$$h = 350 - 20t.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p48-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the helicopter’s initial height?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "350 m",
          "worked": "At $t = 0$,\n$$\\begin{align*}h &= 350 - 20(0)\\\\h &= 350\\end{align*}$$\nThe initial height is 350 m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p48-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How is the helicopter’s height changing?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Decreasing by 20 m/s",
          "worked": "The coefficient of $t$ is $-20$, so the height decreases by 20 metres each second.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p48-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "If instead the rule was $h = 350 + 20t$, describe what the helicopter would be doing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ascending at 20 m/s",
          "worked": "The coefficient of $t$ is $+20$, so the helicopter would ascend at 20 m/s from an initial height of 350 m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
