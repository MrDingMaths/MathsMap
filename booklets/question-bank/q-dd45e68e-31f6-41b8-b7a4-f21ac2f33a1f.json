        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Six is added to a number, $x$, and the result is multiplied by 3. The final result is $-10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x+6)=-10$, $x=-9\\frac13$",
          "worked": "$$\\begin{align*}3(x+6)&=-10\\\\3x+18&=-10\\\\3x&=-28\\\\x&=-\\frac{28}{3}\\\\x&=-9\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Six is subtracted from a number, $m$, and the result is multiplied by 3. The final result is 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(m-6)=5$, $m=7\\frac23$",
          "worked": "$$\\begin{align*}3(m-6)&=5\\\\3m-18&=5\\\\3m&=23\\\\m&=\\frac{23}{3}\\\\m&=7\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-part-c",
        "type": "part",
        "label": "c",
        "prompt": "Ten is added to a number, $p$, and the result is multiplied by 2. The final result is 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(p+10)=4$, $p=-8$",
          "worked": "$$\\begin{align*}2(p+10)&=4\\\\2p+20&=4\\\\2p&=-16\\\\p&=-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-part-d",
        "type": "part",
        "label": "d",
        "prompt": "Five is subtracted from a number, $n$, and the result is multiplied by 3. The final result is 14.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(n-5)=14$, $n=9\\frac23$",
          "worked": "$$\\begin{align*}3(n-5)&=14\\\\3n-15&=14\\\\3n&=29\\\\n&=\\frac{29}{3}\\\\n&=9\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-part-e",
        "type": "part",
        "label": "e",
        "prompt": "Three is subtracted from a number, $x$, and the result is multiplied by 2. The final result is $-10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x-3)=-10$, $x=-2$",
          "worked": "$$\\begin{align*}2(x-3)&=-10\\\\2x-6&=-10\\\\2x&=-4\\\\x&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-part-f",
        "type": "part",
        "label": "f",
        "prompt": "Three is added to a number, $x$, and the result is multiplied by $-2$. The final result is $-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2(x+3)=-2$, $x=-2$",
          "worked": "$$\\begin{align*}-2(x+3)&=-2\\\\-2x-6&=-2\\\\-2x&=4\\\\x&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-part-g",
        "type": "part",
        "label": "g",
        "prompt": "Six is subtracted from a number, $x$, and the result is multiplied by $-4$. The final result is $-10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4(x-6)=-10$, $x=8\\frac12$",
          "worked": "$$\\begin{align*}-4(x-6)&=-10\\\\-4x+24&=-10\\\\-4x&=-34\\\\x&=\\frac{34}{4}\\\\x&=8\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
