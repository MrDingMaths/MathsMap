  "content": {
    "id": "p21-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The lines with equations $y=x+k$ and $y=mx+3$ intersect at $(1,2)$. Find $m$ and $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=-1$, $k=1$.",
      "worked": "The point $(1,2)$ lies on both lines. Substituting $x=1$ and $y=2$ into $y=x+k$:\n$$\\begin{align*}2&=1+k\\\\k&=1\\end{align*}$$\nSubstituting into $y=mx+3$:\n$$\\begin{align*}2&=m(1)+3\\\\2&=m+3\\\\m&=-1\\end{align*}$$\nHence $m=-1$ and $k=1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
