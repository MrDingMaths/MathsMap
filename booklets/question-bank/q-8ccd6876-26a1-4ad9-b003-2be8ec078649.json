        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$89 451, rounded down to the nearest whole dollar.",
          "worked": "$$\\begin{align*}\\text{Taxable income}&=91\\,262-1810.15\\\\\\text{Taxable income}&=\\$89\\,451.85\\end{align*}$$\nRounded down to the nearest whole dollar, taxable income is $\\$89\\,451$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p69-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate Jenni’s amount of income tax payable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$19 538.58; use $5092+0.325(89\\,451-45\\,000)$.",
          "worked": "The taxable income lies in the $\\$45\\,001$–$\\$120\\,000$ bracket.\n$$\\begin{align*}\\text{Excess}&=89\\,451-45\\,000\\\\\\text{Excess}&=44\\,451\\\\\\text{Income tax payable}&=5092+0.325\\times44\\,451\\\\\\text{Income tax payable}&=\\$19\\,538.575\\\\\\text{Income tax payable}&\\approx\\$19\\,538.58\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p69-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the amount of Jenni’s Medicare levy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1789.02.",
          "worked": "$$\\begin{align*}\\text{Medicare levy}&=2\\%\\times\\text{Taxable income}\\\\\\text{Medicare levy}&=0.02\\times89\\,451\\\\\\text{Medicare levy}&=\\$1789.02\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
