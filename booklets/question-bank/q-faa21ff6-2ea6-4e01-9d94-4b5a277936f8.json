  "content": {
    "id": "p2-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider the points $A(1,1)$ and $B(k,5)$. Find $k$ if $AB=5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=-2$ or $4$.",
      "worked": "$$\\begin{align*}AB&=\\sqrt{(k-1)^2+(5-1)^2}\\\\5&=\\sqrt{(k-1)^2+16}\\\\25&=(k-1)^2+16\\\\(k-1)^2&=9\\\\k-1&=\\pm3\\\\k&=-2\\text{ or }4\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
