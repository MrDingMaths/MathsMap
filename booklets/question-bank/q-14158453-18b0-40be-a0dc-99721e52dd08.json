  "content": {
    "id": "p15-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the discriminant of each of the following quadratic functions, and hence determine whether the graph touches, crosses or does not intersect the $x$-axis.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-8x+16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=0$. Touches the $x$-axis.",
          "worked": "$$\\begin{align*}\\Delta&=(-8)^2-4(1)(16)\\\\\\Delta&=64-64\\\\\\Delta&=0\\end{align*}$$\nThe graph touches the $x$-axis at its vertex.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-4x^2+2x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=-12$. Does not intersect the $x$-axis.",
          "worked": "$$\\begin{align*}\\Delta&=2^2-4(-4)(-1)\\\\\\Delta&=4-16\\\\\\Delta&=-12\\end{align*}$$\nSince $\\Delta<0$, the graph has no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p15-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2-13x+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=121$. Crosses the $x$-axis twice.",
          "worked": "$$\\begin{align*}\\Delta&=(-13)^2-4(1)(12)\\\\\\Delta&=169-48\\\\\\Delta&=121\\end{align*}$$\nSince $\\Delta>0$, the graph crosses the $x$-axis twice.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p15-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=2x^2-3x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=-15$. Does not intersect the $x$-axis.",
          "worked": "$$\\begin{align*}\\Delta&=(-3)^2-4(2)(3)\\\\\\Delta&=9-24\\\\\\Delta&=-15\\end{align*}$$\nSince $\\Delta<0$, the graph has no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p15-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=8-3x-2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=73$. Crosses the $x$-axis twice.",
          "worked": "$$\\begin{align*}y&=-2x^2-3x+8\\\\\\Delta&=(-3)^2-4(-2)(8)\\\\\\Delta&=9+64\\\\\\Delta&=73\\end{align*}$$\nSince $\\Delta>0$, the graph crosses the $x$-axis twice.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=4x^2-12x+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=0$. Touches the $x$-axis.",
          "worked": "$$\\begin{align*}\\Delta&=(-12)^2-4(4)(9)\\\\\\Delta&=144-144\\\\\\Delta&=0\\end{align*}$$\nThe graph touches the $x$-axis at its vertex.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
