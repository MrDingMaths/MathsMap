          "short": "$x=8$",
          "worked": "$$\\begin{align*}\\frac{16}{x}&=2\\\\16&=2x\\\\x&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{15}{2x}-2=3$$",
