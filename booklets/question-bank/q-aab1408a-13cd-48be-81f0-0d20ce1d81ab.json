        "answer": {
          "short": "$x=\\frac{3}{2}$",
          "worked": "$$\\begin{align*}\\frac{15}{2x}&=5\\\\15&=5(2x)\\\\15&=10x\\\\x&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
