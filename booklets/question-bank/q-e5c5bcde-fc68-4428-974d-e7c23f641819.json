    "children": [
      {
        "id": "p22-review-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x^2y^2)\\times(2xy)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x^5y^5$",
          "worked": "$$\\begin{align*}(x^2y^2)\\times(2xy)^3&=x^2y^2\\times2xy\\times2xy\\times2xy\\\\(x^2y^2)\\times(2xy)^3&=8x^{2+3}y^{2+3}\\\\(x^2y^2)\\times(2xy)^3&=8x^5y^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-review-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-2xy)^2\\times x^3y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^5y^4$",
          "worked": "$$\\begin{align*}(-2xy)^2\\times x^3y^2&=(-2xy)(-2xy)x^3y^2\\\\(-2xy)^2\\times x^3y^2&=4x^{2+3}y^{2+2}\\\\(-2xy)^2\\times x^3y^2&=4x^5y^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-review-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x^2y^2}{xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy$",
          "worked": "$$\\begin{align*}\\frac{x^2y^2}{xy}&=\\frac{x\\times x\\times y\\times y}{x\\times y}\\\\\\frac{x^2y^2}{xy}&=xy\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p22-review-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{m^3n^2}{m^2n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$mn$",
          "worked": "$$\\begin{align*}\\frac{m^3n^2}{m^2n}&=\\frac{m^2n\\times mn}{m^2n}\\\\\\frac{m^3n^2}{m^2n}&=mn\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-review-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-4x^2y)^2\\times xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16x^5y^3$",
          "worked": "$$\\begin{align*}(-4x^2y)^2\\times xy&=(-4x^2y)(-4x^2y)xy\\\\(-4x^2y)^2\\times xy&=16x^{2+2+1}y^{1+1+1}\\\\(-4x^2y)^2\\times xy&=16x^5y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-review-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{20a^2b^2}{5a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4ab^2$",
          "worked": "$$\\begin{align*}\\frac{20a^2b^2}{5a}&=\\frac{5a\\times4ab^2}{5a}\\\\\\frac{20a^2b^2}{5a}&=4ab^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
