    "children": [
      {
        "id": "v2-783a5-p12-practice-slot-3-upper-slot-3-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\tan\\dfrac{\\theta}{2}=\\dfrac{\\sin\\theta}{1+\\cos\\theta}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sin\\theta}{1+\\cos\\theta}=\\dfrac{2\\sin\\frac\\theta2\\cos\\frac\\theta2}{2\\cos^2\\frac\\theta2}=\\tan\\dfrac\\theta2$",
          "worked": "$$\\begin{align*}\\mathrm{RHS}&=\\frac{\\sin\\theta}{1+\\cos\\theta}\\\\&=\\frac{2\\sin\\frac\\theta2\\cos\\frac\\theta2}{1+\\left(2\\cos^2\\frac\\theta2-1\\right)}\\\\&=\\frac{2\\sin\\frac\\theta2\\cos\\frac\\theta2}{2\\cos^2\\frac\\theta2}\\\\&=\\frac{\\sin\\frac\\theta2}{\\cos\\frac\\theta2}\\\\&=\\tan\\frac\\theta2\\\\&=\\mathrm{LHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-783a5-p12-practice-slot-3-upper-slot-3-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the exact value of $\\tan75^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\sqrt3$",
          "worked": "Let $\\theta=150^\\circ$, so $\\dfrac\\theta2=75^\\circ$.\n$$\\begin{align*}\\tan75^\\circ&=\\frac{\\sin150^\\circ}{1+\\cos150^\\circ}\\\\&=\\frac{\\frac12}{1-\\frac{\\sqrt3}{2}}\\\\&=\\frac{1}{2-\\sqrt3}\\\\&=\\frac{2+\\sqrt3}{(2-\\sqrt3)(2+\\sqrt3)}\\\\&=2+\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
