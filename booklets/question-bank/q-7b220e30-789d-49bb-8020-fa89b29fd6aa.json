  "content": {
    "id": "p13-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Determine the equation of the line that passes through these two points.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(4,2)$ and $(12,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{x}{4}+1$",
          "worked": "$$\\begin{align*}m&=\\frac{4-2}{12-4}\\\\m&=\\frac14\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-2&=\\frac14(x-4)\\\\y-2&=\\frac{x}{4}-1\\\\y&=\\frac{x}{4}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p13-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(1,4)$ and $(3,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+2$",
          "worked": "$$\\begin{align*}m&=\\frac{8-4}{3-1}\\\\m&=2\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-4&=2(x-1)\\\\y-4&=2x-2\\\\y&=2x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p13-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(-1,3)$ and $(2,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x+2$",
          "worked": "$$\\begin{align*}m&=\\frac{0-3}{2-(-1)}\\\\m&=-1\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-3&=-(x+1)\\\\y-3&=-x-1\\\\y&=-x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p13-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(7,3)$ and $(10,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-4$",
          "worked": "$$\\begin{align*}m&=\\frac{6-3}{10-7}\\\\m&=1\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-3&=x-7\\\\y&=x-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p13-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2,-2)$ and $(-1,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{8x}{3}+\\dfrac{10}{3}$",
          "worked": "$$\\begin{align*}m&=\\frac{6-(-2)}{-1-2}\\\\m&=-\\frac83\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y+2&=-\\frac83(x-2)\\\\y+2&=-\\frac{8x}{3}+\\frac{16}{3}\\\\y&=-\\frac{8x}{3}+\\frac{10}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p13-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-10,2)$ and $(1,-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{6x}{11}-\\dfrac{38}{11}$",
          "worked": "$$\\begin{align*}m&=\\frac{-4-2}{1-(-10)}\\\\m&=-\\frac6{11}\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-2&=-\\frac6{11}(x+10)\\\\y-2&=-\\frac{6x}{11}-\\frac{60}{11}\\\\y&=-\\frac{6x}{11}-\\frac{38}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
