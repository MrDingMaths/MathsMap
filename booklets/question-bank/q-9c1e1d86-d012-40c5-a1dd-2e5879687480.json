    "type": "question",
    "label": null,
    "prompt": "Find the values of $x$ for which the curve $y=4+9x-3x^2-x^3$ is concave down.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x>-1$.",
      "worked": "$$\\begin{align*}y'&=9-6x-3x^2\\\\y''&=-6-6x\\end{align*}$$\nFor concave down, $y''<0$.\n$$\\begin{align*}-6-6x&<0\\\\-6x&<6\\\\x&>-1\\end{align*}$$",
      "solutionDiagrams": []
    },
