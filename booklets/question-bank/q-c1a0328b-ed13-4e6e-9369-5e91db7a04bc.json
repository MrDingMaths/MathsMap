  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": null,
    "prompt": "From a set of 12 cards numbered 1 to 12, a card is drawn at random. What is the probability that it is either a multiple of 3 or even?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{3}$.",
      "worked": "Let $M$ be drawing a multiple of 3 and $E$ be drawing an even number. There are 4 multiples of 3 and 6 even numbers. The numbers 6 and 12 belong to both events.\n$$\\begin{align*}P(M\\cup E)&=\\frac{4+6-2}{12}\\\\ P(M\\cup E)&=\\frac{2}{3}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
