  "content": {
    "id": "root-9-5",
    "type": "question",
    "label": null,
    "prompt": "$f(x) = 2x + 4$ and $g(x) = 3x - 8$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "part-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f^{-1}(x)$ and $g^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-4}{2}$ and $\\frac{x+8}{3}$",
          "worked": "Solve each linear equation after swapping $x$ and $y$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      },
      {
        "id": "part-b",
        "type": "part",
        "label": "b",
        "prompt": "Find an expression for $fg(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x-12$",
          "worked": "$fg(x)=f(3x-8)=6x-12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      },
      {
        "id": "part-c",
        "type": "part",
        "label": "c",
        "prompt": "Find an expression for the inverse of $fg(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+12}{6}$",
          "worked": "Undo $y=6x-12$: $x=\\frac{y+12}{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      },
      {
        "id": "part-d",
        "type": "part",
        "label": "d",
        "prompt": "Is $(fg)^{-1}(x)$ the same as $f^{-1}g^{-1}(x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No",
          "worked": "$f^{-1}g^{-1}(x)=\\frac{x-4}{6}$, which is different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      },
      {
        "id": "part-e",
        "type": "part",
        "label": "e",
        "prompt": "Is $(fg)^{-1}(x)$ the same as $g^{-1}f^{-1}(x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes",
          "worked": "Applying $f^{-1}$ first and then $g^{-1}$ gives $\\frac{x+12}{6}$, matching $(fg)^{-1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      }
    ]
