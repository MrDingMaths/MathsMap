  "content": {
    "id": "p20-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Using the common logarithm, evaluate each of the following correct to three significant figures:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$3.23\\div1.34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.41$",
          "worked": "Using the common-logarithm table:\n$$\\begin{align*}\\log_{10}(3.23\\div1.34)&=\\log_{10}3.23-\\log_{10}1.34\\\\\\log_{10}(3.23\\div1.34)&\\approx0.5092-0.1271\\\\\\log_{10}(3.23\\div1.34)&\\approx0.3821\\end{align*}$$\nUsing the table in reverse:\n$$3.23\\div1.34\\approx10^{0.3821}\\approx2.41.$$\nThe answer is correct to three significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$2.32\\div1.58$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.47$",
          "worked": "Using the common-logarithm table:\n$$\\begin{align*}\\log_{10}(2.32\\div1.58)&=\\log_{10}2.32-\\log_{10}1.58\\\\\\log_{10}(2.32\\div1.58)&\\approx0.3655-0.1987\\\\\\log_{10}(2.32\\div1.58)&\\approx0.1668\\end{align*}$$\nUsing the table in reverse:\n$$2.32\\div1.58\\approx10^{0.1668}\\approx1.47.$$\nThe answer is correct to three significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$9.46\\div3.76$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.52$",
          "worked": "Using the common-logarithm table:\n$$\\begin{align*}\\log_{10}(9.46\\div3.76)&=\\log_{10}9.46-\\log_{10}3.76\\\\\\log_{10}(9.46\\div3.76)&\\approx0.9759-0.5752\\\\\\log_{10}(9.46\\div3.76)&\\approx0.4007\\end{align*}$$\nUsing the table in reverse:\n$$9.46\\div3.76\\approx10^{0.4007}\\approx2.52.$$\nThe answer is correct to three significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$7.51\\div6.07$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.24$",
          "worked": "Using the common-logarithm table:\n$$\\begin{align*}\\log_{10}(7.51\\div6.07)&=\\log_{10}7.51-\\log_{10}6.07\\\\\\log_{10}(7.51\\div6.07)&\\approx0.8756-0.7832\\\\\\log_{10}(7.51\\div6.07)&\\approx0.0924\\end{align*}$$\nUsing the table in reverse:\n$$7.51\\div6.07\\approx10^{0.0924}\\approx1.24.$$\nThe answer is correct to three significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
