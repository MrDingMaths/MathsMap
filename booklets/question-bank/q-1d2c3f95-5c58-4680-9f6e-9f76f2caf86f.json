      {
        "id": "p4-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Give a numeric example to demonstrate that this does not always work.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-3)^2=3^2$, but $-3\\ne3$.",
          "worked": "Choose $x=-3$, $y=3$ and $n=2$. Both powers equal $9$, although the bases differ. Opposite nonzero bases give the same even power.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "For what value(s) of $n$ does this actually work?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All odd positive integers $n$, for real $x,y$.\n\nOdd powers preserve order; even powers identify opposite bases.",
          "worked": "For real $x,y$, an odd positive power is strictly increasing, so equal odd powers have equal bases. Every even positive $n$ fails for $x=-1$ and $y=1$, since $(-1)^n=1^n=1$. Thus it works for every real pair precisely when $n$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
