  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Define $f(x)=x^2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find and expand $f(1+h)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h^2+2h+1$",
          "worked": "$$\\begin{align*}f(1+h)&=(1+h)^2\\\\f(1+h)&=h^2+2h+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\frac{f(1+h)-f(1)}{h}=2+h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{f(1+h)-f(1)}{h}=2+h$, for $h\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{f(1+h)-f(1)}{h}&=\\frac{h^2+2h+1-1}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=\\frac{h(h+2)}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=2+h\\qquad(h\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find $\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}&=\\lim_{h\\to0}(2+h)\\\\\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the geometric significance of the numerical value you obtained?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It is the gradient of the tangent at $x=1$.",
          "worked": "The difference quotient is the gradient of a secant through $(1,1)$. Its limit, $2$, is the gradient of the tangent to $y=x^2$ at $(1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
