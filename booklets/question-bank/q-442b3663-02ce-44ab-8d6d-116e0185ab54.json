  "content": {
    "id": "p61-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Simplify each of the following by combining index laws.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p61-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$4\\times(4^3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4^7$",
          "worked": "$$\\begin{align*}4\\times(4^3)^2&=4^1\\times4^6\\\\&=4^{1+6}\\\\&=4^7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$(3^4)^2\\times3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^9$",
          "worked": "$$\\begin{align*}(3^4)^2\\times3&=3^8\\times3^1\\\\&=3^{8+1}\\\\&=3^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$7^8\\div(7^3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^2$",
          "worked": "$$\\begin{align*}7^8\\div(7^3)^2&=7^8\\div7^6\\\\&=7^{8-6}\\\\&=7^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$(4^2)^3\\div4^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(4^2)^3\\div4^5&=4^6\\div4^5\\\\&=4^{6-5}\\\\&=4^1\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p61-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$(3^6)^3\\div(3^5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^8$",
          "worked": "$$\\begin{align*}(3^6)^3\\div(3^5)^2&=3^{18}\\div3^{10}\\\\&=3^{18-10}\\\\&=3^8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$2^2\\times(2^2)^8\\div(2^3)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^9$",
          "worked": "$$\\begin{align*}2^2\\times(2^2)^8\\div(2^3)^3&=2^2\\times2^{16}\\div2^9\\\\&=2^{2+16-9}\\\\&=2^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
