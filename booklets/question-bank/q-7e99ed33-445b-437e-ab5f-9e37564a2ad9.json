              "type": "text",
              "text": "Find three numbers for which the square of the number has none of the same digits as the cube of that number.",
              "marks": []
            }
          ]
        },
        {
          "id": "p4-q12-example",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "One such number is 9, as ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "9^2=81",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "9^3=729",
              "display": false
            },
            {
              "type": "text",
              "text": ", and the number 81 has none of the same digits as 729.",
              "marks": []
            }
          ]
        }
      ]
