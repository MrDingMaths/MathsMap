  "content": {
    "id": "p7-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Sam throws a stone down to the ground from the top of a cliff $s$ metres high, with an initial speed of $u$ m/s. It accelerates at $a$ m/s$^2$. The stone hits the ground with a speed of $v$ m/s given by the formula $v^2=u^2+2as$. Find the speed at which the stone hits the ground, correct to 2 decimal places, if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$u=0$, $a=9.8$ and $s=50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31.30\\text{ m/s}$",
          "worked": "$$\\begin{align*}v^2&=0^2+2\\times9.8\\times50\\\\v^2&=980\\\\v&=\\sqrt{980}\\\\v&\\approx31.30\\text{ m/s}\\end{align*}$$\nTake the positive square root because $v$ is a speed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$u=5$, $a=9.8$ and $s=35$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26.66\\text{ m/s}$",
          "worked": "$$\\begin{align*}v^2&=5^2+2\\times9.8\\times35\\\\v^2&=711\\\\v&=\\sqrt{711}\\\\v&\\approx26.66\\text{ m/s}\\end{align*}$$\nTake the positive square root because $v$ is a speed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
