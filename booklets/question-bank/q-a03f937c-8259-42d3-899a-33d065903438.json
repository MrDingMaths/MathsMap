        "type": "part",
        "label": "a",
        "prompt": "Express $x^2$ as a quadratic in $(x-a)$. Begin by writing $x^2=((x-a)+a)^2$, then expand only the outer brackets of the RHS.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2=(x-a)^2+2a(x-a)+a^2$.",
          "worked": "$$\\begin{align*}x^2&=((x-a)+a)^2\\\\x^2&=(x-a)^2+2a(x-a)+a^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
