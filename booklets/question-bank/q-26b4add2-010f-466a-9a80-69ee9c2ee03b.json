  "content": {
    "id": "p28-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "A patient in hospital is given an antibiotic solution at the rate of $80\\text{ mL/h}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "How much antibiotic solution will the patient receive in $6\\frac{1}{2}\\text{ h}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$520\\text{ mL}$",
          "worked": "$$\\begin{align*}\\frac{80\\text{ mL}}{1\\text{ h}}&=\\frac{x\\text{ mL}}{6.5\\text{ h}}\\\\x&=80\\times6.5\\\\x&=520\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p28-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "How often would 600 mL containers of the antibiotic solution need to be changed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Every $7.5\\text{ hours}$.",
          "worked": "$$\\begin{align*}\\frac{80\\text{ mL}}{1\\text{ h}}&=\\frac{600\\text{ mL}}{x\\text{ h}}\\\\\\frac{1\\text{ h}}{80\\text{ mL}}&=\\frac{x\\text{ h}}{600\\text{ mL}}\\\\x&=\\frac{600}{80}\\\\x&=7.5\\text{ h}\\end{align*}$$\nChange the container every 7.5 hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p28-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "If 1 mL of this solution contains 15 drops, calculate the rate at which the patient receives the antibiotic in drops/minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ drops/min}$",
          "worked": "$80\\text{ mL/h}=\\frac{80\\text{ mL}}{60\\text{ min}}$.\n$$\\begin{align*}\\frac{x\\text{ drops}}{1\\text{ min}}&=\\frac{15\\text{ drops}}{1\\text{ mL}}\\times\\frac{80\\text{ mL}}{60\\text{ min}}\\\\x&=\\frac{15\\times80}{60}\\\\x&=20\\text{ drops/min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
