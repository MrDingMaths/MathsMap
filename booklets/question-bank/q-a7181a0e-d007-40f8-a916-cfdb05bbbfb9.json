  "content": {
    "id": "p14-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A collection of 27 coins consists of 20-cent and $\\$2$ coins, and has a value of $\\$23.40$. Find the number of coins of each denomination.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "17 twenty-cent coins and 10 two-dollar coins.",
      "worked": "Let $x$ be the number of two-dollar coins. Then there are $27-x$ twenty-cent coins. Expressing the total value in cents:\n$$\\begin{align*}200x+20(27-x)&=2340\\\\200x+540-20x&=2340\\\\180x+540&=2340\\\\180x&=1800\\\\x&=10\\\\27-x&=17\\end{align*}$$\nThere are 10 two-dollar coins and 17 twenty-cent coins.",
      "solutionDiagrams": []
    },
