  "content": {
    "id": "p28-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A student council has five girls and six boys. Two students are chosen without replacement to form a committee. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "two girls are selected",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{11}$",
          "worked": "After one girl is selected, four girls remain among ten students.\n$$\\begin{align*}P(\\text{two girls})&=\\frac{5}{11}\\times\\frac{4}{10}\\\\P(\\text{two girls})&=\\frac{2}{11}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "at least one girl is selected.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8}{11}$",
          "worked": "The complement of selecting at least one girl is selecting two boys.\n$$\\begin{align*}P(\\text{at least one girl})&=1-P(\\text{two boys})\\\\P(\\text{at least one girl})&=1-\\frac{6}{11}\\times\\frac{5}{10}\\\\P(\\text{at least one girl})&=\\frac{8}{11}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
