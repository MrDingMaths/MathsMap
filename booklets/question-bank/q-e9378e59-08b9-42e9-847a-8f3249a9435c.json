  "content": {
    "id": "p27-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A closed cylindrical can is to have a surface area of $60\\pi\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Let the cylinder have height $h$ and radius $r$. Show that $h=\\dfrac{30-r^2}{r}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\dfrac{30-r^2}{r}$",
          "worked": "$$\\begin{align*}2\\pi rh+2\\pi r^2&=60\\pi\\\\2\\pi rh&=60\\pi-2\\pi r^2\\\\h&=\\frac{60\\pi-2\\pi r^2}{2\\pi r}\\\\h&=\\frac{30-r^2}{r}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p27-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the volume of the can is $V=\\pi r(30-r^2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=\\pi r(30-r^2)$",
          "worked": "$$\\begin{align*}V&=\\pi r^2h\\\\V&=\\pi r^2\\times\\frac{30-r^2}{r}\\\\V&=\\pi r(30-r^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p27-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\dfrac{dV}{dr}$ and hence find the maximum possible volume of the can.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dV}{dr}=30\\pi-3\\pi r^2$. Maximum volume: $20\\sqrt{10}\\pi\\text{ cm}^3$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p27-q10-c-domain",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since the radius and height are positive, ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "0<r<\\sqrt{30}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p27-q10-c-differentiation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{dV}{dr}&=\\frac{d}{dr}(30\\pi r-\\pi r^3)\\\\\\frac{dV}{dr}&=30\\pi-3\\pi r^2\\end{aligned}",
                    "display": true
                  }
                ]
              },
