  "content": {
    "id": "p14-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Express each of the following natural numbers as a product of prime numbers. Hence, find the cube root of each number.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125=5^3$, $\\sqrt[3]{125}=5$.",
          "worked": "$$\\begin{align*}125&=5\\times25\\\\125&=5\\times5\\times5\\\\125&=5^3\\\\\\sqrt[3]{125}&=\\sqrt[3]{5^3}\\\\\\sqrt[3]{125}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$216$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$216=2^3\\times3^3$, $\\sqrt[3]{216}=6$.",
          "worked": "$$\\begin{align*}216&=8\\times27\\\\216&=2^3\\times3^3\\\\\\sqrt[3]{216}&=\\sqrt[3]{2^3\\times3^3}\\\\\\sqrt[3]{216}&=2\\times3\\\\\\sqrt[3]{216}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p14-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$1728$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1728=2^6\\times3^3$, $\\sqrt[3]{1728}=12$.",
          "worked": "$$\\begin{align*}1728&=64\\times27\\\\1728&=2^6\\times3^3\\\\\\sqrt[3]{1728}&=\\sqrt[3]{2^6\\times3^3}\\\\\\sqrt[3]{1728}&=2^2\\times3\\\\\\sqrt[3]{1728}&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p14-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$3375$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3375=3^3\\times5^3$, $\\sqrt[3]{3375}=15$.",
          "worked": "$$\\begin{align*}3375&=27\\times125\\\\3375&=3^3\\times5^3\\\\\\sqrt[3]{3375}&=\\sqrt[3]{3^3\\times5^3}\\\\\\sqrt[3]{3375}&=3\\times5\\\\\\sqrt[3]{3375}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
