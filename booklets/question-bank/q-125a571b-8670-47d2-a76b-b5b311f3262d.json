  "content": {
    "id": "p26-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The line $y=2x-4$ intersects the line $y=-3x+6$ at the point $B$. Find the equation of the line that passes through $B$ and is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "parallel to the $x$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=0$",
          "worked": "At the intersection, the two expressions for $y$ are equal.\n$$\\begin{align*}2x-4&=-3x+6\\\\5x&=10\\\\x&=2\\\\y&=2(2)-4\\\\y&=0\\end{align*}$$\nCheck in the other equation: $-3(2)+6=0$. Thus $B=(2,0)$. A line parallel to the $x$-axis has constant $y$, so its equation is $y=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p26-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "parallel to the $y$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "From part a, $B=(2,0)$. A line parallel to the $y$-axis has constant $x$. Through $B$, its equation is $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
