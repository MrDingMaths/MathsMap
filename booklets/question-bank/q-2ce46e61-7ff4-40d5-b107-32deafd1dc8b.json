  "content": {
    "id": "p8-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Write the equation of the parabola obtained when the basic parabola, $y=x^2$, is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "translated 3 units up and 4 units to the left",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+4)^2+3$",
          "worked": "Translating 4 units left replaces $x$ by $x+4$; translating 3 units up adds 3.\n\n$$y=(x+4)^2+3$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "translated 5 units down and 6 units to the right",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-6)^2-5$",
          "worked": "Translating 6 units right replaces $x$ by $x-6$; translating 5 units down subtracts 5.\n\n$$y=(x-6)^2-5$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "translated $a$ units to the right and $b$ units up",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-a)^2+b$",
          "worked": "Translating $a$ units right replaces $x$ by $x-a$; translating $b$ units up adds $b$.\n\n$$y=(x-a)^2+b$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "translated $c$ units down and $d$ units to the left",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+d)^2-c$",
          "worked": "Translating $d$ units left replaces $x$ by $x+d$; translating $c$ units down subtracts $c$.\n\n$$y=(x+d)^2-c$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
