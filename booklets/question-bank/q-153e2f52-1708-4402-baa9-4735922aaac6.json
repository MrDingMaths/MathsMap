  "content": {
    "id": "p7-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Try to solve the equation $6(2x + 2) = 3(4x + 3)$. How many solutions does this equation have?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No solutions.\n\nExpanding and cancelling the $x$ terms gives the false equality $12=9$.",
      "worked": "$$\\begin{align*}12x+12&=12x+9\\\\12x+12-12x&=12x+9-12x\\\\12&=9\\end{align*}$$\nSince $12\\ne9$, the equation has no solutions.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
