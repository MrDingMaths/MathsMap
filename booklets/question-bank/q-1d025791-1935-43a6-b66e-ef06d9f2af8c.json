  "content": {
    "id": "binomial-numerator-r33-compare-1-root",
    "type": "question",
    "label": null,
    "prompt": "A student thinks that the common denominator to use when simplifying $\\dfrac{2x+3}{4}+\\dfrac{x+5}{6}$ is 24.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "binomial-numerator-r33-compare-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Complete the addition by making both denominators 24.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8x+19}{12}$",
          "worked": "$$\\begin{align*}\\frac{2x+3}{4}+\\frac{x+5}{6}&=\\frac{6(2x+3)}{24}+\\frac{4(x+5)}{24}\\\\&=\\frac{12x+18+4x+20}{24}\\\\&=\\frac{16x+38}{24}\\\\&=\\frac{8x+19}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "binomial-numerator-r33-compare-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Complete the simplification using the actual LCD of 12.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8x+19}{12}$",
          "worked": "$$\\begin{align*}\\frac{2x+3}{4}+\\frac{x+5}{6}&=\\frac{3(2x+3)}{12}+\\frac{2(x+5)}{12}\\\\&=\\frac{6x+9+2x+10}{12}\\\\&=\\frac{8x+19}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "binomial-numerator-r33-compare-1-c",
        "type": "part",
        "label": "c",
        "prompt": "You should have the same answer for both methods. Which do you prefer and why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, use 12: smaller numbers and less simplification.",
          "worked": "Both methods give $\\dfrac{8x+19}{12}$. Using the LCD of 12 keeps the numbers smaller and avoids reducing a fraction with denominator 24. Either preference is acceptable with a valid reason.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
