        "prompt": "$\\tan35^\\circ-\\dfrac{1}{\\tan55^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "Since $\\tan55^\\circ=\\cot35^\\circ$,\n$$\\begin{align*}\\tan35^\\circ-\\frac{1}{\\tan55^\\circ}&=\\tan35^\\circ-\\tan35^\\circ\\\\\\tan35^\\circ-\\frac{1}{\\tan55^\\circ}&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q56-59-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac35$",
          "worked": "Since $\\cos42^\\circ=\\sin48^\\circ$,\n$$\\begin{align*}\\frac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}&=\\frac{3\\sin48^\\circ}{5\\sin48^\\circ}\\\\\\frac{\\cos42^\\circ+2\\sin48^\\circ}{5\\sin48^\\circ}&=\\frac35.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q56-59-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2\\tan56^\\circ+3\\cot34^\\circ}{7\\tan56^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac57$",
          "worked": "Since $\\cot34^\\circ=\\tan56^\\circ$,\n$$\\begin{align*}\\frac{2\\tan56^\\circ+3\\cot34^\\circ}{7\\tan56^\\circ}&=\\frac{5\\tan56^\\circ}{7\\tan56^\\circ}\\\\\\frac{2\\tan56^\\circ+3\\cot34^\\circ}{7\\tan56^\\circ}&=\\frac57.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
