  "content": {
    "id": "p44-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Silvana rolls a die 50 times.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the expected number of sixes that she rolls?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{25}{3}=8\\dfrac13$ sixes.",
          "worked": "Let $X$ be the number of sixes. Then $X\\sim\\operatorname{Bin}(50,\\frac16)$.\n$$\\begin{aligned}E(X)&=np\\\\E(X)&=50\\times\\frac16\\\\E(X)&=\\frac{25}{3}=8\\frac13.\\end{aligned}$$\nThe expectation is $8\\frac13$ sixes; its nearest whole number is 8.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p44-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the probability of Silvana rolling 8 sixes. Leave your answer in index form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\binom{50}{8}\\left(\\frac16\\right)^8\\left(\\frac56\\right)^{42}$",
          "worked": "$$\\begin{aligned}P(X=8)&=\\binom{50}{8}\\left(\\frac16\\right)^8\\left(1-\\frac16\\right)^{50-8}\\\\P(X=8)&=\\binom{50}{8}\\left(\\frac16\\right)^8\\left(\\frac56\\right)^{42}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
