    "id": "p10-q28-response",
    "type": "question",
    "label": "28",
    "prompt": "Find the positive integer $n$ for which $\\frac{n}{9}$ is an integer with 5 factors, and $\\frac{n}{16}$ is an integer with three factors.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
