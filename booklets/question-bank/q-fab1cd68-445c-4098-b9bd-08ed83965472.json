  "content": {
    "id": "p42-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "For events $A$ and $B$ from a sample space, $P(A\\mid B)=\\frac{1}{5}$ and $P(B\\mid A)=\\frac{1}{4}$. Let $P(A\\cap B)=p$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $P(A)$ in terms of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4p$",
          "worked": "$$\\begin{align*}P(A)&=\\frac{P(A\\cap B)}{P(B\\mid A)}\\\\P(A)&=\\frac{p}{\\frac14}\\\\P(A)&=4p\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p42-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $P(A'\\cap B')$ in terms of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-8p$",
          "worked": "$$\\begin{align*}P(B)&=\\frac{P(A\\cap B)}{P(A\\mid B)}\\\\P(B)&=\\frac{p}{\\frac15}=5p\\\\P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=4p+5p-p=8p\\end{align*}$$\nUsing the Venn diagram,\n$$\\begin{align*}P(A'\\cap B')&=1-P(A\\cup B)\\\\P(A'\\cap B')&=1-8p\\end{align*}$$",
          "solutionDiagrams": [
            {
              "id": "p42-q26-b-diagram",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 42 p42-q26-b-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.8pt] (0,0) rectangle (5.4,3.3);\n\\draw[black,line width=0.8pt] (1.95,1.5) circle (1.15);\n\\draw[black,line width=0.8pt] (3.45,1.5) circle (1.15);\n\\node at (0.95,2.55) {$A$};\n\\node at (4.45,2.55) {$B$};\n\\node at (1.5,1.5) {$3p$};\n\\node at (2.7,1.5) {$p$};\n\\node at (3.9,1.5) {$4p$};\n\\node at (2.7,2.98) {$1-8p$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 58,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 42,
                "sourceRegion": "Question 26b, supplied solution Venn diagram",
                "description": "Unshaded rectangular sample space containing overlapping circles A on the left and B on the right. All source region labels are retained; ordinary strokes and labels use house black.",
                "mathematics": "A-only probability 3p; intersection probability p; B-only probability 4p; outside both probability 1-8p.",
                "answerVisibility": "Answer edition only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p42-q26-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $P(A\\cup B)\\leq\\frac15$, state the largest possible interval for $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0<p\\leq\\frac{1}{40}$",
          "worked": "$$\\begin{align*}P(A\\cup B)&=8p\\\\8p&\\leq\\frac15\\\\p&\\leq\\frac1{40}\\end{align*}$$\nThe given conditional probabilities require $P(A)>0$ and $P(B)>0$, so $p>0$. Thus $0<p\\leq\\frac1{40}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
