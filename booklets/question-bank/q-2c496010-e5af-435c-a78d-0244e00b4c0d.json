    "id": "p13-q4-p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "In a raffle, 1000 tickets are sold. If you buy 50 tickets, what is the probability that you will not win the first prize?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{19}{20}$",
      "worked": "$$\\begin{align*}P(\\text{not winning first prize})&=1-\\frac{50}{1000}\\\\P(\\text{not winning first prize})&=\\frac{950}{1000}\\\\P(\\text{not winning first prize})&=\\frac{19}{20}\\end{align*}$$",
      "solutionDiagrams": []
    },
