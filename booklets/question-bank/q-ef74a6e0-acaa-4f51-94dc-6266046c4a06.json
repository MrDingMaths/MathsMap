      {
        "id": "p14-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How much larger is $\\frac{1}{3}$ than $33\\%$, as a percentage?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}\\%$\n\nSubtract the converted percentages: the difference is $\\frac{1}{3}$ of a percentage point.",
          "worked": "$$\\begin{align*}\\frac{1}{3}\\times100\\%&=33\\frac{1}{3}\\%\\\\33\\frac{1}{3}\\%-33\\%&=\\frac{1}{3}\\%\\end{align*}$$\nThe difference is $\\frac{1}{3}$ of a percentage point.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How much larger is $\\frac{1}{3}$ than $0.3$, as a percentage?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac{1}{3}\\%$\n\nConvert both numbers to percentages and subtract: the difference is $3\\frac{1}{3}$ percentage points.",
          "worked": "$$\\begin{align*}\\frac{1}{3}\\times100\\%&=33\\frac{1}{3}\\%\\\\0.3\\times100\\%&=30\\%\\\\33\\frac{1}{3}\\%-30\\%&=3\\frac{1}{3}\\%\\end{align*}$$\nThe difference is $3\\frac{1}{3}$ percentage points.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
