  "content": {
    "id": "p33-q7",
    "type": "question",
    "label": "7",
    "prompt": "Factorise and hence simplify the following. (hint: difference of two squares)",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{9^n-1}{3^n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^n+1$",
          "worked": "$$\\begin{align*}\\frac{9^n-1}{3^n-1}&=\\frac{(3^n)^2-1^2}{3^n-1}\\\\&=\\frac{(3^n+1)(3^n-1)}{3^n-1}\\\\&=3^n+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5^{2n}-5^n}{5^n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^n$",
          "worked": "$$\\begin{align*}\\frac{5^{2n}-5^n}{5^n-1}&=\\frac{5^n(5^n-1)}{5^n-1}\\\\&=5^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
