  "content": {
    "id": "p3-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3^4\\times2^5}{3^3\\times2^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac32$",
          "worked": "$$\\begin{align*}\\frac{3^4\\times2^5}{3^3\\times2^6}&=3^{4-3}\\times\\frac1{2^{6-5}}\\\\\\frac{3^4\\times2^5}{3^3\\times2^6}&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{6^5}{2^3\\times3^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$108$",
          "worked": "$$\\begin{align*}\\frac{6^5}{2^3\\times3^2}&=\\frac{2^5\\times3^5}{2^3\\times3^2}\\\\\\frac{6^5}{2^3\\times3^2}&=2^2\\times3^3\\\\\\frac{6^5}{2^3\\times3^2}&=4\\times27\\\\\\frac{6^5}{2^3\\times3^2}&=108\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p3-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2^6\\times3^9}{6^2\\times9^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "$$\\begin{align*}\\frac{2^6\\times3^9}{6^2\\times9^3}&=\\frac{2^6\\times3^9}{2^2\\times3^2\\times3^6}\\\\\\frac{2^6\\times3^9}{6^2\\times9^3}&=2^4\\times3\\\\\\frac{2^6\\times3^9}{6^2\\times9^3}&=16\\times3\\\\\\frac{2^6\\times3^9}{6^2\\times9^3}&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p3-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{22^3}{44^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac18$",
          "worked": "$$\\begin{align*}\\frac{22^3}{44^3}&=\\left(\\frac{22}{44}\\right)^3\\\\\\frac{22^3}{44^3}&=\\left(\\frac12\\right)^3\\\\\\frac{22^3}{44^3}&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
