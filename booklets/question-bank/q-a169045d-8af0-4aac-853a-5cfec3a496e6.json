    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{a^2}$",
      "worked": "$$\\begin{align*}(3a)^{-1}\\times 3a^{-1}&=\\frac{1}{3a}\\times\\frac{3}{a}\\\\&=\\frac{3}{3a^2}\\\\&=\\frac{1}{a^2}\\end{align*}$$",
      "solutionDiagrams": []
