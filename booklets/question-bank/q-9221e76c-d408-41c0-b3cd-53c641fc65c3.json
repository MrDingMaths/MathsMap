  "content": {
    "id": "v2-ac439-p13-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "A line with gradient $\\frac32$ passes through the midpoint of $A(-1,2)$ and $B(5,6)$.\n\nFind the equation of the line in general form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Midpoint: $(2,4)$; $3x-2y+2=0$.",
      "worked": "$$\\begin{aligned}M&=\\left(\\frac{-1+5}{2},\\frac{2+6}{2}\\right)\\\\M&=(2,4)\\end{aligned}$$\nUsing $m=\\frac32$ and $(2,4)$:\n$$\\begin{aligned}y-4&=\\frac32(x-2)\\\\2y-8&=3x-6\\\\3x-2y+2&=0\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
