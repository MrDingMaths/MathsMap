  "content": {
    "id": "p5-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A ship has taken 15 days to travel $\\frac{3}{7}$ of its journey. How much longer will it take to complete the journey?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "A further 20 days.",
      "worked": "Assuming the ship continues at the same rate:\n$$\\begin{align*}\\text{Time for }\\frac{1}{7}\\text{ of the journey}&=15\\div3=5\\text{ days}\\\\\\text{Remaining fraction}&=1-\\frac{3}{7}=\\frac{4}{7}\\\\\\text{Time remaining}&=4\\times5=20\\text{ days}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
