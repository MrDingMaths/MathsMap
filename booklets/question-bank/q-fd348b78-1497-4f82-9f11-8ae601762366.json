  "content": {
    "id": "p13-q1",
    "type": "question",
    "label": "1",
    "prompt": "A train takes 4 hours to complete a journey of 360 km. What is the average speed of the train?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$90\\text{ km/h}$",
      "worked": "$$\\begin{align*}\\text{Average speed}&=\\frac{\\text{distance}}{\\text{time}}\\\\\\text{Average speed}&=\\frac{360}{4}\\\\\\text{Average speed}&=90\\text{ km/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
