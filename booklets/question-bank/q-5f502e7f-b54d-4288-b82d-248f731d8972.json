  "content": {
    "id": "p35-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Steel rods have mean diameter 10.6 cm and standard deviation 0.5 cm. Assume the diameters are approximately normally distributed and the acceptance limits are symmetric about the mean.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q18-a",
        "type": "group",
        "label": "a",
        "prompt": "If 0.3% of rods are rejected, find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p35-q18-a-i",
            "type": "part",
            "label": "i",
            "prompt": "the percentage accepted",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "99.7% accepted.",
              "worked": "$$\\begin{aligned}\\text{Percentage accepted}&=100\\%-0.3\\%\\\\&=99.7\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p35-q18-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the largest diameter accepted",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "12.1 cm.",
              "worked": "By the empirical rule, approximately 99.7% of diameters lie within three standard deviations of the mean.\n$$\\begin{aligned}\\text{Largest diameter}&=\\mu+3\\sigma\\\\&=10.6+3(0.5)\\\\&=12.1\\text{ cm}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p35-q18-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the smallest diameter accepted",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "9.1 cm.",
              "worked": "$$\\begin{aligned}\\text{Smallest diameter}&=\\mu-3\\sigma\\\\&=10.6-3(0.5)\\\\&=9.1\\text{ cm}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      },
      {
        "id": "p35-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "In one batch, diameters are 10.9 cm, 9.6 cm, 8.3 cm, 11.4 cm, 12.6 cm. Which are rejected?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8.3 cm and 12.6 cm.",
          "worked": "The acceptable range is $9.1\\leq x\\leq12.1$ cm. Since $8.3<9.1$ and $12.6>12.1$, the rods with diameters 8.3 cm and 12.6 cm are rejected.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
