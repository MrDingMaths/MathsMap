  "content": {
    "id": "v2-3cf9e-p17-practice-slot-7-lower-root",
    "type": "question",
    "label": null,
    "prompt": "An irregular polygon has two exterior angles of $60^{\\circ}$.\nIf the other exterior angles are $20^{\\circ}$, find the number of sides.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "14 sides.",
      "worked": "Let $n$ be the number of sides.\n$$\\begin{align*}2(60)+20(n-2)&=360\\\\120+20(n-2)&=360\\\\20(n-2)&=240\\\\n-2&=12\\\\n&=14\\end{align*}$$\nThe polygon has 14 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
