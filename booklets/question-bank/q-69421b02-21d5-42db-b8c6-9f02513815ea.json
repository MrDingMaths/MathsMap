  "content": {
    "id": "p5-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The triangle $ABC$ has vertices $A(0,0)$, $B(3,0)$ and $C(3,4)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the distance between $A$ and $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}AC^2&=(3-0)^2+(4-0)^2\\\\AC^2&=9+16\\\\AC^2&=25\\\\AC&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the midpoint $M$ of $AC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M\\left(\\frac32,2\\right)$",
          "worked": "$$\\begin{align*}x_M&=\\frac{0+3}{2}\\\\x_M&=\\frac32\\\\y_M&=\\frac{0+4}{2}\\\\y_M&=2\\end{align*}$$\nTherefore, $M\\left(\\frac32,2\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p5-q6-c",
        "type": "group",
        "label": "c",
        "prompt": "Find the length of:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p5-q6-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$AM$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac52$",
              "worked": "Since $M$ is the midpoint of $AC$,\n$$\\begin{align*}AM&=\\frac{AC}{2}\\\\AM&=\\frac52\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p5-q6-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$BM$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac52$",
              "worked": "$$\\begin{align*}BM^2&=\\left(\\frac32-3\\right)^2+(2-0)^2\\\\BM^2&=\\frac94+4\\\\BM^2&=\\frac{25}{4}\\\\BM&=\\frac52\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p5-q6-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$CM$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac52$",
              "worked": "Since $M$ is the midpoint of $AC$,\n$$\\begin{align*}CM&=\\frac{AC}{2}\\\\CM&=\\frac52\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      }
