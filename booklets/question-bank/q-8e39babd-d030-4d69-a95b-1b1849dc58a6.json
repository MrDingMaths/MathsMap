    "difficulty": "Development",
    "difficultyReason": "Identify income and allowable work expenses, total each, then subtract."
  },
  "content": {
    "id": "p47-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Eliza earned \\$88 784 from her employer in the last financial year. She also earned bank interest of \\$380. Eliza spent \\$240 on books, \\$520 on stationery and \\$380 on a printer, all of which are needed for her work.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What is Eliza’s gross income?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$89 164",
          "worked": "$$\\begin{align*}\\text{Gross income} &= 88\\,784+380\\\\&=\\$89\\,164\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p47-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What are Eliza’s total allowable tax deductions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1140",
          "worked": "$$\\begin{align*}\\text{Total deductions} &= 240+520+380\\\\&=\\$1140\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p47-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate Eliza’s taxable income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$88 024",
          "worked": "$$\\begin{align*}\\text{Taxable income} &= 89\\,164-1140\\\\&=\\$88\\,024\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
