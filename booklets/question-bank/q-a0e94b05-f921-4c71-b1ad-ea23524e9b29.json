  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "In the expansion of $(3x+a)^6$, the coefficient of $x$ is 576. Find $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=2$.",
      "worked": "The term involving $x$ is\n$$\\binom{6}{1}(3x)a^5=18a^5x.$$\nEquating its coefficient to 576 gives\n$$\\begin{align*}18a^5&=576\\\\a^5&=32\\\\a&=2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
