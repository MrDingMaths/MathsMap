  "content": {
    "id": "p18-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Check whether or not each of these points lies on the line with equation $y=-6x$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$(0,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=0\\\\\\mathrm{RHS}&=-6(0)\\\\\\mathrm{RHS}&=0\\end{align*}$$\nThe two sides are equal, so $(0,0)$ lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$(1,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=6\\\\\\mathrm{RHS}&=-6(1)\\\\\\mathrm{RHS}&=-6\\end{align*}$$\nThe two sides are unequal, so $(1,6)$ does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(-1,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=6\\\\\\mathrm{RHS}&=-6(-1)\\\\\\mathrm{RHS}&=6\\end{align*}$$\nThe two sides are equal, so $(-1,6)$ lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$(4,-10)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=-10\\\\\\mathrm{RHS}&=-6(4)\\\\\\mathrm{RHS}&=-24\\end{align*}$$\nThe two sides are unequal, so $(4,-10)$ does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
