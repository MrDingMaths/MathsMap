  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The points $P(0,-2)$ and $Q(-4,-6)$ lie on the graph of $y=f(x)$. The graph of $y=f(x+2)+3$ is then drawn. State the new locations of $P$ and $Q$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P(-2,1)$ and $Q(-6,-3)$",
      "worked": "The graph moves 2 units left and 3 units up. Subtract 2 from each $x$-coordinate and add 3 to each $y$-coordinate.\n\n$$\\begin{align*}P'&=(0-2,-2+3)\\\\P'&=(-2,1)\\\\Q'&=(-4-2,-6+3)\\\\Q'&=(-6,-3)\\end{align*}$$",
      "solutionDiagrams": []
