    "type": "question",
    "label": "13",
    "prompt": "How many ways can the letters of the word HOMOLOGOUS be arranged if the vowels are together?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3600$\n\nArrange one vowel block with the five consonants, then arrange its vowels.",
      "worked": "The vowels are four O’s and one U. Treat them as one block. The block and the five distinct consonants form six elements; the vowels have $5!/4!$ internal arrangements.\n$$\\begin{align*}N&=6!\\times\\frac{5!}{4!}\\\\N&=720\\times5\\\\N&=3600.\\end{align*}$$",
      "solutionDiagrams": []
    },
