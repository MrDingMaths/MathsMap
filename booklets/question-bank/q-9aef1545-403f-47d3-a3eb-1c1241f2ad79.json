  "content": {
    "id": "p50-group-1-3-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the quotient and remainder of the following polynomials when $P(x)$ is divided by $D(x)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q1",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=x^3-7x^2+3x+4$, $D(x)=x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Quotient: $x^2-5x-7$; remainder: $-10$.",
          "worked": "$$\\begin{align*}(x^3-7x^2+3x+4)-x^2(x-2)&=-5x^2+3x+4\\\\(-5x^2+3x+4)-(-5x)(x-2)&=-7x+4\\\\(-7x+4)-(-7)(x-2)&=-10\\\\P(x)&=(x-2)(x^2-5x-7)-10\\end{align*}$$\nQuotient: $x^2-5x-7$; remainder: $-10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p50-q2",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=x^4+3x^2+5$, $D(x)=x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Quotient: $x^2+2$; remainder: $3$.",
          "worked": "$$\\begin{align*}(x^4+3x^2+5)-x^2(x^2+1)&=2x^2+5\\\\(2x^2+5)-2(x^2+1)&=3\\\\P(x)&=(x^2+1)(x^2+2)+3\\end{align*}$$\nQuotient: $x^2+2$; remainder: $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p50-q3",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=2x^3+9x^2+1$, $D(x)=2x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Quotient: $x^2+4x-2$; remainder: $3$.",
          "worked": "$$\\begin{align*}(2x^3+9x^2+0x+1)-x^2(2x+1)&=8x^2+1\\\\(8x^2+0x+1)-4x(2x+1)&=-4x+1\\\\(-4x+1)-(-2)(2x+1)&=3\\\\P(x)&=(2x+1)(x^2+4x-2)+3\\end{align*}$$\nQuotient: $x^2+4x-2$; remainder: $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
