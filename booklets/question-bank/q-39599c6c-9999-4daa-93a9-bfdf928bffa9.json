  "content": {
    "id": "p25-q11-root",
    "type": "question",
    "label": "",
    "prompt": "Solve for $x$. Rewrite the decimals as fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$10^x=0.0001$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$",
          "worked": "$\\begin{align*}10^x&=\\frac{1}{10000}\\\\10^x&=10^{-4}\\\\x&=-4\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p25-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^x=0.125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$",
          "worked": "$\\begin{align*}2^x&=\\frac{1}{8}\\\\2^x&=2^{-3}\\\\x&=-3\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p25-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$5^x=0.00032$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5$",
          "worked": "$\\begin{align*}5^x&=\\frac{1}{3125}\\\\5^x&=5^{-5}\\\\x&=-5\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p25-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$(0.25)^x=0.5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{2}$",
          "worked": "$\\begin{align*}\\left(\\frac{1}{4}\\right)^x&=\\frac{1}{2}\\\\2^{-2x}&=2^{-1}\\\\-2x&=-1\\\\x&=\\frac{1}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p25-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$(0.04)^x=125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{3}{2}$",
          "worked": "$\\begin{align*}\\left(\\frac{1}{25}\\right)^x&=125\\\\5^{-2x}&=5^3\\\\-2x&=3\\\\x&=-\\frac{3}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p25-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$(0.0625)^{x+1}=\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{3}{4}$",
          "worked": "$\\begin{align*}\\left(\\frac{1}{16}\\right)^{x+1}&=\\frac{1}{2}\\\\2^{-4x-4}&=2^{-1}\\\\-4x-4&=-1\\\\-4x&=3\\\\x&=-\\frac{3}{4}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
