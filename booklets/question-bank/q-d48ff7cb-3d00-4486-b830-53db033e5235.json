  "content": {
    "id": "v2-939c3-p18-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "The volume of water $W$ litres used by a sprinkler is directly proportional to the time $t$ minutes it runs. The sprinkler uses 90 L in 12 minutes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-939c3-p18-practice-slot-8-slot-8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the constant of variation and write the equation relating $W$ and $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=7.5,\\quad W=7.5t$",
          "worked": "$$\\begin{align*}W&=kt\\\\90&=k\\times12\\\\k&=\\frac{90}{12}=7.5\\\\W&=7.5t\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-939c3-p18-practice-slot-8-slot-8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "How much water does the sprinkler use in 35 minutes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "262.5 L",
          "worked": "$$\\begin{align*}W&=7.5t\\\\W&=7.5\\times35\\\\W&=262.5\\end{align*}$$\nThe sprinkler uses 262.5 L.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
