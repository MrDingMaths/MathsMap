  "content": {
    "id": "p63-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "“The square of a number is the product of one more and one less than the number, add one.”",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p63-q4-demonstration",
        "type": "part",
        "label": "a",
        "prompt": "Show this is true for $10^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10^2=11\\times9+1=100$",
          "worked": "$$\\begin{align*}11\\times9+1&=99+1\\\\&=100\\\\&=10^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p63-q4-proof",
        "type": "part",
        "label": "b",
        "prompt": "Prove this is always true using algebra.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n+1)(n-1)+1=n^2-1+1=n^2$.",
          "worked": "Let the number be $n$. We want to prove $n^2=(n+1)(n-1)+1$.\n\n$$\\begin{align*}\\text{RHS}&=(n+1)(n-1)+1\\\\&=n^2-1+1\\\\&=n^2\\\\&=\\text{LHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
