  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A kite has area $36\\text{ cm}^2$. Its longer diagonal is twice the length of the shorter diagonal. Find the lengths of these diagonals.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6\\text{ cm}$ and $12\\text{ cm}$.",
      "worked": "Let the shorter diagonal be $x\\text{ cm}$, so the longer diagonal is $2x\\text{ cm}$.\n$$\\begin{align*}36&=\\frac{x(2x)}{2}\\\\x^2&=36\\\\x&=6\\end{align*}$$\nSince lengths are positive, the diagonals are $6\\text{ cm}$ and $2(6)=12\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
