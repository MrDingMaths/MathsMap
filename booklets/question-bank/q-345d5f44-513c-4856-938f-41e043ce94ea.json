  "content": {
    "id": "p15-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Find $g(a+1)$ for:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(x)=2-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-a$",
          "worked": "$$\\begin{align*}g(a+1)&=2-(a+1)\\\\&=1-a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(x)=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+2a+1$",
          "worked": "$$\\begin{align*}g(a+1)&=(a+1)^2\\\\&=a^2+2a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(x)=\\dfrac{1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{a}$",
          "worked": "$$\\begin{align*}g(a+1)&=\\frac{1}{(a+1)-1}\\\\&=\\frac{1}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
