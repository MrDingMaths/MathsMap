  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The curve $y=x^2+ax+7$ has a turning point at $x=-1$.\nFind the value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=2$",
      "worked": "At a turning point, $y'=0$.\n$$\\begin{align*}y'&=2x+a\\\\y'(-1)&=-2+a=0\\\\a&=2\\end{align*}$$",
      "solutionDiagrams": []
    },
