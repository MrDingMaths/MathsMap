    "id": "v2-e2085-p32-practice-j6-034150-root",
    "type": "question",
    "label": null,
    "prompt": "Mia drinks 350 mL from a 1 litre bottle of orange juice.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-e2085-p32-practice-j6-034150-j6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "How many millilitres of juice are left?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$650\\text{ mL}$",
          "worked": "$$\\begin{align*}1\\text{ L}&=1000\\text{ mL}\\\\\\text{Juice left}&=1000-350\\\\&=650\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-e2085-p32-practice-j6-034150-j6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage of the juice is left?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$65\\%$",
          "worked": "$$\\begin{align*}\\frac{650}{1000}&=\\frac{65}{100}\\\\&=65\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
