    "children": [
      {
        "id": "p8-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove that for any $a$ and $b$,\n$$ab=\\frac{(a+b)^2-(a-b)^2}{4}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(a+b)^2-(a-b)^2}{4}=\\dfrac{4ab}{4}=ab.$\n\nExpand both perfect squares and collect like terms.",
          "worked": "$$\\begin{align*}\\frac{(a+b)^2-(a-b)^2}{4}&=\\frac{(a^2+2ab+b^2)-(a^2-2ab+b^2)}{4}\\\\\\frac{(a+b)^2-(a-b)^2}{4}&=\\frac{a^2+2ab+b^2-a^2+2ab-b^2}{4}\\\\\\frac{(a+b)^2-(a-b)^2}{4}&=\\frac{4ab}{4}\\\\\\frac{(a+b)^2-(a-b)^2}{4}&=ab.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p8-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the above identity to evaluate $16\\times14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$224$",
          "worked": "$$\\begin{align*}16\\times14&=\\frac{(16+14)^2-(16-14)^2}{4}\\\\16\\times14&=\\frac{30^2-2^2}{4}\\\\16\\times14&=\\frac{900-4}{4}\\\\16\\times14&=\\frac{896}{4}\\\\16\\times14&=224.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
