  "content": {
    "id": "p7-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A number is chosen at random from the first 10 positive whole numbers. What is the probability that it is not exactly divisible by 3?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{7}{10}$",
      "worked": "Let $A$ be the event ‘the number is exactly divisible by 3’. Among the numbers 1 to 10, the multiples of 3 are 3, 6 and 9.\n$$\\begin{align*}P(A)&=\\frac{3}{10}\\\\P(A^c)&=1-P(A)\\\\P(A^c)&=1-\\frac{3}{10}\\\\P(A^c)&=\\frac{7}{10}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
