  "content": {
    "id": "p30-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Consider $f(x)=x^2-2x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the largest interval containing $x=2$ on which the inverse is a function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\geq1$. Turning point at $x=1$.",
          "worked": "$$\\begin{align*}f(x)&=x^2-2x\\\\&=(x-1)^2-1.\\end{align*}$$\nThe turning point is $(1,-1)$. The largest interval containing $x=2$ on which $f$ is one-to-one is $[1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "State the range of $f(x)$ in that domain.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\geq-1$.",
          "worked": "$$\\begin{align*}f(1)&=1^2-2(1)\\\\&=-1.\\end{align*}$$\nOn $x\\geq1$, $f$ increases from its minimum value $-1$. Its range is $y\\geq-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p30-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that the inverse relation is $y^2-2y-x=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=y^2-2y$, so $y^2-2y-x=0$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p30-q6-c-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Interchange ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " in ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=x^2-2x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p30-q6-c-source-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x&=y^2-2y\\\\0&=y^2-2y-x.\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q6-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p30-q6-d-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "By quadratic formula or completing the square, show that making ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " the subject yields",
                  "marks": []
                }
              ]
            },
            {
              "id": "p30-q6-d-given-result",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "y=1\\pm\\sqrt{1+x}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2\\pm\\sqrt{4+4x}}{2}=1\\pm\\sqrt{1+x}$.",
          "worked": "$$\\begin{align*}y&=\\frac{2\\pm\\sqrt{4-4(1)(-x)}}{2}\\\\y&=\\frac{2\\pm\\sqrt{4+4x}}{2}\\\\y&=\\frac{2\\pm2\\sqrt{1+x}}{2}\\\\y&=1\\pm\\sqrt{1+x}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p30-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "State the range of the inverse function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\geq1$.",
          "worked": "The range of the inverse is the restricted domain of $f$. Hence $y\\geq1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p30-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "Hence, determine whether the inverse function is $y=1+\\sqrt{1+x}$ or $y=1-\\sqrt{1+x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1+\\sqrt{1+x}$, since the inverse must have $y\\geq1$.",
          "worked": "The inverse has range $y\\geq1$, so choose the positive square-root branch:\n$$f^{-1}(x)=1+\\sqrt{1+x},\\qquad x\\geq-1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p30-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "Hence sketch the graph of $y=f(x)$ and $y=f^{-1}(x)$ on the same axes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2-2x$, $x\\geq1$, and $y=1+\\sqrt{1+x}$, $x\\geq-1$, reflected in $y=x$.",
          "worked": "Sketch $y=x^2-2x$ for $x\\geq1$, with filled endpoint $(1,-1)$ and intercept $(2,0)$. Reflect it in $y=x$ to obtain $y=1+\\sqrt{1+x}$ for $x\\geq-1$, with filled endpoint $(-1,1)$ and intercept $(0,2)$.",
          "solutionDiagrams": [
