        "type": "part",
        "label": "a",
        "prompt": "Rearrange the formula to make $w$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=\\frac{A}{l}$",
          "worked": "$$\\begin{align*}A&=lw\\\\\\frac{A}{l}&=w\\\\w&=\\frac{A}{l}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-8566fd-p4-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use your rearranged formula to find $w$ when $A=84$ and $l=12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=7$",
          "worked": "$$\\begin{align*}w&=\\frac{84}{12}\\\\w&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
