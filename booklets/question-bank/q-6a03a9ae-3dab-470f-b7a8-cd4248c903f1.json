    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "74 people.",
      "worked": "$$\\begin{align*}82-36&=46\\\\46+28&=74\\end{align*}$$\n\n74 people belonged to the club at the end of the year.",
