    "type": "question",
    "label": "8",
    "prompt": "Order each set of fractions from smallest to largest.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2}{3},\\ \\frac{5}{6},\\ \\frac{3}{4},\\ \\frac{1}{2},\\ \\frac{4}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}<\\frac{2}{3}<\\frac{3}{4}<\\frac{4}{5}<\\frac{5}{6}$",
          "worked": "Express the fractions with denominator $60$:\n\n$$\\begin{align*}\\frac{2}{3}&=\\frac{40}{60}\\\\\\frac{5}{6}&=\\frac{50}{60}\\\\\\frac{3}{4}&=\\frac{45}{60}\\\\\\frac{1}{2}&=\\frac{30}{60}\\\\\\frac{4}{5}&=\\frac{48}{60}\\end{align*}$$\n\nTherefore, $\\frac{1}{2}<\\frac{2}{3}<\\frac{3}{4}<\\frac{4}{5}<\\frac{5}{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p3-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{11}{25},\\ \\frac{4}{5},\\ \\frac{13}{20},\\ \\frac{1}{4},\\ \\frac{6}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}<\\frac{11}{25}<\\frac{6}{10}<\\frac{13}{20}<\\frac{4}{5}$",
          "worked": "Express the fractions with denominator $100$:\n\n$$\\begin{align*}\\frac{11}{25}&=\\frac{44}{100}\\\\\\frac{4}{5}&=\\frac{80}{100}\\\\\\frac{13}{20}&=\\frac{65}{100}\\\\\\frac{1}{4}&=\\frac{25}{100}\\\\\\frac{6}{10}&=\\frac{60}{100}\\end{align*}$$\n\nTherefore, $\\frac{1}{4}<\\frac{11}{25}<\\frac{6}{10}<\\frac{13}{20}<\\frac{4}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
