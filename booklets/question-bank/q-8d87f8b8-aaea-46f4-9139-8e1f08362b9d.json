  "content": {
    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Krystal’s family goes to dinner with Helen’s family.\nThe bill comes to a total of $\\$x$ and each family pays half.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an algebraic fraction for the amount Krystal’s family pays.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{2}$",
          "worked": "$$\\begin{align*}x\\div2&=\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Krystal says she will pay one third of her family’s bill.\nWrite an algebraic fraction for the amount that she pays.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{6}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}\\div3&=\\frac{x}{2}\\times\\frac{1}{3}\\\\&=\\frac{x}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
