  "content": {
    "id": "p23-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Two of the roots of $x^3+3x^2-4x+a=0$ are opposites.\n\nFind the value of $a$ and the three roots.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-12$; the roots are $-2$, $2$ and $-3$.",
      "worked": "Let the roots be $\\alpha$, $-\\alpha$ and $\\beta$.\n\nSum of roots:\n$$\\begin{aligned}\\alpha-\\alpha+\\beta&=-3\\\\\\beta&=-3\\end{aligned}$$\nSum of products taken two at a time:\n$$\\begin{aligned}-\\alpha^2+\\alpha\\beta-\\alpha\\beta&=-4\\\\\\alpha^2&=4\\\\\\alpha&=\\pm2\\end{aligned}$$\nProduct of roots:\n$$\\begin{aligned}(-2)(2)(-3)&=-a\\\\12&=-a\\\\a&=-12\\end{aligned}$$\nThe roots are $-2$, $2$ and $-3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
