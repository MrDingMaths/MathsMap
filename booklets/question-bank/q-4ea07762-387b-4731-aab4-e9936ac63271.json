    "children": [
      {
        "id": "p14-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{a}+\\frac{1}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{a}$",
          "worked": "$$\\begin{align*}\\frac{1}{a}+\\frac{1}{a}&=\\frac{1+1}{a}\\\\\\frac{1}{a}+\\frac{1}{a}&=\\frac{2}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{x}-\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{x}$",
          "worked": "$$\\begin{align*}\\frac{1}{x}-\\frac{2}{x}&=\\frac{1-2}{x}\\\\\\frac{1}{x}-\\frac{2}{x}&=-\\frac{1}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{a}+\\frac{1}{2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{2a}$",
          "worked": "$$\\begin{align*}\\frac{1}{a}+\\frac{1}{2a}&=\\frac{2}{2a}+\\frac{1}{2a}\\\\\\frac{1}{a}+\\frac{1}{2a}&=\\frac{2+1}{2a}\\\\\\frac{1}{a}+\\frac{1}{2a}&=\\frac{3}{2a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{2x}-\\frac{1}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6x}$",
          "worked": "$$\\begin{align*}\\frac{1}{2x}-\\frac{1}{3x}&=\\frac{3}{6x}-\\frac{2}{6x}\\\\\\frac{1}{2x}-\\frac{1}{3x}&=\\frac{3-2}{6x}\\\\\\frac{1}{2x}-\\frac{1}{3x}&=\\frac{1}{6x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{4a}+\\frac{4}{3a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{12a}$",
          "worked": "$$\\begin{align*}\\frac{3}{4a}+\\frac{4}{3a}&=\\frac{9}{12a}+\\frac{16}{12a}\\\\\\frac{3}{4a}+\\frac{4}{3a}&=\\frac{9+16}{12a}\\\\\\frac{3}{4a}+\\frac{4}{3a}&=\\frac{25}{12a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5}{6x}-\\frac{1}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2x}$",
          "worked": "$$\\begin{align*}\\frac{5}{6x}-\\frac{1}{3x}&=\\frac{5}{6x}-\\frac{2}{6x}\\\\\\frac{5}{6x}-\\frac{1}{3x}&=\\frac{5-2}{6x}\\\\\\frac{5}{6x}-\\frac{1}{3x}&=\\frac{3}{6x}\\\\\\frac{5}{6x}-\\frac{1}{3x}&=\\frac{1}{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
