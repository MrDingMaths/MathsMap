  "content": {
    "id": "p23-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A clock rests on a table. The hour hand is 8 cm long and the minute hand is 12 cm long. The centre of the clock is 20 cm above the table. Let $t$ be the time (in minutes) after midnight.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find a formula for the distance $M$, in cm, from the tip of the minute hand to the table at time $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M(t)=20+12\\cos\\left(\\frac{\\pi t}{30}\\right)$ cm.",
          "worked": "The mean height is 20 cm, the amplitude is 12 cm and the period is 60 minutes. The minute hand points upwards at midnight, so the height starts at its maximum.\n$$\\begin{align*}n&=\\frac{2\\pi}{60}\\\\n&=\\frac{\\pi}{30}\\\\M(t)&=20+12\\cos\\left(\\frac{\\pi t}{30}\\right)\\end{align*}$$\n$M(t)$ is measured in centimetres.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find a formula for the distance $H$, in cm, from the tip of the hour hand to the table at time $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$H(t)=20+8\\cos\\left(\\frac{\\pi t}{360}\\right)$ cm.",
          "worked": "The mean height is 20 cm and the amplitude is 8 cm. The hour hand completes one revolution in 12 hours, or 720 minutes. It points upwards at midnight, so the height starts at its maximum.\n$$\\begin{align*}n&=\\frac{2\\pi}{720}\\\\n&=\\frac{\\pi}{360}\\\\H(t)&=20+8\\cos\\left(\\frac{\\pi t}{360}\\right)\\end{align*}$$\n$H(t)$ is measured in centimetres.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
