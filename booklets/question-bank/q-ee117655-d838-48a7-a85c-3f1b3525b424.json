  "content": {
    "id": "p22-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "An interval $AB$ is $6\\text{ cm}$ in length. A point $C$ is a point on $AB$ such that the ratio of the length $AB$ to the length $CB$ is $2:1$. Find the lengths of $AC$ and $CB$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AC=3\\text{ cm}$ and $CB=3\\text{ cm}$.",
      "worked": "$AB$ represents 2 parts and $CB$ represents 1 part.\n$$\\begin{align*}\\text{One part}&=6\\div2=3\\text{ cm}\\\\CB&=1\\times3=3\\text{ cm}\\\\AC&=6-3=3\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
