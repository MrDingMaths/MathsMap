        "label": "a",
        "prompt": "Differentiate $P=2x+\\dfrac{50}{x}$ with respect to $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dP}{dx}=2-\\dfrac{50}{x^2}=2-50x^{-2}$",
          "worked": "$$\\begin{align*}P&=2x+50x^{-1}\\\\\\frac{dP}{dx}&=2-50x^{-2}\\\\&=2-\\frac{50}{x^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
