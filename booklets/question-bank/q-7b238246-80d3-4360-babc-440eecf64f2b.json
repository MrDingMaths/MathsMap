  "content": {
    "id": "p40-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Northbound trains arrive at my local train station every sixty minutes. Each day, I walk to the station at a random time in the afternoon and wait for a northbound train. Find the probability that I will have to wait no more than 10 minutes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{6}$",
      "worked": "Let $W$ be the waiting time in minutes. It is uniformly distributed over $[0,60]$, so probability is proportional to interval length.\n$$\\begin{align*}\\Pr(W\\leq10)&=\\frac{10-0}{60-0}\\\\\\Pr(W\\leq10)&=\\frac16.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
