      {
        "id": "p34-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Given that the derivative of $f(x)$ is $\\dfrac{x^2+x+1}{x}$ and $f(1)=1\\dfrac12$, find $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\dfrac12x^2+x+\\ln|x|$.",
          "worked": "$$\\begin{align*}\\frac{x^2+x+1}{x}&=x+1+\\frac1x\\\\f(x)&=\\frac12x^2+x+\\ln|x|+C\\end{align*}$$\nUsing $f(1)=\\dfrac32$:\n$$\\begin{align*}\\frac12+1+0+C&=\\frac32\\\\C&=0\\\\f(x)&=\\frac12x^2+x+\\ln|x|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p34-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that the derivative of $g(x)$ is $\\dfrac{2x^3-3x-4}{x^2}$ and $g(2)=-3\\ln 2$, find $g(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(x)=x^2-3\\ln|x|+\\dfrac4x-6$.",
          "worked": "$$\\begin{align*}\\frac{2x^3-3x-4}{x^2}&=2x-\\frac3x-4x^{-2}\\\\g(x)&=x^2-3\\ln|x|+\\frac4x+C\\end{align*}$$\nUsing $g(2)=-3\\ln 2$:\n$$\\begin{align*}4-3\\ln 2+2+C&=-3\\ln 2\\\\C&=-6\\\\g(x)&=x^2-3\\ln|x|+\\frac4x-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
