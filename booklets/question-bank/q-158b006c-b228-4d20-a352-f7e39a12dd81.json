  "content": {
    "id": "p49-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Use the addition rule $P(A\\cup B)=P(A)+P(B)-P(A\\cap B)$ to answer the following questions. Drawing a Venn diagram helps.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "If $P(A)=\\frac15$, $P(B)=\\frac13$ and $P(A\\cap B)=\\frac1{15}$, find $P(A\\cup B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac7{15}$",
          "worked": "$$\\begin{aligned}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=\\frac15+\\frac13-\\frac1{15}\\\\P(A\\cup B)&=\\frac7{15}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p49-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If $P(A)=\\frac12$, $P(B)=\\frac13$ and $P(A\\cup B)=\\frac56$, find $P(A\\cap B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{aligned}P(A\\cap B)&=P(A)+P(B)-P(A\\cup B)\\\\P(A\\cap B)&=\\frac12+\\frac13-\\frac56\\\\P(A\\cap B)&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p49-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "If $P(A\\cup B)=\\frac9{10}$, $P(A\\cap B)=\\frac15$ and $P(A)=\\frac12$, find $P(B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "$$\\begin{aligned}P(B)&=P(A\\cup B)-P(A)+P(A\\cap B)\\\\P(B)&=\\frac9{10}-\\frac12+\\frac15\\\\P(B)&=\\frac35\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p49-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "If $A$ and $B$ are mutually exclusive and $P(A)=\\frac17$ and $P(B)=\\frac47$, find $P(A\\cup B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac57$",
          "worked": "Since $A$ and $B$ are mutually exclusive, $P(A\\cap B)=0$.\n\n$$\\begin{aligned}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=\\frac17+\\frac47-0\\\\P(A\\cup B)&=\\frac57\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p49-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Find $P(A\\cap B')$ when $P(A\\cup B)=0.8$, $P(A)=0.5$ and $P(B)=0.4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{aligned}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\0.8&=0.5+0.4-P(A\\cap B)\\\\P(A\\cap B)&=0.1\\\\P(A\\cap B')&=P(A)-P(A\\cap B)\\\\P(A\\cap B')&=0.5-0.1\\\\P(A\\cap B')&=0.4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p49-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "Find $P(A'\\cap B)$ when $P(A\\cup B)=0.76$, $P(A)=0.31$ and $P(B)=0.59$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.45$",
          "worked": "$$\\begin{aligned}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\0.76&=0.31+0.59-P(A\\cap B)\\\\P(A\\cap B)&=0.14\\\\P(A'\\cap B)&=P(B)-P(A\\cap B)\\\\P(A'\\cap B)&=0.59-0.14\\\\P(A'\\cap B)&=0.45\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
