  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{x}+\\frac{2}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x+2}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{3}{x}+\\frac{2}{x^2}&=\\frac{3x}{x^2}+\\frac{2}{x^2}\\\\&=\\frac{3x+2}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{5}{x^2}+\\frac{4}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5+4x}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{5}{x^2}+\\frac{4}{x}&=\\frac{5}{x^2}+\\frac{4x}{x^2}\\\\&=\\frac{5+4x}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{7}{x}+\\frac{3}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x+3}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{7}{x}+\\frac{3}{x^2}&=\\frac{7x}{x^2}+\\frac{3}{x^2}\\\\&=\\frac{7x+3}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{4}{x}-\\frac{5}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x-5}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{4}{x}-\\frac{5}{x^2}&=\\frac{4x}{x^2}-\\frac{5}{x^2}\\\\&=\\frac{4x-5}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{x^2}-\\frac{8}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3-8x}{x^2}$",
          "worked": "$$\\begin{align*}\\frac{3}{x^2}-\\frac{8}{x}&=\\frac{3}{x^2}-\\frac{8x}{x^2}\\\\&=\\frac{3-8x}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$-\\frac{4}{x^2}+\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-4}{x^2}$",
          "worked": "$$\\begin{align*}-\\frac{4}{x^2}+\\frac{1}{x}&=-\\frac{4}{x^2}+\\frac{x}{x^2}\\\\&=\\frac{x-4}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{3}{x}-\\frac{7}{2x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6x-7}{2x^2}$",
          "worked": "$$\\begin{align*}\\frac{3}{x}-\\frac{7}{2x^2}&=\\frac{6x}{2x^2}-\\frac{7}{2x^2}\\\\&=\\frac{6x-7}{2x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{-2}{3x}+\\frac{3}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-2x+9}{3x^2}$",
          "worked": "$$\\begin{align*}\\frac{-2}{3x}+\\frac{3}{x^2}&=\\frac{-2x}{3x^2}+\\frac{9}{3x^2}\\\\&=\\frac{-2x+9}{3x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$-\\frac{5}{x^2}-\\frac{3}{4x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-20-3x}{4x^2}$",
          "worked": "$$\\begin{align*}-\\frac{5}{x^2}-\\frac{3}{4x}&=-\\frac{20}{4x^2}-\\frac{3x}{4x^2}\\\\&=\\frac{-20-3x}{4x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
