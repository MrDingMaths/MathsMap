    "type": "question",
    "label": null,
    "prompt": "The lockers at a school in Geelong are numbered 1 to 180. Every locker whose number is divisible by 10 is painted red. How many lockers are not painted red?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$162$",
      "worked": "$$\\begin{align*}\\text{Red lockers}&=180\\div10=18\\\\\\text{Not red}&=180-18\\\\&=162\\end{align*}$$",
