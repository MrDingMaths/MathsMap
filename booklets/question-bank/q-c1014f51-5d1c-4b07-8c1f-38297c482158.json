            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 9,
              "sourceRegion": "Question 2b, top-right grid cell",
              "description": "Unshaded triangle with vertical left edge labelled 20, horizontal bottom edge labelled 21 and descending diagonal labelled 29; no right-angle marker.",
              "mathematics": "The longest labelled side is 29. Test 20² + 21² against 29².",
              "answerVisibility": "Only the three supplied side lengths are visible in the question."
