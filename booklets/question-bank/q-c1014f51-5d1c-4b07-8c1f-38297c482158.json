            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "Right-angled; $20^2+21^2=29^2=841$.",
          "worked": "$$\\begin{align*}a^2+b^2&=20^2+21^2\\\\&=400+441\\\\&=841\\\\h^2&=29^2\\\\&=841\\end{align*}$$\nSince $a^2+b^2=h^2$, the triangle is right-angled.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42,
        "responseSpace": "scaffold"
