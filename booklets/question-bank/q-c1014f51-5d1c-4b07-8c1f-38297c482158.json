            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 9 p9-q2-c-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,draw=black,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,1.25);\n\\coordinate (B) at (3.1,2.5);\n\\coordinate (C) at (4.15,-0.2);\n\\draw (A)--node[midway,above left=3pt] {$0.5$} (B)--node[midway,right=3pt] {$1.2$} (C)--node[midway,below=3pt] {$1.3$} cycle;\n\\end{tikzpicture}",
