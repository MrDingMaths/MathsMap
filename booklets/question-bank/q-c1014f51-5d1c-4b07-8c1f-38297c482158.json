        "columns": null,
        "questionDiagrams": [
          {
            "id": "p9-q2-a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 9 p9-q2-a-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,draw=black,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (3.5,0);\n\\coordinate (C) at (3.5,3.05);\n\\draw (A)--node[midway,below=3pt] {$7$} (B)--node[midway,right=3pt] {$8$} (C)--node[midway,above left=3pt] {$9$} cycle;\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 46,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 9,
              "sourceRegion": "Question 2a, top-left grid cell",
              "description": "Unshaded triangle with horizontal bottom edge labelled 7, vertical right edge labelled 8 and rising diagonal labelled 9; no right-angle marker.",
              "mathematics": "The longest labelled side is 9. Test 7² + 8² against 9². Preserve the source's schematic geometry without asserting a right angle.",
              "answerVisibility": "Only the three supplied side lengths are visible in the question."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "Not right-angled; $7^2+8^2=113\\ne81=9^2$.",
          "worked": "$$\\begin{align*}a^2+b^2&=7^2+8^2\\\\&=49+64\\\\&=113\\\\h^2&=9^2\\\\&=81\\end{align*}$$\nSince $a^2+b^2\\ne h^2$, the triangle is not right-angled.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42,
        "responseSpace": "scaffold"
      },
      {
