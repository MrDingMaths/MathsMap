            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 9 p9-q2-d-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,draw=black,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,1.15);\n\\coordinate (B) at (2.85,2.25);\n\\coordinate (C) at (3.8,-0.2);\n\\draw (A)--node[midway,above left=4pt] {$\\frac{3}{10}$} (B)--node[midway,right=4pt] {$\\frac{2}{5}$} (C)--node[midway,below=4pt] {$\\frac{1}{2}$} cycle;\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 48,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 9,
              "sourceRegion": "Question 2d, bottom-right grid cell",
              "description": "Unshaded triangle pointing left, with upper sloping side labelled 3/10, right side labelled 2/5 and lower sloping side labelled 1/2; no right-angle marker.",
              "mathematics": "The longest labelled side is 1/2. Compare the squares using exact fractions. Preserve the source orientation and use editable fraction labels.",
              "answerVisibility": "Only the three supplied side lengths are visible in the question."
