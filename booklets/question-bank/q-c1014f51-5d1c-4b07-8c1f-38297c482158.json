            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 9 p9-q2-b-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,draw=black,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (3.5,0);\n\\coordinate (C) at (0,3.0);\n\\draw (A)--node[midway,below=3pt] {$21$} (B)--node[midway,above right=3pt] {$29$} (C)--node[midway,left=3pt] {$20$} cycle;\n\\end{tikzpicture}",
