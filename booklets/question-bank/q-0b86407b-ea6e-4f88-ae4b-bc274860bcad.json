  "content": {
    "id": "p10-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A die is rolled. What is the probability of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "obtaining a 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "There are six equally likely outcomes. Only $3$ is favourable.\n\n$$P(3)=\\frac{1}{6}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "not obtaining a 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{6}$",
          "worked": "Not obtaining a $3$ is the complement of obtaining a $3$.\n\n$$\\begin{align*}P(\\text{not }3)&=1-\\frac{1}{6}\\\\P(\\text{not }3)&=\\frac{5}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "obtaining a number divisible by 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "The favourable outcomes are $3$ and $6$.\n\n$$\\begin{align*}P(\\text{divisible by }3)&=\\frac{2}{6}\\\\P(\\text{divisible by }3)&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "obtaining a number not divisible by 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "This is the complement of obtaining a number divisible by $3$.\n\n$$\\begin{align*}P(\\text{not divisible by }3)&=1-\\frac{1}{3}\\\\P(\\text{not divisible by }3)&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
