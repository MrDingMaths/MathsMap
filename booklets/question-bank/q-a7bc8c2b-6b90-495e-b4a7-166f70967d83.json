  "content": {
    "id": "v2-1ddc9-p55-practice-slot-9-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Solve each of these equations for $0\\leq\\theta\\leq180^{\\circ}$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1ddc9-p55-practice-slot-9-lower-slot-9-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\theta=\\frac{\\sqrt{3}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=30^{\\circ}$.",
          "worked": "$$\\begin{align*}A&=\\cos^{-1}\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\A&=30^{\\circ}\\end{align*}$$\n$\\cos\\theta>0$, so $\\theta$ is in Q1.\n$$\\theta=30^{\\circ}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-1ddc9-p55-practice-slot-9-lower-slot-9-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\theta=-\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=120^{\\circ}$.",
          "worked": "$$\\begin{align*}A&=\\cos^{-1}\\left(\\frac{1}{2}\\right)\\\\A&=60^{\\circ}\\end{align*}$$\n$\\cos\\theta<0$, so $\\theta$ is in Q2.\n$$\\begin{align*}\\theta&=180^{\\circ}-60^{\\circ}\\\\\\theta&=120^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-1ddc9-p55-practice-slot-9-lower-slot-9-lower-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos\\theta=-\\frac{1}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=135^{\\circ}$.",
          "worked": "$$\\begin{align*}A&=\\cos^{-1}\\left(\\frac{1}{\\sqrt{2}}\\right)\\\\A&=45^{\\circ}\\end{align*}$$\n$\\cos\\theta<0$, so $\\theta$ is in Q2.\n$$\\begin{align*}\\theta&=180^{\\circ}-45^{\\circ}\\\\\\theta&=135^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
