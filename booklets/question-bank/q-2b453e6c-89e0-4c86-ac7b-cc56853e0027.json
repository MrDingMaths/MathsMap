      {
        "id": "p20-q14",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_6(12)-\\log_6(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_6(12)-\\log_6(2)&=\\log_6\\left(\\frac{12}{2}\\right)\\\\\\log_6(12)-\\log_6(2)&=\\log_6(6)\\\\\\log_6(12)-\\log_6(2)&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q15",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_5(75)-\\log_5(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_5(75)-\\log_5(3)&=\\log_5\\left(\\frac{75}{3}\\right)\\\\\\log_5(75)-\\log_5(3)&=\\log_5(25)\\\\\\log_5(75)-\\log_5(3)&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q16",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2(20)-\\log_2(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_2(20)-\\log_2(5)&=\\log_2\\left(\\frac{20}{5}\\right)\\\\\\log_2(20)-\\log_2(5)&=\\log_2(4)\\\\\\log_2(20)-\\log_2(5)&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q17",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_5(2)-\\log_5(10)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\log_5(2)-\\log_5(10)&=\\log_5\\left(\\frac{2}{10}\\right)\\\\\\log_5(2)-\\log_5(10)&=\\log_5\\left(\\frac{1}{5}\\right)\\\\\\log_5(2)-\\log_5(10)&=\\log_5(5^{-1})\\\\\\log_5(2)-\\log_5(10)&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
