  "content": {
    "id": "p43-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the values of $p$ for which $y=px-3p-5$ is tangent to $x^2=8y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=\\dfrac{5}{2}$ or $p=-1$.",
      "worked": "$$\\begin{align*}x^2&=8(px-3p-5)\\\\x^2-8px+24p+40&=0\\end{align*}$$\nFor a tangent, $\\Delta=0$.\n$$\\begin{align*}(-8p)^2-4(1)(24p+40)&=0\\\\64p^2-96p-160&=0\\\\2p^2-3p-5&=0\\\\(2p-5)(p+1)&=0\\\\p&=\\frac{5}{2}\\text{ or }-1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
