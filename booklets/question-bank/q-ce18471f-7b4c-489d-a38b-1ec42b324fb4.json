    "label": null,
    "prompt": "Solve for $x$.\n$ax+3=bx+7$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac{4}{a-b}$ for $a\\ne b$. For $a=b$, there is no solution.",
      "worked": "For $a\\ne b$:\n$$\\begin{align*}ax-bx&=7-3\\\\x(a-b)&=4\\\\x&=\\frac{4}{a-b}\\end{align*}$$\nFor $a=b$, the original equation becomes $3=7$, so there is no solution.",
      "solutionDiagrams": []
    },
