  "content": {
    "id": "p19-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Determine the equation of the parabola $y=ax^2+bx+c$ that passes through $A(-1,0)$, $B(0,4)$ and $C(1,6)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-x^2+3x+4$",
      "worked": "Substitute the coordinates of $B(0,4)$:\n$$\\begin{align*}4&=a(0)^2+b(0)+c\\\\c&=4\\end{align*}$$\nSubstitute the coordinates of $A(-1,0)$ and $C(1,6)$:\n$$\\begin{align*}0&=a(-1)^2+b(-1)+4\\\\a-b&=-4\\tag{1}\\\\6&=a(1)^2+b(1)+4\\\\a+b&=2\\tag{2}\\end{align*}$$\nAdd (1) and (2), then substitute into (2):\n$$\\begin{align*}2a&=-2\\\\a&=-1\\\\-1+b&=2\\\\b&=3\\end{align*}$$\nTherefore $y=-x^2+3x+4$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
