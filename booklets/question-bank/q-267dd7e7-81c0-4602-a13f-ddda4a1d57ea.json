    "type": "question",
    "label": "38",
    "prompt": "Simplify $\\dfrac{\\binom{n+1}{k}}{\\binom{n}{k}}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{n+1}{n-k+1}$",
      "worked": "$$\\begin{align*}\\frac{\\binom{n+1}{k}}{\\binom{n}{k}}&=\\frac{(n+1)!}{k!(n+1-k)!}\\times\\frac{k!(n-k)!}{n!}\\\\\\frac{\\binom{n+1}{k}}{\\binom{n}{k}}&=\\frac{(n+1)n!(n-k)!}{n!(n-k+1)(n-k)!}\\\\\\frac{\\binom{n+1}{k}}{\\binom{n}{k}}&=\\frac{n+1}{n-k+1}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
