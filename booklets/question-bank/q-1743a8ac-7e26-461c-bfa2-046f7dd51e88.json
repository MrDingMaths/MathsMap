  "content": {
    "id": "p11-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Timber dowelling comes in fixed lengths. If 48 pieces, each 3.6 cm long, can be cut from a fixed length, how many pieces 3.2 cm long can be cut from the same fixed length?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "54 pieces",
      "worked": "Let $n$ be the number of pieces and $l$ their length in centimetres. The fixed total length gives $nl=k$.\n$$\\begin{align*}k&=48\\times3.6\\\\k&=172.8\\\\n&=\\frac{172.8}{3.2}\\\\n&=54\\end{align*}$$\nTherefore, 54 pieces can be cut.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
