    "type": "question",
    "label": "7",
    "prompt": "At the final of a tennis tournament, $15\\%$ of the reserved seats are vacant. If there is a total of 860 reserve seats, how many are vacant?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "129 seats.",
      "worked": "$$\\begin{align*}\\text{Number of vacant seats}&=\\frac{15}{100}\\times860\\\\\\text{Number of vacant seats}&=\\frac{3}{20}\\times860\\\\\\text{Number of vacant seats}&=129\\end{align*}$$\nThere are 129 vacant seats.",
      "solutionDiagrams": []
    },
