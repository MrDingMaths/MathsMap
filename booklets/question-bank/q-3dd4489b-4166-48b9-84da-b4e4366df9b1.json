    "label": "2",
    "prompt": "Prove:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan\\alpha\\operatorname{cosec}\\alpha=\\sec\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\alpha\\operatorname{cosec}\\alpha=\\dfrac{1}{\\cos\\alpha}=\\sec\\alpha$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sin\\alpha}{\\cos\\alpha}\\cdot\\left(\\frac{1}{\\sin\\alpha}\\right)\\\\\\mathrm{LHS}&=\\frac{1}{\\cos\\alpha}\\\\\\mathrm{LHS}&=\\sec\\alpha\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cot\\beta\\sec\\beta=\\operatorname{cosec}\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\beta\\sec\\beta=\\dfrac{1}{\\sin\\beta}=\\operatorname{cosec}\\beta$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\cos\\beta}{\\sin\\beta}\\cdot\\left(\\frac{1}{\\cos\\beta}\\right)\\\\\\mathrm{LHS}&=\\frac{1}{\\sin\\beta}\\\\\\mathrm{LHS}&=\\operatorname{cosec}\\beta\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\operatorname{cosec}^{2}\\gamma+\\sec^{2}\\gamma=\\operatorname{cosec}^{2}\\gamma\\sec^{2}\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{cosec}^{2}\\gamma+\\sec^{2}\\gamma=\\dfrac{1}{\\sin^{2}\\gamma\\cos^{2}\\gamma}=\\operatorname{cosec}^{2}\\gamma\\sec^{2}\\gamma$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{1}{\\sin^{2}\\gamma}+\\frac{1}{\\cos^{2}\\gamma}\\\\\\mathrm{LHS}&=\\frac{\\cos^{2}\\gamma+\\sin^{2}\\gamma}{\\sin^{2}\\gamma\\cos^{2}\\gamma}\\\\\\mathrm{LHS}&=\\frac{1}{\\sin^{2}\\gamma\\cos^{2}\\gamma}\\\\\\mathrm{LHS}&=\\left(\\frac{1}{\\sin^{2}\\gamma}\\right)\\left(\\frac{1}{\\cos^{2}\\gamma}\\right)\\\\\\mathrm{LHS}&=\\operatorname{cosec}^{2}\\gamma\\sec^{2}\\gamma\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p32-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan\\delta+\\cot\\delta=\\operatorname{cosec}\\delta\\sec\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\delta+\\cot\\delta=\\dfrac{1}{\\sin\\delta\\cos\\delta}=\\operatorname{cosec}\\delta\\sec\\delta$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sin\\delta}{\\cos\\delta}+\\frac{\\cos\\delta}{\\sin\\delta}\\\\\\mathrm{LHS}&=\\frac{\\sin^{2}\\delta+\\cos^{2}\\delta}{\\sin\\delta\\cos\\delta}\\\\\\mathrm{LHS}&=\\frac{1}{\\sin\\delta\\cos\\delta}\\\\\\mathrm{LHS}&=\\left(\\frac{1}{\\sin\\delta}\\right)\\cdot\\left(\\frac{1}{\\cos\\delta}\\right)\\\\\\mathrm{LHS}&=\\operatorname{cosec}\\delta\\sec\\delta\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p32-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\operatorname{cosec}\\varphi-\\sin\\varphi=\\cos\\varphi\\cot\\varphi$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{cosec}\\varphi-\\sin\\varphi=\\dfrac{\\cos^{2}\\varphi}{\\sin\\varphi}=\\cos\\varphi\\cot\\varphi$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{1}{\\sin\\varphi}-\\sin\\varphi\\\\\\mathrm{LHS}&=\\frac{1-\\sin^{2}\\varphi}{\\sin\\varphi}\\\\\\mathrm{LHS}&=\\frac{\\cos^{2}\\varphi}{\\sin\\varphi}\\\\\\mathrm{LHS}&=\\cos\\varphi\\cdot\\frac{\\cos\\varphi}{\\sin\\varphi}\\\\\\mathrm{LHS}&=\\cos\\varphi\\cot\\varphi\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p32-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sec\\theta-\\cos\\theta=\\tan\\theta\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sec\\theta-\\cos\\theta=\\dfrac{\\sin^{2}\\theta}{\\cos\\theta}=\\tan\\theta\\sin\\theta$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{1}{\\cos\\theta}-\\cos\\theta\\\\\\mathrm{LHS}&=\\frac{1-\\cos^{2}\\theta}{\\cos\\theta}\\\\\\mathrm{LHS}&=\\frac{\\sin^{2}\\theta}{\\cos\\theta}\\\\\\mathrm{LHS}&=\\sin\\theta\\cdot\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\mathrm{LHS}&=\\sin\\theta\\tan\\theta\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p32-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{1}{\\sin\\theta\\cos\\theta}-\\tan\\theta=\\cot\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{\\sin\\theta\\cos\\theta}-\\tan\\theta=\\dfrac{\\cos\\theta}{\\sin\\theta}=\\cot\\theta$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{1}{\\sin\\theta\\cos\\theta}-\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\mathrm{LHS}&=\\frac{1-\\sin^{2}\\theta}{\\sin\\theta\\cos\\theta}\\\\\\mathrm{LHS}&=\\frac{\\cos^{2}\\theta}{\\sin\\theta\\cos\\theta}\\\\\\mathrm{LHS}&=\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\mathrm{LHS}&=\\cot\\theta\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p32-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\tan\\theta(1-\\cot^{2}\\theta)+\\cot\\theta(1-\\tan^{2}\\theta)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\tan\\theta-\\cot\\theta+\\cot\\theta-\\tan\\theta=0=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\tan\\theta-\\tan\\theta\\cot^{2}\\theta +\\cot\\theta-\\cot\\theta\\tan^{2}\\theta\\\\\\mathrm{LHS}&=\\tan\\theta-\\tan\\theta\\cdot\\left(\\frac{1}{\\tan^{2}\\theta}\\right) +\\cot\\theta-\\cot\\theta\\cdot\\tan^{2}\\theta\\\\\\mathrm{LHS}&=\\tan\\theta-\\frac{1}{\\tan\\theta} +\\cot\\theta-\\frac{\\tan^{2}\\theta}{\\tan\\theta}\\\\\\mathrm{LHS}&=\\tan\\theta-\\cot\\theta +\\cot\\theta-\\tan\\theta\\\\\\mathrm{LHS}&=0\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
