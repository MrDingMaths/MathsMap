  "content": {
    "id": "p49-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A ball is tossed from the origin $O$ that is $6\\text{ m}$ above ground level.\nThe initial velocity is $24\\text{ m/s}$ at an angle of $30^\\circ$ above the horizontal. Use $g=10\\text{ m/s}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\dot{x}$, $\\dot{y}$, $x$ and $y$ as functions of $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dot{x}=12\\sqrt3$, $\\dot{y}=12-10t$, $x=12\\sqrt3\\,t$, $y=12t-5t^2$.",
          "worked": "$$\\begin{aligned}\\dot{x}(0)&=24\\cos30^\\circ=12\\sqrt3\\\\\\dot{y}(0)&=24\\sin30^\\circ=12\\end{aligned}$$\nUsing $\\ddot{x}=0$, $\\ddot{y}=-10$ and $x(0)=y(0)=0$,\n$$\\begin{aligned}\\dot{x}&=12\\sqrt3\\\\\\dot{y}&=12-10t\\\\x&=12\\sqrt3\\,t\\\\y&=12t-5t^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p49-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the Cartesian equation of the path is $y=\\dfrac{1}{\\sqrt3}x-\\dfrac{5}{432}x^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{\\sqrt3}x-\\dfrac{5}{432}x^2$.",
          "worked": "$$t=\\frac{x}{12\\sqrt3}$$\n$$\\begin{aligned}y&=-5\\left(\\frac{x}{12\\sqrt3}\\right)^2+12\\left(\\frac{x}{12\\sqrt3}\\right)\\\\&=-\\frac{5x^2}{432}+\\frac{x}{\\sqrt3}\\\\&=\\frac{1}{\\sqrt3}x-\\frac{5}{432}x^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p49-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "If $D$ metres is the horizontal distance travelled when it strikes the ground, show that\n$$5D^2-144\\sqrt3\\,D-2592=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5D^2-144\\sqrt3\\,D-2592=0$.",
          "worked": "At ground level, $y=-6$ and $x=D$.\n$$\\begin{aligned}\\frac{D}{\\sqrt3}-\\frac{5D^2}{432}&=-6\\\\144\\sqrt3\\,D-5D^2&=-2592\\\\5D^2-144\\sqrt3\\,D-2592&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p49-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find $D$ correct to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$58.7\\text{ m}$.",
          "worked": "$$\\begin{aligned}D&=\\frac{144\\sqrt3\\pm\\sqrt{(144\\sqrt3)^2-4(5)(-2592)}}{10}\\\\&=\\frac{144\\sqrt3\\pm\\sqrt{62208+51840}}{10}\\end{aligned}$$\nSince $D>0$, take the positive root:\n$$D=\\frac{144\\sqrt3+\\sqrt{114048}}{10}\\approx58.7\\text{ m}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
