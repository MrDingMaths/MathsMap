        "prompt": "$2.302 \\times 10^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.30 \\times 10^{2}$",
          "worked": "Round the coefficient to the nearest hundredth. The next digit is $2$, so the hundredths digit stays unchanged.\n$$\\begin{aligned}2.302 &\\approx 2.30\\end{aligned}$$\nHence $2.30 \\times 10^{2}$ (3 s.f.). The final zero is significant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$4.897 \\times 10^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.90 \\times 10^{-4}$",
          "worked": "Round the coefficient to the nearest hundredth. The next digit is $7$, so round up.\n$$\\begin{aligned}4.897 &\\approx 4.90\\end{aligned}$$\nHence $4.90 \\times 10^{-4}$ (3 s.f.). The final zero is significant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$3.996 \\times 10^{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.00 \\times 10^{6}$",
          "worked": "Round the coefficient to the nearest hundredth. The next digit is $6$, so round up, carrying into the units digit.\n$$\\begin{aligned}3.996 &\\approx 4.00\\end{aligned}$$\nHence $4.00 \\times 10^{6}$ (3 s.f.). Both final zeroes are significant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
