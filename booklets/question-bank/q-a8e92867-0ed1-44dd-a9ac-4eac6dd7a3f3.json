  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Decide, by substitution, whether the following points are in the region defined by $2x-3y>8$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(5,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$2(5)-3(0)=10>8$$\nYes, the point lies in the region.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2.5,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{aligned}2(2.5)-3(-1)&=8\\end{aligned}$$\n$8>8$ is false. The point lies on the excluded boundary.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(0,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{aligned}2(0)-3(-1)&=3\\end{aligned}$$\n$3>8$ is false, so the point does not lie in the region.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2,-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$2(2)-3(-5)=19>8$$\nYes, the point lies in the region.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
