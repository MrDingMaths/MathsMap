  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^n\\times4^n\\times8^n\\times16^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{10n}$",
          "worked": "$$\\begin{align*}2^n\\times4^n\\times8^n\\times16^n&=2^n\\times2^{2n}\\times2^{3n}\\times2^{4n}\\\\2^n\\times4^n\\times8^n\\times16^n&=2^{n+2n+3n+4n}\\\\2^n\\times4^n\\times8^n\\times16^n&=2^{10n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{49^{-n}\\times7}{7^{3n}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{1-5n}$",
          "worked": "$$\\begin{align*}\\frac{49^{-n}\\times7}{7^{3n}}&=\\frac{7^{-2n}\\times7^1}{7^{3n}}\\\\\\frac{49^{-n}\\times7}{7^{3n}}&=7^{1-5n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p8-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3^n\\times9^{n+1}}{27^{n-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^8$",
          "worked": "$$\\begin{align*}\\frac{3^n\\times9^{n+1}}{27^{n-2}}&=\\frac{3^n\\times3^{2n+2}}{3^{3n-6}}\\\\\\frac{3^n\\times9^{n+1}}{27^{n-2}}&=3^{n+2n+2-(3n-6)}\\\\\\frac{3^n\\times9^{n+1}}{27^{n-2}}&=3^8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{9^n-1}{3^n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^n+1$, for $n\\ne0$.",
          "worked": "The original denominator is nonzero for $n\\ne0$.\n\n$$\\begin{align*}\\frac{9^n-1}{3^n-1}&=\\frac{(3^n)^2-1^2}{3^n-1}\\\\\\frac{9^n-1}{3^n-1}&=\\frac{(3^n-1)(3^n+1)}{3^n-1}\\\\\\frac{9^n-1}{3^n-1}&=3^n+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{5^{2n}-5^n}{5^n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^n$, for $n\\ne0$.",
          "worked": "The original denominator is nonzero for $n\\ne0$.\n\n$$\\begin{align*}\\frac{5^{2n}-5^n}{5^n-1}&=\\frac{5^n(5^n-1)}{5^n-1}\\\\\\frac{5^{2n}-5^n}{5^n-1}&=5^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
