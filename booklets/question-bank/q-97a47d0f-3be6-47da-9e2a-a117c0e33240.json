  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the new amount after each of the percentage changes.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\$155\\,000$ increased by $20\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$186\\,000$",
          "worked": "$$\\begin{align*}\\text{Increase}&=\\frac{20}{100}\\times155\\,000\\\\\\text{Increase}&=31\\,000\\\\\\text{New amount}&=155\\,000+31\\,000\\\\\\text{New amount}&=186\\,000\\end{align*}$$\n\nThe new amount is $\\$186\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\$60\\,000$ decreased by $5\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$57\\,000$",
          "worked": "$$\\begin{align*}\\text{Decrease}&=\\frac{5}{100}\\times60\\,000\\\\\\text{Decrease}&=3000\\\\\\text{New amount}&=60\\,000-3000\\\\\\text{New amount}&=57\\,000\\end{align*}$$\n\nThe new amount is $\\$57\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\$32\\,000$ increased by $15\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$36\\,800$",
          "worked": "$$\\begin{align*}\\text{Increase}&=\\frac{15}{100}\\times32\\,000\\\\\\text{Increase}&=4800\\\\\\text{New amount}&=32\\,000+4800\\\\\\text{New amount}&=36\\,800\\end{align*}$$\n\nThe new amount is $\\$36\\,800$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$108\\,000$ hectares increased by $24\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$133\\,920$ hectares",
          "worked": "$$\\begin{align*}\\text{Increase}&=\\frac{24}{100}\\times108\\,000\\\\\\text{Increase}&=25\\,920\\\\\\text{New area}&=108\\,000+25\\,920\\\\\\text{New area}&=133\\,920\\end{align*}$$\n\nThe new area is $133\\,920$ hectares.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
