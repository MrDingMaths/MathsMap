  "content": {
    "id": "p3-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A bucket full of water has a leak, and the volume after $t$ minutes is given by\n$$V(t)=t^2-4t+4,$$\nwhere $V$ is measured in litres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q2-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the average rate of change of $V$.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p3-q2-a-i",
            "type": "part",
            "label": "i",
            "prompt": "during the first minute.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-3\\text{ L/min}$.",
              "worked": "$$\\begin{align*}V(0)&=0^2-4(0)+4=4,\\\\V(1)&=1^2-4(1)+4=1,\\\\\\text{Average rate}&=\\frac{1-4}{1-0}\\\\\\text{Average rate}&=-3\\text{ L/min}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p3-q2-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "over the first 2 minutes.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2\\text{ L/min}$.",
              "worked": "$$\\begin{align*}V(0)&=0^2-4(0)+4=4,\\\\V(2)&=2^2-4(2)+4=0,\\\\\\text{Average rate}&=\\frac{0-4}{2-0}\\\\\\text{Average rate}&=-2\\text{ L/min}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      },
      {
        "id": "p3-q2-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p3-q2-b-instruction",
              "type": "paragraph",
