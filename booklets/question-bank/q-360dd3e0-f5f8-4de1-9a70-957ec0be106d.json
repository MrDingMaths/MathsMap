      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2+6x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $x=-2$",
          "worked": "Divide both sides by $2$.\n\n$$\\begin{align*}x^2+3x+2&=0\\\\(x+1)(x+2)&=0\\\\x+1&=0\\quad\\text{or}\\quad x+2=0\\\\x&=-1\\quad\\text{or}\\quad x=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$3a^2-15a+18=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3$ or $a=2$",
          "worked": "Divide both sides by $3$.\n\n$$\\begin{align*}a^2-5a+6&=0\\\\(a-3)(a-2)&=0\\\\a-3&=0\\quad\\text{or}\\quad a-2=0\\\\a&=3\\quad\\text{or}\\quad a=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$4x^2+8x-140=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7$ or $x=5$",
          "worked": "Divide both sides by $4$.\n\n$$\\begin{align*}x^2+2x-35&=0\\\\(x+7)(x-5)&=0\\\\x+7&=0\\quad\\text{or}\\quad x-5=0\\\\x&=-7\\quad\\text{or}\\quad x=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
