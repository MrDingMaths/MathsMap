  "content": {
    "id": "v2-7fb87d-p8-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "The number of text messages 12 students sent yesterday is shown.\n\n$14,\\ 9,\\ 21,\\ 12,\\ 17,\\ 9,\\ 25,\\ 15,\\ 11,\\ 19,\\ 13,\\ 16$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-7fb87d-p8-practice-slot-1-s1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the range",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$ messages",
          "worked": "Ordered data: $9,9,11,12,13,14,15,16,17,19,21,25$.\n$$\\begin{align*}\\text{Range}&=25-9\\\\&=16\\text{ messages}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-7fb87d-p8-practice-slot-1-s1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the median",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14.5$ messages",
          "worked": "There are $12$ values, so the median is the mean of the sixth and seventh values.\n$$\\begin{align*}\\text{Median}&=\\frac{14+15}{2}\\\\&=14.5\\text{ messages}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-7fb87d-p8-practice-slot-1-s1-q-c",
        "type": "group",
        "label": "c",
        "prompt": "Find the:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "v2-7fb87d-p8-practice-slot-1-s1-q-c-i",
            "type": "part",
            "label": "i",
            "prompt": "lower quartile",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$11.5$ messages",
              "worked": "The lower half is $9,9,11,12,13,14$.\n$$\\begin{align*}Q_1&=\\frac{11+12}{2}\\\\&=11.5\\text{ messages}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "v2-7fb87d-p8-practice-slot-1-s1-q-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "upper quartile",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$18$ messages",
              "worked": "The upper half is $15,16,17,19,21,25$.\n$$\\begin{align*}Q_3&=\\frac{17+19}{2}\\\\&=18\\text{ messages}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "v2-7fb87d-p8-practice-slot-1-s1-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the interquartile range",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.5$ messages",
          "worked": "$$\\begin{align*}\\mathrm{IQR}&=Q_3-Q_1\\\\&=18-11.5\\\\&=6.5\\text{ messages}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-7fb87d-p8-practice-slot-1-s1-q-e",
        "type": "part",
        "label": "e",
        "prompt": "A 13th student sent $18$ messages. Find the new interquartile range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$ messages",
          "worked": "Ordered data: $9,9,11,12,13,14,15,16,17,18,19,21,25$.\nThe median is the seventh value, $15$. Excluding it:\n$$\\begin{align*}Q_1&=\\frac{11+12}{2}=11.5\\\\Q_3&=\\frac{18+19}{2}=18.5\\\\\\mathrm{IQR}&=18.5-11.5\\\\&=7\\text{ messages}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
