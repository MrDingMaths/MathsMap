        "label": "a",
        "prompt": "$2\\sqrt{3}+3\\sqrt{2}-\\sqrt{3}+2\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{3}+3\\sqrt{2}$",
          "worked": "$$\\begin{align*}2\\sqrt{3}+3\\sqrt{2}-\\sqrt{3}+2\\sqrt{3}&=(2-1+2)\\sqrt{3}+3\\sqrt{2}\\\\&=3\\sqrt{3}+3\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$3\\sqrt{5}-4\\sqrt{2}+\\sqrt{5}-3\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{5}-7\\sqrt{2}$",
          "worked": "$$\\begin{align*}3\\sqrt{5}-4\\sqrt{2}+\\sqrt{5}-3\\sqrt{2}&=(3+1)\\sqrt{5}-(4+3)\\sqrt{2}\\\\&=4\\sqrt{5}-7\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$5\\sqrt{2}+2\\sqrt{5}-7\\sqrt{2}-\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\sqrt{2}+\\sqrt{5}$",
          "worked": "$$\\begin{align*}5\\sqrt{2}+2\\sqrt{5}-7\\sqrt{2}-\\sqrt{5}&=(5-7)\\sqrt{2}+(2-1)\\sqrt{5}\\\\&=-2\\sqrt{2}+\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\sqrt{3}+2\\sqrt{7}+2\\sqrt{3}-2\\sqrt{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{3}$",
          "worked": "$$\\begin{align*}2\\sqrt{3}+2\\sqrt{7}+2\\sqrt{3}-2\\sqrt{7}&=(2+2)\\sqrt{3}+(2-2)\\sqrt{7}\\\\&=4\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$5\\sqrt{11}+3\\sqrt{6}-3\\sqrt{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{11}+3\\sqrt{6}$",
          "worked": "$$\\begin{align*}5\\sqrt{11}+3\\sqrt{6}-3\\sqrt{11}&=(5-3)\\sqrt{11}+3\\sqrt{6}\\\\&=2\\sqrt{11}+3\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$-4\\sqrt{10}-5\\sqrt{2}+\\sqrt{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\sqrt{10}-5\\sqrt{2}$",
          "worked": "$$\\begin{align*}-4\\sqrt{10}-5\\sqrt{2}+\\sqrt{10}&=(-4+1)\\sqrt{10}-5\\sqrt{2}\\\\&=-3\\sqrt{10}-5\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
