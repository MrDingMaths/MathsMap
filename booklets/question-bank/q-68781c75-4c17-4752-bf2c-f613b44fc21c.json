  "content": {
    "id": "p53-q2-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $y'=ky$, where $k$ is an unknown constant.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=Ae^{kx}$.",
          "worked": "$$\\begin{align*}\\frac{dy}{y}&=k\\,dx\\\\\\ln|y|&=kx+C\\\\y&=Ae^{kx}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p53-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate the arbitrary constant given $y(0)=8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=8$, so $y=8e^{kx}$.",
          "worked": "$$\\begin{align*}8&=Ae^{k(0)}\\\\A&=8\\\\y&=8e^{kx}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p53-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Evaluate $k$ given $y(2)=18$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\ln\\left(\\frac32\\right)$.",
          "worked": "$$\\begin{align*}18&=8e^{2k}\\\\e^{2k}&=\\frac94\\\\2k&=\\ln\\frac94\\\\k&=\\ln\\frac32.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p53-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Simplify the solution and evaluate $y(4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=8\\left(\\frac32\\right)^x$; $y(4)=40.5$.",
          "worked": "$$\\begin{align*}y&=8e^{x\\ln(3/2)}\\\\y&=8\\left(\\frac32\\right)^x\\\\y(4)&=8\\left(\\frac32\\right)^4\\\\y(4)&=\\frac{81}{2}=40.5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
