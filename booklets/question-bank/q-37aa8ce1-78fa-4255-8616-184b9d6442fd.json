  "content": {
    "id": "v2-ion--p6-foundation-slot-1-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Leo says, “Postcodes are numerical data because they are numbers, and 3000 is bigger than 2000.” Explain why he is incorrect.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Categorical nominal — postcodes are labels for places, with no natural order.",
      "worked": "A postcode names a location, so it is a category and the data are categorical. The numbers are only labels: they are not amounts, counts or measurements. Having 3000 larger than 2000 does not rank the places, so there is no natural order and the data are nominal.",
      "solutionDiagrams": []
    },
