    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q15-a",
        "type": "group",
        "label": "a",
        "prompt": "Solve each of the following quadratic equations:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q15-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$x^2+2x=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-3,\\ 1$.",
              "worked": "$$\\begin{align*}x^2+2x-3&=0\\\\(x+3)(x-1)&=0\\\\x&=-3\\text{ or }1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p7-q15-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x^2+3x=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-4,\\ 1$.",
              "worked": "$$\\begin{align*}x^2+3x-4&=0\\\\(x+4)(x-1)&=0\\\\x&=-4\\text{ or }1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p7-q15-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$x^2+4x=5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-5,\\ 1$.",
              "worked": "$$\\begin{align*}x^2+4x-5&=0\\\\(x+5)(x-1)&=0\\\\x&=-5\\text{ or }1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      },
      {
        "id": "p7-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $k\\in\\mathbb R$. Solve the quadratic equation $x^2+kx=k+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-(k+1)$ or $x=1$.",
          "worked": "$$\\begin{align*}x^2+kx-(k+1)&=0\\\\(x-1)(x+k+1)&=0\\\\x&=1\\text{ or }-(k+1)\\end{align*}$$\nWhen $k=-2$, the two roots coincide at $x=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
