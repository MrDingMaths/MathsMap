  "content": {
    "id": "p10-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the dimensions of a rectangle with area $10\\text{ cm}^2$ and a perimeter $13\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
