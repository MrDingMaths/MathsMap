  "content": {
    "id": "v2-da9597-p6-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "A fair coin is tossed 6 times and the result is recorded.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-da9597-p6-practice-slot-3-slot3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the probability of exactly 2 heads.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{15}{64}$",
          "worked": "There are $2^6=64$ equally likely outcomes. Choose the positions of the 2 heads:\n$$\\begin{aligned}\\text{Favourable outcomes}&=\\binom{6}{2}\\\\&=15\\end{aligned}$$\n$$P(\\text{2 heads})=\\frac{15}{64}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-da9597-p6-practice-slot-3-slot3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the probability of at least 5 heads.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{64}$",
          "worked": "There are $2^6=64$ equally likely outcomes. At least 5 heads means exactly 5 heads or exactly 6 heads.\n$$\\begin{aligned}\\text{Favourable outcomes}&=\\binom{6}{5}+\\binom{6}{6}\\\\&=6+1\\\\&=7\\end{aligned}$$\n$$P(\\text{at least 5 heads})=\\frac{7}{64}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
