        "label": "a",
        "prompt": "Differentiate $e^{x^2+3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2xe^{x^2+3}$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}\\left(e^{x^2+3}\\right)&=e^{x^2+3}\\frac{d}{dx}(x^2+3)\\\\&=2xe^{x^2+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p58-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\int 2xe^{x^2+3}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^{x^2+3}+C$",
          "worked": "From part a, $\\dfrac{d}{dx}\\left(e^{x^2+3}\\right)=2xe^{x^2+3}$. Therefore,\n$$\\int 2xe^{x^2+3}\\,dx=e^{x^2+3}+C.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
