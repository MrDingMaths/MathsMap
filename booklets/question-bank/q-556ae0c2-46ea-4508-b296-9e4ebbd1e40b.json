  "content": {
    "id": "p5-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Show that the triangle with vertices $X(-3,1)$, $Y(0,2)$ and $Z(-2,4)$ is isosceles.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$XY=XZ=\\sqrt{10}$, so the triangle is isosceles.",
      "worked": "$$\\begin{align*}XY^2&=(0-(-3))^2+(2-1)^2\\\\XY^2&=9+1\\\\XY^2&=10\\\\XY&=\\sqrt{10}\\\\XZ^2&=(-2-(-3))^2+(4-1)^2\\\\XZ^2&=1+9\\\\XZ^2&=10\\\\XZ&=\\sqrt{10}\\end{align*}$$\nSince $XY=XZ$, triangle $XYZ$ is isosceles.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
