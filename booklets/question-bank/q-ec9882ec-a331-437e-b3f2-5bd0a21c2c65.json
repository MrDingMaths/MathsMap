  "content": {
    "id": "p6-q6-root",
    "type": "question",
    "label": null,
    "prompt": "Find the unknown number described in each of the following cases:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "When an unknown number is added to 10, the result is 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}x+10&=4\\\\x+10-10&=4-10\\\\x&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "When 7 is subtracted from an unknown number, the result is $-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}x-7&=-3\\\\x-7+7&=-3+7\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "When an unknown number is taken from 8, the result is $-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}8-x&=-3\\\\x-3&=8\\\\x-3+3&=8+3\\\\x&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "When twice an unknown number is added to 9, the result is 7.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}2x+9&=7\\\\2x+9-9&=7-9\\\\2x&=-2\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "When five is multiplied by the sum of an unknown number and 5, the result is 30.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}5(x+5)&=30\\\\x+5&=6\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "When 4 is taken from twice an unknown number, the result is $-11$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{7}{2}$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}2x-4&=-11\\\\2x-4+4&=-11+4\\\\2x&=-7\\\\x&=-\\frac{7}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "When twice an unknown number is taken from 3, the result is 6.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3}{2}$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}3-2x&=6\\\\2x+6&=3\\\\2x&=-3\\\\x&=-\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "When the sum of an unknown number and 4 is divided by 3, the result is $-5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-19$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}\\frac{x+4}{3}&=-5\\\\x+4&=-15\\\\x&=-19\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "When 3 is taken from half an unknown number, the result is 10.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}\\frac{x}{2}-3&=10\\\\\\frac{x}{2}&=13\\\\x&=26\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p6-q6-j",
        "type": "part",
        "label": "j",
        "prompt": "When 9 is added to one third of an unknown number, the result is 8.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "Let $x$ be the unknown number.\n$$\\begin{align*}\\frac{x}{3}+9&=8\\\\\\frac{x}{3}&=-1\\\\x&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
