    "children": [
      {
        "id": "p5-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression for the total area of the frame and the picture.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A_{\\text{total}}&=(2x)(x)\\\\&=2x^2\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p5-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find an expression for the area of the picture, in expanded form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x^2-30x+100)\\text{ cm}^2$",
          "worked": "The picture dimensions are $(2x-10)$ cm and $(x-10)$ cm.\n$$\\begin{align*}A_{\\text{picture}}&=(2x-10)(x-10)\\\\&=2x^2-20x-10x+100\\\\&=(2x^2-30x+100)\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
