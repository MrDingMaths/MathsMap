        "children": [],
        "answer": {
          "short": "$a=c^3$",
          "worked": "$$\\begin{align*}\\sqrt[3]{a}&=c\\\\a&=c^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q5-l",
