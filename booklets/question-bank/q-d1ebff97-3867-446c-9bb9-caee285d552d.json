  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Rearrange these equations to make $a$ the subject.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$2a^2=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm\\sqrt{\\frac{c}{2}}$",
          "worked": "$$\\begin{align*}2a^2&=c\\\\a^2&=\\frac{c}{2}\\\\a&=\\pm\\sqrt{\\frac{c}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$2a^2+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm\\sqrt{\\frac{c-b}{2}}$",
          "worked": "$$\\begin{align*}2a^2+b&=c\\\\2a^2&=c-b\\\\a^2&=\\frac{c-b}{2}\\\\a&=\\pm\\sqrt{\\frac{c-b}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$2a^2-b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm\\sqrt{\\frac{c+b}{2}}$",
          "worked": "$$\\begin{align*}2a^2-b&=c\\\\2a^2&=c+b\\\\a^2&=\\frac{c+b}{2}\\\\a&=\\pm\\sqrt{\\frac{c+b}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$4a^2-b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm\\sqrt{\\frac{c+b}{4}}$",
          "worked": "$$\\begin{align*}4a^2-b&=c\\\\4a^2&=c+b\\\\a^2&=\\frac{c+b}{4}\\\\a&=\\pm\\sqrt{\\frac{c+b}{4}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$64a^2-b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm\\sqrt{\\frac{c+b}{64}}$",
          "worked": "$$\\begin{align*}64a^2-b&=c\\\\64a^2&=c+b\\\\a^2&=\\frac{c+b}{64}\\\\a&=\\pm\\sqrt{\\frac{c+b}{64}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$64a^3-b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\sqrt[3]{\\frac{c+b}{64}}$",
          "worked": "$$\\begin{align*}64a^3-b&=c\\\\64a^3&=c+b\\\\a^3&=\\frac{c+b}{64}\\\\a&=\\sqrt[3]{\\frac{c+b}{64}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{\\sqrt{a}}{2}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=(2c)^2$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{a}}{2}&=c\\\\\\sqrt{a}&=2c\\\\a&=(2c)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$2\\sqrt{a}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\left(\\frac{c}{2}\\right)^2$",
          "worked": "$$\\begin{align*}2\\sqrt{a}&=c\\\\\\sqrt{a}&=\\frac{c}{2}\\\\a&=\\left(\\frac{c}{2}\\right)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$2\\sqrt{a}+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\left(\\frac{c-b}{2}\\right)^2$",
          "worked": "$$\\begin{align*}2\\sqrt{a}+b&=c\\\\2\\sqrt{a}&=c-b\\\\\\sqrt{a}&=\\frac{c-b}{2}\\\\a&=\\left(\\frac{c-b}{2}\\right)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p11-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$2\\sqrt{3a}+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{\\left(\\frac{c-b}{2}\\right)^2}{3}$",
          "worked": "$$\\begin{align*}2\\sqrt{3a}+b&=c\\\\2\\sqrt{3a}&=c-b\\\\\\sqrt{3a}&=\\frac{c-b}{2}\\\\3a&=\\left(\\frac{c-b}{2}\\right)^2\\\\a&=\\frac{\\left(\\frac{c-b}{2}\\right)^2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p11-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\sqrt[3]{a}=c$",
        "layout": "list",
        "columns": null,
