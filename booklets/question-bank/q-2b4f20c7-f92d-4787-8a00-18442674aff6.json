    "id": "p21-ex9d-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Sketch the graph of $y=2^{-x}$, $y=3^{-x}$ and $y=5^{-x}$ on the one set of axes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
