    "children": [
      {
        "id": "p56-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(2x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate left by 4, then dilate horizontally by factor $\\frac12$; or dilate horizontally by factor $\\frac12$, then translate left by 2.",
          "worked": "Translate left by 4, then dilate horizontally by factor $\\frac12$:\n$$\\begin{align*}y&=f(x)\\\\y&=f(x+4)\\\\y&=f(2x+4)\\end{align*}$$\nAlternatively, dilate horizontally by factor $\\frac12$, then translate left by 2:\n$$\\begin{align*}y&=f(x)\\\\y&=f(2x)\\\\y&=f(2(x+2))\\\\y&=f(2x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p56-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(3x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate right by 2, then dilate horizontally by factor $\\frac13$; or dilate horizontally by factor $\\frac13$, then translate right by $\\frac23$.",
          "worked": "Translate right by 2, then dilate horizontally by factor $\\frac13$:\n$$\\begin{align*}y&=f(x)\\\\y&=f(x-2)\\\\y&=f(3x-2)\\end{align*}$$\nAlternatively, dilate horizontally by factor $\\frac13$, then translate right by $\\frac23$:\n$$\\begin{align*}y&=f(x)\\\\y&=f(3x)\\\\y&=f\\left(3\\left(x-\\frac23\\right)\\right)\\\\y&=f(3x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p56-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(2x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate right by 1, then dilate horizontally by factor $\\frac12$; or dilate horizontally by factor $\\frac12$, then translate right by $\\frac12$.",
          "worked": "Translate right by 1, then dilate horizontally by factor $\\frac12$:\n$$\\begin{align*}y&=f(x)\\\\y&=f(x-1)\\\\y&=f(2x-1)\\end{align*}$$\nAlternatively, dilate horizontally by factor $\\frac12$, then translate right by $\\frac12$:\n$$\\begin{align*}y&=f(x)\\\\y&=f(2x)\\\\y&=f\\left(2\\left(x-\\frac12\\right)\\right)\\\\y&=f(2x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p56-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(3x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate left by 1, then dilate horizontally by factor $\\frac13$; or dilate horizontally by factor $\\frac13$, then translate left by $\\frac13$.",
          "worked": "Translate left by 1, then dilate horizontally by factor $\\frac13$:\n$$\\begin{align*}y&=f(x)\\\\y&=f(x+1)\\\\y&=f(3x+1)\\end{align*}$$\nAlternatively, dilate horizontally by factor $\\frac13$, then translate left by $\\frac13$:\n$$\\begin{align*}y&=f(x)\\\\y&=f(3x)\\\\y&=f\\left(3\\left(x+\\frac13\\right)\\right)\\\\y&=f(3x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
