  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The weight of a steel beam, $w$, varies directly with its length, $l$.\n\nA 1200 mm steel beam weighs 144 kg.\n\nCalculate the weight of a 750 mm steel beam.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "90 kg",
      "worked": "$$\\begin{align*}w &= kl\\\\144 &= k\\times1200\\\\k &= \\frac{144}{1200}\\\\k &= 0.12\\\\w &= 0.12l\\\\w &= 0.12\\times750\\\\w &= 90\\end{align*}$$\nThe steel beam weighs 90 kg.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
