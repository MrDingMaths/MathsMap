        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{n}{100}=\\frac{25}{50}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=50$",
          "worked": "$$\\begin{align*}\\frac{25}{50}&=\\frac{25\\times2}{50\\times2}\\\\\\frac{25}{50}&=\\frac{50}{100}\\\\n&=50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{3}{n}=\\frac{25}{75}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=9$",
          "worked": "$$\\begin{align*}\\frac{25}{75}&=\\frac{25\\div25}{75\\div25}\\\\\\frac{25}{75}&=\\frac{1}{3}\\\\\\frac{25}{75}&=\\frac{1\\times3}{3\\times3}=\\frac{3}{9}\\\\n&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{3}{8}=\\frac{45}{n}$$",
