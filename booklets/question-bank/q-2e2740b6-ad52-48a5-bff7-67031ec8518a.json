        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=15$",
          "worked": "$$\\begin{align*}\\frac{66}{99}&=\\frac{66\\div33}{99\\div33}\\\\\\frac{66}{99}&=\\frac{2}{3}\\\\\\frac{66}{99}&=\\frac{2\\times5}{3\\times5}=\\frac{10}{15}\\\\n&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
