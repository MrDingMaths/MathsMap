          "inlines": [
            {
              "type": "text",
              "text": "Pythagoras’ method starts with an odd integer greater than 1, squares it and subtracts 1, then halves the result to give the second side. Adding 1 to the second side gives the hypotenuse. Plato’s method starts with a positive integer divisible by 4. Squaring it, dividing by 4 and subtracting 1 gives the second side; squaring the original number, dividing by 4 and adding 1 gives the hypotenuse.",
              "marks": []
            }
          ]
        },
        {
          "id": "p14-primitive-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Do the above methods produce primitive Pythagorean triples?",
              "marks": []
            }
          ]
