    "children": [
      {
        "id": "p39-q55",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{(x-1)^3}{(x+1)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{(x-1)^2(x+5)}{(x+1)^3}$",
          "worked": "$$\\begin{align*}y'&=\\frac{3(x-1)^2(x+1)^2-2(x-1)^3(x+1)}{(x+1)^4}\\\\y'&=\\frac{(x-1)^2[3(x+1)-2(x-1)]}{(x+1)^3}\\\\y'&=\\frac{(x-1)^2(x+5)}{(x+1)^3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q56",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{(x^2+1)^3}{(x^2-1)^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{2x(x^2+1)^2(x^2+7)}{(x^2-1)^5}$",
          "worked": "$$\\begin{align*}y'&=\\frac{6x(x^2+1)^2(x^2-1)^4-8x(x^2+1)^3(x^2-1)^3}{(x^2-1)^8}\\\\y'&=\\frac{2x(x^2+1)^2[3(x^2-1)-4(x^2+1)]}{(x^2-1)^5}\\\\y'&=-\\frac{2x(x^2+1)^2(x^2+7)}{(x^2-1)^5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q57",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\left(\\dfrac{2x+1}{2x-1}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{12(2x+1)^2}{(2x-1)^4}$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}\\left(\\frac{2x+1}{2x-1}\\right)&=\\frac{2(2x-1)-2(2x+1)}{(2x-1)^2}=-\\frac4{(2x-1)^2},\\\\y'&=3\\left(\\frac{2x+1}{2x-1}\\right)^2\\left(-\\frac4{(2x-1)^2}\\right)\\\\y'&=-\\frac{12(2x+1)^2}{(2x-1)^4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q58",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\left(\\dfrac{1-x}{1+x}\\right)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{8(1-x)^3}{(1+x)^5}$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}\\left(\\frac{1-x}{1+x}\\right)&=\\frac{-(1+x)-(1-x)}{(1+x)^2}=-\\frac2{(1+x)^2},\\\\y'&=4\\left(\\frac{1-x}{1+x}\\right)^3\\left(-\\frac2{(1+x)^2}\\right)\\\\y'&=-\\frac{8(1-x)^3}{(1+x)^5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q59",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\sqrt{\\dfrac{x+1}{x-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{3}{2(x-2)^2\\sqrt{\\frac{(x+1)}{(x-2)}}}$, for $x<-1$ or $x>2$.",
          "worked": "\n\n$$\\begin{align*}\\frac{d}{dx}\\left(\\frac{x+1}{x-2}\\right)&=\\frac{(x-2)-(x+1)}{(x-2)^2}=-\\frac3{(x-2)^2},\\\\y'&=\\frac{1}{2\\sqrt{(x+1)/(x-2)}}\\left(-\\frac3{(x-2)^2}\\right)\\\\y'&=-\\frac{3}{2(x-2)^2\\sqrt{(x+1)/(x-2)}}.\\end{align*}$$\n\n The derivative exists on $(-\\infty,-1)\\cup(2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p39-q60",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\sqrt{\\dfrac{x^2+1}{x^2-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{2x}{(x^2-1)^{3/2}\\sqrt{x^2+1}}$",
          "worked": "\n\n$$\\begin{align*}\\frac{d}{dx}\\left(\\frac{x^2+1}{x^2-1}\\right)&=\\frac{2x(x^2-1)-2x(x^2+1)}{(x^2-1)^2}=-\\frac{4x}{(x^2-1)^2},\\\\y'&=-\\frac{2x}{(x^2-1)^2\\sqrt{(x^2+1)/(x^2-1)}}\\\\y'&=-\\frac{2x}{(x^2-1)^{3/2}\\sqrt{x^2+1}}.\\end{align*}$$\n\n Here $|x|>1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q61",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\sqrt{\\dfrac{x^2-1}{x^2+1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2x}{(x^2+1)^{3/2}\\sqrt{x^2-1}}$",
          "worked": "\n\n$$\\begin{align*}\\frac{d}{dx}\\left(\\frac{x^2-1}{x^2+1}\\right)&=\\frac{2x(x^2+1)-2x(x^2-1)}{(x^2+1)^2}=\\frac{4x}{(x^2+1)^2},\\\\y'&=\\frac{2x}{(x^2+1)^2\\sqrt{(x^2-1)/(x^2+1)}}\\\\y'&=\\frac{2x}{(x^2+1)^{3/2}\\sqrt{x^2-1}}.\\end{align*}$$\n\n The derivative exists for $|x|>1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p39-q62",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\dfrac{\\sqrt{x+2}}{\\sqrt{x-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac5{2\\sqrt{x+2}(x-3)^{3/2}}$",
          "worked": "$$\\begin{align*}y'&=\\frac{\\dfrac{\\sqrt{x-3}}{2\\sqrt{x+2}}-\\dfrac{\\sqrt{x+2}}{2\\sqrt{x-3}}}{x-3}\\\\y'&=\\frac{(x-3)-(x+2)}{2\\sqrt{x+2}(x-3)^{3/2}}\\\\y'&=-\\frac5{2\\sqrt{x+2}(x-3)^{3/2}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q63",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\dfrac{\\sqrt{2x+4}}{\\sqrt{3x-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac7{\\sqrt{2x+4}(3x-1)^{3/2}}$",
          "worked": "$$\\begin{align*}y'&=\\frac{\\dfrac{\\sqrt{3x-1}}{\\sqrt{2x+4}}-\\dfrac{3\\sqrt{2x+4}}{2\\sqrt{3x-1}}}{3x-1}\\\\y'&=\\frac{2(3x-1)-3(2x+4)}{2\\sqrt{2x+4}(3x-1)^{3/2}}\\\\y'&=-\\frac7{\\sqrt{2x+4}(3x-1)^{3/2}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q64",
        "type": "part",
        "label": "j",
        "prompt": "$y=\\dfrac{\\sqrt{x^2+4}}{\\sqrt{2x+4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x^2+4x-4}{(2x+4)^{3/2}\\sqrt{x^2+4}}$",
          "worked": "$$\\begin{align*}y'&=\\frac{\\dfrac{x\\sqrt{2x+4}}{\\sqrt{x^2+4}}-\\dfrac{\\sqrt{x^2+4}}{\\sqrt{2x+4}}}{2x+4}\\\\y'&=\\frac{x(2x+4)-(x^2+4)}{(2x+4)^{3/2}\\sqrt{x^2+4}}\\\\y'&=\\frac{x^2+4x-4}{(2x+4)^{3/2}\\sqrt{x^2+4}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
