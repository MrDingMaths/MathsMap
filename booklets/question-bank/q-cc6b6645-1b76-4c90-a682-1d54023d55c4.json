  "content": {
    "id": "p22-q35-root",
    "type": "question",
    "label": null,
    "prompt": "Show that $\\tan(45^\\circ+\\theta)\\tan(45^\\circ-\\theta)=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$.\n\nThe tangent sum and difference expansions give reciprocal factors.",
      "worked": "$$\\begin{align*}\\tan(45^\\circ+\\theta)\\tan(45^\\circ-\\theta)&=\\frac{\\tan45^\\circ+\\tan\\theta}{1-\\tan45^\\circ\\tan\\theta}\\frac{\\tan45^\\circ-\\tan\\theta}{1+\\tan45^\\circ\\tan\\theta}\\\\\\tan(45^\\circ+\\theta)\\tan(45^\\circ-\\theta)&=\\frac{1+\\tan\\theta}{1-\\tan\\theta}\\frac{1-\\tan\\theta}{1+\\tan\\theta}\\\\\\tan(45^\\circ+\\theta)\\tan(45^\\circ-\\theta)&=1.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
