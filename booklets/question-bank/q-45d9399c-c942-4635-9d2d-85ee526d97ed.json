  "content": {
    "id": "p26-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Evaluate $(x^2-2)^2$ when:",
    "layout": "grid",
    "columns": 5,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(x^2-2)^2&=(2^2-2)^2\\\\(x^2-2)^2&=(4-2)^2\\\\(x^2-2)^2&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p26-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(x^2-2)^2&=\\bigl((-2)^2-2\\bigr)^2\\\\(x^2-2)^2&=(4-2)^2\\\\(x^2-2)^2&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p26-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{196}{81}$",
          "worked": "$$\\begin{align*}(x^2-2)^2&=\\left(\\left(\\frac23\\right)^2-2\\right)^2\\\\(x^2-2)^2&=\\left(\\frac49-\\frac{18}{9}\\right)^2\\\\(x^2-2)^2&=\\left(-\\frac{14}{9}\\right)^2\\\\(x^2-2)^2&=\\frac{196}{81}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p26-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=-\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}(x^2-2)^2&=\\bigl((-\\sqrt2)^2-2\\bigr)^2\\\\(x^2-2)^2&=(2-2)^2\\\\(x^2-2)^2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p26-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$x=\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}(x^2-2)^2&=\\bigl((\\sqrt3)^2-2\\bigr)^2\\\\(x^2-2)^2&=(3-2)^2\\\\(x^2-2)^2&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
