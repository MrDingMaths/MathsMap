      {
        "id": "p27-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "How much did the furniture cost?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$50\\,000$",
          "worked": "At $n=0$, the graph shows $S=\\$50\\,000$. The furniture cost $\\$50\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p27-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the graph to estimate how much it depreciated between year 1 and year 2. Give your estimate to the nearest $\\$1000$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $\\$9000$.",
          "worked": "From the graph, the values at years 1 and 2 are approximately $\\$39\\,000$ and $\\$30\\,000$.\n$$\\begin{align*}\\text{Depreciation}&\\approx39\\,000-30\\,000\\\\\\text{Depreciation}&\\approx\\$9000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p27-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the salvage value formula to find the value of the furniture after 8 years. Round your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$6850.57$",
          "worked": "$$\\begin{align*}S&=V_0(1-r)^n\\\\S&=50\\,000(1-0.22)^8\\\\S&\\approx\\$6850.57\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ],
