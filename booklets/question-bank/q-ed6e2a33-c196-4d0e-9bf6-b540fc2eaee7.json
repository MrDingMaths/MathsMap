  "content": {
    "id": "p39-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Explain why $\\dfrac{\\frac{a}{b}}{\\frac{c}{d}}=\\dfrac{ad}{bc}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Dividing by a fraction is equivalent to multiplying by its reciprocal: $\\dfrac{a}{b}\\div\\dfrac{c}{d}=\\dfrac{a}{b}\\times\\dfrac{d}{c}=\\dfrac{ad}{bc}$.",
      "worked": "Dividing by a fraction is equivalent to multiplying by its reciprocal.\n$$\\begin{align*}\\frac{\\frac{a}{b}}{\\frac{c}{d}}&=\\frac{a}{b}\\times\\frac{d}{c}\\\\&=\\frac{ad}{bc}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
