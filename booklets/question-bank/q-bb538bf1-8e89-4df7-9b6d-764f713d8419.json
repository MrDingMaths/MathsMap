  "content": {
    "id": "v2-e5d47-p53-practice-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "A cup of tea at $85^\\circ\\mathrm{C}$ is placed on a bench in a room at $21^\\circ\\mathrm{C}$.\n\nLet $T$ be the temperature after $t$ minutes.\n\n$$\\frac{dT}{dt}=k(T-21),\\quad\\text{for some constant }k.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-e5d47-p53-practice-slot-13-s13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution of this DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$T=21+Ae^{kt}$.",
          "worked": "$$\\begin{align*}\\frac{dT}{T-21}&=k\\,dt\\\\\\ln|T-21|&=kt+C\\\\T-21&=Ae^{kt}\\\\T&=21+Ae^{kt}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-e5d47-p53-practice-slot-13-s13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the initial condition to determine the arbitrary constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=64$, hence $T=21+64e^{kt}$.",
          "worked": "Using $T(0)=85$:\n$$\\begin{align*}85&=21+A\\\\A&=64\\\\T&=21+64e^{kt}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-e5d47-p53-practice-slot-13-s13-q-c",
        "type": "part",
        "label": "c",
        "prompt": "After 8 minutes the tea is at $53^\\circ\\mathrm{C}$. Determine the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-\\dfrac{\\ln 2}{8}\\ \\mathrm{min}^{-1}$.",
          "worked": "Using $T(8)=53$:\n$$\\begin{align*}21+64e^{8k}&=53\\\\e^{8k}&=\\frac12\\\\k&=-\\frac18\\ln 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-e5d47-p53-practice-slot-13-s13-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Find how long it takes, to the nearest minute, for the tea to reach $50^\\circ\\mathrm{C}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 minutes.",
          "worked": "$$\\begin{align*}21+64e^{kt}&=50\\\\e^{kt}&=\\frac{29}{64}\\\\kt&=\\ln\\frac{29}{64}\\\\t&=\\frac{-\\ln\\frac{64}{29}}{-\\frac18\\ln2}\\\\t&=\\frac{8\\ln\\frac{64}{29}}{\\ln2}\\\\t&\\approx9\\text{ minutes}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
