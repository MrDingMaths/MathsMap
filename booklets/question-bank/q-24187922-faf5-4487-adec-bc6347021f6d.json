  "content": {
    "id": "p61-q28-root",
    "type": "question",
    "label": "28",
    "prompt": "If $f(x)=\\dfrac{4x+5}{2x-1}$, evaluate $f'(2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\dfrac{14}{9}$",
      "worked": "Using $u=4x+5$, $u'=4$, $v=2x-1$ and $v'=2$:\n$$\\begin{align*}\nf'(x)&=\\frac{4(2x-1)-2(4x+5)}{(2x-1)^2}\\\\\nf'(x)&=\\frac{8x-4-8x-10}{(2x-1)^2}\\\\\nf'(x)&=-\\frac{14}{(2x-1)^2}\\\\\nf'(2)&=-\\frac{14}{(2\\times2-1)^2}\\\\\nf'(2)&=-\\frac{14}{9}.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
