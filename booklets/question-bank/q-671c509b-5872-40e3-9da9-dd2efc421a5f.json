    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$26\\frac{2}{3}\\%$",
      "worked": "$$\\begin{align*}\\text{Percentage in Year 7}&=\\frac{200}{750}\\times100\\%\\\\\\text{Percentage in Year 7}&=\\frac{80}{3}\\%\\\\\\text{Percentage in Year 7}&=26\\frac{2}{3}\\%\\end{align*}$$",
