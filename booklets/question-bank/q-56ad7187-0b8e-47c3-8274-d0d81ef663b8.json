  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "",
    "prompt": "The ratio of the area of a field on a scale drawing to its actual area is $1:2500$.\nWhat is the ratio of the dimensions of the field on the diagram to its actual dimensions?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1:50$",
      "worked": "The length ratio is the square root of the area ratio.\n$$\\begin{align*}\\text{Drawing : actual}&=\\sqrt{1}:\\sqrt{2500}\\\\\\text{Drawing : actual}&=1:50\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 16
  },
