      {
        "id": "p10-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "At the beginning of 2011, the population of Australia was estimated to be approximately 22.5 million. Write this number in scientific notation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.25\\times10^7$",
          "worked": "$$\\begin{align*}22.5\\text{ million}&=22.5\\times10^6\\\\22.5\\text{ million}&=2.25\\times10^7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "The wavelength of red light is $6700\\,\\text{Å}$, where $1\\,\\text{Å}=10^{-10}\\,\\text{m}$. Write this wavelength of red light in metres, using scientific notation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.700\\times10^{-7}\\,\\text{m}$",
          "worked": "$$\\begin{align*}6700\\,\\text{Å}&=6700\\times10^{-10}\\,\\text{m}\\\\6700\\,\\text{Å}&=6.700\\times10^3\\times10^{-10}\\,\\text{m}\\\\6700\\,\\text{Å}&=6.700\\times10^{-7}\\,\\text{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "The Sun is approximately 150 billion metres from the Earth. Using scientific notation, write this distance in metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5\\times10^{11}\\,\\text{m}$",
          "worked": "$$\\begin{align*}150\\text{ billion metres}&=150\\times10^9\\,\\text{m}\\\\150\\text{ billion metres}&=1.5\\times10^{11}\\,\\text{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
