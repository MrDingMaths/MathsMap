  "content": {
    "id": "p15-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "For each question, first find $k$, then find the mean of the probability distribution.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q2-ab-row",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q2-a",
            "type": "part",
            "label": "a",
            "prompt": "$$ (1,k)\\quad\\left(2,\\frac15\\right)\\quad\\left(3,\\frac3{10}\\right)\\quad\\left(4,\\frac25\\right) $$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=\\frac1{10},\\quad\\mu=3$",
              "worked": "$$\\begin{aligned}k+\\frac15+\\frac3{10}+\\frac25&=1\\\\k&=\\frac1{10}\\end{aligned}$$\nThe products $xP(x)$ are $\\frac1{10},\\frac25,\\frac9{10},\\frac85$.\n$$\\begin{aligned}\\mu&=\\frac1{10}+\\frac25+\\frac9{10}+\\frac85\\\\\\mu&=3\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p15-q2-b",
            "type": "part",
            "label": "b",
            "prompt": "$$P(x)=k(x+3)\\text{ for }x\\in\\{0,1,2\\}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=\\frac1{12},\\quad\\mu=\\frac76$",
              "worked": "$$\\begin{aligned}3k+4k+5k&=1\\\\12k&=1\\\\k&=\\frac1{12}\\end{aligned}$$\nThe probabilities are $\\frac3{12},\\frac4{12},\\frac5{12}$, so the products $xP(x)$ are $0,\\frac4{12},\\frac{10}{12}$.\n$$\\begin{aligned}\\mu&=0+\\frac4{12}+\\frac{10}{12}\\\\\\mu&=\\frac76\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          }
        ]
      },
