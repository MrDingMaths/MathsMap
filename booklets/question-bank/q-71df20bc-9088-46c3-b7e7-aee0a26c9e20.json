  "content": {
    "id": "p3-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Solve each of the following quadratic equations:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x(x-5)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=5$.",
          "worked": "By the null factor law,\n$$\\begin{align*}x&=0\\quad\\text{or}\\quad x-5=0\\\\x&=0\\quad\\text{or}\\quad x=5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x(2x-9)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=\\frac92$.",
          "worked": "By the null factor law,\n$$\\begin{align*}x&=0\\quad\\text{or}\\quad 2x-9=0\\\\x&=0\\quad\\text{or}\\quad 2x=9\\\\x&=0\\quad\\text{or}\\quad x=\\frac92.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x(x+3)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $x=0$.",
          "worked": "Since $3\\ne0$, the null factor law gives\n$$\\begin{align*}x&=0\\quad\\text{or}\\quad x+3=0\\\\x&=0\\quad\\text{or}\\quad x=-3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x(2x+3)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac32$ or $x=0$.",
          "worked": "Since $2\\ne0$, the null factor law gives\n$$\\begin{align*}x&=0\\quad\\text{or}\\quad 2x+3=0\\\\x&=0\\quad\\text{or}\\quad 2x=-3\\\\x&=0\\quad\\text{or}\\quad x=-\\frac32.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+4)(x+11)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-11$ or $x=-4$.",
          "worked": "By the null factor law,\n$$\\begin{align*}x+4&=0\\quad\\text{or}\\quad x+11=0\\\\x&=-4\\quad\\text{or}\\quad x=-11.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$4(x-2)(x+5)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5$ or $x=2$.",
          "worked": "Since $4\\ne0$, the null factor law gives\n$$\\begin{align*}x-2&=0\\quad\\text{or}\\quad x+5=0\\\\x&=2\\quad\\text{or}\\quad x=-5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$(2x-3)(3x-2)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac23$ or $x=\\frac32$.",
          "worked": "By the null factor law,\n$$\\begin{align*}2x-3&=0\\quad\\text{or}\\quad 3x-2=0\\\\2x&=3\\quad\\text{or}\\quad 3x=2\\\\x&=\\frac32\\quad\\text{or}\\quad x=\\frac23.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$5(3x-2)(x+5)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5$ or $x=\\frac23$.",
          "worked": "Since $5\\ne0$, the null factor law gives\n$$\\begin{align*}3x-2&=0\\quad\\text{or}\\quad x+5=0\\\\3x&=2\\quad\\text{or}\\quad x=-5\\\\x&=\\frac23\\quad\\text{or}\\quad x=-5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
