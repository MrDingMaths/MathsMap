  "content": {
    "id": "p37-q1",
    "type": "question",
    "label": "1",
    "prompt": "The probability that it will rain this weekend is $\\frac{8}{10}$.\nWhat is the probability that it won’t rain?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{5}$",
      "worked": "$$\\begin{align*}P(\\text{not rain})&=1-\\frac{8}{10}\\\\P(\\text{not rain})&=\\frac{2}{10}\\\\P(\\text{not rain})&=\\frac{1}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
