            "inlines": [
              {
                "type": "text",
                "text": "Any of the three questions; each gives probability ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{1}{26}",
                "display": false
              },
              {
                "type": "text",
                "text": " of a correct guess.",
                "marks": []
