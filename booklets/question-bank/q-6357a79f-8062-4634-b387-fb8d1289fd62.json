    "children": [
      {
        "id": "p41-q12a",
        "type": "part",
        "label": "a",
        "prompt": "Find a formula for the volume $V$ of a sphere in terms of its surface area $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p41-q12a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "V=\\frac16\\sqrt{\\frac{A^3}{\\pi}}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p41-q12a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Express the radius using surface area, then substitute into the volume formula.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}A&=4\\pi r^2\\\\r&=\\sqrt{\\frac{A}{4\\pi}}\\\\V&=\\frac43\\pi\\left(\\frac{A}{4\\pi}\\right)^{3/2}\\\\V&=\\frac{A^{3/2}}{6\\sqrt\\pi}\\\\V&=\\frac16\\sqrt{\\frac{A^3}{\\pi}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p41-q12b",
        "type": "part",
        "label": "b",
        "prompt": "Find a formula for the surface area $A$ of a sphere in terms of its volume $V$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p41-q12b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "A=\\sqrt[3]{36\\pi V^2}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p41-q12b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Express the radius using volume, then substitute into the surface area formula.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}V&=\\frac43\\pi r^3\\\\r&=\\sqrt[3]{\\frac{3V}{4\\pi}}\\\\A&=4\\pi\\left(\\frac{3V}{4\\pi}\\right)^{2/3}\\\\A&=\\sqrt[3]{36\\pi V^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
