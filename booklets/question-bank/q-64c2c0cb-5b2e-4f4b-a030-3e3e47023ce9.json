    "children": [
      {
        "id": "p109-q43-m",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{5}+\\frac{6\\times4}{5}-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{1}{5}+\\frac{6\\times4}{5}-6&=\\frac{1+24}{5}-6\\\\&=5-6\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p109-q43-n",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{68}+\\frac{69\\times67}{68}-69$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{1}{68}+\\frac{69\\times67}{68}-69&=\\frac{1+(68+1)(68-1)}{68}-69\\\\&=\\frac{1+68^2-1^2}{68}-69\\\\&=\\frac{68^2}{68}-69\\\\&=68-69\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p109-q43-o",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{n}+\\frac{(n+1)(n-1)}{n}-(n+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{1}{n}+\\frac{(n+1)(n-1)}{n}-(n+1)&=\\frac{1+n^2-1}{n}-n-1\\\\&=\\frac{n^2}{n}-n-1\\\\&=n-n-1\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
