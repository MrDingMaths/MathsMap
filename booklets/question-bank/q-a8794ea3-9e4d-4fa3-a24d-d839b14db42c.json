  "content": {
    "id": "p8-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Expand each of the following perfect squares:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(a+3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+6a+9$",
          "worked": "$$\\begin{align*}(a+3)^2&=a^2+2(a)(3)+3^2\\\\(a+3)^2&=a^2+6a+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(b+4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^2+8b+16$",
          "worked": "$$\\begin{align*}(b+4)^2&=b^2+2(b)(4)+4^2\\\\(b+4)^2&=b^2+8b+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x-5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-10x+25$",
          "worked": "$$\\begin{align*}(x-5)^2&=x^2-2(x)(5)+5^2\\\\(x-5)^2&=x^2-10x+25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3m+2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9m^2+12m+4$",
          "worked": "$$\\begin{align*}(3m+2)^2&=(3m)^2+2(3m)(2)+2^2\\\\(3m+2)^2&=9m^2+12m+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(3x-4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-24x+16$",
          "worked": "$$\\begin{align*}(3x-4)^2&=(3x)^2-2(3x)(4)+4^2\\\\(3x-4)^2&=9x^2-24x+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(4m+3n)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16m^2+24mn+9n^2$",
          "worked": "$$\\begin{align*}(4m+3n)^2&=(4m)^2+2(4m)(3n)+(3n)^2\\\\(4m+3n)^2&=16m^2+24mn+9n^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(2x-5y)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2-20xy+25y^2$",
          "worked": "$$\\begin{align*}(2x-5y)^2&=(2x)^2-2(2x)(5y)+(5y)^2\\\\(2x-5y)^2&=4x^2-20xy+25y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$(10x+3y)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100x^2+60xy+9y^2$",
          "worked": "$$\\begin{align*}(10x+3y)^2&=(10x)^2+2(10x)(3y)+(3y)^2\\\\(10x+3y)^2&=100x^2+60xy+9y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(x+\\frac12\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+x+\\frac14$",
          "worked": "$$\\begin{align*}\\left(x+\\frac12\\right)^2&=x^2+2(x)\\left(\\frac12\\right)+\\left(\\frac12\\right)^2\\\\\\left(x+\\frac12\\right)^2&=x^2+x+\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\left(\\frac{x}{2}-3\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{4}-3x+9$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{2}-3\\right)^2&=\\left(\\frac{x}{2}\\right)^2-2\\left(\\frac{x}{2}\\right)(3)+3^2\\\\\\left(\\frac{x}{2}-3\\right)^2&=\\frac{x^2}{4}-3x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\left(\\frac{x}{3}+\\frac12\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{9}+\\frac{x}{3}+\\frac14$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{3}+\\frac12\\right)^2&=\\left(\\frac{x}{3}\\right)^2+2\\left(\\frac{x}{3}\\right)\\left(\\frac12\\right)+\\left(\\frac12\\right)^2\\\\\\left(\\frac{x}{3}+\\frac12\\right)^2&=\\frac{x^2}{9}+\\frac{x}{3}+\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p8-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\left(\\frac{x+y}{2}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{4}+\\frac{xy}{2}+\\frac{y^2}{4}$",
          "worked": "$$\\begin{align*}\\left(\\frac{x+y}{2}\\right)^2&=\\left(\\frac{x}{2}+\\frac{y}{2}\\right)^2\\\\\\left(\\frac{x+y}{2}\\right)^2&=\\left(\\frac{x}{2}\\right)^2+2\\left(\\frac{x}{2}\\right)\\left(\\frac{y}{2}\\right)+\\left(\\frac{y}{2}\\right)^2\\\\\\left(\\frac{x+y}{2}\\right)^2&=\\frac{x^2}{4}+\\frac{xy}{2}+\\frac{y^2}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
