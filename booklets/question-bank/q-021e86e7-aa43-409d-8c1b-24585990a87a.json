  "content": {
    "id": "p52-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Differentiate these functions, where $m,b,a,n$ are constants.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{mx+b}{bx+m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{m^2-b^2}{(bx+m)^2}$",
          "worked": "$u=mx+b$, $u'=m$; $v=bx+m$, $v'=b$.\n$$\\begin{align*}y'&=\\frac{u'v-uv'}{v^2}\\\\y'&=\\frac{m(bx+m)-b(mx+b)}{(bx+m)^2}\\\\y'&=\\frac{mbx+m^2-bmx-b^2}{(bx+m)^2}\\\\y'&=\\frac{m^2-b^2}{(bx+m)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p52-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x^2-a}{x^2-b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2x(a-b)}{(x^2-b)^2}$",
          "worked": "$u=x^2-a$, $u'=2x$; $v=x^2-b$, $v'=2x$.\n$$\\begin{align*}y'&=\\frac{u'v-uv'}{v^2}\\\\y'&=\\frac{2x(x^2-b)-2x(x^2-a)}{(x^2-b)^2}\\\\y'&=\\frac{2x^3-2bx-2x^3+2ax}{(x^2-b)^2}\\\\y'&=\\frac{2x(a-b)}{(x^2-b)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p52-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{x^n-3}{x^n+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{6nx^{n-1}}{(x^n+3)^2}$",
          "worked": "$u=x^n-3$, $u'=nx^{n-1}$; $v=x^n+3$, $v'=nx^{n-1}$.\n$$\\begin{align*}y'&=\\frac{u'v-uv'}{v^2}\\\\y'&=\\frac{nx^{n-1}(x^n+3)-(x^n-3)nx^{n-1}}{(x^n+3)^2}\\\\y'&=\\frac{nx^{n-1}[(x^n+3)-(x^n-3)]}{(x^n+3)^2}\\\\y'&=\\frac{6nx^{n-1}}{(x^n+3)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
  },
