      {
        "id": "p4-q6-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"fractionFill\",\"hex\":\"DCEBE0\",\"reason\":\"Filled cells represent the counted quantity of four wholes and one eighth\"}],\"reference\":\"source page 4, p4-q6-diagram\"}\n\\begin{tikzpicture}[x=4mm,y=4mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{fractionFill}{HTML}{DCEBE0}\n\\path[use as bounding box] (-0.25,-3.45) rectangle (13.45,2.25);\n\\foreach \\x/\\y in {0/0,4.6/0,0/-3.2,4.6/-3.2} {\n  \\fill[fractionFill] (\\x,\\y) rectangle ++(4,2);\n}\n\\fill[fractionFill] (9.2,1) rectangle (10.2,2);\n\\foreach \\x/\\y in {0/0,4.6/0,9.2/0,0/-3.2,4.6/-3.2} {\n  \\draw[black,line width=0.8pt] (\\x,\\y) rectangle ++(4,2);\n  \\foreach \\i in {1,2,3} {\n    \\draw[black,line width=0.4pt] (\\x+\\i,\\y) -- (\\x+\\i,\\y+2);\n  }\n  \\draw[black,line width=0.4pt] (\\x,\\y+1) -- (\\x+4,\\y+1);\n}\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 53,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 4,
          "sourceRegion": "Question 6, fraction model to the left of parts a–d",
          "description": "Five equal rectangles partitioned into two rows and four columns. Three rectangles occupy the upper row and two occupy the lower row beneath the first two. Four rectangles are completely filled; only the upper-left cell of the upper-right rectangle is filled.",
          "mathematics": "Each rectangle represents one whole and each cell represents one eighth. There are 32 filled cells in the four complete wholes and one additional filled cell.",
          "answerVisibility": "The fraction model is permanently visible. Numerical responses are shown only in answer content."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p4-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How many wholes are there in the diagram?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "There are $4$ completely filled rectangles, so there are $4$ wholes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "What does the diagram represent as a mixed numeral?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\frac{1}{8}$",
          "worked": "There are $4$ wholes and $1$ of the $8$ equal parts of another whole, giving $4\\frac{1}{8}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p4-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "How many eighths are shown in the diagram?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33$",
          "worked": "Each whole contains $8$ eighths.\n$$\\begin{aligned}4\\times8+1&=32+1\\\\&=33\\end{aligned}$$\nThere are $33$ eighths.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p4-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Write this as an improper fraction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{33}{8}$",
          "worked": "$$\\begin{aligned}4\\frac{1}{8}&=\\frac{4\\times8+1}{8}\\\\&=\\frac{33}{8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ],
