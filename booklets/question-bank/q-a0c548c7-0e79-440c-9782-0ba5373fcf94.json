    "children": [
      {
        "id": "p5-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the 10th term of the arithmetic sequence $3,5,7,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21$",
          "worked": "$$\\begin{align*}d&=5-3=2\\\\a_{10}&=a+9d\\\\a_{10}&=3+9\\times2\\\\a_{10}&=21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the 9th term of the arithmetic sequence $-5,1,7,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$43$",
          "worked": "$$\\begin{align*}d&=1-(-5)=6\\\\a_9&=a+8d\\\\a_9&=-5+8\\times6\\\\a_9&=43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the 8th term of the arithmetic sequence $10,7,4,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-11$",
          "worked": "$$\\begin{align*}d&=7-10=-3\\\\a_8&=a+7d\\\\a_8&=10+7\\times(-3)\\\\a_8&=-11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the 7th term of the arithmetic sequence $\\frac13,\\frac12,\\frac23,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac43$",
          "worked": "$$\\begin{align*}d&=\\frac12-\\frac13=\\frac16\\\\a_7&=a+6d\\\\a_7&=\\frac13+6\\times\\frac16\\\\a_7&=\\frac13+1\\\\a_7&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
