  "content": {
    "id": "p4-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "One counter is picked at random from a bag containing 20 red counters, 5 white counters and 15 yellow counters. What is the probability that the counter removed is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "red?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "There are $20+5+15=40$ counters.\n$$\\begin{align*}P(\\text{red})&=\\frac{20}{40}\\\\P(\\text{red})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
