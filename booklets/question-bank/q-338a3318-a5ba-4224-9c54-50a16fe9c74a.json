            "solve-linear-2-step",
            "substitute-into-expressions"
          ],
          "archetype": "lr-audit:quantity+lr-audit:inverse",
          "rationale": "Classification of revised source content; no teaching-content edits.",
          "sourcePages": [
            57
          ],
          "sourceTargetId": "page-57-q13-b"
        },
        "answer": {
          "short": "$13$",
          "worked": "Using $T=3n+6$, $45=3n+6$, so $n=13$ shaded tiles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "page-57-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine how many *unshaded* tiles would be in a pattern with 17 shaded tiles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
