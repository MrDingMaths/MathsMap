          ],
          "archetype": "lr-audit:pattern-rule+lr-audit:quantity+lr-audit:forward",
          "rationale": "Classification of revised source content; no teaching-content edits.",
          "sourcePages": [
            57
          ],
          "sourceTargetId": "page-57-q13-c"
        },
        "answer": {
          "short": "$40$",
          "worked": "Unshaded tiles: $U=T-n=2n+6$. For $n=17$, $U=2(17)+6=40$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
