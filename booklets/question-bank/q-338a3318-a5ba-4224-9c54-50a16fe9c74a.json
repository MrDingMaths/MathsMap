        "type": "part",
        "label": "a",
        "prompt": "Determine the total number of tiles needed to make a pattern with 23 shaded tiles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "teachingMapping": {
          "skillIds": [
            "pattern-to-equation",
            "apply-pattern-equation"
          ],
          "role": "assesses",
          "prerequisiteIds": [
            "find-rule-from-table",
            "pattern-to-equation"
          ],
          "archetype": "lr-audit:pattern-rule+lr-audit:quantity+lr-audit:forward",
          "rationale": "Classification of revised source content; no teaching-content edits.",
          "sourcePages": [
            57
          ],
          "sourceTargetId": "page-57-q13-a"
        },
        "answer": {
          "short": "$75$",
          "worked": "A row of $n$ shaded tiles has 3 rows of $n+2$ tiles altogether. Thus $T=3n+6$. For $n=23$, $T=3(23)+6=75$ tiles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "page-57-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine the number of shaded tiles in a pattern with 45 total tiles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "teachingMapping": {
          "skillIds": [
            "apply-pattern-equation",
            "equations-from-formulas"
          ],
          "role": "assesses",
          "prerequisiteIds": [
