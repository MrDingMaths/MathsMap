  "content": {
    "id": "p14-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Differentiate each function using the chain, product or quotient rules.\nThen find any values of $x$ for which the derivative is zero.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x\\ln x-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\ln x$; zero when $x=1$.",
          "worked": "$$\\begin{align*}y'&=\\ln x+x\\left(\\frac1x\\right)-1\\\\y'&=\\ln x\\\\\\ln x&=0\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2\\ln x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=x(1+2\\ln x)$; zero when $x=e^{-1/2}$.",
          "worked": "$$\\begin{align*}y'&=2x\\ln x+x^2\\left(\\frac1x\\right)\\\\y'&=x(1+2\\ln x)\\end{align*}$$\nSince $x>0$,\n$$\\begin{align*}1+2\\ln x&=0\\\\\\ln x&=-\\frac12\\\\x&=e^{-1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{\\ln x}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1-\\ln x}{x^2}$; zero when $x=e$.",
          "worked": "$$\\begin{align*}y'&=\\frac{\\left(\\frac1x\\right)x-(\\ln x)(1)}{x^2}\\\\y'&=\\frac{1-\\ln x}{x^2}\\\\1-\\ln x&=0\\\\\\ln x&=1\\\\x&=e\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p14-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(\\ln x)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{4(\\ln x)^3}{x}$; zero when $x=1$.",
          "worked": "$$\\begin{align*}y'&=4(\\ln x)^3\\left(\\frac1x\\right)\\\\y'&=\\frac{4(\\ln x)^3}{x}\\\\\\ln x&=0\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=(2\\ln x-3)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{8(2\\ln x-3)^3}{x}$; zero when $x=e^{3/2}$.",
          "worked": "$$\\begin{align*}y'&=4(2\\ln x-3)^3\\left(\\frac2x\\right)\\\\y'&=\\frac{8(2\\ln x-3)^3}{x}\\\\2\\ln x-3&=0\\\\\\ln x&=\\frac32\\\\x&=e^{3/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p14-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac1{\\ln x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac1{x(\\ln x)^2}$; never zero.",
          "worked": "$$\\begin{align*}y'&=\\frac{0(\\ln x)-(1)\\left(\\frac1x\\right)}{(\\ln x)^2}\\\\y'&=-\\frac1{x(\\ln x)^2}\\end{align*}$$\nThe numerator is nonzero, so the derivative is never zero on its domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\ln(\\ln x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac1{x\\ln x}$; never zero.",
          "worked": "$$\\begin{align*}y'&=\\frac{\\frac1x}{\\ln x}\\\\y'&=\\frac1{x\\ln x}\\end{align*}$$\nThe numerator is nonzero, so the derivative is never zero on its domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=x\\ln x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=1+\\ln x$; zero when $x=\\dfrac1e$.",
          "worked": "$$\\begin{align*}y'&=\\ln x+x\\left(\\frac1x\\right)\\\\y'&=1+\\ln x\\\\\\ln x&=-1\\\\x&=\\frac1e\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
