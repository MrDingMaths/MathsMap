    "children": [
      {
        "id": "p24-q15-a",
        "type": "group",
        "label": "a",
        "prompt": "At what times is this particle:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q15-a-i",
            "type": "part",
            "label": "i",
            "prompt": "below the origin?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0\\le t<8$.",
              "worked": "Below the origin means $x<0$. The displacement graph lies below the time axis for $0\\le t<8$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p24-q15-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "moving downwards?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0\\le t<4$ and $t>12$.",
              "worked": "Moving downwards means $v<0$, so the displacement graph has negative gradient. This occurs for $0\\le t<4$ and $t>12$. At $t=4$ and $t=12$, the particle is stationary.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p24-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "At about what time is its speed greatest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t\\approx8$.",
          "worked": "Speed is the magnitude of the displacement graph's gradient. The curve is steepest at about $t=8$, so its speed is greatest then.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p24-q15-c",
        "type": "group",
        "label": "c",
        "prompt": "At about what time is:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q15-c-i",
            "type": "part",
            "label": "i",
            "prompt": "the distance from the origin about the same as at $t=3$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t\\approx5,\\ 11,\\ 13$.",
              "worked": "Distance from the origin is $|x|$. Read the displacement at $t=3$, then find the other points with approximately that displacement or its opposite. These occur at $t\\approx5,\\ 11,\\ 13$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p24-q15-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the velocity about the same as at $t=3$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t\\approx13$ and $t\\approx20$.",
              "worked": "Velocity is the gradient of the displacement graph. Compare the tangent at $t=3$ with tangents elsewhere: approximately parallel tangents occur at $t\\approx13$ and $t\\approx20$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p24-q15-d",
