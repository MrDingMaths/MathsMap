  "content": {
    "id": "p50-q6-response",
    "type": "question",
    "label": "6",
    "prompt": "Show that $y=-2x+5$ is tangent to the circle $x^2+y^2=5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Substitution gives $5x^2-20x+20=0$, with $\\Delta=(-20)^2-4(5)(20)=0$. There is exactly one point of intersection, so the line is tangent to the circle.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p50-q6-answer-introduction",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Substitute to find points of intersection:",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p50-q6-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}x^2+(-2x+5)^2&=5\\\\x^2+4x^2-20x+25&=5\\\\5x^2-20x+20&=0\\\\\\Delta&=b^2-4ac\\\\&=(-20)^2-4(5)(20)\\\\&=0\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p50-q6-answer-conclusion",
            "type": "paragraph",
