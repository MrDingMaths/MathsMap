    ],
    "children": [
      {
        "id": "p45-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the size of $\\angle ACB$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle ACB = 60^\\circ$.",
          "worked": "The angle in a semicircle is a right angle, so $\\angle BCD = 90^\\circ$. Since $C$, $Y$ and $A$ are collinear, $\\angle ACD = 30^\\circ$.\n$$\\begin{align*}\\angle ACB + \\angle ACD &= 90^\\circ\\\\\\angle ACB + 30^\\circ &= 90^\\circ\\\\\\angle ACB &= 60^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p45-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the size of $\\angle ADX$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle ADX = 30^\\circ$.",
          "worked": "By the alternate segment theorem,\n$$\\begin{align*}\\angle ADX &= \\angle ACD\\\\\\angle ADX &= 30^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p45-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Find, giving reasons, the size of $\\angle CAB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle CAB = 70^\\circ$.",
          "worked": "$\\angle BYC$ is an exterior angle of $\\triangle CDY$.\n$$\\begin{align*}\\angle CDY + \\angle YCD &= 100^\\circ\\\\\\angle CDY + 30^\\circ &= 100^\\circ\\\\\\angle CDY &= 70^\\circ\\end{align*}$$\nSince $D$, $Y$ and $B$ are collinear, $\\angle CDB = 70^\\circ$. Angles at the circumference standing on the same chord $CB$ are equal.\n$$\\begin{align*}\\angle CAB &= \\angle CDB\\\\\\angle CAB &= 70^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
