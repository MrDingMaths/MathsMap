  "content": {
    "id": "p23-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A line passes through the points $A(1, 3)$ and $B(4, 12)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}m&=\\frac{12-3}{4-1}\\\\m&=\\frac{9}{3}\\\\m&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p23-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Using the gradient and the point $A$, find the equation of line $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x$",
          "worked": "Using $y-y_1=m(x-x_1)$ with $A(1,3)$ and $m=3$:\n$$\\begin{align*}y-3&=3(x-1)\\\\y-3&=3x-3\\\\y&=3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Using the gradient and the point $B$, find the equation of line $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x$",
          "worked": "Using $y-y_1=m(x-x_1)$ with $B(4,12)$ and $m=3$:\n$$\\begin{align*}y-12&=3(x-4)\\\\y-12&=3x-12\\\\y&=3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
