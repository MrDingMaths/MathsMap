      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\left(\\frac{3x}{5}+1\\right)+\\frac{x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{29x}{20}+2$",
          "worked": "$$\\begin{align*}2\\left(\\frac{3x}{5}+1\\right)+\\frac{x}{4}&=\\frac{6x}{5}+2+\\frac{x}{4}\\\\2\\left(\\frac{3x}{5}+1\\right)+\\frac{x}{4}&=\\frac{24x+5x}{20}+2\\\\2\\left(\\frac{3x}{5}+1\\right)+\\frac{x}{4}&=\\frac{29x}{20}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
