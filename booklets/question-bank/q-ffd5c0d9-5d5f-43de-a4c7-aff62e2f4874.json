        "prompt": "$2\\left(\\frac{x}{3}+5\\right)+\\frac{x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+10$",
          "worked": "$$\\begin{align*}2\\left(\\frac{x}{3}+5\\right)+\\frac{x}{3}&=\\frac{2x}{3}+10+\\frac{x}{3}\\\\2\\left(\\frac{x}{3}+5\\right)+\\frac{x}{3}&=\\frac{3x}{3}+10\\\\2\\left(\\frac{x}{3}+5\\right)+\\frac{x}{3}&=x+10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$3\\left(3-\\frac{x}{4}\\right)+\\frac{x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9-\\frac{x}{2}$",
          "worked": "$$\\begin{align*}3\\left(3-\\frac{x}{4}\\right)+\\frac{x}{4}&=9-\\frac{3x}{4}+\\frac{x}{4}\\\\3\\left(3-\\frac{x}{4}\\right)+\\frac{x}{4}&=9-\\frac{2x}{4}\\\\3\\left(3-\\frac{x}{4}\\right)+\\frac{x}{4}&=9-\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$-2\\left(\\frac{x}{5}+3\\right)-\\frac{x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3x}{5}-6$",
          "worked": "$$\\begin{align*}-2\\left(\\frac{x}{5}+3\\right)-\\frac{x}{5}&=-\\frac{2x}{5}-6-\\frac{x}{5}\\\\-2\\left(\\frac{x}{5}+3\\right)-\\frac{x}{5}&=-\\frac{3x}{5}-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
