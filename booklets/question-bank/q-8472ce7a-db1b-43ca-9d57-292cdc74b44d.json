  "content": {
    "id": "p7-q20-root",
    "type": "question",
    "label": null,
    "prompt": "Suppose that $\\dfrac{2x+3}{4y+5}=\\dfrac{3}{5}$. Solve for $\\dfrac{x}{y}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{x}{y}=\\dfrac{6}{5}$",
      "worked": "$$\\begin{align*}5(2x+3)&=3(4y+5)\\\\10x+15&=12y+15\\\\10x&=12y\\\\\\frac{x}{y}&=\\frac{12}{10}\\\\\\frac{x}{y}&=\\frac{6}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
