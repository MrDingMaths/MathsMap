        "answer": {
          "short": "$27x^8y^{17}$",
          "worked": "$$\\begin{align*}(3x^2y^3)^3\\times(xy^4)^2&=27x^6y^9\\times x^2y^8\\\\(3x^2y^3)^3\\times(xy^4)^2&=27x^{6+2}y^{9+8}\\\\(3x^2y^3)^3\\times(xy^4)^2&=27x^8y^{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
