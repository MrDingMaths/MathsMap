    "children": [
      {
        "id": "p7-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2y\\times x^4y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^6y^4$",
          "worked": "$$\\begin{align*}x^2y\\times x^4y^3&=x^{2+4}y^{1+3}\\\\x^2y\\times x^4y^3&=x^6y^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{-5}y^3\\times x^3y^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y}{x^2}$",
          "worked": "$$\\begin{align*}x^{-5}y^3\\times x^3y^{-2}&=x^{-5+3}y^{3-2}\\\\x^{-5}y^3\\times x^3y^{-2}&=x^{-2}y\\\\x^{-5}y^3\\times x^3y^{-2}&=\\frac{y}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$3ax^{-2}\\times7a^2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21a^3}{x}$",
          "worked": "$$\\begin{align*}3ax^{-2}\\times7a^2x&=21a^{1+2}x^{-2+1}\\\\3ax^{-2}\\times7a^2x&=21a^3x^{-1}\\\\3ax^{-2}\\times7a^2x&=\\frac{21a^3}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{15}s^{-2}t^3\\times5st^{-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3st^2}$",
          "worked": "$$\\begin{align*}\\frac{1}{15}s^{-2}t^3\\times5st^{-5}&=\\frac{5}{15}s^{-2+1}t^{3-5}\\\\\\frac{1}{15}s^{-2}t^3\\times5st^{-5}&=\\frac13s^{-1}t^{-2}\\\\\\frac{1}{15}s^{-2}t^3\\times5st^{-5}&=\\frac{1}{3st^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$56x^2y^6\\div8xy^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{y^2}$",
          "worked": "$$\\begin{align*}56x^2y^6\\div8xy^8&=\\frac{56}{8}x^{2-1}y^{6-8}\\\\56x^2y^6\\div8xy^8&=7xy^{-2}\\\\56x^2y^6\\div8xy^8&=\\frac{7x}{y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$35a^{-2}b^4\\div28a^4b^{-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5b^{10}}{4a^6}$",
          "worked": "$$\\begin{align*}35a^{-2}b^4\\div28a^4b^{-6}&=\\frac{35}{28}a^{-2-4}b^{4-(-6)}\\\\35a^{-2}b^4\\div28a^4b^{-6}&=\\frac54a^{-6}b^{10}\\\\35a^{-2}b^4\\div28a^4b^{-6}&=\\frac{5b^{10}}{4a^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$(s^2y^{-3})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{s^6}{y^9}$",
          "worked": "$$\\begin{align*}(s^2y^{-3})^3&=s^{2\\times3}y^{-3\\times3}\\\\(s^2y^{-3})^3&=s^6y^{-9}\\\\(s^2y^{-3})^3&=\\frac{s^6}{y^9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$(5c^{-2}d^3)^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{c^2}{5d^3}$",
          "worked": "$$\\begin{align*}(5c^{-2}d^3)^{-1}&=5^{-1}c^{(-2)(-1)}d^{3(-1)}\\\\(5c^{-2}d^3)^{-1}&=\\frac15c^2d^{-3}\\\\(5c^{-2}d^3)^{-1}&=\\frac{c^2}{5d^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q13-i",
        "type": "part",
        "label": "i",
        "prompt": "$(3x^2y^3)^3\\times(xy^4)^2$",
        "layout": "list",
        "columns": null,
