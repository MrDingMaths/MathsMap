  "content": {
    "id": "p97-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The variable $y$ varies directly with $x$ with a constant of proportionality $k$. When $x = 4$, $y = 5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p97-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = 1.25$",
          "worked": "$$\\begin{align*}y &= kx\\\\5 &= 4k\\\\k &= \\frac{5}{4}\\\\k &= 1.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p97-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $y$ when $x = 8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 10$",
          "worked": "$$\\begin{align*}y &= 1.25\\times 8\\\\y &= 10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p97-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the value of $x$ when $y = 8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 6.4$",
          "worked": "$$\\begin{align*}8 &= 1.25x\\\\x &= \\frac{8}{1.25}\\\\x &= 6.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
