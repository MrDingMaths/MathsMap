  "content": {
    "id": "p14-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify these divisions. Remember to simplify before you multiply.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3a}{4}\\div\\frac{1}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15a}{4}$",
          "worked": "$$\\begin{align*}\\frac{3a}{4}\\div\\frac{1}{5}&=\\frac{3a}{4}\\times\\frac{5}{1}\\\\\\frac{3a}{4}\\div\\frac{1}{5}&=\\frac{15a}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2x}{5}\\div\\frac{3}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14x}{15}$",
          "worked": "$$\\begin{align*}\\frac{2x}{5}\\div\\frac{3}{7}&=\\frac{2x}{5}\\times\\frac{7}{3}\\\\&=\\frac{14x}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p14-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{9a}{10}\\div\\frac{1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{18a}{5}$",
          "worked": "$$\\begin{align*}\\frac{9a}{10}\\div\\frac{1}{4}&=\\frac{9a}{10}\\times4\\\\&=\\frac{9a}{5}\\times2\\\\&=\\frac{18a}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{3}\\div\\frac{4x}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{6x}$",
          "worked": "$$\\begin{align*}\\frac{2}{3}\\div\\frac{4x}{7}&=\\frac{2}{3}\\times\\frac{7}{4x}\\\\&=\\frac{1}{3}\\times\\frac{7}{2x}\\\\&=\\frac{7}{6x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{4}{5}\\div\\frac{2y}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6}{5y}$",
          "worked": "$$\\begin{align*}\\frac{4}{5}\\div\\frac{2y}{3}&=\\frac{4}{5}\\times\\frac{3}{2y}\\\\&=\\frac{2}{5}\\times\\frac{3}{y}\\\\&=\\frac{6}{5y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1}{7}\\div\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{14}$",
          "worked": "$$\\begin{align*}\\frac{1}{7}\\div\\frac{2}{x}&=\\frac{1}{7}\\times\\frac{x}{2}\\\\&=\\frac{x}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p14-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{4a}{7}\\div\\frac{2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10a}{7}$",
          "worked": "$$\\begin{align*}\\frac{4a}{7}\\div\\frac{2}{5}&=\\frac{4a}{7}\\times\\frac{5}{2}\\\\&=\\frac{2a}{7}\\times5\\\\&=\\frac{10a}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{4b}{7}\\div\\frac{2c}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10b}{7c}$",
          "worked": "$$\\begin{align*}\\frac{4b}{7}\\div\\frac{2c}{5}&=\\frac{4b}{7}\\times\\frac{5}{2c}\\\\&=\\frac{2b}{7}\\times\\frac{5}{c}\\\\&=\\frac{10b}{7c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{2x}{5}\\div\\frac{4y}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x}{10y}$",
          "worked": "$$\\begin{align*}\\frac{2x}{5}\\div\\frac{4y}{3}&=\\frac{2x}{5}\\times\\frac{3}{4y}\\\\&=\\frac{x}{5}\\times\\frac{3}{2y}\\\\&=\\frac{3x}{10y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{2y}{x}\\div\\frac{3}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2y^2}{3x}$",
          "worked": "$$\\begin{align*}\\frac{2y}{x}\\div\\frac{3}{y}&=\\frac{2y}{x}\\times\\frac{y}{3}\\\\&=\\frac{2y^2}{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p14-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{5}{12x}\\div\\frac{7x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{42x^2}$",
          "worked": "$$\\begin{align*}\\frac{5}{12x}\\div\\frac{7x}{2}&=\\frac{5}{12x}\\times\\frac{2}{7x}\\\\&=\\frac{5}{6x}\\times\\frac{1}{7x}\\\\&=\\frac{5}{42x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{4a}{5}\\div\\frac{2b}{7a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14a^2}{5b}$",
          "worked": "$$\\begin{align*}\\frac{4a}{5}\\div\\frac{2b}{7a}&=\\frac{4a}{5}\\times\\frac{7a}{2b}\\\\&=\\frac{2a}{5}\\times\\frac{7a}{b}\\\\&=\\frac{14a^2}{5b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
