  "content": {
    "id": "p22-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The sum of an infinite geometric series is 3. If the first term is removed, then the sum of the resulting geometric series is 2. Find the common ratio of this series.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$r=\\dfrac{2}{3}$",
      "worked": "Let $a$ be the first term and $r$ the common ratio, with $|r|<1$. The remaining series begins with $ar$.\n$$\\begin{align*}\\frac{a}{1-r}&=3\\\\\\frac{ar}{1-r}&=2\\\\r&=\\frac{ar/(1-r)}{a/(1-r)}\\\\r&=\\frac{2}{3}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
