    "id": "v2-32-salary-practice-slot-22-root",
    "type": "question",
    "label": null,
    "prompt": "Tariq works part-time and earns \\$1386.50 per fortnight.\nFind how much he earns for these periods to the nearest cent.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-32-salary-practice-slot-22-slot-22-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Year",
        "layout": "list",
