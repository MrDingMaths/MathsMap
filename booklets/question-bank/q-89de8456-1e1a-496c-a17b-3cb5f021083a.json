        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$36 049 per year.",
          "worked": "$$\\begin{align*}\\text{Yearly pay} &= \\text{Fortnightly pay}\\times 26\\\\ &= \\$1386.50\\times 26\\\\ &= \\$36\\,049\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-32-salary-practice-slot-22-slot-22-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Month",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3004.08 per month.",
          "worked": "$$\\begin{align*}\\text{Yearly pay} &= \\$1386.50\\times 26\\\\ &= \\$36\\,049\\\\ \\text{Monthly pay} &= \\frac{\\$36\\,049}{12}\\\\ &\\approx \\$3004.08\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
