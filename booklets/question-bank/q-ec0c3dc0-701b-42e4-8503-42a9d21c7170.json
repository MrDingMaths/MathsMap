  "content": {
    "id": "p16-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Four friends order three large pizzas for their dinner. Each pizza is cut into eight equal slices. Simone has three slices, Isabella has four slices, Mark has five slices and Alex has three slices.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "How many pizza slices do they eat in total?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "15 slices",
          "worked": "$$\\begin{align*}3+4+5+3&=15\\end{align*}$$\nThey eat 15 slices.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "How many pizzas do they eat in total as a mixed numeral?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{7}{8}$ pizzas",
          "worked": "Dividing 15 by 8 gives a quotient of 1 and a remainder of 7.\n$$\\begin{align*}\\frac{15}{8}&=1\\frac{7}{8}\\end{align*}$$\nThey eat $1\\frac{7}{8}$ pizzas.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "How many pizza slices are left uneaten?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 slices",
          "worked": "$$\\begin{align*}3\\times8&=24\\text{ slices}\\\\24-15&=9\\text{ slices}\\end{align*}$$\n9 slices are left uneaten.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "How many pizzas are left uneaten as a mixed numeral?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{1}{8}$ pizzas",
          "worked": "Dividing 9 by 8 gives a quotient of 1 and a remainder of 1.\n$$\\begin{align*}\\frac{9}{8}&=1\\frac{1}{8}\\end{align*}$$\n$1\\frac{1}{8}$ pizzas are left uneaten.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
