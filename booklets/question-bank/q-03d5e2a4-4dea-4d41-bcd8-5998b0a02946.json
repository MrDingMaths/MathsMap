        "label": "a",
        "prompt": "$\\frac{\\sqrt{40}}{\\sqrt{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{40}}{\\sqrt{10}}&=\\sqrt{\\frac{40}{10}}\\\\\\frac{\\sqrt{40}}{\\sqrt{10}}&=\\sqrt4\\\\\\frac{\\sqrt{40}}{\\sqrt{10}}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\sqrt{18}}{\\sqrt{50}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{18}}{\\sqrt{50}}&=\\frac{3\\sqrt2}{5\\sqrt2}\\\\\\frac{\\sqrt{18}}{\\sqrt{50}}&=\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2\\sqrt6\\times\\sqrt5}{\\sqrt{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt3$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt6\\times\\sqrt5}{\\sqrt{10}}&=2\\sqrt{\\frac{6\\times5}{10}}\\\\\\frac{2\\sqrt6\\times\\sqrt5}{\\sqrt{10}}&=2\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p13-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5\\sqrt7\\times\\sqrt3}{\\sqrt{28}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt7\\times\\sqrt3}{\\sqrt{28}}&=\\frac{5\\sqrt7\\sqrt3}{2\\sqrt7}\\\\\\frac{5\\sqrt7\\times\\sqrt3}{\\sqrt{28}}&=\\frac{5\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{\\sqrt{15}\\times\\sqrt{20}}{\\sqrt{12}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{15}\\times\\sqrt{20}}{\\sqrt{12}}&=\\sqrt{\\frac{15\\times20}{12}}\\\\\\frac{\\sqrt{15}\\times\\sqrt{20}}{\\sqrt{12}}&=\\sqrt{25}\\\\\\frac{\\sqrt{15}\\times\\sqrt{20}}{\\sqrt{12}}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
