            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\displaystyle\\frac{a}{b}=\\frac{y}{h}=\\frac{h}{x}$.",
              "worked": "The corresponding sides opposite $65^\\circ$ and $25^\\circ$ are $AB$ and $BC$, $AM$ and $MB$, and $BM$ and $MC$. Hence\n$$\\frac{a}{b}=\\frac{AM}{MB}=\\frac{BM}{MC}=\\frac{y}{h}=\\frac{h}{x}.$$",
              "solutionDiagrams": []
