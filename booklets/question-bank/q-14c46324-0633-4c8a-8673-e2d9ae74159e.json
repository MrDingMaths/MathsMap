                  "inlines": [
                    {
                      "type": "math",
                      "latex": "\\frac{h}{a}=\\frac{\\boxed{\\rule{0pt}{5mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{5mm}\\hspace{14mm}}}=\\frac{\\boxed{\\rule{0pt}{5mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{5mm}\\hspace{8mm}}}",
