  "content": {
    "id": "p147-q31-root",
    "type": "question",
    "label": null,
    "prompt": "By considering the graphs of $y=x^2-1$ and $y=k$, find the value(s) of $k$ such that $x^2-1=k$ has:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p147-q31-a",
        "type": "part",
        "label": "a",
        "prompt": "two solutions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k>-1$.",
          "worked": "The parabola opens upwards and has vertex $(0,-1)$. The horizontal line $y=k$ intersects both branches when it lies above the vertex, so $k>-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p147-q31-b",
        "type": "part",
        "label": "b",
        "prompt": "one solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-1$.",
          "worked": "The horizontal line $y=k$ meets the parabola only at its vertex $(0,-1)$ when $k=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p147-q31-c",
        "type": "part",
        "label": "c",
        "prompt": "no solutions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k<-1$.",
          "worked": "The parabola has minimum value $-1$. A horizontal line below this minimum has no intersection with the parabola, so $k<-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
