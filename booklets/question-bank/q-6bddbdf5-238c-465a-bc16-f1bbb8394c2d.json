    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Write out the values of $A_1$, $A_2$, $A_3$ and $A_4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A_1=\\$2120$, $A_2=\\$2240$, $A_3=\\$2360$, $A_4=\\$2480$.",
          "worked": "Interest per year is $0.06\\times\\$2000=\\$120$.\n$$\\begin{aligned}A_1&=2000+120=\\$2120\\\\A_2&=2000+2(120)=\\$2240\\\\A_3&=2000+3(120)=\\$2360\\\\A_4&=2000+4(120)=\\$2480\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the formula $a_n=a+(n-1)d$ to find a formula for $A_n$, and evaluate $A_{12}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A_n=2000+120n$ dollars; $A_{12}=\\$3440$.",
          "worked": "The amounts form an AP with $a=2120$ and $d=120$.\n$$\\begin{aligned}A_n&=a+(n-1)d\\\\A_n&=2120+(n-1)(120)\\\\A_n&=2120+120n-120\\\\A_n&=2000+120n\\end{aligned}$$\n$$\\begin{aligned}A_{12}&=2000+120(12)\\\\A_{12}&=\\$3440\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p13-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "How many years will it take before the total amount exceeds $\\$6000$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "34 years.",
          "worked": "$$\\begin{aligned}A_n&>6000\\\\2000+120n&>6000\\\\120n&>4000\\\\n&>33\\tfrac13\\end{aligned}$$\nThe first whole number of years satisfying this inequality is 34, so the amount first exceeds $\\$6000$ at the end of 34 years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
