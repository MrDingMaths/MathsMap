      {
        "id": "p57-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the value of $x$ is \\$24590.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=11\\,880+0.31(95\\,000-54\\,000)=24\\,590$, so the base tax is \\$24 590.",
          "worked": "Using the supplied third-bracket base tax, the next base tax is the tax at \\$95 000.\n$$\\begin{align*}\\text{Excess}&=95\\,000-54\\,000\\\\\\text{Excess}&=\\$41\\,000\\\\x&=11\\,880+0.31\\times41\\,000\\\\x&=24\\,590\\end{align*}$$\nHence the base tax is \\$24 590.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p57-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "A person with a taxable income of \\$123 000 pays \\$36346.50 in tax.\nCalculate the value of $y$ rounded to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{36\\,346.50-24\\,590}{28\\,000}\\times100=41.9875$, so $y=42$ cents per dollar to the nearest cent.",
          "worked": "The taxable income is in the fourth bracket.\n$$\\begin{align*}\\text{Excess}&=123\\,000-95\\,000\\\\\\text{Excess}&=\\$28\\,000\\\\36\\,346.50&=24\\,590+\\frac{y}{100}\\times28\\,000\\\\y&=\\frac{36\\,346.50-24\\,590}{28\\,000}\\times100\\\\y&=41.9875\\\\y&\\approx42\\end{align*}$$\nThe rate is 42 cents per dollar, rounded to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
