  "content": {
    "id": "p5-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A polynomial expression is given by $3x^4-2x^3+x^2-x+2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "How many terms does the polynomial have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "The terms are $3x^4$, $-2x^3$, $x^2$, $-x$ and $2$, so there are $5$ terms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q1-b",
        "type": "group",
        "label": "b",
        "prompt": "State the coefficient of:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p5-q1-b-x4",
            "type": "part",
            "label": "i",
            "prompt": "$x^4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "The term $3x^4$ has coefficient $3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p5-q1-b-x3",
            "type": "part",
            "label": "ii",
            "prompt": "$x^3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2$",
              "worked": "The term $-2x^3$ has coefficient $-2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p5-q1-b-x2",
            "type": "part",
            "label": "iii",
            "prompt": "$x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$x^2=1x^2$, so the coefficient is $1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p5-q1-b-x",
            "type": "part",
            "label": "iv",
            "prompt": "$x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1$",
              "worked": "$-x=-1x$, so the coefficient is $-1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      },
      {
        "id": "p5-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the constant term?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "The term without $x$ is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
