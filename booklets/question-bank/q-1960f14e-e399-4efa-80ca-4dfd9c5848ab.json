  "content": {
    "id": "p27-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the $x$-coordinates of the point(s) where $f'(x)=0$ for each of the following curves.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-8x+16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$y'=2x-8$$ $$\\begin{align*}2x-8&=0\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p27-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=6x^2-x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=4$.",
          "worked": "$$\\begin{align*}y'&=12x-3x^2\\\\y'&=3x(4-x)\\end{align*}$$ $$\\begin{align*}3x(4-x)&=0\\\\x&=0\\quad\\text{or}\\quad x=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p27-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2x^3+3x^2-36x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $x=2$.",
          "worked": "$$\\begin{align*}y'&=6x^2+6x-36\\\\y'&=6(x+3)(x-2)\\end{align*}$$ $$\\begin{align*}6(x+3)(x-2)&=0\\\\x&=-3\\quad\\text{or}\\quad x=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
