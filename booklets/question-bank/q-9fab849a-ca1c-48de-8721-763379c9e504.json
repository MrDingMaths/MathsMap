                "marks": [
                  "bold"
                ]
              }
            ]
          },
          {
            "id": "p53-q26-answer-sydney-rate",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "r=1+\\frac{0.07}{12}",
                "display": true
              }
            ]
          },
          {
            "id": "p53-q26-answer-sydney-series",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "There are 36 repayments. At the end of 36 months:",
                "marks": []
              },
              {
                "type": "math",
                "latex": "A_{36}=5000r^{36}-Mr^{35}-Mr^{34}-\\cdots-M",
                "display": true
              },
              {
                "type": "text",
                "text": "The repayment terms form a geometric series with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=M",
                "display": false
              },
              {
                "type": "text",
                "text": ", common ratio ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "r",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n=36",
                "display": false
              },
              {
                "type": "text",
                "text": ". Set the final balance to zero.",
                "marks": []
              }
            ]
          },
          {
            "id": "p53-q26-answer-sydney-calculation",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}0&=5000r^{36}-M\\frac{r^{36}-1}{r-1}\\\\M&=\\frac{5000r^{36}(r-1)}{r^{36}-1}\\\\M&=\\frac{5000(1+\\frac{0.07}{12})^{36}(\\frac{0.07}{12})}{(1+\\frac{0.07}{12})^{36}-1}\\\\M&\\approx\\$154.39\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p53-q26-answer-sydney-total",
            "type": "paragraph",
            "fontSize": null,
