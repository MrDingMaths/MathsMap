  "content": {
    "id": "p53-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "NSW Bank offers loans at 9% p.a. with no repayments for the first 3 months, while Sydney Bank offers loans at 7% p.a. Compare these loans for a $\\$5000$ loan over 3 years and state which bank offers the better loan and why. Assume interest is compounded monthly and equal repayments are made at the end of each repayment month. Give repayments and totals to the nearest cent, using unrounded repayments to calculate totals.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "NSW Bank: 33 monthly repayments of approximately $\\$175.49$; total $\\$5791.25$. Sydney Bank: 36 monthly repayments of approximately $\\$154.39$; total $\\$5557.88$. Sydney Bank is better because the total repaid is lower.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p53-q26-answer-nsw-heading",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "NSW Bank:",
                "marks": [
                  "bold"
                ]
              }
            ]
          },
          {
            "id": "p53-q26-answer-nsw-rate",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "r=1+\\frac{0.09}{12}=1.0075",
                "display": true
              }
            ]
          },
          {
            "id": "p53-q26-answer-nsw-delay",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let M be the monthly repayment. No repayments are made for the first 3 months, so there are 33 repayments, at the ends of months 4 to 36.",
                "marks": []
              }
            ]
          },
          {
            "id": "p53-q26-answer-nsw-balance",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "A_{36}=5000r^{36}-Mr^{32}-Mr^{31}-\\cdots-M",
                "display": true
              }
            ]
          },
          {
            "id": "p53-q26-answer-nsw-series",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The repayment terms form a geometric series with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=M",
                "display": false
              },
              {
                "type": "text",
                "text": ", common ratio ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "r",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n=33",
                "display": false
              },
              {
                "type": "text",
                "text": ". Set the final balance to zero.",
                "marks": []
              }
            ]
          },
          {
            "id": "p53-q26-answer-nsw-calculation",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}0&=5000r^{36}-M\\frac{r^{33}-1}{r-1}\\\\M&=\\frac{5000r^{36}(r-1)}{r^{33}-1}\\\\M&=\\frac{5000(1.0075)^{36}(0.0075)}{(1.0075)^{33}-1}\\\\M&\\approx\\$175.49\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p53-q26-answer-nsw-total",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using the unrounded repayment:",
                "marks": []
              },
              {
                "type": "math",
                "latex": "T_{\\mathrm{NSW}}=33\\left(\\frac{5000(1.0075)^{36}(0.0075)}{(1.0075)^{33}-1}\\right)\\approx\\$5791.25",
                "display": true
              }
            ]
          },
          {
            "id": "p53-q26-answer-sydney-heading",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
