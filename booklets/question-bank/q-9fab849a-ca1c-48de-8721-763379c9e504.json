            "inlines": [
              {
                "type": "text",
                "text": "Using the unrounded repayment:",
                "marks": []
              },
              {
                "type": "math",
                "latex": "T_{\\mathrm{Sydney}}=36\\left(\\frac{5000(1+\\frac{0.07}{12})^{36}(\\frac{0.07}{12})}{(1+\\frac{0.07}{12})^{36}-1}\\right)\\approx\\$5557.88",
                "display": true
              }
            ]
          },
          {
