  "content": {
    "id": "p8-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "There are 300 cells in a Petri dish. The number of cells increases by 6% every hour.\nWork out the number of cells in the dish after these times, answer to the nearest whole.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q11-a-node",
        "type": "part",
        "label": "a",
        "prompt": "1 hour",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "318 cells",
          "worked": "The hourly multiplier is $1+0.06=1.06$.\n$$\\begin{align*}N&=300\\times1.06\\\\&=318\\end{align*}$$\n318 cells.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q11-b-node",
        "type": "part",
        "label": "b",
        "prompt": "6 hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "426 cells",
          "worked": "The hourly multiplier is $1.06$.\n$$\\begin{align*}N&=300\\times(1.06)^6\\\\&\\approx426\\end{align*}$$\n426 cells, to the nearest whole number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q11-c-node",
        "type": "part",
        "label": "c",
        "prompt": "72 hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "19 913 cells",
          "worked": "The hourly multiplier is $1.06$.\n$$\\begin{align*}N&=300\\times(1.06)^{72}\\\\&\\approx19\\,913\\end{align*}$$\n19 913 cells, to the nearest whole number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
