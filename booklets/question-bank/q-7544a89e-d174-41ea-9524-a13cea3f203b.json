  "content": {
    "id": "p25-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "A shopkeeper paid $\\$200$ each for two handbags. He sold the first handbag for a profit of $25\\%$ of the cost price. He sold the second at a loss of $15\\%$ of the cost price. How much profit did the shopkeeper make on the two bags?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$20$ profit.",
      "worked": "$$\\begin{align*}\\text{Profit on first handbag}&=\\frac{25}{100}\\times\\$200\\\\\\text{Profit on first handbag}&=\\$50\\\\\\text{Loss on second handbag}&=\\frac{15}{100}\\times\\$200\\\\\\text{Loss on second handbag}&=\\$30\\\\\\text{Total profit}&=\\$50-\\$30\\\\\\text{Total profit}&=\\$20\\end{align*}$$",
      "solutionDiagrams": []
    },
