  "content": {
    "id": "p34-q4-response",
    "type": "question",
    "label": "4",
    "prompt": "A team has a probability of 52% of winning its first season and a 39% chance of winning both seasons 1 and 2. What is the probability of the team winning the second season given that it wins the first season?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{4}$",
      "worked": "$$\\begin{align*}P(\\text{second win}\\mid\\text{first win})&=\\frac{P(\\text{both wins})}{P(\\text{first win})}\\\\&=\\frac{0.39}{0.52}\\\\&=\\frac{3}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 27
  },
