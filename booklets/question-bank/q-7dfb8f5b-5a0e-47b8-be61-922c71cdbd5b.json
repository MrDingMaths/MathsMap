    "type": "question",
    "label": "1",
    "prompt": "A couple saves $\\$3000$ at the beginning of each year towards a deposit on a house. If the interest rate is 5% p.a., how much will the couple have saved after 6 years? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
