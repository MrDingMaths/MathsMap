  "content": {
    "id": "p5-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "For the function $L(x)=3x+1$, determine:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$L(1)-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}L(1)-2&=(3\\times1+1)-2\\\\L(1)-2&=4-2\\\\L(1)-2&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$3L(-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6$",
          "worked": "$$\\begin{align*}3L(-1)&=3\\bigl(3\\times(-1)+1\\bigr)\\\\3L(-1)&=3\\times(-2)\\\\3L(-1)&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$L(1)+L(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$",
          "worked": "$$\\begin{align*}L(1)+L(2)&=(3\\times1+1)+(3\\times2+1)\\\\L(1)+L(2)&=4+7\\\\L(1)+L(2)&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$L(9)\\div L(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}L(9)\\div L(2)&=(3\\times9+1)\\div(3\\times2+1)\\\\L(9)\\div L(2)&=28\\div7\\\\L(9)\\div L(2)&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
