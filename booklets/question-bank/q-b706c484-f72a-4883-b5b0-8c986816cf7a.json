  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A bag contains 6 blocks numbered 1 through 6. We pull out 3 of them, and place them in a line. How many different arrangements of 3 blocks are possible?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$120$",
      "worked": "There are 6 choices for the first block, 5 for the second and 4 for the third. Order matters.\n$$\\begin{align*}N&=6\\times5\\times4\\\\N&=120\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
