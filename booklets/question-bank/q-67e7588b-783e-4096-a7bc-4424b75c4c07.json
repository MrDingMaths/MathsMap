  "content": {
    "id": "p15-q17",
    "type": "question",
    "label": "17",
    "prompt": "After cycling $\\frac{1}{3}$ of a journey, a cyclist has 28 km further to go. What is the length of the journey?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$42\\text{ km}$\n\nThe remaining 28 km is two-thirds of the journey.",
      "worked": "$$\\begin{align*}\\text{Fraction remaining}&=1-\\frac{1}{3}\\\\\\text{Fraction remaining}&=\\frac{2}{3}\\\\\\text{Journey length}&=28\\div\\frac{2}{3}\\\\\\text{Journey length}&=28\\times\\frac{3}{2}\\\\\\text{Journey length}&=42\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
