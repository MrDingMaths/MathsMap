  "content": {
    "id": "p42-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "If $x=\\dfrac{1}{t}$, $y=\\dfrac{1}{1-x}$, $z=\\dfrac{y}{y-1}$, show that $z=t$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\dfrac{t}{t-1}$, so $z=\\dfrac{\\frac{t}{t-1}}{\\frac{1}{t-1}}=t$.",
      "worked": "$\\begin{align*}y&=\\frac{1}{1-x}\\\\y&=\\frac{1}{1-\\frac{1}{t}}\\\\y&=\\frac{t}{t-1}\\end{align*}$\n\n$\\begin{align*}z&=\\frac{y}{y-1}\\\\z&=\\frac{\\frac{t}{t-1}}{\\frac{t}{t-1}-1}\\\\z&=\\frac{\\frac{t}{t-1}}{\\frac{t-(t-1)}{t-1}}\\\\z&=\\frac{\\frac{t}{t-1}}{\\frac{1}{t-1}}\\\\z&=t\\end{align*}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 112
  },
