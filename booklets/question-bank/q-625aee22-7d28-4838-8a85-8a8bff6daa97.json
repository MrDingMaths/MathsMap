    "type": "question",
    "label": null,
    "prompt": "$\\$12\\,500$ is invested for 4 years at 3.2% p.a. interest, compounded yearly. Calculate the total amount of interest earned. Answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$1678.45$",
      "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 12\\,500(1+0.032)^4\\\\FV &\\approx 14\\,178.4515\\\\I &= FV-PV\\\\I &\\approx 14\\,178.4515-12\\,500\\\\I &\\approx \\$1678.45\\end{align*}$$",
