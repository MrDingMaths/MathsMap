            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 95 p95-q2-c-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black},line join=miter]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-1,-12) rectangle (59,25);\n\\draw[black,line width=0.8pt] (0,0) rectangle (42,23);\n\\node[below=3mm] at (21,0) {?};\n\\node[right=3mm] at (42,11.5) {$\\frac{2}{7}\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
