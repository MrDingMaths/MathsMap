            "spec": {
              "sourcePage": 95,
              "sourceRegion": "Question 2d",
              "description": "Unfilled horizontal rectangle with three-fifths centimetres below the bottom side and a question mark beside the right side.",
              "mathematics": "Perimeter is 12 cm and the known side is 3/5 cm; the right-side length is unknown. Source illustration is schematic.",
