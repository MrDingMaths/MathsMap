        },
        "answerSpaceMm": 22
      },
      {
        "id": "p95-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the perimeter of the rectangle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{62}{35}\\text{ cm}$",
          "worked": "$$\\begin{align*}P&=2\\left(\\frac{3}{5}+\\frac{2}{7}\\right)\\\\&=2\\left(\\frac{21}{35}+\\frac{10}{35}\\right)\\\\&=\\frac{62}{35}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p95-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "The area of the rectangle is $8\\text{ cm}^2$. Find the missing length.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
