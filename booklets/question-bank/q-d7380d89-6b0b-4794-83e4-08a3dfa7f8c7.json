        "answer": {
          "short": "$28\\text{ cm}$",
          "worked": "$$\\begin{align*}\\text{Length}&=8\\div\\frac{2}{7}\\\\&=8\\times\\frac{7}{2}\\\\&=28\\text{ cm}\\end{align*}$$",
