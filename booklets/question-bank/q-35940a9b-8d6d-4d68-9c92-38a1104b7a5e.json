  "content": {
    "id": "p36-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "The probability of a woman being alive at 80 years of age is 0.2, and the probability of her husband being alive at 80 years of age is 0.05. Assuming their lifetimes are independent, find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "they will both live to be 80 years of age,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.01$",
          "worked": "Assuming their lifetimes are independent,\n$$\\begin{align*}P(\\text{both alive at 80}) &= 0.2\\times0.05\\\\&=0.01\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p36-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "only one of them will live to be 80.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.23$",
          "worked": "Assuming their lifetimes are independent, add the probabilities that only the woman survives and that only her husband survives.\n$$\\begin{align*}P(\\text{only one alive at 80}) &= 0.2\\times(1-0.05)+(1-0.2)\\times0.05\\\\&=0.19+0.04\\\\&=0.23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
