  "content": {
    "id": "p4-q1-root",
    "type": "question",
    "label": "",
    "prompt": "Given that $y=x^3+x$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "If $\\dfrac{dx}{dt}=5$, find $\\dfrac{dy}{dt}$ when $x=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$65$",
          "worked": "Variables: $y,x,t$.\n$$\\begin{aligned}\\frac{dy}{dt}&=\\frac{dy}{dx}\\times\\frac{dx}{dt}\\\\\\frac{dy}{dt}&=(3x^2+1)\\times5\\end{aligned}$$\nAt $x=2$:\n$$\\begin{aligned}\\frac{dy}{dt}&=(3(2)^2+1)\\times5\\\\\\frac{dy}{dt}&=65\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p4-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\dfrac{dy}{dt}=-6$, find $\\dfrac{dx}{dt}$ when $x=-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3}{14}$",
          "worked": "Variables: $y,x,t$.\n$$\\begin{aligned}\\frac{dy}{dt}&=\\frac{dy}{dx}\\times\\frac{dx}{dt}\\\\-6&=(3x^2+1)\\frac{dx}{dt}\\end{aligned}$$\nAt $x=-3$:\n$$\\begin{aligned}-6&=(3(-3)^2+1)\\frac{dx}{dt}\\\\-6&=28\\frac{dx}{dt}\\\\\\frac{dx}{dt}&=-\\frac{6}{28}\\\\\\frac{dx}{dt}&=-\\frac{3}{14}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
