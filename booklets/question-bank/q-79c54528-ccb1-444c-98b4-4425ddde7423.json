              "type": "text",
              "text": "A bowl of fruit contains 17 apples of which 9 are red and 8 are green.",
              "marks": []
            }
          ]
        },
        {
          "id": "p48-q15-selection",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Dennis takes one apple at random and eats it.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Margaret also takes an apple at random and eats it.",
              "marks": []
            }
          ]
        },
        {
          "id": "p48-q15-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "By drawing a probability tree diagram, or otherwise, find the probability that Dennis and Margaret eat apples of the same colour.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{8}{17}$",
      "worked": "The apples are selected without replacement. Let $R$ denote red and $G$ denote green.\n$$\\begin{align*}P(RR)&=\\frac{9}{17}\\times\\frac{8}{16}=\\frac{72}{272}\\\\P(GG)&=\\frac{8}{17}\\times\\frac{7}{16}=\\frac{56}{272}\\\\P(\\text{same colour})&=P(RR)+P(GG)\\\\&=\\frac{72}{272}+\\frac{56}{272}\\\\&=\\frac{8}{17}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
