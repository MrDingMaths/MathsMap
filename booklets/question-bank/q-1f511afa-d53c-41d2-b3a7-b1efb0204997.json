  "content": {
    "id": "p19-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Simplify the following using index laws. Write your answer without fractional or negative indices.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^3\\times x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4$",
          "worked": "$\\begin{aligned}x^3\\times x&=x^{3+1}\\\\&=x^4\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{x}\\times\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$",
          "worked": "$\\begin{aligned}\\sqrt{x}\\times\\sqrt{x}&=x^{\\frac12}\\times x^{\\frac12}\\\\&=x^{\\frac12+\\frac12}\\\\&=x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2\\times\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x^5}$",
          "worked": "$\\begin{aligned}x^2\\times\\sqrt{x}&=x^2\\times x^{\\frac12}\\\\&=x^{\\frac52}\\\\&=\\sqrt{x^5}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^3\\times\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x^7}$",
          "worked": "$\\begin{aligned}x^3\\times\\sqrt{x}&=x^3\\times x^{\\frac12}\\\\&=x^{\\frac72}\\\\&=\\sqrt{x^7}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2\\times\\sqrt[3]{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[3]{x^7}$",
          "worked": "$\\begin{aligned}x^2\\times\\sqrt[3]{x}&=x^2\\times x^{\\frac13}\\\\&=x^{\\frac73}\\\\&=\\sqrt[3]{x^7}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{x}\\times\\sqrt[3]{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[6]{x^5}$",
          "worked": "$\\begin{aligned}\\sqrt{x}\\times\\sqrt[3]{x}&=x^{\\frac12}\\times x^{\\frac13}\\\\&=x^{\\frac36+\\frac26}\\\\&=x^{\\frac56}\\\\&=\\sqrt[6]{x^5}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p19-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$x\\sqrt{x}\\times x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x^5}$",
          "worked": "$\\begin{aligned}x\\sqrt{x}\\times x&=x^1\\times x^{\\frac12}\\times x^1\\\\&=x^{\\frac52}\\\\&=\\sqrt{x^5}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$x\\sqrt{x}\\times x\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3$",
          "worked": "$\\begin{aligned}x\\sqrt{x}\\times x\\sqrt{x}&=x^{1+\\frac12}\\times x^{1+\\frac12}\\\\&=x^{\\frac32+\\frac32}\\\\&=x^3\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac1x\\times\\frac1x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{x^2}$",
          "worked": "$\\begin{aligned}\\frac1x\\times\\frac1x&=x^{-1}\\times x^{-1}\\\\&=x^{-2}\\\\&=\\frac1{x^2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p19-q11-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac1x\\times x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$\\begin{aligned}\\frac1x\\times x&=x^{-1}\\times x^1\\\\&=x^0\\\\&=1\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac3x\\times x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$\\begin{aligned}\\frac3x\\times x&=3x^{-1}\\times x^1\\\\&=3x^0\\\\&=3\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac1{\\sqrt{x}}\\times\\frac1{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1x$",
          "worked": "$\\begin{aligned}\\frac1{\\sqrt{x}}\\times\\frac1{\\sqrt{x}}&=x^{-\\frac12}\\times x^{-\\frac12}\\\\&=x^{-1}\\\\&=\\frac1x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p19-q11-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac2{\\sqrt{x}}\\times\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$\\begin{aligned}\\frac2{\\sqrt{x}}\\times\\sqrt{x}&=2x^{-\\frac12}\\times x^{\\frac12}\\\\&=2x^0\\\\&=2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac1{\\sqrt{x}}\\times x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x}$",
          "worked": "$\\begin{aligned}\\frac1{\\sqrt{x}}\\times x&=x^{-\\frac12}\\times x^1\\\\&=x^{\\frac12}\\\\&=\\sqrt{x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\frac1{\\sqrt{x}}\\times\\frac{x}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$\\begin{aligned}\\frac1{\\sqrt{x}}\\times\\frac{x}{\\sqrt{x}}&=x^{-\\frac12}\\times x^{1-\\frac12}\\\\&=x^{-\\frac12+\\frac12}\\\\&=1\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p19-q11-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\frac{x^2}{\\sqrt{x}}\\times\\frac{\\sqrt{x}}{x\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x}$",
          "worked": "$\\begin{aligned}\\frac{x^2}{\\sqrt{x}}\\times\\frac{\\sqrt{x}}{x\\sqrt{x}}&=x^{2-\\frac12}\\times x^{\\frac12-1-\\frac12}\\\\&=x^{\\frac32}\\times x^{-1}\\\\&=x^{\\frac12}\\\\&=\\sqrt{x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
