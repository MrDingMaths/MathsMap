        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{x}{2}+1\\right)^2+\\left(\\frac{x}{2}-1\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{2}+2$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{2}+1\\right)^2+\\left(\\frac{x}{2}-1\\right)^2&=\\frac{x^2}{4}+x+1+\\frac{x^2}{4}-x+1\\\\\\left(\\frac{x}{2}+1\\right)^2+\\left(\\frac{x}{2}-1\\right)^2&=\\frac{x^2}{2}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{x}{3}+3\\right)^2+\\left(\\frac{2x}{3}+1\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x^2}{9}+\\frac{10x}{3}+10$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{3}+3\\right)^2+\\left(\\frac{2x}{3}+1\\right)^2&=\\frac{x^2}{9}+2x+9\\\\&\\quad+\\frac{4x^2}{9}+\\frac{4x}{3}+1\\\\\\left(\\frac{x}{3}+3\\right)^2+\\left(\\frac{2x}{3}+1\\right)^2&=\\frac{5x^2}{9}+\\frac{10x}{3}+10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p22-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{3x}{4}+2\\right)^2+\\left(\\frac{x}{2}+3\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13x^2}{16}+6x+13$",
          "worked": "$$\\begin{align*}\\left(\\frac{3x}{4}+2\\right)^2+\\left(\\frac{x}{2}+3\\right)^2&=\\frac{9x^2}{16}+3x+4\\\\&\\quad+\\frac{x^2}{4}+3x+9\\\\\\left(\\frac{3x}{4}+2\\right)^2+\\left(\\frac{x}{2}+3\\right)^2&=\\frac{13x^2}{16}+6x+13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p22-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{2x}{5}-\\frac14\\right)^2+\\left(\\frac{x}{5}+\\frac12\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{5}+\\frac{5}{16}$",
          "worked": "$$\\begin{align*}\\left(\\frac{2x}{5}-\\frac14\\right)^2+\\left(\\frac{x}{5}+\\frac12\\right)^2&=\\frac{4x^2}{25}-\\frac{x}{5}+\\frac{1}{16}\\\\&\\quad+\\frac{x^2}{25}+\\frac{x}{5}+\\frac14\\\\\\left(\\frac{2x}{5}-\\frac14\\right)^2+\\left(\\frac{x}{5}+\\frac12\\right)^2&=\\frac{x^2}{5}+\\frac{5}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
