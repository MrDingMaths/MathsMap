    "children": [
      {
        "id": "p7-ch14-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_x 27=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "$$\\begin{align*}x^3&=27\\\\x^3&=3^3\\\\x&=3\\end{align*}$$\nThe base satisfies $x>0$ and $x\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-ch14-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_x 16=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2^{2/3}$",
          "worked": "$$\\begin{align*}x^6&=16\\\\x^6&=2^4\\\\x&=(2^4)^{1/6}\\\\x&=2^{2/3}\\end{align*}$$\nTake the positive root because a logarithm's base is positive. This value is not $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p7-ch14-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_x 2048=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2^{11/6}$",
          "worked": "$$\\begin{align*}x^6&=2048\\\\x^6&=2^{11}\\\\x&=(2^{11})^{1/6}\\\\x&=2^{11/6}\\end{align*}$$\nTake the positive root because a logarithm's base is positive. This value is not $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p7-ch14-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_x 1000=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10$",
          "worked": "$$\\begin{align*}x^3&=1000\\\\x^3&=10^3\\\\x&=10\\end{align*}$$\nThe base satisfies $x>0$ and $x\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
