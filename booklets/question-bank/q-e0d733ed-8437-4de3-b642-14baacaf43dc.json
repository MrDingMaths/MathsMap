  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Write down the equation of the line that has a $y$-intercept of $(0,-1)$ and which passes through the point $(3,3)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\frac{4}{3}x-1$",
      "worked": "The $y$-intercept gives $c=-1$. Using $(0,-1)$ and $(3,3)$:\n$$\\begin{align*}m&=\\frac{3-(-1)}{3-0}\\\\m&=\\frac{4}{3}.\\end{align*}$$\nHence, in $y=mx+c$,\n$$y=\\frac{4}{3}x-1.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
