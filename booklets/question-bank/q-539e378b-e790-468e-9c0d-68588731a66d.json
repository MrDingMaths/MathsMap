  "content": {
    "id": "p15-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find a formula for:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "the number of cents $z$ in $x$ dollars and $y$ cents",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z=100x+y$",
          "worked": "$x$ dollars is $100x$ cents. Adding the remaining $y$ cents gives\n$$z=100x+y.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "the number of minutes $x$ in $y$ minutes and $z$ seconds",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=y+\\dfrac{z}{60}$",
          "worked": "$z$ seconds is $\\dfrac{z}{60}$ minutes, so\n$$x=y+\\frac{z}{60}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "the number of hours $x$ in $y$ minutes and $z$ seconds",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{60y+z}{3600}$",
          "worked": "The total time is $60y+z$ seconds. There are $3600$ seconds in an hour, so\n$$x=\\frac{60y+z}{3600}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "the cost $\\$m$ of 1 book if 20 books cost $\\$c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\dfrac{c}{20}$",
          "worked": "Divide the total cost by the number of books:\n$$m=\\frac{c}{20}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "the cost $\\$n$ of 1 suit if 5 suits cost $\\$m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac{m}{5}$",
          "worked": "Divide the total cost by the number of suits:\n$$n=\\frac{m}{5}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "the cost $\\$m$ of 1 tyre if $x$ tyres cost $\\$y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\dfrac{y}{x}$",
          "worked": "Divide the total cost by the number of tyres:\n$$m=\\frac{y}{x}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "the cost $\\$p$ of $n$ suits if 4 suits cost $\\$k$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\dfrac{nk}{4}$",
          "worked": "One suit costs $\\$\\dfrac{k}{4}$. Therefore\n$$\\begin{align*}p&=n\\times\\frac{k}{4}\\\\p&=\\frac{nk}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "the cost $\\$q$ of $x$ cars if 8 cars cost $\\$b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$q=\\dfrac{xb}{8}$",
          "worked": "One car costs $\\$\\dfrac{b}{8}$. Therefore\n$$\\begin{align*}q&=x\\times\\frac{b}{8}\\\\q&=\\frac{xb}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
