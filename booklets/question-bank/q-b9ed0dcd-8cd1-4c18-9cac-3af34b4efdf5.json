        "prompt": "Find the perimeter of the figure shown below in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p19-q15-a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 19, p19-q15-a-diagram\"}\n\\begin{tikzpicture}[x=13mm,y=13mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (3,0);\n\\coordinate (C) at (3,2);\n\\coordinate (D) at (1,2);\n\\coordinate (E) at (1,1);\n\\coordinate (F) at (0,1);\n\\draw[draw=black,line width=0.8pt] (A)--(B)--(C)--(D)--(E)--(F)--cycle;\n\\path (A)--(B) node[midway,below=2mm] {$3x\\ \\mathrm{cm}$};\n\\path (B)--(C) node[midway,right=2mm] {$2x\\ \\mathrm{cm}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 52,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 19,
              "sourceRegion": "Question 15a, figure below the instruction",
              "description": "Unfilled six-sided orthogonal polygon with an inward step at the upper left. The full bottom edge is labelled 3x cm and the full right edge is labelled 2x cm.",
              "mathematics": "The horizontal boundary lengths total twice the full width, 2(3x); the vertical boundary lengths total twice the full height, 2(2x). Coordinates reproduce the source appearance and do not supply additional measurements.",
              "answerVisibility": "The outline and both supplied dimensions remain visible in the student question. No perimeter expression or solved value appears in the diagram."
            },
            "derived": false,
            "reviewStatus": "needs-review"
