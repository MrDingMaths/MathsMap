        "children": [],
        "answer": {
          "short": "$P=10x\\text{ cm}$; horizontal boundary segments total $6x\\text{ cm}$ and vertical boundary segments total $4x\\text{ cm}$.",
          "worked": "The horizontal boundary lengths total $2\\times3x$, and the vertical boundary lengths total $2\\times2x$.\n\n$$\\begin{align*}P&=2(3x)+2(2x)\\\\P&=6x+4x\\\\P&=10x\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "If the perimeter is 64 cm, find the value of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6\\frac{2}{5}$.",
          "worked": "$$\\begin{align*}P&=10x\\\\10x&=64\\\\x&=\\frac{64}{10}\\\\x&=6\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
