  "content": {
    "id": "p17-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Cans in a supermarket are displayed in a triangular stack with one can at the top, two cans in the second row from the top, three cans in the third row from the top, and so on. What is the number of cans in the display if the number of rows is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$4$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$ cans",
          "worked": "$$\\begin{align*}N&=1+2+3+4\\\\N&=10\\end{align*}$$\nThere are $10$ cans.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$5$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$ cans",
          "worked": "$$\\begin{align*}N&=1+2+3+4\\\\&\\quad+5\\\\N&=15\\end{align*}$$\nThere are $15$ cans.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$n$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n(n+1)}{2}$ cans\n\nPair the row counts in forward and reverse order.",
          "worked": "Let $N$ be the total number of cans. Add the row counts in forward and reverse order:\n$$\\begin{align*}N&=1+2+\\cdots+n\\\\N&=n+(n-1)+\\cdots+1\\end{align*}$$\nEach of the $n$ pairs totals $n+1$.\n$$\\begin{align*}2N&=n(n+1)\\\\N&=\\frac{n(n+1)}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p17-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$35$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$630$ cans",
          "worked": "$$\\begin{align*}N&=\\frac{n(n+1)}{2}\\\\N&=\\frac{35(35+1)}{2}\\\\N&=35\\times18\\\\N&=630\\end{align*}$$\nThere are $630$ cans.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
