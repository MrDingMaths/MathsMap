    "children": [
      {
        "id": "p25-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the value after 3 years of a new computer that costs $\\$4000$ and depreciates by 25% of its value each year. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1687.50$",
          "worked": "$$\\begin{align*}S &= V_0(1-r)^n\\\\S &= 4000(1-0.25)^3\\\\S &= 1687.50\\end{align*}$$\nThe computer’s value is $\\$1687.50$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How much did it depreciate by in that time? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2312.50$",
          "worked": "$$\\begin{align*}\\text{Depreciation} &= 4000-1687.50\\\\\\text{Depreciation} &= 2312.50\\end{align*}$$\nIt depreciated by $\\$2312.50$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
