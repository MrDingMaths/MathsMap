  "content": {
    "id": "v2-3b3-p16-foundation-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "The mean number of goals a netball team scores each game is $15$.\nThe team scores a total of $255$ goals.\nHow many games did the team play?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$17$ games.\n\nDivide the total by the mean.",
      "worked": "$$\\begin{align*}n &= \\frac{255}{15}\\\\n &= 17\\end{align*}$$\nThe team played $17$ games.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
