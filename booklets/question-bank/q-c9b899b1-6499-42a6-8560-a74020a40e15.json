        "prompt": "$y=2x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2$, $y$-intercept $=-1$.",
          "worked": "Comparing with $y=mx+c$, the gradient is $2$ and the $y$-intercept is $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-ch4-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1$, $y$-intercept $=3$.",
          "worked": "Comparing with $y=mx+c$, the coefficient of $x$ is $1$. The gradient is $1$ and the $y$-intercept is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-ch4-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-1$, $y$-intercept $=7$.",
          "worked": "Comparing with $y=mx+c$, the coefficient of $x$ is $-1$. The gradient is $-1$ and the $y$-intercept is $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-ch4-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x+y=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-1$, $y$-intercept $=4$.",
          "worked": "$$\\begin{align*}y&=4-x\\\\y&=-x+4\\end{align*}$$\nThe gradient is $-1$ and the $y$-intercept is $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-ch4-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$2x+3y=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\frac23$, $y$-intercept $=\\frac13$.",
          "worked": "$$\\begin{align*}3y&=1-2x\\\\y&=\\frac{1-2x}{3}\\\\y&=-\\frac23x+\\frac13\\end{align*}$$\nThe gradient is $-\\frac23$ and the $y$-intercept is $\\frac13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-ch4-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x-4y=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac34$, $y$-intercept $=-\\frac12$.",
          "worked": "$$\\begin{align*}-4y&=2-3x\\\\y&=\\frac{2-3x}{-4}\\\\y&=\\frac34x-\\frac12\\end{align*}$$\nThe gradient is $\\frac34$ and the $y$-intercept is $-\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
