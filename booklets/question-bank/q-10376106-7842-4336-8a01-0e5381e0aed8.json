  "content": {
    "id": "p25-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A new grand piano costs $\\$32\\,000$ and depreciates by 15% of its value each year.\nFind how long it will take for the piano to depreciate to $\\$16\\,000$. Answer to the nearest year.\nHint: set up the compound depreciation equation and use trial and error to estimate n. Refine your trials around the target, then round the estimated time as requested.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "4 years",
      "worked": "$$\\begin{align*}S &= V_0(1-r)^n\\\\S &= 32\\,000(0.85)^n\\\\S(4) &= 32\\,000(0.85)^4=16\\,704.20\\\\S(4.5) &= 32\\,000(0.85)^{4.5}\\approx15\\,400.51\\end{align*}$$\nThe value reaches $\\$16\\,000$ between 4 and 4.5 years, so the time is 4 years to the nearest year.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
