      {
        "id": "index-t6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{a^{7}b^{5}}{a^{3}b^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{4}b^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{a^{7}b^{5}}{a^{3}b^{2}} &= a^{7 - 3}\\,b^{5 - 2} \\\\\n&= a^{4}b^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x^{10}y^{4}}{x^{4}y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{6}y^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{x^{10}y^{4}}{x^{4}y} &= x^{10 - 4}\\,y^{4 - 1} \\\\\n&= x^{6}y^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{r^{5}s^{7}}{rs^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r^{4}s^{5}$",
          "worked": "$$\\begin{align*}\n\\frac{r^{5}s^{7}}{rs^{2}} &= r^{5 - 1}\\,s^{7 - 2} \\\\\n&= r^{4}s^{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{m^{8}n^{6}}{m^{5}n^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^{3}n^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{m^{8}n^{6}}{m^{5}n^{3}} &= m^{8 - 5}\\,n^{6 - 3} \\\\\n&= m^{3}n^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{p^{6}q^{9}}{p^{2}q^{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^{4}q^{4}$",
          "worked": "$$\\begin{align*}\n\\frac{p^{6}q^{9}}{p^{2}q^{5}} &= p^{6 - 2}\\,q^{9 - 5} \\\\\n&= p^{4}q^{4}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{c^{9}d^{12}}{c^{2}d^{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c^{7}d^{8}\\ $",
          "worked": "$$\\begin{align*}\n\\frac{c^{9}d^{12}}{c^{2}d^{4}} &= c^{9 - 2}\\,d^{12 - 4} \\\\\n&= c^{7}d^{8}\\ \n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
