  "content": {
    "id": "p15-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Write down the general term for each binomial expansion.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1+x)^{13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{13}{k}x^k$, $k=0,1,\\ldots,13$.",
          "worked": "$$\\begin{align*}T_k&=\\binom{13}{k}1^{13-k}x^k\\\\T_k&=\\binom{13}{k}x^k\\end{align*}$$\nHere $k=0,1,\\ldots,13$, so $T_k$ is the $(k+1)$th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(1+2x)^7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{7}{k}2^kx^k$, $k=0,1,\\ldots,7$.",
          "worked": "$$\\begin{align*}T_k&=\\binom{7}{k}1^{7-k}(2x)^k\\\\T_k&=\\binom{7}{k}2^kx^k\\end{align*}$$\nHere $k=0,1,\\ldots,7$, so $T_k$ is the $(k+1)$th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(5+7x)^{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{12}{k}5^{12-k}7^kx^k$, $k=0,1,\\ldots,12$.",
          "worked": "$$\\begin{align*}T_k&=\\binom{12}{k}5^{12-k}(7x)^k\\\\T_k&=\\binom{12}{k}5^{12-k}7^kx^k\\end{align*}$$\nHere $k=0,1,\\ldots,12$, so $T_k$ is the $(k+1)$th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2x-y)^9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{9}{k}2^{9-k}(-1)^kx^{9-k}y^k$, $k=0,1,\\ldots,9$.",
          "worked": "$$\\begin{align*}T_k&=\\binom{9}{k}(2x)^{9-k}(-y)^k\\\\T_k&=\\binom{9}{k}2^{9-k}(-1)^k\\times x^{9-k}y^k\\end{align*}$$\nHere $k=0,1,\\ldots,9$, so $T_k$ is the $(k+1)$th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+2x^{-1})^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{5}{k}2^kx^{5-2k}$, $k=0,1,\\ldots,5$.",
          "worked": "$$\\begin{align*}T_k&=\\binom{5}{k}x^{5-k}(2x^{-1})^k\\\\T_k&=\\binom{5}{k}x^{5-k}2^kx^{-k}\\\\T_k&=\\binom{5}{k}2^kx^{5-2k}\\end{align*}$$\nHere $k=0,1,\\ldots,5$, so $T_k$ is the $(k+1)$th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p15-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(6x-\\frac{2}{x}\\right)^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{8}{k}3^{8-k}(-1)^k2^8x^{8-2k}$, $k=0,1,\\ldots,8$.",
          "worked": "$$\\begin{align*}T_k&=\\binom{8}{k}(6x)^{8-k}(-2)^kx^{-k}\\\\T_k&=\\binom{8}{k}6^{8-k}(-2)^kx^{8-2k}\\\\T_k&=\\binom{8}{k}3^{8-k}2^{8-k}(-1)^k2^k\\times x^{8-2k}\\\\T_k&=\\binom{8}{k}3^{8-k}(-1)^k2^8x^{8-2k}\\end{align*}$$\nHere $k=0,1,\\ldots,8$, so $T_k$ is the $(k+1)$th term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
