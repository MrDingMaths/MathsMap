    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "3 is added to $x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+x$",
          "worked": "Adding 3 to $x$ gives $x+3$, equivalently $3+x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p24-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "6 is subtracted from $z$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z-6$",
          "worked": "Start with $z$ and subtract 6: $z-6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p24-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$ is multiplied by 4",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x$",
          "worked": "$x\\times4=4x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p24-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$t$ is subtracted from 11",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11-t$",
          "worked": "Start with 11 and subtract $t$: $11-t$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p24-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "2 is multiplied by $b$, and 3 is added to the result",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2b+3$",
          "worked": "The product is $2\\times b=2b$. Adding 3 gives $2b+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "6 is added to $z$, and the result is multiplied by 4",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(z+6)$",
          "worked": "The sum is $z+6$. Multiplying the whole sum by 4 gives $4(z+6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$x$ is multiplied by $x$, and 3 is added to the result",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+3$",
          "worked": "The product is $x\\times x=x^2$. Adding 3 gives $x^2+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$x$ is divided by a number, $t$, and then 3 is added to it",
