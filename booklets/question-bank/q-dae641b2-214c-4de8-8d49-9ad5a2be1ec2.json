  "content": {
    "id": "p38-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "For two events $A$ and $B$ it is known that $P(A\\cup B)=0.6$ and $P(A)=0.4$ and $P(B)=0.3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the addition formula $P(A\\cup B)=P(A)+P(B)-P(A\\cap B)$ to find the probability $P(A\\cap B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.1$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p38-q15-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}0.6&=0.4+0.3-P(A\\cap B)\\\\P(A\\cap B)&=0.7-0.6\\\\P(A\\cap B)&=0.1\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p38-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the formula for conditional probability to find $P(A\\mid B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p38-q15-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(A\\mid B)&=\\frac{P(A\\cap B)}{P(B)}\\\\P(A\\mid B)&=\\frac{0.1}{0.3}\\\\P(A\\mid B)&=\\frac{1}{3}\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p38-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $P(B\\mid A)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p38-q15-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(B\\mid A)&=\\frac{P(A\\cap B)}{P(A)}\\\\P(B\\mid A)&=\\frac{0.1}{0.4}\\\\P(B\\mid A)&=\\frac{1}{4}\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
