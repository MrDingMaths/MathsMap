  "content": {
    "id": "p25-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Find the equation if $x^2+y^2=1$ is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "dilated horizontally by a factor of 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{4}+y^2=1$",
          "worked": "Replace $x$ by $\\frac{x}{2}$.\n$$\\begin{align*}\\left(\\frac{x}{2}\\right)^2+y^2&=1\\\\\\frac{x^2}{4}+y^2&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "dilated vertically by a factor of 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+\\dfrac{y^2}{4}=1$",
          "worked": "Replace $y$ by $\\frac{y}{2}$.\n$$\\begin{align*}x^2+\\left(\\frac{y}{2}\\right)^2&=1\\\\x^2+\\frac{y^2}{4}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "dilated horizontally by a factor of 0.5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+y^2=1$",
          "worked": "Replace $x$ by $\\frac{x}{0.5}=2x$.\n$$\\begin{align*}(2x)^2+y^2&=1\\\\4x^2+y^2&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "dilated vertically by a factor of 0.5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+4y^2=1$",
          "worked": "Replace $y$ by $\\frac{y}{0.5}=2y$.\n$$\\begin{align*}x^2+(2y)^2&=1\\\\x^2+4y^2&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
