  "content": {
    "id": "p30-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A football squad consists of 24 players. Only $\\frac{1}{8}$ of the squad are injured. How many players are fit to play?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "21 players",
      "worked": "Injured players:\n$$\\begin{aligned}\\frac{1}{8}\\times24&=\\frac{24}{8}\\\\\\frac{1}{8}\\times24&=3\\end{aligned}$$\nFit players:\n$$24-3=21$$\nTherefore, 21 players are fit to play.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
