  "content": {
    "id": "p44-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Differentiate the following with respect to $x$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\frac{x+1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2}{(x-1)^2}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{(x-1)-(x+1)}{(x-1)^2}\\\\\\frac{dy}{dx}&=-\\frac{2}{(x-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p44-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac{x^2}{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x(x-1)}{(2x-1)^2}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{2x(2x-1)-2x^2}{(2x-1)^2}\\\\\\frac{dy}{dx}&=\\frac{2x^2-2x}{(2x-1)^2}\\\\\\frac{dy}{dx}&=\\frac{2x(x-1)}{(2x-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p44-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{x^2-1}{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x}{(x^2+1)^2}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{2x(x^2+1)-2x(x^2-1)}{(x^2+1)^2}\\\\\\frac{dy}{dx}&=\\frac{2x[(x^2+1)-(x^2-1)]}{(x^2+1)^2}\\\\\\frac{dy}{dx}&=\\frac{4x}{(x^2+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p44-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{x^2}{\\sqrt{x+1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x(3x+4)}{2\\sqrt{(x+1)^3}}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{2x\\sqrt{x+1}-\\frac{x^2}{2\\sqrt{x+1}}}{x+1}\\\\\\frac{dy}{dx}&=\\frac{4x(x+1)-x^2}{2(x+1)^{\\frac32}}\\\\\\frac{dy}{dx}&=\\frac{x(3x+4)}{2\\sqrt{(x+1)^3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
