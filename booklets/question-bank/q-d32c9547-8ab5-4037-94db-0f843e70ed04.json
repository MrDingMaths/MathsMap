              ]
            },
            {
              "id": "p7-q9-a-bc-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "BC=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$2$",
                  "width": 12
                }
              ]
            },
            {
              "id": "p7-q9-a-ac-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "AC=",
                  "display": false
                },
                {
                  "type": "cloze",
