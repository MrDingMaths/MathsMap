  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Each set of three points given below forms a triangle that is either isosceles, equilateral, right-angled, or none of the above.\nFind the side lengths of each triangle and hence determine its type.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p7-q9-a-givens",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
