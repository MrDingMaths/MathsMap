              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "A(-1,0),\\ B(1,0),\\ C(0,\\sqrt{3})",
                  "display": false
                }
              ]
            },
            {
              "id": "p7-q9-a-ab-scaffold",
              "type": "paragraph",
              "fontSize": null,
