    "children": [
      {
        "id": "v2-nr-p50-s1-slot-31-slot-31-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the yacht's average speed in km/h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18\\text{ km/h}$",
          "worked": "$$\\begin{align*}t&=\\frac{40}{60}=\\frac23\\text{ h}\\\\v&=\\frac{12}{\\frac23}=18\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-nr-p50-s1-slot-31-slot-31-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the direct distance from $A$ to $C$, correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23.9\\text{ km}$",
          "worked": "$$\\begin{align*}AC^2&=12^2+15^2-2(12)(15)\\cos124^\\circ\\\\AC&=\\sqrt{12^2+15^2-2(12)(15)\\cos124^\\circ}\\\\AC&\\approx23.9\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-nr-p50-s1-slot-31-slot-31-c",
        "type": "part",
        "label": "c",
        "prompt": "How many minutes would be saved by sailing directly from $A$ to $C$? Answer to the nearest minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\text{ minutes}$",
          "worked": "Using the unrounded $AC$:\n$$\\begin{align*}t_{ABC}&=\\frac{27}{18}\\times60=90\\text{ min}\\\\t_{AC}&=\\frac{AC}{18}\\times60\\approx79.6\\text{ min}\\\\\\text{Saved}&=90-79.6\\approx10\\text{ min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
