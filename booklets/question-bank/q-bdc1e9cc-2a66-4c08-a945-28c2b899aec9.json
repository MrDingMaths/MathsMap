  "content": {
    "id": "v2-nr-p50-s1-slot-31-root",
    "type": "question",
    "label": null,
    "prompt": "A yacht sails from $A$ to $B$, a distance of 12 km, in 40 minutes. It then sails 15 km from $B$ to $C$ at the same average speed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "v2-nr-p50-s1-slot-31-slot-31-d1",
        "role": "question",
        "format": "tikz",
        "code": "\\usetikzlibrary{angles,quotes}\n\\begin{tikzpicture}[every node/.style={font=\\large}]\n\\coordinate (B) at (0,0);\n\\coordinate (A) at (152:2.4);\n\\coordinate (C) at (28:3.0);\n\\draw[line width=0.8pt] (A)--(B) node[midway,below left] {$12\\text{ km}$};\n\\draw[line width=0.8pt] (B)--(C) node[midway,below right] {$15\\text{ km}$};\n\\pic[draw,line width=0.5pt,\"$124^\\circ$\",angle radius=0.5cm,angle eccentricity=1.8] {angle=C--B--A};\n\\node[left] at (A) {$A$};\n\\node[below] at (B) {$B$};\n\\node[right] at (C) {$C$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 55,
