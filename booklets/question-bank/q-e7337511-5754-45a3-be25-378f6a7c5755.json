  "content": {
    "id": "p126-q65-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=\\dfrac{|x|}{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p126-q65-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $f(x)$ as a piecewise-defined function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$f(x)=\\begin{cases}1,&x>0,\\\\-1,&x<0.\\end{cases}$$\n\nSplit by the sign of $x$; exclude zero.",
          "worked": "The denominator requires $x\\ne0$.\n\nFor $x>0$, $|x|=x$:\n$$\\begin{align*}f(x)&=\\frac{x}{x}\\\\f(x)&=1.\\end{align*}$$\n\nFor $x<0$, $|x|=-x$:\n$$\\begin{align*}f(x)&=\\frac{-x}{x}\\\\f(x)&=-1.\\end{align*}$$\n\nThus\n$$f(x)=\\begin{cases}1,&x>0,\\\\-1,&x<0.\\end{cases}$$\nThe function is undefined at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p126-q65-b",
        "type": "part",
        "label": "b",
        "prompt": "Graph $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal rays $y=1$ for $x>0$ and $y=-1$ for $x<0$, with open endpoints at $(0,1)$ and $(0,-1)$.",
          "worked": "Draw $y=1$ only for $x>0$ and $y=-1$ only for $x<0$. Use open circles at $(0,1)$ and $(0,-1)$ because $x=0$ is excluded.",
          "solutionDiagrams": [
            {
              "id": "p126-q65-b-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"graphBlue\",\"hex\":\"268CFF\",\"reason\":\"Function branches distinguished from coordinate axes.\"}],\"reference\":\"Answer PDF page 27, printed page 605, Exercise 2M Q65(b)\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,line cap=round,line join=round]\n\\definecolor{graphBlue}{HTML}{268CFF}\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-2.4,-1.65) rectangle (2.45,1.95);\n\\draw[black,line width=0.5pt,->] (-2.1,0) -- (2.1,0);\n\\draw[black,line width=0.5pt,->] (0,-1.5) -- (0,1.75);\n\\node[anchor=north,yshift=-3pt,text=black] at (2.1,0) {$x$};\n\\node[anchor=east,xshift=-2pt,text=black] at (0,1.75) {$y$};\n\\draw[graphBlue,line width=0.8pt,->] (0,1) -- (2.05,1);\n\\draw[graphBlue,line width=0.8pt,->] (0,-1) -- (-2.05,-1);\n\\draw[draw=graphBlue,fill=white,line width=0.8pt] (0,1) circle[radius=1.3pt];\n\\draw[draw=graphBlue,fill=white,line width=0.8pt] (0,-1) circle[radius=1.3pt];\n\\node[anchor=east,xshift=-3pt,text=black] at (0,1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\node[anchor=west,xshift=3pt,text=black] at (0,-1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 60,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 27,
                "sourceRegion": "Answer book, printed page 605, right column, Exercise 2M Q65(b).",
                "description": "Two horizontal rays on Cartesian axes: the upper ray extends right from an open endpoint, and the lower ray extends left from an open endpoint. The upper level is labelled 1 to the left of the vertical axis and the lower level is labelled −1 to its right. No grid or origin label.",
                "mathematics": "The upper branch is {(x,1): x>0}; the lower branch is {(x,-1): x<0}. Both points with x=0 are excluded. Arrowheads indicate continuation along each ray.",
                "answerVisibility": "solution-only"
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p126-q65-c",
        "type": "part",
        "label": "c",
        "prompt": "State the domain and range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $(-\\infty,0)\\cup(0,\\infty)$.\n\nRange: $\\{-1,1\\}$.",
          "worked": "Every real input except zero is allowed, since the original denominator is $x$.\n$$\\operatorname{Dom}(f)=(-\\infty,0)\\cup(0,\\infty).$$\nThe two branches attain only $-1$ and $1$.\n$$\\operatorname{Ran}(f)=\\{-1,1\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
