      {
        "id": "p65-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^4-5x^2+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x-1)(x+2)(x-2)$",
          "worked": "Product: $4$. Sum: $-5$. Factor pair: $-1,-4$.\n$$\\begin{align*}x^4-5x^2+4&=x^4-x^2-4x^2+4\\\\&=x^2(x^2-1)-4(x^2-1)\\\\&=(x^2-1)(x^2-4)\\\\&=(x+1)(x-1)(x+2)(x-2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p65-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^4-13x^2+36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x-2)(x+3)(x-3)$",
          "worked": "Product: $36$. Sum: $-13$. Factor pair: $-4,-9$.\n$$\\begin{align*}x^4-13x^2+36&=x^4-4x^2-9x^2+36\\\\&=x^2(x^2-4)-9(x^2-4)\\\\&=(x^2-4)(x^2-9)\\\\&=(x+2)(x-2)(x+3)(x-3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p65-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$9x^4-37x^2+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+1)(3x-1)(x+2)(x-2)$",
          "worked": "Product: $9\\times4=36$. Sum: $-37$. Factor pair: $-1,-36$.\n$$\\begin{align*}9x^4-37x^2+4&=9x^4-x^2-36x^2+4\\\\&=x^2(9x^2-1)-4(9x^2-1)\\\\&=(9x^2-1)(x^2-4)\\\\&=(3x+1)(3x-1)(x+2)(x-2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p65-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^4-13x^2y^2+9y^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+3y)(2x-3y)(x+y)(x-y)$",
          "worked": "Product: $4\\times9=36$. Sum: $-13$. Factor pair: $-9,-4$.\n$$\\begin{align*}4x^4-13x^2y^2+9y^4&=4x^4-9x^2y^2-4x^2y^2+9y^4\\\\&=x^2(4x^2-9y^2)-y^2(4x^2-9y^2)\\\\&=(4x^2-9y^2)(x^2-y^2)\\\\&=(2x+3y)(2x-3y)(x+y)(x-y).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
