        "answer": {
          "short": "$x=\\log_5 10$",
          "worked": "$$\\begin{align*}x&=\\log_5 10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p25-q11",
        "type": "part",
        "label": "b",
        "prompt": "$3^x=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_3 12$",
          "worked": "$$\\begin{align*}x&=\\log_3 12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p25-q12",
        "type": "part",
        "label": "c",
        "prompt": "$e^x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\ln 3$",
          "worked": "$$\\begin{align*}x&=\\ln 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p25-q13",
        "type": "part",
        "label": "d",
        "prompt": "$7^x=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\log_7 9$",
          "worked": "$$\\begin{align*}x&=\\log_7 9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p25-q14",
        "type": "part",
        "label": "e",
        "prompt": "$e^{x+1}=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\ln 7-1$",
          "worked": "$$\\begin{align*}x+1&=\\ln 7\\\\x&=\\ln 7-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p25-q15",
        "type": "part",
        "label": "f",
        "prompt": "$9^{x-2}=18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3+\\log_9 2$",
          "worked": "$$\\begin{align*}x-2&=\\log_9 18\\\\x&=2+\\log_9(9\\times2)\\\\x&=3+\\log_9 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
