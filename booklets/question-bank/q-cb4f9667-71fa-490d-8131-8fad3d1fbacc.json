  "content": {
    "id": "p13-q14-root",
    "type": "question",
    "label": null,
    "prompt": "A car salesman has a basic salary of $\\$800$ a month.\nFor every car he sells, he earns a commission of $\\$150$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Write a formula to find his wage, $W$, in terms of the number, $n$, of cars he sells.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$W=800+150n$",
          "worked": "His monthly wage is the basic salary plus the commission on $n$ cars.\n$$W=800+150n$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p13-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the formula to find his wage in a month when he sells 12 cars.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$W=\\$2600$",
          "worked": "$$\\begin{align*}W&=800+150n\\\\W&=800+150(12)\\\\W&=\\$2600\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p13-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the formula to form and solve an equation to find the number of cars he sells in a month when he earns $\\$1850$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=7$ cars",
          "worked": "$$\\begin{align*}W&=800+150n\\\\1850&=800+150n\\\\1050&=150n\\\\7&=n\\end{align*}$$\nHe sells 7 cars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
