  "content": {
    "id": "p14-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Make $y$ the subject then rewrite these functions with function notation.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x+y=7$; find $f(3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=7-2x$; $f(3)=1$.",
          "worked": "$\\begin{align*}y&=7-2x\\\\f(x)&=7-2x\\\\f(3)&=7-2(3)\\\\f(3)&=1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p14-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x+y=7$; find $f(-3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=7-2x$; $f(-3)=13$.",
          "worked": "$\\begin{align*}y&=7-2x\\\\f(x)&=7-2x\\\\f(-3)&=7-2(-3)\\\\f(-3)&=13\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p14-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x+2y=8$; find $f(3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=4-x$; $f(3)=1$.",
          "worked": "$\\begin{align*}2y&=8-2x\\\\y&=4-x\\\\f(x)&=4-x\\\\f(3)&=4-3\\\\f(3)&=1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$3x+2y=8$; find $f(2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\dfrac{8-3x}{2}$; $f(2)=1$.",
          "worked": "$\\begin{align*}2y&=8-3x\\\\y&=\\frac{8-3x}{2}\\\\f(x)&=\\frac{8-3x}{2}\\\\f(2)&=\\frac{8-3(2)}{2}\\\\f(2)&=1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p14-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x-2y=8$; find $f(2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\dfrac{3x-8}{2}$; $f(2)=-1$.",
          "worked": "$\\begin{align*}2y&=3x-8\\\\y&=\\frac{3x-8}{2}\\\\f(x)&=\\frac{3x-8}{2}\\\\f(2)&=\\frac{3(2)-8}{2}\\\\f(2)&=-1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p14-q15-f",
        "type": "part",
        "label": "f",
        "prompt": "$5x-2y=1$; find $f(-1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\dfrac{5x-1}{2}$; $f(-1)=-3$.",
          "worked": "$\\begin{align*}2y&=5x-1\\\\y&=\\frac{5x-1}{2}\\\\f(x)&=\\frac{5x-1}{2}\\\\f(-1)&=\\frac{5(-1)-1}{2}\\\\f(-1)&=-3\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
