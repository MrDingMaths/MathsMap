  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "How many ways can we choose 4 of 6 people and arrange them in a row?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$360$",
      "worked": "The four positions have 6, 5, 4 and 3 choices respectively; each person can appear only once.\n$$\\begin{align*}N&=6\\times5\\times4\\times3\\\\N&=360\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
