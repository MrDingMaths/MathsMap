  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Suppose that $\\log_2 5=x$ and $\\log_2 3=y$. Express each of the following in terms of $x$ and $y$:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+y$",
          "worked": "$$\\begin{align*}\\log_2 15&=\\log_2 5+\\log_2 3\\\\\\log_2 15&=x+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2 25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$",
          "worked": "$$\\begin{align*}\\log_2 25&=2\\log_2 5\\\\\\log_2 25&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2 75$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+y$",
          "worked": "$$\\begin{align*}\\log_2 75&=\\log_2(5^2\\times3)\\\\\\log_2 75&=2\\log_2 5+\\log_2 3\\\\\\log_2 75&=2x+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_2 30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+y+1$",
          "worked": "$$\\begin{align*}\\log_2 30&=\\log_2(2\\times5\\times3)\\\\\\log_2 30&=\\log_2 2+\\log_2 5+\\log_2 3\\\\\\log_2 30&=1+x+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_2 120$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+y+3$",
          "worked": "$$\\begin{align*}\\log_2 120&=\\log_2(2^3\\times5\\times3)\\\\\\log_2 120&=3\\log_2 2+\\log_2 5+\\log_2 3\\\\\\log_2 120&=3+x+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_2\\frac35$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y-x$",
          "worked": "$$\\begin{align*}\\log_2\\frac35&=\\log_2 3-\\log_2 5\\\\\\log_2\\frac35&=y-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p7-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_2\\frac53$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-y$",
          "worked": "$$\\begin{align*}\\log_2\\frac53&=\\log_2 5-\\log_2 3\\\\\\log_2\\frac53&=x-y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p7-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_2\\frac{27}{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3y-2x$",
          "worked": "$$\\begin{align*}\\log_2\\frac{27}{25}&=\\log_2 3^3-\\log_2 5^2\\\\\\log_2\\frac{27}{25}&=3\\log_2 3-2\\log_2 5\\\\\\log_2\\frac{27}{25}&=3y-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
