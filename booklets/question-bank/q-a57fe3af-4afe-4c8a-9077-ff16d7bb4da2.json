  "content": {
    "id": "p22-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A piece of string $253\\text{ cm}$ long is to be divided in the ratio $2:3:6$. How long is each part?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$46\\text{ cm}$, $69\\text{ cm}$ and $138\\text{ cm}$, respectively.",
      "worked": "There are $2+3+6=11$ parts in total.\n$$\\begin{align*}\\text{Length of one part}&=253\\div11=23\\text{ cm}\\\\\\text{First length}&=2\\times23=46\\text{ cm}\\\\\\text{Second length}&=3\\times23=69\\text{ cm}\\\\\\text{Third length}&=6\\times23=138\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
