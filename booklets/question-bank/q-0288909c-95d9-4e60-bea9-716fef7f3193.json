  "content": {
    "id": "p7-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A circular wheel of radius $r$ m rolls through half of a revolution as shown below. The point $P$ is on the horizontal diameter at the start and end of its rotation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p7-q13-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 7, p7-q13-diagram\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (S) at (0,1);\n\\coordinate (F) at ({pi},1);\n\\draw[black,line width=0.8pt] (S) circle[radius=1];\n\\draw[black,line width=0.8pt] (F) circle[radius=1];\n\\draw[black,line width=0.8pt] (-1,0)--({pi+1},0);\n\\fill[black] (-1,1) circle[radius=1.2pt];\n\\fill[black] ({pi+1},1) circle[radius=1.2pt];\n\\node[left] at (-1,1) {$P$};\n\\node[right] at ({pi+1},1) {$P$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 7,
          "sourceRegion": "Top of right column, question 13",
          "description": "Two equal wheels on one horizontal surface; initial wheel on the left and final wheel on the right. The marked point is initially leftmost and finally rightmost. Decorative red fill is omitted.",
          "mathematics": "For radius r, the centre advances pi r during half a revolution. The two endpoint positions of P differ horizontally by pi r + 2r and have equal height.",
          "answerVisibility": "Only the two source P labels and point markers are visible; no distance formula or answer is shown."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p7-q13a",
        "type": "part",
        "label": "a",
        "prompt": "Find the distance between the starting and finishing point of $P$ if $r=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4+2\\pi)\\text{ m}$.",
          "worked": "The centre travels half the circumference, $\\pi r$. The final point is a further $2r$ horizontally from the initial point relative to the two centres. Thus the distance $D$ is\n$$\\begin{align*}D&=\\pi r+2r\\\\D&=2\\pi+2\\times2\\\\D&=4+2\\pi\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p7-q13b",
        "type": "part",
        "label": "b",
        "prompt": "Find $r$ if the distance between the starting and finishing point of $P$ is $10$ m.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\dfrac{10}{2+\\pi}\\text{ m}$.",
          "worked": "The endpoint distance is half the circumference plus two radii:\n$$\\begin{align*}10&=\\pi r+2r\\\\10&=(\\pi+2)r\\\\r&=\\frac{10}{\\pi+2}\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
