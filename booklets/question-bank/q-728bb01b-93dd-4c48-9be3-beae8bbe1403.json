        "prompt": "Evaluate $\\sqrt{36}\\times\\sqrt{64}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "$$\\begin{align*}\\sqrt{36}\\times\\sqrt{64} &= 6\\times8\\\\&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p37-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate $\\sqrt{36\\times64}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "$$\\begin{align*}\\sqrt{36\\times64} &= \\sqrt{2304}\\\\&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p37-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Is $\\sqrt{36}\\times\\sqrt{64}=\\sqrt{36\\times64}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, both sides equal $48$.",
          "worked": "Yes. The left-hand side is $48$ and the right-hand side is $48$, so they are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
