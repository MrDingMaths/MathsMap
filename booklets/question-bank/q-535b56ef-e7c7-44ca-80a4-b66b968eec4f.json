  "content": {
    "id": "p20-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "An irregular polygon has one exterior angle of $100^{\\circ}$ and all others are $13^{\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why the sum of all the $13^{\\circ}$ angles is $260^{\\circ}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The exterior angles sum to $360^{\\circ}$, so $360^{\\circ}-100^{\\circ}=260^{\\circ}$.",
          "worked": "The exterior angles sum to $360^{\\circ}$. Removing the $100^{\\circ}$ angle leaves $360^{\\circ}-100^{\\circ}=260^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p20-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Therefore, how many 13-degree angles are there?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 angles of $13^{\\circ}$.",
          "worked": "$$260^{\\circ}\\div13^{\\circ}=20$$\nThere are 20 angles of $13^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "How many sides are there, in total? (hint: it’s not 20)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "21 sides.",
          "worked": "There are 20 angles of $13^{\\circ}$ and one angle of $100^{\\circ}$. Thus the polygon has $20+1=21$ sides.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "To find the number of sides, we can use the equation $100+13(n-1)=360^{\\circ}$, where $n$ is the number of sides in the polygon. Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "There is one $100^{\\circ}$ exterior angle and $n-1$ exterior angles of $13^{\\circ}$; their sum is $360^{\\circ}$.",
          "worked": "An $n$-sided polygon has $n$ exterior angles. One is $100^{\\circ}$, so the remaining $n-1$ angles are each $13^{\\circ}$. Their total is $360^{\\circ}$, giving $100+13(n-1)=360$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p20-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the number of sides of the polygon using the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "21 sides.",
          "worked": "$$\\begin{align*}100+13(n-1)&=360\\\\13(n-1)&=260\\\\n-1&=20\\\\n&=21\\end{align*}$$\nThe polygon has 21 sides.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
