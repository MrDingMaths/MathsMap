    "label": "2",
    "prompt": "Evaluate the six circular functions of angle $\\theta$ for the triangle below.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p6-q2-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 6, p6-q2-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (0,1);\n\\coordinate (C) at (2,0);\n\\draw[black] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.4pt] (0,0.16)--(0.16,0.16)--(0.16,0);\n\\path (A)--(B) node[midway,left] {$1$};\n\\path (A)--(C) node[midway,below] {$2$};\n\\path (C)--(B) node[pos=0.35,below] {$\\theta$};\n\\end{tikzpicture}",
        "src": null,
