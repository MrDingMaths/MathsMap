      {
        "id": "p5-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the equation $3x+4y+5=0$ as a function with independent variable $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac34x-\\frac54$.",
          "worked": "$$\\begin{align*}4y&=-3x-5\\\\y&=\\frac{-3x-5}{4}\\\\y&=-\\frac34x-\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Write the equation $3x+4y+5=0$ as a function with independent variable $y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac43y-\\frac53$.",
          "worked": "$$\\begin{align*}3x&=-4y-5\\\\x&=\\frac{-4y-5}{3}\\\\x&=-\\frac43y-\\frac53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Write the equation $4+xy=0$ as a function with dependent variable $y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac4x$, where $x\\ne0$.",
          "worked": "$$\\begin{align*}xy&=-4\\\\y&=-\\frac4x\\end{align*}$$\nHere $x\\ne0$, since division by zero is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "The volume of a cube with side length $s$ is $V=s^3$, and its surface area is $A=6s^2$. Write each formula as a function with dependent variable $s$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=\\sqrt[3]{V}$ and $s=\\sqrt{\\frac A6}$.\n\nTake the positive square root because $s$ is a side length.",
          "worked": "$$\\begin{align*}V&=s^3\\\\s&=\\sqrt[3]{V}\\end{align*}$$\n$$\\begin{align*}A&=6s^2\\\\s^2&=\\frac A6\\\\s&=\\sqrt{\\frac A6}\\end{align*}$$\nTake the positive square root because $s$ is a side length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p5-q10-e",
        "type": "group",
        "label": "e",
        "prompt": "If a rectangle has area $100\\,\\mathrm{m}^2$ and sides $\\ell$ and $b$, then $\\ell b=100$. Write this formula as a function with:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p5-q10-e-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\ell$ as the dependent variable,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\ell=\\frac{100}{b}$, where $b>0$.",
              "worked": "$$\\begin{align*}\\ell b&=100\\\\\\ell&=\\frac{100}{b}\\end{align*}$$\nThe side lengths are positive, so $b>0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p5-q10-e-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\ell$ as the independent variable.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b=\\frac{100}{\\ell}$, where $\\ell>0$.",
              "worked": "$$\\begin{align*}\\ell b&=100\\\\b&=\\frac{100}{\\ell}\\end{align*}$$\nThe side lengths are positive, so $\\ell>0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      }
    ]
