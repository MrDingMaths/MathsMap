  "content": {
    "id": "p53-q6",
    "type": "question",
    "label": "6",
    "prompt": "Find the percentage change, to two decimal places, when:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A ticket was \\$60 but changed to \\$29.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$51.67\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Change}&=29-60=-31\\\\\\text{Percentage change}&=\\frac{-31}{60}\\times100\\%\\\\\\text{Percentage change}&\\approx-51.67\\%\\end{align*}$$\nThe price decreased by $51.67\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p53-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "A ticket of \\$60 originally cost \\$29.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$106.90\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Change}&=60-29=31\\\\\\text{Percentage change}&=\\frac{31}{29}\\times100\\%\\\\\\text{Percentage change}&\\approx106.90\\%\\end{align*}$$\nThe price increased by $106.90\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p53-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "A 12 cm tall hedge grows to 18 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50.00\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Change}&=18-12=6\\text{ cm}\\\\\\text{Percentage change}&=\\frac{6}{12}\\times100\\%=50.00\\%\\end{align*}$$\nThe height increased by $50.00\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p53-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "A hedge that got cut down to 12 cm was originally 18 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33.33\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Change}&=12-18=-6\\text{ cm}\\\\\\text{Percentage change}&=\\frac{-6}{18}\\times100\\%\\\\\\text{Percentage change}&\\approx-33.33\\%\\end{align*}$$\nThe height decreased by $33.33\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
