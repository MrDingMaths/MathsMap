  "content": {
    "id": "p54-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "It is known that $y$ is inversely proportional to $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{k}{x}$",
          "worked": "Inverse proportionality gives $y=\\dfrac{k}{x}$, for some non-zero constant $k$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p54-q2-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the value of $k$ given that:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q2-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$y=2$ when $x=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=6$",
              "worked": "$$\\begin{align*}2&=\\frac{k}{3}\\\\k&=2\\times3\\\\k&=6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p54-q2-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$y=\\dfrac{1}{2}$ when $x=-3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=-\\dfrac{3}{2}$",
              "worked": "$$\\begin{align*}\\frac12&=\\frac{k}{-3}\\\\k&=\\frac12\\times(-3)\\\\k&=-\\frac32\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p54-q2-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$y=-2$ when $x=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=-8$",
              "worked": "$$\\begin{align*}-2&=\\frac{k}{4}\\\\k&=(-2)\\times4\\\\k&=-8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      }
    ]
  },
