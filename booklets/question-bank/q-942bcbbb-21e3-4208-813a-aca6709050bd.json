  "content": {
    "id": "p7-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "One letter is chosen at random from the word ALPHABET. What is the probability that it is not a vowel?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{8}$",
      "worked": "ALPHABET has 8 letters, including 3 vowel occurrences: A, A and E.\n\n$$\\begin{align*}P(\\text{vowel})&=\\frac{3}{8}\\\\P(\\text{not a vowel})&=1-P(\\text{vowel})\\\\P(\\text{not a vowel})&=1-\\frac{3}{8}\\\\P(\\text{not a vowel})&=\\frac{5}{8}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
