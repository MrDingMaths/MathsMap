  "content": {
    "id": "p19-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider the set of numbers\n$$\\{1,2,3,4,5,6,7\\}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can you select two numbers whose product is odd?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "Both numbers must be odd. There are 4 odd numbers.\n$$\\begin{align*}N&=\\binom{4}{2}\\\\N&=6.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "How many ways can you select two numbers whose product is even? Hint: Use (a).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "Subtract the odd-product selections from all two-number selections.\n$$\\begin{align*}N&=\\binom{7}{2}-6\\\\N&=21-6\\\\N&=15.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "How many ways can you select three numbers whose product is even?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31$",
          "worked": "An odd product requires three odd numbers. Subtract these selections from all three-number selections.\n$$\\begin{align*}N&=\\binom{7}{3}-\\binom{4}{3}\\\\N&=35-4\\\\N&=31.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
