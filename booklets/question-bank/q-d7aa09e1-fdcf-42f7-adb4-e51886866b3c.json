  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Given $\\csc\\theta=\\frac32$, find the value of $\\cot\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\cot\\theta=\\pm\\frac{\\sqrt5}{2}$.",
      "worked": "$$\\begin{align*}\\cot^2\\theta&=\\csc^2\\theta-1\\\\\\cot^2\\theta&=\\left(\\frac32\\right)^2-1\\\\\\cot^2\\theta&=\\frac54\\\\\\cot\\theta&=\\pm\\frac{\\sqrt5}{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
