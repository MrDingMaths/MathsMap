      "taskHash": "4e33da4182f6de4b5f4e96db305ccc7f793f9efb91a39556ff3401f9e65c05db",
      "evidence": ".booklet-work/reasoning-ratings/calls/measurement-error-v1/563bbcaba4aa28c82786d1d9a623011937308f6ed3060fe8dbb4cb5294081861-1793244794634/last-message.txt"
    }
  },
  "content": {
    "id": "p11-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Abbey measured the mass of a dishwasher as 49.6 kg.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the limits of accuracy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$49.55\\text{ kg}$ to $49.65\\text{ kg}$",
          "worked": "$$\\begin{aligned}\\text{Precision} &=0.1\\text{ kg}\\\\\\text{Absolute error} &=\\tfrac12\\times0.1=0.05\\text{ kg}\\\\\\text{Upper bound} &=49.6+0.05=49.65\\text{ kg}\\\\\\text{Lower bound} &=49.6-0.05=49.55\\text{ kg}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the percentage error correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.10\\%$",
          "worked": "$$\\begin{aligned}\\text{Percentage error} &=\\frac{0.05}{49.6}\\times100\\%\\\\\\text{Percentage error} &\\approx0.10\\%\\quad\\text{(2 d.p.)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-root-bank-p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Another dishwasher is measured as 99.2 kg. Find its percentage error to three decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.050\\%$",
          "worked": "Precision: $0.1\\text{ kg}$.\n\n$$\\begin{aligned}\\text{Absolute error}&=\\tfrac12\\times0.1=0.05\\text{ kg}\\\\\\text{Percentage error}&=\\frac{0.05}{99.2}\\times100\\%\\\\&\\approx0.050\\%\\quad\\text{(3 d.p.)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-root-bank-p11-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "How does this percentage error compare with that for 49.6 kg? Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Before rounding, it is half as large because the absolute error remains $0.05\\text{ kg}$ while the measured mass doubles.",
          "worked": "Before rounding, the percentage error is half as large: the absolute error remains $0.05\\text{ kg}$ while the measured mass doubles.\n\n$$\\frac{0.05}{99.2}\\times100=\\tfrac12\\left(\\frac{0.05}{49.6}\\times100\\right).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
