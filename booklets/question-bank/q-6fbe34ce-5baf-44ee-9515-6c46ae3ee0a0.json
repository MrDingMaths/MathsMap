      "evidence": ".booklet-work/reasoning-ratings/calls/measurement-error-v1/4dbd8d3a0c551d1f793736152e1f8f443fbfd8daff30dc5e7b4cc862b4a6fee7-1792560664511/last-message.txt"
    }
  },
  "content": {
    "id": "p11-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Abbey measured the mass of a dishwasher as 49.6 kg.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the limits of accuracy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$49.55\\text{ kg}$ to $49.65\\text{ kg}$",
          "worked": "$$\\begin{aligned}\\text{Precision} &=0.1\\text{ kg}\\\\\\text{Absolute error} &=\\tfrac12\\times0.1=0.05\\text{ kg}\\\\\\text{Upper bound} &=49.6+0.05=49.65\\text{ kg}\\\\\\text{Lower bound} &=49.6-0.05=49.55\\text{ kg}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the percentage error correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.10\\%$",
          "worked": "$$\\begin{aligned}\\text{Percentage error} &=\\frac{0.05}{49.6}\\times100\\%\\\\\\text{Percentage error} &\\approx0.10\\%\\quad\\text{(2 d.p.)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
