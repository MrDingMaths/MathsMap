  "content": {
    "id": "v2-d6987117-p36-topic-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "A farmer buys a tractor for \\$48 000. The value of the tractor depreciates by 20% in the first year and 10% in each of the next two years. Work out the value of the tractor at the end of 3 years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$31 104",
      "worked": "The multipliers are $0.8$ for the first year and $0.9$ for each following year.\n$$\\begin{align*}\\text{Value after 3 years}&=\\$48\\,000\\times0.8\\times0.9\\times0.9\\\\&=\\$48\\,000\\times0.648\\\\&=\\$31\\,104\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
