    "difficultyReason": "Calculate both moving clock-hand positions and select the smaller separation across the full turn."
  },
  "content": {
    "id": "p74-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Determine the angle between the hour hand and minute hand of a clock at",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p74-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "10:10 am",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$115^\\circ$",
          "worked": "Clockwise from 12, the hour hand moves $30^\\circ$ per hour and $0.5^\\circ$ per minute; the minute hand moves $6^\\circ$ per minute.\n$$\\begin{align*}\\text{Hour-hand angle} &= 10\\times30^\\circ+10\\times0.5^\\circ\\\\\\text{Hour-hand angle} &= 305^\\circ\\\\\\text{Minute-hand angle} &= 10\\times6^\\circ\\\\\\text{Minute-hand angle} &= 60^\\circ\\\\\\text{Separation} &= 305^\\circ-60^\\circ\\\\\\text{Separation} &= 245^\\circ\\\\\\text{Smaller angle} &= 360^\\circ-245^\\circ\\\\\\text{Smaller angle} &= 115^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p74-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "4:45 am",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$127.5^\\circ$",
          "worked": "Measure both hand positions clockwise from 12.\n$$\\begin{align*}\\text{Hour-hand angle} &= 4\\times30^\\circ+45\\times0.5^\\circ\\\\\\text{Hour-hand angle} &= 142.5^\\circ\\\\\\text{Minute-hand angle} &= 45\\times6^\\circ\\\\\\text{Minute-hand angle} &= 270^\\circ\\\\\\text{Smaller angle} &= 270^\\circ-142.5^\\circ\\\\\\text{Smaller angle} &= 127.5^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p74-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "7:15 am",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$127.5^\\circ$",
          "worked": "Measure both hand positions clockwise from 12.\n$$\\begin{align*}\\text{Hour-hand angle} &= 7\\times30^\\circ+15\\times0.5^\\circ\\\\\\text{Hour-hand angle} &= 217.5^\\circ\\\\\\text{Minute-hand angle} &= 15\\times6^\\circ\\\\\\text{Minute-hand angle} &= 90^\\circ\\\\\\text{Smaller angle} &= 217.5^\\circ-90^\\circ\\\\\\text{Smaller angle} &= 127.5^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p74-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "2:35 p.m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$132.5^\\circ$",
          "worked": "Measure both hand positions clockwise from 12.\n$$\\begin{align*}\\text{Hour-hand angle} &= 2\\times30^\\circ+35\\times0.5^\\circ\\\\\\text{Hour-hand angle} &= 77.5^\\circ\\\\\\text{Minute-hand angle} &= 35\\times6^\\circ\\\\\\text{Minute-hand angle} &= 210^\\circ\\\\\\text{Smaller angle} &= 210^\\circ-77.5^\\circ\\\\\\text{Smaller angle} &= 132.5^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
