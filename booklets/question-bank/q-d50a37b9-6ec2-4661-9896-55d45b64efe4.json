    "label": "13",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q13-response",
        "type": "part",
        "label": "a",
        "prompt": "Solve $\\log_8 x+\\log_4 x=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2^6=64$",
          "worked": "For $x>0$:\n$$\\begin{align*}\\frac{\\log_2 x}{\\log_2 8}+\\frac{\\log_2 x}{\\log_2 4}&=5\\\\\\frac{\\log_2 x}{3}+\\frac{\\log_2 x}{2}&=5\\\\\\frac{5\\log_2 x}{6}&=5\\\\\\log_2 x&=6\\\\x&=2^6\\\\x&=64.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p25-q13-response-bank-p25-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve $\\log_8 x+\\log_4 x=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4096$",
          "worked": "For $x>0$:\n$$\\begin{align*}\\frac{\\log_2 x}{3}+\\frac{\\log_2 x}{2} &= 10 \\\\ \\frac{5\\log_2 x}{6} &= 10 \\\\ \\log_2 x &= 12 \\\\ x &= 2^{12}=4096\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p25-q13-response-bank-p25-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why the solution in part b is the square of the solution in part a.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Doubling the right side doubles $\\log_2 x$ from $6$ to $12$, so $2^{12}=(2^6)^2=64^2$.",
          "worked": "The left side equals $\\frac56\\log_2 x$. Doubling the right side from $5$ to $10$ doubles $\\log_2 x$ from $6$ to $12$. Therefore the new solution is $2^{12}=(2^6)^2=64^2=4096$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
