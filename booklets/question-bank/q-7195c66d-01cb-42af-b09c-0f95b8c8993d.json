    "label": "10",
    "prompt": "If $ax+b=c$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Solve the equation for $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{c-b}{a}$",
          "worked": "$$\\begin{align*}ax+b&=c\\\\ax&=c-b\\\\x&=\\frac{c-b}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "Use the formula you found in part a to solve for $x$:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q10-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$2x+1=5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=2$",
              "worked": "$$\\begin{align*}x&=\\frac{5-1}{2}\\\\x&=\\frac{4}{2}\\\\x&=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p8-q10-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$3x-5=7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=4$",
              "worked": "$$\\begin{align*}x&=\\frac{7-(-5)}{3}\\\\x&=\\frac{12}{3}\\\\x&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p8-q10-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$-3x-1=5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-2$",
              "worked": "$$\\begin{align*}x&=\\frac{5-(-1)}{-3}\\\\x&=\\frac{6}{-3}\\\\x&=-2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p8-q10-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$\\dfrac{x}{2}+1=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=4$",
              "worked": "$a=\\frac12$, $b=1$, $c=3$.\n\n$$\\begin{align*}x&=\\frac{3-1}{1/2}\\\\x&=2\\times2\\\\x&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p8-q10-b-v",
            "type": "part",
            "label": "v",
            "prompt": "$\\dfrac{x}{3}-2=-3$",
