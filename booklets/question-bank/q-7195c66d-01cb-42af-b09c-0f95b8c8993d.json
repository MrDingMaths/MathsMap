              "short": "$x=-3$",
              "worked": "$a=\\frac13$, $b=-2$, $c=-3$.\n\n$$\\begin{align*}x&=\\frac{-3-(-2)}{1/3}\\\\x&=-1\\times3\\\\x&=-3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p8-q10-b-vi",
            "type": "part",
            "label": "vi",
            "prompt": "$\\dfrac{x}{5}-\\dfrac12=2$",
