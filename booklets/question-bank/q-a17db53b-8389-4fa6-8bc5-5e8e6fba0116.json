  "content": {
    "id": "p31-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The total amount of prize money in a photography competition is $\\$19\\,600$. Given that the prize money is divided among the first, second and third prizes in the ratio $7:5:2$, find the amount each prize winner receives.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "First: $\\$9800$; second: $\\$7000$; third: $\\$2800$.",
      "worked": "There are $7+5+2=14$ parts in total.\n$$\\begin{align*}\\text{Value of one part}&=\\$19\\,600\\div14\\\\\\text{Value of one part}&=\\$1400\\\\\\text{First prize}&=7\\times\\$1400=\\$9800\\\\\\text{Second prize}&=5\\times\\$1400=\\$7000\\\\\\text{Third prize}&=2\\times\\$1400=\\$2800\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
