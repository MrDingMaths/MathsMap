      {
        "id": "p28-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the compound interest on $\\$1000$ at $12\\%$ p.a. for 100 years. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$83\\,521\\,265.73$",
          "worked": "$$\\begin{align*}A_n&=P(1+R)^n\\\\A_{100}&=1000(1.12)^{100}\\\\I&=A_{100}-P\\\\I&=1000(1.12)^{100}-1000\\\\I&\\approx\\$83\\,521\\,265.73\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p28-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the compound interest on $\\$1000$ at $1\\%$ per month for 100 years. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$153\\,336\\,556.81$",
          "worked": "The rate is $0.01$ per month, so use monthly periods.\n\n$$\\begin{align*}n&=100\\times12\\\\n&=1200\\\\A_n&=P(1+R)^n\\\\A_{1200}&=1000(1.01)^{1200}\\\\I&=A_{1200}-P\\\\I&=1000(1.01)^{1200}-1000\\\\I&\\approx\\$153\\,336\\,556.81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p28-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the simple interest on $\\$1000$ at $12\\%$ p.a. for 100 years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$12\\,000$",
          "worked": "$$\\begin{align*}I&=PRT\\\\I&=1000\\times0.12\\times100\\\\I&=\\$12\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
