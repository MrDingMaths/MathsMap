  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "If $f(x)=\\log_e\\left(\\dfrac{1+\\sin x}{\\cos x}\\right)$, show that $f'(x)=\\sec x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(x)=\\sec x$.",
      "worked": "$$\\begin{align*}f(x)&=\\ln|1+\\sin x|-\\ln|\\cos x|\\\\f'(x)&=\\frac{\\cos x}{1+\\sin x}-\\frac{-\\sin x}{\\cos x}\\\\&=\\frac{\\cos x}{1+\\sin x}+\\frac{\\sin x}{\\cos x}\\\\&=\\frac{\\cos^2x+\\sin x(1+\\sin x)}{\\cos x(1+\\sin x)}\\\\&=\\frac{\\cos^2x+\\sin x+\\sin^2x}{\\cos x(1+\\sin x)}\\\\&=\\frac{1+\\sin x}{\\cos x(1+\\sin x)}\\\\&=\\frac{1}{\\cos x}\\\\&=\\sec x\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 63
  },
