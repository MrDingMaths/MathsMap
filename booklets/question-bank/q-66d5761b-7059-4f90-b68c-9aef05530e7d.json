        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125=5^3$; $\\sqrt[3]{125}=5$.",
          "worked": "$$\\begin{align*}125&=5^3\\\\\\sqrt[3]{125}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p74-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$216$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$216=2^3\\times3^3$; $\\sqrt[3]{216}=6$.",
          "worked": "$$\\begin{align*}216&=2^3\\times3^3\\\\\\sqrt[3]{216}&=2\\times3\\\\\\sqrt[3]{216}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p74-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$1728$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1728=2^6\\times3^3$; $\\sqrt[3]{1728}=12$.",
          "worked": "$$\\begin{align*}1728&=2^6\\times3^3\\\\\\sqrt[3]{1728}&=2^2\\times3\\\\\\sqrt[3]{1728}&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p74-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$3375$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3375=3^3\\times5^3$; $\\sqrt[3]{3375}=15$.",
          "worked": "$$\\begin{align*}3375&=3^3\\times5^3\\\\\\sqrt[3]{3375}&=3\\times5\\\\\\sqrt[3]{3375}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
