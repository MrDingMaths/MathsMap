            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\varnothing$, $\\{a\\}$, $\\{b\\}$, $\\{c\\}$, $\\{a,b\\}$, $\\{a,c\\}$, $\\{b,c\\}$, $\\{a,b,c\\}$.",
              "worked": "List subsets by their number of elements:\n\n0 elements: $\\varnothing$.\n\n1 element: $\\{a\\}$, $\\{b\\}$, $\\{c\\}$.\n\n2 elements: $\\{a,b\\}$, $\\{a,c\\}$, $\\{b,c\\}$.\n\n3 elements: $\\{a,b,c\\}$.\n\nThere are $1+3+3+1=8$ subsets.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
