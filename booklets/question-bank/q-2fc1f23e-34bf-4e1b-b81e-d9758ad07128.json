  "content": {
    "id": "percentage-error-precision-variation-root",
    "type": "question",
    "label": "5",
    "prompt": "Calculate the percentage error for each measurement. Give your answers to three decimal places.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "percentage-error-precision-variation-a",
        "type": "part",
        "label": "a",
        "prompt": "24 m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.083\\%$",
          "worked": "Precision: $1\\text{ m}$.\n\n$$\\begin{aligned}\\text{Absolute error}&=\\tfrac12\\times1=0.5\\text{ m}\\\\\\text{Percentage error}&=\\frac{0.5}{24}\\times100\\%\\\\&\\approx2.083\\%\\quad\\text{(3 d.p.)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "percentage-error-precision-variation-b",
        "type": "part",
        "label": "b",
        "prompt": "24.0 m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.208\\%$",
          "worked": "Precision: $0.1\\text{ m}$.\n\n$$\\begin{aligned}\\text{Absolute error}&=\\tfrac12\\times0.1=0.05\\text{ m}\\\\\\text{Percentage error}&=\\frac{0.05}{24.0}\\times100\\%\\\\&\\approx0.208\\%\\quad\\text{(3 d.p.)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "percentage-error-precision-variation-c",
        "type": "part",
        "label": "c",
        "prompt": "24.00 m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.021\\%$",
          "worked": "Precision: $0.01\\text{ m}$.\n\n$$\\begin{aligned}\\text{Absolute error}&=\\tfrac12\\times0.01=0.005\\text{ m}\\\\\\text{Percentage error}&=\\frac{0.005}{24.00}\\times100\\%\\\\&\\approx0.021\\%\\quad\\text{(3 d.p.)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
