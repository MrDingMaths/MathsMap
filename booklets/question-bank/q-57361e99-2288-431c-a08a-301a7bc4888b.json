  "content": {
    "id": "p12-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the equation of the transformation of $y=\\sin x$ if the transformed function has:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "amplitude $9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=9\\sin x$",
          "worked": "A vertical dilation by factor $9$ gives $y=9\\sin x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "reflection across the $x$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\sin x$",
          "worked": "Reflection across the $x$-axis multiplies every $y$-value by $-1$: $y=-\\sin x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "mean position $-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sin x-4$",
          "worked": "Translate $y=\\sin x$ down $4$ units: $y=\\sin x-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "period $\\pi$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sin(2x)$",
          "worked": "For $y=\\sin(ax)$ with $a>0$:\n$$\\begin{aligned}\\frac{2\\pi}{a}&=\\pi\\\\a&=2\\end{aligned}$$\nHence $y=\\sin(2x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "a phase shift of $\\pi$ units to the right",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sin(x-\\pi)$",
          "worked": "A shift right by $\\pi$ replaces $x$ with $x-\\pi$: $y=\\sin(x-\\pi)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
