  "content": {
    "id": "p11-q7-root",
    "type": "question",
    "label": "",
    "prompt": "The radius of the base of a cylinder is increasing at a rate of 6 cm/min.\nThe height of the cylinder is fixed at 20 cm.\nFind the rate of change of the volume of the cylinder at the instant when the radius is 15 cm.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3600\\pi\\text{ cm}^3/\\text{min}$",
      "worked": "$$V=\\pi r^2h=20\\pi r^2,\\qquad \\frac{dr}{dt}=6\\text{ cm/min}.$$\n$$\\begin{align*}\\frac{dV}{dt}&=\\frac{dV}{dr}\\times\\frac{dr}{dt}\\\\\\frac{dV}{dt}&=40\\pi r(6)\\\\\\frac{dV}{dt}&=240\\pi r.\\end{align*}$$\nWhen $r=15$,\n$$\\begin{align*}\\frac{dV}{dt}&=240\\pi(15)\\\\\\frac{dV}{dt}&=3600\\pi\\text{ cm}^3/\\text{min}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
