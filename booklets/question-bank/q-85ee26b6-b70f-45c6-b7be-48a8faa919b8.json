  "content": {
    "id": "p18-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the number of sides of a polygon given that the sum of its interior angles is $1440^{\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "10 sides",
      "worked": "For an $n$-sided polygon, the interior-angle sum is $(n-2)\\times180^{\\circ}$.\n$$\\begin{align*}(n-2)\\times180^{\\circ}&=1440^{\\circ}\\\\n-2&=8\\\\n&=10\\end{align*}$$\nThe polygon has 10 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
