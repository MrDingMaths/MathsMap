  "content": {
    "id": "p5-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The enrolment of a school increased from 680 to 740. Calculate the percentage increase, correct to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8.82\\%$",
      "worked": "$$\\begin{align*}\\text{Increase}&=740-680\\\\\\text{Increase}&=60\\\\\\text{Percentage increase}&=\\frac{60}{680}\\times100\\%\\\\\\text{Percentage increase}&\\approx8.82\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
