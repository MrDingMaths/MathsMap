        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 12 question 5 triangular dot diagram\"}\n\\begin{tikzpicture}[x=6mm,y=6mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-0.3,-0.3) rectangle (6.3,6.3);\n\\foreach \\y/\\last in {0/0,2/2,4/4,6/6}{\\foreach \\x in {0,...,\\last}{\\fill[black] (\\x,\\y) circle[radius=1.1mm];}}\n\\foreach \\y/\\last in {1/1,3/3,5/5}{\\foreach \\x in {0,...,\\last}{\\draw[black,line width=0.8pt,fill=white] (\\x,\\y) circle[radius=1.1mm];}}\n\\end{tikzpicture}",
