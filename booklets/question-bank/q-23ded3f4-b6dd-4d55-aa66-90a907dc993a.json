  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "If $\\alpha$ and $\\beta$ are the zeroes of $2x^2+5x-4=0$, find:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac52$",
          "worked": "$$\\begin{aligned}\\alpha+\\beta&=-\\frac ba\\\\\\alpha+\\beta&=-\\frac52\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{aligned}\\alpha\\beta&=\\frac ca\\\\\\alpha\\beta&=\\frac{-4}{2}\\\\\\alpha\\beta&=-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha^2+\\beta^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{41}{4}$",
          "worked": "$$\\begin{aligned}\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\\\alpha^2+\\beta^2&=\\left(-\\frac52\\right)^2-2(-2)\\\\\\alpha^2+\\beta^2&=\\frac{25}{4}+4\\\\\\alpha^2+\\beta^2&=\\frac{41}{4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$|\\alpha-\\beta|$\n\n(hint: square it)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{57}}2$",
          "worked": "$$\\begin{aligned}(\\alpha-\\beta)^2&=(\\alpha+\\beta)^2-4\\alpha\\beta\\\\(\\alpha-\\beta)^2&=\\left(-\\frac52\\right)^2-4(-2)\\\\(\\alpha-\\beta)^2&=\\frac{57}{4}\\\\|\\alpha-\\beta|&=\\frac{\\sqrt{57}}2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
