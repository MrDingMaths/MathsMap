  "content": {
    "id": "p61-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The temperature in New York on a dreary winter day was falling at a steady rate of $2^\\circ\\mathrm{C}$ per hour after 5 p.m. If the temperature at 8 p.m. was $-8^\\circ\\mathrm{C}$, find the temperature at:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p61-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "10 p.m.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12^\\circ\\mathrm{C}$",
          "worked": "10 p.m. is 2 hours later, so subtract the temperature fall.\n$$\\begin{align*}2\\times2&=4\\\\-8-4&=-12\\end{align*}$$\nThe temperature is $-12^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
