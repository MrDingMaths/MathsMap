    "children": [
      {
        "id": "p16-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$2+\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+4\\sqrt{3}$ square units",
          "worked": "Using $A=s^2$:\n\n$$\\begin{align*}A&=(2+\\sqrt{3})^2\\\\A&=2^2+2(2)(\\sqrt{3})+(\\sqrt{3})^2\\\\A&=4+4\\sqrt{3}+3\\\\A&=7+4\\sqrt{3}\\end{align*}$$\n\nThe area is $7+4\\sqrt{3}$ square units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$2-\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7-4\\sqrt{3}$ square units",
          "worked": "Using $A=s^2$:\n\n$$\\begin{align*}A&=(2-\\sqrt{3})^2\\\\A&=2^2-2(2)(\\sqrt{3})+(\\sqrt{3})^2\\\\A&=4-4\\sqrt{3}+3\\\\A&=7-4\\sqrt{3}\\end{align*}$$\n\nThe area is $7-4\\sqrt{3}$ square units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$5+2\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$37+20\\sqrt{3}$ square units",
          "worked": "Using $A=s^2$:\n\n$$\\begin{align*}A&=(5+2\\sqrt{3})^2\\\\A&=5^2+2(5)(2\\sqrt{3})+(2\\sqrt{3})^2\\\\A&=25+20\\sqrt{3}+12\\\\A&=37+20\\sqrt{3}\\end{align*}$$\n\nThe area is $37+20\\sqrt{3}$ square units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
