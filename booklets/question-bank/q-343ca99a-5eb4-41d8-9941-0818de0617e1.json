    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove that $\\csc\\theta+\\cot\\theta=\\cot\\frac{\\theta}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\csc\\theta+\\cot\\theta=\\dfrac{1+\\cos\\theta}{\\sin\\theta}=\\cot\\frac{\\theta}{2}$.\n\nUse the double-angle formulas for the numerator and denominator.",
          "worked": "$$\\begin{align*}\\csc\\theta+\\cot\\theta&=\\frac{1}{\\sin\\theta}+\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\csc\\theta+\\cot\\theta&=\\frac{1+\\cos\\theta}{\\sin\\theta}\\\\\\csc\\theta+\\cot\\theta&=\\frac{2\\cos^2\\frac{\\theta}{2}}{2\\sin\\frac{\\theta}{2}\\cos\\frac{\\theta}{2}}\\\\\\csc\\theta+\\cot\\theta&=\\frac{\\cos\\frac{\\theta}{2}}{\\sin\\frac{\\theta}{2}}\\\\\\csc\\theta+\\cot\\theta&=\\cot\\frac{\\theta}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p7-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, evaluate $\\cot\\frac{\\pi}{8}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\sqrt{2}$",
          "worked": "Use part (a) with $\\theta=\\frac{\\pi}{4}$.\n\n$$\\begin{align*}\\cot\\frac{\\pi}{8}&=\\csc\\frac{\\pi}{4}+\\cot\\frac{\\pi}{4}\\\\\\cot\\frac{\\pi}{8}&=\\frac{1}{\\frac{\\sqrt{2}}{2}}+1\\\\\\cot\\frac{\\pi}{8}&=\\sqrt{2}+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
