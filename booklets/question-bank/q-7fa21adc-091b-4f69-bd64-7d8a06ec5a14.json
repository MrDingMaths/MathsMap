        "answer": {
          "short": "$8.64\\times10^{10}\\text{ microseconds}$",
          "worked": "$$\\begin{aligned}1\\text{ day}&=24\\times60\\times60=86400\\text{ s}\\\\&=86400\\times10^6\\text{ microseconds}\\\\&=8.64\\times10^{10}\\text{ microseconds}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "One week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.048\\times10^{11}\\text{ microseconds}$",
          "worked": "$$\\begin{aligned}1\\text{ week}&=7\\times86400=604800\\text{ s}\\\\&=604800\\times10^6\\text{ microseconds}\\\\&=6.048\\times10^{11}\\text{ microseconds}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
