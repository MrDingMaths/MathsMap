    "type": "question",
    "label": "7",
    "prompt": "The temperature in Ballarat on a very cold winter’s day went from $-3^\\circ\\mathrm{C}$ to $7^\\circ\\mathrm{C}$. What was the rise in temperature?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10^\\circ\\mathrm{C}$ rise.",
      "worked": "$$\\begin{align*}\\text{Rise in temperature}&=7-(-3)\\\\\\text{Rise in temperature}&=7+3\\\\\\text{Rise in temperature}&=10^\\circ\\mathrm{C}.\\end{align*}$$",
