  "content": {
    "id": "p7-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "Both the numerator and denominator of $\\frac{2}{3}$ are increased by the same amount, giving a result of $\\frac{5}{7}$. Find the increase.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{2}$",
      "worked": "Let $x$ be the increase.\n$$\\begin{align*}\\frac{2+x}{3+x}&=\\frac{5}{7}\\\\7(2+x)&=5(3+x)\\\\14+7x&=15+5x\\\\2x&=1\\\\x&=\\frac{1}{2}\\end{align*}$$\nThe increase is $\\frac{1}{2}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
