  "content": {
    "id": "p28-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A student borrows $\\$20\\,000$ from a bank for six years. Compound interest at $9\\%$ p.a. must be paid. Give monetary answers to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How much money is owed to the bank at the end of the six-year period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$33\\,542.00$",
          "worked": "$$\\begin{align*}A_6&=P(1+R)^6\\\\A_6&=20\\,000(1+0.09)^6\\\\A_6&\\approx\\$33\\,542.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How much of this amount is interest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$13\\,542.00$",
          "worked": "$$\\begin{align*}I&=A_6-P\\\\I&=20\\,000(1.09)^6-20\\,000\\\\I&\\approx\\$13\\,542.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
