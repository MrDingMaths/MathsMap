  "content": {
    "id": "p17-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Consider the expansion $\\left(x^2+\\frac1x\\right)^9$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that each term in the expansion of $\\left(x^2+\\frac1x\\right)^9$ can be written as $\\binom9j x^{18-3j}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom9j(x^2)^{9-j}(x^{-1})^j=\\binom9j x^{18-3j}$.",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\binom9j(x^2)^{9-j}(x^{-1})^j\\\\&=\\binom9j x^{18-2j}x^{-j}\\\\&=\\binom9j x^{18-3j}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the coefficient of $x^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$126$",
          "worked": "For $x^3$:\n$$\\begin{aligned}18-3j&=3\\\\j&=5.\\end{aligned}$$\nCoefficient: $\\binom95=126$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p17-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the coefficient of $x^{-3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "For $x^{-3}$:\n$$\\begin{aligned}18-3j&=-3\\\\j&=7.\\end{aligned}$$\nCoefficient: $\\binom97=36$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p17-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the term independent of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84$",
          "worked": "For $x^0$:\n$$\\begin{aligned}18-3j&=0\\\\j&=6.\\end{aligned}$$\nThe term independent of $x$ is $\\binom96=84$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p17-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "Is there a term containing $x^4$ in this expansion? Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. $18-3j=4$ gives $j=\\frac{14}{3}$, which is not an integer.",
          "worked": "The general term is $\\binom9j x^{18-3j}$, where $j$ is an integer from $0$ to $9$.\n$$\\begin{aligned}18-3j&=4\\\\j&=\\frac{14}{3}\\end{aligned}$$\nThis index is not an integer, so no term containing $x^4$ occurs.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
