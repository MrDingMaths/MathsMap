  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "How many circular arrangements of the word **SYLOW** are there if the S and L are together?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3!\\times2!=12$",
      "worked": "Treat S and L as one block. The block and the other three letters form four circular entities. There are $2!$ orders within the block.\n$$\\begin{align*}N&=(4-1)!\\times2!\\\\N&=3!\\times2!\\\\N&=12\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
