  "content": {
    "id": "v2-72eaf-p23-practice-slot-13-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Solve $\\cos 2\\theta=-\\frac12$ for $0^\\circ\\le\\theta<360^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\theta=60^\\circ,\\ 120^\\circ,\\ 240^\\circ,\\ 300^\\circ$",
      "worked": "Let $u=2\\theta$.\n$$\\begin{aligned}0^\\circ&\\le 2\\theta<720^\\circ\\\\0^\\circ&\\le u<720^\\circ\\end{aligned}$$\n$$\\cos u=-\\frac12$$\nThe reference angle is $60^\\circ$. Cosine is negative in quadrants II and III.\n$$\\begin{aligned}u&=120^\\circ,\\ 240^\\circ,\\ 480^\\circ,\\ 600^\\circ\\\\2\\theta&=120^\\circ,\\ 240^\\circ,\\ 480^\\circ,\\ 600^\\circ\\\\\\theta&=60^\\circ,\\ 120^\\circ,\\ 240^\\circ,\\ 300^\\circ\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
