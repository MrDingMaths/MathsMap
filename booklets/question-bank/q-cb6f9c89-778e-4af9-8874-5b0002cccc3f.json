            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "After losing the first round, Bob must win both remaining rounds: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "0.1\\times0.7",
                "display": false
              },
