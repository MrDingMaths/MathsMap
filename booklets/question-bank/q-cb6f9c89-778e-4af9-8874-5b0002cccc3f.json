          "inlines": [
            {
              "type": "text",
              "text": "Bob and Mary play a game against each other, where the first to win two rounds wins the overall match.",
              "marks": []
            }
          ]
        },
        {
          "id": "p33-q20-probabilities",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "They both start with an equal chance of winning. If Bob wins a round, he has a 70% chance of winning the next round. If Mary wins a round, she has a 90% chance of winning the next round.",
              "marks": []
            }
          ]
        },
        {
          "id": "p33-q20-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "What is the probability that Bob wins the match, given that he lost the first round.",
              "marks": []
            }
          ]
        }
      ]
    },
