  "content": {
    "id": "p10-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "How many ways can you arrange the digits in the number $12\\,345$ so that the resulting five-digit number is even?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$48$",
      "worked": "The final digit must be $2$ or $4$, giving $2$ choices. Arrange the remaining four digits in $4!$ ways.\n$$\\begin{align*}\\text{Number of arrangements}&=2\\times4!\\\\\\text{Number of arrangements}&=48\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
