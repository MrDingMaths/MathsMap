      {
        "id": "p74-q7a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the mean, median and mode of this data.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p74-q7a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Mean: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "95\\text{ mm}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": "; median: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "111.5\\text{ mm}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": "; mode: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "112\\text{ mm}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\text{Mean}&=\\frac{112+111+110+13+112+112}{6}\\text{ mm}\\\\\\text{Mean}&=\\frac{570}{6}\\text{ mm}\\\\\\text{Mean}&=95\\text{ mm}\\end{align*}$$\nIn order: $13,\\;110,\\;111,\\;112,\\;112,\\;112\\text{ mm}$.\n$$\\begin{align*}\\text{Median}&=\\frac{111+112}{2}\\text{ mm}\\\\\\text{Median}&=111.5\\text{ mm}\\end{align*}$$\nThe mode is $112\\text{ mm}$ because it occurs three times.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p74-q7b",
        "type": "part",
        "label": "b",
        "prompt": "Identify the outlier in this set of data.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
