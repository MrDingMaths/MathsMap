  },
  "content": {
    "id": "p6-q8-11-root",
    "type": "question",
    "label": "8",
    "prompt": "True or False? Consider a function $f$ on $[a,b]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q8-11-a",
        "type": "part",
        "label": "a",
        "prompt": "The average rate of change is $\\dfrac{f(b)-f(a)}{b-a}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The average rate of change over $[a,b]$ is $\\dfrac{f(b)-f(a)}{b-a}$, where $a\\ne b$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-11-b",
        "type": "part",
        "label": "b",
        "prompt": "The average rate of change and the instantaneous rate of change always have the same value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. The average rate is a secant gradient; the instantaneous rate is a tangent gradient. They need not be equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-11-c",
        "type": "part",
        "label": "c",
        "prompt": "If the average rate of change is positive, then the graph must always be rising in this interval.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. A positive average rate means $f(b)>f(a)$, but the graph could fall during part of the interval before rising.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q8-11-d",
        "type": "part",
        "label": "d",
        "prompt": "If the instantaneous rate of change is zero at every point in an interval, then the average rate of change over that interval is also zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The graph is horizontal throughout the interval, so $f(b)=f(a)$ and $\\dfrac{f(b)-f(a)}{b-a}=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
