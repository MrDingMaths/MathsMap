              "type": "text",
              "text": "Determine whether you can use the index law of multiplication to simplify these expressions.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "If so, write the simplified form.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$5^4\\times5^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $5^7$.",
          "worked": "Yes: the factors have the same base.\n$$\\begin{align*}5^4\\times5^3&=5^{4+3}\\\\&=5^7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p58-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^4+5^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No: the powers are being added. The multiplication law applies to a product of powers with the same base.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p58-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$5^4\\times6^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No: the bases, $5$ and $6$, are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p58-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$2^7\\times2^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $2^5$.",
          "worked": "Yes: the factors have the same base.\n$$\\begin{align*}2^7\\times2^{-2}&=2^{7+(-2)}\\\\&=2^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p58-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$3^5\\times3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $3^6$.",
          "worked": "Yes: $3=3^1$, so the factors have the same base.\n$$\\begin{align*}3^5\\times3&=3^5\\times3^1\\\\&=3^{5+1}\\\\&=3^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p58-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$8^2+8^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No: the powers are being added. The multiplication law applies to a product of powers with the same base.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p58-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$6^{-3}\\times6^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $6^{-1}$.",
          "worked": "Yes: the factors have the same base.\n$$\\begin{align*}6^{-3}\\times6^2&=6^{-3+2}\\\\&=6^{-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p58-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$4^{1.5}\\times4^{0.5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $4^2$.",
          "worked": "Yes: the factors have the same base.\n$$\\begin{align*}4^{1.5}\\times4^{0.5}&=4^{1.5+0.5}\\\\&=4^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
