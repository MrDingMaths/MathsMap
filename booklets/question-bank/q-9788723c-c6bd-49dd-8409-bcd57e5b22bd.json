    "type": "question",
    "label": "8",
    "prompt": "Sam wants to make five banana pancakes. He has a recipe for 20 pancakes, and the recipe requires two-thirds of a cup of milk. How much milk is needed for 5 pancakes?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{6}$ cup of milk.",
      "worked": "20 pancakes require $\\frac{2}{3}$ cup of milk.\n\n$$\\begin{align*}\\text{Milk for 1 pancake}&=\\frac{2}{3}\\div20\\\\\\text{Milk for 1 pancake}&=\\frac{1}{30}\\text{ cup}\\\\\\text{Milk for 5 pancakes}&=\\frac{1}{30}\\times5\\\\\\text{Milk for 5 pancakes}&=\\frac{1}{6}\\text{ cup}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
