    "children": [
      {
        "id": "p26-p6-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch a relative frequency histogram for these data. Use one unit of width for each labelled outcome group.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "From left to right, the four touching bars have heights $0.15$, $0.25$, $0.40$ and $0.20$.",
          "worked": "Put the groups 1–2, 3–4, 5–6 and 7–8 in order on the horizontal axis. Draw four adjoining bars of width $1$. Read each bar height from the corresponding relative frequency in the table.",
          "solutionDiagrams": [
            {
              "id": "p26-p6-a-solution-histogram",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"barFill\",\"hex\":\"D4E8FF\",\"reason\":\"identifies the four relative-frequency bars\"}],\"reference\":\"answer PDF p91 p26-p6-a-solution-histogram\"}\n\\begin{tikzpicture}[x=16mm,y=4.4mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{barFill}{HTML}{D4E8FF}\n\\foreach \\leftedge/\\rightedge/\\height in {0/1/3,1/2/5,2/3/8,3/4/4} {\n  \\fill[barFill] (\\leftedge,0) rectangle (\\rightedge,\\height);\n}\n\\draw[black,line width=0.8pt] (0,3)--(1,3)--(1,5)--(2,5)--(2,8)--(3,8)--(3,4)--(4,4)--(4,0);\n\\draw[black,line width=0.8pt] (1,0)--(1,3) (2,0)--(2,5) (3,0)--(3,4);\n\\draw[black,line width=0.5pt] (0,9.55)--(0,0)--(4.12,0);\n\\foreach \\j/\\labeltext in {0/0,2/0.10,4/0.20,6/0.30,8/0.40} {\n  \\draw[black,line width=0.4pt] (0,\\j)--++(-1mm,0);\n  \\node[anchor=east,inner sep=1pt] at ([xshift=-1mm]0,\\j) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\labeltext$\\special{dvisvgm:raw </g>}};\n}\n\\foreach \\i/\\labeltext in {0.5/{1\\text{–}2},1.5/{3\\text{–}4},2.5/{5\\text{–}6},3.5/{7\\text{–}8}} {\n  \\draw[black,line width=0.4pt] (\\i,0)--++(0,-1mm);\n  \\node[anchor=north,inner sep=1pt] at ([yshift=-1mm]\\i,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\labeltext$\\special{dvisvgm:raw </g>}};\n}\n\\node[anchor=north] at ([yshift=-7mm]2,0) {Outcome group};\n\\node[rotate=90] at ([xshift=-22mm]0,4.5) {Relative frequency};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 83,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 91,
                "sourceRegion": "Answer book, printed page 385, Exercise 10F P6(a), lower left",
                "description": "Four adjoining unit-width bars with centred outcome-group labels, scaled relative-frequency ticks and labelled axes.",
                "mathematics": "The groups 1–2, 3–4, 5–6 and 7–8 have heights 0.15, 0.25, 0.40 and 0.20. The vertical scale runs from 0 to 0.45 in increments of 0.05.",
                "answerVisibility": "Solutions only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-p6-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the area of each rectangle to determine the total area under the histogram.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\text{Total area} &= 1(0.15)+1(0.25)+1(0.40)+1(0.20)\\\\\\text{Total area} &= 0.15+0.25+0.40+0.20\\\\\\text{Total area} &= 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-p6-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain what this total represents in terms of probability.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The total represents probability $1$ because the groups include all possible outcomes.",
          "worked": "Each rectangle represents the observed proportion of rolls in its group. Every roll belongs to exactly one group, so the proportions sum to $1$. This corresponds to the probability of rolling any of the eight possible values, which is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-p6-d",
        "type": "part",
        "label": "d",
        "prompt": "Suppose each bar is made half as wide while its area still represents the same relative frequency. What happens to the bar heights and the total area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The bar heights double and the total area stays at $1$.",
          "worked": "For a bar representing relative frequency $r$, the new width is $\\tfrac12$.\n\n$$\\begin{align*}\\text{New height} &= r\\div\\tfrac12\\\\\\text{New height} &= 2r\\end{align*}$$\n\nEach bar still has area $r$, so the total area stays at $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
