  "content": {
    "id": "p16-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the rate $R$ p.a. for $\\$7200$ of simple interest on a principal of $\\$8000$ over 12 years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7.5\\%$ p.a.",
      "worked": "$$\\begin{aligned}I&=PRT\\\\7200&=8000\\times R\\times12\\\\7200&=96\\,000R\\\\R&=\\frac{7200}{96\\,000}\\\\R&=0.075\\\\R&=7.5\\%\\end{aligned}$$\nThe interest rate is $7.5\\%$ p.a.",
      "solutionDiagrams": []
    },
