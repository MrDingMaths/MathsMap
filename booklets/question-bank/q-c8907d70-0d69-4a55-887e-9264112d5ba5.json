  "content": {
    "id": "p17-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Using the discriminant, find the number of real solutions that each of the following quadratic equations has:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+5x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 real solutions.",
          "worked": "$$\\begin{align*}\\Delta&=5^2-4(1)(3)\\\\\\Delta&=13>0\\end{align*}$$\nThere are two distinct real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$3x^2-2x+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "0 real solutions.",
          "worked": "$$\\begin{align*}\\Delta&=(-2)^2-4(3)(5)\\\\\\Delta&=-56<0\\end{align*}$$\nThere are no real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$-2x^2-3x+6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 real solutions.",
          "worked": "$$\\begin{align*}\\Delta&=(-3)^2-4(-2)(6)\\\\\\Delta&=57>0\\end{align*}$$\nThere are two distinct real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+\\sqrt{12}x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 real solution.",
          "worked": "$$\\begin{align*}\\Delta&=(\\sqrt{12})^2-4(1)(3)\\\\\\Delta&=0\\end{align*}$$\nThere is one real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
