  "content": {
    "id": "p5-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Sam completes four mathematics tests. His average for these four tests is $82\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find Sam’s overall average if he scores $92\\%$ on his fifth test.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84\\%$",
          "worked": "$$\\begin{align*}\\text{Overall average}&=\\frac{4\\times82\\%+92\\%}{5}\\\\\\text{Overall average}&=\\frac{420\\%}{5}\\\\\\text{Overall average}&=84\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find Sam’s highest possible average after five tests.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$85.6\\%$\n\nThe highest fifth-test score is $100\\%$.",
          "worked": "The highest possible fifth-test score is $100\\%$.\n\n$$\\begin{align*}\\text{Highest average}&=\\frac{4\\times82\\%+100\\%}{5}\\\\\\text{Highest average}&=\\frac{428\\%}{5}\\\\\\text{Highest average}&=85.6\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Find Sam’s lowest possible average after five tests.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$65.6\\%$\n\nThe lowest fifth-test score is $0\\%$.",
          "worked": "The lowest possible fifth-test score is $0\\%$.\n\n$$\\begin{align*}\\text{Lowest average}&=\\frac{4\\times82\\%+0\\%}{5}\\\\\\text{Lowest average}&=\\frac{328\\%}{5}\\\\\\text{Lowest average}&=65.6\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "What would Sam have to score for his fifth test for his overall average to be $85\\%$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$97\\%$\n\nSubtract the total of the first four scores from the total needed for five tests.",
          "worked": "Let $s$ be the fifth-test score, expressed as a percentage.\n\n$$\\begin{align*}\\frac{4\\times82\\%+s}{5}&=85\\%\\\\328\\%+s&=425\\%\\\\s&=425\\%-328\\%\\\\s&=97\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
