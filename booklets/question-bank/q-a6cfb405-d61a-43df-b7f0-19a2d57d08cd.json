      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(5,1)$ given $f(x)=x^3+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13$",
          "worked": "$$\\begin{aligned}f'(x)&=3x^2\\\\(f^{-1})'(5)&=\\frac{1}{f'(1)}\\\\&=\\frac13\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-1,1)$ given $f(x)=2x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$$\\begin{aligned}f'(x)&=2\\\\(f^{-1})'(-1)&=\\frac{1}{f'(1)}\\\\&=\\frac12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1,0)$ given $f(x)=e^{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13$",
          "worked": "$$\\begin{aligned}f'(x)&=3e^{3x}\\\\(f^{-1})'(1)&=\\frac{1}{f'(0)}\\\\&=\\frac{1}{3e^0}\\\\&=\\frac13\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2,5)$ given $f(x)=\\sqrt{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{aligned}f'(x)&=\\frac{1}{2\\sqrt{x-1}}\\\\f'(5)&=\\frac14\\\\(f^{-1})'(2)&=\\frac{1}{f'(5)}\\\\&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\dfrac19,2\\right)$ given $f(x)=\\dfrac{1}{x^3+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{27}{4}$",
          "worked": "$$\\begin{aligned}f'(x)&=-\\frac{3x^2}{(x^3+1)^2}\\\\f'(2)&=-\\frac{12}{81}\\\\&=-\\frac4{27}\\\\(f^{-1})'\\left(\\frac19\\right)&=\\frac{1}{f'(2)}\\\\&=-\\frac{27}{4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
