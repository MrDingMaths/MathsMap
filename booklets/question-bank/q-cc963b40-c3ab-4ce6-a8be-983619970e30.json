  "content": {
    "id": "p9-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the sum of each of the following arithmetic sequences:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$1+2+\\cdots+1000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$500\\,500$",
          "worked": "$$\\begin{align*}n&=1000\\\\S_{1000}&=\\frac{1000}{2}(1+1000)\\\\S_{1000}&=500\\,500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$1+3+\\cdots+99$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2500$",
          "worked": "$$\\begin{align*}n&=\\frac{99-1}{2}+1\\\\n&=50\\\\S_{50}&=\\frac{50}{2}(1+99)\\\\S_{50}&=2500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$3+6+\\cdots+999$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$166\\,833$",
          "worked": "$$\\begin{align*}n&=\\frac{999-3}{3}+1\\\\n&=333\\\\S_{333}&=\\frac{333}{2}(3+999)\\\\S_{333}&=166\\,833\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$77+88+\\cdots+1221$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$68\\,145$",
          "worked": "$$\\begin{align*}n&=\\frac{1221-77}{11}+1\\\\n&=105\\\\S_{105}&=\\frac{105}{2}(77+1221)\\\\S_{105}&=68\\,145\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$8+13+\\cdots+263$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7046$",
          "worked": "$$\\begin{align*}n&=\\frac{263-8}{5}+1\\\\n&=52\\\\S_{52}&=\\frac{52}{2}(8+263)\\\\S_{52}&=7046\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$20+24+\\cdots+524$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34\\,544$",
          "worked": "$$\\begin{align*}n&=\\frac{524-20}{4}+1\\\\n&=127\\\\S_{127}&=\\frac{127}{2}(20+524)\\\\S_{127}&=34\\,544\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$-10-13-\\cdots-100$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1705$",
          "worked": "The terms are $-10,-13,\\ldots,-100$, with common difference $-3$.\n\n$$\\begin{align*}n&=\\frac{-100-(-10)}{-3}+1\\\\n&=31\\\\S_{31}&=\\frac{31}{2}(-10-100)\\\\S_{31}&=-1705\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p9-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$(-30)+(-25)+\\cdots+350$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\,320$",
          "worked": "The common difference is $5$.\n\n$$\\begin{align*}n&=\\frac{350-(-30)}{5}+1\\\\n&=77\\\\S_{77}&=\\frac{77}{2}(-30+350)\\\\S_{77}&=12\\,320\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
