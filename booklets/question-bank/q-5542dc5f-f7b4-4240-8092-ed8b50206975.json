  "content": {
    "id": "p13-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Find, to 1 decimal place, the percentage profit or loss on costs in these situations.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Costs $\\$16\\,000$ and sales $\\$18\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12.5\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit}&=18\\,000-16\\,000\\\\\\text{Profit}&=\\$2\\,000\\\\\\text{Percentage profit}&=\\frac{2\\,000}{16\\,000}\\times100\\%\\\\\\text{Percentage profit}&=12.5\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Costs $\\$162\\,000$ and sales $\\$150\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.4\\%$ loss",
          "worked": "$$\\begin{align*}\\text{Loss}&=162\\,000-150\\,000\\\\\\text{Loss}&=\\$12\\,000\\\\\\text{Percentage loss}&=\\frac{12\\,000}{162\\,000}\\times100\\%\\\\\\text{Percentage loss}&\\approx7.4\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Costs $\\$2\\,800\\,000$ and sales $\\$3\\,090\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10.4\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit}&=3\\,090\\,000-2\\,800\\,000\\\\\\text{Profit}&=\\$290\\,000\\\\\\text{Percentage profit}&=\\frac{290\\,000}{2\\,800\\,000}\\times100\\%\\\\\\text{Percentage profit}&\\approx10.4\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "Costs $\\$289\\,000\\,000$ and sales $\\$268\\,000\\,000$",
