    "label": "8",
    "prompt": "Show that 85 can be written both as the sum of two squares and the difference of two squares.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$85=7^2+6^2$ and $85=11^2-6^2$.",
      "worked": "$$\\begin{align*}7^2+6^2&=49+36\\\\7^2+6^2&=85\\\\11^2-6^2&=121-36\\\\11^2-6^2&=85\\end{align*}$$",
      "solutionDiagrams": []
