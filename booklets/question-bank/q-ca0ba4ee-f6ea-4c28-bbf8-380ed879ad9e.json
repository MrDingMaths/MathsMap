  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The angle between vectors $\\underset{\\sim}{u}$ and $\\underset{\\sim}{v}$ is $60^\\circ$ and their scalar product is $10$.\n\nIf $\\underset{\\sim}{v}=3\\underset{\\sim}{i}-4\\underset{\\sim}{j}$, find the magnitude of $\\underset{\\sim}{u}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$|\\underset{\\sim}{u}|=4$",
      "worked": "$$\\begin{aligned}|\\underset{\\sim}{v}|&=\\sqrt{3^2+(-4)^2}=5\\\\|\\underset{\\sim}{u}||\\underset{\\sim}{v}|\\cos60^\\circ&=10\\\\|\\underset{\\sim}{u}|\\times5\\times\\frac12&=10\\\\|\\underset{\\sim}{u}|&=4\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 21
  },
