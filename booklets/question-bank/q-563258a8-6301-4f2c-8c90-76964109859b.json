  "content": {
    "id": "p23-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "For $x=3+2\\sqrt5$ and $y=3-2\\sqrt5$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}x+y&=(3+2\\sqrt5)+(3-2\\sqrt5)\\\\x+y&=6.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p23-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "$xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-11$",
          "worked": "$$\\begin{align*}xy&=(3+2\\sqrt5)(3-2\\sqrt5)\\\\xy&=3^2-(2\\sqrt5)^2\\\\xy&=9-20\\\\xy&=-11.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q24-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac1x+\\dfrac1y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac6{11}$",
          "worked": "$$\\begin{align*}\\frac1x+\\frac1y&=\\frac{x+y}{xy}\\\\\\frac1x+\\frac1y&=\\frac6{-11}\\\\\\frac1x+\\frac1y&=-\\frac6{11}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
