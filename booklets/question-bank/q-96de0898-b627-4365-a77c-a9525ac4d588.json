        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-foundation-section-slot-12-upper-slot-12-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "no prize.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "330 times",
          "worked": "$$\\begin{align*}P(\\text{prize})&=0.05+0.15+0.25\\\\P(\\text{prize})&=0.45\\\\P(\\text{no prize})&=1-0.45\\\\P(\\text{no prize})&=0.55\\\\f&=np\\\\f&=600\\times0.55\\\\f&=330\\end{align*}$$Expected frequency: 330 times.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
