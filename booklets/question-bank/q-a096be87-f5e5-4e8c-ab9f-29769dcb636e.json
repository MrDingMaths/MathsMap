  "content": {
    "id": "p8-prob-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A box contains 24 balls. There are eight red balls numbered 1 to 8, six blue balls numbered 9 to 14, and ten green balls numbered 15 to 24. One ball is taken out of the box. Find the probability of getting:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-prob-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "a red ball",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "$$P(\\text{red})=\\frac8{24}=\\frac13.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-prob-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "a green ball",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac5{12}$",
          "worked": "$$P(\\text{green})=\\frac{10}{24}=\\frac5{12}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-prob-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "an odd number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "There are 12 odd numbers from 1 to 24.\n\n$$P(\\text{odd})=\\frac{12}{24}=\\frac12.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-prob-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "a green ball with an odd number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac5{24}$",
          "worked": "The favourable numbers are $15,17,19,21,23$.\n\n$$P(\\text{green and odd})=\\frac5{24}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-prob-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "a green or a red ball",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac34$",
          "worked": "There are $10+8=18$ green or red balls.\n\n$$P(\\text{green or red})=\\frac{18}{24}=\\frac34.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-prob-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "a number greater than 10",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac7{12}$",
          "worked": "The numbers 11 to 24 give 14 favourable outcomes.\n\n$$P(\\text{greater than }10)=\\frac{14}{24}=\\frac7{12}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-prob-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "a number divisible by 5",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac16$",
          "worked": "The favourable numbers are $5,10,15,20$.\n\n$$P(\\text{divisible by }5)=\\frac4{24}=\\frac16.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-prob-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "a prime number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac38$",
          "worked": "The prime numbers are $2,3,5,7,11,13,17,19,23$; there are 9.\n\n$$P(\\text{prime})=\\frac9{24}=\\frac38.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-prob-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "a ball that is not red",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "There are $6+10=16$ balls that are not red.\n\n$$P(\\text{not red})=\\frac{16}{24}=\\frac23.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
