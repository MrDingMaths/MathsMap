  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Each of the nine letters A, B, C, D, E, F, G, H and I stand for a different digit from 1 to 9. Find the value of\n$$(ABC)+(DEF)+(GHI)$$\nthat is as close as possible to $1500$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p7-q10-short-result",
