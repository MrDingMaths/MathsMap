  "content": {
    "id": "p15-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The ratio of length to width of a rectangle is $5:3$. Find the area of the rectangle if its perimeter is $160\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1500\\text{ cm}^2$",
      "worked": "The length and width together represent $5+3=8$ parts.\n$$\\begin{align*}\n\\text{Length}+\\text{width}&=160\\div2\\\\\n\\text{Length}+\\text{width}&=80\\text{ cm}\\\\\n\\text{One part}&=80\\div8\\\\\n\\text{One part}&=10\\text{ cm}\\\\\n\\text{Length}&=5\\times10=50\\text{ cm}\\\\\n\\text{Width}&=3\\times10=30\\text{ cm}\\\\\n\\text{Area}&=50\\times30\\\\\n\\text{Area}&=1500\\text{ cm}^2\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
