  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A rectangle has length $x$ cm and width $\\frac{x}{3}$ cm. What is the area of the rectangle? Find the area if $x=9$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{x^2}{3}\\text{ cm}^2$; $27\\text{ cm}^2$.",
      "worked": "Area is length multiplied by width.\n\n$$\\begin{align*}A&=x\\times\\frac{x}{3}\\\\A&=\\frac{x\\times x}{3}\\\\A&=\\frac{x^2}{3}\\text{ cm}^2\\end{align*}$$\n\nFor $x=9$:\n\n$$\\begin{align*}A&=\\frac{9^2}{3}\\\\A&=\\frac{81}{3}\\\\A&=27\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 50
  },
