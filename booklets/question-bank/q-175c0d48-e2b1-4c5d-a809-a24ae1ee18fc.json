        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p64-q5-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Sprinter A has the lower mean time: A ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\approx13.09\\,\\text{s}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", B ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\approx13.27\\,\\text{s}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\bar{x}_A&=\\frac{12.6+12.8+13.5+12.7+13.9+12.6+13.1+14.2+12.4}{9}\\,\\text{s}\\\\\\bar{x}_A&=\\frac{117.8}{9}\\,\\text{s}\\\\\\bar{x}_A&\\approx13.09\\,\\text{s}\\\\\\bar{x}_B&=\\frac{12.7+11.9+15.1+11.8+15.2+14.4+11.8}{7}\\,\\text{s}\\\\\\bar{x}_B&=\\frac{92.9}{7}\\,\\text{s}\\\\\\bar{x}_B&\\approx13.27\\,\\text{s}\\end{align*}$$\n\nSprinter A is quicker on average because its mean time is lower.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
