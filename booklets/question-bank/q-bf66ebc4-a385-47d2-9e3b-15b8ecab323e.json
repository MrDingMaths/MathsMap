  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Evaluate each expression when $a=-2$, $b=5$ and $c=-\\frac{1}{3}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$c^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "$$\\begin{align*}c^2&=\\left(-\\frac{1}{3}\\right)^2\\\\c^2&=\\left(-\\frac{1}{3}\\right)\\times\\left(-\\frac{1}{3}\\right)\\\\c^2&=\\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^2-c^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac{8}{9}$",
          "worked": "$$\\begin{align*}a^2-c^2&=(-2)^2-\\left(-\\frac{1}{3}\\right)^2\\\\a^2-c^2&=4-\\frac{1}{9}\\\\a^2-c^2&=\\frac{35}{9}\\\\a^2-c^2&=3\\frac{8}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p4-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$a-b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7$",
          "worked": "$$\\begin{align*}a-b&=-2-5\\\\a-b&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$b-a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}b-a&=5-(-2)\\\\b-a&=5+2\\\\b-a&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
