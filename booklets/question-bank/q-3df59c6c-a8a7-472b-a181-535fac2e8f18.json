    "type": "question",
    "label": "18",
    "prompt": "Find the percentage profit or loss on costs in these situations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Costs $\\$12\\,000$ and sales $\\$13\\,920$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit}&=13\\,920-12\\,000\\\\\\text{Profit}&=\\$1920\\\\\\text{Percentage profit}&=\\frac{1920}{12\\,000}\\times100\\%\\\\\\text{Percentage profit}&=16\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Costs $\\$52\\,000$ and sales $\\$56\\,680$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit}&=56\\,680-52\\,000\\\\\\text{Profit}&=\\$4680\\\\\\text{Percentage profit}&=\\frac{4680}{52\\,000}\\times100\\%\\\\\\text{Percentage profit}&=9\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "Costs $\\$112\\,000$ and sales $\\$100\\,800$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\%$ loss",
          "worked": "$$\\begin{align*}\\text{Loss}&=112\\,000-100\\,800\\\\\\text{Loss}&=\\$11\\,200\\\\\\text{Percentage loss}&=\\frac{11\\,200}{112\\,000}\\times100\\%\\\\\\text{Percentage loss}&=10\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "Costs $\\$22\\,000$ and sales $\\$200\\,900$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$813\\frac{2}{11}\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit}&=200\\,900-22\\,000\\\\\\text{Profit}&=\\$178\\,900\\\\\\text{Percentage profit}&=\\frac{178\\,900}{22\\,000}\\times100\\%\\\\\\text{Percentage profit}&=813\\frac{2}{11}\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
