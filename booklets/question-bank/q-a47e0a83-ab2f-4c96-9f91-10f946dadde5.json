  "content": {
    "id": "p8-q15-response",
    "type": "question",
    "label": "15",
    "prompt": "The mass of a hydrogen atom is $1.67\\times10^{-24}\\text{ g}$.\nWhat is the mass in nanograms of 1 million hydrogen atoms?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1.67\\times10^{-9}\\text{ ng}$. Multiply the mass by $10^6$, then by $10^9$ to convert grams to nanograms.",
      "worked": "$$\\begin{align*}\\text{Total mass}&=1.67\\times10^{-24}\\times10^6\\text{ g}\\\\&=1.67\\times10^{-18}\\text{ g}\\\\&=1.67\\times10^{-18}\\times10^9\\text{ ng}\\\\&=1.67\\times10^{-9}\\text{ ng}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
