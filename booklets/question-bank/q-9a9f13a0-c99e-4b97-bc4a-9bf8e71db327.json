  "content": {
    "id": "p21-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve each of the following for $(x,y)$ by equating each pair of equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=ax+b\\\\y&=bx+a\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,a+b)$, where $a\\ne b$.\n\nEquate the expressions for $y$, then substitute.",
          "worked": "$$\\begin{align*}ax+b&=bx+a\\\\ax-bx&=a-b\\\\(a-b)x&=a-b\\\\x&=1\\quad(a\\ne b)\\\\y&=a(1)+b=a+b\\end{align*}$$\nTherefore, $(x,y)=(1,a+b)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=ax+b\\\\y&=-ax-b\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-\\frac{b}{a},0\\right)$, where $a\\ne0$.\n\nEquate the expressions for $y$, then substitute.",
          "worked": "$$\\begin{align*}ax+b&=-ax-b\\\\2ax&=-2b\\\\x&=-\\frac{b}{a}\\quad(a\\ne0)\\\\y&=a\\left(-\\frac{b}{a}\\right)+b=0\\end{align*}$$\nTherefore, $(x,y)=\\left(-\\frac{b}{a},0\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p21-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=ax-b\\\\y&=-bx+a\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,a-b)$, where $a\\ne-b$.\n\nEquate the expressions for $y$, then substitute.",
          "worked": "$$\\begin{align*}ax-b&=-bx+a\\\\ax+bx&=a+b\\\\(a+b)x&=a+b\\\\x&=1\\quad(a\\ne-b)\\\\y&=a(1)-b=a-b\\end{align*}$$\nTherefore, $(x,y)=(1,a-b)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=\\frac{x}{a}+b\\\\y&=-\\frac{x}{a}-b\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-ab,0)$, where $a\\ne0$.\n\nEquate the expressions for $y$, then substitute.",
          "worked": "The equations require $a\\ne0$.\n$$\\begin{align*}\\frac{x}{a}+b&=-\\frac{x}{a}-b\\\\\\frac{2x}{a}&=-2b\\\\x&=-ab\\\\y&=\\frac{-ab}{a}+b=0\\end{align*}$$\nTherefore, $(x,y)=(-ab,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
