  "content": {
    "id": "p15-q3-root",
    "type": "question",
    "label": "5",
    "prompt": "For the following pairs of functions $f(x)$ and $g(x)$, find and simplify $f(g(x))$ and $g(f(x))$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x-2$, $g(x)=2x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=2x+3$, $g(f(x))=2x+1$.",
          "worked": "$$\\begin{align*}f(g(x))&=(2x+5)-2\\\\f(g(x))&=2x+3\\end{align*}$$\n\n$$\\begin{align*}g(f(x))&=2(x-2)+5\\\\g(f(x))&=2x-4+5\\\\g(f(x))&=2x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p15-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2x$, $g(x)=3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=g(f(x))=6x$.",
          "worked": "$$\\begin{align*}f(g(x))&=2(3x)\\\\f(g(x))&=6x\\end{align*}$$\n\n$$\\begin{align*}g(f(x))&=3(2x)\\\\g(f(x))&=6x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^2$, $g(x)=x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=g(f(x))=x^6$.",
          "worked": "$$\\begin{align*}f(g(x))&=(x^3)^2\\\\f(g(x))&=x^6\\end{align*}$$\n\n$$\\begin{align*}g(f(x))&=(x^2)^3\\\\g(f(x))&=x^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{1}{x}$, $g(x)=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=g(f(x))=\\dfrac{1}{\\sqrt{x}}$, for $x>0$.",
          "worked": "$$\\begin{align*}f(g(x))&=\\frac{1}{\\sqrt{x}}\\end{align*}$$\n\n$$\\begin{align*}g(f(x))&=\\sqrt{\\frac{1}{x}}\\\\g(f(x))&=\\frac{1}{\\sqrt{x}}\\end{align*}$$\n\nBoth compositions require $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
