    "children": [
      {
        "id": "p66-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "According to the index laws, what would $(9^{0.5})^2$ be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}(9^{0.5})^2&=9^{0.5\\times2}\\\\&=9^1\\\\&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p66-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Using what you got above, what is $9^{0.5}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "From part a, $(9^{0.5})^2=9$. Since $3^2=9$, $9^{0.5}=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p66-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "What would $16^{0.5}$ be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$16^{0.5}=\\sqrt{16}=4$$\nSince $4^2=16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p66-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "What would $25^{0.5}$ be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$25^{0.5}=\\sqrt{25}=5$$\nSince $5^2=25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p66-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "What would $36^{0.5}$ be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$36^{0.5}=\\sqrt{36}=6$$\nSince $6^2=36$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p66-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "What would $x^{0.5}$ be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x}$",
          "worked": "$$\\begin{align*}(x^{0.5})^2&=x^{0.5\\times2}\\\\&=x\\end{align*}$$\nTherefore $x^{0.5}=\\sqrt{x}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
