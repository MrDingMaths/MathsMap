  "content": {
    "id": "p20-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Two of the roots of $ax^3+bx^2+cx+d=0$ are equal in magnitude but opposite in sign.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q16a",
        "type": "part",
        "label": "a",
        "prompt": "Show that one of the roots is $x=-\\dfrac ba$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The remaining root is $-\\dfrac ba$.",
          "worked": "Let the roots be $\\alpha,-\\alpha,\\beta$.\n\nUsing the sum of roots:\n$$\\begin{aligned}\\alpha+(-\\alpha)+\\beta&=-\\frac ba\\\\\\beta&=-\\frac ba\\end{aligned}$$\nThus one root is $x=-\\dfrac ba$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p20-q16b",
        "type": "part",
        "label": "b",
        "prompt": "By substituting this back into the polynomial, show that $ad=bc$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ad=bc$.",
          "worked": "$$\\begin{aligned}a\\left(-\\frac ba\\right)^3+b\\left(-\\frac ba\\right)^2+c\\left(-\\frac ba\\right)+d&=0\\\\-\\frac{b^3}{a^2}+\\frac{b^3}{a^2}-\\frac{bc}{a}+d&=0\\\\-\\frac{bc}{a}+d&=0\\\\-bc+ad&=0\\\\ad&=bc\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
