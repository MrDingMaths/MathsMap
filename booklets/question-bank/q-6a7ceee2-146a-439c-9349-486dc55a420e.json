        "id": "p7-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the length of $AC$ is 26.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AC=26$.",
          "worked": "Triangle $ABC$ is right-angled at $B$.\n$$\\begin{align*}AC^2&=24^2+10^2\\\\AC^2&=676\\\\AC&=26\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of triangle $ABC$ in two ways to show that $13h=120$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "dependsOn": [
          "p7-q15-a"
        ],
        "answer": {
          "short": "$A=120=13h$.",
          "worked": "Using the perpendicular sides $AB$ and $BC$:\n$$A=\\frac12\\times24\\times10=120.$$\nUsing base $AC$ and perpendicular height $BD$:\n$$A=\\frac12\\times26\\times h=13h.$$\nEquating the two expressions for the same area gives $13h=120$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p7-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Use Pythagoras’ theorem to find $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "dependsOn": [
          "p7-q15-b"
        ],
        "answer": {
          "short": "$x=\\frac{50}{13}$.\n\nUse $h=\\frac{120}{13}$ in right-angled triangle $BDC$.",
          "worked": "From part b, $h=\\frac{120}{13}$. Triangle $BDC$ is right-angled at $D$.\n$$\\begin{align*}x^2+h^2&=10^2\\\\x^2&=100-\\left(\\frac{120}{13}\\right)^2\\\\x^2&=\\frac{2500}{169}\\\\x&=\\frac{50}{13}\\end{align*}$$\nTake the positive square root because $x$ is a length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
