  "content": {
    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find $\\dfrac{dy}{dx}$ using the quotient rule.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{\\sin x}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{x\\cos x-\\sin x}{x^2}$",
          "worked": "Let $u=\\sin x$, $u'=\\cos x$; $v=x$, $v'=1$.\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{(\\cos x)x-(\\sin x)(1)}{x^2}\\\\&=\\frac{x\\cos x-\\sin x}{x^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p8-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{\\cos x}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{-x\\sin x-\\cos x}{x^2}$",
          "worked": "Let $u=\\cos x$, $u'=-\\sin x$; $v=x$, $v'=1$.\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{(-\\sin x)x-(\\cos x)(1)}{x^2}\\\\&=\\frac{-x\\sin x-\\cos x}{x^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p8-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{x^2}{\\cos x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{x(2\\cos x+x\\sin x)}{\\cos^2 x}$",
          "worked": "Let $u=x^2$, $u'=2x$; $v=\\cos x$, $v'=-\\sin x$.\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{(2x)\\cos x-x^2(-\\sin x)}{\\cos^2 x}\\\\&=\\frac{2x\\cos x+x^2\\sin x}{\\cos^2 x}\\\\&=\\frac{x(2\\cos x+x\\sin x)}{\\cos^2 x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p8-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{x}{1+\\sin x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{1+\\sin x-x\\cos x}{(1+\\sin x)^2}$",
          "worked": "Let $u=x$, $u'=1$; $v=1+\\sin x$, $v'=\\cos x$.\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{1(1+\\sin x)-x\\cos x}{(1+\\sin x)^2}\\\\&=\\frac{1+\\sin x-x\\cos x}{(1+\\sin x)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
