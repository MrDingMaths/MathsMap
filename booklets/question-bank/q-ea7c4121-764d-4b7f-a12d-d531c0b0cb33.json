  "content": {
    "id": "p30-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A bag contains 8 red balls and 5 black balls. A ball is taken and its colour noted. It is not replaced. A second ball is taken and its colour noted. Find the probability of obtaining:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "a red ball followed by a black ball",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{39}$",
          "worked": "$$\\begin{align*}P(\\text{red then black})&=\\frac{8}{13}\\times\\frac{5}{12}\\\\P(\\text{red then black})&=\\frac{10}{39}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "a red and a black ball",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{20}{39}$",
          "worked": "The colours can occur in either order. These two cases are mutually exclusive.\n\n$$\\begin{align*}P(\\text{one of each})&=\\frac{8}{13}\\times\\frac{5}{12}+\\frac{5}{13}\\times\\frac{8}{12}\\\\P(\\text{one of each})&=\\frac{40+40}{156}\\\\P(\\text{one of each})&=\\frac{20}{39}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p30-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "two red balls",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14}{39}$",
          "worked": "$$\\begin{align*}P(\\text{two red})&=\\frac{8}{13}\\times\\frac{7}{12}\\\\P(\\text{two red})&=\\frac{14}{39}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "two black balls",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{39}$",
          "worked": "$$\\begin{align*}P(\\text{two black})&=\\frac{5}{13}\\times\\frac{4}{12}\\\\P(\\text{two black})&=\\frac{5}{39}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
