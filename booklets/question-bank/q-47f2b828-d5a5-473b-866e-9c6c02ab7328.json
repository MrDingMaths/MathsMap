  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The price of beans has been rising. The price has risen by $10\\%$, $15\\%$ and $35\\%$ in three successive years, and they now cost $\\$3.40$ per kg. By dividing successively by $1.35$, then by $1.15$, and then by $1.10$, find the following prices, correct to the nearest cent.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "price one year ago",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2.52$ per kg",
          "worked": "$$\\begin{align*}P_1&=3.40\\div1.35\\\\P_1&\\approx2.52\\end{align*}$$\nThe price was $\\$2.52$ per kg.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "price two years ago",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2.19$ per kg",
          "worked": "$$\\begin{align*}P_2&=(3.40\\div1.35)\\div1.15\\\\P_2&\\approx2.19\\end{align*}$$\nThe price was $\\$2.19$ per kg. Keep the first division unrounded.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
