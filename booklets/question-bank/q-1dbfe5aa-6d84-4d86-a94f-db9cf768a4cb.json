    "questionDiagrams": [],
    "children": [
      {
        "id": "p65-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $P(x)=2x^3-x^2-13x-6$ is divisible by both $(x-3)$ and $(2x+1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(3)=0$ and $P\\left(-\\frac12\\right)=0$, so both are factors.",
          "worked": "$$\\begin{align*}P(3)&=2(3)^3-(3)^2-13(3)-6\\\\&=54-9-39-6\\\\&=0\\\\P\\left(-\\frac12\\right)&=2\\left(-\\frac12\\right)^3-\\left(-\\frac12\\right)^2-13\\left(-\\frac12\\right)-6\\\\&=-\\frac14-\\frac14+\\frac{13}{2}-6\\\\&=0\\end{align*}$$\nBy the factor theorem, $(x-3)$ and $(2x+1)$ are factors of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p65-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "By considering the leading term and constant term, express $P(x)$ as a product of three linear factors and hence solve $P(x)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(2x+1)(x-3)(x+2)$; $x=-2,-\\frac12,3$.",
          "worked": "Write $P(x)=(2x+1)(x-3)(ax+b)$.\nThe leading coefficient gives\n$$\\begin{align*}2a&=2\\\\a&=1\\end{align*}$$\nThe constant term gives\n$$\\begin{align*}-3b&=-6\\\\b&=2\\end{align*}$$\nThus\n$$\\begin{align*}P(x)&=(2x+1)(x-3)(x+2)\\\\(2x+1)(x-3)(x+2)&=0\\end{align*}$$\nBy the null factor law,\n$$x=-\\frac12,\\ 3,\\ -2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
