    "children": [
      {
        "id": "p35-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the $x$-coordinates $\\alpha$ and $\\beta$ of $A$ and $B$ satisfy $x^3-5x^2+5x+2=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3-5x^2+6x=x-2$, so $x^3-5x^2+5x+2=0$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q6-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "center",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x^3-5x^2+6x&=x-2\\\\x^3-5x^2+5x+2&=0\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p35-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\alpha+\\beta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha+\\beta=3$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q6-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Using the sum of roots,",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\alpha+\\beta+2&=5\\\\\\alpha+\\beta&=3\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p35-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find the coordinates of the midpoint $M$ of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M=\\left(\\frac32,-\\frac12\\right)$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q6-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Average the x-coordinates of A and B, then substitute into the equation of the line.",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x_M&=\\frac{\\alpha+\\beta}{2}=\\frac32\\\\y_M&=\\frac32-2=-\\frac12\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "math",
                    "latex": "M=\\left(\\frac32,-\\frac12\\right)",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $\\alpha\\beta=-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\alpha\\beta=-2$, so $\\alpha\\beta=-1$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q6-d-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Using the product of roots,",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}2\\alpha\\beta&=-2\\\\\\alpha\\beta&=-1\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p35-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "Use the identity $(\\alpha-\\beta)^2=(\\alpha+\\beta)^2-4\\alpha\\beta$ to show that the horizontal distance $|\\alpha-\\beta|$ between $A$ and $B$ is $\\sqrt{13}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\alpha-\\beta|=\\sqrt{3^2-4(-1)}=\\sqrt{13}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q6-e-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(\\alpha-\\beta)^2&=3^2-4(-1)\\\\(\\alpha-\\beta)^2&=13\\\\|\\alpha-\\beta|&=\\sqrt{13}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "Hence find the length of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=\\sqrt{26}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q6-f-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The line has gradient 1, so the vertical distance is also ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\sqrt{13}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". Alternatively, find the y-coordinates of the intersection points by substituting their x-coordinates into the equation of the line.",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}AB&=\\sqrt{(\\sqrt{13})^2+(\\sqrt{13})^2}\\\\AB&=\\sqrt{26}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
