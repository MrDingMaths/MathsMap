  "content": {
    "id": "p30-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Let $f:\\mathbb{R}\\to\\mathbb{R}$ where $f(x)=3x+2$. Find the value of $x$ such that $f^{-1}(x)=f(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-1$.",
      "worked": "Interchange $x$ and $y$ and solve for $y$:\n$$\\begin{align*}x&=3y+2\\\\x-2&=3y\\\\y&=\\frac{x-2}{3}.\\end{align*}$$\nThus $f^{-1}(x)=\\dfrac{x-2}{3}$. Equating the two rules gives\n$$\\begin{align*}\\frac{x-2}{3}&=3x+2\\\\x-2&=9x+6\\\\-8&=8x\\\\x&=-1.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
