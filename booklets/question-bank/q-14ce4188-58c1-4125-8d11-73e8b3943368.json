  "content": {
    "id": "p14-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "For these real functions, explain why the function value cannot be found.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$F(0)$, when $F(x)=\\sqrt{x-4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Substitution gives $\\sqrt{-4}$, which is not real.",
          "worked": "Substituting $x=0$ gives $\\begin{align*}\\sqrt{0-4}&=\\sqrt{-4}.\\end{align*}$ A negative number has no real square root, so $F(0)$ is not defined as a real value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(3)$, when $g(x)=\\sqrt{1-x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Substitution gives $\\sqrt{-8}$, which is not real.",
          "worked": "Substituting $x=3$ gives $\\begin{align*}\\sqrt{1-3^2}&=\\sqrt{1-9}\\\\&=\\sqrt{-8}.\\end{align*}$ A negative number has no real square root, so $g(3)$ is not defined as a real value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p14-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$h(-2)$, when $h(x)=\\dfrac{1}{2+x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The denominator is $2+(-2)=0$; division by zero is undefined.",
          "worked": "Substituting $x=-2$ gives $\\begin{align*}\\frac{1}{2+(-2)}&=\\frac{1}{0}.\\end{align*}$ Division by zero is undefined, so $h(-2)$ cannot be found.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p14-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(0)$, when $f(x)=\\dfrac{1}{3x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The denominator is $3(0)=0$; division by zero is undefined.",
          "worked": "Substituting $x=0$ gives $\\begin{align*}\\frac{1}{3(0)}&=\\frac{1}{0}.\\end{align*}$ Division by zero is undefined, so $f(0)$ cannot be found.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
