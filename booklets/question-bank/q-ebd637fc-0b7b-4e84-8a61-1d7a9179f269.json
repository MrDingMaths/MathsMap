  "content": {
    "id": "p41-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Jane’s average walking speed is $8\\text{ km/h}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "If she walks for 3 hours and 20 minutes, how far has she walked?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26\\frac{2}{3}\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Walking time}&=3+\\frac{20}{60}\\\\\\text{Walking time}&=\\frac{10}{3}\\text{ h}\\\\\\text{Walking distance}&=8\\times\\frac{10}{3}\\\\\\text{Walking distance}&=\\frac{80}{3}\\text{ km}\\\\\\text{Walking distance}&=26\\frac{2}{3}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p41-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "If she then hikes $10\\text{ km}$ in 4 hours, what is her average speed for the entire journey?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p41-q21-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "5\\text{ km/h}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p41-q21-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Divide the total distance by the total time.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\text{Total distance}&=\\frac{80}{3}+10\\\\\\text{Total distance}&=\\frac{110}{3}\\text{ km}\\\\\\text{Total time}&=\\frac{10}{3}+4\\\\\\text{Total time}&=\\frac{22}{3}\\text{ h}\\\\\\text{Average speed}&=\\frac{\\text{total distance}}{\\text{total time}}\\\\\\text{Average speed}&=\\frac{110}{3}\\div\\frac{22}{3}\\\\\\text{Average speed}&=5\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
