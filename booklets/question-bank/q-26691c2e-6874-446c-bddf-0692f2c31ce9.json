        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}\\frac{3(200-3x)}{5}&=\\frac{3(200-3\\times60)}{5}\\\\\\frac{3(200-3x)}{5}&=\\frac{3\\times20}{5}\\\\\\frac{3(200-3x)}{5}&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
