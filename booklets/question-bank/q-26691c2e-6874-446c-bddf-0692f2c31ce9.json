  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Evaluate these expressions for $x=60$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2(x+50)}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$44$",
          "worked": "$$\\begin{align*}\\frac{2(x+50)}{5}&=\\frac{2(60+50)}{5}\\\\\\frac{2(x+50)}{5}&=\\frac{2\\times110}{5}\\\\\\frac{2(x+50)}{5}&=44\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2x}{15}+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}\\frac{2x}{15}+10&=\\frac{2\\times60}{15}+10\\\\\\frac{2x}{15}+10&=8+10\\\\\\frac{2x}{15}+10&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\left(\\frac{x-20}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "$$\\begin{align*}3\\left(\\frac{x-20}{5}\\right)&=3\\left(\\frac{60-20}{5}\\right)\\\\3\\left(\\frac{x-20}{5}\\right)&=3\\times8\\\\3\\left(\\frac{x-20}{5}\\right)&=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$40-\\frac{3x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}40-\\frac{3x}{5}&=40-\\frac{3\\times60}{5}\\\\40-\\frac{3x}{5}&=40-36\\\\40-\\frac{3x}{5}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$5-\\frac{360}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}5-\\frac{360}{2x}&=5-\\frac{360}{2\\times60}\\\\5-\\frac{360}{2x}&=5-3\\\\5-\\frac{360}{2x}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2x+54}{11}+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\frac{9}{11}$",
          "worked": "$$\\begin{align*}\\frac{2x+54}{11}+10&=\\frac{2\\times60+54}{11}+10\\\\\\frac{2x+54}{11}+10&=\\frac{174}{11}+10\\\\\\frac{2x+54}{11}+10&=15\\frac{9}{11}+10\\\\\\frac{2x+54}{11}+10&=25\\frac{9}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{3(200-3x)}{5}$",
