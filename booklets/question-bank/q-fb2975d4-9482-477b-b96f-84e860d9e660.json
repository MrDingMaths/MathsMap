            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}f'(x)&=4x^3-48x^2+144x\\\\f'(x)&=4x(x-6)^2\\\\f''(x)&=12x^2-96x+144\\\\f''(x)&=12(x-2)(x-6).\\end{aligned}",
                "display": true
              }
            ]
          },
