              },
              {
                "type": "math",
                "latex": "x=0,6",
                "display": false
              },
              {
                "type": "text",
                "text": ". Possible inflection points occur at ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=2,6",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
