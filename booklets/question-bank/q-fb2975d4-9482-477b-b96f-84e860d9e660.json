            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The domain is all real numbers. The function is neither odd nor even and has no asymptotes. Its y-intercept is (0,10).",
                "marks": []
              }
            ]
          },
          {
            "id": "p46-q6-w-derivatives",
