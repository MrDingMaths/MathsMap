                "type": "math",
                "latex": "\\begin{aligned}f(0)&=10\\\\f(2)&=16-128+288+10\\\\f(2)&=186\\\\f(6)&=1296-3456+2592+10\\\\f(6)&=442.\\end{aligned}",
                "display": true
              }
            ]
