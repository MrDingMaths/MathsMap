  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "",
    "prompt": "Consider the equation $\\sin 2x-\\cos x=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "By using a double-angle formula and then factoring, show that $\\cos x=0$ or $\\sin x=\\frac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos x(2\\sin x-1)=0$, so $\\cos x=0$ or $\\sin x=\\frac12$.",
          "worked": "$$\\begin{aligned}\\sin 2x-\\cos x&=0\\\\2\\sin x\\cos x-\\cos x&=0\\\\\\cos x(2\\sin x-1)&=0\\end{aligned}$$\nTherefore $\\cos x=0$ or $\\sin x=\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence solve the equation for $0\\le x\\le2\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac\\pi6,\\frac\\pi2,\\frac{5\\pi}6,\\frac{3\\pi}2$.",
          "worked": "$$\\begin{aligned}\\cos x&=0:&x&=\\frac\\pi2,\\frac{3\\pi}2\\\\\\sin x&=\\frac12:&x&=\\frac\\pi6,\\frac{5\\pi}6\\end{aligned}$$\nTherefore $x=\\frac\\pi6,\\frac\\pi2,\\frac{5\\pi}6,\\frac{3\\pi}2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
