      {
        "id": "p25-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate, correct to two decimal places, the radius of a sphere with a volume of $1000\\text{ cm}^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.20\\text{ cm}$",
          "worked": "$$\\begin{align*}V&=\\frac{4}{3}\\pi r^3\\\\1000&=\\frac{4}{3}\\pi r^3\\\\r^3&=\\frac{1000\\times3}{4\\pi}\\\\r&=\\sqrt[3]{\\frac{750}{\\pi}}\\\\r&\\approx6.20\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p25-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate, correct to the nearest millimetre, the diameter of a sphere with a volume of $3000\\text{ cm}^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$179\\text{ mm}$",
          "worked": "$$\\begin{align*}V&=\\frac{4}{3}\\pi r^3\\\\3000&=\\frac{4}{3}\\pi r^3\\\\r^3&=\\frac{3000\\times3}{4\\pi}\\\\r&=\\sqrt[3]{\\frac{2250}{\\pi}}\\text{ cm}\\\\d&=2\\sqrt[3]{\\frac{2250}{\\pi}}\\text{ cm}\\\\d&=20\\sqrt[3]{\\frac{2250}{\\pi}}\\text{ mm}\\\\d&\\approx179\\text{ mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p25-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate, correct to one decimal place, the diameter of a hemispherical bowl with a volume of $250\\text{ cm}^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9.8\\text{ cm}$",
          "worked": "A hemisphere has half the volume of a sphere of the same radius.\n$$\\begin{align*}V&=\\frac12\\times\\frac43\\pi r^3\\\\250&=\\frac23\\pi r^3\\\\r^3&=\\frac{250\\times3}{2\\pi}\\\\r&=\\sqrt[3]{\\frac{375}{\\pi}}\\text{ cm}\\\\d&=2\\sqrt[3]{\\frac{375}{\\pi}}\\text{ cm}\\\\d&\\approx9.8\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
