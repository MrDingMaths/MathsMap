  "content": {
    "id": "p31-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Given $\\underset{\\sim}{u}=\\begin{pmatrix}2\\\\1\\end{pmatrix}$ and $\\underset{\\sim}{v}=\\begin{pmatrix}3\\\\-4\\end{pmatrix}$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\operatorname{proj}_{\\underset{\\sim}{v}}\\underset{\\sim}{u}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}0.24\\\\-0.32\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\operatorname{proj}_{\\underset{\\sim}{v}}\\underset{\\sim}{u}&=\\frac{\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}}{|\\underset{\\sim}{v}|^2}\\underset{\\sim}{v}\\\\\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=2(3)+1(-4)=2\\\\|\\underset{\\sim}{v}|^2&=9+16=25\\\\\\operatorname{proj}_{\\underset{\\sim}{v}}\\underset{\\sim}{u}&=\\frac{2}{25}\\begin{pmatrix}3\\\\-4\\end{pmatrix}=\\begin{pmatrix}0.24\\\\-0.32\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p31-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\operatorname{proj}_{\\underset{\\sim}{u}}\\underset{\\sim}{v}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}0.8\\\\0.4\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\operatorname{proj}_{\\underset{\\sim}{u}}\\underset{\\sim}{v}&=\\frac{\\underset{\\sim}{v}\\cdot\\underset{\\sim}{u}}{|\\underset{\\sim}{u}|^2}\\underset{\\sim}{u}\\\\|\\underset{\\sim}{u}|^2&=4+1=5\\\\\\operatorname{proj}_{\\underset{\\sim}{u}}\\underset{\\sim}{v}&=\\frac{2}{5}\\begin{pmatrix}2\\\\1\\end{pmatrix}=\\begin{pmatrix}0.8\\\\0.4\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p31-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left|\\operatorname{proj}_{\\underset{\\sim}{v}}\\underset{\\sim}{u}\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{aligned}\\left|\\operatorname{proj}_{\\underset{\\sim}{v}}\\underset{\\sim}{u}\\right|&=\\sqrt{0.24^2+(-0.32)^2}\\\\&=0.4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p31-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "The direction of $\\operatorname{proj}_{\\underset{\\sim}{v}}\\underset{\\sim}{u}$, measured anticlockwise from the positive $x$-axis, to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$307^\\circ$",
          "worked": "The projection lies in quadrant IV.\n\n$$\\begin{aligned}\\alpha&=\\tan^{-1}\\left(\\frac{0.32}{0.24}\\right)=\\tan^{-1}\\left(\\frac43\\right)\\\\\\theta&=360^\\circ-\\tan^{-1}\\left(\\frac43\\right)\\\\&\\approx307^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
