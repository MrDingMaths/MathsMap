  "content": {
    "id": "p25-group14-17-root",
    "type": "question",
    "label": "14",
    "prompt": "Find the new equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-group14-17-a",
        "type": "part",
        "label": "a",
        "prompt": "Dilate $y=x^2$ horizontally by a dilation factor $\\dfrac{1}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4x^2$",
          "worked": "Replace $x$ by $\\frac{x}{(\\frac{1}{2})}=2x$.\n$$\\begin{align*}y&=(2x)^2\\\\y&=4x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-group14-17-b",
        "type": "part",
        "label": "b",
        "prompt": "Dilate $y=9x^3$ horizontally by a dilation factor 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{x^3}{3}$",
          "worked": "Replace $x$ by $\\frac{x}{3}$.\n$$\\begin{align*}y&=9\\left(\\frac{x}{3}\\right)^3\\\\y&=\\frac{9x^3}{27}\\\\y&=\\frac{x^3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p25-group14-17-c",
        "type": "part",
        "label": "c",
        "prompt": "Dilate $y=3x^2$ vertically by a dilation factor 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=12x^2$",
          "worked": "Replace $y$ by $\\frac{y}{4}$.\n$$\\begin{align*}\\frac{y}{4}&=3x^2\\\\y&=12x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-group14-17-d",
        "type": "part",
        "label": "d",
        "prompt": "Dilate $y=\\dfrac{3x}{x-1}$ vertically by a dilation factor $\\dfrac{2}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2x}{x-1}$",
          "worked": "Replace $y$ by $\\frac{y}{(\\frac{2}{3})}$.\n$$\\begin{align*}\\frac{y}{2/3}&=\\frac{3x}{x-1}\\\\y&=\\frac{2x}{x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
