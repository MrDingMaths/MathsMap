  "content": {
    "id": "p59-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The curve $y=\\sqrt{x-3}$ has a tangent with gradient $\\frac{1}{2}$ at point $N$. Find the coordinates of $N$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$N=(4,1)$",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{1}{2\\sqrt{x-3}}\\\\\\frac{1}{2\\sqrt{x-3}}&=\\frac12\\\\\\sqrt{x-3}&=1\\\\x-3&=1\\\\x&=4\\\\y&=\\sqrt{4-3}\\\\y&=1\\end{align*}$$\nTherefore $N=(4,1)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
