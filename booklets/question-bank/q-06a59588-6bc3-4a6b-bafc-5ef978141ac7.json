    "prompt": "Complete the square. $2x^2-4x+5$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2(x-1)^2+3$",
      "worked": "$$\\begin{align*}2x^2-4x+5&=2\\left(x^2-2x+\\frac52\\right)\\\\2x^2-4x+5&=2\\left((x-1)^2-1+\\frac52\\right)\\\\2x^2-4x+5&=2(x-1)^2+3.\\end{align*}$$",
      "solutionDiagrams": []
    },
