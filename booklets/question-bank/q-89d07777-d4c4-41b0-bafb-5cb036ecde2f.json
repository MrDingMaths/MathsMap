  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Write two equivalent fractions for:",
    "layout": "grid",
    "columns": 5,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{4}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{8}{16}$ and $\\frac{12}{24}$.",
          "worked": "$$\\begin{align*}\\frac{4}{8}&=\\frac{4\\times2}{8\\times2}=\\frac{8}{16}\\\\\\frac{4}{8}&=\\frac{4\\times3}{8\\times3}=\\frac{12}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{6}{24}$ and $\\frac{9}{36}$.",
          "worked": "$$\\begin{align*}\\frac{3}{12}&=\\frac{3\\times2}{12\\times2}=\\frac{6}{24}\\\\\\frac{3}{12}&=\\frac{3\\times3}{12\\times3}=\\frac{9}{36}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{15}{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{30}{40}$ and $\\frac{45}{60}$.",
          "worked": "$$\\begin{align*}\\frac{15}{20}&=\\frac{15\\times2}{20\\times2}=\\frac{30}{40}\\\\\\frac{15}{20}&=\\frac{15\\times3}{20\\times3}=\\frac{45}{60}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{4}{6}$ and $\\frac{6}{9}$.",
          "worked": "$$\\begin{align*}\\frac{2}{3}&=\\frac{2\\times2}{3\\times2}=\\frac{4}{6}\\\\\\frac{2}{3}&=\\frac{2\\times3}{3\\times3}=\\frac{6}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{11}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{22}{24}$ and $\\frac{33}{36}$.",
          "worked": "$$\\begin{align*}\\frac{11}{12}&=\\frac{11\\times2}{12\\times2}=\\frac{22}{24}\\\\\\frac{11}{12}&=\\frac{11\\times3}{12\\times3}=\\frac{33}{36}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{10}{16}$ and $\\frac{15}{24}$.",
          "worked": "$$\\begin{align*}\\frac{5}{8}&=\\frac{5\\times2}{8\\times2}=\\frac{10}{16}\\\\\\frac{5}{8}&=\\frac{5\\times3}{8\\times3}=\\frac{15}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$1\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $1\\frac{2}{4}$ and $1\\frac{3}{6}$.",
          "worked": "Keep the whole-number part and form equivalent fractional parts.\n$$\\begin{align*}1\\frac{1}{2}&=1\\frac{1\\times2}{2\\times2}=1\\frac{2}{4}\\\\1\\frac{1}{2}&=1\\frac{1\\times3}{2\\times3}=1\\frac{3}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$4\\frac{1}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $4\\frac{2}{6}$ and $4\\frac{3}{9}$.",
          "worked": "Keep the whole-number part and form equivalent fractional parts.\n$$\\begin{align*}4\\frac{1}{3}&=4\\frac{1\\times2}{3\\times2}=4\\frac{2}{6}\\\\4\\frac{1}{3}&=4\\frac{1\\times3}{3\\times3}=4\\frac{3}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$3\\frac{5}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $3\\frac{10}{12}$ and $3\\frac{15}{18}$.",
          "worked": "Keep the whole-number part and form equivalent fractional parts.\n$$\\begin{align*}3\\frac{5}{6}&=3\\frac{5\\times2}{6\\times2}=3\\frac{10}{12}\\\\3\\frac{5}{6}&=3\\frac{5\\times3}{6\\times3}=3\\frac{15}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{7}{24}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{14}{48}$ and $\\frac{21}{72}$.",
          "worked": "$$\\begin{align*}\\frac{7}{24}&=\\frac{7\\times2}{24\\times2}=\\frac{14}{48}\\\\\\frac{7}{24}&=\\frac{7\\times3}{24\\times3}=\\frac{21}{72}\\end{align*}$$",
