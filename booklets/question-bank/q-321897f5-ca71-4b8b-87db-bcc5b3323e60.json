  "content": {
    "id": "p9-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Rewrite each division as multiplication by a fraction, then expand. Simplify the answer.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2y+8}{2}=\\dfrac{1}{2}(2y+8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y+4$",
          "worked": "$$\\begin{align*}\\dfrac{2y+8}{2}&=\\dfrac{1}{2}(2y+8)\\\\&=y+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{12-16y}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-4y$",
          "worked": "$$\\begin{align*}\\dfrac{12-16y}{4}&=\\dfrac{1}{4}(12-16y)\\\\&=3-4y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{18k-6}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3k-1$",
          "worked": "$$\\begin{align*}\\dfrac{18k-6}{6}&=\\dfrac{1}{6}(18k-6)\\\\&=3k-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{30t+15}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6t+3$",
          "worked": "$$\\begin{align*}\\dfrac{30t+15}{5}&=\\dfrac{1}{5}(30t+15)\\\\&=6t+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{63-14k}{-7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9+2k$",
          "worked": "$$\\begin{align*}\\dfrac{63-14k}{-7}&=-\\dfrac{1}{7}(63-14k)\\\\&=-9+2k\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{4a+8}{4}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+5$",
          "worked": "$$\\begin{align*}\\dfrac{4a+8}{4}+3&=\\dfrac{1}{4}(4a+8)+3\\\\&=a+2+3\\\\&=a+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$2y+\\dfrac{4y-16}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3y-4$",
          "worked": "$$\\begin{align*}2y+\\dfrac{4y-16}{4}&=2y+\\dfrac{1}{4}(4y-16)\\\\&=2y+y-4\\\\&=3y-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{60y-24}{12}-2(y+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3y-8$",
          "worked": "$$\\begin{align*}\\dfrac{60y-24}{12}-2(y+3)&=\\dfrac{1}{12}(60y-24)-2(y+3)\\\\&=5y-2-2y-6\\\\&=3y-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
