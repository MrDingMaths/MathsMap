  "content": {
    "id": "p3-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the domain of the following logarithmic functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\log_2(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>2$",
          "worked": "The logarithm requires a positive argument.\n\n$$\\begin{align*}x-2&>0\\\\x&>2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p3-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\log_{10}(4-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<4$",
          "worked": "The logarithm requires a positive argument.\n\n$$\\begin{align*}4-x&>0\\\\4&>x\\end{align*}$$\n\nThe domain is $x<4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p3-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\log_8(2x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-2$",
          "worked": "The logarithm requires a positive argument.\n\n$$\\begin{align*}2x+4&>0\\\\2x&>-4\\\\x&>-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\log_{10}\\left(\\frac1x\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>0$",
          "worked": "The reciprocal is undefined at $x=0$. Since its numerator is positive, $\\frac1x$ is positive exactly when $x>0$. The domain is $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p3-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\log_7(\\sqrt x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>0$",
          "worked": "The square root is defined for $x\\ge 0$. The logarithm requires $\\sqrt{x}>0$, so the domain is $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p3-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\log_4(1+x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R$",
          "worked": "For every real $x$, $x^2\\ge 0$ and $1+x^2\\ge 1>0$. The logarithm is therefore defined for all $x\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
