  "content": {
    "id": "p15-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A lightning bolt hits the ground with a tremendous noise. The noise spreads out across the suburbs in a circle of area $A$, startling people.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "The speed of sound in air is about $\\frac{1}{3}$ km/s. Show that the area $A$ in which people are startled as a function of the time $t$ in seconds after the strike is $A=\\frac{\\pi}{9}t^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\pi\\left(\\frac{t}{3}\\right)^2=\\frac{\\pi}{9}t^2$ km².",
          "worked": "Using distance = speed × time,\n$$\\begin{aligned}r&=\\frac{1}{3}t\\\\A&=\\pi r^2\\\\&=\\pi\\left(\\frac{t}{3}\\right)^2\\\\&=\\frac{\\pi}{9}t^2\\text{ km}^2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p15-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the rate at which the area of startled people is increasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{dA}{dt}=\\frac{2\\pi}{9}t$ km²/s.",
          "worked": "$$\\begin{aligned}A&=\\frac{\\pi}{9}t^2\\\\\\frac{dA}{dt}&=\\frac{2\\pi}{9}t\\text{ km}^2/\\text{s}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p15-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "Find, correct to four significant figures, the time when the area is 5 km².",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\sqrt{\\frac{45}{\\pi}}\\approx3.785$ s.",
          "worked": "$$\\begin{aligned}\\frac{\\pi}{9}t^2&=5\\\\t^2&=\\frac{45}{\\pi}\\\\t&=\\sqrt{\\frac{45}{\\pi}}\\\\&\\approx3.785\\text{ s}.\\end{aligned}$$ Take the positive root because $t$ is the time after the strike.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "Find, correct to four significant figures, the rate at which the area is increasing at that time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.642$ km²/s.",
          "worked": "At $t=\\sqrt{\\frac{45}{\\pi}}$,\n$$\\begin{aligned}\\frac{dA}{dt}&=\\frac{2\\pi}{9}\\sqrt{\\frac{45}{\\pi}}\\\\&\\approx2.642\\text{ km}^2/\\text{s}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
