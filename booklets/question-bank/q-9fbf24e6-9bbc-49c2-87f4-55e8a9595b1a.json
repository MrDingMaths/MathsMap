  "content": {
    "id": "p20-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "The ratio of the number of times the pedals are turned on a bicycle to the number of times the rear wheel revolves is called the gear ratio. If the gear ratio is $9:4$, how many times will the rear wheel turn if I pedal:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "72 times?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32$ times.",
          "worked": "Nine pedal turns correspond to four wheel turns.\n\n$$\\begin{align*}\\text{Wheel turns}&=72\\div9\\times4\\\\\\text{Wheel turns}&=8\\times4\\\\\\text{Wheel turns}&=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "108 times?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$ times.",
          "worked": "Nine pedal turns correspond to four wheel turns.\n\n$$\\begin{align*}\\text{Wheel turns}&=108\\div9\\times4\\\\\\text{Wheel turns}&=12\\times4\\\\\\text{Wheel turns}&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "12 times?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\frac{1}{3}$ times.",
          "worked": "Nine pedal turns correspond to four wheel turns.\n\n$$\\begin{align*}\\text{Wheel turns}&=12\\div9\\times4\\\\\\text{Wheel turns}&=\\frac{16}{3}\\\\\\text{Wheel turns}&=5\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
