  "content": {
    "id": "p6-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve these equations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$4=x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm2$",
          "worked": "$$\\begin{align*}x^{2}&=4\\\\x&=\\pm\\sqrt{4}\\\\x&=\\pm2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$-x^{2}+25=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm5$",
          "worked": "$$\\begin{align*}x^{2}&=25\\\\x&=\\pm\\sqrt{25}\\\\x&=\\pm5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$-x^{2}=-100$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm10$",
          "worked": "$$\\begin{align*}x^{2}&=100\\\\x&=\\pm\\sqrt{100}\\\\x&=\\pm10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$-3x^{2}=21x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $-7$",
          "worked": "$$\\begin{align*}-3x^{2}-21x&=0\\\\-3x(x+7)&=0\\\\x&=0\\quad\\text{or}\\quad x+7=0\\\\x&=0\\quad\\text{or}\\quad x=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$-5x^{2}+35x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $7$",
          "worked": "$$\\begin{align*}-5x(x-7)&=0\\\\x&=0\\quad\\text{or}\\quad x-7=0\\\\x&=0\\quad\\text{or}\\quad x=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$1-x^{2}=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm1$",
          "worked": "$$\\begin{align*}x^{2}&=1\\\\x&=\\pm\\sqrt{1}\\\\x&=\\pm1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$12x=18x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $\\dfrac{2}{3}$",
          "worked": "$$\\begin{align*}18x^{2}-12x&=0\\\\6x(3x-2)&=0\\\\x&=0\\quad\\text{or}\\quad 3x-2=0\\\\x&=0\\quad\\text{or}\\quad x=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$2x^{2}+x=7x^{2}-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $\\dfrac{3}{5}$",
          "worked": "$$\\begin{align*}5x^{2}-3x&=0\\\\x(5x-3)&=0\\\\x&=0\\quad\\text{or}\\quad 5x-3=0\\\\x&=0\\quad\\text{or}\\quad x=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$9-2x^{2}=x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\sqrt{3}$",
          "worked": "$$\\begin{align*}3x^{2}&=9\\\\x^{2}&=3\\\\x&=\\pm\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
