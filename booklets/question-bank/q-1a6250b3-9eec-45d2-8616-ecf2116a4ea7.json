            "answer": {
              "short": "$70$",
              "worked": "$$\\begin{aligned}N&={}^{8}C_{4}\\\\&=70\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p57-q6-b",
            "type": "part",
            "label": "b",
            "prompt": "there are two odd numbers and two even numbers,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$36$",
              "worked": "Choose 2 of the 4 odd numbers and 2 of the 4 even numbers.\n$$\\begin{aligned}N&={}^{4}C_{2}\\times{}^{4}C_{2}\\\\&=6\\times6\\\\&=36\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p57-q6-c",
            "type": "part",
            "label": "c",
            "prompt": "there is exactly one odd number,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$16$",
              "worked": "Choose 1 of the 4 odd numbers and 3 of the 4 even numbers.\n$$\\begin{aligned}N&={}^{4}C_{1}\\times{}^{4}C_{3}\\\\&=4\\times4\\\\&=16\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p57-q6-d",
            "type": "part",
            "label": "d",
            "prompt": "all the numbers must be even,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "All four even numbers must be selected.\n$$N={}^{4}C_{4}=1$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p57-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "there is at least one odd number.",
