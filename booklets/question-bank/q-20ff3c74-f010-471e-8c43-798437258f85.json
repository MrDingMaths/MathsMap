  "content": {
    "id": "p33-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Give money answers to the nearest cent and percentage increases to 2 decimal places where needed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q1-a",
        "type": "group",
        "label": "a",
        "prompt": "Christine invested $\\$100\\,000$ for six years at $5\\%$ p.a. interest, compounded annually.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p33-q1-a-i",
            "type": "part",
            "label": "i",
            "prompt": "By multiplying by $1.05$, find the value of the investment after one year.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$105\\,000$",
              "worked": "$$\\begin{align*}A_1&=100\\,000\\times1.05\\\\A_1&=\\$105\\,000\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q1-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "By multiplying by $(1.05)^2$, find the value of the investment after two years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$110\\,250$",
              "worked": "$$\\begin{align*}A_2&=100\\,000\\times(1.05)^2\\\\A_2&=\\$110\\,250\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q1-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "By multiplying by $(1.05)^6$, find the value of the investment after six years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$134\\,009.56$",
              "worked": "$$\\begin{align*}A_6&=100\\,000\\times(1.05)^6\\\\A_6&\\approx\\$134\\,009.56\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q1-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "Find the percentage increase in the investment over the six years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$34.01\\%$",
              "worked": "$$\\begin{align*}\\text{Percentage increase}&=((1.05)^6-1)\\times100\\%\\\\\\text{Percentage increase}&\\approx34.01\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q1-a-v",
            "type": "part",
            "label": "v",
            "prompt": "Find the total interest earned over the six years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$34\\,009.56$",
              "worked": "$$\\begin{align*}I&=100\\,000(1.05)^6-100\\,000\\\\I&\\approx\\$34\\,009.56\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p33-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the simple interest on the principal of $\\$100\\,000$ over the six years at the same rate of $5\\%$ p.a.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$30\\,000$",
          "worked": "$$\\begin{align*}I&=PRT\\\\I&=100\\,000\\times0.05\\times6\\\\I&=\\$30\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
