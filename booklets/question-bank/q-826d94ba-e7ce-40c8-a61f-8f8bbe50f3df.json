  "content": {
    "id": "p35-q28-root",
    "type": "question",
    "label": "28",
    "prompt": "Four-letter codes are formed from the letters of the word EXTENSION. Find the probability that",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q28-a",
        "type": "part",
        "label": "a",
        "prompt": "the code has no vowels.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{126}$",
          "worked": "EXTENSION has four vowel occurrences and five consonant occurrences. Treat the nine letter occurrences as separate choices; the $4!$ ordering factors cancel.\n$$\\begin{align*}P(\\text{no vowels})&=\\frac{\\binom54}{\\binom94}\\\\P(\\text{no vowels})&=\\frac5{126}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p35-q28-b",
        "type": "part",
        "label": "b",
        "prompt": "the code has exactly two vowels.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{21}$",
          "worked": "Choose two of the four vowel occurrences and two of the five consonant occurrences.\n$$\\begin{align*}P(\\text{exactly two vowels})&=\\frac{\\binom42\\binom52}{\\binom94}\\\\P(\\text{exactly two vowels})&=\\frac{6\\times10}{126}\\\\P(\\text{exactly two vowels})&=\\frac{10}{21}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p35-q28-c",
        "type": "part",
        "label": "c",
        "prompt": "exactly one E is chosen.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac59$",
          "worked": "Choose one of the two E occurrences and three of the seven other letter occurrences.\n$$\\begin{align*}P(\\text{exactly one E})&=\\frac{\\binom21\\binom73}{\\binom94}\\\\P(\\text{exactly one E})&=\\frac{2\\times35}{126}\\\\P(\\text{exactly one E})&=\\frac59.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
