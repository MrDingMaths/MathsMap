    "children": [
      {
        "id": "v2-9e3d4-p35-practice-j8-104354-j8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}3x+2y&=12\\\\2x&=y+1\\end{aligned}$$\nRearranging the second equation gives $2x-y=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=3$",
          "worked": "Multiply the rearranged second equation by 2, then add the first equation.\n$$\\begin{align*}4x-2y&=2\\\\(3x+2y)+(4x-2y)&=12+2\\\\7x&=14\\\\x&=2\\end{align*}$$\nSubstitute into $2x-y=1$.\n$$\\begin{align*}2(2)-y&=1\\\\4-y&=1\\\\y&=3\\end{align*}$$\nTherefore $x=2,\\ y=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-9e3d4-p35-practice-j8-104354-j8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}4x+3y+1&=0\\\\3x-2y&=12\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=-3$",
          "worked": "Rearrange the first equation to $4x+3y=-1$. Multiply it by 2 and the second equation by 3, then add.\n$$\\begin{align*}8x+6y&=-2\\\\9x-6y&=36\\\\(8x+6y)+(9x-6y)&=-2+36\\\\17x&=34\\\\x&=2\\end{align*}$$\nSubstitute into the second equation.\n$$\\begin{align*}3(2)-2y&=12\\\\6-2y&=12\\\\-2y&=6\\\\y&=-3\\end{align*}$$\nTherefore $x=2,\\ y=-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      }
    ]
  },
