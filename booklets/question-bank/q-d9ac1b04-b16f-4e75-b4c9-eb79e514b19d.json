  "content": {
    "id": "p22-q4",
    "type": "question",
    "label": "4",
    "prompt": "Write these numbers from largest to smallest.\n\n$$2.41\\times10^{6},\\quad24.2\\times10^{5},\\quad0.239\\times10^{7},\\quad2421\\times10^{3},\\quad0.02\\times10^{8}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2421\\times10^{3},\\ 24.2\\times10^{5},\\ 2.41\\times10^{6},\\ 0.239\\times10^{7},\\ 0.02\\times10^{8}$",
      "worked": "Convert to decimal form to compare the values.\n\n$$\\begin{align*}2.41\\times10^{6}&=2\\,410\\,000\\\\24.2\\times10^{5}&=2\\,420\\,000\\\\0.239\\times10^{7}&=2\\,390\\,000\\\\2421\\times10^{3}&=2\\,421\\,000\\\\0.02\\times10^{8}&=2\\,000\\,000\\end{align*}$$\n\nFrom largest to smallest:\n\n$2421\\times10^{3},\\ 24.2\\times10^{5},\\ 2.41\\times10^{6},\\ 0.239\\times10^{7},\\ 0.02\\times10^{8}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
