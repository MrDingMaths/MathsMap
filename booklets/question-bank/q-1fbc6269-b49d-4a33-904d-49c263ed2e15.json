                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x^8-1&=(x^4-1)(x^4+1)\\\\&=(x^2-1)(x^2+1)(x^4+1)\\\\&=(x-1)(x+1)(x^2+1)(x^4+1)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
