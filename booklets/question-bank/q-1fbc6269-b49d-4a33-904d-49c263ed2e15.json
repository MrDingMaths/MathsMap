  "content": {
    "id": "p70-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Using the fact that $x^2-y^2=(x-y)(x+y)$, factorise the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p70-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^4-16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(x+2)(x^2+4)$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p70-q16-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x^4-16&=(x^2-4)(x^2+4)\\\\&=(x-2)(x+2)(x^2+4)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p70-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-2y)^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2y-3)(x-2y+3)$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p70-q16-b-answer",
                "type": "paragraph",
