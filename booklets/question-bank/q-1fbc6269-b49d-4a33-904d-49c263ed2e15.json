                    "latex": "\\begin{aligned}(x-2y)^2-9&=[x-2y-3][x-2y+3]\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p70-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$4-(x-5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(7-x)(x-3)$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p70-q16-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}4-(x-5)^2&=[2-(x-5)][2+(x-5)]\\\\&=[7-x][x-3]\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
