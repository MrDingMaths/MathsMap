        "answer": {
          "short": "$(x^2+2-2x)(x^2+2+2x)$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p70-q16-g-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x^4+4&=x^4+4+4x^2-4x^2\\\\&=(x^2+2)^2-4x^2\\\\&=(x^2+2-2x)(x^2+2+2x)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
