        "answer": {
          "short": "$(x+y)(x+5y)$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p70-q16-f-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(x+3y)^2-4y^2&=[x+3y-2y][x+3y+2y]\\\\&=[x+y][x+5y]\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p70-q16-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^4+4$ (Hint: add and subtract $4x^2$.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
