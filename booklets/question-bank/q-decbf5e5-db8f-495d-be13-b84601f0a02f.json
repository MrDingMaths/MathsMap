  "content": {
    "id": "p11-q11-response",
    "type": "question",
    "label": "11",
    "prompt": "The side lengths of a square increase from $2\\text{ cm}$ to $3\\text{ cm}$. What is the percentage change in area?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$125\\%$ increase.",
      "worked": "$$\\begin{align*}\\text{Original area}&=2^2=4\\text{ cm}^2\\\\\\text{New area}&=3^2=9\\text{ cm}^2\\\\\\text{Percentage change}&=\\frac{9-4}{4}\\times100\\%\\\\\\text{Percentage change}&=125\\%\\end{align*}$$\nThe area increases by $125\\%$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
