  "content": {
    "id": "p24-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Consider $p=\\frac{\\log_{10}a}{\\log_{10}x}$. Show that $x^p=a$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^p=a$, for $a>0$, $x>0$ and $x\\ne1$.\n\nApply the change-of-base law, then use the definition of a logarithm.",
      "worked": "For $a>0$, $x>0$ and $x\\ne1$,\n$$\\begin{align*}p&=\\log_x a\\\\x^p&=a\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
