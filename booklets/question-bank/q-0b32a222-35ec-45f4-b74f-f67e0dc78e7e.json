        "children": [],
        "answer": {
          "short": "$-3\\log_5 7$",
          "worked": "$$\\begin{align*}\\log_5 7+\\log_5 49-2\\log_5 343&=\\log_5 7+2\\log_5 7-6\\log_5 7\\\\\\log_5 7+\\log_5 49-2\\log_5 343&=-3\\log_5 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
