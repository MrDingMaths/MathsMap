        "prompt": "$\\log_2 7-\\log_2 11+\\log_2 22$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 14$",
          "worked": "$$\\begin{align*}\\log_2 7-\\log_2 11+\\log_2 22&=\\log_2\\left(\\frac{7\\times22}{11}\\right)\\\\\\log_2 7-\\log_2 11+\\log_2 22&=\\log_2 14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-ch14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_3 1000-\\log_3 10-\\log_3 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 20$",
          "worked": "$$\\begin{align*}\\log_3 1000-\\log_3 10-\\log_3 5&=\\log_3\\left(\\frac{1000}{10\\times5}\\right)\\\\\\log_3 1000-\\log_3 10-\\log_3 5&=\\log_3 20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-ch14-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_5 7+\\log_5 49-2\\log_5 343$",
        "layout": "list",
        "columns": null,
