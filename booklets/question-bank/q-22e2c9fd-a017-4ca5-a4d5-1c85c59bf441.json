  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Without calculating either, state which of ${}^{8}C_{2}$ and ${}^{8}C_{6}$ is larger. Justify your answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "They are equal by the identity $\\binom{n}{r}=\\binom{n}{n-r}$.",
      "worked": "They are equal. Choosing 2 objects to include determines the 6 objects left out, so both selections have the same count:\n\n$$\\binom{8}{2}=\\binom{8}{8-2}=\\binom{8}{6}.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 14
  },
