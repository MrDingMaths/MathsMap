    "type": "question",
    "label": "9",
    "prompt": "A cylinder has radius $4\\text{ m}$ and height $h$. The total surface area of the cylinder is $128\\pi\\text{ m}^2$.\n\nWork out the value of $h$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$h=12\\text{ m}$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
