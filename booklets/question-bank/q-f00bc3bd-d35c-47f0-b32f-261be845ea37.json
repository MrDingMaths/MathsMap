  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": "10",
    "prompt": "Marta has a chocolate bar. She eats $\\frac{2}{3}$ of the chocolate bar and gives her friend $\\frac{1}{6}$ of it.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the chocolate bar has Marta eaten or given away?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{6}$",
          "worked": "The total fraction eaten or given away is\n$$\\begin{align*}\\frac{2}{3}+\\frac{1}{6}&=\\frac{4}{6}+\\frac{1}{6}\\\\&=\\frac{5}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the chocolate bar is left?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "The fraction left is\n$$\\begin{align*}1-\\frac{5}{6}&=\\frac{6}{6}-\\frac{5}{6}\\\\&=\\frac{1}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
