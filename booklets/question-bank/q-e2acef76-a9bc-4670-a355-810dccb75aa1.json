  "content": {
    "id": "p53-q9",
    "type": "question",
    "label": "9",
    "prompt": "A rugby player has mass 105 kg. His doctor advises him to lose 15% of his mass.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Work out the mass of the rugby player if he succeeds in losing 15% of his mass.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$89.25\\text{ kg}$",
          "worked": "$$\\begin{align*}\\text{Mass lost}&=\\frac{15}{100}\\times105=15.75\\text{ kg}\\\\\\text{Final mass}&=105-15.75=89.25\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p53-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "The rugby player actually loses 12 kg. What percentage of his mass has he lost? Give your answer to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11.43\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Final mass}&=105-12=93\\text{ kg}\\\\\\text{Change}&=93-105=-12\\text{ kg}\\\\\\text{Percentage change}&=\\frac{-12}{105}\\times100\\%\\\\\\text{Percentage change}&\\approx-11.43\\%\\end{align*}$$\nHe lost $11.43\\%$ of his original mass.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
