  "content": {
    "id": "p14-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Mary has twice as much to spend as Jane, and Sarah has $\\$5$ less than Jane. If their spending money totals $\\$75$, then how much does Jane have to spend?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$20$",
      "worked": "Let Jane have $x$ dollars. Mary has $2x$ dollars and Sarah has $(x-5)$ dollars.\n$$\\begin{align*}2x+x+(x-5)&=75\\\\4x-5&=75\\\\4x&=80\\\\x&=20\\end{align*}$$\nJane has $\\$20$ to spend.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
