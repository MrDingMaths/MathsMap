  "content": {
    "id": "p26-q39-root",
    "type": "question",
    "label": "39",
    "prompt": "Let $y=4e^x-x$. Find the value(s) of $x$ for which the gradient of the tangent to the curve is equal to $1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-\\ln2$",
      "worked": "The tangent gradient is $y'=4e^x-1$. Set $y'=1$.\n$$\\begin{align*}\n4e^x-1&=1\\\\\n4e^x&=2\\\\\ne^x&=\\frac12\\\\\nx&=\\ln\\left(\\frac12\\right)=-\\ln2\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
