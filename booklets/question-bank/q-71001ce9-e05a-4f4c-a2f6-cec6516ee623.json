        "children": [],
        "answer": {
          "short": "$x=4,\\ y=6$.",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}2x&=8\\\\x&=4\\\\4+y&=10\\\\y&=6.\\end{align*}$$",
