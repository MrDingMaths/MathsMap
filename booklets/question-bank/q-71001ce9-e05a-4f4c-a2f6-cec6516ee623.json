        "prompt": "$$\\begin{aligned}5x+2y&=43\\\\x-y&=3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7,\\ y=4$.",
          "worked": "Multiply the second equation by $2$ and add it to the first.\n$$\\begin{align*}2x-2y&=6\\\\7x&=49\\\\x&=7\\\\7-y&=3\\\\y&=4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p30-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}5x-2y&=37\\\\3x-2y&=23\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7,\\ y=-1$.",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}2x&=14\\\\x&=7\\\\3(7)-2y&=23\\\\-2y&=2\\\\y&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p30-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}4x+3y&=26\\\\3x-2y&=11\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5,\\ y=2$.",
          "worked": "Multiply the first equation by $2$ and the second by $3$, then add.\n$$\\begin{align*}8x+6y&=52\\\\9x-6y&=33\\\\17x&=85\\\\x&=5\\\\3(5)-2y&=11\\\\-2y&=-4\\\\y&=2.\\end{align*}$$",
