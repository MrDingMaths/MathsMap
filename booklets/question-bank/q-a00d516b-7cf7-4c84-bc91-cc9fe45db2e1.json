  "content": {
    "id": "v2-4fcf45866fe981-p35-retro-slot-3-223657-root",
    "type": "question",
    "label": null,
    "prompt": "Find the distance travelled in each situation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4fcf45866fe981-p35-retro-slot-3-223657-retro-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "A bicycle wheel has a radius of 35 cm. How far does the bicycle travel when the wheel turns through $2430^{\\circ}$? Give your answer in metres rounded to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14.84\\text{ m}$",
          "worked": "$$\\begin{align*}r&=\\frac{35}{100}=0.35\\text{ m}\\\\\\text{Revolutions}&=\\frac{2430}{360}=6.75\\\\\\text{Distance}&=6.75\\times2\\pi r\\\\\\text{Distance}&=6.75\\times2\\pi\\times0.35\\\\\\text{Distance}&=4.725\\pi\\text{ m}\\\\\\text{Distance}&\\approx14.84\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-4fcf45866fe981-p35-retro-slot-3-223657-retro-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "A seat on a merry-go-round is 4.5 m from the centre. How far does the seat travel when the merry-go-round turns through $1890^{\\circ}$? Give your answer in metres rounded to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$148.4\\text{ m}$",
          "worked": "$$\\begin{align*}\\text{Revolutions}&=\\frac{1890}{360}=5.25\\\\\\text{Distance}&=5.25\\times2\\pi r\\\\\\text{Distance}&=5.25\\times2\\pi\\times4.5\\\\\\text{Distance}&=47.25\\pi\\text{ m}\\\\\\text{Distance}&\\approx148.4\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
