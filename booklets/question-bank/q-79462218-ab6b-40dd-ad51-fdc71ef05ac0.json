  "content": {
    "id": "p6-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The interval $AB$ joins the points $A(1,6)$ and $B(3,-8)$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "the distance $AB$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\sqrt{2}$",
          "worked": "$$\\begin{align*}AB&=\\sqrt{(3-1)^2+(-8-6)^2}\\\\AB&=\\sqrt{4+196}\\\\AB&=\\sqrt{200}\\\\AB&=10\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p6-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "the midpoint of $AB$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,-1)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{1+3}{2},\\frac{6+(-8)}{2}\\right)\\\\M&=(2,-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "the equation of the circle with diameter $AB$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2+(y+1)^2=50$\n\nThe centre is the midpoint of $AB$ and the radius is half $AB$.",
          "worked": "The centre is $(2,-1)$ and the radius is half the diameter.\n$$\\begin{align*}r&=\\frac{10\\sqrt{2}}{2}\\\\r&=5\\sqrt{2}\\\\r^2&=50\\end{align*}$$\nUsing $(x-h)^2+(y-k)^2=r^2$:\n$$(x-2)^2+(y+1)^2=50.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
