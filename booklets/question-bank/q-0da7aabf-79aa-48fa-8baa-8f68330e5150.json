  "content": {
    "id": "p34-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "From the letters of the word ALGEBRAIC, five letters are chosen and arranged in a circle. How many ways can this be done?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
