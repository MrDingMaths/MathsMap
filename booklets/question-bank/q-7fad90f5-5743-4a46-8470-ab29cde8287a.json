    "id": "v2-5fec1-p29-practice-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "Zara rides to the beach in three stages. She rides $1\\frac{1}{2}$ km along the river, $2\\frac{2}{3}$ km through the park and $3\\frac{3}{4}$ km along the coast.\nWhat is the total distance that Zara rides?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7\\frac{11}{12}\\text{ km}$",
      "worked": "$$\\begin{align*}1\\frac{1}{2}+2\\frac{2}{3}+3\\frac{3}{4}&=\\frac{3}{2}+\\frac{8}{3}+\\frac{15}{4}\\\\&=\\frac{18}{12}+\\frac{32}{12}+\\frac{45}{12}\\\\&=\\frac{95}{12}\\\\&=7\\frac{11}{12}\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
