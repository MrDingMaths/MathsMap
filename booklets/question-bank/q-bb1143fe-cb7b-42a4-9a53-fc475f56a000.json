    "type": "question",
    "label": "12",
    "prompt": "If $x=1$, $y=3$, $z=5$ and $w=0$, find the exact value of $\\sqrt{3xy}+\\sqrt{3xz}+\\sqrt{3wy}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3+\\sqrt{15}$",
      "worked": "$$\\begin{align*}\\sqrt{3xy}+\\sqrt{3xz}+\\sqrt{3wy}&=\\sqrt{3\\times1\\times3}+\\sqrt{3\\times1\\times5}+\\sqrt{3\\times0\\times3}\\\\\\sqrt{3xy}+\\sqrt{3xz}+\\sqrt{3wy}&=\\sqrt{9}+\\sqrt{15}+\\sqrt{0}\\\\\\sqrt{3xy}+\\sqrt{3xz}+\\sqrt{3wy}&=3+\\sqrt{15}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
