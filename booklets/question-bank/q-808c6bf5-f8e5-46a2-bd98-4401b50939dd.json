        "id": "p15-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$$P(X=x)=\\begin{cases}0.7&\\text{for }x=1\\\\0.3&\\text{for }x=0\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=0.7$, $\\operatorname{Var}(X)=0.21$",
          "worked": "$$E(X)=p=0.7$$\n\n$$\\begin{aligned}\\operatorname{Var}(X)&=p(1-p)\\\\\\operatorname{Var}(X)&=0.7(0.3)\\\\\\operatorname{Var}(X)&=0.21\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$$P(X=x)=\\begin{cases}\\frac{14}{15}&\\text{for }x=1\\\\\\frac{1}{15}&\\text{for }x=0\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=\\frac{14}{15}$, $\\operatorname{Var}(X)=\\frac{14}{225}$",
          "worked": "$$E(X)=p=\\frac{14}{15}$$\n\n$$\\begin{aligned}\\operatorname{Var}(X)&=p(1-p)\\\\\\operatorname{Var}(X)&=\\frac{14}{15}\\left(\\frac{1}{15}\\right)\\\\\\operatorname{Var}(X)&=\\frac{14}{225}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p15-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$p(x)=\\frac{x+1}{3}$ for $x=0,1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=\\frac{2}{3}$, $\\operatorname{Var}(X)=\\frac{2}{9}$",
          "worked": "$$p=P(X=1)=\\frac{1+1}{3}=\\frac{2}{3}$$\n\n$$E(X)=p=\\frac{2}{3}$$\n\n$$\\begin{aligned}\\operatorname{Var}(X)&=p(1-p)\\\\\\operatorname{Var}(X)&=\\frac{2}{3}\\left(\\frac{1}{3}\\right)\\\\\\operatorname{Var}(X)&=\\frac{2}{9}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
