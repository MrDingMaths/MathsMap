  "content": {
    "id": "p26-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Let $x=\\log(a)$, $y=\\log(b)$ and $z=\\log(c)$. Express the following in terms of $x$, $y$ and $z$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log\\!\\left(\\frac{a}{b^2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2y$",
          "worked": "$$\\begin{align*}\\log\\!\\left(\\frac{a}{b^2}\\right)&=\\log(a)-\\log(b^2)\\\\\\log\\!\\left(\\frac{a}{b^2}\\right)&=\\log(a)-2\\log(b)\\\\\\log\\!\\left(\\frac{a}{b^2}\\right)&=x-2y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log\\!\\left(\\sqrt{b^2c}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(2y+z)$",
          "worked": "$$\\begin{align*}\\log\\!\\left(\\sqrt{b^2c}\\right)&=\\frac12\\log(b^2c)\\\\\\log\\!\\left(\\sqrt{b^2c}\\right)&=\\frac12\\bigl(\\log(b^2)+\\log(c)\\bigr)\\\\\\log\\!\\left(\\sqrt{b^2c}\\right)&=\\frac12\\bigl(2\\log(b)+\\log(c)\\bigr)\\\\\\log\\!\\left(\\sqrt{b^2c}\\right)&=\\frac12(2y+z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
