  "content": {
    "id": "p48-q9",
    "type": "question",
    "label": "9",
    "prompt": "An Australian banker bought plane tickets worth \\$1500 to go to a conference related to banking. The company reimbursed him for this purchase. Explain why this is not an allowable tax deduction.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "For an expense to be tax-deductible, the taxpayer must have personally incurred the expense without reimbursement.",
      "worked": "The company reimbursed him, so he did not personally bear the expense. An allowable work-related deduction must be paid by the taxpayer without reimbursement.",
      "solutionDiagrams": []
    },
