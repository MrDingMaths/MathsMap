  "content": {
    "id": "p33-q9-root",
    "type": "question",
    "label": null,
    "prompt": "Find the magnitude of $\\underset{\\sim}{a}$ in the direction of $\\underset{\\sim}{b}$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=-2\\mathbf{i},\\quad \\underset{\\sim}{b}=-3\\mathbf{i}-2\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6}{\\sqrt{13}}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=(-2)(-3)+0(-2)=6\\\\|\\underset{\\sim}{b}|&=\\sqrt{(-3)^2+(-2)^2}=\\sqrt{13}\\\\\\left|\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}\\right|&=\\frac{|6|}{\\sqrt{13}}=\\frac{6}{\\sqrt{13}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p33-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{a}=6\\mathbf{i}-4\\mathbf{j},\\quad \\underset{\\sim}{b}=-3\\mathbf{i}+6\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{14}{\\sqrt{5}}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=6(-3)+(-4)(6)\\\\\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=-18-24=-42\\\\|\\underset{\\sim}{b}|&=\\sqrt{45}=3\\sqrt{5}\\\\\\left|\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}\\right|&=\\frac{|-42|}{3\\sqrt{5}}=\\frac{14}{\\sqrt{5}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
