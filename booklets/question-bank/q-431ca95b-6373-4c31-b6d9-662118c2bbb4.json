  "content": {
    "id": "p36-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A new car is valued at $\\$26\\,000$. It is estimated to depreciate by $12\\%$ each year. Give monetary answers to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Find its depreciated value after five years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$13\\,721.03$",
          "worked": "Using $A_n=P(1-R)^n$,\n$$\\begin{align*}A_5&=26\\,000(1-0.12)^5\\\\A_5&=26\\,000(0.88)^5\\\\A_5&\\approx\\$13\\,721.03.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p36-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Find its depreciated value after 10 years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$7241.03$",
          "worked": "$$\\begin{align*}A_{10}&=26\\,000(1-0.12)^{10}\\\\A_{10}&=26\\,000(0.88)^{10}\\\\A_{10}&\\approx\\$7241.03.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p36-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the first whole number of years after which its depreciated value is below $\\$11\\,000$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$ years.\n\nThe value is above $\\$11\\,000$ after six years and below it after seven years.",
          "worked": "Evaluate $A_n=26\\,000(0.88)^n$ for successive whole years, keeping unrounded values in the calculator. Near the threshold:\n$$\\begin{align*}A_6&=26\\,000(0.88)^6\\\\A_6&\\approx\\$12\\,074.51\\\\A_7&=26\\,000(0.88)^7\\\\A_7&\\approx\\$10\\,625.57.\\end{align*}$$\nThe value decreases each year. Since $A_6>11\\,000$ and $A_7<11\\,000$, the first whole number of years is $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
