    "type": "question",
    "label": "9",
    "prompt": "If I spend one-third of my money, then one-quarter of what is left, and finally one-fifth of the remainder, what fraction of my original money do I have left?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{5}$",
      "worked": "The fractions retained after the three purchases are $\\frac{2}{3}$, $\\frac{3}{4}$ and $\\frac{4}{5}$, respectively.\n$$\\begin{align*}\\text{Fraction remaining}&=\\frac{2}{3}\\times\\frac{3}{4}\\times\\frac{4}{5}\\\\\\text{Fraction remaining}&=\\frac{2\\times3\\times4}{3\\times4\\times5}\\\\\\text{Fraction remaining}&=\\frac{2}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
