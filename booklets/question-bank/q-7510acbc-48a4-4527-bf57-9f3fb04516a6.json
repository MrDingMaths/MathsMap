    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the solutions to the equation $(x-1)(x-2)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $x=2$.",
          "worked": "At least one factor must be zero.\n\n$$\\begin{aligned}x-1&=0&\\text{or}\\quad x-2&=0\\\\x&=1&\\text{or}\\quad x&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p9-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the domain of $f(x)=\\dfrac{1}{(x-1)(x-2)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R\\setminus\\{1,2\\}$",
          "worked": "The denominator is zero at $x=1$ and $x=2$, so these values are excluded.\n\nDomain: $\\mathbb R\\setminus\\{1,2\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p9-q9-c",
        "type": "group",
        "label": "c",
        "prompt": "Using a similar technique, find the domain of the following functions.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q9-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$f(x)=\\dfrac{1}{(x+1)(x-3)}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x\\in\\mathbb R\\setminus\\{-1,3\\}$",
              "worked": "Find where the denominator is zero:\n\n$$\\begin{aligned}x+1&=0&\\text{or}\\quad x-3&=0\\\\x&=-1&\\text{or}\\quad x&=3\\end{aligned}$$\nDomain: $\\mathbb R\\setminus\\{-1,3\\}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p9-q9-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$f(x)=\\dfrac{1}{(2x-1)(3x-1)}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x\\in\\mathbb R\\setminus\\left\\{\\dfrac12,\\dfrac13\\right\\}$",
              "worked": "Find where the denominator is zero:\n\n$$\\begin{aligned}2x-1&=0&\\text{or}\\quad 3x-1&=0\\\\x&=\\frac12&\\text{or}\\quad x&=\\frac13\\end{aligned}$$\nDomain: $\\mathbb R\\setminus\\left\\{\\frac12,\\frac13\\right\\}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p9-q9-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$f(x)=\\dfrac{x}{x^2-4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x\\in\\mathbb R\\setminus\\{-2,2\\}$",
              "worked": "Find where the denominator is zero:\n\n$$\\begin{align*}x^2-4&=0\\\\(x-2)(x+2)&=0\\end{align*}$$\nThus $x=2$ or $x=-2$ is excluded.\n\nDomain: $\\mathbb R\\setminus\\{-2,2\\}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p9-q9-c-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$f(x)=\\dfrac{x^2-1}{x^2-4x+3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x\\in\\mathbb R\\setminus\\{1,3\\}$\n\nExclude zeros of the original denominator even if a factor cancels.",
              "worked": "Find where the original denominator is zero:\n\n$$\\begin{align*}x^2-4x+3&=0\\\\(x-1)(x-3)&=0\\end{align*}$$\nThus $x=1$ and $x=3$ are excluded. Cancelling a factor does not restore an excluded input.\n\nDomain: $\\mathbb R\\setminus\\{1,3\\}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      }
    ]
  },
