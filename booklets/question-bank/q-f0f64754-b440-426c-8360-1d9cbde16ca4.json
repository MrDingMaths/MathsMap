      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\left(\\sin^{-1}(0)-\\cos^{-1}\\left(\\frac12\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{aligned}\\sin^{-1}(0)&=0\\\\\\cos^{-1}\\left(\\frac12\\right)&=\\frac\\pi3\\end{aligned}$$\n$$\\begin{aligned}\\cos\\left(0-\\frac\\pi3\\right)&=\\cos\\left(-\\frac\\pi3\\right)\\\\&=\\cos\\left(\\frac\\pi3\\right)\\\\&=\\frac12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\left(\\sin^{-1}(1)+\\sin^{-1}\\left(\\frac12\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sqrt3$",
          "worked": "$$\\begin{aligned}\\sin^{-1}(1)&=\\frac\\pi2\\\\\\sin^{-1}\\left(\\frac12\\right)&=\\frac\\pi6\\end{aligned}$$\n$$\\begin{aligned}\\tan\\left(\\frac\\pi2+\\frac\\pi6\\right)&=\\tan\\left(\\frac{2\\pi}3\\right)\\\\&=-\\sqrt3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos\\left(\\cos^{-1}\\left(-\\frac12\\right)-\\sin^{-1}\\left(-\\frac12\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\sqrt3}{2}$",
          "worked": "$$\\begin{aligned}\\cos^{-1}\\left(-\\frac12\\right)&=\\frac{2\\pi}3\\\\\\sin^{-1}\\left(-\\frac12\\right)&=-\\frac\\pi6\\end{aligned}$$\n$$\\begin{aligned}\\cos\\left(\\frac{2\\pi}3-\\left(-\\frac\\pi6\\right)\\right)&=\\cos\\left(\\frac{2\\pi}3+\\frac\\pi6\\right)\\\\&=\\cos\\left(\\frac{5\\pi}6\\right)\\\\&=-\\frac{\\sqrt3}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\left(\\tan^{-1}\\left(-\\frac1{\\sqrt3}\\right)-\\tan^{-1}(-\\sqrt3)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{aligned}\\tan^{-1}\\left(-\\frac1{\\sqrt3}\\right)&=-\\frac\\pi6\\\\\\tan^{-1}(-\\sqrt3)&=-\\frac\\pi3\\end{aligned}$$\n$$\\begin{aligned}\\sin\\left(-\\frac\\pi6-\\left(-\\frac\\pi3\\right)\\right)&=\\sin\\left(-\\frac\\pi6+\\frac\\pi3\\right)\\\\&=\\sin\\left(\\frac\\pi6\\right)\\\\&=\\frac12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
