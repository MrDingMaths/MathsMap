  "content": {
    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $g(x)=\\frac{5+x}{5-x}$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}g(0)&=\\frac{5+0}{5-0}\\\\g(0)&=\\frac55\\\\g(0)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}g(-5)&=\\frac{5+(-5)}{5-(-5)}\\\\g(-5)&=\\frac0{10}\\\\g(-5)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6$",
          "worked": "$$\\begin{align*}g(7)&=\\frac{5+7}{5-7}\\\\g(7)&=\\frac{12}{-2}\\\\g(7)&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac32$",
          "worked": "$$\\begin{align*}g(1)&=\\frac{5+1}{5-1}\\\\g(1)&=\\frac64\\\\g(1)&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p13-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$g\\left(\\frac52\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}g\\left(\\frac52\\right)&=\\frac{5+\\frac52}{5-\\frac52}\\\\g\\left(\\frac52\\right)&=\\frac{15/2}{5/2}\\\\g\\left(\\frac52\\right)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p13-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$g\\left(-\\frac52\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "$$\\begin{align*}g\\left(-\\frac52\\right)&=\\frac{5-\\frac52}{5+\\frac52}\\\\g\\left(-\\frac52\\right)&=\\frac{5/2}{15/2}\\\\g\\left(-\\frac52\\right)&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
