  "content": {
    "id": "p9-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "There are 100 terms in an arithmetic sequence whose sum is 20 300. The first term is 5. What is the last term?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$401$",
      "worked": "Let $l$ be the last term. Using $S_n=n\\left(\\dfrac{a+l}{2}\\right)$,\n$$\\begin{align*}20\\,300 &= 100\\left(\\frac{5+l}{2}\\right)\\\\406 &= 5+l\\\\l &= 401.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
