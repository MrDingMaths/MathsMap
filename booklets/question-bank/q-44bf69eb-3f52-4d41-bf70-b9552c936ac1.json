  "content": {
    "id": "p17-q13-root",
    "type": "question",
    "label": null,
    "prompt": "A deck of twenty cards numbered 1 through 20 is shuffled, and a card is drawn from the deck. Let $A$ be the event that an odd number is drawn and $B$ be the event that a prime number is drawn. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\Pr(B\\mid A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{10}$",
          "worked": "There are 10 odd numbers from 1 through 20. Of these, 7 are prime: $3,5,7,11,13,17,19$.\n\n$$\\begin{align*}\\Pr(B\\mid A)&=\\frac{n(A\\cap B)}{n(A)}\\\\\\Pr(B\\mid A)&=\\frac{7}{10}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\Pr(A\\mid B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{8}$",
          "worked": "There are 8 primes from 1 through 20: $2,3,5,7,11,13,17,19$. All except 2 are odd.\n\n$$\\begin{align*}\\Pr(A\\mid B)&=\\frac{n(A\\cap B)}{n(B)}\\\\\\Pr(A\\mid B)&=\\frac{7}{8}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
