    "children": [
      {
        "id": "p18-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the size of each exterior angle of a regular octagon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45^{\\circ}$",
          "worked": "$$\\begin{aligned}E&=\\frac{360^{\\circ}}{8}\\\\&=45^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the exterior angle to find the size of the interior angle. Give a reason for the answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$135^{\\circ}$; the interior and exterior angles at each vertex are supplementary.",
          "worked": "The interior and exterior angles at each vertex sum to $180^{\\circ}$.\n$$\\begin{aligned}I&=180^{\\circ}-45^{\\circ}\\\\&=135^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p18-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the angle sum of an octagon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1080^{\\circ}$",
          "worked": "$$\\begin{aligned}S&=8\\times135^{\\circ}\\\\&=1080^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
