  "content": {
    "id": "p25-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Simplify the following. Assume $a$ and $b$ are positive.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{a^{2}b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a\\sqrt{b}$",
          "worked": "$$\\begin{align*}\\sqrt{a^{2}b}&=\\sqrt{a^{2}}\\times\\sqrt{b}\\\\&=a\\sqrt{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{a^{4}b^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{2}b$",
          "worked": "$$\\begin{align*}\\sqrt{a^{4}b^{2}}&=\\sqrt{a^{4}}\\times\\sqrt{b^{2}}\\\\&=a^{2}b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[3]{a^{6}b^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{2}b$",
          "worked": "$$\\begin{align*}\\sqrt[3]{a^{6}b^{3}}&=\\sqrt[3]{a^{6}}\\times\\sqrt[3]{b^{3}}\\\\&=a^{2}b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{a^{5}b^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{2}b\\sqrt{ab}$",
          "worked": "$$\\begin{align*}\\sqrt{a^{5}b^{3}}&=\\sqrt{a^{4}b^{2}\\times ab}\\\\&=\\sqrt{a^{4}b^{2}}\\times\\sqrt{ab}\\\\&=a^{2}b\\sqrt{ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
