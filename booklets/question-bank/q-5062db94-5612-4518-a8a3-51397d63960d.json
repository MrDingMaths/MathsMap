  "content": {
    "id": "v2-8424b-p43-practice-j15-214331-root",
    "type": "question",
    "label": null,
    "prompt": "Jess takes $20$ shots at goal in netball. Find the mean and variance of the number of goals she scores when the probability of scoring each shot is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8424b-p43-practice-j15-214331-j15-a",
        "type": "part",
        "label": "a",
        "prompt": "$0.2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mean $4$ goals, variance $3.2$",
          "worked": "$$\\begin{align*}E(X)&=np\\\\E(X)&=20(0.2)\\\\E(X)&=4\\\\\\operatorname{Var}(X)&=np(1-p)\\\\\\operatorname{Var}(X)&=20(0.2)(0.8)\\\\\\operatorname{Var}(X)&=3.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-8424b-p43-practice-j15-214331-j15-b",
        "type": "part",
