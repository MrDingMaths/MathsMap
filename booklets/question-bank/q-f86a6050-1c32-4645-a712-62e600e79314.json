  "content": {
    "id": "p81-q51-response",
    "type": "question",
    "label": null,
    "prompt": "Given the cubic function $f(x)$ has a triple root at $x=3$, and the graph of $y=f(x)$ goes through $(2,3)$, find $f(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(x)=-3(x-3)^3$.",
      "worked": "The triple root gives $f(x)=k(x-3)^3$.\n\nSubstitute $(2,3)$:\n$$\\begin{align*}k(2-3)^3&=3\\\\-k&=3\\\\k&=-3\\end{align*}$$\nHence, $f(x)=-3(x-3)^3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
