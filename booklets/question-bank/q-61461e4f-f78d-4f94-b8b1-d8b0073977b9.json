    "type": "question",
    "label": "5",
    "prompt": "Differentiate $f(x)=ax^2+bx+c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(x)=2ax+b$",
      "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{a(x+h)^2+b(x+h)+c-(ax^2+bx+c)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2axh+ah^2+bh}{h}\\\\f'(x)&=\\lim_{h\\to0}(2ax+ah+b)\\\\f'(x)&=2ax+b\\end{align*}$$",
      "solutionDiagrams": []
    },
