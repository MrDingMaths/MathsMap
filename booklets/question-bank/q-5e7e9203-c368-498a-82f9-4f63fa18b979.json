  "content": {
    "id": "p5-q8-root",
    "type": "question",
    "label": null,
    "prompt": "A straight slide is $3.5\\text{ m}$ long and has a vertical ladder $2.1\\text{ m}$ high. Find the angle the slide makes with the ground, giving your answer to the nearest degree.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$37^\\circ$",
      "worked": "Let $\\theta$ be the angle the slide makes with the ground. The slide is the hypotenuse.\n$$\\begin{align*}\\sin\\theta&=\\frac{2.1}{3.5}\\\\\\theta&=\\sin^{-1}\\left(\\frac{2.1}{3.5}\\right)\\\\\\theta&\\approx37^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 37
  },
