  "content": {
    "id": "p60-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "In simple spring theory, the change in length $x$ of a spring varies directly with the mass $m$ hung from it.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=km$.",
          "worked": "Direct variation has the form $x=km$, where $k$ is the constant of proportionality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p60-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "For a certain spring, $x=2\\text{ cm}$ when $m=3\\text{ kg}$. Evaluate $k$, giving its units in your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac{2}{3}\\text{ cm/kg}$.",
          "worked": "$$\\begin{align*}2&=3k\\\\k&=\\frac{2}{3}\\text{ cm/kg}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p60-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "What will be the change in length of the spring when $m=4.5\\text{ kg}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\text{ cm}$.",
          "worked": "$$\\begin{align*}x&=\\frac{2}{3}\\times4.5\\\\x&=3\\text{ cm}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p60-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "What happens to $x$ when the mass is doubled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$ doubles.",
          "worked": "Replacing $m$ by $2m$ gives $k(2m)=2(km)=2x$, so the change in length doubles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
