    "children": [
      {
        "id": "p14-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the prime factorisation of $270$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$270=2\\times3^3\\times5$.",
          "worked": "$$\\begin{align*}270&=2\\times135\\\\270&=2\\times3\\times45\\\\270&=2\\times3\\times3\\times15\\\\270&=2\\times3\\times3\\times3\\times5\\\\270&=2\\times3^3\\times5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p14-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the least positive integer $n$ for which $270n$ is a perfect square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=30$.\n\nMultiply by $2\\times3\\times5$ to make every prime exponent even.",
          "worked": "$$270n=2\\times3^3\\times5\\times n.$$ Every prime exponent must be even. The least additional factor is $2\\times3\\times5$.\n\n$$\\begin{align*}n&=2\\times3\\times5\\\\n&=30\\\\270\\times30&=2^2\\times3^4\\times5^2\\\\270\\times30&=90^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p14-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the least positive integer $n$ for which $\\frac{270}{n}$ is a perfect square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=30$.\n\nThe largest square factor of $270$ is $3^2=9$, so $n=270\\div9$.",
          "worked": "Write $\\frac{270}{n}=k^2$, so $270=nk^2$. To minimise $n$, use the largest square factor of $270=2\\times3^3\\times5$. This is $k^2=3^2=9$.\n\n$$\\begin{align*}n&=\\frac{270}{9}\\\\n&=30\\\\\\frac{270}{30}&=9\\\\\\frac{270}{30}&=3^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
