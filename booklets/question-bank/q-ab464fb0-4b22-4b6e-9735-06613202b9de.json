    "type": "question",
    "label": "31",
    "prompt": "Rationalise the denominator of $\\dfrac1{\\sqrt{1+\\sqrt2}}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt{\\sqrt2-1}$.\n\nMultiply numerator and denominator by $\\sqrt{\\sqrt2-1}$.",
      "worked": "$$\\begin{align*}\\frac1{\\sqrt{1+\\sqrt2}}&=\\frac{\\sqrt{\\sqrt2-1}}{\\sqrt{1+\\sqrt2}\\sqrt{\\sqrt2-1}}\\\\\\frac1{\\sqrt{1+\\sqrt2}}&=\\frac{\\sqrt{\\sqrt2-1}}{\\sqrt{(1+\\sqrt2)(\\sqrt2-1)}}\\\\\\frac1{\\sqrt{1+\\sqrt2}}&=\\frac{\\sqrt{\\sqrt2-1}}{\\sqrt{2-1}}\\\\\\frac1{\\sqrt{1+\\sqrt2}}&=\\sqrt{\\sqrt2-1}.\\end{align*}$$",
      "solutionDiagrams": []
    },
