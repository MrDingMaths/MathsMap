                "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 8, p8-f1-a-right\"}\n\\begin{tikzpicture}[x=2.4cm,y=2.4cm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (1,0);\n\\coordinate (C) at (1,1);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.4pt] ($(B)!2.5mm!(A)$)--($($(B)!2.5mm!(A)$)+($(B)!2.5mm!(C)$)-(B)$)--($(B)!2.5mm!(C)$);\n\\pic[draw=black,line width=0.4pt,angle radius=6mm] {angle=B--A--C};\n\\pic[draw=black,line width=0.4pt,angle radius=6mm] {angle=A--C--B};\n\\node at ($(A)+(22.5:9mm)$) {$45^\\circ$};\n\\node at ($(C)+(247.5:9mm)$) {$45^\\circ$};\n\\path (A)--node[midway,below] {$1$} (B);\n\\path (B)--node[midway,right] {$1$} (C);\n\\end{tikzpicture}",
                "src": null,
                "widthMm": 48,
                "alt": "Mathematical diagram",
                "overlayOf": null,
                "transparent": false,
                "axes": null,
                "spec": {
                  "sourcePage": 8,
                  "sourceRegion": "Fundamentals 1(a), right triangle",
                  "description": "Unshaded isosceles right triangle beside the 30°–60° triangle, with the same baseline orientation. Both perpendicular sides are labelled 1; the hypotenuse is unlabelled. Both acute angles are labelled 45°.",
                  "mathematics": "Two perpendicular sides of length 1; missing hypotenuse.",
                  "answerVisibility": "The hypotenuse length is absent in the question."
                },
                "derived": false,
                "reviewStatus": "needs-review"
              }
            ],
            "children": [],
            "answer": {
              "short": "$\\sqrt2$",
              "worked": "Let $h$ be the missing hypotenuse. By Pythagoras,\n$$\\begin{align*}h^2&=1^2+1^2\\\\h^2&=2\\\\h&=\\sqrt2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16,
            "responseSpace": "scaffold"
          }
