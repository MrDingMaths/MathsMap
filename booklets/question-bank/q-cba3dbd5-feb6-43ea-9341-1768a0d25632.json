              {
                "id": "p8-f1-a-left",
                "role": "question",
                "format": "tikz",
                "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 8, p8-f1-a-left\"}\n\\begin{tikzpicture}[x=2.4cm,y=2.4cm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at ({sqrt(3)},0);\n\\coordinate (C) at ({sqrt(3)},1);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.4pt] ($(B)!2.5mm!(A)$)--($($(B)!2.5mm!(A)$)+($(B)!2.5mm!(C)$)-(B)$)--($(B)!2.5mm!(C)$);\n\\pic[draw=black,line width=0.4pt,angle radius=8mm] {angle=B--A--C};\n\\pic[draw=black,line width=0.4pt,angle radius=6mm] {angle=A--C--B};\n\\node at ($(A)+(15:11mm)$) {$30^\\circ$};\n\\node at ($(C)+(240:9mm)$) {$60^\\circ$};\n\\path (A)--node[midway,above,sloped] {$2$} (C);\n\\path (B)--node[midway,right] {$1$} (C);\n\\end{tikzpicture}",
                "src": null,
                "widthMm": 70,
                "alt": "Mathematical diagram",
                "overlayOf": null,
                "transparent": false,
                "axes": null,
                "spec": {
                  "sourcePage": 8,
                  "sourceRegion": "Fundamentals 1(a), left triangle",
                  "description": "Unshaded right triangle with a horizontal unlabelled base, vertical right side 1, hypotenuse 2, angles 30° and 60°, and a right-angle square at the lower-right vertex.",
                  "mathematics": "The unknown base is adjacent to 30° and opposite 60°. The known perpendicular side is 1 and the hypotenuse is 2.",
                  "answerVisibility": "The base length is absent in the question."
                },
                "derived": false,
                "reviewStatus": "needs-review"
              }
            ],
            "children": [],
            "answer": {
              "short": "$\\sqrt3$",
              "worked": "Let $x$ be the missing base length. By Pythagoras,\n$$\\begin{align*}x^2&=2^2-1^2\\\\x^2&=3\\\\x&=\\sqrt3.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16,
            "responseSpace": "scaffold"
          },
