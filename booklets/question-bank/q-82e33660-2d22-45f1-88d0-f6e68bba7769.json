        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6^{14x}$",
          "worked": "$$\\begin{align*}\\left(6^x\\right)^4\\times\\left(6^{2x}\\right)^5&=6^{4x}\\times6^{10x}\\\\\\left(6^x\\right)^4\\times\\left(6^{2x}\\right)^5&=6^{4x+10x}\\\\\\left(6^x\\right)^4\\times\\left(6^{2x}\\right)^5&=6^{14x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
