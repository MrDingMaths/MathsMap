        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{x+3}$",
          "worked": "$$\\begin{align*}2^x\\times2^3&=2^{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^x\\times3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{x+1}$",
          "worked": "$$\\begin{align*}3^x\\times3&=3^x\\times3^1\\\\3^x\\times3&=3^{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$7^{4x}\\times7^{-5x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{7^x}$",
          "worked": "$$\\begin{align*}7^{4x}\\times7^{-5x}&=7^{4x-5x}\\\\7^{4x}\\times7^{-5x}&=7^{-x}\\\\7^{4x}\\times7^{-5x}&=\\frac{1}{7^x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$5^{2x}\\div5^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{2x-3}$",
          "worked": "$$\\begin{align*}5^{2x}\\div5^3&=5^{2x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(10^{2x}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10^{6x}$",
          "worked": "$$\\begin{align*}\\left(10^{2x}\\right)^3&=10^{2x\\times3}\\\\\\left(10^{2x}\\right)^3&=10^{6x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(5^{4x}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{5^{8x}}$",
          "worked": "$$\\begin{align*}\\left(5^{4x}\\right)^{-2}&=5^{4x\\times(-2)}\\\\\\left(5^{4x}\\right)^{-2}&=5^{-8x}\\\\\\left(5^{4x}\\right)^{-2}&=\\frac{1}{5^{8x}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q12-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(6^x\\right)^4\\times\\left(6^{2x}\\right)^5$",
