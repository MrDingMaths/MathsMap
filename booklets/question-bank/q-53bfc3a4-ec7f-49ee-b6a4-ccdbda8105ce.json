  "content": {
    "id": "p25-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A new car that costs $\\$130\\,000$ depreciates by 20% of its value at the start of each year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the car’s value after 30 years. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$160.93$",
          "worked": "$$\\begin{align*}S &= V_0(1-r)^n\\\\S &= 130\\,000(1-0.20)^{30}\\\\S &\\approx 160.93\\end{align*}$$\nThe car’s value is $\\$160.93$ to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Will its value ever reach zero?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. The value approaches zero but remains positive.",
          "worked": "Each year the car retains 80% of its previous value. Since $130\\,000(0.8)^n>0$ for every finite number of years, its value never reaches zero in this model, although it becomes extremely small.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
