  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "In each quadratic equation the discriminant $\\Delta$ involves the pronumeral $p$. Solve $\\Delta\\geq0$ to find the values of $p$ for which the roots are real numbers.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+2x+p=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=4-4p$, $p\\leq1$.",
          "worked": "Real roots require $\\Delta\\geq0$.\n$$\\begin{align*}\\Delta&=2^2-4(1)(p)\\\\\\Delta&=4-4p\\\\4-4p&\\geq0\\\\p&\\leq1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$px^2-8x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=64-8p$, $p\\leq8$.",
          "worked": "Real roots require $\\Delta\\geq0$.\n$$\\begin{align*}\\Delta&=(-8)^2-4(p)(2)\\\\\\Delta&=64-8p\\\\64-8p&\\geq0\\\\p&\\leq8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x^2-4x+(p+1)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=4-12p$, $p\\leq\\frac13$.",
          "worked": "Real roots require $\\Delta\\geq0$.\n$$\\begin{align*}\\Delta&=(-4)^2-4(3)(p+1)\\\\\\Delta&=16-12p-12\\\\\\Delta&=4-12p\\\\4-12p&\\geq0\\\\p&\\leq\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2p-1)x^2-5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=33-16p$, $p\\leq\\frac{33}{16}$.",
          "worked": "Real roots require $\\Delta\\geq0$.\n$$\\begin{align*}\\Delta&=(-5)^2-4(2p-1)(2)\\\\\\Delta&=25-16p+8\\\\\\Delta&=33-16p\\\\33-16p&\\geq0\\\\p&\\leq\\frac{33}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
