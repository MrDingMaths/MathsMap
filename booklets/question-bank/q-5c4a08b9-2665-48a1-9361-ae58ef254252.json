  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A monomial is an expression with a single term. Complete these divisions, writing the quotient as a sum, or difference, of separate terms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q9-divisions",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q9-a",
            "type": "part",
            "label": "a",
            "prompt": "$x^7\\div x^4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^3$",
              "worked": "$$\\begin{align*}x^7\\div x^4&=x^{7-4}\\\\&=x^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p14-q9-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\dfrac{10x^{10}}{2x^2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5x^8$",
              "worked": "$$\\begin{align*}\\frac{10x^{10}}{2x^2}&=5x^{10-2}\\\\&=5x^8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p14-q9-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\dfrac{x^3}{15}\\div\\dfrac{x}{3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{x^2}{5}$",
              "worked": "$$\\begin{align*}\\frac{x^3}{15}\\div\\frac{x}{3}&=\\frac{x^3}{15}\\times\\frac{3}{x}\\\\&=\\frac{3x^3}{15x}\\\\&=\\frac{x^2}{5}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p14-q9-d",
            "type": "part",
            "label": "d",
            "prompt": "$(x^5+x)\\div x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^3+x^{-1}$",
              "worked": "$$\\begin{align*}(x^5+x)\\div x^2&=\\frac{x^5}{x^2}+\\frac{x}{x^2}\\\\&=x^{5-2}+x^{1-2}\\\\&=x^3+x^{-1}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p14-q9-e",
            "type": "part",
            "label": "e",
            "prompt": "$(24x^3+16x^2)\\div 8x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3x+2$",
              "worked": "$$\\begin{align*}\\frac{24x^3+16x^2}{8x^2}&=\\frac{24x^3}{8x^2}+\\frac{16x^2}{8x^2}\\\\&=3x^{3-2}+2x^{2-2}\\\\&=3x+2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p14-q9-f",
            "type": "part",
            "label": "f",
            "prompt": "$\\dfrac{10x^6-12x^4+2x^2}{2x^3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5x^3-6x+x^{-1}$",
              "worked": "$$\\begin{align*}\\frac{10x^6-12x^4+2x^2}{2x^3}&=\\frac{10x^6}{2x^3}-\\frac{12x^4}{2x^3}+\\frac{2x^2}{2x^3}\\\\&=5x^{6-3}-6x^{4-3}+x^{2-3}\\\\&=5x^3-6x+x^{-1}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p14-q9-followup",
        "type": "part",
        "label": "g",
        "prompt": "When is the quotient a polynomial?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "When every term has a non-negative integer power of $x$; here, parts a, b, c and e.",
          "worked": "The quotient is a polynomial when every term has a non-negative integer power of $x$. When dividing by a monomial, this requires each nonzero term in the numerator to have a power at least as large as the denominator's power. Parts a, b, c and e satisfy this condition; parts d and f contain $x^{-1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
