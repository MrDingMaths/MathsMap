    "id": "v2-da4e1-p18-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "Find $f'(2)$ if $f(x)=\\ln\\sqrt{3x-5}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(2)=\\dfrac32$.",
      "worked": "$$\\begin{align*}f(x)&=\\frac12\\ln(3x-5)\\\\f'(x)&=\\frac12\\left(\\frac{3}{3x-5}\\right)\\\\f'(x)&=\\frac{3}{2(3x-5)}\\\\f'(2)&=\\frac{3}{2(3(2)-5)}\\\\f'(2)&=\\frac32\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
  },
