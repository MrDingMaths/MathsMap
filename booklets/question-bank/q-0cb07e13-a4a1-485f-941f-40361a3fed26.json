  "content": {
    "id": "p38-q2-response",
    "type": "question",
    "label": "2",
    "prompt": "In each of the following, what should the substitution $u$ be to reduce the equation into a quadratic?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^4+9x^2-10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=x^2$.",
          "worked": "Let $u=x^2$, so $x^4=u^2$. The equation becomes $u^2+9u-10=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-5)^2+4(x-5)-5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=x-5$.",
          "worked": "Let $u=x-5$. The equation becomes $u^2+4u-5=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{x^2}-\\dfrac{3}{x}+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=\\dfrac{1}{x}$.",
          "worked": "Let $u=\\dfrac{1}{x}$, where $x\\ne0$. Then $\\dfrac{1}{x^2}=u^2$, so the equation becomes $u^2-3u+2=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x-6\\sqrt{x}+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=\\sqrt{x}$.",
          "worked": "Let $u=\\sqrt{x}$, so $x=u^2$ and $u\\ge0$. The equation becomes $u^2-6u+5=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$9^x-4(3^x)+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=3^x$.",
          "worked": "Let $u=3^x$. Since $9^x=(3^x)^2=u^2$, the equation becomes $u^2-4u+3=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
