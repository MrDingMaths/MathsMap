  "content": {
    "id": "p18-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "There are 132 blue and red marbles in a box. The ratio of red marbles to blue marbles is $3:8$. How many blue marbles are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "96 blue marbles.",
      "worked": "$$\\begin{align*}\\text{Total parts}&=3+8\\\\\\text{Total parts}&=11\\\\\\text{Marbles per part}&=132\\div11\\\\\\text{Marbles per part}&=12\\\\\\text{Blue marbles}&=8\\times12\\\\\\text{Blue marbles}&=96\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
