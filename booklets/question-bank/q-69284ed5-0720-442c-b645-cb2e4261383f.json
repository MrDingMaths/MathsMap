  "content": {
    "id": "p8-q12-root",
    "type": "question",
    "label": "",
    "prompt": "Warragamba dam holds approximately $2\\,580\\,000\\ \\mathrm{ML}$ of water at full capacity.\nHow many gigalitres is this?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately $2580\\ \\mathrm{GL}$.",
      "worked": "Gigalitres are a larger unit, so divide by $1000$.\n$$\\begin{align*}2\\,580\\,000\\ \\mathrm{ML}&=(2\\,580\\,000\\div1000)\\ \\mathrm{GL}\\\\&=2580\\ \\mathrm{GL}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 16
  },
