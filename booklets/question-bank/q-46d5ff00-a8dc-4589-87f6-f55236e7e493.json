      {
        "id": "p4-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(t+\\frac{1}{t}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t^2+2+\\dfrac{1}{t^2}$",
          "worked": "$$\\begin{align*}\\left(t+\\frac1t\\right)^2&=t^2+2t\\left(\\frac1t\\right)+\\left(\\frac1t\\right)^2\\\\\\left(t+\\frac1t\\right)^2&=t^2+2+\\frac1{t^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(t-\\frac{1}{t}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t^2-2+\\dfrac{1}{t^2}$",
          "worked": "$$\\begin{align*}\\left(t-\\frac1t\\right)^2&=t^2-2t\\left(\\frac1t\\right)+\\left(\\frac1t\\right)^2\\\\\\left(t-\\frac1t\\right)^2&=t^2-2+\\frac1{t^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(t+\\frac{1}{t}\\right)\\left(t-\\frac{1}{t}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t^2-\\dfrac{1}{t^2}$",
          "worked": "$$\\begin{align*}\\left(t+\\frac1t\\right)\\left(t-\\frac1t\\right)&=t^2-\\left(\\frac1t\\right)^2\\\\\\left(t+\\frac1t\\right)\\left(t-\\frac1t\\right)&=t^2-\\frac1{t^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
