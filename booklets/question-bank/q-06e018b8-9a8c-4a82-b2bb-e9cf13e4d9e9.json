  "content": {
    "id": "p11-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A circle has area $1386\\text{ cm}^2$. Using $\\pi\\approx\\frac{22}{7}$, find the approximate value of the radius of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$21\\text{ cm}$",
      "worked": "$$\\begin{align*}A&=\\pi r^2\\\\r^2&=\\frac{A}{\\pi}\\\\r^2&\\approx1386\\times\\frac7{22}\\\\r^2&\\approx441\\\\r&\\approx\\sqrt{441}\\\\r&\\approx21\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
