        "prompt": "What is the probability that Leslie wins a prize?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "Leslie appears in six of the ten equally likely allocations.\n$$P(\\text{Leslie wins})=\\frac{6}{10}=\\frac{3}{5}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
