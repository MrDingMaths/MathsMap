        "label": "a",
        "prompt": "$\\frac{3^{-1}+3^{-2}}{3+3^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{27}$",
          "worked": "$\\begin{align*}\\frac{3^{-1}+3^{-2}}{3+3^2}&=\\frac{\\frac13+\\frac19}{3+9}\\\\\\frac{3^{-1}+3^{-2}}{3+3^2}&=\\frac{4}{9}\\div12\\\\\\frac{3^{-1}+3^{-2}}{3+3^2}&=\\frac1{27}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p6-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2^{-2}+2^{-4}}{2^2+2^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{64}$",
          "worked": "$\\begin{align*}\\frac{2^{-2}+2^{-4}}{2^2+2^4}&=\\frac{\\frac14+\\frac1{16}}{4+16}\\\\\\frac{2^{-2}+2^{-4}}{2^2+2^4}&=\\frac5{16}\\div20\\\\\\frac{2^{-2}+2^{-4}}{2^2+2^4}&=\\frac1{64}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p6-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2^{-2}-2^{-4}}{2^2-2^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{64}$",
          "worked": "$\\begin{align*}\\frac{2^{-2}-2^{-4}}{2^2-2^4}&=\\frac{\\frac14-\\frac1{16}}{4-16}\\\\\\frac{2^{-2}-2^{-4}}{2^2-2^4}&=\\frac3{16}\\div(-12)\\\\\\frac{2^{-2}-2^{-4}}{2^2-2^4}&=-\\frac1{64}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
