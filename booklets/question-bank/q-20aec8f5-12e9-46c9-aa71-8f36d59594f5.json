  "content": {
    "id": "p22-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Solve for $x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{3}{4}\\right)^x=\\frac{4}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$\\begin{align*}\\left(\\frac{3}{4}\\right)^x&=\\left(\\frac{3}{4}\\right)^{-1}\\\\x&=-1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p22-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{2}{3}\\right)^x=\\frac{9}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$",
          "worked": "$\\begin{align*}\\left(\\frac{2}{3}\\right)^x&=\\left(\\frac{2}{3}\\right)^{-2}\\\\x&=-2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p22-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{2}{5}\\right)^x=\\frac{125}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$",
          "worked": "$\\begin{align*}\\left(\\frac{2}{5}\\right)^x&=\\left(\\frac{2}{5}\\right)^{-3}\\\\x&=-3\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p22-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{2^x}=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$",
          "worked": "$\\begin{align*}2^{-x}&=2^3\\\\-x&=3\\\\x&=-3\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{3^x}=81$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$",
          "worked": "$\\begin{align*}3^{-x}&=3^4\\\\-x&=4\\\\x&=-4\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1}{2^x}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "$\\begin{align*}2^{-x}&=2^0\\\\-x&=0\\\\x&=0\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
