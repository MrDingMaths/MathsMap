  "content": {
    "id": "v2-ee1e0-p32-practice-slot-14-root",
    "type": "question",
    "label": null,
    "prompt": "Five friends sit in a row of five seats at the cinema.\nIf Ava sits in an end seat, then Ben must sit next to her.\nHow many seating arrangements are possible?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$84$ arrangements.",
      "worked": "**Case 1: Ava sits in an end seat**\nAva has 2 choices of end seat. Ben must take the seat next to her.\nThe other three friends fill the remaining seats in $3!$ ways.\n$2\\times1\\times3!=12$ arrangements.\n**Case 2: Ava does not sit in an end seat**\nAva has 3 choices of seat. The other four friends fill the remaining seats in $4!$ ways.\n$3\\times4!=72$ arrangements.\n\nTotal: $12+72=84$ arrangements.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
