  "content": {
    "id": "p4-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the smallest number greater than 1 that is both a perfect square and a perfect cube.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$64=8^2=4^3$.",
      "worked": "The positive cubes greater than 1 up to $64$ are $8,27,64$. Neither $8$ nor $27$ is a perfect square, since $2^2<8<3^2$ and $5^2<27<6^2$.\n\n$$64=8^2=4^3.$$\n\nTherefore, the smallest number is $64$.",
      "solutionDiagrams": []
    },
