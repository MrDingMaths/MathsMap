  "content": {
    "id": "p108-q38-root",
    "type": "question",
    "label": "38",
    "prompt": "Express $\\frac{1}{8}$ as the sum of two fractions, each with 1 as the numerator, in four ways.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{9}+\\frac{1}{72},\\quad\\frac{1}{10}+\\frac{1}{40},\\quad\\frac{1}{12}+\\frac{1}{24},\\quad\\frac{1}{16}+\\frac{1}{16}$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p108-q38-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{1}{8}=\\frac{1}{x}+\\frac{1}{y}",
                "display": false
              },
              {
                "type": "text",
                "text": ", where x and y are positive integers.",
                "marks": []
              }
            ]
          },
          {
            "id": "p108-q38-answer-derivation",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\frac{1}{y}&=\\frac{1}{8}-\\frac{1}{x}\\\\\\frac{1}{y}&=\\frac{x-8}{8x}\\\\y&=\\frac{8x}{x-8}\\\\y&=8+\\frac{64}{x-8}\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p108-q38-answer-factors",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "For y to be an integer, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x-8",
                "display": false
              },
              {
                "type": "text",
                "text": " must divide 64. Taking ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x\\le y",
                "display": false
              },
              {
                "type": "text",
                "text": " avoids reversed pairs, giving ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x-8=1,2,4,8",
                "display": false
              },
              {
                "type": "text",
                "text": ". Substitute ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=9,10,12,16",
                "display": false
              },
              {
                "type": "text",
                "text": " to obtain ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "y=72,40,24,16",
                "display": false
              },
              {
                "type": "text",
                "text": ", respectively.",
                "marks": []
              }
            ]
          },
          {
            "id": "p108-q38-answer-pairs",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\frac{1}{9}+\\frac{1}{72}&=\\frac{8+1}{72}=\\frac{1}{8}\\\\\\frac{1}{10}+\\frac{1}{40}&=\\frac{4+1}{40}=\\frac{1}{8}\\\\\\frac{1}{12}+\\frac{1}{24}&=\\frac{2+1}{24}=\\frac{1}{8}\\\\\\frac{1}{16}+\\frac{1}{16}&=\\frac{2}{16}=\\frac{1}{8}\\end{align*}",
                "display": true
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
