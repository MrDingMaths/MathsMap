              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "A survey on household spending is needed.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "You take a random sample of a Sydney harbour-side suburb.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p90-q1-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "If the target is all Australian households, one harbour-side suburb may differ in income and spending; random sampling within it does not cover other areas.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "If the target is all Australian households, households outside this suburb are excluded and may have different incomes and spending. Random selection within the suburb does not remove this selection bias.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p90-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "A survey of the number of people who can touch their toes is done with students from a gymnastics class.",
