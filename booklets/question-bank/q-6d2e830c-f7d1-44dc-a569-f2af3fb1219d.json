    "difficulty": "Development",
    "difficultyReason": "Explain how a sampling frame or voluntary response may differ from its target population across varied contexts. The hardest cases require a conditional target-population assumption and a likely direction of overrepresentation; fourteen repetitions do not create a higher band."
  },
  "content": {
    "id": "p90-q1",
    "type": "question",
    "label": "1",
    "prompt": "Discuss why the following sampling methods may result in an unrepresentative sample:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p90-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Responses to a survey conducted by email.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p90-q1-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "only those with internet access respond; excludes people without email.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Selection bias: people without email access are excluded, so their views are not represented. Volunteer bias may also occur if those who choose to reply have different views from those who do not.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p90-q1-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p90-q1-b-prompt",
              "type": "paragraph",
              "fontSize": null,
