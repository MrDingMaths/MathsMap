            {
              "type": "math",
              "latex": "x=\\frac{-b+\\sqrt{b^2-4ac}}{2a}\\quad\\text{or}\\quad x=\\frac{-b-\\sqrt{b^2-4ac}}{2a}.",
              "display": true
            }
          ]
