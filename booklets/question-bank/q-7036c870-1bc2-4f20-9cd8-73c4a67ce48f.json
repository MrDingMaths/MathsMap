    "children": [
      {
        "id": "p24-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "What can you conclude about the number of solutions of a quadratic equation if:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$b^2-4ac<0$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "No real solutions.",
              "worked": "A negative discriminant has no real square root, so the quadratic formula gives no real solutions.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p24-q4-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$b^2-4ac=0$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "One real solution.",
              "worked": "The square-root term is zero, so both branches give the same value, $x=-\\frac{b}{2a}$. There is one real solution.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p24-q4-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$b^2-4ac>0$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Two distinct real solutions.",
              "worked": "The square-root term is positive, so adding it and subtracting it give two distinct real solutions.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p24-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "Determine the number of solutions of each quadratic equation, and where they exist, state their nature. You do not need to find the solutions.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x^2+8x-5=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Two irrational solutions.",
              "worked": "$$\\begin{align*}\\Delta&=8^2-4(1)(-5)\\\\\\Delta&=64+20\\\\\\Delta&=84\\end{align*}$$\n$84>0$ and is not a perfect square, so there are two irrational solutions.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p24-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$3x^2-7x+2=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Two rational solutions.",
              "worked": "$$\\begin{align*}\\Delta&=(-7)^2-4(3)(2)\\\\\\Delta&=49-24\\\\\\Delta&=25\\end{align*}$$\n$25>0$ and $25=5^2$, so there are two rational solutions.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p24-q4-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$x^2+6x+9=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "One rational solution.",
              "worked": "$$\\begin{align*}\\Delta&=6^2-4(1)(9)\\\\\\Delta&=36-36\\\\\\Delta&=0\\end{align*}$$\nThe discriminant is zero, so there is one rational solution.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p24-q4-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$4x^2-4x+1=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "One rational solution.",
              "worked": "$$\\begin{align*}\\Delta&=(-4)^2-4(4)(1)\\\\\\Delta&=16-16\\\\\\Delta&=0\\end{align*}$$\nThe discriminant is zero, so there is one rational solution.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p24-q4-b-v",
            "type": "part",
            "label": "v",
            "prompt": "$x^2+7x+13=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "No real solutions.",
              "worked": "$$\\begin{align*}\\Delta&=7^2-4(1)(13)\\\\\\Delta&=49-52\\\\\\Delta&=-3\\end{align*}$$\nThe discriminant is negative, so there are no real solutions.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p24-q4-b-vi",
            "type": "part",
            "label": "vi",
            "prompt": "$2x^2+11x+17=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "No real solutions.",
              "worked": "$$\\begin{align*}\\Delta&=11^2-4(2)(17)\\\\\\Delta&=121-136\\\\\\Delta&=-15\\end{align*}$$\nThe discriminant is negative, so there are no real solutions.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p24-q4-b-vii",
            "type": "part",
            "label": "vii",
            "prompt": "$3x^2-4x-2=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Two irrational solutions.",
              "worked": "$$\\begin{align*}\\Delta&=(-4)^2-4(3)(-2)\\\\\\Delta&=16+24\\\\\\Delta&=40\\end{align*}$$\n$40>0$ and is not a perfect square, so there are two irrational solutions.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p24-q4-b-viii",
            "type": "part",
            "label": "viii",
            "prompt": "$-2x^2+3x+7=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
