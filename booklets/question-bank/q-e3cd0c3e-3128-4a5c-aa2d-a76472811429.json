  "content": {
    "id": "v2-82039-p24-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Rewrite these equations in the form $y=k\\cdot a^x$, where $a>1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-82039-p24-practice-slot-1-slot-1-q-a",
        "type": "group",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "v2-82039-p24-practice-slot-1-slot-1-q-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$y=6\\left(\\frac13\\right)^{-x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=6\\cdot3^x$",
              "worked": "$$\\begin{align*}y&=6\\left(\\frac13\\right)^{-x}\\\\y&=6\\cdot3^x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "v2-82039-p24-practice-slot-1-slot-1-q-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$y=-\\left(\\frac25\\right)^{-x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-\\left(\\frac52\\right)^x$",
              "worked": "$$\\begin{align*}y&=-\\left(\\frac25\\right)^{-x}\\\\y&=-\\left(\\frac52\\right)^x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "v2-82039-p24-practice-slot-1-slot-1-q-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$y=4(0.2)^{-x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=4\\cdot5^x$",
              "worked": "$$\\begin{align*}y&=4(0.2)^{-x}\\\\y&=4\\left(\\frac15\\right)^{-x}\\\\y&=4\\cdot5^x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "v2-82039-p24-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Which of the three curves in part a fall as $x$ increases?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Only ii.",
          "worked": "In $y=k\\cdot a^x$ with $a>1$, the curve rises if $k>0$ and falls if $k<0$. Only ii has $k=-1<0$, so only ii falls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
