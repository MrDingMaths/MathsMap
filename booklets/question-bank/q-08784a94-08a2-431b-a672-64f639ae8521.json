    "children": [
      {
        "id": "p38-q6a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $OA=7$ and $AC=5$, determine the length of arc $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.34$",
          "worked": "Let $\\theta=\\angle AOC$, measured in radians. Since a tangent is perpendicular to the radius at the point of contact,\n$$\\begin{align*}\\tan\\theta&=\\frac{5}{7}\\\\\\theta&=\\tan^{-1}\\!\\left(\\frac{5}{7}\\right)\\\\L&=7\\tan^{-1}\\!\\left(\\frac{5}{7}\\right)\\\\L&\\approx4.34.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p38-q6b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $OA=4$ and $BC=1$, determine the length of arc $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.57$",
          "worked": "Let $\\theta=\\angle AOC$, measured in radians. The tangent makes $\\triangle OAC$ right-angled at $A$, and $OB=OA=4$.\n$$\\begin{align*}OC&=4+1=5\\\\\\cos\\theta&=\\frac{4}{5}\\\\\\theta&=\\cos^{-1}\\!\\left(\\frac{4}{5}\\right)\\\\L&=4\\cos^{-1}\\!\\left(\\frac{4}{5}\\right)\\\\L&\\approx2.57.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p38-q6c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $OA=2$ and the length of arc $AB$ is $1$, determine $OC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.28$",
          "worked": "Let $\\theta=\\angle AOC$, measured in radians. Use $L=r\\theta$ and the right angle between the radius and tangent.\n$$\\begin{align*}1&=2\\theta\\\\\\theta&=\\frac{1}{2}\\\\\\cos\\!\\left(\\frac{1}{2}\\right)&=\\frac{2}{OC}\\\\OC&=\\frac{2}{\\cos(1/2)}\\\\OC&\\approx2.28.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
