  "content": {
    "id": "p4-q13-root",
    "type": "question",
    "label": null,
    "prompt": "Determine whether the following points lie on the given lines.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3x+4$, $(-2,1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Substitute $x=-2$ into the equation.\n$$\\begin{align*}3x+4&=3(-2)+4\\\\3x+4&=-2\\end{align*}$$\nSince $-2\\ne1$, the point does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-4x+2$, $(3,-8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Substitute $x=3$ into the equation.\n$$\\begin{align*}-4x+2&=-4(3)+2\\\\-4x+2&=-10\\end{align*}$$\nSince $-10\\ne-8$, the point does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x-7y-5=0$, $(6,1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Substitute $(x,y)=(6,1)$ into the left-hand side.\n$$\\begin{align*}2x-7y-5&=2(6)-7(1)-5\\\\2x-7y-5&=0\\end{align*}$$\nThe equation is satisfied, so the point lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x}{3}-\\dfrac{y}{5}=1$, $(-3,-10)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Substitute $(x,y)=(-3,-10)$ into the left-hand side.\n$$\\begin{align*}\\frac{x}{3}-\\frac{y}{5}&=\\frac{-3}{3}-\\frac{-10}{5}\\\\\\frac{x}{3}-\\frac{y}{5}&=-1+2\\\\\\frac{x}{3}-\\frac{y}{5}&=1\\end{align*}$$\nThe equation is satisfied, so the point lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
