  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the value of $x$ if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x:3=4:5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{12}{5}$",
          "worked": "$$\\begin{align*}\\frac{x}{3}&=\\frac{4}{5}\\\\5x&=12\\\\x&=\\frac{12}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x:5=4:3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{20}{3}$",
          "worked": "$$\\begin{align*}\\frac{x}{5}&=\\frac{4}{3}\\\\3x&=20\\\\x&=\\frac{20}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+1):2=(x+3):4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}\\frac{x+1}{2}&=\\frac{x+3}{4}\\\\4(x+1)&=2(x+3)\\\\4x+4&=2x+6\\\\2x&=2\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$2:x=5:(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}\\frac{2}{x}&=\\frac{5}{x+3}\\\\2(x+3)&=5x\\\\2x+6&=5x\\\\3x&=6\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
