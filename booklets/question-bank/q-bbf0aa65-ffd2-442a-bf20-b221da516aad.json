        "prompt": "$23^2+(2\\times23\\times17)+17^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1600$",
          "worked": "$$\\begin{align*}23^2+(2\\times23\\times17)+17^2&=(23+17)^2\\\\23^2+(2\\times23\\times17)+17^2&=40^2\\\\23^2+(2\\times23\\times17)+17^2&=1600\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$73^2+(2\\times73\\times27)+27^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\,000$",
          "worked": "$$\\begin{align*}73^2+(2\\times73\\times27)+27^2&=(73+27)^2\\\\73^2+(2\\times73\\times27)+27^2&=100^2\\\\73^2+(2\\times73\\times27)+27^2&=10\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$14^2+(2\\times14\\times16)+16^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$900$",
          "worked": "$$\\begin{align*}14^2+(2\\times14\\times16)+16^2&=(14+16)^2\\\\14^2+(2\\times14\\times16)+16^2&=30^2\\\\14^2+(2\\times14\\times16)+16^2&=900\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$19^2-(2\\times19\\times9)+9^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100$",
          "worked": "$$\\begin{align*}19^2-(2\\times19\\times9)+9^2&=(19-9)^2\\\\19^2-(2\\times19\\times9)+9^2&=10^2\\\\19^2-(2\\times19\\times9)+9^2&=100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$99^2-(2\\times99\\times98)+98^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}99^2-(2\\times99\\times98)+98^2&=(99-98)^2\\\\99^2-(2\\times99\\times98)+98^2&=1^2\\\\99^2-(2\\times99\\times98)+98^2&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
