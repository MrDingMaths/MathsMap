  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Andrew walks at 5 km/h for 1 hour and 45 minutes. How far does he walk? Give your answer in metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8750\\text{ m}$",
      "worked": "$$\\begin{align*}t&=1+\\frac{45}{60}\\\\t&=\\frac{7}{4}\\text{ h}\\\\d&=5\\times\\frac{7}{4}\\\\d&=8.75\\text{ km}\\\\d&=8750\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
