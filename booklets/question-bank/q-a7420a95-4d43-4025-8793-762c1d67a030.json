          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "f(x)=\\begin{cases}x&\\text{if }x\\ge 1\\\\x-1&\\text{if }x\\le 1\\end{cases}",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
