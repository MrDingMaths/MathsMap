        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{\\pi}{12},\\frac{5\\pi}{12},\\frac{13\\pi}{12},\\frac{17\\pi}{12}$",
          "worked": "Let $u=2x$, so $0\\le u<4\\pi$.\n$$\\begin{align*}\\sin u&=\\frac12\\\\u&=\\frac{\\pi}{6},\\frac{5\\pi}{6},\\frac{13\\pi}{6},\\frac{17\\pi}{6}\\\\x&=\\frac{u}{2}\\\\x&=\\frac{\\pi}{12},\\frac{5\\pi}{12},\\frac{13\\pi}{12},\\frac{17\\pi}{12}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
