  "content": {
    "id": "p8-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Given $\\sec\\theta=3$, find the value of $\\csc\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\csc\\theta=\\pm\\frac{3\\sqrt2}{4}$.",
      "worked": "$$\\begin{align*}\\cos\\theta&=\\frac13\\\\\\sin^2\\theta&=1-\\left(\\frac13\\right)^2\\\\\\sin^2\\theta&=\\frac89\\\\\\sin\\theta&=\\pm\\frac{2\\sqrt2}{3}\\\\\\csc\\theta&=\\frac1{\\sin\\theta}\\\\\\csc\\theta&=\\pm\\frac{3\\sqrt2}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
