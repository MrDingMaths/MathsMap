    "children": [
      {
        "id": "p10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x\\log_e x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=1+\\log_e x$",
          "worked": "$$\\begin{aligned}y'&=\\log_e x+x\\left(\\frac{1}{x}\\right)\\\\y'&=1+\\log_e x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\log_e(2x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{2x}{2x+1}+\\log_e(2x+1)$",
          "worked": "$$\\begin{aligned}y'&=\\log_e(2x+1)+x\\left(\\frac{2}{2x+1}\\right)\\\\y'&=\\frac{2x}{2x+1}+\\log_e(2x+1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x+1)\\log_e x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{2x+1}{x}+2\\log_e x$",
          "worked": "$$\\begin{aligned}y'&=2\\log_e x+(2x+1)\\left(\\frac{1}{x}\\right)\\\\y'&=\\frac{2x+1}{x}+2\\log_e x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^4\\log_e x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=x^3(1+4\\log_e x)$",
          "worked": "$$\\begin{aligned}y'&=4x^3\\log_e x+x^4\\left(\\frac{1}{x}\\right)\\\\y'&=x^3(1+4\\log_e x)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p10-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+3)\\log_e(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\log_e(x+3)+1$",
          "worked": "$$\\begin{aligned}y'&=\\log_e(x+3)+(x+3)\\left(\\frac{1}{x+3}\\right)\\\\y'&=\\log_e(x+3)+1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x-1)\\log_e(2x+7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{2(x-1)}{2x+7}+\\log_e(2x+7)$",
          "worked": "$$\\begin{aligned}y'&=\\log_e(2x+7)+(x-1)\\left(\\frac{2}{2x+7}\\right)\\\\y'&=\\frac{2(x-1)}{2x+7}+\\log_e(2x+7)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p10-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$e^x\\log_e x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=e^x\\left(\\frac{1}{x}+\\log_e x\\right)$",
          "worked": "$$\\begin{aligned}y'&=e^x\\log_e x+e^x\\left(\\frac{1}{x}\\right)\\\\y'&=e^x\\left(\\frac{1}{x}+\\log_e x\\right)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$e^{-x}\\log_e x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=e^{-x}\\left(\\frac{1}{x}-\\log_e x\\right)$",
          "worked": "$$\\begin{aligned}y'&=-e^{-x}\\log_e x+e^{-x}\\left(\\frac{1}{x}\\right)\\\\y'&=e^{-x}\\left(\\frac{1}{x}-\\log_e x\\right)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
