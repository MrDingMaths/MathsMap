  "content": {
    "id": "p12-q76-response",
    "type": "question",
    "label": "18",
    "prompt": "Show that $\\dfrac{(a+b)^2}{4}-\\dfrac{(a-b)^2}{4}=ab$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{(a+b)^2}{4}-\\dfrac{(a-b)^2}{4}=ab$.\n\nExpand the squares; the numerator simplifies to $4ab$.",
      "worked": "$$\\begin{align*}\\frac{(a+b)^2}{4}-\\frac{(a-b)^2}{4}&=\\frac{a^2+2ab+b^2-(a^2-2ab+b^2)}{4}\\\\\\frac{(a+b)^2}{4}-\\frac{(a-b)^2}{4}&=\\frac{4ab}{4}\\\\\\frac{(a+b)^2}{4}-\\frac{(a-b)^2}{4}&=ab.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
