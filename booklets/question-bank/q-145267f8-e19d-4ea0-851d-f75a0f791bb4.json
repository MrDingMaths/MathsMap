  "content": {
    "id": "p11-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Twenty students took a maths test. Here are their results:\n\n11, 12, 13, 15, 15, 20, 11, 9, 5, 15, 19, 19, 16, 8, 12, 12, 16, 16, 20, 10",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the mean.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13.7$",
          "worked": "The sum of the twenty results is $274$.\n\n$$\\begin{align*}\\text{Mean}&=\\frac{274}{20}\\\\\\text{Mean}&=13.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the median.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "In ascending order:\n\n5, 8, 9, 10, 11, 11, 12, 12, 12, 13, 15, 15, 15, 16, 16, 16, 19, 19, 20, 20.\n\nThere are twenty results, so use the 10th and 11th values, $13$ and $15$.\n\n$$\\begin{align*}\\text{Median}&=\\frac{13+15}{2}\\\\\\text{Median}&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "The highest result is $20$ and the lowest is $5$.\n\n$$\\begin{align*}\\text{Range}&=20-5\\\\\\text{Range}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
