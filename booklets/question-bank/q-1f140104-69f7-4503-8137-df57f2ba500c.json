  "content": {
    "id": "p15-q39-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x^2+4$ and $g(x)=x+6$. Find the value of $a$ such that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q39-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(a)=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4$",
          "worked": "$$\\begin{align*}a+6&=10\\\\a&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q39-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(a)=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm1$",
          "worked": "$$\\begin{align*}a^2+4&=5\\\\a^2&=1\\\\a&=\\pm1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q39-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(a)=g(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p15-q39-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=-1\\text{ or }a=2",
                    "display": false
                  }
                ]
              },
              {
                "id": "p15-q39-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute and solve ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(a-2)(a+1)=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}a^2+4&=a+6\\\\a^2-a-2&=0\\\\(a-2)(a+1)&=0\\\\a-2&=0\\quad\\text{or}\\quad a+1=0\\\\a&=2\\quad\\text{or}\\quad a=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q39-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(2a)=g(-2a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p15-q39-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=-1\\text{ or }a=\\frac12",
                    "display": false
                  }
                ]
              },
              {
                "id": "p15-q39-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute and solve ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(2a-1)(a+1)=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}(2a)^2+4&=-2a+6\\\\4a^2+2a-2&=0\\\\2a^2+a-1&=0\\end{align*}$$\n\nSplit the middle term as $2a-a$ and take out common factors.\n\n$$\\begin{align*}2a^2+2a-a-1&=0\\\\2a(a+1)-(a+1)&=0\\\\(2a-1)(a+1)&=0\\\\2a-1&=0\\quad\\text{or}\\quad a+1=0\\\\a&=\\frac12\\quad\\text{or}\\quad a=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
