    "type": "question",
    "label": "19",
    "prompt": "Solve $2^{3x-3}=8^{2-x}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac{3}{2}$\n\nRewrite $8$ as $2^3$, then equate the indices.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p19-q19-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}2^{3x-3}&=(2^3)^{2-x}\\\\2^{3x-3}&=2^{3(2-x)}\\\\3x-3&=6-3x\\\\6x&=9\\\\x&=\\frac{3}{2}\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
