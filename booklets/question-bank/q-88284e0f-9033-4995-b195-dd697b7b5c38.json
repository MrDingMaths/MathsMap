  "content": {
    "id": "p72-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A function has $f'(x)=x^2e^{2x^3}$ and passes through the point $(0,0)$.\n\nFind the equation of the function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(x)=\\dfrac{e^{2x^3}-1}{6}$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p72-q6-root-completion-worked-0",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}f'(x)&=x^2e^{2x^3}\\\\f(x)&=\\frac16\\int 6x^2e^{2x^3}\\,dx\\\\&=\\frac16e^{2x^3}+C\\end{align*}",
                "display": true
              }
            ]
          },
          {
