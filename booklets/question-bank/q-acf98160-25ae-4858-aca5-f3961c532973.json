  "content": {
    "id": "p34-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The surface area of a cube is $x\\text{ cm}^2$ and its volume is $y\\text{ cm}^3$. If $x=y$, find the length of the side of the cube.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6\\text{ cm}$",
      "worked": "Let the side length be $s$ cm, where $s>0$. Then $x=6s^2$ and $y=s^3$.\n$$\\begin{align*}6s^2&=s^3\\\\6&=s\\\\s&=6\\end{align*}$$\nThe side length is $6\\text{ cm}$.",
      "solutionDiagrams": []
    },
