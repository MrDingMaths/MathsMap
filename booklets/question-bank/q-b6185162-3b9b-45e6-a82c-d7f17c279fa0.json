  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Temperatures can be measured in either degrees Fahrenheit or degrees Celsius. To convert from one scale to the other, the following formula is used: $F=\\frac{9}{5}C+32$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange the formula to make $C$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=\\frac{5(F-32)}{9}$",
          "worked": "$$\\begin{align*}F-32&=\\frac{9}{5}C\\\\5(F-32)&=9C\\\\C&=\\frac{5(F-32)}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "On a particular day in Melbourne, the temperature was $28^\\circ\\mathrm{C}$. What is this temperature measured in Fahrenheit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$82\\frac{2}{5}^\\circ\\mathrm{F}$",
          "worked": "$$\\begin{align*}F&=\\frac{9}{5}\\times28+32\\\\F&=\\frac{252}{5}+\\frac{160}{5}\\\\F&=\\frac{412}{5}=82\\frac{2}{5}\\end{align*}$$\nThe temperature was $82\\frac{2}{5}^\\circ\\mathrm{F}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "In Boston, USA, the minimum overnight temperature was $4^\\circ\\mathrm{F}$. What is this temperature measured in Celsius?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-15\\frac{5}{9}^\\circ\\mathrm{C}$",
          "worked": "$$\\begin{align*}C&=\\frac{5(4-32)}{9}\\\\C&=\\frac{5\\times(-28)}{9}\\\\C&=-\\frac{140}{9}=-15\\frac{5}{9}\\end{align*}$$\nThe temperature was $-15\\frac{5}{9}^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "What number represents the same temperature in $^\\circ\\mathrm{C}$ and $^\\circ\\mathrm{F}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-40^\\circ\\mathrm{F}=-40^\\circ\\mathrm{C}$\n\nSet the Fahrenheit and Celsius readings equal and solve.",
          "worked": "Let the common temperature reading be $x$, so $F=C=x$.\n$$\\begin{align*}x&=\\frac{9}{5}x+32\\\\5x&=9x+160\\\\-4x&=160\\\\x&=-40\\end{align*}$$\nThus $-40^\\circ\\mathrm{F}=-40^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p13-q10-e",
        "type": "group",
        "label": "e",
        "prompt": "An approximate conversion formula, used frequently when converting oven temperatures, is $F=2C+30$. Use this to convert these temperatures:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q10-e-i",
            "type": "part",
            "label": "i",
            "prompt": "an oven temperature of $180^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$390^\\circ\\mathrm{F}$",
              "worked": "$$\\begin{align*}F&=2\\times180+30\\\\F&=360+30\\\\F&=390\\end{align*}$$\nThe approximate temperature is $390^\\circ\\mathrm{F}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p13-q10-e-ii",
            "type": "part",
            "label": "ii",
            "prompt": "an oven temperature of $530^\\circ\\mathrm{F}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$250^\\circ\\mathrm{C}$",
              "worked": "$$\\begin{align*}530&=2C+30\\\\500&=2C\\\\C&=\\frac{500}{2}\\\\C&=250\\end{align*}$$\nThe approximate temperature is $250^\\circ\\mathrm{C}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
  },
