  "content": {
    "id": "p26-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find $f(x)$ and then find $f(1)$, given that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$f'(x)=1+2e^x$ and $f(0)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x+2e^x-1$; $f(1)=2e$.",
          "worked": "$$\\begin{align*}f(x)&=x+2e^x+C\\\\f(0)&=0+2e^0+C\\\\1&=2+C\\\\C&=-1\\\\f(x)&=x+2e^x-1\\\\f(1)&=1+2e-1\\\\f(1)&=2e\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p26-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$f'(x)=e^{2x-1}$ and $f\\left(\\frac12\\right)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\frac12e^{2x-1}+\\frac52$; $f(1)=\\frac12(e+5)$.",
          "worked": "$$\\begin{align*}f(x)&=\\frac12e^{2x-1}+C\\\\f\\left(\\frac12\\right)&=\\frac12e^{2(1/2)-1}+C\\\\3&=\\frac12e^0+C\\\\C&=\\frac52\\\\f(x)&=\\frac12e^{2x-1}+\\frac52\\\\f(1)&=\\frac12e+\\frac52\\\\f(1)&=\\frac12(e+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$f'(x)=e^{x/2+1}$ and $f(-2)=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=2e^{x/2+1}-6$; $f(1)=2e^{3/2}-6$.",
          "worked": "$$\\begin{align*}f(x)&=2e^{x/2+1}+C\\\\f(-2)&=2e^{-2/2+1}+C\\\\-4&=2e^0+C\\\\C&=-6\\\\f(x)&=2e^{x/2+1}-6\\\\f(1)&=2e^{1/2+1}-6\\\\f(1)&=2e^{3/2}-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
