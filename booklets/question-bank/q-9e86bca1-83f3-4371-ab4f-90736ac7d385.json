    "type": "question",
    "label": "5",
    "prompt": "True or False? Let $x,y\\geq0$. The conjugate of $\\sqrt{5}$ is $\\sqrt{5}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "False. Its conjugate is $-\\sqrt{5}$.",
      "worked": "Write $\\sqrt{5}=0+\\sqrt{5}$. Keeping the rational part and reversing the surd term gives $0-\\sqrt{5}=-\\sqrt{5}$.",
      "solutionDiagrams": []
    },
