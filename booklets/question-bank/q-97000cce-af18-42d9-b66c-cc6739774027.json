      {
        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the first term $a$ and the common ratio $r$ of the GP $7,\\ 14,\\ 28,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=7,\\ r=2$",
          "worked": "$$\\begin{align*}a&=7\\\\r&=\\frac{14}{7}=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the sixth term $a_6$ and an expression for the $50$th term $a_{50}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_6=224,\\quad a_{50}=7\\times2^{49}$",
          "worked": "$$\\begin{align*}a_6&=ar^5=7(2^5)=224\\\\a_{50}&=ar^{49}=7\\times2^{49}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Find a formula for the $n$th term $a_n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=7\\times2^{n-1}$",
          "worked": "$$a_n=ar^{n-1}=7\\times2^{n-1}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
