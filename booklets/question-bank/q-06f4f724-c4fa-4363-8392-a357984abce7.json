    "type": "question",
    "label": "7",
    "prompt": "How many subsets of $\\{1,2,3,\\ldots,8\\}$ have at least two elements?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$247$",
      "worked": "There are $2^8$ subsets in total. Exclude the empty subset and the eight subsets containing exactly one element.\n$$\\begin{align*}N &= 2^8-\\binom{8}{0}-\\binom{8}{1}\\\\N &= 256-1-8\\\\N &= 247.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
