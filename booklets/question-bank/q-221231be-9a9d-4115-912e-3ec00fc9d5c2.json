  "content": {
    "id": "p16-q2",
    "type": "question",
    "label": "2",
    "prompt": "Find the coordinates of the points of intersection of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+3x+3$ and $y=x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,1)$.",
          "worked": "$$\\begin{align*}x^2+3x+3&=x+2\\\\x^2+2x+1&=0\\\\(x+1)^2&=0\\\\x&=-1\\\\y&=-1+2=1\\end{align*}$$\nThe intersection is $(-1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p16-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2+5x+2$ and $y=x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-5,2)$ and $(1,8)$.",
          "worked": "$$\\begin{align*}x^2+5x+2&=x+7\\\\x^2+4x-5&=0\\\\(x+5)(x-1)&=0\\\\x&=-5\\text{ or }1\\end{align*}$$\nWhen $x=-5$, $y=-5+7=2$. When $x=1$, $y=1+7=8$.\nThe intersections are $(-5,2)$ and $(1,8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2+2x+4$ and $y=x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,4)$ and $(1,7)$.",
          "worked": "$$\\begin{align*}x^2+2x+4&=x+6\\\\x^2+x-2&=0\\\\(x+2)(x-1)&=0\\\\x&=-2\\text{ or }1\\end{align*}$$\nWhen $x=-2$, $y=-2+6=4$. When $x=1$, $y=1+6=7$.\nThe intersections are $(-2,4)$ and $(1,7)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=2x^2+3x+1$ and $y=2x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac12,0\\right)$ and $(0,1)$.",
          "worked": "$$\\begin{align*}2x^2+3x+1&=2x+1\\\\2x^2+x&=0\\\\x(2x+1)&=0\\\\x&=0\\text{ or }-\\frac12\\end{align*}$$\nWhen $x=0$, $y=2(0)+1=1$. When $x=-\\frac12$, $y=2(-\\frac12)+1=0$.\nThe intersections are $(0,1)$ and $\\left(-\\frac12,0\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p16-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=3x^2+x+2$ and $y=3x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac13,2\\right)$ and $(1,6)$.",
          "worked": "$$\\begin{align*}3x^2+x+2&=3x+3\\\\3x^2-2x-1&=0\\\\(3x+1)(x-1)&=0\\\\x&=-\\frac13\\text{ or }1\\end{align*}$$\nWhen $x=-\\frac13$, $y=3(-\\frac13)+3=2$. When $x=1$, $y=3(1)+3=6$.\nThe intersections are $\\left(-\\frac13,2\\right)$ and $(1,6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p16-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=6x^2+9x+5$ and $y=2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac23,\\frac53\\right)$ and $\\left(-\\frac12,2\\right)$.",
          "worked": "$$\\begin{align*}6x^2+9x+5&=2x+3\\\\6x^2+7x+2&=0\\\\(3x+2)(2x+1)&=0\\\\x&=-\\frac23\\text{ or }-\\frac12\\end{align*}$$\nWhen $x=-\\frac23$, $y=2(-\\frac23)+3=\\frac53$. When $x=-\\frac12$, $y=2(-\\frac12)+3=2$.\nThe intersections are $\\left(-\\frac23,\\frac53\\right)$ and $\\left(-\\frac12,2\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
