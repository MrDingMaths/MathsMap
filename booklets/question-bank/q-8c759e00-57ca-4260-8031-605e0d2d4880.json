                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Reflection in the y-axis: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=\\frac{x-1}{2x+1}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p19-q41-short-rotation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
