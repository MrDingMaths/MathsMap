                  }
                ]
              }
            ]
          },
          "worked": "Reflection in the $x$-axis:\n$$\\begin{align*}-y&=|x-2|\\\\y&=-|x-2|\\end{align*}$$\nReflection in the $y$-axis:\n$$\\begin{align*}y&=|-x-2|\\\\y&=|x+2|\\end{align*}$$\nRotation through $180^\\circ$ about the origin:\n$$\\begin{align*}-y&=|-x-2|\\\\-y&=|x+2|\\\\y&=-|x+2|\\end{align*}$$",
          "solutionDiagrams": []
