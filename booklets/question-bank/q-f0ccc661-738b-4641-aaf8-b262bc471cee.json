    "type": "question",
    "label": "10",
    "prompt": "A potato is taken from boiling water at $100^\\circ\\mathrm{C}$ and placed in a fridge at $0^\\circ\\mathrm{C}$. Every minute after this, the temperature of the potato drops by $16\\%$. Give temperatures correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q10-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the temperature of the potato after:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q10-a-i",
            "type": "part",
            "label": "i",
            "prompt": "4 minutes",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$49.8^\\circ\\mathrm{C}$",
              "worked": "The multiplier each minute is $1-0.16=0.84$.\n\n$$\\begin{align*}T&=100\\times0.84^4\\\\T&=49.787136\\\\T&\\approx49.8^\\circ\\mathrm{C}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p22-q10-a-ii",
            "type": "part",
            "label": "ii",
