  "content": {
    "id": "p21-q10",
    "type": "question",
    "label": "10",
    "prompt": "Consider the function $y=|x-2|$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the equation of the reflection across the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-|x-2|$.",
          "worked": "Replace $y$ by $-y$:\n$$\\begin{align*}-y&=|x-2|\\\\y&=-|x-2|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p21-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the reflection of the curve from part a across the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-|x+2|$.",
          "worked": "Replace $x$ by $-x$ in the equation from part a:\n$$\\begin{align*}y&=-|-x-2|\\\\y&=-|-(x+2)|\\\\y&=-|x+2|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p21-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Verify you get the same result by reflecting $y=|x-2|$ across the $y$-axis then $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Across the $y$-axis: $y=|x+2|$. Then across the $x$-axis: $y=-|x+2|$, the same result as part b.",
          "worked": "Across the $y$-axis, replace $x$ by $-x$:\n$$\\begin{align*}f(-x)&=|-x-2|\\\\f(-x)&=|x+2|\\end{align*}$$\nThen reflect across the $x$-axis:\n$$\\begin{align*}y&=-f(-x)\\\\y&=-|x+2|\\end{align*}$$\nThis is the same equation as in part b.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
