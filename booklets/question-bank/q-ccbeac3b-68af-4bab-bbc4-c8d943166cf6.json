  "content": {
    "id": "p44-q16-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=2x+3$ and $g(x)=ax+b$, where $b$ is a constant.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Find expressions for $g(f(x))$ and $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(f(x))=2ax+3a+b$, $f(g(x))=2ax+2b+3$.",
          "worked": "$$\\begin{align*}g(f(x))&=a(2x+3)+b\\\\g(f(x))&=2ax+3a+b\\\\f(g(x))&=2(ax+b)+3\\\\f(g(x))&=2ax+2b+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p44-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the values of $a$ and $b$ so that $g(f(x))=x$, for all $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac12$, $b=-\\frac32$.",
          "worked": "For $2ax+3a+b=x$ for all $x$, match the coefficient of $x$ and the constant term:$$\\begin{align*}2a&=1\\\\a&=\\frac12\\\\3a+b&=0\\\\b&=-3\\left(\\frac12\\right)\\\\b&=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p44-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that if $a$ and $b$ have these values, then $f(g(x))=x$, for all $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=2\\left(\\frac{x}{2}-\\frac32\\right)+3=x$ for all $x$.",
          "worked": "$$\\begin{align*}f(g(x))&=2\\left(\\frac{x}{2}-\\frac32\\right)+3\\\\f(g(x))&=x-3+3\\\\f(g(x))&=x\\end{align*}$$Thus the identity holds for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
