    "type": "question",
    "label": "13",
    "prompt": "Calculate the area of a road that is $10\\,\\mathrm{m}$ in width and $3.8\\,\\mathrm{km}$ in length. Give your answer in hectares.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3.8$ hectares",
      "worked": "$$3.8\\,\\mathrm{km}=3800\\,\\mathrm{m}$$\n$$\\begin{align*}\\text{Area}&=L\\times W\\\\\\text{Area}&=3800\\times10\\,\\mathrm{m}^2\\\\\\text{Area}&=38\\,000\\,\\mathrm{m}^2\\\\\\text{Area}&=\\frac{38\\,000}{10\\,000}\\,\\mathrm{ha}\\\\\\text{Area}&=3.8\\,\\mathrm{ha}\\end{align*}$$",
      "solutionDiagrams": []
    },
