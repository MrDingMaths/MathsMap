  "content": {
    "id": "p63-q34-root",
    "type": "question",
    "label": "34",
    "prompt": "We can bypass the quotient rule by splitting a fraction.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p63-q34-a",
        "type": "part",
        "label": "a",
        "prompt": "Find constants $a$ and $b$ such that $\\dfrac{x}{x+1}=a+\\dfrac{b}{x+1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1,\\ b=-1$.",
          "worked": "$$\\begin{align*}\\frac{x}{x+1}&=\\frac{ax+a+b}{x+1}\\\\x&=ax+a+b\\end{align*}$$\nBy equating coefficients, $a=1$ and $a+b=0$.\nTherefore $a=1,\\ b=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p63-q34-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence differentiate $y=\\dfrac{x}{x+1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1}{(x+1)^2}$.",
          "worked": "From part a, this is the same as differentiating $y=1+\\dfrac{-1}{x+1}$.\n$$\\begin{align*}y&=1-(x+1)^{-1}\\\\y'&=-(-1)(x+1)^{-2}\\times1\\\\&=\\frac{1}{(x+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
