  "content": {
    "id": "p14-q8",
    "type": "question",
    "label": "8",
    "prompt": "Expand and simplify these expressions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q8-row1",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q8-a",
            "type": "part",
            "label": "a",
            "prompt": "$4x(3x+y)+2x(5x-2y)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$22x^2$",
              "worked": "$$\\begin{align*}4x(3x+y)+2x(5x-2y)&=12x^2+4xy+10x^2-4xy\\\\&=22x^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p14-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "$5m(4m-3n)-2m(9m-2n)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2m^2-11mn$",
              "worked": "$$\\begin{align*}5m(4m-3n)-2m(9m-2n)&=20m^2-15mn-18m^2+4mn\\\\&=2m^2-11mn\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p14-q8-row2",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q8-c",
            "type": "part",
            "label": "c",
            "prompt": "$3a^2(4a^3-b^4)+2a^2(5a^3+3b^4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$22a^5+3a^2b^4$",
              "worked": "$$\\begin{align*}3a^2(4a^3-b^4)+2a^2(5a^3+3b^4)&=12a^5-3a^2b^4+10a^5+6a^2b^4\\\\&=22a^5+3a^2b^4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p14-q8-d",
            "type": "part",
            "label": "d",
            "prompt": "$2y^3(5y^2+3y^4)-4y^2(2y^2-y^4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10y^5+6y^7-8y^4+4y^6$",
              "worked": "$$\\begin{align*}2y^3(5y^2+3y^4)-4y^2(2y^2-y^4)&=10y^5+6y^7-8y^4+4y^6\\end{align*}$$\nThere are no like terms to combine.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p14-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$5a^2b(2a^3b^2-3ab^3)-4a^2b(3a^3b^2-4ab^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2a^5b^3+a^3b^4$",
          "worked": "$$\\begin{align*}5a^2b(2a^3b^2-3ab^3)-4a^2b(3a^3b^2-4ab^3)&=10a^5b^3-15a^3b^4-12a^5b^3+16a^3b^4\\\\&=-2a^5b^3+a^3b^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
