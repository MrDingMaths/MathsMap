                "inlines": [
                  {
                    "type": "text",
                    "text": "Let X be the number of sales. Treat the calls as independent. Each sale has probability 0.4 and each unsuccessful call has probability 0.6.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p17-q8-a-work-probabilities",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(X=0)&=0.6^4=\\frac{81}{625}\\\\P(X=1)&=4(0.4)(0.6)^3=\\frac{216}{625}\\\\P(X=2)&=6(0.4)^2(0.6)^2=\\frac{216}{625}\\\\P(X=3)&=4(0.4)^3(0.6)=\\frac{96}{625}\\\\P(X=4)&=0.4^4=\\frac{16}{625}\\end{aligned}",
                    "display": true
                  }
                ]
              },
