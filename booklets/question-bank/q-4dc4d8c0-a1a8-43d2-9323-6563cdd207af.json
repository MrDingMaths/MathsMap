  "content": {
    "id": "p7-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Given that $\\log_{10}2=\\alpha$, $\\log_{10}3=\\beta$, $\\log_{10}5=\\gamma$ and $\\log_{10}7=\\delta$, express in terms of $\\alpha$, $\\beta$, $\\gamma$ and $\\delta$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{10}12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\alpha+\\beta$",
          "worked": "$$\\begin{align*}\\log_{10}12&=\\log_{10}(2^2\\times3)\\\\\\log_{10}12&=2\\log_{10}2+\\log_{10}3\\\\\\log_{10}12&=2\\alpha+\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}75$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\beta+2\\gamma$",
          "worked": "$$\\begin{align*}\\log_{10}75&=\\log_{10}(3\\times5^2)\\\\\\log_{10}75&=\\log_{10}3+2\\log_{10}5\\\\\\log_{10}75&=\\beta+2\\gamma\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{10}210$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha+\\beta+\\gamma+\\delta$",
          "worked": "$$\\begin{align*}\\log_{10}210&=\\log_{10}(2\\times3\\times5\\times7)\\\\\\log_{10}210&=\\log_{10}2+\\log_{10}3+\\log_{10}5+\\log_{10}7\\\\\\log_{10}210&=\\alpha+\\beta+\\gamma+\\delta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{10}6\\,000\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\alpha+\\beta+6\\gamma$",
          "worked": "$$\\begin{align*}\\log_{10}6\\,000\\,000&=\\log_{10}(2^7\\times3\\times5^6)\\\\\\log_{10}6\\,000\\,000&=7\\log_{10}2+\\log_{10}3+6\\log_{10}5\\\\\\log_{10}6\\,000\\,000&=7\\alpha+\\beta+6\\gamma\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{10}1875$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\beta+4\\gamma$",
          "worked": "$$\\begin{align*}\\log_{10}1875&=\\log_{10}(3\\times5^4)\\\\\\log_{10}1875&=\\log_{10}3+4\\log_{10}5\\\\\\log_{10}1875&=\\beta+4\\gamma\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_{10}1050$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha+\\beta+2\\gamma+\\delta$",
          "worked": "$$\\begin{align*}\\log_{10}1050&=\\log_{10}(2\\times3\\times5^2\\times7)\\\\\\log_{10}1050&=\\log_{10}2+\\log_{10}3+2\\log_{10}5+\\log_{10}7\\\\\\log_{10}1050&=\\alpha+\\beta+2\\gamma+\\delta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_{10}(2^a3^b5^c7^d)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a\\alpha+b\\beta+c\\gamma+d\\delta$",
          "worked": "$$\\begin{align*}\\log_{10}(2^a3^b5^c7^d)&=a\\log_{10}2+b\\log_{10}3+c\\log_{10}5+d\\log_{10}7\\\\\\log_{10}(2^a3^b5^c7^d)&=a\\alpha+b\\beta+c\\gamma+d\\delta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "What does $\\alpha+\\gamma$ equal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\alpha+\\gamma&=\\log_{10}2+\\log_{10}5\\\\\\alpha+\\gamma&=\\log_{10}(2\\times5)\\\\\\alpha+\\gamma&=\\log_{10}10\\\\\\alpha+\\gamma&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
