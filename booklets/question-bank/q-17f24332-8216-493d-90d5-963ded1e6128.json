  "content": {
    "id": "p2-f3-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider the graph of $y=f(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-f3-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the equation of the result when $f(x)$ is reflected across the $x$-axis, and then across the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "First $y=-f(x)$, then $y=-f(-x)$.",
          "worked": "Reflect across the $x$-axis to get $y=-f(x)$.\n\nFor the $y$-axis reflection, replace $x$ with $-x$ in that equation to get $y=-f(-x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-f3-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the equation of the result when $f(x)$ is reflected across the $y$-axis, and then across the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "First $y=f(-x)$, then $y=-f(-x)$.",
          "worked": "Reflect across the $y$-axis to get $y=f(-x)$.\n\nFor the $x$-axis reflection, reverse the sign of that output to get $y=-f(-x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
