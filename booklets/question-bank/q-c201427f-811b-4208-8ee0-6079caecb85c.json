    "prompt": "Factorise",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x-3)$",
          "worked": "$\\begin{align*}x^2-9&=x^2-3^2\\\\&=(x+3)(x-3)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^4-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+3)(x^2-3)$",
          "worked": "$\\begin{align*}x^4-9&=(x^2)^2-3^2\\\\&=(x^2+3)(x^2-3)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^6-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^3+3)(x^3-3)$",
          "worked": "$\\begin{align*}x^6-9&=(x^3)^2-3^2\\\\&=(x^3+3)(x^3-3)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^{2n}-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^n+3)(x^n-3)$",
          "worked": "$\\begin{align*}x^{2n}-9&=(x^n)^2-3^2\\\\&=(x^n+3)(x^n-3)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
