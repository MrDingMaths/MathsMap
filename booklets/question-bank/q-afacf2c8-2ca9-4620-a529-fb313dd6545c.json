        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\frac{2}{3}+\\frac{3}{4}}{\\frac{5}{6}-\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac{2}{3}+\\frac{3}{4}}{\\frac{5}{6}-\\frac{2}{3}}&=\\dfrac{\\frac{8}{12}+\\frac{9}{12}}{\\frac{5}{6}-\\frac{4}{6}}\\\\\\dfrac{\\frac{2}{3}+\\frac{3}{4}}{\\frac{5}{6}-\\frac{2}{3}}&=\\frac{17}{12}\\div\\frac{1}{6}\\\\\\dfrac{\\frac{2}{3}+\\frac{3}{4}}{\\frac{5}{6}-\\frac{2}{3}}&=\\frac{17}{12}\\times\\frac{6}{1}\\\\\\dfrac{\\frac{2}{3}+\\frac{3}{4}}{\\frac{5}{6}-\\frac{2}{3}}&=\\frac{17}{2}\\\\\\dfrac{\\frac{2}{3}+\\frac{3}{4}}{\\frac{5}{6}-\\frac{2}{3}}&=8\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\frac{5}{12}-\\frac{1}{4}}{\\frac{2}{3}+\\frac{1}{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac{5}{12}-\\frac{1}{4}}{\\frac{2}{3}+\\frac{1}{6}}&=\\dfrac{\\frac{5}{12}-\\frac{3}{12}}{\\frac{4}{6}+\\frac{1}{6}}\\\\\\dfrac{\\frac{5}{12}-\\frac{1}{4}}{\\frac{2}{3}+\\frac{1}{6}}&=\\frac{1}{6}\\div\\frac{5}{6}\\\\\\dfrac{\\frac{5}{12}-\\frac{1}{4}}{\\frac{2}{3}+\\frac{1}{6}}&=\\frac{1}{6}\\times\\frac{6}{5}\\\\\\dfrac{\\frac{5}{12}-\\frac{1}{4}}{\\frac{2}{3}+\\frac{1}{6}}&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p8-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\frac{3}{4}\\times\\frac{8}{9}}{\\frac{2}{3}-\\frac{1}{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{1}{3}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac{3}{4}\\times\\frac{8}{9}}{\\frac{2}{3}-\\frac{1}{6}}&=\\dfrac{\\frac{24}{36}}{\\frac{4}{6}-\\frac{1}{6}}\\\\\\dfrac{\\frac{3}{4}\\times\\frac{8}{9}}{\\frac{2}{3}-\\frac{1}{6}}&=\\frac{2}{3}\\div\\frac{1}{2}\\\\\\dfrac{\\frac{3}{4}\\times\\frac{8}{9}}{\\frac{2}{3}-\\frac{1}{6}}&=\\frac{2}{3}\\times\\frac{2}{1}\\\\\\dfrac{\\frac{3}{4}\\times\\frac{8}{9}}{\\frac{2}{3}-\\frac{1}{6}}&=\\frac{4}{3}\\\\\\dfrac{\\frac{3}{4}\\times\\frac{8}{9}}{\\frac{2}{3}-\\frac{1}{6}}&=1\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
