      {
        "id": "p19-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the volume of the missing top cone? Answer correct to the nearest cubic metre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$785\\text{ m}^3$",
          "worked": "$$\\begin{align*}V_{\\text{top}}&=\\frac13\\pi r^2h\\\\&=\\frac13\\times\\pi\\times5^2\\times30\\\\&=250\\pi\\\\&\\approx785\\text{ m}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p19-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What was the volume of the entire cone? Answer correct to the nearest cubic metre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6283\\text{ m}^3$",
          "worked": "$$\\begin{align*}h&=30+30=60\\text{ m}\\\\V_{\\text{entire}}&=\\frac13\\pi r^2h\\\\&=\\frac13\\times\\pi\\times10^2\\times60\\\\&=2000\\pi\\\\&\\approx6283\\text{ m}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p19-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the volume of the frustum? Answer correct to the nearest cubic metre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5498\\text{ m}^3$",
          "worked": "$$\\begin{align*}V_{\\text{frustum}}&=V_{\\text{entire}}-V_{\\text{top}}\\\\&=2000\\pi-250\\pi\\\\&=1750\\pi\\\\&\\approx5498\\text{ m}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ],
