    "type": "question",
    "label": "6",
    "prompt": "A regular polygon has sixteen sides. What is the measure of each of its exterior angles?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$22.5^{\\circ}$",
      "worked": "The equal exterior angles sum to $360^{\\circ}$.\n$$\\begin{align*}E&=\\frac{360^{\\circ}}{16}\\\\E&=22.5^{\\circ}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
