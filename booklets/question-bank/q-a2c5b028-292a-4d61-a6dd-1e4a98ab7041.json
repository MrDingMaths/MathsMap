  "content": {
    "id": "p27-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Given $f(x)=\\sqrt{x^2-9}$ and $g(x)=x+5$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find integers $c$ and $d$ such that $f(g(x))=\\sqrt{(x+c)(x+d)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=2$, $d=8$ (or the other way around).",
          "worked": "$$\\begin{aligned}f(g(x))&=\\sqrt{(x+5)^2-9}\\\\f(g(x))&=\\sqrt{x^2+10x+16}\\\\f(g(x))&=\\sqrt{(x+2)(x+8)}\\end{aligned}$$\nThus $c=2$, $d=8$ (or the other way around).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence state the domain for which $f(g(x))$ is defined.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le -8$ or $x\\ge -2$.",
          "worked": "The radicand must be non-negative:\n$$\\begin{aligned}(x+2)(x+8)&\\ge0\\end{aligned}$$\nThe product is non-negative outside the roots, including the endpoints. Hence the domain is $x\\le-8$ or $x\\ge-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
