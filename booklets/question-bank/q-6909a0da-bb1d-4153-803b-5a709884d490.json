        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the coordinates of the point of intersection of lines B and C and hence give the solution to the simultaneous equations for these lines.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,2)$; $x=2$, $y=2$.",
          "worked": "Lines B and C intersect at $(2,2)$. Therefore $x=2$ and $y=2$ satisfy both equations.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the graph to solve the equations for lines A and C simultaneously (give an estimate).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx0.4$, $y\\approx2.8$.",
          "worked": "The intersection of lines A and C is approximately $(0.4,2.8)$. Therefore $x\\approx0.4$ and $y\\approx2.8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Can the equations for lines A and B be solved simultaneously? Explain why or why not.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. The lines are parallel and never intersect.",
          "worked": "Lines A and B have the same gradient and different intercepts, so they are parallel. They never intersect, so no pair of $x$ and $y$ values satisfies both equations.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
