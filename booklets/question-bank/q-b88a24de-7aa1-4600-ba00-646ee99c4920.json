  "content": {
    "id": "p15-q25-root",
    "type": "question",
    "label": "25",
    "prompt": "Train A and Train B both stop at Swindon at 10:30 am.\nTrain A stops every 12 minutes and Train B stops every 14 minutes.\nWhen do they both stop at Swindon again?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "11:54 am, after 84 minutes.",
      "worked": "Use the LCM because both stopping intervals must divide the elapsed time. The HCF of 12 and 14 is 2.\n$$\\begin{align*}\\operatorname{LCM}(12,14)&=\\frac{12\\times14}{2}\\\\\\operatorname{LCM}(12,14)&=84\\end{align*}$$\n84 minutes is 1 hour 24 minutes. They next both stop at Swindon at 11:54 am.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
