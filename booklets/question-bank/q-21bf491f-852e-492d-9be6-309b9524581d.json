  "content": {
    "id": "p20-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "The lengths of a triangle are in the ratio $5:12:13$. If the perimeter of the triangle is $36\\text{ cm}$, what is the length of each side?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6\\text{ cm}$, $14.4\\text{ cm}$ and $15.6\\text{ cm}$.",
      "worked": "There are $5+12+13=30$ parts in total.\n\n$$\\begin{align*}\\text{Length of one part}&=36\\div30\\\\\\text{Length of one part}&=1.2\\text{ cm}\\\\\\text{First side}&=5\\times1.2\\text{ cm}\\\\\\text{First side}&=6\\text{ cm}\\\\\\text{Second side}&=12\\times1.2\\text{ cm}\\\\\\text{Second side}&=14.4\\text{ cm}\\\\\\text{Third side}&=13\\times1.2\\text{ cm}\\\\\\text{Third side}&=15.6\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
