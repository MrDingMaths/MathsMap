        "label": "a",
        "prompt": "$X=\\{\\text{multiples of 7 between 20 and 40}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$X=\\{21,28,35\\}$",
          "worked": "The multiples of 7 between 20 and 40 are $7\\times3=21$, $7\\times4=28$ and $7\\times5=35$.\n\n$X=\\{21,28,35\\}$",
