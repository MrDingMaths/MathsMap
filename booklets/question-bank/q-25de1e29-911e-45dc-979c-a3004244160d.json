        "answer": {
          "short": "$Y=\\{\\text{spring},\\text{summer},\\text{autumn},\\text{winter}\\}$",
          "worked": "List each season once, separated by commas inside braces:\n\n$Y=\\{\\text{spring},\\text{summer},\\text{autumn},\\text{winter}\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$Z=\\{\\text{letters in the word “science”}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
