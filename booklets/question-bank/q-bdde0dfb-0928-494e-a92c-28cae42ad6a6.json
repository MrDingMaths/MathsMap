  "content": {
    "id": "p48-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A function is defined by $f(x)=\\frac{1}{10}$, $0\\le x\\le10$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p48-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show $f(x)$ is a valid PDF.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\frac{1}{10}\\ge0$ on $[0,10]$ and $\\int_0^{10}\\frac{1}{10}\\,dx=1$.",
          "worked": "$f(x)=\\frac{1}{10}\\ge0$ for $0\\le x\\le10$.\n$$\\begin{align*}\\int_0^{10}\\frac{1}{10}\\,dx&=\\left[\\frac{x}{10}\\right]_0^{10}\\\\&=1.\\end{align*}$$\nTherefore $f(x)$ is a valid PDF.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p48-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate $E(X)$ using $E(X)=\\displaystyle\\int_a^b xf(x)\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=5$.",
          "worked": "$$\\begin{align*}E(X)&=\\int_0^{10}\\frac{x}{10}\\,dx\\\\&=\\frac{1}{10}\\left[\\frac{x^2}{2}\\right]_0^{10}\\\\&=\\frac{1}{10}(50-0)\\\\&=5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p48-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Does $E(X)$ agree with your understanding of expected value as an average?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. $E(X)=5$ is the midpoint of $[0,10]$, the expected average for a uniform distribution.",
          "worked": "Yes. The density is constant on $[0,10]$, so the distribution is uniform. Its average is the midpoint, $\\frac{0+10}{2}=5$, agreeing with $E(X)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p48-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Calculate $\\operatorname{Var}(X)=E(X^2)-(E(X))^2$, then find $\\sigma$ using $\\sigma=\\sqrt{\\operatorname{Var}(X)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{Var}(X)=\\frac{25}{3}$, $\\sigma=\\frac{5}{\\sqrt3}$.",
          "worked": "$$\\begin{align*}E(X^2)&=\\frac{1}{10}\\int_0^{10}x^2\\,dx\\\\&=\\frac{1}{10}\\left[\\frac{x^3}{3}\\right]_0^{10}\\\\&=\\frac{100}{3}.\\end{align*}$$\n$$\\begin{align*}\\operatorname{Var}(X)&=E(X^2)-(E(X))^2\\\\&=\\frac{100}{3}-25\\\\&=\\frac{25}{3}.\\end{align*}$$\n$$\\begin{align*}\\sigma&=\\sqrt{\\frac{25}{3}}\\\\&=\\frac{5}{\\sqrt3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
