        "type": "part",
        "label": "a",
        "prompt": "$\\frac{(3xy^2)^2\\times(2x^2y)^3}{(6x^2y)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^4y^5$",
          "worked": "$\\begin{aligned}\\frac{(3xy^2)^2\\times(2x^2y)^3}{(6x^2y)^2}&=\\frac{9x^2y^4\\times8x^6y^3}{36x^4y^2}\\\\\\frac{(3xy^2)^2\\times(2x^2y)^3}{(6x^2y)^2}&=\\frac{72x^8y^7}{36x^4y^2}\\\\\\frac{(3xy^2)^2\\times(2x^2y)^3}{(6x^2y)^2}&=2x^4y^5\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3a^2b^4\\times(2ab^2)^3}{(4a^2b^3)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3ab^4}{2}$",
          "worked": "$\\begin{aligned}\\frac{3a^2b^4\\times(2ab^2)^3}{(4a^2b^3)^2}&=\\frac{3a^2b^4\\times8a^3b^6}{16a^4b^6}\\\\\\frac{3a^2b^4\\times(2ab^2)^3}{(4a^2b^3)^2}&=\\frac{24a^5b^{10}}{16a^4b^6}\\\\\\frac{3a^2b^4\\times(2ab^2)^3}{(4a^2b^3)^2}&=\\frac{3ab^4}{2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{(2x^2y^3)^3\\times(5xy^2)^2}{(10x^2y)^2\\times(xy)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2xy^8$",
          "worked": "$\\begin{aligned}\\frac{(2x^2y^3)^3\\times(5xy^2)^2}{(10x^2y)^2\\times(xy)^3}&=\\frac{8x^6y^9\\times25x^2y^4}{100x^4y^2\\times x^3y^3}\\\\\\frac{(2x^2y^3)^3\\times(5xy^2)^2}{(10x^2y)^2\\times(xy)^3}&=\\frac{200x^8y^{13}}{100x^7y^5}\\\\\\frac{(2x^2y^3)^3\\times(5xy^2)^2}{(10x^2y)^2\\times(xy)^3}&=2xy^8\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q21-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{(6ab)^3\\times2a^7b^4}{(2ab)^4\\times(3a^2b)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a^2b$",
          "worked": "$\\begin{aligned}\\frac{(6ab)^3\\times2a^7b^4}{(2ab)^4\\times(3a^2b)^2}&=\\frac{216a^3b^3\\times2a^7b^4}{16a^4b^4\\times9a^4b^2}\\\\\\frac{(6ab)^3\\times2a^7b^4}{(2ab)^4\\times(3a^2b)^2}&=\\frac{432a^{10}b^7}{144a^8b^6}\\\\\\frac{(6ab)^3\\times2a^7b^4}{(2ab)^4\\times(3a^2b)^2}&=3a^2b\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
