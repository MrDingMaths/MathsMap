  "content": {
    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The standard deviation of a normal distribution is $3.3$ and the z-score of $45$ is $-1$.\nFind the mean.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$48.3$",
      "worked": "$$\\begin{aligned}-1&=\\frac{45-\\mu}{3.3}\\\\-3.3&=45-\\mu\\\\\\mu&=45+3.3\\\\\\mu&=48.3\\end{aligned}$$",
      "solutionDiagrams": []
    },
