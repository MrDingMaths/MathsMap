  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "If $f(x)=x^n$, where $n$ is a positive integer, find:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$f'(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$nx^{n-1}$",
          "worked": "$$f'(x)=nx^{n-1}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$f''(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n(n-1)x^{n-2}$",
          "worked": "$$\\begin{aligned}f'(x)&=nx^{n-1}\\\\f''(x)&=n(n-1)x^{n-2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$f^{(n)}(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n!$",
          "worked": "$$\\begin{aligned}f^{(n)}(x)&=n(n-1)\\cdots2\\times1\\,x^0\\\\&=n!\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$f^{(k)}(x)$, where $k$ is an integer and $1\\leq k\\leq n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n!}{(n-k)!}x^{n-k}$",
          "worked": "Each differentiation lowers the exponent by 1 and multiplies by its previous value. Thus\n$$\\begin{aligned}f^{(k)}(x)&=n(n-1)\\cdots(n-k+1)x^{n-k}\\\\&=\\frac{n!}{(n-k)!}x^{n-k}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
