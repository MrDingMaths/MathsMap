  "content": {
    "id": "v2-21-median-practice-j1-104536-root",
    "type": "question",
    "label": null,
    "prompt": "The dataset $4,\\ 8,\\ 12,\\ 20,\\ x$ has the given median. What could the value of $x$ be?",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-21-median-practice-j1-104536-j1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The median is $8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Any value $x\\le 8$.",
          "worked": "$$\\begin{align*}\\text{Ordered values: }&x,\\ 4,\\ 8,\\ 12,\\ 20\\ \\text{ or }\\ 4,\\ x,\\ 8,\\ 12,\\ 20\\\\\\text{Third value}&=8\\end{align*}$$\nFor the median to be $8$, $x$ must be at most $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-21-median-practice-j1-104536-j1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The median is $10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10$.",
          "worked": "$$\\begin{align*}\\text{Ordered values: }&4,\\ 8,\\ x,\\ 12,\\ 20\\\\\\text{Third value}&=x\\\\x&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-21-median-practice-j1-104536-j1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "The median is $12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Any value $x\\ge 12$.",
          "worked": "$$\\begin{align*}\\text{Ordered values: }&4,\\ 8,\\ 12,\\ x,\\ 20\\ \\text{ or }\\ 4,\\ 8,\\ 12,\\ 20,\\ x\\\\\\text{Third value}&=12\\end{align*}$$\nFor the median to be $12$, $x$ must be at least $12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
