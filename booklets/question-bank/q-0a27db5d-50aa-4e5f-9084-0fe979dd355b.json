      {
        "id": "p40-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{d}{dx}(\\sec x)=\\sec x\\tan x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(\\sec x)=\\dfrac{\\sin x}{\\cos^2x}=\\sec x\\tan x$.",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}(\\sec x)&=\\frac{d}{dx}\\left(\\frac{1}{\\cos x}\\right)\\\\&=\\frac{\\sin x}{\\cos^2x}\\\\&=\\left(\\frac{1}{\\cos x}\\right)\\left(\\frac{\\sin x}{\\cos x}\\right)\\\\&=\\sec x\\tan x.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p40-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "Use $u=\\sec x$ and $\\displaystyle\\int a^x\\,dx=\\frac{a^x}{\\ln a}+C$ to find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p40-q10-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\displaystyle\\int_0^{\\pi/3}2^{\\sec x}\\sec x\\tan x\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{2}{\\ln 2}$",
              "worked": {
                "format": "maths-editor-document-v1",
                "version": 1,
                "blocks": [
                  {
                    "id": "p40-q10-bi-working-layout",
                    "type": "layout",
                    "arrangement": "parallel",
                    "title": "",
                    "border": false,
                    "padding": 3,
                    "margin": 3,
                    "gap": 3,
                    "columns": 2,
                    "slots": [
                      {
                        "id": "p40-q10-bi-main",
                        "blocks": [
                          {
                            "id": "p40-q10-bi-main-equations",
                            "type": "paragraph",
                            "fontSize": null,
                            "align": "left",
                            "spaceBefore": 0,
                            "spaceAfter": 2,
                            "lineHeight": 1.4,
                            "indent": 0,
                            "inlines": [
                              {
                                "type": "math",
                                "latex": "\\begin{aligned}\\int_0^{\\pi/3}2^{\\sec x}\\sec x\\tan x\\,dx&=\\int_1^2 2^u\\,du\\\\&=\\left[\\frac{2^u}{\\ln 2}\\right]_1^2\\\\&=\\frac{4-2}{\\ln 2}\\\\&=\\frac{2}{\\ln 2}.\\end{aligned}",
                                "display": true
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "id": "p40-q10-bi-substitution",
                        "blocks": [
                          {
                            "id": "p40-q10-bi-substitution-equations",
                            "type": "paragraph",
                            "fontSize": null,
                            "align": "left",
                            "spaceBefore": 0,
                            "spaceAfter": 2,
                            "lineHeight": 1.4,
                            "indent": 0,
                            "inlines": [
                              {
                                "type": "math",
                                "latex": "\\begin{aligned}u&=\\sec x\\\\\\frac{du}{dx}&=\\sec x\\tan x\\\\dx&=\\frac{du}{\\sec x\\tan x}\\\\x=0 &: u=1\\\\x=\\frac{\\pi}{3} &: u=2.\\end{aligned}",
                                "display": true
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "solutionDiagrams": []
            },
            "answerSpaceMm": 65
          },
