                                "type": "math",
                                "latex": "\\begin{aligned}\\int_0^{\\pi/4}\\sec^5x\\tan x\\,dx&=\\int_1^{\\sqrt{2}}u^4\\,du\\\\&=\\left[\\frac{u^5}{5}\\right]_1^{\\sqrt{2}}\\\\&=\\frac{4\\sqrt{2}-1}{5}.\\end{aligned}",
                                "display": true
                              }
                            ]
                          }
