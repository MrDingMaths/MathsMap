  "content": {
    "id": "v2-515e2-p33-practice-slot-14-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Mia plays a tennis match. The probability she wins the first set is 0.6. If she wins the first set, the probability she wins the match is 0.5. If she loses the first set, the probability she wins the match is 0.25.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-515e2-p33-practice-slot-14-upper-slot-14-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the probability that Mia wins the match.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "Let $F$ be the event that Mia wins the first set and $M$ the event that she wins the match.\n$$\\begin{align*}P(M)&=P(F)P(M\\mid F)+P(F')P(M\\mid F')\\\\&=0.6\\times0.5+0.4\\times0.25\\\\&=0.3+0.1\\\\&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-515e2-p33-practice-slot-14-upper-slot-14-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that Mia wins the match, find the probability that she won the first set.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac34$",
          "worked": "$$\\begin{align*}P(F\\mid M)&=\\frac{P(F\\cap M)}{P(M)}\\\\&=\\frac{0.6\\times0.5}{0.4}\\\\&=\\frac{0.3}{0.4}\\\\&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
