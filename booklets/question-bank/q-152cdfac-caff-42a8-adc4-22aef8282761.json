  "content": {
    "id": "p7-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Write a numerical expression for each of the following.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Three different fractions that sum to exactly $\\frac{5}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac18+\\frac16+\\frac13=\\frac58$.",
          "worked": "$$\\begin{align*}\\frac18+\\frac16+\\frac13&=\\frac3{24}+\\frac4{24}+\\frac8{24}\\\\\\frac18+\\frac16+\\frac13&=\\frac{15}{24}\\\\\\frac18+\\frac16+\\frac13&=\\frac58\\end{align*}$$\nThe three fractions are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Two fractions with a difference that is a little more than $\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac45-\\frac14=\\frac{11}{20}$, which is $\\frac1{20}$ more than $\\frac12$.",
          "worked": "$$\\begin{align*}\\frac45-\\frac14&=\\frac{16}{20}-\\frac5{20}\\\\\\frac45-\\frac14&=\\frac{11}{20}\\end{align*}$$\nSince $\\frac12=\\frac{10}{20}$, the difference is $\\frac1{20}$ more than $\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Three different fractions that sum to exactly $\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac1{24}+\\frac1{12}+\\frac18=\\frac14$.",
          "worked": "$$\\begin{align*}\\frac1{24}+\\frac1{12}+\\frac18&=\\frac1{24}+\\frac2{24}+\\frac3{24}\\\\\\frac1{24}+\\frac1{12}+\\frac18&=\\frac6{24}\\\\\\frac1{24}+\\frac1{12}+\\frac18&=\\frac14\\end{align*}$$\nThe three fractions are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "Two fractions with a difference of exactly $\\frac34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac78-\\frac18=\\frac34$.",
          "worked": "$$\\begin{align*}\\frac78-\\frac18&=\\frac68\\\\\\frac78-\\frac18&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
