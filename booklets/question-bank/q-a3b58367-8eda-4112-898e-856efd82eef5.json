    "children": [
      {
        "id": "p22-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "at the origin?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t_2$, $t_4$ and $t_6$.",
          "worked": "At the origin, $x=0$. The graph meets the time axis at $t_2$, $t_4$ and $t_6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p22-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "at rest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Near $t_1$ (slightly before it), and at approximately $t_3$ and $t_5$.",
          "worked": "At rest, $v=\\dfrac{dx}{dt}=0$, so the displacement graph has a horizontal tangent. These occur at the shallow first maximum slightly before $t_1$, the minimum near $t_3$ and the maximum near $t_5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "furthest from the origin?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "At approximately $t_5$, over the interval shown.",
          "worked": "Distance from the origin is $|x|$. Over the interval shown, the largest magnitude of displacement occurs at the higher positive maximum, near $t_5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
