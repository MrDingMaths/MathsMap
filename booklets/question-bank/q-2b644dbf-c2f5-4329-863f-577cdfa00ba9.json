  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "There are 20 litres of a chemical stored in a container.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What amount of chemical remains if 750 mL is removed from the container? Answer in litres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19.25\\text{ L}$",
          "worked": "$$\\begin{align*}750\\text{ mL}&=750\\div1000\\text{ L}\\\\&=0.75\\text{ L}\\\\\\text{Amount remaining}&=20-0.75\\\\&=19.25\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "How many containers, each holding 20 L, are required to hold a kilolitre of the chemical?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50 containers",
          "worked": "$$\\begin{align*}1\\text{ kL}&=1000\\text{ L}\\\\\\text{Number of containers}&=1000\\div20\\\\&=50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
