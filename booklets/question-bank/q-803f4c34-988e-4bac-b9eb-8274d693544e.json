  "content": {
    "id": "v2-eb80a-p50-practice-retro-slot-6-223657-root",
    "type": "question",
    "label": null,
    "prompt": "A sector of a circle has radius 15 cm. Its perimeter equals the circumference of a circle of radius 10 cm.\n\nWhat is the angle at the centre of the sector? Answer to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$125.4^\\circ$",
      "worked": "$$\\begin{align*}P &= 2\\pi(10) = 20\\pi\\\\P &= l + 2r\\\\20\\pi &= \\frac{\\theta}{360}\\times 2\\pi(15) + 2(15)\\\\20\\pi - 30 &= \\frac{\\theta}{360}\\times 30\\pi\\\\\\theta &= \\frac{360(20\\pi-30)}{30\\pi}\\\\\\theta &= 240-\\frac{360}{\\pi}\\approx 125.4^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
