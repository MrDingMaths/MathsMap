  "content": {
    "id": "v2-04517-p41-practice-slot-13-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A dataset has $Q_1=24$ and $Q_3=36$. If there are no outliers in this dataset, what is the largest possible range?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$48$",
      "worked": "$$\\begin{align*}\\text{IQR}&=36-24=12\\\\\\text{Lower fence}&=24-1.5\\times12=6\\\\\\text{Upper fence}&=36+1.5\\times12=54\\\\\\text{Maximum range}&=54-6=48\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
