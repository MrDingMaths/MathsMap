        "answer": {
          "short": "The discriminant is $0$.",
          "worked": "$\\Delta=(-4)^2-4(4)(1)=16-16=0$, so there is exactly one real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p47-q2-solve",
        "type": "part",
        "label": "c",
        "prompt": "Solve: $9w^2+12w=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=-\\dfrac23$",
          "worked": "$$\\begin{aligned}9w^2+12w+4&=0\\\\\\Delta&=12^2-4(9)(4)\\\\\\Delta&=0\\\\w&=\\frac{-12\\pm\\sqrt0}{2(9)}\\\\w&=-\\frac{12}{18}\\\\w&=-\\frac23\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
