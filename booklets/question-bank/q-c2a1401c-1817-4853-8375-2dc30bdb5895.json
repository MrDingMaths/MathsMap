        "answer": {
          "short": "$0$.",
          "worked": "The quadratic formula requires $ax^2+bx+c=0$. Adding $1$ to both sides gives $4w^2-4w+1=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
