  "content": {
    "id": "p63-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Factorise fully:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p63-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^4-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+1)(x+1)(x-1)$",
          "worked": "$$\\begin{align*}x^4-1&=(x^2-1)(x^2+1)\\\\&=(x-1)(x+1)(x^2+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p63-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^4-16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+4)(x+2)(x-2)$",
          "worked": "$$\\begin{align*}x^4-16&=(x^2-4)(x^2+4)\\\\&=(x-2)(x+2)(x^2+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p63-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^4-81$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+9)(x+3)(x-3)$",
          "worked": "$$\\begin{align*}x^4-81&=(x^2-9)(x^2+9)\\\\&=(x-3)(x+3)(x^2+9)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p63-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$16x^4-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x^2+1)(2x+1)(2x-1)$",
          "worked": "$$\\begin{align*}16x^4-1&=(4x^2-1)(4x^2+1)\\\\&=(2x-1)(2x+1)\\times(4x^2+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p63-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^4-y^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+y^2)(x+y)(x-y)$",
          "worked": "$$\\begin{align*}x^4-y^4&=(x^2-y^2)(x^2+y^2)\\\\&=(x-y)(x+y)\\times(x^2+y^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
