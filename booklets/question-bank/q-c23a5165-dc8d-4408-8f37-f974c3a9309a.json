  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A circle is drawn with centre $O$. Line $AB$ is tangent to the circle at $A$ and line $OB$ intersects the circle at $C$. Given $AB=10$ and $BC=5$, find the radius of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{15}{2}$",
      "worked": "Let the radius be $r$. The radius $OA$ is perpendicular to tangent $AB$, and $OB=r+5$. By Pythagoras,\n$$\\begin{align*}(r+5)^2&=r^2+10^2\\\\r^2+10r+25&=r^2+100\\\\10r&=75\\\\r&=\\frac{15}{2}.\\end{align*}$$\nThe radius is $\\dfrac{15}{2}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
