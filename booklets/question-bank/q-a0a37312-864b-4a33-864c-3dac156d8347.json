  "content": {
    "id": "p21-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the lowest common multiple of each of the following groups of terms:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x-2,\\ x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(x+3)$",
          "worked": "The two distinct factors are each required once, so the LCM is $(x-2)(x+3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$6x,\\ 4x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x^2$",
          "worked": "The numerical LCM is $12$ and the greatest power of $x$ is $x^2$, so the LCM is $12x^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$n^2,\\ n^3,\\ n^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^4$",
          "worked": "The greatest required power of $n$ is $n^4$, so the LCM is $n^4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$6cd,\\ 3c,\\ 8d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24cd$",
          "worked": "The numerical LCM is $24$. Both $c$ and $d$ are required once, so the LCM is $24cd$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$4x^2,\\ 6x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x^3$",
          "worked": "The numerical LCM is $12$ and the greatest power of $x$ is $x^3$, so the LCM is $12x^3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$x-2,\\ (x-2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2$",
          "worked": "The greatest required power of the factor $x-2$ is $(x-2)^2$, so this is the LCM.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$abc,\\ bcd,\\ dac$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$abcd$",
          "worked": "Each of $a$, $b$, $c$ and $d$ is required once, so the LCM is $abcd$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2y^3,\\ x^3y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3y^3$",
          "worked": "The greatest required powers are $x^3$ and $y^3$, so the LCM is $x^3y^3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
