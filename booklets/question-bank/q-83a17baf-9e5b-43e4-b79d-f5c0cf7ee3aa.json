  "content": {
    "id": "p33-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "From the letters of the word HEXAGON, five-letter codes are formed. Find the number of codes if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{7}{5}\\times5!=2520$ codes.",
          "worked": "Choose five of the seven distinct letters, then arrange them.\n$$\\begin{align*}N_a&=\\binom{7}{5}\\times5!\\\\N_a&=21\\times120\\\\N_a&=2520.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "the H and X are included.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{5}{3}\\times5!=1200$ codes.",
          "worked": "H and X are already selected. Choose three more letters from E, A, G, O and N, then arrange all five letters.\n$$\\begin{align*}N_b&=\\binom{5}{3}\\times5!\\\\N_b&=10\\times120\\\\N_b&=1200.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p33-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "the H is included, but the G is not included.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{5}{4}\\times5!=600$ codes.",
          "worked": "H is already selected and G is excluded. Choose four more letters from E, X, A, O and N, then arrange all five letters.\n$$\\begin{align*}N_c&=\\binom{5}{4}\\times5!\\\\N_c&=5\\times120\\\\N_c&=600.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
