    "label": null,
    "prompt": "Make $y$ the subject.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-p22-practice-slot-9-slot-9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 y=3+\\log_2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=8x$",
          "worked": "$$\\begin{align*}\\log_2 y-\\log_2 x&=3\\\\\\log_2\\left(\\frac{y}{x}\\right)&=3\\\\\\frac{y}{x}&=2^3\\\\y&=8x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-p22-practice-slot-9-slot-9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_3 y=2-\\log_3 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{9}{x}$",
          "worked": "$$\\begin{align*}\\log_3 y+\\log_3 x&=2\\\\\\log_3(xy)&=2\\\\xy&=3^2\\\\y&=\\frac{9}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
