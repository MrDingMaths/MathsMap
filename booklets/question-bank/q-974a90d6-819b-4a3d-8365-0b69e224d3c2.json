  "content": {
    "id": "p30-q14",
    "type": "question",
    "label": "14",
    "prompt": "A particle is projected from the origin with initial speed $V$ at an angle of $\\alpha$ to the horizontal. Two seconds later it passes through the point with position vector $8\\mathbf{i}-12\\mathbf{j}$. Use $g=10\\text{ m s}^{-2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $V\\cos\\alpha=4$ and $V\\sin\\alpha=4$, and hence write down the initial velocity vector.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V\\cos\\alpha=4$, $V\\sin\\alpha=4$; initial velocity $=4\\mathbf{i}+4\\mathbf{j}\\text{ m s}^{-1}$.",
          "worked": "$$\\begin{aligned}x(2)&=2V\\cos\\alpha=8\\\\V\\cos\\alpha&=4\\\\y(2)&=-5(2)^2+2V\\sin\\alpha=-12\\\\2V\\sin\\alpha&=8\\\\V\\sin\\alpha&=4\\end{aligned}$$\nAlso, $V=\\sqrt{16+16}=4\\sqrt{2}\\text{ m s}^{-1}$ and $\\alpha=45^\\circ$.\nThe initial velocity is $4\\mathbf{i}+4\\mathbf{j}\\text{ m s}^{-1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p30-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the position vector after $0.5$ seconds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathbf{r}(0.5)=(2\\mathbf{i}+0.75\\mathbf{j})\\text{ m}$.",
          "worked": "$$\\begin{aligned}\\mathbf{r}(t)&=4t\\mathbf{i}+(4t-5t^2)\\mathbf{j}\\\\\\mathbf{r}(0.5)&=0.5(4)\\mathbf{i}+\\bigl(0.5(4)-5(0.25)\\bigr)\\mathbf{j}\\\\\\mathbf{r}(0.5)&=(2\\mathbf{i}+0.75\\mathbf{j})\\text{ m}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
