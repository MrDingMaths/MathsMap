        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$x-a=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=b+a$",
          "worked": "$$\\begin{align*}x-a&=b\\\\x&=b+a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x}{a}=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=ab$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=b\\\\x&=ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$ax=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{b}{a}$",
          "worked": "$$\\begin{align*}ax&=b\\\\x&=\\frac{b}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$ax+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{c-b}{a}$",
          "worked": "$$\\begin{align*}ax+b&=c\\\\ax&=c-b\\\\x&=\\frac{c-b}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$ax-b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{c+b}{a}$",
          "worked": "$$\\begin{align*}ax-b&=c\\\\ax&=c+b\\\\x&=\\frac{c+b}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{x}{a}+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a(c-b)$",
          "worked": "$$\\begin{align*}\\frac{x}{a}+b&=c\\\\\\frac{x}{a}&=c-b\\\\x&=a(c-b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x}{a}-b=-c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a(b-c)$",
          "worked": "$$\\begin{align*}\\frac{x}{a}-b&=-c\\\\\\frac{x}{a}&=b-c\\\\x&=a(b-c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q10-i",
        "type": "part",
        "label": "i",
        "prompt": "$a-x=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a-b$",
          "worked": "$$\\begin{align*}a-x&=b\\\\x+b&=a\\\\x&=a-b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q10-j",
        "type": "part",
        "label": "j",
        "prompt": "$a-bx=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{a-c}{b}$",
          "worked": "$$\\begin{align*}a-bx&=c\\\\bx+c&=a\\\\bx&=a-c\\\\x&=\\frac{a-c}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q10-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{x+a}{b}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=bc-a$",
          "worked": "$$\\begin{align*}\\frac{x+a}{b}&=c\\\\x+a&=bc\\\\x&=bc-a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q10-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{a-x}{b}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a-bc$",
          "worked": "$$\\begin{align*}\\frac{a-x}{b}&=c\\\\a-x&=bc\\\\x+bc&=a\\\\x&=a-bc\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q10-m",
        "type": "part",
        "label": "m",
        "prompt": "$a(x+b)=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{c}{a}-b$",
          "worked": "$$\\begin{align*}a(x+b)&=c\\\\x+b&=\\frac{c}{a}\\\\x&=\\frac{c}{a}-b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q10-n",
        "type": "part",
        "label": "n",
        "prompt": "$ax=bx+c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{c}{a-b}$\n\nCollect the $x$ terms and factor out $x$.",
          "worked": "$$\\begin{align*}ax&=bx+c\\\\ax-bx&=c\\\\(a-b)x&=c\\\\x&=\\frac{c}{a-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q10-o",
        "type": "part",
        "label": "o",
        "prompt": "$ax=b-cx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{b}{a+c}$\n\nCollect the $x$ terms and factor out $x$.",
          "worked": "$$\\begin{align*}ax&=b-cx\\\\ax+cx&=b\\\\(a+c)x&=b\\\\x&=\\frac{b}{a+c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q10-p",
        "type": "part",
        "label": "p",
        "prompt": "$ax+b=cx+d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{d-b}{a-c}$\n\nCollect the $x$ terms and factor out $x$.",
          "worked": "$$\\begin{align*}ax+b&=cx+d\\\\ax-cx+b&=d\\\\ax-cx&=d-b\\\\(a-c)x&=d-b\\\\x&=\\frac{d-b}{a-c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q10-q",
        "type": "part",
        "label": "q",
        "prompt": "$ax-b=c-dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{c+b}{a+d}$\n\nCollect the $x$ terms and factor out $x$.",
          "worked": "$$\\begin{align*}ax-b&=c-dx\\\\ax+dx-b&=c\\\\ax+dx&=c+b\\\\(a+d)x&=c+b\\\\x&=\\frac{c+b}{a+d}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q10-r",
        "type": "part",
        "label": "r",
        "prompt": "$ax-b=cx-d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{b-d}{a-c}$\n\nCollect the $x$ terms and factor out $x$.",
          "worked": "$$\\begin{align*}ax-b&=cx-d\\\\ax-cx-b&=-d\\\\ax-cx&=b-d\\\\(a-c)x&=b-d\\\\x&=\\frac{b-d}{a-c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q10-s",
        "type": "part",
        "label": "s",
        "prompt": "$a(x+b)=c(x+d)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{cd-ab}{a-c}$\n\nExpand, collect the $x$ terms and factor out $x$.",
          "worked": "$$\\begin{align*}a(x+b)&=c(x+d)\\\\ax+ab&=cx+cd\\\\ax-cx+ab&=cd\\\\ax-cx&=cd-ab\\\\(a-c)x&=cd-ab\\\\x&=\\frac{cd-ab}{a-c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p6-q10-t",
        "type": "part",
        "label": "t",
        "prompt": "$a(b-x)=c(d+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{ab-cd}{a+c}$\n\nExpand, collect the $x$ terms and factor out $x$.",
          "worked": "$$\\begin{align*}a(b-x)&=c(d+x)\\\\ab-ax&=cd+cx\\\\ax+cx+cd&=ab\\\\ax+cx&=ab-cd\\\\(a+c)x&=ab-cd\\\\x&=\\frac{ab-cd}{a+c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
