      {
        "id": "p39-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How much would it cost for a 2-hour job (i.e. $x=2$)?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$200$",
          "worked": "$$\\begin{align*}\\text{Cost}&=40+80\\times2\\\\\\text{Cost}&=40+160\\\\\\text{Cost}&=200\\end{align*}$$The cost is $\\$200$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p39-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How much would it cost for a job that takes 8 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$680$",
          "worked": "$$\\begin{align*}\\text{Cost}&=40+80\\times8\\\\\\text{Cost}&=40+640\\\\\\text{Cost}&=680\\end{align*}$$The cost is $\\$680$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
