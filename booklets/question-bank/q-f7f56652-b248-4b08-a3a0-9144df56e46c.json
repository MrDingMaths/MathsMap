  "content": {
    "id": "p4-q3",
    "type": "question",
    "label": "3",
    "prompt": "The circumference of a circle is 40 cm. The formula for the circumference is $C = \\pi d$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange to get $d$ as the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d = \\frac{C}{\\pi}$",
          "worked": "$$\\begin{align*}\\frac{C}{\\pi} &= d\\\\d &= \\frac{C}{\\pi}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "Find, to 1 decimal place, the diameter of the circle with circumference:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p4-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "40 cm",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12.7\\text{ cm}$",
              "worked": "$$\\begin{align*}d &= \\frac{40}{\\pi}\\text{ cm}\\\\d &\\approx 12.7\\text{ cm}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p4-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "82 cm",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$26.1\\text{ cm}$",
              "worked": "$$\\begin{align*}d &= \\frac{82}{\\pi}\\text{ cm}\\\\d &\\approx 26.1\\text{ cm}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          }
        ]
      }
    ]
  },
