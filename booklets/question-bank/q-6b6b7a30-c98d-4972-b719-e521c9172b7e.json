      {
        "id": "p32-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^{-3}\\times a^{-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{a^8}$",
          "worked": "$$\\begin{align*}a^{-3}\\times a^{-5}&=a^{-8}\\\\a^{-3}\\times a^{-5}&=\\frac{1}{a^8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$2a^3\\times7a^{-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{14}{a^3}$",
          "worked": "$$\\begin{align*}2a^3\\times7a^{-6}&=14a^{3-6}\\\\2a^3\\times7a^{-6}&=\\frac{14}{a^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{12a^4}{3a^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{a^2}$",
          "worked": "$$\\begin{align*}\\frac{12a^4}{3a^6}&=4a^{4-6}\\\\\\frac{12a^4}{3a^6}&=\\frac{4}{a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2a^{-1})^2\\times(4a^2)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{4a^6}$\n\nRaise every factor to its outside power, then combine the powers of $a$.",
          "worked": "$$\\begin{align*}(2a^{-1})^2\\times(4a^2)^{-2}&=4a^{-2}\\times\\frac{1}{16}a^{-4}\\\\(2a^{-1})^2\\times(4a^2)^{-2}&=\\frac14a^{-6}\\\\(2a^{-1})^2\\times(4a^2)^{-2}&=\\frac{1}{4a^6}\\end{align*}$$",
