  "content": {
    "id": "p38-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "Max and Jack each throw a die. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "they do not throw the same number,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{6}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p38-q22-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "A two-way table is useful for this question.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p38-q22-a-count",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "There are 36 equally likely ordered outcomes. Six have the same number on both dice.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p38-q22-a-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}P(\\text{different numbers})&=1-P(\\text{same})\\\\P(\\text{different numbers})&=1-\\frac{6}{36}\\\\P(\\text{different numbers})&=\\frac{30}{36}\\\\P(\\text{different numbers})&=\\frac{5}{6}\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p38-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "the number thrown by Max is greater than the number thrown by Jack,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{12}$",
          "worked": "In a two-way table, Max's throws of $1,2,3,4,5,6$ give respectively $0,1,2,3,4,5$ outcomes where Max's number is greater. There are $0+1+2+3+4+5=15$ favourable outcomes.\n$$\\begin{align*}P(\\text{Max}>\\text{Jack})&=\\frac{15}{36}\\\\P(\\text{Max}>\\text{Jack})&=\\frac{5}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p38-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "the numbers they throw differ by three.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "The favourable ordered outcomes $(\\text{Max},\\text{Jack})$ in the two-way table are $(1,4),(2,5),(3,6),(4,1),(5,2),(6,3)$.\n$$\\begin{align*}P(\\text{differ by }3)&=\\frac{6}{36}\\\\P(\\text{differ by }3)&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
