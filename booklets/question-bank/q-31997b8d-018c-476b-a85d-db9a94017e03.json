    "children": [
      {
        "id": "p48-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$3(2^x)>21$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\log_2 7$; boundary $\\log_2 7\\approx2.807$.",
          "worked": "$$\\begin{align*}2^x&>7\\\\\\log_2(2^x)&>\\log_2 7\\\\x&>\\log_2 7\\end{align*}$$\nApplying $\\log_2$ retains the sign because $2>1$. Boundary: $\\log_2 7\\approx2.807$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p48-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$4(5^x)<36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<\\log_5 9$; boundary $\\log_5 9\\approx1.365$.",
          "worked": "$$\\begin{align*}5^x&<9\\\\\\log_5(5^x)&<\\log_5 9\\\\x&<\\log_5 9\\end{align*}$$\nApplying $\\log_5$ retains the sign because $5>1$. Boundary: $\\log_5 9\\approx1.365$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p48-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$2(0.5)^x>6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<\\log_{0.5}3$; boundary $\\log_{0.5}3\\approx-1.585$.",
          "worked": "$$\\begin{align*}(0.5)^x&>3\\\\\\log_{0.5}((0.5)^x)&<\\log_{0.5}3\\\\x&<\\log_{0.5}3\\end{align*}$$\nApplying $\\log_{0.5}$ reverses the sign because $0<0.5<1$. Boundary: $\\log_{0.5}3\\approx-1.585$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p48-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$5(0.8)^x<15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\log_{0.8}3$; boundary $\\log_{0.8}3\\approx-4.923$.",
          "worked": "$$\\begin{align*}(0.8)^x&<3\\\\\\log_{0.8}((0.8)^x)&>\\log_{0.8}3\\\\x&>\\log_{0.8}3\\end{align*}$$\nApplying $\\log_{0.8}$ reverses the sign because $0<0.8<1$. Boundary: $\\log_{0.8}3\\approx-4.923$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p48-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$7(1.1)^x+2>30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\log_{1.1}4$; boundary $\\log_{1.1}4\\approx14.545$.",
          "worked": "$$\\begin{align*}7(1.1)^x&>28\\\\(1.1)^x&>4\\\\\\log_{1.1}((1.1)^x)&>\\log_{1.1}4\\\\x&>\\log_{1.1}4\\end{align*}$$\nApplying $\\log_{1.1}$ retains the sign because $1.1>1$. Boundary: $\\log_{1.1}4\\approx14.545$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p48-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$100(0.9)^x<40$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\log_{0.9}\\left(\\frac25\\right)$; boundary $\\log_{0.9}\\left(\\frac25\\right)\\approx8.697$.",
          "worked": "$$\\begin{align*}(0.9)^x&<\\frac25\\\\\\log_{0.9}((0.9)^x)&>\\log_{0.9}\\left(\\frac25\\right)\\\\x&>\\log_{0.9}\\left(\\frac25\\right)\\end{align*}$$\nApplying $\\log_{0.9}$ reverses the sign because $0<0.9<1$. Boundary: $\\log_{0.9}\\left(\\frac25\\right)\\approx8.697$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
