  "content": {
    "id": "p28-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A parallelogram has the same area as a rectangle of width $4\\text{ cm}$ and length $6\\text{ cm}$. If the height of the parallelogram is $10\\text{ cm}$, what is the length of the base?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2.4\\text{ cm}$",
      "worked": "$$\\begin{align*}\\text{Area of rectangle}&=6\\times4\\\\\\text{Area of rectangle}&=24\\text{ cm}^2\\end{align*}$$\nThe parallelogram also has area $24\\text{ cm}^2$.\n$$\\begin{align*}\\text{Base}&=\\text{area}\\div\\text{height}\\\\\\text{Base}&=24\\div10\\\\\\text{Base}&=2.4\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
