    "children": [
      {
        "id": "v2-ac439-p13-practice-slot-6-slot-6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sin 64^{\\circ}}{\\cos 26^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\cos 26^{\\circ}&=\\sin(90^{\\circ}-26^{\\circ})\\\\&=\\sin 64^{\\circ}\\\\\\frac{\\sin 64^{\\circ}}{\\cos 26^{\\circ}}&=\\frac{\\sin 64^{\\circ}}{\\sin 64^{\\circ}}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-ac439-p13-practice-slot-6-slot-6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan 15^{\\circ}\\times\\tan 75^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\tan 75^{\\circ}&=\\tan(90^{\\circ}-15^{\\circ})\\\\&=\\frac{1}{\\tan 15^{\\circ}}\\\\\\tan 15^{\\circ}\\times\\tan 75^{\\circ}&=\\tan 15^{\\circ}\\times\\frac{1}{\\tan 15^{\\circ}}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-ac439-p13-practice-slot-6-slot-6-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos 10^{\\circ}-\\sin 80^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\sin 80^{\\circ}&=\\cos(90^{\\circ}-80^{\\circ})\\\\&=\\cos 10^{\\circ}\\\\\\cos 10^{\\circ}-\\sin 80^{\\circ}&=\\cos 10^{\\circ}-\\cos 10^{\\circ}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-ac439-p13-practice-slot-6-slot-6-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sin 35^{\\circ}}{\\cos 55^{\\circ}}+\\tan 20^{\\circ}\\times\\tan 70^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\cos 55^{\\circ}&=\\sin 35^{\\circ}\\\\\\tan 70^{\\circ}&=\\frac{1}{\\tan 20^{\\circ}}\\\\\\frac{\\sin 35^{\\circ}}{\\cos 55^{\\circ}}+\\tan 20^{\\circ}\\times\\tan 70^{\\circ}&=1+\\tan 20^{\\circ}\\times\\frac{1}{\\tan 20^{\\circ}}\\\\&=1+1\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
