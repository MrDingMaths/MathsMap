  "content": {
    "id": "p32-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_1^e\\frac{dx}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\int_1^e\\frac{dx}{x}&=\\left[\\ln|x|\\right]_1^e\\\\&=\\ln e-\\ln1\\\\&=1-0\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p32-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^{e^2}\\frac{dx}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\int_1^{e^2}\\frac{dx}{x}&=\\left[\\ln|x|\\right]_1^{e^2}\\\\&=\\ln(e^2)-\\ln1\\\\&=2-0\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p32-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_e^{e^4}\\frac{dx}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{aligned}\\int_e^{e^4}\\frac{dx}{x}&=\\left[\\ln|x|\\right]_e^{e^4}\\\\&=\\ln(e^4)-\\ln e\\\\&=4-1\\\\&=3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p32-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{\\sqrt e}^e\\frac{dx}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{aligned}\\int_{\\sqrt e}^e\\frac{dx}{x}&=\\left[\\ln|x|\\right]_{\\sqrt e}^e\\\\&=\\ln e-\\ln(e^{1/2})\\\\&=1-\\frac12\\\\&=\\frac12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
