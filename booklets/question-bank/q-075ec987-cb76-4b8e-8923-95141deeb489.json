  "content": {
    "id": "p24-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The faces of a die are labelled with the first six prime numbers: $2,3,5,7,11$ and $13$. The die is rolled ten times and the product of the ten numbers is recorded. How many different products can be obtained?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
