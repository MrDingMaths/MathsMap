      {
        "id": "p72-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of $A$ and $B$ exactly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=(3-2\\sqrt2,4)$, $B=(3+2\\sqrt2,4)$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p72-q3-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "At an intersection,",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(x-3)^2-4&=-\\frac12(x-3)^2+8\\\\\\frac32(x-3)^2&=12\\\\(x-3)^2&=8\\\\x&=3\\pm2\\sqrt2\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Substitution gives",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "y=8-4=4.",
                    "display": true,
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Therefore",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "A=(3-2\\sqrt2,4),\\qquad B=(3+2\\sqrt2,4).",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p72-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why $AB$ must be horizontal before solving any equations.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both parabolas have axis $x=3$, so $A$ and $B$ are reflections with equal $y$-coordinates. Hence $AB$ is horizontal.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p72-q3-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Both parabolas have axis of symmetry ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "x=3",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ". Their intersection points must therefore be reflections of one another across this vertical line, so they have the same ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "y",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": "-coordinate. Thus ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "AB",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is horizontal.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p72-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the exact length of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=4\\sqrt2$; subtract the $x$-coordinates.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p72-q3-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "AB",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is horizontal,",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}AB&=(3+2\\sqrt2)-(3-2\\sqrt2)\\\\AB&=4\\sqrt2.\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
