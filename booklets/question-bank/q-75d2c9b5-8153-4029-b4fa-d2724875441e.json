  "content": {
    "id": "p24-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "For each of the following, write your answer in the form $ax+by=c$. Find the equation of the line through:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2,1)$ that is perpendicular to $y=2x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y=4$",
          "worked": "The given gradient is $2$, so the perpendicular gradient is $-\\frac12$.\n$$\\begin{align*}y-1&=-\\frac12(x-2)\\\\2y-2&=-x+2\\\\x+2y&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-2,3)$ that is perpendicular to $y=-3x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-3y=-11$",
          "worked": "The given gradient is $-3$, so the perpendicular gradient is $\\frac13$.\n$$\\begin{align*}y-3&=\\frac13(x+2)\\\\3y-9&=x+2\\\\x-3y&=-11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3,2)$ that is perpendicular to $y=\\frac23x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+2y=13$",
          "worked": "The given gradient is $\\frac23$, so the perpendicular gradient is $-\\frac32$.\n$$\\begin{align*}y-2&=-\\frac32(x-3)\\\\2y-4&=-3x+9\\\\3x+2y&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p24-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2,-3)$ that is perpendicular to $y=-\\frac43x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x-4y=18$",
          "worked": "The given gradient is $-\\frac43$, so the perpendicular gradient is $\\frac34$.\n$$\\begin{align*}y+3&=\\frac34(x-2)\\\\4y+12&=3x-6\\\\3x-4y&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p24-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(1,2)$ that is perpendicular to $2y+3x=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x-3y=-4$",
          "worked": "$$\\begin{align*}2y&=-3x+6\\\\y&=-\\frac32x+3\\end{align*}$$\nThe perpendicular gradient is $\\frac23$.\n$$\\begin{align*}y-2&=\\frac23(x-1)\\\\3y-6&=2x-2\\\\2x-3y&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p24-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-3,-4)$ that is perpendicular to $4x-3y=12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+4y=-25$",
          "worked": "$$\\begin{align*}3y&=4x-12\\\\y&=\\frac43x-4\\end{align*}$$\nThe perpendicular gradient is $-\\frac34$.\n$$\\begin{align*}y+4&=-\\frac34(x+3)\\\\4y+16&=-3x-9\\\\3x+4y&=-25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
