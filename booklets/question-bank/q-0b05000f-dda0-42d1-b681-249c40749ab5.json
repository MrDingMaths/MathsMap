      {
        "id": "p25-q4a",
        "type": "part",
        "label": "a",
        "prompt": "If $y'=\\dfrac{1}{\\sqrt{36-x^2}}$ and $y=\\dfrac{\\pi}{6}$ when $x=3$, find $y$ when $x=3\\sqrt3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{\\pi}{3}$",
          "worked": "$$\\begin{aligned}y&=\\int\\frac{1}{\\sqrt{36-x^2}}\\,dx\\\\&=\\sin^{-1}\\left(\\frac{x}{6}\\right)+C\\end{aligned}$$\nSubstitute $x=3$, $y=\\dfrac{\\pi}{6}$:\n$$\\begin{aligned}\\frac{\\pi}{6}&=\\sin^{-1}\\left(\\frac12\\right)+C\\\\&=\\frac{\\pi}{6}+C\\\\C&=0\\\\y&=\\sin^{-1}\\left(\\frac{x}{6}\\right)\\end{aligned}$$\nAt $x=3\\sqrt3$:\n$$\\begin{aligned}y&=\\sin^{-1}\\left(\\frac{3\\sqrt3}{6}\\right)\\\\&=\\sin^{-1}\\left(\\frac{\\sqrt3}{2}\\right)\\\\&=\\frac{\\pi}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p25-q4b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $y'=\\dfrac{2}{4+x^2}$ and $y=\\dfrac{\\pi}{3}$ when $x=2$, find $y$ when $x=\\dfrac{2}{\\sqrt3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{\\pi}{4}$",
          "worked": "$$\\begin{aligned}y&=\\int\\frac{2}{4+x^2}\\,dx\\\\&=2\\cdot\\frac12\\tan^{-1}\\left(\\frac{x}{2}\\right)+C\\\\&=\\tan^{-1}\\left(\\frac{x}{2}\\right)+C\\end{aligned}$$\nSubstitute $x=2$, $y=\\dfrac{\\pi}{3}$:\n$$\\begin{aligned}\\frac{\\pi}{3}&=\\tan^{-1}(1)+C\\\\&=\\frac{\\pi}{4}+C\\\\C&=\\frac{\\pi}{12}\\\\y&=\\tan^{-1}\\left(\\frac{x}{2}\\right)+\\frac{\\pi}{12}\\end{aligned}$$\nAt $x=\\dfrac{2}{\\sqrt3}$:\n$$\\begin{aligned}y&=\\tan^{-1}\\left(\\frac{1}{\\sqrt3}\\right)+\\frac{\\pi}{12}\\\\&=\\frac{\\pi}{6}+\\frac{\\pi}{12}\\\\&=\\frac{\\pi}{4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
