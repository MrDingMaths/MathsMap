  "content": {
    "id": "p6-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "By changing the base to the specified value, simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_8(32)$, [base 2]",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac53$",
          "worked": "$$\\begin{align*}\\log_8(32)&=\\frac{\\log_2(32)}{\\log_2(8)}\\\\\\log_8(32)&=\\frac{\\log_2(2^5)}{\\log_2(2^3)}\\\\\\log_8(32)&=\\frac53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{0.25}(32)$, [base 2]",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac52$",
          "worked": "$$\\begin{align*}\\log_{0.25}(32)&=\\frac{\\log_2(32)}{\\log_2(0.25)}\\\\\\log_{0.25}(32)&=\\frac{\\log_2(2^5)}{\\log_2(2^{-2})}\\\\\\log_{0.25}(32)&=\\frac{5}{-2}\\\\\\log_{0.25}(32)&=-\\frac52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{\\frac19}(27)$, [base 3]",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac32$",
          "worked": "$$\\begin{align*}\\log_{\\frac19}(27)&=\\frac{\\log_3(27)}{\\log_3(1/9)}\\\\\\log_{\\frac19}(27)&=\\frac{\\log_3(3^3)}{\\log_3(3^{-2})}\\\\\\log_{\\frac19}(27)&=\\frac{3}{-2}\\\\\\log_{\\frac19}(27)&=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{25}(125)$, [base 5]",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac32$",
          "worked": "$$\\begin{align*}\\log_{25}(125)&=\\frac{\\log_5(125)}{\\log_5(25)}\\\\\\log_{25}(125)&=\\frac{\\log_5(5^3)}{\\log_5(5^2)}\\\\\\log_{25}(125)&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
