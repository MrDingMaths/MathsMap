      {
        "id": "p8-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x^2+3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+6x^2+9$",
          "worked": "$a=x^2$, $b=3$.\n$$\\begin{align*}(x^2+3)^2&=(x^2)^2+2(x^2)(3)+3^2\\\\&=x^4+6x^2+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x^2-3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-6x^2+9$",
          "worked": "$a=x^2$, $b=-3$.\n$$\\begin{align*}(x^2-3)^2&=(x^2)^2+2(x^2)(-3)+(-3)^2\\\\&=x^4-6x^2+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x^3+2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^6+4x^3+4$",
          "worked": "$a=x^3$, $b=2$.\n$$\\begin{align*}(x^3+2)^2&=(x^3)^2+2(x^3)(2)+2^2\\\\&=x^6+4x^3+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2x^2+5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^4+20x^2+25$",
          "worked": "$a=2x^2$, $b=5$.\n$$\\begin{align*}(2x^2+5)^2&=(2x^2)^2+2(2x^2)(5)+5^2\\\\&=4x^4+20x^2+25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p8-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x^2+y^2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+2x^2y^2+y^4$",
          "worked": "$a=x^2$, $b=y^2$.\n$$\\begin{align*}(x^2+y^2)^2&=(x^2)^2+2(x^2)(y^2)+(y^2)^2\\\\&=x^4+2x^2y^2+y^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
