            "type": "part",
            "label": "ii",
            "prompt": "Find $F$ if $C=40$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$F=104$",
              "worked": "$$\\begin{align*}40&=\\frac{5}{9}(F-32)\\\\360&=5(F-32)\\\\72&=F-32\\\\F&=104\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
