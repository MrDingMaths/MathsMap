      {
        "id": "p22-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(g(f(0)+2))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "From the graphs, $f(0)=2$, $g(4)=3$ and $f(3)=2$.\n$$\\begin{align*}f(g(f(0)+2))&=f(g(2+2))\\\\f(g(f(0)+2))&=f(g(4))\\\\f(g(f(0)+2))&=f(3)\\\\f(g(f(0)+2))&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(f(g(1))+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "From the graphs, $g(1)=1$, $f(1)=1$ and $g(3)=2$.\n$$\\begin{align*}g(f(g(1))+2)&=g(f(1)+2)\\\\g(f(g(1))+2)&=g(1+2)\\\\g(f(g(1))+2)&=g(3)\\\\g(f(g(1))+2)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(f(0))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "From the graphs, $f(0)=2$ and $f(2)=1$.\n$$\\begin{align*}f(f(0))&=f(2)\\\\f(f(0))&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(g(g(4)))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "From the graphs, $g(4)=3$, $g(3)=2$ and $f(2)=1$.\n$$\\begin{align*}f(g(g(4)))&=f(g(3))\\\\f(g(g(4)))&=f(2)\\\\f(g(g(4)))&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
