  "content": {
    "id": "p47-q12-response",
    "type": "question",
    "label": "12",
    "prompt": "There are 3 grey, 2 yellow and 5 white counters in a bag.\nThree are picked at random. Counters are not replaced after each pick.\nWhat is the probability of picking two greys and a white?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{8}$",
      "worked": "Let $G$ represent grey and $W$ represent white. The possible orders are $GGW$, $GWG$ and $WGG$.\n$$\\begin{align*}P(GGW)&=\\frac{3}{10}\\times\\frac{2}{9}\\times\\frac{5}{8}=\\frac{30}{720}\\\\P(GWG)&=\\frac{3}{10}\\times\\frac{5}{9}\\times\\frac{2}{8}=\\frac{30}{720}\\\\P(WGG)&=\\frac{5}{10}\\times\\frac{3}{9}\\times\\frac{2}{8}=\\frac{30}{720}\\\\P(\\text{two greys and a white})&=\\frac{30}{720}+\\frac{30}{720}+\\frac{30}{720}\\\\P(\\text{two greys and a white})&=\\frac{1}{8}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 65
  },
