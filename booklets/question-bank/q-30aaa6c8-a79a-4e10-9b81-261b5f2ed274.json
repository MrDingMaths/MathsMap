  "content": {
    "id": "p19-practice-1-root",
    "type": "question",
    "label": "",
    "prompt": "Find the point on the graph of $f(x)=x^2-5x+4$ where the tangent has:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p19-practice-1-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"supplied function curve distinguished from axes\"}],\"reference\":\"page 19 practice 1 graph\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.35cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\draw[<->,line width=0.5pt] (-5.5,0)--(5.7,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-5.5)--(0,6.2) node[above] {$y$};\n\\draw[<->,curveBlue,line width=0.8pt,domain=-0.35:5.35,samples=101,smooth] plot (\\x,{\\x*\\x-5*\\x+4});\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
