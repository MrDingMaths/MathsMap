          "sourceRegion": "First practice question, right-hand graph",
          "description": "Upward-opening parabola with arrowheads, arrowed axes and no ticks or grid.",
          "mathematics": "y=x^2-5x+4; roots 1 and 4; vertex (5/2,-9/4); y-intercept 4.",
          "answerVisibility": "Supplied curve only; no answer coordinates or tangents."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p19-practice-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Gradient $-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,0)$",
          "worked": "$\\begin{align*}f'(x)&=2x-5\\\\2x-5&=-3\\\\2x&=2\\\\x&=1\\\\f(1)&=1-5+4\\\\f(1)&=0\\end{align*}$\n\nThe point is $(1,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p19-practice-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Angle of inclination $45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,-2)$",
          "worked": "$\\begin{align*}m&=\\tan45^\\circ\\\\m&=1\\\\f'(x)&=2x-5\\\\2x-5&=1\\\\2x&=6\\\\x&=3\\\\f(3)&=9-15+4\\\\f(3)&=-2\\end{align*}$\n\nThe point is $(3,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ],
