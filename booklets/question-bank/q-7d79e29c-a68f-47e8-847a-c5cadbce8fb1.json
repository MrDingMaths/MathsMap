  "content": {
    "id": "v2-659a8-p11-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "A plumber measures a pipe as $1.7\\text{ m}$, to the nearest $0.1\\text{ m}$. An electrician measures a cable as $24\\text{ m}$, to the nearest metre.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-659a8-p11-practice-slot-5-s5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the percentage error of each measurement. Answer to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Pipe: $2.94\\%$; cable: $2.08\\%$",
          "worked": "$$\\begin{align*}\\text{Pipe: absolute error}&=\\tfrac12\\times0.1=0.05\\text{ m}\\\\\\text{Percentage error}&=\\frac{0.05}{1.7}\\times100\\%\\approx2.94\\%\\\\\\text{Cable: absolute error}&=\\tfrac12\\times1=0.5\\text{ m}\\\\\\text{Percentage error}&=\\frac{0.5}{24}\\times100\\%\\approx2.08\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-659a8-p11-practice-slot-5-s5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Which measurement is more accurate relative to its size?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The cable",
          "worked": "$$2.08\\%<2.94\\%$$ so the cable measurement has the smaller percentage error, so it is more accurate relative to its size.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
