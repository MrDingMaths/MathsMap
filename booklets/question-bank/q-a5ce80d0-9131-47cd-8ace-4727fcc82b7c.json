  "content": {
    "id": "v2-2dca1-p24-practice-topup-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Six students have towers of $4,\\ 9,\\ 6,\\ 11,\\ 0$ and $12$ blocks.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-2dca1-p24-practice-topup-slot-10-topup-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The blocks are shared equally so that every tower has the same height. Find the height of each tower.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$ blocks.",
          "worked": "$$\\begin{align*}\\bar{x}&=\\frac{4+9+6+11+0+12}{6}\\\\\\bar{x}&=\\frac{42}{6}\\\\\\bar{x}&=7\\text{ blocks}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-2dca1-p24-practice-topup-slot-10-topup-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "How many blocks must be moved from taller towers to shorter towers to make all six towers the same height?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$ blocks.\n\nAdd the amounts by which the taller towers exceed $7$.",
          "worked": "The towers taller than $7$ blocks are $9,\\ 11$ and $12$.\n$$\\begin{align*}\\text{Blocks moved}&=(9-7)+(11-7)+(12-7)\\\\\\text{Blocks moved}&=2+4+5\\\\\\text{Blocks moved}&=11\\end{align*}$$\nCheck: the shorter towers need $3+1+7=11$ blocks.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
