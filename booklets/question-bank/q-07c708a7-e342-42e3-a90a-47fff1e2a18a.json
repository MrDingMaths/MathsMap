  "content": {
    "id": "v2-a5908-p60-practice-slot-14-root",
    "type": "question",
    "label": null,
    "prompt": "The angle of inclination of a line is $120^\\circ$ and it passes through the points $(1,5)$ and $(x,-1)$.\nFind the exact value of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=1+2\\sqrt3$. Use $m=\\tan120^\\circ=-\\sqrt3$ and $\\dfrac{-6}{x-1}=-\\sqrt3$.",
      "worked": "$$\\begin{align*}m&=\\tan120^\\circ=-\\sqrt3\\\\m&=\\frac{y_2-y_1}{x_2-x_1}=\\frac{-1-5}{x-1}=-\\sqrt3\\\\\\frac{-6}{x-1}&=-\\sqrt3\\\\x-1&=\\frac6{\\sqrt3}\\\\x-1&=2\\sqrt3\\\\x&=1+2\\sqrt3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
