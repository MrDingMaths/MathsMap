  "content": {
    "id": "p8-circles-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "For a sector with radius $12\\text{ cm}$ and angle $72^\\circ$, find the following. Give each answer in terms of $\\pi$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-circles-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "the perimeter of the sector",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(24+4.8\\pi)\\text{ cm}$",
          "worked": "The sector is $\\frac{72}{360}=\\frac{1}{5}$ of a circle. Arc length $=(\\frac{1}{5})(2\\pi\\times12)=\\frac{24\\pi}{5}\\text{ cm}$. Add both radii: $P=24+\\frac{24\\pi}{5}=(24+4.8\\pi)\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-circles-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "the area of the sector",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28.8\\pi\\text{ cm}^2$",
          "worked": "$A=(\\frac{72}{360})\\pi(12)^2=\\frac{144\\pi}{5}=28.8\\pi\\text{ cm}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
