        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\sin90^\\circ\\times\\sin225^\\circ\\times\\cos135^\\circ&=1\\times\\left(-\\frac{\\sqrt2}{2}\\right)\\times\\left(-\\frac{\\sqrt2}{2}\\right)\\\\\\sin90^\\circ\\times\\sin225^\\circ\\times\\cos135^\\circ&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p13-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin330^\\circ\\times\\cos240^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "$$\\begin{align*}\\sin330^\\circ\\times\\cos240^\\circ&=\\left(-\\frac12\\right)\\times\\left(-\\frac12\\right)\\\\\\sin330^\\circ\\times\\cos240^\\circ&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
