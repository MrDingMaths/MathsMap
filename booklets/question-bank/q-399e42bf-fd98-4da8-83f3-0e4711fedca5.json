  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A sample of red-eyed tree frogs is taken from an area surrounding a pond in central Queensland.\n\nThe lengths of the frogs in millimetres are as follows.\n\n$33,\\ 35,\\ 45,\\ 50,\\ 55,\\ 58,\\ 32,\\ 56,\\ 60,\\ 32$\n\nFind the sample mean of these data.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$45.6\\text{ mm}$",
      "worked": "$$\\begin{align*}\\text{Sample mean}&=\\frac{33+35+45+50+55+58+32+56+60+32}{10}\\\\\\text{Sample mean}&=\\frac{456}{10}\\\\\\text{Sample mean}&=45.6\\text{ mm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
