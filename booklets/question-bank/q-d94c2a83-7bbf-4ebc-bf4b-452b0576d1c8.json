    "children": [
      {
        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the complete expansion of $(1-x)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-4x+6x^2-4x^3+x^4$",
          "worked": "The fourth row of Pascal’s triangle is $1,4,6,4,1$.\n\n$$\\begin{align*}(1-x)^4&=1+4(-x)+6(-x)^2+4(-x)^3+(-x)^4\\\\(1-x)^4&=1-4x+6x^2-4x^3+x^4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, evaluate $(0.99)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.96059601$",
          "worked": "Substitute $x=0.01$ into the expansion in part (a).\n\n$$\\begin{align*}(0.99)^4&=1-4(0.01)+6(0.01)^2-4(0.01)^3+(0.01)^4\\\\(0.99)^4&=1-0.04+0.0006-0.000004+0.00000001\\\\(0.99)^4&=0.96059601.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
