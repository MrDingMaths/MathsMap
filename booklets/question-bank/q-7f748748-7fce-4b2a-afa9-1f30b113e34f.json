              }
            ]
          },
          {
            "id": "p24-q37-answer-place-values",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let the original number be ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "N=1000a+100b+10c+d",
                "display": false
              },
              {
                "type": "text",
                "text": ". The reversed number is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "R=1000d+100c+10b+a",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p24-q37-answer-subtraction",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}N-R&=(1000a+100b+10c+d)-(1000d+100c+10b+a)\\\\N-R&=999a+90b-90c-999d\\\\N-R&=9(111a+10b-10c-111d)\\end{align*}",
                "display": false
              }
            ]
          },
          {
            "id": "p24-q37-answer-positive-difference",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Subtracting the smaller number from the larger gives ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "D=|N-R|=9|111a+10b-10c-111d|",
                "display": false
              },
              {
                "type": "text",
                "text": ", so D is divisible by 9.",
                "marks": []
              }
            ]
          },
          {
            "id": "p24-q37-answer-digit-sum-definition",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Write the difference as ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "D=1000p+100q+10r+s",
                "display": false
              },
              {
                "type": "text",
                "text": ", using leading zeros if needed. Its digit sum is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "S=p+q+r+s",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p24-q37-answer-digit-sum-proof",
            "type": "paragraph",
