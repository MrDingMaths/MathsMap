  "content": {
    "id": "p32-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Two particles $P_1$ and $P_2$ are projected from the origin with initial velocity vectors $20\\mathbf{i}+30\\mathbf{j}$ and $60\\mathbf{i}+50\\mathbf{j}$ respectively. $P_2$ is projected $2$ seconds after $P_1$.\n\nDetermine whether they collide and, if so, when. Take $g=10\\text{ m/s}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "They collide $3\\text{ s}$ after $P_1$ is projected, which is $1\\text{ s}$ after $P_2$ is projected.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
