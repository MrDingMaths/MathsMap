  "content": {
    "id": "v2-p48-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "\\$3000 is invested at 4% compound interest per year.\nAfter how many whole years will the balance first exceed \\$10 000?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "31 years",
      "worked": "Let $n$ be the number of years.\n$$\\begin{align*}3000(1.04)^n &> 10000\\\\(1.04)^n &> \\frac{10}{3}\\\\n &> \\log_{1.04}\\left(\\frac{10}{3}\\right)\\end{align*}$$\nThe base $1.04>1$, so the inequality direction is unchanged. Since $30<\\log_{1.04}\\left(\\frac{10}{3}\\right)<31$, the balance first exceeds \\$10 000 after 31 whole years.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
