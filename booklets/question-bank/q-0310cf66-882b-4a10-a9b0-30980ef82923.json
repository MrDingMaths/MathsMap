    "children": [
      {
        "id": "p11-q5-first",
        "type": "part",
        "label": "a",
        "prompt": "At what value of $x$ will the lowest point of the graph be? How do you know?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$x=2.5$, the midpoint of 2 and 3.",
          "worked": "The points at $x=2$ and $x=3$ have equal $y$-values, so the axis of symmetry lies halfway between them.\n$$\\begin{align*}x&=\\frac{2+3}{2}\\\\x&=2.5\\end{align*}$$\nThe parabola opens upwards, so its lowest point is on this axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q5-second",
        "type": "part",
        "label": "b",
        "prompt": "What will the $y$-value be at this point?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3.25$.",
          "worked": "$$\\begin{align*}y&=(2.5)^2-5(2.5)+3\\\\y&=6.25-12.5+3\\\\y&=-3.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-root-bank-p11-q5-third",
        "type": "part",
        "label": "c",
        "prompt": "Find $y$ when $x=1.5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2.25$.",
          "worked": "$$\\begin{align*}y&=(1.5)^2-5(1.5)+3\\\\y&=2.25-7.5+3\\\\y&=-2.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q5-root-bank-p11-q5-fourth",
        "type": "part",
        "label": "d",
        "prompt": "Use the axis of symmetry to find a different $x$-value with the same $y$-value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3.5$. It is the same distance from $x=2.5$ as $x=1.5$.",
          "worked": "The axis of symmetry is $x=2.5$. Since $1.5$ is 1 unit to the left, the matching point is 1 unit to the right: $x=3.5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
