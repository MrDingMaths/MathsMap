    "children": [
      {
        "id": "p2-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Let $k\\in\\mathbb{N}$. Prove that the sum of $2k+1$ consecutive integers is a multiple of $2k+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2k+1)n$, where $n$ is the middle integer.\n\nPair terms equally far from the middle; their offsets cancel.",
          "worked": "Let $n$ be the middle integer and $S$ the sum. The offsets from $n$ cancel in pairs:\n$$\\begin{align*}S &= (n-k)+\\cdots+(n-1)+n+(n+1)+\\cdots+(n+k)\\\\S &= (2k+1)n.\\end{align*}$$\nSince $n$ is an integer, the sum is a multiple of $2k+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p2-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $k\\in\\mathbb{N}$. Prove that the sum of $2k$ consecutive integers is a multiple of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k(2n+2k+1)$, where $n+1$ is the first integer.\n\nCollect the terms and factor out $k$.",
          "worked": "Let $n+1$ be the first integer and $S$ the sum.\n$$\\begin{align*}S &= (n+1)+\\cdots+(n+2k)\\\\S &= 2kn+(1+2+\\cdots+2k)\\\\S &= 2kn+\\frac{2k(2k+1)}{2}\\\\S &= 2kn+k(2k+1)\\\\S &= k(2n+2k+1).\\end{align*}$$\nSince $2n+2k+1$ is an integer, the sum is a multiple of $k$. It is never a multiple of $2k$, because $2n+2k+1$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
