    "type": "question",
    "label": null,
    "prompt": "Solve the following for $x$ by first expressing in the form $a^b=c$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-g35-36-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_x(25)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}x^2&=25\\\\x&=\\pm5\\end{align*}$$\nA logarithm base must satisfy $x>0$ and $x\\ne1$, so reject $x=-5$.\n\nHence, $x=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-g35-36-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_x(64)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}x^3&=64\\\\x&=4\\end{align*}$$\nSince $4>0$ and $4\\ne1$, this is a valid logarithm base.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
