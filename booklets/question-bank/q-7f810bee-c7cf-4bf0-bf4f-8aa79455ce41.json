  "content": {
    "id": "p15-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "One 500 g bag of almonds costs $\\$9.70$. A second 450 g bag of almonds costs $\\$8.80$. Which bag offers the best value for money?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "The first bag (500 g for $\\$9.70$).",
      "worked": "Compare the prices per kilogram.\n\nBag 1:\n$$\\begin{align*}\\text{Price per kilogram}&=\\frac{\\$9.70}{0.5\\text{ kg}}\\\\\\text{Price per kilogram}&=\\$19.40/\\text{kg}\\end{align*}$$\nBag 2:\n$$\\begin{align*}\\text{Price per kilogram}&=\\frac{\\$8.80}{0.45\\text{ kg}}\\\\\\text{Price per kilogram}&=\\$\\frac{176}{9}/\\text{kg}\\end{align*}$$\nSince $19.40<\\frac{176}{9}$, the first bag offers the best value for money.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 78
  },
