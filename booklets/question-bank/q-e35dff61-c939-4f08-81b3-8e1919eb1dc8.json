        "answer": {
          "short": "$40:111$",
          "worked": "$$\\begin{align*}1\\frac{2}{3}:4\\frac{5}{8}&=\\frac{5}{3}:\\frac{37}{8}\\\\1\\frac{2}{3}:4\\frac{5}{8}&=\\frac{40}{24}:\\frac{111}{24}\\\\1\\frac{2}{3}:4\\frac{5}{8}&=40:111\\end{align*}$$",
          "solutionDiagrams": []
        },
