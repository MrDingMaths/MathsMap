  "content": {
    "id": "p15-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Express each of the following as a ratio of integers in simplest form:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{3}:\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:3$",
          "worked": "$$\\begin{align*}\\frac{1}{3}:\\frac{1}{2}&=\\frac{2}{6}:\\frac{3}{6}\\\\\\frac{1}{3}:\\frac{1}{2}&=2:3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{4}{5}:\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6:5$",
          "worked": "$$\\begin{align*}\\frac{4}{5}:\\frac{2}{3}&=\\frac{12}{15}:\\frac{10}{15}\\\\\\frac{4}{5}:\\frac{2}{3}&=12:10\\\\\\frac{4}{5}:\\frac{2}{3}&=6:5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{4}:\\frac{1}{5}:\\frac{1}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15:12:10$",
          "worked": "$$\\begin{align*}\\frac{1}{4}:\\frac{1}{5}:\\frac{1}{6}&=\\frac{15}{60}:\\frac{12}{60}:\\frac{10}{60}\\\\\\frac{1}{4}:\\frac{1}{5}:\\frac{1}{6}&=15:12:10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{4}:\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:2$",
          "worked": "$$\\begin{align*}\\frac{3}{4}:\\frac{1}{2}&=\\frac{3}{4}:\\frac{2}{4}\\\\\\frac{3}{4}:\\frac{1}{2}&=3:2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{7}{8}:\\frac{5}{6}:\\frac{3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21:20:18$",
          "worked": "$$\\begin{align*}\\frac{7}{8}:\\frac{5}{6}:\\frac{3}{4}&=\\frac{21}{24}:\\frac{20}{24}:\\frac{18}{24}\\\\\\frac{7}{8}:\\frac{5}{6}:\\frac{3}{4}&=21:20:18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$1\\frac{1}{2}:1\\frac{1}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9:8$",
          "worked": "$$\\begin{align*}1\\frac{1}{2}:1\\frac{1}{3}&=\\frac{3}{2}:\\frac{4}{3}\\\\1\\frac{1}{2}:1\\frac{1}{3}&=\\frac{9}{6}:\\frac{8}{6}\\\\1\\frac{1}{2}:1\\frac{1}{3}&=9:8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$2\\frac{3}{4}:2\\frac{5}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33:34$",
          "worked": "$$\\begin{align*}2\\frac{3}{4}:2\\frac{5}{6}&=\\frac{11}{4}:\\frac{17}{6}\\\\2\\frac{3}{4}:2\\frac{5}{6}&=\\frac{33}{12}:\\frac{34}{12}\\\\2\\frac{3}{4}:2\\frac{5}{6}&=33:34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$1\\frac{2}{3}:4\\frac{5}{8}$",
