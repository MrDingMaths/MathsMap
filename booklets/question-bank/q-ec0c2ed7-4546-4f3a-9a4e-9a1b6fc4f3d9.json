  "content": {
    "id": "p12-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "An isosceles triangle has an interior angle of $60^{\\circ}$. Find all the other angles.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q9-working-group",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q9-working",
            "type": "part",
            "label": "a",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$60^{\\circ}$ and $60^{\\circ}$.",
              "worked": "If $60^{\\circ}$ is the unequal angle, let each remaining angle be $x^{\\circ}$.\n$$\\begin{align*}2x+60&=180 &&\\text{(angle sum of a triangle)}\\\\2x&=120\\\\x&=60\\end{align*}$$\nIf $60^{\\circ}$ is one of the equal angles, let the remaining angle be $y^{\\circ}$.\n$$\\begin{align*}y+60+60&=180 &&\\text{(angle sum of a triangle)}\\\\y+120&=180\\\\y&=60\\end{align*}$$\nIn either case, the other angles are $60^{\\circ}$ and $60^{\\circ}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      },
      {
        "id": "p12-q9-notice",
        "type": "part",
        "label": "b",
        "prompt": "What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An isosceles triangle with a $60^{\\circ}$ angle is equilateral.",
          "worked": "All three angles are $60^{\\circ}$, so all three sides are equal. The triangle is equilateral.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
