  "content": {
    "id": "p60-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Granny spends one third of her weekly pension on Thursday night,\nand one quarter of what remains on Friday.\nWhat fraction of the original amount is left for her big night out on Saturday?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{2}$ remains: $\\frac{2}{3}\\times\\frac{3}{4}=\\frac{1}{2}$.",
      "worked": "After Thursday, $\\frac{2}{3}$ remains. On Friday, she keeps $\\frac{3}{4}$ of that amount.\n$$\\begin{align*}\\text{Fraction remaining}&=\\frac{2}{3}\\times\\frac{3}{4}\\\\&=\\frac{1}{1}\\times\\frac{1}{2}\\\\&=\\frac{1}{2}\\end{align*}$$\nShe has half remaining.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
