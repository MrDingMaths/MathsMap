  "content": {
    "id": "p36-q12",
    "type": "question",
    "label": "12",
    "prompt": "The two events $A$ and $B$ in the following experiments are known to be independent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(A)=0.4$ and $P(B)=0.6$. Find $P(A\\cap B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.24$",
          "worked": "$$\\begin{align*}P(A\\cap B)&=P(A)\\times P(B)\\\\P(A\\cap B)&=0.4\\times0.6\\\\P(A\\cap B)&=0.24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p36-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(A)=0.3$ and $P(B)=0.5$. Find $P(A\\cap B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.15$",
          "worked": "$$\\begin{align*}P(A\\cap B)&=P(A)\\times P(B)\\\\P(A\\cap B)&=0.3\\times0.5\\\\P(A\\cap B)&=0.15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p36-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(A)=0.4$ and $P(B)=0.6$. Find $P(A\\mid B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "Since $A$ and $B$ are independent,\n$$\\begin{align*}P(A\\mid B)&=P(A)\\\\P(A\\mid B)&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p36-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(A)=0.7$ and $P(B)=0.2$. Find $P(A\\mid B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.7$",
          "worked": "Since $A$ and $B$ are independent,\n$$\\begin{align*}P(A\\mid B)&=P(A)\\\\P(A\\mid B)&=0.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
