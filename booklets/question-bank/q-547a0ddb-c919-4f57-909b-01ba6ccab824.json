  "content": {
    "id": "p19-q4-root",
    "type": "question",
    "label": "5",
    "prompt": "It is known that $x$ and $y$ vary directly according to the model $y=kx$, and that $z$ varies inversely with $y$ according to the equation $z=\\dfrac{m}{y}$.\n\nWhen $x=4$, $y=10$ and $z=6$. Determine the values of $k$ and $m$, and find $z$ when $x=8$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\dfrac{5}{2}$, $m=60$; $z=3$.",
      "worked": "$$\\begin{align*}10&=4k\\\\k&=\\frac{5}{2}\\\\6&=\\frac{m}{10}\\\\m&=60\\end{align*}$$\nWhen $x=8$:\n$$\\begin{align*}y&=\\frac{5}{2}(8)\\\\y&=20\\\\z&=\\frac{60}{20}\\\\z&=3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
