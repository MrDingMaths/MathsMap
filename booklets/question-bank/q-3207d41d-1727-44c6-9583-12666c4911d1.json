  "content": {
    "id": "p15-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "There are two loaf cakes. One is 35 cm long and one is 27 cm long.\nBoth cakes are cut into slices of equal thickness to sell, with no cake left over.\nWhat is the greatest possible thickness of each slice, in whole centimetres?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "1 cm.",
      "worked": "Use the HCF because the slice length must divide both cake lengths without a remainder.\nFactors of 35: $1,5,7,35$.\nFactors of 27: $1,3,9,27$.\nThe only shared factor is 1, so the greatest possible slice length is 1 cm.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
