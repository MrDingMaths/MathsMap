    "children": [
      {
        "id": "p3-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $2^{10}>10^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{10}=1024>1000=10^3$.",
          "worked": "$$2^{10}=1024>1000=10^3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p3-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $2^{13}<10^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{13}=8192<10000=10^4$.",
          "worked": "$$2^{13}=8192<10000=10^4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p3-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "How many digits does $2^{55}$ have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "17 digits.\n\nUsing parts (a) and (b), $3.2\\times10^{16}<2^{55}<8\\times10^{16}$, so $10^{16}<2^{55}<10^{17}$.",
          "worked": "Using part (a):\n\n$$\\begin{align*}2^{55}&=2^{10\\times5}\\times2^5\\\\2^{55}&=(2^{10})^5\\times32\\\\2^{55}&>(10^3)^5\\times32\\\\2^{55}&>10^{15}\\times32\\\\2^{55}&>3.2\\times10^{16}\\end{align*}$$\n\nUsing part (b):\n\n$$\\begin{align*}2^{55}&=2^{13\\times4}\\times2^3\\\\2^{55}&=(2^{13})^4\\times8\\\\2^{55}&<(10^4)^4\\times8\\\\2^{55}&<10^{16}\\times8\\\\2^{55}&<8\\times10^{16}\\end{align*}$$\n\nThus $10^{16}<2^{55}<10^{17}$, so $2^{55}$ has 17 digits.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 108
      }
    ]
  },
