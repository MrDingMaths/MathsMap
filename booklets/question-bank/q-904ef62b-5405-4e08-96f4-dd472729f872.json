    "type": "question",
    "label": "3",
    "prompt": "If 7 tins can hold 1421 g of coffee, how much, in kilograms, can 3 tins hold?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.609\\text{ kg}$",
      "worked": "$$\\begin{align*}\\text{Coffee in 1 tin}&=1421\\div7=203\\text{ g}\\\\\\text{Coffee in 3 tins}&=203\\times3=609\\text{ g}\\\\\\text{Coffee in 3 tins}&=609\\div1000=0.609\\text{ kg}\\end{align*}$$",
      "solutionDiagrams": []
