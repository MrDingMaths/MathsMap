              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}2^{x+y}&=4\\\\3^{x-y}&=27\\end{aligned}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac52,\\ y=-\\frac12$",
          "worked": "$$\\begin{align*}2^{x+y}&=2^2\\\\3^{x-y}&=3^3\\\\x+y&=2\\\\x-y&=3\\end{align*}$$\n\nAdd the linear equations, then substitute into $x+y=2$.\n\n$$\\begin{align*}2x&=5\\\\x&=\\frac52\\\\\\frac52+y&=2\\\\y&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p11-q3-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q3-b-equation-pair",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}5^{2x+y}&=1\\\\2^{x-2y}&=32\\end{aligned}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=-2$",
          "worked": "$$\\begin{align*}5^{2x+y}&=5^0\\\\2^{x-2y}&=2^5\\\\2x+y&=0\\\\x-2y&=5\\end{align*}$$\n\nSubstitute $y=-2x$ into $x-2y=5$.\n\n$$\\begin{align*}x-2(-2x)&=5\\\\5x&=5\\\\x&=1\\\\y&=-2(1)\\\\y&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p11-q3-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
