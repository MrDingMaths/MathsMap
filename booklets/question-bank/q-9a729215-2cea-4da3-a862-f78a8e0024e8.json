              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}4^{2x-y}&=64\\\\2^{3x+y}&=4\\end{aligned}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=-1$",
          "worked": "$$\\begin{align*}4^{2x-y}&=4^3\\\\2^{3x+y}&=2^2\\\\2x-y&=3\\\\3x+y&=2\\end{align*}$$\n\nAdd the linear equations, then substitute into $3x+y=2$.\n\n$$\\begin{align*}5x&=5\\\\x&=1\\\\3(1)+y&=2\\\\y&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
