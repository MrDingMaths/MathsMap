  "content": {
    "id": "p21-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "In each case below, write an equation and solve it to find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "The number $x$ has 11 added to it and the result is 23.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+11=23$, $x=12$",
          "worked": "$$\\begin{align*}x+11&=23\\\\x+11-11&=23-11\\\\x&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "The number $x$ is multiplied by 7 and the result is 25.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7x=25$, $x=3\\frac{4}{7}$",
          "worked": "$$\\begin{align*}7x&=25\\\\\\frac{7x}{7}&=\\frac{25}{7}\\\\x&=3\\frac{4}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p21-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "The number $x$ is divided by 7, and 3 is subtracted from it. The result is 6.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{7}-3=6$, $x=63$",
          "worked": "$$\\begin{align*}\\frac{x}{7}-3&=6\\\\\\frac{x}{7}-3+3&=6+3\\\\\\frac{x}{7}&=9\\\\\\frac{x}{7}\\times7&=9\\times7\\\\x&=63\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
