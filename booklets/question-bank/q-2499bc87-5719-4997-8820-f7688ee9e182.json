  "content": {
    "id": "p27-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Ming invested $\\$100\\,000$ for five years at $7\\%$ p.a. interest, compounded annually.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the amount invested after one year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$107\\,000$",
          "worked": "$$\\begin{align*}A_1&=100\\,000(1+0.07)\\\\A_1&=\\$107\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p27-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the amount invested after two years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$114\\,490$",
          "worked": "$$\\begin{align*}A_2&=100\\,000(1.07)^2\\\\A_2&=\\$114\\,490\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p27-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the amount invested after five years. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$140\\,255.17$",
          "worked": "$$\\begin{align*}A_5&=100\\,000(1.07)^5\\\\A_5&=140\\,255.17307\\\\A_5&\\approx\\$140\\,255.17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p27-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the percentage increase in the investment over the five-year period, correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40.26\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\frac{100\\,000(1.07)^5-100\\,000}{100\\,000}\\times100\\%\\\\\\text{Percentage increase}&=40.25517307\\%\\\\\\text{Percentage increase}&\\approx40.26\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p27-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the total interest earned over the five years. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$40\\,255.17$",
          "worked": "$$\\begin{align*}I&=100\\,000(1.07)^5-100\\,000\\\\I&\\approx\\$40\\,255.17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p27-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "Find the simple interest on the principal of $\\$100\\,000$ over the five years at the same annual interest rate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$35\\,000$",
          "worked": "$$\\begin{align*}I&=PRT\\\\I&=100\\,000\\times0.07\\times5\\\\I&=\\$35\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
