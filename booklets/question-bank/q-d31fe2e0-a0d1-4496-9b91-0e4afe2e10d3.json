  "content": {
    "id": "p35-q01-06-root",
    "type": "question",
    "label": "1",
    "prompt": "Evaluate the following, and express your answer as an exact value in simplest form.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q01",
        "type": "part",
        "label": "a",
        "prompt": "$\\cot\\frac{3\\pi}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\cot\\frac{3\\pi}{2}&=\\frac{\\cos\\frac{3\\pi}{2}}{\\sin\\frac{3\\pi}{2}}\\\\\\cot\\frac{3\\pi}{2}&=\\frac{0}{-1}\\\\\\cot\\frac{3\\pi}{2}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p35-q02",
        "type": "part",
        "label": "b",
        "prompt": "$\\sec\\frac{2\\pi}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\sec\\frac{2\\pi}{3}&=\\frac{1}{\\cos\\frac{2\\pi}{3}}\\\\\\sec\\frac{2\\pi}{3}&=\\frac{1}{-\\frac12}\\\\\\sec\\frac{2\\pi}{3}&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p35-q03",
        "type": "part",
        "label": "c",
        "prompt": "$\\operatorname{cosec}\\frac{5\\pi}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sqrt2$",
          "worked": "$$\\begin{align*}\\operatorname{cosec}\\frac{5\\pi}{4}&=\\frac{1}{\\sin\\frac{5\\pi}{4}}\\\\\\operatorname{cosec}\\frac{5\\pi}{4}&=\\frac{1}{-\\frac{1}{\\sqrt2}}\\\\\\operatorname{cosec}\\frac{5\\pi}{4}&=-\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p35-q04",
        "type": "part",
        "label": "d",
        "prompt": "$\\cot\\frac{11\\pi}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sqrt3$",
          "worked": "$$\\begin{align*}\\cot\\frac{11\\pi}{6}&=\\frac{\\cos\\frac{11\\pi}{6}}{\\sin\\frac{11\\pi}{6}}\\\\\\cot\\frac{11\\pi}{6}&=\\frac{\\frac{\\sqrt3}{2}}{-\\frac12}\\\\\\cot\\frac{11\\pi}{6}&=-\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p35-q05",
        "type": "part",
        "label": "e",
        "prompt": "$\\sec\\frac{5\\pi}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2\\sqrt3}{3}$",
          "worked": "$$\\begin{align*}\\sec\\frac{5\\pi}{6}&=\\frac{1}{\\cos\\frac{5\\pi}{6}}\\\\\\sec\\frac{5\\pi}{6}&=\\frac{1}{-\\frac{\\sqrt3}{2}}\\\\\\sec\\frac{5\\pi}{6}&=-\\frac{2}{\\sqrt3}\\\\\\sec\\frac{5\\pi}{6}&=-\\frac{2\\sqrt3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p35-q06",
        "type": "part",
        "label": "f",
        "prompt": "$\\operatorname{cosec}\\pi$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Undefined.",
          "worked": "$$\\begin{align*}\\operatorname{cosec}\\pi&=\\frac{1}{\\sin\\pi}\\\\\\operatorname{cosec}\\pi&=\\frac{1}{0}\\end{align*}$$\n\nUndefined because division by zero is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
