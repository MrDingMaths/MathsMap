    "id": "p14-point-membership-a",
    "type": "question",
    "label": "1",
    "prompt": "Determine if y=2x+1 contains the point (1,3).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes.",
      "worked": "For $x=1$,\n$$\\begin{align*}2x+1&=2(1)+1\\\\2x+1&=3.\\end{align*}$$\nThis equals the given $y$-coordinate, so $(1,3)$ lies on the line.",
      "solutionDiagrams": []
    },
