  "content": {
    "id": "p9-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the sum of the natural numbers less than 1000 that are divisible by 6.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$83\\,166$",
      "worked": "The multiples are $6,12,\\ldots,996$, since $6\\times166=996$ and $6\\times167=1002$. There are $166$ terms.\n\n$$\\begin{align*}S_{166}&=\\frac{166}{2}(6+996)\\\\S_{166}&=83\\times1002\\\\S_{166}&=83\\,166.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
