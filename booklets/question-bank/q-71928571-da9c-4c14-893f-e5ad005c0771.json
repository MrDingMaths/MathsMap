  "content": {
    "id": "p3-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A letter is chosen at random from the word RANDOM.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "List the sample space for this experiment.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{R,A,N,D,O,M\\}$",
          "worked": "The possible outcomes are the six letters, so the sample space is $\\{R,A,N,D,O,M\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p3-q1-b",
        "type": "group",
        "label": "b",
        "prompt": "If $B$ is the event ‘the letter chosen is a vowel’,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p3-q1-b-i",
            "type": "part",
            "label": "i",
            "prompt": "write down the outcomes favourable to $B$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\{A,O\\}$",
              "worked": "The vowels in RANDOM are $A$ and $O$, so the favourable outcomes are $\\{A,O\\}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p3-q1-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What is the probability of $B$ occurring?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{3}$",
              "worked": "There are 2 favourable outcomes among 6 equally likely outcomes.\n$$P(B)=\\frac{2}{6}=\\frac{1}{3}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p3-q1-c",
        "type": "group",
        "label": "c",
        "prompt": "Find the probability that the letter chosen:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p3-q1-c-i",
            "type": "part",
            "label": "i",
            "prompt": "is a consonant",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{3}$",
              "worked": "The favourable letters are $R,N,D,M$.\n$$P(\\text{consonant})=\\frac{4}{6}=\\frac{2}{3}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p3-q1-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "comes after K in the alphabet",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{3}$",
              "worked": "The favourable letters are $R,N,O,M$.\n$$P(\\text{after K})=\\frac{4}{6}=\\frac{2}{3}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p3-q1-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "comes before H in the alphabet",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{3}$",
              "worked": "The favourable letters are $A,D$.\n$$P(\\text{before H})=\\frac{2}{6}=\\frac{1}{3}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p3-q1-c-iv",
            "type": "part",
            "label": "iv",
            "prompt": "has an axis of symmetry",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{3}$",
              "worked": "Using ordinary idealised capital letters, $A,D,O,M$ have an axis of symmetry.\n$$P(\\text{axis of symmetry})=\\frac{4}{6}=\\frac{2}{3}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      }
    ]
