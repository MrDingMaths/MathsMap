  "content": {
    "id": "p62-q7-response",
    "type": "question",
    "label": "7",
    "prompt": "Write $x^2+4x+y^2-2y$ in the form $(x+a)^2+(y+b)^2+c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x+2)^2+(y-1)^2-5$",
      "worked": "$$\\begin{align*}(x+a)^2+(y+b)^2+c&=x^2+2ax+y^2+2by+a^2+b^2+c\\end{align*}$$\nEquate coefficients and constant terms.\n$$\\begin{align*}2a&=4\\\\a&=2\\\\2b&=-2\\\\b&=-1\\\\2^2+(-1)^2+c&=0\\\\c&=-5\\end{align*}$$\nHence $x^2+4x+y^2-2y=(x+2)^2+(y-1)^2-5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
