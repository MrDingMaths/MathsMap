    "children": [
      {
        "id": "p41-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Use $u=\\sqrt{x}$ to find $\\displaystyle\\int\\frac{1}{\\sqrt{x(1-x)}}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sin^{-1}\\sqrt{x}+C_1$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p41-q14-a-columns",
                "type": "layout",
                "arrangement": "parallel",
                "title": "",
                "border": false,
                "padding": 3,
                "margin": 3,
                "gap": 3,
                "columns": 2,
                "slots": [
                  {
                    "id": "p41-q14-a-main-slot",
                    "blocks": [
                      {
                        "id": "p41-q14-a-main-working",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\int\\frac{1}{\\sqrt{x(1-x)}}\\,dx&=\\int\\frac{2u}{\\sqrt{u^2(1-u^2)}}\\,du\\\\&=\\int\\frac{2}{\\sqrt{1-u^2}}\\,du\\\\&=2\\sin^{-1}u+C_1\\\\&=2\\sin^{-1}\\sqrt{x}+C_1\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p41-q14-a-substitution-slot",
                    "blocks": [
                      {
                        "id": "p41-q14-a-substitution-working",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}u&=\\sqrt{x}\\\\u^2&=x\\\\dx&=2u\\,du\\\\\\sqrt{x}&=u\\\\1-x&=1-u^2\\end{aligned}",
                            "display": true
                          }
                        ]
                      },
                      {
                        "id": "p41-q14-a-domain-note",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "text",
                            "text": "For ",
                            "marks": []
                          },
                          {
                            "type": "math",
                            "latex": "0<x<1",
                            "display": false
                          },
                          {
                            "type": "text",
                            "text": ", ",
                            "marks": []
                          },
                          {
                            "type": "math",
                            "latex": "u>0",
                            "display": false
                          },
                          {
                            "type": "text",
                            "text": ", so ",
                            "marks": []
                          },
                          {
                            "type": "math",
                            "latex": "\\sqrt{u^2}=u",
                            "display": false
                          },
                          {
                            "type": "text",
                            "text": ".",
                            "marks": []
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p41-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate the integral in part a again using $u=x-\\frac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^{-1}(2x-1)+C_2$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p41-q14-b-columns",
                "type": "layout",
                "arrangement": "parallel",
                "title": "",
                "border": false,
                "padding": 3,
                "margin": 3,
                "gap": 3,
                "columns": 2,
                "slots": [
                  {
                    "id": "p41-q14-b-main-slot",
                    "blocks": [
                      {
                        "id": "p41-q14-b-main-working",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\int\\frac{1}{\\sqrt{x(1-x)}}\\,dx&=\\int\\frac{1}{\\sqrt{\\frac14-u^2}}\\,du\\\\&=\\int\\frac{1}{\\frac12\\sqrt{1-\\left(\\frac{u}{\\frac{1}{2}}\\right)^2}}\\,du\\\\&=\\sin^{-1}(2u)+C_2\\\\&=\\sin^{-1}(2x-1)+C_2\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p41-q14-b-substitution-slot",
                    "blocks": [
                      {
                        "id": "p41-q14-b-substitution-working",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}u&=x-\\frac12\\\\x&=u+\\frac12\\\\dx&=du\\\\x(1-x)&=\\left(u+\\frac12\\right)\\left(\\frac12-u\\right)\\\\&=\\frac14-u^2\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p41-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence show that $\\sin^{-1}(2x-1)=2\\sin^{-1}\\sqrt{x}-\\frac{\\pi}{2}$, for $0<x<1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^{-1}(2x-1)=2\\sin^{-1}\\sqrt{x}-\\frac{\\pi}{2}$, for $0<x<1$.",
          "worked": "From (a) and (b), both are primitives of the same function on $0<x<1$, so\n$$\\sin^{-1}(2x-1)+C_2=2\\sin^{-1}\\sqrt{x}+C_1.$$\nAt $x=\\frac12$,\n$$\\begin{aligned}\\sin^{-1}(0)&=2\\sin^{-1}\\left(\\frac{1}{\\sqrt2}\\right)+(C_1-C_2)\\\\0&=2\\left(\\frac{\\pi}{4}\\right)+(C_1-C_2)\\\\C_1-C_2&=-\\frac{\\pi}{2}.\\end{aligned}$$\nTherefore\n$$\\sin^{-1}(2x-1)=2\\sin^{-1}\\sqrt{x}-\\frac{\\pi}{2},\\qquad 0<x<1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
