    "children": [
      {
        "id": "p7-q5-price",
        "type": "part",
        "label": "a",
        "prompt": "Work out the price of a handbag that cost $\\$60$ before the sale.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$43.20$",
          "worked": "$$\\begin{align*}\\text{Final price} &= \\$60\\times0.9\\times0.8\\\\\\text{Final price} &= \\$60\\times0.72\\\\\\text{Final price} &= \\$43.20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q5-comparison",
        "type": "part",
        "label": "b",
        "prompt": "Is this the same as $30\\%$ off?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. $30\\%$ off gives $\\$42$.",
          "worked": "$$\\begin{align*}\\text{Price with }30\\%\\text{ off} &= \\$60\\times0.7\\\\\\text{Price with }30\\%\\text{ off} &= \\$42\\end{align*}$$\nNo. The successive discounts give $\\$43.20$, so they are not equivalent to $30\\%$ off.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
