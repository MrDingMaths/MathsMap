  "content": {
    "id": "v2-3ab5c-p29-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Find the exact value of the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-3ab5c-p29-practice-slot-10-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan 180^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "On the unit circle, the point at $180^{\\circ}$ is $(-1,0)$.\n$$\\begin{align*}\\tan 180^{\\circ}&=\\frac{\\sin 180^{\\circ}}{\\cos 180^{\\circ}}\\\\&=\\frac{0}{-1}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-3ab5c-p29-practice-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin 135^{\\circ}\\times\\cos 180^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{\\sqrt{2}}$",
          "worked": "$$\\begin{align*}A&=180^{\\circ}-135^{\\circ}=45^{\\circ}\\\\\\sin 135^{\\circ}&=\\sin 45^{\\circ}=\\frac{1}{\\sqrt{2}}\\\\\\cos 180^{\\circ}&=-1\\\\\\sin 135^{\\circ}\\times\\cos 180^{\\circ}&=-\\frac{1}{\\sqrt{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-3ab5c-p29-practice-slot-10-slot-10-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos 150^{\\circ}+\\sin 90^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-\\dfrac{\\sqrt{3}}{2}$",
          "worked": "$$\\begin{align*}A&=180^{\\circ}-150^{\\circ}=30^{\\circ}\\\\\\cos 150^{\\circ}&=-\\cos 30^{\\circ}=-\\frac{\\sqrt{3}}{2}\\\\\\sin 90^{\\circ}&=1\\\\\\cos 150^{\\circ}+\\sin 90^{\\circ}&=-\\frac{\\sqrt{3}}{2}+1\\\\&=1-\\frac{\\sqrt{3}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-3ab5c-p29-practice-slot-10-slot-10-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sin 120^{\\circ}}{\\cos 180^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{\\sqrt{3}}{2}$",
          "worked": "$$\\begin{align*}A&=180^{\\circ}-120^{\\circ}=60^{\\circ}\\\\\\sin 120^{\\circ}&=\\sin 60^{\\circ}=\\frac{\\sqrt{3}}{2}\\\\\\cos 180^{\\circ}&=-1\\\\\\frac{\\sin 120^{\\circ}}{\\cos 180^{\\circ}}&=\\frac{\\sqrt{3}/2}{-1}\\\\&=-\\frac{\\sqrt{3}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
