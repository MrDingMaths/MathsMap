    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Consider a triangle $ABC$ for which $\\angle A+\\angle B=\\angle C$. Find the measure of $\\angle C$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$90^{\\circ}$",
      "worked": "By the angle sum of a triangle and the given relationship,\n$$\\begin{align*}\\angle A+\\angle B+\\angle C&=180^{\\circ}\\\\\\angle C+\\angle C&=180^{\\circ}\\\\2\\angle C&=180^{\\circ}\\\\\\angle C&=90^{\\circ}.\\end{align*}$$",
      "solutionDiagrams": []
    },
