  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Without using a calculator, find the exact value of $\\operatorname{cosec}^{2}30^\\circ-\\cot^{2}30^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$",
      "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\left(\\frac{1}{\\sin30^\\circ}\\right)^2-\\left(\\frac{1}{\\tan30^\\circ}\\right)^2\\\\&=\\left(\\frac{1}{\\frac12}\\right)^2-\\left(\\frac{1}{\\frac1{\\sqrt3}}\\right)^2\\\\&=(2)^2-(\\sqrt3)^2\\\\&=1\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
