    "type": "question",
    "label": "4",
    "prompt": "Find $f'(1)$ if $f(x)=\\ln\\sqrt{2-x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(1)=-\\dfrac12$.",
      "worked": "$$\\begin{align*}f(x)&=\\frac12\\ln(2-x)\\\\f'(x)&=\\frac12\\left(-\\frac{1}{2-x}\\right)\\\\f'(x)&=-\\frac{1}{2(2-x)}\\\\f'(1)&=-\\frac{1}{2(2-1)}\\\\f'(1)&=-\\frac12\\end{align*}$$",
      "solutionDiagrams": []
    },
