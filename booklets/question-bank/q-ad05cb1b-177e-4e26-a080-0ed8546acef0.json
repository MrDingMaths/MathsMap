    "children": [
      {
        "id": "p10-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$4p^2-(q+r)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2p-q-r)(2p+q+r)$",
          "worked": "$$\\begin{align*}4p^2-(q+r)^2&=[2p-(q+r)][2p+(q+r)]\\\\4p^2-(q+r)^2&=(2p-q-r)(2p+q+r).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^2-b^2-a+b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-b)(a+b-1)$",
          "worked": "$$\\begin{align*}a^2-b^2-a+b&=(a-b)(a+b)-(a-b)\\\\a^2-b^2-a+b&=(a-b)(a+b-1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$a^3-10a^2b+24ab^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a(a-4b)(a-6b)$",
          "worked": "$$\\begin{align*}a^3-10a^2b+24ab^2&=a(a^2-10ab+24b^2)\\\\a^3-10a^2b+24ab^2&=a(a-4b)(a-6b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$6x^4-x^3-2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2(3x-2)(2x+1)$",
          "worked": "$$\\begin{align*}6x^4-x^3-2x^2&=x^2(6x^2-x-2)\\\\6x^4-x^3-2x^2&=x^2(6x^2+3x-4x-2)\\\\6x^4-x^3-2x^2&=x^2[3x(2x+1)-2(2x+1)]\\\\6x^4-x^3-2x^2&=x^2(3x-2)(2x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$4x^4-37x^2+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(2x+1)(x-3)(x+3)$",
          "worked": "$$\\begin{align*}4x^4-37x^2+9&=4x^4-36x^2-x^2+9\\\\4x^4-37x^2+9&=4x^2(x^2-9)-(x^2-9)\\\\4x^4-37x^2+9&=(4x^2-1)(x^2-9)\\\\4x^4-37x^2+9&=(2x-1)(2x+1)(x-3)(x+3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$40-18x-40x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(4-5x)(5+4x)$",
          "worked": "$$\\begin{align*}40-18x-40x^2&=2(20-9x-20x^2)\\\\40-18x-40x^2&=2(20+16x-25x-20x^2)\\\\40-18x-40x^2&=2[4(5+4x)-5x(5+4x)]\\\\40-18x-40x^2&=2(4-5x)(5+4x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$4x^3-12x^2-x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(2x+1)(x-3)$",
          "worked": "$$\\begin{align*}4x^3-12x^2-x+3&=4x^2(x-3)-(x-3)\\\\4x^3-12x^2-x+3&=(4x^2-1)(x-3)\\\\4x^3-12x^2-x+3&=(2x-1)(2x+1)(x-3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2+2ax+a^2-b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+a-b)(x+a+b)$",
          "worked": "$$\\begin{align*}x^2+2ax+a^2-b^2&=(x+a)^2-b^2\\\\x^2+2ax+a^2-b^2&=(x+a-b)(x+a+b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
