    "type": "question",
    "label": "11",
    "prompt": "In one week, Sam read four books. The first book had 312 pages, the second 175, the third 48 and the fourth 98. How many pages did Sam read in the week?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "633 pages",
      "worked": "$$\\begin{align*}312+175+48+98&=(312+48)+(175+98)\\\\312+175+48+98&=360+273\\\\312+175+48+98&=633\\end{align*}$$\n\nSam read 633 pages.",
