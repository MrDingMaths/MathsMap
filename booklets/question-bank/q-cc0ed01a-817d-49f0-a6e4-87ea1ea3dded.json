  "content": {
    "id": "p37-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A pyramid has volume $400\\,\\mathrm{cm}^3$. If the side length of its square base is $10\\,\\mathrm{cm}$, then determine the height of the pyramid.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\,\\mathrm{cm}$",
      "worked": "$$\\begin{align*}A&=10^2\\\\A&=100\\ \\mathrm{cm}^2\\\\V&=\\frac13Ah\\\\400&=\\frac13(100)h\\\\h&=\\frac{3\\times400}{100}\\\\h&=12\\ \\mathrm{cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
