  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Write the equation of the parabola obtained when the basic parabola, $y=-x^2$, is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "translated 3 units to the right",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-3)^2$",
          "worked": "A translation 3 units to the right replaces $x$ by $x-3$.\n\n$$y=-(x-3)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "translated $b$ units to the left",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x+b)^2$",
          "worked": "A translation $b$ units to the left replaces $x$ by $x+b$.\n\n$$y=-(x+b)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "translated 6 units down",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^2-6$",
          "worked": "A translation 6 units down subtracts 6 from every $y$-value.\n\n$$y=-x^2-6$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "translated $c$ units up",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^2+c$",
          "worked": "A translation $c$ units up adds $c$ to every $y$-value.\n\n$$y=-x^2+c$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
