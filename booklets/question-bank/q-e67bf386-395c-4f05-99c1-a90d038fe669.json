  "content": {
    "id": "p17-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A kite has area $14\\text{ cm}^2$. Its longer diagonal exceeds the shorter diagonal by $3\\text{ cm}$. Find the lengths of these diagonals.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\text{ cm}$ and $7\\text{ cm}$.\n\nUse $A=\\frac{pq}{2}$ with diagonals $x$ and $x+3$.",
      "worked": "Let the shorter diagonal be $x\\text{ cm}$, so the longer diagonal is $(x+3)\\text{ cm}$.\n$$\\begin{align*}14&=\\frac{x(x+3)}{2}\\\\x(x+3)&=28\\\\x^2+3x-28&=0\\\\(x+7)(x-4)&=0\\end{align*}$$\nThus $x=4$ or $x=-7$. A length is positive, so $x=4$.\nThe diagonals are $4\\text{ cm}$ and $4+3=7\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
