  "content": {
    "id": "p79-q28",
    "type": "question",
    "label": null,
    "prompt": "A bag contains seven white and five black discs. Three discs are chosen from the bag. Find the probability that all three discs are black, if the discs are chosen:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p79-q28-ab",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p79-q28-a",
            "type": "part",
            "label": "a",
            "prompt": "without replacement,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{22}$",
              "worked": "$$\\begin{aligned}P(\\text{all black})&=\\frac{{}^{5}C_3}{{}^{12}C_3}\\\\&=\\frac{10}{220}\\\\&=\\frac{1}{22}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p79-q28-b",
            "type": "part",
            "label": "b",
            "prompt": "with replacement,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{125}{1728}$",
              "worked": "Replacement keeps the probability of black at $\\frac{5}{12}$ on every draw.\n$$\\begin{aligned}P(\\text{all black})&=\\left(\\frac{5}{12}\\right)^3\\\\&=\\frac{125}{1728}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          }
        ]
      },
      {
        "id": "p79-q28-c",
        "type": "part",
        "label": "c",
        "prompt": "so that after each draw the disc is replaced with one of the opposite colour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{144}$",
          "worked": "A tree diagram may help you visualise this. Along the all-black branch, the number of black discs decreases from 5 to 4 to 3, while the total remains 12.\n$$\\begin{aligned}P(\\text{all black})&=\\frac{5}{12}\\times\\frac{4}{12}\\times\\frac{3}{12}\\\\&=\\frac{5}{144}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
