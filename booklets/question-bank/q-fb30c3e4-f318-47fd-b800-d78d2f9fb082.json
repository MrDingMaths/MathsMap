  "content": {
    "id": "p57-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Solve each of these equations for $0\\le\\theta<360^{\\circ}$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q2-a",
        "type": "group",
        "label": "a",
        "prompt": "$\\sin\\theta=\\dfrac{\\sqrt3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p57-q2-a-reference",
            "type": "part",
            "label": "1",
            "prompt": "Reference angle",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$A=60^{\\circ}$",
              "worked": "$$\\begin{align*}A&=\\sin^{-1}\\left(\\frac{\\sqrt3}{2}\\right)\\\\A&=60^{\\circ}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p57-q2-a-quadrants",
            "type": "part",
            "label": "2",
            "prompt": "Quadrants",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Q1 and Q2.",
              "worked": "$\\sin\\theta>0$, so $\\theta$ is in Q1 or Q2.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p57-q2-a-solutions",
            "type": "part",
            "label": "3",
            "prompt": "Solutions",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\theta=60^{\\circ}$ or $120^{\\circ}$.",
              "worked": "$$\\begin{align*}\\theta&=60^{\\circ}\\quad\\text{or}\\quad180^{\\circ}-60^{\\circ}\\\\\\theta&=60^{\\circ}\\quad\\text{or}\\quad120^{\\circ}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          }
        ]
      },
      {
        "id": "p57-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=45^{\\circ}$ or $225^{\\circ}$.",
          "worked": "$$\\begin{align*}A&=\\tan^{-1}(1)\\\\A&=45^{\\circ}\\end{align*}$$\n\n$\\tan\\theta>0$, so $\\theta$ is in Q1 or Q3.\n\n$$\\begin{align*}\\theta&=45^{\\circ}\\quad\\text{or}\\quad180^{\\circ}+45^{\\circ}\\\\\\theta&=45^{\\circ}\\quad\\text{or}\\quad225^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p57-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\theta=\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^{\\circ}$ or $240^{\\circ}$.",
          "worked": "$$\\begin{align*}A&=\\tan^{-1}(\\sqrt3)\\\\A&=60^{\\circ}\\end{align*}$$\n\n$\\tan\\theta>0$, so $\\theta$ is in Q1 or Q3.\n\n$$\\begin{align*}\\theta&=60^{\\circ}\\quad\\text{or}\\quad180^{\\circ}+60^{\\circ}\\\\\\theta&=60^{\\circ}\\quad\\text{or}\\quad240^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p57-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\theta=-\\dfrac{1}{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=135^{\\circ}$ or $225^{\\circ}$.",
          "worked": "$$\\begin{align*}A&=\\cos^{-1}\\left(\\frac{1}{\\sqrt2}\\right)\\\\A&=45^{\\circ}\\end{align*}$$\n\n$\\cos\\theta<0$, so $\\theta$ is in Q2 or Q3.\n\n$$\\begin{align*}\\theta&=180^{\\circ}-45^{\\circ}\\\\\\theta&=135^{\\circ}\\end{align*}$$\n\nor\n\n$$\\begin{align*}\\theta&=180^{\\circ}+45^{\\circ}\\\\\\theta&=225^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p57-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\tan\\theta=-\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=120^{\\circ}$ or $300^{\\circ}$.",
          "worked": "$$\\begin{align*}A&=\\tan^{-1}(\\sqrt3)\\\\A&=60^{\\circ}\\end{align*}$$\n\n$\\tan\\theta<0$, so $\\theta$ is in Q2 or Q4.\n\n$$\\begin{align*}\\theta&=180^{\\circ}-60^{\\circ}\\\\\\theta&=120^{\\circ}\\end{align*}$$\n\nor\n\n$$\\begin{align*}\\theta&=360^{\\circ}-60^{\\circ}\\\\\\theta&=300^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p57-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\cos\\theta=-\\dfrac{\\sqrt3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=150^{\\circ}$ or $210^{\\circ}$.",
          "worked": "$$\\begin{align*}A&=\\cos^{-1}\\left(\\frac{\\sqrt3}{2}\\right)\\\\A&=30^{\\circ}\\end{align*}$$\n\n$\\cos\\theta<0$, so $\\theta$ is in Q2 or Q3.\n\n$$\\begin{align*}\\theta&=180^{\\circ}-30^{\\circ}\\\\\\theta&=150^{\\circ}\\end{align*}$$\n\nor\n\n$$\\begin{align*}\\theta&=180^{\\circ}+30^{\\circ}\\\\\\theta&=210^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
