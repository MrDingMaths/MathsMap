        "label": "a",
        "prompt": "Find the actual mean travel time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23.2$ minutes",
          "worked": "$$\\begin{align*}\\sum(x\\times f)&=10\\times2+14\\times3+18\\times1+22\\times4+25\\times2+27\\times3+31\\times3+36\\times2\\\\&=20+42+18+88+50+81+93+72\\\\&=464\\\\\\bar{x}&=\\frac{464}{20}\\\\&=23.2\\text{ minutes}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-5c088-p13-practice-slot-7-slot-7-b",
        "type": "part",
        "label": "b",
        "prompt": "Group the data into the classes 10–19, 20–29 and 30–39. Use the grouped data to estimate the mean travel time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$ minutes",
          "worked": "Frequencies: $10$–$19$: $2+3+1=6$; $20$–$29$: $4+2+3=9$; $30$–$39$: $3+2=5$.\nClass centres: $14.5,\\ 24.5,\\ 34.5$.\n$$\\begin{align*}\\sum(cc\\times f)&=14.5\\times6+24.5\\times9+34.5\\times5\\\\&=87+220.5+172.5\\\\&=480\\\\\\sum f&=6+9+5=20\\\\\\bar{x}&=\\frac{480}{20}\\\\&=24\\text{ minutes}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ],
