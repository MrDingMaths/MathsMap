  "content": {
    "id": "p30-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The 7 button on my calculator does not work. Show how I might use my calculator to work out:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$7\\times20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Enter $4\\times20+3\\times20$ to obtain $140$.",
          "worked": "Use $7=4+3$. Enter $4\\times20+3\\times20$.\n$$\\begin{align*}7\\times20&=4\\times20+3\\times20\\\\7\\times20&=80+60\\\\7\\times20&=140\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
