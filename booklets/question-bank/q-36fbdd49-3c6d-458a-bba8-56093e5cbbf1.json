  "content": {
    "id": "p36-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A computer store states that it will reduce the price of a computer by $10\\%$ each day until it is sold. The original price of the computer is $\\$2500$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the sale price after the first reduction?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2250$",
          "worked": "The reduction multiplier is $1-0.10=0.90$.\n\n$$\\begin{align*}\\text{Price after first reduction}&=2500\\times0.90\\\\\\text{Price after first reduction}&=\\$2250.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p36-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the sale price after the second reduction?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2025$",
          "worked": "$$\\begin{align*}\\text{Price after second reduction}&=2500\\times0.90\\times0.90\\\\\\text{Price after second reduction}&=\\$2025.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p36-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the sale price after the third reduction?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1822.50$",
          "worked": "$$\\begin{align*}\\text{Price after third reduction}&=2500\\times0.90\\times0.90\\times0.90\\\\\\text{Price after third reduction}&=\\$1822.50.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p36-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "What single percentage decrease has the same effect as the three $10\\%$ reductions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27.1\\%$ decrease.\n\nThe combined multiplier is $0.90^3=0.729$, so $72.9\\%$ of the original price remains.",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=0.90\\times0.90\\times0.90\\\\\\text{Combined multiplier}&=0.729.\\end{align*}$$\n\nThe final price is $72.9\\%$ of the original price.\n\n$$\\begin{align*}\\text{Percentage decrease}&=100\\%-72.9\\%\\\\\\text{Percentage decrease}&=27.1\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
