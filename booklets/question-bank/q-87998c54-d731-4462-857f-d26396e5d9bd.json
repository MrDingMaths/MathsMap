    "type": "question",
    "label": "8",
    "prompt": "Find the area of the region bounded by $y=|x+2|$ and the $x$-axis, for $-2\\le x\\le2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8\\,\\mathrm{u}^2$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p12-q8-answer",
