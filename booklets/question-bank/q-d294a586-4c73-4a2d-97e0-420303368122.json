  "content": {
    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A particle moves in a straight line so that its displacement $x$ m from a fixed point O on the line at any time $t$ seconds $(t\\geq 0)$ is given by $x=t^2-5t+6$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "its initial displacement.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ m}$",
          "worked": "$$\\begin{aligned}x(0)&=0^2-5(0)+6\\\\x(0)&=6\\text{ m}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "its initial velocity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5\\text{ m/s}$",
          "worked": "$$\\begin{aligned}v(t)&=\\frac{dx}{dt}=2t-5\\\\v(0)&=2(0)-5\\\\v(0)&=-5\\text{ m/s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p20-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "when it first passes through O and with what velocity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2\\text{ s}$, $v=-1\\text{ m/s}$.",
          "worked": "At O, $x=0$.\n$$\\begin{aligned}t^2-5t+6&=0\\\\(t-2)(t-3)&=0\\\\t&=2\\text{ or }3\\end{aligned}$$\nThe first crossing is at $t=2\\text{ s}$.\n$$\\begin{aligned}v(2)&=2(2)-5\\\\v(2)&=-1\\text{ m/s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p20-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "when it passes through O the second time and with what velocity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=3\\text{ s}$, $v=1\\text{ m/s}$.",
          "worked": "From part c, the second crossing is at $t=3\\text{ s}$.\n$$\\begin{aligned}v(3)&=2(3)-5\\\\v(3)&=1\\text{ m/s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p20-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "when and where its velocity is zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2.5\\text{ s}$, $x=-0.25\\text{ m}$.",
          "worked": "$$\\begin{aligned}2t-5&=0\\\\t&=\\frac{5}{2}\\text{ s}\\\\x\\left(\\frac{5}{2}\\right)&=\\left(\\frac{5}{2}\\right)^2-5\\left(\\frac{5}{2}\\right)+6\\\\x\\left(\\frac{5}{2}\\right)&=-\\frac14\\text{ m}\\end{aligned}$$\nIts velocity is zero at $2.5\\text{ s}$, at displacement $-0.25\\text{ m}$ from O.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
