  "content": {
    "id": "p44-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Given parallelogram $ABCD$, write the vector that is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "p44-q1-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 44 p44-q1-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (D) at (0,0);\n\\coordinate (A) at (3,2);\n\\coordinate (B) at (5,1);\n\\coordinate (C) at (2,-1);\n\\draw[black] (A)--(B)--(C)--(D)--cycle;\n\\draw[black] (A)--(C) (D)--(B);\n\\node[above] at (A) {$A$};\n\\node[right] at (B) {$B$};\n\\node[below] at (C) {$C$};\n\\node[left] at (D) {$D$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 53,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 44,
          "sourceRegion": "Question 1, left diagram",
          "description": "Parallelogram with A above, B right, C below and D left; both diagonals are drawn and their intersection is unlabelled. Source blue outlines become ordinary black house-style geometry.",
          "mathematics": "ABCD is a parallelogram. Diagonals AC and DB connect opposite vertices. No lengths or additional marks are supplied.",
          "answerVisibility": "All geometry and vertex labels remain visible in the question edition."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p44-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{AB}+\\overrightarrow{BC}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AC}$",
          "worked": "$\\overrightarrow{AB}+\\overrightarrow{BC}=\\overrightarrow{AC}$ by the triangle law.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{AD}+\\overrightarrow{DB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AB}$",
          "worked": "$\\overrightarrow{AD}+\\overrightarrow{DB}=\\overrightarrow{AB}$ by the triangle law.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\overrightarrow{DC}+\\overrightarrow{CA}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{DA}$",
          "worked": "$\\overrightarrow{DC}+\\overrightarrow{CA}=\\overrightarrow{DA}$ by the triangle law.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\overrightarrow{CD}+\\overrightarrow{CB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{CA}$",
          "worked": "Opposite sides give $\\overrightarrow{CB}=\\overrightarrow{DA}$.\n$$\\begin{aligned}\\overrightarrow{CD}+\\overrightarrow{CB}&=\\overrightarrow{CD}+\\overrightarrow{DA}\\\\\\overrightarrow{CD}+\\overrightarrow{CB}&=\\overrightarrow{CA}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\overrightarrow{DA}-\\overrightarrow{AB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{CA}$",
          "worked": "Opposite sides give $\\overrightarrow{BA}=\\overrightarrow{CD}$.\n$$\\begin{aligned}\\overrightarrow{DA}-\\overrightarrow{AB}&=\\overrightarrow{DA}+\\overrightarrow{BA}\\\\\\overrightarrow{DA}-\\overrightarrow{AB}&=\\overrightarrow{CD}+\\overrightarrow{DA}\\\\\\overrightarrow{DA}-\\overrightarrow{AB}&=\\overrightarrow{CA}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\overrightarrow{AB}-\\overrightarrow{AD}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{DB}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{AB}-\\overrightarrow{AD}&=\\overrightarrow{DA}+\\overrightarrow{AB}\\\\\\overrightarrow{AB}-\\overrightarrow{AD}&=\\overrightarrow{DB}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\overrightarrow{BC}-\\overrightarrow{CD}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AC}$",
          "worked": "Opposite sides give $\\overrightarrow{DC}=\\overrightarrow{AB}$.\n$$\\begin{aligned}\\overrightarrow{BC}-\\overrightarrow{CD}&=\\overrightarrow{BC}+\\overrightarrow{DC}\\\\\\overrightarrow{BC}-\\overrightarrow{CD}&=\\overrightarrow{AB}+\\overrightarrow{BC}\\\\\\overrightarrow{BC}-\\overrightarrow{CD}&=\\overrightarrow{AC}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
