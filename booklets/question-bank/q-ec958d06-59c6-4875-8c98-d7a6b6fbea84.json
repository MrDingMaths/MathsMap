  "content": {
    "id": "p33-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Complete the square of each quadratic function in order to find its zeroes. Each zero involves a surd.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2-4x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=(x-2)^2-3$; zeroes $2-\\sqrt3$ and $2+\\sqrt3$.",
          "worked": "$$\\begin{align*}f(x)&=(x^2-4x+4)-4+1\\\\f(x)&=(x-2)^2-3\\end{align*}$$\nPut $f(x)=0$.\n$$\\begin{align*}(x-2)^2-3&=0\\\\(x-2)^2&=3\\\\x-2&=\\pm\\sqrt3\\\\x&=2\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p33-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2x^2-4x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=2(x-1)^2-4$; zeroes $1-\\sqrt2$ and $1+\\sqrt2$.",
          "worked": "Write $y=f(x)$.\n$$\\begin{align*}\\frac y2&=x^2-2x-1\\\\\\frac y2&=(x^2-2x+1)-1-1\\\\\\frac y2&=(x-1)^2-2\\\\y&=2(x-1)^2-4\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}2(x-1)^2-4&=0\\\\(x-1)^2&=2\\\\x-1&=\\pm\\sqrt2\\\\x&=1\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 86
      },
      {
        "id": "p33-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=-x^2-6x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=-(x+3)^2+10$; zeroes $-3-\\sqrt{10}$ and $-3+\\sqrt{10}$.",
          "worked": "Write $y=f(x)$.\n$$\\begin{align*}-y&=x^2+6x-1\\\\-y&=(x^2+6x+9)-9-1\\\\-y&=(x+3)^2-10\\\\y&=-(x+3)^2+10\\end{align*}$$\nPut $y=0$.\n$$\\begin{align*}-(x+3)^2+10&=0\\\\(x+3)^2&=10\\\\x+3&=\\pm\\sqrt{10}\\\\x&=-3\\pm\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      }
    ]
