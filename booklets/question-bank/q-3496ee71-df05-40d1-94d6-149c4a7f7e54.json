  "content": {
    "id": "p16-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Use Fermat’s Little Theorem to find the remainder when:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^{12}$ is divided by $13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $13$ is prime and $3$ is not divisible by $13$, Fermat’s Little Theorem gives\n$$3^{12}\\equiv1\\pmod{13}.$$\nThe remainder is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$4^{16}$ is divided by $17$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $17$ is prime and $4$ is not divisible by $17$, Fermat’s Little Theorem gives\n$$4^{16}\\equiv1\\pmod{17}.$$\nThe remainder is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$5^{19}$ is divided by $19$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "By Fermat’s Little Theorem, $5^{18}\\equiv1\\pmod{19}$.\n$$\\begin{align*}5^{19}&=5^{18}\\times5\\\\5^{19}&\\equiv1\\times5\\pmod{19}\\\\5^{19}&\\equiv5\\pmod{19}.\\end{align*}$$\nThe remainder is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$2^{23}$ is divided by $23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "By Fermat’s Little Theorem, $2^{22}\\equiv1\\pmod{23}$.\n$$\\begin{align*}2^{23}&=2^{22}\\times2\\\\2^{23}&\\equiv1\\times2\\pmod{23}\\\\2^{23}&\\equiv2\\pmod{23}.\\end{align*}$$\nThe remainder is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$3^{12}$ is divided by $11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "By Fermat’s Little Theorem, $3^{10}\\equiv1\\pmod{11}$.\n$$\\begin{align*}3^{12}&=3^{10}\\times3^2\\\\3^{12}&\\equiv1\\times9\\pmod{11}\\\\3^{12}&\\equiv9\\pmod{11}.\\end{align*}$$\nThe remainder is $9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^{20}$ is divided by $19$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "By Fermat’s Little Theorem, $4^{18}\\equiv1\\pmod{19}$.\n$$\\begin{align*}4^{20}&=4^{18}\\times4^2\\\\4^{20}&\\equiv1\\times16\\pmod{19}\\\\4^{20}&\\equiv16\\pmod{19}.\\end{align*}$$\nThe remainder is $16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$5^{22}$ is divided by $23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $23$ is prime and $5$ is not divisible by $23$, Fermat’s Little Theorem gives\n$$5^{22}\\equiv1\\pmod{23}.$$\nThe remainder is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$6^{28}$ is divided by $29$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $29$ is prime and $6$ is not divisible by $29$, Fermat’s Little Theorem gives\n$$6^{28}\\equiv1\\pmod{29}.$$\nThe remainder is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
