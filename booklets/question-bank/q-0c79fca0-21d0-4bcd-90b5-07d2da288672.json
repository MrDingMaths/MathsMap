      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "By changing to base 3, calculate $\\log_9 243$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{2}$",
          "worked": "$\\log_3 243=5$ and $\\log_3 9=2$.\n$$\\begin{align*}\\log_9 243&=\\frac{\\log_3 243}{\\log_3 9}\\\\\\log_9 243&=\\frac{5}{2}.\\end{align*}$$\nCheck: $9^{5/2}=(3^2)^{5/2}=3^5=243$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "By changing to base 2, calculate $\\log_8 32$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{3}$",
          "worked": "$\\log_2 32=5$ and $\\log_2 8=3$.\n$$\\begin{align*}\\log_8 32&=\\frac{\\log_2 32}{\\log_2 8}\\\\\\log_8 32&=\\frac{5}{3}.\\end{align*}$$\nCheck: $8^{5/3}=(2^3)^{5/3}=2^5=32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
