  "content": {
    "id": "v2-a28b0-p33-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Find the centre and radius of the circle $x^2+8x+y^2-2y-8=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Centre $(-4,1)$, radius $5$",
      "worked": "$$\\begin{align*}x^2+8x+16-16+y^2-2y+1-1-8&=0\\\\(x^2+8x+16)+(y^2-2y+1)-25&=0\\\\(x+4)^2+(y-1)^2&=25\\end{align*}$$\nComparing with $(x-a)^2+(y-b)^2=r^2$, the centre is $(-4,1)$ and the radius is $\\sqrt{25}=5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
