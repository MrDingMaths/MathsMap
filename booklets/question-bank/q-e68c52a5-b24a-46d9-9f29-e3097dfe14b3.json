              "type": "text",
              "text": "There are 20 students in a class. Their mean mark in a Science test is given as 62%.",
              "marks": []
            }
          ]
        },
        {
          "id": "p19-q14-prompt-2",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "However, one paper has been marked incorrectly and awarded 58% instead of 85%.",
              "marks": []
            }
          ]
        },
        {
          "id": "p19-q14-prompt-3",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "What should the correct mean mark in the test be?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$63.35\\%$. Corrected total: $20\\times62+85-58=1267$; divide by $20$.",
      "worked": {
        "format": "maths-editor-document-v1",
