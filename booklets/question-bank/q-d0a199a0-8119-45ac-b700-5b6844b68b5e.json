  "content": {
    "id": "p13-q61-root",
    "type": "question",
    "label": "61",
    "prompt": "Find the coefficient of $x^m$ from the expansion of $$\\frac{1+(1+x)+(1+x)^2+\\cdots+(1+x)^n}{x^2},$$ where $1\\le m\\le n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p13-q61-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{cases}\\displaystyle\\sum_{j=m+2}^{n}\\binom{j}{m+2},&1\\le m\\le n-2,\\\\0,&m=n-1\\text{ or }m=n.\\end{cases}",
                "display": true
              }
            ]
          },
          {
            "id": "p13-q61-short-method",
            "type": "paragraph",
