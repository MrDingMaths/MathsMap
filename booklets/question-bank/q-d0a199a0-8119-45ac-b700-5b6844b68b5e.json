            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Add the coefficients of ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x^{m+2}",
                "display": false
              },
              {
                "type": "text",
                "text": " in the numerator.",
                "marks": []
