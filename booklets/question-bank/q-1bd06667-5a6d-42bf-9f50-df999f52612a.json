        "answer": {
          "short": "$183.3\\text{ cm}^2$",
          "worked": "$$\\begin{align*}C&=2\\pi r\\\\48&=2\\pi r\\\\\\frac{48}{2\\pi}&=r\\\\r&=\\frac{24}{\\pi}\\text{ cm}\\\\A&=\\pi r^2\\\\A&=\\pi\\left(\\frac{24}{\\pi}\\right)^2\\\\A&=\\frac{576}{\\pi}\\text{ cm}^2\\\\A&\\approx183.3\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
