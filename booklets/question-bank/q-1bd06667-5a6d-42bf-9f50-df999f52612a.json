        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.9\\text{ cm}$",
          "worked": "$$\\begin{align*}A&=\\pi r^2\\\\48&=\\pi r^2\\\\\\frac{48}{\\pi}&=r^2\\\\\\sqrt{\\frac{48}{\\pi}}&=r\\\\r&\\approx3.9\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
