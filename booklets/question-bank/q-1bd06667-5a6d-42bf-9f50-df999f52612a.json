        "prompt": "Calculate the exact circumference of a circle with diameter $5\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\pi\\text{ cm}$",
          "worked": "$$\\begin{align*}C&=\\pi d\\\\C&=\\pi\\times5\\\\C&=5\\pi\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p29-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the exact area of a circle with diameter $5\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{25\\pi}{4}\\text{ cm}^2$",
          "worked": "$$\\begin{align*}r&=\\frac{d}{2}\\\\r&=\\frac{5}{2}\\text{ cm}\\\\A&=\\pi r^2\\\\A&=\\pi\\left(\\frac{5}{2}\\right)^2\\\\A&=\\frac{25\\pi}{4}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p29-q9-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
