      {
        "id": "p53-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "$6x^2+7x-5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$ or $x=-\\frac53$",
          "worked": "$$\\begin{align*}6x^2+7x-5&=0\\\\(2x-1)(3x+5)&=0\\\\x&=\\frac12\\quad\\text{or}\\quad x=-\\frac53.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p53-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "$6\\sin^2x+7\\sin x-5=0$ for $x\\in[0,2\\pi]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{\\pi}{6}$ or $x=\\frac{5\\pi}{6}$",
          "worked": "Let $u=\\sin x$.\n$$\\begin{align*}6u^2+7u-5&=0\\\\(2u-1)(3u+5)&=0\\\\u&=\\frac12\\quad\\text{or}\\quad u=-\\frac53.\\end{align*}$$\nSince $-1\\leq\\sin x\\leq1$, only $\\sin x=\\frac12$ is valid.\nFor $x\\in[0,2\\pi]$:\n$$x=\\frac{\\pi}{6}\\quad\\text{or}\\quad x=\\frac{5\\pi}{6}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p53-q24-c",
        "type": "part",
        "label": "c",
        "prompt": "$6(\\log_3x)^2+7\\log_3x-5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\sqrt3$ or $x=3^{-5/3}=\\frac{1}{\\sqrt[3]{243}}$",
          "worked": "Let $y=\\log_3x$, where $x>0$.\n$$\\begin{align*}6y^2+7y-5&=0\\\\(2y-1)(3y+5)&=0\\\\y&=\\frac12\\quad\\text{or}\\quad y=-\\frac53.\\end{align*}$$\n$$\\begin{align*}\\log_3x&=\\frac12\\\\x&=3^{1/2}=\\sqrt3.\\end{align*}$$\nOr\n$$\\begin{align*}\\log_3x&=-\\frac53\\\\x&=3^{-5/3}\\\\x&=\\frac{1}{\\sqrt[3]{3^5}}=\\frac{1}{\\sqrt[3]{243}}.\\end{align*}$$\nBoth values satisfy $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p53-q24-d",
        "type": "part",
        "label": "d",
        "prompt": "$6e^{2x}+7e^x-5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\ln\\left(\\frac12\\right)=-\\ln2$",
          "worked": "Let $z=e^x$.\n$$\\begin{align*}6z^2+7z-5&=0\\\\(2z-1)(3z+5)&=0\\\\z&=\\frac12\\quad\\text{or}\\quad z=-\\frac53.\\end{align*}$$\nSince $e^x>0$, only $e^x=\\frac12$ is valid.\n$$\\begin{align*}x&=\\ln\\left(\\frac12\\right)\\\\x&=-\\ln2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
