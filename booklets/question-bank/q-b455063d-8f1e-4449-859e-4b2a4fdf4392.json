  "content": {
    "id": "p58-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find $F(a)-1$ and $F(a-1)$ for each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$F(x)=2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(a)-1=2a+2$, $F(a-1)=2a+1$.",
          "worked": "$$\\begin{align*}F(a)-1&=2a+3-1\\\\F(a)-1&=2a+2\\end{align*}$$\n$$\\begin{align*}F(a-1)&=2(a-1)+3\\\\F(a-1)&=2a-2+3\\\\F(a-1)&=2a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p58-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$F(x)=x^2-3x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(a)-1=a^2-3a-8$, $F(a-1)=a^2-5a-3$.",
          "worked": "$$\\begin{align*}F(a)-1&=a^2-3a-7-1\\\\F(a)-1&=a^2-3a-8\\end{align*}$$\n$$\\begin{align*}F(a-1)&=(a-1)^2-3(a-1)-7\\\\F(a-1)&=a^2-2a+1-3a+3-7\\\\F(a-1)&=a^2-5a-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
