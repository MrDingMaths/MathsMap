            {
              "type": "text",
              "text": "Write each of these sets of real numbers in simplest form using bracket interval notation.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$x>-1$ or $x<1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,\\infty)$",
          "worked": "Every real number satisfies at least one of $x>-1$ and $x<1$. Their union is the whole real line, $(-\\infty,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\ge-1$ and $x\\le1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[-1,1]$",
          "worked": "Both conditions must hold, giving $-1\\le x\\le1$. Both endpoints are included, so the interval is $[-1,1]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
