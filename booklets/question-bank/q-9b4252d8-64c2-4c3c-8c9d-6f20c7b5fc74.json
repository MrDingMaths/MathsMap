        "children": [
          {
            "id": "p42-q26-a",
            "type": "part",
            "label": "a",
            "prompt": "What is the relative frequency of selecting a red jelly bean?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.17$",
              "worked": "$$\\begin{align*}\\text{Relative frequency of red}&=1-(0.32+0.13+0.14+0.24)\\\\\\text{Relative frequency of red}&=1-0.83\\\\\\text{Relative frequency of red}&=0.17\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p42-q26-b",
            "type": "part",
            "label": "b",
            "prompt": "Based on this table of relative frequencies, estimate the probability of NOT selecting a black jelly bean.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.86$",
              "worked": "Using relative frequency to estimate probability:\n$$\\begin{align*}P(\\text{not black})&=1-P(\\text{black})\\\\P(\\text{not black})&\\approx1-0.14\\\\P(\\text{not black})&\\approx0.86\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          }
        ]
