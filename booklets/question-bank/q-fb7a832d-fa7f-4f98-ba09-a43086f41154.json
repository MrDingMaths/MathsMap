    "type": "question",
    "label": "46",
    "prompt": "Rationalise the denominator of the following. $$\\frac4{\\sqrt7-\\sqrt5}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2(\\sqrt7+\\sqrt5)$",
      "worked": "$$\\begin{align*}\\frac4{\\sqrt7-\\sqrt5}&=\\frac{4(\\sqrt7+\\sqrt5)}{(\\sqrt7-\\sqrt5)(\\sqrt7+\\sqrt5)}\\\\\\frac4{\\sqrt7-\\sqrt5}&=\\frac{4(\\sqrt7+\\sqrt5)}{7-5}\\\\\\frac4{\\sqrt7-\\sqrt5}&=2(\\sqrt7+\\sqrt5)\\end{align*}$$",
      "solutionDiagrams": []
    },
