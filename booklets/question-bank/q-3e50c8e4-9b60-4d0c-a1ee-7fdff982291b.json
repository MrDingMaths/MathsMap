  "content": {
    "id": "v2-60ad1-p30-practice-slot-7-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify by factorising each base to the smallest prime factors.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-60ad1-p30-practice-slot-7-upper-slot-7-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3^{n+1})^{n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{n^2-1}$",
          "worked": "$$\\begin{align*}(3^{n+1})^{n-1}&=3^{(n+1)(n-1)}\\\\&=3^{n^2-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-60ad1-p30-practice-slot-7-upper-slot-7-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{(2^{n})^{n+2}}{(4^{n})^{n-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{-n^2+4n}$",
          "worked": "$$\\begin{align*}\\frac{(2^{n})^{n+2}}{(4^{n})^{n-1}}&=\\frac{2^{n(n+2)}}{2^{2n(n-1)}}\\\\&=2^{n^2+2n-(2n^2-2n)}\\\\&=2^{-n^2+4n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-60ad1-p30-practice-slot-7-upper-slot-7-upper-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{(9^{n+1})^{n}\\times3^{n}}{(27^{n})^{n-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{-n^2+6n}$",
          "worked": "$$\\begin{align*}\\frac{(9^{n+1})^{n}\\times3^{n}}{(27^{n})^{n-1}}&=\\frac{3^{2n(n+1)}\\times3^{n}}{3^{3n(n-1)}}\\\\&=3^{2n^2+2n+n-(3n^2-3n)}\\\\&=3^{-n^2+6n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
