  "content": {
    "id": "p5-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify these to unit rates.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q1-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p5-q1-a-given",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "$12 in 4 hours",
                  "marks": []
                }
              ]
            },
            {
              "id": "p5-q1-a-fraction-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{\\$12}{4\\text{ hours}}=\\frac{\\$\\,(\\rule{0pt}{5mm}\\hspace{8mm})}{1\\text{ hour}}",
                  "display": false,
                  "colour": "#268cff"
                }
              ]
            },
            {
              "id": "p5-q1-a-result-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "= $",
                  "marks": [],
                  "colour": "#268cff"
                },
                {
                  "type": "cloze",
                  "answer": "3",
                  "width": 9
                },
                {
                  "type": "text",
                  "text": " /hour",
                  "marks": [],
                  "colour": "#268cff"
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$3}{\\text{h}}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{\\$12}{4\\text{ hours}}\\\\\\text{Rate}&=\\frac{\\$12\\div4}{4\\text{ hours}\\div4}\\\\\\text{Rate}&=\\frac{\\$3}{1\\text{ hour}}\\\\\\text{Rate}&=\\$3/\\text{h}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "15 goals per 3 games",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\text{ goals/game}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{15\\text{ goals}}{3\\text{ games}}\\\\\\text{Rate}&=\\frac{15\\text{ goals}\\div3}{3\\text{ games}\\div3}\\\\\\text{Rate}&=\\frac{5\\text{ goals}}{1\\text{ game}}\\\\\\text{Rate}&=5\\text{ goals/game}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "\\$160 for 6 hours. Round to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$26.67}{\\text{h}}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{\\$160}{6\\text{ hours}}\\\\\\text{Rate}&=\\frac{\\$160\\div6}{6\\text{ hours}\\div6}\\\\\\text{Rate}&=\\frac{\\$\\left(\\frac{80}{3}\\right)}{1\\text{ hour}}\\\\\\text{Rate}&\\approx\\$26.67/\\text{h}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p5-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "\\$17.50 for every 5 kg",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$3.50}{\\text{kg}}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{\\$17.50}{5\\text{ kg}}\\\\\\text{Rate}&=\\frac{\\$17.50\\div5}{5\\text{ kg}\\div5}\\\\\\text{Rate}&=\\frac{\\$3.50}{1\\text{ kg}}\\\\\\text{Rate}&=\\$3.50/\\text{kg}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "36000 cans in 8 hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4500\\text{ cans/h}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{36000\\text{ cans}}{8\\text{ hours}}\\\\\\text{Rate}&=\\frac{36000\\text{ cans}\\div8}{8\\text{ hours}\\div8}\\\\\\text{Rate}&=\\frac{4500\\text{ cans}}{1\\text{ hour}}\\\\\\text{Rate}&=4500\\text{ cans/h}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "80 mm rain in 5 days",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\text{ mm/day}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{80\\text{ mm}}{5\\text{ days}}\\\\\\text{Rate}&=\\frac{80\\text{ mm}\\div5}{5\\text{ days}\\div5}\\\\\\text{Rate}&=\\frac{16\\text{ mm}}{1\\text{ day}}\\\\\\text{Rate}&=16\\text{ mm/day}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "15 km in 60 minutes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.25\\text{ km/min}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{15\\text{ km}}{60\\text{ minutes}}\\\\\\text{Rate}&=\\frac{15\\text{ km}\\div60}{60\\text{ minutes}\\div60}\\\\\\text{Rate}&=\\frac{0.25\\text{ km}}{1\\text{ minute}}\\\\\\text{Rate}&=0.25\\text{ km/min}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "78 runs for 12 overs",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.5\\text{ runs/over}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{78\\text{ runs}}{12\\text{ overs}}\\\\\\text{Rate}&=\\frac{78\\text{ runs}\\div12}{12\\text{ overs}\\div12}\\\\\\text{Rate}&=\\frac{6.5\\text{ runs}}{1\\text{ over}}\\\\\\text{Rate}&=6.5\\text{ runs/over}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "91 people in 3 buses",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30.\\dot{3}\\text{ people/bus}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{91\\text{ people}}{3\\text{ buses}}\\\\\\text{Rate}&=\\frac{91\\text{ people}\\div3}{3\\text{ buses}\\div3}\\\\\\text{Rate}&=\\frac{30.\\dot{3}\\text{ people}}{1\\text{ bus}}\\\\\\text{Rate}&=30.\\dot{3}\\text{ people/bus}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "448 km in 8 hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56\\text{ km/h}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{448\\text{ km}}{8\\text{ hours}}\\\\\\text{Rate}&=\\frac{448\\text{ km}\\div8}{8\\text{ hours}\\div8}\\\\\\text{Rate}&=\\frac{56\\text{ km}}{1\\text{ hour}}\\\\\\text{Rate}&=56\\text{ km/h}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "\\$16.50 for 6 kg",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$2.75}{\\text{kg}}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{\\$16.50}{6\\text{ kg}}\\\\\\text{Rate}&=\\frac{\\$16.50\\div6}{6\\text{ kg}\\div6}\\\\\\text{Rate}&=\\frac{\\$2.75}{1\\text{ kg}}\\\\\\text{Rate}&=\\$2.75/\\text{kg}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "243 km using 30 litres",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.1\\text{ km/L}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{243\\text{ km}}{30\\text{ litres}}\\\\\\text{Rate}&=\\frac{243\\text{ km}\\div30}{30\\text{ litres}\\div30}\\\\\\text{Rate}&=\\frac{8.1\\text{ km}}{1\\text{ litre}}\\\\\\text{Rate}&=8.1\\text{ km/L}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
