  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If a die is rolled, find the probability that the uppermost face is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "a three",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "There is one favourable face out of six equally likely faces.\n\n$$P(\\text{three})=\\frac{1}{6}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "an even number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The even faces are $2,4,6$.\n\n$$\\begin{align*}P(\\text{even})&=\\frac{3}{6}\\\\P(\\text{even})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "a number greater than four",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "The faces greater than four are $5,6$.\n\n$$\\begin{align*}P(\\text{greater than }4)&=\\frac{2}{6}\\\\P(\\text{greater than }4)&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "a multiple of three",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "The faces that are multiples of three are $3,6$.\n\n$$\\begin{align*}P(\\text{multiple of }3)&=\\frac{2}{6}\\\\P(\\text{multiple of }3)&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
