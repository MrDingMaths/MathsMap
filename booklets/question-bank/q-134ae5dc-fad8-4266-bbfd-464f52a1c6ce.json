  "content": {
    "id": "p20-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "In the game of Bridge, the 52 playing cards are evenly distributed to four players. How many different ways are there to deal hands to the four players?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\binom{52}{13}\\binom{39}{13}\\binom{26}{13}$",
      "worked": "Each player receives 13 cards. Choose the first three players’ hands successively from the remaining cards; the fourth player receives the remaining 13 cards.\n\n$$\\begin{align*}N&=\\binom{52}{13}\\binom{39}{13}\\binom{26}{13}\\binom{13}{13}\\\\N&=\\binom{52}{13}\\binom{39}{13}\\binom{26}{13}.\\end{align*}$$",
      "solutionDiagrams": []
    },
