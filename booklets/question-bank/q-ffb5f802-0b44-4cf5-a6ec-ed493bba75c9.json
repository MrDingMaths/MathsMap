        "type": "part",
        "label": "a",
        "prompt": "$\\frac{10m^7n^5}{2m^2n^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5m^{5}n$",
          "worked": "$$\\begin{align*}\n\\frac{10m^7n^5}{2m^2n^4} &= \\frac{10\\,m^{7 - 2}\\,n^{5 - 4}}{2} \\\\\n&= 5m^{5}n\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{12a^4b^5}{8ab^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3a^{3}b^{2}}{2}$",
          "worked": "$$\\begin{align*}\n\\frac{12a^4b^5}{8ab^3} &= \\frac{12\\,a^{4 - 1}\\,b^{5 - 3}}{8} \\\\\n&= \\frac{3a^{3}b^{2}}{2}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{10h^8g^3}{25h^4g^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2h^{4}}{5}$",
          "worked": "$$\\begin{align*}\n\\frac{10h^8g^3}{25h^4g^3} &= \\frac{10\\,h^{8 - 4}\\,g^{3 - 3}}{25} \\\\\n&= \\frac{2h^{4}}{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$20x^2y^3\\div(2xy^5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10x}{y^{2}}$",
          "worked": "$$\\begin{align*}\n20x^2y^3\\div(2xy^5) &= \\frac{20\\,x^{2 - 1}}{2\\,y^{- 3 + 5}} \\\\\n&= \\frac{10x}{y^{2}}\n\\end{align*}$$",
