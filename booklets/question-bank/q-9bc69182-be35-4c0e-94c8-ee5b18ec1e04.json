        "children": [],
        "answer": {
          "short": "$28$",
          "worked": "$$\\begin{align*}10\\%&=96\\div12\\\\10\\%&=8\\\\35\\%&=8\\times3.5\\\\35\\%&=28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q8-d",
