  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "$120\\%$ of a number is $96$. Work out:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$10\\%$ of the number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}10\\%&=\\frac{96}{12}\\\\10\\%&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$20\\%$ of the number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$\\begin{align*}10\\%&=96\\div12\\\\10\\%&=8\\\\20\\%&=8\\times2\\\\20\\%&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$35\\%$ of the number",
