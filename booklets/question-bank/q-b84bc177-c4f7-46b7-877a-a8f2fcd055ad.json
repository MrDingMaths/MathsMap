  "content": {
    "id": "p18-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Each interior angle of a polygon measures $144^{\\circ}$. How many sides does it have?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "10 sides",
      "worked": "Each exterior angle is supplementary to its interior angle, and the exterior angles sum to $360^{\\circ}$.\n$$\\begin{align*}E&=180^{\\circ}-144^{\\circ}\\\\E&=36^{\\circ}\\\\n&=\\frac{360^{\\circ}}{36^{\\circ}}\\\\n&=10\\end{align*}$$\nThe polygon has 10 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
