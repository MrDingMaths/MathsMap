  "content": {
    "id": "p57-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A polynomial gives a remainder of 1 when divided by $(x+1)$, and a remainder of 5 when divided by $(x-3)$. What is the remainder when the same polynomial is divided by $(x+1)(x-3)$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x+2$; the linear remainder satisfies $R(-1)=1$ and $R(3)=5$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p57-q17-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The remainder has degree less than 2.",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}P(x)&=(x+1)(x-3)Q(x)+ax+b\\\\P(-1)&=-a+b=1\\\\P(3)&=3a+b=5\\\\4a&=4\\\\a&=1\\\\b&=2\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Therefore the remainder is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "x+2",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
    "answerSpaceMm": 49
  },
