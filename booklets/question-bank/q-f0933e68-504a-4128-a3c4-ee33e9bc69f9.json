      {
        "id": "p32-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt{6}+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{6}-1}{5}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{6}+1}&=\\frac{1}{\\sqrt{6}+1}\\times\\frac{\\sqrt{6}-1}{\\sqrt{6}-1}\\\\\\frac{1}{\\sqrt{6}+1}&=\\frac{\\sqrt{6}-1}{6-1}\\\\\\frac{1}{\\sqrt{6}+1}&=\\frac{\\sqrt{6}-1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3}{\\sqrt{2}-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{2}+3$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{2}-1}&=\\frac{3}{\\sqrt{2}-1}\\times\\frac{\\sqrt{2}+1}{\\sqrt{2}+1}\\\\\\frac{3}{\\sqrt{2}-1}&=\\frac{3\\sqrt{2}+3}{2-1}\\\\\\frac{3}{\\sqrt{2}-1}&=3\\sqrt{2}+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2}{3+\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3-\\sqrt{5}}{2}$",
          "worked": "$$\\begin{align*}\\frac{2}{3+\\sqrt{5}}&=\\frac{2}{3+\\sqrt{5}}\\times\\frac{3-\\sqrt{5}}{3-\\sqrt{5}}\\\\\\frac{2}{3+\\sqrt{5}}&=\\frac{6-2\\sqrt{5}}{9-5}\\\\\\frac{2}{3+\\sqrt{5}}&=\\frac{3-\\sqrt{5}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{3-\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3+\\sqrt{5}}{2}$",
          "worked": "$$\\begin{align*}\\frac{2}{3-\\sqrt{5}}&=\\frac{2}{3-\\sqrt{5}}\\times\\frac{3+\\sqrt{5}}{3+\\sqrt{5}}\\\\\\frac{2}{3-\\sqrt{5}}&=\\frac{6+2\\sqrt{5}}{9-5}\\\\\\frac{2}{3-\\sqrt{5}}&=\\frac{3+\\sqrt{5}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q2-e",
