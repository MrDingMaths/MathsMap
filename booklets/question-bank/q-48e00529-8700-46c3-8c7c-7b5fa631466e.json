  "content": {
    "id": "p17-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the greatest common divisor and least common multiple of each of the following groups of numbers:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$6,14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=2,\\quad\\mathrm{LCM}=42$",
          "worked": "$6=2\\times3$ and $14=2\\times7$. Take the least common prime powers for the GCD and the greatest prime powers for the LCM.\n$$\\begin{align*}\\mathrm{GCD}(6,14)&=2\\\\\\mathrm{LCM}(6,14)&=2\\times3\\times7\\\\\\mathrm{LCM}(6,14)&=42\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p17-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$12,15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=3,\\quad\\mathrm{LCM}=60$",
          "worked": "$12=2^2\\times3$ and $15=3\\times5$.\n$$\\begin{align*}\\mathrm{GCD}(12,15)&=3\\\\\\mathrm{LCM}(12,15)&=2^2\\times3\\times5\\\\\\mathrm{LCM}(12,15)&=60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$6,12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=6,\\quad\\mathrm{LCM}=12$",
          "worked": "$6=2\\times3$ and $12=2^2\\times3$.\n$$\\begin{align*}\\mathrm{GCD}(6,12)&=2\\times3\\\\\\mathrm{GCD}(6,12)&=6\\\\\\mathrm{LCM}(6,12)&=2^2\\times3\\\\\\mathrm{LCM}(6,12)&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p17-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$1,5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=1,\\quad\\mathrm{LCM}=5$",
          "worked": "The only positive factor of $1$ is $1$, and every positive integer is a multiple of $1$.\n$$\\begin{align*}\\mathrm{GCD}(1,5)&=1\\\\\\mathrm{LCM}(1,5)&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p17-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$3,9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=3,\\quad\\mathrm{LCM}=9$",
          "worked": "$3=3^1$ and $9=3^2$.\n$$\\begin{align*}\\mathrm{GCD}(3,9)&=3\\\\\\mathrm{LCM}(3,9)&=3^2\\\\\\mathrm{LCM}(3,9)&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$3,7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=1,\\quad\\mathrm{LCM}=21$",
          "worked": "$3$ and $7$ are distinct primes, so they have no common prime factor.\n$$\\begin{align*}\\mathrm{GCD}(3,7)&=1\\\\\\mathrm{LCM}(3,7)&=3\\times7\\\\\\mathrm{LCM}(3,7)&=21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p17-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$16,25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=1,\\quad\\mathrm{LCM}=400$",
          "worked": "$16=2^4$ and $25=5^2$ have no common prime factor.\n$$\\begin{align*}\\mathrm{GCD}(16,25)&=1\\\\\\mathrm{LCM}(16,25)&=2^4\\times5^2\\\\\\mathrm{LCM}(16,25)&=400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p17-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$20,25,30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=5,\\quad\\mathrm{LCM}=300$",
          "worked": "$20=2^2\\times5$, $25=5^2$ and $30=2\\times3\\times5$.\n$$\\begin{align*}\\mathrm{GCD}(20,25,30)&=5\\\\\\mathrm{LCM}(20,25,30)&=2^2\\times3\\times5^2\\\\\\mathrm{LCM}(20,25,30)&=300\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p17-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$12,15,24$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{GCD}=3,\\quad\\mathrm{LCM}=120$",
          "worked": "$12=2^2\\times3$, $15=3\\times5$ and $24=2^3\\times3$.\n$$\\begin{align*}\\mathrm{GCD}(12,15,24)&=3\\\\\\mathrm{LCM}(12,15,24)&=2^3\\times3\\times5\\\\\\mathrm{LCM}(12,15,24)&=120\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
