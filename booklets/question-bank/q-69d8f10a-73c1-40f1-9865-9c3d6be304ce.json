  "content": {
    "id": "p28-q4-response",
    "type": "question",
    "label": "4",
    "prompt": "Calculate the size of the smallest angle of the triangle whose side lengths are 30 mm, 70 mm and 85 mm. Give your answer correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$19.4^\\circ$",
      "worked": "The smallest angle, $\\theta$, is opposite the shortest side, 30 mm.\n\n$$\\begin{align*}30^2&=70^2+85^2-2\\times70\\times85\\cos\\theta\\\\\\cos\\theta&=\\frac{70^2+85^2-30^2}{2\\times70\\times85}\\\\\\cos\\theta&=\\frac{449}{476}\\\\\\theta&\\approx19.4^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
