  "content": {
    "id": "v2-09d4b-p24-practice-slot-18-root",
    "type": "question",
    "label": null,
    "prompt": "A tractor was purchased for \\$85 000 five years ago.\nBy using declining-balance depreciation, the current value of the tractor is \\$48 200.\nWhat is the annual percentage rate of depreciation, correct to one decimal place?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10.7\\%$ p.a.",
      "worked": "$$\\begin{align*}S&=V_0(1-r)^n\\\\48200&=85000(1-r)^5\\\\(1-r)^5&=\\frac{48200}{85000}\\\\r&=1-\\sqrt[5]{\\frac{48200}{85000}}\\end{align*}$$\nThe annual depreciation rate is $100\\left(1-\\sqrt[5]{\\frac{48200}{85000}}\\right)\\%=10.7\\%$ p.a., correct to one decimal place.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
