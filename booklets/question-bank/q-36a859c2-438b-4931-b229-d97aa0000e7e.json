        "label": "b",
        "prompt": "What does this say about $\\angle B$ and $\\angle D$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle B=\\angle D$.",
          "worked": "$\\angle B=\\angle D$ because corresponding angles in congruent triangles are equal. These are also opposite angles of the parallelogram.",
