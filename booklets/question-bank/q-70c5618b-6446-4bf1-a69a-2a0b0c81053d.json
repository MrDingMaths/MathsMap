  "content": {
    "id": "p107-q34-root",
    "type": "question",
    "label": "34",
    "prompt": "What is the value of $\\dfrac{\\frac{1}{2}-\\frac{1}{5}}{\\frac{1}{2}+\\frac{1}{5}}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{7}$",
      "worked": "Multiply the numerator and denominator of the complex fraction by $10$, the lowest common multiple of $2$ and $5$.\n\n$$\\begin{align*}\\frac{\\frac{1}{2}-\\frac{1}{5}}{\\frac{1}{2}+\\frac{1}{5}}&=\\frac{10\\left(\\frac{1}{2}-\\frac{1}{5}\\right)}{10\\left(\\frac{1}{2}+\\frac{1}{5}\\right)}\\\\&=\\frac{5-2}{5+2}\\\\&=\\frac{3}{7}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
