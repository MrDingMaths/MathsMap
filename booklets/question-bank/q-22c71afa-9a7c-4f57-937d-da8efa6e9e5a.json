  "content": {
    "id": "p14-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Suppose that $f(x)=x^2$ and $g(x)=2x-3$. Calculate:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(g(1))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}g(1)&=2(1)-3\\\\g(1)&=-1\\\\f(g(1))&=f(-1)\\\\f(g(1))&=(-1)^2\\\\f(g(1))&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(f(1))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}f(1)&=1^2\\\\f(1)&=1\\\\g(f(1))&=g(1)\\\\g(f(1))&=2(1)-3\\\\g(f(1))&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(f(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(f(x))=2x^2-3$",
          "worked": "$$\\begin{align*}g(f(x))&=g(x^2)\\\\g(f(x))&=2x^2-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(g(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=(2x-3)^2$",
          "worked": "$$\\begin{align*}f(g(x))&=f(2x-3)\\\\f(g(x))&=(2x-3)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
