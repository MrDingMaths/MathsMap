  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Initially there are 100 acres of pine in a managed forest. Each year the number of acres of pine decreases by 10%.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of pine after 1 year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90$ acres",
          "worked": "The annual multiplier is $1-0.10=0.9$.\n$$\\begin{align*}A_1&=100(0.9)\\\\A_1&=90\\text{ acres}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of pine after 4 years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$65.61$ acres",
          "worked": "$$\\begin{align*}A_4&=100(0.9)^4\\\\A_4&=65.61\\text{ acres}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the area of pine after $n$ years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A_n=100(0.9)^n$ acres",
          "worked": "The initial area is $100$ acres, and each year multiplies the area by $0.9$. After $n$ yearly reductions,\n$$A_n=100(0.9)^n\\text{ acres}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "How many years are needed for the pine area to be reduced to half its initial value? Round to the nearest year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$ years",
          "worked": "Half the initial area is $50$ acres.\n$$\\begin{align*}100(0.9)^n&=50\\\\(0.9)^n&=0.5\\\\n\\log(0.9)&=\\log(0.5)\\\\n&=\\frac{\\log(0.5)}{\\log(0.9)}\\\\n&\\approx6.58\\end{align*}$$\nTo the nearest year, $7$ years are needed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
