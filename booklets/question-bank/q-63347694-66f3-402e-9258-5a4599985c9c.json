  "content": {
    "id": "p39-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1+\\frac{1}{x}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{2x}$",
          "worked": "$$\\begin{align*}\\frac{1+\\frac{1}{x}}{2}&=\\frac{x\\left(1+\\frac{1}{x}\\right)}{2x}\\\\&=\\frac{x+1}{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p39-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1+\\frac{2}{x}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{2x}$",
          "worked": "$$\\begin{align*}\\frac{1+\\frac{2}{x}}{2}&=\\frac{x\\left(1+\\frac{2}{x}\\right)}{2x}\\\\&=\\frac{x+2}{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p39-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1+\\frac{1}{x}}{1+\\frac{2}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{1+\\frac{1}{x}}{1+\\frac{2}{x}}&=\\frac{x\\left(1+\\frac{1}{x}\\right)}{x\\left(1+\\frac{2}{x}\\right)}\\\\&=\\frac{x+1}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1-\\frac{1}{x}}{1+\\frac{1}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-1}{x+1}$",
          "worked": "$$\\begin{align*}\\frac{1-\\frac{1}{x}}{1+\\frac{1}{x}}&=\\frac{x\\left(1-\\frac{1}{x}\\right)}{x\\left(1+\\frac{1}{x}\\right)}\\\\&=\\frac{x-1}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1-\\frac{1}{x}}{1-\\frac{2}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-1}{x-2}$",
          "worked": "$$\\begin{align*}\\frac{1-\\frac{1}{x}}{1-\\frac{2}{x}}&=\\frac{x\\left(1-\\frac{1}{x}\\right)}{x\\left(1-\\frac{2}{x}\\right)}\\\\&=\\frac{x-1}{x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1+\\frac{1}{x}}{1-\\frac{1}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x-1}$",
          "worked": "$$\\begin{align*}\\frac{1+\\frac{1}{x}}{1-\\frac{1}{x}}&=\\frac{x\\left(1+\\frac{1}{x}\\right)}{x\\left(1-\\frac{1}{x}\\right)}\\\\&=\\frac{x+1}{x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{2-\\frac{1}{x}}{3+\\frac{1}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x-1}{3x+1}$",
          "worked": "$$\\begin{align*}\\frac{2-\\frac{1}{x}}{3+\\frac{1}{x}}&=\\frac{x\\left(2-\\frac{1}{x}\\right)}{x\\left(3+\\frac{1}{x}\\right)}\\\\&=\\frac{2x-1}{3x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{1-\\frac{a}{x}}{1+\\frac{a}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-a}{x+a}$",
          "worked": "$$\\begin{align*}\\frac{1-\\frac{a}{x}}{1+\\frac{a}{x}}&=\\frac{x\\left(1-\\frac{a}{x}\\right)}{x\\left(1+\\frac{a}{x}\\right)}\\\\&=\\frac{x-a}{x+a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
