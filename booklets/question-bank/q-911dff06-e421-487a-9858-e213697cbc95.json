  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Prove that the three angles of a triangle cannot all exceed $60^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "If all three angles exceeded $60^\\circ$, their sum would exceed $180^\\circ$, contradicting the triangle angle sum.",
      "worked": "Suppose all three angles exceed $60^\\circ$. Their sum then exceeds $3\\times60^\\circ=180^\\circ$. This contradicts the fact that the angles of a triangle sum to $180^\\circ$. Therefore, the three angles cannot all exceed $60^\\circ$.",
      "solutionDiagrams": []
    },
