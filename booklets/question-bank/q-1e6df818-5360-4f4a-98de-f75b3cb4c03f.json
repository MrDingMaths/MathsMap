    "children": [
      {
        "id": "p21-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "A square is inscribed in a circle. Find the square’s area as a fraction of the circle’s area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{\\pi}$.",
          "worked": "Let the circle have radius $r$ and the square have side length $s$. The square’s diagonal is $2r$.\n\n$$\\begin{align*}2s^2&=(2r)^2\\\\s^2&=2r^2\\\\\\frac{A_{\\text{square}}}{A_{\\text{circle}}}&=\\frac{2r^2}{\\pi r^2}\\\\\\frac{A_{\\text{square}}}{A_{\\text{circle}}}&=\\frac{2}{\\pi}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p21-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "A circle is inscribed in a square. Find the circle’s area as a fraction of the square’s area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\pi}{4}$.",
          "worked": "Let the circle have radius $r$. The square’s side length is $2r$.\n\n$$\\begin{align*}A_{\\text{square}}&=(2r)^2\\\\A_{\\text{square}}&=4r^2\\\\\\frac{A_{\\text{circle}}}{A_{\\text{square}}}&=\\frac{\\pi r^2}{4r^2}\\\\\\frac{A_{\\text{circle}}}{A_{\\text{square}}}&=\\frac{\\pi}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
