            "prompt": "exactly one Heart",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac38$",
              "worked": "Exclude $(H,H)$ from the 7 outcomes in part c, leaving 6.\n\n$P(\\text{exactly one Heart})=\\dfrac6{16}=\\dfrac38$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
