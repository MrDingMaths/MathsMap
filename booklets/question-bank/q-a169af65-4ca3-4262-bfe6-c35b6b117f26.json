            "answer": {
              "short": "$\\frac7{16}$",
              "worked": "There are 7 favourable cells among the 16 equally likely cells in the array.\n\n$P(\\text{at least one Heart})=\\dfrac7{16}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p17-q7-d-ii",
