      },
      {
        "id": "p17-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "List the set of outcomes in which at least one Heart is obtained.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left\\{\\begin{array}{llll}(H,D),&(D,H),&(H,H),&(S,H),\\\\(C,H),&(H,S),&(H,C)\\end{array}\\right\\}$",
          "worked": "Select the Heart row and Heart column of the array, counting $(H,H)$ once:\n\n$\\left\\{\\begin{array}{llll}(H,D),&(D,H),&(H,H),&(S,H),\\\\(C,H),&(H,S),&(H,C)\\end{array}\\right\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
