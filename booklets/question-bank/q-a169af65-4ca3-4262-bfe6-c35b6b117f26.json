      {
        "id": "p16-q7-a",
        "type": "group",
        "label": "a",
        "prompt": "A card is drawn at random from a pack of 52 playing cards. Find the probability that the card will be:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q7-ai",
            "type": "part",
            "label": "i",
            "prompt": "a Heart",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac14$",
              "worked": "$P(\\text{Heart})=\\dfrac{13}{52}=\\dfrac14$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p16-q7-aii",
            "type": "part",
            "label": "ii",
            "prompt": "a Queen",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac1{13}$",
              "worked": "$P(\\text{Queen})=\\dfrac4{52}=\\dfrac1{13}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p16-q7-aiii",
            "type": "part",
            "label": "iii",
            "prompt": "not a Queen",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{12}{13}$",
              "worked": "$P(\\text{not a Queen})=\\dfrac{52-4}{52}=\\dfrac{12}{13}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p16-q7-aiv",
            "type": "part",
            "label": "iv",
            "prompt": "a Queen of Hearts",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac1{52}$",
              "worked": "There is one Queen of Hearts, so $P(\\text{Queen of Hearts})=\\dfrac1{52}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p16-q7-av",
            "type": "part",
            "label": "v",
            "prompt": "a Queen or a Heart",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac4{13}$",
              "worked": "Count the 13 Hearts and the 3 Queens that are not Hearts.\n\n$P(\\text{Queen or Heart})=\\dfrac{13+3}{52}=\\dfrac4{13}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
