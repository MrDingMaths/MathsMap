  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{8m^3}{6m^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4m}{3}$",
          "worked": "$$\\begin{align*}\\frac{8m^3}{6m^2}&=\\frac43m^{3-2}\\\\\\frac{8m^3}{6m^2}&=\\frac{4m}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{12a^8}{18a^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2a^5}{3}$",
          "worked": "$$\\begin{align*}\\frac{12a^8}{18a^3}&=\\frac23a^{8-3}\\\\\\frac{12a^8}{18a^3}&=\\frac{2a^5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{(a^2)^3}{a^2\\times b^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^4}{b^3}$",
          "worked": "$$\\begin{align*}\\frac{(a^2)^3}{a^2\\times b^3}&=\\frac{a^6}{a^2b^3}\\\\\\frac{(a^2)^3}{a^2\\times b^3}&=\\frac{a^4}{b^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{(-4m)^3}{(6m)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{16m}{9}$",
          "worked": "$$\\begin{align*}\\frac{(-4m)^3}{(6m)^2}&=\\frac{-64m^3}{36m^2}\\\\\\frac{(-4m)^3}{(6m)^2}&=-\\frac{16m}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{b^3\\times b^4\\times b^5}{b^2\\times b^3\\times b^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^3$",
          "worked": "$$\\begin{align*}\\frac{b^3b^4b^5}{b^2b^3b^4}&=\\frac{b^{12}}{b^9}\\\\\\frac{b^3b^4b^5}{b^2b^3b^4}&=b^{12-9}\\\\\\frac{b^3b^4b^5}{b^2b^3b^4}&=b^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(3m^3)^3}{3(m^2)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9m^3$",
          "worked": "$$\\begin{align*}\\frac{(3m^3)^3}{3(m^2)^3}&=\\frac{27m^9}{3m^6}\\\\\\frac{(3m^3)^3}{3(m^2)^3}&=9m^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{(2a)^3\\times(-5a^2)^3}{(4a)^2\\times(5a)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{5a^5}{2}$",
          "worked": "$$\\begin{align*}\\frac{(2a)^3(-5a^2)^3}{(4a)^2(5a)^2}&=\\frac{8a^3(-125a^6)}{16a^2(25a^2)}\\\\\\frac{(2a)^3(-5a^2)^3}{(4a)^2(5a)^2}&=\\frac{-1000a^9}{400a^4}\\\\\\frac{(2a)^3(-5a^2)^3}{(4a)^2(5a)^2}&=-\\frac{5a^5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p3-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\dfrac{2a}{3}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8a^3}{27}$",
          "worked": "$$\\begin{align*}\\left(\\frac{2a}{3}\\right)^3&=\\frac{2^3a^3}{3^3}\\\\\\left(\\frac{2a}{3}\\right)^3&=\\frac{8a^3}{27}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
