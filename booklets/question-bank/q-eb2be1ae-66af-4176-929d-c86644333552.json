  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Show that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$18\\equiv8\\pmod{5}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18-8=10=2\\times5$.",
          "worked": "$$\\begin{align*}18-8&=10\\\\18-8&=2\\times5\\end{align*}$$\nThe difference is a multiple of 5, so $18\\equiv8\\pmod{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$18\\equiv6\\pmod{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18-6=12=3\\times4$.",
          "worked": "$$\\begin{align*}18-6&=12\\\\18-6&=3\\times4\\end{align*}$$\nThe difference is a multiple of 4, so $18\\equiv6\\pmod{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$25\\equiv13\\pmod{6}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25-13=12=2\\times6$.",
          "worked": "$$\\begin{align*}25-13&=12\\\\25-13&=2\\times6\\end{align*}$$\nThe difference is a multiple of 6, so $25\\equiv13\\pmod{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$8\\equiv-7\\pmod{5}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8-(-7)=15=3\\times5$.",
          "worked": "$$\\begin{align*}8-(-7)&=15\\\\8-(-7)&=3\\times5\\end{align*}$$\nThe difference is a multiple of 5, so $8\\equiv-7\\pmod{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$-6\\equiv2\\pmod{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6-2=-8=(-2)\\times4$.",
          "worked": "$$\\begin{align*}-6-2&=-8\\\\-6-2&=(-2)\\times4\\end{align*}$$\nThe difference is a multiple of 4, so $-6\\equiv2\\pmod{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$-2\\equiv-20\\pmod{6}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2-(-20)=18=3\\times6$.",
          "worked": "$$\\begin{align*}-2-(-20)&=18\\\\-2-(-20)&=3\\times6\\end{align*}$$\nThe difference is a multiple of 6, so $-2\\equiv-20\\pmod{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
