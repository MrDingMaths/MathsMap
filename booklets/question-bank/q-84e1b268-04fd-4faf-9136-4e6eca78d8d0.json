  "content": {
    "id": "p38-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q5a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of the sector whose sector angle is $45^\\circ$ and whose radius is $8\\text{ m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\pi\\text{ m}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{45}{360}\\times\\pi\\times8^2\\\\A&=8\\pi\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p38-q5b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of the sector whose sector angle is $\\frac{\\pi}{6}$ and whose radius is $12\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\pi\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac12r^2\\theta\\\\A&=\\frac12\\times12^2\\times\\frac{\\pi}{6}\\\\A&=12\\pi\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p38-q5c",
        "type": "part",
        "label": "c",
        "prompt": "Find the sector angle if the area of the sector is $4\\pi\\text{ cm}^2$ and its radius is $8\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{8}$ radians",
          "worked": "$$\\begin{align*}A&=\\frac12r^2\\theta\\\\4\\pi&=\\frac12\\times8^2\\times\\theta\\\\\\theta&=\\frac{4\\pi}{32}\\\\\\theta&=\\frac{\\pi}{8}\\text{ radians}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p38-q5d",
        "type": "part",
        "label": "d",
        "prompt": "Find the sector radius if the sector angle is $\\frac{\\pi}{6}$ and the area of the sector is $3\\pi\\text{ cm}^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ cm}$",
          "worked": "$$\\begin{align*}A&=\\frac12r^2\\theta\\\\3\\pi&=\\frac12\\times r^2\\times\\frac{\\pi}{6}\\\\r^2&=36\\\\r&=6\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p38-q5e",
        "type": "part",
        "label": "e",
        "prompt": "Find the area of the sector whose radius is $2\\text{ m}$ and whose arc length is $3\\text{ m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\text{ m}^2$",
          "worked": "$$\\begin{align*}\\theta&=\\frac{L}{r}\\\\\\theta&=\\frac32\\\\A&=\\frac12r^2\\theta\\\\A&=\\frac12\\times2^2\\times\\frac32\\\\A&=3\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p38-q5f",
        "type": "part",
        "label": "f",
        "prompt": "Find the area of the sector whose radius is $2\\text{ m}$ and whose arc length is $4\\pi\\text{ m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\pi\\text{ m}^2$",
          "worked": "$$\\begin{align*}\\theta&=\\frac{L}{r}\\\\\\theta&=\\frac{4\\pi}{2}\\\\\\theta&=2\\pi\\\\A&=\\frac12\\times2^2\\times2\\pi\\\\A&=4\\pi\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p38-q5g",
        "type": "part",
        "label": "g",
        "prompt": "Find the perimeter of the sector whose area is $3\\text{ cm}^2$ and whose arc length is $5\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{37}{5}\\text{ cm}$\n\nUse $A=\\frac12rL$ to find the radius, then add the arc length and two radii.",
          "worked": "Using $L=r\\theta$ in the sector-area formula:\n$$\\begin{align*}A&=\\frac12r^2\\theta\\\\A&=\\frac12rL\\\\3&=\\frac12\\times r\\times5\\\\r&=\\frac65\\text{ cm}\\\\P&=L+2r\\\\P&=5+2\\times\\frac65\\\\P&=\\frac{37}{5}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
