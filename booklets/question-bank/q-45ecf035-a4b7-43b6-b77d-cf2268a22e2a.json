      {
        "id": "v2-a6eb5da01-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The concentration of a medicine in the bloodstream is given by $C=45e^{-0.3t}$ mg/L, where $t$ is in hours. Find the concentration after 4 hours. Then state what the concentration becomes as $t\\to\\infty$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13.55\\text{ mg/L}$; the concentration approaches $0\\text{ mg/L}$.",
          "worked": "$$\\begin{align*}C(4)&=45e^{-0.3(4)}\\\\C(4)&=45e^{-1.2}\\\\C(4)&\\approx13.55\\text{ mg/L}\\end{align*}$$\nAs $t\\to\\infty$, $e^{-0.3t}\\to0$, so $C\\to0\\text{ mg/L}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-a6eb5da01-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The value of an investment is given by $V=5000e^{0.04t}$ dollars, where $t$ is in years. Find the value after 10 years. Then state what the value becomes as $t\\to\\infty$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$7459.12$; the value increases without bound, $V\\to\\infty$.",
          "worked": "$$\\begin{align*}V(10)&=5000e^{0.04(10)}\\\\V(10)&=5000e^{0.4}\\\\V(10)&\\approx\\$7459.12\\end{align*}$$\nAs $t\\to\\infty$, $e^{0.04t}\\to\\infty$, so $V\\to\\infty$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
