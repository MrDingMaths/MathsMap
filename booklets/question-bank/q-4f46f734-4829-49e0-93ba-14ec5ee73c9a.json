  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A rectangle has area 10. The length of the rectangle is $\\sqrt{2}-1$. Find the width of the rectangle in simplest form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10(\\sqrt{2}+1)$",
      "worked": "Using $A=lw$, the width is $w=\\frac{A}{l}$.\n$$\\begin{align*}w&=\\frac{10}{\\sqrt{2}-1}\\\\w&=\\frac{10}{\\sqrt{2}-1}\\times\\frac{\\sqrt{2}+1}{\\sqrt{2}+1}\\\\w&=\\frac{10(\\sqrt{2}+1)}{(\\sqrt{2})^2-1^2}\\\\w&=\\frac{10(\\sqrt{2}+1)}{2-1}\\\\w&=10(\\sqrt{2}+1)\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
