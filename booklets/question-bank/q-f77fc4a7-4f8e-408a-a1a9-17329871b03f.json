  "content": {
    "id": "p32-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Solve the quadratic inequalities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q4a",
        "type": "part",
        "label": "a",
        "prompt": "$-x^2-3x+40>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8<x<5$.",
          "worked": "$$\\begin{align*}y&=-x^2-3x+40\\\\y&=-(x+8)(x-5)\\end{align*}$$\nThe downward-opening parabola crosses the $x$-axis at $-8$ and $5$. It is above the axis between these intercepts.\nThus $-8<x<5$. The intercepts are excluded because the inequality is strict.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-q4b",
        "type": "part",
        "label": "b",
        "prompt": "$-x^2+5x+24\\geq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\leq x\\leq8$.",
          "worked": "$$\\begin{align*}y&=-x^2+5x+24\\\\y&=-(x+3)(x-8)\\end{align*}$$\nThe downward-opening parabola crosses the $x$-axis at $-3$ and $8$. It is on or above the axis between these intercepts, including the intercepts.\nThus $-3\\leq x\\leq8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-q4c",
        "type": "part",
        "label": "c",
        "prompt": "$-x^2+12x-35\\leq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq5$ or $x\\geq7$.",
          "worked": "$$\\begin{align*}y&=-x^2+12x-35\\\\y&=-(x-5)(x-7)\\end{align*}$$\nThe downward-opening parabola crosses the $x$-axis at $5$ and $7$. It is on or below the axis outside these intercepts, including the intercepts.\nThus $x\\leq5$ or $x\\geq7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-q4d",
        "type": "part",
        "label": "d",
        "prompt": "$-x^2+11x<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<0$ or $x>11$.",
          "worked": "$$\\begin{align*}y&=-x^2+11x\\\\y&=-x(x-11)\\end{align*}$$\nThe downward-opening parabola crosses the $x$-axis at $0$ and $11$. It is below the axis outside these intercepts.\nThus $x<0$ or $x>11$. The intercepts are excluded because the inequality is strict.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
