    "children": [
      {
        "id": "p23-q13-part-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the diameter of the cylinder to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.79\\text{ cm}$",
          "worked": "$$\\begin{align*}\\pi r^2 &= 18\\\\r &= \\sqrt{\\frac{18}{\\pi}}\\\\d &= 2\\sqrt{\\frac{18}{\\pi}}\\\\d &\\approx 4.79\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q13-part-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the volume of the cylinder.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$162\\text{ cm}^3$",
          "worked": "$$\\begin{align*}V &= \\pi r^2h\\\\V &= 18\\times9\\\\V &= 162\\text{ cm}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q13-part-c",
        "type": "part",
        "label": "c",
        "prompt": "The top surface of a cylinder with the same volume has area of $50\\text{ cm}^2$. What is the height of the cylinder?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.24\\text{ cm}$",
          "worked": "$$\\begin{align*}V &= \\pi r^2h\\\\162 &= 50h\\\\h &= 3.24\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q13-part-d",
        "type": "part",
        "label": "d",
        "prompt": "Calculate the surface area of the original cylinder shown in the diagram. Round your answer to the nearest square centimetre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$171\\text{ cm}^2$",
          "worked": "$$\\begin{align*}r &= \\sqrt{\\frac{18}{\\pi}}\\\\A &= 2\\pi r^2+2\\pi rh\\\\A &= 2(18)+2\\pi\\sqrt{\\frac{18}{\\pi}}(9)\\\\A &= 36+18\\sqrt{18\\pi}\\\\A &\\approx 171\\text{ cm}^2\\end{align*}$$\nRounded to the nearest square centimetre.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
