  "content": {
    "id": "v2-f5ecbc-p5-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "A student thinks that the common denominator to use when simplifying $\\dfrac{x+2}{6}+\\dfrac{3x-1}{8}$ is 48.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-f5ecbc-p5-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Complete the addition by making both denominators 48.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13x+5}{24}$",
          "worked": "$$\\begin{align*}\\frac{x+2}{6}+\\frac{3x-1}{8}&=\\frac{8(x+2)}{48}+\\frac{6(3x-1)}{48}\\\\&=\\frac{8x+16+18x-6}{48}\\\\&=\\frac{26x+10}{48}\\\\&=\\frac{13x+5}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "v2-f5ecbc-p5-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Complete the simplification using the actual LCD of 24.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13x+5}{24}$",
          "worked": "$$\\begin{align*}\\frac{x+2}{6}+\\frac{3x-1}{8}&=\\frac{4(x+2)}{24}+\\frac{3(3x-1)}{24}\\\\&=\\frac{4x+8+9x-3}{24}\\\\&=\\frac{13x+5}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "v2-f5ecbc-p5-practice-slot-1-slot-1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "You should have the same answer for both methods. Which do you prefer and why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, use 24: smaller numbers and less simplification.",
          "worked": "Both methods give $\\dfrac{13x+5}{24}$. Using the LCD of 24 keeps the numbers smaller and avoids reducing a fraction with denominator 48. Either preference is acceptable with a valid reason.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
