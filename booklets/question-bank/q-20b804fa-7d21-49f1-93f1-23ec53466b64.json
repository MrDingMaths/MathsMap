  "content": {
    "id": "p21-q9-node",
    "type": "question",
    "label": "9",
    "prompt": "Consider $f(x)=(x-5)^2$, show that $g(x)=(x+5)^2$ is a reflection across the $y$ axis using function notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(-x)=(-x-5)^2=(x+5)^2=g(x)$.",
      "worked": "$$\\begin{align*}f(-x)&=(-x-5)^2\\\\f(-x)&=\\bigl(-(x+5)\\bigr)^2\\\\f(-x)&=(x+5)^2\\\\f(-x)&=g(x)\\end{align*}$$\nSince $g(x)=f(-x)$, its graph is the reflection of $y=f(x)$ across the $y$-axis.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 23
  },
