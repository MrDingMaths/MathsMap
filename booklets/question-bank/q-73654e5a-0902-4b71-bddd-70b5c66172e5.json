    "children": [
      {
        "id": "p13-q8a",
        "type": "part",
        "label": "a",
        "prompt": "Determine $\\phi(7)$ and $\\phi(11)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\phi(7)=6$, $\\phi(11)=10$.",
          "worked": "Since 7 and 11 are prime, $\\phi(p)=p-1$ gives\n$$\\begin{align*}\\phi(7)&=7-1\\\\\\phi(7)&=6\\end{align*}$$\n$$\\begin{align*}\\phi(11)&=11-1\\\\\\phi(11)&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q8b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, determine $\\phi(77)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\phi(77)=60$.",
          "worked": "Since $77=7\\times11$ and 7 and 11 are coprime,\n$$\\begin{align*}\\phi(77)&=\\phi(7)\\phi(11)\\\\\\phi(77)&=6\\times10\\\\\\phi(77)&=60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
