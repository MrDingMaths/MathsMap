  "content": {
    "id": "p24-q12",
    "type": "question",
    "label": "12",
    "prompt": "The speed of light is $3\\times10^8\\text{ m/s}$. The distance to the sun is $1.5\\times10^{11}\\text{ m}$.\nCalculate the time, in minutes, it takes for light to travel from the sun to Earth. Give your answer to 3 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8.333\\text{ min}$. Divide distance by speed, then divide the time in seconds by $60$.",
      "worked": "$$\\begin{align*}\\text{Time in seconds}&=\\frac{\\text{distance}}{\\text{speed}}\\\\&=\\frac{1.5\\times10^{11}}{3\\times10^8}\\\\&=0.5\\times10^{11-8}\\\\&=500\\text{ s}.\\end{align*}$$\n$$\\begin{align*}\\text{Time in minutes}&=\\frac{500}{60}\\\\&=\\frac{25}{3}\\text{ min}\\\\&\\approx8.333\\text{ min}\\quad\\text{(3 decimal places).}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
