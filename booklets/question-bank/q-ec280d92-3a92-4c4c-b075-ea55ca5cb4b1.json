  "content": {
    "id": "p30-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider $\\cos\\left(2\\sin^{-1}\\left(\\frac45\\right)\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Let $A=\\sin^{-1}\\left(\\frac45\\right)$. Show that the expression is equivalent to $1-2\\sin^2 A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\left(2\\sin^{-1}\\left(\\frac45\\right)\\right)=1-2\\sin^2 A$.",
          "worked": "$$\\begin{aligned}\\cos\\left(2\\sin^{-1}\\left(\\frac45\\right)\\right)&=\\cos(2A)\\\\&=1-2\\sin^2 A\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the value of $\\sin A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac45$",
          "worked": "$$\\sin A=\\sin\\left(\\sin^{-1}\\left(\\frac45\\right)\\right)=\\frac45$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p30-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the exact value of $\\cos\\left(2\\sin^{-1}\\left(\\frac45\\right)\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac7{25}$",
          "worked": "$$\\begin{aligned}\\cos\\left(2\\sin^{-1}\\left(\\frac45\\right)\\right)&=1-2\\sin^2 A\\\\&=1-2\\left(\\frac45\\right)^2\\\\&=-\\frac7{25}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
