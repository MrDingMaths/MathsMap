  "content": {
    "id": "p28-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A couple takes out a housing loan of $\\$380\\,000$ over a period of 25 years. They make no repayments during the 25-year period.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q3-a",
        "type": "group",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p28-q3-a-i",
            "type": "part",
            "label": "i",
            "prompt": "How much money would they owe if compound interest were payable at 6% p.a.? Give your answer to the nearest cent.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$1\\,630\\,910.87$",
              "worked": "$$\\begin{align*}A_n&=P(1+R)^n\\\\A_{25}&=380\\,000(1.06)^{25}\\\\A_{25}&\\approx\\$1\\,630\\,910.87\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p28-q3-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What would the percentage increase in the debt be, correct to the nearest 1%?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$329\\%$",
              "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\bigl((1.06)^{25}-1\\bigr)\\times100\\%\\\\\\text{Percentage increase}&\\approx329.187071974\\%\\\\\\text{Percentage increase}&\\approx329\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p28-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p28-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "How much money would they owe if compound interest were payable at 0.5% per month? Give your answer to the nearest cent.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$1\\,696\\,688.53$",
              "worked": "The monthly rate is $R=0.005$.\n\n$$\\begin{align*}n&=25\\times12\\\\n&=300\\\\A_n&=P(1+R)^n\\\\A_{300}&=380\\,000(1.005)^{300}\\\\A_{300}&\\approx\\$1\\,696\\,688.53\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p28-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What would the percentage increase in the debt be, correct to the nearest 1%?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$346\\%$",
              "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\bigl((1.005)^{300}-1\\bigr)\\times100\\%\\\\\\text{Percentage increase}&\\approx346.496981216\\%\\\\\\text{Percentage increase}&\\approx346\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
  },
