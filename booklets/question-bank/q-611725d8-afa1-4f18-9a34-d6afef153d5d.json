                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Which method (a, b, or c) do you prefer to use for this question?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Option 1 is the best buy. Preferred method: answers vary; a, b or c is acceptable.",
          "worked": "Option 1 is the best buy because its price per kilogram is lower: $\\$1.75<\\$12.50\\div7$. For example, method c is convenient because 14 kg is a whole number of bags for both options, and $\\$24.50<\\$25$. Any of methods a, b or c may be preferred.",
