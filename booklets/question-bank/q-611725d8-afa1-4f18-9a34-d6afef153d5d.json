  "content": {
    "id": "p19-q9",
    "type": "question",
    "label": "9",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p19-q9-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "In a shop, potatoes are sold in 2 kg bags for $3.50.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "In a wholesale market, potatoes are sold in 7 kg bags for $12.50.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "For each option calculate:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q9-a",
        "type": "group",
        "label": "a",
        "prompt": "The cost of 1 kg of potatoes. Give monetary rates to 2 decimal places.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q9-a-option1",
            "type": "part",
            "label": "",
            "prompt": "Option 1",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{\\$1.75}{\\text{kg}}$",
              "worked": "$$\\begin{align*}\\text{Cost per kilogram}&=\\frac{\\$3.50}{2\\text{ kg}}\\\\&=\\$1.75/\\text{kg}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p19-q9-a-option2",
            "type": "part",
            "label": "",
            "prompt": "Option 2",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{\\$1.79}{\\text{kg}}$",
              "worked": "$$\\begin{align*}\\text{Cost per kilogram}&=\\frac{\\$12.50}{7\\text{ kg}}\\\\&\\approx\\$1.79/\\text{kg}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p19-q9-b",
        "type": "group",
        "label": "b",
        "prompt": "The number of kilograms that can be bought for \\$1. Round to 2 decimal places.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q9-b-option1",
            "type": "part",
            "label": "",
            "prompt": "Option 1",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{0.57\\text{ kg}}{\\$1}$",
              "worked": "$$\\begin{align*}\\text{Kilograms per dollar}&=\\frac{2\\text{ kg}}{\\$3.50}\\\\&\\approx0.57\\text{ kg}/\\$1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p19-q9-b-option2",
            "type": "part",
            "label": "",
            "prompt": "Option 2",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{0.56\\text{ kg}}{\\$1}$",
              "worked": "$$\\begin{align*}\\text{Kilograms per dollar}&=\\frac{7\\text{ kg}}{\\$12.50}\\\\&=0.56\\text{ kg}/\\$1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p19-q9-c",
        "type": "group",
        "label": "c",
        "prompt": "The cost of 14 kg of potatoes.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q9-c-option1",
            "type": "part",
            "label": "",
            "prompt": "Option 1",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "\\$24.50 for 14 kg",
              "worked": "$$\\begin{align*}\\text{Number of bags}&=14\\div2=7\\\\\\text{Total cost}&=7\\times\\$3.50=\\$24.50\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p19-q9-c-option2",
            "type": "part",
            "label": "",
            "prompt": "Option 2",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "\\$25 for 14 kg",
              "worked": "$$\\begin{align*}\\text{Number of bags}&=14\\div7=2\\\\\\text{Total cost}&=2\\times\\$12.50=\\$25\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p19-q9-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
