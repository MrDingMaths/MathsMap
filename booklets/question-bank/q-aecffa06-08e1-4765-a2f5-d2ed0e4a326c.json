    "children": [
      {
        "id": "p39-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the mode of $f(x)=-\\frac{3}{22}(x^2-6x+5)$ defined on $[2,4]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mode $=3$.",
          "worked": "The graph is a concave down parabola, so its turning point is the maximum.\n$$\\begin{align*}f'(x)&=-\\frac{3}{22}(2x-6)\\\\0&=-\\frac{3}{22}(2x-6)\\\\x&=3\\end{align*}$$\nSince $3\\in[2,4]$, the mode is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p39-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the CDF.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$F(x)=\\begin{cases}0,&x<2,\\\\-\\dfrac{x^3-9x^2+15x-2}{22},&2\\le x\\le4,\\\\1,&x>4.\\end{cases}$$",
          "worked": "For $2\\le x\\le4$,\n$$\\begin{align*}F(x)&=\\int_2^x-\\frac{3}{22}(t^2-6t+5)\\,dt\\\\&=-\\frac{3}{22}\\left[\\frac{t^3}{3}-3t^2+5t\\right]_2^x\\\\&=-\\frac{3}{22}\\left(\\frac{x^3}{3}-3x^2+5x-\\frac23\\right)\\\\&=-\\frac{1}{22}(x^3-9x^2+15x-2).\\end{align*}$$\nThus\n$$F(x)=\\begin{cases}0,&x<2,\\\\-\\dfrac{x^3-9x^2+15x-2}{22},&2\\le x\\le4,\\\\1,&x>4.\\end{cases}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p39-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $P(X\\le a)$ where $a$ is the mode.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}P(X\\le3)&=F(3)\\\\&=-\\frac{1}{22}(27-81+45-2)\\\\&=-\\frac{1}{22}(-11)\\\\&=\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
