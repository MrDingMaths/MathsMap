  "content": {
    "id": "p7-q8-response",
    "type": "question",
    "label": "8",
    "prompt": "Find the total mass (in g) of five items of mass 250 mg, 1100 mg, 0.7 g, 5.95 g, and 15.4 g.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$23.4\\text{ g}$",
      "worked": "$$\\begin{align*}250\\text{ mg}&=250\\div1000\\text{ g}=0.25\\text{ g}\\\\1100\\text{ mg}&=1100\\div1000\\text{ g}=1.1\\text{ g}\\\\\\text{Total mass}&=(0.25+1.1+0.7+5.95+15.4)\\text{ g}\\\\\\text{Total mass}&=23.4\\text{ g}\\end{align*}$$",
      "solutionDiagrams": []
    },
