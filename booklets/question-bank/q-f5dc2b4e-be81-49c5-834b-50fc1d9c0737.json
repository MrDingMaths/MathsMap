      {
        "id": "p13-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(x+5x^{-1}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+10+\\frac{25}{x^2}$",
          "worked": "$$\\begin{align*}\\left(x+5x^{-1}\\right)^2&=x^2+2(x)(5x^{-1})+25x^{-2}\\\\\\left(x+5x^{-1}\\right)^2&=x^2+10+25x^{-2}\\\\\\left(x+5x^{-1}\\right)^2&=x^2+10+\\frac{25}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(x^2-7x^{-2}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-14+\\frac{49}{x^4}$",
          "worked": "$$\\begin{align*}\\left(x^2-7x^{-2}\\right)^2&=x^4-2(x^2)(7x^{-2})+49x^{-4}\\\\\\left(x^2-7x^{-2}\\right)^2&=x^4-14+49x^{-4}\\\\\\left(x^2-7x^{-2}\\right)^2&=x^4-14+\\frac{49}{x^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(3x^{1/2}-2x^{-1/2}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x-12+\\frac{4}{x}$",
          "worked": "$$\\begin{align*}\\left(3x^{1/2}-2x^{-1/2}\\right)^2&=9x-12x^{1/2-1/2}+4x^{-1}\\\\\\left(3x^{1/2}-2x^{-1/2}\\right)^2&=9x-12+4x^{-1}\\\\\\left(3x^{1/2}-2x^{-1/2}\\right)^2&=9x-12+\\frac{4}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
