      {
        "id": "p73-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac12(x-2)^2-3$.",
          "worked": "Using the vertex, write $y=a(x-2)^2-3$. The chord $AB$ is centred on $x=2$ and has length $8$, so its endpoints have $x$-coordinates $-2$ and $6$.\n\nUsing $(-2,5)$:\n$$\\begin{aligned}5&=a(-2-2)^2-3\\\\8&=16a\\\\a&=\\frac12\\end{aligned}$$\nHence $y=\\frac12(x-2)^2-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p73-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find its $y$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-1)$.",
          "worked": "At $x=0$:\n$$\\begin{aligned}y&=\\frac12(0-2)^2-3\\\\y&=-1\\end{aligned}$$\nThe $y$-intercept is $(0,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p73-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Find its $x$-intercepts exactly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2-\\sqrt6,0)$ and $(2+\\sqrt6,0)$.",
          "worked": "Set $y=0$:\n$$\\begin{aligned}\\frac12(x-2)^2-3&=0\\\\(x-2)^2&=6\\\\x-2&=\\pm\\sqrt6\\\\x&=2\\pm\\sqrt6\\end{aligned}$$\nThe $x$-intercepts are $(2-\\sqrt6,0)$ and $(2+\\sqrt6,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p73-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Sketch the graph, clearly identifying all features.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave up; vertex $(2,-3)$; axis $x=2$; $y$-intercept $(0,-1)$; $x$-intercepts $(2-\\sqrt6,0)$ and $(2+\\sqrt6,0)$.",
          "worked": "Since $a=\\frac12>0$, the parabola is concave up. Its vertex is $(2,-3)$ and its axis of symmetry is $x=2$. Mark the $y$-intercept $(0,-1)$ and the $x$-intercepts $(2-\\sqrt6,0)$ and $(2+\\sqrt6,0)$, then draw a smooth symmetric curve. The given horizontal chord joins $A=(-2,5)$ and $B=(6,5)$.",
          "solutionDiagrams": [
            {
              "id": "p73-q4-d-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 73, p73-q4-d-solution-graph\"}\n\\begin{tikzpicture}[x=0.85cm,y=0.65cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,line width=0.5pt] (-3.4,0)--(7.4,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-4.4)--(0,7.3) node[above] {$y$};\n\\draw[dashed,line width=0.4pt] (2,-4.1)--(2,6.9) node[above] {$x=2$};\n\\draw[<->,line width=0.8pt,samples=100,domain=-2.45:6.45] plot (\\x,{0.5*(\\x-2)^2-3});\n\\draw[line width=0.4pt] (-2,5)--(6,5);\n\\fill (-2,5) circle (1.5pt) node[below left,xshift=-2mm,yshift=-2mm] {$A(-2,5)$};\n\\fill (6,5) circle (1.5pt) node[below right,xshift=2mm,yshift=-2mm] {$B(6,5)$};\n\\path (2,5) node[above] {$AB=8$};\n\\fill (2,-3) circle (1.5pt) node[below right] {$(2,-3)$};\n\\fill (0,-1) circle (1.5pt);\n\\coordinate (mmPoint42) at (0,-1);\n\\node[name=mmLabel42,right,xshift=30mm,yshift=-37.5mm] at (0,-1) {$(0,-1)$};\n\\draw[housegrid,dashed,line width=0.25pt] (mmPoint42)--(mmPoint42 -| mmLabel42.west)--(mmLabel42.west);\n\\fill ({2-sqrt(6)},0) circle (1.5pt);\n\\coordinate (mmPoint43) at ({2-sqrt(6)},0);\n\\node[name=mmLabel43,below left,xshift=-6mm,yshift=-12mm] at ({2-sqrt(6)},0) {$(2-\\sqrt6,0)$};\n\\draw[housegrid,dashed,line width=0.25pt] (mmPoint43)--(mmPoint43 |- mmLabel43.north east)--(mmLabel43.north east);\n\\fill ({2+sqrt(6)},0) circle (1.5pt) node[below right] {$(2+\\sqrt6,0)$};\n\\end{tikzpicture}",
