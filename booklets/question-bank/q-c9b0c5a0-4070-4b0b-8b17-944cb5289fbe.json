                  },
                  {
                    "type": "math",
                    "latex": "-5",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", F: ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "-9,4",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p54-q10-supplied-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}-12x^{2}-5x+3&=-12x^{2}-9x+4x+3\\\\&=-3x(4x+3)+(4x+3)\\\\&=(4x+3)(1-3x)\\\\&=(1-3x)(4x+3)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p54-q10-hence",
        "type": "group",
        "label": "",
        "prompt": "Hence factorise these expressions.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q10-a",
            "type": "part",
            "label": "b",
            "prompt": "$-8x^{2}+2x+15$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(3-2x)(4x+5)$",
              "worked": "P: $-120$, S: $2$, F: $-10,12$.\n$$\\begin{align*}-8x^{2}+2x+15&=-8x^{2}-10x+12x+15\\\\&=-2x(4x+5)+3(4x+5)\\\\&=(3-2x)(4x+5)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p54-q10-b",
            "type": "part",
            "label": "c",
            "prompt": "$-6x^{2}+11x+10$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(5-2x)(3x+2)$",
              "worked": "P: $-60$, S: $11$, F: $-4,15$.\n$$\\begin{align*}-6x^{2}+11x+10&=-6x^{2}-4x+15x+10\\\\&=-2x(3x+2)+5(3x+2)\\\\&=(5-2x)(3x+2)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p54-q10-c",
            "type": "part",
            "label": "d",
            "prompt": "$-12x^{2}+13x+4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(4-3x)(4x+1)$",
              "worked": "P: $-48$, S: $13$, F: $-3,16$.\n$$\\begin{align*}-12x^{2}+13x+4&=-12x^{2}-3x+16x+4\\\\&=-3x(4x+1)+4(4x+1)\\\\&=(4-3x)(4x+1)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p54-q10-d",
            "type": "part",
            "label": "e",
            "prompt": "$-8x^{2}+18x-9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(3-4x)(2x-3)$",
              "worked": "P: $72$, S: $18$, F: $12,6$.\n$$\\begin{align*}-8x^{2}+18x-9&=-8x^{2}+12x+6x-9\\\\&=-4x(2x-3)+3(2x-3)\\\\&=(3-4x)(2x-3)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p54-q10-e",
            "type": "part",
            "label": "f",
            "prompt": "$-14x^{2}+39x-10$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(2-7x)(2x-5)$",
              "worked": "P: $140$, S: $39$, F: $35,4$.\n$$\\begin{align*}-14x^{2}+39x-10&=-14x^{2}+35x+4x-10\\\\&=-7x(2x-5)+2(2x-5)\\\\&=(2-7x)(2x-5)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p54-q10-f",
            "type": "part",
            "label": "g",
            "prompt": "$-15x^{2}-x+6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(3-5x)(3x+2)$",
              "worked": "P: $-90$, S: $-1$, F: $-10,9$.\n$$\\begin{align*}-15x^{2}-x+6&=-15x^{2}-10x+9x+6\\\\&=-5x(3x+2)+3(3x+2)\\\\&=(3-5x)(3x+2)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      }
    ]
