      {
        "id": "p54-q10-show",
        "type": "part",
        "label": "a",
        "prompt": "Show that $-12x^{2}-5x+3$ factorises to $(1-3x)(4x+3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12x^{2}-5x+3=(1-3x)(4x+3)$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p54-q10-working-factors",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "P: ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "-36",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", S: ",
                    "marks": [],
