  "content": {
    "id": "p9-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Determine which of these integers have an odd number of factors: $24, 25, 60, 70, 100, 125, 144$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$25, 100, 144$.",
      "worked": "An integer has an odd number of positive factors if and only if it is a perfect square. The perfect squares in the list are:\n$$\\begin{align*}25 &= 5^2\\\\100 &= 10^2\\\\144 &= 12^2.\\end{align*}$$\nTherefore, $25, 100$ and $144$ have an odd number of factors.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
