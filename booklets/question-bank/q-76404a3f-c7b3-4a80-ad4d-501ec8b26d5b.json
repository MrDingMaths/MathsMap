  "content": {
    "id": "p18-q11-root",
    "type": "question",
    "label": null,
    "prompt": "When the side length of a square increases by 2, its area is tripled. Find the side length of the original square.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p18-q11-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "1+\\sqrt3",
                "display": false
              },
              {
                "type": "text",
