  "content": {
    "id": "p35-q25-root",
    "type": "question",
    "label": "25",
    "prompt": "Eight people are to be seated at two indistinguishable round tables, each with four seats. How many distinct arrangements are possible?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p35-q25-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\frac{1}{2}\\binom{8}{4}(3!)^2=1260",
                "display": false
              },
              {
                "type": "text",
                "text": " arrangements.",
                "marks": []
              }
            ]
          },
          {
            "id": "p35-q25-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Divide by ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2!",
                "display": false
              },
              {
                "type": "text",
                "text": " for the indistinguishable tables, and arrange each group circularly.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Choose four people for one table; the remaining four form the other group. Divide by $2!$ because swapping the indistinguishable tables gives the same arrangement. Each group has $3!$ circular arrangements.\n\n$$\\begin{align*}N&=\\frac{\\binom{8}{4}\\binom{4}{4}}{2!}\\times3!\\times3!\\\\N&=1260.\\end{align*}$$\n\nThere are $1260$ arrangements.",
      "solutionDiagrams": []
    },
