  "content": {
    "id": "p6-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "In each part, find the value of $n$ that makes the statement true.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{n}{40}=\\frac{15}{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=30$",
          "worked": "The denominator is multiplied by $2$, so multiply the numerator by $2$.\n$$\\begin{align*}\\frac{15}{20}&=\\frac{15\\times2}{20\\times2}\\\\\\frac{15}{20}&=\\frac{30}{40}\\end{align*}$$\nThus $n=30$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{48}{40}=\\frac{6}{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=5$",
          "worked": "The numerator is divided by $8$, so divide the denominator by $8$.\n$$\\begin{align*}\\frac{48}{40}&=\\frac{48\\div8}{40\\div8}\\\\\\frac{48}{40}&=\\frac{6}{5}\\end{align*}$$\nThus $n=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{10}{15}=\\frac{n}{75}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=50$",
          "worked": "The denominator is multiplied by $5$, so multiply the numerator by $5$.\n$$\\begin{align*}\\frac{10}{15}&=\\frac{10\\times5}{15\\times5}\\\\\\frac{10}{15}&=\\frac{50}{75}\\end{align*}$$\nThus $n=50$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{8}=\\frac{36}{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=96$",
          "worked": "The numerator is multiplied by $12$, so multiply the denominator by $12$.\n$$\\begin{align*}\\frac{3}{8}&=\\frac{3\\times12}{8\\times12}\\\\\\frac{3}{8}&=\\frac{36}{96}\\end{align*}$$\nThus $n=96$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{18}{n}=\\frac{90}{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=20$",
          "worked": "The numerator is divided by $5$, so divide the denominator by $5$.\n$$\\begin{align*}\\frac{90}{100}&=\\frac{90\\div5}{100\\div5}\\\\\\frac{90}{100}&=\\frac{18}{20}\\end{align*}$$\nThus $n=20$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
