  "content": {
    "id": "p22-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Find the smallest positive number that is divisible by $1,2,3,4$ and $5$, and which only uses the digits $0$ and $5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$55\\,500$.\n\nDivisibility by $4$ requires the final digits $00$, and divisibility by $3$ requires at least three digits equal to $5$.",
      "worked": "The final two digits must be divisible by $4$. Of $00,05,50,55$, only $00$ qualifies. The digit sum is five times the number of digits equal to $5$, so divisibility by $3$ requires that number to be a positive multiple of $3$. At least three $5$s and two final zeros are needed. The smallest arrangement is $55\\,500$. It is divisible by $3$ and $4$, and its final zero also ensures divisibility by $2$ and $5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
