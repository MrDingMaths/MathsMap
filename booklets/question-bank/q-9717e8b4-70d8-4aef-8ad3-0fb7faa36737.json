  "content": {
    "id": "p13-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Solve these equations by first writing in the form $x^{2}+bx+c=0$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{2}=5(x-1.2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $3$",
          "worked": "$$\\begin{align*}x^{2}&=5x-6\\\\x^{2}-5x+6&=0\\\\(x-2)(x-3)&=0\\\\x&=2\\text{ or }3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x(x-3)=x^{2}-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "$$\\begin{align*}2x^{2}-6x&=x^{2}-9\\\\x^{2}-6x+9&=0\\\\(x-3)^{2}&=0\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$x(x+6)=4(x+1)-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$ or $1$",
          "worked": "$$\\begin{align*}x^{2}+6x&=4x+4-x\\\\x^{2}+6x&=3x+4\\\\x^{2}+3x-4&=0\\\\(x+4)(x-1)&=0\\\\x&=-4\\text{ or }1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{5x+84}{x}=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=12$ or $-7$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}5x+84&=x^{2}\\\\x^{2}-5x-84&=0\\\\(x-12)(x+7)&=0\\\\x&=12\\text{ or }-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{9x+70}{x}=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=14$ or $-5$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}9x+70&=x^{2}\\\\x^{2}-9x-70&=0\\\\(x-14)(x+5)&=0\\\\x&=14\\text{ or }-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$x-2=\\dfrac{35}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$ or $-5$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}x^{2}-2x&=35\\\\x^{2}-2x-35&=0\\\\(x-7)(x+5)&=0\\\\x&=7\\text{ or }-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$x+3=-\\dfrac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $-2$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}x^{2}+3x&=-2\\\\x^{2}+3x+2&=0\\\\(x+1)(x+2)&=0\\\\x&=-1\\text{ or }-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$-\\dfrac{1}{x}=x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}-1&=x^{2}-2x\\\\x^{2}-2x+1&=0\\\\(x-1)^{2}&=0\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q11-i",
        "type": "part",
        "label": "i",
        "prompt": "$-\\dfrac{8}{x}=2x-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $4$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}-8&=2x^{2}-10x\\\\2x^{2}-10x+8&=0\\\\x^{2}-5x+4&=0\\\\(x-1)(x-4)&=0\\\\x&=1\\text{ or }4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p13-q11-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{x^{2}-48}{x}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8$ or $-6$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}x^{2}-48&=2x\\\\x^{2}-2x-48&=0\\\\(x-8)(x+6)&=0\\\\x&=8\\text{ or }-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q11-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{x^{2}+12}{x}=-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $-6$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}x^{2}+12&=-8x\\\\x^{2}+8x+12&=0\\\\(x+2)(x+6)&=0\\\\x&=-2\\text{ or }-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q11-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{x-5}{4}=\\dfrac{6}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8$ or $-3$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}x(x-5)&=24\\\\x^{2}-5x&=24\\\\x^{2}-5x-24&=0\\\\(x-8)(x+3)&=0\\\\x&=8\\text{ or }-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p13-q11-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{x-4}{2}=\\dfrac{5}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$ or $-1$",
          "worked": "For $x\\ne0$:\n$$\\begin{align*}x(x-4)&=5\\\\x^{2}-4x&=5\\\\x^{2}-4x-5&=0\\\\(x-5)(x+1)&=0\\\\x&=5\\text{ or }-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p13-q11-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\dfrac{x+4}{2}-\\dfrac{3}{x-3}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $-3$",
          "worked": "For $x\\ne3$:\n$$\\begin{align*}(x+4)(x-3)-6&=2(x-3)\\\\x^{2}+x-18&=2x-6\\\\x^{2}-x-12&=0\\\\(x-4)(x+3)&=0\\\\x&=4\\text{ or }-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q11-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\dfrac{x}{x-2}-\\dfrac{x+1}{x+4}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$ or $-2$",
          "worked": "For $x\\ne2,-4$:\n$$\\begin{align*}x(x+4)-(x+1)(x-2)&=(x-2)(x+4)\\\\x^{2}+4x-(x^{2}-x-2)&=x^{2}+2x-8\\\\5x+2&=x^{2}+2x-8\\\\x^{2}-3x-10&=0\\\\(x-5)(x+2)&=0\\\\x&=5\\text{ or }-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
