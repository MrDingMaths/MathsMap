        "children": [
          {
            "id": "p10-q6a-sketch",
            "type": "part",
            "label": "i",
            "prompt": "Sketch $(x-3)^2+y^2=9$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "sharedSolutionDiagramId": "p10-q6a-graph",
            "answer": {
              "short": "Circle with centre $(3,0)$ and radius $3$.",
              "worked": "The circle has centre $(3,0)$ and radius $\\sqrt{9}=3$. It passes through $(0,0)$, $(6,0)$ and $(3,\\pm3)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 70
          },
          {
            "id": "p10-q6a-original-domain-range",
            "type": "part",
            "label": "ii",
            "prompt": "State the domain and range.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Domain: $0\\le x\\le6$. Range: $-3\\le y\\le3$.",
              "worked": "The centre is $(3,0)$ and the radius is $3$.\n$$\\begin{align*}3-3&\\le x\\le3+3\\\\-3&\\le y\\le3\\end{align*}$$\nDomain: $[0,6]$. Range: $[-3,3]$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p10-q6a-inverse-sketch",
            "type": "part",
            "label": "iii",
            "prompt": "On the same axis, graph the inverse.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "sharedSolutionDiagramId": "p10-q6a-graph",
            "answer": {
              "short": "$x^2+(y-3)^2=9$: circle with centre $(0,3)$ and radius $3$.",
              "worked": "Swap $x$ and $y$:\n$$\\begin{align*}(y-3)^2+x^2&=9\\\\x^2+(y-3)^2&=9\\end{align*}$$\nReflect the original circle across $y=x$. Its centre becomes $(0,3)$ and its radius remains $3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          },
          {
            "id": "p10-q6a-inverse-domain-range",
            "type": "part",
            "label": "iv",
            "prompt": "State the domain and range of the inverse.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Domain: $-3\\le x\\le3$. Range: $0\\le y\\le6$.",
              "worked": "Reflection across $y=x$ swaps the domain and range. The inverse therefore has domain $[-3,3]$ and range $[0,6]$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ],
        "sharedSolutionDiagrams": [
          {
            "id": "p10-q6a-graph",
            "role": "solution",
            "format": "tikz",
