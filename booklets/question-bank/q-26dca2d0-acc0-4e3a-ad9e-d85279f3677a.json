  "content": {
    "id": "p29-q8-root",
    "type": "question",
    "label": null,
    "prompt": "[Dilations and symmetry]",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q8-a",
        "type": "group",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p29-q8-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Show that $y=x^3-x$ is an odd function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(-x)=-f(x)$, so $f$ is odd.",
              "worked": "Let $f(x)=x^3-x$.\n$$\\begin{align*}f(-x)&=(-x)^3-(-x)\\\\f(-x)&=-x^3+x\\\\f(-x)&=-(x^3-x)\\\\f(-x)&=-f(x)\\end{align*}$$\nTherefore $f$ is odd.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p29-q8-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "This function is stretched horizontally by a factor of 2. Write down the equation of this new function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac18(x^3-4x)$.",
              "worked": "$$\\begin{align*}y&=\\left(\\frac{x}{2}\\right)^3-\\frac{x}{2}\\\\y&=\\frac18(x^3-4x)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p29-q8-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Is the new function odd?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Yes.",
              "worked": "For $g(x)=\\frac18(x^3-4x)$,\n$$\\begin{align*}g(-x)&=\\frac18(-x^3+4x)\\\\g(-x)&=-g(x)\\end{align*}$$\nThus the new function is odd.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          }
        ]
      },
      {
        "id": "p29-q8-b",
        "type": "group",
        "label": "b",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p29-q8-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Show that $y=1-x^2$ is an even function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(-x)=f(x)$, so $f$ is even.",
              "worked": "Let $f(x)=1-x^2$.\n$$\\begin{align*}f(-x)&=1-(-x)^2\\\\f(-x)&=1-x^2\\\\f(-x)&=f(x)\\end{align*}$$\nTherefore $f$ is even.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p29-q8-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "This function is stretched vertically by a factor of 3. Write down the equation of this new function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=3(1-x^2)$.",
              "worked": "Multiply the original function by $3$:\n$$y=3(1-x^2).$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p29-q8-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Is the new function even?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Yes.",
              "worked": "For $g(x)=3(1-x^2)$,\n$$\\begin{align*}g(-x)&=3\\left(1-(-x)^2\\right)\\\\g(-x)&=3(1-x^2)\\\\g(-x)&=g(x)\\end{align*}$$\nThus the new function is even.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          }
        ]
      },
      {
        "id": "p29-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "What do you conclude about dilations and symmetry from these two examples?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal and vertical dilations preserve odd and even symmetry.",
          "worked": "The odd function remains odd after the horizontal dilation, so its symmetry about the origin is preserved. The even function remains even after the vertical dilation, so its symmetry about the $y$-axis is preserved.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
