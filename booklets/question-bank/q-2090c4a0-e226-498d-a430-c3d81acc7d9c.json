  "content": {
    "id": "p3-practice-root",
    "type": "question",
    "label": "",
    "prompt": "Find $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}$, given:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-practice-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{u}=3\\mathbf{i}-4\\mathbf{j},\\quad \\underset{\\sim}{v}=\\mathbf{i}+2\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=(3)(1)+(-4)(2)\\\\&=-5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-practice-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{u}=\\begin{pmatrix}2\\\\5\\end{pmatrix},\\quad \\underset{\\sim}{v}=\\begin{pmatrix}-3\\\\4\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=(2)(-3)+(5)(4)\\\\&=14\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-practice-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{u}=\\begin{pmatrix}\\frac{1}{\\sqrt{2}}\\\\[3pt]\\frac{1}{\\sqrt{2}}\\end{pmatrix},\\quad \\underset{\\sim}{v}=\\begin{pmatrix}0\\\\12\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12}{\\sqrt{2}}=6\\sqrt{2}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=\\left(\\frac{1}{\\sqrt{2}}\\right)(0)+\\left(\\frac{1}{\\sqrt{2}}\\right)(12)\\\\&=\\frac{12}{\\sqrt{2}}\\\\&=6\\sqrt{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p3-practice-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\underset{\\sim}{u}=6\\cos30^\\circ\\,\\mathbf{i}-6\\sin30^\\circ\\,\\mathbf{j}$,\n\n$\\underset{\\sim}{v}=-2\\cos45^\\circ\\,\\mathbf{i}-2\\sin45^\\circ\\,\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\sqrt{6}+3\\sqrt{2}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=(6\\cos30^\\circ)(-2\\cos45^\\circ)\\\\&\\quad+(-6\\sin30^\\circ)(-2\\sin45^\\circ)\\\\&=(3\\sqrt{3})(-\\sqrt{2})+(-3)(-\\sqrt{2})\\\\&=-3\\sqrt{6}+3\\sqrt{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
