    "children": [
      {
        "id": "p44-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$3ab+5bc+3ad+5cd$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3a+5c)(b+d)$",
          "worked": "$$\\begin{align*}3ab+5bc+3ad+5cd&=b(3a+5c)+d(3a+5c)\\\\&=(3a+5c)(b+d)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p44-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$4ab-7ac+4bd-7cd$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4b-7c)(a+d)$",
          "worked": "$$\\begin{align*}4ab-7ac+4bd-7cd&=a(4b-7c)+d(4b-7c)\\\\&=(4b-7c)(a+d)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p44-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$2xy-8xz+3wy-12wz$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3w+2x)(y-4z)$",
          "worked": "$$\\begin{align*}2xy-8xz+3wy-12wz&=2x(y-4z)+3w(y-4z)\\\\&=(3w+2x)(y-4z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p44-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$5rs-10r+st-2t$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(s-2)(5r+t)$",
          "worked": "$$\\begin{align*}5rs-10r+st-2t&=5r(s-2)+t(s-2)\\\\&=(s-2)(5r+t)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$4x^2+12xy-3x-9y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x-3)(x+3y)$",
          "worked": "$$\\begin{align*}4x^2+12xy-3x-9y&=4x(x+3y)-3(x+3y)\\\\&=(4x-3)(x+3y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p44-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$2ab-a^2-2bc+ac$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-2b)(c-a)$",
          "worked": "$$\\begin{align*}2ab-a^2-2bc+ac&=a(2b-a)-c(2b-a)\\\\&=(2b-a)(a-c)\\\\&=(a-2b)(c-a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
