  "content": {
    "id": "p17-p3-root",
    "type": "question",
    "label": "7",
    "prompt": "Show that $x=\\sec\\theta+\\tan\\theta$ and $y=2\\sec\\theta$ satisfy $x^2-xy+1=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^2-xy+1=\\tan^2\\theta-\\sec^2\\theta+1=0$.\n\nSubstitute the given expressions, expand and use $\\sec^2\\theta-\\tan^2\\theta=1$.",
      "worked": "$$\\begin{align*}x^2-xy+1&=(\\sec\\theta+\\tan\\theta)^2-2\\sec\\theta(\\sec\\theta+\\tan\\theta)+1\\\\&=\\sec^2\\theta+2\\sec\\theta\\tan\\theta+\\tan^2\\theta-2\\sec^2\\theta-2\\sec\\theta\\tan\\theta+1\\\\&=\\tan^2\\theta-\\sec^2\\theta+1\\\\&=-1+1\\\\&=0.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
