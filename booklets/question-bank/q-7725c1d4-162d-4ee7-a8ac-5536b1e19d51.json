    "type": "question",
    "label": null,
    "prompt": "Find the reciprocal of $\\frac{1}{a}+\\frac{1}{b}-\\frac{c}{ab}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{ab}{a+b-c}$",
      "worked": "$\\begin{aligned}\\frac{1}{a}+\\frac{1}{b}-\\frac{c}{ab}&=\\frac{b}{ab}+\\frac{a}{ab}-\\frac{c}{ab}\\\\&=\\frac{a+b-c}{ab}\\end{aligned}$\n\nThe reciprocal is $\\frac{ab}{a+b-c}$.",
      "solutionDiagrams": []
    },
