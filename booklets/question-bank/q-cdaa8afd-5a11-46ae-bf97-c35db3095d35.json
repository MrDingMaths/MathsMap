  "content": {
    "id": "p42-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Write as a single fraction, without negative indices, and simplify.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^{-1}-b^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b-a}{ab}$",
          "worked": "$\\begin{align*}a^{-1}-b^{-1}&=\\frac{1}{a}-\\frac{1}{b}\\\\&=\\frac{b-a}{ab}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p42-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1-y^{-1}}{1-y^{-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y}{y+1}$",
          "worked": "$\\begin{align*}\\frac{1-y^{-1}}{1-y^{-2}}&=\\frac{1-\\frac{1}{y}}{1-\\frac{1}{y^2}}\\\\&=\\frac{y^2-y}{y^2-1}\\\\&=\\frac{y(y-1)}{(y-1)(y+1)}\\\\&=\\frac{y}{y+1}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p42-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x^{-2}-y^{-2})^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2y^2}{y^2-x^2}$",
          "worked": "$\\begin{align*}(x^{-2}-y^{-2})^{-1}&=\\frac{1}{\\frac{1}{x^2}-\\frac{1}{y^2}}\\\\&=\\frac{1}{\\frac{y^2-x^2}{x^2y^2}}\\\\&=\\frac{x^2y^2}{y^2-x^2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p42-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a^{-1}+b^{-1}}{a^{-2}-b^{-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{ab}{b-a}$",
          "worked": "$\\begin{align*}\\frac{a^{-1}+b^{-1}}{a^{-2}-b^{-2}}&=\\frac{\\frac{1}{a}+\\frac{1}{b}}{\\frac{1}{a^2}-\\frac{1}{b^2}}\\\\&=\\frac{ab^2+a^2b}{b^2-a^2}\\\\&=\\frac{ab(a+b)}{(b-a)(b+a)}\\\\&=\\frac{ab}{b-a}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p42-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^{-2}y^{-2}(x^2y^{-1}-y^2x^{-1})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3-y^3}{x^3y^3}$",
          "worked": "$\\begin{align*}x^{-2}y^{-2}(x^2y^{-1}-y^2x^{-1})&=\\frac{1}{x^2y^2}\\left(\\frac{x^2}{y}-\\frac{y^2}{x}\\right)\\\\&=\\frac{1}{x^2y^2}\\cdot\\frac{x^3-y^3}{xy}\\\\&=\\frac{x^3-y^3}{x^3y^3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p42-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(a^2-1)^{-1}}{(a-1)^{-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{a+1}$",
          "worked": "$\\begin{align*}\\frac{(a^2-1)^{-1}}{(a-1)^{-1}}&=\\frac{\\frac{1}{a^2-1}}{\\frac{1}{a-1}}\\\\&=\\frac{1}{a^2-1}\\times(a-1)\\\\&=\\frac{a-1}{(a-1)(a+1)}\\\\&=\\frac{1}{a+1}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
