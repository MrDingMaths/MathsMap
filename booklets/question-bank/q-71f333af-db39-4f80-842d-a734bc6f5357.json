  "content": {
    "id": "p15-q13",
    "type": "question",
    "label": "13",
    "prompt": "Three-quarters of the trees in a forest are acacias. It is known that there are 6000 trees in the forest.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "How many acacias are there in the forest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4500 acacias",
          "worked": "$$\\begin{align*}\\text{Number of acacias}&=\\frac{3}{4}\\times6000\\\\\\text{Number of acacias}&=3\\times1500\\\\\\text{Number of acacias}&=4500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the trees are not acacias?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\text{Fraction not acacias}&=1-\\frac{3}{4}\\\\\\text{Fraction not acacias}&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
