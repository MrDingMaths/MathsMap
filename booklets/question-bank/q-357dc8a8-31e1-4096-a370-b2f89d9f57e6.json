                  "text": " solving for them explicitly?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Check the discriminant $\\Delta=b^2-4ac$ of the resulting quadratic equation.",
          "worked": "Write the resulting quadratic equation as $ax^2+bx+c=0$ and calculate $\\Delta=b^2-4ac$. If $\\Delta>0$, there are two intersections; if $\\Delta=0$, there is one intersection; if $\\Delta<0$, there are no intersections.",
