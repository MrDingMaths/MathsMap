  "content": {
    "id": "p16-q7-root",
    "type": "question",
    "label": null,
    "prompt": "Bob solves a linear function simultaneously with a quadratic function to find any points of intersection, if they exist.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q7-a",
        "type": "group",
        "label": "a",
        "prompt": "Describe what happens geometrically if Bob finds that there are",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q7-a-i",
            "type": "part",
            "label": "i",
            "prompt": "two solutions.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The line and parabola intersect at two distinct points.",
              "worked": "Each solution gives a point lying on both graphs, so the line and parabola intersect at two distinct points.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p16-q7-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "one solution.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The line is tangential to the parabola.",
              "worked": "There is one common point, so the line is tangent to the parabola.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p16-q7-a-iii",
            "type": "part",
            "label": "iii",
