  "content": {
    "id": "v2-04c12d-p5-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Find the first term of each geometric sequence.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-04c12d-p5-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The 2nd term is 6 and the 5th term is 162.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$",
          "worked": "$$\\begin{align*}ar&=6\\qquad (1)\\\\ar^4&=162\\qquad (2)\\\\\\frac{(2)}{(1)}:\\quad r^3&=27\\\\r&=3\\end{align*}$$\nSubstituting into (1): $3a=6$, so $a=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-04c12d-p5-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The 3rd term is 12 and the 5th term is 48.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3$",
          "worked": "$$\\begin{align*}ar^2&=12\\qquad (1)\\\\ar^4&=48\\qquad (2)\\\\\\frac{(2)}{(1)}:\\quad r^2&=4\\\\r&=\\pm2\\end{align*}$$\nSubstituting either value of $r$ into (1): $4a=12$, so $a=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-04c12d-p5-practice-slot-1-slot-1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "The 3rd term is 50 and the 6th term is $6.25$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=200$",
          "worked": "$$\\begin{align*}ar^2&=50\\qquad (1)\\\\ar^5&=6.25\\qquad (2)\\\\\\frac{(2)}{(1)}:\\quad r^3&=\\frac{6.25}{50}=\\frac18\\\\r&=\\frac12\\end{align*}$$\nSubstituting into (1): $\\frac{a}{4}=50$, so $a=200$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
