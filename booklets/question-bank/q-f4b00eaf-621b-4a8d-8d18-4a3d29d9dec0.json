  "content": {
    "id": "p33-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A debating club has a president, vice-president and 7 other members. A debating team of four is to be chosen, and the speaking order (1 through to 4) fixed. Find the number of distinct speaking orders if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "either the president or the vice-president (but not both) must be included in the team.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{2}{1}\\binom{7}{3}\\times4!=1680$ speaking orders.",
          "worked": "Choose one office-holder and three other members, then arrange the four speakers.\n$$\\begin{align*}N_a&=\\binom{2}{1}\\binom{7}{3}\\times4!\\\\N_a&=2\\times35\\times24\\\\N_a&=1680.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "at least one of the president or vice-president are on the team.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-q8-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "2184 speaking orders.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p33-q8-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the cases of exactly one office-holder and both office-holders, arranging each team in ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "4!",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " ways.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Exactly one office-holder gives $\\binom{2}{1}\\binom{7}{3}\\times4!=1680$ orders. Both office-holders gives $\\binom{2}{2}\\binom{7}{2}\\times4!=504$ orders. These cases are mutually exclusive.\n$$\\begin{align*}N_b&=\\binom{2}{1}\\binom{7}{3}\\times4!+\\binom{2}{2}\\binom{7}{2}\\times4!\\\\N_b&=1680+504\\\\N_b&=2184.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
  },
