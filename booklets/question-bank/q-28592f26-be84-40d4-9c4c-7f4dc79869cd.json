    "id": "v2-a5711-p37-practice-slot-23-upper-root",
    "type": "question",
    "label": null,
    "prompt": "A ribbon is $5\\frac{2}{3}$ m long.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a5711-p37-practice-slot-23-upper-slot-23-upper-a",
        "type": "part",
        "label": "a",
        "prompt": "How many pieces $\\frac{1}{3}$ m long can be cut from it?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17$",
          "worked": "$$\\begin{align*}5\\frac{2}{3}&=\\frac{5\\times3+2}{3}\\\\&=\\frac{17}{3}\\end{align*}$$\nThere are $17$ thirds, so $17$ pieces.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-a5711-p37-practice-slot-23-upper-slot-23-upper-b",
        "type": "part",
        "label": "b",
        "prompt": "How many pieces $\\frac{1}{6}$ m long can be cut from it?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34$",
          "worked": "$$\\begin{align*}5\\frac{2}{3}&=\\frac{17}{3}\\\\&=\\frac{34}{6}\\end{align*}$$\nThere are $34$ sixths, so $34$ pieces.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
