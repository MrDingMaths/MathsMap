    "label": "28",
    "prompt": "Complete the square. $x^2-9x+11$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\left(x-\\dfrac92\\right)^2-\\dfrac{37}{4}$",
      "worked": "$$\\begin{align*}x^2-9x+11&=\\left(x-\\frac92\\right)^2-\\frac{81}{4}+11\\\\x^2-9x+11&=\\left(x-\\frac92\\right)^2-\\frac{37}{4}.\\end{align*}$$",
      "solutionDiagrams": []
    },
