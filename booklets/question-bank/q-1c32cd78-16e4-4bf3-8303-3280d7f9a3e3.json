  "content": {
    "id": "v2-6283f-p10-practice-slot-4-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Find the exact value of $\\cot\\theta$, given $\\sec\\theta=\\frac{7}{4}$ and $\\theta$ is acute.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{4}{\\sqrt{33}}$",
      "worked": "A reference triangle has adjacent side $4$ and hypotenuse $7$.\n\n$$\\begin{align*}\\mathrm{Opp}&=\\sqrt{7^2-4^2}\\\\&=\\sqrt{33}\\\\\\cot\\theta&=\\frac{\\mathrm{Adj}}{\\mathrm{Opp}}\\\\&=\\frac{4}{\\sqrt{33}}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
