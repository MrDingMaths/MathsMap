  "content": {
    "id": "p43-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The line $y=mx-4$ is tangent to the parabola $y=x^2-2x+5$. Find the values of $m$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=4$ or $m=-8$.",
      "worked": "$$\\begin{align*}mx-4&=x^2-2x+5\\\\x^2+(-2-m)x+9&=0\\end{align*}$$\nFor a tangent, $\\Delta=0$.\n$$\\begin{align*}(-2-m)^2-4(1)(9)&=0\\\\m^2+4m-32&=0\\\\(m+8)(m-4)&=0\\\\m&=4\\text{ or }-8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
