  "content": {
    "id": "p20-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $y=x^3-7$, evaluate:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{dy}{dx}$ when $x=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2\\\\\\left.\\frac{dy}{dx}\\right|_{x=2}&=3(2)^2\\\\\\left.\\frac{dy}{dx}\\right|_{x=2}&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x$ when $\\dfrac{dy}{dx}=12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm2$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2\\\\3x^2&=12\\\\x^2&=4\\\\x&=\\pm2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
