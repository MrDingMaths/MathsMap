        "label": "a",
        "prompt": "$\\dfrac{x^2-36}{x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+6$",
          "worked": "$$\\begin{align*}\\frac{x^2-36}{x-6}&=\\frac{(x-6)(x+6)}{x-6}\\\\&=x+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-da515b-p6-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2-121}{x+11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-11$",
          "worked": "$$\\begin{align*}\\frac{x^2-121}{x+11}&=\\frac{(x-11)(x+11)}{x+11}\\\\&=x-11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-da515b-p6-practice-slot-4-slot-4-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3(x+2)}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{x-2}$",
          "worked": "$$\\begin{align*}\\frac{3(x+2)}{x^2-4}&=\\frac{3(x+2)}{(x-2)(x+2)}\\\\&=\\frac{3}{x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-da515b-p6-practice-slot-4-slot-4-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{4x-8}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{4x-8}{x^2-4}&=\\frac{4(x-2)}{(x-2)(x+2)}\\\\&=\\frac{4}{x+2}\\end{align*}$$",
