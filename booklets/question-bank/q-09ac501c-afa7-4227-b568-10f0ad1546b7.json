  "content": {
    "id": "v2-f25f12d6-p95-topic-j3-055159-root",
    "type": "question",
    "label": null,
    "prompt": "Find the operation that makes this operation true. Choose from $+$, $-$, $\\times$, $\\div$.\n\n$\\frac{3}{4}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{1}{2}=\\frac{3}{2}$\n\nTry $+$: $\\frac34+\\frac12=\\frac54$, which is not $\\frac32$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\div$",
      "worked": "$$\\begin{align*}\\frac34\\times\\frac12&=\\frac38\\\\\\frac34-\\frac12&=\\frac14\\\\\\frac34\\div\\frac12&=\\frac34\\times\\frac21\\\\&=\\frac64\\\\&=\\frac32\\end{align*}$$\nThe missing operation is $\\div$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
