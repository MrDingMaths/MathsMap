  "content": {
    "id": "p10-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A student has a 22% chance of being chosen as a prefect.\nWhat is the chance that he will not be chosen as a prefect?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$78\\%$",
      "worked": "$$\\begin{aligned}P(\\text{not chosen})&=1-P(\\text{chosen})\\\\P(\\text{not chosen})&=1-0.22\\\\P(\\text{not chosen})&=0.78=78\\%\\end{aligned}$$",
      "solutionDiagrams": []
    },
