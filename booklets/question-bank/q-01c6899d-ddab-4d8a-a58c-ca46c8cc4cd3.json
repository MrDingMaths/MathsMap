  "content": {
    "id": "p5-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Let $f(x)=\\dfrac{x}{x+1}$. Show that $f(x)+f\\left(\\dfrac1x\\right)=1$, where $x\\ne0,-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f\\left(\\dfrac1x\\right)=\\dfrac1{x+1}$, so $f(x)+f\\left(\\dfrac1x\\right)=1$.",
      "worked": "$$\\begin{align*}f\\left(\\frac1x\\right)&=\\frac{1/x}{1/x+1}\\\\f\\left(\\frac1x\\right)&=\\frac1{x+1}.\\end{align*}$$\n$$\\begin{align*}f(x)+f\\left(\\frac1x\\right)&=\\frac{x}{x+1}+\\frac1{x+1}\\\\f(x)+f\\left(\\frac1x\\right)&=\\frac{x+1}{x+1}\\\\f(x)+f\\left(\\frac1x\\right)&=1.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
