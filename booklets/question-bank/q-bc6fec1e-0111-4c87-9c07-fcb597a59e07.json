  "content": {
    "id": "p30-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A new children’s book author is offered a choice of \\$100000 cash or a 4% royalty on sales. What would the sales need to be to match the cash offer?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$2\\,500\\,000$ in sales.",
      "worked": "Let $S$ be the value of sales in dollars.\n$$\\begin{align*}\\text{Royalty} &= \\text{Percentage}\\times\\text{Sales}\\\\100\\,000 &= 0.04S\\\\S &= \\frac{100\\,000}{0.04}\\\\S &= 2\\,500\\,000\\end{align*}$$\nSales of $\\$2\\,500\\,000$ would match the cash offer.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
