  "content": {
    "id": "v2-4e6d5-p16-practice-j18-094516-root",
    "type": "question",
    "label": null,
    "prompt": "A 2 kg bag of rice costs \\$5.60. A shop wants to sell a 5 kg bag of the same rice at the same value.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4e6d5-p16-practice-j18-094516-j18-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the cost of 1 kg of rice in the 2 kg bag.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2.80/\\text{kg}$",
          "worked": "$$\\begin{align*}\\text{Cost per kg}&=\\frac{\\$5.60}{2\\text{ kg}}\\\\&=\\frac{\\$5.60\\,{\\color{#ef6068}\\div2}}{2\\text{ kg}\\,{\\color{#ef6068}\\div2}}\\\\&=\\$2.80/\\text{kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-4e6d5-p16-practice-j18-094516-j18-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What must the cost of 1 kg be in the 5 kg bag to give the same value?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2.80/\\text{kg}$",
          "worked": "Equal value means equal unit prices, so the 5 kg bag must also cost $\\$2.80/\\text{kg}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-4e6d5-p16-practice-j18-094516-j18-q-c",
        "type": "part",
        "label": "c",
        "prompt": "What should the 5 kg bag cost?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$14.00$",
          "worked": "$$\\begin{align*}\\text{Cost of 5 kg}&=\\$2.80/\\text{kg}\\times5\\text{ kg}\\\\&=\\$14.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
