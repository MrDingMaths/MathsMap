    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $a$ if $P(x)=x^5-3x^3-5x+a$ and $P(2)=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=6$",
          "worked": "$$\\begin{align*}P(2)&=4\\\\2^5-3(2)^3-5(2)+a&=4\\\\32-24-10+a&=4\\\\a-2&=4\\\\a&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $b$ if $Q(x)=2x^3-3x^2+bx+4$ and $Q(-1)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-1$",
          "worked": "$$\\begin{align*}Q(-1)&=0\\\\2(-1)^3-3(-1)^2+b(-1)+4&=0\\\\-2-3-b+4&=0\\\\-1-b&=0\\\\b&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $a$ and $d$ if $S(x)=x^4-4x^3+ax^2-2x+d$ and $S(-1)=S(-2)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-15$, $d=8$.\n\nSubstitute both given values of $x$ and solve the resulting simultaneous equations.",
          "worked": "$$\\begin{align*}S(-1)&=0\\\\(-1)^4-4(-1)^3+a(-1)^2-2(-1)+d&=0\\\\1+4+a+2+d&=0\\\\a+d&=-7\\qquad\\text{(1)}\\end{align*}$$\n$$\\begin{align*}S(-2)&=0\\\\(-2)^4-4(-2)^3+a(-2)^2-2(-2)+d&=0\\\\16+32+4a+4+d&=0\\\\4a+d&=-52\\qquad\\text{(2)}\\end{align*}$$\nSubtracting (1) from (2):\n$$\\begin{align*}(4a+d)-(a+d)&=-52-(-7)\\\\3a&=-45\\\\a&=-15\\end{align*}$$\nSubstituting into (1):\n$$\\begin{align*}-15+d&=-7\\\\d&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      }
    ]
  },
