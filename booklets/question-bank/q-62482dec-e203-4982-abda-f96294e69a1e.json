  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A uniform discrete random variable $X$ has values $x\\in\\{1,2,3,4\\}$.\n\nFind the expected value for $X$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$E(X)=2.5$",
      "worked": "Each of the four outcomes has probability $\\frac14$.\n\n$$\\begin{align*}E(X)&=1\\times\\frac14+2\\times\\frac14+3\\times\\frac14+4\\times\\frac14\\\\E(X)&=\\frac{10}{4}\\\\E(X)&=2.5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
