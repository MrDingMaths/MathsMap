    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\sqrt2$",
      "worked": "$$\\begin{align*}\\sqrt{32}-\\sqrt8&=\\sqrt{16\\times2}-\\sqrt{4\\times2}\\\\\\sqrt{32}-\\sqrt8&=4\\sqrt2-2\\sqrt2\\\\\\sqrt{32}-\\sqrt8&=2\\sqrt2.\\end{align*}$$",
      "solutionDiagrams": []
    },
