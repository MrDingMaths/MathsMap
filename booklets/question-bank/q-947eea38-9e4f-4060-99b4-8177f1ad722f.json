  "content": {
    "id": "p20-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the gradient of a line that is perpendicular to each line.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y = 3x - 1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{3}$",
          "worked": "$$\\begin{align*}m &= 3\\\\m_{\\mathrm{perp}} &= -\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = -2x + 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}m &= -2\\\\m_{\\mathrm{perp}} &= -\\frac{1}{-2}\\\\m_{\\mathrm{perp}} &= \\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y = \\dfrac{7}{8}x - \\dfrac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{8}{7}$",
          "worked": "$$\\begin{align*}m &= \\frac{7}{8}\\\\m_{\\mathrm{perp}} &= -\\frac{1}{\\frac{7}{8}}\\\\m_{\\mathrm{perp}} &= -\\frac{8}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p20-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y = \\dfrac{-4x}{9} - \\dfrac{4}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9}{4}$",
          "worked": "$$\\begin{align*}m &= -\\frac{4}{9}\\\\m_{\\mathrm{perp}} &= -\\frac{1}{-\\frac{4}{9}}\\\\m_{\\mathrm{perp}} &= \\frac{9}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
