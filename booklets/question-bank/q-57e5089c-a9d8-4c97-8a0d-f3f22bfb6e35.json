  "content": {
    "id": "v2-09d4b-p24-practice-slot-19-root",
    "type": "question",
    "label": null,
    "prompt": "A tractor depreciates at 14% p.a. using the declining-balance method. After 3 years its value is $\\$41\\,800$. What was its value after 1 year, to the nearest dollar?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$56\\,517$",
      "worked": "$$\\begin{align*}S&=V_0(1-r)^n\\\\41\\,800&=V_0(1-0.14)^3\\\\V_0&=\\frac{41\\,800}{0.86^3}\\\\V_0&=65\\,717.7\\ldots\\\\\\text{Value after 1 year}&=V_0\\times0.86\\\\&=56\\,517.04\\ldots\\end{align*}$$\nThe value after 1 year was $\\$56\\,517$, to the nearest dollar.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
