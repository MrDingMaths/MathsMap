        ],
        "children": [],
        "answer": {
          "short": "$x=6\\text{ cm}$",
          "worked": "$$\\begin{aligned}\\cos 60^\\circ&=\\frac{x}{12}\\\\\\frac{1}{2}&=\\frac{x}{12}\\\\x&=12\\times\\frac{1}{2}\\\\x&=6\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
