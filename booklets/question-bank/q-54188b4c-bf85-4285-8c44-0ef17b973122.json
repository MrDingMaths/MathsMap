            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 12 p12-q4-a-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,1.5);\\coordinate (B) at ({1.5*sqrt(3)},1.5);\\coordinate (C) at ({1.5*sqrt(3)},0);\n\\draw[black] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.4pt] ($(B)+(-0.22,0)$)--($(B)+(-0.22,-0.22)$)--($(B)+(0,-0.22)$);\n\\pic[draw=black,line width=0.4pt,angle radius=5mm] {angle=B--C--A};\n\\node at ($(C)+(120:0.66)$) {$60^\\circ$};\n\\draw[black,line width=0.4pt,<->] ($(A)+(-0.16,-0.28)$)--($(C)+(-0.16,-0.28)$) node[midway,below left] {$12\\text{ cm}$};\n\\draw[black,line width=0.4pt,<->] ($(B)+(0.30,0)$)--($(C)+(0.30,0)$) node[midway,right] {$x\\text{ cm}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 49,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 12,
              "sourceRegion": "Question 4a",
              "description": "Horizontal top, vertical right side, external dimension arrows, upper-right right angle and lower-right 60-degree angle. Decorative pink fill omitted.",
              "mathematics": "Hypotenuse 12 cm; adjacent side x cm relative to 60 degrees.",
              "answerVisibility": "Unknown x remains unsolved in the question."
