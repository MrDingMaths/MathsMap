  "content": {
    "id": "p23-q2",
    "type": "question",
    "label": "2",
    "prompt": "A car uses petrol at an average rate of $\\frac{7.4\\text{ L}}{100\\text{ km}}$. How much petrol will it consume in $58\\text{ km}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.292\\text{ L}$",
      "worked": "Let $x$ be the number of litres consumed.\n$$\\begin{align*}\\frac{7.4\\text{ L}}{100\\text{ km}}&=\\frac{x\\text{ L}}{58\\text{ km}}\\\\x&=\\frac{7.4\\times58}{100}\\\\x&=4.292\\end{align*}$$\nThe car consumes $4.292\\text{ L}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
