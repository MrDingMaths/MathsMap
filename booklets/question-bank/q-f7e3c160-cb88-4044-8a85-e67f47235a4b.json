    "answer": {
      "short": "\\$61 410",
      "worked": "$\\begin{align*}\\text{Total deductions} &= 160 + 390 + 1240 + 420 \\\\ &= \\$2210 \\\\ \\text{Taxable income} &= 63\\,620 - 2210 \\\\ &= \\$61\\,410\\end{align*}$",
      "solutionDiagrams": []
    },
