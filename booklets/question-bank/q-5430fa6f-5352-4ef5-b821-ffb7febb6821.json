    "label": "5",
    "prompt": "Write down and evaluate all the powers of 6 up to $6^6$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6^1=6$, $6^2=36$, $6^3=216$, $6^4=1296$, $6^5=7776$, $6^6=46656$.",
      "worked": "$$\\begin{align*}6^1&=6\\\\6^2&=6\\times6=36\\\\6^3&=6\\times6\\times6=216\\\\6^4&=6\\times6\\times6\\times6=1296\\\\6^5&=6\\times6\\times6\\times6\\times6=7776\\\\6^6&=6\\times6\\times6\\times6\\times6\\times6=46656\\end{align*}$$",
      "solutionDiagrams": []
    },
