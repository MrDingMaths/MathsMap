  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify each of the following by using the change of base formula:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_4 5+\\log_2 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4 125$",
          "worked": "$$\\begin{align*}\\log_4 5+\\log_2 5&=\\log_4 5+\\frac{\\log_4 5}{\\log_4 2}\\\\\\log_4 5+\\log_2 5&=3\\log_4 5\\\\\\log_4 5+\\log_2 5&=\\log_4 125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\log_3 9)(\\log_9 7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 7$",
          "worked": "$$\\begin{align*}(\\log_3 9)(\\log_9 7)&=(\\log_3 9)\\frac{\\log_3 7}{\\log_3 9}\\\\(\\log_3 9)(\\log_9 7)&=\\log_3 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\log_4 8)(\\log_8 16)(\\log_{16}32)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac52$",
          "worked": "$$\\begin{align*}(\\log_4 8)(\\log_8 16)(\\log_{16}32)&=\\frac{\\log_2 8}{\\log_2 4}\\frac{\\log_2 16}{\\log_2 8}\\frac{\\log_2 32}{\\log_2 16}\\\\(\\log_4 8)(\\log_8 16)(\\log_{16}32)&=\\frac32\\times\\frac43\\times\\frac54\\\\(\\log_4 8)(\\log_8 16)(\\log_{16}32)&=\\frac52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_9 4+\\log_3 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 12$",
          "worked": "$$\\begin{align*}\\log_9 4+\\log_3 6&=\\frac{\\log_3 4}{\\log_3 9}+\\log_3 6\\\\\\log_9 4+\\log_3 6&=\\log_3 2+\\log_3 6\\\\\\log_9 4+\\log_3 6&=\\log_3 12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_8 27+\\log_2 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 18$",
          "worked": "$$\\begin{align*}\\log_8 27+\\log_2 6&=\\frac{\\log_2 27}{\\log_2 8}+\\log_2 6\\\\\\log_8 27+\\log_2 6&=\\log_2 3+\\log_2 6\\\\\\log_8 27+\\log_2 6&=\\log_2 18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_2 15-\\log_4 25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 3$",
          "worked": "$$\\begin{align*}\\log_2 15-\\log_4 25&=\\log_2 15-\\frac{\\log_2 25}{\\log_2 4}\\\\\\log_2 15-\\log_4 25&=\\log_2 15-\\log_2 5\\\\\\log_2 15-\\log_4 25&=\\log_2 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_9 4+\\log_3 12-\\log_{27}8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 12$",
          "worked": "$$\\begin{align*}\\log_9 4+\\log_3 12-\\log_{27}8&=\\frac{\\log_3 4}{2}+\\log_3 12-\\frac{\\log_3 8}{3}\\\\\\log_9 4+\\log_3 12-\\log_{27}8&=\\log_3 2+\\log_3 12-\\log_3 2\\\\\\log_9 4+\\log_3 12-\\log_{27}8&=\\log_3 12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$3\\log_2 5+2\\log_4 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 750$",
          "worked": "$$\\begin{align*}3\\log_2 5+2\\log_4 6&=3\\log_2 5+2\\frac{\\log_2 6}{\\log_2 4}\\\\3\\log_2 5+2\\log_4 6&=\\log_2 125+\\log_2 6\\\\3\\log_2 5+2\\log_4 6&=\\log_2 750\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$2\\log_9 12-\\log_3 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 2$",
          "worked": "$$\\begin{align*}2\\log_9 12-\\log_3 6&=2\\frac{\\log_3 12}{\\log_3 9}-\\log_3 6\\\\2\\log_9 12-\\log_3 6&=\\log_3 12-\\log_3 6\\\\2\\log_9 12-\\log_3 6&=\\log_3 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
