      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the horizontal distance between the end points is $P$ from $A$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3}$",
          "worked": "$$\\begin{aligned}\\text{Fraction}&=\\frac{1}{1+2}\\\\&=\\frac{1}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the vertical distance between the end points is $P$ from $A$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3}$",
          "worked": "$P$ is the same fraction of the vertical distance from $A$ as of the horizontal distance.\n$$\\begin{aligned}\\text{Fraction}&=\\frac{1}{1+2}\\\\&=\\frac{1}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find $P$ algebraically.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-1,0)$",
          "worked": "The coordinates of $P$ are one third of the distance from $A$ to $B$.\n$$\\begin{aligned}x_P&=-3+\\frac{1}{3}\\bigl(3-(-3)\\bigr)\\\\&=-1\\\\y_P&=-1+\\frac{1}{3}\\bigl(2-(-1)\\bigr)\\\\&=0\\end{aligned}$$\n$P(-1,0)$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ],
