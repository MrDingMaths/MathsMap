  "content": {
    "id": "p23-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A rectangle has side lengths $4b$ cm and $2a$ cm. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q9a",
        "type": "part",
        "label": "a",
        "prompt": "the perimeter of the rectangle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(8b+4a)\\text{ cm}$",
          "worked": "$$\\begin{align*}P&=4b+2a+4b+2a\\\\P&=(8b+4a)\\text{ cm}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p23-q9b",
        "type": "part",
        "label": "b",
        "prompt": "the area of the rectangle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8ab\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=4b\\times2a\\\\A&=8ab\\text{ cm}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
