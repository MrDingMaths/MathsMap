  "content": {
    "id": "p99-q5-response",
    "type": "question",
    "label": "5",
    "prompt": "A carpenter takes 36 minutes to make a chair. How many complete chairs can he make in $4\\frac{1}{2}$ hours?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "7 complete chairs; the available time is equivalent to making $7\\frac{1}{2}$ chairs.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p99-q5-answer-time",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "36\\text{ min}=\\frac{36}{60}\\text{ h}=\\frac{3}{5}\\text{ h}",
                "display": false
              }
            ]
          },
          {
            "id": "p99-q5-answer-calculation",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}4\\frac{1}{2}\\div\\frac{3}{5}&=\\frac{9}{2}\\times\\frac{5}{3}\\\\&=\\frac{15}{2}\\\\&=7\\frac{1}{2}\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p99-q5-answer-interpretation",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "He can finish 7 complete chairs, with 18 minutes remaining.",
                "marks": []
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
