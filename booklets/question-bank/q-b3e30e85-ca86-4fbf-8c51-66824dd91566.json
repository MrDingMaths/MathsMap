    "children": [
      {
        "id": "p36-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the mean of $X$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5$ calls",
          "worked": "$$\\begin{aligned}E(X)&=0(0.2)+1(0.2)+2(0.5)+3(0.1)\\\\E(X)&=1.5\\text{ calls}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p36-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that Daniel receives only one phone call on each of the three consecutive days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.008$",
          "worked": "By independence,\n$$\\begin{aligned}P(1,1,1)&=0.2^3\\\\P(1,1,1)&=0.008.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p36-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "Daniel receives telephone calls on both Monday and Tuesday.\n\nWhat is the probability that Daniel receives a total of four calls over these two days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{29}{64}$",
          "worked": "Let $M$ and $T$ be the numbers of calls received on Monday and Tuesday. The possible pairs totalling four are $(1,3)$, $(2,2)$ and $(3,1)$.\n$$\\begin{aligned}P(M+T=4\\mid M\\geq1,T\\geq1)&=\\frac{P(M=1,T=3)+P(M=2,T=2)+P(M=3,T=1)}{P(M\\geq1,T\\geq1)}\\\\P(M+T=4\\mid M\\geq1,T\\geq1)&=\\frac{(0.2)(0.1)+(0.5)(0.5)+(0.1)(0.2)}{(0.8)(0.8)}\\\\P(M+T=4\\mid M\\geq1,T\\geq1)&=\\frac{0.29}{0.64}\\\\P(M+T=4\\mid M\\geq1,T\\geq1)&=\\frac{29}{64}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
