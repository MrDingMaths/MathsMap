  "content": {
    "id": "p18-p8-node",
    "type": "question",
    "label": "8",
    "prompt": "Show that $ax^2+bx+c=0$ cannot have real roots if $\\frac ba=\\frac cb$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No real roots, since $b^2=ac$ and $\\Delta=-3b^2<0$.",
      "worked": "The given fractions require $a\\ne0$ and $b\\ne0$. Cross-multiplying gives $b^2=ac$.\n\n$$\\begin{align*}\\Delta&=b^2-4ac\\\\\\Delta&=b^2-4b^2\\\\\\Delta&=-3b^2\\end{align*}$$\n\nSince $b\\ne0$, $\\Delta<0$ and there are no real roots.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
