    "children": [
      {
        "id": "p17-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{a^2+ab}{a^2-ab}\\times\\frac{ab^2+b^2}{a^3+a^2b}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b^2(a+1)}{a^2(a-b)}$",
          "worked": "$$\\begin{align*}\\frac{a^2+ab}{a^2-ab}\\times\\frac{ab^2+b^2}{a^3+a^2b}&=\\frac{a(a+b)}{a(a-b)}\\times\\frac{b^2(a+1)}{a^2(a+b)}\\\\\\frac{a^2+ab}{a^2-ab}\\times\\frac{ab^2+b^2}{a^3+a^2b}&=\\frac{b^2(a+1)}{a^2(a-b)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{a^2}{a^2-4}\\times\\frac{a^2-5a+6}{3a-a^2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{a}{a+2}$",
          "worked": "$$\\begin{align*}\\frac{a^2}{a^2-4}\\times\\frac{a^2-5a+6}{3a-a^2}&=\\frac{a^2}{(a-2)(a+2)}\\times\\frac{(a-2)(a-3)}{-a(a-3)}\\\\\\frac{a^2}{a^2-4}\\times\\frac{a^2-5a+6}{3a-a^2}&=-\\frac{a}{a+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{m^2-m-6}{m^2-9}\\times\\frac{m^2}{m^2+2m}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{m}{m+3}$",
          "worked": "$$\\begin{align*}\\frac{m^2-m-6}{m^2-9}\\times\\frac{m^2}{m^2+2m}&=\\frac{(m-3)(m+2)}{(m-3)(m+3)}\\times\\frac{m^2}{m(m+2)}\\\\\\frac{m^2-m-6}{m^2-9}\\times\\frac{m^2}{m^2+2m}&=\\frac{m}{m+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{3x^2+x-2}{x^2-1}\\times\\frac{x^2-2x+1}{x^2-x-2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(3x-2)(x-1)}{(x-2)(x+1)}$",
          "worked": "$$\\begin{align*}\\frac{3x^2+x-2}{x^2-1}\\times\\frac{x^2-2x+1}{x^2-x-2}&=\\frac{(3x-2)(x+1)}{(x-1)(x+1)}\\times\\frac{(x-1)^2}{(x-2)(x+1)}\\\\\\frac{3x^2+x-2}{x^2-1}\\times\\frac{x^2-2x+1}{x^2-x-2}&=\\frac{(3x-2)(x-1)}{(x-2)(x+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{4x^2+x-3}{x^2+2x}\\div\\frac{x^2-4x-5}{x^2-3x-10}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4x-3}{x}$",
          "worked": "$$\\begin{align*}\\frac{4x^2+x-3}{x^2+2x}\\div\\frac{x^2-4x-5}{x^2-3x-10}&=\\frac{4x^2+x-3}{x^2+2x}\\times\\frac{x^2-3x-10}{x^2-4x-5}\\\\\\frac{4x^2+x-3}{x^2+2x}\\div\\frac{x^2-4x-5}{x^2-3x-10}&=\\frac{(4x-3)(x+1)}{x(x+2)}\\times\\frac{(x-5)(x+2)}{(x-5)(x+1)}\\\\\\frac{4x^2+x-3}{x^2+2x}\\div\\frac{x^2-4x-5}{x^2-3x-10}&=\\frac{4x-3}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p17-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{2x^2+x-3}{x^2+2x}\\div\\frac{x^2-4x+3}{x^2}\\div\\frac{2x^2+3x}{x^2-x-6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$\n\nWork from left to right, multiplying by the reciprocal of each divisor.",
          "worked": "Work from left to right, replacing each division by multiplication by the reciprocal.\n$$\\begin{align*}\\frac{2x^2+x-3}{x^2+2x}\\div\\frac{x^2-4x+3}{x^2}\\div\\frac{2x^2+3x}{x^2-x-6}&=\\frac{2x^2+x-3}{x^2+2x}\\times\\frac{x^2}{x^2-4x+3}\\times\\frac{x^2-x-6}{2x^2+3x}\\\\\\frac{2x^2+x-3}{x^2+2x}\\div\\frac{x^2-4x+3}{x^2}\\div\\frac{2x^2+3x}{x^2-x-6}&=\\frac{(2x+3)(x-1)}{x(x+2)}\\times\\frac{x^2}{(x-1)(x-3)}\\times\\frac{(x-3)(x+2)}{x(2x+3)}\\\\\\frac{2x^2+x-3}{x^2+2x}\\div\\frac{x^2-4x+3}{x^2}\\div\\frac{2x^2+3x}{x^2-x-6}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p17-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{x^2-3x-4}{x^2-4x}\\div\\frac{x^2-4x+4}{x^2-4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(x+1)(x+2)}{x(x-2)}$",
          "worked": "$$\\begin{align*}\\frac{x^2-3x-4}{x^2-4x}\\div\\frac{x^2-4x+4}{x^2-4}&=\\frac{x^2-3x-4}{x^2-4x}\\times\\frac{x^2-4}{x^2-4x+4}\\\\\\frac{x^2-3x-4}{x^2-4x}\\div\\frac{x^2-4x+4}{x^2-4}&=\\frac{(x-4)(x+1)}{x(x-4)}\\times\\frac{(x-2)(x+2)}{(x-2)^2}\\\\\\frac{x^2-3x-4}{x^2-4x}\\div\\frac{x^2-4x+4}{x^2-4}&=\\frac{(x+1)(x+2)}{x(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
