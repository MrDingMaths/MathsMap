  "content": {
    "id": "p31-q26-group-root",
    "type": "question",
    "label": "6",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q26-root",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x^2+4x+3}{x+3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+1$, $x\\ne-3$.",
          "worked": "$$\\begin{align*}\\frac{x^2+4x+3}{x+3}&=\\frac{(x+1)(x+3)}{x+3}\\\\\\frac{x^2+4x+3}{x+3}&=x+1.\\end{align*}$$\nThe original denominator requires $x\\ne-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q27-root",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{x^2+6x+9}{x+3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$, $x\\ne-3$.",
          "worked": "$$\\begin{align*}\\frac{x^2+6x+9}{x+3}&=\\frac{(x+3)^2}{x+3}\\\\\\frac{x^2+6x+9}{x+3}&=x+3.\\end{align*}$$\nThe original denominator requires $x\\ne-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q28-root",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{x^2-4x-12}{x-6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$, $x\\ne6$.",
          "worked": "$$\\begin{align*}\\frac{x^2-4x-12}{x-6}&=\\frac{(x-6)(x+2)}{x-6}\\\\\\frac{x^2-4x-12}{x-6}&=x+2.\\end{align*}$$\nThe original denominator requires $x\\ne6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q29-root",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{x^2-7x+10}{x-5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2$, $x\\ne5$.",
          "worked": "$$\\begin{align*}\\frac{x^2-7x+10}{x-5}&=\\frac{(x-5)(x-2)}{x-5}\\\\\\frac{x^2-7x+10}{x-5}&=x-2.\\end{align*}$$\nThe original denominator requires $x\\ne5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q30-root",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{2x^2+7x+3}{2x+1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$, $x\\ne-\\frac12$.",
          "worked": "$$\\begin{align*}\\frac{2x^2+7x+3}{2x+1}&=\\frac{(2x+1)(x+3)}{2x+1}\\\\\\frac{2x^2+7x+3}{2x+1}&=x+3.\\end{align*}$$\nThe original denominator requires $x\\ne-\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q31-root",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{3x^2-5x-2}{x-2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+1$, $x\\ne2$.",
          "worked": "$$\\begin{align*}\\frac{3x^2-5x-2}{x-2}&=\\frac{(3x+1)(x-2)}{x-2}\\\\\\frac{3x^2-5x-2}{x-2}&=3x+1.\\end{align*}$$\nThe original denominator requires $x\\ne2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
