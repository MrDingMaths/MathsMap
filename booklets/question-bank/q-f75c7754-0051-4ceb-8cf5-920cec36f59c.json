  "content": {
    "id": "p22-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "If $x=\\dfrac{1}{2-\\sqrt3}$ and $y=2+\\sqrt3$, find, in simplest form:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4+2\\sqrt3$",
          "worked": "$$\\begin{align*}x&=\\frac{1}{2-\\sqrt3}\\times\\frac{2+\\sqrt3}{2+\\sqrt3}\\\\x&=\\frac{2+\\sqrt3}{4-3}\\\\x&=2+\\sqrt3\\\\x+y&=(2+\\sqrt3)+(2+\\sqrt3)\\\\x+y&=4+2\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p22-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$x-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}x&=\\frac{1}{2-\\sqrt3}\\times\\frac{2+\\sqrt3}{2+\\sqrt3}\\\\x&=\\frac{2+\\sqrt3}{4-3}\\\\x&=2+\\sqrt3\\\\x-y&=(2+\\sqrt3)-(2+\\sqrt3)\\\\x-y&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p22-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+4\\sqrt3$\n\nRationalise $x$, then expand the square.",
          "worked": "$$\\begin{align*}x&=\\frac{1}{2-\\sqrt3}\\times\\frac{2+\\sqrt3}{2+\\sqrt3}\\\\x&=\\frac{2+\\sqrt3}{4-3}\\\\x&=2+\\sqrt3\\\\xy&=(2+\\sqrt3)^2\\\\xy&=4+4\\sqrt3+3\\\\xy&=7+4\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p22-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}x&=\\frac{1}{2-\\sqrt3}\\times\\frac{2+\\sqrt3}{2+\\sqrt3}\\\\x&=\\frac{2+\\sqrt3}{4-3}\\\\x&=2+\\sqrt3\\\\\\frac{x}{y}&=\\frac{2+\\sqrt3}{2+\\sqrt3}\\\\\\frac{x}{y}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
