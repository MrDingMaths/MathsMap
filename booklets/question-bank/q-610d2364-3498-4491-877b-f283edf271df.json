    "children": [
      {
        "id": "p29-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$1-\\left(\\frac{1}{2}+\\frac{1}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}1-\\left(\\frac{1}{2}+\\frac{1}{4}\\right)&=1-\\left(\\frac{2}{4}+\\frac{1}{4}\\right)\\\\1-\\left(\\frac{1}{2}+\\frac{1}{4}\\right)&=\\frac{4}{4}-\\frac{3}{4}\\\\1-\\left(\\frac{1}{2}+\\frac{1}{4}\\right)&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p29-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}\\right)&=1-\\left(\\frac{4}{8}+\\frac{2}{8}+\\frac{1}{8}\\right)\\\\1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}\\right)&=\\frac{8}{8}-\\frac{7}{8}\\\\1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}\\right)&=\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p29-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{16}$",
          "worked": "$$\\begin{align*}1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}\\right)&=1-\\frac{8+4+2+1}{16}\\\\1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}\\right)&=\\frac{16}{16}-\\frac{15}{16}\\\\1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}\\right)&=\\frac{1}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p29-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}+\\frac{1}{32}+\\frac{1}{64}+\\frac{1}{128}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{128}$",
          "worked": "Using the common denominator 128, the sum inside the brackets is\n\n$$\\begin{align*}\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}+\\frac{1}{32}+\\frac{1}{64}+\\frac{1}{128}&=\\frac{64+32+16+8+4+2+1}{128}\\\\\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}+\\frac{1}{32}+\\frac{1}{64}+\\frac{1}{128}&=\\frac{127}{128}.\\end{align*}$$\n\nTherefore,\n\n$$\\begin{align*}1-\\frac{127}{128}&=\\frac{128}{128}-\\frac{127}{128}\\\\1-\\frac{127}{128}&=\\frac{1}{128}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p29-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The answer equals the smallest fraction in the brackets. As more terms of this pattern are included, their sum gets closer to 1.",
          "worked": "The answers are $\\frac{1}{4}$, $\\frac{1}{8}$, $\\frac{1}{16}$ and $\\frac{1}{128}$, each equal to the smallest fraction in its brackets. Each new term halves the amount still needed to reach 1, so the sum gets closer and closer to 1.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
