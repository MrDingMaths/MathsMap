        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{p+2q}{3r}&=\\frac{7+2\\times4}{3\\times2}\\\\\\frac{p+2q}{3r}&=\\frac{15}{6}\\\\\\frac{p+2q}{3r}&=\\frac{5}{2}\\\\\\frac{p+2q}{3r}&=2\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p3-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$p=7$, $q=-2$ and $r=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{p+2q}{3r}&=\\frac{7+2\\times(-2)}{3\\times2}\\\\\\frac{p+2q}{3r}&=\\frac{3}{6}\\\\\\frac{p+2q}{3r}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
