    "type": "question",
    "label": "7",
    "prompt": "A man now owes the bank $\\$47\\,000$, after taking out a loan $n$ years ago with an interest rate of $10\\%$ per annum. He borrowed $\\$26\\,530$. Find $n$, correct to the nearest year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n\\approx6$ years.",
      "worked": "$$\\begin{align*}A_n&=P(1+R)^n\\\\47\\,000&=26\\,530(1.1)^n\\\\\\frac{47\\,000}{26\\,530}&=(1.1)^n\\\\\\log_{10}\\left(\\frac{47\\,000}{26\\,530}\\right)&=n\\log_{10}(1.1)\\\\n&=\\frac{\\log_{10}(47\\,000/26\\,530)}{\\log_{10}(1.1)}\\\\n&\\approx6.000108642\\\\n&\\approx6\\text{ years}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
