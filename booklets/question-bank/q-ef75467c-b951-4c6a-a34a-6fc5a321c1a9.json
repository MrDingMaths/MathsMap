  "content": {
    "id": "p5-q19-root",
    "type": "question",
    "label": null,
    "prompt": "The quadrilateral $PQRS$ has vertices $P(1,0)$, $Q(3,1)$, $R(4,3)$ and $S(2,2)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $PQRS$ is a parallelogram.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{PQ}=m_{RS}=\\frac12$ and $m_{QR}=m_{PS}=2$. Both pairs of opposite sides are parallel.",
          "worked": "$$\\begin{align*}m_{PQ}&=\\frac{1-0}{3-1}=\\frac12\\\\m_{RS}&=\\frac{2-3}{2-4}=\\frac12\\\\m_{QR}&=\\frac{3-1}{4-3}=2\\\\m_{PS}&=\\frac{2-0}{2-1}=2\\end{align*}$$Thus $PQ\\parallel RS$ and $QR\\parallel PS$. Both pairs of opposite sides are parallel, so $PQRS$ is a parallelogram.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p5-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $PR$ is perpendicular to $QS$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{PR}=1$ and $m_{QS}=-1$, so $PR\\perp QS$.",
          "worked": "$$\\begin{align*}m_{PR}&=\\frac{3-0}{4-1}=1\\\\m_{QS}&=\\frac{2-1}{2-3}=-1\\\\m_{PR}m_{QS}&=-1\\end{align*}$$The product of the gradients is $-1$, so $PR\\perp QS$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, what type of quadrilateral does $PQRS$ form?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rhombus.",
          "worked": "A parallelogram with perpendicular diagonals is a rhombus. Therefore $PQRS$ is a rhombus.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
