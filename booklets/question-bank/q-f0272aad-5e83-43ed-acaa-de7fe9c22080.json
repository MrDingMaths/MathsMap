    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "The sum of the first two terms in a geometric sequence is 2. The sum of the next two terms is 18. Find the sum of the first three terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13}{2}$ or $-7$.",
          "worked": "Let the first term be $a$ and the common ratio be $r$.\n$$\\begin{align*}a(1+r)&=2\\\\ar^2(1+r)&=18\\\\r^2&=9\\\\r&=3\\text{ or }-3.\\end{align*}$$\nFor $r=3$:\n$$\\begin{align*}a&=\\frac{2}{1+3}=\\frac12\\\\S_3&=\\frac12(1+3+9)=\\frac{13}{2}.\\end{align*}$$\nFor $r=-3$:\n$$\\begin{align*}a&=\\frac{2}{1-3}=-1\\\\S_3&=-(1-3+9)=-7.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p17-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "The sum of the first three terms in a geometric sequence is 3. The sum of the next three is 24. Find the sum of the first two terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac97$.",
          "worked": "Let the first term be $a$ and the common ratio be $r$.\n$$\\begin{align*}a(1+r+r^2)&=3\\\\ar^3(1+r+r^2)&=24\\\\r^3&=8\\\\r&=2\\\\a&=\\frac{3}{1+2+4}=\\frac37\\\\S_2&=\\frac37(1+2)=\\frac97.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "The sum of the first three terms in a geometric sequence is 3. The sum of the next three terms is 81. Find the sum of the first two terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{12}{13}$.",
          "worked": "Let the first term be $a$ and the common ratio be $r$.\n$$\\begin{align*}a(1+r+r^2)&=3\\\\ar^3(1+r+r^2)&=81\\\\r^3&=27\\\\r&=3\\\\a&=\\frac{3}{1+3+9}=\\frac{3}{13}\\\\S_2&=\\frac{3}{13}(1+3)=\\frac{12}{13}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q2-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p17-q2-d-stem",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "The sum of the first two terms in a geometric sequence is 8. The sum of the first four is 80. Find the first term. Hint:",
                  "marks": []
                }
              ]
            },
            {
              "id": "p17-q2-d-hint",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "r^4-1=(r^2-1)(r^2+1).",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-4$ or $a=2$.",
          "worked": "Let the first term be $a$ and the common ratio be $r$. Using the finite geometric-series formula and the supplied factorisation,\n$$\\begin{align*}\\frac{S_4}{S_2}&=\\frac{a(r^4-1)/(r-1)}{a(r^2-1)/(r-1)}\\\\\\frac{S_4}{S_2}&=r^2+1\\\\10&=r^2+1\\\\r^2&=9\\\\r&=3\\text{ or }-3.\\end{align*}$$\nSince $S_2=a(1+r)=8$:\n$$\\begin{align*}a&=\\frac{8}{1+3}=2\\quad(r=3)\\\\a&=\\frac{8}{1-3}=-4\\quad(r=-3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p17-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "The sum of the first three terms in a geometric sequence is 2. The sum of the first six terms is 18. Find the first term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac27$.",
          "worked": "Let the first term be $a$ and the common ratio be $r$. The next three terms have sum $r^3S_3$.\n$$\\begin{align*}S_6&=S_3+r^3S_3\\\\18&=2(1+r^3)\\\\r^3&=8\\\\r&=2\\\\a(1+2+4)&=2\\\\a&=\\frac27.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p17-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "The sum of the first four terms in a geometric sequence is 1. The sum of the first eight terms is 17. Find the first term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-\\dfrac15$ or $a=\\dfrac1{15}$.",
          "worked": "Let the first term be $a$ and the common ratio be $r$. The next four terms have sum $r^4S_4$.\n$$\\begin{align*}S_8&=S_4+r^4S_4\\\\17&=1+r^4\\\\r^4&=16\\\\r&=2\\text{ or }-2.\\end{align*}$$\nFor $r=2$:\n$$\\begin{align*}a(1+2+4+8)&=1\\\\a&=\\frac1{15}.\\end{align*}$$\nFor $r=-2$:\n$$\\begin{align*}a(1-2+4-8)&=1\\\\a&=-\\frac15.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
