  "content": {
    "id": "p18-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Given that $m=-1$, $n=2$ and $p=-6$, evaluate:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$m+n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}m+n&=-1+2\\\\m+n&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
