          "worked": "$$\\begin{align*}m+p&=-1+(-6)\\\\m+p&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$m-p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
