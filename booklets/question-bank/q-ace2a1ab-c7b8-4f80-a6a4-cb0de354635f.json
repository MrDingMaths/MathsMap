          "worked": "$$\\begin{align*}mp&=(-1)\\times(-6)\\\\mp&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q1-e",
        "type": "part",
