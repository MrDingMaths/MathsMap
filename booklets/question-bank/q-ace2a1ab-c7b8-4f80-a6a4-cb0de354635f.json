          "short": "$5$",
          "worked": "$$\\begin{align*}m-p&=-1-(-6)\\\\m-p&=-1+6\\\\m-p&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p18-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$mp$",
