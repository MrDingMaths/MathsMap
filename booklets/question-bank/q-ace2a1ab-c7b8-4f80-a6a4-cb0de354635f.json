          "short": "$-12$",
          "worked": "$$\\begin{align*}np&=2\\times(-6)\\\\np&=-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{p}{m}$",
