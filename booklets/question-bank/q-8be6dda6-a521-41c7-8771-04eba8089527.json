  "content": {
    "id": "p22-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A ribbon is cut so that the lengths of the parts are in the ratio $8:5$. If the shorter piece is $15\\text{ cm}$ in length, what was the length of the original ribbon?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$39\\text{ cm}$",
      "worked": "The shorter piece represents $5$ parts.\n$$\\begin{align*}\\text{Length of one part}&=15\\div5=3\\text{ cm}\\\\\\text{Total number of parts}&=8+5=13\\\\\\text{Original ribbon length}&=13\\times3=39\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
