        "children": [],
        "answer": {
          "short": "$9-z=6$, $z=3$.",
          "worked": "$$\\begin{align*}9-z&=6\\\\9-z+z&=6+z\\\\9&=6+z\\\\9-6&=6+z-6\\\\3&=z\\end{align*}$$\n\nThe number is 3.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p7-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "A number $z$ is multiplied by 3 and the result is 5.",
