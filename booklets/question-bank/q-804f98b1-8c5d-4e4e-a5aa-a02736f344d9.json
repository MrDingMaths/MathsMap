        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z-6=14$, $z=20$.",
          "worked": "$$\\begin{align*}z-6&=14\\\\z-6+6&=14+6\\\\z&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "A number $z$ is taken away from 9 and the result is 6.",
