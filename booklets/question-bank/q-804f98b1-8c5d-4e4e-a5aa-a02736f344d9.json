      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A number $z$ has 7 added to it and the result is 12.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z+7=12$, $z=5$.",
          "worked": "$$\\begin{align*}z+7&=12\\\\z+7-7&=12-7\\\\z&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Twelve is added to a number $z$ to give 19.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z+12=19$, $z=7$.",
          "worked": "$$\\begin{align*}z+12&=19\\\\z+12-12&=19-12\\\\z&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Six is subtracted from a number $z$ and the result is 14.",
