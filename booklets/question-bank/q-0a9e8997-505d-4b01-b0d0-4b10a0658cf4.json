    "children": [
      {
        "id": "p10-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "An amount is increased by $25\\%$. What percentage decrease would restore this to the original amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\%$ decrease.",
          "worked": "Take the original amount as $100$.\n$$\\begin{align*}\\text{Increased amount}&=1.25\\times100=125\\\\\\text{Percentage decrease}&=\\frac{125-100}{125}\\times100\\%\\\\\\text{Percentage decrease}&=20\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "An amount is increased by $60\\%$. What percentage decrease would restore this to the original amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$37.5\\%$ decrease.",
          "worked": "Take the original amount as $100$.\n$$\\begin{align*}\\text{Increased amount}&=1.6\\times100=160\\\\\\text{Percentage decrease}&=\\frac{160-100}{160}\\times100\\%\\\\\\text{Percentage decrease}&=37.5\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "An amount is increased by $28\\%$. What percentage decrease would restore this to the original amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21.875\\%$ decrease.",
          "worked": "Take the original amount as $100$.\n$$\\begin{align*}\\text{Increased amount}&=1.28\\times100=128\\\\\\text{Percentage decrease}&=\\frac{128-100}{128}\\times100\\%\\\\\\text{Percentage decrease}&=21.875\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "An amount is decreased by $20\\%$. What percentage increase would restore this to the original amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$ increase.",
          "worked": "Take the original amount as $100$.\n$$\\begin{align*}\\text{Decreased amount}&=0.8\\times100=80\\\\\\text{Percentage increase}&=\\frac{100-80}{80}\\times100\\%\\\\\\text{Percentage increase}&=25\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "An amount is decreased by $36\\%$. What percentage increase would restore this to the original amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56.25\\%$ increase.",
          "worked": "Take the original amount as $100$.\n$$\\begin{align*}\\text{Decreased amount}&=0.64\\times100=64\\\\\\text{Percentage increase}&=\\frac{100-64}{64}\\times100\\%\\\\\\text{Percentage increase}&=56.25\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
