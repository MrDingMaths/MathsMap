            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"regionBlue\",\"hex\":\"D4E8FF\",\"reason\":\"Identifies the requested region and excluded upper semicircular cutout\"}],\"reference\":\"source page 20 p20-q3-d-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{regionBlue}{HTML}{D4E8FF}\n\\fill[regionBlue] (10,0) arc[start angle=0,end angle=180,radius=5]--cycle;\n\\fill[regionBlue] (4,0) arc[start angle=180,end angle=360,radius=3]--cycle;\n\\fill[white] (4,0) arc[start angle=0,end angle=180,radius=2]--cycle;\n\\draw (0,0) arc[start angle=180,end angle=0,radius=5] arc[start angle=0,end angle=-180,radius=3] arc[start angle=0,end angle=180,radius=2];\n\\draw[line width=0.4pt] (0,0)--(10,0);\n\\path (0,0)--(4,0) node[midway,below] {$4\\,\\mathrm{m}$};\n\\path (4,0)--(10,0) node[midway,below] {$6\\,\\mathrm{m}$};\n\\end{tikzpicture}",
