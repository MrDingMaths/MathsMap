        "columns": null,
        "questionDiagrams": [
          {
            "id": "p20-q3-a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 20 p20-q3-a-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw (0,0)--(4,0)--(4,2) arc[start angle=0,end angle=180,radius=2]--cycle;\n\\draw[dashed,line width=0.4pt] (0,2)--(4,2);\n\\path (0,0)--(4,0) node[midway,below] {$4\\,\\mathrm{cm}$};\n\\path (4,0)--(4,2) node[midway,right] {$2\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 45,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 20,
              "sourceRegion": "Question 3(a)",
              "description": "A 4 cm by 2 cm rectangle topped by a semicircle; dashed common diameter.",
              "mathematics": "Semicircle diameter 4 cm; rectangle height 2 cm.",
              "answerVisibility": "Givens only; no answer."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$(8+2\\pi)\\,\\mathrm{cm}^2$",
          "worked": "$$\\begin{align*}r&=4\\div2=2\\,\\mathrm{cm}\\\\A&=4(2)+\\frac12\\pi(2)^2\\\\A&=(8+2\\pi)\\,\\mathrm{cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28,
        "responseSpace": "scaffold"
      },
      {
        "id": "p20-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p20-q3-b-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"regionBlue\",\"hex\":\"D4E8FF\",\"reason\":\"Identifies the requested composite region and excluded semicircular cutout\"}],\"reference\":\"source page 20 p20-q3-b-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{regionBlue}{HTML}{D4E8FF}\n\\fill[regionBlue] (0,0)--(6,0) arc[start angle=0,end angle=-180,radius=3]--cycle;\n\\fill[regionBlue] (0,0) rectangle (6,3);\n\\fill[white] (0,3) arc[start angle=180,end angle=360,radius=3]--cycle;\n\\draw (0,3) arc[start angle=180,end angle=360,radius=3];\n\\draw (0,3)--(0,0) arc[start angle=180,end angle=360,radius=3]--(6,3);\n\\draw[dashed,line width=0.4pt] (0,3)--(6,3) (0,0)--(6,0);\n\\path (0,3)--(6,3) node[midway,above] {$6\\,\\mathrm{m}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 37.8,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 20,
              "sourceRegion": "Question 3(b)",
              "description": "Rectangle with an upper semicircular cutout touching its lower dashed edge and a congruent outward lower semicircle. Dashed upper diameter is labelled 6 m.",
              "mathematics": "Both semicircles have radius 3 m. Rectangle height equals that radius.",
              "answerVisibility": "No inferred height or answer is printed."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$18\\,\\mathrm{m}^2$\n\nThe congruent semicircles cancel, leaving the rectangle's area.",
          "worked": "The cutout and the lower semicircle are congruent, so their areas cancel. The rectangle's height is the cutout's radius.\n$$\\begin{align*}r&=6\\div2=3\\,\\mathrm{m}\\\\A&=6(3)+\\frac12\\pi(3)^2-\\frac12\\pi(3)^2\\\\A&=18\\,\\mathrm{m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60,
        "responseSpace": "scaffold"
      },
