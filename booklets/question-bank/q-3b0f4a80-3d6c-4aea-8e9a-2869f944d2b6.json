  "content": {
    "id": "p14-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A square has side length $2+5\\sqrt{3}$.\n\nFind:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "the perimeter of the square",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8+20\\sqrt{3}$ units",
          "worked": "$$\\begin{align*}P&=4s\\\\P&=4(2+5\\sqrt{3})\\\\P&=8+20\\sqrt{3}\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "the area of the square",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$79+20\\sqrt{3}$ square units",
          "worked": "$$\\begin{align*}A&=s^2\\\\A&=(2+5\\sqrt{3})(2+5\\sqrt{3})\\\\A&=4+10\\sqrt{3}+10\\sqrt{3}+25\\times3\\\\A&=4+20\\sqrt{3}+75\\\\A&=79+20\\sqrt{3}\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
