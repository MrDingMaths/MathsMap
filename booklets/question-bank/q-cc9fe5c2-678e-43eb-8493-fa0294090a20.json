        "answer": {
          "short": "$x=15$. Use $\\dfrac{x}{5}=\\dfrac{x+3}{x-9}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "42d5d70d-95e0-4df4-ac47-667e21715add-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Corresponding sides give",
                    "marks": []
                  }
                ]
              },
              {
                "id": "42d5d70d-95e0-4df4-ac47-667e21715add-compact-1",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\n\\frac{x}{5}&=\\frac{x+3}{x-9}\\\\\nx(x-9)&=5(x+3)\\\\\nx^2-9x&=5x+15\\\\\nx^2-14x-15&=0\\\\\n(x-15)(x+1)&=0\\\\\nx&=15\\text{ or }-1.\n\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "42d5d70d-95e0-4df4-ac47-667e21715add-compact-2",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x-9>0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x>9",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". Hence ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=15",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
