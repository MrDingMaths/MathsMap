      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand and simplify $(n+1)^2-n^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2n+1$",
          "worked": "$$\\begin{align*}(n+1)^2-n^2&=(n+1)(n+1)-n^2\\\\(n+1)^2-n^2&=n(n+1)+(n+1)-n^2\\\\(n+1)^2-n^2&=n^2+n+n+1-n^2\\\\(n+1)^2-n^2&=2n+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Using your answer, write the number 51 as the difference of two square numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$51=26^2-25^2$.\n\nSet $2n+1=51$ to find the smaller number.",
          "worked": "From part a, consecutive squares differ by $2n+1$.\n\n$$\\begin{align*}2n+1&=51\\\\2n&=50\\\\n&=25\\\\51&=(25+1)^2-25^2\\\\51&=26^2-25^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
