  "content": {
    "id": "p18-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "Find the approximate value of the area of the annulus formed by a circle of radius $10\\text{ cm}$ and a circle of radius $4\\text{ cm}$. Use $\\pi\\approx\\dfrac{22}{7}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$264\\text{ cm}^2$",
      "worked": "Subtract the smaller circle's area from the larger circle's area.\n$$\\begin{align*}A&=\\pi\\times10^2-\\pi\\times4^2\\\\A&=100\\pi-16\\pi\\\\A&=84\\pi\\\\A&\\approx84\\times\\frac{22}{7}\\\\A&\\approx264\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
