  "content": {
    "id": "equations-r6-backfill-5-root",
    "type": "question",
    "label": null,
    "prompt": "Write $\\frac{4x+1}{x-3}$ in the form $a+\\frac{b}{x-3}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4+\\frac{13}{x-3}$",
      "worked": "$$\\begin{align*}\\frac{4x+1}{x-3}&=a+\\frac{b}{x-3}\\\\4x+1&=a(x-3)+b\\\\4x+1&=ax-3a+b\\end{align*}$$\nEquate coefficients and constant terms.\n$$\\begin{align*}a&=4\\\\-3a+b&=1\\\\-12+b&=1\\\\b&=13\\end{align*}$$\nHence $\\frac{4x+1}{x-3}=4+\\frac{13}{x-3}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
