    "label": "6",
    "prompt": "Rationalise the denominator and simplify:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-surds-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2\\sqrt{27}}{\\sqrt{18}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt6$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{27}}{\\sqrt{18}}&=\\frac{2\\sqrt{27}\\sqrt{18}}{18}\\\\\\frac{2\\sqrt{27}}{\\sqrt{18}}&=\\frac{2\\times9\\sqrt6}{18}\\\\\\frac{2\\sqrt{27}}{\\sqrt{18}}&=\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p3-surds-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2\\sqrt3+3\\sqrt2}{\\sqrt6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt2+\\sqrt3$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt3+3\\sqrt2}{\\sqrt6}&=\\frac{2\\sqrt{18}+3\\sqrt{12}}6\\\\\\frac{2\\sqrt3+3\\sqrt2}{\\sqrt6}&=\\frac{6\\sqrt2+6\\sqrt3}6\\\\\\frac{2\\sqrt3+3\\sqrt2}{\\sqrt6}&=\\sqrt2+\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p3-surds-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{\\sqrt3+5}{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3+5\\sqrt3}{3}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt3+5}{\\sqrt3}&=\\frac{(\\sqrt3+5)\\sqrt3}{3}\\\\\\frac{\\sqrt3+5}{\\sqrt3}&=\\frac{3+5\\sqrt3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p3-surds-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3\\sqrt5-1}{\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15-\\sqrt5}{5}$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt5-1}{\\sqrt5}&=\\frac{(3\\sqrt5-1)\\sqrt5}{5}\\\\\\frac{3\\sqrt5-1}{\\sqrt5}&=\\frac{15-\\sqrt5}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p3-surds-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{5\\sqrt{12}+2\\sqrt{10}}{\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{15}+2\\sqrt2$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt{12}+2\\sqrt{10}}{\\sqrt5}&=\\frac{5\\sqrt{60}+2\\sqrt{50}}5\\\\\\frac{5\\sqrt{12}+2\\sqrt{10}}{\\sqrt5}&=\\frac{10\\sqrt{15}+10\\sqrt2}5\\\\\\frac{5\\sqrt{12}+2\\sqrt{10}}{\\sqrt5}&=2\\sqrt{15}+2\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p3-surds-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2\\sqrt6-\\sqrt3}{3\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2\\sqrt2-1}{3}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt6-\\sqrt3}{3\\sqrt3}&=\\frac{2\\sqrt{18}-3}{9}\\\\\\frac{2\\sqrt6-\\sqrt3}{3\\sqrt3}&=\\frac{6\\sqrt2-3}{9}\\\\\\frac{2\\sqrt6-\\sqrt3}{3\\sqrt3}&=\\frac{2\\sqrt2-1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
