    "children": [
      {
        "id": "p4-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the average rate of change of $V$ during the first minute.\nRemember to have units in your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\text{ L/min}$.",
          "worked": "$$\\begin{aligned}V(0)&=0^2-4(0)+4=4\\\\V(1)&=1^2-4(1)+4=1\\\\\\text{Average rate of change}&=\\frac{V(1)-V(0)}{1-0}\\\\&=\\frac{1-4}{1}=-3\\text{ L/min}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the average rate of change of $V$ over the first two minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\text{ L/min}$.",
          "worked": "$$\\begin{aligned}V(0)&=4\\\\V(2)&=2^2-4(2)+4=0\\\\\\text{Average rate of change}&=\\frac{V(2)-V(0)}{2-0}\\\\&=\\frac{0-4}{2}=-2\\text{ L/min}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why the model is only valid for $t\\in[0,2]$.\nWhat happens to a leaky bucket eventually?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The bucket is empty at $t=2$ minutes. After that it stays empty, whereas the model predicts increasing volume.",
          "worked": "$$V(2)=2^2-4(2)+4=0.$$ The bucket is empty after two minutes. For $t>2$, the model $V(t)=(t-2)^2$ predicts increasing volume, which cannot describe the bucket continuing to leak. Negative times are outside the situation being modelled.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
