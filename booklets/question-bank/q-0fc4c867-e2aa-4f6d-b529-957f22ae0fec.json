  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the natural domain of each function.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=7-3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real $x$.",
          "worked": "The expression $7-3x$ is defined for every real value of $x$. Hence the natural domain is all real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{3}{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne\\dfrac12$.",
          "worked": "The denominator cannot be zero.\n\n$$\\begin{align*}2x-1&\\ne0\\\\2x&\\ne1\\\\x&\\ne\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sqrt{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge-4$.",
          "worked": "The expression under the square root must be non-negative.\n\n$$\\begin{align*}x+4&\\ge0\\\\x&\\ge-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\sqrt{4-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le2$.",
          "worked": "The expression under the square root must be non-negative.\n\n$$\\begin{align*}4-2x&\\ge0\\\\-2x&\\ge-4\\\\x&\\le2\\end{align*}$$\n\nDividing by $-2$ reverses the inequality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\dfrac{2}{\\sqrt{1-x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<1$.",
          "worked": "The square root must be defined and the denominator must be non-zero, so its radicand must be positive.\n\n$$\\begin{align*}1-x&>0\\\\-x&>-1\\\\x&<1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\dfrac{1}{\\sqrt{2x-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\dfrac32$.",
          "worked": "The square root must be defined and the denominator must be non-zero, so its radicand must be positive.\n\n$$\\begin{align*}2x-3&>0\\\\2x&>3\\\\x&>\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
