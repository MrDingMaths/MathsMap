    "id": "p34-challenge-q2-root",
    "type": "question",
    "label": null,
    "prompt": "Find the value of $x$ if $a^x=\\dfrac{\\sqrt{a^8}}{(\\sqrt{a^6})^4}$, where $a>0$ and $a\\ne1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-8$\n\nConvert the radicals to powers of $a$ and equate indices.",
      "worked": "$$\\begin{align*}a^x&=\\frac{(a^8)^{1/2}}{((a^6)^{1/2})^4}\\\\a^x&=\\frac{a^4}{(a^3)^4}\\\\a^x&=a^{4-12}\\\\a^x&=a^{-8}\\\\x&=-8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
