    "type": "question",
    "label": "8",
    "prompt": "The sum of a number and its square is 42. Find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-7$ or $6$",
      "worked": "Let $x$ be the number.\n\n$$\\begin{align*}x+x^2&=42\\\\x^2+x-42&=0\\\\(x+7)(x-6)&=0\\\\x&=-7\\text{ or }6\\end{align*}$$\n\nBoth numbers satisfy the stated relationship.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
