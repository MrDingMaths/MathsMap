  "content": {
    "id": "p5-q14-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f:[0,4)\\to\\mathbb{R}$ where $f(x)=x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the graph of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The segment of $y=x$ from a closed point at $(0,0)$ to an open point at $(4,4)$.",
          "worked": "Sketch $y=x$ for $0\\le x<4$. Include $(0,0)$ with a closed point and exclude $(4,4)$ with an open point.",
          "solutionDiagrams": [
            {
              "id": "p5-q14-a-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"functionBlue\",\"hex\":\"268CFF\",\"reason\":\"function graph distinguished from axes\"}],\"reference\":\"source page 5 question 14; teacher page 31 printed question 13\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.8cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{functionBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-1.6,-1.2) rectangle (5.2,5.1);\n\\draw[->,black,line width=0.5pt] (-1,0)--(4.8,0) node[right] {$x$};\n\\draw[->,black,line width=0.5pt] (0,-1)--(0,4.8) node[above] {$y$};\n\\draw[functionBlue,line width=0.8pt] (0,0)--(4,4);\n\\fill[functionBlue] (0,0) circle[radius=2pt];\n\\draw[functionBlue,fill=white,line width=0.8pt] (4,4) circle[radius=2pt];\n\\node[below left,black] at (0,0) {$(0,0)$};\n\\node[above,black] at (4,4) {$(4,4)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 55,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 5,
                "sourceRegion": "Question 14(a); matching answer figure on teacher PDF page 31",
                "description": "Increasing line segment with a closed lower endpoint and open upper endpoint; axes and endpoint coordinates, without a grid or numeric ticks.",
                "mathematics": "y=x for 0≤x<4; (0,0) included and (4,4) excluded.",
                "answerVisibility": "Solution only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p5-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the domain and range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{dom}(f)=[0,4)$, $\\operatorname{ran}(f)=[0,4)$.",
          "worked": "The specified inputs satisfy $0\\le x<4$. Since $f(x)=x$, the outputs satisfy the same bounds.\n$$\\begin{align*}\\operatorname{dom}(f)&=[0,4)\\\\\\operatorname{ran}(f)&=[0,4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Does this function have a maximum value?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. The outputs approach $4$, but $4$ is excluded.",
          "worked": "No. The range is $[0,4)$, so $4$ is not attained. For every output below $4$, there is a larger output still below $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
