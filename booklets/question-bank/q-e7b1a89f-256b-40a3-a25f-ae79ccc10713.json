  "content": {
    "id": "v2-p48-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "A radioactive sample loses 15% of its mass every day under a continuous exponential decay model. If 80 g is present at the start, after how long will less than 10 g remain?\nAnswer to the nearest hour.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "307 hours (12 days 19 hours)",
      "worked": "Let $d\\geq0$ be the elapsed time in days.\n$$\\begin{align*}80(0.85)^d &< 10\\\\(0.85)^d &< \\frac18\\\\d &> \\log_{0.85}\\left(\\frac18\\right)\\end{align*}$$\nTaking logarithms to base $0.85$ reverses the inequality because $0<0.85<1$. The threshold in hours is\n$$24\\log_{0.85}\\left(\\frac18\\right)\\approx307.08.$$\nTo the nearest hour, this is 307 hours, or 12 days 19 hours.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
