  "content": {
    "id": "p57-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Calculate the percentage change and state whether it is a profit or loss.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "\\$20 becomes \\$36",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "80% profit",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=36-20\\\\&=16\\\\\\text{Percentage change}&=\\frac{16}{20}\\times100\\\\&=80\\%\\end{align*}$$\nThe change is positive: 80% profit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p57-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "\\$10 becomes \\$13",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "30% profit",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=13-10\\\\&=3\\\\\\text{Percentage change}&=\\frac{3}{10}\\times100\\\\&=30\\%\\end{align*}$$\nThe change is positive: 30% profit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p57-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "\\$40 becomes \\$30",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "25% loss",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=30-40\\\\&=-10\\\\\\text{Percentage change}&=\\frac{-10}{40}\\times100\\\\&=-25\\%\\end{align*}$$\nThe change is negative: 25% loss.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p57-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "\\$25 becomes \\$21",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "16% loss",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=21-25\\\\&=-4\\\\\\text{Percentage change}&=\\frac{-4}{25}\\times100\\\\&=-16\\%\\end{align*}$$\nThe change is negative: 16% loss.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
