  "content": {
    "id": "p45-q8-response",
    "type": "question",
    "label": "8",
    "prompt": "There are 4 green and 7 pink counters in a bag. Two are picked at random.\nCounters are not replaced after each pick. What is the probability of picking at least one pink?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{49}{55}$",
      "worked": "The complement of at least one pink is two green counters.\n$$\\begin{align*}P(GG)&=\\frac{4}{11}\\times\\frac{3}{10}\\\\P(\\text{at least one pink})&=1-P(GG)\\\\&=1-\\frac{12}{110}\\\\&=\\frac{49}{55}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
