  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find a quadratic equation with integer coefficients for which:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\sqrt3$ is a solution",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-3=0$",
          "worked": "$$\\begin{align*}x^2&=3\\\\x^2-3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=3\\sqrt5$ is a solution",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-45=0$",
          "worked": "$$\\begin{align*}x^2&=(3\\sqrt5)^2\\\\x^2&=45\\\\x^2-45&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=2+\\sqrt3$ is a solution",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-4x+1=0$",
          "worked": "$$\\begin{align*}x-2&=\\sqrt3\\\\(x-2)^2&=3\\\\x^2-4x+4&=3\\\\x^2-4x+1&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=\\dfrac{1+\\sqrt2}3$ is a solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-6x-1=0$",
          "worked": "$$\\begin{align*}3x&=1+\\sqrt2\\\\3x-1&=\\sqrt2\\\\(3x-1)^2&=2\\\\9x^2-6x+1&=2\\\\9x^2-6x-1&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
