  "content": {
    "id": "p37-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the stationary point on the curve $y=x^2-2x+1$ and determine its nature.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(1,0)$, minimum turning point.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x-2\\\\2x-2&=0\\\\x&=1\\\\y&=1^2-2(1)+1\\\\y&=0\\\\\\frac{d^2y}{dx^2}&=2>0\\end{align*}$$\nTherefore, $(1,0)$ is a minimum turning point.",
      "solutionDiagrams": []
    },
