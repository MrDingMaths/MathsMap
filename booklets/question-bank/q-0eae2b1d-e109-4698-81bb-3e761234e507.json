  "content": {
    "id": "p8-circles-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the circumferences of the two circles specified below. In each case give the answer (i) in terms of $\\pi$, (ii) approximately using $\\pi\\approx\\frac{22}{7}$, and (iii) approximately using $\\pi\\approx3.14$. Give approximate answers to 2 decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-circles-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Diameter $8\\text{ mm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "(i) $8\\pi\\text{ mm}$; (ii) $25.14\\text{ mm}$; (iii) $25.12\\text{ mm}$.",
          "worked": "$C=\\pi d=8\\pi\\text{ mm}$. Using $\\pi\\approx\\frac{22}{7}$ gives $\\frac{176}{7}\\approx25.14\\text{ mm}$; using $3.14$ gives $8(3.14)=25.12\\text{ mm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p8-circles-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Radius $3\\text{ m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "(i) $6\\pi\\text{ m}$; (ii) $18.86\\text{ m}$; (iii) $18.84\\text{ m}$.",
          "worked": "$C=2\\pi r=6\\pi\\text{ m}$. Using $\\pi\\approx\\frac{22}{7}$ gives $\\frac{132}{7}\\approx18.86\\text{ m}$; using $3.14$ gives $6(3.14)=18.84\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
