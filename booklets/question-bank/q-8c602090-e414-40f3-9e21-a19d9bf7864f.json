  "content": {
    "id": "v2-723f9-p39-practice-slot-26-root",
    "type": "question",
    "label": null,
    "prompt": "A cafe group made a profit of \\$312 000 for the year. The owners decided to share 35% of the profit between their 42 staff as a bonus. Calculate the bonus paid to each staff member.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$2600 each; divide 35% of the profit by 42.",
      "worked": "$$\\begin{align*}\\text{Total bonuses} &= 312\\,000\\times0.35 = \\$109\\,200\\\\\\text{Bonus per staff member} &= 109\\,200\\div42 = \\$2600\\end{align*}$$",
      "solutionDiagrams": []
    },
