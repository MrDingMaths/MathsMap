        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 8 question 3 shared graph\"}\n\\begin{tikzpicture}[x=0.72cm,y=0.72cm,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-4.7,-3.8) rectangle (3.1,4.4);\n\\draw[black,->,line width=0.5pt] (-4.5,0)--(3,0) node[below] {$x$};\n\\draw[black,->,line width=0.5pt] (0,-3.6)--(0,4.2) node[left] {$y$};\n\\draw[black,<->,line width=0.8pt] (-4.2,-3.2)--(2.6,3.6);\n\\draw[black,dashed,line width=0.4pt] (-3,0)--(-3,-2);\n\\draw[black,dashed,line width=0.4pt] (2,0)--(2,3);\n\\foreach \\v in {-3,-1,2}{\\draw[black,line width=0.4pt] (\\v,-0.08)--(\\v,0.08);}\n\\node[above] at (-3,0.08) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-3$\\special{dvisvgm:raw </g>}};\n\\node[above] at (-1,0.08) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[below] at (2,-0.08) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 63.1,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 8,
          "sourceRegion": "Question 3 shared graph",
          "description": "Unshaded line with arrowheads at both ends, positive-end axis arrows, labelled x-axis ticks and dashed boundary guides. No grid or origin label.",
