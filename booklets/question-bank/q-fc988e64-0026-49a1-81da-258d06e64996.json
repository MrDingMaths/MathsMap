    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Shade the region between the line $y=x+1$ and the $x$-axis from $x=-3$ to $x=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Shade both regions between the line and the $x$-axis: below the axis for $-3\\le x\\le-1$ and above it for $-1\\le x\\le2$.",
          "worked": "The line crosses the $x$-axis at $x=-1$. Shade between the line and the axis on both sides of this intercept, bounded by $x=-3$ and $x=2$.",
          "solutionDiagrams": [
            {
              "id": "p8-q3-a-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"regionBlue\",\"hex\":\"D4E8FF\",\"reason\":\"requested regions between the line and x-axis\"}],\"reference\":\"source page 8 question 3a solution\"}\n\\begin{tikzpicture}[x=0.72cm,y=0.72cm,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{regionBlue}{HTML}{D4E8FF}\n\\path[use as bounding box] (-4.7,-3.8) rectangle (3.1,4.4);\n\\fill[regionBlue] (-3,0)--(-3,-2)--(-1,0)--cycle;\n\\fill[regionBlue] (-1,0)--(2,3)--(2,0)--cycle;\n\\draw[black,->,line width=0.5pt] (-4.5,0)--(3,0) node[below] {$x$};\n\\draw[black,->,line width=0.5pt] (0,-3.6)--(0,4.2) node[left] {$y$};\n\\draw[black,<->,line width=0.8pt] (-4.2,-3.2)--(2.6,3.6);\n\\draw[black,dashed,line width=0.4pt] (-3,0)--(-3,-2);\n\\draw[black,dashed,line width=0.4pt] (2,0)--(2,3);\n\\foreach \\v in {-3,-1,2}{\\draw[black,line width=0.4pt] (\\v,-0.08)--(\\v,0.08);}\n\\node[above] at (-3,0.08) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-3$\\special{dvisvgm:raw </g>}};\n\\node[above] at (-1,0.08) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[below] at (2,-0.08) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 70,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 8,
                "sourceRegion": "Question 3a",
                "description": "Complete solution graph with both requested triangular regions shaded in house light blue.",
                "mathematics": "Shade the region between y=x+1 and y=0 on [-3,-1] and [-1,2].",
                "answerVisibility": "Solution only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "By evaluating $\\displaystyle\\int_{-1}^{2}(x+1)\\,dx$, find the area of the shaded region above the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9}{2}\\text{ units}^2$.",
          "worked": "$$\\begin{align*}A_{\\text{above}}&=\\int_{-1}^{2}(x+1)\\,dx\\\\&=\\left[\\frac{x^2}{2}+x\\right]_{-1}^{2}\\\\&=(2+2)-\\left(\\frac12-1\\right)\\\\&=\\frac92\\text{ units}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "By evaluating $\\displaystyle\\int_{-3}^{-1}(x+1)\\,dx$, find the area of the shaded region below the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\text{ units}^2$.",
          "worked": "$$\\begin{align*}I&=\\int_{-3}^{-1}(x+1)\\,dx\\\\&=\\left[\\frac{x^2}{2}+x\\right]_{-3}^{-1}\\\\&=\\left(\\frac12-1\\right)-\\left(\\frac92-3\\right)\\\\&=-2.\\end{align*}$$\nThe region is below the $x$-axis, so its area is $|-2|=2\\text{ units}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p8-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find the area of the entire shaded region.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13}{2}\\text{ units}^2$.",
          "worked": "$$\\begin{align*}A_{\\text{total}}&=\\frac92+2\\\\&=\\frac{13}{2}\\text{ units}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Find $\\displaystyle\\int_{-3}^{2}(x+1)\\,dx$, and explain why this integral does not give the area of the shaded region.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac52$. The integral gives the area above the $x$-axis minus the area below it, rather than the total area.",
          "worked": "$$\\begin{align*}\\int_{-3}^{2}(x+1)\\,dx&=\\left[\\frac{x^2}{2}+x\\right]_{-3}^{2}\\\\&=(2+2)-\\left(\\frac92-3\\right)\\\\&=\\frac52.\\end{align*}$$\nThe region below the $x$-axis contributes negatively. Thus the integral gives $\\frac92-2=\\frac52$, whereas the total area is $\\frac92+2=\\frac{13}{2}\\text{ units}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
