        "answer": {
          "short": "$(x^3-1)^5+C$",
          "worked": "Using the derivative from part a,\n$$\\begin{aligned}\\int15x^2(x^3-1)^4\\,dx&=(x^3-1)^5+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
