  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Given that $\\log_2 3\\approx1.58$, find the approximate value of each expression to 2 decimal places:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.16$",
          "worked": "$$\\begin{align*}\\log_2 9&=2\\log_2 3\\\\\\log_2 9&\\approx2(1.58)\\\\\\log_2 9&\\approx3.16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.58$",
          "worked": "$$\\begin{align*}\\log_2 6&=\\log_2 2+\\log_2 3\\\\\\log_2 6&=1+\\log_2 3\\\\\\log_2 6&\\approx1+1.58\\\\\\log_2 6&\\approx2.58\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2 12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.58$",
          "worked": "$$\\begin{align*}\\log_2 12&=\\log_2 4+\\log_2 3\\\\\\log_2 12&=2+\\log_2 3\\\\\\log_2 12&\\approx2+1.58\\\\\\log_2 12&\\approx3.58\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_2 1.5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.58$",
          "worked": "$$\\begin{align*}\\log_2 1.5&=\\log_2 3-\\log_2 2\\\\\\log_2 1.5&=\\log_2 3-1\\\\\\log_2 1.5&\\approx1.58-1\\\\\\log_2 1.5&\\approx0.58\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_2 4.5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.16$",
          "worked": "$$\\begin{align*}\\log_2 4.5&=\\log_2 9-\\log_2 2\\\\\\log_2 4.5&=2\\log_2 3-1\\\\\\log_2 4.5&\\approx2(1.58)-1\\\\\\log_2 4.5&\\approx2.16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_2\\sqrt{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.79$",
          "worked": "$$\\begin{align*}\\log_2\\sqrt{12}&=\\frac12\\log_2 12\\\\\\log_2\\sqrt{12}&=\\frac12(2+\\log_2 3)\\\\\\log_2\\sqrt{12}&\\approx\\frac12(2+1.58)\\\\\\log_2\\sqrt{12}&\\approx1.79\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
