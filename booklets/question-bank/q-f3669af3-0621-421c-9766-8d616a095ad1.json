  "content": {
    "id": "p14-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A car travels 20 km from Cranung to Doville. It travels $d$ km at 60 km/h and the remainder at 80 km/h.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "How far does the car travel at 80 km/h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(20-d)$ km.",
          "worked": "$$\\begin{align*}\\text{Distance at 80 km/h}&=20-d\\end{align*}$$\nThe car travels $(20-d)$ km at 80 km/h.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p14-q8-b",
        "type": "group",
        "label": "b",
        "prompt": "For how long, in terms of $d$, does the car travel at:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q8-b-i",
            "type": "part",
            "label": "i",
            "prompt": "60 km/h?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{d}{60}$ h.",
              "worked": "A speed of 60 km/h means 60 km in 1 hour. Therefore 1 km takes $\\frac{1}{60}$ hour, and $d$ km takes $\\frac{d}{60}$ hour.\n$$\\begin{align*}\\text{Time at 60 km/h}&=\\frac{d}{60}\\text{ h}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p14-q8-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "80 km/h?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{20-d}{80}$ h.",
              "worked": "The remaining distance is $(20-d)$ km. A speed of 80 km/h means 80 km in 1 hour, so each kilometre takes $\\frac{1}{80}$ hour.\n$$\\begin{align*}\\text{Time at 80 km/h}&=\\frac{20-d}{80}\\text{ h}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p14-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the total time for the journey, in terms of $d$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d+60}{240}$ h.\n\nAdd the times for the two stages using a common denominator.",
          "worked": "$$\\begin{align*}\\text{Total time}&=\\frac{d}{60}+\\frac{20-d}{80}\\\\\\text{Total time}&=\\frac{4d}{240}+\\frac{3(20-d)}{240}\\\\\\text{Total time}&=\\frac{4d+60-3d}{240}\\\\\\text{Total time}&=\\frac{d+60}{240}\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p14-q8-d",
        "type": "group",
        "label": "d",
        "prompt": "Find the total time taken, in minutes, if:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q8-d-i",
            "type": "part",
            "label": "i",
            "prompt": "$d=6$ km",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$16\\dfrac12$ min.",
              "worked": "Since 1 hour equals 60 minutes, multiply the time in hours by 60 to obtain minutes.\n$$\\begin{align*}\\text{Total time}&=\\frac{6+60}{240}\\times60\\text{ min}\\\\\\text{Total time}&=\\frac{66}{4}\\text{ min}\\\\\\text{Total time}&=16\\frac12\\text{ min}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p14-q8-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$d=12$ km",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$18$ min.",
              "worked": "$$\\begin{align*}\\text{Total time}&=\\frac{12+60}{240}\\times60\\text{ min}\\\\\\text{Total time}&=\\frac{72}{4}\\text{ min}\\\\\\text{Total time}&=18\\text{ min}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p14-q8-d-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$d=20$ km",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$20$ min.",
              "worked": "$$\\begin{align*}\\text{Total time}&=\\frac{20+60}{240}\\times60\\text{ min}\\\\\\text{Total time}&=\\frac{80}{4}\\text{ min}\\\\\\text{Total time}&=20\\text{ min}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      }
    ]
  },
