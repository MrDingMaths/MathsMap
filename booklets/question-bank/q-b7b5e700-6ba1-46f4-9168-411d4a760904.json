  "content": {
    "id": "p14-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find $y$ as a function of $x$ if $\\dfrac{dy}{dx}=\\sqrt{x}$ and:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=1$ when $x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2x^{3/2}}{3}+1$",
          "worked": "$\\begin{aligned}\\frac{dy}{dx}&=x^{1/2}\\\\y&=\\frac{2x^{3/2}}{3}+C\\\\1&=\\frac{2(0)^{3/2}}{3}+C\\\\C&=1\\\\y&=\\frac{2x^{3/2}}{3}+1\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2$ when $x=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2x^{3/2}}{3}-16$",
          "worked": "$\\begin{aligned}\\frac{dy}{dx}&=x^{1/2}\\\\y&=\\frac{2x^{3/2}}{3}+C\\\\2&=\\frac{2(9)^{3/2}}{3}+C\\\\2&=18+C\\\\C&=-16\\\\y&=\\frac{2x^{3/2}}{3}-16\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
