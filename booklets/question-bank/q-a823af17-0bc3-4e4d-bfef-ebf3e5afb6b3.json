  "content": {
    "id": "p13-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Show that $\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}=|\\underset{\\sim}{v}|^2$ where:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{v}=3\\mathbf{i}-4\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\underset{\\sim}{v}|^2=25=\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}$.",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{v}|^2&=3^2+(-4)^2\\\\&=9+16=25\\end{aligned}$$\n\n$$\\begin{aligned}\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}&=3(3)+(-4)(-4)\\\\&=9+16=25\\end{aligned}$$\n\nHence $\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}=|\\underset{\\sim}{v}|^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{v}=a\\mathbf{i}+b\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\underset{\\sim}{v}|^2=a^2+b^2=\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}$.",
          "worked": "$$|\\underset{\\sim}{v}|^2=a^2+b^2$$\n\n$$\\begin{aligned}\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}&=a(a)+b(b)\\\\&=a^2+b^2\\end{aligned}$$\n\nHence $\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}=|\\underset{\\sim}{v}|^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
