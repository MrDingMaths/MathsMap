  "content": {
    "id": "p11-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "There are thirty-two students in a class and there are 40% fewer girls than boys. How many boys are in the class?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "20 boys.",
      "worked": "Let $x$ be the number of boys. The number of girls is $0.6x$.\n\n$$\\begin{align*}x+0.6x&=32\\\\1.6x&=32\\\\16x&=320\\\\x&=\\frac{320}{16}\\\\x&=20\\end{align*}$$\n\nThere are 20 boys in the class.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
