  "content": {
    "id": "p9-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "A picnic table has two sides and each side has four seats. Bob, Mary and five of their friends come to sit down at the picnic table. Find the number of possible ways to seat the seven people if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8!=40\\,320$",
          "worked": "Treat the empty seat as an eighth distinct item.\n\n$$\\begin{align*}N&=8!\\\\N&=40\\,320.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Bob sits directly opposite Mary.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p9-q22-b-short-result",
                "type": "paragraph",
                "fontSize": null,
