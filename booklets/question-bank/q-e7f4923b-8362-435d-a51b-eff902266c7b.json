  "content": {
    "id": "index-t7-q31-root",
    "type": "question",
    "label": null,
    "prompt": "Evaluate without a calculator.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t7-q31-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left( 2^{4} \\right)^{8} \\div 2^{30}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4",
          "worked": "$$\\begin{align*}(2^4)^8\\div2^{30}&=2^{32-30} \\\\ &=2^2=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q31-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left( 10^{3} \\right)^{7} \\div 10^{18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1000",
          "worked": "$$\\begin{align*}(10^3)^7\\div10^{18}&=10^{21-18} \\\\ &=10^3=1000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q31-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left( 7^{4} \\right)^{9} \\div 7^{36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1",
          "worked": "$$\\begin{align*}(7^4)^9\\div7^{36}&=7^{36-36} \\\\ &=7^0=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q31-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left( ( - 1)^{11} \\right)^{2} \\div \\left( ( - 1)^{2} \\right)^{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1",
          "worked": "$$\\begin{align*}((-1)^{11})^2\\div((-1)^2)^{11}&=(-1)^{22}\\div(-1)^{22} \\\\ &=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q31-e",
        "type": "part",
        "label": "e",
        "prompt": "$- 2\\left( ( - 2)^{3} \\right)^{3} \\div ( - 2)^{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4",
          "worked": "$$\\begin{align*}-2((-2)^3)^3\\div(-2)^8&=-2\\times(-2)^{9-8} \\\\ &=(-2)\\times(-2)=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q31-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{\\left( 5^{2} \\right)^{3}}{\\left( 8^{4} \\right)^{7}} \\times \\frac{\\left( 8^{7} \\right)^{4}}{\\left( 5^{3} \\right)^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1",
          "worked": "$$\\begin{align*}\n\\frac{\\left( 5^{2} \\right)^{3}}{\\left( 8^{4} \\right)^{7}} \\times \\frac{\\left( 8^{7} \\right)^{4}}{\\left( 5^{3} \\right)^{2}} &= \\frac{5^{6}\\times8^{28}}{8^{28}\\times5^{6}} \\\\\n&= 1\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
