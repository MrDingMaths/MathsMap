  "content": {
    "id": "p34-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Complete each of the following operations in the given base:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$1010_2+1011_2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10101_2$",
          "worked": "Add from right to left, carrying whenever a column total reaches $2$.\n$$\\begin{array}{r}1010_2\\\\+\\,1011_2\\\\\\hline10101_2\\end{array}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p34-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$101001_2+110111_2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1100000_2$",
          "worked": "Add from right to left, carrying whenever a column total reaches $2$.\n$$\\begin{array}{r}101001_2\\\\+\\,110111_2\\\\\\hline1100000_2\\end{array}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p34-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$2020_3+2021_3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11111_3$",
          "worked": "Add from right to left. A column total of $4$ is $11_3$: write $1$ and carry $1$.\n$$\\begin{array}{r}2020_3\\\\+\\,2021_3\\\\\\hline11111_3\\end{array}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p34-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$21044_5+1314_5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22413_5$",
          "worked": "Align equal place values. In the units column, $4+4=8=13_5$, so write $3$ and carry $1$. The next column totals $6=11_5$, so write $1$ and carry $1$.\n$$\\begin{array}{r}21044_5\\\\+\\,01314_5\\\\\\hline22413_5\\end{array}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p34-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$1111_2-1001_2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$110_2$",
          "worked": "Subtract corresponding digits; no borrowing is needed.\n$$\\begin{array}{r}1111_2\\\\-\\,1001_2\\\\\\hline0110_2\\end{array}$$\nOmit the leading zero: $110_2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p34-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$2221_3-1012_3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1202_3$",
          "worked": "Borrow one group of $3$ into the units column: $1+3-2=2$. The next column becomes $1-1=0$.\n$$\\begin{array}{r}2221_3\\\\-\\,1012_3\\\\\\hline1202_3\\end{array}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p34-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$32112_4-22123_4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3323_4$",
          "worked": "Each borrowed unit supplies $4$ units in the next column. From right to left, the column differences are $2+4-3=3$, $0+4-2=2$, $0+4-1=3$, $1+4-2=3$, and $2-2=0$.\n$$\\begin{array}{r}32112_4\\\\-\\,22123_4\\\\\\hline03323_4\\end{array}$$\nOmit the leading zero: $3323_4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      },
      {
        "id": "p34-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$2387_9-1238_9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1148_9$",
          "worked": "Borrow one group of $9$ into the units column: $7+9-8=8$. The next column becomes $7-3=4$.\n$$\\begin{array}{r}2387_9\\\\-\\,1238_9\\\\\\hline1148_9\\end{array}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
