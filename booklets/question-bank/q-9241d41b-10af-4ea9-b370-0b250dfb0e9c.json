  "content": {
    "id": "p16-q26-root",
    "type": "question",
    "label": "26",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p16-q26-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "At the International Mathematical Olympiad (IMO) the thresholds for awarding medals to participants are decided using the following as a rough guide.",
              "marks": []
            }
          ]
        },
        {
          "id": "p16-q26-givens",
          "type": "list",
          "ordered": false,
          "start": 1,
          "indent": 7,
          "items": [
            {
              "id": "p16-q26-given-silver",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p16-q26-silver-text",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 1,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "The number of silver medals awarded is twice the number of gold medals awarded.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "p16-q26-given-bronze",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p16-q26-bronze-text",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 1,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "The number of bronze medals awarded is three times the number of gold medals awarded.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "p16-q26-given-no-medal",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p16-q26-no-medal-text",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 1,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "The total number of students awarded a medal is equal to the number of students who do not receive a medal.",
                      "marks": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the ratio gold : silver : bronze : no medal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p16-q26-a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "1:2:3:6",
                    "display": false
                  }
                ]
              },
              {
                "id": "p16-q26-a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Medal recipients account for 1 + 2 + 3 = 6 parts, so those receiving no medal also account for 6 parts.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Taking gold as 1 part gives silver as 2 parts and bronze as 3 parts.\n\n$$\\begin{align*}\\text{Medal parts}&=1+2+3\\\\\\text{Medal parts}&=6\\\\\\text{No-medal parts}&=6\\end{align*}$$\n\nTherefore gold : silver : bronze : no medal is $1:2:3:6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p16-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "If 600 people participate in the IMO, then determine how many people receive each of the awards.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p16-q26-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "50 gold, 100 silver, 150 bronze; 300 receive no medal.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p16-q26-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "There are 12 parts altogether, so each part represents 600 ÷ 12 = 50 people.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\text{Total parts}&=1+2+3+6\\\\\\text{Total parts}&=12\\\\\\text{People per part}&=600\\div12\\\\\\text{People per part}&=50\\\\\\text{Gold recipients}&=1\\times50=50\\\\\\text{Silver recipients}&=2\\times50=100\\\\\\text{Bronze recipients}&=3\\times50=150\\\\\\text{People receiving no medal}&=6\\times50=300\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
