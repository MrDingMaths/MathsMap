  "content": {
    "id": "p4-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Show that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$3<\\sqrt{10}<4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^2=9<10<16=4^2$.",
          "worked": "$3^2=9$ and $4^2=16$. Since $9<10<16$, taking positive square roots gives $3<\\sqrt{10}<4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$11<\\sqrt{130}<12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11^2=121<130<144=12^2$.",
          "worked": "$11^2=121$ and $12^2=144$. Since $121<130<144$, taking positive square roots gives $11<\\sqrt{130}<12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{4}{3}<\\sqrt{2}<\\frac{3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac43\\right)^2=\\frac{16}{9}<2<\\frac94=\\left(\\frac32\\right)^2$.",
          "worked": "$\\left(\\frac43\\right)^2=\\frac{16}{9}<\\frac{18}{9}=2$ and $\\left(\\frac32\\right)^2=\\frac94>\\frac84=2$.\nTaking positive square roots gives $\\frac43<\\sqrt2<\\frac32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5}{3}<\\sqrt{3}<\\frac{7}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac53\\right)^2=\\frac{25}{9}<3<\\frac{49}{16}=\\left(\\frac74\\right)^2$.",
          "worked": "$\\left(\\frac53\\right)^2=\\frac{25}{9}<\\frac{27}{9}=3$ and $\\left(\\frac74\\right)^2=\\frac{49}{16}>\\frac{48}{16}=3$.\nTaking positive square roots gives $\\frac53<\\sqrt3<\\frac74$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$2<\\sqrt[3]{10}<3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^3=8<10<27=3^3$.",
          "worked": "$2^3=8$ and $3^3=27$. Since $8<10<27$, taking cube roots gives $2<\\sqrt[3]{10}<3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$1.2<\\sqrt{1.5}<1.3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.2^2=1.44<1.5<1.69=1.3^2$.",
          "worked": "$1.2^2=1.44$ and $1.3^2=1.69$. Since $1.44<1.5<1.69$, taking positive square roots gives $1.2<\\sqrt{1.5}<1.3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
