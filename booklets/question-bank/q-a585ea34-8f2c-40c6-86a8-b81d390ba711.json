        "answer": {
          "short": "$-5x^{-\\frac12}$",
          "worked": "$$\\begin{align*}-\\frac{5}{\\sqrt{x}}&=-\\frac{5}{x^{1/2}}\\\\-\\frac{5}{\\sqrt{x}}&=-5x^{-1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{15}{\\sqrt[3]{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15x^{-\\frac13}$",
          "worked": "$$\\begin{align*}\\frac{15}{\\sqrt[3]{x}}&=\\frac{15}{x^{1/3}}\\\\\\frac{15}{\\sqrt[3]{x}}&=15x^{-1/3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$-\\frac{4}{\\sqrt[3]{x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4x^{-\\frac23}$",
          "worked": "$$\\begin{align*}-\\frac{4}{\\sqrt[3]{x^2}}&=-\\frac{4}{x^{2/3}}\\\\-\\frac{4}{\\sqrt[3]{x^2}}&=-4x^{-2/3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$x\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac32}$",
          "worked": "$$\\begin{align*}x\\sqrt{x}&=x^1x^{1/2}\\\\x\\sqrt{x}&=x^{1+1/2}\\\\x\\sqrt{x}&=x^{3/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
