        "answer": {
          "short": "$5x^{-\\frac32}$",
          "worked": "$$\\begin{align*}\\frac{5}{x\\sqrt{x}}&=\\frac{5}{x^1x^{1/2}}\\\\\\frac{5}{x\\sqrt{x}}&=\\frac{5}{x^{3/2}}\\\\\\frac{5}{x\\sqrt{x}}&=5x^{-3/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
