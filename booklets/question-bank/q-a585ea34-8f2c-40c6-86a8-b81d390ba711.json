        "prompt": "$\\frac{12}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x^{-\\frac12}$",
          "worked": "$$\\begin{align*}\\frac{12}{\\sqrt{x}}&=\\frac{12}{x^{1/2}}\\\\\\frac{12}{\\sqrt{x}}&=12x^{-1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$-\\frac{5}{\\sqrt{x}}$",
        "layout": "list",
