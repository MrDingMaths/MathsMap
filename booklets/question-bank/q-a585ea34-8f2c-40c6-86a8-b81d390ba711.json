        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{-\\frac12}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{x}}&=\\frac{1}{x^{1/2}}\\\\\\frac{1}{\\sqrt{x}}&=x^{-1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
