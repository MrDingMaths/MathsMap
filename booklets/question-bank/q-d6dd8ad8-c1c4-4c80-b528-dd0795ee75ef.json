  "content": {
    "id": "p7-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "If $y=a\\times10^{bx}$, express $x$ in terms of the other pronumerals.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac{1}{b}\\log_{10}\\left(\\frac{y}{a}\\right)$\n\nIsolate the power of 10, then convert to logarithmic form.",
      "worked": "$$\\begin{align*}\\frac{y}{a}&=10^{bx}\\\\\\log_{10}\\left(\\frac{y}{a}\\right)&=bx\\\\x&=\\frac{1}{b}\\log_{10}\\left(\\frac{y}{a}\\right)\\end{align*}$$",
      "solutionDiagrams": []
    },
