  "content": {
    "id": "p21-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The line $y=2x$ is tangent to the curve $y=ax^2+bx+c$ at the origin, and there is a maximum turning point at $x=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $c=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The curve passes through the origin, so its $y$-intercept is $0$.",
          "worked": "At the origin, $x=0$ and $y=0$. Substituting into $y=ax^2+bx+c$ gives $0=c$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p21-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why $b=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The tangent gradient at the origin is $2$, so $y'(0)=b=2$.",
          "worked": "$$\\begin{align*}y'&=2ax+b\\\\y'(0)&=b.\\end{align*}$$\nThe tangent $y=2x$ has gradient $2$, so $b=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $2a+b=0$ and hence find the value of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'(1)=2a+b=0$, so $a=-1$.",
          "worked": "The gradient at the turning point is $0$.\n$$\\begin{align*}y'(1)&=2a+b=0\\\\2a+2&=0\\\\2a&=-2\\\\a&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
