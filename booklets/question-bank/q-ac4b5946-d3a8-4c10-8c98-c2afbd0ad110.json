      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "A car travelling at a constant speed travels 130 km in 2 hours. How far will it travel in 3 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "195 km",
          "worked": "In 1 hour, the car travels $130\\div2=65$ km.\n\nIn 3 hours, the car travels $65\\times3=195$ km.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "A truck travels 55 km on 10 L of petrol. How far will it travel on 36 L?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "198 km",
          "worked": "On 1 L, the truck travels $55\\div10=5.5$ km.\n\nOn 36 L, the truck travels $5.5\\times36=198$ km.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "If 100 US dollars ($\\text{US}\\$100$) is worth 180 Australian dollars ($\\text{A}\\$180$), how much is $\\text{US}\\$40$ worth in Australian dollars?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{A}\\$72$",
          "worked": "$\\text{US}\\$1$ is worth $\\text{A}\\$(180\\div100)=\\text{A}\\$1.80$.\n\n$\\text{US}\\$40$ is worth $\\text{A}\\$(1.80\\times40)=\\text{A}\\$72$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "A watch loses 3 minutes every 6 months. How much time will it lose in 8 months?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 minutes",
          "worked": "In 1 month, the watch loses $3\\div6=\\frac12$ minute.\n\nIn 8 months, the watch loses $\\frac12\\times8=4$ minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "A car travels 80 km on 12 L of petrol. How far could it travel on 300 L of petrol?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2000 km",
          "worked": "On 1 L, the car travels $\\frac{80}{12}=\\frac{20}{3}$ km.\n\nOn 300 L, the car travels $\\frac{20}{3}\\times300=2000$ km.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
