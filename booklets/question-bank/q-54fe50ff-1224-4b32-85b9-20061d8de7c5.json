  "content": {
    "id": "p11-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Expand each of the following by finding the difference of two squares:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x-y)(x+y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-y^2$",
          "worked": "$$\\begin{align*}(x-y)(x+y)&=x^2-y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(a+3)(a-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-9$",
          "worked": "$$\\begin{align*}(a+3)(a-3)&=a^2-3^2\\\\(a+3)(a-3)&=a^2-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3a-b)(3a+b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9a^2-b^2$",
          "worked": "$$\\begin{align*}(3a-b)(3a+b)&=(3a)^2-b^2\\\\(3a-b)(3a+b)&=9a^2-b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(m+5n)(m-5n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^2-25n^2$",
          "worked": "$$\\begin{align*}(m+5n)(m-5n)&=m^2-(5n)^2\\\\(m+5n)(m-5n)&=m^2-25n^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2a-7b)(2a+7b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2-49b^2$",
          "worked": "$$\\begin{align*}(2a-7b)(2a+7b)&=(2a)^2-(7b)^2\\\\(2a-7b)(2a+7b)&=4a^2-49b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x^2-y)(x^2+y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-y^2$",
          "worked": "$$\\begin{align*}(x^2-y)(x^2+y)&=(x^2)^2-y^2\\\\(x^2-y)(x^2+y)&=x^4-y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(3x-y^2)(3x+y^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-y^4$",
          "worked": "$$\\begin{align*}(3x-y^2)(3x+y^2)&=(3x)^2-(y^2)^2\\\\(3x-y^2)(3x+y^2)&=9x^2-y^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$(3m^2-2y^2)(3m^2+2y^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9m^4-4y^4$",
          "worked": "$$\\begin{align*}(3m^2-2y^2)(3m^2+2y^2)&=(3m^2)^2-(2y^2)^2\\\\(3m^2-2y^2)(3m^2+2y^2)&=9m^4-4y^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$(\\sqrt3-2)(\\sqrt3+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}(\\sqrt3-2)(\\sqrt3+2)&=(\\sqrt3)^2-2^2\\\\(\\sqrt3-2)(\\sqrt3+2)&=3-4\\\\(\\sqrt3-2)(\\sqrt3+2)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$(\\sqrt5-\\sqrt2)(\\sqrt5+\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}(\\sqrt5-\\sqrt2)(\\sqrt5+\\sqrt2)&=(\\sqrt5)^2-(\\sqrt2)^2\\\\(\\sqrt5-\\sqrt2)(\\sqrt5+\\sqrt2)&=5-2\\\\(\\sqrt5-\\sqrt2)(\\sqrt5+\\sqrt2)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$(2\\sqrt3+1)(2\\sqrt3-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$",
          "worked": "$$\\begin{align*}(2\\sqrt3+1)(2\\sqrt3-1)&=(2\\sqrt3)^2-1^2\\\\(2\\sqrt3+1)(2\\sqrt3-1)&=12-1\\\\(2\\sqrt3+1)(2\\sqrt3-1)&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$(3\\sqrt2-2\\sqrt5)(3\\sqrt2+2\\sqrt5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}(3\\sqrt2-2\\sqrt5)(3\\sqrt2+2\\sqrt5)&=(3\\sqrt2)^2-(2\\sqrt5)^2\\\\(3\\sqrt2-2\\sqrt5)(3\\sqrt2+2\\sqrt5)&=18-20\\\\(3\\sqrt2-2\\sqrt5)(3\\sqrt2+2\\sqrt5)&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
