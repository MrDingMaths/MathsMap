  "content": {
    "id": "p40-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{\\frac{1}{x+1}+\\frac{1}{x-1}}{\\frac{1}{x+1}-\\frac{1}{x-1}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x$",
          "worked": "Multiply every term in the main numerator and denominator by $(x+1)(x-1)$.\n$$\\begin{aligned}\\frac{\\frac{1}{x+1}+\\frac{1}{x-1}}{\\frac{1}{x+1}-\\frac{1}{x-1}}&=\\frac{(x-1)+(x+1)}{(x-1)-(x+1)}\\\\&=\\frac{2x}{-2}\\\\&=-x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p40-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{\\frac{1}{x+2}+\\frac{1}{x-2}}{\\frac{2}{x^2-4}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$",
          "worked": "Since $x^2-4=(x+2)(x-2)$, multiply every term in the main numerator and denominator by $(x+2)(x-2)$.\n$$\\begin{aligned}\\frac{\\frac{1}{x+2}+\\frac{1}{x-2}}{\\frac{2}{x^2-4}}&=\\frac{(x-2)+(x+2)}{2}\\\\&=\\frac{2x}{2}\\\\&=x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p40-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{1-\\frac{1}{x^2}}{1+\\frac{1}{x}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-1}{x}$",
          "worked": "Multiply every term in the main numerator and denominator by $x^2$.\n$$\\begin{aligned}\\frac{1-\\frac{1}{x^2}}{1+\\frac{1}{x}}&=\\frac{x^2-1}{x^2+x}\\\\&=\\frac{(x-1)(x+1)}{x(x+1)}\\\\&=\\frac{x-1}{x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p40-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{1+\\frac{1}{x}}{1-\\frac{1}{x^2}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{x-1}$",
          "worked": "Multiply every term in the main numerator and denominator by $x^2$.\n$$\\begin{aligned}\\frac{1+\\frac{1}{x}}{1-\\frac{1}{x^2}}&=\\frac{x^2+x}{x^2-1}\\\\&=\\frac{x(x+1)}{(x-1)(x+1)}\\\\&=\\frac{x}{x-1}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
