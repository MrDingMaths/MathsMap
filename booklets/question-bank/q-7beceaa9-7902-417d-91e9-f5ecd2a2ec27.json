  "content": {
    "id": "p39-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A grocery store is increasing all prices by $8\\%$. A tub of ice-cream used to cost $\\$8.50$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the mark-up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$0.68$",
          "worked": "$$\\begin{align*}\\text{Mark-up} &= 0.08\\times\\$8.50\\\\\\text{Mark-up} &= \\$0.68\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p39-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the selling price.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$9.18$",
          "worked": "$$\\begin{align*}\\text{Selling-price percentage} &= 100\\%+8\\%=108\\%\\\\\\text{Selling price} &= 1.08\\times\\$8.50\\\\\\text{Selling price} &= \\$9.18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
