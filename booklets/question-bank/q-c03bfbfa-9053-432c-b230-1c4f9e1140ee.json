  "content": {
    "id": "p8-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find $f'(x)$ using first principles, and hence find the gradient of the tangent to each of the following when $x=2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x,\\quad m=4$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{(x+h)^2-x^2}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2xh+h^2}{h}\\\\f'(x)&=\\lim_{h\\to0}(2x+h)\\\\f'(x)&=2x\\\\m&=f'(2)=2(2)=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-2x,\\quad m=-4$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{2-(x+h)^2-(2-x^2)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{-2xh-h^2}{h}\\\\f'(x)&=\\lim_{h\\to0}(-2x-h)\\\\f'(x)&=-2x\\\\m&=f'(2)=-2(2)=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p8-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^2-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x-2,\\quad m=2$",
          "worked": "$$\\begin{align*}f(x+h)&=(x+h)^2-2(x+h)\\\\f(x+h)-f(x)&=2xh+h^2-2h\\\\f'(x)&=\\lim_{h\\to0}\\frac{2xh+h^2-2h}{h}\\\\f'(x)&=\\lim_{h\\to0}(2x+h-2)\\\\f'(x)&=2x-2\\\\m&=f'(2)=2(2)-2=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p8-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=3x^2+x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=6x+1,\\quad m=13$",
          "worked": "$$\\begin{align*}f(x+h)&=3(x+h)^2+(x+h)+1\\\\f(x+h)-f(x)&=6xh+3h^2+h\\\\f'(x)&=\\lim_{h\\to0}\\frac{6xh+3h^2+h}{h}\\\\f'(x)&=\\lim_{h\\to0}(6x+3h+1)\\\\f'(x)&=6x+1\\\\m&=f'(2)=6(2)+1=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
