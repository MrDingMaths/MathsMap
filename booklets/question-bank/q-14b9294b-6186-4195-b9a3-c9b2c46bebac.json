        "id": "p23-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$10\\%$ of $800$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80$",
          "worked": "$$\\begin{align*}10\\%\\text{ of }800 &= 800\\div10\\\\&=80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\%$ of $800$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$",
          "worked": "$$\\begin{align*}5\\%\\text{ of }800 &= (10\\%\\text{ of }800)\\div2\\\\&=80\\div2\\\\&=40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$20\\%$ of $800$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$160$",
          "worked": "$$\\begin{align*}20\\%\\text{ of }800 &= 2\\times(10\\%\\text{ of }800)\\\\&=2\\times80\\\\&=160\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$15\\%$ of $800$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "$$\\begin{align*}15\\%\\text{ of }800 &= (10\\%\\text{ of }800)+(5\\%\\text{ of }800)\\\\&=80+40\\\\&=120\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$35\\%$ of $800$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$280$",
          "worked": "$$\\begin{align*}30\\%\\text{ of }800 &= 3\\times80\\\\&=240\\\\35\\%\\text{ of }800 &= 240+40\\\\&=280\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q6-explanation",
        "type": "part",
        "label": "f",
        "prompt": "Describe a simpler way of finding $95\\%$ of $800$. (Hint: how could you use $5\\%$?)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Find $5\\%$ of $800$, then subtract it from $800$: $800-40=760$.",
          "worked": "Since $95\\%=100\\%-5\\%$, subtract $5\\%$ of $800$ from the whole amount.\n$$\\begin{align*}95\\%\\text{ of }800 &= 800-40\\\\&=760\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
