  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Sandra has some money. If she earned another $\\$27$, she would have four times as much money. How much money does Sandra have?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$9$.",
      "worked": "Let Sandra have $x$ dollars.\n$$\\begin{align*}x+27&=4x\\\\27&=3x\\\\9&=x\\end{align*}$$\nSandra has $\\$9$.",
