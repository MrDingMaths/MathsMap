    "type": "question",
    "label": "10",
    "prompt": "A cyclist travels to and from work over a 1200-metre long bridge. Calculate the distance travelled in a week if the cyclist works for 5 days. Answer in kilometres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\text{ km}$",
      "worked": "$$\\begin{align*}\\text{Daily distance}&=2\\times1200\\text{ m}=2400\\text{ m}\\\\\\text{Weekly distance}&=5\\times2400\\text{ m}=12\\,000\\text{ m}\\\\\\text{Weekly distance in km}&=12\\,000\\div1000=12\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
