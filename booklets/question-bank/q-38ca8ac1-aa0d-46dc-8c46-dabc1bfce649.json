  "content": {
    "id": "p22-q71-response",
    "type": "question",
    "label": "23",
    "prompt": "Given $a=\\sqrt3+\\sqrt2$, find the value of $a-\\dfrac1a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\sqrt2$",
      "worked": "$$\\begin{align*}\\frac1a&=\\frac1{\\sqrt3+\\sqrt2}\\\\\\frac1a&=\\frac{\\sqrt3-\\sqrt2}{3-2}\\\\\\frac1a&=\\sqrt3-\\sqrt2\\\\a-\\frac1a&=(\\sqrt3+\\sqrt2)-(\\sqrt3-\\sqrt2)\\\\a-\\frac1a&=2\\sqrt2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
