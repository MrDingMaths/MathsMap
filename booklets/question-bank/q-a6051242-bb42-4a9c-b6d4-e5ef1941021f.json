  "content": {
    "id": "p41-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "In this question, give all approximations correct to four decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area between the curve $y=e^x$ and the $x$-axis, for $0\\le x\\le1$, by evaluating an appropriate integral. Then approximate the result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e-1\\approx1.7183\\text{ units}^2$",
          "worked": "$$\\begin{align*}A&=\\int_0^1e^x\\,dx\\\\&=[e^x]_0^1\\\\&=e-1\\\\&\\approx1.7183\\text{ units}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p41-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Estimate the area using the trapezoidal rule with two subintervals (that is, with three function values).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.7539\\text{ units}^2$",
          "worked": "$h=0.5$, $f(0)=1$, $f(0.5)=e^{0.5}$ and $f(1)=e$.\n$$\\begin{align*}A&\\approx\\frac{h}{2}[f(0)+2f(0.5)+f(1)]\\\\&=\\frac{0.5}{2}(1+2e^{0.5}+e)\\\\&\\approx1.7539\\text{ units}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p41-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "Is the trapezoidal-rule approximation greater than or less than the exact value? Give a geometric explanation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Greater: the curve is concave up, so the chords lie above it.",
          "worked": "The approximation is greater than the exact value. Since $y''=e^x>0$, the curve is concave up. The chords forming the tops of the trapezia lie above the curve, so the trapezia overestimate its area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
