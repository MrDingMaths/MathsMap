  "content": {
    "id": "v2-82bc9-p35-practice-j3-224300-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $f(x)=\\sqrt{x-2}+\\dfrac{1}{x-5}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-82bc9-p35-practice-j3-224300-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "State the condition on $x$ for $\\sqrt{x-2}$ to be defined.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge2$",
          "worked": "The radicand must be non-negative.\n$$\\begin{align*}x-2&\\ge0\\\\x&\\ge2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-82bc9-p35-practice-j3-224300-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "State the condition on $x$ for $\\dfrac{1}{x-5}$ to be defined.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne5$",
          "worked": "The denominator must be non-zero.\n$$\\begin{align*}x-5&\\ne0\\\\x&\\ne5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-82bc9-p35-practice-j3-224300-j3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence state the natural domain of $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge2$ and $x\\ne5$",
          "worked": "Both conditions must hold.\nDomain: $x\\ge2$ with $x\\ne5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
