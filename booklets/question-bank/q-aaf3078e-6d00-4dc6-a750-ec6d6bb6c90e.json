  "content": {
    "id": "p7-q10",
    "type": "question",
    "label": "10",
    "prompt": "Find the coordinates of point $P$ that divides $A(-2,-3)$ and $B(4,0)$ in the ratio $3:2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P\\left(\\frac{8}{5},-\\frac{6}{5}\\right)$\n\nMove three fifths of each coordinate difference from A towards B.",
      "worked": "$P$ is three fifths of the distance from $A$ to $B$.\n$$\\begin{align*}x_P &= -2+\\frac{3}{5}\\bigl(4-(-2)\\bigr)\\\\x_P &= \\frac{8}{5}\\\\y_P &= -3+\\frac{3}{5}\\bigl(0-(-3)\\bigr)\\\\y_P &= -\\frac{6}{5}\\end{align*}$$\n$P\\left(\\frac{8}{5},-\\frac{6}{5}\\right)$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 49
  },
