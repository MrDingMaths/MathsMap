    "children": [
      {
        "id": "v2-2f0902af-p30-topic-slot-6-slot-6-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $x\\ln x$. Hence find $\\displaystyle\\int_1^e\\ln x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(x\\ln x)=\\ln x+1$, and $\\displaystyle\\int_1^e\\ln x\\,dx=1$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(x\\ln x)&=\\ln x+x\\cdot\\frac1x\\\\&=\\ln x+1\\end{align*}$$\nSo $\\ln x=\\dfrac{d}{dx}(x\\ln x)-1$ and $\\displaystyle\\int\\ln x\\,dx=x\\ln x-x$.\n$$\\begin{align*}\\int_1^e\\ln x\\,dx&=\\left[x\\ln x-x\\right]_1^e\\\\&=(e-e)-(0-1)\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-2f0902af-p30-topic-slot-6-slot-6-b",
        "type": "part",
        "label": "b",
        "prompt": "Differentiate $x\\ln 2x$. Hence find the area under the curve $y=\\ln 2x$ from $x=\\frac12$ to $x=\\frac e2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(x\\ln 2x)=\\ln 2x+1$, and the area is $\\dfrac12\\text{ units}^2$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(x\\ln 2x)&=\\ln 2x+x\\cdot\\frac1x\\\\&=\\ln 2x+1\\end{align*}$$\nSo $\\displaystyle\\int\\ln 2x\\,dx=x\\ln 2x-x$.\n$$\\begin{align*}A&=\\left[x\\ln 2x-x\\right]_{1/2}^{e/2}\\\\&=\\left(\\frac e2-\\frac e2\\right)-\\left(0-\\frac12\\right)\\\\&=\\frac12\\text{ units}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
