  "content": {
    "id": "p23-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Given that $\\log_{10}2\\approx0.30$ and $\\log_{10}3\\approx0.48$, use the fact that $\\log_{10}5=\\log_{10}10-\\log_{10}2$ to find an approximation for $\\log_{10}5$. Then use the log laws to find approximations for:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q12-initial",
        "type": "part",
        "label": "",
        "prompt": "$\\log_{10}5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{10}5\\approx0.70$",
          "worked": "$$\\begin{align*}\\log_{10}5&=\\log_{10}10-\\log_{10}2\\\\\\log_{10}5&\\approx1-0.30\\\\\\log_{10}5&\\approx0.70\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q12-parts",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q12-a",
            "type": "part",
            "label": "a",
            "prompt": "$\\log_{10}20$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1.30$",
              "worked": "$$\\begin{align*}\\log_{10}20&=\\log_{10}2+\\log_{10}10\\\\\\log_{10}20&\\approx0.30+1\\\\\\log_{10}20&\\approx1.30\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p23-q12-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\log_{10}0.2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-0.70$",
              "worked": "$$\\begin{align*}\\log_{10}0.2&=\\log_{10}2-\\log_{10}10\\\\\\log_{10}0.2&\\approx0.30-1\\\\\\log_{10}0.2&\\approx-0.70\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p23-q12-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\log_{10}360$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2.56$",
              "worked": "Since $360=2^3\\times3^2\\times5$,\n$$\\begin{align*}\\log_{10}360&=3\\log_{10}2+2\\log_{10}3+\\log_{10}5\\\\\\log_{10}360&\\approx3(0.30)+2(0.48)+0.70\\\\\\log_{10}360&\\approx2.56\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 52
          },
          {
            "id": "p23-q12-d",
            "type": "part",
            "label": "d",
            "prompt": "$\\log_{10}\\sqrt2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.15$",
              "worked": "$$\\begin{align*}\\log_{10}\\sqrt2&=\\tfrac12\\log_{10}2\\\\\\log_{10}\\sqrt2&\\approx\\tfrac12(0.30)\\\\\\log_{10}\\sqrt2&\\approx0.15\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p23-q12-e",
            "type": "part",
            "label": "e",
            "prompt": "$\\log_{10}\\sqrt8$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.45$",
              "worked": "$$\\begin{align*}\\log_{10}\\sqrt8&=\\tfrac32\\log_{10}2\\\\\\log_{10}\\sqrt8&\\approx\\tfrac32(0.30)\\\\\\log_{10}\\sqrt8&\\approx0.45\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p23-q12-f",
            "type": "part",
            "label": "f",
            "prompt": "$\\log_{10}\\frac1{\\sqrt{10}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-0.50$",
              "worked": "$$\\begin{align*}\\log_{10}\\frac1{\\sqrt{10}}&=-\\tfrac12\\log_{10}10\\\\\\log_{10}\\frac1{\\sqrt{10}}&=-0.50\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p23-q12-g",
            "type": "part",
            "label": "g",
            "prompt": "$\\log_{10}\\sqrt{12}$",
            "layout": "list",
