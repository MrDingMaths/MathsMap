            "answer": {
              "short": "$0.54$",
              "worked": "$$\\begin{align*}\\log_{10}\\sqrt{12}&=\\tfrac12(2\\log_{10}2+\\log_{10}3)\\\\\\log_{10}\\sqrt{12}&\\approx\\tfrac12(2(0.30)+0.48)\\\\\\log_{10}\\sqrt{12}&\\approx0.54\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
