  "content": {
    "id": "p60-q11-response",
    "type": "question",
    "label": "11",
    "prompt": "A patient needs 0.75 g of medicine per day. Pills contain 125 mg each and cost 75 c per pill.\nWhat is the annual cost of medicine, in dollars?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{\\$1642.50}{\\text{yr}}$",
      "worked": "Quantities: medicine, time, pills and cost. Use 365 days in a year.\n$$\\begin{align*}\n\\frac{\\text{Cost}}{\\text{Time}}&=\\frac{\\text{Medicine}}{\\text{Time}}\\times\\frac{\\text{Pills}}{\\text{Medicine}}\\times\\frac{\\text{Cost}}{\\text{Pills}}\\\\\n\\frac{\\$x}{1\\text{ year}}&=\\frac{0.75\\text{ g}}{1\\text{ day}}\\times\\frac{1\\text{ pill}}{125\\text{ mg}}\\times\\frac{75\\text{ c}}{1\\text{ pill}}\\\\\n\\frac{\\$x}{1\\text{ year}}&=\\frac{0.75\\text{ g}}{(1\\div365)\\text{ years}}\\times\\frac{1\\text{ pill}}{(125\\div1000)\\text{ g}}\\times\\frac{\\$0.75}{1\\text{ pill}}\\\\\n\\frac{\\$x}{1\\text{ year}}&=\\$1642.50/\\text{yr}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
