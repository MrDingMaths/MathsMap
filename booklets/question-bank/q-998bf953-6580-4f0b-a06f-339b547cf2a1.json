  "content": {
    "id": "p37-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "The landlord of a large block of home units purchased washing machines for its units four years ago for $\\$400000$, and is assuming a depreciation rate of $30\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "By multiplying by $0.70$, find the value after one year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$280000$",
          "worked": "$$\\begin{align*}V_1&=400000\\times0.70\\\\V_1&=\\$280000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p37-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "By multiplying by $(0.70)^2$, find the value after two years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$196000$",
          "worked": "$$\\begin{align*}V_2&=400000\\times(0.70)^2\\\\V_2&=\\$196000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p37-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "By multiplying by $(0.70)^3$, find the value after three years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$137200$",
          "worked": "$$\\begin{align*}V_3&=400000\\times(0.70)^3\\\\V_3&=\\$137200\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p37-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "By multiplying by $(0.70)^4$, find the value after four years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$96040$",
          "worked": "$$\\begin{align*}V_4&=400000\\times(0.70)^4\\\\V_4&=\\$96040\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p37-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "What is the percentage decrease in value over the four years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75.99\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage remaining}&=(0.70)^4\\times100\\%\\\\\\text{Percentage remaining}&=24.01\\%\\\\\\text{Percentage decrease}&=100\\%-24.01\\%\\\\\\text{Percentage decrease}&=75.99\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "What is the average depreciation on the washing machines, in dollars p.a. over the four years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$75990$ p.a.",
          "worked": "$$\\begin{align*}\\text{Total depreciation}&=400000-96040\\\\\\text{Total depreciation}&=\\$303960\\\\\\text{Average depreciation}&=303960\\div4\\\\\\text{Average depreciation}&=\\$75990\\text{ p.a.}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
