  "content": {
    "id": "p37-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A fair coin is tossed four times. Find the probability that exactly two heads are obtained.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{8}$",
      "worked": "Let $X$ be the number of heads. There are $4$ independent trials, each with success probability $\\frac12$.\n$$\\begin{align*}P(X=2)&=\\binom{4}{2}\\left(\\frac12\\right)^2\\left(\\frac12\\right)^2\\\\P(X=2)&=\\frac{6}{16}\\\\P(X=2)&=\\frac38.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
