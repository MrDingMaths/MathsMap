                {
                  "type": "cloze",
                  "answer": "$2^2\\times3^{3n+4}$",
                  "width": 26
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times3^{3n+4}$",
          "worked": "$$\\begin{align*}\\frac{2^n\\times9^{2n+1}}{6^{n-2}}&=\\frac{2^n\\times3^{4n+2}}{2^{n-2}\\times3^{n-2}}\\\\&=2^{n-(n-2)}\\times3^{4n+2-(n-2)}\\\\&=2^2\\times3^{3n+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p30-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{25^{3n}\\times5^{n-3}}{5^{4n+3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{3n-6}$",
          "worked": "$$\\begin{align*}\\frac{25^{3n}\\times5^{n-3}}{5^{4n+3}}&=\\frac{5^{6n}\\times5^{n-3}}{5^{4n+3}}\\\\&=5^{6n+n-3-(4n+3)}\\\\&=5^{3n-6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p30-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{12^{x-2}\\times4^x}{6^{x-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{3x-2}$",
          "worked": "$$\\begin{align*}\\frac{12^{x-2}\\times4^x}{6^{x-2}}&=\\frac{2^{2x-4}\\times3^{x-2}\\times2^{2x}}{2^{x-2}\\times3^{x-2}}\\\\&=2^{2x-4+2x-(x-2)}\\times3^0\\\\&=2^{3x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p30-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{12^{n-3}\\times27^{1-n}}{9^{2n}\\times8^{n-1}\\times16^n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{-5n-3}\\times3^{-6n}$",
          "worked": "$$\\begin{align*}\\frac{12^{n-3}\\times27^{1-n}}{9^{2n}\\times8^{n-1}\\times16^n}&=\\frac{2^{2n-6}\\times3^{n-3}\\times3^{3-3n}}{3^{4n}\\times2^{3n-3}\\times2^{4n}}\\\\&=\\frac{2^{2n-6}\\times3^{-2n}}{2^{7n-3}\\times3^{4n}}\\\\&=2^{2n-6-(7n-3)}\\times3^{-2n-4n}\\\\&=2^{-5n-3}\\times3^{-6n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p30-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{4^n\\times7^{n-3}\\times49^{3n+1}}{14^{n+2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{n-2}\\times7^{6n-3}$",
          "worked": "$$\\begin{align*}\\frac{4^n\\times7^{n-3}\\times49^{3n+1}}{14^{n+2}}&=\\frac{2^{2n}\\times7^{n-3}\\times7^{6n+2}}{2^{n+2}\\times7^{n+2}}\\\\&=2^{2n-(n+2)}\\times7^{n-3+6n+2-(n+2)}\\\\&=2^{n-2}\\times7^{6n-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p30-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{35^2\\times5^2\\times7^6}{25^4\\times49^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{49}{625}$",
          "worked": "$$\\begin{align*}\\frac{35^2\\times5^2\\times7^6}{25^4\\times49^3}&=\\frac{5^2\\times7^2\\times5^2\\times7^6}{5^8\\times7^6}\\\\&=5^{4-8}\\times7^{8-6}\\\\&=5^{-4}\\times7^2\\\\&=\\frac{49}{625}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
