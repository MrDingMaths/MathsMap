                  "latex": "\\mathrel{\\phantom{=}}\\frac{2^n\\times9^{2n+1}}{6^{n-2}}",
                  "display": true
                }
              ]
            },
            {
              "id": "p30-q2-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
