              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "=\\frac{2^n\\times3^{4n+2}}{2^{n-2}\\times3^{n-2}}",
                  "display": false,
                  "colour": "#268cff"
                },
                {
                  "type": "break"
                },
                {
