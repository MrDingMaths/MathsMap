  "content": {
    "id": "p51-q64-66",
    "type": "question",
    "label": "64",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p51-q64-66-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "The following problems involve finding where the instantaneous and average rates of change are equal.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q64-66-a",
        "type": "part",
        "label": "a",
        "prompt": "Let $A(a,a^2)$ and $B(b,b^2)$ be two points on $y=x^2$. Find the $x$-coordinate of the point $C$ such that the tangent at $C$ is parallel to the chord $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle c=\\frac{a+b}{2}$. The chord gradient is $a+b$, so set $2c=a+b$.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{b^2-a^2}{b-a}\\\\m_{AB}&=a+b\\\\f'(x)&=2x\\\\f'(c)&=m_{AB}\\\\2c&=a+b\\\\c&=\\frac{a+b}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p51-q64-66-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $A(a,\\sqrt a)$ and $B(b,\\sqrt b)$ be two points on the curve $y=\\sqrt x$. Find the $x$-coordinate of the point $C$ on the curve where the tangent at $C$ is parallel to the chord $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle c=\\left(\\frac{\\sqrt a+\\sqrt b}{2}\\right)^2$. Equate the chord gradient with $f'(c)=\\frac{1}{(2\\sqrt c)}$.",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{\\sqrt b-\\sqrt a}{b-a}\\\\m_{AB}&=\\frac{1}{\\sqrt a+\\sqrt b}\\\\f'(x)&=\\frac{1}{2\\sqrt x}\\\\f'(c)&=m_{AB}\\\\\\frac{1}{2\\sqrt c}&=\\frac{1}{\\sqrt a+\\sqrt b}\\\\2\\sqrt c&=\\sqrt a+\\sqrt b\\\\c&=\\left(\\frac{\\sqrt a+\\sqrt b}{2}\\right)^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p51-q64-66-c",
        "type": "part",
        "label": "c",
        "prompt": "Let $A\\left(a,\\frac1a\\right)$ and $B\\left(b,\\frac1b\\right)$ be two points on the same branch of the curve $y=\\frac1x$. Find the $x$-coordinate of the point $C$ on the curve where the tangent at $C$ is parallel to the chord $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=\\pm\\sqrt{ab}$. The chord gradient and tangent gradient are both $-\\frac{1}{(ab)}$ when $c^2=ab$; the question does not restrict $C$ to the branch containing $A$ and $B$.",
          "worked": "\n\n$$\\begin{align*}m_{AB}&=\\frac{\\frac1b-\\frac1a}{b-a}\\\\m_{AB}&=-\\frac1{ab}\\\\f'(x)&=-\\frac1{x^2}\\\\f'(c)&=m_{AB}\\\\-\\frac1{c^2}&=-\\frac1{ab}\\\\c^2&=ab\\\\c&=\\pm\\sqrt{ab}.\\end{align*}$$\n\n Since $A$ and $B$ lie on the same branch, $ab>0$. Both values of $c$ lie on the curve and give the required gradient.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      }
    ]
  },
