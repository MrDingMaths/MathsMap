  "content": {
    "id": "p21-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider the curve $y=x^2-x+5$ at $x=2$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of the tangent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x-1\\\\\\left.\\frac{dy}{dx}\\right|_{x=2}&=2(2)-1\\\\\\left.\\frac{dy}{dx}\\right|_{x=2}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p21-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation of the tangent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x+1$",
          "worked": "At $x=2$,\n\n$$\\begin{align*}y&=2^2-2+5\\\\y&=7\\end{align*}$$\n\nThe tangent has gradient $3$ and passes through $(2,7)$.\n\n$$\\begin{align*}y-7&=3(x-2)\\\\y&=3x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of the normal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3y=23$",
          "worked": "The normal passes through $(2,7)$ and its gradient is the negative reciprocal of the tangent gradient.\n\n$$\\begin{align*}m_{\\mathrm{normal}}&=-\\frac{1}{3}\\\\y-7&=-\\frac{1}{3}(x-2)\\\\3y-21&=-x+2\\\\x+3y&=23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
