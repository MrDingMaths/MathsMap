  "content": {
    "id": "p19-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The diagram shows the parabola $y=1-x^2$.\n\nWithout evaluating the definite integrals, explain why:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p19-q5-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 19 p19-q5-graph\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.24cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[->,black,line width=0.5pt] (-3.6,0)--(4.1,0) node[below right] {$x$};\n\\draw[->,black,line width=0.5pt] (0,-10)--(0,3.5) node[above] {$y$};\n\\draw[<->,black,line width=0.8pt,domain=-3.2:3.2,samples=100] plot (\\x,{1-\\x*\\x});\n\\foreach \\x in {-1,0.5,1,2,3} {\\draw[black,line width=0.4pt] (\\x,-0.17)--(\\x,0.17);}\n\\node[above left] at (-1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[below] at (0.5,-0.25) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\frac12$\\special{dvisvgm:raw </g>}};\n\\node[above right] at (1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\node[below] at (3,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\node[above left] at (0,1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 19,
