    "children": [
      {
        "id": "p19-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_{-1}^{1}(1-x^2)\\,dx$ is positive",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The curve lies above the $x$-axis for $-1<x<1$, so the integral is positive.",
          "worked": "Between $x=-1$ and $x=1$, the parabola lies above the $x$-axis, meeting it at the endpoints. Its signed area is positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^3(1-x^2)\\,dx$ is negative",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The curve lies below the $x$-axis for $1<x\\leq3$, so the integral is negative.",
          "worked": "From $x=1$ to $x=3$, the parabola lies below the $x$-axis except at $x=1$. The region contributes negative signed area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q5-lower-row",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q5-d",
            "type": "part",
            "label": "c",
            "prompt": "$\\displaystyle\\int_{-1}^{0}(1-x^2)\\,dx=\\int_0^1(1-x^2)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The parabola is symmetric about the $y$-axis, so the two regions have equal area.",
              "worked": "$y=1-x^2$ is an even function, so its graph is symmetric about the $y$-axis. The regions above the $x$-axis on $[-1,0]$ and $[0,1]$ are mirror images and have equal area. Hence the integrals are equal.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p19-q5-e",
            "type": "part",
            "label": "d",
            "prompt": "$\\displaystyle\\int_0^{\\frac12}(1-x^2)\\,dx>\\int_{\\frac12}^1(1-x^2)\\,dx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The intervals have equal width, and the positive curve is higher over the first interval. Its area is greater.",
              "worked": "On $[0,1]$, the parabola is nonnegative and decreasing. Both intervals have width $\\tfrac12$. For each $x$ in the first interval, the curve is higher than at $x+\\tfrac12$ in the second interval. Thus the first area is greater.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          }
        ]
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
