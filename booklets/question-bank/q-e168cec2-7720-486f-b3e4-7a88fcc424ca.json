    "children": [
      {
        "id": "p5-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the quotient and remainder when each of the following numbers is divided into 30.\n\n$1,\\ 2,\\ 3,\\ 4,\\ 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "In the given order: quotient $30$, remainder $0$; quotient $15$, remainder $0$; quotient $10$, remainder $0$; quotient $7$, remainder $2$; quotient $6$, remainder $0$.",
          "worked": "$$\\begin{align*}30&=1\\times30+0\\\\30&=2\\times15+0\\\\30&=3\\times10+0\\\\30&=4\\times7+2\\\\30&=5\\times6+0\\end{align*}$$\n\nThe quotients are $30,15,10,7,6$, and the corresponding remainders are $0,0,0,2,0$. Each remainder is less than its divisor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p5-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down all the factors of 30.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\ 2,\\ 3,\\ 5,\\ 6,\\ 10,\\ 15,\\ 30$",
          "worked": "$$\\begin{align*}30&=1\\times30\\\\30&=2\\times15\\\\30&=3\\times10\\\\30&=5\\times6\\end{align*}$$\n\nThe factors of $30$ are $1,2,3,5,6,10,15,30$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
