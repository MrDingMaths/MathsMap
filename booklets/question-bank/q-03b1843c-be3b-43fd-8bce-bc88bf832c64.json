  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Determine the lowest common multiple of each set of numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q7-grid",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q7-a",
            "type": "part",
            "label": "a",
            "prompt": "$5$ and $8$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$40$",
              "worked": "The only common factor of $5$ and $8$ is $1$.\n$$\\begin{align*}\\operatorname{HCF}(5,8)&=1\\\\\\operatorname{LCM}(5,8)&=\\frac{5\\times8}{1}\\\\\\operatorname{LCM}(5,8)&=40\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p10-q7-b",
            "type": "part",
            "label": "b",
            "prompt": "$6$ and $7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$42$",
              "worked": "The only common factor of $6$ and $7$ is $1$.\n$$\\begin{align*}\\operatorname{HCF}(6,7)&=1\\\\\\operatorname{LCM}(6,7)&=\\frac{6\\times7}{1}\\\\\\operatorname{LCM}(6,7)&=42\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p10-q7-c",
            "type": "part",
            "label": "c",
            "prompt": "$4$ and $3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12$",
              "worked": "The only common factor of $4$ and $3$ is $1$.\n$$\\begin{align*}\\operatorname{HCF}(4,3)&=1\\\\\\operatorname{LCM}(4,3)&=\\frac{4\\times3}{1}\\\\\\operatorname{LCM}(4,3)&=12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p10-q7-d",
            "type": "part",
            "label": "d",
            "prompt": "$2$ and $11$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$22$",
              "worked": "The only common factor of $2$ and $11$ is $1$.\n$$\\begin{align*}\\operatorname{HCF}(2,11)&=1\\\\\\operatorname{LCM}(2,11)&=\\frac{2\\times11}{1}\\\\\\operatorname{LCM}(2,11)&=22\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p10-q7-e",
            "type": "part",
            "label": "e",
            "prompt": "$11$ and $4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$44$",
              "worked": "The only common factor of $11$ and $4$ is $1$.\n$$\\begin{align*}\\operatorname{HCF}(11,4)&=1\\\\\\operatorname{LCM}(11,4)&=\\frac{11\\times4}{1}\\\\\\operatorname{LCM}(11,4)&=44\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p10-q7-f",
            "type": "part",
            "label": "f",
            "prompt": "$9$ and $4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$36$",
              "worked": "The only common factor of $9$ and $4$ is $1$.\n$$\\begin{align*}\\operatorname{HCF}(9,4)&=1\\\\\\operatorname{LCM}(9,4)&=\\frac{9\\times4}{1}\\\\\\operatorname{LCM}(9,4)&=36\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          }
        ]
      },
      {
        "id": "p10-q7-reflection",
        "type": "part",
        "label": "g",
        "prompt": "What do you notice about your answers? Why does this happen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each LCM is the product of the two numbers because their only common factor is $1$.",
          "worked": "Each answer equals the product of the two given numbers. Each pair has no common factor other than $1$, so its HCF is $1$. The taught rule gives\n$$\\operatorname{LCM}=\\frac{\\text{product of the two numbers}}{\\operatorname{HCF}}=\\frac{\\text{product of the two numbers}}{1}.$$\nTherefore, the LCM is their product.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
