  "content": {
    "id": "p17-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Use the remainder theorem to find the remainder, and state whether or not $D(x)$ is a factor of $P(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=x^2-5x+2$, $D(x)=x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $38$; $x+4$ is not a factor.",
          "worked": "The remainder is $P(-4)$.\n$$\\begin{align*}P(-4)&=(-4)^2-5(-4)+2\\\\P(-4)&=16+20+2\\\\P(-4)&=38.\\end{align*}$$\nSince $P(-4)\\ne0$, $x+4$ is not a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=3x^2-16x+21$, $D(x)=x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $0$; $x-3$ is a factor.",
          "worked": "The remainder is $P(3)$.\n$$\\begin{align*}P(3)&=3(3)^2-16(3)+21\\\\P(3)&=27-48+21\\\\P(3)&=0.\\end{align*}$$\nSince $P(3)=0$, $x-3$ is a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=x^3-6x^2+1$, $D(x)=x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $-274$; $x+5$ is not a factor.",
          "worked": "The remainder is $P(-5)$.\n$$\\begin{align*}P(-5)&=(-5)^3-6(-5)^2+1\\\\P(-5)&=-125-150+1\\\\P(-5)&=-274.\\end{align*}$$\nSince $P(-5)\\ne0$, $x+5$ is not a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(x)=x^3-11x^2+8x+20$, $D(x)=x-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $0$; $x-10$ is a factor.",
          "worked": "The remainder is $P(10)$.\n$$\\begin{align*}P(10)&=10^3-11(10)^2+8(10)+20\\\\P(10)&=1000-1100+80+20\\\\P(10)&=0.\\end{align*}$$\nSince $P(10)=0$, $x-10$ is a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
