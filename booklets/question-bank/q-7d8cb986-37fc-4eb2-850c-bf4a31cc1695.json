    "answer": {
      "short": "$6\\sqrt2$",
      "worked": "$$\\begin{align*}\\sqrt{18}-\\sqrt8+\\sqrt{50}&=\\sqrt{9\\times2}-\\sqrt{4\\times2}+\\sqrt{25\\times2}\\\\\\sqrt{18}-\\sqrt8+\\sqrt{50}&=3\\sqrt2-2\\sqrt2+5\\sqrt2\\\\\\sqrt{18}-\\sqrt8+\\sqrt{50}&=6\\sqrt2.\\end{align*}$$",
      "solutionDiagrams": []
