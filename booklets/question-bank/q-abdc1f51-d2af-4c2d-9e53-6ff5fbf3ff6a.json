  "content": {
    "id": "p30-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "$A(5,6)$ and $B(6,7)$ are adjacent vertices of a square $ABCD$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of each side of the square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}$",
          "worked": "$$\\begin{align*}AB^2&=(6-5)^2+(7-6)^2\\\\AB^2&=1+1\\\\AB^2&=2\\\\AB&=\\sqrt{2}\\end{align*}$$\nAll sides of a square are equal, so each side has length $\\sqrt{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p30-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the gradient of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{7-6}{6-5}\\\\m_{AB}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p30-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the gradient of $BC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "Adjacent sides of a square are perpendicular.\n$$\\begin{align*}m_{AB}m_{BC}&=-1\\\\1\\times m_{BC}&=-1\\\\m_{BC}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p30-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "The coordinates of $C$ are $(7,c)$. Find the value of $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=6$",
          "worked": "$$\\begin{align*}\\frac{c-7}{7-6}&=-1\\\\c-7&=-1\\\\c&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the coordinates of $D$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D=(6,5)$\n\nOpposite sides of the square are equal and parallel.",
          "worked": "From $B(6,7)$ to $C(7,6)$, the horizontal change is $1$ and the vertical change is $-1$. Opposite sides of a square are equal and parallel, so the same changes take $A$ to $D$.\n$$D=(5+1,6-1)=(6,5).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
