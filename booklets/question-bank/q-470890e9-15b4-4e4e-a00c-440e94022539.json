    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "The $x$-intercepts of a parabola are $(1,0)$ and $(2,0)$. From this information alone, is it possible to write down the equation of the parabola?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. Any $y=c(x-1)(x-2)$ with $c\\ne0$ has these intercepts.",
          "worked": "The intercepts give $y=c(x-1)(x-2)$, where $c\\ne0$. They do not determine $c$, so the equation cannot be determined uniquely.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "The $x$-intercepts of a parabola are $(1,0)$ and $(2,0)$. The parabola also passes through the point $(3,1)$. Find the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac12(x-1)(x-2)$.",
          "worked": "The intercepts give $y=c(x-1)(x-2)$. Substitute $(3,1)$:\n$$\\begin{align*}1&=c(3-1)(3-2)\\\\1&=2c\\\\c&=\\frac12.\\end{align*}$$\nHence $y=\\frac12(x-1)(x-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of the parabola that passes through the points $(3,0)$, $(-2,0)$ and $(4,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac16(x+2)(x-3)$.",
          "worked": "The intercepts give $y=c(x+2)(x-3)$. Substitute $(4,1)$:\n$$\\begin{align*}1&=c(4+2)(4-3)\\\\1&=6c\\\\c&=\\frac16.\\end{align*}$$\nHence $y=\\frac16(x+2)(x-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
