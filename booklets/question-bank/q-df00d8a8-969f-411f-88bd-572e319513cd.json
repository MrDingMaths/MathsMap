    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y^2+2y-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-1\\pm\\sqrt{5}$",
          "worked": "$$\\begin{align*}y^2+2y&=4\\\\y^2+2y+1&=4+1\\\\(y+1)^2&=5\\\\y+1&=\\pm\\sqrt{5}\\\\y&=-1\\pm\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p9-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^2-4a-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2\\pm\\sqrt{6}$",
          "worked": "$$\\begin{align*}a^2-4a&=2\\\\a^2-4a+4&=2+4\\\\(a-2)^2&=6\\\\a-2&=\\pm\\sqrt{6}\\\\a&=2\\pm\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p9-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-2x=\\frac{5}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1\\pm\\frac{\\sqrt{14}}{2}$",
          "worked": "$$\\begin{align*}x^2-2x+1&=\\frac{5}{2}+1\\\\(x-1)^2&=\\frac{7}{2}\\\\x-1&=\\pm\\frac{\\sqrt{14}}{2}\\\\x&=1\\pm\\frac{\\sqrt{14}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p9-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-7x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{7\\pm\\sqrt{41}}{2}$",
          "worked": "$$\\begin{align*}x^2-7x&=-2\\\\x^2-7x+\\frac{49}{4}&=-2+\\frac{49}{4}\\\\\\left(x-\\frac{7}{2}\\right)^2&=\\frac{41}{4}\\\\x-\\frac{7}{2}&=\\pm\\frac{\\sqrt{41}}{2}\\\\x&=\\frac{7\\pm\\sqrt{41}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p9-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$y^2+\\frac{1}{2}y=\\frac{1}{16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{1}{4}\\pm\\frac{\\sqrt{2}}{4}$",
          "worked": "$$\\begin{align*}y^2+\\frac{1}{2}y+\\frac{1}{16}&=\\frac{1}{16}+\\frac{1}{16}\\\\\\left(y+\\frac{1}{4}\\right)^2&=\\frac{1}{8}\\\\y+\\frac{1}{4}&=\\pm\\frac{\\sqrt{2}}{4}\\\\y&=-\\frac{1}{4}\\pm\\frac{\\sqrt{2}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p9-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$2x^2-x=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1\\pm\\sqrt{33}}{4}$",
          "worked": "$$\\begin{align*}x^2-\\frac{1}{2}x&=2\\\\x^2-\\frac{1}{2}x+\\frac{1}{16}&=2+\\frac{1}{16}\\\\\\left(x-\\frac{1}{4}\\right)^2&=\\frac{33}{16}\\\\x-\\frac{1}{4}&=\\pm\\frac{\\sqrt{33}}{4}\\\\x&=\\frac{1\\pm\\sqrt{33}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p9-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$n^2=5n+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac{5\\pm\\sqrt{41}}{2}$",
          "worked": "$$\\begin{align*}n^2-5n&=4\\\\n^2-5n+\\frac{25}{4}&=4+\\frac{25}{4}\\\\\\left(n-\\frac{5}{2}\\right)^2&=\\frac{41}{4}\\\\n-\\frac{5}{2}&=\\pm\\frac{\\sqrt{41}}{2}\\\\n&=\\frac{5\\pm\\sqrt{41}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p9-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$16x^2+8x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-1\\pm\\sqrt{2}}{4}$",
          "worked": "$$\\begin{align*}x^2+\\frac{1}{2}x&=\\frac{1}{16}\\\\x^2+\\frac{1}{2}x+\\frac{1}{16}&=\\frac{1}{16}+\\frac{1}{16}\\\\\\left(x+\\frac{1}{4}\\right)^2&=\\frac{1}{8}\\\\x+\\frac{1}{4}&=\\pm\\frac{\\sqrt{2}}{4}\\\\x&=\\frac{-1\\pm\\sqrt{2}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
