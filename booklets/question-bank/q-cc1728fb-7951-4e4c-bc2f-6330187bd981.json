  "content": {
    "id": "p56-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify the following by rationalising the denominator.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{a\\sqrt{b}}{c\\sqrt{d}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a\\sqrt{bd}}{cd}$",
          "worked": "$$\\begin{align*}\\frac{a\\sqrt{b}}{c\\sqrt{d}}&=\\frac{a\\sqrt{b}\\times\\sqrt{d}}{c\\sqrt{d}\\times\\sqrt{d}}\\\\&=\\frac{a\\sqrt{bd}}{cd}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p56-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{a+\\sqrt{b}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a-\\sqrt{b}}{a^2-b}$",
          "worked": "$$\\begin{align*}\\frac{1}{a+\\sqrt{b}}&=\\frac{1}{a+\\sqrt{b}}\\times\\frac{a-\\sqrt{b}}{a-\\sqrt{b}}\\\\&=\\frac{a-\\sqrt{b}}{a^2-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p56-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{\\sqrt{a}}-\\dfrac{1}{\\sqrt{b}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b\\sqrt{a}-a\\sqrt{b}}{ab}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{a}}-\\frac{1}{\\sqrt{b}}&=\\frac{\\sqrt{a}}{a}-\\frac{\\sqrt{b}}{b}\\\\&=\\frac{b\\sqrt{a}}{ab}-\\frac{a\\sqrt{b}}{ab}\\\\&=\\frac{b\\sqrt{a}-a\\sqrt{b}}{ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p56-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{a\\sqrt{b}-c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a\\sqrt{b}+c}{a^2b-c^2}$",
          "worked": "$$\\begin{align*}\\frac{1}{a\\sqrt{b}-c}&=\\frac{1}{a\\sqrt{b}-c}\\times\\frac{a\\sqrt{b}+c}{a\\sqrt{b}+c}\\\\&=\\frac{a\\sqrt{b}+c}{(a\\sqrt{b})^2-c^2}\\\\&=\\frac{a\\sqrt{b}+c}{a^2b-c^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p56-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1}{a\\sqrt{b}+c\\sqrt{d}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a\\sqrt{b}-c\\sqrt{d}}{a^2b-c^2d}$",
          "worked": "$$\\begin{align*}\\frac{1}{a\\sqrt{b}+c\\sqrt{d}}&=\\frac{a\\sqrt{b}-c\\sqrt{d}}{(a\\sqrt{b}+c\\sqrt{d})(a\\sqrt{b}-c\\sqrt{d})}\\\\&=\\frac{a\\sqrt{b}-c\\sqrt{d}}{(a\\sqrt{b})^2-(c\\sqrt{d})^2}\\\\&=\\frac{a\\sqrt{b}-c\\sqrt{d}}{a^2b-c^2d}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
