    "type": "question",
    "label": "18",
    "prompt": "What is the value of $\\left(1-\\frac{1}{2}\\right)\\times\\left(1-\\frac{1}{3}\\right)\\times\\left(1-\\frac{1}{4}\\right)\\times\\left(1-\\frac{1}{5}\\right)$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{5}$",
      "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\left(1-\\frac{1}{2}\\right)\\times\\left(1-\\frac{1}{3}\\right)\\times\\left(1-\\frac{1}{4}\\right)\\times\\left(1-\\frac{1}{5}\\right)\\\\&=\\frac{1}{2}\\times\\frac{2}{3}\\times\\frac{3}{4}\\times\\frac{4}{5}\\\\&=\\frac{1}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
