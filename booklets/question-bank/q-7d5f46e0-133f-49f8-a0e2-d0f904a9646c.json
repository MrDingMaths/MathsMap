  "content": {
    "id": "p31-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_2^3 x(2+3x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "$$\\begin{aligned}\\int_2^3 x(2+3x)\\,dx&=\\int_2^3(2x+3x^2)\\,dx\\\\&=\\left[x^2+x^3\\right]_2^3\\\\&=(9+27)-(4+8)\\\\&=24\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p31-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^2(x+1)(3x+1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{aligned}\\int_0^2(x+1)(3x+1)\\,dx&=\\int_0^2(3x^2+4x+1)\\,dx\\\\&=\\left[x^3+2x^2+x\\right]_0^2\\\\&=(8+8+2)-0\\\\&=18\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p31-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{-1}^1 x^2(5x^2+1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8}{3}$",
          "worked": "$$\\begin{aligned}\\int_{-1}^1x^2(5x^2+1)\\,dx&=\\int_{-1}^1(5x^4+x^2)\\,dx\\\\&=\\left[x^5+\\frac{x^3}{3}\\right]_{-1}^1\\\\&=\\left(1+\\frac13\\right)-\\left(-1-\\frac13\\right)\\\\&=\\frac83\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p31-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{-1}^2(x-3)^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21$",
          "worked": "$$\\begin{aligned}\\int_{-1}^2(x-3)^2\\,dx&=\\int_{-1}^2(x^2-6x+9)\\,dx\\\\&=\\left[\\frac{x^3}{3}-3x^2+9x\\right]_{-1}^2\\\\&=\\left(\\frac83-12+18\\right)-\\left(-\\frac13-3-9\\right)\\\\&=21\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p31-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_{-1}^0x(x-1)(x+1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14$",
          "worked": "$$\\begin{aligned}\\int_{-1}^0x(x-1)(x+1)\\,dx&=\\int_{-1}^0(x^3-x)\\,dx\\\\&=\\left[\\frac{x^4}{4}-\\frac{x^2}{2}\\right]_{-1}^0\\\\&=0-\\left(\\frac14-\\frac12\\right)\\\\&=\\frac14\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p31-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_{-1}^0(1-x^2)^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8}{15}$",
          "worked": "$$\\begin{aligned}\\int_{-1}^0(1-x^2)^2\\,dx&=\\int_{-1}^0(1-2x^2+x^4)\\,dx\\\\&=\\left[x-\\frac{2x^3}{3}+\\frac{x^5}{5}\\right]_{-1}^0\\\\&=0-\\left(-1+\\frac23-\\frac15\\right)\\\\&=\\frac8{15}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
