  "content": {
    "id": "v2-f1e31-p55-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "State if the following is an identity, contradiction or conditional equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-f1e31-p55-practice-slot-8-slot-8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$3(x-2)+4x=7x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Identity.",
          "worked": "$$\\begin{align*}3x-6+4x&=7x-6\\\\7x-6&=7x-6\\\\0&=0\\end{align*}$$\nThis is true for all values of $x$, so the equation is an identity.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f1e31-p55-practice-slot-8-slot-8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$2(4x+3)=8x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Contradiction.",
          "worked": "$$\\begin{align*}8x+6&=8x+5\\\\6&=5\\end{align*}$$\nThis statement is false, so the equation is a contradiction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f1e31-p55-practice-slot-8-slot-8-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$5x-2(x-4)=4x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Conditional equation.",
          "worked": "$$\\begin{align*}5x-2x+8&=4x+3\\\\3x+8&=4x+3\\\\5&=x\\end{align*}$$\nIt is true only when $x=5$, so it is a conditional equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f1e31-p55-practice-slot-8-slot-8-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$-2(3-x)-5=3x-11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Conditional equation.",
          "worked": "$$\\begin{align*}-6+2x-5&=3x-11\\\\2x-11&=3x-11\\\\0&=x\\end{align*}$$\nIt is true only when $x=0$, so it is a conditional equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f1e31-p55-practice-slot-8-slot-8-q-e",
        "type": "part",
        "label": "e",
        "prompt": "$5(p-q)+2(p+3q)=7p+q+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Contradiction.",
          "worked": "$$\\begin{align*}5p-5q+2p+6q&=7p+q+2\\\\7p+q&=7p+q+2\\\\0&=2\\end{align*}$$\nThis statement is false, so the equation is a contradiction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
