  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Arrange each of these collections of numbers in ascending order:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\sqrt{3},\\ 3\\sqrt{2},\\ 4,\\ \\sqrt{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{11}<2\\sqrt{3}<4<3\\sqrt{2}$",
          "worked": "$$\\begin{align*}2\\sqrt{3}&=\\sqrt{12}\\\\3\\sqrt{2}&=\\sqrt{18}\\\\4&=\\sqrt{16}\\end{align*}$$Since $11<12<16<18$, the ascending order is $\\sqrt{11},\\ 2\\sqrt{3},\\ 4,\\ 3\\sqrt{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\sqrt{2},\\ \\sqrt{30},\\ 6,\\ 3\\sqrt{5},\\ 4\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{30}<6<3\\sqrt{5}<4\\sqrt{3}<5\\sqrt{2}$",
          "worked": "$$\\begin{align*}5\\sqrt{2}&=\\sqrt{50}\\\\6&=\\sqrt{36}\\\\3\\sqrt{5}&=\\sqrt{45}\\\\4\\sqrt{3}&=\\sqrt{48}\\end{align*}$$Since $30<36<45<48<50$, the ascending order is $\\sqrt{30},\\ 6,\\ 3\\sqrt{5},\\ 4\\sqrt{3},\\ 5\\sqrt{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sqrt{15},\\ 5\\sqrt{2},\\ 3\\sqrt{6},\\ 7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7<5\\sqrt{2}<3\\sqrt{6}<2\\sqrt{15}$",
          "worked": "$$\\begin{align*}2\\sqrt{15}&=\\sqrt{60}\\\\5\\sqrt{2}&=\\sqrt{50}\\\\3\\sqrt{6}&=\\sqrt{54}\\\\7&=\\sqrt{49}\\end{align*}$$Since $49<50<54<60$, the ascending order is $7,\\ 5\\sqrt{2},\\ 3\\sqrt{6},\\ 2\\sqrt{15}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
