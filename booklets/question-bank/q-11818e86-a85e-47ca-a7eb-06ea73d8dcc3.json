  "content": {
    "id": "p20-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Simplify by factorising using the difference of two squares first.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2-7}{x+\\sqrt7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-\\sqrt7$",
          "worked": "$$\\begin{align*}\\frac{x^2-7}{x+\\sqrt7}&=\\frac{(x-\\sqrt7)(x+\\sqrt7)}{x+\\sqrt7}\\\\\\frac{x^2-7}{x+\\sqrt7}&=x-\\sqrt7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2-10}{x-\\sqrt{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+\\sqrt{10}$",
          "worked": "$$\\begin{align*}\\frac{x^2-10}{x-\\sqrt{10}}&=\\frac{(x-\\sqrt{10})(x+\\sqrt{10})}{x-\\sqrt{10}}\\\\\\frac{x^2-10}{x-\\sqrt{10}}&=x+\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\sqrt5\\,x+3}{5x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{\\sqrt5\\,x-3}$",
          "worked": "$$\\begin{align*}5x^2-9&=(\\sqrt5\\,x-3)(\\sqrt5\\,x+3)\\\\\\frac{\\sqrt5\\,x+3}{5x^2-9}&=\\frac{\\sqrt5\\,x+3}{(\\sqrt5\\,x-3)(\\sqrt5\\,x+3)}\\\\\\frac{\\sqrt5\\,x+3}{5x^2-9}&=\\frac{1}{\\sqrt5\\,x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p20-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sqrt3\\,x-4}{3x^2-16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{\\sqrt3\\,x+4}$",
          "worked": "$$\\begin{align*}3x^2-16&=(\\sqrt3\\,x-4)(\\sqrt3\\,x+4)\\\\\\frac{\\sqrt3\\,x-4}{3x^2-16}&=\\frac{\\sqrt3\\,x-4}{(\\sqrt3\\,x-4)(\\sqrt3\\,x+4)}\\\\\\frac{\\sqrt3\\,x-4}{3x^2-16}&=\\frac{1}{\\sqrt3\\,x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p20-q18-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{(x+1)^2-2}{x+1+\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+1-\\sqrt2$",
          "worked": "$$\\begin{align*}(x+1)^2-2&=(x+1-\\sqrt2)(x+1+\\sqrt2)\\\\\\frac{(x+1)^2-2}{x+1+\\sqrt2}&=\\frac{(x+1-\\sqrt2)(x+1+\\sqrt2)}{x+1+\\sqrt2}\\\\\\frac{(x+1)^2-2}{x+1+\\sqrt2}&=x+1-\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p20-q18-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(x-3)^2-5}{x-3-\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-3+\\sqrt5$",
          "worked": "$$\\begin{align*}(x-3)^2-5&=(x-3-\\sqrt5)(x-3+\\sqrt5)\\\\\\frac{(x-3)^2-5}{x-3-\\sqrt5}&=\\frac{(x-3-\\sqrt5)(x-3+\\sqrt5)}{x-3-\\sqrt5}\\\\\\frac{(x-3)^2-5}{x-3-\\sqrt5}&=x-3+\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
