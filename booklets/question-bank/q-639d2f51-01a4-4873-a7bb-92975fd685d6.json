  "content": {
    "id": "p31-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The cubic function is defined as $f(x)=2(x-k)(x+2)^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f(1)=-36$, solve for $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=3$.",
          "worked": "$$\\begin{align*}-36&=2(1-k)(1+2)^2\\\\-36&=18(1-k)\\\\-2&=1-k\\\\k&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p31-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "If $k$ was doubled, determine the new value of $f(1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(1)=-90$.",
          "worked": "Doubling $k=3$ gives $k=6$.\n$$\\begin{align*}f(1)&=2(1-6)(1+2)^2\\\\f(1)&=2(-5)(9)\\\\f(1)&=-90.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p31-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Using the value of $k$ from part (a), reflect the graph of $f$ in the $x$-axis. State the equation of the reflected function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2(x-3)(x+2)^2$.",
          "worked": "Reflection in the $x$-axis multiplies every function value by $-1$. Using $k=3$, the reflected function is\n$$y=-f(x)=-2(x-3)(x+2)^2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
