  "content": {
    "id": "p38-q50-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=e^x$ and $g(x)=\\sqrt{1-x}$. Find the domain and range of $f(g(x))$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Domain: $(-\\infty,1]$. Range: $[1,\\infty)$.",
      "worked": "The square root requires\n$$\\begin{align*}1-x&\\geq0\\\\x&\\leq1.\\end{align*}$$\nFor $x\\leq1$, $\\sqrt{1-x}$ takes every value in $[0,\\infty)$. Since $e^u$ increases from $1$ without bound for $u\\geq0$,\n$$f(g(x))=e^{\\sqrt{1-x}}\\in[1,\\infty).$$\nDomain: $(-\\infty,1]$. Range: $[1,\\infty)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
