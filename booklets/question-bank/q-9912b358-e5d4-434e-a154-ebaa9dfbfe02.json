  "content": {
    "id": "p3-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Convert the following from radians to degrees, rounded to the nearest degree where necessary.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{\\pi}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36^\\circ$",
          "worked": "$\\begin{aligned}\\frac{\\pi}{5}\\text{ rad}&=\\frac{\\pi}{5}\\times\\frac{180^\\circ}{\\pi}\\\\\\frac{\\pi}{5}\\text{ rad}&=36^\\circ\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\pi}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18^\\circ$",
          "worked": "$\\begin{aligned}\\frac{\\pi}{10}\\text{ rad}&=\\frac{\\pi}{10}\\times\\frac{180^\\circ}{\\pi}\\\\\\frac{\\pi}{10}\\text{ rad}&=18^\\circ\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
