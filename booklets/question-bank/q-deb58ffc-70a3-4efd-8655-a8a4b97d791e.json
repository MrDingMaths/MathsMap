        "id": "p25-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$A = 12\\text{ cm}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p25-q3-a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 25, p25-q3-a-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,draw=black,text=black,line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (L) at (-16,0);\n\\coordinate (R) at (16,0);\n\\coordinate (O) at (0,0);\n\\draw (O) circle[radius=16mm];\n\\draw (L) -- (R) node[midway,above=2mm,font=\\fontsize{10}{12}\\selectfont] {$d$};\n\\fill[black] (O) circle[radius=0.8mm];\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 29.2,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 25,
              "sourceRegion": "Question 3a, lower-left practice cell",
              "description": "Unfilled circle with a horizontal diameter through a centre dot; d is above the diameter at its midpoint.",
              "mathematics": "The given area is the area of a complete circle. The labelled segment is the full diameter.",
              "answerVisibility": "Only the unknown d is visible; no numerical answer is drawn."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$3.9\\text{ cm}$",
          "worked": "$$\\begin{align*}\nA &= \\pi r^2\\\\\n12 &= \\pi r^2\\\\\n\\frac{12}{\\pi} &= r^2\\\\\nr &= \\sqrt{\\frac{12}{\\pi}}\\text{ cm}\\\\\nd &= 2\\sqrt{\\frac{12}{\\pi}}\\text{ cm}\\\\\nd &\\approx 3.9\\text{ cm}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p25-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$A = 14\\text{ mm}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p25-q3-b-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 25, p25-q3-b-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,draw=black,text=black,line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (L) at (-16,0);\n\\coordinate (R) at (16,0);\n\\draw (R) arc[start angle=0,end angle=180,radius=16mm];\n\\draw (L) -- (R) node[midway,below=2mm,font=\\fontsize{10}{12}\\selectfont] {$d$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 34,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 25,
              "sourceRegion": "Question 3b, lower-right practice cell",
              "description": "Unfilled upward-facing semicircle with a horizontal diameter; d is below the diameter at its midpoint.",
              "mathematics": "The given area is the area of the semicircle, and d labels its full straight diameter.",
              "answerVisibility": "Only the unknown d is visible; no numerical answer is drawn."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$6.0\\text{ mm}$",
          "worked": "$$\\begin{align*}\nA &= \\frac{\\pi r^2}{2}\\\\\n14 &= \\frac{\\pi r^2}{2}\\\\\n28 &= \\pi r^2\\\\\n\\frac{28}{\\pi} &= r^2\\\\\nr &= \\sqrt{\\frac{28}{\\pi}}\\text{ mm}\\\\\nd &= 2\\sqrt{\\frac{28}{\\pi}}\\text{ mm}\\\\\nd &\\approx 6.0\\text{ mm}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
