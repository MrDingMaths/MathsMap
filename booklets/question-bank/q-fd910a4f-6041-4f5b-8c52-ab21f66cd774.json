    }
  },
  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the inverse relation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\pm\\sqrt{x}$, $x\\geq0$.",
          "worked": "Interchange $x$ and $y$.\n$$\\begin{align*}x&=y^2\\\\y&=\\pm\\sqrt{x}\\end{align*}$$\nThe inverse relation has domain $[0,\\infty)$ and range $\\mathbb{R}$. Both branches are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\pm\\sqrt{x-5}$, $x\\geq5$.",
          "worked": "Interchange $x$ and $y$.\n$$\\begin{align*}x&=y^2+5\\\\x-5&=y^2\\\\y&=\\pm\\sqrt{x-5}\\end{align*}$$\nThe inverse relation has domain $[5,\\infty)$ and range $\\mathbb{R}$. Both branches are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2x^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\pm\\sqrt[4]{\\frac{x}{2}}$, $x\\geq0$.",
          "worked": "Interchange $x$ and $y$.\n$$\\begin{align*}x&=2y^4\\\\\\frac{x}{2}&=y^4\\\\y&=\\pm\\sqrt[4]{\\frac{x}{2}}\\end{align*}$$\nThe inverse relation has domain $[0,\\infty)$ and range $\\mathbb{R}$. Both real branches are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^2+8x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4\\pm\\sqrt{x+16}$, $x\\geq-16$.",
          "worked": "Interchange $x$ and $y$, then complete the square.\n$$\\begin{align*}x&=y^2+8y\\\\x+16&=y^2+8y+16\\\\x+16&=(y+4)^2\\\\y+4&=\\pm\\sqrt{x+16}\\\\y&=-4\\pm\\sqrt{x+16}\\end{align*}$$\nThe inverse relation has domain $[-16,\\infty)$ and range $\\mathbb{R}$. Both branches are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p8-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=4x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2\\pm\\sqrt{4-x}$, $x\\leq4$.",
          "worked": "Interchange $x$ and $y$, then complete the square.\n$$\\begin{align*}x&=4y-y^2\\\\y^2-4y&=-x\\\\y^2-4y+4&=4-x\\\\(y-2)^2&=4-x\\\\y-2&=\\pm\\sqrt{4-x}\\\\y&=2\\pm\\sqrt{4-x}\\end{align*}$$\nThe inverse relation has domain $(-\\infty,4]$ and range $\\mathbb{R}$. Both branches are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p8-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=x^2+12x-11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-6\\pm\\sqrt{x+47}$, $x\\geq-47$.",
          "worked": "Interchange $x$ and $y$, then complete the square.\n$$\\begin{align*}x&=y^2+12y-11\\\\x+11&=y^2+12y\\\\x+47&=y^2+12y+36\\\\x+47&=(y+6)^2\\\\y+6&=\\pm\\sqrt{x+47}\\\\y&=-6\\pm\\sqrt{x+47}\\end{align*}$$\nThe inverse relation has domain $[-47,\\infty)$ and range $\\mathbb{R}$. Both branches are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 51
      }
    ]
  },
