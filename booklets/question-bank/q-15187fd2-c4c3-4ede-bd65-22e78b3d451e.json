  "content": {
    "id": "p16-q20-root",
    "type": "question",
    "label": "20",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p16-q20-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "[Other Methods] Each problem in Question 13 could be easily solved by graphing the line and circle. How could parts a and b be solved using geometry?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "For Question 13a: the circle $x^2+y^2=4$ and the line $y=x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two intersections: $(0,1)$ lies inside the circle and on the line.",
          "worked": "The circle has centre $O(0,0)$ and radius $2$. The line passes through $P(0,1)$, and $OP=1<2$, so $P$ is inside the circle. A complete straight line through an interior point crosses the circle twice.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q20-b",
        "type": "group",
        "label": "b",
        "prompt": "For Question 13b, explain each case geometrically.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q20-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x^2+y^2=1$, $y=x+2$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "No intersections: the perpendicular distance from the centre to the line is $\\sqrt2>1$.",
              "worked": "The line meets the axes at $A(0,2)$ and $B(-2,0)$. Their midpoint is $M(-1,1)$. The gradient of $AB$ is $1$ and that of $OM$ is $-1$, so $OM$ is perpendicular to the line.\n$$\\begin{align*}OM&=\\sqrt{(-1)^2+1^2}\\\\OM&=\\sqrt2>1.\\end{align*}$$\nThe shortest distance from the centre to the line exceeds the circle's radius $1$, so there are no intersections.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p16-q20-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x^2+y^2=5$, $y=-2x+5$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "One intersection: the line is tangent at $(2,1)$, where the radius is perpendicular to the line.",
              "worked": "Let $P=(2,1)$. Then $2^2+1^2=5$ and $1=-2(2)+5$, so $P$ lies on both the circle and the line. The radius $OP$ has gradient $\\frac12$, while the line has gradient $-2$.\n$$\\frac12\\times(-2)=-1.$$\nThus the radius is perpendicular to the line at $P$. The line is tangent to the circle, so there is exactly one intersection.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      }
    ]
  },
