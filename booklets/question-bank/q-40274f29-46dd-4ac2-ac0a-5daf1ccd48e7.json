        "children": [],
        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "Tangent: $y=-6x$. Normal: $y=\\frac16x$.",
          "worked": "$$\\begin{align*}f'(x)&=2x-6\\\\m_{\\mathrm t}&=f'(0)=-6\\\\m_{\\mathrm n}&=-\\frac1{-6}=\\frac16\\end{align*}$$\nTangent:\n$$\\begin{align*}y-0&=-6(x-0)\\\\y&=-6x\\end{align*}$$\nNormal:\n$$\\begin{align*}y-0&=\\frac16(x-0)\\\\y&=\\frac16x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
