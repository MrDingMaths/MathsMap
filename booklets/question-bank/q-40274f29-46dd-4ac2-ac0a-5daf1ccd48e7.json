            "src": null,
            "widthMm": 70,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 29,
              "sourceRegion": "Question 1(c), right",
              "description": "Unticked axes with cubic, horizontal tangent along the x-axis and vertical normal through the local minimum.",
              "mathematics": "Curve y=x^3-3x+2; tangent y=0; normal x=1.",
              "answerVisibility": "Source-supplied lines remain visible without equation labels."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
