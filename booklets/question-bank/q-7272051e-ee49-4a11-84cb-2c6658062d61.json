  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "By what factor must the radius of a spherical balloon be multiplied if the volume is to be increased from $760\\text{ cm}^3$ to $389\\,120\\text{ cm}^3$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8$",
      "worked": "Let $k$ be the factor multiplying the radius. Volume is multiplied by $k^3$.\n$$\\begin{align*}k^3&=\\frac{389\\,120}{760}\\\\k^3&=512\\\\k&=\\sqrt[3]{512}\\\\k&=8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
