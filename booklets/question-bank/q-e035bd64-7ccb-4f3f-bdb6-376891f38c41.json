      {
        "id": "p25-node-01-a",
        "type": "part",
        "label": "a",
        "prompt": "The domain of $y=f(x)+g(x)$ is $A\\cup B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. The domain is $A\\cap B$.",
          "worked": "Both $f(x)$ and $g(x)$ must be defined at the same input. Hence $x$ must belong to both $A$ and $B$, so the domain is $A\\cap B$. This is not generally $A\\cup B$, so the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p25-node-01-b",
        "type": "part",
        "label": "b",
        "prompt": "The domain of $y=f(x)+g(x)$ is $A\\cap B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True. Both functions must be defined.",
          "worked": "The allowable inputs satisfy both $x\\in A$ and $x\\in B$. These inputs form $A\\cap B$, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p25-node-01-c",
        "type": "part",
        "label": "c",
        "prompt": "The domain of $y=\\sqrt{f(x)}$ is $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. The domain is $\\{x\\in A:f(x)\\geq 0\\}$.",
          "worked": "The input must belong to $A$ so that $f(x)$ is defined. The square root also requires $f(x)\\geq 0$. Therefore the domain is $\\{x\\in A:f(x)\\geq 0\\}$. This may equal $A$ in a particular case, but the statement is false as a general rule.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p25-node-01-d",
        "type": "part",
        "label": "d",
        "prompt": "The domain of $y=\\frac{1}{g(x)}$ is $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. The domain is $\\{x\\in B:g(x)\\neq 0\\}$.",
          "worked": "The input must belong to $B$ so that $g(x)$ is defined. The denominator must also satisfy $g(x)\\neq 0$. Therefore the domain is $\\{x\\in B:g(x)\\neq 0\\}$. This may equal $B$ in a particular case, but the statement is false as a general rule.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
