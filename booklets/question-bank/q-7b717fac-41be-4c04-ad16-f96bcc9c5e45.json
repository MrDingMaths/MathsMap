  "content": {
    "id": "p26-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If pencils cost $\\$x$ each, write an expression for the cost of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "10 pencils",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10x$ dollars",
          "worked": "$\\begin{align*}\\text{Cost}&=10\\times x\\\\\\text{Cost}&=10x\\end{align*}$\nThe cost is $10x$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p26-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$k$ pencils",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$kx$ dollars",
          "worked": "$\\begin{align*}\\text{Cost}&=k\\times x\\\\\\text{Cost}&=kx\\end{align*}$\nThe cost is $kx$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p26-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "3 packets of pencils, if each packet contains 5 pencils",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15x$ dollars",
          "worked": "There are $3\\times5=15$ pencils.\n$\\begin{align*}\\text{Cost}&=15\\times x\\\\\\text{Cost}&=15x\\end{align*}$\nThe cost is $15x$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
