    "id": "v2-5bb25-p34-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "Find the possible values of the unknown in each vector.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-5bb25-p34-practice-slot-11-slot-11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Vector $\\underset{\\sim}{v}=ai-2j$ has magnitude $\\sqrt{13}$. Find $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm3$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{v}|&=\\sqrt{a^2+(-2)^2}=\\sqrt{13}\\\\a^2+4&=13\\\\a^2&=9\\\\a&=\\pm3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-5bb25-p34-practice-slot-11-slot-11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Vector $\\underset{\\sim}{w}=3i+bj$ has magnitude $7$. Find $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\pm2\\sqrt{10}$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{w}|&=\\sqrt{3^2+b^2}=7\\\\9+b^2&=49\\\\b^2&=40\\\\b&=\\pm2\\sqrt{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
