        "id": "p17-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Each exterior angle of a regular polygon is $15^{\\circ}$. Find the number of sides of the polygon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "24 sides",
          "worked": "$$\\begin{align*}15^{\\circ}&=\\frac{360^{\\circ}}{n}\\\\n&=\\frac{360^{\\circ}}{15^{\\circ}}\\\\n&=24\\end{align*}$$\n\nThe polygon has 24 sides.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the number of sides in a regular polygon with each exterior angle of $18^{\\circ}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 sides",
          "worked": "$$\\begin{align*}18^{\\circ}&=\\frac{360^{\\circ}}{n}\\\\n&=\\frac{360^{\\circ}}{18^{\\circ}}\\\\n&=20\\end{align*}$$\n\nThe polygon has 20 sides.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
