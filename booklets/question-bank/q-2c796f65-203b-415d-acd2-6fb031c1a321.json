  "content": {
    "id": "p2-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The ratio of the number of birds to the number of cats owned by people in a neighbourhood is 5 : 3. The number of cats is 96. How many birds are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$160$ birds",
      "worked": "$$\\begin{aligned}3\\text{ parts}&=96\\text{ cats}\\\\1\\text{ part}&=96\\div3=32\\\\5\\text{ parts}&=5\\times32=160.\\end{aligned}$$\nThere are $160$ birds.",
      "solutionDiagrams": []
    },
