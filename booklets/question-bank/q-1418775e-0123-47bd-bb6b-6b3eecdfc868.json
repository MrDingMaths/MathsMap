  "content": {
    "id": "v2-9f0a2-p19-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "A cyclist rides 40 km on the first day of a tour. On each following day she rides 4 km less than on the previous day. How far does she ride in total over 8 days?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$208$ km",
      "worked": "The daily distances form an AP with $a=40$, $d=-4$ and $n=8$.\n$$\\begin{align*}S_{8}&=\\frac{8}{2}\\left[2(40)+7(-4)\\right]\\\\S_{8}&=4(80-28)\\\\S_{8}&=4(52)\\\\S_{8}&=208\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
