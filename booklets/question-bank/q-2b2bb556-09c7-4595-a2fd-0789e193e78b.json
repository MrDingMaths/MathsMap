      {
        "id": "index-t2-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x^{7}}{x^{2}}\\quad\\text{and}\\quad\\frac{x^{2}}{x^{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{5},\\frac{1}{x^{5}}$",
          "worked": "$$\\begin{align*}\\frac{x^{7}}{x^{2}}&=x^{7-2} \\\\ &=x^{5}\\end{align*}$$\n\n$$\\begin{align*}\\frac{x^{2}}{x^{7}}&=\\frac1{x^{7-2}} \\\\ &=\\frac1{x^{5}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t2-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{a^{5}}{a^{3}}\\quad\\text{and}\\quad\\frac{a^{3}}{a^{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{2},\\frac{1}{a^{2}}$",
          "worked": "$$\\begin{align*}\\frac{a^{5}}{a^{3}}&=a^{5-3} \\\\ &=a^{2}\\end{align*}$$\n\n$$\\begin{align*}\\frac{a^{3}}{a^{5}}&=\\frac1{a^{5-3}} \\\\ &=\\frac1{a^{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t2-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{m^{4}}{m^{10}}\\quad\\text{and}\\quad\\frac{m^{10}}{m^{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{m^{6}},\\ m^{6}$",
          "worked": "$$\\begin{align*}\\frac{m^{4}}{m^{10}}&=\\frac1{m^{10-4}} \\\\ &=\\frac1{m^{6}}\\end{align*}$$\n\n$$\\begin{align*}\\frac{m^{10}}{m^{4}}&=m^{10-4} \\\\ &=m^{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t2-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{n^{12}}{n^{7}}\\quad\\text{and}\\quad\\frac{n^{7}}{n^{12}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^{5},\\frac{1}{n^{5}}$",
          "worked": "$$\\begin{align*}\\frac{n^{12}}{n^{7}}&=n^{12-7} \\\\ &=n^{5}\\end{align*}$$\n\n$$\\begin{align*}\\frac{n^{7}}{n^{12}}&=\\frac1{n^{12-7}} \\\\ &=\\frac1{n^{5}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t2-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{p^{15}}{p^{20}}\\quad\\text{and}\\quad\\frac{p^{20}}{p^{15}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{p^{5}},\\ p^{5}$",
          "worked": "$$\\begin{align*}\\frac{p^{15}}{p^{20}}&=\\frac1{p^{20-15}} \\\\ &=\\frac1{p^{5}}\\end{align*}$$\n\n$$\\begin{align*}\\frac{p^{20}}{p^{15}}&=p^{20-15} \\\\ &=p^{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t2-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{q}{q^{9}}\\quad\\text{and}\\quad\\frac{q^{9}}{q}$",
