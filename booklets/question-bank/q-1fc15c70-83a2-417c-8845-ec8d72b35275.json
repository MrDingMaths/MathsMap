    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q7-a-response",
        "type": "part",
        "label": "a",
        "prompt": "The factorisation is correct.\n\nWriting $x-4=7$ and $x+2=7$ is incorrect. Why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The null factor law applies only when the product equals zero.",
          "worked": "Here $(x-4)(x+2)=7$, so the null factor law does not apply. It applies only when the product equals zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q7-b-response",
        "type": "part",
        "label": "b",
        "prompt": "What do you need to do before you factorise?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rearrange so all terms are on one side and the other side is zero.",
          "worked": "Subtract $7$ from both sides to obtain $x^2-2x-15=0$ before factorising.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q7-c-response",
        "type": "part",
        "label": "c",
        "prompt": "Hence solve $x^2-2x-8=7$ correctly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$ or $x=-3$.",
          "worked": "$$\\begin{aligned}x^2-2x-15&=0\\\\(x-5)(x+3)&=0\\\\x-5&=0\\quad\\text{or}\\quad x+3=0\\\\x&=5\\quad\\text{or}\\quad x=-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
