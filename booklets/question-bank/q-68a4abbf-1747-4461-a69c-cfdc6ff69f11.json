      {
        "id": "p12-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{1/3}=3^{2/5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3^{6/5}$",
          "worked": "Raise both sides to the power of $3$.\n\n$$\\begin{align*}(x^{1/3})^3&=(3^{2/5})^3\\\\x&=3^{6/5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{5/2}=4^{2/3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4^{4/15}$",
          "worked": "Raise both sides to the power of $\\frac{2}{5}$.\n\n$$\\begin{align*}(x^{5/2})^{2/5}&=(4^{2/3})^{2/5}\\\\x&=4^{4/15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^{3/4}=5^{3/2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=25$",
          "worked": "Raise both sides to the power of $\\frac{4}{3}$.\n\n$$\\begin{align*}(x^{3/4})^{4/3}&=(5^{3/2})^{4/3}\\\\x&=5^2\\\\x&=25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p12-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[2]{x^3}=\\sqrt[3]{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2^{2/9}$",
          "worked": "Convert to index form, then raise both sides to the power of $\\frac{2}{3}$.\n\n$$\\begin{align*}x^{3/2}&=2^{1/3}\\\\(x^{3/2})^{2/3}&=(2^{1/3})^{2/3}\\\\x&=2^{2/9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
