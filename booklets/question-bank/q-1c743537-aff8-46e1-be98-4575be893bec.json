  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Each month Mrs Nguyen gives $\\$45$ in pocket money to her three children. The eldest is given $\\$10$ more than the youngest, and the middle child receives $\\$5$ more than the youngest. How much does the youngest child receive each month?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$10$ each month",
      "worked": "Let the youngest child receive $x$ dollars each month. The eldest receives $x+10$ dollars and the middle child receives $x+5$ dollars.\n$$\\begin{align*}x+(x+10)+(x+5)&=45\\\\3x+15&=45\\\\3x&=30\\\\x&=10\\end{align*}$$\nThe youngest child receives $\\$10$ each month.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
