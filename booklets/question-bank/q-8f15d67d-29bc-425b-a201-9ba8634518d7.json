  "content": {
    "id": "p35-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Mario worked for 17 days 18 hours in January, 28 days 21 hours in February and 25 days 3 hours in March. What was the total time he worked?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "71 days 18 hours",
      "worked": "$$\\begin{align*}\\text{Total days}&=17+28+25\\\\\\text{Total days}&=70\\\\\\text{Total hours}&=18+21+3\\\\\\text{Total hours}&=42\\end{align*}$$\n42 hours is 1 day 18 hours, since there are 24 hours in a day.\n$$\\begin{align*}\\text{Total time}&=70\\text{ days}+1\\text{ day}+18\\text{ hours}\\\\\\text{Total time}&=71\\text{ days }18\\text{ hours}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
