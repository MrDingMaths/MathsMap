  "content": {
    "id": "p19-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "$40\\%$ of a group of students are going to a concert, and $23\\%$ of the students going to the concert are also going to a party afterwards. What percentage of students go to both the concert and the party afterwards?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9.2\\%$",
      "worked": "The students attending both events are $23\\%$ of the $40\\%$ attending the concert.\n\n$$\\begin{align*}23\\%\\text{ of }40\\%&=\\frac{23}{100}\\times\\frac{40}{100}\\\\23\\%\\text{ of }40\\%&=\\frac{23}{250}\\\\23\\%\\text{ of }40\\%&=9.2\\%\\end{align*}$$\n\nTherefore, $9.2\\%$ of the group attend both events.",
      "solutionDiagrams": []
    },
