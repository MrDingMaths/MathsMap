  "content": {
    "id": "p6-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A sector has angle $50^\\circ$ and perimeter $2\\text{ m}$. Find its radius.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{36}{36+5\\pi}\\text{ m}$\n\nUse $2r+\\frac{50}{360}\\times2\\pi r=2$.",
      "worked": "$$\\begin{align*}2r+\\frac{50}{360}\\times2\\pi r&=2\\\\\\left(2+\\frac{5\\pi}{18}\\right)r&=2\\\\r&=\\frac{2}{2+\\frac{5\\pi}{18}}\\\\r&=\\frac{36}{36+5\\pi}\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
