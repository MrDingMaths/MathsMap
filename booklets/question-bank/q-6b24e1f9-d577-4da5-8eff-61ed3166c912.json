  "content": {
    "id": "p19-q81-root",
    "type": "question",
    "label": "81",
    "prompt": "Let $x=\\sec A-\\tan A$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q81-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x+\\frac{1}{x}=2\\sec A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+\\frac{1}{x}=2\\sec A$.\n\nUse $(\\sec A-\\tan A)(\\sec A+\\tan A)=1$ to obtain $\\frac{1}{x}=\\sec A+\\tan A$.",
          "worked": "Since $\\sec A$ and $\\tan A$ are defined, $\\cos A\\ne0$. Also $\\sec^2A-\\tan^2A=1$, so $x\\ne0$.\n$$\\begin{align*}\\frac{1}{x}&=\\frac{1}{\\sec A-\\tan A}\\\\\\frac{1}{x}&=\\frac{\\sec A+\\tan A}{\\sec^2A-\\tan^2A}\\\\\\frac{1}{x}&=\\sec A+\\tan A\\\\x+\\frac{1}{x}&=(\\sec A-\\tan A)+(\\sec A+\\tan A)\\\\x+\\frac{1}{x}&=2\\sec A.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p19-q81-b",
        "type": "part",
        "label": "b",
        "prompt": "Express $x-\\frac{1}{x}$ in terms of $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\tan A$.",
          "worked": "Using $\\frac{1}{x}=\\sec A+\\tan A$ from part (a),\n$$\\begin{align*}x-\\frac{1}{x}&=(\\sec A-\\tan A)-(\\sec A+\\tan A)\\\\x-\\frac{1}{x}&=-2\\tan A.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
