  "content": {
    "id": "p57-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Abdullah buys a scooter for \\$75. He later sells it for \\$60",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What loss does Abdullah make on the scooter?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$15",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=60-75\\\\&=-15\\end{align*}$$\nAbdullah makes a loss of \\$15.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p57-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage loss does he make?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20% loss",
          "worked": "$$\\begin{align*}\\text{Percentage profit/loss}&=\\frac{-15}{75}\\times100\\\\&=-20\\%\\end{align*}$$\nThe change is negative: 20% loss.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
