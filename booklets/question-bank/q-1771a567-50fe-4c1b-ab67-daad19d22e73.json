              "type": "math",
              "latex": "4\\text{ blue}=3\\text{ red}",
              "display": false
            }
          ]
        },
        {
          "id": "p18-q8-rate-red-green",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
