          "inlines": [
            {
              "type": "text",
              "text": "In the schoolyard marble market, marbles are valued according to their colour, and can be exchanged according to the following rates:",
              "marks": []
            }
          ]
        },
        {
          "id": "p18-q8-rate-blue-red",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
