            {
              "type": "math",
              "latex": "5\\text{ red}=6\\text{ green}",
              "display": false
            }
          ]
        },
        {
          "id": "p18-q8-rate-green-yellow",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
