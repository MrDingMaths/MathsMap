    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q8a",
        "type": "part",
        "label": "a",
        "prompt": "If Darcy has 30 yellow marbles, then how many green marbles can he obtain?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "45 green marbles.",
          "worked": "$$\\begin{align*}\\text{Green marbles}&=30\\times\\frac{3}{2}\\\\\\text{Green marbles}&=45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q8b",
        "type": "part",
        "label": "b",
        "prompt": "If Darcy has 60 blue marbles, then how many green marbles can he obtain?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "54 green marbles.",
          "worked": "$$\\begin{align*}\\text{Green marbles}&=60\\times\\frac{3}{4}\\times\\frac{6}{5}\\\\\\text{Green marbles}&=54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q8c",
        "type": "part",
        "label": "c",
        "prompt": "If Darcy has 180 yellow marbles, then how many blue marbles can he obtain?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "300 blue marbles.",
          "worked": "$$\\begin{align*}\\text{Blue marbles}&=180\\times\\frac{3}{2}\\times\\frac{5}{6}\\times\\frac{4}{3}\\\\\\text{Blue marbles}&=300\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q8d",
        "type": "part",
        "label": "d",
        "prompt": "What is the exchange rate between red and yellow marbles?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\text{ red}=4\\text{ yellow}$.",
          "worked": "Five red marbles exchange for six green marbles. Six green marbles exchange for four yellow marbles.\n\n$$5\\text{ red}=4\\text{ yellow}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q8e",
        "type": "part",
        "label": "e",
        "prompt": "What is the exchange rate between blue and yellow marbles?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\text{ blue}=3\\text{ yellow}$.",
          "worked": "Twenty blue marbles exchange for fifteen red marbles, then eighteen green marbles, then twelve yellow marbles.\n\n$$\\begin{align*}20\\text{ blue}&=12\\text{ yellow}\\\\5\\text{ blue}&=3\\text{ yellow}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
