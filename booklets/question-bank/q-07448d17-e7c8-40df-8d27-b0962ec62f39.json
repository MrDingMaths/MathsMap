  "content": {
    "id": "p20-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Given $h(x)=3x+19$ and $k(x)=2x-10$, work out the value of $x$ for which $h^{-1}(x)=k^{-1}(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p20-q14-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x=-68",
                "display": false
              }
            ]
          }
        ]
      },
      "worked": "For $h$:\n$$\\begin{align*}y&=3x+19\\\\x&=3y+19\\\\y&=\\frac{x-19}{3}\\\\h^{-1}(x)&=\\frac{x-19}{3}\\end{align*}$$\nFor $k$:\n$$\\begin{align*}y&=2x-10\\\\x&=2y-10\\\\y&=\\frac{x+10}{2}\\\\k^{-1}(x)&=\\frac{x+10}{2}\\end{align*}$$\nEquating the inverses:\n$$\\begin{align*}\\frac{x-19}{3}&=\\frac{x+10}{2}\\\\2x-38&=3x+30\\\\x&=-68\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 77
  },
