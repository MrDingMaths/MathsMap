  "content": {
    "id": "p19-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The quadratic $f(x)=a(x+1)^2+b(x+1)+c$ has the same graph as $g(x)=2x^2+3x-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Compare the coefficients of $x^2$ to find the value of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$",
          "worked": "The coefficient of $x^2$ in $f(x)$ is $a$, and in $g(x)$ it is $2$. Hence $a=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p19-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute $x=-1$ to find the value of $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=-2$",
          "worked": "At $x=-1$, both terms containing $(x+1)$ vanish.\n$$\\begin{align*}c&=2(-1)^2+3(-1)-1\\\\c&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Substitute another suitable value of $x$ to determine $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ gives $b=-1$.",
          "worked": "Substitute $x=0$, using $a=2$ and $c=-2$.\n$$\\begin{align*}2(0+1)^2+b(0+1)-2&=2(0)^2+3(0)-1\\\\b&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Write down the resulting quadratic identity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2+3x-1=2(x+1)^2-(x+1)-2$",
          "worked": "Substitute $a=2$, $b=-1$ and $c=-2$:\n$$2x^2+3x-1=2(x+1)^2-(x+1)-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
