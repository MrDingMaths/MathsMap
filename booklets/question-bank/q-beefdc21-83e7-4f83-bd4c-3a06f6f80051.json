    "children": [
      {
        "id": "p9-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$3(x+3)=6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "$$\\begin{align*}3x+9&=6x\\\\9&=3x\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p9-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x+3}{3}=6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{17}$",
          "worked": "$$\\begin{align*}x+3&=18x\\\\3&=17x\\\\x&=\\frac{3}{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p9-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x+3}{3}+\\frac{x+3}{6}=6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{11}$",
          "worked": "$$\\begin{align*}\\frac{2(x+3)}{6}+\\frac{x+3}{6}&=6x\\\\\\frac{2x+6+x+3}{6}&=6x\\\\\\frac{3x+9}{6}&=6x\\\\3x+9&=36x\\\\9&=33x\\\\x&=\\frac{3}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p9-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x+3}{3}-\\frac{x+3}{6}=6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{35}$",
          "worked": "$$\\begin{align*}\\frac{2(x+3)}{6}-\\frac{x+3}{6}&=6x\\\\\\frac{2x+6-x-3}{6}&=6x\\\\\\frac{x+3}{6}&=6x\\\\x+3&=36x\\\\3&=35x\\\\x&=\\frac{3}{35}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
