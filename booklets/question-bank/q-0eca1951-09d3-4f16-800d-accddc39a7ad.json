  "content": {
    "id": "v2-383dbf-p4-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Priya spent one-fifth of her savings on a book and one-third of her savings on a bike helmet. She had $\\$56$ left. How much were her savings?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$120$",
      "worked": "Let her savings be $x$ dollars.\n$$\\begin{align*}x-\\frac{x}{5}-\\frac{x}{3}&=56\\\\\\frac{15x}{15}-\\frac{3x}{15}-\\frac{5x}{15}&=56\\\\\\frac{7x}{15}&=56\\\\7x&=840\\\\x&=120\\end{align*}$$\nHer savings were $\\$120$.",
      "solutionDiagrams": []
    },
