  "content": {
    "id": "p19-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Looksmart Shirts charges $\\$60$ for one shirt and $\\$50$ for each shirt after this.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find, as a function of $n$, the cost $C$ in dollars of $n$ shirts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C(n)=50n+10$ dollars.",
          "worked": "There are $n-1$ shirts after the first shirt.\n$$\\begin{align*}C(n)&=60+50(n-1)\\\\C(n)&=60+50n-50\\\\C(n)&=50n+10.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q12-b",
        "type": "group",
        "label": "b",
        "prompt": "Delivery costs $\\$10$ for one shirt and $\\$2$ for each subsequent shirt.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q12-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Find, as a function of $n$, the cost $D$ in dollars of delivering $n$ shirts.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$D(n)=2n+8$ dollars.",
              "worked": "There are $n-1$ subsequent shirts.\n$$\\begin{align*}D(n)&=10+2(n-1)\\\\D(n)&=10+2n-2\\\\D(n)&=2n+8.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p19-q12-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find, as a function of $n$, the total cost $T$ in dollars of buying $n$ shirts and having them delivered.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$T(n)=52n+18$ dollars.",
              "worked": "$$\\begin{align*}T(n)&=C(n)+D(n)\\\\T(n)&=(50n+10)+(2n+8)\\\\T(n)&=52n+18.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      }
    ]
  },
