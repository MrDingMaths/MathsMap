              "type": "text",
              "text": "Find the equation of the tangent and normal to the following at the given point.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-ep-10",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^3$ at $x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=3x-2$. Normal: $y=-\\frac{x}{3}+\\frac{4}{3}$.",
          "worked": "At $x=1$, the point is $(1,1)$.\n$$\\begin{align*}y'&=3x^2\\\\y'(1)&=3\\\\y-1&=3(x-1)\\\\y&=3x-2\\end{align*}$$\nThe normal gradient is $-\\frac13$.\n$$\\begin{align*}y-1&=-\\frac13(x-1)\\\\y&=-\\frac{x}{3}+\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p47-ep-11",
        "type": "part",
        "label": "b",
        "prompt": "$y=2x^2-3$ at $x=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=-4x-5$. Normal: $y=\\frac{x}{4}-\\frac34$.",
          "worked": "At $x=-1$, the point is $(-1,-1)$.\n$$\\begin{align*}y'&=4x\\\\y'(-1)&=-4\\\\y+1&=-4(x+1)\\\\y&=-4x-5\\end{align*}$$\nThe normal gradient is $\\frac14$.\n$$\\begin{align*}y+1&=\\frac14(x+1)\\\\y&=\\frac{x}{4}-\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p47-ep-12",
        "type": "part",
        "label": "c",
        "prompt": "$y=(2x-1)^3$ at $x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=6x-5$. Normal: $y=-\\frac{x}{6}+\\frac76$.",
          "worked": "At $x=1$, the point is $(1,1)$.\n$$\\begin{align*}y'&=6(2x-1)^2\\\\y'(1)&=6\\\\y-1&=6(x-1)\\\\y&=6x-5\\end{align*}$$\nThe normal gradient is $-\\frac16$.\n$$\\begin{align*}y-1&=-\\frac16(x-1)\\\\y&=-\\frac{x}{6}+\\frac76\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p47-ep-13",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{x+1}{x+2}$ at $x=-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=x+5$. Normal: $y=-x-1$.",
          "worked": "At $x=-3$, the point is $(-3,2)$.\n$$\\begin{align*}y'&=\\frac{(x+2)-(x+1)}{(x+2)^2}\\\\y'&=\\frac{1}{(x+2)^2}\\\\y'(-3)&=1\\\\y-2&=x+3\\\\y&=x+5\\end{align*}$$\nThe normal gradient is $-1$.\n$$\\begin{align*}y-2&=-(x+3)\\\\y&=-x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      }
    ]
