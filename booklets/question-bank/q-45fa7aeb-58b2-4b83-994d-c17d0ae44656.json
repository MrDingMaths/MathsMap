  "content": {
    "id": "p40-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A plumber says that the cost, in dollars, to hire her for $x$ hours is $50+60x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "What is her call-out fee?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$50",
          "worked": "The constant term $50$ is charged regardless of the hours worked, so the call-out fee is \\$50.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p40-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How much does she charge an hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$60 per hour",
          "worked": "The coefficient of $x$ is $60$, so she charges \\$60 per hour.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p40-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "How much would it cost to hire her for 4.5 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$320",
          "worked": "$$\\begin{align*}\\text{Cost}&=50+60(4.5)\\\\\\text{Cost}&=50+270\\\\\\text{Cost}&=320\\end{align*}$$\nThe cost is \\$320.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "How much would it cost to hire her for 9 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$590",
          "worked": "$$\\begin{align*}\\text{Cost}&=50+60(9)\\\\&=50+540\\\\&=590\\end{align*}$$\nThe cost is \\$590.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "How much less is this than twice the cost of hiring her for 4.5 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$50",
          "worked": "$$\\begin{align*}2(320)-590&=640-590\\\\&=50\\end{align*}$$\nIt is \\$50 less.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "Explain why the difference equals the call-out fee.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Doubling the 4.5-hour total counts the call-out fee twice; one nine-hour job includes it once.",
          "worked": "Doubling the 4.5-hour total doubles the hourly charge and counts the \\$50 call-out fee twice. One nine-hour job includes the same hourly charge but only one call-out fee, so the difference is \\$50.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
