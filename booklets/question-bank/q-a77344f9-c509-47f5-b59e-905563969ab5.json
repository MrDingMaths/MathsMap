  "content": {
    "id": "p12-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Evaluate these expressions for $a=\\frac{3}{7}$ and $b=\\frac{7}{8}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$b-a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{56}$",
          "worked": "$$\\begin{align*}b-a&=\\frac{7}{8}-\\frac{3}{7}\\\\b-a&=\\frac{49}{56}-\\frac{24}{56}\\\\b-a&=\\frac{25}{56}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$2a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6}{7}$",
          "worked": "$$\\begin{align*}2a&=2\\times\\frac{3}{7}\\\\2a&=\\frac{6}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$2b-2a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{28}$",
          "worked": "$$\\begin{align*}2b-2a&=2\\times\\frac{7}{8}-2\\times\\frac{3}{7}\\\\2b-2a&=\\frac{7}{4}-\\frac{6}{7}\\\\2b-2a&=\\frac{49}{28}-\\frac{24}{28}\\\\2b-2a&=\\frac{25}{28}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$3(a+b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac{51}{56}$",
          "worked": "$$\\begin{align*}3(a+b)&=3\\left(\\frac{3}{7}+\\frac{7}{8}\\right)\\\\3(a+b)&=3\\left(\\frac{24}{56}+\\frac{49}{56}\\right)\\\\3(a+b)&=3\\times\\frac{73}{56}\\\\3(a+b)&=\\frac{219}{56}\\\\3(a+b)&=3\\frac{51}{56}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p12-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{2}(a+b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{73}{112}$",
          "worked": "$$\\begin{align*}\\frac12(a+b)&=\\frac12\\left(\\frac37+\\frac78\\right)\\\\\\frac12(a+b)&=\\frac12\\left(\\frac{24}{56}+\\frac{49}{56}\\right)\\\\\\frac12(a+b)&=\\frac12\\times\\frac{73}{56}\\\\\\frac12(a+b)&=\\frac{73}{112}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$b\\div a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\frac{1}{24}$",
          "worked": "$$\\begin{align*}b\\div a&=\\frac78\\div\\frac37\\\\b\\div a&=\\frac78\\times\\frac73\\\\b\\div a&=\\frac{49}{24}\\\\b\\div a&=2\\frac{1}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$a^2+b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2977}{3136}$",
          "worked": "$$\\begin{align*}a^2+b^2&=\\left(\\frac37\\right)^2+\\left(\\frac78\\right)^2\\\\a^2+b^2&=\\frac9{49}+\\frac{49}{64}\\\\a^2+b^2&=\\frac{576}{3136}+\\frac{2401}{3136}\\\\a^2+b^2&=\\frac{2977}{3136}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$5-b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\frac18$",
          "worked": "$$\\begin{align*}5-b&=5-\\frac78\\\\5-b&=\\frac{40}{8}-\\frac78\\\\5-b&=4\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
