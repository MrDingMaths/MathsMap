    "type": "question",
    "label": "4",
    "prompt": "Solve each of the following equations:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^n+2^n=4^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=1$",
          "worked": "$$\\begin{align*}2\\times2^n&=(2^2)^n\\\\2^{n+1}&=2^{2n}\\\\n+1&=2n\\\\n&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p15-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$4^n+4^n+4^n+4^n=2^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-2$",
          "worked": "$$\\begin{align*}4\\times4^n&=2^n\\\\2^2\\times2^{2n}&=2^n\\\\2^{2n+2}&=2^n\\\\2n+2&=n\\\\n&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^{2n}+3^{2n}+3^{2n}=27^{n+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-2$",
          "worked": "$$\\begin{align*}3\\times3^{2n}&=(3^3)^{n+1}\\\\3^{2n+1}&=3^{3n+3}\\\\2n+1&=3n+3\\\\-n&=2\\\\n&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
