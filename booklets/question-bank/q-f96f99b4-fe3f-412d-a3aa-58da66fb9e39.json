    "children": [
      {
        "id": "p15-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x^2+x}+\\dfrac{1}{x^2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{x^2-1}$",
          "worked": "$$\\begin{align*}\\frac{1}{x^2+x}+\\frac{1}{x^2-x}&=\\frac{1}{x(x+1)}+\\frac{1}{x(x-1)}\\\\\\frac{1}{x^2+x}+\\frac{1}{x^2-x}&=\\frac{(x-1)+(x+1)}{x(x+1)(x-1)}\\\\\\frac{1}{x^2+x}+\\frac{1}{x^2-x}&=\\frac{2}{x^2-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{x^2-4}+\\dfrac{1}{x^2-4x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x}{(x-2)^2(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x^2-4}+\\frac{1}{x^2-4x+4}&=\\frac{1}{(x-2)(x+2)}+\\frac{1}{(x-2)^2}\\\\\\frac{1}{x^2-4}+\\frac{1}{x^2-4x+4}&=\\frac{(x-2)+(x+2)}{(x-2)^2(x+2)}\\\\\\frac{1}{x^2-4}+\\frac{1}{x^2-4x+4}&=\\frac{2x}{(x-2)^2(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{x-y}+\\dfrac{2x-y}{x^2-y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x}{x^2-y^2}$",
          "worked": "$$\\begin{align*}\\frac{1}{x-y}+\\frac{2x-y}{x^2-y^2}&=\\frac{x+y}{(x-y)(x+y)}+\\frac{2x-y}{(x-y)(x+y)}\\\\\\frac{1}{x-y}+\\frac{2x-y}{x^2-y^2}&=\\frac{x+y+2x-y}{(x-y)(x+y)}\\\\\\frac{1}{x-y}+\\frac{2x-y}{x^2-y^2}&=\\frac{3x}{x^2-y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3}{x^2+2x-8}-\\dfrac{2}{x^2+x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{(x-2)(x+3)(x+4)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x^2+2x-8}-\\frac{2}{x^2+x-6}&=\\frac{3}{(x+4)(x-2)}-\\frac{2}{(x+3)(x-2)}\\\\\\frac{3}{x^2+2x-8}-\\frac{2}{x^2+x-6}&=\\frac{3(x+3)-2(x+4)}{(x-2)(x+3)(x+4)}\\\\\\frac{3}{x^2+2x-8}-\\frac{2}{x^2+x-6}&=\\frac{x+1}{(x-2)(x+3)(x+4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p15-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x}{a^2-b^2}-\\dfrac{x}{a^2+ab}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{bx}{a(a-b)(a+b)}$",
          "worked": "$$\\begin{align*}\\frac{x}{a^2-b^2}-\\frac{x}{a^2+ab}&=\\frac{x}{(a-b)(a+b)}-\\frac{x}{a(a+b)}\\\\\\frac{x}{a^2-b^2}-\\frac{x}{a^2+ab}&=\\frac{ax-x(a-b)}{a(a-b)(a+b)}\\\\\\frac{x}{a^2-b^2}-\\frac{x}{a^2+ab}&=\\frac{bx}{a(a-b)(a+b)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1}{x^2-4x+3}+\\dfrac{1}{x^2-5x+6}-\\dfrac{1}{x^2-3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{(x-1)(x-2)(x-3)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x^2-4x+3}+\\frac{1}{x^2-5x+6}-\\frac{1}{x^2-3x+2}&=\\frac{1}{(x-1)(x-3)}+\\frac{1}{(x-2)(x-3)}-\\frac{1}{(x-1)(x-2)}\\\\\\frac{1}{x^2-4x+3}+\\frac{1}{x^2-5x+6}-\\frac{1}{x^2-3x+2}&=\\frac{(x-2)+(x-1)-(x-3)}{(x-1)(x-2)(x-3)}\\\\\\frac{1}{x^2-4x+3}+\\frac{1}{x^2-5x+6}-\\frac{1}{x^2-3x+2}&=\\frac{x}{(x-1)(x-2)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
