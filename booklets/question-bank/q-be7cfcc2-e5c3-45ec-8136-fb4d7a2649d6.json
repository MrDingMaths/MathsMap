    "type": "question",
    "label": "10",
    "prompt": "A job has a normal working hours pay rate of \\$9.20 per hour. Calculate the pay for 13 hours at normal pay and 6 hours at time and a half.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$202.40",
      "worked": "$\\begin{align*}\\text{Normal pay}&=9.20\\times13\\\\\\text{Normal pay}&=\\$119.60\\\\\\text{Overtime pay}&=9.20\\times6\\times1.5\\\\\\text{Overtime pay}&=\\$82.80\\\\\\text{Total pay}&=119.60+82.80\\\\\\text{Total pay}&=\\$202.40\\end{align*}$",
      "solutionDiagrams": []
    },
