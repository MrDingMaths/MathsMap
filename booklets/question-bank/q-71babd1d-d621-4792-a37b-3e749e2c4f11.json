  "content": {
    "id": "p68-q13-response",
    "type": "question",
    "label": null,
    "prompt": "A ball is thrown upwards. Its height at time $t$ seconds is given by $h(t)=-5t^2+20t+2$. Find the maximum height reached by the ball.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$22\\text{ m}$.",
      "worked": "$$h(t)=-5t(t-4)+2$$\nSince $h(0)=h(4)=2$, the axis of symmetry is halfway between $t=0$ and $t=4$, at $t=2$. The parabola is concave down, so this gives the maximum.\n$$\\begin{align*}h(2)&=-5(2)^2+20(2)+2\\\\h(2)&=22\\end{align*}$$\nThe maximum height is $22\\text{ m}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
