  "content": {
    "id": "p19-q2-root",
    "type": "question",
    "label": "3",
    "prompt": "Suppose $y$ varies inversely with $x$. If $y=8$ when $x=2$, find the constant of variation and calculate $x$ when $y=10$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=16$; $x=1.6$.",
      "worked": "$$\\begin{align*}y&=\\frac{k}{x}\\\\8&=\\frac{k}{2}\\\\k&=16\\\\10&=\\frac{16}{x}\\\\x&=\\frac{16}{10}\\\\x&=1.6\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
