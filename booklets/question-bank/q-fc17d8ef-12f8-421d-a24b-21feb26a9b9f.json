  "content": {
    "id": "p19-q10-content",
    "type": "question",
    "label": "10",
    "prompt": "The area of rectangle $ABCD$ is 16 cm². The length of BA is $x$ cm.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p19-q10-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 19, p19-q10-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,draw=black,line width=0.8pt,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont,inner sep=0pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (0,2.8);\n\\coordinate (C) at (4.8,2.8);\n\\coordinate (D) at (4.8,0);\n\\draw (A)--(B)--(C)--(D)--cycle;\n\\node[anchor=north east,xshift=-2pt,yshift=-4pt] at (A) {$A$};\n\\node[anchor=south east,xshift=-2pt,yshift=4pt] at (B) {$B$};\n\\node[anchor=south west,xshift=2pt,yshift=4pt] at (C) {$C$};\n\\node[anchor=north west,xshift=2pt,yshift=-4pt] at (D) {$D$};\n\\node[anchor=east,xshift=-4pt] at (0,1.4) {$x\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 48,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 19,
          "sourceRegion": "Question 10, upper-left rectangle beneath the shared stem and left of part a.",
          "description": "Unfilled horizontal rectangle with A bottom left, B top left, C top right and D bottom right. All vertex labels lie outside their corners. Side BA is labelled x cm outside the left edge.",
          "mathematics": "ABCD is a rectangle. The prompt supplies area 16 cm² and BA = x cm. Drawing coordinates preserve schematic proportions only and do not supply measurements.",
          "answerVisibility": "Permanent question figure; no answers or derived dimensions appear."
        },
