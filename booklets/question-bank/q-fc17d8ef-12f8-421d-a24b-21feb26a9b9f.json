    "children": [
      {
        "id": "p19-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of $BC$, in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$BC=\\dfrac{16}{x}\\text{ cm}$",
          "worked": "$$\\begin{align*}x\\times BC&=16\\\\BC&=\\frac{16}{x}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down an expression for the perimeter of the rectangle, in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\left(x+\\dfrac{16}{x}\\right)=2x+\\dfrac{32}{x}\\text{ cm}$",
          "worked": "$$\\begin{align*}P&=2\\left(x+\\frac{16}{x}\\right)\\\\P&=2(x)+2\\left(\\frac{16}{x}\\right)\\\\P&=2x+\\frac{32}{x}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "If $x=4$, find the perimeter of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\text{ cm}$",
          "worked": "$$\\begin{align*}P&=2(4)+\\frac{32}{4}\\\\P&=8+8\\\\P&=16\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "If $x=\\dfrac{1}{4}$, find the perimeter of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$128\\dfrac{1}{2}\\text{ cm}$",
          "worked": "$$\\begin{align*}P&=2\\left(\\frac{1}{4}\\right)+\\frac{32}{\\frac{1}{4}}\\\\P&=\\frac{1}{2}+128\\\\P&=128\\frac{1}{2}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
