  "content": {
    "id": "p41-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Consider $x^{2}-2ax+4=0$, where $a$ is a constant.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the solutions in terms of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a\\pm\\sqrt{a^{2}-4}$ for $a\\leq-2$ or $a\\geq2$. No real solutions for $-2<a<2$.",
          "worked": "By completing the square:\n$$\\begin{align*}x^{2}-2ax+a^{2}-a^{2}+4&=0\\\\(x-a)^{2}&=a^{2}-4\\\\x-a&=\\pm\\sqrt{a^{2}-4}\\\\x&=a\\pm\\sqrt{a^{2}-4}\\end{align*}$$\nReal solutions require $a^{2}-4\\geq0$, so $a\\leq-2$ or $a\\geq2$. For $-2<a<2$, there are no real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p41-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that, whenever real solutions exist, the product of the solutions is always a constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The product is $a^{2}-(a^{2}-4)=4$, independent of $a$.",
          "worked": "Using the difference of two squares:\n$$\\begin{align*}\\left(a+\\sqrt{a^{2}-4}\\right)\\left(a-\\sqrt{a^{2}-4}\\right)&=a^{2}-(a^{2}-4)\\\\&=4\\end{align*}$$\nThe product is always $4$, independent of $a$, whenever real solutions exist.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
