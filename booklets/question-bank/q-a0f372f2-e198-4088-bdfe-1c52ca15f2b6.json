  "content": {
    "id": "v2-3cf9e-p17-practice-slot-4-upper-root",
    "type": "question",
    "label": null,
    "prompt": "An irregular polygon has two exterior angles three times the size of the others.\nIf the other exterior angles are $12^{\\circ}$, find the number of sides.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "26 sides.",
      "worked": "Each larger exterior angle is $3\\times12^{\\circ}=36^{\\circ}$. Let $n$ be the number of sides.\n$$\\begin{align*}2(36)+12(n-2)&=360\\\\72+12(n-2)&=360\\\\12(n-2)&=288\\\\n-2&=24\\\\n&=26\\end{align*}$$\nThe polygon has 26 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
