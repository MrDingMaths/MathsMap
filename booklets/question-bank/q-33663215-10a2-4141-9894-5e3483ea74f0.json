  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the prime factorisation of 511. Hint: $512=8^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$511=7\\times73$.",
          "worked": "$$\\begin{align*}511&=8^3-1^3\\\\511&=(8-1)(8^2+8+1)\\\\511&=7\\times73\\end{align*}$$\nBoth 7 and 73 are prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Similarly, find the prime factorisation of 513.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$513=3^3\\times19$.",
          "worked": "$$\\begin{align*}513&=8^3+1^3\\\\513&=(8+1)(8^2-8+1)\\\\513&=9\\times57\\\\513&=3^3\\times19\\end{align*}$$\nBoth 3 and 19 are prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
