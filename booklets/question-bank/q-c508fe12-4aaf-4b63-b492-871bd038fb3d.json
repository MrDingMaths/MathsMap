  "content": {
    "id": "p16-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "If $a:b=3:2$ and $a+b=8$, then find the values of $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=\\frac{24}{5}$ and $b=\\frac{16}{5}$.",
      "worked": "There are $3+2=5$ parts in total, so one part is $\\frac{8}{5}$.\n$$\\begin{align*}a&=3\\times\\frac{8}{5}\\\\a&=\\frac{24}{5}\\\\b&=2\\times\\frac{8}{5}\\\\b&=\\frac{16}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
