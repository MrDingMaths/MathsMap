        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.9$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(4-(-4))^2+(3-(-1))^2}\\\\d&=\\sqrt{80}\\\\d&\\approx8.9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$A(5,-12),\\ B(0,0)$",
