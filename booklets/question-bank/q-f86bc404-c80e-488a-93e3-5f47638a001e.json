  "content": {
    "id": "p12-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the length, or distance, of each interval. Answer to 1 d.p. where necessary.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(1,4),\\ B(5,1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(5-1)^2+(1-4)^2}\\\\d&=\\sqrt{16+9}\\\\d&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(-2,7),\\ B(3,-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(3-(-2))^2+(-5-7)^2}\\\\d&=\\sqrt{25+144}\\\\d&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(-5,-2),\\ B(3,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(3-(-5))^2+(4-(-2))^2}\\\\d&=\\sqrt{64+36}\\\\d&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(3,6),\\ B(5,4)$",
        "layout": "list",
