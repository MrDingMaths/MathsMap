        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.8$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(5-3)^2+(4-6)^2}\\\\d&=\\sqrt{8}\\\\d&\\approx2.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$A(-4,-1),\\ B(4,3)$",
