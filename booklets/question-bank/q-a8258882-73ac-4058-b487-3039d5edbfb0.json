        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\,000\\text{ mm}^3$",
          "worked": "$$\\begin{align*}V&=lwh\\\\V&=20\\times30\\times50\\\\V&=30\\,000\\text{ mm}^3\\end{align*}$$",
          "solutionDiagrams": []
