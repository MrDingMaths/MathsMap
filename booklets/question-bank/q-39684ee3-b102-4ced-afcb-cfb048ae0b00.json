  "content": {
    "id": "p14-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "State the natural domain of each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{x}{\\sqrt{x+2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-2$.",
          "worked": "The square root is in the denominator, so its radicand must be strictly positive.\n$$\\begin{align*}x+2&>0\\\\x&>-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{2}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R}\\setminus\\{-2,2\\}$.",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x^2-4&\\ne0\\\\(x-2)(x+2)&\\ne0\\end{align*}$$\nHence the natural domain is all real $x$ except $-2$ and $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{1}{x^2+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R}\\setminus\\{-1,0\\}$.",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x^2+x&\\ne0\\\\x(x+1)&\\ne0\\end{align*}$$\nHence the natural domain is all real $x$ except $-1$ and $0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{1}{x^2-5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R}\\setminus\\{2,3\\}$.",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x^2-5x+6&\\ne0\\\\(x-2)(x-3)&\\ne0\\end{align*}$$\nHence the natural domain is all real $x$ except $2$ and $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\sqrt{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le-2$ or $x\\ge2$.",
          "worked": "The radicand must be non-negative.\n$$\\begin{align*}x^2-4&\\ge0\\\\(x-2)(x+2)&\\ge0\\end{align*}$$\nThe product is non-negative outside the roots, including the roots. Thus the natural domain is $x\\le-2$ or $x\\ge2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p14-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\dfrac{1}{\\sqrt{1-x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1<x<1$.",
          "worked": "The square root is in the denominator, so its radicand must be strictly positive.\n$$\\begin{align*}1-x^2&>0\\\\x^2&<1\\end{align*}$$\nThus the natural domain is $-1<x<1$; the endpoints would give a zero denominator.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
