  "content": {
    "id": "p34-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{4}{(x+1)^2}-\\dfrac{3}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1-3x}{(x+1)^2}$",
          "worked": "$$\\begin{aligned}\\frac{4}{(x+1)^2}-\\frac{3}{x+1}&=\\frac{4-3(x+1)}{(x+1)^2}\\\\&=\\frac{4-3x-3}{(x+1)^2}\\\\&=\\frac{1-3x}{(x+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p34-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2}{(x+3)^2}-\\dfrac{4}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-4x-10}{(x+3)^2}$",
          "worked": "$$\\begin{aligned}\\frac{2}{(x+3)^2}-\\frac{4}{x+3}&=\\frac{2-4(x+3)}{(x+3)^2}\\\\&=\\frac{2-4x-12}{(x+3)^2}\\\\&=\\frac{-4x-10}{(x+3)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p34-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3}{x-2}+\\dfrac{4}{(x-2)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x-2}{(x-2)^2}$",
          "worked": "$$\\begin{aligned}\\frac{3}{x-2}+\\frac{4}{(x-2)^2}&=\\frac{3(x-2)+4}{(x-2)^2}\\\\&=\\frac{3x-6+4}{(x-2)^2}\\\\&=\\frac{3x-2}{(x-2)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p34-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3x}{(x-1)^2}+\\dfrac{2}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x-2}{(x-1)^2}$",
          "worked": "$$\\begin{aligned}\\frac{3x}{(x-1)^2}+\\frac{2}{x-1}&=\\frac{3x+2(x-1)}{(x-1)^2}\\\\&=\\frac{3x+2x-2}{(x-1)^2}\\\\&=\\frac{5x-2}{(x-1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p34-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3x+2}{3x}+\\dfrac{7}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{19x+8}{12x}$",
          "worked": "$$\\begin{aligned}\\frac{3x+2}{3x}+\\frac{7}{12}&=\\frac{4(3x+2)}{12x}+\\frac{7x}{12x}\\\\&=\\frac{12x+8+7x}{12x}\\\\&=\\frac{19x+8}{12x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p34-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{2x-1}{4}+\\dfrac{2-3x}{10x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10x^2-11x+4}{20x}$",
          "worked": "$$\\begin{aligned}\\frac{2x-1}{4}+\\frac{2-3x}{10x}&=\\frac{5x(2x-1)}{20x}+\\frac{2(2-3x)}{20x}\\\\&=\\frac{5x(2x-1)+2(2-3x)}{20x}\\\\&=\\frac{10x^2-5x+4-6x}{20x}\\\\&=\\frac{10x^2-11x+4}{20x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p34-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{3}{4-x}-\\dfrac{2x}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(2x+1)(x-3)}{(4-x)(x-1)}$",
          "worked": "$$\\begin{aligned}\\frac{3}{4-x}-\\frac{2x}{x-1}&=\\frac{3(x-1)-2x(4-x)}{(4-x)(x-1)}\\\\&=\\frac{3x-3-8x+2x^2}{(4-x)(x-1)}\\\\&=\\frac{2x^2-5x-3}{(4-x)(x-1)}\\\\&=\\frac{(2x+1)(x-3)}{(4-x)(x-1)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p34-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x}{x+1}-\\dfrac{5x+1}{(x+1)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2-4x-1}{(x+1)^2}$",
          "worked": "$$\\begin{aligned}\\frac{x}{x+1}-\\frac{5x+1}{(x+1)^2}&=\\frac{x(x+1)-(5x+1)}{(x+1)^2}\\\\&=\\frac{x^2+x-5x-1}{(x+1)^2}\\\\&=\\frac{x^2-4x-1}{(x+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
