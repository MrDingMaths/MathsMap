  "content": {
    "id": "v2-612b9b-p5-practice-retro-slot-2-225238-root",
    "type": "question",
    "label": null,
    "prompt": "In each case, find who has the higher rate, and by how much.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-612b9b-p5-practice-retro-slot-2-225238-retro-slot-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Mia types 450 words in 5 minutes. Liam types 1000 words in 8 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Liam by $35\\text{ words/min}$",
          "worked": "Mia:\n$$\\frac{450\\text{ words}}{5\\text{ min}}=\\frac{90\\text{ words}}{1\\text{ min}}=90\\text{ words/min}$$\nLiam:\n$$\\frac{1000\\text{ words}}{8\\text{ min}}=\\frac{125\\text{ words}}{1\\text{ min}}=125\\text{ words/min}$$\nDifference:\n$$125-90=35$$\nLiam types faster by $35\\text{ words/min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-612b9b-p5-practice-retro-slot-2-225238-retro-slot-2-b",
        "type": "part",
        "label": "b",
        "prompt": "Tank A fills with 1260 L of water in 7 hours. Tank B fills with 1500 L of water in 8 hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tank B by $7.5\\text{ L/h}$",
          "worked": "Tank A:\n$$\\frac{1260\\text{ L}}{7\\text{ h}}=\\frac{180\\text{ L}}{1\\text{ h}}=180\\text{ L/h}$$\nTank B:\n$$\\frac{1500\\text{ L}}{8\\text{ h}}=\\frac{187.5\\text{ L}}{1\\text{ h}}=187.5\\text{ L/h}$$\nDifference:\n$$187.5-180=7.5$$\nTank B fills faster by $7.5\\text{ L/h}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
