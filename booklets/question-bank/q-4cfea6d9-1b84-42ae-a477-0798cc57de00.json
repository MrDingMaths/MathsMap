  "content": {
    "id": "p9-q1-response",
    "type": "question",
    "label": "1",
    "prompt": "A rope is tied to the top of a flagpole. When it hangs straight down, the rope is 2 m longer than the pole. When the rope is pulled tight with the lower end on the ground, the rope is 3 metres from the pole’s base. How tall is the flagpole?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{4}\\text{ m}$",
      "worked": "Let $h$ metres be the height of the flagpole. The rope is $(h+2)$ metres long.\n$$\\begin{align*}(h+2)^2&=h^2+3^2\\\\h^2+4h+4&=h^2+9\\\\4h&=5\\\\h&=\\frac{5}{4}\\end{align*}$$\nThe flagpole is $\\frac{5}{4}$ metres tall.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
