    "type": "question",
    "label": "14",
    "prompt": "Suppose 35% of students in a class have blue eyes. Five blue-eyed students join the class. Now 48% of the students have blue eyes. How many students were originally in the class?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
