            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": " be the original class size; solve ",
                "marks": []
