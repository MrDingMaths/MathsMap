  "content": {
    "id": "v2-96467-p30-practice-j8-104829-root",
    "type": "question",
    "label": null,
    "prompt": "Each time Mia casts her line from a jetty, the probability of a bite is $0.2$. The casts are independent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-96467-p30-practice-j8-104829-j8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the probability that Mia gets at least one bite in 3 casts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.488$",
          "worked": "$$\\begin{align*}P(\\text{at least one bite})&=1-P(\\text{no bites})\\\\&=1-0.8^3\\\\&=1-0.512=0.488\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-96467-p30-practice-j8-104829-j8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the probability that Mia gets at least one bite in 10 casts, correct to 3 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.893$",
          "worked": "$$\\begin{align*}P(\\text{at least one bite})&=1-0.8^{10}\\\\&=1-0.1074\\\\&=0.893\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-96467-p30-practice-j8-104829-j8-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the smallest number of casts for which the probability of at least one bite is greater than $0.95$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "14 casts",
          "worked": "$$\\begin{align*}1-0.8^n&>0.95\\\\0.8^n&<0.05\\end{align*}$$\nTest values of $n$:\n$$\\begin{align*}0.8^{12}&=0.0687\\\\0.8^{13}&=0.0550\\\\0.8^{14}&=0.0440<0.05\\end{align*}$$\nThe smallest number of casts is $14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
