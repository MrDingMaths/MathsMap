        "prompt": "How much will his holiday loading be if he takes 4 weeks holiday?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$297.50",
          "worked": "$$\\begin{align*}\\text{4 weeks' pay} &= 425\\times4 = \\$1700\\\\\\text{Holiday loading} &= 0.175\\times1700\\\\\\text{Holiday loading} &= \\$297.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p43-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "What will be the amount of his holiday pay?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1997.50",
          "worked": "$$\\begin{align*}\\text{Holiday pay} &= \\text{4 weeks' pay}+\\text{Holiday loading}\\\\\\text{Holiday pay} &= 1700+297.50\\\\\\text{Holiday pay} &= \\$1997.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
