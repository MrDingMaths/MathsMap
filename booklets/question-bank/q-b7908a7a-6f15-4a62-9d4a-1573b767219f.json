    "type": "question",
    "label": "8",
    "prompt": "Find the normal to $y=\\dfrac{x+2}{x-1}$ at $x=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\dfrac{x}{3}+\\dfrac{10}{3}$\n\nAt $(2,4)$ the tangent gradient is $-3$, so the normal gradient is $\\tfrac13$.",
      "worked": "$$\\begin{align*}y'&=\\frac{(x-1)-(x+2)}{(x-1)^2}\\\\y'&=-\\frac{3}{(x-1)^2}\\\\y'(2)&=-3\\\\m_{\\mathrm{normal}}&=\\frac13\\\\y-4&=\\frac13(x-2)\\\\y&=\\frac{x}{3}+\\frac{10}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
