            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$252$",
              "worked": "Choose five of the ten digits. Each selection has exactly one descending arrangement, and zero, if selected, is last:\n$$ {}^{10}C_{5}=252. $$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p59-q14-b",
            "type": "part",
            "label": "b",
            "prompt": "ascending order.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$126$",
              "worked": "Each selection has exactly one ascending arrangement. Selections containing zero would begin with zero, so subtract these:\n$$\\begin{aligned}N&={}^{10}C_{5}-{}^{9}C_{4}\\\\N&=252-126\\\\N&=126.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p59-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Why do these two questions involve unordered selections?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each selection of five digits has only one arrangement in the required order.",
          "worked": "Once the five digits are selected, their ascending or descending order is fixed. There is only one permitted arrangement, so rearrangements are not counted.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
