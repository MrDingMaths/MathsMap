        "label": "a",
        "prompt": "Identify the mistake.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "He subtracted $x-1$ without keeping brackets: $3-(x-1)=4-x$, not $2-x$.",
          "worked": "The second factor must be $3-(x-1)$. Subtracting the bracket changes both signs, giving $3-x+1=4-x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p34-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Write the correct factorisation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2+x)(4-x)$",
          "worked": "$$\\begin{aligned}9-(x-1)^2&=(3+(x-1))(3-(x-1))\\\\&=(2+x)(4-x)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
