  "content": {
    "id": "p9-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The curve $y=(x-1)(x+3)=x^2+2x-3$ is graphed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p9-q4-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"page 9 p9-q4-graph\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.32cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-5,-5.5) rectangle (3.5,10.5);\n\\draw[->,line width=0.5pt] (-5,0)--(3.2,0) node[below] {$x$};\n\\draw[->,line width=0.5pt] (0,-5.3)--(0,10) node[left] {$y$};\n\\draw[dashed,line width=0.4pt] (2,0)--(2,5);\n\\draw[<->,line width=0.8pt,domain=-4.65:2.65,samples=101] plot (\\x,{\\x*\\x+2*\\x-3});\n\\node[below] at (-3,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-3$\\special{dvisvgm:raw </g>}};\n\\node[below] at (1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\node[below] at (2,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
