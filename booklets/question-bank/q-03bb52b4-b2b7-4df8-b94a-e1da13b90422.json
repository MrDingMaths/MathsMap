    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $\\binom{4}{k}$ for $k=0,1,2,3,4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,4,6,4,1$, respectively.",
          "worked": "Using $\\binom{n}{k}=\\dfrac{n!}{k!(n-k)!}$ and the special values:\n$$\\begin{align*}\\binom{4}{0}&=1\\\\\\binom{4}{1}&=4\\\\\\binom{4}{2}&=\\frac{4!}{2!2!}\\\\\\binom{4}{2}&=\\frac{4\\times3}{2}\\\\\\binom{4}{2}&=6\\\\\\binom{4}{3}&=\\binom{4}{1}=4\\\\\\binom{4}{4}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate $\\binom{n}{2}$ for $n=2,3,4,5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,3,6,10$, respectively.",
          "worked": "$$\\begin{align*}\\binom{2}{2}&=1\\\\\\binom{3}{2}&=\\binom{3}{1}=3\\\\\\binom{4}{2}&=\\frac{4!}{2!2!}\\\\\\binom{4}{2}&=\\frac{4\\times3}{2}=6\\\\\\binom{5}{2}&=\\frac{5!}{2!3!}\\\\\\binom{5}{2}&=\\frac{5\\times4}{2}=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
