    "type": "question",
    "label": "7",
    "prompt": "Fiona sells cleaning equipment. She earns a commission of 17.5% of all weekly sales in excess of \\$10 000. How much commission does she earn on weekly sales of \\$24 000?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$2450, from 17.5% of \\$14 000.",
      "worked": "$$\\begin{align*}\\text{Excess}&=24000-10000\\\\&=\\$14000\\\\\\text{Commission}&=\\text{Percentage}\\times\\text{Excess}\\\\&=0.175\\times14000\\\\&=\\$2450\\end{align*}$$",
