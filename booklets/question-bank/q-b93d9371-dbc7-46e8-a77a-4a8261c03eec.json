  "content": {
    "id": "p29-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Two opposite sides of a $10\\text{ cm}\\times10\\text{ cm}$ square sheet are taped together. The circular ends are capped to form a closed cylinder. Find the surface area of the cylinder.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\left(100+\\dfrac{50}{\\pi}\\right)\\text{ cm}^2$",
      "worked": "The curved surface has area $10\\times10=100\\text{ cm}^2$, and the circumference is $10\\text{ cm}$.\n$$\\begin{align*}2\\pi r&=10\\\\r&=\\frac5\\pi\\\\A&=100+2\\pi\\left(\\frac5\\pi\\right)^2\\\\A&=\\left(100+\\frac{50}{\\pi}\\right)\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
