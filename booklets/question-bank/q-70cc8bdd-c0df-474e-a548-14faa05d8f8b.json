  "content": {
    "id": "p14-q6",
    "type": "question",
    "label": "6",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q6a",
        "type": "part",
        "label": "a",
        "prompt": "Find the mean of the data set $12, 15, 20, 32, 40$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23.8$",
          "worked": "$$\\begin{align*}\\bar{x}&=\\frac{12+15+20+32+40}{5}\\\\\\bar{x}&=\\frac{119}{5}\\\\\\bar{x}&=23.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q6b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p14-q6b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "An extra number is added to the data set, and its value is ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "19",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "How does the mean change?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "New mean $23$; decreases by $0.8$.\n\nAdd the extra value to the original total, then divide by $6$.",
          "worked": "$$\\begin{align*}\\bar{x}_{\\text{new}}&=\\frac{119+19}{6}\\\\\\bar{x}_{\\text{new}}&=\\frac{138}{6}\\\\\\bar{x}_{\\text{new}}&=23\\end{align*}$$\nThe mean decreases by $23.8-23=0.8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q6c",
        "type": "part",
        "label": "c",
        "prompt": "Instead of $19$, the value of the extra number is $91$. How does the mean change now?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "New mean $35$; increases by $11.2$ from the original mean, or by $12$ compared with part b.",
          "worked": "$$\\begin{align*}\\bar{x}_{\\text{new}}&=\\frac{119+91}{6}\\\\\\bar{x}_{\\text{new}}&=\\frac{210}{6}\\\\\\bar{x}_{\\text{new}}&=35\\end{align*}$$\nCompared with the original mean, the increase is $35-23.8=11.2$.\nCompared with part b, the increase is $35-23=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
