  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the equation of the transformation of $y=\\cos x$ if the transformed function has:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "amplitude $4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4\\cos x$",
          "worked": "A vertical dilation by factor $4$ gives $y=4\\cos x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "a phase of $\\frac{\\pi}{3}$ units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\cos\\left(x+\\frac{\\pi}{3}\\right)$",
          "worked": "Using the booklet's convention, positive phase $\\frac{\\pi}{3}$ means a shift left by $\\frac{\\pi}{3}$:\n$$y=\\cos\\left(x+\\frac{\\pi}{3}\\right).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "mean position $8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\cos x+8$",
          "worked": "Translate $y=\\cos x$ up $8$ units: $y=\\cos x+8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "period $\\frac{\\pi}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\cos(4x)$",
          "worked": "For $y=\\cos(ax)$ with $a>0$:\n$$\\begin{aligned}\\frac{2\\pi}{a}&=\\frac{\\pi}{2}\\\\a&=4\\end{aligned}$$\nHence $y=\\cos(4x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p12-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "a vertical dilation with scale factor $7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=7\\cos x$",
          "worked": "Multiply every $y$-value by $7$: $y=7\\cos x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
