        "id": "p21-question-50-52-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3\\log_{32}(7)}{\\log_8(49)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9}{10}$",
          "worked": "$$\\begin{align*}\\frac{3\\log_{32}(7)}{\\log_8(49)}&=\\frac{3\\left(\\frac{\\ln(7)}{5\\ln(2)}\\right)}{\\frac{2\\ln(7)}{3\\ln(2)}}\\\\\\frac{3\\log_{32}(7)}{\\log_8(49)}&=\\frac{3\\ln(7)}{5\\ln(2)}\\times\\frac{3\\ln(2)}{2\\ln(7)}\\\\\\frac{3\\log_{32}(7)}{\\log_8(49)}&=\\frac{9}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-question-50-52-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{0.25}(32)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{5}{2}$",
          "worked": "$$\\begin{align*}\\log_{0.25}(32)&=\\frac{\\ln(2^5)}{\\ln(2^{-2})}\\\\\\log_{0.25}(32)&=\\frac{5\\ln(2)}{-2\\ln(2)}\\\\\\log_{0.25}(32)&=-\\frac{5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-question-50-52-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{\\frac{1}{9}}(27)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3}{2}$",
          "worked": "$$\\begin{align*}\\log_{\\frac{1}{9}}(27)&=\\frac{\\ln(3^3)}{\\ln(3^{-2})}\\\\\\log_{\\frac{1}{9}}(27)&=\\frac{3\\ln(3)}{-2\\ln(3)}\\\\\\log_{\\frac{1}{9}}(27)&=-\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
