  "content": {
    "id": "p40-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "An online clothes store is offering 17.5% off all purchases. How much would a skirt that originally costs \\$85 be? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$70.13$",
      "worked": "$$\\begin{align*}\\text{Percentage remaining} &= 100\\%-17.5\\% \\\\ &= 82.5\\% \\\\ \\text{Sale price} &= \\$85\\times0.825 \\\\ &= \\$70.125 \\\\ &\\approx \\$70.13\\end{align*}$$\nTo the nearest cent, the skirt costs $\\$70.13$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
