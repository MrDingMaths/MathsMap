  "content": {
    "id": "p56-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Use order of operations to evaluate the following. Remember that there are invisible brackets enclosing the numerator and denominator of a fraction. Check your answer using a calculator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{8-4}{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\frac{8-4}{-2}&=\\frac{4}{-2}\\\\&=-2\\end{align*}$$\nCalculator check: $-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p56-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{10}{4-(-1)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{10}{4-(-1)}&=\\frac{10}{4+1}\\\\&=\\frac{10}{5}\\\\&=2\\end{align*}$$\nCalculator check: $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p56-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{24-12}{16+(-4)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{24-12}{16+(-4)}&=\\frac{12}{16+(-4)}\\\\&=\\frac{12}{16-4}\\\\&=\\frac{12}{12}\\\\&=1\\end{align*}$$\nCalculator check: $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p56-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$1-\\frac{2\\times(-3)}{-3-(-2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}1-\\frac{2\\times(-3)}{-3-(-2)}&=1-\\frac{-6}{-3-(-2)}\\\\&=1-\\frac{-6}{-3+2}\\\\&=1-\\frac{-6}{-1}\\\\&=1-6\\\\&=-5\\end{align*}$$\nCalculator check: $-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p56-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{1+4}\\times6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{18}{5}$",
          "worked": "$$\\begin{align*}\\frac{3}{1+4}\\times6&=\\frac{3}{5}\\times6\\\\&=\\frac{18}{5}\\end{align*}$$\nCalculator check: $3.6=\\frac{18}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p56-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{-(-2)-2\\times(-5)}{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}\\frac{-(-2)-2\\times(-5)}{-3}&=\\frac{2-2\\times(-5)}{-3}\\\\&=\\frac{2-(-10)}{-3}\\\\&=\\frac{2+10}{-3}\\\\&=\\frac{12}{-3}\\\\&=-4\\end{align*}$$\nCalculator check: $-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p56-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{2\\times(-2)-5\\times(-5)}{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7$",
          "worked": "$$\\begin{align*}\\frac{2\\times(-2)-5\\times(-5)}{-3}&=\\frac{-4-5\\times(-5)}{-3}\\\\&=\\frac{-4-(-25)}{-3}\\\\&=\\frac{-4+25}{-3}\\\\&=\\frac{21}{-3}\\\\&=-7\\end{align*}$$\nCalculator check: $-7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p56-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\frac{-4+(-4)}{4-(-4)}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\left(\\frac{-4+(-4)}{4-(-4)}\\right)^2&=\\left(\\frac{-8}{4-(-4)}\\right)^2\\\\&=\\left(\\frac{-8}{4+4}\\right)^2\\\\&=\\left(\\frac{-8}{8}\\right)^2\\\\&=(-1)^2\\\\&=1\\end{align*}$$\nCalculator check: $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
