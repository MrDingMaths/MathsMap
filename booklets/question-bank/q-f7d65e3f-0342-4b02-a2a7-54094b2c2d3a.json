    "children": [
      {
        "id": "p27-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $\\sin^{-1}\\left(\\sin\\frac{5\\pi}{3}\\right)\\ne\\frac{5\\pi}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5\\pi}{3}$ is outside the range $\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$ of $\\sin^{-1}$.",
          "worked": "The range of $\\sin^{-1}$ is $\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$. Since $\\frac{5\\pi}{3}$ is outside this interval, it cannot equal $\\sin^{-1}\\left(\\sin\\frac{5\\pi}{3}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What condition must $x$ meet for $\\sin^{-1}(\\sin x)=x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\pi}{2}\\leq x\\leq\\frac{\\pi}{2}$.",
          "worked": "The angle $x$ must lie in the principal range of inverse sine:\n$$-\\frac{\\pi}{2}\\leq x\\leq\\frac{\\pi}{2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Describe how to evaluate $\\sin^{-1}\\left(\\sin\\frac{5\\pi}{3}\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Use the angle $-\\frac{\\pi}{3}$, which has the same sine and lies in $\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$. The value is $-\\frac{\\pi}{3}$.",
          "worked": "The reference angle is $\\frac{\\pi}{3}$. Since $\\sin\\frac{5\\pi}{3}<0$, choose $-\\frac{\\pi}{3}$ in the range $\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$ of inverse sine.\n$$\\sin\\frac{5\\pi}{3}=\\sin\\left(-\\frac{\\pi}{3}\\right).$$\nThen use $\\sin^{-1}(\\sin x)=x$ within this interval.\n$$\\begin{aligned}\\sin^{-1}\\left(\\sin\\frac{5\\pi}{3}\\right)&=\\sin^{-1}\\left(\\sin\\left(-\\frac{\\pi}{3}\\right)\\right)\\\\\\sin^{-1}\\left(\\sin\\frac{5\\pi}{3}\\right)&=-\\frac{\\pi}{3}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
