  "content": {
    "id": "p26-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Simplify.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2-4}{x^2-x-6}\\times\\dfrac{5x-15}{x^2+4x-12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{x+6}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2-4}{x^2-x-6}\\times\\frac{5x-15}{x^2+4x-12}\n&=\\frac{(x-2)(x+2)}{(x-3)(x+2)}\\times\\frac{5(x-3)}{(x+6)(x-2)}\\\\\n&=\\frac{5}{x+6}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2+3x+2}{x^2+4x+3}\\times\\dfrac{x^2-9}{3x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-3}{3}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2+3x+2}{x^2+4x+3}\\times\\frac{x^2-9}{3x+6}\n&=\\frac{(x+1)(x+2)}{(x+1)(x+3)}\\times\\frac{(x-3)(x+3)}{3(x+2)}\\\\\n&=\\frac{x-3}{3}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2+2x-3}{x^2-25}\\times\\dfrac{2x-10}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x-1)}{x+5}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2+2x-3}{x^2-25}\\times\\frac{2x-10}{x+3}\n&=\\frac{(x+3)(x-1)}{(x-5)(x+5)}\\times\\frac{2(x-5)}{x+3}\\\\\n&=\\frac{2(x-1)}{x+5}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x^2-4x+3}{x^2+4x-21}\\times\\dfrac{5x-15}{x^2+4x-12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5(x-3)(x-1)}{(x+7)(x+6)(x-2)}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2-4x+3}{x^2+4x-21}\\times\\frac{5x-15}{x^2+4x-12}\n&=\\frac{(x-1)(x-3)}{(x+7)(x-3)}\\times\\frac{5(x-3)}{(x+6)(x-2)}\\\\\n&=\\frac{x-1}{x+7}\\times\\frac{5(x-3)}{(x+6)(x-2)}\\\\\n&=\\frac{5(x-3)(x-1)}{(x+7)(x+6)(x-2)}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p26-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x^2-x-6}{x^2+x-12}\\times\\dfrac{x^2+5x+4}{x^2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{x-1}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2-x-6}{x^2+x-12}\\times\\frac{x^2+5x+4}{x^2-1}\n&=\\frac{(x-3)(x+2)}{(x+4)(x-3)}\\times\\frac{(x+1)(x+4)}{(x-1)(x+1)}\\\\\n&=\\frac{x+2}{x-1}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x^2-4x-12}{x^2-4}\\times\\dfrac{x^2-6x+8}{x^2-36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-4}{x+6}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2-4x-12}{x^2-4}\\times\\frac{x^2-6x+8}{x^2-36}\n&=\\frac{(x-6)(x+2)}{(x-2)(x+2)}\\times\\frac{(x-2)(x-4)}{(x-6)(x+6)}\\\\\n&=\\frac{x-4}{x+6}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x^2+2x-3}{x^2-25}\\div\\dfrac{3x-3}{2x+10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x+3)}{3(x-5)}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2+2x-3}{x^2-25}\\div\\frac{3x-3}{2x+10}\n&=\\frac{x^2+2x-3}{x^2-25}\\times\\frac{2x+10}{3x-3}\\\\\n&=\\frac{(x+3)(x-1)}{(x-5)(x+5)}\\times\\frac{2(x+5)}{3(x-1)}\\\\\n&=\\frac{2(x+3)}{3(x-5)}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p26-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x^2+3x+2}{x^2+4x+3}\\div\\dfrac{4x+8}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-3}{4}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2+3x+2}{x^2+4x+3}\\div\\frac{4x+8}{x^2-9}\n&=\\frac{x^2+3x+2}{x^2+4x+3}\\times\\frac{x^2-9}{4x+8}\\\\\n&=\\frac{(x+1)(x+2)}{(x+1)(x+3)}\\times\\frac{(x-3)(x+3)}{4(x+2)}\\\\\n&=\\frac{x-3}{4}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p26-q11-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{x^2+5x-14}{x^2+2x-3}\\div\\dfrac{x^2+9x+14}{x^2+x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-2}{x+3}$",
          "worked": "$$\\begin{align*}\n\\frac{x^2+5x-14}{x^2+2x-3}\\div\\frac{x^2+9x+14}{x^2+x-2}\n&=\\frac{x^2+5x-14}{x^2+2x-3}\\times\\frac{x^2+x-2}{x^2+9x+14}\\\\\n&=\\frac{(x+7)(x-2)}{(x+3)(x-1)}\\times\\frac{(x+2)(x-1)}{(x+7)(x+2)}\\\\\n&=\\frac{x-2}{x+3}.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
