  "content": {
    "id": "p29-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "One rectangular prism measures $4\\times6\\times x$ and another measures $8\\times3\\times y$, where $x$ and $y$ are both positive integers. Given that the prisms have the same surface area, find the smallest possible value of $x+y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p29-q23-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "21",
                "display": false
              }
            ]
          },
          {
            "id": "p29-q23-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Equal surface areas give ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "10x=11y",
                "display": false
              },
              {
                "type": "text",
                "text": "; the smallest positive solution is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=11,\\ y=10",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}2(4\\times6+4x+6x)&=2(8\\times3+8y+3y)\\\\24+10x&=24+11y\\\\10x&=11y\\end{align*}$$\nSince $10$ and $11$ have no common factor, $x=11k$ and $y=10k$ for a positive integer $k$. The smallest choice is $k=1$, giving $x+y=11+10=21$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
