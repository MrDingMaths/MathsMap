          "inlines": [
            {
              "type": "text",
              "text": "A formula for finding Pythagorean triads ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "(a,b,c)",
              "display": false
            },
            {
              "type": "text",
              "text": " is given below.",
              "marks": []
            }
          ]
        },
        {
          "id": "p13-q4-condition",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "If one number in the triad is an odd whole number ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "a>1",
              "display": false
            },
            {
              "type": "text",
              "text": ", the formulas for the other 2 numbers are:",
              "marks": []
            }
          ]
        },
        {
          "id": "p13-q4-formulas",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "b=\\frac12(a^2-1)",
              "display": false
            },
            {
              "type": "text",
              "text": "   and   ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "c=\\frac12(a^2+1)",
              "display": false
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "If $a=5$, use the formulas to find the values of $b$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=12$, $c=13$.",
          "worked": "$$\\begin{align*}b&=\\frac12(5^2-1)\\\\b&=\\frac12(25-1)\\\\b&=12\\\\c&=\\frac12(5^2+1)\\\\c&=\\frac12(25+1)\\\\c&=13\\end{align*}$$\nThe triad is $(5,12,13)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "If $a=7$, use the formulas to find the values of $b$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=24$, $c=25$.",
          "worked": "$$\\begin{align*}b&=\\frac12(7^2-1)\\\\b&=\\frac12(49-1)\\\\b&=24\\\\c&=\\frac12(7^2+1)\\\\c&=\\frac12(49+1)\\\\c&=25\\end{align*}$$\nThe triad is $(7,24,25)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
