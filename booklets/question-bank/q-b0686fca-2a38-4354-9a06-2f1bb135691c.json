  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The vertices of $\\Delta ABC$ are $A(0,0)$, $B(3,4)$ and $C\\left(\\frac{25}{3},0\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the gradient of:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q8-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$AB$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{4}{3}$",
              "worked": "$$\\begin{align*}m_{AB}&=\\frac{4-0}{3-0}\\\\m_{AB}&=\\frac{4}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p7-q8-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$BC$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\frac{3}{4}$",
              "worked": "$$\\begin{align*}m_{BC}&=\\frac{0-4}{\\frac{25}{3}-3}\\\\m_{BC}&=-\\frac{3}{4}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p7-q8-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$CA$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0$",
              "worked": "$$\\begin{align*}m_{CA}&=\\frac{0-0}{0-\\frac{25}{3}}\\\\m_{CA}&=0\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "What type of triangle is $\\Delta ABC$? Why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Right-angled at $B$, since $m_{AB}m_{BC}=-1$.",
          "worked": "$$\\begin{align*}m_{AB}\\times m_{BC}&=\\frac{4}{3}\\times\\left(-\\frac{3}{4}\\right)\\\\m_{AB}\\times m_{BC}&=-1\\end{align*}$$\n$AB\\perp BC$, so $\\Delta ABC$ is right-angled at $B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the perimeter of $\\Delta ABC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$ units",
          "worked": "$$\\begin{align*}AB&=\\sqrt{3^2+4^2}\\\\AB&=5\\\\BC&=\\sqrt{\\left(\\frac{16}{3}\\right)^2+4^2}\\\\BC&=\\frac{20}{3}\\\\CA&=\\frac{25}{3}\\\\\\text{Perimeter}&=5+\\frac{20}{3}+\\frac{25}{3}\\\\\\text{Perimeter}&=20\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
