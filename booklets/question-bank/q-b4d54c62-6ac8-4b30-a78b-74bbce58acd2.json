  "content": {
    "id": "p28-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Your sister offers you any of ten different books that she no longer wants. How many different selections can you make? Include the selection of no books.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1024$ selections.",
      "worked": "For each book, either include it or exclude it. By the multiplication principle, the number of selections is\n$$2^{10}=1024.$$\nThis includes selecting no books.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
