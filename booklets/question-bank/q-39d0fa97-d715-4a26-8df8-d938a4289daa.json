  "content": {
    "id": "p10-q15",
    "type": "question",
    "label": "15",
    "prompt": "In a sale, all items are reduced by 20%.\nAs a special promotion, sale items are reduced by a further 25%.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Work out the sale price of a cooker that cost \\$350 before the sale.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$210",
          "worked": "$$\\begin{align*}\\text{Sale price}&=\\$350\\times0.8\\times0.75\\\\&=\\$350\\times0.6\\\\&=\\$210\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the overall percentage reduction in cost of the combined offers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "40% reduction",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=0.8\\times0.75\\\\&=0.6\\\\\\text{Overall reduction}&=100\\%-60\\%\\\\&=40\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
