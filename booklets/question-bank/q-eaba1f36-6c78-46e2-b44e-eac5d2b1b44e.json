    "children": [
      {
        "id": "p33-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the difference between $4a+3$ and $4(a+3)$ when $a=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}4a+3&=4(2)+3\\\\&=11\\\\4(a+3)&=4(2+3)\\\\&=4(5)\\\\&=20\\end{align*}$$\nThe difference is $20-11=9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the difference between $4a+3$ and $4(a+3)$ when $a=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}4a+3&=4(10)+3\\\\&=43\\\\4(a+3)&=4(10+3)\\\\&=4(13)\\\\&=52\\end{align*}$$\nThe difference is $52-43=9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the difference between $4a+3$ and $4(a+3)$ when $a=100$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}4a+3&=4(100)+3\\\\&=403\\\\4(a+3)&=4(100+3)\\\\&=4(103)\\\\&=412\\end{align*}$$\nThe difference is $412-403=9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the difference between $4a+3$ and $4(a+3)$ when $a=0.2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}4a+3&=4(0.2)+3\\\\&=0.8+3\\\\&=3.8\\\\4(a+3)&=4(0.2+3)\\\\&=4(3.2)\\\\&=12.8\\end{align*}$$\nThe difference is $12.8-3.8=9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(a+3)$ is always $9$ greater than $4a+3$.",
          "worked": "The difference is $9$ in every case: $4(a+3)$ is $9$ greater than $4a+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p33-q15-f",
        "type": "part",
        "label": "f",
        "prompt": {
