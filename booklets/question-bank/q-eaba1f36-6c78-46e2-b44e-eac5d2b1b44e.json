      },
      {
        "id": "p33-q15-g",
        "type": "part",
        "label": "g",
        "prompt": "When $a=2$, find the difference between $5a+3$ and $5(a+3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}5a+3&=5(2)+3\\\\&=13\\\\5(a+3)&=5(2+3)\\\\&=25\\end{align*}$$\nThe difference is $25-13=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q15-h",
        "type": "part",
        "label": "h",
        "prompt": "When $a=10$, find the difference between $5a+3$ and $5(a+3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}5a+3&=5(10)+3\\\\&=53\\\\5(a+3)&=5(10+3)\\\\&=65\\end{align*}$$\nThe difference is $65-53=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q15-i",
        "type": "part",
        "label": "i",
        "prompt": "Explain why changing $a$ from 2 to 10 did not change this difference.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both expressions contain five lots of $a$; their remaining amounts are 3 and 15, giving a difference of 12.",
          "worked": "Both expressions contain five lots of $a$. Their remaining amounts are $3$ and $15$, so the difference is $15-3=12$ for either value of $a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
