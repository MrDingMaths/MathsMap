  "content": {
    "id": "v2-a9dca-p13-practice-j3-025907-root",
    "type": "question",
    "label": null,
    "prompt": "In 5 years, the product of the ages of Ava and Ben will be 125 more than the product of their current ages. Ava is 4 years older than Ben.\nLet $x$ be Ben's current age in years.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a9dca-p13-practice-j3-025907-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for Ava's current age.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+4$.",
          "worked": "Ava is 4 years older than Ben, so her age is $x+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-a9dca-p13-practice-j3-025907-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Write expressions for Ben's age and Ava's age in 5 years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ben: $x+5$; Ava: $x+9$.",
          "worked": "$$\\begin{align*}\\text{Ben}&=x+5\\\\\\text{Ava}&=(x+4)+5=x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-a9dca-p13-practice-j3-025907-j3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an equation using the products of their ages.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+5)(x+9)=x(x+4)+125$.",
          "worked": "Product in 5 years = current product + 125:\n$$(x+5)(x+9)=x(x+4)+125$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-a9dca-p13-practice-j3-025907-j3-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Solve your equation to find their current ages.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ben is 8 years old and Ava is 12 years old.",
          "worked": "$$\\begin{align*}(x+5)(x+9)&=x(x+4)+125\\\\x^2+14x+45&=x^2+4x+125\\\\10x&=80\\\\x&=8\\end{align*}$$\nBen is 8 years old and Ava is $8+4=12$ years old.\nCheck: $13\\times17=221$ and $12\\times8=96$, a difference of $125$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
