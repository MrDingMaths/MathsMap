  "content": {
    "id": "p21-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A policeman and a thief are 70 metres apart. The policeman chases the thief at a speed of 8 metres per second while the thief runs away at a speed of 5 metres per second.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "How long does it take for the policeman to catch the thief?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{70}{3}\\text{ seconds}$",
          "worked": "The gap closes at the difference between their speeds.\n$$\\begin{align*}s_{\\text{relative}} &= 8-5 = 3\\text{ m/s}\\\\t &= \\frac{d}{s_{\\text{relative}}}\\\\t &= \\frac{70}{3}\\text{ seconds}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "How far does the policeman run in catching the thief?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{560}{3}\\text{ m}$",
          "worked": "$$\\begin{align*}d_{\\text{policeman}} &= st\\\\d_{\\text{policeman}} &= 8\\times\\frac{70}{3}\\\\d_{\\text{policeman}} &= \\frac{560}{3}\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
