  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Solve these equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2+4x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$$\\begin{align*}2(x^2+2x+1)&=0\\\\2(x+1)^2&=0\\\\x+1&=0\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2+6x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $-2$",
          "worked": "$$\\begin{align*}2(x^2+3x+2)&=0\\\\2(x+1)(x+2)&=0\\\\x+1&=0\\quad\\text{or}\\quad x+2=0\\\\x&=-1\\quad\\text{or}\\quad x=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x^2-2x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $-1$",
          "worked": "$$\\begin{align*}2(x^2-x-2)&=0\\\\2(x-2)(x+1)&=0\\\\x-2&=0\\quad\\text{or}\\quad x+1=0\\\\x&=2\\quad\\text{or}\\quad x=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x^2-6x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $2$",
          "worked": "$$\\begin{align*}2(x^2-3x+2)&=0\\\\2(x-1)(x-2)&=0\\\\x-1&=0\\quad\\text{or}\\quad x-2=0\\\\x&=1\\quad\\text{or}\\quad x=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x^2-8x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2}{3}$ or $2$",
          "worked": "$P=12$, $S=-8$, $F=-6,-2$.\n$$\\begin{align*}3x^2-6x-2x+4&=0\\\\3x(x-2)-2(x-2)&=0\\\\(3x-2)(x-2)&=0\\\\3x-2&=0\\quad\\text{or}\\quad x-2=0\\\\x&=\\frac{2}{3}\\quad\\text{or}\\quad x=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$6x^2-10x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2}{3}$ or $1$",
          "worked": "$P=6$, $S=-5$, $F=-3,-2$ for the trinomial after removing the common factor.\n$$\\begin{align*}2(3x^2-5x+2)&=0\\\\2(3x^2-3x-2x+2)&=0\\\\2\\bigl(3x(x-1)-2(x-1)\\bigr)&=0\\\\2(3x-2)(x-1)&=0\\\\3x-2&=0\\quad\\text{or}\\quad x-1=0\\\\x&=\\frac{2}{3}\\quad\\text{or}\\quad x=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p6-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$6x^2+2x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2}{3}$ or $-1$",
          "worked": "$P=-6$, $S=1$, $F=3,-2$ for the trinomial after removing the common factor.\n$$\\begin{align*}2(3x^2+x-2)&=0\\\\2(3x^2+3x-2x-2)&=0\\\\2\\bigl(3x(x+1)-2(x+1)\\bigr)&=0\\\\2(3x-2)(x+1)&=0\\\\3x-2&=0\\quad\\text{or}\\quad x+1=0\\\\x&=\\frac{2}{3}\\quad\\text{or}\\quad x=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p6-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$6x^2+10x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{2}{3}$ or $-1$",
          "worked": "$P=6$, $S=5$, $F=3,2$ for the trinomial after removing the common factor.\n$$\\begin{align*}2(3x^2+5x+2)&=0\\\\2(3x^2+3x+2x+2)&=0\\\\2\\bigl(3x(x+1)+2(x+1)\\bigr)&=0\\\\2(3x+2)(x+1)&=0\\\\3x+2&=0\\quad\\text{or}\\quad x+1=0\\\\x&=-\\frac{2}{3}\\quad\\text{or}\\quad x=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
