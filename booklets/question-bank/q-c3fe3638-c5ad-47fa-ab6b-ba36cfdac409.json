    "children": [
      {
        "id": "p33-q11-explanation",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $y=a(x+4)^2+2$ is the general form of a quadratic with vertex $(-4,2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Substitute $h=-4$ and $k=2$ into $y=a(x-h)^2+k$, with $a\\ne0$.",
          "worked": "A quadratic with vertex $(h,k)$ has equation $y=a(x-h)^2+k$, where $a\\ne0$. Taking $h=-4$ and $k=2$ gives $y=a(x+4)^2+2$. Different non-zero values of $a$ give quadratics sharing this vertex.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-q11-conditions",
        "type": "group",
        "label": "",
        "prompt": "Then find the equation of such a quadratic for which:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p33-q11-a",
            "type": "part",
            "label": "b",
            "prompt": "the quadratic is monic,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=(x+4)^2+2$",
              "worked": "A monic quadratic has $a=1$.\n$$y=(x+4)^2+2.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p33-q11-b",
            "type": "part",
            "label": "c",
            "prompt": "the coefficient of $x^2$ is $3$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=3(x+4)^2+2$",
              "worked": "The coefficient of $x^2$ is $a$, so $a=3$.\n$$y=3(x+4)^2+2.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p33-q11-c",
            "type": "part",
            "label": "d",
            "prompt": "the $y$-intercept is $16$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac78(x+4)^2+2$",
              "worked": "Substitute $(0,16)$:\n$$\\begin{align*}16&=a(0+4)^2+2\\\\16&=16a+2\\\\14&=16a\\\\a&=\\frac78\\\\y&=\\frac78(x+4)^2+2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          },
          {
            "id": "p33-q11-d",
            "type": "part",
            "label": "e",
            "prompt": "the curve passes through the origin.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-\\frac18(x+4)^2+2$",
              "worked": "Substitute $(0,0)$:\n$$\\begin{align*}0&=a(0+4)^2+2\\\\0&=16a+2\\\\-2&=16a\\\\a&=-\\frac18\\\\y&=-\\frac18(x+4)^2+2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          }
        ]
      }
    ]
  },
