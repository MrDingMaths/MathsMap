  "content": {
    "id": "p34-linear-equations-root",
    "type": "question",
    "label": null,
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p34-linear-equations-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Find the equation of the straight line.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-linear-equations-a",
        "type": "part",
        "label": "a",
        "prompt": "Has $y$-intercept $-2$ and $x$-intercept $6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{3}x-2$.",
          "worked": "The intercepts give the points $(0,-2)$ and $(6,0)$.\n$$\\begin{align*}m&=\\frac{0-(-2)}{6-0}\\\\m&=\\frac{1}{3}\\\\y&=\\frac{1}{3}x-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-linear-equations-b",
        "type": "part",
        "label": "b",
        "prompt": "Has gradient $-\\frac{2}{3}$ and passes through $(2,-4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{2}{3}x-\\frac{8}{3}$.",
          "worked": "$$\\begin{align*}y+4&=-\\frac{2}{3}(x-2)\\\\y&=-\\frac{2}{3}x+\\frac{4}{3}-4\\\\y&=-\\frac{2}{3}x-\\frac{8}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-linear-equations-c",
        "type": "part",
        "label": "c",
        "prompt": "Passes through $(-1,5)$ and $(3,-3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x+3$.",
          "worked": "$$\\begin{align*}m&=\\frac{-3-5}{3-(-1)}\\\\m&=-2\\\\y-5&=-2(x+1)\\\\y&=-2x+3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p34-linear-equations-d",
        "type": "part",
        "label": "d",
        "prompt": "Parallel to $y=3x+1$ and passes through $(2,4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x-2$.",
          "worked": "Parallel lines have the same gradient.\n$$\\begin{align*}m&=3\\\\y-4&=3(x-2)\\\\y&=3x-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-linear-equations-e",
        "type": "part",
        "label": "e",
        "prompt": "Perpendicular to $2x+4y-7=0$ and passes through $(9,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p34-linear-equations-e-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y=2x-17",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p34-linear-equations-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the perpendicular gradient ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " in point-gradient form.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Rearranging the given line gives\n$$y=-\\frac{1}{2}x+\\frac{7}{4}.$$\nPerpendicular gradients multiply to $-1$, so the required gradient is $2$.\n$$\\begin{align*}y-1&=2(x-9)\\\\y&=2x-17.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p34-linear-equations-f",
        "type": "part",
        "label": "f",
        "prompt": "Has an angle of inclination of $120^\\circ$ and passes through $(2,5)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p34-linear-equations-f-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y=-\\sqrt{3}x+2\\sqrt{3}+5",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p34-linear-equations-f-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "m=\\tan120^\\circ=-\\sqrt{3}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " in point-gradient form.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}m&=\\tan120^\\circ\\\\m&=-\\sqrt{3}\\\\y-5&=-\\sqrt{3}(x-2)\\\\y&=-\\sqrt{3}x+2\\sqrt{3}+5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
