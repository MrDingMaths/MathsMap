  "content": {
    "id": "p9-q15-content",
    "type": "question",
    "label": "15",
    "prompt": "Expand these expressions involving fractions.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{3}(6x+15)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+5$",
          "worked": "$$\\begin{align*}\\frac{1}{3}(6x+15)&=\\frac{1}{3}(6x)+\\frac{1}{3}(15)\\\\\\frac{1}{3}(6x+15)&=2x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{4}(12x+8y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+2y$",
          "worked": "$$\\begin{align*}\\frac{1}{4}(12x+8y)&=\\frac{1}{4}(12x)+\\frac{1}{4}(8y)\\\\\\frac{1}{4}(12x+8y)&=3x+2y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3}{4}(16-12y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12-9y$",
          "worked": "$$\\begin{align*}\\frac{3}{4}(16-12y)&=\\frac{3}{4}(16)+\\frac{3}{4}(-12y)\\\\\\frac{3}{4}(16-12y)&=12-9y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{4x+10y}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+5y$",
          "worked": "$$\\begin{align*}\\frac{4x+10y}{2}&=\\frac{4x}{2}+\\frac{10y}{2}\\\\\\frac{4x+10y}{2}&=2x+5y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
