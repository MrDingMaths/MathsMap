  "content": {
    "id": "p4-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Evaluate each expression for $x=-2$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6$",
          "worked": "$$\\begin{align*}5x+4&=5\\times(-2)+4\\\\5x+4&=-10+4\\\\5x+4&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$-5x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{align*}-5x+4&=(-5)\\times(-2)+4\\\\-5x+4&=10+4\\\\-5x+4&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$5(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}5(x+4)&=5\\times(-2+4)\\\\5(x+4)&=5\\times2\\\\5(x+4)&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$-5(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10$",
          "worked": "$$\\begin{align*}-5(x+4)&=-5\\times(-2+4)\\\\-5(x+4)&=-5\\times2\\\\-5(x+4)&=-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$-5x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-20$",
          "worked": "$$\\begin{align*}-5x^2&=-5\\times(-2)^2\\\\-5x^2&=-5\\times4\\\\-5x^2&=-20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-5x)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100$",
          "worked": "$$\\begin{align*}(-5x)^2&=\\bigl((-5)\\times(-2)\\bigr)^2\\\\(-5x)^2&=10^2\\\\(-5x)^2&=100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
