          "inlines": [
            {
              "type": "text",
              "text": "Consider a fair 6-sided die with the numbers 1 to 6 on it.",
              "marks": []
            }
          ]
        },
        {
          "id": "p6-q2-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Answer true or false to each of the following.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Rolling a 3 is unlikely.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True. Only one of the six equally likely outcomes is a 3, giving less than an even chance.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Rolling a 5 is likely.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. Only one of the six equally likely outcomes is a 5, so rolling a 5 is unlikely.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Rolling a 4 and rolling a 5 are equally likely events.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True. Each number appears on one face of the fair die, so the events have the same chance.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Rolling an even number is likely.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. The even numbers are 2, 4 and 6: half the six equally likely outcomes. There is an even chance.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "There is an even chance of rolling an odd number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True. The odd numbers are 1, 3 and 5: half the six equally likely outcomes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "There is an even chance of rolling a multiple of 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. Only 3 and 6 are multiples of 3. Fewer than half the equally likely outcomes qualify, so the event is unlikely.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
