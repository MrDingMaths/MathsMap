  "content": {
    "id": "p14-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Simplify, expressing the answers with positive indices. Evaluate powers where possible.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3a^2b^{-2})^3\\times(2a^4)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27}{4a^2b^6}$",
          "worked": "$$\\begin{align*}(3a^2b^{-2})^3\\times(2a^4)^{-2}&=27a^6b^{-6}\\times\\frac{1}{4a^8}\\\\&=\\frac{27a^{6-8}b^{-6}}{4}\\\\&=\\frac{27}{4a^2b^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$(5x^4y^6)^{-3}\\times(5^2xy^{-1})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{125}{x^9y^{21}}$",
          "worked": "$$\\begin{align*}(5x^4y^6)^{-3}\\times(5^2xy^{-1})^3&=5^{-3}x^{-12}y^{-18}\\times5^6x^3y^{-3}\\\\&=5^3x^{-9}y^{-21}\\\\&=\\frac{125}{x^9y^{21}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p14-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$(5m^2n^{-3})^{-2}\\times2(m^{-2}n^3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2n^{12}}{25m^8}$",
          "worked": "$$\\begin{align*}(5m^2n^{-3})^{-2}\\times2(m^{-2}n^3)^2&=\\frac{n^6}{25m^4}\\times\\frac{2n^6}{m^4}\\\\&=\\frac{2n^{6+6}}{25m^{4+4}}\\\\&=\\frac{2n^{12}}{25m^8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p14-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{(2a^4b^{-2})^3}{c^2}\\times\\dfrac{(2^2a^{-3}b^2)^{-1}}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2a^{15}}{c^3b^8}$",
          "worked": "$$\\begin{align*}\\frac{(2a^4b^{-2})^3}{c^2}\\times\\frac{(2^2a^{-3}b^2)^{-1}}{c}&=\\frac{8a^{12}}{c^2b^6}\\times\\frac{a^3}{4cb^2}\\\\&=\\frac{8a^{12+3}}{4c^{2+1}b^{6+2}}\\\\&=\\frac{2a^{15}}{c^3b^8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{(m^2n^3)^2}{p^{-3}}\\times(mnp^{-2})^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$mn^3p^9$",
          "worked": "$$\\begin{align*}\\frac{(m^2n^3)^2}{p^{-3}}\\times(mnp^{-2})^{-3}&=m^4n^6p^3\\times\\frac{p^6}{m^3n^3}\\\\&=m^{4-3}n^{6-3}p^{3+6}\\\\&=mn^3p^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(a^2)^3}{b^3}\\div\\left(\\dfrac{a}{b^2}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^8}{b^7}$",
          "worked": "$$\\begin{align*}\\frac{(a^2)^3}{b^3}\\div\\left(\\frac{a}{b^2}\\right)^{-2}&=\\frac{a^6}{b^3}\\div\\frac{b^4}{a^2}\\\\&=\\frac{a^6}{b^3}\\times\\frac{a^2}{b^4}\\\\&=\\frac{a^8}{b^7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q12-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{(2a^4)^2}{b^7}\\div\\dfrac{(a^2)^{-3}}{2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8a^{14}}{b^6}$",
          "worked": "$$\\begin{align*}\\frac{(2a^4)^2}{b^7}\\div\\frac{(a^2)^{-3}}{2b}&=\\frac{4a^8}{b^7}\\div\\frac{1}{2ba^6}\\\\&=\\frac{4a^8}{b^7}\\times2ba^6\\\\&=\\frac{8a^{14}}{b^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q12-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{(4c^4d^{-3})^2}{9}\\div\\dfrac{3c^{-2}}{d}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16c^{10}}{27d^5}$",
          "worked": "$$\\begin{align*}\\frac{(4c^4d^{-3})^2}{9}\\div\\frac{3c^{-2}}{d}&=\\frac{16c^8}{9d^6}\\div\\frac{3}{c^2d}\\\\&=\\frac{16c^8}{9d^6}\\times\\frac{c^2d}{3}\\\\&=\\frac{16c^{10}}{27d^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q12-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{(3m^2n^3)^{-2}}{p^4}\\div\\dfrac{p^{-3}}{m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{9m^3n^6p}$",
          "worked": "$$\\begin{align*}\\frac{(3m^2n^3)^{-2}}{p^4}\\div\\frac{p^{-3}}{m}&=\\frac{1}{9m^4n^6p^4}\\div\\frac{1}{mp^3}\\\\&=\\frac{1}{9m^4n^6p^4}\\times mp^3\\\\&=\\frac{1}{9m^3n^6p}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
