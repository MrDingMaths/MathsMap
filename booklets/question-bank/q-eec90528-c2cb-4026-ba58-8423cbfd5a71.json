    "type": "question",
    "label": "15",
    "prompt": "What is the minimum value of $x^2-6x+2$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-7$",
      "worked": "Let $y=x^2-6x+2$. Completing the square gives\n$$\\begin{align*}y&=x^2-6x+9-9+2\\\\y&=(x-3)^2-7.\\end{align*}$$\nSince $(x-3)^2\\geq0$, the minimum value is $-7$, attained when $x=3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
