        "answer": {
          "short": "$14\\sqrt{7}$",
          "worked": "$$\\begin{align*}\\frac{(2\\sqrt{7})^3}{4}&=\\frac{2^3(\\sqrt{7})^3}{4}\\\\&=\\frac{8\\times7\\sqrt{7}}{4}\\\\&=14\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p40-q11-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{(3\\sqrt{2})^3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27\\sqrt{2}}{2}$",
          "worked": "$$\\begin{align*}\\frac{(3\\sqrt{2})^3}{4}&=\\frac{3^3(\\sqrt{2})^3}{4}\\\\&=\\frac{27\\times2\\sqrt{2}}{4}\\\\&=\\frac{27\\sqrt{2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p40-q11-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{(3\\sqrt{2})^4}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81$",
          "worked": "$$\\begin{align*}\\frac{(3\\sqrt{2})^4}{4}&=\\frac{3^4(\\sqrt{2})^4}{4}\\\\&=\\frac{81\\times4}{4}\\\\&=81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p40-q11-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{(5\\sqrt{2})^2}{4}\\times\\dfrac{(2\\sqrt{3})^3}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\sqrt{3}$; simplify each power, then multiply.",
          "worked": "$$\\begin{align*}\\frac{(5\\sqrt{2})^2}{4}\\times\\frac{(2\\sqrt{3})^3}{3}&=\\frac{25\\times2}{4}\\times\\frac{8\\times3\\sqrt{3}}{3}\\\\&=\\frac{25}{2}\\times8\\sqrt{3}\\\\&=100\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p40-q11-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\dfrac{(2\\sqrt{3})^2}{9}\\times\\dfrac{(-3\\sqrt{2})^4}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$144$; simplify each power, then multiply.",
          "worked": "$$\\begin{align*}\\frac{(2\\sqrt{3})^2}{9}\\times\\frac{(-3\\sqrt{2})^4}{3}&=\\frac{4\\times3}{9}\\times\\frac{81\\times4}{3}\\\\&=\\frac{4}{3}\\times108\\\\&=144\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p40-q11-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\dfrac{(2\\sqrt{5})^3}{5}\\times\\dfrac{(-2\\sqrt{3})^5}{24}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-96\\sqrt{15}$; $8\\sqrt{5}\\times(-12\\sqrt{3})$.",
          "worked": "$$\\begin{align*}\\frac{(2\\sqrt{5})^3}{5}\\times\\frac{(-2\\sqrt{3})^5}{24}&=\\frac{8\\times5\\sqrt{5}}{5}\\times\\frac{-32\\times9\\sqrt{3}}{24}\\\\&=8\\sqrt{5}\\times(-12\\sqrt{3})\\\\&=-96\\sqrt{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p40-q11-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\dfrac{(3\\sqrt{3})^3}{2}\\div\\dfrac{(5\\sqrt{2})^2}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{81\\sqrt{3}}{25}$; multiply by the reciprocal.",
          "worked": "$$\\begin{align*}\\frac{(3\\sqrt{3})^3}{2}\\div\\frac{(5\\sqrt{2})^2}{4}&=\\frac{81\\sqrt{3}}{2}\\div\\frac{50}{4}\\\\&=\\frac{81\\sqrt{3}}{2}\\times\\frac{4}{50}\\\\&=\\frac{81\\sqrt{3}}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p40-q11-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\dfrac{(2\\sqrt{5})^4}{50}\\div\\dfrac{(2\\sqrt{3})^3}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{3\\sqrt{3}}$; $8\\times\\dfrac{5}{24\\sqrt{3}}$.",
          "worked": "$$\\begin{align*}\\frac{(2\\sqrt{5})^4}{50}\\div\\frac{(2\\sqrt{3})^3}{5}&=\\frac{16\\times25}{50}\\div\\frac{8\\times3\\sqrt{3}}{5}\\\\&=8\\times\\frac{5}{24\\sqrt{3}}\\\\&=\\frac{5}{3\\sqrt{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p40-q11-r",
        "type": "part",
        "label": "r",
        "prompt": "$\\dfrac{(2\\sqrt{2})^3}{9}\\div\\dfrac{(2\\sqrt{8})^2}{(\\sqrt{27})^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9\\sqrt{6}}{2}$; $\\dfrac{16\\sqrt{2}}{9}\\times\\dfrac{81\\sqrt{3}}{32}$.",
          "worked": "$$\\begin{align*}\\frac{(2\\sqrt{2})^3}{9}\\div\\frac{(2\\sqrt{8})^2}{(\\sqrt{27})^3}&=\\frac{8\\times2\\sqrt{2}}{9}\\div\\frac{4\\times8}{27\\sqrt{27}}\\\\&=\\frac{16\\sqrt{2}}{9}\\div\\frac{32}{81\\sqrt{3}}\\\\&=\\frac{16\\sqrt{2}}{9}\\times\\frac{81\\sqrt{3}}{32}\\\\&=\\frac{9\\sqrt{6}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
