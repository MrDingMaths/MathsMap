  "content": {
    "id": "p23-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Write these expressions in terms of $\\log_a x$, $\\log_a y$ and $\\log_a z$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a yz$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a y+\\log_a z$",
          "worked": "By the product law,\n$$\\begin{align*}\\log_a(yz)&=\\log_a y+\\log_a z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p23-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a\\frac{z}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a z-\\log_a y$",
          "worked": "By the quotient law,\n$$\\begin{align*}\\log_a\\frac{z}{y}&=\\log_a z-\\log_a y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p23-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a y^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\log_a y$",
          "worked": "By the power law,\n$$\\begin{align*}\\log_a y^4&=4\\log_a y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p23-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_a\\frac{1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\frac{1}{x^2}&=\\log_a x^{-2}\\\\\\log_a\\frac{1}{x^2}&=-2\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p23-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_a xy^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a x+3\\log_a y$",
          "worked": "$$\\begin{align*}\\log_a(xy^3)&=\\log_a x+\\log_a y^3\\\\\\log_a(xy^3)&=\\log_a x+3\\log_a y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p23-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a\\frac{x^2y}{z^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log_a x+\\log_a y-3\\log_a z$",
          "worked": "$$\\begin{align*}\\log_a\\frac{x^2y}{z^3}&=\\log_a(x^2y)-\\log_a z^3\\\\\\log_a\\frac{x^2y}{z^3}&=\\log_a x^2+\\log_a y-\\log_a z^3\\\\\\log_a\\frac{x^2y}{z^3}&=2\\log_a x+\\log_a y-3\\log_a z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_a\\sqrt{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\log_a y$",
          "worked": "$$\\begin{align*}\\log_a\\sqrt{y}&=\\log_a y^{1/2}\\\\\\log_a\\sqrt{y}&=\\frac12\\log_a y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p23-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_a\\sqrt{xz}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\log_a x+\\frac12\\log_a z$",
          "worked": "$$\\begin{align*}\\log_a\\sqrt{xz}&=\\log_a(xz)^{1/2}\\\\\\log_a\\sqrt{xz}&=\\frac12\\log_a(xz)\\\\\\log_a\\sqrt{xz}&=\\frac12\\log_a x+\\frac12\\log_a z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
