  "content": {
    "id": "p5-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find $Q(-1)$, $Q(2)$, $Q(-10)$ and $Q(0)$ for each polynomial.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$Q(x)=x^5+x^4+x^3+x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(-1)=0$, $Q(2)=60$, $Q(-10)=-90\\,900$, $Q(0)=0$.",
          "worked": "$$\\begin{align*}Q(-1)&=(-1)^5+(-1)^4+(-1)^3+(-1)^2\\\\Q(-1)&=-1+1-1+1\\\\Q(-1)&=0\\end{align*}$$\n$$\\begin{align*}Q(2)&=2^5+2^4+2^3+2^2\\\\Q(2)&=32+16+8+4\\\\Q(2)&=60\\end{align*}$$\n$$\\begin{align*}Q(-10)&=(-10)^5+(-10)^4+(-10)^3+(-10)^2\\\\Q(-10)&=-100\\,000+10\\,000-1000+100\\\\Q(-10)&=-90\\,900\\end{align*}$$\n$$\\begin{align*}Q(0)&=0+0+0+0\\\\Q(0)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 88
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$Q(x)=x^4-2x^3-4x^2-8x+32$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(-1)=39$, $Q(2)=0$, $Q(-10)=11\\,712$, $Q(0)=32$.",
          "worked": "$$\\begin{align*}Q(-1)&=(-1)^4-2(-1)^3-4(-1)^2-8(-1)+32\\\\Q(-1)&=1+2-4+8+32\\\\Q(-1)&=39\\end{align*}$$\n$$\\begin{align*}Q(2)&=2^4-2(2)^3-4(2)^2-8(2)+32\\\\Q(2)&=16-16-16-16+32\\\\Q(2)&=0\\end{align*}$$\n$$\\begin{align*}Q(-10)&=(-10)^4-2(-10)^3-4(-10)^2-8(-10)+32\\\\Q(-10)&=10\\,000+2000-400+80+32\\\\Q(-10)&=11\\,712\\end{align*}$$\n$$\\begin{align*}Q(0)&=0-0-0-0+32\\\\Q(0)&=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 96
      },
      {
        "id": "p5-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$Q(x)=5x^3-3x^5+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(-1)=-1$, $Q(2)=-55$, $Q(-10)=295\\,001$, $Q(0)=1$.",
          "worked": "$$\\begin{align*}Q(-1)&=5(-1)^3-3(-1)^5+1\\\\Q(-1)&=-5+3+1\\\\Q(-1)&=-1\\end{align*}$$\n$$\\begin{align*}Q(2)&=5(2)^3-3(2)^5+1\\\\Q(2)&=40-96+1\\\\Q(2)&=-55\\end{align*}$$\n$$\\begin{align*}Q(-10)&=5(-10)^3-3(-10)^5+1\\\\Q(-10)&=-5000+300\\,000+1\\\\Q(-10)&=295\\,001\\end{align*}$$\n$$\\begin{align*}Q(0)&=0-0+1\\\\Q(0)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      },
      {
        "id": "p5-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$Q(x)=x^2+8x-20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(-1)=-27$, $Q(2)=0$, $Q(-10)=0$, $Q(0)=-20$.",
          "worked": "$$\\begin{align*}Q(-1)&=(-1)^2+8(-1)-20\\\\Q(-1)&=1-8-20\\\\Q(-1)&=-27\\end{align*}$$\n$$\\begin{align*}Q(2)&=2^2+8(2)-20\\\\Q(2)&=4+16-20\\\\Q(2)&=0\\end{align*}$$\n$$\\begin{align*}Q(-10)&=(-10)^2+8(-10)-20\\\\Q(-10)&=100-80-20\\\\Q(-10)&=0\\end{align*}$$\n$$\\begin{align*}Q(0)&=0+0-20\\\\Q(0)&=-20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      }
    ]
