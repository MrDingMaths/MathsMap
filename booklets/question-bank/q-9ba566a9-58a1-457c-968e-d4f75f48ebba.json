  "content": {
    "id": "p55-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q1-root-initial",
        "type": "group",
        "label": null,
        "prompt": "State if the following is an identity, contradiction or conditional equation.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p55-q1-a",
            "type": "part",
            "label": "a",
            "prompt": "$4x-1=4(x+1)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Contradiction.",
              "worked": "$$\\begin{align*}4x-1&=4x+4\\\\-1&=4\\end{align*}$$\nThis statement is false, so the equation is a contradiction.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p55-q1-b",
            "type": "part",
            "label": "b",
            "prompt": "$-3(2x+1)-4x=-10(x+1)+7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Identity.",
              "worked": "$$\\begin{align*}-6x-3-4x&=-10x-10+7\\\\-10x-3&=-10x-3\\\\0&=0\\end{align*}$$\nThis is true for all values of $x$, so the equation is an identity.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p55-q1-c",
            "type": "part",
            "label": "c",
            "prompt": "$2x-6+8x=10x-3+x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Conditional equation.",
              "worked": "$$\\begin{align*}10x-6&=11x-3\\\\-6&=x-3\\\\x&=-3\\end{align*}$$\nIt is true only when $x=-3$, so it is a conditional equation.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p55-q1-d",
            "type": "part",
            "label": "d",
            "prompt": "$3x+4=6x-11$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Conditional equation.",
              "worked": "$$\\begin{align*}15&=3x\\\\x&=5\\end{align*}$$\nIt is true only when $x=5$, so it is a conditional equation.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p55-q1-e",
            "type": "part",
            "label": "e",
            "prompt": "$-x+15-3(x+1)=5-4x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Contradiction.",
              "worked": "$$\\begin{align*}-x+15-3x-3&=5-4x\\\\-4x+12&=5-4x\\\\12&=5\\end{align*}$$\nThis statement is false, so the equation is a contradiction.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p55-q1-f",
            "type": "part",
            "label": "f",
            "prompt": "$5(x-1)=7x-2(x+1)-3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Identity.",
              "worked": "$$\\begin{align*}5x-5&=7x-2x-2-3\\\\5x-5&=5x-5\\\\0&=0\\end{align*}$$\nThis is true for all values of $x$, so the equation is an identity.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p55-q1-g",
            "type": "part",
            "label": "g",
            "prompt": "$4(3p+6q)+6(4p-q)=18(2p+q)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Identity.",
              "worked": "$$\\begin{align*}12p+24q+24p-6q&=36p+18q\\\\36p+18q&=36p+18q\\\\0&=0\\end{align*}$$\nThis is true for all values of $p$ and $q$, so the equation is an identity.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 41
          },
          {
            "id": "p55-q1-h",
            "type": "part",
            "label": "h",
            "prompt": "$3(3x-1)=9x+7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Contradiction.",
              "worked": "$$\\begin{align*}9x-3&=9x+7\\\\-3&=7\\end{align*}$$\nThis statement is false, so the equation is a contradiction.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p55-q2-response",
        "type": "part",
        "label": "i",
        "prompt": {
