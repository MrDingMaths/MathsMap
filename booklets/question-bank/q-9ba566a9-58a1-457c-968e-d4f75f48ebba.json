                {
                  "type": "cloze",
                  "answer": "parallel",
                  "width": 24
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "A contradiction has no solution. The two lines have the same gradient and different $y$-intercepts, so they are parallel and never intersect.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p55-q4-instruction",
        "type": "part",
        "label": "k",
        "prompt": "Check your answers to parts a–h by graphing $y=\\mathit{LHS}$ and $y=\\mathit{RHS}$ using DESMOS. For part g, choose a fixed value of $q$ and replace $p$ with $x$ before plotting in Desmos.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "a, e, h: parallel. b, f, g: coincident. c, d: one intersection.",
          "worked": "Plot the left and right sides of each equation in Desmos. The graphs are parallel for a, e and h, confirming contradictions. They coincide for b, f and g, confirming identities. For g, choose a fixed value of $q$ and replace $p$ with $x$ when entering both sides in Desmos: both graphs are the same line, $y=36x+18q$. The graphs intersect once for c and d, confirming conditional equations. For c, the intersection is $(-3,-36)$; for d, it is $(5,19)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      }
    ]
