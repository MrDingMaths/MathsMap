  "content": {
    "id": "p33-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The population of a city increases annually at a compound rate of $3.2\\%$ for five years. If the population is $21\\,000$ initially, what is it at the end of the five-year period, and what is the total percentage increase? Give the population to the nearest whole person and the percentage increase to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$24\\,582$ people; $17.06\\%$ increase.",
      "worked": "$$\\begin{align*}N&=21\\,000(1.032)^5\\\\N&\\approx24\\,582\\text{ people}\\\\\\text{Percentage increase}&=((1.032)^5-1)\\times100\\%\\\\\\text{Percentage increase}&\\approx17.06\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
