    "children": [
      {
        "id": "p10-q18-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the income tax payable on:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q18-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\$9000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$0$",
              "worked": "The income is below the tax-free threshold of $\\$12\\,000$, so no income tax is payable.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p10-q18-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\$15\\,000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$450$",
              "worked": "The first $\\$12\\,000$ is tax-free.\n$$\\begin{align*}\\text{Tax}&=(15\\,000-12\\,000)\\times0.15\\\\\\text{Tax}&=3000\\times0.15\\\\\\text{Tax}&=\\$450\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p10-q18-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\$38\\,000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$4700$",
              "worked": "$$\\begin{align*}\\text{Tax on next }\\$18\\,000&=18\\,000\\times0.15\\\\\\text{Tax on next }\\$18\\,000&=\\$2700\\\\\\text{Tax on remaining }\\$8000&=8000\\times0.25\\\\\\text{Tax on remaining }\\$8000&=\\$2000\\\\\\text{Total tax}&=2700+2000\\\\\\text{Total tax}&=\\$4700\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p10-q18-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$\\$400\\,000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$127\\,700$",
              "worked": "$$\\begin{align*}\\text{Tax on next }\\$18\\,000&=18\\,000\\times0.15\\\\\\text{Tax on next }\\$18\\,000&=\\$2700\\\\\\text{Tax on next }\\$45\\,000&=45\\,000\\times0.25\\\\\\text{Tax on next }\\$45\\,000&=\\$11\\,250\\\\\\text{Tax on remaining }\\$325\\,000&=325\\,000\\times0.35\\\\\\text{Tax on remaining }\\$325\\,000&=\\$113\\,750\\\\\\text{Total tax}&=2700+11\\,250+113\\,750\\\\\\text{Total tax}&=\\$127\\,700\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      },
      {
        "id": "p10-q18-b",
        "type": "group",
        "label": "b",
        "prompt": "What percentage of each person’s income was paid in income tax in parts i–iv of part a? Give percentages to the nearest 0.01% where necessary.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q18-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Part a(i)",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0\\%$",
              "worked": "$$\\begin{align*}\\text{Percentage paid}&=\\frac{0}{9000}\\times100\\%\\\\\\text{Percentage paid}&=0\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p10-q18-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Part a(ii)",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3\\%$",
              "worked": "$$\\begin{align*}\\text{Percentage paid}&=\\frac{450}{15\\,000}\\times100\\%\\\\\\text{Percentage paid}&=3\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p10-q18-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Part a(iii)",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12.37\\%$",
              "worked": "$$\\begin{align*}\\text{Percentage paid}&=\\frac{4700}{38\\,000}\\times100\\%\\\\\\text{Percentage paid}&\\approx12.37\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p10-q18-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "Part a(iv)",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$31.93\\%$",
              "worked": "$$\\begin{align*}\\text{Percentage paid}&=\\frac{127\\,700}{400\\,000}\\times100\\%\\\\\\text{Percentage paid}&=31.925\\%\\\\\\text{Percentage paid}&\\approx31.93\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p10-q18-c",
        "type": "group",
        "label": "c",
        "prompt": "Find the income if the income tax on it was: Give incomes to the nearest cent where necessary.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q18-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\$1580$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$22\\,533.33$",
              "worked": "Tax at an income of $\\$30\\,000$ is $18\\,000\\times0.15=\\$2700$. Since $1580<2700$, reverse the 15% calculation.\n$$\\begin{align*}\\text{Income above }\\$12\\,000&=1580\\div0.15\\\\\\text{Income}&=12\\,000+\\frac{1580}{0.15}\\\\\\text{Income}&\\approx\\$22\\,533.33\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          },
          {
            "id": "p10-q18-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\$3860$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$34\\,640.00$",
              "worked": "Tax at $\\$30\\,000$ is $\\$2700$ and at $\\$75\\,000$ is $\\$13\\,950$. Thus the excess tax is charged at 25%.\n$$\\begin{align*}\\text{Excess tax}&=3860-2700\\\\\\text{Excess tax}&=\\$1160\\\\\\text{Income above }\\$30\\,000&=1160\\div0.25\\\\\\text{Income above }\\$30\\,000&=\\$4640\\\\\\text{Income}&=30\\,000+4640\\\\\\text{Income}&=\\$34\\,640.00\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 37
          },
          {
            "id": "p10-q18-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\$15\\,200$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$78\\,571.43$",
              "worked": "$$\\begin{align*}\\text{Tax on first }\\$75\\,000&=18\\,000(0.15)+45\\,000(0.25)\\\\\\text{Tax on first }\\$75\\,000&=\\$13\\,950\\\\\\text{Excess tax}&=15\\,200-13\\,950\\\\\\text{Excess tax}&=\\$1250\\\\\\text{Income above }\\$75\\,000&=1250\\div0.35\\\\\\text{Income}&=75\\,000+\\frac{1250}{0.35}\\\\\\text{Income}&\\approx\\$78\\,571.43\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 37
          },
          {
            "id": "p10-q18-c-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$\\$15\\,000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$78\\,000.00$",
              "worked": "$$\\begin{align*}\\text{Tax on first }\\$75\\,000&=18\\,000(0.15)+45\\,000(0.25)\\\\\\text{Tax on first }\\$75\\,000&=\\$13\\,950\\\\\\text{Excess tax}&=15\\,000-13\\,950\\\\\\text{Excess tax}&=\\$1050\\\\\\text{Income above }\\$75\\,000&=1050\\div0.35\\\\\\text{Income above }\\$75\\,000&=\\$3000\\\\\\text{Income}&=75\\,000+3000\\\\\\text{Income}&=\\$78\\,000.00\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 37
          }
        ]
      }
