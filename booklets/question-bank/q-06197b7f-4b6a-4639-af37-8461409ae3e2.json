  "content": {
    "id": "p6-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "In my neighbourhood, 90% of the properties are houses and 10% are shops. If 10% of the houses are for sale and 30% of the shops are for sale, then what percentage of the properties are for sale?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\%$.\n\nFind each category’s contribution to the total and add.",
      "worked": "$$\\begin{align*}\\text{Houses for sale as a percentage of all properties} &= \\frac{10}{100}\\times90\\%\\\\\\text{Houses for sale as a percentage of all properties} &= 9\\%\\\\\\text{Shops for sale as a percentage of all properties} &= \\frac{30}{100}\\times10\\%\\\\\\text{Shops for sale as a percentage of all properties} &= 3\\%\\\\\\text{Properties for sale} &= 9\\%+3\\%\\\\\\text{Properties for sale} &= 12\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
