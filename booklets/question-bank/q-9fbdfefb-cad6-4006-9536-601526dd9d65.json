    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Squaring the equation introduces extra solutions.",
      "worked": "Squaring loses the distinction between equal and opposite values. The squared equation also allows $\\sin\\theta=-\\cos\\theta$.\nAt $135^\\circ$ and $315^\\circ$, sine and cosine have opposite signs, so these angles fail the original equation. At $45^\\circ$ and $225^\\circ$, sine and cosine are equal.\nThe correct solutions are $\\theta=45^\\circ,225^\\circ$; the candidates must be checked in the original equation.",
      "solutionDiagrams": []
    },
