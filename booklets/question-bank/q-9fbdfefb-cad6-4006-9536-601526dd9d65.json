            {
              "type": "text",
              "text": "What is wrong with the following solution to solving the equation ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\sin\\theta=\\cos\\theta",
              "display": false
            },
            {
              "type": "text",
              "text": " in the domain ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\theta\\in[0,360^\\circ]",
              "display": false
            },
            {
              "type": "text",
              "text": "?",
              "marks": []
            }
          ]
        },
        {
          "id": "p21-p4-working-paragraph",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}\\sin\\theta&=\\cos\\theta\\\\\\sin^2\\theta&=\\cos^2\\theta\\\\\\sin^2\\theta-\\cos^2\\theta&=0\\\\\\sin^2\\theta-(1-\\sin^2\\theta)&=0\\\\2\\sin^2\\theta-1&=0\\\\\\sin\\theta&=\\pm\\frac{1}{\\sqrt2}\\\\\\therefore\\theta&=45^\\circ,135^\\circ,225^\\circ,315^\\circ\\end{aligned}",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
