  "content": {
    "id": "p22-q44-51-root",
    "type": "question",
    "label": "",
    "prompt": "Differentiate the following by first simplifying.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q44-51-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(2x+1)(3x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=12x+1$. Expand first.",
          "worked": "$$\\begin{align*}y&=6x^2+x-1\\\\y'&=12x+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q44-51-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x^2+1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=1-\\dfrac1{x^2}$. Split the numerator over $x$.",
          "worked": "$$\\begin{align*}y&=x+\\dfrac1x\\\\y&=x+x^{-1}\\\\y'&=1-x^{-2}\\\\y'&=1-\\dfrac1{x^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p22-q44-51-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{x^2-5x+6}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=1$ for $x\\ne2$. Factorise and cancel $x-2$.",
          "worked": "$$\\begin{align*}y&=\\dfrac{(x-2)(x-3)}{x-2}\\\\y&=x-3\\qquad(x\\ne2)\\\\y'&=1\\qquad(x\\ne2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q44-51-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{3x^2-6x+8}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3-\\dfrac8{x^2}$. Divide each numerator term by $x$.",
          "worked": "$$\\begin{align*}y&=3x-6+\\dfrac8x\\\\y&=3x-6+8x^{-1}\\\\y'&=3-8x^{-2}\\\\y'&=3-\\dfrac8{x^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p22-q44-51-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{2x+1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac1{x^2}$. First write $y=2+x^{-1}$.",
          "worked": "$$\\begin{align*}y&=2+\\dfrac1x\\\\y&=2+x^{-1}\\\\y'&=-x^{-2}\\\\y'&=-\\dfrac1{x^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p22-q44-51-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{x-1}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac1{2\\sqrt{x}}+\\dfrac1{2x^{3/2}}$. Split the numerator and use fractional indices.",
          "worked": "$$\\begin{align*}y&=\\dfrac{x}{\\sqrt{x}}-\\dfrac1{\\sqrt{x}}\\\\y&=x^{1/2}-x^{-1/2}\\\\y'&=\\dfrac12x^{-1/2}+\\dfrac12x^{-3/2}\\\\y'&=\\dfrac1{2\\sqrt{x}}+\\dfrac1{2x^{3/2}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p22-q44-51-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\dfrac{x^2+5x+6}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac5{x^2}-\\dfrac{12}{x^3}$. Split over $x^2$.",
          "worked": "$$\\begin{align*}y&=1+\\dfrac5x+\\dfrac6{x^2}\\\\y&=1+5x^{-1}+6x^{-2}\\\\y'&=-5x^{-2}-12x^{-3}\\\\y'&=-\\dfrac5{x^2}-\\dfrac{12}{x^3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p22-q44-51-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=x(x-1)(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3x^2-1$. Use $(x-1)(x+1)=x^2-1$ first.",
          "worked": "$$\\begin{align*}y&=x(x^2-1)\\\\y&=x^3-x\\\\y'&=3x^2-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
