    "answer": {
      "short": "$46.75\\%$. Subtract the inner sector from the outer sector, then divide by the windscreen area and multiply by 100.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p31-q2-answer-radius",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}R&=10+30\\\\R&=40\\ \\text{cm}\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p31-q2-answer-areas",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}A_{\\text{wiped}}&=\\frac{\\theta}{360}\\pi R^2-\\frac{\\theta}{360}\\pi r^2\\\\A_{\\text{wiped}}&=\\frac{100}{360}\\pi(40)^2-\\frac{100}{360}\\pi(10)^2\\\\A_{\\text{windscreen}}&=40\\times70\\\\A_{\\text{windscreen}}&=2800\\ \\text{cm}^{2}\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p31-q2-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\text{Percentage wiped}&=\\frac{\\frac{100}{360}\\pi(40)^2-\\frac{100}{360}\\pi(10)^2}{40\\times70}\\times100\\%\\\\\\text{Percentage wiped}&\\approx46.75\\%\\quad\\text{(2 d.p.)}\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
