            {
              "type": "text",
              "text": "Water is being poured into a fish tank at a rate of 2 L every 10 seconds.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "The tank is 1.2 m long by 1 m wide by 80 cm high.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "How long will it take to fill the tank? Give the answer in minutes.",
              "marks": []
            }
