    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "80 minutes",
      "worked": "For an initially empty rectangular tank:\n$${\\def\\arraystretch{0.65}\\begin{align*} h &= 80\\div100\\text{ m} \\\\ h &= 0.8\\text{ m} \\\\ V &= Ah \\\\ V &= (1.2\\times1)\\times0.8\\text{ m}^3 \\\\ V &= 0.96\\text{ m}^3 \\\\ C &= 0.96\\times1000\\text{ L} \\\\ C &= 960\\text{ L} \\\\ \\text{Rate} &= \\frac{2}{10}\\text{ L/s} \\\\ \\text{Rate} &= 0.2\\text{ L/s} \\\\ \\text{Rate} &= 0.2\\times60\\text{ L/min} \\\\ \\text{Rate} &= 12\\text{ L/min} \\\\ \\text{Time} &= \\frac{960}{12}\\text{ min} \\\\ \\text{Time} &= 80\\text{ min} \\end{align*}}$$",
      "solutionDiagrams": []
    },
