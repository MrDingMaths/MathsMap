  "content": {
    "id": "p96-task-q9-content",
    "type": "question",
    "label": "2",
    "prompt": "What can we say about $y$ and $z$ if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p96-task-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y$ varies directly with $x$ and $x$ varies directly with $z$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ varies directly with $z$.",
          "worked": "Write $y=ax$ and $x=bz$, where $a$ and $b$ are nonzero constants.\n\n$$\\begin{align*}y&=a(bz)\\\\y&=abz\\end{align*}$$\n\nSince $ab$ is a nonzero constant, $y$ varies directly with $z$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p96-task-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$ varies directly with $x$ and $x$ varies inversely with $z$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ varies inversely with $z$.",
          "worked": "Write $y=ax$ and $x=\\dfrac{b}{z}$, where $a$ and $b$ are nonzero constants.\n\n$$\\begin{align*}y&=a\\left(\\frac{b}{z}\\right)\\\\y&=\\frac{ab}{z}\\end{align*}$$\n\nSince $ab$ is a nonzero constant, $y$ varies inversely with $z$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p96-task-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$y$ varies inversely with $x$ and $x$ varies directly with $z$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ varies inversely with $z$.",
          "worked": "Write $y=\\dfrac{a}{x}$ and $x=bz$, where $a$ and $b$ are nonzero constants.\n\n$$\\begin{align*}y&=\\frac{a}{bz}\\\\y&=\\frac{a/b}{z}\\end{align*}$$\n\nSince $\\dfrac{a}{b}$ is a nonzero constant, $y$ varies inversely with $z$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p96-task-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$y$ varies inversely with $x$ and $x$ varies inversely with $z$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ varies directly with $z$.",
          "worked": "Write $y=\\dfrac{a}{x}$ and $x=\\dfrac{b}{z}$, where $a$ and $b$ are nonzero constants.\n\n$$\\begin{align*}y&=\\frac{a}{b/z}\\\\y&=\\frac{a}{b}z\\end{align*}$$\n\nSince $\\dfrac{a}{b}$ is a nonzero constant, $y$ varies directly with $z$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
