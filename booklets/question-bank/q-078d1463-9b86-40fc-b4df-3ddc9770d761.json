  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider the trigonometric equation $\\sin\\theta=\\frac12$, which has two solutions in the interval $\\theta\\in[0^\\circ,360^\\circ]$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the acute value of $\\theta$ that satisfies the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^\\circ$",
          "worked": "$\\sin30^\\circ=\\frac12$, so the acute value is $\\theta=30^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Note that $\\sin\\theta$ is positive. Using All Stations To Central or a similar mnemonic, in what quadrant should the other solution lie?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Second quadrant.",
          "worked": "Sine is positive in the first and second quadrants. The acute solution is in the first quadrant, so the other solution is in the second quadrant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the related angle, in the correct quadrant, to the acute angle that you found in (a). Hence write down the two solutions to $\\sin\\theta=\\frac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=30^\\circ,150^\\circ$.",
          "worked": "The second-quadrant angle is $180^\\circ-30^\\circ=150^\\circ$. Hence $\\theta=30^\\circ,150^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
