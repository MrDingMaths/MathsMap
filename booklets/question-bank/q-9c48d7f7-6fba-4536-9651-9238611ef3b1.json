  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Consider points $A(1,1)$ and $B(3,5)$. Find the point $N$ that divides the line segment $AB$ in the ratio $1:2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$N\\left(\\frac53,\\frac73\\right)$.",
      "worked": "$N$ is $\\frac13$ of the way from $A$ to $B$.\n$$\\begin{align*}x_N&=1+\\frac13(3-1)\\\\x_N&=\\frac53\\\\y_N&=1+\\frac13(5-1)\\\\y_N&=\\frac73.\\end{align*}$$\nTherefore, $N\\left(\\frac53,\\frac73\\right)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 58
  },
