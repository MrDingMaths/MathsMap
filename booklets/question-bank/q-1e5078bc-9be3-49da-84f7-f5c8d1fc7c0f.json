  "content": {
    "id": "p43-q56-root",
    "type": "question",
    "label": "56",
    "prompt": "The price of shares in a particular company is falling by an average of 2% each day.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q56-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage of their initial value do they have after 2 days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$96.04\\%$",
          "worked": "Each day's value is $0.98$ times the previous day's value.\n$$\\begin{align*}\\text{Proportion remaining after 2 days}&=(0.98)^2\\\\&=0.9604\\\\\\text{Percentage remaining}&=96.04\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p43-q56-b",
        "type": "part",
        "label": "b",
        "prompt": "Approximately how many days will it take for the shares to halve in value?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 34 days.",
          "worked": "Let $n$ be the number of days.\n$$\\begin{align*}(0.98)^n&=0.5\\\\n&=\\log_{0.98}(0.5)\\\\n&\\approx34.3.\\end{align*}$$\nTherefore, approximately 34 days.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
