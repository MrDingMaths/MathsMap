  "content": {
    "id": "v2-55815-p13-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Find the standard deviation of each normal distribution.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-55815-p13-practice-slot-3-gen-slot-3-a",
        "type": "part",
        "label": "a",
        "prompt": "The mean is $64$ and a raw score of $85$ has z-score $1.75$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sigma=12$",
          "worked": "$$\\begin{align*}z&=\\frac{x-\\mu}{\\sigma}\\\\1.75&=\\frac{85-64}{\\sigma}\\\\\\sigma&=\\frac{21}{1.75}\\\\\\sigma&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-55815-p13-practice-slot-3-gen-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "The mean is $5.2$ and the z-score of $3.7$ is $-1.25$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sigma=1.2$",
          "worked": "$$\\begin{align*}z&=\\frac{x-\\mu}{\\sigma}\\\\-1.25&=\\frac{3.7-5.2}{\\sigma}\\\\\\sigma&=\\frac{-1.5}{-1.25}\\\\\\sigma&=1.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
