  "content": {
    "id": "p28-q5",
    "type": "question",
    "label": "5",
    "prompt": "A fair die is rolled 6 times. Find the probability that exactly 2 of the rolls show a three. Give your answer correct to four decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.2009$",
      "worked": "Success: the roll shows a three. Let $X$ be the number of threes, so $X\\sim\\operatorname{Bin}(6,\\frac16)$.\n$$\\begin{align*}P(X=2)&=\\binom{6}{2}\\left(\\frac16\\right)^2\\left(\\frac56\\right)^4\\\\&=\\frac{3125}{15552}\\\\&\\approx0.2009\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 21
