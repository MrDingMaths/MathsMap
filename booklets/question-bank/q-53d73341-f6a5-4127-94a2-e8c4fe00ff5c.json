  "content": {
    "id": "p68-q12-response",
    "type": "question",
    "label": null,
    "prompt": "Find the value(s) of $c$ so that the line $y=2x+c$ is a tangent to the parabola $y=-x^2-2x+2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c=6$.",
      "worked": "$$\\begin{align*}2x+c&=-x^2-2x+2\\\\x^2+4x+c-2&=0\\end{align*}$$\nFor tangency, the intersection equation has one repeated root, so $\\Delta=0$.\n$$\\begin{align*}4^2-4(c-2)&=0\\\\24-4c&=0\\\\c&=6\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
