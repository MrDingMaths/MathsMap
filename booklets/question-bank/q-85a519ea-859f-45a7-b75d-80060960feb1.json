  "content": {
    "id": "v2-400600-p8-practice-j5-033619-root",
    "type": "question",
    "label": null,
    "prompt": "Express $\\dfrac{m^{-2}}{n^{-1}}$ with positive indices only.\n\nFirst, $n^{-1}$ moves from the denominator to the numerator.\n$$\\frac{m^{-2}}{n^{-1}}=m^{-2}n$$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-400600-p8-practice-j5-033619-j5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Now move $m^{-2}$ from the numerator to the denominator to finish the expression.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n}{m^2}$",
          "worked": "$$\\begin{align*}\\frac{m^{-2}}{n^{-1}}&=m^{-2}n\\\\&=\\frac{n}{m^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-400600-p8-practice-j5-033619-j5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the same two moves to express $\\dfrac{c^{-3}}{d^{-4}}$ with positive indices only.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d^4}{c^3}$",
          "worked": "$$\\begin{align*}\\frac{c^{-3}}{d^{-4}}&=c^{-3}d^4\\\\&=\\frac{d^4}{c^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
