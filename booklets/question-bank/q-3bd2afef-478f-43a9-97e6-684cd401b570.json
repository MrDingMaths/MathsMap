  "content": {
    "id": "p7-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A circle has circumference $62.8\\text{ cm}$. Using $\\pi\\approx3.14$, find the approximate value of the radius of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10\\text{ cm}$",
      "worked": "$$\\begin{align*}C&=2\\pi r\\\\r&=\\frac{C}{2\\pi}\\\\r&\\approx\\frac{62.8}{2\\times3.14}\\\\r&\\approx10\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
