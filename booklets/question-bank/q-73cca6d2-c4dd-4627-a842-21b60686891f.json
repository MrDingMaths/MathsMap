  "content": {
    "id": "p54-q9",
    "type": "question",
    "label": "9",
    "prompt": "Factorise:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$-x^{2}-5x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+2)(x+3)$",
          "worked": "P: $6$, S: $-5$, F: $-2,-3$.\n$$\\begin{align*}-x^{2}-5x-6&=-x^{2}-2x-3x-6\\\\&=-x(x+2)-3(x+2)\\\\&=(x+2)(-x-3)\\\\&=-(x+2)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p54-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$-2x^{2}-5x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(2x+3)(x+1)$",
          "worked": "P: $6$, S: $-5$, F: $-2,-3$.\n$$\\begin{align*}-2x^{2}-5x-3&=-2x^{2}-2x-3x-3\\\\&=-2x(x+1)-3(x+1)\\\\&=(-2x-3)(x+1)\\\\&=-(2x+3)(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p54-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$-2x^{2}+5x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(2x-3)(x-1)$",
          "worked": "P: $6$, S: $5$, F: $2,3$.\n$$\\begin{align*}-2x^{2}+5x-3&=-2x^{2}+2x+3x-3\\\\&=-2x(x-1)+3(x-1)\\\\&=(-2x+3)(x-1)\\\\&=-(2x-3)(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p54-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$-3x^{2}+x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(3x+2)(x-1)$",
          "worked": "P: $-6$, S: $1$, F: $3,-2$.\n$$\\begin{align*}-3x^{2}+x+2&=-3x^{2}+3x-2x+2\\\\&=-3x(x-1)-2(x-1)\\\\&=(-3x-2)(x-1)\\\\&=-(3x+2)(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p54-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$-6x^{2}+x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(3x-2)(2x+1)$",
          "worked": "P: $-12$, S: $1$, F: $-3,4$.\n$$\\begin{align*}-6x^{2}+x+2&=-6x^{2}-3x+4x+2\\\\&=-3x(2x+1)+2(2x+1)\\\\&=(-3x+2)(2x+1)\\\\&=-(3x-2)(2x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
