  "content": {
    "id": "p45-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the number of circular arrangements of the word EXACTING if",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7!=5040$",
          "worked": "There are eight distinct letters. Fix one letter and arrange the other seven relative to it.\n\n$$N=(8-1)!=7!=5040.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p45-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "the vowels must be separate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p45-q6-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "4!\\times5\\times4\\times3=1440",
                    "display": false
                  }
                ]
              },
              {
                "id": "p45-q6-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Arrange the consonants in a circle, then put the vowels in distinct gaps.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Arrange the five consonants X, C, T, N and G in a circle in $4!$ ways. There are five circular gaps. Place E, A and I in distinct gaps in $5\\times4\\times3$ ways.\n\n$$\\begin{align*}N&=4!\\times5\\times4\\times3\\\\N&=1440\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p45-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "the vowels are together, but the X and C are separate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p45-q6-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "3!\\times3!\\times4\\times3=432",
                    "display": false
                  }
                ]
              },
              {
                "id": "p45-q6-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Group the vowels and subtract arrangements in which X and C are adjacent.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Treat E, A and I as one block, with $3!$ internal orders. The block and five consonants form six entities, giving $5!$ circular arrangements. If X and C are adjacent, treat them as another block: there are $2!\\times4!$ circular arrangements of these entities.\n\n$$\\begin{align*}N&=3!(5!-2!\\times4!)\\\\N&=6(120-48)\\\\N&=432\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
