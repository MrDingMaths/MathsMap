  "content": {
    "id": "p12-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "List all of the positive integers less than or equal to 15 that are coprime to 15. Hence, determine $\\phi(15)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1,2,4,7,8,11,13,14$; $\\phi(15)=8$.",
      "worked": "Since $15=3\\times5$, an integer is coprime to 15 precisely when it is divisible by neither 3 nor 5. The required integers are\n$$1,2,4,7,8,11,13,14.$$\nThere are eight such integers, so\n$$\\phi(15)=8.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
