  "content": {
    "id": "p13-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The local council gets 2190 complaints per 3 years. How many is this per month?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$60.8\\dot{3}$ complaints/month",
      "worked": "$$\\begin{align*}\\frac{2190\\text{ complaints}}{3\\text{ years}}&=\\frac{2190\\text{ complaints}}{(3\\times12)\\text{ months}}\\\\&=\\frac{2190\\text{ complaints}}{36\\text{ months}}\\\\&=60.8\\dot{3}\\text{ complaints/month}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
