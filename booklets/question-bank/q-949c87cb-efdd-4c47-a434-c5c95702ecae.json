    "answer": {
      "short": "$71\\%$",
      "worked": "$$\\begin{align*}2\\text{ L}&=2000\\text{ mL}\\\\\\text{Milk left}&=2000-580\\\\&=1420\\text{ mL}\\\\\\frac{1420}{2000}&=\\frac{71}{100}\\\\&=71\\%\\end{align*}$$",
