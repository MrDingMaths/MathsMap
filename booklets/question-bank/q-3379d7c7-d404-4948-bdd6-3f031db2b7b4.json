  "content": {
    "id": "p25-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Find the average of each of these lists of numbers.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$-1\\frac{1}{4},\\ 2\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "Add the numbers and divide by $2$.\n\n$$\\begin{align*}\\text{Average}&=\\left(-\\frac{5}{4}+\\frac{10}{4}\\right)\\div2\\\\\\text{Average}&=\\frac{5}{4}\\div2\\\\\\text{Average}&=\\frac{5}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$-1,\\ -1\\frac{1}{2},\\ 0,\\ 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{8}$",
          "worked": "Add the numbers and divide by $4$.\n\n$$\\begin{align*}\\text{Average}&=\\left(-1-\\frac{3}{2}+0+6\\right)\\div4\\\\\\text{Average}&=\\frac{7}{2}\\div4\\\\\\text{Average}&=\\frac{7}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$-\\frac{3}{4},\\ -\\frac{1}{2},\\ -\\frac{1}{8},\\ \\frac{1}{2},\\ \\frac{1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{8}$",
          "worked": "Add the numbers and divide by $5$.\n\n$$\\begin{align*}\\text{Average}&=\\left(-\\frac{3}{4}-\\frac{1}{2}-\\frac{1}{8}+\\frac{1}{2}+\\frac{1}{4}\\right)\\div5\\\\\\text{Average}&=\\frac{-6-4-1+4+2}{8}\\div5\\\\\\text{Average}&=-\\frac{5}{8}\\div5\\\\\\text{Average}&=-\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
