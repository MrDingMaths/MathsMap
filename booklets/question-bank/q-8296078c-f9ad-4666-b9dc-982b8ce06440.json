      {
        "id": "v2-p43-mixed-practice-slot-6-slot-6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{7x+4}{x^2-x-6}=\\dfrac{5}{x-3}+\\dfrac{2}{x+2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{RHS}=\\dfrac{5(x+2)+2(x-3)}{(x-3)(x+2)}=\\dfrac{7x+4}{x^2-x-6}=\\mathrm{LHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{RHS}&=\\frac{5}{x-3}+\\frac{2}{x+2}\\\\&=\\frac{5(x+2)+2(x-3)}{(x-3)(x+2)}\\\\&=\\frac{7x+4}{x^2-x-6}=\\mathrm{LHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-p43-mixed-practice-slot-6-slot-6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int\\frac{7x+4}{x^2-x-6}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\ln|x-3|+2\\ln|x+2|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{7x+4}{x^2-x-6}\\,dx&=\\int\\left(\\frac{5}{x-3}+\\frac{2}{x+2}\\right)\\,dx\\\\&=5\\ln|x-3|+2\\ln|x+2|+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
