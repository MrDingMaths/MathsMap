  "content": {
    "id": "p17-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A line has equation $3x-by+10=0$ and gradient $-\\frac{1}{2}$. Find the value of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=-6$.",
      "worked": "$$\\begin{align*}by&=3x+10\\\\y&=\\frac{3}{b}x+\\frac{10}{b}\\end{align*}$$\nThe gradient is the coefficient of $x$, so\n$$\\begin{align*}\\frac{3}{b}&=-\\frac{1}{2}\\\\6&=-b\\\\b&=-6\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
