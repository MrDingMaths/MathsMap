    "type": "question",
    "label": "4",
    "prompt": "Find the integers $p$ and $q$ such that $\\frac{\\sqrt{5}}{\\sqrt{5}-2}=p+q\\sqrt{5}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=5,\\ q=2$",
      "worked": "$$\\begin{align*}\\frac{\\sqrt{5}}{\\sqrt{5}-2}&=\\frac{\\sqrt{5}}{\\sqrt{5}-2}\\times\\frac{\\sqrt{5}+2}{\\sqrt{5}+2}\\\\\\frac{\\sqrt{5}}{\\sqrt{5}-2}&=\\frac{5+2\\sqrt{5}}{5-4}\\\\\\frac{\\sqrt{5}}{\\sqrt{5}-2}&=5+2\\sqrt{5}\\end{align*}$$\nComparing coefficients gives $p=5$ and $q=2$.",
      "solutionDiagrams": []
    },
