    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q29-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine whether each of the random variables is discrete, continuous, or neither.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$L$: continuous; $X$: discrete; $Y$: neither (non-numerical); $Z$: discrete.",
          "worked": "$L$ is continuous because its possible lengths form an interval.\n\n$X$ is discrete because its possible rounded values can be listed.\n\n$Y$ is neither under the textbook's classification because its outputs are intervals, rather than numerical values.\n\n$Z$ is discrete because its possible numerical midpoints can be listed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p50-q29-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the range of each random variable?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p50-q29-b-short-L",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "L:\\ (0,100]",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " cm.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p50-q29-b-short-X",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "X:\\ \\{0.0,0.1,0.2,\\ldots,99.9,100.0\\}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p50-q29-b-short-Y",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "Y:\\ \\{[0,1),[1,2),[2,3),\\ldots,[99,100),[100,101)\\}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p50-q29-b-short-Z",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "Z:\\ \\{0.5,1.5,2.5,\\ldots,99.5,100.5\\}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p50-q29-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Round the possible positive lengths, then find their containing unit intervals and midpoints.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The cut string has $0<L\\le100$ cm. Small positive lengths can round to $0.0$, and $100.0$ lies in $[100,101)$.\n\n$$\\begin{align*}\\operatorname{range}(L)&=(0,100],\\\\\\operatorname{range}(X)&=\\{0.0,0.1,0.2,\\ldots,99.9,100.0\\},\\\\\\operatorname{range}(Y)&=\\{[0,1),[1,2),[2,3),\\ldots,[99,100),[100,101)\\},\\\\\\operatorname{range}(Z)&=\\{0.5,1.5,2.5,\\ldots,99.5,100.5\\}.\\end{align*}$$\n\nEach interval $[n,n+1)$ has midpoint $n+0.5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p50-q29-c",
        "type": "part",
        "label": "c",
        "prompt": "If $X=18.7$, what are the possible values of $L$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18.65\\le L<18.75$ cm.",
          "worked": "The halfway values on either side of $18.7$ are $18.65$ and $18.75$. Using ordinary rounding to one decimal place,\n\n$$18.65\\le L<18.75\\text{ cm}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p50-q29-d",
        "type": "part",
        "label": "d",
        "prompt": "If $X=78.8$, what is the value of $Z$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Z=78.5$.",
          "worked": "$$\\begin{align*}Y&=[78,79),\\\\Z&=\\frac{78+79}{2}=78.5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-q29-e",
        "type": "part",
        "label": "e",
        "prompt": "If $L=34.963$, what is the value of $Z$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Z=35.5$.",
          "worked": "$$\\begin{align*}X&=35.0,\\\\Y&=[35,36),\\\\Z&=\\frac{35+36}{2}=35.5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
