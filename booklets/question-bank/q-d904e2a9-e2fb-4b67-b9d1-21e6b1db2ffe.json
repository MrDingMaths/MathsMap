    "id": "p8-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "For $n>1$, prove that $2^n<\\binom{2n}{n}<2^{2n}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
