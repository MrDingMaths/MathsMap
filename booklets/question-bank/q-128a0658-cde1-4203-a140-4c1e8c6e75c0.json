  "content": {
    "id": "p42-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "For the CDF $F(x)=\\dfrac{x^3+8}{16}$, find",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "the median $Q_2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q_2=0$",
          "worked": "$$\\begin{align*}F(Q_2)&=\\frac12\\\\\\frac{Q_2^3+8}{16}&=\\frac12\\\\Q_2^3+8&=8\\\\Q_2^3&=0\\\\Q_2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p42-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$Q_1$ and $Q_3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q_1=-\\sqrt[3]{4}$; $Q_3=\\sqrt[3]{4}$.",
          "worked": "$$\\begin{align*}F(Q_1)&=\\frac14\\\\\\frac{Q_1^3+8}{16}&=\\frac14\\\\Q_1^3+8&=4\\\\Q_1^3&=-4\\\\Q_1&=-\\sqrt[3]{4}\\end{align*}$$\n$$\\begin{align*}F(Q_3)&=\\frac34\\\\\\frac{Q_3^3+8}{16}&=\\frac34\\\\Q_3^3+8&=12\\\\Q_3^3&=4\\\\Q_3&=\\sqrt[3]{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
