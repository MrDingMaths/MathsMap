      {
        "id": "p36-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the CDF for $f(x)=\\dfrac{5x^4}{7775}$ for $1\\le x\\le6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\dfrac{x^5-1}{7775}$ for $1\\le x\\le6$.",
          "worked": "$$\\begin{aligned}F(x)&=\\int_1^x\\frac{5t^4}{7775}\\,dt\\\\F(x)&=\\frac{1}{7775}\\left[t^5\\right]_1^x\\\\F(x)&=\\frac{x^5-1}{7775},\\qquad 1\\le x\\le6.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p36-q9-b",
        "type": "group",
        "label": "b",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p36-q9-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(X\\le3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{242}{7775}$",
              "worked": "$$\\begin{aligned}P(X\\le3)&=F(3)\\\\P(X\\le3)&=\\frac{3^5-1}{7775}\\\\P(X\\le3)&=\\frac{242}{7775}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p36-q9-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(X\\le2)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{31}{7775}$",
              "worked": "$$\\begin{aligned}P(X\\le2)&=F(2)\\\\P(X\\le2)&=\\frac{2^5-1}{7775}\\\\P(X\\le2)&=\\frac{31}{7775}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p36-q9-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(X<5)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{3124}{7775}$",
              "worked": "Since $X$ is continuous, $P(X=5)=0$.\n$$\\begin{aligned}P(X<5)&=F(5)\\\\P(X<5)&=\\frac{5^5-1}{7775}\\\\P(X<5)&=\\frac{3124}{7775}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p36-q9-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(X>4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{6752}{7775}$",
              "worked": "$$\\begin{aligned}P(X>4)&=1-F(4)\\\\P(X>4)&=1-\\frac{1023}{7775}\\\\P(X>4)&=\\frac{6752}{7775}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p36-q9-b-v",
            "type": "part",
            "label": "v",
            "prompt": "$P(2\\le X\\le4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{992}{7775}$",
              "worked": "$$\\begin{aligned}P(2\\le X\\le4)&=F(4)-F(2)\\\\P(2\\le X\\le4)&=\\frac{1023}{7775}-\\frac{31}{7775}\\\\P(2\\le X\\le4)&=\\frac{992}{7775}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      }
    ]
