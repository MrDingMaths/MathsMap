  "content": {
    "id": "v2-7-practice-section-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Find the magnitude of $\\underset{\\sim}{u}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-7-practice-section-slot-3-slot-3-a",
        "type": "part",
        "label": "a",
        "prompt": "The angle between vectors $\\underset{\\sim}{u}$ and $\\underset{\\sim}{v}$ is $60^\\circ$ and their dot product is $39$.\n\nIf $\\underset{\\sim}{v}=5\\mathbf{i}+12\\mathbf{j}$, find the magnitude of $\\underset{\\sim}{u}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\underset{\\sim}{u}|=6$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{v}|&=\\sqrt{5^2+12^2}=13\\\\|\\underset{\\sim}{u}||\\underset{\\sim}{v}|\\cos60^\\circ&=39\\\\|\\underset{\\sim}{u}|\\times13\\times\\frac12&=39\\\\|\\underset{\\sim}{u}|&=6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-7-practice-section-slot-3-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "The angle between vectors $\\underset{\\sim}{u}$ and $\\underset{\\sim}{v}$ is $120^\\circ$ and their dot product is $-15$.\n\nIf $\\underset{\\sim}{v}=-6\\mathbf{i}+8\\mathbf{j}$, find the magnitude of $\\underset{\\sim}{u}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\underset{\\sim}{u}|=3$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{v}|&=\\sqrt{(-6)^2+8^2}=10\\\\|\\underset{\\sim}{u}||\\underset{\\sim}{v}|\\cos120^\\circ&=-15\\\\|\\underset{\\sim}{u}|\\times10\\times\\left(-\\frac12\\right)&=-15\\\\|\\underset{\\sim}{u}|&=3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
