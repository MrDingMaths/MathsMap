    "children": [
      {
        "id": "p37-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^2-2ax+x^2-4b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-x+2b)(a-x-2b)$\n\nRecognise a perfect square, then use the difference of two squares.",
          "worked": "$$\\begin{align*}a^2-2ax+x^2-4b^2&=(a-x)^2-(2b)^2\\\\a^2-2ax+x^2-4b^2&=(a-x+2b)(a-x-2b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$9a^2-c^2+2cx-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3a-x+c)(3a+x-c)$\n\nGroup the last three terms as the negative of a perfect square.",
          "worked": "$$\\begin{align*}9a^2-c^2+2cx-x^2&=(3a)^2-(c^2-2cx+x^2)\\\\9a^2-c^2+2cx-x^2&=(3a)^2-(c-x)^2\\\\9a^2-c^2+2cx-x^2&=(3a-x+c)(3a+x-c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p37-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$2bd-a^2-c^2+b^2+d^2+2ac$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(b+d+a-c)(b+d-a+c)$\n\nRegroup into two perfect squares and factorise their difference.",
          "worked": "$$\\begin{align*}2bd-a^2-c^2+b^2+d^2+2ac&=(b^2+2bd+d^2)-(a^2-2ac+c^2)\\\\2bd-a^2-c^2+b^2+d^2+2ac&=(b+d)^2-(a-c)^2\\\\2bd-a^2-c^2+b^2+d^2+2ac&=(b+d+a-c)(b+d-a+c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p37-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y^2+2by+b^2-a^2-6ax-9x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y+b+a+3x)(y+b-a-3x)$\n\nRegroup into two perfect squares and factorise their difference.",
          "worked": "$$\\begin{align*}y^2+2by+b^2-a^2-6ax-9x^2&=(y^2+2by+b^2)-(a^2+6ax+9x^2)\\\\y^2+2by+b^2-a^2-6ax-9x^2&=(y+b)^2-(a+3x)^2\\\\y^2+2by+b^2-a^2-6ax-9x^2&=(y+b+a+3x)(y+b-a-3x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
