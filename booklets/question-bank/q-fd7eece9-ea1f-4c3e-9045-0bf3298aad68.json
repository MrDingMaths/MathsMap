  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A die is rolled twice. Find the probability of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A six then a five",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{36}$",
          "worked": "$$\\begin{align*}P(6\\text{ then }5)&=\\frac{1}{6}\\times\\frac{1}{6}\\\\&=\\frac{1}{36}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "A one then an odd number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{12}$",
          "worked": "$$\\begin{align*}P(1\\text{ then odd})&=\\frac{1}{6}\\times\\frac{3}{6}\\\\&=\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "A double six",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{36}$",
          "worked": "$$\\begin{align*}P(6\\text{ then }6)&=\\frac{1}{6}\\times\\frac{1}{6}\\\\&=\\frac{1}{36}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Two numbers greater than four",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "$$\\begin{align*}P(>4\\text{ then }>4)&=\\frac{2}{6}\\times\\frac{2}{6}\\\\&=\\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "A number greater than four and then a number less than four.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "$$\\begin{align*}P(>4\\text{ then }<4)&=\\frac{2}{6}\\times\\frac{3}{6}\\\\&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
