  "content": {
    "id": "v2-ab1d0-p48-practice-slot-1-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Four different Maths books, three different Science books and two different Art books are placed on a shelf. In how many ways can this be done if the books of each subject must be together?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1728$",
      "worked": "Treat each subject as one unit, giving 3 units in a line: $3!$ ways. Within the units, arrange the Maths books in $4!$ ways, the Science books in $3!$ ways and the Art books in $2!$ ways.\n$$\\begin{align*}N&=3!\\times4!\\times3!\\times2!\\\\&=6\\times24\\times6\\times2\\\\&=1728\\end{align*}$$",
      "solutionDiagrams": []
    },
