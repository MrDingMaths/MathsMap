  "content": {
    "id": "p61-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Emma completed a worksheet in 2:18 (minutes:seconds).\nA week later, she completed the same worksheet in 1:45.\nWork out the percentage change, to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$23.9\\%$ decrease",
      "worked": "$$\\begin{align*}\\text{Original time}&=(2\\times60+18)\\text{ s}\\\\\\text{Original time}&=138\\text{ s}\\\\\\text{Final time}&=(1\\times60+45)\\text{ s}\\\\\\text{Final time}&=105\\text{ s}\\\\\\text{Percentage change}&=\\frac{105-138}{138}\\times100\\%\\\\\\text{Percentage change}&\\approx-23.9\\%\\end{align*}$$\nThe time decreased by $23.9\\%$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
