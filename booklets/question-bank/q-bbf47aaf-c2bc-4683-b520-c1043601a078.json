        "prompt": "dilated horizontally by a factor of 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{x}{x+4}$",
          "worked": "Replace $x$ by $\\frac{x}{2}$.\n$$\\begin{align*}y&=\\frac{x/2}{x/2+2}\\\\y&=\\frac{x}{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "dilated vertically by a factor of 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2x}{x+2}$",
          "worked": "Replace $y$ by $\\frac{y}{2}$.\n$$\\begin{align*}\\frac{y}{2}&=\\frac{x}{x+2}\\\\y&=\\frac{2x}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "dilated horizontally by a factor of 0.5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{x}{x+1}$",
          "worked": "Replace $x$ by $\\frac{x}{0.5}=2x$.\n$$\\begin{align*}y&=\\frac{2x}{2x+2}\\\\y&=\\frac{x}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "dilated vertically by a factor of 0.5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{x}{2x+4}$",
          "worked": "Replace $y$ by $\\frac{y}{0.5}$.\n$$\\begin{align*}\\frac{y}{0.5}&=\\frac{x}{x+2}\\\\y&=\\frac{0.5x}{x+2}\\\\y&=\\frac{x}{2x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
