    "id": "p22-q69-response",
    "type": "question",
    "label": "21",
    "prompt": "Let $x=\\dfrac1{1+\\sqrt2}$. Simplify $\\dfrac{1-x^2}{1+x^2}$.",
    "layout": "list",
    "columns": null,
