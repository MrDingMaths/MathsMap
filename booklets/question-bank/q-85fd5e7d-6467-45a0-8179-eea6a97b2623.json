  "content": {
    "id": "p37-scale-perimeter-bridge-root",
    "type": "question",
    "label": "16",
    "prompt": "A rectangular park measures 6 cm by 4 cm on a plan with scale $1:2000$. What is the real-life distance walked in one complete circuit of its boundary? Give your answer in kilometres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.4\\text{ km}$",
      "worked": "$$\\begin{aligned}\\text{Plan perimeter}&=2(6+4)=20\\text{ cm}\\\\\\text{Actual perimeter}&=20\\times2000=40\\,000\\text{ cm}\\\\&=0.4\\text{ km}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
