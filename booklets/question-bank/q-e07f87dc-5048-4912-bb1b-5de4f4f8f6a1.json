        "answer": {
          "short": "$\\frac{9}{20}$",
          "worked": "$$\\begin{align*}\\frac{3}{8}\\times\\frac{4}{5}\\div\\frac{2}{3}&=\\frac{3}{8}\\times\\frac{4}{5}\\times\\frac{3}{2}\\\\&=\\frac{36}{80}\\\\&=\\frac{9}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
