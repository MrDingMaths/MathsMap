        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3}{8}\\div\\frac{4}{5}\\times\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{16}$",
          "worked": "$$\\begin{align*}\\frac{3}{8}\\div\\frac{4}{5}\\times\\frac{2}{3}&=\\frac{3}{8}\\times\\frac{5}{4}\\times\\frac{2}{3}\\\\&=\\frac{30}{96}\\\\&=\\frac{5}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p73-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{8}\\div\\frac{4}{5}\\div\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{45}{64}$",
