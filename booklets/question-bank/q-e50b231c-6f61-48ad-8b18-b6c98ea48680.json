  "content": {
    "id": "p35-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The graph of $y=-x^2+2x+10$ models the height $y$ of a diver, in metres, at time $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Where is the diver initially? Interpret this in the context.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "On a platform $10\\,\\mathrm{m}$ above the water.",
          "worked": "At $x=0$, the height is $-(0)^2+2(0)+10=10\\,\\mathrm{m}$. The diver starts on a platform $10\\,\\mathrm{m}$ above the water.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p35-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\frac{dy}{dx}=-2x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{dy}{dx}=-2x+2$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=-2x+2+0\\\\\\frac{dy}{dx}&=-2x+2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p35-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the height at which the diver's instantaneous speed is zero and interpret it physically.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11\\,\\mathrm{m}$, the diver's maximum height.",
          "worked": "The speed is zero when the vertical velocity is zero.\n\n$$\\begin{align*}-2x+2&=0\\\\x&=1\\\\y&=-(1)^2+2(1)+10=11\\,\\mathrm{m}.\\end{align*}$$\n\nThe velocity changes from positive to negative at $x=1$, so the diver reaches a maximum height of $11\\,\\mathrm{m}$ there.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
