  "content": {
    "id": "p23-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "$y$ is inversely proportional to $x$ and $y = 42$ when $x = 6$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation $y = \\frac{k}{x}$ and calculate the constant of variation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = 252$, $y = \\frac{252}{x}$.",
          "worked": "$$\\begin{align*}y &= \\frac{k}{x}\\\\42 &= \\frac{k}{6}\\\\252 &= k\\\\y &= \\frac{252}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "What is $y$ when $x = 3$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 84$.",
          "worked": "$$\\begin{align*}y &= \\frac{252}{3}\\\\y &= 84\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "What is $x$ when $y = 21$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 12$.",
          "worked": "$$\\begin{align*}21 &= \\frac{252}{x}\\\\21x &= 252\\\\x &= \\frac{252}{21}\\\\x &= 12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
