        "id": "p30-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the second derivative $\\dfrac{d^2y}{dx^2}$ of $y=x^3-x^2-5x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d^2y}{dx^2}=6x-2$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2-2x-5\\\\\\frac{d^2y}{dx^2}&=6x-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p30-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence find the values of $x$ for which the curve is:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q5-b-i",
            "type": "part",
            "label": "i",
            "prompt": "concave up,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x>\\dfrac{1}{3}$.",
              "worked": "For concave up, $\\dfrac{d^2y}{dx^2}>0$.\n$$\\begin{align*}6x-2&>0\\\\6x&>2\\\\x&>\\frac{1}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
