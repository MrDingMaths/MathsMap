  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The formula to convert Celsius to Fahrenheit is $F=\\frac{9}{5}C+32$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange this formula to make $C$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=\\frac{5F-160}{9}$",
          "worked": "$$\\begin{align*}F-32&=\\frac{9}{5}C\\\\\\frac{5(F-32)}{9}&=C\\\\C&=\\frac{5F-160}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "Use your rearranged formula to convert these degrees Fahrenheit to Celsius. Give your answers to 2 decimal places.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q5-b-350",
            "type": "part",
            "label": "i",
            "prompt": "$350^\\circ\\mathrm{F}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$176.67^\\circ\\mathrm{C}$",
              "worked": "$$\\begin{align*}C&=\\frac{5(350)-160}{9}\\\\C&=\\frac{1590}{9}\\\\C&\\approx176.67^\\circ\\mathrm{C}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p7-q5-b-400",
            "type": "part",
            "label": "ii",
            "prompt": "$400^\\circ\\mathrm{F}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$204.44^\\circ\\mathrm{C}$",
              "worked": "$$\\begin{align*}C&=\\frac{5(400)-160}{9}\\\\C&=\\frac{1840}{9}\\\\C&\\approx204.44^\\circ\\mathrm{C}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p7-q5-b-100",
            "type": "part",
            "label": "iii",
            "prompt": "$100^\\circ\\mathrm{F}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$37.78^\\circ\\mathrm{C}$",
              "worked": "$$\\begin{align*}C&=\\frac{5(100)-160}{9}\\\\C&=\\frac{340}{9}\\\\C&\\approx37.78^\\circ\\mathrm{C}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          }
        ]
      }
    ]
  },
