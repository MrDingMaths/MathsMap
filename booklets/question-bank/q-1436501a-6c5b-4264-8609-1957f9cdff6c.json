            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\frac{18}{7}\\text{ hours}",
                "display": false
              }
            ]
          },
          {
            "id": "p18-q11-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
