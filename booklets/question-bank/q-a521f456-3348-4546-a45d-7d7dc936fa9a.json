  "content": {
    "id": "p22-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Let $f:\\mathbb{R}\\to\\mathbb{R}$ and $g:\\mathbb{R}\\to\\mathbb{R}$ be given by $f(x)=2x+1$ and $g(x)=x^2-2x+1$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(f+g)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2$",
          "worked": "$$\\begin{align*}(f+g)(x)&=f(x)+g(x)\\\\(f+g)(x)&=(2x+1)+(x^2-2x+1)\\\\(f+g)(x)&=x^2+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(f-g)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x^2+4x$",
          "worked": "$$\\begin{align*}(f-g)(x)&=f(x)-g(x)\\\\(f-g)(x)&=(2x+1)-(x^2-2x+1)\\\\(f-g)(x)&=-x^2+4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(f\\cdot g)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^3-3x^2+1$",
          "worked": "$$\\begin{align*}(f\\cdot g)(x)&=f(x)g(x)\\\\(f\\cdot g)(x)&=(2x+1)(x^2-2x+1)\\\\(f\\cdot g)(x)&=2x^3-4x^2+2x+x^2-2x+1\\\\(f\\cdot g)(x)&=2x^3-3x^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\dfrac{f}{g}\\right)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+1}{x^2-2x+1}$, $x\\ne1$.",
          "worked": "$$\\begin{align*}\\left(\\frac{f}{g}\\right)(x)&=\\frac{f(x)}{g(x)}\\\\\\left(\\frac{f}{g}\\right)(x)&=\\frac{2x+1}{x^2-2x+1}\\\\\\left(\\frac{f}{g}\\right)(x)&=\\frac{2x+1}{(x-1)^2}\\end{align*}$$\nThe denominator must be nonzero, so $x\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
