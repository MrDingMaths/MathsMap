  "content": {
    "id": "v2-f2031-p10-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "A cube of ice is melting so that its side length is decreasing at a rate of $0.3\\text{ cm/min}$. At what rate is the volume of the cube decreasing when the side length is $5\\text{ cm}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Decreasing at $22.5\\text{ cm}^3/\\text{min}$.",
      "worked": "$$V=x^3,\\qquad \\frac{dx}{dt}=-0.3\\text{ cm/min}.$$\n$$\\begin{align*}\\frac{dV}{dt}&=\\frac{dV}{dx}\\times\\frac{dx}{dt}\\\\\\frac{dV}{dt}&=3x^2(-0.3)\\\\\\frac{dV}{dt}&=-0.9x^2.\\end{align*}$$\nWhen $x=5$,\n$$\\begin{align*}\\frac{dV}{dt}&=-0.9(5)^2\\\\\\frac{dV}{dt}&=-22.5\\text{ cm}^3/\\text{min}.\\end{align*}$$\nThe volume is decreasing at $22.5\\text{ cm}^3/\\text{min}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
