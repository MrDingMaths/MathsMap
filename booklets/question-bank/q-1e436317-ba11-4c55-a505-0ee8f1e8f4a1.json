    "type": "question",
    "label": "5",
    "prompt": "The sum of $1\\frac{1}{5}$ and a larger number is $5\\frac{7}{10}$. Find the larger number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\frac{1}{2}$",
      "worked": "The larger number is the sum minus the known number.\n$$\\begin{align*}5\\frac{7}{10}-1\\frac{1}{5}&=5\\frac{7}{10}-1\\frac{2}{10}\\\\5\\frac{7}{10}-1\\frac{1}{5}&=4\\frac{5}{10}\\\\5\\frac{7}{10}-1\\frac{1}{5}&=4\\frac{1}{2}\\end{align*}$$",
      "solutionDiagrams": []
