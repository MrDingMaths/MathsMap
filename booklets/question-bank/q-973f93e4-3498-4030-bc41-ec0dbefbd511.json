  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "At a factory, it takes 408 seconds to make 100 chocolates.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "How long, in minutes, does it take to make 10 000 chocolates?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$680\\text{ min}$",
          "worked": "10 000 chocolates is 100 times as many as 100 chocolates.\n\n$$\\begin{align*}\\text{Time in seconds}&=408\\times100\\\\\\text{Time in seconds}&=40\\,800\\\\\\text{Time in minutes}&=40\\,800\\div60\\\\\\text{Time in minutes}&=680\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "How long, in seconds, does it take to make 10 chocolates?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40.8\\text{ s}$",
          "worked": "10 chocolates is one tenth of 100 chocolates, so the time is divided by 10.\n\n$$\\text{Time}=408\\div10=40.8\\text{ s}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "How many chocolates can be made in 4080 seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1000 chocolates",
          "worked": "$$\\begin{align*}\\text{Number of 408-second periods}&=4080\\div408\\\\\\text{Number of 408-second periods}&=10\\\\\\text{Number of chocolates}&=100\\times10\\\\\\text{Number of chocolates}&=1000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
