  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the number of elements in each of the following sets:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\{1,2,3\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "The three elements are $1$, $2$ and $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\{1,\\{2,3\\}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "The two elements are $1$ and the set $\\{2,3\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\{\\{1,2,3\\}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "The only element is the set $\\{1,2,3\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\{1,\\{1,2,3\\}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "The two elements are $1$ and the set $\\{1,2,3\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\{1,\\{2,3\\},\\{4,5\\}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "The three elements are $1$, $\\{2,3\\}$ and $\\{4,5\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\{\\varnothing,1,2\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "The three elements are $\\varnothing$, $1$ and $2$. The empty set counts as one element here.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\{\\varnothing,\\{\\varnothing\\}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "The two distinct elements are $\\varnothing$ and $\\{\\varnothing\\}$. The latter contains one element.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\{n\\in\\mathbb N:n^2<0\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No natural number has a negative square, so the set is empty.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\{x\\in\\mathbb R:x^2=2\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$x^2=2$ has the two real solutions $-\\sqrt2$ and $\\sqrt2$, so there are two elements.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p7-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\{x\\in\\mathbb Z:x^2=2\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "Neither $-\\sqrt2$ nor $\\sqrt2$ is an integer, so the set is empty.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      }
    ]
  },
