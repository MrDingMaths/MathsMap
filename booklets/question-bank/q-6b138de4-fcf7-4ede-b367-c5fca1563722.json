  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Evaluate these expressions for $m=5$ and $n=\\frac{1}{2}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$m+n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\frac{1}{2}$",
          "worked": "$$\\begin{align*}m+n&=5+\\frac{1}{2}\\\\m+n&=5\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$2m+n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\frac{1}{2}$",
          "worked": "$$\\begin{align*}2m+n&=2\\times5+\\frac{1}{2}\\\\2m+n&=10+\\frac{1}{2}\\\\2m+n&=10\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$2m-3n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\frac{1}{2}$",
          "worked": "$$\\begin{align*}2m-3n&=2\\times5-3\\times\\frac{1}{2}\\\\2m-3n&=10-\\frac{3}{2}\\\\2m-3n&=\\frac{20}{2}-\\frac{3}{2}\\\\2m-3n&=8\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{m}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\frac{m}{4}&=\\frac{5}{4}\\\\\\frac{m}{4}&=1\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$n\\div5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "$$\\begin{align*}n\\div5&=\\frac{1}{2}\\div5\\\\n\\div5&=\\frac{1}{2\\times5}\\\\n\\div5&=\\frac{1}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p7-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$mn$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\frac{1}{2}$",
          "worked": "$$\\begin{align*}mn&=5\\times\\frac{1}{2}\\\\mn&=\\frac{5}{2}\\\\mn&=2\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p7-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$n\\div m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "$$\\begin{align*}n\\div m&=\\frac{1}{2}\\div5\\\\n\\div m&=\\frac{1}{2\\times5}\\\\n\\div m&=\\frac{1}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p7-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{m+n}{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{m+n}{11}&=\\frac{5+\\frac{1}{2}}{11}\\\\\\frac{m+n}{11}&=\\frac{\\frac{11}{2}}{11}\\\\\\frac{m+n}{11}&=\\frac{11}{2\\times11}\\\\\\frac{m+n}{11}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
