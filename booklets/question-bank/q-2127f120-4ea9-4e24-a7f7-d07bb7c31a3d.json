  "content": {
    "id": "p35-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Suppose that $P=4(a+b)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $P$ when $a=6$ and $b=7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=52$",
          "worked": "$$\\begin{align*}P&=4(6+7)\\\\P&=4\\times13\\\\P&=52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Make $a$ the subject of the formula.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{P}{4}-b$",
          "worked": "$$\\begin{align*}P&=4(a+b)\\\\\\frac{P}{4}&=a+b\\\\a&=\\frac{P}{4}-b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p35-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $a$ when $P=20$ and $b=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-1$",
          "worked": "Using the rearranged formula from part b:\n$$\\begin{align*}a&=\\frac{P}{4}-b\\\\a&=\\frac{20}{4}-6\\\\a&=5-6\\\\a&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
