    "type": "question",
    "label": "11",
    "prompt": "Show that $x=-3+2\\sqrt{2}$ satisfies the equation $x^2+6x+1=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\mathrm{LHS}=0=\\mathrm{RHS}$ after substituting $x=-3+2\\sqrt{2}$.",
      "worked": "$$\\begin{aligned}\\mathrm{LHS}&=(-3+2\\sqrt{2})^2+6(-3+2\\sqrt{2})+1\\\\&=9-12\\sqrt{2}+8-18+12\\sqrt{2}+1\\\\&=0=\\mathrm{RHS}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
