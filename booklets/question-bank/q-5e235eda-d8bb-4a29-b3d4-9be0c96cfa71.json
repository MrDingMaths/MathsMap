    "children": [
      {
        "id": "p76-g15-20-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p76-q15-expression",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "|x-5|\\le 2",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\le x\\le 7$",
          "worked": "$$\\begin{align*}-2&\\le x-5\\le 2\\\\3&\\le x\\le 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p76-g15-20-b",
        "type": "part",
        "label": "b",
        "prompt": "$|2x+1|\\ge 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le -3$ or $x\\ge 2$",
          "worked": "$$\\begin{align*}2x+1&\\le -5\\quad\\text{or}\\quad 2x+1\\ge 5\\\\2x&\\le -6\\quad\\text{or}\\quad 2x\\ge 4\\\\x&\\le -3\\quad\\text{or}\\quad x\\ge 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p76-g15-20-c",
        "type": "part",
        "label": "c",
        "prompt": "$|4x+1|<5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac32<x<1$",
          "worked": "$$\\begin{align*}-5&<4x+1<5\\\\-6&<4x<4\\\\-\\frac32&<x<1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p76-g15-20-d",
        "type": "part",
        "label": "d",
        "prompt": "$|3x-2|>2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<0$ or $x>\\frac43$",
          "worked": "$$\\begin{align*}3x-2&<-2\\quad\\text{or}\\quad 3x-2>2\\\\3x&<0\\quad\\text{or}\\quad 3x>4\\\\x&<0\\quad\\text{or}\\quad x>\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p76-g15-20-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left|\\frac{x}{2}-3\\right|\\le 1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\le x\\le 8$",
          "worked": "$$\\begin{align*}-1&\\le \\frac{x}{2}-3\\le 1\\\\2&\\le \\frac{x}{2}\\le 4\\\\4&\\le x\\le 8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p76-g15-20-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left|\\frac{3x}{2}+1\\right|>4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-\\frac{10}{3}$ or $x>2$",
          "worked": "$$\\begin{align*}\\frac{3x}{2}+1&<-4\\quad\\text{or}\\quad \\frac{3x}{2}+1>4\\\\\\frac{3x}{2}&<-5\\quad\\text{or}\\quad \\frac{3x}{2}>3\\\\x&<-\\frac{10}{3}\\quad\\text{or}\\quad x>2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
