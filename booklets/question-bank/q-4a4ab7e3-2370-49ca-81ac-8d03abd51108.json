        "label": "a",
        "prompt": "$\\cos135^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{\\sqrt{2}}$; $\\cos135^{\\circ}=-\\cos45^{\\circ}$.",
          "worked": "$$\\begin{align*}\\cos135^{\\circ}&=-\\cos45^{\\circ}\\\\\\cos135^{\\circ}&=-\\frac{1}{\\sqrt{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-65792-p37-practice-slot-4-slot4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin330^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{2}$; $\\sin330^{\\circ}=-\\sin30^{\\circ}$.",
          "worked": "$$\\begin{align*}\\sin330^{\\circ}&=-\\sin30^{\\circ}\\\\\\sin330^{\\circ}&=-\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
