          "worked": "$$\\begin{align*}\\tan(-30^{\\circ})&=\\tan330^{\\circ}\\\\\\tan(-30^{\\circ})&=-\\tan30^{\\circ}\\\\\\tan(-30^{\\circ})&=-\\frac{1}{\\sqrt{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
