          "worked": "$$\\begin{align*}\\tan120^{\\circ}&=-\\tan60^{\\circ}\\\\\\tan120^{\\circ}&=-\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-65792-p37-practice-slot-4-slot4-d",
