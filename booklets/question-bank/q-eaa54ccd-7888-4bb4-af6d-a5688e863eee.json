  "content": {
    "id": "v2-cfcbb-p58-practice-j3-054628-root",
    "type": "question",
    "label": null,
    "prompt": "A water tank is $\\frac{3}{4}$ full. Then $\\frac{1}{3}$ of the water in the tank is used.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-cfcbb-p58-practice-j3-054628-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the water in the tank is left?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{align*}\\text{Fraction left}&=1-\\frac{1}{3}\\\\&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-cfcbb-p58-practice-j3-054628-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the whole tank is now filled with water?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\text{Fraction of tank}&=\\frac{2}{3}\\times\\frac{3}{4}\\\\&=\\frac{1}{1}\\times\\frac{1}{2}\\\\&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ],
    "responseKind": "group-answer",
    "answer": {
      "short": "a) $\\frac{2}{3}$ b) $\\frac{1}{2}$",
