      },
      {
        "id": "p26-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coordinates of points $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A(0,10)$, $B(2,0)$.",
          "worked": "The intercepts are $A(0,c)$ and $B(\\frac{c}{5},0)$. With $c=10$, these are $A(0,10)$ and $B(2,0)$.",
