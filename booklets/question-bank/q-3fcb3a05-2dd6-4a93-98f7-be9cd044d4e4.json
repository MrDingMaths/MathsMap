    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4$",
      "worked": "The vertex lies halfway between the two $x$-intercepts.\n\n$$\\begin{align*}x&=\\frac{1+7}{2}\\\\x&=4\\end{align*}$$",
