  "content": {
    "id": "p35-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Fifteen distinct people are to be seated at two round tables: one with eight seats and one with seven. How many distinct seating arrangements are possible?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\binom{15}{8}\\times7!\\times6!=23\\,351\\,328\\,000$ arrangements.",
      "worked": "Choose eight people for the eight-seat table; the remaining seven sit at the other table. Arrange the groups circularly in $7!$ and $6!$ ways. The different table sizes distinguish the groups.\n\n$$\\begin{align*}N&=\\binom{15}{8}\\times7!\\times6!\\\\N&=23\\,351\\,328\\,000.\\end{align*}$$\n\nThere are $23\\,351\\,328\\,000$ arrangements.",
      "solutionDiagrams": []
    },
