    "children": [
      {
        "id": "p25-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "If the entire frame has height $h$ metres and width $w$ metres, show that $w=\\dfrac{12-3h}{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=\\dfrac{12-3h}{4}$.",
          "worked": "There are three vertical members of length $h$ and four horizontal members of length $w$.\n$$\\begin{align*}3h+4w&=12\\\\4w&=12-3h\\\\w&=\\frac{12-3h}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the area of the window is $A=3h-\\dfrac34h^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=3h-\\dfrac34h^2$.",
          "worked": "$$\\begin{align*}A&=hw\\\\A&=\\frac{h(12-3h)}{4}\\\\A&=3h-\\frac{3h^2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p25-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\dfrac{dA}{dh}$ and hence find the dimensions of the frame for which the area of the window is maximised.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dA}{dh}=3-\\dfrac{3h}{2}$; height $2$ m and width $1.5$ m.",
