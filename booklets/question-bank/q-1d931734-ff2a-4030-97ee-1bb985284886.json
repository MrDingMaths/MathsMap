      {
        "id": "v2-nr-p48-s1-slot-28-upper-slot-28-upper-d1",
        "role": "question",
        "format": "tikz",
        "code": "\\usetikzlibrary{calc}\n\\begin{tikzpicture}[every node/.style={font=\\large}]\n\\coordinate (O) at (0,0);\n\\foreach \\i in {0,...,9}{\\coordinate (P\\i) at ({90+36*\\i}:2);}\n\\draw[line width=0.8pt] (P0)--(P1)--(P2)--(P3)--(P4)--(P5)--(P6)--(P7)--(P8)--(P9)--cycle;\n\\draw[line width=0.8pt] (O)--(P0);\n\\draw[line width=0.8pt] (O)--(P1);\n\\path (P1)--(P0) node[midway,above,sloped] {$4\\text{ cm}$};\n\\node[above right] at (P0) {$A$};\n\\node[above left] at (P1) {$B$};\n\\node[below right] at (O) {$O$};\n\\end{tikzpicture}",
