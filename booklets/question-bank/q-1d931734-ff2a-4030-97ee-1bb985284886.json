    "children": [],
    "answer": {
      "short": "$123.1\\text{ cm}^2$",
      "worked": "$$\\begin{align*}\\angle AOB&=\\frac{360^\\circ}{10}=36^\\circ\\\\4^2&=r^2+r^2-2r^2\\cos36^\\circ\\\\r^2&=\\frac{16}{2-2\\cos36^\\circ}\\\\\\operatorname{Area}(\\triangle OAB)&=\\frac12r^2\\sin36^\\circ=\\frac{8\\sin36^\\circ}{2-2\\cos36^\\circ}\\\\\\operatorname{Area}(\\text{decagon})&=10\\times\\frac{8\\sin36^\\circ}{2-2\\cos36^\\circ}\\\\&\\approx123.1\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
