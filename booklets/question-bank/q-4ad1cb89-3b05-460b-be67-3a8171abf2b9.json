  "content": {
    "id": "p23-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve for $x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^x=\\sqrt{81}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}3^x&=(3^4)^{\\frac12}\\\\3^x&=3^2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$6^x=\\sqrt[3]{36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac23$",
          "worked": "$$\\begin{align*}6^x&=(6^2)^{\\frac13}\\\\6^x&=6^{\\frac23}\\\\x&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p23-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^x=\\sqrt[4]{64}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac34$",
          "worked": "$$\\begin{align*}4^x&=(4^3)^{\\frac14}\\\\4^x&=4^{\\frac34}\\\\x&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p23-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$3^x=\\sqrt[9]{27}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac13$",
          "worked": "$$\\begin{align*}3^x&=(3^3)^{\\frac19}\\\\3^x&=3^{\\frac13}\\\\x&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p23-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$25^x=\\sqrt[5]{125}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac3{10}$",
          "worked": "$$\\begin{align*}(5^2)^x&=(5^3)^{\\frac15}\\\\5^{2x}&=5^{\\frac35}\\\\2x&=\\frac35\\\\x&=\\frac3{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p23-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$9^x=\\frac{1}{\\sqrt[3]{27}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac12$",
          "worked": "$$\\begin{align*}(3^2)^x&=\\frac{1}{(3^3)^{\\frac13}}\\\\3^{2x}&=3^{-1}\\\\2x&=-1\\\\x&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
