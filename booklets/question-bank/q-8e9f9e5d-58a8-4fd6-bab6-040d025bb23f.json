  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Given $\\overrightarrow{OA}=\\begin{pmatrix}6\\\\2\\end{pmatrix}$ and $\\overrightarrow{OB}=\\begin{pmatrix}1\\\\5\\end{pmatrix}$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a-node",
        "type": "group",
        "label": "a",
        "prompt": "Find the angle in degrees and minutes, to the nearest minute, between:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q5-a-i-node",
            "type": "part",
            "label": "i",
            "prompt": "$\\overrightarrow{OA}$ and $\\overrightarrow{OB}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$60^\\circ15'$",
              "worked": "$$\\begin{aligned}\\overrightarrow{OA}\\cdot\\overrightarrow{OB}&=6(1)+2(5)\\\\&=16\\\\|\\overrightarrow{OA}|&=\\sqrt{40}\\\\|\\overrightarrow{OB}|&=\\sqrt{26}\\\\\\cos\\theta&=\\frac{16}{\\sqrt{40}\\sqrt{26}}\\\\&=\\frac{16}{\\sqrt{1040}}\\\\\\theta&\\approx60^\\circ15'\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p17-q5-a-ii-node",
            "type": "part",
            "label": "ii",
            "prompt": "$\\overrightarrow{OA}$ and $\\overrightarrow{OA}-\\overrightarrow{OB}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$49^\\circ24'$",
              "worked": "$$\\begin{aligned}\\overrightarrow{OA}-\\overrightarrow{OB}&=(5,-3)\\end{aligned}$$\n\n$$\\begin{aligned}\\overrightarrow{OA}\\cdot(\\overrightarrow{OA}-\\overrightarrow{OB})&=6(5)+2(-3)\\\\&=24\\end{aligned}$$\n\n$$\\begin{aligned}|\\overrightarrow{OA}|&=\\sqrt{40}\\\\|\\overrightarrow{OA}-\\overrightarrow{OB}|&=\\sqrt{34}\\\\\\cos\\theta&=\\frac{24}{\\sqrt{40}\\sqrt{34}}\\\\\\theta&\\approx49^\\circ24'\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          },
          {
            "id": "p17-q5-a-iii-node",
            "type": "part",
            "label": "iii",
            "prompt": "$\\overrightarrow{OB}$ and $\\overrightarrow{OA}-\\overrightarrow{OB}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$109^\\circ39'$",
              "worked": "$$\\begin{aligned}\\overrightarrow{OB}\\cdot(\\overrightarrow{OA}-\\overrightarrow{OB})&=1(5)+5(-3)\\\\&=-10\\end{aligned}$$\n\n$$\\begin{aligned}|\\overrightarrow{OB}|&=\\sqrt{26}\\\\|\\overrightarrow{OA}-\\overrightarrow{OB}|&=\\sqrt{34}\\\\\\cos\\theta&=\\frac{-10}{\\sqrt{26}\\sqrt{34}}\\\\\\theta&\\approx109^\\circ39'\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      },
      {
        "id": "p17-q5-b-node",
        "type": "part",
        "label": "b",
        "prompt": "What geometrical relationship does this illustrate?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An exterior angle of a triangle equals the sum of its interior opposite angles: $109^\\circ39'=60^\\circ15'+49^\\circ24'$.",
          "worked": "A sketch is useful here. In triangle $OAB$, $\\overrightarrow{OA}-\\overrightarrow{OB}=\\overrightarrow{BA}$. The angle in (iii) is an exterior angle at $B$; the angles in (i) and (ii) are the interior opposite angles at $O$ and $A$. Thus an exterior angle of a triangle equals the sum of its interior opposite angles:\n\n$$109^\\circ39'=60^\\circ15'+49^\\circ24'.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
