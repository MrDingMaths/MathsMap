  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A room in a house with dimensions $4$ m by $5$ m is to be extended. Both the length and width are to be increased by $x$ m.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expanded expression for the area of the new room.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+9x+20)\\text{ m}^2$",
          "worked": "$\\begin{aligned}A&=(x+4)(x+5)\\\\&=x^2+5x+4x+20\\\\&=x^2+9x+20\\end{aligned}$\nThe area is $(x^2+9x+20)\\text{ m}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "If $x=3$,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p5-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Find the area of the new room.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$56\\text{ m}^2$",
              "worked": "$\\begin{aligned}A&=3^2+9(3)+20\\\\&=56\\text{ m}^2\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p5-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "By how much has the area increased?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$36\\text{ m}^2$",
              "worked": "$\\begin{aligned}\\text{Original area}&=4\\times5\\\\&=20\\text{ m}^2\\\\\\text{Increase}&=56-20\\\\&=36\\text{ m}^2\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
  },
