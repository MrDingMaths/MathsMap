    "children": [
      {
        "id": "p37-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "How far east of its starting point is the boat, to the nearest kilometre?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$39\\text{ km}$",
          "worked": "Let $x$ be the eastward distance in kilometres. The angle between $OB$ and east is $140^\\circ-90^\\circ=50^\\circ$.\n$$\\begin{align*}\\cos50^\\circ&=\\frac{x}{60}\\\\x&=60\\cos50^\\circ\\\\x&\\approx39\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p37-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the bearing of $O$ from $B$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$320^\\circ\\text{ T}$",
          "worked": "The reverse bearing differs by $180^\\circ$.\n$$140^\\circ+180^\\circ=320^\\circ$$\nThe bearing of $O$ from $B$ is $320^\\circ\\text{ T}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
