        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 37 p37-q10-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (B) at ({1.65*sin(140)},{1.65*cos(140)});\n\\draw[<->,line width=0.5pt] (-1.2,0) node[left] {$W$} -- (1.2,0) node[right] {$E$};\n\\draw[<->,line width=0.5pt] (0,-1.2) node[below] {$S$} -- (0,1.2) node[above] {$N$};\n\\draw[line width=0.8pt] (O)--(B);\n\\draw[->,line width=0.4pt] (0,0.48) arc[start angle=90,end angle=-50,radius=0.48];\n\\fill (O) circle (1.5pt);\n\\fill (B) circle (1.5pt);\n\\node[above right] at (O) {$O$};\n\\node[below right] at (B) {$B$};\n\\end{tikzpicture}",
