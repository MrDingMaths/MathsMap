    "children": [
      {
        "id": "p17-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine which of $\\frac{2}{5}$ or $\\frac{1}{4}+\\frac{1}{6}$ is larger.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}+\\frac{1}{6}$ is larger.",
          "worked": "$$\\begin{align*}\\frac{1}{4}+\\frac{1}{6}&=\\frac{3}{12}+\\frac{2}{12}\\\\\\frac{1}{4}+\\frac{1}{6}&=\\frac{5}{12}\\\\\\frac{5}{12}&=\\frac{25}{60}\\\\\\frac{2}{5}&=\\frac{24}{60}\\end{align*}$$\nSince $25>24$, $\\frac{1}{4}+\\frac{1}{6}$ is larger.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p17-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "We generalise the above result as follows. Suppose that $n>1$. By writing the left-hand side as a single fraction, prove that\n$$\\frac{1}{n+1}+\\frac{1}{n-1}-\\frac{2}{n}>0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p17-q15-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{1}{n+1}+\\frac{1}{n-1}-\\frac{2}{n}=\\frac{2}{n(n+1)(n-1)}>0",
                    "display": false
                  }
                ]
              },
              {
                "id": "p17-q15-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use a common denominator; every denominator factor is positive when ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "n>1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{1}{n+1}+\\frac{1}{n-1}-\\frac{2}{n}&=\\frac{n(n-1)+n(n+1)-2(n+1)(n-1)}{n(n+1)(n-1)}\\\\\\frac{1}{n+1}+\\frac{1}{n-1}-\\frac{2}{n}&=\\frac{n^2-n+n^2+n-2(n^2-1)}{n(n+1)(n-1)}\\\\\\frac{1}{n+1}+\\frac{1}{n-1}-\\frac{2}{n}&=\\frac{2}{n(n+1)(n-1)}\\end{align*}$$\nSince $n>1$, the factors $n$, $n+1$ and $n-1$ are positive. Therefore $\\frac{2}{n(n+1)(n-1)}>0$, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
