      {
        "id": "p49-q5-proof",
        "type": "part",
        "label": "a",
        "prompt": "By rationalising the denominator, show that $\\dfrac{n}{\\sqrt{n}}=\\sqrt{n}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n}{\\sqrt{n}}\\times\\dfrac{\\sqrt{n}}{\\sqrt{n}}=\\dfrac{n\\sqrt{n}}{n}=\\sqrt{n}$",
          "worked": "$$\\begin{align*}\\frac{n}{\\sqrt{n}}&=\\frac{n}{\\sqrt{n}}\\times\\frac{\\sqrt{n}}{\\sqrt{n}}\\\\&=\\frac{n\\sqrt{n}}{n}\\\\&=\\sqrt{n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p49-q5-follow-on",
        "type": "group",
        "label": "",
        "prompt": "Therefore, simplify:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
