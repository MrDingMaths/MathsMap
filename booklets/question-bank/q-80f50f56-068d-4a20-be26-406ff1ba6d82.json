        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ps+qv$.\n\nMultiply successive branch probabilities and add the two paths ending in $B$.",
          "worked": "Bob has added probabilities along each path and multiplied the two cases. Multiply along each path and add the mutually exclusive cases instead.\n\n$$\\begin{align*}P(B\\text{ in the second stage})&=P(AB)+P(BB)\\\\P(B\\text{ in the second stage})&=ps+qv\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
