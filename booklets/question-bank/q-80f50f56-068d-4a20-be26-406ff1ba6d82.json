                {
                  "type": "math",
                  "latex": "p=r=u",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p$, $r$ and $u$ need not be equal. The second-stage probability of $A$ can depend on the first-stage outcome.",
          "worked": "The tree does not establish that these probabilities are equal. Here $p$ is the first-stage probability of $A$, while $r$ and $u$ are the second-stage probabilities of $A$ after different first-stage outcomes. If the stages are dependent, those second-stage probabilities can differ.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
