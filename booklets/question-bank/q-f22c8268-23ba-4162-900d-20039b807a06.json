    "label": "7",
    "prompt": "The spinner is spun. Calculate:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p12-q7-spinner",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"sectorA\",\"hex\":\"EF8B2C\",\"reason\":\"identifies the three A outcomes\"},{\"name\":\"sectorB\",\"hex\":\"268CFF\",\"reason\":\"identifies the two B outcomes; source yellow mapped to an available standard accent\"},{\"name\":\"sectorC\",\"hex\":\"4F9B63\",\"reason\":\"identifies the single C outcome\"}],\"reference\":\"source page 12, p12-q7-spinner\"}\n\\begin{tikzpicture}[x={(1.1cm,-0.4cm)},y={(0.2cm,0.9cm)},line width=0.8pt,draw=black,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{sectorA}{HTML}{EF8B2C}\n\\definecolor{sectorB}{HTML}{268CFF}\n\\definecolor{sectorC}{HTML}{4F9B63}\n\\coordinate (O) at (0,0);\n\\coordinate (V0) at (0,1);\n\\coordinate (V1) at ({sqrt(3)/2},0.5);\n\\coordinate (V2) at ({sqrt(3)/2},-0.5);\n\\coordinate (V3) at (0,-1);\n\\coordinate (V4) at ({-sqrt(3)/2},-0.5);\n\\coordinate (V5) at ({-sqrt(3)/2},0.5);\n\\path[fill=sectorC!20!white] (O)--(V0)--(V1)--cycle;\n\\path[fill=sectorA!20!white] (O)--(V1)--(V2)--cycle;\n\\path[fill=sectorB!20!white] (O)--(V2)--(V3)--cycle;\n\\path[fill=sectorA!20!white] (O)--(V3)--(V4)--cycle;\n\\path[fill=sectorB!20!white] (O)--(V4)--(V5)--cycle;\n\\path[fill=sectorA!20!white] (O)--(V5)--(V0)--cycle;\n\\draw (V0)--(V1)--(V2)--(V3)--(V4)--(V5)--cycle;\n\\foreach \\v in {V0,V1,V2,V3,V4,V5} {\\draw (O)--(\\v);}\n\\node at ({sqrt(3)/6},0.5) {C};\n\\node at ({sqrt(3)/3},0) {A};\n\\node at ({sqrt(3)/6},-0.5) {B};\n\\node at ({-sqrt(3)/6},-0.5) {A};\n\\node at ({-sqrt(3)/3},0) {B};\n\\node at ({-sqrt(3)/6},0.5) {A};\n\\draw[line width=0.8pt,line cap=round] (0,0)--(0.65,-1.25);\n\\draw[line width=0.8pt,line cap=round] (0,0)--(-0.65,1.25);\n\\fill[black] (O) circle[radius=1.2pt];\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 30,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 12,
          "sourceRegion": "Question 7, spinner to the left of parts a–f",
          "description": "Projected regular six-sector hexagonal spinner. Clockwise from the upper-right sector: C, A, B, A, B, A. Black pivot and pointer; the thick upper pointer extends beyond the upper-left perimeter and its thinner continuation extends below the opposite side.",
          "mathematics": "Six equally likely sectors under the approved editorial interpretation. A occurs three times, B twice and C once. Geometry is an affine projection of a regular hexagon; projected angles do not determine probabilities. No angle or dimension labels are added.",
          "answerVisibility": "Category labels, fills, boundaries and pointer are permanent question content. No probabilities appear in the diagram."
