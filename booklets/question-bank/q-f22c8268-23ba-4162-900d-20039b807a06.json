            "children": [
              {
                "id": "p12-q7-a",
                "type": "part",
                "label": "a",
                "prompt": "$P(\\mathrm{A}) =$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$\\frac{1}{2}$",
                  "worked": "$$\\begin{align*}P(\\mathrm{A}) &= \\frac{3}{6}\\\\P(\\mathrm{A}) &= \\frac{1}{2}\\end{align*}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 15
              },
              {
                "id": "p12-q7-b",
                "type": "part",
                "label": "b",
                "prompt": "$P(\\mathrm{C}) =$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$\\frac{1}{6}$",
                  "worked": "There is one C sector among six equally likely sectors.\n$$P(\\mathrm{C}) = \\frac{1}{6}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 15
              },
              {
                "id": "p12-q7-c",
                "type": "part",
                "label": "c",
                "prompt": "$P(\\mathrm{B}) =$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$\\frac{1}{3}$",
                  "worked": "$$\\begin{align*}P(\\mathrm{B}) &= \\frac{2}{6}\\\\P(\\mathrm{B}) &= \\frac{1}{3}\\end{align*}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 15
              },
              {
                "id": "p12-q7-d",
                "type": "part",
                "label": "d",
                "prompt": "$P(\\mathrm{D}) =$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$0$",
                  "worked": "There are no D sectors.\n$$\\begin{align*}P(\\mathrm{D}) &= \\frac{0}{6}\\\\P(\\mathrm{D}) &= 0\\end{align*}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 15
              }
            ]
          },
          {
            "id": "p12-q7-e",
            "type": "part",
            "label": "e",
            "prompt": "Do all probabilities sum to 1?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Yes.",
              "worked": "$$\\begin{align*}P(\\mathrm{A})+P(\\mathrm{C})+P(\\mathrm{B})+P(\\mathrm{D}) &= \\frac{1}{2}+\\frac{1}{6}+\\frac{1}{3}+0\\\\P(\\mathrm{A})+P(\\mathrm{C})+P(\\mathrm{B})+P(\\mathrm{D}) &= \\frac{3+1+2}{6}\\\\P(\\mathrm{A})+P(\\mathrm{C})+P(\\mathrm{B})+P(\\mathrm{D}) &= 1\\end{align*}$$\nYes.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p12-q7-f",
            "type": "part",
            "label": "f",
            "prompt": "Which event is the most likely?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Getting an A.",
              "worked": "Getting an A. It occupies three of the six equally likely sectors, giving the greatest probability, $\\frac{1}{2}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      }
