  "content": {
    "id": "p45-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The letters of the alphabet are written on 26 separate cards and shuffled. Three players are dealt three cards each. How many ways can the cards be dealt?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\binom{26}{3}\\binom{23}{3}\\binom{20}{3}=5\\,249\\,244\\,000$",
      "worked": "Choose the first player's three cards from 26, the second player's three cards from the remaining 23, and the third player's three cards from the remaining 20. Order within each hand does not matter.\n\n$$\\begin{align*}N&=\\binom{26}{3}\\binom{23}{3}\\binom{20}{3}\\\\N&=2600\\times1771\\times1140\\\\N&=5\\,249\\,244\\,000\\end{align*}$$",
      "solutionDiagrams": []
    },
