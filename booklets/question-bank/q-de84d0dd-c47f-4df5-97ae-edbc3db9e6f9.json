    "children": [
      {
        "id": "p38-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "The gradient function of a certain curve is given by $\\dfrac{dy}{dx}=\\sin x$.\n\nIf the curve passes through the origin, find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1-\\cos x$",
          "worked": "$$\\begin{aligned}y&=-\\cos x+C\\\\0&=-\\cos 0+C\\\\0&=-1+C\\\\C&=1\\\\y&=1-\\cos x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p38-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Another curve passing through the origin has gradient function $y'=\\cos x-2\\sin 2x$.\n\nFind its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sin x+\\cos 2x-1$",
          "worked": "$$\\begin{aligned}y&=\\sin x-2\\left(-\\frac12\\cos 2x\\right)+C\\\\y&=\\sin x+\\cos 2x+C\\\\0&=\\sin 0+\\cos 0+C\\\\0&=0+1+C\\\\C&=-1\\\\y&=\\sin x+\\cos 2x-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p38-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "If $\\dfrac{dy}{dx}=\\sin x+\\cos x$, and $y=-2$ when $x=\\pi$, find $y$ as a function of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\cos x+\\sin x-3$",
          "worked": "$$\\begin{aligned}y&=-\\cos x+\\sin x+C\\\\-2&=-\\cos\\pi+\\sin\\pi+C\\\\-2&=-(-1)+0+C\\\\1+C&=-2\\\\C&=-3\\\\y&=-\\cos x+\\sin x-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
