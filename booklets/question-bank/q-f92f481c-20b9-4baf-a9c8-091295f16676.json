    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt3(\\sqrt3+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+2\\sqrt3$",
          "worked": "$$\\begin{align*}\\sqrt3(\\sqrt3+2)&=\\sqrt3\\sqrt3+2\\sqrt3\\\\\\sqrt3(\\sqrt3+2)&=3+2\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt2(2\\sqrt2+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4+3\\sqrt2$",
          "worked": "$$\\begin{align*}\\sqrt2(2\\sqrt2+3)&=2\\times2+3\\sqrt2\\\\\\sqrt2(2\\sqrt2+3)&=4+3\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\sqrt5(3\\sqrt5-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45-9\\sqrt5$",
          "worked": "$$\\begin{align*}3\\sqrt5(3\\sqrt5-3)&=9\\times5-9\\sqrt5\\\\3\\sqrt5(3\\sqrt5-3)&=45-9\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt3(\\sqrt3-\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-\\sqrt6$",
          "worked": "$$\\begin{align*}\\sqrt3(\\sqrt3-\\sqrt2)&=\\sqrt9-\\sqrt6\\\\\\sqrt3(\\sqrt3-\\sqrt2)&=3-\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\sqrt2(3\\sqrt2-\\sqrt8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}2\\sqrt2(3\\sqrt2-\\sqrt8)&=6\\times2-2\\sqrt{16}\\\\2\\sqrt2(3\\sqrt2-\\sqrt8)&=12-8\\\\2\\sqrt2(3\\sqrt2-\\sqrt8)&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt2(\\sqrt8-\\sqrt6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4-2\\sqrt3$",
          "worked": "$$\\begin{align*}\\sqrt2(\\sqrt8-\\sqrt6)&=\\sqrt{16}-\\sqrt{12}\\\\\\sqrt2(\\sqrt8-\\sqrt6)&=4-2\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt3(\\sqrt3+1)+\\sqrt2(\\sqrt6+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+2\\sqrt2+3\\sqrt3$",
          "worked": "$$\\begin{align*}\\sqrt3(\\sqrt3+1)+\\sqrt2(\\sqrt6+2)&=3+\\sqrt3+\\sqrt{12}+2\\sqrt2\\\\\\sqrt3(\\sqrt3+1)+\\sqrt2(\\sqrt6+2)&=3+\\sqrt3+2\\sqrt3+2\\sqrt2\\\\\\sqrt3(\\sqrt3+1)+\\sqrt2(\\sqrt6+2)&=3+2\\sqrt2+3\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sqrt2(\\sqrt6-1)-\\sqrt3(\\sqrt6-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt3-4\\sqrt2$",
          "worked": "$$\\begin{align*}\\sqrt2(\\sqrt6-1)-\\sqrt3(\\sqrt6-3)&=\\sqrt{12}-\\sqrt2-\\sqrt{18}+3\\sqrt3\\\\\\sqrt2(\\sqrt6-1)-\\sqrt3(\\sqrt6-3)&=2\\sqrt3-\\sqrt2-3\\sqrt2+3\\sqrt3\\\\\\sqrt2(\\sqrt6-1)-\\sqrt3(\\sqrt6-3)&=5\\sqrt3-4\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$2\\sqrt2(2\\sqrt2-\\sqrt3)-3\\sqrt2(\\sqrt3-\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14-5\\sqrt6$",
          "worked": "$$\\begin{align*}2\\sqrt2(2\\sqrt2-\\sqrt3)-3\\sqrt2(\\sqrt3-\\sqrt2)&=8-2\\sqrt6-3\\sqrt6+6\\\\2\\sqrt2(2\\sqrt2-\\sqrt3)-3\\sqrt2(\\sqrt3-\\sqrt2)&=14-5\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\sqrt{10}(3\\sqrt5-1)+3\\sqrt2(\\sqrt5-3\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\sqrt2+2\\sqrt{10}-18$",
          "worked": "$$\\begin{align*}\\sqrt{10}(3\\sqrt5-1)+3\\sqrt2(\\sqrt5-3\\sqrt2)&=3\\sqrt{50}-\\sqrt{10}+3\\sqrt{10}-18\\\\\\sqrt{10}(3\\sqrt5-1)+3\\sqrt2(\\sqrt5-3\\sqrt2)&=15\\sqrt2-\\sqrt{10}+3\\sqrt{10}-18\\\\\\sqrt{10}(3\\sqrt5-1)+3\\sqrt2(\\sqrt5-3\\sqrt2)&=15\\sqrt2+2\\sqrt{10}-18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
