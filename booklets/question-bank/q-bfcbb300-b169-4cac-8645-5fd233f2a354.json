  "content": {
    "id": "p21-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "For how many values of $a$ does the quadratic $x^2-ax+100$ have two positive integer roots?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5$ values",
      "worked": "Let the roots be $p$ and $q$. Vieta’s formulas give $pq=100$ and $a=p+q$.\nThe positive integer factor pairs are $(1,100)$, $(2,50)$, $(4,25)$, $(5,20)$ and $(10,10)$. Their sums are $101$, $52$, $29$, $25$ and $20$, all distinct.\nEqual roots are allowed, so there are $5$ possible values of $a$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
