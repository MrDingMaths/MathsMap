        "label": "a",
        "prompt": "$\\dfrac{x}{6}+\\dfrac{3x+5}{3}=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "Multiply both sides by 6.\n\n$$\\begin{align*}x+2(3x+5)&=24\\\\x+6x+10&=24\\\\7x&=14\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p33-q6b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2x-3}{4}-\\dfrac{x+1}{3}=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{13}{2}$",
          "worked": "Multiply both sides by 12.\n\n$$\\begin{align*}3(2x-3)-4(x+1)&=0\\\\6x-9-4x-4&=0\\\\2x-13&=0\\\\2x&=13\\\\x&=\\frac{13}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p33-q6c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2x+3}{5}-\\dfrac{6+3x}{4}=\\dfrac{101}{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-17$",
          "worked": "Multiply both sides by 20.\n\n$$\\begin{align*}4(2x+3)-5(6+3x)&=101\\\\8x+12-30-15x&=101\\\\-7x-18&=101\\\\-7x&=119\\\\x&=-17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p33-q6d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x-8}{7}+\\dfrac{x-3}{3}+\\dfrac{5}{21}=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "Multiply both sides by 21.\n\n$$\\begin{align*}3(x-8)+7(x-3)+5&=0\\\\3x-24+7x-21+5&=0\\\\10x-40&=0\\\\10x&=40\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p33-q6e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x+5}{6}-\\dfrac{x+1}{9}=\\dfrac{x+3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac{1}{7}$",
          "worked": "Multiply both sides by 36.\n\n$$\\begin{align*}6(x+5)-4(x+1)&=9(x+3)\\\\6x+30-4x-4&=9x+27\\\\2x+26&=9x+27\\\\-1&=7x\\\\x&=-\\frac{1}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p33-q6f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{4(x+2)}{3}-\\dfrac{6(x-7)}{7}=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$",
          "worked": "Multiply both sides by 21.\n\n$$\\begin{align*}28(x+2)-18(x-7)&=252\\\\28x+56-18x+126&=252\\\\10x+182&=252\\\\10x&=70\\\\x&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
