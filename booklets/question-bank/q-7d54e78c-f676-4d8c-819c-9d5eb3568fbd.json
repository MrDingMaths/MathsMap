        "answer": {
          "short": "$(x-3)(x+8)$",
          "worked": "$$\\begin{align*}x^2+5x-24&=x^2+8x-3x-24\\\\x^2+5x-24&=x(x+8)-3(x+8)\\\\x^2+5x-24&=(x-3)(x+8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
