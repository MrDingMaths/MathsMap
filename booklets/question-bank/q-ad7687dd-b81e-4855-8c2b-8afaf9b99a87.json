    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p78-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the particle’s initial velocity?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\text{ m/s}$",
          "worked": "Differentiate displacement to obtain velocity.\n$$\\begin{align*}v(t)&=\\frac{dx}{dt}=-3+6t-3t^2\\\\v(0)&=-3\\text{ m/s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p78-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "When is the particle stationary?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=1\\text{ s}$",
          "worked": "A particle is stationary when its velocity is zero.\n$$\\begin{align*}v(t)&=-3+6t-3t^2\\\\0&=-3(t-1)^2\\\\t&=1\\text{ s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p78-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the average velocity for $t\\in[0,1]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\text{ m/s}$",
          "worked": "$$\\begin{align*}x(0)&=2\\\\x(1)&=2-3+3-1=1\\\\\\text{Average velocity}&=\\frac{x(1)-x(0)}{1-0}=-1\\text{ m/s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
