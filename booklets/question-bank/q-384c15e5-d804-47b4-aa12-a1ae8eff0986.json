  "content": {
    "id": "p52-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "For each curve, find the equation of the tangent and its angle of inclination at the given point. Give angles to the nearest minute.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{x}{5-3x}$ at $K(2,-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=5x-12$; $\\theta\\approx78^\\circ41'$.",
          "worked": "$$\\begin{align*}u&=x,&u'&=1\\\\v&=5-3x,&v'&=-3\\\\y'&=\\frac{u'v-uv'}{v^2}\\\\y'&=\\frac{1(5-3x)-x(-3)}{(5-3x)^2}\\\\y'&=\\frac{5}{(5-3x)^2}\\\\m&=\\frac{5}{(5-3(2))^2}=5\\\\y+2&=5(x-2)\\\\y&=5x-12\\\\\\tan\\theta&=5\\\\\\theta&\\approx78^\\circ41'\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p52-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x^2-4}{x-1}$ at $L(4,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{4x}{3}-\\dfrac43$; $\\theta\\approx53^\\circ8'$.",
          "worked": "$$\\begin{align*}u&=x^2-4,&u'&=2x\\\\v&=x-1,&v'&=1\\\\y'&=\\frac{u'v-uv'}{v^2}\\\\y'&=\\frac{2x(x-1)-(x^2-4)(1)}{(x-1)^2}\\\\y'&=\\frac{2x^2-2x-x^2+4}{(x-1)^2}\\\\y'&=\\frac{x^2-2x+4}{(x-1)^2}\\\\m&=\\frac{4^2-2(4)+4}{(4-1)^2}=\\frac43\\\\y-4&=\\frac43(x-4)\\\\y&=\\frac{4x}{3}-\\frac43\\\\\\tan\\theta&=\\frac43\\\\\\theta&\\approx53^\\circ8'\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 63
      }
    ]
