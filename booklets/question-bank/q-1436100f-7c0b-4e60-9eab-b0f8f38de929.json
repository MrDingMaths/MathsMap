    "id": "v2-b20da-p35-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Find the values of $x$ for which:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b20da-p35-practice-slot-1-slot-1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^3-6x^2+2x$ is concave up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>2$",
          "worked": "$$\\begin{align*}f'(x)&=3x^2-12x+2\\\\f''(x)&=6x-12\\\\6x-12&>0\\\\x&>2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-b20da-p35-practice-slot-1-slot-1-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^4-6x^2+5$ is concave down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1<x<1$",
          "worked": "$$\\begin{align*}f'(x)&=4x^3-12x\\\\f''(x)&=12x^2-12\\\\12(x-1)(x+1)&<0\\\\-1<x&<1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-b20da-p35-practice-slot-1-slot-1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^4-8x^3+18x^2$ is concave up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<1$ or $x>3$",
          "worked": "$$\\begin{align*}f'(x)&=4x^3-24x^2+36x\\\\f''(x)&=12x^2-48x+36\\\\&=12(x-1)(x-3)\\\\12(x-1)(x-3)&>0\\\\x<1\\ \\text{or}\\ x&>3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
