  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "For what positive integer values of $n$ is the function $f(x)=kx^n$, where $k$ is a nonzero real constant:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Even?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even values: $n=2,4,6,8,\\ldots$.",
          "worked": "$$\\begin{align*}f(-x)&=k(-x)^n\\\\&=kx^n\\quad\\text{when }n\\text{ is even}\\\\&=f(x).\\end{align*}$$Hence $n=2,4,6,8,\\ldots$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Odd?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Odd values: $n=1,3,5,7,\\ldots$.",
          "worked": "$$\\begin{align*}f(-x)&=k(-x)^n\\\\&=-kx^n\\quad\\text{when }n\\text{ is odd}\\\\&=-f(x).\\end{align*}$$Hence $n=1,3,5,7,\\ldots$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
