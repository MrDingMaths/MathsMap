  "content": {
    "id": "p12-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A class has 6 girls and 4 boys. Two students are selected at random. Find the probability of each event.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Both students are boys.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{15}$",
          "worked": "After selecting a boy, 3 of the remaining 9 students are boys.\n\n$$\\begin{align*}P(\\text{both boys}) &= \\frac4{10}\\times\\frac39 \\\\ P(\\text{both boys}) &= \\frac2{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "A boy and a girl are selected.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8}{15}$",
          "worked": "Add the probabilities of boy then girl and girl then boy.\n\n$$\\begin{align*}P(\\text{one of each}) &= \\frac4{10}\\times\\frac69+\\frac6{10}\\times\\frac49 \\\\ P(\\text{one of each}) &= \\frac{24}{90}+\\frac{24}{90} \\\\ P(\\text{one of each}) &= \\frac8{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
