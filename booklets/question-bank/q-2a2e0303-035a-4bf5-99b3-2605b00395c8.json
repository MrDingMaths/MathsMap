  "content": {
    "id": "p6-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Consider an arithmetic sequence whose first term and common difference are both 100. Given the $n\\text{th}$ term of this sequence is $100!$, find $n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=99!$",
      "worked": "Using $a_n=a+(n-1)d$ with $a=d=100$:\n$$\\begin{align*}a_n&=100+(n-1)100\\\\a_n&=100n\\end{align*}$$\nSince $a_n=100!$,\n$$\\begin{align*}100n&=100!\\\\n&=\\frac{100!}{100}\\\\n&=99!\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
