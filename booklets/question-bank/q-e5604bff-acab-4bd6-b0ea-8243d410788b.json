    "type": "question",
    "label": "8",
    "prompt": "Solve\n\n$$\\cos(x-45^\\circ)\\cos(x+45^\\circ)=\\frac14$$\n\nfor $0^\\circ\\le x\\le360^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=30^\\circ,\\ 150^\\circ,\\ 210^\\circ,\\ 330^\\circ$.",
      "worked": "$$\\begin{align*}\\left(\\frac{\\sqrt2}{2}\\cos x+\\frac{\\sqrt2}{2}\\sin x\\right)\\left(\\frac{\\sqrt2}{2}\\cos x-\\frac{\\sqrt2}{2}\\sin x\\right)&=\\frac14\\\\\\frac12\\cos^2x-\\frac12\\sin^2x&=\\frac14\\\\\\cos^2x-\\sin^2x&=\\frac12\\\\2\\cos^2x-1&=\\frac12\\\\\\cos^2x&=\\frac34\\\\\\cos x&=\\pm\\frac{\\sqrt3}{2}\\\\x&=30^\\circ,\\ 150^\\circ,\\ 210^\\circ,\\ 330^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 66
  },
