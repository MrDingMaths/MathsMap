  "content": {
    "id": "p41-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the volume of a sphere whose surface area is $16\\pi\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{32\\pi}{3}\\text{ cm}^3$",
      "worked": "$$\\begin{align*}4\\pi r^2&=16\\pi\\\\r^2&=4\\\\r&=2\\text{ cm}\\\\V&=\\frac43\\pi r^3\\\\V&=\\frac43\\pi(2)^3\\\\V&=\\frac{32\\pi}{3}\\text{ cm}^3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
