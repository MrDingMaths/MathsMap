  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Rearrange each of these formulas to make the pronumeral in brackets the subject. (All pronumerals represent positive numbers.)",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$c=a^2+b^2\\qquad(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\sqrt{c-b^2}$",
          "worked": "$$\\begin{align*}a^2+b^2&=c\\\\a^2&=c-b^2\\\\a&=\\sqrt{c-b^2}\\end{align*}$$\nTake the positive square root because $a>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$K=3\\ell^2+4m\\qquad(\\ell)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ell=\\sqrt{\\frac{K-4m}{3}}$",
          "worked": "$$\\begin{align*}3\\ell^2+4m&=K\\\\3\\ell^2&=K-4m\\\\\\ell^2&=\\frac{K-4m}{3}\\\\\\ell&=\\sqrt{\\frac{K-4m}{3}}\\end{align*}$$\nTake the positive square root because $\\ell>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=\\sqrt{ab}\\qquad(b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\frac{x^2}{a}$",
          "worked": "$$\\begin{align*}x^2&=ab\\\\ab&=x^2\\\\b&=\\frac{x^2}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p13-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$d=8\\sqrt{\\frac{h}{5}}\\qquad(h)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\frac{5d^2}{64}$",
          "worked": "$$\\begin{align*}\\frac{d}{8}&=\\sqrt{\\frac{h}{5}}\\\\\\frac{d^2}{64}&=\\frac{h}{5}\\\\h&=5\\times\\frac{d^2}{64}\\\\h&=\\frac{5d^2}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p13-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$T=\\frac{2\\pi}{n}\\qquad(n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac{2\\pi}{T}$",
          "worked": "$$\\begin{align*}nT&=2\\pi\\\\n&=\\frac{2\\pi}{T}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p13-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$D=\\frac{m}{v}\\qquad(v)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=\\frac{m}{D}$",
          "worked": "$$\\begin{align*}vD&=m\\\\v&=\\frac{m}{D}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p13-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$E=\\frac{m}{2r^2}\\qquad(r)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\sqrt{\\frac{m}{2E}}$",
          "worked": "$$\\begin{align*}2Er^2&=m\\\\r^2&=\\frac{m}{2E}\\\\r&=\\sqrt{\\frac{m}{2E}}\\end{align*}$$\nTake the positive square root because $r>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$T=\\frac{a}{4r^2}\\qquad(r)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\frac{1}{2}\\sqrt{\\frac{a}{T}}$",
          "worked": "$$\\begin{align*}4Tr^2&=a\\\\r^2&=\\frac{a}{4T}\\\\r&=\\sqrt{\\frac{a}{4T}}\\\\r&=\\frac{1}{2}\\sqrt{\\frac{a}{T}}\\end{align*}$$\nTake the positive square root because $r>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
