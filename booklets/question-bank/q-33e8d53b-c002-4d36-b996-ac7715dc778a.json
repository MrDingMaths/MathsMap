  "content": {
    "id": "p38-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "A cricket team knows that in half of the games they played last season, they won the game and their star player Arnav was playing. Arnav consistently plays in 80% of the games.\n\nWhat is the probability that they will win this Saturday if Arnav is playing?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$62.5\\%$",
      "worked": "Let $W$ be the event that the team wins and $A$ be the event that Arnav plays.\n\nFind $P(W\\mid A)$. Given $P(W\\cap A)=0.5$ and $P(A)=0.8$.\n\n$$\\begin{align*}P(W\\mid A)&=\\frac{P(W\\cap A)}{P(A)}\\\\P(W\\mid A)&=\\frac{0.5}{0.8}\\\\P(W\\mid A)&=62.5\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
