    "type": "question",
    "label": "11",
    "prompt": "Simplify the following. $\\frac{x^2-25}{x^2-5x}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{x+5}{x}$, $x\\ne0,5$.",
      "worked": "$$\\begin{align*}\\frac{x^2-25}{x^2-5x}&=\\frac{(x-5)(x+5)}{x(x-5)}\\\\\\frac{x^2-25}{x^2-5x}&=\\frac{x+5}{x}\\end{align*}$$\nOriginal domain: $x\\ne0,5$.",
      "solutionDiagrams": []
    },
