      {
        "id": "p30-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "\\$500 000",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$13 000",
          "worked": "$$\\begin{align*}\\text{Commission} &= 3000 + 0.02\\times500\\,000\\\\&= 3000 + 10\\,000\\\\&= \\$13\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p30-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "\\$950 000",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$24 250",
          "worked": "The amount in the second bracket is:\n$$\\begin{align*}950\\,000-500\\,000 &= 450\\,000\\end{align*}$$\n$$\\begin{align*}\\text{First bracket} &= 0.02\\times500\\,000\\\\&= \\$10\\,000\\\\\\text{Second bracket} &= 0.025\\times450\\,000\\\\&= \\$11\\,250\\\\\\text{Commission} &= 3000+10\\,000+11\\,250\\\\&= \\$24\\,250\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p30-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "\\$2 550 000",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$72 000",
          "worked": "The amount in the final bracket is:\n$$\\begin{align*}2\\,550\\,000-1\\,000\\,000 &= 1\\,550\\,000\\end{align*}$$\n$$\\begin{align*}\\text{First bracket} &= 0.02\\times500\\,000\\\\&= \\$10\\,000\\\\\\text{Second bracket} &= 0.025\\times500\\,000\\\\&= \\$12\\,500\\\\\\text{Final bracket} &= 0.03\\times1\\,550\\,000\\\\&= \\$46\\,500\\\\\\text{Commission} &= 3000+10\\,000+12\\,500+46\\,500\\\\&= \\$72\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
