  "content": {
    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A circle with centre $O(0,0)$ passes through $A(5,12)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What is its radius?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "$$\\begin{align*}r&=\\sqrt{5^2+12^2}\\\\r&=\\sqrt{169}\\\\r&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Therefore, what is its equation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=169$",
          "worked": "$$\\begin{align*}x^2+y^2&=13^2\\\\x^2+y^2&=169\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
