    "answer": {
      "short": "$15^{\\circ}\\mathrm{C}$",
      "worked": "$$\\begin{align*}\\text{Temperature rise}&=-7-(-22)\\\\\\text{Temperature rise}&=-7+22\\\\\\text{Temperature rise}&=15^{\\circ}\\mathrm{C}\\end{align*}$$",
