  "content": {
    "id": "p31-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The costs of material, labour and administration for an advertising campaign are in the ratio $8:5:2$. If the total cost of the campaign is $\\$35\\,700$, find the cost of the labour.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$11\\,900$",
      "worked": "There are $8+5+2=15$ parts in total. Labour accounts for 5 parts.\n$$\\begin{align*}\\text{Value of 15 parts}&=\\$35\\,700\\\\\\text{Value of 1 part}&=\\$35\\,700\\div15\\\\\\text{Value of 1 part}&=\\$2380\\\\\\text{Cost of labour}&=5\\times\\$2380\\\\\\text{Cost of labour}&=\\$11\\,900\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
