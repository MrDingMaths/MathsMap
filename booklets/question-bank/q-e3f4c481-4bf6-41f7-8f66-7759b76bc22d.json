      {
        "id": "p47-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{3x+3}{x^2-9}=\\dfrac{1}{x+3}+\\dfrac{2}{x-3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle \\frac{1}{x+3}+\\frac{2}{x-3}=\\frac{(x-3)+2(x+3)}{(x+3)(x-3)}=\\frac{3x+3}{x^2-9}$.",
          "worked": "$$\\begin{align*}\\mathrm{RHS}&=\\frac{1}{x+3}+\\frac{2}{x-3}\\\\&=\\frac{(x-3)+2(x+3)}{(x+3)(x-3)}\\\\&=\\frac{3x+3}{x^2-9}=\\mathrm{LHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p47-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int\\frac{3x+3}{x^2-9}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln|x+3|+2\\ln|x-3|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{3x+3}{x^2-9}\\,dx&=\\int\\left(\\frac{1}{x+3}+\\frac{2}{x-3}\\right)\\,dx\\\\&=\\ln|x+3|+2\\ln|x-3|+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
