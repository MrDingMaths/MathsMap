    "type": "question",
    "label": null,
    "prompt": "A water tank holds 4800 L. During a drought, the volume of water in the tank falls by 17.5%. How much water is in the tank now?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "3960 L",
      "worked": "$$\\begin{align*}\\text{Volume now}&=(100-17.5)\\%\\times4800\\text{ L}\\\\\\text{Volume now}&=0.825\\times4800\\text{ L}\\\\\\text{Volume now}&=3960\\text{ L}\\end{align*}$$",
      "solutionDiagrams": []
    },
