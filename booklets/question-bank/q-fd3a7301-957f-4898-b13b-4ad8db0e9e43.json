        "label": "a",
        "prompt": "Verify Bobbie’s solution by substitution to show it is incorrect.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "reuse-s5-p88-q11-verify-lhs",
            "type": "part",
            "label": "i",
            "prompt": "$\\text{LHS}=$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\text{LHS}=4$.",
              "worked": "$$\\begin{align*}\\text{LHS} &= 5(2)-6 \\\\ &= 4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "reuse-s5-p88-q11-verify-rhs",
            "type": "part",
            "label": "ii",
            "prompt": "$\\text{RHS}=$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\text{RHS}=16$. Since $\\text{LHS}\\ne\\text{RHS}$, $2$ is not the solution.",
              "worked": "$$\\begin{align*}\\text{RHS} &= 2+7(2) \\\\ &= 16\\end{align*}$$\nSince $\\text{LHS}=4$ and $\\text{RHS}=16$, $\\text{LHS}\\ne\\text{RHS}$. Therefore $2$ is not the solution.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      },
      {
        "id": "reuse-s5-p88-q11-correct",
        "type": "part",
        "label": "b",
        "prompt": "Identify Bobbie’s error and solve the equation correctly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "He should have kept the negative sign with $6$ on the left. $x=-4$.",
          "worked": "After subtracting $5x$ from both sides, Bobbie incorrectly changed $-6$ to $6$. The left side should remain $-6$.\n$$\\begin{align*}-6 &= 2+2x \\\\ -8 &= 2x \\\\ -4 &= x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
