  "content": {
    "id": "p6-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the midpoints of each of the following pairs of points:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q1a",
        "type": "part",
        "label": "a",
        "prompt": "$(1,3),\\ (3,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,5)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{1+3}{2},\\frac{3+7}{2}\\right)\\\\M&=(2,5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q1b",
        "type": "part",
        "label": "b",
        "prompt": "$(2,5),\\ (3,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac52,\\frac{13}{2}\\right)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{2+3}{2},\\frac{5+8}{2}\\right)\\\\M&=\\left(\\frac52,\\frac{13}{2}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q1c",
        "type": "part",
        "label": "c",
        "prompt": "$(-1,1),\\ (1,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,3)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{-1+1}{2},\\frac{1+5}{2}\\right)\\\\M&=(0,3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q1d",
        "type": "part",
        "label": "d",
        "prompt": "$(-3,2),\\ (9,-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(3,-\\frac32\\right)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{-3+9}{2},\\frac{2+(-5)}{2}\\right)\\\\M&=\\left(3,-\\frac32\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q1e",
        "type": "part",
        "label": "e",
        "prompt": "$(5,2),\\ (-3,-6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-2)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{5+(-3)}{2},\\frac{2+(-6)}{2}\\right)\\\\M&=(1,-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q1f",
        "type": "part",
        "label": "f",
        "prompt": "$(4,-3),\\ (7,-8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac{11}{2},-\\frac{11}{2}\\right)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{4+7}{2},\\frac{-3+(-8)}{2}\\right)\\\\M&=\\left(\\frac{11}{2},-\\frac{11}{2}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q1g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(\\frac12,\\frac14\\right),\\ \\left(\\frac32,\\frac34\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(1,\\frac12\\right)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{\\frac12+\\frac32}{2},\\frac{\\frac14+\\frac34}{2}\\right)\\\\M&=\\left(\\frac22,\\frac12\\right)\\\\M&=\\left(1,\\frac12\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q1h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\frac12,\\frac34\\right),\\ \\left(\\frac34,\\frac12\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac58,\\frac58\\right)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{\\frac12+\\frac34}{2},\\frac{\\frac34+\\frac12}{2}\\right)\\\\M&=\\left(\\frac{\\frac54}{2},\\frac{\\frac54}{2}\\right)\\\\M&=\\left(\\frac58,\\frac58\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
