        "label": "a",
        "prompt": "Divide $96\\text{ m}$ in the ratio $9:7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$54\\text{ m}$ and $42\\text{ m}$",
          "worked": "$$\\begin{align*}\\text{Total parts}&=9+7=16\\\\\\text{One part}&=96\\div16=6\\text{ m}\\\\\\text{First share}&=9\\times6=54\\text{ m}\\\\\\text{Second share}&=7\\times6=42\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q7b",
        "type": "part",
        "label": "b",
        "prompt": "Divide $144\\text{ cm}$ in the ratio $5:1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120\\text{ cm}$ and $24\\text{ cm}$",
          "worked": "$$\\begin{align*}\\text{Total parts}&=5+1=6\\\\\\text{One part}&=144\\div6=24\\text{ cm}\\\\\\text{First share}&=5\\times24=120\\text{ cm}\\\\\\text{Second share}&=1\\times24=24\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
