  "content": {
    "id": "p12-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{(-6)\\times(-8)}{3\\times(-2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8$",
          "worked": "$$\\begin{align*}\\frac{(-6)\\times(-8)}{3\\times(-2)}&=\\frac{48}{-6}\\\\\\frac{(-6)\\times(-8)}{3\\times(-2)}&=-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{12\\times4}{(-2)\\times(-6)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\frac{12\\times4}{(-2)\\times(-6)}&=\\frac{48}{12}\\\\\\frac{12\\times4}{(-2)\\times(-6)}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{13-17}{6-8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{13-17}{6-8}&=\\frac{-4}{-2}\\\\\\frac{13-17}{6-8}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{4-9}{9-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{4-9}{9-4}&=\\frac{-5}{5}\\\\\\frac{4-9}{9-4}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{12\\times(-5)}{15\\div(-3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}\\frac{12\\times(-5)}{15\\div(-3)}&=\\frac{-60}{-5}\\\\\\frac{12\\times(-5)}{15\\div(-3)}&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{18\\div3}{2\\times(-3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{18\\div3}{2\\times(-3)}&=\\frac{6}{-6}\\\\\\frac{18\\div3}{2\\times(-3)}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{(-6)\\times4}{2-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\frac{(-6)\\times4}{2-6}&=\\frac{-24}{-4}\\\\\\frac{(-6)\\times4}{2-6}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{(-16)\\div(-4)}{-6+8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{(-16)\\div(-4)}{-6+8}&=\\frac{4}{2}\\\\\\frac{(-16)\\div(-4)}{-6+8}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
