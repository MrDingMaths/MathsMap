    "children": [
      {
        "id": "p19-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1+\\sqrt5}{2}$ or $\\frac{1-\\sqrt5}{2}$; $x\\approx1.618$ or $-0.6180$.",
          "worked": "$$\\begin{align*}\\Delta&=(-1)^2-4(1)(-1)\\\\\\Delta&=5\\\\x&=\\frac{-(-1)\\pm\\sqrt5}{2(1)}\\\\x&=\\frac{1\\pm\\sqrt5}{2}\\\\x&\\approx1.618\\text{ or }-0.6180\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p19-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y^2+y=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{-1+\\sqrt{13}}2$ or $\\frac{-1-\\sqrt{13}}2$; $y\\approx1.303$ or $-2.303$.",
          "worked": "$$\\begin{align*}y^2+y-3&=0\\\\\\Delta&=1^2-4(1)(-3)\\\\\\Delta&=13\\\\y&=\\frac{-1\\pm\\sqrt{13}}{2(1)}\\\\y&=\\frac{-1\\pm\\sqrt{13}}2\\\\y&\\approx1.303\\text{ or }-2.303\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p19-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$a^2+12=7a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3$ or $4$.",
          "worked": "$$\\begin{align*}a^2-7a+12&=0\\\\\\Delta&=(-7)^2-4(1)(12)\\\\\\Delta&=1\\\\a&=\\frac{7\\pm\\sqrt1}{2}\\\\a&=3\\text{ or }4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p19-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$u^2+2u-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=-1+\\sqrt3$ or $-1-\\sqrt3$; $u\\approx0.7321$ or $-2.732$.",
          "worked": "$$\\begin{align*}\\Delta&=2^2-4(1)(-2)\\\\\\Delta&=12\\\\u&=\\frac{-2\\pm\\sqrt{12}}2\\\\u&=-1\\pm\\sqrt3\\\\u&\\approx0.7321\\text{ or }-2.732\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p19-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$c^2-6c+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=3+\\sqrt7$ or $3-\\sqrt7$; $c\\approx5.646$ or $0.3542$.",
          "worked": "$$\\begin{align*}\\Delta&=(-6)^2-4(1)(2)\\\\\\Delta&=28\\\\c&=\\frac{6\\pm\\sqrt{28}}2\\\\c&=3\\pm\\sqrt7\\\\c&\\approx5.646\\text{ or }0.3542\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p19-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$4x^2+4x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac12$.",
          "worked": "$$\\begin{align*}\\Delta&=4^2-4(4)(1)\\\\\\Delta&=0\\\\x&=\\frac{-4\\pm\\sqrt0}{2(4)}\\\\x&=-\\frac12\\end{align*}$$\nThere is one distinct solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      },
      {
        "id": "p19-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$2a^2+1=4a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{2+\\sqrt2}{2}$ or $\\frac{2-\\sqrt2}{2}$; $a\\approx1.707$ or $0.2929$.",
          "worked": "$$\\begin{align*}2a^2-4a+1&=0\\\\\\Delta&=(-4)^2-4(2)(1)\\\\\\Delta&=8\\\\a&=\\frac{4\\pm\\sqrt8}{2(2)}\\\\a&=\\frac{2\\pm\\sqrt2}{2}\\\\a&\\approx1.707\\text{ or }0.2929\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p19-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$5x^2+13x-6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $\\frac25$.",
          "worked": "$$\\begin{align*}\\Delta&=13^2-4(5)(-6)\\\\\\Delta&=289\\\\x&=\\frac{-13\\pm17}{10}\\\\x&=-3\\text{ or }\\frac25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      },
      {
        "id": "p19-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$2b^2+3b=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\frac{-3+\\sqrt{17}}4$ or $\\frac{-3-\\sqrt{17}}4$; $b\\approx0.2808$ or $-1.781$.",
          "worked": "$$\\begin{align*}2b^2+3b-1&=0\\\\\\Delta&=3^2-4(2)(-1)\\\\\\Delta&=17\\\\b&=\\frac{-3\\pm\\sqrt{17}}{2(2)}\\\\b&=\\frac{-3\\pm\\sqrt{17}}4\\\\b&\\approx0.2808\\text{ or }-1.781\\end{align*}$$",
          "solutionDiagrams": []
