    "children": [
      {
        "id": "p22-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the uniform distribution $f(x)=\\dfrac{1}{b-a}$ for $a\\le x\\le b$, $0$ for all other $x$, is a PDF. Assume $a<b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)\\ge0$ for all $x$ and the total area is $(b-a)\\dfrac{1}{b-a}=1$. Therefore, it is a PDF.",
          "worked": "Since $a<b$, $b-a>0$, so $f(x)=\\dfrac{1}{b-a}>0$ on $[a,b]$. Outside this interval, $f(x)=0$. Thus $f(x)\\ge0$ for all $x$.\n$$\\begin{align*}\\text{Total area}&=(b-a)\\times\\frac{1}{b-a}\\\\\\text{Total area}&=1\\end{align*}$$\nBoth PDF conditions hold, so it is a PDF.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p22-q14-b",
        "type": "group",
        "label": "b",
        "prompt": "If $a=3$ and $b=7$, find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q14-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(X\\le6)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac34$",
              "worked": "$$\\begin{align*}f(x)&=\\frac{1}{7-3}=\\frac14\\quad\\text{on }[3,7]\\\\P(X\\le6)&=(6-3)\\times\\frac14\\\\P(X\\le6)&=\\frac34\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p22-q14-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(X\\ge5)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac12$",
              "worked": "$$\\begin{align*}f(x)&=\\frac{1}{7-3}=\\frac14\\quad\\text{on }[3,7]\\\\P(X\\ge5)&=(7-5)\\times\\frac14\\\\P(X\\ge5)&=\\frac12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p22-q14-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(5\\le X\\le6)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac14$",
              "worked": "$$\\begin{align*}f(x)&=\\frac{1}{7-3}=\\frac14\\quad\\text{on }[3,7]\\\\P(5\\le X\\le6)&=(6-5)\\times\\frac14\\\\P(5\\le X\\le6)&=\\frac14\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      }
    ]
