  "content": {
    "id": "p46-q9-root",
    "type": "question",
    "label": "",
    "prompt": "Factorise these expressions by first rearranging the terms.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p46-q9a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p46-q9a-given",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\mathrel{\\phantom{=}}2x^2-7-14x+x",
                  "display": false
                }
              ]
            },
            {
              "id": "p46-q9a-start",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "=2x^2-14x-7+x",
                  "display": false,
                  "colour": "#268cff"
                }
              ]
            },
            {
              "id": "p46-q9a-equals",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "=",
                  "display": false,
                  "colour": "#268cff"
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(x-7)$",
          "worked": "$$\\begin{align*}2x^2-7-14x+x&=2x^2-14x+x-7\\\\&=2x(x-7)+(x-7)\\\\&=(2x+1)(x-7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p46-q9b",
        "type": "part",
        "label": "b",
        "prompt": "$5x+2x+x^2+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+5)(x+2)$",
          "worked": "$$\\begin{align*}5x+2x+x^2+10&=x^2+5x+2x+10\\\\&=x(x+5)+2(x+5)\\\\&=(x+5)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p46-q9c",
        "type": "part",
        "label": "c",
        "prompt": "$2x^2-3-x+6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(x+3)$",
          "worked": "$$\\begin{align*}2x^2-3-x+6x&=2x^2+6x-x-3\\\\&=2x(x+3)-(x+3)\\\\&=(2x-1)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p46-q9d",
        "type": "part",
        "label": "d",
        "prompt": "$3x-8x-6x^2+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-2x)(3x+4)$",
          "worked": "$$\\begin{align*}3x-8x-6x^2+4&=3x-6x^2+4-8x\\\\&=3x(1-2x)+4(1-2x)\\\\&=(1-2x)(3x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p46-q9e",
        "type": "part",
        "label": "e",
        "prompt": "$11x-5a-55+ax$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+11)(x-5)$",
          "worked": "$$\\begin{align*}11x-5a-55+ax&=ax-5a+11x-55\\\\&=a(x-5)+11(x-5)\\\\&=(a+11)(x-5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p46-q9f",
        "type": "part",
        "label": "f",
        "prompt": "$12y+2x-8xy-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-3)(1-4y)$",
          "worked": "$$\\begin{align*}12y+2x-8xy-3&=2x-8xy-3+12y\\\\&=2x(1-4y)-3(1-4y)\\\\&=(2x-3)(1-4y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p46-q9g",
        "type": "part",
        "label": "g",
        "prompt": "$6m-n+3mn-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3m-1)(n+2)$",
          "worked": "$$\\begin{align*}6m-n+3mn-2&=3mn+6m-n-2\\\\&=3m(n+2)-(n+2)\\\\&=(3m-1)(n+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p46-q9h",
        "type": "part",
        "label": "h",
        "prompt": "$15p-8r-5pr+24$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5p+8)(3-r)$",
          "worked": "$$\\begin{align*}15p-8r-5pr+24&=15p-5pr+24-8r\\\\&=5p(3-r)+8(3-r)\\\\&=(5p+8)(3-r)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p46-q9i",
        "type": "part",
        "label": "i",
        "prompt": "$16x-3y-8xy+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(8x+3)(2-y)$",
          "worked": "$$\\begin{align*}16x-3y-8xy+6&=16x-8xy+6-3y\\\\&=8x(2-y)+3(2-y)\\\\&=(8x+3)(2-y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
