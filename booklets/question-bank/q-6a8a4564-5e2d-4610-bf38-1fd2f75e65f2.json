    "children": [
      {
        "id": "p39-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\angle ZXY=90^{\\circ}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle ZXY=(360^{\\circ}-330^{\\circ})+60^{\\circ}=90^{\\circ}$.",
          "worked": "The angle between $XZ$ and north is $360^{\\circ}-330^{\\circ}=30^{\\circ}$. The angle between north and $XY$ is $60^{\\circ}$.\n$$\\begin{align*}\\angle ZXY&=30^{\\circ}+60^{\\circ}\\\\&=90^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that town $Z$ is $80\\text{ km}$ from town $X$ and that $\\angle XYZ=50^{\\circ}$, find correct to the nearest kilometre, the distance between town $Y$ and town $X$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$67\\text{ km}$",
          "worked": "Let $XY=x\\text{ km}$. Relative to $50^{\\circ}$, $XZ$ is opposite and $XY$ is adjacent.\n$$\\begin{align*}\\tan 50^{\\circ}&=\\frac{80}{x}\\\\x\\tan 50^{\\circ}&=80\\\\x&=\\frac{80}{\\tan 50^{\\circ}}\\\\x&\\approx67\\end{align*}$$\nThe distance between towns $Y$ and $X$ is $67\\text{ km}$, to the nearest kilometre.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
