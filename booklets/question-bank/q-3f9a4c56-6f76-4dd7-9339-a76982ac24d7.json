    "label": "10",
    "prompt": "A rectangle has length $2x$ cm and width $\\frac{5x}{3}$ cm.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the area of the rectangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10x^2}{3}\\text{ cm}^2$",
          "worked": "Area is length multiplied by width.\n\n$$\\begin{align*}A&=2x\\times\\frac{5x}{3}\\\\A&=\\frac{10x^2}{3}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area if $x=27$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2430\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{10\\times27^2}{3}\\\\A&=\\frac{7290}{3}\\\\A&=2430\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
