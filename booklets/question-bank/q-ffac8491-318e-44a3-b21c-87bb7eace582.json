  "content": {
    "id": "p15-g37-40-root",
    "type": "question",
    "label": null,
    "prompt": "By using the identity $\\log_a(a^x)=x$, simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-g37-40-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2(2^4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\log_2(2^4)=4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-g37-40-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_3(81)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\log_3(81)&=\\log_3(3^4)\\\\\\log_3(81)&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-g37-40-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_5(\\sqrt5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\log_5(\\sqrt5)&=\\log_5(5^{1/2})\\\\\\log_5(\\sqrt5)&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-g37-40-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_2(\\sqrt{32})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac52$",
          "worked": "$$\\begin{align*}\\log_2(\\sqrt{32})&=\\log_2\\bigl((2^5)^{1/2}\\bigr)\\\\\\log_2(\\sqrt{32})&=\\log_2(2^{5/2})\\\\\\log_2(\\sqrt{32})&=\\frac52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
