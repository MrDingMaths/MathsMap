    "answer": {
      "short": "$42\\text{ km}$",
      "worked": "$$\\begin{align*}\\text{Time}&=2+\\frac{20}{60}\\\\\\text{Time}&=\\frac73\\text{ h}\\\\\\text{Distance}&=18\\times\\frac73\\\\\\text{Distance}&=42\\text{ km}\\end{align*}$$",
