    "type": "question",
    "label": "4",
    "prompt": "In a class, $\\frac13$ of the students are 12 years old and $\\frac15$ of the students are 11 years old. What fraction of the students in the class are either 11 or 12 years old?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac8{15}$",
      "worked": "$$\\begin{align*}\\frac13+\\frac15&=\\frac5{15}+\\frac3{15}\\\\\\frac13+\\frac15&=\\frac8{15}\\end{align*}$$\n$\\frac8{15}$ of the students are either 11 or 12 years old.",
      "solutionDiagrams": []
