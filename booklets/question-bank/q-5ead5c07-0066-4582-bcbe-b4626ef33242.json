  "content": {
    "id": "v2-2-practice-section-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "If $P(A)=0.7$, $P(B)=0.4$ and $P(A\\cap B)=0.3$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-2-practice-section-slot-13-slot-13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(A\\cap B')$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{align*}P(A\\cap B')&=P(A)-P(A\\cap B)\\\\&=0.7-0.3\\\\&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-2-practice-section-slot-13-slot-13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(A\\cup B')$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9$",
          "worked": "$$\\begin{align*}P(B')&=1-0.4\\\\&=0.6\\\\P(A\\cup B')&=P(A)+P(B')-P(A\\cap B')\\\\&=0.7+0.6-0.4\\\\&=0.9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
