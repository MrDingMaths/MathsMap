  "content": {
    "id": "p10-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Factorise $(x+y)^3-(x-y)^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2y(3x^2+y^2)$\n\nUse the difference of cubes with bases $x+y$ and $x-y$.",
      "worked": "$$\\begin{align*}(x+y)^3-(x-y)^3&=((x+y)-(x-y))((x+y)^2+(x+y)(x-y)+(x-y)^2)\\\\(x+y)^3-(x-y)^3&=2y(x^2+2xy+y^2+x^2-y^2+x^2-2xy+y^2)\\\\(x+y)^3-(x-y)^3&=2y(3x^2+y^2).\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
