    "children": [
      {
        "id": "p66-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $(n+1)^2-(n-1)^2=4n$ for all integers $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n+1)^2-(n-1)^2=(2n)(2)=4n$.",
          "worked": "$$\\begin{align*}(n+1)^2-(n-1)^2&=[(n+1)+(n-1)][(n+1)-(n-1)]\\\\&=(n+1+n-1)(n+1-n+1)\\\\&=(2n)(2)\\\\&=4n.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p66-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence show that the difference of the squares of any two integers differing by 2 is always a multiple of 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Write the integers as $n-1$ and $n+1$. Their squares differ by $4n$, a multiple of 4.",
          "worked": "Any two integers differing by 2 can be written as $n-1$ and $n+1$, where $n$ is their integer midpoint. By part a, their squares differ by $4n$. Since $n$ is an integer, $4n$ is a multiple of 4, so the difference is always divisible by 4.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
