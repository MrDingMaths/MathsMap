          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "C(t)=9\\left(e^{-0.2t}-e^{-0.4t}\\right)",
              "display": true
            }
          ]
        },
        {
          "id": "p52-q4-variables",
          "type": "paragraph",
          "fontSize": null,
