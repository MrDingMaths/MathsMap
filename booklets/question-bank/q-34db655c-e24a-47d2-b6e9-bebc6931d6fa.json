          "inlines": [
            {
              "type": "text",
              "text": "When antibiotics are introduced into the human body, the concentration of the antibiotic in the bloodstream can be modelled by the equation",
              "marks": []
            }
          ]
        },
        {
          "id": "p52-q4-model",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
