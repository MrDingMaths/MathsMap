        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q9-b",
            "type": "part",
            "label": "b",
            "prompt": "the rate of increase of area when $r=40\\text{ cm}$ if the radius is increasing at $3\\text{ cm/s}$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$240\\pi\\text{ cm}^2/\\text{s}$.",
              "worked": "When $r=40\\text{ cm}$ and $\\dfrac{dr}{dt}=3\\text{ cm/s}$,\n$$\\begin{align*}\\frac{dA}{dt}&=2\\pi r\\frac{dr}{dt}\\\\\\frac{dA}{dt}&=2\\pi(40)(3)\\\\\\frac{dA}{dt}&=240\\pi\\text{ cm}^2/\\text{s}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p12-q9-c",
            "type": "part",
            "label": "c",
            "prompt": "the rate of increase of the radius when $r=60\\text{ cm}$ if the area is increasing at $10\\text{ cm}^2/\\text{s}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{12\\pi}\\text{ cm/s}$.",
              "worked": "When $r=60\\text{ cm}$ and $\\dfrac{dA}{dt}=10\\text{ cm}^2/\\text{s}$,\n$$\\begin{align*}\\frac{dA}{dt}&=2\\pi r\\frac{dr}{dt}\\\\10&=2\\pi(60)\\frac{dr}{dt}\\\\\\frac{dr}{dt}&=\\frac{10}{120\\pi}\\\\\\frac{dr}{dt}&=\\frac{1}{12\\pi}\\text{ cm/s}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          }
        ]
      }
    ]
