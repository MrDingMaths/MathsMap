  "content": {
    "id": "p12-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A circular oil stain of radius $r$ and area $A$ is spreading on water.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate the area formula with respect to time to show that $\\dfrac{dA}{dt}=2\\pi r\\left(\\dfrac{dr}{dt}\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dA}{dt}=2\\pi r\\dfrac{dr}{dt}$.",
          "worked": "$$\\begin{align*}A&=\\pi r^2\\\\\\frac{dA}{dr}&=2\\pi r\\\\\\frac{dA}{dt}&=\\frac{dA}{dr}\\times\\frac{dr}{dt}\\\\\\frac{dA}{dt}&=2\\pi r\\frac{dr}{dt}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q9-hence-group",
        "type": "group",
        "label": "",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p12-q9-hence-text",
              "type": "paragraph",
              "fontSize": null,
