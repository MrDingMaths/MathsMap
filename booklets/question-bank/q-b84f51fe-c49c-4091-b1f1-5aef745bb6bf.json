  "content": {
    "id": "p56-q13-root",
    "type": "question",
    "label": null,
    "prompt": "In simple cases, the time $t$ it takes for a tank to empty is found to be proportional to a power of the initial depth $h$ of the water.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q13-a",
        "type": "group",
        "label": "a",
        "prompt": "The time taken to empty a cylindrical tank is proportional to the square-root of the initial depth.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p56-q13-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t=k\\sqrt h$.",
              "worked": "$$t=k\\sqrt h.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p56-q13-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "When the initial depth was $9\\text{ m}$ the time taken was $8448\\text{ s}$. How long will it take to empty this tank if it is filled to a depth of $4\\text{ m}$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5632\\text{ s}$.",
              "worked": "$$\\begin{align*}8448&=k\\sqrt9\\\\k&=\\frac{8448}{3}\\\\k&=2816.\\end{align*}$$$$\\begin{align*}t&=2816\\sqrt4\\\\t&=5632\\text{ s}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      },
      {
        "id": "p56-q13-b",
        "type": "group",
        "label": "b",
        "prompt": "The time taken to empty a conical tank is proportional to the square-root of the fifth power of the initial depth.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p56-q13-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t=k\\sqrt{h^5}$.",
              "worked": "$$t=k\\sqrt{h^5}=kh^{5/2}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p56-q13-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "When the initial depth was $3\\text{ m}$ the time taken was $956\\text{ s}$. How long will it take to empty this tank if it is filled to a depth of $4\\text{ m}$? Give your answer correct to the nearest second.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1962\\text{ s}$.\n\nUse $t=k\\sqrt{h^5}$ and retain the unrounded constant.",
              "worked": "$$\\begin{align*}956&=k\\sqrt{3^5}\\\\k&=\\frac{956}{\\sqrt{243}}.\\end{align*}$$$$\\begin{align*}t&=\\frac{956}{\\sqrt{243}}\\sqrt{4^5}\\\\t&\\approx1962.477715\\text{ s}\\\\t&\\approx1962\\text{ s}\\quad\\text{(nearest second)}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      }
    ]
  },
