        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{9}$",
          "worked": "There are $4+3+6+5=18$ items.\n\n$$\\begin{align*}P(\\text{green})&=\\frac{3+5}{18}\\\\P(\\text{green})&=\\frac{8}{18}\\\\P(\\text{green})&=\\frac{4}{9}\\end{align*}$$",
