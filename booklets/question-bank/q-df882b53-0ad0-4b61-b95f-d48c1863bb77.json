    "type": "question",
    "label": "6",
    "prompt": "In a bag there are four red capsicums, three green capsicums, six red apples and five green apples. One item is chosen at random. Find the probability that it is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "green",
