      {
        "id": "p26-q60-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x=\\dfrac{n}{n-1}$ is a zero of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P\\!\\left(\\dfrac{n}{n-1}\\right)=0$.",
          "worked": "$$\\begin{align*}P(x)&=x^{n-1}\\bigl[n-(n-1)x\\bigr]\\\\P\\!\\left(\\frac{n}{n-1}\\right)&=\\left(\\frac{n}{n-1}\\right)^{n-1}\\left[n-(n-1)\\frac{n}{n-1}\\right]\\\\P\\!\\left(\\frac{n}{n-1}\\right)&=\\left(\\frac{n}{n-1}\\right)^{n-1}(n-n)\\\\P\\!\\left(\\frac{n}{n-1}\\right)&=0\\end{align*}$$\nHence $x=\\dfrac{n}{n-1}$ is a zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p26-q60-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $P(1)$ is fixed, regardless of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(1)=1$, independently of $n$.",
          "worked": "$$\\begin{align*}P(1)&=n(1)^{n-1}-(n-1)(1)^n\\\\P(1)&=n-(n-1)\\\\P(1)&=1\\end{align*}$$\nThis value is independent of $n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p26-q60-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that the graph is always above the $x$-axis for $0<x<\\dfrac{n}{n-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p26-q60-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "P(x)>0\\quad\\text{for }0<x<\\frac{n}{n-1}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p26-q60-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Both factors in ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x^{n-1}[n-(n-1)x]",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " are positive on this interval.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$P(x)=x^{n-1}\\bigl[n-(n-1)x\\bigr].$$\nFor $0<x<\\dfrac{n}{n-1}$, the factor $x^{n-1}$ is positive. Since $n-1>0$,\n$$\\begin{align*}(n-1)x&<n\\\\n-(n-1)x&>0\\end{align*}$$\nBoth factors are positive, so $P(x)>0$. Hence the graph is above the $x$-axis throughout the interval.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
