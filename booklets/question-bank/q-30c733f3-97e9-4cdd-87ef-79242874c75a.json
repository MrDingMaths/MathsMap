  "content": {
    "id": "p26-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "$f(x)=x-2$ and $g(x)=\\sqrt{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x}-2$",
          "worked": "$$\\begin{align*}f(g(x))&=f(\\sqrt{x})\\\\f(g(x))&=\\sqrt{x}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence state the domain of $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\geq 0$",
          "worked": "For $\\sqrt{x}$ to be real, $x\\geq 0$. Subtracting 2 introduces no further restriction, so the domain is $[0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p26-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the domain of $g(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\geq 2$",
          "worked": "$$g(f(x))=\\sqrt{x-2}$$\nThe expression under the square root must be non-negative:\n$$\\begin{align*}x-2&\\geq 0\\\\x&\\geq 2\\end{align*}$$\nThe domain is $[2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
