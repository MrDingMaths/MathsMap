  "content": {
    "id": "p8-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Four-letter codes are made from the letters of the word GROUPS. Find the number of possible codes if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{6}P_4=360$",
          "worked": "Choose and order four of the six distinct letters without repetition.\n\n$$\\begin{align*}N&={}^{6}P_4\\\\N&=6\\times5\\times4\\times3\\\\N&=360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "the code starts with P.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{5}P_3=60$",
          "worked": "Fix P first. Choose and order the remaining three letters from the other five.\n\n$$\\begin{align*}N&={}^{5}P_3\\\\N&=5\\times4\\times3\\\\N&=60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "the code contains the letter G but not the letter S.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\times{}^{4}P_3=96$\n\nChoose G's position, then fill the other positions without S.",
          "worked": "G has four possible positions. Excluding S leaves R, O, U and P for the other three positions.\n\n$$\\begin{align*}N&=4\\times{}^{4}P_3\\\\N&=4\\times4\\times3\\times2\\\\N&=96\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
