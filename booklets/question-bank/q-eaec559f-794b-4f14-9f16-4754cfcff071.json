    "id": "p11-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "For each measurement, identify the range within which the true value lies.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$15\\text{ cm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14.5\\le x<15.5\\text{ cm}$",
          "worked": "The precision is $1$ cm, so the half-interval is $0.5$ cm.\n\n$15-0.5=14.5$ and $15+0.5=15.5$.\n\n$14.5\\le x<15.5\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$2.00\\times10^3\\text{ kg}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.995\\times10^3\\le x<2.005\\times10^3\\text{ kg}$",
          "worked": "$2.00\\times10^3=2000$ kg is recorded to the nearest $10$ kg. The half-interval is $5$ kg.\n\n$2000-5=1995$ and $2000+5=2005$.\n\n$1.995\\times10^3\\le x<2.005\\times10^3\\text{ kg}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$18.67\\text{ m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18.665\\le x<18.675\\text{ m}$",
          "worked": "The precision is $0.01$ m, so the half-interval is $0.005$ m.\n\n$18.67-0.005=18.665$ and $18.67+0.005=18.675$.\n\n$18.665\\le x<18.675\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$4.8745\\times10^7\\text{ mL}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.87445\\times10^7\\le x<4.87455\\times10^7\\text{ mL}$",
          "worked": "$4.8745\\times10^7=48\\,745\\,000$ mL is recorded to the nearest $1000$ mL. The half-interval is $500$ mL.\n\n$48\\,745\\,000-500=48\\,744\\,500$ and $48\\,745\\,000+500=48\\,745\\,500$.\n\n$4.87445\\times10^7\\le x<4.87455\\times10^7\\text{ mL}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
