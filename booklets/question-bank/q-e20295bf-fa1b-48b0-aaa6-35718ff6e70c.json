  "content": {
    "id": "p6-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Solve these trigonometric equations for $x\\in[0,2\\pi)$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\left(x-\\frac{\\pi}{4}\\right)=\\frac{1}{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{\\pi}{2},\\pi$",
          "worked": "Let $u=x-\\frac{\\pi}{4}$, so $-\\frac{\\pi}{4}\\le u<\\frac{7\\pi}{4}$.\n$$\\begin{align*}\\sin u&=\\frac{1}{\\sqrt2}\\\\u&=\\frac{\\pi}{4},\\frac{3\\pi}{4}\\\\x&=u+\\frac{\\pi}{4}\\\\x&=\\frac{\\pi}{2},\\pi.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\left(x-\\frac{\\pi}{6}\\right)=-\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5\\pi}{6},\\frac{3\\pi}{2}$",
          "worked": "Let $u=x-\\frac{\\pi}{6}$, so $-\\frac{\\pi}{6}\\le u<\\frac{11\\pi}{6}$.\n$$\\begin{align*}\\cos u&=-\\frac12\\\\u&=\\frac{2\\pi}{3},\\frac{4\\pi}{3}\\\\x&=u+\\frac{\\pi}{6}\\\\x&=\\frac{5\\pi}{6},\\frac{3\\pi}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\left(x+\\frac{\\pi}{4}\\right)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3\\pi}{4},\\frac{7\\pi}{4}$",
          "worked": "Let $u=x+\\frac{\\pi}{4}$, so $\\frac{\\pi}{4}\\le u<\\frac{9\\pi}{4}$.\n$$\\begin{align*}\\sin u&=0\\\\u&=\\pi,2\\pi\\\\x&=u-\\frac{\\pi}{4}\\\\x&=\\frac{3\\pi}{4},\\frac{7\\pi}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\left(x-\\frac{\\pi}{3}\\right)=\\frac{\\sqrt3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2\\pi}{3},\\pi$",
          "worked": "Let $u=x-\\frac{\\pi}{3}$, so $-\\frac{\\pi}{3}\\le u<\\frac{5\\pi}{3}$.\n$$\\begin{align*}\\sin u&=\\frac{\\sqrt3}{2}\\\\u&=\\frac{\\pi}{3},\\frac{2\\pi}{3}\\\\x&=u+\\frac{\\pi}{3}\\\\x&=\\frac{2\\pi}{3},\\pi.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\tan\\left(x-\\frac{\\pi}{6}\\right)=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{11\\pi}{12},\\frac{23\\pi}{12}$",
          "worked": "Let $u=x-\\frac{\\pi}{6}$, so $-\\frac{\\pi}{6}\\le u<\\frac{11\\pi}{6}$.\n$$\\begin{align*}\\tan u&=-1\\\\u&=\\frac{3\\pi}{4},\\frac{7\\pi}{4}\\\\x&=u+\\frac{\\pi}{6}\\\\x&=\\frac{11\\pi}{12},\\frac{23\\pi}{12}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
