        "type": "part",
        "label": "a",
        "prompt": "Find the second derivative $\\dfrac{d^2y}{dx^2}$ of $y=x^3-3x^2-5x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d^2y}{dx^2}=6x-6$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2-6x-5\\\\\\frac{d^2y}{dx^2}&=6x-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
