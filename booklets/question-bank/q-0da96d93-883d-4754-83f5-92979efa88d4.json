        "answer": {
          "short": "$(x+3)^2$",
          "worked": "$$\\begin{align*}(x-3)^2+12x&=x^2-6x+9+12x\\\\(x-3)^2+12x&=x^2+6x+9\\\\(x-3)^2+12x&=(x+3)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q3-c",
        "type": "part",
