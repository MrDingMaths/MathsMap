  "content": {
    "id": "p63-q17-root",
    "type": "question",
    "label": null,
    "prompt": "The quadrilateral $PQRS$ has vertices $P(-3,-4)$, $Q(2,-2)$, $R(4,3)$ and $S(-1,1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p63-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\overrightarrow{PQ}=\\overrightarrow{SR}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{PQ}=\\overrightarrow{SR}=\\begin{pmatrix}5\\\\2\\end{pmatrix}$.",
          "worked": "$$\\begin{align*}\\overrightarrow{PQ}&=\\overrightarrow{OQ}-\\overrightarrow{OP}\\\\&=\\begin{pmatrix}2-(-3)\\\\-2-(-4)\\end{pmatrix}\\\\&=\\begin{pmatrix}5\\\\2\\end{pmatrix}\\end{align*}$$\n$$\\begin{align*}\\overrightarrow{SR}&=\\overrightarrow{OR}-\\overrightarrow{OS}\\\\&=\\begin{pmatrix}4-(-1)\\\\3-1\\end{pmatrix}\\\\&=\\begin{pmatrix}5\\\\2\\end{pmatrix}\\end{align*}$$\nHence, $\\overrightarrow{PQ}=\\overrightarrow{SR}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p63-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $|\\overrightarrow{PQ}|=|\\overrightarrow{QR}|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\overrightarrow{PQ}|=|\\overrightarrow{QR}|=\\sqrt{29}$.",
          "worked": "$$\\begin{align*}|\\overrightarrow{PQ}|&=\\sqrt{5^2+2^2}\\\\&=\\sqrt{29}\\end{align*}$$\n$$\\begin{align*}\\overrightarrow{QR}&=\\overrightarrow{OR}-\\overrightarrow{OQ}\\\\&=\\begin{pmatrix}4-2\\\\3-(-2)\\end{pmatrix}\\\\&=\\begin{pmatrix}2\\\\5\\end{pmatrix}\\end{align*}$$\n$$\\begin{align*}|\\overrightarrow{QR}|&=\\sqrt{2^2+5^2}\\\\&=\\sqrt{29}\\end{align*}$$\nHence, $|\\overrightarrow{PQ}|=|\\overrightarrow{QR}|$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p63-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "What type of special quadrilateral is $PQRS$? Give reasons for your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A rhombus: one pair of opposite sides is equal and parallel, and adjacent sides are equal in length.",
          "worked": "Since $\\overrightarrow{PQ}=\\overrightarrow{SR}$, one pair of opposite sides is equal and parallel, so $PQRS$ is a parallelogram. Also, $|\\overrightarrow{PQ}|=|\\overrightarrow{QR}|$, so adjacent sides are equal. Therefore, $PQRS$ is a rhombus.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
