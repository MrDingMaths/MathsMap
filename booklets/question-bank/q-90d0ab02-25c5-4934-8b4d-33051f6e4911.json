  "content": {
    "id": "p26-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Evaluate $3m^3-2n$ when:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$m=2$ and $n=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}3m^3-2n&=3\\times2^3-2\\times3\\\\3m^3-2n&=24-6\\\\3m^3-2n&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$m=-4$ and $n=-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-182$",
          "worked": "$$\\begin{align*}3m^3-2n&=3\\times(-4)^3-2\\times(-5)\\\\3m^3-2n&=3\\times(-64)+10\\\\3m^3-2n&=-192+10\\\\3m^3-2n&=-182\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p26-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$m=-\\frac12$ and $n=\\frac34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{15}{8}$",
          "worked": "$$\\begin{align*}3m^3-2n&=3\\left(-\\frac12\\right)^3-2\\left(\\frac34\\right)\\\\3m^3-2n&=-\\frac38-\\frac32\\\\3m^3-2n&=-\\frac38-\\frac{12}{8}\\\\3m^3-2n&=-\\frac{15}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p26-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$m=\\frac13$ and $n=\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac19-2\\sqrt2$",
          "worked": "$$\\begin{align*}3m^3-2n&=3\\left(\\frac13\\right)^3-2\\sqrt2\\\\3m^3-2n&=\\frac3{27}-2\\sqrt2\\\\3m^3-2n&=\\frac19-2\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
