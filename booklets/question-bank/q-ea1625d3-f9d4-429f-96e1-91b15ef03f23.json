  "content": {
    "id": "p40-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Three numbers are chosen uniformly from the interval $[0,1]$. What is the probability that the sum of the numbers is less than 1?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
