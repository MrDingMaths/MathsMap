        "children": [],
        "answer": {
          "short": "$(x+2)(x+3)$",
          "worked": "$\\begin{align*}x^{2}+2x+3x+6&=x(x+2)+3(x+2)\\\\&=(x+2)(x+3)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
