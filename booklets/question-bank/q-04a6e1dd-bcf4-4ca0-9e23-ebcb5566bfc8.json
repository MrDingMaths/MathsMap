    "children": [
      {
        "id": "p12-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Find a formula for $a_n$ in $2x,\\,2x^2,\\,2x^3,\\ldots$ Then find $x$ if $a_6=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=2x^n$; $x=1$ or $x=-1$.",
          "worked": "$a=2x$, $r=x$.\n$$\\begin{align*}a_n&=ar^{n-1}\\\\a_n&=2x\\times x^{n-1}\\\\a_n&=2x^n\\end{align*}$$\nIf $a_6=2$:\n$$\\begin{align*}2x^6&=2\\\\x^6&=1\\\\x&=1\\text{ or }-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p12-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Find a formula for $a_n$ in $x^4,\\,x^2,\\,1,\\ldots$ Then find $x$ if $a_6=3^6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=x^{6-2n}$; $x=\\frac13$ or $x=-\\frac13$.",
          "worked": "$a=x^4$, $r=\\frac{1}{x^2}$.\n$$\\begin{align*}a_n&=ar^{n-1}\\\\a_n&=x^4\\times\\left(\\frac{1}{x^2}\\right)^{n-1}\\\\a_n&=x^{6-2n}\\end{align*}$$\nIf $a_6=3^6$:\n$$\\begin{align*}x^{6-12}&=3^6\\\\x^{-6}&=3^6\\\\\\frac{1}{x^6}&=729\\\\x^6&=\\frac{1}{729}\\\\x&=\\frac13\\text{ or }-\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p12-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "Find a formula for $a_n$ in $2^{-16}x,\\,2^{-12}x,\\,2^{-8}x,\\ldots$ Then find $x$ if $a_6=96$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=2^{4n-20}x$; $x=6$.",
          "worked": "$a=2^{-16}x$, $r=2^4$.\n$$\\begin{align*}a_n&=ar^{n-1}\\\\a_n&=2^{-16}x\\times(2^4)^{n-1}\\\\a_n&=2^{-16}x\\times2^{4n-4}\\\\a_n&=2^{4n-20}x\\end{align*}$$\nIf $a_6=96$:\n$$\\begin{align*}2^{24-20}x&=96\\\\2^4x&=96\\\\16x&=96\\\\x&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
