  "content": {
    "id": "p27-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Find $\\frac{a}{c}$ and $\\frac{a-b}{b-c}$ if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q15-a",
        "type": "group",
        "label": "a",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p27-q15-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$a=4$, $b=2$ and $c=\\frac{4}{3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{a}{c}=3$, $\\frac{a-b}{b-c}=3$.",
              "worked": "$$\\begin{align*}\\frac{a}{c}&=4\\div\\frac{4}{3}\\\\\\frac{a}{c}&=4\\times\\frac{3}{4}\\\\\\frac{a}{c}&=3\\\\\\frac{a-b}{b-c}&=\\frac{4-2}{2-\\frac{4}{3}}\\\\\\frac{a-b}{b-c}&=2\\div\\frac{2}{3}\\\\\\frac{a-b}{b-c}&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 64
          },
          {
            "id": "p27-q15-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$a=\\frac{3}{4}$, $b=\\frac{3}{5}$ and $c=\\frac{1}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{a}{c}=\\frac{3}{2}$, $\\frac{a-b}{b-c}=\\frac{3}{2}$.",
              "worked": "$$\\begin{align*}\\frac{a}{c}&=\\frac{3}{4}\\div\\frac{1}{2}\\\\\\frac{a}{c}&=\\frac{3}{4}\\times2\\\\\\frac{a}{c}&=\\frac{3}{2}\\\\\\frac{a-b}{b-c}&=\\frac{\\frac{3}{4}-\\frac{3}{5}}{\\frac{3}{5}-\\frac{1}{2}}\\\\\\frac{a-b}{b-c}&=\\frac{3}{20}\\div\\frac{1}{10}\\\\\\frac{a-b}{b-c}&=\\frac{3}{20}\\times10\\\\\\frac{a-b}{b-c}&=\\frac{3}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 76
          },
          {
            "id": "p27-q15-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$a=3$, $b=\\frac{3}{2}$ and $c=1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{a}{c}=3$, $\\frac{a-b}{b-c}=3$.",
              "worked": "$$\\begin{align*}\\frac{a}{c}&=\\frac{3}{1}\\\\\\frac{a}{c}&=3\\\\\\frac{a-b}{b-c}&=\\frac{3-\\frac{3}{2}}{\\frac{3}{2}-1}\\\\\\frac{a-b}{b-c}&=\\frac{3}{2}\\div\\frac{1}{2}\\\\\\frac{a-b}{b-c}&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          }
        ]
      },
      {
        "id": "p27-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "In each of the above, show that $\\frac{1}{c}-\\frac{1}{b}=\\frac{1}{b}-\\frac{1}{a}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "In i, both sides equal $\\frac{1}{4}$; in ii, both sides equal $\\frac{1}{3}$; in iii, both sides equal $\\frac{1}{3}$.",
          "worked": "For i:\n$$\\begin{align*}\\frac{1}{c}-\\frac{1}{b}&=\\frac{3}{4}-\\frac{1}{2}=\\frac{1}{4}\\\\\\frac{1}{b}-\\frac{1}{a}&=\\frac{1}{2}-\\frac{1}{4}=\\frac{1}{4}\\end{align*}$$\nFor ii:\n$$\\begin{align*}\\frac{1}{c}-\\frac{1}{b}&=2-\\frac{5}{3}=\\frac{1}{3}\\\\\\frac{1}{b}-\\frac{1}{a}&=\\frac{5}{3}-\\frac{4}{3}=\\frac{1}{3}\\end{align*}$$\nFor iii:\n$$\\begin{align*}\\frac{1}{c}-\\frac{1}{b}&=1-\\frac{2}{3}=\\frac{1}{3}\\\\\\frac{1}{b}-\\frac{1}{a}&=\\frac{2}{3}-\\frac{1}{3}=\\frac{1}{3}\\end{align*}$$\nThe two sides are equal in each case.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 92
      }
    ]
  },
