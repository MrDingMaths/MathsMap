  "content": {
    "id": "p38-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify fully.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q7a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sqrt{40}}{\\sqrt{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{40}}{\\sqrt{10}}&=\\sqrt{4}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p38-q7b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sqrt{18}}{\\sqrt{50}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{5}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{18}}{\\sqrt{50}}&=\\frac{3\\sqrt{2}}{5\\sqrt{2}}\\\\&=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p38-q7c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2\\sqrt{6}\\times\\sqrt{5}}{\\sqrt{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{6}\\times\\sqrt{5}}{\\sqrt{10}}&=\\frac{2\\sqrt{30}}{\\sqrt{10}}\\\\&=2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p38-q7d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{5\\sqrt{7}\\times\\sqrt{3}}{\\sqrt{28}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\sqrt{3}}{2}$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt{7}\\times\\sqrt{3}}{\\sqrt{28}}&=\\frac{5\\sqrt{7}\\times\\sqrt{3}}{2\\sqrt{7}}\\\\&=\\frac{5\\sqrt{3}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p38-q7e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\sqrt{15}\\times\\sqrt{20}}{\\sqrt{12}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{15}\\times\\sqrt{20}}{\\sqrt{12}}&=\\sqrt{\\frac{15\\times20}{12}}\\\\&=\\sqrt{25}\\\\&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p38-q7f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{6\\sqrt{3}\\times8\\sqrt{2}}{\\sqrt{32}\\times\\sqrt{27}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$. Simplify the denominator to $12\\sqrt{6}$.",
          "worked": "$$\\begin{align*}\\frac{6\\sqrt{3}\\times8\\sqrt{2}}{\\sqrt{32}\\times\\sqrt{27}}&=\\frac{48\\sqrt{6}}{4\\sqrt{2}\\times3\\sqrt{3}}\\\\&=\\frac{48\\sqrt{6}}{12\\sqrt{6}}\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
