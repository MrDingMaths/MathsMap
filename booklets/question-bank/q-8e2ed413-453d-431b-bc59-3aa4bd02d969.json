          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Another form of a line is the ",
              "marks": []
            },
            {
              "type": "text",
              "text": "two-point form",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": " that states the equation of a line that passes through any two points ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "(x_1,y_1)",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "(x_2,y_2)",
              "display": false
            },
            {
              "type": "text",
              "text": ". We will derive it in this section.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the expression for the gradient between the two points $(x_1,y_1)$ and $(x_2,y_2)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\dfrac{y_2-y_1}{x_2-x_1}$",
          "worked": "$$m=\\frac{y_2-y_1}{x_2-x_1}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q10-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p17-q10-b-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Use the formula ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y-y_1=m(x-x_1)",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and the expression in part ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "a",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": " to show that the two-point form of a line is ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\dfrac{y-y_1}{x-x_1}=\\dfrac{y_2-y_1}{x_2-x_1}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y-y_1=\\dfrac{y_2-y_1}{x_2-x_1}(x-x_1)$; divide by $x-x_1$ to obtain $\\dfrac{y-y_1}{x-x_1}=\\dfrac{y_2-y_1}{x_2-x_1}$.",
          "worked": "$$\\begin{align*}y-y_1&=\\frac{y_2-y_1}{x_2-x_1}(x-x_1)\\\\\\frac{y-y_1}{x-x_1}&=\\frac{y_2-y_1}{x_2-x_1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the two-point form to find the equation of a line passing through $(7,3)$ and $(10,6)$. Answer in gradient-intercept form. Check your answer using DESMOS.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-4$",
          "worked": "$$\\begin{align*}\\frac{y-3}{x-7}&=\\frac{6-3}{10-7}\\\\\\frac{y-3}{x-7}&=1\\\\y-3&=x-7\\\\y&=x-4\\end{align*}$$\nIn DESMOS, plot $y=x-4$, $(7,3)$ and $(10,6)$. Both points lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p17-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of a line passing through $(-1,10)$ and $(10,-17.5)$. Answer in gradient-intercept form. Check your answer using DESMOS.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2.5x+7.5$",
          "worked": "$$\\begin{align*}\\frac{y-10}{x+1}&=\\frac{-17.5-10}{10+1}\\\\\\frac{y-10}{x+1}&=-2.5\\\\y-10&=-2.5(x+1)\\\\y-10&=-2.5x-2.5\\\\y&=-2.5x+7.5\\end{align*}$$\nIn DESMOS, plot $y=-2.5x+7.5$, $(-1,10)$ and $(10,-17.5)$. Both points lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
