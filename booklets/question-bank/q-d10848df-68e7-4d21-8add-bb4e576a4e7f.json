  "content": {
    "id": "v2-41749f-p5-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify these expressions. Absolute value may be needed.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-41749f-p5-practice-slot-1-lower-s1l-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left((-7)^2\\right)^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\left((-7)^2\\right)^{\\frac12}&=\\sqrt{49}\\\\&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "v2-41749f-p5-practice-slot-1-lower-s1l-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left((-2)^6\\right)^{\\frac16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\left((-2)^6\\right)^{\\frac16}&=64^{\\frac16}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "v2-41749f-p5-practice-slot-1-lower-s1l-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(y^4\\right)^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^2$",
          "worked": "$$\\begin{align*}\\left(y^4\\right)^{\\frac12}&=\\sqrt{\\left(y^2\\right)^2}\\\\&=y^2\\end{align*}$$\nSince $y^2\\geq0$, no absolute value is needed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "v2-41749f-p5-practice-slot-1-lower-s1l-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(k^6\\right)^{\\frac16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|k|$",
          "worked": "$$\\begin{align*}\\left(k^6\\right)^{\\frac16}&=\\sqrt[6]{k^6}\\\\&=|k|\\end{align*}$$\nAn even root is non-negative, so the answer is $|k|$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
