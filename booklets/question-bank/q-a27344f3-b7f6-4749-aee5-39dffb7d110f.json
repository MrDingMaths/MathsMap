  "content": {
    "id": "p14-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Find the least natural number $n$ for which $24n$ is a perfect cube.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=9$.\n\nMultiply by $3^2$ so that every prime exponent is a multiple of $3$.",
      "worked": "$$\\begin{align*}24&=2^3\\times3\\\\24n&=2^3\\times3\\times n\\end{align*}$$\nEvery prime exponent in a perfect cube is a multiple of $3$. The exponent of $2$ is already $3$; the exponent of $3$ needs two more factors of $3$. Thus the least multiplier is\n$$\\begin{align*}n&=3^2\\\\n&=9\\end{align*}$$\nCheck: $24\\times9=216=6^3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
