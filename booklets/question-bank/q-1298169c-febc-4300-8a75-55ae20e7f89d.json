  "content": {
    "id": "p5-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Use the Pythagorean identity to rewrite these expressions in terms of $\\sin^2 x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\sin^2 x-2\\cos^2 x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sin^2 x$",
          "worked": "$$\\begin{aligned}2\\sin^2 x-2\\cos^2 x+2&=2\\sin^2 x-2(1-\\sin^2 x)+2\\\\&=2\\sin^2 x-2+2\\sin^2 x+2\\\\&=4\\sin^2 x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$5-5\\cos^2 x+\\sin^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\sin^2 x$",
          "worked": "$$\\begin{aligned}5-5\\cos^2 x+\\sin^2 x&=5-5(1-\\sin^2 x)+\\sin^2 x\\\\&=6\\sin^2 x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sin^2 x+1-\\cos^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sin^2 x$",
          "worked": "$$\\begin{aligned}2\\sin^2 x+1-\\cos^2 x&=2\\sin^2 x+1-(1-\\sin^2 x)\\\\&=3\\sin^2 x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
