  "content": {
    "id": "p30-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The number of students at a school increased by $12\\%$ from 2010 to 2011. In 2011, there are 1680 students. How many students were there in 2010?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "1500 students",
      "worked": "The 2011 population represents $100\\%+12\\%=112\\%$ of the 2010 population.\n\n$$\\begin{align*}1\\%\\text{ of the 2010 population}&=1680\\div112\\\\1\\%\\text{ of the 2010 population}&=15\\\\\\text{2010 population}&=15\\times100\\\\\\text{2010 population}&=1500\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
