    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the set $\\{1,2,\\ldots,18\\}$ can also be partitioned into square-sum pairs.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,15), (2,14), (3,13), (4,12), (5,11), (6,10), (7,18), (8,17), (9,16)$.\n\nThe first six pairs sum to $16$ and the last three to $25$.",
          "worked": "$$\\begin{align*}1+15&=16\\\\2+14&=16\\\\3+13&=16\\\\4+12&=16\\\\5+11&=16\\\\6+10&=16\\\\7+18&=25\\\\8+17&=25\\\\9+16&=25.\\end{align*}$$\nEvery integer from $1$ to $18$ appears exactly once, and every pair sums to a perfect square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 92
      },
      {
        "id": "p5-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the set $\\{1,2,\\ldots,20\\}$ cannot be partitioned into square-sum pairs.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No partition exists.\n\n$20$ must pair with $16$, and $18$ must pair with $7$. The only possible partners for $9$ are $7$ and $16$, both already used.",
          "worked": "Suppose a square-sum partition exists. The only square obtainable by adding $20$ to another member is $36$, so $20$ must pair with $16$. Similarly, $18$ must pair with $7$ to total $25$.\n\nFor $9$, the only possible square sums with another member are $16$ and $25$, requiring partners $7$ and $16$, respectively. Both are already used. This contradiction proves that no square-sum partition exists.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
