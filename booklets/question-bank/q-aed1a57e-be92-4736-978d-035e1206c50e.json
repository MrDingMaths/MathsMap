              "latex": "\\begin{gathered}1+8=9\\\\2+7=9\\\\3+6=9\\\\4+5=9\\\\9+16=25\\\\10+15=25\\\\11+14=25\\\\12+13=25,\\end{gathered}",
              "display": true
            }
          ]
