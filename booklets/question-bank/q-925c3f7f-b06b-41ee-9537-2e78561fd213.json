    "type": "question",
    "label": "8",
    "prompt": "Given that $A=\\dfrac{PRT}{100}$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$A$ when $P=200$, $R=4$ and $T=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=48$",
          "worked": "$$\\begin{align*}A&=\\frac{200\\times4\\times6}{100}\\\\A&=\\frac{4800}{100}\\\\A&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p5-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$P$ when $A=1200$, $R=3$ and $T=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=4000$",
          "worked": "$$\\begin{align*}1200&=\\frac{P\\times3\\times10}{100}\\\\1200&=\\frac{30P}{100}\\\\120000&=30P\\\\P&=4000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$T$ when $A=14\\,000$, $P=12\\,000$ and $R=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$T=23\\frac{1}{3}$",
          "worked": "$$\\begin{align*}14000&=\\frac{12000\\times5\\times T}{100}\\\\14000&=600T\\\\T&=\\frac{14000}{600}\\\\T&=\\frac{70}{3}\\\\T&=23\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
