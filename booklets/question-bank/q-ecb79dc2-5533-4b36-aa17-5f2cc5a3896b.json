  "content": {
    "id": "p52-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The line $2y-x=12$ intersects the circle $x^2+y^2-10x-12y+36=0$ at the points $A$ and $B$.\n\nA sketch is given, it would be useful to add to it as you go through parts a to d.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p52-q11-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"circleRed\",\"hex\":\"EF6068\",\"reason\":\"distinguishes the circle from the line\"},{\"name\":\"lineBlue\",\"hex\":\"268CFF\",\"reason\":\"distinguishes the line from the circle\"}],\"reference\":\"page 52 p52-q11-diagram\"}\n\\begin{tikzpicture}[x=0.18cm,y=0.18cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{circleRed}{HTML}{EF6068}\n\\definecolor{lineBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-6.5,-6.5) rectangle (17,17);\n\\draw[<->,black,line width=0.5pt] (-6,0)--(16,0) node[right] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-6)--(0,16) node[above] {$y$};\n\\draw[circleRed,line width=0.8pt] (5,6) circle[radius=5];\n\\draw[<->,lineBlue,line width=0.8pt] (-6,3)--(16,14);\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 52,
          "sourceRegion": "Upper-right shared sketch beside part a",
          "description": "Shared unlabelled line–circle sketch with double-ended Cartesian axes, positive-end axis labels, no numerical ticks and no grid. The circle touches the y-axis and the ascending line crosses it twice.",
          "mathematics": "Circle (x-5)^2+(y-6)^2=25; line y=x/2+6. Plotting bounds are illustrative because the source supplies no axis ranges.",
          "answerVisibility": "Permanent supplied reference sketch; derived point labels, the perpendicular bisector and kite are omitted from the question figure."
        },
