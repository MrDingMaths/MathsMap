  "content": {
    "id": "p33-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Overnight temperatures at Thredbo in June had mean $6.8^\\circ\\mathrm{C}$ and standard deviation $1.1^\\circ\\mathrm{C}$. Assume the temperatures are approximately normally distributed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Within what range do almost all temperatures lie (3 standard deviations)?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.5^\\circ\\mathrm{C}$ to $10.1^\\circ\\mathrm{C}$.",
          "worked": "$$\\begin{aligned}\\mu-3\\sigma&=6.8-3(1.1)=3.5\\\\\\mu+3\\sigma&=6.8+3(1.1)=10.1\\end{aligned}$$\nAlmost all temperatures lie from $3.5^\\circ\\mathrm{C}$ to $10.1^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p33-q14-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the $z$-score for each temperature. Round to 1 decimal place where necessary.",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p33-q14-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$6.8^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0$",
              "worked": "$$\\begin{aligned}z&=\\frac{6.8-6.8}{1.1}\\\\z&=0\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p33-q14-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$7.9^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{aligned}z&=\\frac{7.9-6.8}{1.1}\\\\z&=1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p33-q14-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$9^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$$\\begin{aligned}z&=\\frac{9-6.8}{1.1}\\\\z&=2\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p33-q14-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$10.1^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "$$\\begin{aligned}z&=\\frac{10.1-6.8}{1.1}\\\\z&=3\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p33-q14-b-v",
            "type": "part",
            "label": "v",
            "prompt": "$5.7^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1$",
              "worked": "$$\\begin{aligned}z&=\\frac{5.7-6.8}{1.1}\\\\z&=-1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p33-q14-b-vi",
            "type": "part",
            "label": "vi",
            "prompt": "$4.6^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2$",
              "worked": "$$\\begin{aligned}z&=\\frac{4.6-6.8}{1.1}\\\\z&=-2\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p33-q14-b-vii",
            "type": "part",
            "label": "vii",
            "prompt": "$3.5^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-3$",
              "worked": "$$\\begin{aligned}z&=\\frac{3.5-6.8}{1.1}\\\\z&=-3\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p33-q14-b-viii",
            "type": "part",
            "label": "viii",
            "prompt": "$6^\\circ\\mathrm{C}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-0.7$",
              "worked": "$$\\begin{aligned}z&=\\frac{6-6.8}{1.1}\\\\z&=-\\frac{8}{11}\\\\z&\\approx-0.7\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      }
    ]
  },
