  "content": {
    "id": "p41-q12-root",
    "type": "question",
    "label": null,
    "prompt": "Find the general solutions of these separable equations. Make $y$ the subject in each case.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{dy}{dx}=xe^{-y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln\\left(\\dfrac{x^2}{2}+C\\right)$",
          "worked": "$$\\begin{align*}e^y\\,dy&=x\\,dx\\\\\\int e^y\\,dy&=\\int x\\,dx\\\\e^y&=\\frac{x^2}{2}+C\\\\y&=\\ln\\left(\\frac{x^2}{2}+C\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p41-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{dy}{dx}=4x^3(1+y^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\tan(x^4+C)$",
          "worked": "$$\\begin{align*}\\frac{1}{1+y^2}\\,dy&=4x^3\\,dx\\\\\\int\\frac{1}{1+y^2}\\,dy&=\\int4x^3\\,dx\\\\\\arctan y&=x^4+C\\\\y&=\\tan(x^4+C)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
