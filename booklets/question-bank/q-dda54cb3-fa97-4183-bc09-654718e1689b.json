  "content": {
    "id": "p36-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Given $\\underset{\\sim}{a}=\\begin{pmatrix}5\\\\-12\\end{pmatrix}$ and $\\underset{\\sim}{b}=\\begin{pmatrix}-15\\\\-8\\end{pmatrix}$, show that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q10-a-node",
        "type": "part",
        "label": "a",
        "prompt": "$\\left|2\\underset{\\sim}{a}\\right|=2\\left|\\underset{\\sim}{a}\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left|2\\underset{\\sim}{a}\\right|=26=2\\left|\\underset{\\sim}{a}\\right|$.",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}&=\\begin{pmatrix}5\\\\-12\\end{pmatrix}\\\\ 2\\underset{\\sim}{a}&=\\begin{pmatrix}10\\\\-24\\end{pmatrix}\\\\ \\left|2\\underset{\\sim}{a}\\right|&=\\sqrt{10^2+(-24)^2}\\\\ &=26\\\\ \\left|\\underset{\\sim}{a}\\right|&=\\sqrt{5^2+(-12)^2}\\\\ &=13\\end{aligned}$$\n$$\\begin{aligned}\\text{LHS: }\\left|2\\underset{\\sim}{a}\\right|&=26\\\\ \\text{RHS: }2\\left|\\underset{\\sim}{a}\\right|&=2(13)=26\\end{aligned}$$\nHence, LHS $=$ RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p36-q10-b-node",
        "type": "part",
        "label": "b",
        "prompt": "$\\left|-\\underset{\\sim}{b}\\right|=\\left|\\underset{\\sim}{b}\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left|-\\underset{\\sim}{b}\\right|=17=\\left|\\underset{\\sim}{b}\\right|$.",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{b}&=\\begin{pmatrix}-15\\\\-8\\end{pmatrix}\\\\ -\\underset{\\sim}{b}&=\\begin{pmatrix}15\\\\8\\end{pmatrix}\\\\ \\left|-\\underset{\\sim}{b}\\right|&=\\sqrt{15^2+8^2}\\\\ &=17\\\\ \\left|\\underset{\\sim}{b}\\right|&=\\sqrt{(-15)^2+(-8)^2}\\\\ &=17\\end{aligned}$$\n$$\\begin{aligned}\\text{LHS: }\\left|-\\underset{\\sim}{b}\\right|&=17\\\\ \\text{RHS: }\\left|\\underset{\\sim}{b}\\right|&=17\\end{aligned}$$\nHence, LHS $=$ RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p36-q10-c-node",
        "type": "part",
        "label": "c",
        "prompt": "$\\left|\\underset{\\sim}{a}+\\underset{\\sim}{b}\\right|<\\left|\\underset{\\sim}{a}\\right|+\\left|\\underset{\\sim}{b}\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left|\\underset{\\sim}{a}+\\underset{\\sim}{b}\\right|=10\\sqrt5<30=\\left|\\underset{\\sim}{a}\\right|+\\left|\\underset{\\sim}{b}\\right|$.",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}+\\underset{\\sim}{b}&=\\begin{pmatrix}5+(-15)\\\\-12+(-8)\\end{pmatrix}\\\\ &=\\begin{pmatrix}-10\\\\-20\\end{pmatrix}\\\\ \\left|\\underset{\\sim}{a}+\\underset{\\sim}{b}\\right|&=\\sqrt{(-10)^2+(-20)^2}\\\\ &=10\\sqrt5\\\\ \\left|\\underset{\\sim}{a}\\right|&=\\sqrt{5^2+(-12)^2}\\\\ &=13\\\\ \\left|\\underset{\\sim}{b}\\right|&=\\sqrt{(-15)^2+(-8)^2}\\\\ &=17\\end{aligned}$$\n$$\\begin{aligned}\\text{LHS: }\\left|\\underset{\\sim}{a}+\\underset{\\sim}{b}\\right|&=10\\sqrt5\\approx22.36\\\\ \\text{RHS: }\\left|\\underset{\\sim}{a}\\right|+\\left|\\underset{\\sim}{b}\\right|&=13+17=30\\end{aligned}$$\nHence, LHS $<$ RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p36-q10-d-node",
        "type": "part",
        "label": "d",
        "prompt": "$\\left|\\underset{\\sim}{a}+\\underset{\\sim}{b}\\right|>\\left|\\left|\\underset{\\sim}{a}\\right|-\\left|\\underset{\\sim}{b}\\right|\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left|\\underset{\\sim}{a}+\\underset{\\sim}{b}\\right|=10\\sqrt5>4=\\left|\\left|\\underset{\\sim}{a}\\right|-\\left|\\underset{\\sim}{b}\\right|\\right|$.",
          "worked": "Using the magnitudes calculated in part c:\n$$\\begin{aligned}\\text{LHS: }\\left|\\underset{\\sim}{a}+\\underset{\\sim}{b}\\right|&=10\\sqrt5\\approx22.36\\\\ \\text{RHS: }\\left|\\left|\\underset{\\sim}{a}\\right|-\\left|\\underset{\\sim}{b}\\right|\\right|&=|13-17|=4\\end{aligned}$$\nHence, LHS $>$ RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
