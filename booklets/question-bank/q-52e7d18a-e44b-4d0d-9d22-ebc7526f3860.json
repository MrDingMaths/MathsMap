  "content": {
    "id": "p6-q27-response",
    "type": "question",
    "label": "",
    "prompt": "An observer is on level ground $48\\text{ m}$ away from the base of the famous bell tower Big Ben. The angle of elevation $\\theta$ from their position to the top of the tower satisfies $\\tan\\theta=2$. How tall is Big Ben?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$96\\text{ m}$",
      "worked": "Let $h$ metres be the height of the tower.\n$$\\begin{align*}\\tan\\theta&=\\frac{h}{48}\\\\h&=48\\times2\\\\h&=96\\end{align*}$$\nThe tower is $96\\text{ m}$ tall.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
