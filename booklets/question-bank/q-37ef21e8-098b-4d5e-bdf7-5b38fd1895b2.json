  "content": {
    "id": "p14-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "The average percentage, by weight, of body fat is $17\\%$ for men and $23\\%$ for women. Calculate the amount of fat, in kilograms, for:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "a woman weighing $76\\text{ kg}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17.48\\text{ kg}$",
          "worked": "$$\\begin{align*}\\text{Mass of fat}&=\\frac{23}{100}\\times76\\text{ kg}\\\\\\text{Mass of fat}&=17.48\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
