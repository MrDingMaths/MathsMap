  "content": {
    "id": "p2-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Line segment $PQ$ has length 10. It is parallel to the $x$-axis and intersects the graph of $y=x^2$ at $P$ and $Q$. Find the coordinates of $P$ and $Q$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(-5,25)$ and $(5,25)$",
      "worked": "The parabola is symmetric about the $y$-axis, which bisects the horizontal chord $PQ$. Each endpoint is 5 units from the $y$-axis, so their $x$-coordinates are $-5$ and $5$.\n\n$$\\begin{align*}y&=5^2\\\\y&=25.\\end{align*}$$\n\nThe coordinates are $(-5,25)$ and $(5,25)$, in either order.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
