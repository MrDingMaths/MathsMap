  "content": {
    "id": "p70-q73-root",
    "type": "question",
    "label": "73",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p70-q73-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the Cartesian equation of the curve defined by the parametric equations $(2p,p^2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{x^2}{4}$.",
          "worked": "$x=2p$ and $y=p^2$.\n$$\\begin{align*}p&=\\frac{x}{2}\\\\y&=\\left(\\frac{x}{2}\\right)^2\\\\y&=\\frac{x^2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p70-q73-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coordinate of the midpoint $M$ of $(2p,p^2)$ and $(2q,q^2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M=\\left(p+q,\\frac{p^2+q^2}{2}\\right)$.",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{2p+2q}{2},\\frac{p^2+q^2}{2}\\right)\\\\M&=\\left(p+q,\\frac{p^2+q^2}{2}\\right).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p70-q73-c",
        "type": "part",
        "label": "c",
        "prompt": "If $pq=-1$, find the coordinates of $M$ in terms of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M=\\left(p-\\frac1p,\\frac12\\left(p^2+\\frac1{p^2}\\right)\\right)$, where $p\\ne0$.",
          "worked": "$pq=-1$ gives $q=-\\frac{1}{p}$, with $p\\ne0$. Substituting into (b),\n$$M=\\left(p-\\frac1p,\\frac12\\left(p^2+\\frac1{p^2}\\right)\\right).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p70-q73-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence, find the Cartesian equation of the curve defined by $M$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{x^2}{2}+1$, where $x\\in\\mathbb R$.",
          "worked": "Using the coordinates from (c),\n$$\\begin{align*}x^2&=\\left(p-\\frac1p\\right)^2\\\\x^2&=p^2+\\frac1{p^2}-2\\\\x^2&=2y-2\\\\y&=\\frac{x^2}{2}+1.\\end{align*}$$\nEvery real $x$ is attained: $p^2-xp-1=0$ has real, nonzero roots since its discriminant is $x^2+4>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
