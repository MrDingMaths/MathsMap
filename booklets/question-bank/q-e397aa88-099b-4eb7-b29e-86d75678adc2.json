  "content": {
    "id": "p10-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "An amount is decreased by 10% and then the result is decreased by 60%.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find a single decrease that would give the same overall result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "64% decrease.\n\nThe combined multiplier is $0.9\\times0.4=0.36$.",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=0.9\\times0.4\\\\\\text{Combined multiplier}&=0.36\\\\\\text{Percentage decrease}&=(1-0.36)\\times100\\%\\\\\\text{Percentage decrease}&=64\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find two equal consecutive decreases that would give the same overall result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two decreases of 40% each.\n\nEach multiplier is $0.6$, since $0.6\\times0.6=0.36$.",
          "worked": "Let $m$ be the multiplier for each decrease.\n\n$$\\begin{align*}m^2&=0.9\\times0.4\\\\m^2&=0.36\\\\m&=0.6\\\\\\text{Each percentage decrease}&=(1-0.6)\\times100\\%\\\\\\text{Each percentage decrease}&=40\\%\\end{align*}$$\n\nCheck: $0.6\\times0.6=0.36$, so the two decreases give the same overall result.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
