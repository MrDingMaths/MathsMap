  "content": {
    "id": "p41-q21",
    "type": "question",
    "label": "21",
    "prompt": "A fair six-sided die is rolled. What is the probability of not rolling a factor of 6?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{3}$",
      "worked": "The factors of 6 on the die are 1, 2, 3 and 6.\n$$\\begin{align*}P(\\text{not a factor of }6)&=1-P(\\text{factor of }6)\\\\P(\\text{not a factor of }6)&=1-\\frac{4}{6}\\\\P(\\text{not a factor of }6)&=\\frac{1}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 27
