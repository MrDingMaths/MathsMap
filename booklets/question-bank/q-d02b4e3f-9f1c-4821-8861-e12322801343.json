          "inlines": [
            {
              "type": "text",
              "text": "“When two coins are tossed together, there are three events: two heads, two tails and one of each. Hence the probability of getting one of each is ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{1}{3}",
              "display": false
            },
            {
              "type": "text",
              "text": "”",
              "marks": []
