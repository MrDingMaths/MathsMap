    "id": "p4-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The power used by a furnace, $P$ watts, is related to the resistance of the wiring, $R$ ohms, and the current, $I$ amps, according to the formula $P=RI^2$. Find the power used by a furnace with wire resistance of $2.5\\times10^{-1}$ ohms that draws a current of $6.2\\times10^3$ amps.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9.61\\times10^6$ watts.",
      "worked": "$$\\begin{align*}P&=(2.5\\times10^{-1})(6.2\\times10^3)^2\\\\P&=(2.5\\times10^{-1})(38.44\\times10^6)\\\\P&=96.1\\times10^5\\\\P&=9.61\\times10^6\\text{ W}\\end{align*}$$",
      "solutionDiagrams": []
    },
