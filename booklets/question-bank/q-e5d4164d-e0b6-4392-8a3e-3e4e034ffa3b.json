  "content": {
    "id": "p12-q10-answer",
    "type": "question",
    "label": "10",
    "prompt": "A city has a population of 3 500 000. How many digits should its telephone numbers have so that every person can have one?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "7 digits",
      "worked": "With $n$ digits, there are $10^n$ possible telephone numbers. We need $10^n\\geq3\\,500\\,000$.\n\n$$\\begin{aligned}10^6&=1\\,000\\,000<3\\,500\\,000\\\\10^7&=10\\,000\\,000\\geq3\\,500\\,000\\end{aligned}$$\n\nThe minimum is 7 digits.",
      "solutionDiagrams": []
    },
