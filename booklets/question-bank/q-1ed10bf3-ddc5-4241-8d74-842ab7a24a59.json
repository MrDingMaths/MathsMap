  "content": {
    "id": "p41-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The ages of a group of people attending a musical were as follows:\n\n14, 23, 25, 26, 26, 27, 27, 27, 28, 28, 29, 29, 30, 31, 31, 32, 34, 36, 37, 40, 40, 40, 42, 52, 76",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the lower and upper quartiles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q_1=27$, $Q_3=38.5$.",
          "worked": "Exclude the median, $30$, leaving $12$ values in each half.\n\n$\\begin{aligned}Q_1&=\\frac{27+27}{2}=27\\\\Q_3&=\\frac{37+40}{2}=38.5\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p41-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the IQR?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11.5$ years.",
          "worked": "$\\text{IQR}=Q_3-Q_1=38.5-27=11.5$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p41-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Identify any outliers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The only outlier is $76$ years. The fences are $9.75$ and $55.75$ years.",
          "worked": "$\\begin{aligned}\\text{Lower fence}&=27-1.5\\times11.5=9.75\\\\\\text{Upper fence}&=38.5+1.5\\times11.5=55.75\\end{aligned}$\n\nSince $76>55.75$ and all other ages lie between the fences, the only outlier is $76$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
