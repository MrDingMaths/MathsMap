  "content": {
    "id": "p16-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Amy buys 4 tickets in a raffle in which 50 tickets are sold. The tickets are drawn without replacement for first and second prizes. What is the probability that Amy wins",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "first prize?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{25}$",
          "worked": "$$\\begin{align*}P(\\text{Amy wins first prize})&=\\frac{4}{50}\\\\P(\\text{Amy wins first prize})&=\\frac{2}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "second prize, given that she wins first prize?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{49}$",
          "worked": "The first draw removes one of Amy’s tickets, so she has 3 of the 49 tickets left.\n\n$$P(\\text{Amy wins second prize}\\mid\\text{Amy wins first prize})=\\frac{3}{49}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p16-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "second prize, given that she does not win first prize?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{49}$",
          "worked": "The first draw removes someone else’s ticket, so Amy still has 4 of the 49 tickets left.\n\n$$P(\\text{Amy wins second prize}\\mid\\text{Amy misses first prize})=\\frac{4}{49}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
  },
