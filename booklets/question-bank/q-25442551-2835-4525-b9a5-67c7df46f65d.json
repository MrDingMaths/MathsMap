  "content": {
    "id": "p14-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A parabola has equation $y=gx^2-gx+1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the discriminant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=g^2-4g$.",
          "worked": "$$\\begin{align*}\\Delta&=(-g)^2-4(g)(1)\\\\\\Delta&=g^2-4g\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the values of $g$ which make $\\Delta=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g=0$ or $g=4$.",
          "worked": "$$\\begin{align*}g^2-4g&=0\\\\g(g-4)&=0\\end{align*}$$\nBy the null factor law, $g=0$ or $g=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why the lesser value of $g$ is not valid in this case.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g=0$ gives $y=1$, which is not a parabola.",
          "worked": "When $g=0$, $y=0x^2-0x+1=1$. The quadratic term vanishes, so the graph is a horizontal line rather than a parabola.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Write down the equation of the parabola that has a double zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4x^2-4x+1$.",
          "worked": "The valid value is $g=4$, giving $y=4x^2-4x+1=(2x-1)^2$. Hence the parabola has a double zero at $x=\\tfrac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
