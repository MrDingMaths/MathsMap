        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x}{2}+\\frac{x+1}{3}-\\frac{x}{4}=5$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8$",
          "worked": "$$\\begin{align*}\\frac{6x}{12}+\\frac{4(x+1)}{12}-\\frac{3x}{12}&=5\\\\\\frac{6x+4x+4-3x}{12}&=5\\\\\\frac{7x+4}{12}&=5\\\\7x+4&=60\\\\7x&=56\\\\x&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-d10a7b-p8-practice-slot-6-slot-6-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{2x}{3}-\\frac{x-1}{2}+\\frac{x}{6}=4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{21}{2}$",
          "worked": "$$\\begin{align*}\\frac{4x}{6}-\\frac{3(x-1)}{6}+\\frac{x}{6}&=4\\\\\\frac{4x-3x+3+x}{6}&=4\\\\\\frac{2x+3}{6}&=4\\\\2x+3&=24\\\\2x&=21\\\\x&=\\frac{21}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
