  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "For the formula $s=ut+\\dfrac{1}{2}at^2$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "the value of $s$, when $u=4$, $t=3$ and $a=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=39$",
          "worked": "$$\\begin{align*}s&=4\\times3+\\frac12\\times6\\times3^2\\\\s&=12+3\\times9\\\\s&=12+27\\\\s&=39\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "the value of $u$, when $s=100$, $t=5$ and $a=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=10$",
          "worked": "$$\\begin{align*}100&=5u+\\frac12\\times4\\times5^2\\\\100&=5u+50\\\\50&=5u\\\\u&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "the value of $a$, when $s=200$, $t=10$ and $u=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2\\dfrac45$",
          "worked": "$$\\begin{align*}200&=6\\times10+\\frac12\\times a\\times10^2\\\\200&=60+50a\\\\140&=50a\\\\a&=\\frac{14}{5}\\\\a&=2\\frac45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
