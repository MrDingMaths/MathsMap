  "content": {
    "id": "p20-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\frac12}{\\frac34}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac12}{\\frac34}&=\\frac12\\times\\frac43\\\\\\dfrac{\\frac12}{\\frac34}&=\\frac{1\\times2}{1\\times3}\\\\\\dfrac{\\frac12}{\\frac34}&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\frac34}{\\frac38}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac34}{\\frac38}&=\\frac34\\times\\frac83\\\\\\dfrac{\\frac34}{\\frac38}&=\\frac{1\\times2}{1\\times1}\\\\\\dfrac{\\frac34}{\\frac38}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\frac23}{\\frac56}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac45$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac23}{\\frac56}&=\\frac23\\times\\frac65\\\\\\dfrac{\\frac23}{\\frac56}&=\\frac{2\\times2}{1\\times5}\\\\\\dfrac{\\frac23}{\\frac56}&=\\frac45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\frac56}{\\frac34}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}9$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac56}{\\frac34}&=\\frac56\\times\\frac43\\\\\\dfrac{\\frac56}{\\frac34}&=\\frac{5\\times2}{3\\times3}\\\\\\dfrac{\\frac56}{\\frac34}&=\\frac{10}9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\frac56}{\\frac58}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac43$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac56}{\\frac58}&=\\frac56\\times\\frac85\\\\\\dfrac{\\frac56}{\\frac58}&=\\frac{1\\times4}{3\\times1}\\\\\\dfrac{\\frac56}{\\frac58}&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\frac79}{\\frac23}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac76$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac79}{\\frac23}&=\\frac79\\times\\frac32\\\\\\dfrac{\\frac79}{\\frac23}&=\\frac{7\\times1}{3\\times2}\\\\\\dfrac{\\frac79}{\\frac23}&=\\frac76\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\frac7{12}}{\\frac5{18}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{10}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac7{12}}{\\frac5{18}}&=\\frac7{12}\\times\\frac{18}5\\\\\\dfrac{\\frac7{12}}{\\frac5{18}}&=\\frac{7\\times3}{2\\times5}\\\\\\dfrac{\\frac7{12}}{\\frac5{18}}&=\\frac{21}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\frac{11}{18}}{\\frac7{12}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{22}{21}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac{11}{18}}{\\frac7{12}}&=\\frac{11}{18}\\times\\frac{12}7\\\\\\dfrac{\\frac{11}{18}}{\\frac7{12}}&=\\frac{11\\times2}{3\\times7}\\\\\\dfrac{\\frac{11}{18}}{\\frac7{12}}&=\\frac{22}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
