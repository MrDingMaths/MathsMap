    "type": "question",
    "label": "9",
    "prompt": "A train travels for 48 minutes at 80 km/h. How far does it go?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$64\\text{ km}$",
      "worked": "$$\\begin{align*}\\text{Time}&=\\frac{48}{60}\\text{ h}\\\\\\text{Time}&=\\frac45\\text{ h}\\\\\\text{Distance}&=80\\times\\frac45\\\\\\text{Distance}&=64\\text{ km}\\end{align*}$$",
