  "content": {
    "id": "p42-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A shoe store is running a 20% off storewide sale.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "How much would you pay for a pair of sneakers originally priced at \\$56.50? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$45.20",
          "worked": "$$\\begin{align*}\\text{Sale percentage} &= 100\\%-20\\%\\\\&=80\\%\\\\\\text{Sale price} &= \\$56.50\\times0.8\\\\&=\\$45.20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p42-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Mr Ding pays \\$48.80 for a pair of shoes. What was the original price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$61",
          "worked": "The sale price represents $100\\%-20\\%=80\\%$ of the original price.\n\n$$\\begin{align*}80\\% &= \\$48.80\\\\1\\% &= \\frac{\\$48.80}{80}\\\\100\\% &= \\frac{\\$48.80}{80}\\times100\\\\&=\\$61\\end{align*}$$\n\nThe original price was \\$61.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p42-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Another shop is offering one quarter off the price storewide. Which is the better deal, and why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The other shop: one quarter off is 25%, which is a larger discount than 20%.",
          "worked": "$$\\begin{align*}\\text{One quarter as a percentage} &= \\frac14\\times100\\%\\\\&=25\\%\\end{align*}$$\n\nThe other shop offers the better discount because $25\\%>20\\%$. For the same original price, you pay 75% instead of 80%.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p42-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "You have \\$500 to spend. How many pairs of shoes, costing \\$96 before the price reduction, can you buy?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6 pairs",
          "worked": "$$\\begin{align*}\\text{Sale price per pair} &= \\$96\\times0.8\\\\&=\\$76.80\\\\\\text{Number affordable} &= \\frac{500}{76.80}\\\\&=\\frac{625}{96}\\\\&=6\\frac{49}{96}\\end{align*}$$\n\nYou can buy 6 whole pairs. Six pairs cost \\$460.80; seven pairs cost \\$537.60, exceeding the budget.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
