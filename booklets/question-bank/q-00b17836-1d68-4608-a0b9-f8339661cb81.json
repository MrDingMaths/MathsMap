  "content": {
    "id": "p33-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Money borrowed at $8\\%$ p.a. interest, compounded annually, grew to $\\$100\\,000$ in four years. Give the percentage increase to 2 decimal places and the original amount to the nearest cent. Keep unrounded values in intermediate calculations.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the total percentage increase.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36.05\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=((1.08)^4-1)\\times100\\%\\\\\\text{Percentage increase}&\\approx36.05\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p33-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the original amount borrowed.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$73\\,502.99$\n\nDivide the final debt by the full four-year growth multiplier.",
          "worked": "$$\\begin{align*}100\\,000&=P(1.08)^4\\\\P&=100\\,000\\div(1.08)^4\\\\P&\\approx\\$73\\,502.99\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
