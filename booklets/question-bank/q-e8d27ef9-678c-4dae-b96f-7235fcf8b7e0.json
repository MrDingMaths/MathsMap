  "content": {
    "id": "p25-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "$f(x)=x+2$ and $g(x)=\\frac{1}{x-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $g^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g^{-1}(x)=\\frac{1}{x}+1$, $x\\ne0$.",
          "worked": "$$\\begin{align*}y&=\\frac{1}{x-1}\\\\x&=\\frac{1}{y-1}\\\\y-1&=\\frac{1}{x}\\\\y&=\\frac{1}{x}+1\\\\g^{-1}(x)&=\\frac{1}{x}+1,\\qquad x\\ne0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p25-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $f(g(x))$ and give your answer in its simplest form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=\\frac{1}{x-1}+2=\\frac{2x-1}{x-1}$, $x\\ne1$.",
          "worked": "$$\\begin{align*}f(g(x))&=\\frac{1}{x-1}+2\\\\f(g(x))&=\\frac{1+2(x-1)}{x-1}\\\\f(g(x))&=\\frac{2x-1}{x-1},\\qquad x\\ne1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p25-q26-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the inverse of $f(g(x))$, i.e. $(fg)^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(fg)^{-1}(x)=\\frac{x-1}{x-2}$, $x\\ne2$.",
          "worked": "$$\\begin{align*}y&=\\frac{2x-1}{x-1}\\\\x&=\\frac{2y-1}{y-1}\\\\x(y-1)&=2y-1\\\\xy-x&=2y-1\\\\y(x-2)&=x-1\\\\y&=\\frac{x-1}{x-2}\\\\(fg)^{-1}(x)&=\\frac{x-1}{x-2},\\qquad x\\ne2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
