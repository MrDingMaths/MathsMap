            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}0&=5000r^{48}-M\\left[\\frac{r^{48}-1}{r-1}\\right]\\\\M&=\\frac{5000r^{48}(r-1)}{r^{48}-1}\\\\M&=\\frac{5000(1.0125)^{48}(0.0125)}{(1.0125)^{48}-1}\\\\M&\\approx\\$139.15\\end{align*}",
