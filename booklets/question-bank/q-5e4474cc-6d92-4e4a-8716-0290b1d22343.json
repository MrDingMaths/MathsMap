    "type": "question",
    "label": "3",
    "prompt": "David borrows $\\$5000$ from the bank and pays back the loan in monthly instalments over 4 years. If the loan incurs interest of 15% p.a. calculated monthly, find the amount of each instalment to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
