    "children": [
      {
        "id": "p20-q2-part-1",
        "type": "part",
        "label": "a",
        "prompt": "What did Yetta do wrong while adding the fractions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "She added the numerators and the denominators. The denominators must be made the same before adding the numerators.",
          "worked": "She added the numerators and the denominators separately. First rewrite the fractions with a common denominator, then add the numerators.\n$$\\begin{align*}\\frac{2}{5}+\\frac{3}{4}&=\\frac{8}{20}+\\frac{15}{20}\\\\&=\\frac{23}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p20-q2-part-2",
        "type": "part",
        "label": "b",
        "prompt": "Is Yetta’s answer bigger or smaller than the correct answer? How can you tell?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Smaller. $\\frac{5}{9}<\\frac{3}{4}$, but adding the positive fraction $\\frac{2}{5}$ to $\\frac{3}{4}$ gives a result greater than $\\frac{3}{4}$.",
          "worked": "$$\\begin{align*}\\frac{5}{9}&=\\frac{20}{36}\\\\\\frac{3}{4}&=\\frac{27}{36}\\end{align*}$$\nSo $\\frac{5}{9}<\\frac{3}{4}$. The correct sum is greater than $\\frac{3}{4}$ because $\\frac{2}{5}$ is positive. Yetta’s answer is smaller.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
