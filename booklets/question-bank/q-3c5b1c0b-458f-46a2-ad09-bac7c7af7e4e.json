  "content": {
    "id": "p17-q12-19-root",
    "type": "question",
    "label": "5",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p17-q12-19-shared-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Simplify the following expressions.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q12-19-a",
        "type": "part",
        "label": "a",
        "prompt": "$1-\\sin^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^2\\theta$",
          "worked": "Using $\\sin^2\\theta+\\cos^2\\theta=1$:\n$$\\begin{align*}1-\\sin^2\\theta&=\\cos^2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q12-19-b",
        "type": "part",
        "label": "b",
        "prompt": "$1+\\cot^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{cosec}^2\\theta$",
          "worked": "$$\\begin{align*}1+\\cot^2\\theta&=\\operatorname{cosec}^2\\theta\\end{align*}$$\nValid where $\\sin\\theta\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q12-19-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1-\\cos\\theta)(1+\\cos\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2\\theta$",
          "worked": "$$\\begin{align*}(1-\\cos\\theta)(1+\\cos\\theta)&=1-\\cos^2\\theta\\\\(1-\\cos\\theta)(1+\\cos\\theta)&=\\sin^2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q12-19-d",
        "type": "part",
        "label": "d",
        "prompt": "$3\\sin^2\\theta+4\\cos^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+\\cos^2\\theta$ or $4-\\sin^2\\theta$",
          "worked": "$$\\begin{align*}3\\sin^2\\theta+4\\cos^2\\theta&=3(1-\\cos^2\\theta)+4\\cos^2\\theta\\\\3\\sin^2\\theta+4\\cos^2\\theta&=3-3\\cos^2\\theta+4\\cos^2\\theta\\\\3\\sin^2\\theta+4\\cos^2\\theta&=3+\\cos^2\\theta\\end{align*}$$\nAlternatively:\n$$\\begin{align*}3\\sin^2\\theta+4\\cos^2\\theta&=3\\sin^2\\theta+4(1-\\sin^2\\theta)\\\\3\\sin^2\\theta+4\\cos^2\\theta&=3\\sin^2\\theta+4-4\\sin^2\\theta\\\\3\\sin^2\\theta+4\\cos^2\\theta&=4-\\sin^2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p17-q12-19-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin^2\\theta-\\sin^4\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2\\theta\\cos^2\\theta$",
          "worked": "$$\\begin{align*}\\sin^2\\theta-\\sin^4\\theta&=\\sin^2\\theta(1-\\sin^2\\theta)\\\\\\sin^2\\theta-\\sin^4\\theta&=\\sin^2\\theta\\cos^2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p17-q12-19-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1}{\\cos^2\\theta}-\\tan^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{1}{\\cos^2\\theta}-\\tan^2\\theta&=\\sec^2\\theta-\\tan^2\\theta\\\\\\frac{1}{\\cos^2\\theta}-\\tan^2\\theta&=1\\end{align*}$$\nValid where $\\cos\\theta\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q12-19-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sin\\theta\\cos(90^\\circ-\\theta)+\\cos\\theta\\sin(90^\\circ-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Use $\\cos(90^\\circ-\\theta)=\\sin\\theta$ and $\\sin(90^\\circ-\\theta)=\\cos\\theta$.\n$$\\begin{align*}\\sin\\theta\\cos(90^\\circ-\\theta)+\\cos\\theta\\sin(90^\\circ-\\theta)&=\\sin^2\\theta+\\cos^2\\theta\\\\\\sin\\theta\\cos(90^\\circ-\\theta)+\\cos\\theta\\sin(90^\\circ-\\theta)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q12-19-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\cot^2\\theta-\\operatorname{cosec}^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\cot^2\\theta-\\operatorname{cosec}^2\\theta&=\\cot^2\\theta-(1+\\cot^2\\theta)\\\\\\cot^2\\theta-\\operatorname{cosec}^2\\theta&=-1\\end{align*}$$\nValid where $\\sin\\theta\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
