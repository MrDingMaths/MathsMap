  "content": {
    "id": "p21-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find all integer values of $b$ for which $x^2+bx-1=0$ has integer solutions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=0$.",
      "worked": "By the Integer Root Theorem, any integer root must divide $-1$, so the only possibilities are $x=1$ and $x=-1$.\n\nFor $x=1$:\n$$\\begin{align*}1+b-1&=0\\\\b&=0\\end{align*}$$\nFor $x=-1$:\n$$\\begin{align*}1-b-1&=0\\\\-b&=0\\\\b&=0\\end{align*}$$\nWhen $b=0$, the equation is $x^2-1=(x-1)(x+1)=0$, giving integer solutions $x=\\pm1$. Therefore, the only value is $b=0$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
