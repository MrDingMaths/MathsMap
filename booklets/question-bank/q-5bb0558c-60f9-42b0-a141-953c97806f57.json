  "content": {
    "id": "p11-problem-2-root",
    "type": "question",
    "label": "2",
    "prompt": "[Telescoping sum]",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-problem-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Rationalise the denominator of\n\n$$\\frac{1}{\\sqrt{n}+\\sqrt{n+1}}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{n+1}-\\sqrt{n}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{n}+\\sqrt{n+1}}&=\\frac{\\sqrt{n+1}-\\sqrt{n}}{(\\sqrt{n+1}+\\sqrt{n})(\\sqrt{n+1}-\\sqrt{n})}\\\\\\frac{1}{\\sqrt{n}+\\sqrt{n+1}}&=\\frac{\\sqrt{n+1}-\\sqrt{n}}{(n+1)-n}\\\\\\frac{1}{\\sqrt{n}+\\sqrt{n+1}}&=\\sqrt{n+1}-\\sqrt{n}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p11-problem-2-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, simplify\n\n$$\\frac{1}{1+\\sqrt{2}}+\\frac{1}{\\sqrt{2}+\\sqrt{3}}+\\frac{1}{\\sqrt{3}+\\sqrt{4}}+\\cdots+\\frac{1}{\\sqrt{99}+\\sqrt{100}}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$.\n\nUse part (a) to write each term as a difference. The intermediate square roots cancel.",
          "worked": "Let $S$ be the given sum. Use part (a) for each term, with $n$ running from $1$ to $99$.\n\n$$\\begin{align*}S&=(\\sqrt{2}-1)+(\\sqrt{3}-\\sqrt{2})+(\\sqrt{4}-\\sqrt{3})+\\cdots+(\\sqrt{100}-\\sqrt{99})\\\\S&=\\sqrt{100}-1\\\\S&=10-1\\\\S&=9.\\end{align*}$$\n\nEach of $\\sqrt{2}$ through $\\sqrt{99}$ occurs once with a plus sign and once with a minus sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
