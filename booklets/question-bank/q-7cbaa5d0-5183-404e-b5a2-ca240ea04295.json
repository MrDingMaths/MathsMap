    "label": "59",
    "prompt": "Find the smallest positive number that is divisible by 1, 2, 3, 4 and 5, and which only uses the digits 0 and 5.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$55500$. It needs three 5s and must end in 00.",
