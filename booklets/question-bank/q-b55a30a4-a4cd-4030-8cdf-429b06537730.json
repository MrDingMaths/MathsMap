  "content": {
    "id": "v2-80fa2-p27-practice-slot-14-upper-root",
    "type": "question",
    "label": null,
    "prompt": "The Moon is $3.844\\times10^{5}$ km from Earth. Light travels at $3.00\\times10^{8}$ m/s. Calculate the time light takes to travel from the Moon to Earth. Give the answer in seconds, in scientific notation, rounded to three s.f.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1.28\\times10^{0}$ s",
      "worked": "$$\\begin{align*}3.844\\times10^{5}\\text{ km}&=3.844\\times10^{5}\\times10^{3}\\text{ m}\\\\&=3.844\\times10^{8}\\text{ m}\\\\\\text{Time}&=\\frac{3.844\\times10^{8}}{3.00\\times10^{8}}\\\\&=1.281333\\ldots\\times10^{0}\\\\&\\approx1.28\\times10^{0}\\text{ s}\\quad(3\\text{ s.f.})\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
