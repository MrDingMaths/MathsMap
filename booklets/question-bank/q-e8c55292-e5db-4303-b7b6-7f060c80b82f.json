  "content": {
    "id": "p10-q5",
    "type": "question",
    "label": "5",
    "prompt": "Simplify the following. Write as a single fraction. Reminder that $4x$ is the same as $\\frac{4x}{1}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-r1c1",
        "type": "part",
        "label": "a",
        "prompt": "$4x+\\frac{x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13x}{3}$",
          "worked": "$\\begin{align*}4x+\\frac{x}{3}&=\\frac{12x}{3}+\\frac{x}{3}\\\\4x+\\frac{x}{3}&=\\frac{13x}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-r1c2",
        "type": "part",
        "label": "b",
        "prompt": "$3x+\\frac{x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{2}$",
          "worked": "$\\begin{align*}3x+\\frac{x}{2}&=\\frac{6x}{2}+\\frac{x}{2}\\\\3x+\\frac{x}{2}&=\\frac{7x}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-r1c3",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{a}{5}+2a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11a}{5}$",
          "worked": "$\\begin{align*}\\frac{a}{5}+2a&=\\frac{a}{5}+\\frac{10a}{5}\\\\\\frac{a}{5}+2a&=\\frac{11a}{5}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-r1c4",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{8p}{3}-2p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2p}{3}$",
          "worked": "$\\begin{align*}\\frac{8p}{3}-2p&=\\frac{8p}{3}-\\frac{6p}{3}\\\\\\frac{8p}{3}-2p&=\\frac{2p}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-r2c1",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{10u}{3}+\\frac{3v}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{100u+9v}{30}$",
          "worked": "$\\begin{align*}\\frac{10u}{3}+\\frac{3v}{10}&=\\frac{100u}{30}+\\frac{9v}{30}\\\\\\frac{10u}{3}+\\frac{3v}{10}&=\\frac{100u+9v}{30}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-r2c2",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{7y}{10}-\\frac{2x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7y-4x}{10}$",
          "worked": "$\\begin{align*}\\frac{7y}{10}-\\frac{2x}{5}&=\\frac{7y}{10}-\\frac{4x}{10}\\\\\\frac{7y}{10}-\\frac{2x}{5}&=\\frac{7y-4x}{10}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q5-r2c3",
        "type": "part",
        "label": "g",
        "prompt": "$2t+\\frac{7p}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4t+7p}{2}$",
          "worked": "$\\begin{align*}2t+\\frac{7p}{2}&=\\frac{4t}{2}+\\frac{7p}{2}\\\\2t+\\frac{7p}{2}&=\\frac{4t+7p}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-r2c4",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x}{3}-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-3y}{3}$",
          "worked": "$\\begin{align*}\\frac{x}{3}-y&=\\frac{x}{3}-\\frac{3y}{3}\\\\\\frac{x}{3}-y&=\\frac{x-3y}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
