    "children": [
      {
        "id": "p17-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "When the polynomial $P(x)=2x^4-x^2+x-p$ is divided by $x-2$, the remainder is $2$. Find $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=28$",
          "worked": "By the remainder theorem, $P(2)=2$.\n$$\\begin{align*}2(2)^4-(2)^2+2-p&=2\\\\32-4+2-p&=2\\\\30-p&=2\\\\p&=28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "The polynomial $P(x)=x^3-bx^2+6x-24$ gives a remainder of $48$ on division by $x+2$. Find $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-23$",
          "worked": "Since $x+2=x-(-2)$, the remainder theorem gives $P(-2)=48$.\n$$\\begin{align*}(-2)^3-b(-2)^2+6(-2)-24&=48\\\\-8-4b-12-24&=48\\\\-4b-44&=48\\\\-4b&=92\\\\b&=-23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
