    "type": "question",
    "label": "4",
    "prompt": "For each line given below, find the points on the line with x-values of $1$ and $2$, and hence calculate the gradient of the line.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,1),(2,4)$; gradient $3$.",
          "worked": "At $x=1$, $y=1$; at $x=2$, $y=4$. Thus $$\\begin{aligned}m&=\\frac{4-(1)}{2-1}\\\\&=3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p25-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2x-8$",
        "layout": "list",
        "columns": null,
