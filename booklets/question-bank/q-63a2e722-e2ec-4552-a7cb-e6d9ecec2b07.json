  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Write these intervals using bracket interval notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "The real numbers greater than 0 and less than 7.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,7)$",
          "worked": "Neither endpoint is included, so use round brackets: $(0,7)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "The real numbers greater than or equal to 2 and less than or equal to 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[2,5]$",
          "worked": "Both endpoints are included, so use square brackets: $[2,5]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "The real numbers greater than or equal to 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[4,\\infty)$",
          "worked": "Include $4$ and extend to the right; infinity always takes a round bracket: $[4,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "The real numbers less than $-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,-4)$",
          "worked": "Exclude $-4$ and extend to the left: $(-\\infty,-4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      }
    ]
