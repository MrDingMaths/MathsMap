  "content": {
    "id": "v2-p34-classification-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Calculate the summary statistics for the number of tries scored by a rugby team in $7$ games: $1,\\;3,\\;3,\\;4,\\;6,\\;8,\\;10$",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-p34-classification-slot-2-slot-2-qa",
        "type": "part",
        "label": "a",
        "prompt": "Range",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}\\text{Range}&=10-1\\\\\\text{Range}&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-p34-classification-slot-2-slot-2-qb",
        "type": "part",
        "label": "b",
        "prompt": "Mode",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$3$ occurs twice; every other value occurs once. The mode is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-p34-classification-slot-2-slot-2-qc",
        "type": "part",
        "label": "c",
        "prompt": "Mean",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\overline{x}&=\\frac{\\text{sum of data values}}{\\text{number of data values}}\\\\\\overline{x}&=\\frac{1+3+3+4+6+8+10}{7}\\\\\\overline{x}&=\\frac{35}{7}\\\\\\overline{x}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-p34-classification-slot-2-slot-2-qd",
        "type": "part",
        "label": "d",
        "prompt": "Median",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\text{Position}&=\\frac{7+1}{2}\\\\\\text{Position}&=4\\end{align*}$$\nThe fourth value is $4$, so the median is $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
