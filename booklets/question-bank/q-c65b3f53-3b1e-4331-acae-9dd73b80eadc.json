                    {
                      "type": "text",
                      "text": "From all distinct three-letter codes formed from the letters of the word CONCEPT, select a code uniformly at random. Find the probability that the selected code has both C's.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "p33-q6-b-item",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p33-q6-b",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "The letters of the word CONCEPT are written on separate cards. Find the probability that when three cards are chosen at random without replacement, two of the cards are the letter C.",
                      "marks": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
