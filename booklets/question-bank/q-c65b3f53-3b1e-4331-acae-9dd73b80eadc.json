            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Distinct codes: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{1}{9}",
                "display": false
              },
              {
                "type": "text",
                "text": ". Separate cards: ",
                "marks": []
