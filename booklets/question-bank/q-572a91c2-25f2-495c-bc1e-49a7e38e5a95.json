    "label": "5",
    "prompt": "Find the sum of the first 50 odd positive integers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2500$",
      "worked": "The odd positive integers form an arithmetic sequence with $a=1$ and $d=2$.\n$$\\begin{align*}S_{50}&=\\frac{50}{2}\\left[2(1)+(50-1)2\\right]\\\\S_{50}&=25(100)\\\\S_{50}&=2500.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
