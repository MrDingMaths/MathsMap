        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17.14\\%$ (24 of 140 employees)",
          "worked": "$$\\begin{align*}100\\%\\text{ of the women}&=80\\text{ women}\\\\1\\%\\text{ of the women}&=80\\div100=0.8\\text{ women}\\\\15\\%\\text{ of the women}&=0.8\\times15=12\\text{ women}\\\\\\text{Employees wearing glasses}&=12+12=24\\\\\\text{Total employees}&=60+80=140\\\\\\text{Percentage wearing glasses}&=\\frac{24}{140}\\times100\\%=\\frac{120}{7}\\%\\\\\\text{Percentage wearing glasses}&\\approx17.14\\%\\end{align*}$$",
