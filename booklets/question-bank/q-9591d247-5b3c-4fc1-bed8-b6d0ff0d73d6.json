  "content": {
    "id": "p16-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "When rolling 2 dice:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q9-distribution-node",
        "type": "part",
        "label": "a",
        "prompt": "Find the Bernoulli distribution for getting a double.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(X=x)=\\begin{cases}\\frac{1}{6}&x=1\\\\\\frac{5}{6}&x=0\\end{cases}$",
          "worked": "Let $X=1$ for a double and $X=0$ otherwise. There are 6 doubles among 36 equally likely outcomes.\n\n$P(X=1)=\\frac{6}{36}=\\frac{1}{6}$ and $P(X=0)=1-\\frac{1}{6}=\\frac{5}{6}$.\n\n$P(X=x)=\\begin{cases}\\frac{1}{6}&x=1\\\\\\frac{5}{6}&x=0\\end{cases}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q9-moments-group",
        "type": "group",
        "label": "",
        "prompt": "For this distribution, find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q9-a-node",
            "type": "part",
            "label": "b",
            "prompt": "the mean",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{6}$",
              "worked": "$E(X)=p=\\frac{1}{6}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 9
          },
          {
            "id": "p16-q9-b-node",
            "type": "part",
            "label": "c",
            "prompt": "the variance",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{5}{36}$",
              "worked": "$\\begin{aligned}\\operatorname{Var}(X)&=p(1-p)\\\\\\operatorname{Var}(X)&=\\frac{1}{6}\\left(\\frac{5}{6}\\right)=\\frac{5}{36}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p16-q9-c-node",
            "type": "part",
            "label": "d",
            "prompt": "the exact standard deviation",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{\\sqrt{5}}{6}$",
              "worked": "$\\sigma=\\sqrt{\\operatorname{Var}(X)}=\\sqrt{\\frac{5}{36}}=\\frac{\\sqrt{5}}{6}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 11
          }
        ]
      }
    ]
  },
