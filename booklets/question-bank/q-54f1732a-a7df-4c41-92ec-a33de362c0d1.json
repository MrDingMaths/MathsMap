  "content": {
    "id": "v2-9f332-p25-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Decide whether each geometric series has a limiting sum. Find it if it exists.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-9f332-p25-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$12+9+\\frac{27}{4}+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $S_\\infty=48$.",
          "worked": "$$\\begin{align*}r&=\\frac{9}{12}=\\frac34\\end{align*}$$\nSince $|r|<1$, the limiting sum exists.\n$$\\begin{align*}S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{12}{1-\\frac34}\\\\S_\\infty&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-9f332-p25-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$4-6+9-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No limiting sum.",
          "worked": "$$\\begin{align*}r&=\\frac{-6}{4}=-\\frac32\\end{align*}$$\nSince $|r|>1$, there is no limiting sum.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-9f332-p25-practice-slot-1-slot-1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$-90+60-40+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $S_\\infty=-54$.",
          "worked": "$$\\begin{align*}r&=\\frac{60}{-90}=-\\frac23\\end{align*}$$\nSince $|r|<1$, the limiting sum exists.\n$$\\begin{align*}S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{-90}{1+\\frac23}\\\\S_\\infty&=-54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
