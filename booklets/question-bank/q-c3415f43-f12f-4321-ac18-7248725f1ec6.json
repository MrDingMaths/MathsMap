    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A debating team consists of five boys and seven girls. If one of the team is chosen at random to be the leader, what is the probability that the leader is a girl?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{7}{12}$",
      "worked": "There are $5+7=12$ team members, each equally likely to be chosen. Seven are girls.\n\n$$P(\\text{girl})=\\frac{7}{12}.$$",
      "solutionDiagrams": []
    },
