  "content": {
    "id": "p20-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the equation of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "the line through $(2,5)$ and parallel to $y=2x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+1$",
          "worked": "Parallel lines have equal gradients.\n$$\\begin{align*}m_{\\mathrm{new}}&=2\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-5&=2(x-2)\\\\y-5&=2x-4\\\\y&=2x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p20-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "the line through $(2,5)$ and perpendicular to $y=2x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{x}{2}+6$",
          "worked": "Perpendicular gradients are negative reciprocals.\n$$\\begin{align*}m_{\\mathrm{new}}&=-\\frac{1}{2}\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-5&=-\\frac{1}{2}(x-2)\\\\y-5&=-\\frac{x}{2}+1\\\\y&=-\\frac{x}{2}+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p20-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "the line through $(-7,6)$ and parallel to $y=\\dfrac{3x}{7}-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{3x}{7}+9$",
          "worked": "Parallel lines have equal gradients.\n$$\\begin{align*}m_{\\mathrm{new}}&=\\frac{3}{7}\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-6&=\\frac{3}{7}\\bigl(x-(-7)\\bigr)\\\\y-6&=\\frac{3x}{7}+3\\\\y&=\\frac{3x}{7}+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p20-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "the line through $(-4,0)$ and perpendicular to $y=-\\dfrac{2}{5}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{5x}{2}+10$",
          "worked": "Perpendicular gradients are negative reciprocals.\n$$\\begin{align*}m_{\\mathrm{new}}&=-\\frac{1}{-2/5}=\\frac{5}{2}\\\\y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y-0&=\\frac{5}{2}\\bigl(x-(-4)\\bigr)\\\\y&=\\frac{5}{2}(x+4)\\\\y&=\\frac{5x}{2}+10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
