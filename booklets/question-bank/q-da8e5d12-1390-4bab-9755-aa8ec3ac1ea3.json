  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The price of Victoria shoes is increasing over a 10-year period by 10% per annum, so that the price in each of those 10 years is $P,\\ 1.1P,\\ (1.1)^2P,\\ldots$. I buy one pair of these shoes each year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q9-part-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression for the total paid over 10 years (correct to the nearest cent).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10P((1.1)^{10}-1)$ dollars, rounded to the nearest cent once $P$ is known.",
          "worked": "$a=P$, $r=1.1$, $n=10$.\n\n$$\\begin{align*}S_{10}&=\\frac{a(r^{10}-1)}{r-1}\\\\S_{10}&=\\frac{P((1.1)^{10}-1)}{1.1-1}\\\\S_{10}&=\\frac{P((1.1)^{10}-1)}{0.1}\\\\S_{10}&=10P((1.1)^{10}-1).\\end{align*}$$\nThe total is $10P((1.1)^{10}-1)$ dollars; round the resulting amount to the nearest cent once $P$ is known.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p20-q9-part-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the initial price $P$ if the total paid is $\\$900$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$56.47$.",
          "worked": "$$\\begin{align*}900&=10P((1.1)^{10}-1)\\\\P&=\\frac{900}{10((1.1)^{10}-1)}\\\\P&\\approx56.47.\\end{align*}$$\nThe initial price is $\\$56.47$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
