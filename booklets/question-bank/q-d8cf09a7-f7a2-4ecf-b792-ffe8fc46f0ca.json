  "content": {
    "id": "p59-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A team of seven netballers is to be chosen from a squad of twelve players A, B, C, D, E, F, G, H, I, J, K and L. In how many ways can they be chosen:",
