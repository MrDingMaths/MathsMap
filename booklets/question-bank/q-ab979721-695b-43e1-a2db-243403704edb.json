    "type": "question",
    "label": "21",
    "prompt": "Given $a^2+b^2=29$ and $ab=10$, find the value of $(a+b)^2$ without solving for $a$ or $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$49$",
      "worked": "$$\\begin{align*}(a+b)^2&=a^2+b^2+2ab\\\\(a+b)^2&=29+2(10)\\\\(a+b)^2&=49.\\end{align*}$$",
