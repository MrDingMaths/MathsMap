      {
        "id": "p4-q3-factorise",
        "type": "part",
        "label": "b",
        "prompt": "Factorise:\n$$-9x^2-3x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3x(3x+1)$",
          "worked": "The negative HCF is $-3x$.\n$$\\begin{aligned}-9x^2-3x&=-3x\\left(\\frac{-9x^2}{-3x}+\\frac{-3x}{-3x}\\right)\\\\&=-3x(3x+1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
