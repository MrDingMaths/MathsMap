  "content": {
    "id": "p28-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The surface area of a cone of slant length $3\\,\\text{cm}$ is $10\\pi\\,\\text{cm}^2$. Find the radius of the cone.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\,\\text{cm}$",
      "worked": "$$\\begin{align*}\\pi rs+\\pi r^2&=10\\pi\\\\3\\pi r+\\pi r^2&=10\\pi\\\\r^2+3r-10&=0\\\\(r+5)(r-2)&=0\\\\r&=2\\,\\text{cm}\\end{align*}$$\n\nThe root $r=-5$ is rejected because a radius is positive.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
