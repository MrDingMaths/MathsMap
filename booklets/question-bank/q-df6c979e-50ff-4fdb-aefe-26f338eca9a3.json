  "content": {
    "id": "p33-q12-root",
    "type": "question",
    "label": null,
    "prompt": "Find the possible values of $\\lambda$ if the projection of $\\lambda\\mathbf{i}+4\\mathbf{j}$ onto $12\\mathbf{i}-5\\mathbf{j}$ has length $\\dfrac{140}{13}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\lambda=\\dfrac{40}{3}$ or $\\lambda=-10$.",
      "worked": "For the projection of $\\lambda\\mathbf{i}+4\\mathbf{j}$ onto $12\\mathbf{i}-5\\mathbf{j}$:\n\n$$\\begin{aligned}(\\lambda\\mathbf{i}+4\\mathbf{j})\\cdot(12\\mathbf{i}-5\\mathbf{j})&=12\\lambda-20\\\\|12\\mathbf{i}-5\\mathbf{j}|&=\\sqrt{144+25}=13\\\\|\\operatorname{proj}|&=\\frac{|12\\lambda-20|}{13}=\\frac{140}{13}\\\\|12\\lambda-20|&=140\\\\12\\lambda-20&=140\\quad\\text{or}\\quad12\\lambda-20=-140\\\\12\\lambda&=160\\quad\\text{or}\\quad12\\lambda=-120\\\\\\lambda&=\\frac{40}{3}\\quad\\text{or}\\quad\\lambda=-10\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
