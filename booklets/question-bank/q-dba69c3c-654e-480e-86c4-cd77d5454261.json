    "children": [
      {
        "id": "p13-q1a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}x&=6\\cos\\theta,\\\\y&=6\\sin\\theta\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=36$",
          "worked": "$$\\begin{aligned}\\cos\\theta&=\\frac{x}{6}\\\\\\sin\\theta&=\\frac{y}{6}\\end{aligned}$$\nUsing $\\cos^2\\theta+\\sin^2\\theta=1$:\n$$\\begin{aligned}\\left(\\frac{x}{6}\\right)^2+\\left(\\frac{y}{6}\\right)^2&=1\\\\\\frac{x^2}{36}+\\frac{y^2}{36}&=1\\\\x^2+y^2&=36\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q1b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}x&=\\sin\\theta,\\\\y&=\\cos\\theta+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+(y-1)^2=1$",
          "worked": "$$\\begin{aligned}\\sin\\theta&=x\\\\\\cos\\theta&=y-1\\end{aligned}$$\nUsing $\\sin^2\\theta+\\cos^2\\theta=1$:\n$$x^2+(y-1)^2=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p13-q1c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}x&=5+4\\cos\\theta,\\\\y&=2+4\\sin\\theta\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)^2+(y-2)^2=16$",
          "worked": "$$\\begin{aligned}\\cos\\theta&=\\frac{x-5}{4}\\\\\\sin\\theta&=\\frac{y-2}{4}\\end{aligned}$$\nUsing $\\cos^2\\theta+\\sin^2\\theta=1$:\n$$\\begin{aligned}\\left(\\frac{x-5}{4}\\right)^2+\\left(\\frac{y-2}{4}\\right)^2&=1\\\\\\frac{(x-5)^2}{16}+\\frac{(y-2)^2}{16}&=1\\\\(x-5)^2+(y-2)^2&=16\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
