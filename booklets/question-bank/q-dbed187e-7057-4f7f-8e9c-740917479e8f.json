  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p8-q4-a-line",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Complete the following ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "2=e^{\\textstyle\\rule{0pt}{4mm}\\ldots\\ldots\\ldots\\ldots\\ldots}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln(2)$",
          "worked": "Since $2>0$, the inverse identity gives $2=e^{\\ln(2)}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, express $2^x$ in the form $e^{ax}$ for some value of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^x=e^{x\\ln(2)}$, with $a=\\ln(2)$.",
          "worked": "$$\\begin{align*}2^x&=(e^{\\ln(2)})^x\\\\2^x&=e^{x\\ln(2)}\\end{align*}$$\n\nThus $a=\\ln(2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the expression in part (b) to show that $\\frac{d}{dx}(2^x)=2^x\\times\\ln(2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d}{dx}(2^x)=2^x\\ln(2)$.\n\nDifferentiate $e^{x\\ln(2)}$ using the chain rule, then replace the exponential with $2^x$.",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(2^x)&=\\frac{d}{dx}(e^{x\\ln(2)})\\\\\\frac{d}{dx}(2^x)&=e^{x\\ln(2)}\\cdot\\ln(2)\\\\\\frac{d}{dx}(2^x)&=2^x\\ln(2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
