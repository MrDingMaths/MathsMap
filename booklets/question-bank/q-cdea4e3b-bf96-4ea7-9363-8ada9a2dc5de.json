  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve these equations",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{n+2}{2}+\\frac{n}{6}=5$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=6$",
          "worked": "$$\\begin{align*}\\frac{3(n+2)}{6}+\\frac{n}{6}&=5\\\\\\frac{3n+6+n}{6}&=5\\\\\\frac{4n+6}{6}&=5\\\\4n+6&=30\\\\4n&=24\\\\n&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{x+2}{10}+\\frac{20-x}{4}=4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8$",
          "worked": "$$\\begin{align*}\\frac{2(x+2)}{20}+\\frac{5(20-x)}{20}&=4\\\\\\frac{2x+4+100-5x}{20}&=4\\\\\\frac{104-3x}{20}&=4\\\\104-3x&=80\\\\104&=80+3x\\\\24&=3x\\\\x&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{2x-5}{3}-\\frac{x+7}{5}=2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{76}{7}$",
          "worked": "$$\\begin{align*}\\frac{5(2x-5)}{15}-\\frac{3(x+7)}{15}&=2\\\\\\frac{10x-25-3x-21}{15}&=2\\\\\\frac{7x-46}{15}&=2\\\\7x-46&=30\\\\7x&=76\\\\x&=\\frac{76}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p11-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{4-k}{5}-\\frac{3k-1}{2}=20$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-11$",
          "worked": "$$\\begin{align*}\\frac{2(4-k)}{10}-\\frac{5(3k-1)}{10}&=20\\\\\\frac{8-2k-15k+5}{10}&=20\\\\\\frac{13-17k}{10}&=20\\\\13-17k&=200\\\\13&=200+17k\\\\-187&=17k\\\\k&=-11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p11-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{4x+3}{2}-\\frac{30x+11}{8}=-\\frac{3}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{4(4x+3)}{8}-\\frac{30x+11}{8}&=-\\frac{6}{8}\\\\\\frac{16x+12-30x-11}{8}&=-\\frac{6}{8}\\\\\\frac{1-14x}{8}&=-\\frac{6}{8}\\\\1-14x&=-6\\\\1&=-6+14x\\\\7&=14x\\\\x&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p11-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{y-1}{4}-\\frac{2y+3}{3}=\\frac{1}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{21}{5}$",
          "worked": "$$\\begin{align*}\\frac{3(y-1)}{12}-\\frac{4(2y+3)}{12}&=\\frac{6}{12}\\\\\\frac{3y-3-8y-12}{12}&=\\frac{6}{12}\\\\\\frac{-5y-15}{12}&=\\frac{6}{12}\\\\-5y-15&=6\\\\-15&=6+5y\\\\-21&=5y\\\\y&=-\\frac{21}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      }
    ]
  },
