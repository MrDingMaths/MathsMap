  "content": {
    "id": "p16-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "$f(x)=x^2+5x$. Find, in simplest form:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{f(1+h)-f(1)}{h}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+h$",
          "worked": "$$\\begin{align*}f(1+h)&=(1+h)^2+5(1+h)\\\\f(1+h)&=h^2+7h+6\\\\f(1)&=6\\\\\\frac{f(1+h)-f(1)}{h}&=\\frac{h^2+7h+6-6}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=\\frac{h(h+7)}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=7+h\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p16-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{f(p)-f(q)}{p-q}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p+q+5$",
          "worked": "$$\\begin{align*}\\frac{f(p)-f(q)}{p-q}&=\\frac{p^2+5p-(q^2+5q)}{p-q}\\\\\\frac{f(p)-f(q)}{p-q}&=\\frac{p^2-q^2+5(p-q)}{p-q}\\\\\\frac{f(p)-f(q)}{p-q}&=\\frac{(p-q)(p+q+5)}{p-q}\\\\\\frac{f(p)-f(q)}{p-q}&=p+q+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p16-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{f(x+h)-f(x)}{h}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+h+5$",
          "worked": "$$\\begin{align*}f(x+h)&=(x+h)^2+5(x+h)\\\\f(x+h)&=x^2+2xh+h^2+5x+5h\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{x^2+2xh+h^2+5x+5h-(x^2+5x)}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{2xh+h^2+5h}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=\\frac{h(2x+h+5)}{h}\\\\\\frac{f(x+h)-f(x)}{h}&=2x+h+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
