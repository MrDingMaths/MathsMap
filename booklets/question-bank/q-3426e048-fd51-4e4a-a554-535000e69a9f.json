  "content": {
    "id": "v2-fc7d35-p4-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "If $V=4x^3$ and $\\dfrac{dV}{dt}=18$, evaluate $\\dfrac{dx}{dt}$ when $x=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{6}$",
      "worked": "$$\\begin{aligned}\\frac{dV}{dx}&=12x^2\\\\\\frac{dV}{dt}&=\\frac{dV}{dx}\\times\\frac{dx}{dt}\\\\18&=12x^2\\frac{dx}{dt}\\end{aligned}$$\nAt $x=3$:\n$$\\begin{aligned}18&=12(9)\\frac{dx}{dt}\\\\18&=108\\frac{dx}{dt}\\\\\\frac{dx}{dt}&=\\frac{18}{108}=\\frac16\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
