  "content": {
    "id": "p12-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A sector has radius $3\\text{ cm}$. If the angle subtended at the centre is $150^{\\circ}$, find in exact form:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Arc length",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\pi}{2}\\text{ cm}$",
          "worked": "$$\\begin{align*}\\theta &= 150\\times\\frac{\\pi}{180}=\\frac{5\\pi}{6}\\text{ radians}\\\\l &= r\\theta\\\\l &= 3\\times\\frac{5\\pi}{6}\\\\l &= \\frac{5\\pi}{2}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Area of the sector",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{15\\pi}{4}\\text{ cm}^{2}$",
          "worked": "$$\\begin{align*}\\theta &= 150\\times\\frac{\\pi}{180}=\\frac{5\\pi}{6}\\text{ radians}\\\\A &= \\frac{1}{2}r^{2}\\theta\\\\A &= \\frac{1}{2}\\times3^{2}\\times\\frac{5\\pi}{6}\\\\A &= \\frac{15\\pi}{4}\\text{ cm}^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
