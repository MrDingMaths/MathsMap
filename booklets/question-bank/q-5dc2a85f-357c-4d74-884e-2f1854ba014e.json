  "content": {
    "id": "p27-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find each ratio $r$ to test whether there is a limiting sum. Find the limiting sum if it exists.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$1-\\frac12+\\frac14-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=-\\frac12$, $S_\\infty=\\frac23$.",
          "worked": "$$\\begin{align*}r&=\\frac{-1/2}{1}\\\\r&=-\\frac12\\\\|r|&=\\frac12<1\\\\S_\\infty&=\\frac{1}{1-(-1/2)}\\\\S_\\infty&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$4-6+9-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=-\\frac32$; no limiting sum.",
          "worked": "$$\\begin{align*}r&=\\frac{-6}{4}\\\\r&=-\\frac32\\\\|r|&=\\frac32>1\\end{align*}$$\nThere is no limiting sum.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p27-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$12+4+\\frac43+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\frac13$, $S_\\infty=18$.",
          "worked": "$$\\begin{align*}r&=\\frac4{12}\\\\r&=\\frac13\\\\|r|&=\\frac13<1\\\\S_\\infty&=\\frac{12}{1-1/3}\\\\S_\\infty&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$1000+100+10+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\frac1{10}$, $S_\\infty=\\frac{10000}{9}$.",
          "worked": "$$\\begin{align*}r&=\\frac{100}{1000}\\\\r&=\\frac1{10}\\\\|r|&=\\frac1{10}<1\\\\S_\\infty&=\\frac{1000}{1-1/10}\\\\S_\\infty&=\\frac{10000}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$-2+\\frac25-\\frac2{25}+\\cdots$",
