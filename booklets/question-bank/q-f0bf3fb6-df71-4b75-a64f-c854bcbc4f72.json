  "content": {
    "id": "p16-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "I think of a number. I add one-third of that number and one-quarter of the same number to get 5 more than the number I first thought of. What is this number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-12$",
      "worked": "Let $x$ be the number. Multiply both sides of the equation by 12 to clear the fractions.\n$$\\begin{align*}\\frac{x}{3}+\\frac{x}{4}&=x+5\\\\4x+3x&=12x+60\\\\7x&=12x+60\\\\0&=5x+60\\\\-60&=5x\\\\x&=-12\\end{align*}$$\nThe number is $-12$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
