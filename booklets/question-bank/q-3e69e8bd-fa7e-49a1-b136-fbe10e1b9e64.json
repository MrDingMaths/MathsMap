  "content": {
    "id": "v2-8113f-p18-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Two accounts are offered for an investment of $\\$8000$ over 6 years. Account A pays 5.4% p.a. simple interest. Account B pays 4.8% p.a. interest, compounded annually. Give monetary answers to the nearest cent.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8113f-p18-practice-slot-9-s9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the balance of Account A after 6 years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$10\\,592.00$",
          "worked": "$$\\begin{align*}I &= Prn\\\\I &= 8000\\times0.054\\times6\\\\I &= \\$2592\\\\FV &= 8000+2592\\\\FV &= \\$10\\,592.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-8113f-p18-practice-slot-9-s9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the balance of Account B after 6 years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$10\\,598.82$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 8000(1+0.048)^6\\\\FV &\\approx \\$10\\,598.82\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-8113f-p18-practice-slot-9-s9-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Which account gives more money, and by how much?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Account B, by $\\$6.82$.",
          "worked": "$$\\begin{align*}10\\,598.82-10\\,592.00 &= \\$6.82\\end{align*}$$\nAccount B gives more, by $\\$6.82$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
