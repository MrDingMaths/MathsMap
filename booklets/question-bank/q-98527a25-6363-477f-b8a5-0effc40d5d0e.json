  "content": {
    "id": "p23-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the equation of the tangent to the curve $y=4^{x+1}$ when $x=0$. Answer in general form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4x\\ln 4-y+4=0$",
      "worked": "At $x=0$:\n$$\\begin{align*}y&=4^{0+1}\\\\y&=4\\end{align*}$$\n$$\\begin{align*}\\frac{dy}{dx}&=4^{x+1}\\ln 4\\end{align*}$$\nAt $(0,4)$:\n$$\\begin{align*}m&=4\\ln 4\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-4&=4\\ln 4(x-0)\\\\y&=4x\\ln 4+4\\\\4x\\ln 4-y+4&=0\\end{align*}$$",
      "solutionDiagrams": []
    },
