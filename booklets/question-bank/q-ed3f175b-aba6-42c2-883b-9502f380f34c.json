    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "50 runs",
      "worked": "$$\\begin{align*}246-196&=246-200+4\\\\246-196&=46+4\\\\246-196&=50\\end{align*}$$\nAustralia won by 50 runs.",
