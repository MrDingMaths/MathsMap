  "content": {
    "id": "p44-q11",
    "type": "question",
    "label": "11",
    "prompt": "Elena earns \\$24.50 per hour for a 36-hour week.\nShe takes 4 weeks holidays to travel overseas.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "What will be her wage for 4 weeks?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3528",
          "worked": "$$\\begin{align*}\\text{Weekly wage} &= 24.50 \\times 36 = \\$882\\\\\\text{Four weeks’ wage} &= 882 \\times 4 = \\$3528\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p44-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How much will her holiday loading be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$617.40",
          "worked": "$$\\begin{align*}\\text{Holiday loading} &= 0.175 \\times 882 \\times 4\\\\\\text{Holiday loading} &= \\$617.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p44-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "What amount of money will Elena be paid altogether for her holiday?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$4145.40",
          "worked": "$$\\begin{align*}\\text{Total holiday pay} &= 3528 + 617.40\\\\\\text{Total holiday pay} &= \\$4145.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
