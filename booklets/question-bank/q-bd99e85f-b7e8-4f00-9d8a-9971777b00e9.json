  "content": {
    "id": "p19-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Suppose that $x=3+\\sqrt{10}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $x+\\frac{1}{x}$ in simplest form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{10}$",
          "worked": "$$\\begin{align*}\\frac{1}{x}&=\\frac{1}{3+\\sqrt{10}}\\times\\frac{3-\\sqrt{10}}{3-\\sqrt{10}}\\\\\\frac{1}{x}&=\\frac{3-\\sqrt{10}}{9-10}\\\\\\frac{1}{x}&=\\sqrt{10}-3\\end{align*}$$\n$$\\begin{align*}x+\\frac{1}{x}&=3+\\sqrt{10}+\\sqrt{10}-3\\\\x+\\frac{1}{x}&=2\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p19-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the value of $x^2+\\frac{1}{x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$38$",
          "worked": "Using part a,\n$$\\begin{align*}x^2+\\frac{1}{x^2}&=\\left(x+\\frac{1}{x}\\right)^2-2\\\\x^2+\\frac{1}{x^2}&=(2\\sqrt{10})^2-2\\\\x^2+\\frac{1}{x^2}&=40-2=38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
