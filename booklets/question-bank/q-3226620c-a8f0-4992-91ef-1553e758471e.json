        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 64 p64-q21-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont},>=stealth]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (P) at (0,0);\\coordinate (Q) at (2.6,2);\\coordinate (R) at (4.2,-1.4);\n\\draw (P)--(Q)--(R)--cycle;\n\\draw[->] (P)--($(P)!0.58!(Q)$);\\draw[->] (Q)--($(Q)!0.46!(R)$);\n\\path (P)--(Q) node[midway,above left] {$6\\underset{\\sim}{a}+\\underset{\\sim}{b}$};\n\\path (Q)--(R) node[midway,right] {$-2\\underset{\\sim}{a}-5\\underset{\\sim}{b}$};\n\\node[left] at (P) {$P$};\\node[above] at (Q) {$Q$};\\node[below right] at (R) {$R$};\n\\end{tikzpicture}",
