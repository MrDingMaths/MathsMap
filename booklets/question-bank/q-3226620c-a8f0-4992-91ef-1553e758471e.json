    "type": "question",
    "label": "",
    "prompt": "$PQR$ is a triangle.\n\nShow that $\\overrightarrow{PR}$ is parallel to $\\underset{\\sim}{a}-\\underset{\\sim}{b}$.",
    "layout": "list",
    "columns": null,
