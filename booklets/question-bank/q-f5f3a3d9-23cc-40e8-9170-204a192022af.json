    "label": "2",
    "prompt": "Prove that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\cos A-\\sin A)(\\cos A+\\sin A)=\\cos2A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=\\cos^2 A-\\sin^2 A=\\cos2A=\\text{RHS}$.",
          "worked": "$$\\begin{aligned}\\text{LHS}&=(\\cos A-\\sin A)(\\cos A+\\sin A)\\\\&=\\cos^2 A-\\sin^2 A\\\\&=\\cos2A\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sin\\alpha-\\cos\\alpha)^2=1-\\sin2\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=1-2\\sin\\alpha\\cos\\alpha=1-\\sin2\\alpha=\\text{RHS}$.",
          "worked": "$$\\begin{aligned}\\text{LHS}&=(\\sin\\alpha-\\cos\\alpha)^2\\\\&=\\sin^2\\alpha-2\\sin\\alpha\\cos\\alpha+\\cos^2\\alpha\\\\&=(\\sin^2\\alpha+\\cos^2\\alpha)-2\\sin\\alpha\\cos\\alpha\\\\&=1-2\\sin\\alpha\\cos\\alpha\\\\&=1-\\sin2\\alpha\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin2\\theta=2\\sin\\theta\\sin\\left(\\dfrac\\pi2-\\theta\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{RHS}=2\\sin\\theta\\cos\\theta=\\sin2\\theta=\\text{LHS}$.",
          "worked": "$$\\begin{aligned}\\text{RHS}&=2\\sin\\theta\\sin\\left(\\frac\\pi2-\\theta\\right)\\\\&=2\\sin\\theta\\cos\\theta\\\\&=\\sin2\\theta\\\\&=\\text{LHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac1{1-\\tan\\theta}-\\dfrac1{1+\\tan\\theta}=\\tan2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=\\dfrac{2\\tan\\theta}{1-\\tan^2\\theta}=\\tan2\\theta=\\text{RHS}$.",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\frac1{1-\\tan\\theta}-\\frac1{1+\\tan\\theta}\\\\&=\\frac{1+\\tan\\theta-(1-\\tan\\theta)}{(1-\\tan\\theta)(1+\\tan\\theta)}\\\\&=\\frac{2\\tan\\theta}{1-\\tan^2\\theta}\\\\&=\\tan2\\theta\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
