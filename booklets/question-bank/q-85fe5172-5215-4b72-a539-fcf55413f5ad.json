        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5a}{6b}$",
          "worked": "$$\\begin{align*}\\frac{3a}{2b}-\\frac{2a}{3b}&=\\frac{9a-4a}{6b}\\\\\\frac{3a}{2b}-\\frac{2a}{3b}&=\\frac{5a}{6b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{3a}{2b}\\times\\frac{2a}{3b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^2}{b^2}$",
          "worked": "$$\\begin{align*}\\frac{3a}{2b}\\times\\frac{2a}{3b}&=\\frac{6a^2}{6b^2}\\\\\\frac{3a}{2b}\\times\\frac{2a}{3b}&=\\frac{a^2}{b^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{3a}{2b}\\div\\frac{2a}{3b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{4}$",
          "worked": "$$\\begin{align*}\\frac{3a}{2b}\\div\\frac{2a}{3b}&=\\frac{3a}{2b}\\times\\frac{3b}{2a}\\\\\\frac{3a}{2b}\\div\\frac{2a}{3b}&=\\frac{9ab}{4ab}\\\\\\frac{3a}{2b}\\div\\frac{2a}{3b}&=\\frac94\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
