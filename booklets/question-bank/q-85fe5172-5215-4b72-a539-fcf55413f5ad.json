      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x}{2}+\\frac{x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x}{4}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}+\\frac{x}{4}&=\\frac{2x+x}{4}\\\\\\frac{x}{2}+\\frac{x}{4}&=\\frac{3x}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x}{2}-\\frac{x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{4}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}-\\frac{x}{4}&=\\frac{2x-x}{4}\\\\\\frac{x}{2}-\\frac{x}{4}&=\\frac{x}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x}{2}\\times\\frac{x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{8}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}\\times\\frac{x}{4}&=\\frac{x\\times x}{2\\times4}\\\\\\frac{x}{2}\\times\\frac{x}{4}&=\\frac{x^2}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{2}\\div\\frac{x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{x}{2}\\div\\frac{x}{4}&=\\frac{x}{2}\\times\\frac{4}{x}\\\\\\frac{x}{2}\\div\\frac{x}{4}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3a}{2b}+\\frac{2a}{3b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13a}{6b}$",
          "worked": "$$\\begin{align*}\\frac{3a}{2b}+\\frac{2a}{3b}&=\\frac{9a+4a}{6b}\\\\\\frac{3a}{2b}+\\frac{2a}{3b}&=\\frac{13a}{6b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{3a}{2b}-\\frac{2a}{3b}$",
