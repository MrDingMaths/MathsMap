  "content": {
    "id": "p32-q7",
    "type": "question",
    "label": "7",
    "prompt": "Simplify each expression, giving your answers with positive indices.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2a^2(2b)^3}{2ab^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8ab$",
          "worked": "$$\\begin{align*}\\frac{2a^2(2b)^3}{2ab^2}&=\\frac{16a^2b^3}{2ab^2}\\\\\\frac{2a^2(2b)^3}{2ab^2}&=8ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{a^2b^3}{ab}\\times\\dfrac{a^2b^5}{a^2b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab^5$",
          "worked": "$$\\begin{align*}\\frac{a^2b^3}{ab}\\times\\frac{a^2b^5}{a^2b^2}&=ab^2\\times b^3\\\\\\frac{a^2b^3}{ab}\\times\\frac{a^2b^5}{a^2b^2}&=ab^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{(2a)^2\\times8b^3}{16a^2b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2b$",
          "worked": "$$\\begin{align*}\\frac{(2a)^2\\times8b^3}{16a^2b^2}&=\\frac{32a^2b^3}{16a^2b^2}\\\\\\frac{(2a)^2\\times8b^3}{16a^2b^2}&=2b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2a^2b^3}{8a^2b^2}\\div\\dfrac{16(ab)^2}{2ab}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{32a}$",
          "worked": "$$\\begin{align*}\\frac{2a^2b^3}{8a^2b^2}\\div\\frac{16(ab)^2}{2ab}&=\\frac b4\\div8ab\\\\\\frac{2a^2b^3}{8a^2b^2}\\div\\frac{16(ab)^2}{2ab}&=\\frac b4\\times\\frac1{8ab}\\\\\\frac{2a^2b^3}{8a^2b^2}\\div\\frac{16(ab)^2}{2ab}&=\\frac1{32a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{8a^6}{6a^3}\\div\\dfrac{4(a^2)^4}{(3a)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac9{a^2}$",
          "worked": "$$\\begin{align*}\\frac{8a^6}{6a^3}\\div\\frac{4(a^2)^4}{(3a)^3}&=\\frac{4a^3}{3}\\div\\frac{4a^5}{27}\\\\\\frac{8a^6}{6a^3}\\div\\frac{4(a^2)^4}{(3a)^3}&=\\frac{4a^3}{3}\\times\\frac{27}{4a^5}\\\\\\frac{8a^6}{6a^3}\\div\\frac{4(a^2)^4}{(3a)^3}&=\\frac9{a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{3a^3}{6a^{-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^4}{2}$",
          "worked": "$$\\begin{align*}\\frac{3a^3}{6a^{-1}}&=\\frac12a^{3-(-1)}\\\\\\frac{3a^3}{6a^{-1}}&=\\frac{a^4}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
