  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify these expressions by cancelling common factors.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q4a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{2}$",
          "worked": "$$\\begin{align*}\\frac{2x}{4}&=\\frac{2x}{2\\times2}\\\\&=\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q4b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{6a}{5a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6}{5}$",
          "worked": "$$\\begin{align*}\\frac{6a}{5a}&=\\frac{6}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p6-q4c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{4y}{20y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{5}$",
          "worked": "$$\\begin{align*}\\frac{4y}{20y}&=\\frac{4y}{5\\times4y}\\\\&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q4d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3(x+1)}{9(x+1)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3}$",
          "worked": "$$\\begin{align*}\\frac{3(x+1)}{9(x+1)}&=\\frac{3}{9}\\\\&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q4e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{2(x-2)}{8(x-2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{4}$",
          "worked": "$$\\begin{align*}\\frac{2(x-2)}{8(x-2)}&=\\frac{2}{8}\\\\&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q4f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{8(x+4)}{12(x+4)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{3}$",
          "worked": "$$\\begin{align*}\\frac{8(x+4)}{12(x+4)}&=\\frac{8}{12}\\\\&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q4g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{(x+5)(x-5)}{(x+5)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-5$",
          "worked": "$$\\begin{align*}\\frac{(x+5)(x-5)}{x+5}&=x-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p6-q4h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{6(x-1)(x+3)}{9(x+3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x-1)}{3}$",
          "worked": "$$\\begin{align*}\\frac{6(x-1)(x+3)}{9(x+3)}&=\\frac{6(x-1)}{9}\\\\&=\\frac{2(x-1)}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q4i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{8(x-2)}{4(x-2)(x+4)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{x+4}$",
          "worked": "$$\\begin{align*}\\frac{8(x-2)}{4(x-2)(x+4)}&=\\frac{8}{4(x+4)}\\\\&=\\frac{2}{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
