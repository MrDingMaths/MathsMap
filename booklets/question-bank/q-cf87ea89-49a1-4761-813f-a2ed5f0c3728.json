  "content": {
    "id": "p7-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Expand and simplify each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+2)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3+6x^2+12x+8$",
          "worked": "$$\\begin{align*}(x+2)^3&=x^3+3x^2(2)+3x(2)^2+2^3\\\\(x+2)^3&=x^3+6x^2+12x+8.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-1)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-4x^3+6x^2-4x+1$",
          "worked": "$$\\begin{align*}(x-1)^4&=x^4+4x^3(-1)+6x^2(-1)^2+4x(-1)^3+(-1)^4\\\\(x-1)^4&=x^4-4x^3+6x^2-4x+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x+1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32x^5+80x^4+80x^3+40x^2+10x+1$",
          "worked": "$$\\begin{align*}(2x+1)^5&=(2x)^5+5(2x)^4+10(2x)^3+10(2x)^2+5(2x)+1\\\\(2x+1)^5&=32x^5+80x^4+80x^3+40x^2+10x+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3x-2)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81x^4-216x^3+216x^2-96x+16$",
          "worked": "$$\\begin{align*}(3x-2)^4&=(3x)^4+4(3x)^3(-2)+6(3x)^2(-2)^2+4(3x)(-2)^3+(-2)^4\\\\(3x-2)^4&=81x^4-216x^3+216x^2-96x+16.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(x+\\frac1x\\right)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5+5x^3+10x+\\frac{10}{x}+\\frac5{x^3}+\\frac1{x^5}$",
          "worked": "$$\\begin{align*}\\left(x+\\frac1x\\right)^5&=\\sum_{k=0}^{5}\\binom5k x^{5-k}\\left(\\frac1x\\right)^k\\\\\\left(x+\\frac1x\\right)^5&=x^5+5x^3+10x+\\frac{10}{x}+\\frac5{x^3}+\\frac1{x^5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(2x-\\frac3x\\right)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16x^4-96x^2+216-\\frac{216}{x^2}+\\frac{81}{x^4}$",
          "worked": "$$\\begin{align*}\\left(2x-\\frac3x\\right)^4&=\\sum_{k=0}^{4}\\binom4k(2x)^{4-k}\\left(-\\frac3x\\right)^k\\\\\\left(2x-\\frac3x\\right)^4&=16x^4-96x^2+216-\\frac{216}{x^2}+\\frac{81}{x^4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(x^2+1)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{12}+6x^{10}+15x^8+20x^6+15x^4+6x^2+1$",
          "worked": "$$\\begin{align*}(x^2+1)^6&=(x^2)^6+6(x^2)^5+15(x^2)^4+20(x^2)^3+15(x^2)^2+6x^2+1\\\\(x^2+1)^6&=x^{12}+6x^{10}+15x^8+20x^6+15x^4+6x^2+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(x^2-\\frac2x\\right)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{10}-10x^7+40x^4-80x+\\frac{80}{x^2}-\\frac{32}{x^5}$",
          "worked": "$$\\begin{align*}\\left(x^2-\\frac2x\\right)^5&=\\sum_{k=0}^{5}\\binom5k(x^2)^{5-k}\\left(-\\frac2x\\right)^k\\\\\\left(x^2-\\frac2x\\right)^5&=x^{10}-10x^7+40x^4-80x+\\frac{80}{x^2}-\\frac{32}{x^5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
