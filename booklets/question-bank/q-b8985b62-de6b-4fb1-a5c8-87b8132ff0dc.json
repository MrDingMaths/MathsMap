        "children": [],
        "answer": {
          "short": "$x=\\frac65$; the left side is $5^{\\frac{5x}{6}}$.",
          "worked": "$$\\begin{align*}(5^{2-\\frac13})^{\\frac x2}&=5^1\\\\(5^{\\frac53})^{\\frac x2}&=5^1\\\\5^{\\frac{5x}{6}}&=5^1\\\\\\frac{5x}{6}&=1\\\\x&=\\frac65\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
