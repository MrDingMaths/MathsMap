      {
        "id": "p26-q14-v",
        "type": "part",
        "label": "v",
        "prompt": "$1000=\\frac{100^{n}}{\\sqrt[5]{10^{n}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac53$; using base $10$, $3=\\frac{9n}{5}$.",
          "worked": "$$\\begin{align*}10^3&=\\frac{10^{2n}}{10^{n/5}}\\\\10^3&=10^{2n-\\frac n5}\\\\3&=\\frac{9n}{5}\\\\15&=9n\\\\n&=\\frac53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p26-q14-w",
        "type": "part",
        "label": "w",
        "prompt": "$\\frac{9^{y}}{27^{5-y}}=\\sqrt{243}$",
