        "children": [],
        "answer": {
          "short": "$(16+6\\pi)\\,\\mathrm{m}^{2}$",
          "worked": "Add the two quarter-circle ends, the quarter-cylinder curved surface and both rectangular cut faces.\n$$\\begin{align*}A&=\\frac12\\pi r^{2}+\\frac12\\pi rh+2rh\\\\A&=\\frac12\\pi(2)^{2}+\\frac12\\pi(2)(4)+2(2)(4)\\\\A&=2\\pi+4\\pi+16\\\\A&=(16+6\\pi)\\,\\mathrm{m}^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62,
        "responseSpace": "scaffold"
      },
