            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 28 question 10(a)\"}\n\\begin{tikzpicture}[line width=0.8pt,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont},x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\def\\H{2.5}\n\\coordinate (O) at (0,0);\\coordinate (A) at (1.3,0.45);\\coordinate (B) at (-0.65,0.65);\\coordinate (P) at (0,-\\H);\\coordinate (C) at (1.3,{0.45-\\H});\\coordinate (D) at (-0.65,{0.65-\\H});\n\\draw (A)--(O)--(B);\n\\draw plot[domain=0:90,samples=41] ({1.3*cos(\\x)-0.65*sin(\\x)},{0.45*cos(\\x)+0.65*sin(\\x)});\n\\draw (O)--(P)--(C)--(A);\n\\draw (B)--(D)--(P);\n\\draw[dashed] plot[domain=0:90,samples=41] ({1.3*cos(\\x)-0.65*sin(\\x)},{0.45*cos(\\x)+0.65*sin(\\x)-\\H});\n\\path (A)--(C) node[midway,right] {$4\\,\\mathrm{m}$};\n\\path (P)--(C) node[midway,below right] {$2\\,\\mathrm{m}$};\n\\end{tikzpicture}",
