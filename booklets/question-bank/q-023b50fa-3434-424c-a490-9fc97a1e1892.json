  "content": {
    "id": "p18-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Calculate the following products, and write each result using scientific notation:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2\\times10^{-2})\\times(4\\times10^{-4})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\times10^{-6}$",
          "worked": "$$\\begin{align*}(2\\times10^{-2})\\times(4\\times10^{-4})&=(2\\times4)\\times10^{-2+(-4)}\\\\(2\\times10^{-2})\\times(4\\times10^{-4})&=8\\times10^{-6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2\\times10^{12})\\times(3\\times10^{-4})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\times10^8$",
          "worked": "$$\\begin{align*}(2\\times10^{12})\\times(3\\times10^{-4})&=(2\\times3)\\times10^{12+(-4)}\\\\(2\\times10^{12})\\times(3\\times10^{-4})&=6\\times10^8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$(4\\times10^3)\\times(4.1\\times10^{-15})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.64\\times10^{-11}$",
          "worked": "$$\\begin{align*}(4\\times10^3)\\times(4.1\\times10^{-15})&=(4\\times4.1)\\times10^{3+(-15)}\\\\(4\\times10^3)\\times(4.1\\times10^{-15})&=16.4\\times10^{-12}\\\\(4\\times10^3)\\times(4.1\\times10^{-15})&=1.64\\times10^{-11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$(4.2\\times10^{12})\\times(2\\times10^{-12})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.4\\times10^0$",
          "worked": "$$\\begin{align*}(4.2\\times10^{12})\\times(2\\times10^{-12})&=(4.2\\times2)\\times10^{12+(-12)}\\\\(4.2\\times10^{12})\\times(2\\times10^{-12})&=8.4\\times10^0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$0.000042\\times20\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.4\\times10^{-1}$",
          "worked": "$$\\begin{align*}0.000042\\times20\\,000&=(4.2\\times10^{-5})\\times(2\\times10^4)\\\\0.000042\\times20\\,000&=(4.2\\times2)\\times10^{-5+4}\\\\0.000042\\times20\\,000&=8.4\\times10^{-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$5\\,600\\,000\\times0.002$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.12\\times10^4$",
          "worked": "$$\\begin{align*}5\\,600\\,000\\times0.002&=(5.6\\times10^6)\\times(2\\times10^{-3})\\\\5\\,600\\,000\\times0.002&=(5.6\\times2)\\times10^{6+(-3)}\\\\5\\,600\\,000\\times0.002&=11.2\\times10^3\\\\5\\,600\\,000\\times0.002&=1.12\\times10^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
