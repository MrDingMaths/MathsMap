  "content": {
    "id": "p39-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A regional country medical centre has lost the services of one of its 16 doctors due to retirement, and has been unable to replace her.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage loss is represented by the retiring doctor?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.25\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage loss}&=\\frac{1}{16}\\times100\\%\\\\\\text{Percentage loss}&=6.25\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p39-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If the medical centre treated 400 patients per day last year and need to reduce this number by the percentage found in part a, how many patients per day will they be able to treat in the coming year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "375 patients per day.",
          "worked": "$$\\begin{align*}\\text{Patients per day}&=400\\times(1-0.0625)\\\\\\text{Patients per day}&=400\\times0.9375\\\\\\text{Patients per day}&=375\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
