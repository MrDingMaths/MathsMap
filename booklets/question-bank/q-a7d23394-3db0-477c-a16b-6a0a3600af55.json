  "content": {
    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Express $\\dfrac{1}{\\sqrt[3]{5}}$ with a rational denominator.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{\\sqrt[3]{25}}{5}$\n\nMultiply numerator and denominator by $\\sqrt[3]{25}$ to make the denominator $\\sqrt[3]{125}=5$.",
      "worked": "$$\\begin{align*}\\frac{1}{\\sqrt[3]{5}}&=\\frac{1}{\\sqrt[3]{5}}\\times\\frac{\\sqrt[3]{25}}{\\sqrt[3]{25}}\\\\\\frac{1}{\\sqrt[3]{5}}&=\\frac{\\sqrt[3]{25}}{\\sqrt[3]{125}}\\\\\\frac{1}{\\sqrt[3]{5}}&=\\frac{\\sqrt[3]{25}}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
