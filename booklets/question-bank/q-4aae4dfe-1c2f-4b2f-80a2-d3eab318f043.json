              {
                "type": "text",
                "text": "Factorise as a quadratic in ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "4^x",
                "display": false
              },
              {
                "type": "text",
                "text": " and reject the negative value.",
                "marks": []
