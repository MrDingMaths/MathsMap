  "content": {
    "id": "p21-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify the expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$$5mn\\times\\frac{4d}{n}\\times\\frac{1}{15mn}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4d}{3n}$",
          "worked": "$$\\begin{align*}5mn\\times\\frac{4d}{n}\\times\\frac{1}{15mn}&=\\frac{20dmn}{15mn^2}\\\\&=\\frac{4d}{3n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{6}{r}\\times\\frac{5r}{9}\\div\\frac{15}{xy}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2xy}{9}$",
          "worked": "$$\\begin{align*}\\frac{6}{r}\\times\\frac{5r}{9}\\div\\frac{15}{xy}&=\\frac{6}{r}\\times\\frac{5r}{9}\\times\\frac{xy}{15}\\\\&=\\frac{30rxy}{135r}\\\\&=\\frac{2xy}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{6cf}{q}\\div\\frac{5}{qf}\\div\\frac{10c}{a}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3af^2}{25}$",
          "worked": "$$\\begin{align*}\\frac{6cf}{q}\\div\\frac{5}{qf}\\div\\frac{10c}{a}&=\\frac{6cf}{q}\\times\\frac{qf}{5}\\times\\frac{a}{10c}\\\\&=\\frac{6acqf^2}{50cq}\\\\&=\\frac{3af^2}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{4ab}{5}\\div\\frac{a}{2b}\\div\\frac{8b}{15}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3b$",
          "worked": "$$\\begin{align*}\\frac{4ab}{5}\\div\\frac{a}{2b}\\div\\frac{8b}{15}&=\\frac{4ab}{5}\\times\\frac{2b}{a}\\times\\frac{15}{8b}\\\\&=\\frac{120ab^2}{40ab}\\\\&=3b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
