  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "There are five red tokens and six blue tokens in a bag. Four tokens are removed at random without replacement. Find the probability of obtaining:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "at least one red token",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{22}$",
          "worked": "The complement is obtaining four blue tokens.\n$$\\begin{align*}\\Pr(\\text{at least one red})&=1-\\frac{6}{11}\\times\\frac{5}{10}\\times\\frac{4}{9}\\times\\frac{3}{8}\\\\\\Pr(\\text{at least one red})&=1-\\frac{1}{22}\\\\\\Pr(\\text{at least one red})&=\\frac{21}{22}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "at least one blue token",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{65}{66}$",
          "worked": "The complement is obtaining four red tokens.\n$$\\begin{align*}\\Pr(\\text{at least one blue})&=1-\\frac{5}{11}\\times\\frac{4}{10}\\times\\frac{3}{9}\\times\\frac{2}{8}\\\\\\Pr(\\text{at least one blue})&=1-\\frac{1}{66}\\\\\\Pr(\\text{at least one blue})&=\\frac{65}{66}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "at least one token of each colour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p9-q5-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{31}{33}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p9-q5-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Subtract the probabilities of four blue tokens and four red tokens from 1.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The complement is obtaining four blue tokens or four red tokens. These events are mutually exclusive.\n$$\\begin{align*}\\Pr(\\text{at least one of each colour})&=1-\\Pr(\\text{four blue})-\\Pr(\\text{four red})\\\\\\Pr(\\text{at least one of each colour})&=1-\\frac{1}{22}-\\frac{1}{66}\\\\\\Pr(\\text{at least one of each colour})&=\\frac{62}{66}\\\\\\Pr(\\text{at least one of each colour})&=\\frac{31}{33}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
