    "type": "question",
    "label": "5",
    "prompt": "A triangular goat paddock has two sides of lengths $320\\text{ m}$ and $170\\text{ m}$, and a $71^\\circ$ angle between them. Find the length of the third side, correct to the nearest metre.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$310\\text{ m}$",
      "worked": "$$\\begin{align*}c^2&=320^2+170^2-2(320)(170)\\cos71^\\circ\\\\c&=\\sqrt{320^2+170^2-2(320)(170)\\cos71^\\circ}\\\\c&\\approx310\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
