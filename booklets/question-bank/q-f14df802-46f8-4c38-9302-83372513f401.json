    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "State the domain and range of $y=\\dfrac{2}{x-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $x\\in\\mathbb{R},\\ x\\ne1$.\n\nRange: $y\\in\\mathbb{R},\\ y\\ne0$.",
          "worked": "The denominator cannot be zero, so $x\\ne1$. The numerator is nonzero, so the function cannot have output $0$; every other real output is possible.\n\nDomain: $\\mathbb{R}\\setminus\\{1\\}$.\n\nRange: $\\mathbb{R}\\setminus\\{0\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation of the inverse.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2}{x}+1,\\quad x\\ne0$.",
          "worked": "Swap $x$ and $y$ and solve for $y$.\n\n$$\\begin{align*}x&=\\frac{2}{y-1}\\\\x(y-1)&=2\\\\y-1&=\\frac{2}{x}\\\\y&=\\frac{2}{x}+1\\end{align*}$$\n\nThe inverse has domain $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "State the domain and range of the inverse function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $x\\in\\mathbb{R},\\ x\\ne0$.\n\nRange: $y\\in\\mathbb{R},\\ y\\ne1$.",
          "worked": "The domain and range swap when taking the inverse.\n\nDomain: $\\mathbb{R}\\setminus\\{0\\}$.\n\nRange: $\\mathbb{R}\\setminus\\{1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
