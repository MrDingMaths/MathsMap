        "label": "a",
        "prompt": "How many ways can 4 children be selected from a group of 6?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}\\binom{6}{4}&=\\frac{6!}{4!2!}\\\\\\binom{6}{4}&=\\frac{6\\times5}{2}\\\\\\binom{6}{4}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "How many ways can 2 children be selected from a group of 6?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}\\binom{6}{2}&=\\frac{6!}{2!4!}\\\\\\binom{6}{2}&=\\frac{6\\times5}{2}\\\\\\binom{6}{2}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
