  "content": {
    "id": "p20-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A parabola has vertex $(-2,-1)$ and passes through the point $(1,26)$. Find its equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=3(x+2)^2-1$, or $y=3x^2+12x+11$.",
      "worked": "The vertex $(-2,-1)$ gives $y=a(x+2)^2-1$. Substitute $(1,26)$:\n\n$$\\begin{align*}26&=a(1+2)^2-1\\\\26&=9a-1\\\\27&=9a\\\\a&=3\\end{align*}$$\n\nHence $y=3(x+2)^2-1$, or $y=3x^2+12x+11$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
