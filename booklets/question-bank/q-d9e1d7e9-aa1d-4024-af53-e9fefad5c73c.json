  "content": {
    "id": "p56-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A small toy glider is released from a cliff. It follows a parabolic path as shown.\nThe lowest point of the glider is 11 metres above the ground, 8 metres from the cliff.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation in the form $y=x^2+bx+c$ to model the glider’s path.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p56-q6-path",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"pathBlue\",\"hex\":\"268CFF\",\"reason\":\"supplied glider path series\"}],\"reference\":\"p56 p56-q6-path\"}\n\\begin{tikzpicture}[x=0.38cm,y=0.055cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{pathBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-0.9,-5) rectangle (13,110);\n\\draw[->,line width=0.5pt] (0,0)--(12,0) node[right] {$x$};\n\\draw[->,line width=0.5pt] (0,0)--(0,104) node[above] {$y$};\n\\draw[pathBlue,->,line width=0.8pt,domain=0:12,samples=81] plot (\\x,{(\\x-8)^2+11});\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 70,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 56,
              "sourceRegion": "Question 6a, supplied path sketch",
              "description": "Unshaded first-quadrant reference curve, starting on the y-axis and rising after an unlabelled minimum; terminal curve arrow, positive axis arrows, no ticks, numerical annotations or grid.",
              "mathematics": "Equation-derived qualitative path y=(x-8)^2+11; coordinates are not printed.",
              "answerVisibility": "Supplied reference curve remains student-visible; equation and numerical features remain answer-only."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "diagramPlacement": "beside-prompt",
        "answer": {
          "short": "$y=x^2-16x+75$.",
          "worked": "The minimum turning point is $(8,11)$. The specified form has coefficient 1 for $x^2$.\n$$\\begin{align*}y&=(x-8)^2+11\\\\y&=x^2-16x+64+11\\\\y&=x^2-16x+75\\end{align*}$$\nThus $b=-16$ and $c=75$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p56-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, or otherwise, from what height was the glider released?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75\\text{ m}$.",
          "worked": "At release, $x=0$.\n$$\\begin{align*}y&=0^2-16(0)+75\\\\y&=75\\end{align*}$$\nThe glider was released from a height of 75 m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
