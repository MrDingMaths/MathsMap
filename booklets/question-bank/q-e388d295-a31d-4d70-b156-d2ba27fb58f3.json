    "type": "question",
    "label": "14",
    "prompt": "The sum of two fractions is $\\frac{13}{12}$. If one fraction is $\\frac{1}{4}$, what is the other?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{6}$",
      "worked": "Subtract the known fraction from the sum.\n\n$$\\begin{align*}\\frac{13}{12}-\\frac{1}{4}&=\\frac{13}{12}-\\frac{3}{12}\\\\\\frac{13}{12}-\\frac{1}{4}&=\\frac{10}{12}\\\\\\frac{13}{12}-\\frac{1}{4}&=\\frac{5}{6}.\\end{align*}$$",
      "solutionDiagrams": []
    },
