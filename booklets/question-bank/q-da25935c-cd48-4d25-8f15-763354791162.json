  "content": {
    "id": "p21-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider the function $f(x)=x^4-2x^2+1$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q3-a-node",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $f(-x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=x^4-2x^2+1$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^4-2(-x)^2+1\\\\f(-x)&=x^4-2x^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-q3-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Hence show that $f(x)$ is an even function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=f(x)$, so $f$ is even.",
          "worked": "$f(-x)=x^4-2x^2+1=f(x)$. Therefore $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
