  "content": {
    "id": "p17-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A bag contains 8 white marbles and 3 non-white marbles. If 3 marbles are selected at random, find the mean number of white marbles if they were selected:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "With replacement.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{24}{11}$ white marbles.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p17-q7-a-work-intro",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "X",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " be the number of white marbles selected. Each selection has white probability ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{8}{11}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and non-white probability ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{3}{11}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p17-q7-a-probabilities",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(X=0)&=\\left(\\frac{3}{11}\\right)^3=\\frac{27}{1331}\\\\P(X=1)&=3\\left(\\frac{8}{11}\\right)\\left(\\frac{3}{11}\\right)^2=\\frac{216}{1331}\\\\P(X=2)&=3\\left(\\frac{8}{11}\\right)^2\\left(\\frac{3}{11}\\right)=\\frac{576}{1331}\\\\P(X=3)&=\\left(\\frac{8}{11}\\right)^3=\\frac{512}{1331}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p17-q7-a-mean",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}E(X)&=\\sum xP(x)\\\\E(X)&=\\frac{0(27)+1(216)+2(576)+3(512)}{1331}\\\\E(X)&=\\frac{2904}{1331}\\\\E(X)&=\\frac{24}{11}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p17-q7-a-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The mean is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{24}{11}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " white marbles.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p17-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Without replacement.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{24}{11}$ white marbles.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p17-q7-b-work-intro",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "X",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " be the number of white marbles selected. For one or two white marbles, there are three possible colour orders.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p17-q7-b-probabilities",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(X=0)&=\\frac{3}{11}\\times\\frac{2}{10}\\times\\frac{1}{9}=\\frac{1}{165}\\\\P(X=1)&=3\\times\\frac{8}{11}\\times\\frac{3}{10}\\times\\frac{2}{9}=\\frac{24}{165}\\\\P(X=2)&=3\\times\\frac{8}{11}\\times\\frac{7}{10}\\times\\frac{3}{9}=\\frac{84}{165}\\\\P(X=3)&=\\frac{8}{11}\\times\\frac{7}{10}\\times\\frac{6}{9}=\\frac{56}{165}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p17-q7-b-mean",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}E(X)&=\\sum xP(x)\\\\E(X)&=\\frac{0(1)+1(24)+2(84)+3(56)}{165}\\\\E(X)&=\\frac{360}{165}\\\\E(X)&=\\frac{24}{11}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p17-q7-b-conclusion",
                "type": "paragraph",
                "fontSize": null,
