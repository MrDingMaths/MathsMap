  "content": {
    "id": "p9-q17",
    "type": "question",
    "label": "17",
    "prompt": "Use the fact that $\\left(\\frac{4}{9}\\right)^{-\\frac{1}{2}}=\\left(\\frac{9}{4}\\right)^{\\frac{1}{2}}=\\sqrt{\\frac{9}{4}}=\\frac{3}{2}$ to evaluate the following:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{9}{4}\\right)^{-\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{9}{4}\\right)^{-\\frac{1}{2}}&=\\left(\\frac{4}{9}\\right)^{\\frac{1}{2}}\\\\&=\\sqrt{\\frac{4}{9}}\\\\&=\\frac{2}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{49}{144}\\right)^{-\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12}{7}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{49}{144}\\right)^{-\\frac{1}{2}}&=\\left(\\frac{144}{49}\\right)^{\\frac{1}{2}}\\\\&=\\sqrt{\\frac{144}{49}}\\\\&=\\frac{12}{7}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{8}{125}\\right)^{-\\frac{1}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{2}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{8}{125}\\right)^{-\\frac{1}{3}}&=\\left(\\frac{125}{8}\\right)^{\\frac{1}{3}}\\\\&=\\sqrt[3]{\\frac{125}{8}}\\\\&=\\frac{5}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{1296}{625}\\right)^{-\\frac{1}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{6}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{1296}{625}\\right)^{-\\frac{1}{4}}&=\\left(\\frac{625}{1296}\\right)^{\\frac{1}{4}}\\\\&=\\sqrt[4]{\\frac{625}{1296}}\\\\&=\\frac{5}{6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
