        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}9^{\\log_3(2)}&=(3^2)^{\\log_3(2)}\\\\9^{\\log_3(2)}&=\\left(3^{\\log_3(2)}\\right)^2\\\\9^{\\log_3(2)}&=2^2\\\\9^{\\log_3(2)}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q110",
        "type": "part",
        "label": "b",
        "prompt": "$5^{\\log_{25}(3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{3}$",
          "worked": "$$\\begin{align*}5^{\\log_{25}(3)}&=(25^{1/2})^{\\log_{25}(3)}\\\\5^{\\log_{25}(3)}&=\\left(25^{\\log_{25}(3)}\\right)^{1/2}\\\\5^{\\log_{25}(3)}&=3^{1/2}\\\\5^{\\log_{25}(3)}&=\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q111",
        "type": "part",
        "label": "c",
        "prompt": "$8^{\\log_2(5)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125$",
          "worked": "$$\\begin{align*}8^{\\log_2(5)}&=(2^3)^{\\log_2(5)}\\\\8^{\\log_2(5)}&=\\left(2^{\\log_2(5)}\\right)^3\\\\8^{\\log_2(5)}&=5^3\\\\8^{\\log_2(5)}&=125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q112",
        "type": "part",
        "label": "d",
        "prompt": "$4^{3\\log_4(3)}$",
