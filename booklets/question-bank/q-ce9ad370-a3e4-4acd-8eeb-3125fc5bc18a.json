  "content": {
    "id": "p45-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Consider the function $f(x)=x^2-4x$. Find the average rate of change over the following intervals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$x\\in[2,3]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{f(3)-f(2)}{3-2}&=\\frac{-3-(-4)}{1}\\\\\\frac{f(3)-f(2)}{3-2}&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p45-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\in[-2,5]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{f(5)-f(-2)}{5-(-2)}&=\\frac{5-12}{7}\\\\\\frac{f(5)-f(-2)}{5-(-2)}&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p45-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$x\\in[-4,-1]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9$",
          "worked": "$$\\begin{align*}\\frac{f(-1)-f(-4)}{-1-(-4)}&=\\frac{5-32}{3}\\\\\\frac{f(-1)-f(-4)}{-1-(-4)}&=-9.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
