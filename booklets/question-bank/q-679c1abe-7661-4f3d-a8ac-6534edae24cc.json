    "type": "question",
    "label": null,
    "prompt": "Given the cubic function $f(x)$ has single roots at $x=-2$, $x=1$, and $x=3$, and the graph of $y=f(x)$ has a $y$-intercept of $12$, find $f(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p81-q49-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "f(x)=2(x+2)(x-1)(x-3)",
                "display": false
              }
            ]
          },
          {
            "id": "p81-q49-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
