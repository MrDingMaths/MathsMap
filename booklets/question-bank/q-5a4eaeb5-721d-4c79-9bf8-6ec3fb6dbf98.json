                  {
                    "type": "math",
                    "latex": "\\cos^2\\theta=1-\\sin^2\\theta",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}2\\cos^2\\theta-1&=2(1-\\sin^2\\theta)-1\\\\2\\cos^2\\theta-1&=1-2\\sin^2\\theta\\end{align*}$$\nUsing $\\cos^2\\theta=1-\\sin^2\\theta$, the final expression is the RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q20-25-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\cos^2\\theta}{1+\\sin\\theta}+\\dfrac{\\cos^2\\theta}{1-\\sin\\theta}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p17-q23-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", for ",
