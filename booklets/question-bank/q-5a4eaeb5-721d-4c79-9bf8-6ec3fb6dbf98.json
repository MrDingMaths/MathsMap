                  {
                    "type": "math",
                    "latex": "\\sin^2\\theta+\\cos^2\\theta=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}(\\sin\\theta+\\cos\\theta)^2&=\\sin^2\\theta+2\\sin\\theta\\cos\\theta+\\cos^2\\theta\\\\(\\sin\\theta+\\cos\\theta)^2&=1+2\\sin\\theta\\cos\\theta\\end{align*}$$\nUsing $\\sin^2\\theta+\\cos^2\\theta=1$, the final expression is the RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q20-25-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1-\\cos\\theta}{\\sin^2\\theta}=\\dfrac{1}{1+\\cos\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
