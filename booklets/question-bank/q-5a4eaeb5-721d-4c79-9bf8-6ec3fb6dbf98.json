                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\tan\\theta",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", for ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\cos\\theta\\ne0",
                    "display": false
                  },
                  {
                    "type": "text",
