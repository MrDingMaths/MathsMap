                    "marks": []
                  }
                ]
              },
              {
                "id": "p17-q23-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Factor ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "1-\\sin^2\\theta",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " to reduce the fractions to ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "1-\\sin\\theta",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "1+\\sin\\theta",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The original denominators require $\\sin\\theta\\ne\\pm1$.\n$$\\begin{align*}\\frac{\\cos^2\\theta}{1+\\sin\\theta}+\\frac{\\cos^2\\theta}{1-\\sin\\theta}&=\\frac{(1-\\sin\\theta)(1+\\sin\\theta)}{1+\\sin\\theta}+\\frac{(1-\\sin\\theta)(1+\\sin\\theta)}{1-\\sin\\theta}\\\\\\frac{\\cos^2\\theta}{1+\\sin\\theta}+\\frac{\\cos^2\\theta}{1-\\sin\\theta}&=(1-\\sin\\theta)+(1+\\sin\\theta)\\\\\\frac{\\cos^2\\theta}{1+\\sin\\theta}+\\frac{\\cos^2\\theta}{1-\\sin\\theta}&=2\\end{align*}$$\nUsing $\\cos^2\\theta=1-\\sin^2\\theta$, the final expression is the RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
