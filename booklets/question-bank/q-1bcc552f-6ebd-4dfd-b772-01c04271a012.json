  "content": {
    "id": "p33-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "A bag contains 2 red balls and 1 blue ball. A ball is drawn with replacement from the bag until the blue ball is obtained. What is the expected number of balls drawn from the bag?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3$ balls.\n\nWith replacement, each red draw restarts the same experiment.",
      "worked": "Let $E$ be the expected number of draws, including the draw of the blue ball. A blue ball is drawn with probability $\\frac13$. A red ball is drawn with probability $\\frac23$; replacement leaves the expected number of additional draws equal to $E$.\n\n$$\\begin{align*}E&=\\frac13\\times1+\\frac23(1+E)\\\\E&=1+\\frac23E\\\\E-\\frac23E&=1\\\\\\frac13E&=1\\\\E&=3.\\end{align*}$$\n\nThe expected number of balls drawn is $3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
