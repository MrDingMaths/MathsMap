      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$R\\propto s$ and $s=7$ when $R=14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=2s$",
          "worked": "$$\\begin{align*}R&=ks\\\\14&=7k\\\\k&=2\\\\R&=2s\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$a$ is directly proportional to the square root of $b$ and $a=3$ when $b=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{3}{2}\\sqrt{b}$",
          "worked": "$$\\begin{align*}a&=k\\sqrt{b}\\\\3&=k\\sqrt{4}\\\\3&=2k\\\\k&=\\frac{3}{2}\\\\a&=\\frac{3}{2}\\sqrt{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$V$ is directly proportional to $r^3$ and $V=216$ when $r=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=8r^3$",
          "worked": "$$\\begin{align*}V&=kr^3\\\\216&=k\\times3^3\\\\216&=27k\\\\k&=8\\\\V&=8r^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
