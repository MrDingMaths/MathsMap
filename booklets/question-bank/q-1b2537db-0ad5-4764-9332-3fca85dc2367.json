      {
        "id": "p23-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $Q=x^2+y^2$ and $x+y=8$, write $Q$ as a function of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(x)=2x^2-16x+64$.",
          "worked": "$$\\begin{align*}y&=8-x\\\\Q(x)&=x^2+(8-x)^2\\\\Q(x)&=2x^2-16x+64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p23-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\dfrac{dQ}{dx}$ and hence determine the value of $x$ that minimises $Q$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dQ}{dx}=4x-16$; $Q$ is minimised when $x=4$.",
