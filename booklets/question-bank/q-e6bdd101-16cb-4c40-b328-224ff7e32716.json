      {
        "id": "p5-p2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{a+\\frac{1}{a}}{a-\\frac{1}{a}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^2+1}{a^2-1}$",
          "worked": "$$\\begin{align*}\\frac{a+\\frac{1}{a}}{a-\\frac{1}{a}}&=\\frac{a\\left(a+\\frac{1}{a}\\right)}{a\\left(a-\\frac{1}{a}\\right)}\\\\&=\\frac{a^2+1}{a^2-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-p2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\frac{a}{b}+\\frac{b}{a}}{\\frac{a}{b}-\\frac{b}{a}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^2+b^2}{a^2-b^2}$",
          "worked": "Multiply the numerator and denominator by $ab$.\n\n$$\\begin{align*}\\frac{\\frac{a}{b}+\\frac{b}{a}}{\\frac{a}{b}-\\frac{b}{a}}&=\\frac{\\frac{a^2b}{b}+\\frac{ab^2}{a}}{\\frac{a^2b}{b}-\\frac{ab^2}{a}}\\\\&=\\frac{a^2+b^2}{a^2-b^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
