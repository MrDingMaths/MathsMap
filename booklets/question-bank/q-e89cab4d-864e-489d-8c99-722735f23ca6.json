  "content": {
    "id": "p11-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Jake shares his liquorice strap equally between himself and five friends. If the strap is $1\\frac{2}{3}$ metres long, how much will each person get?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{18}\\text{ m}$",
      "worked": "There are $1+5=6$ people.\n$$\\begin{align*}1\\frac{2}{3}\\div6&=\\frac{5}{3}\\div6\\\\1\\frac{2}{3}\\div6&=\\frac{5}{3}\\times\\frac{1}{6}\\\\1\\frac{2}{3}\\div6&=\\frac{5}{18}\\end{align*}$$\nEach person gets $\\frac{5}{18}$ metre.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
