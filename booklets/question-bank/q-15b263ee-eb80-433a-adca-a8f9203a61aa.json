  "content": {
    "id": "p64-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Solve for $x$ without long division by factorising first.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p64-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^3-x^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,1$",
          "worked": "$$\\begin{aligned}x^3-x^2&=0\\\\x^2(x-1)&=0\\end{aligned}$$\nBy the null factor law, $x^2=0$ or $x-1=0$. Hence $x=0,1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p64-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^3-x^2-12x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,0,4$",
          "worked": "$$\\begin{aligned}x^3-x^2-12x&=0\\\\x(x^2-x-12)&=0\\\\x(x-4)(x+3)&=0\\end{aligned}$$\nBy the null factor law, $x=0$, $x=4$ or $x=-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p64-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x^5+4x^4+2x^3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,0$",
          "worked": "$$\\begin{aligned}2x^5+4x^4+2x^3&=0\\\\2x^3(x^2+2x+1)&=0\\\\2x^3(x+1)^2&=0\\end{aligned}$$\nBy the null factor law, $x^3=0$ or $(x+1)^2=0$. Hence $x=0,-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
