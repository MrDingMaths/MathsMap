  "content": {
    "id": "v2-a2942-p15-practice-slot-5-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Show that the gradient of the curve $y=\\dfrac{\\tan^{-1}(2x)}{x}$ at the point where $x=\\dfrac12$ is $2-\\pi$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2-\\pi$",
      "worked": "By the quotient rule,\n$$\\begin{align*}\\frac{dy}{dx}&=\\frac{\\dfrac{2}{1+4x^2}\\cdot x-\\tan^{-1}(2x)}{x^2}.\\end{align*}$$\nAt $x=\\dfrac12$, $1+4x^2=2$ and $\\tan^{-1}(1)=\\dfrac\\pi4$.\n$$\\begin{align*}\\left.\\frac{dy}{dx}\\right|_{x=1/2}&=\\frac{1\\cdot\\dfrac12-\\dfrac\\pi4}{\\dfrac14}\\\\&=4\\left(\\frac12-\\frac\\pi4\\right)\\\\&=2-\\pi.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
