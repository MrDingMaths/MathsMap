  "content": {
    "id": "p20-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "What is the greatest value of the function $y=3-2\\sin x$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5$.",
      "worked": "The minimum value of $\\sin x$ is $-1$. Since its coefficient is negative, this gives the greatest value of $y$.\n$$\\begin{align*}y_{\\max}&=3-2(-1)\\\\y_{\\max}&=5\\end{align*}$$",
      "solutionDiagrams": []
    },
