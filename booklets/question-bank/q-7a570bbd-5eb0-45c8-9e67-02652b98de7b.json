  "content": {
    "id": "p17-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the greatest common divisor and the least common multiple of the numbers $48$, $66$ and $72$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\mathrm{GCD}=6,\\quad\\mathrm{LCM}=1584$",
      "worked": "$$\\begin{align*}48&=2^4\\times3\\\\66&=2\\times3\\times11\\\\72&=2^3\\times3^2\\\\\\mathrm{GCD}(48,66,72)&=2\\times3\\\\\\mathrm{GCD}(48,66,72)&=6\\\\\\mathrm{LCM}(48,66,72)&=2^4\\times3^2\\times11\\\\\\mathrm{LCM}(48,66,72)&=1584\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
