  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Suppose that $\\cos 2\\theta=\\frac14$. Find the possible values of $\\cos\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\cos\\theta=\\pm\\sqrt{\\frac58}$",
      "worked": "$$\\begin{align*}\\cos 2\\theta&=2\\cos^2\\theta-1\\\\2\\cos^2\\theta&=1+\\frac14\\\\\\cos^2\\theta&=\\frac58\\\\\\cos\\theta&=\\pm\\sqrt{\\frac58}\\end{align*}$$\nBoth signs are possible because no quadrant is specified.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
