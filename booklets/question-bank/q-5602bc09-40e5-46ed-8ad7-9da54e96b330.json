  "content": {
    "id": "p20-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "For which integer values of $k$ does $\\dfrac{x^2+kx+12}{x+3}$ simplify to a linear expression?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=7$",
      "worked": "$x+3$ must be a factor of the numerator. Write\n$$\\begin{align*}x^2+kx+12&=(x+3)(x+c)\\\\x^2+kx+12&=x^2+(c+3)x+3c\\\\3c&=12\\\\c&=4\\\\k&=4+3=7\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
