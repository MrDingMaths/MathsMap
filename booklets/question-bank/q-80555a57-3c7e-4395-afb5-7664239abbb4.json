    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q16-explanation",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $12^n=(2^2\\times3)^n=2^{2n}\\times3^n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Since $12=2^2\\times3$, apply the power-of-a-product law, then multiply the indices in $(2^2)^n$.",
          "worked": "Since $12=2^2\\times3$, raise each prime factor to the power $n$ and multiply the indices of a power raised to a power.\n$$\\begin{align*}12^n&=(2^2\\times3)^n\\\\12^n&=(2^2)^n\\times3^n\\\\12^n&=2^{2n}\\times3^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p8-q16-expressions",
        "type": "group",
        "label": "",
        "prompt": "Using similar methods, write these expressions with prime bases and simplify them.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q16-a",
            "type": "part",
            "label": "b",
            "prompt": "$2^n\\times4^n\\times8^n$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{6n}$",
              "worked": "$$\\begin{align*}2^n\\times4^n\\times8^n&=2^n\\times(2^2)^n\\times(2^3)^n\\\\2^n\\times4^n\\times8^n&=2^{n+2n+3n}\\\\2^n\\times4^n\\times8^n&=2^{6n}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p8-q16-b",
            "type": "part",
            "label": "c",
            "prompt": "$\\dfrac{9^{n+2}\\times3^{n+1}}{3\\times27^n}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$81$",
              "worked": "$$\\begin{align*}\\frac{9^{n+2}\\times3^{n+1}}{3\\times27^n}&=\\frac{(3^2)^{n+2}\\times3^{n+1}}{3\\times(3^3)^n}\\\\\\frac{9^{n+2}\\times3^{n+1}}{3\\times27^n}&=3^{2n+4+n+1-1-3n}\\\\\\frac{9^{n+2}\\times3^{n+1}}{3\\times27^n}&=3^4\\\\\\frac{9^{n+2}\\times3^{n+1}}{3\\times27^n}&=81\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p8-q16-c",
            "type": "part",
            "label": "d",
            "prompt": "$6^x\\times4^x\\div3^x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{3x}$",
              "worked": "$$\\begin{align*}6^x\\times4^x\\div3^x&=(2\\times3)^x\\times(2^2)^x\\div3^x\\\\6^x\\times4^x\\div3^x&=2^{x+2x}3^{x-x}\\\\6^x\\times4^x\\div3^x&=2^{3x}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p8-q16-d",
            "type": "part",
            "label": "e",
            "prompt": "$\\dfrac{12^x\\times18^x}{3^x\\times2^x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{2x}3^{2x}$",
              "worked": "$$\\begin{align*}\\frac{12^x\\times18^x}{3^x\\times2^x}&=\\frac{(2^2\\times3)^x(2\\times3^2)^x}{3^x2^x}\\\\\\frac{12^x\\times18^x}{3^x\\times2^x}&=2^{2x+x-x}3^{x+2x-x}\\\\\\frac{12^x\\times18^x}{3^x\\times2^x}&=2^{2x}3^{2x}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p8-q16-e",
            "type": "part",
            "label": "f",
            "prompt": "$100^{2n-1}\\times25^{-1}\\times8^{-1}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{4n-5}5^{4n-4}$",
              "worked": "$$\\begin{align*}100^{2n-1}\\times25^{-1}\\times8^{-1}&=(2^2\\times5^2)^{2n-1}(5^2)^{-1}(2^3)^{-1}\\\\100^{2n-1}\\times25^{-1}\\times8^{-1}&=2^{4n-2-3}5^{4n-2-2}\\\\100^{2n-1}\\times25^{-1}\\times8^{-1}&=2^{4n-5}5^{4n-4}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p8-q16-f",
            "type": "part",
            "label": "g",
            "prompt": "$\\dfrac{24^{x+1}\\times8^{-1}}{6^{2x}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^x3^{1-x}$",
              "worked": "$$\\begin{align*}\\frac{24^{x+1}\\times8^{-1}}{6^{2x}}&=\\frac{(2^3\\times3)^{x+1}(2^3)^{-1}}{(2\\times3)^{2x}}\\\\\\frac{24^{x+1}\\times8^{-1}}{6^{2x}}&=2^{3x+3-3-2x}3^{x+1-2x}\\\\\\frac{24^{x+1}\\times8^{-1}}{6^{2x}}&=2^x3^{1-x}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      }
    ]
