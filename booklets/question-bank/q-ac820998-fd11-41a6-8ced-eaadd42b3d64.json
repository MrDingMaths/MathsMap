    "label": "3",
    "prompt": "True or False? Let $x,y\\geq0$.\n$$\\sqrt{\\frac{x}{y}}=\\frac{\\sqrt{x}}{\\sqrt{y}}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
