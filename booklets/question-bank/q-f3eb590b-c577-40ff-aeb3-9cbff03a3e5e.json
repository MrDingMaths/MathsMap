        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=3$, $c=4$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p38-q8a-worked-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "x intercepts at ",
                    "marks": [],
