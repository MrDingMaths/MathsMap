        "children": [],
        "answer": {
          "short": "$y=-x^2-9x-14$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p38-q8b-worked-replacement",
                "type": "paragraph",
