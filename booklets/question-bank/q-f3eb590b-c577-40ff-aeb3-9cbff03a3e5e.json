  "content": {
    "id": "p38-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "$y=-x^2+bx+c$ has $x$ intercepts $-1$ and $4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q8a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $b$ and $c$.",
