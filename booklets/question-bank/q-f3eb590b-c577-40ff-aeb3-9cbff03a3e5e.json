              },
              {
                "id": "p38-q8a-worked-equations",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned} \\therefore\\ y&=-(x+1)(x-4)\\\\ y&=-(x^2-3x-4)\\\\ y&=-x^2+3x+4 \\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
