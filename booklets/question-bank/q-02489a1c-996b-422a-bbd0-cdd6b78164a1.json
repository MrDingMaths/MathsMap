    "children": [
      {
        "id": "p24-q6a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can eight identical sweets be distributed among three children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45$",
          "worked": "Represent the sweets by 8 identical stars and separate the three children’s shares using 2 identical bars. Empty shares are allowed, so choose the positions of the bars among the 10 symbols.\n\n$$\\begin{align*}\\text{Number of distributions}&=\\binom{10}{2}\\\\\\text{Number of distributions}&=45.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q6b",
        "type": "part",
        "label": "b",
        "prompt": "How many ways can this be done so that each child receives at least one sweet?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21$",
          "worked": "There are 7 gaps between the 8 stars. Choose 2 distinct gaps for the bars so that all three shares contain at least one sweet.\n\n$$\\begin{align*}\\text{Number of distributions}&=\\binom{7}{2}\\\\\\text{Number of distributions}&=21.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
