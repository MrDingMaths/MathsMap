        "id": "p33-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\int_1^2 \\frac{1+x^2}{x^2}\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{2}$",
          "worked": "$$\\begin{align*}\\int_1^2\\frac{1+x^2}{x^2}\\,dx&=\\int_1^2(x^{-2}+1)\\,dx\\\\&=\\left[-\\frac{1}{x}+x\\right]_1^2\\\\&=\\left(-\\frac12+2\\right)-(-1+1)\\\\&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\int_{-2}^{-1} \\frac{1+2x}{x^3}\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "$$\\begin{align*}\\int_{-2}^{-1}\\frac{1+2x}{x^3}\\,dx&=\\int_{-2}^{-1}(x^{-3}+2x^{-2})\\,dx\\\\&=\\left[-\\frac{1}{2x^2}-\\frac{2}{x}\\right]_{-2}^{-1}\\\\&=\\left(-\\frac12+2\\right)-\\left(-\\frac18+1\\right)\\\\&=\\frac32-\\frac78\\\\&=\\frac58\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
