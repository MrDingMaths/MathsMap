    "type": "question",
    "label": "3",
    "prompt": "Which term of the sequence $25,18,11,\\ldots$ is equal to $-73$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "The 15th term.",
      "worked": "$a=25$, $d=-7$.\n$$\\begin{align*}a_n&=a+(n-1)d\\\\-73&=25+(n-1)(-7)\\\\-98&=-7(n-1)\\\\14&=n-1\\\\n&=15\\end{align*}$$\nTherefore, $-73$ is the 15th term.",
      "solutionDiagrams": []
    },
