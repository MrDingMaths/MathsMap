  "content": {
    "id": "p16-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "One side and the hypotenuse of a right-angled triangle have lengths 2 and 3, respectively. Find the length of the third side.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt{5}$",
      "worked": "Let the third side have length $x$.\n$$\\begin{align*}x^2+2^2&=3^2\\\\x^2&=9-4\\\\x^2&=5\\\\x&=\\sqrt{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
