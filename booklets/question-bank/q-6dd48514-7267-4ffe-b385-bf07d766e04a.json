  "content": {
    "id": "p13-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "$P(x)=ax^4+bx^3$. If $P(1)=3$ and $P(-2)=96$, use simultaneous equations to find $a$ and $b$ and hence find the polynomial.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=5$, $b=-2$; $P(x)=5x^4-2x^3$.",
      "worked": "$$\\begin{align*}P(1)&=a+b\\\\a+b&=3\\qquad(1)\\\\P(-2)&=a(-2)^4+b(-2)^3\\\\16a-8b&=96\\\\2a-b&=12\\qquad(2)\\end{align*}$$\nAdding equations (1) and (2):\n$$\\begin{align*}3a&=15\\\\a&=5\\\\b&=3-5\\\\&=-2\\\\P(x)&=5x^4-2x^3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 96
  },
