  "content": {
    "id": "v2-7db36c-p9-practice-slot-2-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify these algebraic fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-7db36c-p9-practice-slot-2-lower-slot-2-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2x+1}{3x}+\\dfrac{1}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x+2}{6x}$",
          "worked": "$$\\begin{align*}\\frac{2x+1}{3x}+\\frac{1}{6}&=\\frac{2(2x+1)}{6x}+\\frac{x}{6x}\\\\&=\\frac{2(2x+1)+x}{6x}\\\\&=\\frac{4x+2+x}{6x}\\\\&=\\frac{5x+2}{6x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-7db36c-p9-practice-slot-2-lower-slot-2-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{a+3}{2a}+\\dfrac{a-1}{4a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3a+5}{4a}$",
          "worked": "$$\\begin{align*}\\frac{a+3}{2a}+\\frac{a-1}{4a}&=\\frac{2(a+3)}{4a}+\\frac{a-1}{4a}\\\\&=\\frac{2(a+3)+a-1}{4a}\\\\&=\\frac{2a+6+a-1}{4a}\\\\&=\\frac{3a+5}{4a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-7db36c-p9-practice-slot-2-lower-slot-2-lower-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3b-2}{5b}+\\dfrac{b+4}{2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11b+16}{10b}$",
          "worked": "$$\\begin{align*}\\frac{3b-2}{5b}+\\frac{b+4}{2b}&=\\frac{2(3b-2)}{10b}+\\frac{5(b+4)}{10b}\\\\&=\\frac{2(3b-2)+5(b+4)}{10b}\\\\&=\\frac{6b-4+5b+20}{10b}\\\\&=\\frac{11b+16}{10b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-7db36c-p9-practice-slot-2-lower-slot-2-lower-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{y+3}{3y}-\\dfrac{y-2}{4y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y+18}{12y}$",
          "worked": "$$\\begin{align*}\\frac{y+3}{3y}-\\frac{y-2}{4y}&=\\frac{4(y+3)}{12y}-\\frac{3(y-2)}{12y}\\\\&=\\frac{4(y+3)-3(y-2)}{12y}\\\\&=\\frac{4y+12-3y+6}{12y}\\\\&=\\frac{y+18}{12y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
