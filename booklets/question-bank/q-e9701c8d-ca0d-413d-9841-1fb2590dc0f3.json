    "id": "p48-q6",
    "type": "question",
    "label": "6",
    "prompt": "Find any values of $k$ for which the quadratic equation $x^2+kx+1=0$ has one solution.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\pm2$",
      "worked": "Exactly one real solution requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=k^2-4(1)(1)\\\\0&=k^2-4\\\\k^2&=4\\\\k&=\\pm2\\end{align*}$$",
      "solutionDiagrams": []
    },
