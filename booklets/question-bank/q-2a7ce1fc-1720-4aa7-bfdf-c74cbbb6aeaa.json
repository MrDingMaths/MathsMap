      "evidence": ".booklet-work/reasoning-ratings/calls/polynomials-v1/63e4aa805e26596c7c630d467b9acc984332e0b081415edb0cefa732c3f819ab-1792561080882/last-message.txt"
    }
  },
  "content": {
    "id": "p53-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Without division, find which of the following are factors of $F(x)=x^3+4x^2+x-6$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{aligned}F(1)&=1^3+4(1)^2+1-6\\\\&=0\\end{aligned}$$\nTherefore $x-1$ is a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p53-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{aligned}F(-1)&=(-1)^3+4(-1)^2+(-1)-6\\\\&=-4\\ne0\\end{aligned}$$\nTherefore $x+1$ is not a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p53-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{aligned}F(2)&=2^3+4(2)^2+2-6\\\\&=20\\ne0\\end{aligned}$$\nTherefore $x-2$ is not a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p53-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{aligned}F(-2)&=(-2)^3+4(-2)^2+(-2)-6\\\\&=0\\end{aligned}$$\nTherefore $x+2$ is a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p53-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{aligned}F(3)&=3^3+4(3)^2+3-6\\\\&=60\\ne0\\end{aligned}$$\nTherefore $x-3$ is not a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p53-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{aligned}F(-3)&=(-3)^3+4(-3)^2+(-3)-6\\\\&=0\\end{aligned}$$\nTherefore $x+3$ is a factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
