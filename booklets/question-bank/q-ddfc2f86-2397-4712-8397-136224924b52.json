  "content": {
    "id": "p31-q19-24-root",
    "type": "question",
    "label": null,
    "prompt": "Find the domain of the following functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q19",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\log(x^2-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,-2)\\cup(2,\\infty)$",
          "worked": "The logarithmic argument must be positive.\n\n$$\\begin{align*}x^2-4&>0\\\\(x-2)(x+2)&>0\\end{align*}$$\n\nThe product is positive outside its zeros, so $x<-2$ or $x>2$.\n\nDomain: $(-\\infty,-2)\\cup(2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p31-q20",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\log(x^2-3x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,1)\\cup(2,\\infty)$",
          "worked": "The logarithmic argument must be positive.\n\n$$\\begin{align*}x^2-3x+2&>0\\\\(x-1)(x-2)&>0\\end{align*}$$\n\nThe product is positive outside its zeros, so $x<1$ or $x>2$.\n\nDomain: $(-\\infty,1)\\cup(2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p31-q21",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\log(9x^2-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\infty,-\\dfrac13\\right)\\cup\\left(\\dfrac13,\\infty\\right)$",
          "worked": "The logarithmic argument must be positive.\n\n$$\\begin{align*}9x^2-1&>0\\\\(3x-1)(3x+1)&>0\\end{align*}$$\n\nThe product is positive outside its zeros, so $x<-\\frac13$ or $x>\\frac13$.\n\nDomain: $\\left(-\\infty,-\\frac13\\right)\\cup\\left(\\frac13,\\infty\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p31-q22",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\log(x^2+3x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,-4)\\cup(1,\\infty)$",
          "worked": "The logarithmic argument must be positive.\n\n$$\\begin{align*}x^2+3x-4&>0\\\\(x+4)(x-1)&>0\\end{align*}$$\n\nThe product is positive outside its zeros, so $x<-4$ or $x>1$.\n\nDomain: $(-\\infty,-4)\\cup(1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p31-q23",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\log(x-2)+\\log(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,\\infty)$",
          "worked": "Both original logarithmic arguments must be positive.\n\n$$\\begin{align*}x-2&>0\\\\x&>2\\\\x+2&>0\\\\x&>-2\\end{align*}$$\n\nBoth restrictions hold when $x>2$.\n\nDomain: $(2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p31-q24",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\log(x+3)+\\log(x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,\\infty)$",
          "worked": "Both original logarithmic arguments must be positive.\n\n$$\\begin{align*}x+3&>0\\\\x&>-3\\\\x-1&>0\\\\x&>1\\end{align*}$$\n\nBoth restrictions hold when $x>1$.\n\nDomain: $(1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
