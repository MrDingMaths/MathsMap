        "answer": {
          "short": "In increasing order of $n$: $100,\\ 265,\\ 704,\\ 1868,\\ 4956,\\ 13150$ dollars per kilogram.",
          "worked": "$$\\begin{align*}P(0)&=100(1.05)^0=100\\\\P(20)&=100(1.05)^{20}\\approx265\\\\P(40)&=100(1.05)^{40}\\approx704\\\\P(60)&=100(1.05)^{60}\\approx1868\\\\P(80)&=100(1.05)^{80}\\approx4956\\\\P(100)&=100(1.05)^{100}\\approx13150\\end{align*}$$\nPrices are in dollars per kilogram, rounded to the nearest whole number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
