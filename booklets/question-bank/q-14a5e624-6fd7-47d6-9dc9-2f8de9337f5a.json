        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\cos^2\\theta}{1+\\sin\\theta}=1-\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1-\\sin\\theta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{1-\\sin^2\\theta}{1+\\sin\\theta}\\\\&=\\frac{(1-\\sin\\theta)(1+\\sin\\theta)}{1+\\sin\\theta}\\\\&=1-\\sin\\theta\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-47f22-p31-practice-slot-19-slot-19-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\tan^2\\theta}{\\sec\\theta+1}=\\sec\\theta-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sec\\theta-1=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sec^2\\theta-1}{\\sec\\theta+1}\\\\&=\\frac{(\\sec\\theta-1)(\\sec\\theta+1)}{\\sec\\theta+1}\\\\&=\\sec\\theta-1\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
