              "text": "A box of chocolates contains 3 Freddo Frogs and 1 Caramello Koala.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Two chocolates are taken out of the box ",
              "marks": []
            },
            {
              "type": "text",
              "text": "without replacement",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
