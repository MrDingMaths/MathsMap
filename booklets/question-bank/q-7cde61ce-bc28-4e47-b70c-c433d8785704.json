    "children": [
      {
        "id": "p21-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "If the first chocolate was a Freddo Frog, what is the probability the second chocolate is a Freddo Frog?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "There are 2 Freddo Frogs among the 3 chocolates remaining.\n$$P(\\text{second is a Freddo Frog})=\\frac{2}{3}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If the first chocolate was a Freddo Frog, what is the probability the second chocolate is a Caramello Koala?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "There is 1 Caramello Koala among the 3 chocolates remaining.\n$$P(\\text{second is a Caramello Koala})=\\frac{1}{3}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "If the first chocolate was a Caramello Koala, what is the probability the second chocolate is a Freddo Frog?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "All 3 chocolates remaining are Freddo Frogs.\n$$\\begin{align*}P(\\text{second is a Freddo Frog})&=\\frac{3}{3}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p21-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "If the first chocolate was a Caramello Koala, what is the probability the second chocolate is a Caramello Koala?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No Caramello Koalas remain among the 3 chocolates.\n$$\\begin{align*}P(\\text{second is a Caramello Koala})&=\\frac{0}{3}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
