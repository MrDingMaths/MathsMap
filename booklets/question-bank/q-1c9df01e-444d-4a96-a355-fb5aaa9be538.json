  "content": {
    "id": "v2-42e3a-p45-practice-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "It is given that $\\theta$ is an acute angle and that $\\sin\\theta=\\dfrac{\\sqrt{7}}{4}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-42e3a-p45-practice-slot-13-slot-13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Draw a right-angled triangle to show this information.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A right-angled triangle with opposite side $\\sqrt{7}$ and hypotenuse $4$, relative to $\\theta$.",
          "worked": "$\\sin\\theta=\\dfrac{\\text{opposite}}{\\text{hypotenuse}}=\\dfrac{\\sqrt{7}}{4}$. Label the side opposite $\\theta$ as $\\sqrt{7}$ and the hypotenuse as $4$.",
          "solutionDiagrams": [
            {
              "id": "v2-42e3a-p45-practice-slot-13-slot-13-q-a-solution-triangle",
              "role": "solution",
              "format": "tikz",
              "code": "\\begin{tikzpicture}[x=1.2cm,y=1.2cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\usetikzlibrary{calc,angles,quotes}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (3,0);\n\\coordinate (C) at (3,{sqrt(7)});\n\\draw[black] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.4pt] ($(B)!0.10!(A)$)--($($(B)!0.10!(A)$)+($(B)!0.10!(C)$)-(B)$)--($(B)!0.10!(C)$);\n\\path (B)--(C) node[midway,right] {$\\sqrt{7}$};\n\\path (A)--(C) node[midway,above left] {$4$};\n\\pic[draw=black,line width=0.4pt,angle radius=7mm,angle eccentricity=1.35,\"$\\theta$\"] {angle=B--A--C};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 45,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "derived": false
            }
          ]
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-42e3a-p45-practice-slot-13-slot-13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use Pythagoras’ theorem to find the length of the unknown side.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}a^2+(\\sqrt{7})^2&=4^2\\\\a^2+7&=16\\\\a^2&=9\\\\a&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-42e3a-p45-practice-slot-13-slot-13-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence write the exact values of $\\cos\\theta$ and $\\tan\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta=\\dfrac{3}{4},\\quad\\tan\\theta=\\dfrac{\\sqrt{7}}{3}$",
          "worked": "$$\\begin{align*}\\cos\\theta&=\\frac{\\text{adjacent}}{\\text{hypotenuse}}\\\\\\cos\\theta&=\\frac{3}{4}\\\\\\tan\\theta&=\\frac{\\text{opposite}}{\\text{adjacent}}\\\\\\tan\\theta&=\\frac{\\sqrt{7}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-42e3a-p45-practice-slot-13-slot-13-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $\\tan\\theta=\\dfrac{\\sin\\theta}{\\cos\\theta}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sin\\theta}{\\cos\\theta}=\\dfrac{\\sqrt{7}}{4}\\div\\dfrac{3}{4}=\\dfrac{\\sqrt{7}}{3}=\\tan\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\sin\\theta}{\\cos\\theta}&=\\frac{\\sqrt{7}}{4}\\div\\frac{3}{4}\\\\\\frac{\\sin\\theta}{\\cos\\theta}&=\\frac{\\sqrt{7}}{4}\\times\\frac{4}{3}\\\\\\frac{\\sin\\theta}{\\cos\\theta}&=\\frac{\\sqrt{7}}{3}\\\\\\frac{\\sin\\theta}{\\cos\\theta}&=\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
