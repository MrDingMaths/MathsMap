  "content": {
    "id": "p8-prob-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The letter tiles that make up the word MATHEMATICS are put in a sack together with the letter tiles for the word FOOTBALL. There are a total of 19 tiles. A tile is drawn. What is the probability of obtaining:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-prob-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "an M?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac2{19}$",
          "worked": "There are 2 M tiles among 19 tiles, so $P(\\text{M})=\\frac2{19}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-prob-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "an A?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{19}$",
          "worked": "MATHEMATICS has 2 A tiles and FOOTBALL has 1.\n\n$$P(\\text{A})=\\frac{2+1}{19}=\\frac3{19}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-prob-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "an F?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{19}$",
          "worked": "There is 1 F tile among 19 tiles, so $P(\\text{F})=\\frac1{19}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-prob-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "a vowel?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac7{19}$",
          "worked": "MATHEMATICS has 4 vowels (A, E, A, I); FOOTBALL has 3 (O, O, A).\n\n$$P(\\text{vowel})=\\frac{4+3}{19}=\\frac7{19}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-prob-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "a consonant?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12}{19}$",
          "worked": "There are $19-7=12$ consonant tiles.\n\n$$P(\\text{consonant})=\\frac{12}{19}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-prob-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "a letter other than an M?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{19}$",
          "worked": "There are $19-2=17$ tiles other than M.\n\n$$P(\\text{not M})=\\frac{17}{19}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-prob-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "an M or an A?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac5{19}$",
          "worked": "There are $2+3=5$ M or A tiles.\n\n$$P(\\text{M or A})=\\frac5{19}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
