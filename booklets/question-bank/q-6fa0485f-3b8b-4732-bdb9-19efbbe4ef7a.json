  "content": {
    "id": "p25-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A shop has a discount sale that marks down all prices by $20\\%$. If a customer buys a jacket originally marked at $\\$90$, how much does he pay?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$72$",
      "worked": "$$\\begin{align*}\\text{Discount} &= \\frac{20}{100}\\times\\$90\\\\\\text{Discount} &= \\$18\\\\\\text{Price paid} &= \\$90-\\$18\\\\\\text{Price paid} &= \\$72\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
