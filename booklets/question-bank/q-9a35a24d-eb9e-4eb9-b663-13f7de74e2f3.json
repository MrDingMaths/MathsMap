      {
        "id": "v2-4eaff-p29-practice-slot-19-slot-19-q-a",
        "type": "part",
        "label": "a",
        "prompt": "For what values of $k$ is $y=x^3-kx^2+5x+1$ concave down at the point where $x=2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k>6$",
          "worked": "$$\\begin{align*}y'&=3x^2-2kx+5\\\\y''&=6x-2k\\end{align*}$$\nConcave down at $x=2$: $y''(2)<0$\n$$\\begin{align*}6(2)-2k&<0\\\\12-2k&<0\\\\k&>6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-4eaff-p29-practice-slot-19-slot-19-q-b",
        "type": "part",
        "label": "b",
        "prompt": "For what values of $b$ is $y=2x^3+3bx^2-4x+7$ concave up at the point where $x=-2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b>4$",
          "worked": "$$\\begin{align*}y'&=6x^2+6bx-4\\\\y''&=12x+6b\\end{align*}$$\nConcave up at $x=-2$: $y''(-2)>0$\n$$\\begin{align*}12(-2)+6b&>0\\\\-24+6b&>0\\\\b&>4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
