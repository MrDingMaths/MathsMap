      {
        "id": "p14-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Convert $80\\text{ km/h}$ into metres per second.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{200}{9}\\text{ m/s}$",
          "worked": "$$\\begin{align*}80\\text{ km/h}&=80000\\text{ m/h}\\\\80\\text{ km/h}&=\\frac{80000}{60}\\text{ m/min}\\\\80\\text{ km/h}&=\\frac{80000}{60\\times60}\\text{ m/s}\\\\80\\text{ km/h}&=\\frac{200}{9}\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p14-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Convert $25\\text{ m/s}$ into kilometres per hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90\\text{ km/h}$",
          "worked": "$$\\begin{align*}25\\text{ m/s}&=25\\times60\\text{ m/min}\\\\25\\text{ m/s}&=25\\times60\\times60\\text{ m/h}\\\\25\\text{ m/s}&=\\frac{25\\times60\\times60}{1000}\\text{ km/h}\\\\25\\text{ m/s}&=90\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
