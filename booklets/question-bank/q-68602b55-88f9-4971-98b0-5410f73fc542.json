    "type": "question",
    "label": "11",
    "prompt": "A breakfast cereal contains $23\\frac{1}{2}\\%$ oats, by weight. What is the weight of oats in a package of cereal containing $1500\\text{ g}$ of the cereal?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$352.5\\text{ g}$",
      "worked": "$$\\begin{align*}\\text{Weight of oats}&=\\frac{23\\frac{1}{2}}{100}\\times1500\\text{ g}\\\\\\text{Weight of oats}&=\\frac{47}{200}\\times1500\\text{ g}\\\\\\text{Weight of oats}&=352.5\\text{ g}\\end{align*}$$",
      "solutionDiagrams": []
    },
