        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.\\dot{2}\\dot{7}$",
          "worked": "Dividing 3 by 11 gives 27 repeatedly.\n\n$$\\begin{align*}\\frac{3}{11}&=0.272727\\ldots\\\\\\frac{3}{11}&=0.\\dot{2}\\dot{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
