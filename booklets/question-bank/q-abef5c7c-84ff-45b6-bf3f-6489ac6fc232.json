  "content": {
    "id": "p6-q30-response",
    "type": "question",
    "label": "",
    "prompt": "Mary is standing $25\\text{ m}$ from the base of a tower on horizontal ground and observes an angle of elevation of $55^\\circ$ to its top. Bob stands elsewhere on the same horizontal ground and observes an angle of elevation of $40^\\circ$ to the top. How far is Bob from the base of the tower? Give your answer correct to two decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p6-q30-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\frac{25\\tan55^\\circ}{\\tan40^\\circ}\\text{ m}\\approx42.55\\text{ m}",
                "display": false
              }
            ]
          },
          {
            "id": "p6-q30-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Use tangent to find the common tower height, then use Bob's angle to find his distance.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Let $h$ metres be the tower height and $x$ metres be Bob's distance from the base.\n$$\\begin{align*}\\tan55^\\circ&=\\frac{h}{25}\\\\h&=25\\tan55^\\circ\\\\\\tan40^\\circ&=\\frac{h}{x}\\\\x&=\\frac{h}{\\tan40^\\circ}\\\\x&=\\frac{25\\tan55^\\circ}{\\tan40^\\circ}\\\\x&\\approx42.55\\end{align*}$$\nBob is $42.55\\text{ m}$ from the base, correct to two decimal places.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
