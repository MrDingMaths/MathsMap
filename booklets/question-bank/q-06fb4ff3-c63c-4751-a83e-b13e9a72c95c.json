  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Identify the $y$-intercept in each of these lines.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x + y = 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{aligned}y &= -x\\\\c &= 0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$2y = 8 - 4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{aligned}y &= -2x + 4\\\\c &= 4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$100y = 20x + 300$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{aligned}y &= \\frac{1}{5}x + 3\\\\c &= 3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$7 = 15x + y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{aligned}y &= -15x + 7\\\\c &= 7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$60y = x + 60$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}y &= \\frac{1}{60}x + 1\\\\c &= 1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$-15x + y = 17$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17$",
          "worked": "$$\\begin{aligned}y &= 15x + 17\\\\c &= 17\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$3(2x + 5) = 6y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{2}$",
          "worked": "$$\\begin{aligned}6y &= 6x + 15\\\\y &= x + \\frac{5}{2}\\\\c &= \\frac{5}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$2y = 5(11 - 6x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{55}{2}$",
          "worked": "$$\\begin{aligned}2y &= 55 - 30x\\\\y &= -15x + \\frac{55}{2}\\\\c &= \\frac{55}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
