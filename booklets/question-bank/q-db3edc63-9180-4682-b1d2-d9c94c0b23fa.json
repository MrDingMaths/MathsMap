  "content": {
    "id": "p4-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "$Q=8t-t^2$",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $Q$ when $t=1$ and $t=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$ and $15$, respectively.",
          "worked": "$$\\begin{aligned}Q(1)&=8(1)-1^2=7\\\\Q(3)&=8(3)-3^2=15\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the average rate of change from $t=1$ to $t=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$.",
          "worked": "$$\\begin{aligned}\\text{Average rate of change}&=\\frac{Q(3)-Q(1)}{3-1}\\\\&=\\frac{15-7}{2}\\\\&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Similarly find the average rate of change from $t=5$ to $t=7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$.",
          "worked": "$$\\begin{aligned}Q(5)&=8(5)-5^2=15\\\\Q(7)&=8(7)-7^2=7\\\\\\text{Average rate of change}&=\\frac{Q(7)-Q(5)}{7-5}\\\\&=\\frac{7-15}{2}\\\\&=-4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
