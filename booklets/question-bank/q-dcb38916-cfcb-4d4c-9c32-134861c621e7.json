  "content": {
    "id": "p43-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "The mean of a binomial distribution is $20.5$.\nIf there are $50$ trials, find the probability of success as a fraction.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{41}{100}$",
      "worked": "Using $E(X)=np$:\n$$\\begin{aligned}50p&=20.5\\\\p&=\\frac{20.5}{50}\\\\p&=\\frac{41}{100}\\end{aligned}$$",
