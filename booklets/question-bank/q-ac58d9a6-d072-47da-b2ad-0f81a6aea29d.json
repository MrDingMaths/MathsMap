        "prompt": "without repetition",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60$",
          "worked": "There are 5, then 4, then 3 choices for the successive positions.\n$$\\begin{align*}N&=5\\times4\\times3\\\\N&=60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
