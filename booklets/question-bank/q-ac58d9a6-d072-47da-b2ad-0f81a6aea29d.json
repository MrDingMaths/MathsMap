        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125$",
          "worked": "There are 5 choices for each position, since repetition is allowed.\n$$\\begin{align*}N&=5\\times5\\times5\\\\N&=125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q11b",
        "type": "part",
