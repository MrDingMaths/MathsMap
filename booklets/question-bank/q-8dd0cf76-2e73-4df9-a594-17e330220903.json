    "children": [
      {
        "id": "p17-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=3x^2-6x$",
          "worked": "$$f'(x)=3x^2-6x.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p17-q13-b",
        "type": "group",
        "label": "b",
        "prompt": "For what values of $x$ is $f(x)$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q13-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Increasing",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x<0$ or $x>2$",
              "worked": "$$\\begin{align*}f'(x)&=3x(x-2)\\\\3x(x-2)&>0.\\end{align*}$$\nThe factors have the same sign when $x<0$ or $x>2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p17-q13-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Decreasing",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0<x<2$",
              "worked": "$$3x(x-2)<0.$$\nThe factors have opposite signs when $0<x<2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p17-q13-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Stationary",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=0$ or $x=2$",
              "worked": "$$\\begin{align*}3x(x-2)&=0\\\\x&=0\\text{ or }2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          }
        ]
      },
      {
        "id": "p17-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "By finding $f(0)$ and $f(2)$, label the sketch of $y=f(x)$ to the right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(0)=5$, $f(2)=1$; stationary points $(0,5)$ and $(2,1)$.",
          "worked": "$$\\begin{align*}f(0)&=0^3-3(0)^2+5\\\\f(0)&=5\\\\f(2)&=2^3-3(2)^2+5\\\\f(2)&=1.\\end{align*}$$\nLabel the maximum $(0,5)$ and minimum $(2,1)$.",
          "solutionDiagrams": [
