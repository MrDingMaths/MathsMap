  "content": {
    "id": "p23-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A production-line worker is paid \\$1.50 for each of the first 75 toasters assembled, then \\$1.80 per toaster thereafter. How much does she earn on a day in which she assembles 110 toasters?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$175.50; $75\\times\\$1.50+35\\times\\$1.80$.",
      "worked": "$$\\begin{align*}\\text{Remaining toasters} &= 110-75\\\\\\text{Remaining toasters} &= 35\\\\\\text{Pay} &= 75\\times\\$1.50+35\\times\\$1.80\\\\\\text{Pay} &= \\$112.50+\\$63.00\\\\\\text{Pay} &= \\$175.50\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
