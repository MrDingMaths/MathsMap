  "content": {
    "id": "p4-q8",
    "type": "question",
    "label": "8",
    "prompt": "Bob and Mary have three children. Suppose each birth is independent and the probability of a boy and the probability of a girl are each exactly $50\\%$. What is the probability that they have:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "all boys?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "There are $2^3=8$ equally likely birth orders. Exactly one has all boys.\n\n$$P(\\text{all boys})=\\frac{1}{8}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p4-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "one boy and two girls?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{8}$",
          "worked": "Of the eight equally likely birth orders, three have one boy and two girls: $BGG$, $GBG$ and $GGB$.\n\n$$P(\\text{one boy})=\\frac{3}{8}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "at least one girl?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{8}$",
          "worked": "Let $G$ be the event that at least one child is a girl. Its complement is all boys.\n\n$$\\begin{align*}P(G)&=1-P(\\text{all boys})\\\\P(G)&=1-\\frac{1}{8}\\\\P(G)&=\\frac{7}{8}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
