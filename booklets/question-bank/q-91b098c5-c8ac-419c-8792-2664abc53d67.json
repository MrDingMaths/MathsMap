  "content": {
    "id": "p11-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Evaluate each of these expressions for $x = 35$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23\\frac{1}{3}$",
          "worked": "$$\\begin{align*}\\frac{2x}{3}&=\\frac{2\\times35}{3}\\\\\\frac{2x}{3}&=\\frac{70}{3}\\\\\\frac{2x}{3}&=23\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3x}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}\\frac{3x}{7}&=\\frac{3\\times35}{7}\\\\\\frac{3x}{7}&=3\\times5\\\\\\frac{3x}{7}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2(x+7)}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\frac{4}{5}$",
          "worked": "$$\\begin{align*}\\frac{2(x+7)}{5}&=\\frac{2(35+7)}{5}\\\\\\frac{2(x+7)}{5}&=\\frac{2\\times42}{5}\\\\\\frac{2(x+7)}{5}&=\\frac{84}{5}\\\\\\frac{2(x+7)}{5}&=16\\frac{4}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
