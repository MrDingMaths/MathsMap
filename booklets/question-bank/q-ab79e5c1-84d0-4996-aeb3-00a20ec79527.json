  "content": {
    "id": "p44-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the number of arrangements of the letters of the word ADDRESS if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7!}{2!2!}=1260$",
          "worked": "There are seven letters, with two identical D’s and two identical S’s.\n\n$$\\begin{align*}N&=\\frac{7!}{2!2!}\\\\N&=1260\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "the two D’s are together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360$ arrangements.\n\nTreat DD as one object and divide by $2!$ for the identical S’s.",
          "worked": "Treat DD as one object. There are six objects, including two identical S’s. The DD block has only one internal order.\n\n$$\\begin{align*}N&=\\frac{6!}{2!}\\\\N&=360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p44-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "the two S’s are separate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$900$ arrangements.\n\nSubtract the $360$ arrangements with SS together from the $1260$ unrestricted arrangements.",
          "worked": "There are $1260$ unrestricted arrangements. With SS treated as one object, the six objects include two identical D’s, giving $6!/2!=360$ arrangements with the S’s together.\n\n$$\\begin{align*}N&=\\frac{7!}{2!2!}-\\frac{6!}{2!}\\\\N&=1260-360\\\\N&=900\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
