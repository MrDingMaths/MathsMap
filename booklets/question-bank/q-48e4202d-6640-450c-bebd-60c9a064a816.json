  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "2",
    "prompt": "Suppose $y$ varies directly with $x$. If $y=12$ when $x=4$, find the constant of variation, and then calculate the value of $y$ when $x=7$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=3$; $y=21$.",
      "worked": "$$\\begin{align*}y&=kx\\\\12&=4k\\\\k&=3\\\\y&=3x\\\\y&=3(7)\\\\y&=21\\end{align*}$$",
      "solutionDiagrams": []
    },
