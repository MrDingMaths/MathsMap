        "children": [],
        "answer": {
          "short": "$2\\times10^9$",
          "worked": "$$\\begin{align*}(5\\times10^2)\\times(4\\times10^6)&=20\\times10^{2+6}\\\\(5\\times10^2)\\times(4\\times10^6)&=20\\times10^8\\\\(5\\times10^2)\\times(4\\times10^6)&=2\\times10^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$(6\\times10^{-4})\\div(2\\times10^{-3})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times10^{-1}$",
          "worked": "$$\\begin{align*}(6\\times10^{-4})\\div(2\\times10^{-3})&=(6\\div2)\\times10^{-4-(-3)}\\\\(6\\times10^{-4})\\div(2\\times10^{-3})&=3\\times10^{-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$(4.2\\times10^3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.764\\times10^7$",
          "worked": "$$\\begin{align*}(4.2\\times10^3)^2&=4.2^2\\times10^{3\\times2}\\\\(4.2\\times10^3)^2&=17.64\\times10^6\\\\(4.2\\times10^3)^2&=1.764\\times10^7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{(3\\times10^{-2})^2}{1.8\\times10^{-4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
