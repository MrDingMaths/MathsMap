  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "How many ways can you form a five-digit number using the digits $\\{1,2,3,4,5\\}$ without repetition so that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "the even numbers are grouped together",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "Treat the two even digits as one group. Arrange this group and the three odd digits, then arrange the even digits within their group.\n$$4!\\times2!=48.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "the odd numbers are grouped together",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "Treat the three odd digits as one group. Arrange this group and the two even digits, then arrange the odd digits within their group.\n$$3!\\times3!=36.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "the odd numbers are grouped together and the even numbers are grouped together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "Arrange the odd-digit group and the even-digit group in $2!$ ways. Arrange the digits within each group.\n$$2!\\times3!\\times2!=24.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
