  "content": {
    "id": "p16-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "One bottle contains 2 litres of water and cordial mixed in a ratio of $1:2$. A second bottle contains 3 litres of water and cordial mixed in a ratio of $2:3$. When both bottles are mixed, what is the ratio of water to cordial?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p16-q24-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "28:47",
                "display": false
              }
            ]
          },
          {
            "id": "p16-q24-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Add the water volumes and the cordial volumes separately, then simplify the ratio.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Bottle 1:\n$$\\begin{align*}\\text{Water volume}&=\\frac{1}{3}\\times2=\\frac{2}{3}\\text{ L}\\\\\\text{Cordial volume}&=\\frac{2}{3}\\times2=\\frac{4}{3}\\text{ L}\\end{align*}$$\nBottle 2:\n$$\\begin{align*}\\text{Water volume}&=\\frac{2}{5}\\times3=\\frac{6}{5}\\text{ L}\\\\\\text{Cordial volume}&=\\frac{3}{5}\\times3=\\frac{9}{5}\\text{ L}\\end{align*}$$\nCombined:\n$$\\begin{align*}\\text{Water volume}&=\\frac{2}{3}+\\frac{6}{5}=\\frac{28}{15}\\text{ L}\\\\\\text{Cordial volume}&=\\frac{4}{3}+\\frac{9}{5}=\\frac{47}{15}\\text{ L}\\\\\\text{Water}:\\text{cordial}&=\\frac{28}{15}:\\frac{47}{15}\\\\\\text{Water}:\\text{cordial}&=28:47\\end{align*}$$",
      "solutionDiagrams": []
    },
