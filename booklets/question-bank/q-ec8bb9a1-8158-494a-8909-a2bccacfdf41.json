      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{(x+1)(x+2)}+\\frac{2}{(x+2)(x+3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x+5}{(x+1)(x+2)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{1}{(x+1)(x+2)}+\\frac{2}{(x+2)(x+3)}&=\\frac{(x+3)+2(x+1)}{(x+1)(x+2)(x+3)}\\\\\\frac{1}{(x+1)(x+2)}+\\frac{2}{(x+2)(x+3)}&=\\frac{x+3+2x+2}{(x+1)(x+2)(x+3)}\\\\\\frac{1}{(x+1)(x+2)}+\\frac{2}{(x+2)(x+3)}&=\\frac{3x+5}{(x+1)(x+2)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2}{(x-1)(x+3)}+\\frac{1}{(x-1)(x-2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x-1}{(x-1)(x+3)(x-2)}$",
          "worked": "$$\\begin{align*}\\frac{2}{(x-1)(x+3)}+\\frac{1}{(x-1)(x-2)}&=\\frac{2(x-2)+(x+3)}{(x-1)(x+3)(x-2)}\\\\\\frac{2}{(x-1)(x+3)}+\\frac{1}{(x-1)(x-2)}&=\\frac{2x-4+x+3}{(x-1)(x+3)(x-2)}\\\\\\frac{2}{(x-1)(x+3)}+\\frac{1}{(x-1)(x-2)}&=\\frac{3x-1}{(x-1)(x+3)(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2}{(x-3)(x-2)}-\\frac{4}{(x-1)(x-2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(5-x)}{(x-3)(x-2)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{2}{(x-3)(x-2)}-\\frac{4}{(x-1)(x-2)}&=\\frac{2(x-1)-4(x-3)}{(x-3)(x-2)(x-1)}\\\\\\frac{2}{(x-3)(x-2)}-\\frac{4}{(x-1)(x-2)}&=\\frac{2x-2-4x+12}{(x-3)(x-2)(x-1)}\\\\\\frac{2}{(x-3)(x-2)}-\\frac{4}{(x-1)(x-2)}&=\\frac{2(5-x)}{(x-3)(x-2)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{4}{(x+1)(x-3)}-\\frac{3}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13-3x}{(x+1)(x-3)}$",
          "worked": "$$\\begin{align*}\\frac{4}{(x+1)(x-3)}-\\frac{3}{x+1}&=\\frac{4-3(x-3)}{(x+1)(x-3)}\\\\\\frac{4}{(x+1)(x-3)}-\\frac{3}{x+1}&=\\frac{4-3x+9}{(x+1)(x-3)}\\\\\\frac{4}{(x+1)(x-3)}-\\frac{3}{x+1}&=\\frac{13-3x}{(x+1)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{x^2-x-2}+\\frac{4}{x^2-3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x+1}{(x+1)(x-1)(x-2)}$\n\nFactorise the denominators before choosing the common denominator.",
          "worked": "$$\\begin{align*}\\frac{3}{x^2-x-2}+\\frac{4}{x^2-3x+2}&=\\frac{3}{(x-2)(x+1)}+\\frac{4}{(x-1)(x-2)}\\\\\\frac{3}{x^2-x-2}+\\frac{4}{x^2-3x+2}&=\\frac{3(x-1)+4(x+1)}{(x+1)(x-1)(x-2)}\\\\\\frac{3}{x^2-x-2}+\\frac{4}{x^2-3x+2}&=\\frac{3x-3+4x+4}{(x+1)(x-1)(x-2)}\\\\\\frac{3}{x^2-x-2}+\\frac{4}{x^2-3x+2}&=\\frac{7x+1}{(x+1)(x-1)(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5}{x^2-1}+\\frac{3}{x^2-2x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(4x-9)}{(x-1)(x+1)(x-3)}$\n\nFactorise the denominators before choosing the common denominator.",
          "worked": "$$\\begin{align*}\\frac{5}{x^2-1}+\\frac{3}{x^2-2x-3}&=\\frac{5}{(x-1)(x+1)}+\\frac{3}{(x-3)(x+1)}\\\\\\frac{5}{x^2-1}+\\frac{3}{x^2-2x-3}&=\\frac{5(x-3)+3(x-1)}{(x-1)(x+1)(x-3)}\\\\\\frac{5}{x^2-1}+\\frac{3}{x^2-2x-3}&=\\frac{5x-15+3x-3}{(x-1)(x+1)(x-3)}\\\\\\frac{5}{x^2-1}+\\frac{3}{x^2-2x-3}&=\\frac{2(4x-9)}{(x-1)(x+1)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{3}{(x+1)(x-2)}+\\frac{1}{(x+3)(2-x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(x+4)}{(x+1)(x-2)(x+3)}$\n\nUse $2-x=-(x-2)$.",
          "worked": "$$\\begin{align*}\\frac{3}{(x+1)(x-2)}+\\frac{1}{(x+3)(2-x)}&=\\frac{3}{(x+1)(x-2)}-\\frac{1}{(x+3)(x-2)}\\\\\\frac{3}{(x+1)(x-2)}+\\frac{1}{(x+3)(2-x)}&=\\frac{3(x+3)-(x+1)}{(x+1)(x-2)(x+3)}\\\\\\frac{3}{(x+1)(x-2)}+\\frac{1}{(x+3)(2-x)}&=\\frac{3x+9-x-1}{(x+1)(x-2)(x+3)}\\\\\\frac{3}{(x+1)(x-2)}+\\frac{1}{(x+3)(2-x)}&=\\frac{2(x+4)}{(x+1)(x-2)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{4}{x^2+2x-3}-\\frac{1}{1-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+7}{(x+3)(x-1)(x+1)}$\n\nUse $1-x^2=-(x-1)(x+1)$.",
          "worked": "$$\\begin{align*}\\frac{4}{x^2+2x-3}-\\frac{1}{1-x^2}&=\\frac{4}{(x+3)(x-1)}+\\frac{1}{(x-1)(x+1)}\\\\\\frac{4}{x^2+2x-3}-\\frac{1}{1-x^2}&=\\frac{4(x+1)+(x+3)}{(x+3)(x-1)(x+1)}\\\\\\frac{4}{x^2+2x-3}-\\frac{1}{1-x^2}&=\\frac{4x+4+x+3}{(x+3)(x-1)(x+1)}\\\\\\frac{4}{x^2+2x-3}-\\frac{1}{1-x^2}&=\\frac{5x+7}{(x+3)(x-1)(x+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{3}{x(x+2)}+\\frac{4}{(x+2)(x-1)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x-3}{x(x+2)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x(x+2)}+\\frac{4}{(x+2)(x-1)}&=\\frac{3(x-1)+4x}{x(x+2)(x-1)}\\\\\\frac{3}{x(x+2)}+\\frac{4}{(x+2)(x-1)}&=\\frac{3x-3+4x}{x(x+2)(x-1)}\\\\\\frac{3}{x(x+2)}+\\frac{4}{(x+2)(x-1)}&=\\frac{7x-3}{x(x+2)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{1}{(x-2)(x+4)}-\\frac{3}{(x+4)(x-3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3-2x}{(x-2)(x+4)(x-3)}$",
          "worked": "$$\\begin{align*}\\frac{1}{(x-2)(x+4)}-\\frac{3}{(x+4)(x-3)}&=\\frac{(x-3)-3(x-2)}{(x-2)(x+4)(x-3)}\\\\\\frac{1}{(x-2)(x+4)}-\\frac{3}{(x+4)(x-3)}&=\\frac{x-3-3x+6}{(x-2)(x+4)(x-3)}\\\\\\frac{1}{(x-2)(x+4)}-\\frac{3}{(x+4)(x-3)}&=\\frac{3-2x}{(x-2)(x+4)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{3}{(x+1)(x+3)}+\\frac{2}{x(x+3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+2}{x(x+1)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{3}{(x+1)(x+3)}+\\frac{2}{x(x+3)}&=\\frac{3x+2(x+1)}{x(x+1)(x+3)}\\\\\\frac{3}{(x+1)(x+3)}+\\frac{2}{x(x+3)}&=\\frac{3x+2x+2}{x(x+1)(x+3)}\\\\\\frac{3}{(x+1)(x+3)}+\\frac{2}{x(x+3)}&=\\frac{5x+2}{x(x+1)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{4}{(x+1)(x+2)}+\\frac{3}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x+10}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{4}{(x+1)(x+2)}+\\frac{3}{x+1}&=\\frac{4+3(x+2)}{(x+1)(x+2)}\\\\\\frac{4}{(x+1)(x+2)}+\\frac{3}{x+1}&=\\frac{4+3x+6}{(x+1)(x+2)}\\\\\\frac{4}{(x+1)(x+2)}+\\frac{3}{x+1}&=\\frac{3x+10}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q5-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac{1}{x^2-2x-8}+\\frac{3}{x^2+3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x-11}{(x-4)(x+2)(x+1)}$\n\nFactorise the denominators before choosing the common denominator.",
          "worked": "$$\\begin{align*}\\frac{1}{x^2-2x-8}+\\frac{3}{x^2+3x+2}&=\\frac{1}{(x-4)(x+2)}+\\frac{3}{(x+1)(x+2)}\\\\\\frac{1}{x^2-2x-8}+\\frac{3}{x^2+3x+2}&=\\frac{(x+1)+3(x-4)}{(x-4)(x+2)(x+1)}\\\\\\frac{1}{x^2-2x-8}+\\frac{3}{x^2+3x+2}&=\\frac{x+1+3x-12}{(x-4)(x+2)(x+1)}\\\\\\frac{1}{x^2-2x-8}+\\frac{3}{x^2+3x+2}&=\\frac{4x-11}{(x-4)(x+2)(x+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q5-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{2}{x^2+2x}+\\frac{3}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x-4}{x(x-2)(x+2)}$\n\nFactorise the denominators before choosing the common denominator.",
          "worked": "$$\\begin{align*}\\frac{2}{x^2+2x}+\\frac{3}{x^2-4}&=\\frac{2}{x(x+2)}+\\frac{3}{(x-2)(x+2)}\\\\\\frac{2}{x^2+2x}+\\frac{3}{x^2-4}&=\\frac{2(x-2)+3x}{x(x-2)(x+2)}\\\\\\frac{2}{x^2+2x}+\\frac{3}{x^2-4}&=\\frac{2x-4+3x}{x(x-2)(x+2)}\\\\\\frac{2}{x^2+2x}+\\frac{3}{x^2-4}&=\\frac{5x-4}{x(x-2)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q5-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\frac{2}{x(3-x)}+\\frac{4}{(x+1)(x-3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(x-1)}{x(x-3)(x+1)}$\n\nUse $3-x=-(x-3)$.",
          "worked": "$$\\begin{align*}\\frac{2}{x(3-x)}+\\frac{4}{(x+1)(x-3)}&=-\\frac{2}{x(x-3)}+\\frac{4}{(x+1)(x-3)}\\\\\\frac{2}{x(3-x)}+\\frac{4}{(x+1)(x-3)}&=\\frac{-2(x+1)+4x}{x(x-3)(x+1)}\\\\\\frac{2}{x(3-x)}+\\frac{4}{(x+1)(x-3)}&=\\frac{-2x-2+4x}{x(x-3)(x+1)}\\\\\\frac{2}{x(3-x)}+\\frac{4}{(x+1)(x-3)}&=\\frac{2(x-1)}{x(x-3)(x+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p13-q5-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\frac{3}{4-x^2}+\\frac{4}{x(x-2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+8}{x(x-2)(x+2)}$\n\nUse $4-x^2=-(x-2)(x+2)$.",
          "worked": "$$\\begin{align*}\\frac{3}{4-x^2}+\\frac{4}{x(x-2)}&=-\\frac{3}{(x-2)(x+2)}+\\frac{4}{x(x-2)}\\\\\\frac{3}{4-x^2}+\\frac{4}{x(x-2)}&=\\frac{-3x+4(x+2)}{x(x-2)(x+2)}\\\\\\frac{3}{4-x^2}+\\frac{4}{x(x-2)}&=\\frac{-3x+4x+8}{x(x-2)(x+2)}\\\\\\frac{3}{4-x^2}+\\frac{4}{x(x-2)}&=\\frac{x+8}{x(x-2)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
