  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the next perfect square after $10\\,000$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10\\,201$",
      "worked": "Since $10\\,000=100^2$, the next perfect square is $101^2$.\n$$\\begin{align*}101^2&=(100+1)^2\\\\101^2&=100^2+2(100)(1)+1^2\\\\101^2&=10\\,000+200+1\\\\101^2&=10\\,201.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
