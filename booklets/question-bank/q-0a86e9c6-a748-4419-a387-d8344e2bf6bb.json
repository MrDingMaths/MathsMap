  "content": {
    "id": "p12-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A bag contains 5 red balls, 4 green balls and 2 blue balls. Kevin pulls out a red ball and keeps it. What is the probability that the next ball will also be red?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac25$",
      "worked": "After Kevin keeps the red ball, there are 4 red, 4 green and 2 blue balls left.\n\n$$\\begin{align*}P(\\text{next ball is red}) &= \\frac{4}{4+4+2} \\\\ P(\\text{next ball is red}) &= \\frac25\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 14
  },
