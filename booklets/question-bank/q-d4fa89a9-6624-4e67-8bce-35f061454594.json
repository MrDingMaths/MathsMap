  "content": {
    "id": "p23-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "If $f(x)=x-2$ and $g(x)=x^2-4$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q2-calculations",
