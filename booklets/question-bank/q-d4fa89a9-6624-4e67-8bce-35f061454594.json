            "label": "c",
            "prompt": "$g(f(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-4$",
              "worked": "$\\begin{aligned}g(f(2))&=g(0)\\\\g(f(2))&=0^2-4\\\\g(f(2))&=-4\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p23-q2-d",
            "type": "part",
            "label": "d",
            "prompt": "$f(g(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2$",
              "worked": "$\\begin{aligned}f(g(2))&=f(0)\\\\f(g(2))&=0-2\\\\f(g(2))&=-2\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p23-q2-e",
            "type": "part",
            "label": "e",
            "prompt": "$f(f(7))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "$\\begin{aligned}f(f(7))&=f(5)\\\\f(f(7))&=5-2\\\\f(f(7))&=3\\end{aligned}$",
