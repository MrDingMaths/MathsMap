            "answer": {
              "short": "$-4$",
              "worked": "$\\begin{aligned}g(g(2))&=g(0)\\\\g(g(2))&=0^2-4\\\\g(g(2))&=-4\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p23-q2-g",
