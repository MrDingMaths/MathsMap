        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q2-a",
            "type": "part",
            "label": "a",
            "prompt": "$g(f(0))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0$",
              "worked": "$\\begin{aligned}g(f(0))&=g(-2)\\\\g(f(0))&=(-2)^2-4\\\\g(f(0))&=0\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p23-q2-b",
            "type": "part",
            "label": "b",
            "prompt": "$f(g(0))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-6$",
              "worked": "$\\begin{aligned}f(g(0))&=f(-4)\\\\f(g(0))&=-4-2\\\\f(g(0))&=-6\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
