            "label": "g",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^2-6$",
              "worked": "$\\begin{aligned}f(g(x))&=f(x^2-4)\\\\f(g(x))&=x^2-4-2\\\\f(g(x))&=x^2-6\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p23-q2-h",
            "type": "part",
            "label": "h",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^2-4x$",
              "worked": "$\\begin{aligned}g(f(x))&=g(x-2)\\\\g(f(x))&=(x-2)^2-4\\\\g(f(x))&=x^2-4x+4-4\\\\g(f(x))&=x^2-4x\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p23-q2-i",
            "type": "part",
            "label": "i",
            "prompt": "$f(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x-4$",
              "worked": "$\\begin{aligned}f(f(x))&=f(x-2)\\\\f(f(x))&=x-2-2\\\\f(f(x))&=x-4\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p23-q2-j",
            "type": "part",
            "label": "j",
            "prompt": "$g(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^4-8x^2+12$",
              "worked": "$\\begin{aligned}g(g(x))&=g(x^2-4)\\\\g(g(x))&=(x^2-4)^2-4\\\\g(g(x))&=x^4-8x^2+16-4\\\\g(g(x))&=x^4-8x^2+12\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      },
      {
        "id": "p23-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "Does $f(g(x))=g(f(x))$?",
