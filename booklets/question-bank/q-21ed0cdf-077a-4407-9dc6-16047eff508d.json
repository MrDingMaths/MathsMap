  "content": {
    "id": "p52-q40-root",
    "type": "question",
    "label": "40",
    "prompt": "The graph of $y=f(x)$ goes through $(3,2)$ and the inverse function $f^{-1}$ exists. Find the value of $a$ such that $f^{-1}(a-2)=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=4$.",
      "worked": "Since $f(3)=2$, apply $f$ to both sides.\n$$\\begin{align*}a-2&=f(3)\\\\a-2&=2\\\\a&=4\\end{align*}$$",
      "solutionDiagrams": []
    },
