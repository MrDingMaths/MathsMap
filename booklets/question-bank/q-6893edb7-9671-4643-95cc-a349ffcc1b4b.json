  "content": {
    "id": "p29-q10-root",
    "type": "question",
    "label": null,
    "prompt": "A person has a number of 10-cent and 20-cent coins. If their total value is $\\$18$, how many are there of each coin if there are:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "equal numbers of each coin?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "60 of each coin.",
          "worked": "Let $n$ be the number of each coin. The total value is 1800 cents.\n$$\\begin{align*}10n+20n&=1800\\\\30n&=1800\\\\n&=60\\end{align*}$$\nThere are 60 10-cent coins and 60 20-cent coins.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p29-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "twice as many 10-cent coins as there are 20-cent coins?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "90 10-cent coins and 45 20-cent coins.",
          "worked": "Let $n$ be the number of 20-cent coins. There are $2n$ 10-cent coins.\n$$\\begin{align*}10(2n)+20n&=1800\\\\40n&=1800\\\\n&=45\\end{align*}$$\nThere are 45 20-cent coins and $2(45)=90$ 10-cent coins.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p29-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "twice as many 20-cent coins as there are 10-cent coins?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "36 10-cent coins and 72 20-cent coins.",
          "worked": "Let $n$ be the number of 10-cent coins. There are $2n$ 20-cent coins.\n$$\\begin{align*}10n+20(2n)&=1800\\\\50n&=1800\\\\n&=36\\end{align*}$$\nThere are 36 10-cent coins and $2(36)=72$ 20-cent coins.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
