    "children": [
      {
        "id": "p17-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove that if $5x-2$ is positive, then $x$ is positive.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\frac25>0$, so $x$ is positive.",
          "worked": "$$\\begin{align*}5x-2&>0\\\\5x&>2\\\\x&>\\frac25\\end{align*}$$\nSince $\\frac25>0$, $x>0$, so $x$ is positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p17-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Prove that if $2x+6$ is positive, then $x+5$ is positive.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-3$, so $x+5>2>0$. Hence $x+5$ is positive.",
          "worked": "$$\\begin{align*}2x+6&>0\\\\2x&>-6\\\\x&>-3\\\\x+5&>2\\end{align*}$$\nSince $2>0$, $x+5$ is positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
