  "content": {
    "id": "p4-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Determine whether the following functions are even, odd or neither.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x+|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Neither.",
          "worked": "$$\\begin{align*}f(1)&=1+|1|=2\\\\f(-1)&=-1+|-1|=0\\end{align*}$$\nSince $f(-1)$ equals neither $f(1)$ nor $-f(1)$, the function is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p4-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x\\times|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)|-x|\\\\f(-x)&=-x|x|\\\\f(-x)&=-f(x)\\end{align*}$$\nThe domain is $\\mathbb R$, so the function is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p4-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{x}{|x|-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Neither; its domain is $x<0$.",
          "worked": "For $x\\geq0$, the denominator is $x-x=0$, so the function is undefined. For $x<0$,\n$$\\begin{align*}f(x)&=\\frac{x}{-x-x}\\\\f(x)&=-\\frac12.\\end{align*}$$\nIts domain is not symmetric about zero, so the function is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p4-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=|x-1|+|x+1|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even.",
          "worked": "$$\\begin{align*}f(-x)&=|-x-1|+|-x+1|\\\\f(-x)&=|x+1|+|x-1|\\\\f(-x)&=f(x)\\end{align*}$$\nThe domain is $\\mathbb R$, so the function is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
