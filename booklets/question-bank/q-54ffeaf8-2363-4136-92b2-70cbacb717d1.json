  "content": {
    "id": "p11-q10-root",
    "type": "question",
    "label": "4",
    "prompt": "Explain why the coefficient of $x^{10}$ in $(1+x^2)^{12}$ is the same as the coefficient of $x^5$ in $(1+x)^{12}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Both coefficients are $\\binom{12}{5}=792$.\n\nEach counts the ways to choose the variable term from five of the twelve brackets.",
      "worked": "To obtain $x^{10}$ in $(1+x^2)^{12}$, choose $x^2$ from five brackets and 1 from the remaining seven. The coefficient is $\\binom{12}{5}$.\n\nTo obtain $x^5$ in $(1+x)^{12}$, choose $x$ from five brackets and 1 from the remaining seven. The coefficient is also $\\binom{12}{5}$.\n\nBoth coefficients count the same five-bracket selections and equal 792.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
