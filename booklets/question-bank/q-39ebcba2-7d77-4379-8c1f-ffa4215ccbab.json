  "content": {
    "id": "p18-q16-response",
    "type": "question",
    "label": "16",
    "prompt": "In a group of 150 employees, 65 have a car, 85 have a smartphone, and 40 have both.\nHow many employees have a car or a smartphone?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "110 employees.",
      "worked": "Let $C$ and $S$ be the sets of employees who have a car and a smartphone.\n$$\\begin{align*}|C\\cup S|&=|C|+|S|-|C\\cap S|\\\\|C\\cup S|&=65+85-40\\\\|C\\cup S|&=110\\end{align*}$$\n110 employees have a car or a smartphone.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
