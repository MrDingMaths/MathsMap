      {
        "id": "p26-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{d}{dx}\\left(\\cos^{-1}(2-x)\\right)=\\dfrac1{\\sqrt{4x-x^2-3}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}\\left(\\cos^{-1}(2-x)\\right)=\\dfrac1{\\sqrt{4x-x^2-3}}$ for $1<x<3$.",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}\\left(\\cos^{-1}(2-x)\\right)&=-\\frac1{\\sqrt{1-(2-x)^2}}(-1)\\\\&=\\frac1{\\sqrt{1-(4-4x+x^2)}}\\\\&=\\frac1{\\sqrt{4x-x^2-3}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p26-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int_1^2\\frac1{\\sqrt{4x-x^2-3}}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac\\pi2$.",
          "worked": "$$\\begin{aligned}\\int_1^2\\frac1{\\sqrt{4x-x^2-3}}\\,dx&=\\left[\\cos^{-1}(2-x)\\right]_1^2\\\\&=\\cos^{-1}(0)-\\cos^{-1}(1)\\\\&=\\frac\\pi2-0\\\\&=\\frac\\pi2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
