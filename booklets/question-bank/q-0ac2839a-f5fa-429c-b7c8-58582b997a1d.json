  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify these products. Remember to simplify before you multiply.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{5a}{3}\\times\\dfrac{4b}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4ab}{3}$",
          "worked": "$$\\begin{align*}\\frac{5a}{3}\\times\\frac{4b}{5}&=\\frac{a}{3}\\times 4b\\\\&=\\frac{4ab}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2b}{5}\\times\\frac{7d}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7bd}{15}$",
          "worked": "$$\\begin{align*}\\frac{2b}{5}\\times\\frac{7d}{6}&=\\frac{b}{5}\\times\\frac{7d}{3}\\\\&=\\frac{7bd}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{6p}{7}\\times\\dfrac{5q}{9r}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10pq}{21r}$",
          "worked": "$$\\begin{align*}\\frac{6p}{7}\\times\\frac{5q}{9r}&=\\frac{2p}{7}\\times\\frac{5q}{3r}\\\\&=\\frac{10pq}{21r}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{9d}{2}\\times\\frac{4e}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{18de}{7}$",
          "worked": "$$\\begin{align*}\\frac{9d}{2}\\times\\frac{4e}{7}&=9d\\times\\frac{2e}{7}\\\\&=\\frac{18de}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3x}{2}\\times\\frac{1}{6x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\frac{3x}{2}\\times\\frac{1}{6x}&=\\frac{1}{2}\\times\\frac{1}{2}\\\\&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{4}{9k}\\times\\frac{3k}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{align*}\\frac{4}{9k}\\times\\frac{3k}{2}&=\\frac{2}{3}\\times 1\\\\&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
