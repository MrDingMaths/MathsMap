  "content": {
    "id": "p27-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $\\alpha,\\beta,\\gamma$ and $\\delta$ are the roots of $x^4-5x^3+2x^2-4x-3=0$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta+\\gamma+\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{aligned}\\alpha+\\beta+\\gamma+\\delta&=-\\frac{-5}{1}\\\\&=5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p27-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta&=\\frac{2}{1}\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p27-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha\\beta\\gamma+\\alpha\\beta\\delta+\\alpha\\gamma\\delta+\\beta\\gamma\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{aligned}\\alpha\\beta\\gamma+\\alpha\\beta\\delta+\\alpha\\gamma\\delta+\\beta\\gamma\\delta&=-\\frac{-4}{1}\\\\&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p27-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\alpha\\beta\\gamma\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{aligned}\\alpha\\beta\\gamma\\delta&=\\frac{-3}{1}\\\\&=-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p27-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac1\\alpha+\\dfrac1\\beta+\\dfrac1\\gamma+\\dfrac1\\delta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac43$",
          "worked": "$$\\begin{aligned}\\frac1\\alpha+\\frac1\\beta+\\frac1\\gamma+\\frac1\\delta&=\\frac{\\beta\\gamma\\delta+\\alpha\\gamma\\delta+\\alpha\\beta\\delta+\\alpha\\beta\\gamma}{\\alpha\\beta\\gamma\\delta}\\\\&=\\frac4{-3}\\\\&=-\\frac43\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p27-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac1{\\alpha\\beta}+\\dfrac1{\\alpha\\gamma}+\\dfrac1{\\alpha\\delta}+\\dfrac1{\\beta\\gamma}+\\dfrac1{\\beta\\delta}+\\dfrac1{\\gamma\\delta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac23$",
          "worked": "Let $R=\\dfrac1{\\alpha\\beta}+\\dfrac1{\\alpha\\gamma}+\\dfrac1{\\alpha\\delta}+\\dfrac1{\\beta\\gamma}+\\dfrac1{\\beta\\delta}+\\dfrac1{\\gamma\\delta}$. Then\n$$\\begin{aligned}R&=\\frac{\\gamma\\delta+\\beta\\delta+\\beta\\gamma+\\alpha\\delta+\\alpha\\gamma+\\alpha\\beta}{\\alpha\\beta\\gamma\\delta}\\\\&=\\frac2{-3}\\\\&=-\\frac23\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p27-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac1{\\alpha\\beta\\gamma}+\\dfrac1{\\alpha\\beta\\delta}+\\dfrac1{\\alpha\\gamma\\delta}+\\dfrac1{\\beta\\gamma\\delta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac53$",
          "worked": "$$\\begin{aligned}\\frac1{\\alpha\\beta\\gamma}+\\frac1{\\alpha\\beta\\delta}+\\frac1{\\alpha\\gamma\\delta}+\\frac1{\\beta\\gamma\\delta}&=\\frac{\\delta+\\gamma+\\beta+\\alpha}{\\alpha\\beta\\gamma\\delta}\\\\&=\\frac5{-3}\\\\&=-\\frac53\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p27-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\alpha^2+\\beta^2+\\gamma^2+\\delta^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21$",
          "worked": "$$\\begin{aligned}\\alpha^2+\\beta^2+\\gamma^2+\\delta^2&=(\\alpha+\\beta+\\gamma+\\delta)^2\\\\&\\quad-2(\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta)\\\\&=5^2-2(2)\\\\&=21\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
