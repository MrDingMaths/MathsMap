  "content": {
    "id": "p16-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Suppose that $A$, $P$ and $Q$ are the points $(-3,3)$, $(2,9)$ and $(10,0)$ respectively.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $\\overrightarrow{AP}$ and $\\overrightarrow{AQ}$ as column vectors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AP}=\\begin{pmatrix}5\\\\6\\end{pmatrix}$, $\\overrightarrow{AQ}=\\begin{pmatrix}13\\\\-3\\end{pmatrix}$.",
          "worked": "$$\\begin{align*}\\overrightarrow{AP}&=\\begin{pmatrix}2-(-3)\\\\9-3\\end{pmatrix}=\\begin{pmatrix}5\\\\6\\end{pmatrix},\\\\\\overrightarrow{AQ}&=\\begin{pmatrix}10-(-3)\\\\0-3\\end{pmatrix}=\\begin{pmatrix}13\\\\-3\\end{pmatrix}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\angle PAQ$ correct to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle PAQ\\approx63^\\circ$.",
          "worked": "$$\\begin{align*}\\overrightarrow{AP}\\cdot\\overrightarrow{AQ}&=5(13)+6(-3)=47,\\\\|\\overrightarrow{AP}|&=\\sqrt{25+36}=\\sqrt{61},\\\\|\\overrightarrow{AQ}|&=\\sqrt{169+9}=\\sqrt{178},\\\\\\cos\\theta&=\\frac{47}{\\sqrt{61}\\sqrt{178}}=\\frac{47}{\\sqrt{10858}},\\\\\\theta&=\\cos^{-1}\\left(\\frac{47}{\\sqrt{10858}}\\right)\\\\\\theta&\\approx63^\\circ.\\end{align*}$$\n\nTherefore $\\angle PAQ\\approx63^\\circ$ to the nearest degree.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
