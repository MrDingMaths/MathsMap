  "content": {
    "id": "p32-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A cuboid has three faces with areas equal to $8\\text{ cm}^2$, $9\\text{ cm}^2$ and $10\\text{ cm}^2$. Find its volume.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\sqrt{5}\\text{ cm}^3$",
      "worked": "Let the dimensions be $a$, $b$ and $c$ centimetres. Then $ab=8$, $ac=9$ and $bc=10$.\n\n$$\\begin{align*}a^2b^2c^2&=8\\times9\\times10\\\\a^2b^2c^2&=720\\\\abc&=\\sqrt{720}\\\\abc&=12\\sqrt{5}.\\end{align*}$$\n\nThe volume is $12\\sqrt{5}\\text{ cm}^3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
