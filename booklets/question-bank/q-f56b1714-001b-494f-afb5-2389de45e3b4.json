              {
                "type": "math",
                "latex": "\\begin{align*}3(x-0.12) &= 25-1.36 \\\\ 3(x-0.12) &= 23.64 \\\\ x-0.12 &= 7.88 \\\\ x &= 8\\end{align*}",
                "display": true
              }
            ]
