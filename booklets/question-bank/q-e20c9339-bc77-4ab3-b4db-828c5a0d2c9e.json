  "content": {
    "id": "p22-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "An advertising graduate earns $\\$28000$ per annum in her first year, then each successive year her salary rises by $\\$1600$. What are her total earnings over 10 years?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$352000$",
      "worked": "The annual salaries form an AP with $a=28000$, $d=1600$ and $n=10$.\n$$\\begin{align*}S_{10}&=\\frac{10}{2}\\left[2(28000)+9(1600)\\right]\\\\S_{10}&=5(56000+14400)\\\\S_{10}&=352000\\end{align*}$$\nHer total earnings over 10 years are $\\$352000$.",
      "solutionDiagrams": []
    },
