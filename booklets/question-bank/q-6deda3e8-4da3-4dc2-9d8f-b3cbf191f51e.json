          "inlines": [
            {
              "type": "text",
              "text": "A fixed point of a function is any point ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x",
              "display": false
            },
            {
              "type": "text",
              "text": " in the domain of ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "f",
              "display": false
            },
            {
              "type": "text",
              "text": " for which ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "f(x)=x",
              "display": false
            },
            {
              "type": "text",
              "text": ". Find the fixed point(s) of the following functions:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q9a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "Set $f(x)=x$.\n$$\\begin{align*}3x+2&=x\\\\2x&=-2\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q9b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x(x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\ 2$",
          "worked": "Set $f(x)=x$.\n$$\\begin{align*}x(x-1)&=x\\\\x^2-2x&=0\\\\x(x-2)&=0\\end{align*}$$\nBy the null factor law, $x=0$ or $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p33-q9c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ 0,\\ 1$",
          "worked": "Set $f(x)=x$.\n$$\\begin{align*}x^3&=x\\\\x^3-x&=0\\\\x(x^2-1)&=0\\\\x(x-1)(x+1)&=0\\end{align*}$$\nBy the null factor law, $x=-1$, $x=0$ or $x=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
