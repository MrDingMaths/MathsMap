        "answer": {
          "short": "$\\dfrac{\\sqrt{5}}{5}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{5}}&=\\frac{1}{\\sqrt{5}}\\times\\frac{\\sqrt{5}}{\\sqrt{5}}\\\\\\frac{1}{\\sqrt{5}}&=\\frac{\\sqrt{5}}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
