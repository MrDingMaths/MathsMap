          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}}{\\sqrt{11}}&=\\frac{\\sqrt{3}}{\\sqrt{11}}\\times\\frac{\\sqrt{11}}{\\sqrt{11}}\\\\\\frac{\\sqrt{3}}{\\sqrt{11}}&=\\frac{\\sqrt{33}}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{5\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{3}}{15}$",
          "worked": "$$\\begin{align*}\\frac{1}{5\\sqrt{3}}&=\\frac{1}{5\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\frac{1}{5\\sqrt{3}}&=\\frac{\\sqrt{3}}{5\\times3}\\\\\\frac{1}{5\\sqrt{3}}&=\\frac{\\sqrt{3}}{15}\\end{align*}$$",
