      {
        "id": "p19-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3\\sqrt{2}}{2}$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{2}}&=\\frac{3}{\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\\\frac{3}{\\sqrt{2}}&=\\frac{3\\sqrt{2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
