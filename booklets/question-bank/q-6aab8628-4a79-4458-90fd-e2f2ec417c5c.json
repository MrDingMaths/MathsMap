  "content": {
    "id": "p3-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Angel has $\\$2000$ in a bank account. She takes $\\$x$ from the bank account every day.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q6-a",
        "type": "group",
        "label": "a",
        "prompt": "How much money does she have in the account after:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p3-q6-a-i",
            "type": "part",
            "label": "i",
            "prompt": "1 day?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(2000-x)$",
              "worked": "Amount left $=\\$(2000-x)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 9
          },
          {
            "id": "p3-q6-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "5 days?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(2000-5x)$",
              "worked": "Total withdrawn $=\\$5x$.\n\nAmount left $=\\$(2000-5x)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p3-q6-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the value of her bank account after five days if:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p3-q6-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x=100$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$1500$",
              "worked": "$\\begin{aligned}\\text{Amount left}&=2000-5(100)\\\\\\text{Amount left}&=2000-500\\\\\\text{Amount left}&=1500\\end{aligned}$\n\nAngel has $\\$1500$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p3-q6-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x=200$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$1000$",
              "worked": "$\\begin{aligned}\\text{Amount left}&=2000-5(200)\\\\\\text{Amount left}&=2000-1000\\\\\\text{Amount left}&=1000\\end{aligned}$\n\nAngel has $\\$1000$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p3-q6-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$x=450$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\$250$\n\nThe account is overdrawn by $\\$250$.",
              "worked": "$\\begin{aligned}\\text{Amount left}&=2000-5(450)\\\\\\text{Amount left}&=2000-2250\\\\\\text{Amount left}&=-250\\end{aligned}$\n\nAngel has overdrawn her account by $\\$250$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
  },
