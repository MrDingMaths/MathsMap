  "content": {
    "id": "p37-q36-root",
    "type": "question",
    "label": "36",
    "prompt": "Find the $n$th term of the sequences:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q36-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{2}{1},\\frac{2+4}{1+3},\\frac{2+4+6}{1+3+5},\\ldots$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=\\dfrac{n+1}{n}$",
          "worked": "Numerators: AP with $a=2$, $d=2$.\n$$\\begin{align*}N_n&=\\frac{n}{2}[2\\times2+(n-1)2]\\\\N_n&=n(n+1)\\end{align*}$$\nDenominators: AP with $a=1$, $d=2$.\n$$\\begin{align*}D_n&=\\frac{n}{2}[2\\times1+(n-1)2]\\\\D_n&=n^2\\end{align*}$$\n$$\\begin{align*}a_n&=\\frac{n(n+1)}{n^2}\\\\a_n&=\\frac{n+1}{n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p37-q36-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{1}{1},\\frac{1+2}{1+4},\\frac{1+2+4}{1+4+16},\\ldots$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=\\dfrac{3}{2^n+1}$",
          "worked": "Numerators: GP with $a=1$, $r=2$.\n$$\\begin{align*}N_n&=\\frac{2^n-1}{2-1}\\\\N_n&=2^n-1\\end{align*}$$\nDenominators: GP with $a=1$, $r=4$.\n$$\\begin{align*}D_n&=\\frac{4^n-1}{4-1}\\\\D_n&=\\frac{4^n-1}{3}\\end{align*}$$\n$$\\begin{align*}a_n&=\\frac{2^n-1}{\\frac{4^n-1}{3}}\\\\a_n&=\\frac{3(2^n-1)}{4^n-1}\\\\a_n&=\\frac{3(2^n-1)}{2^{2n}-1}\\\\a_n&=\\frac{3(2^n-1)}{(2^n-1)(2^n+1)}\\\\a_n&=\\frac{3}{2^n+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
