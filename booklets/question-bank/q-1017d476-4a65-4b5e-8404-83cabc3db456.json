    "children": [
      {
        "id": "index-t6-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x^{7}y^{3}}{x^{2}y^{8}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^{5}}{y^{5}}$",
          "worked": "$$\\begin{align*}\n\\frac{x^{7}y^{3}}{x^{2}y^{8}} &= \\frac{x^{7 - 2}}{y^{8 - 3}} \\\\\n&= \\frac{x^{5}}{y^{5}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{m^{4}n^{6}}{m^{10}n^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{n^{4}}{m^{6}}$",
          "worked": "$$\\begin{align*}\n\\frac{m^{4}n^{6}}{m^{10}n^{2}} &= \\frac{n^{6 - 2}}{m^{10 - 4}} \\\\\n&= \\frac{n^{4}}{m^{6}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{r^{2}s^{7}}{r^{9}s^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{s^{4}}{r^{7}}$",
          "worked": "$$\\begin{align*}\n\\frac{r^{2}s^{7}}{r^{9}s^{3}} &= \\frac{s^{7 - 3}}{r^{9 - 2}} \\\\\n&= \\frac{s^{4}}{r^{7}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{a^{3}b^{9}}{a^{7}b^{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b^{4}}{a^{4}}$",
          "worked": "$$\\begin{align*}\n\\frac{a^{3}b^{9}}{a^{7}b^{5}} &= \\frac{b^{9 - 5}}{a^{7 - 3}} \\\\\n&= \\frac{b^{4}}{a^{4}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{p^{8}q}{p^{2}q^{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{p^{6}}{q^{3}}$",
          "worked": "$$\\begin{align*}\n\\frac{p^{8}q}{p^{2}q^{4}} &= \\frac{p^{8 - 2}}{q^{4 - 1}} \\\\\n&= \\frac{p^{6}}{q^{3}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
