    "children": [
      {
        "id": "p125-task19-24-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\lvert5\\rvert+\\lvert-3\\rvert$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}\\lvert5\\rvert+\\lvert-3\\rvert &= 5+3\\\\\\lvert5\\rvert+\\lvert-3\\rvert &= 8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p125-task19-24-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\lvert-7+4\\rvert$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\lvert-7+4\\rvert &= \\lvert-3\\rvert\\\\\\lvert-7+4\\rvert &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p125-task19-24-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\lvert2-6\\rvert+\\lvert3+1\\rvert$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}\\lvert2-6\\rvert+\\lvert3+1\\rvert &= \\lvert-4\\rvert+\\lvert4\\rvert\\\\\\lvert2-6\\rvert+\\lvert3+1\\rvert &= 4+4\\\\\\lvert2-6\\rvert+\\lvert3+1\\rvert &= 8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p125-task19-24-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\lvert-2\\rvert\\lvert5\\rvert$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\lvert-2\\rvert\\lvert5\\rvert &= 2\\times5\\\\\\lvert-2\\rvert\\lvert5\\rvert &= 10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p125-task19-24-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\lvert3-7\\rvert+\\lvert-4+1\\rvert$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\lvert3-7\\rvert+\\lvert-4+1\\rvert &= \\lvert-4\\rvert+\\lvert-3\\rvert\\\\\\lvert3-7\\rvert+\\lvert-4+1\\rvert &= 4+3\\\\\\lvert3-7\\rvert+\\lvert-4+1\\rvert &= 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p125-task19-24-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left\\lvert\\lvert2-4\\rvert-\\lvert4-8\\rvert\\right\\rvert$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\left\\lvert\\lvert2-4\\rvert-\\lvert4-8\\rvert\\right\\rvert &= \\left\\lvert\\lvert-2\\rvert-\\lvert-4\\rvert\\right\\rvert\\\\\\left\\lvert\\lvert2-4\\rvert-\\lvert4-8\\rvert\\right\\rvert &= \\lvert2-4\\rvert\\\\\\left\\lvert\\lvert2-4\\rvert-\\lvert4-8\\rvert\\right\\rvert &= \\lvert-2\\rvert\\\\\\left\\lvert\\lvert2-4\\rvert-\\lvert4-8\\rvert\\right\\rvert &= 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
