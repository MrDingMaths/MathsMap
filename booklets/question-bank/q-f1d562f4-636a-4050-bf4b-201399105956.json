  "content": {
    "id": "p34-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "There is an 80% chance that Garry will pass his driving test and a 90% chance that Emma will pass hers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q12-draw",
        "type": "part",
        "label": "a",
        "prompt": "Draw a probability tree diagram.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P$ = pass; $F$ = fail. Garry: $P=0.8$, $F=0.2$. From each Garry outcome, Emma: $P=0.9$, $F=0.1$.",
          "worked": "Label the first stage Garry and the second stage Emma. Garry's branches have probabilities $0.8$ and $0.2$. From each first-stage outcome, Emma's branches have probabilities $0.9$ and $0.1$.",
          "solutionDiagrams": [
            {
              "id": "p34-q12-tree",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 34, p34-q12-tree\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black},line cap=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (S) at (0,0);\n\\coordinate (GP) at (2,1.5);\n\\coordinate (GF) at (2,-1.5);\n\\coordinate (PP) at (4.4,2.25);\n\\coordinate (PF) at (4.4,0.75);\n\\coordinate (FP) at (4.4,-0.75);\n\\coordinate (FF) at (4.4,-2.25);\n\\node[anchor=east] at (S) {Start};\n\\node at (2,2.95) {Garry};\n\\node at (4.4,2.95) {Emma};\n\\draw[black] (S) -- (GP) node[midway,above,sloped] {$0.8$};\n\\draw[black] (S) -- (GF) node[midway,below,sloped] {$0.2$};\n\\draw[black] (GP) -- (PP) node[midway,above,sloped] {$0.9$};\n\\draw[black] (GP) -- (PF) node[midway,below,sloped] {$0.1$};\n\\draw[black] (GF) -- (FP) node[midway,above,sloped] {$0.9$};\n\\draw[black] (GF) -- (FF) node[midway,below,sloped] {$0.1$};\n\\node[fill=white,inner sep=2pt] at (GP) {$P$};\n\\node[fill=white,inner sep=2pt] at (GF) {$F$};\n\\node[anchor=west] at (PP) {$P$};\n\\node[anchor=west] at (PF) {$F$};\n\\node[anchor=west] at (FP) {$P$};\n\\node[anchor=west] at (FF) {$F$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 85,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 34,
                "sourceRegion": "Question 12 supplied answer tree",
                "description": "Left-to-right two-stage tree, Garry then Emma, with pass above fail at each stage. Ordinary strokes and labels use house black; no shaded regions.",
                "mathematics": "Garry passes with probability 0.8 and fails with probability 0.2. Emma passes with probability 0.9 and fails with probability 0.1 after either Garry outcome.",
                "answerVisibility": "Answer only; omitted from the unsolved question."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p34-q12-events",
        "type": "group",
        "label": "",
        "prompt": "Find the chance that:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p34-q12-a",
            "type": "part",
            "label": "b",
            "prompt": "Garry passes and Emma fails.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8\\%$",
              "worked": "$$\\begin{aligned}P(\\text{Garry passes and Emma fails})&=0.8\\times0.1\\\\&=0.08\\\\&=8\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p34-q12-b",
            "type": "part",
            "label": "c",
            "prompt": "Garry fails and Emma passes.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$18\\%$",
              "worked": "$$\\begin{aligned}P(\\text{Garry fails and Emma passes})&=0.2\\times0.9\\\\&=0.18\\\\&=18\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p34-q12-c",
            "type": "part",
            "label": "d",
            "prompt": "Only one of Garry and Emma passes.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$26\\%$",
              "worked": "$$\\begin{aligned}P(\\text{only one passes})&=P(PF)+P(FP)\\\\&=8\\%+18\\%\\\\&=26\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p34-q12-d",
            "type": "part",
            "label": "e",
            "prompt": "At least one fails.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$28\\%$",
              "worked": "$$\\begin{aligned}P(\\text{at least one fails})&=1-P(\\text{both pass})\\\\&=1-0.8\\times0.9\\\\&=0.28\\\\&=28\\%\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          }
        ]
      }
    ]
  },
