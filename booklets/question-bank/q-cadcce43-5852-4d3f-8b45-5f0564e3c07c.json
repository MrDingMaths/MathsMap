  "content": {
    "id": "p39-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A goat is tethered by rope to the corner of a grassy field whose shape is an equilateral triangle of area $400\\text{ m}^2$. Find the length of the rope if the goat can access half of the field’s grass.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p39-q13-short-result",
            "type": "paragraph",
