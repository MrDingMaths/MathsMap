    "children": [
      {
        "id": "p22-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $3\\times 2^{3x+2}$ in the form $k\\times 8^x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\times 8^x$.",
          "worked": "$$\\begin{align*}3\\times 2^{3x+2}&=3\\times 2^2\\times (2^3)^x\\\\3\\times 2^{3x+2}&=12\\times 8^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p22-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "For $a>0$, explain why the equation $y=k\\times a^{bx+c}$ can be simplified down to $y=h\\times A^x$ without any loss of information.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=ka^c$ and $A=a^b$. The index laws give the same $y$ for every $x$.",
          "worked": "$$\\begin{align*}y&=k\\times a^{bx+c}\\\\y&=k\\times a^c\\times a^{bx}\\\\y&=(ka^c)(a^b)^x\\end{align*}$$\n\nWith $h=ka^c$ and $A=a^b$, this is $y=h\\times A^x$ for every $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
