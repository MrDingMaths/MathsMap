  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Check whether or not each point lies on the circle $x^2+y^2=100$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(6,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}x^2+y^2&=6^2+8^2\\\\x^2+y^2&=36+64\\\\x^2+y^2&=100\\end{align*}$$\nThe point lies on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(10,10)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}x^2+y^2&=10^2+10^2\\\\x^2+y^2&=100+100\\\\x^2+y^2&=200\\end{align*}$$\nSince $200\\ne100$, the point does not lie on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(20,80)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}x^2+y^2&=20^2+80^2\\\\x^2+y^2&=400+6400\\\\x^2+y^2&=6800\\end{align*}$$\nSince $6800\\ne100$, the point does not lie on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(-6,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}x^2+y^2&=(-6)^2+8^2\\\\x^2+y^2&=36+64\\\\x^2+y^2&=100\\end{align*}$$\nThe point lies on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(5\\sqrt{2},5\\sqrt{2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}x^2+y^2&=(5\\sqrt{2})^2+(5\\sqrt{2})^2\\\\x^2+y^2&=25\\times2+25\\times2\\\\x^2+y^2&=100\\end{align*}$$\nThe point lies on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(10,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}x^2+y^2&=10^2+0^2\\\\x^2+y^2&=100+0\\\\x^2+y^2&=100\\end{align*}$$\nThe point lies on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
