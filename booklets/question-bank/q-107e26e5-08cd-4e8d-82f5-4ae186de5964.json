  "classification": {
    "primarySkillId": "index-laws-variables",
    "secondarySkillIds": [],
    "archetype": "index-laws-topic-1",
    "reasoningScore": 40,
    "difficulty": "Development",
    "difficultyReason": "Identify several distinct multiplication-law misconceptions and correct each."
  },
  "content": {
    "id": "index-t1-q13-root",
    "type": "question",
    "label": null,
    "prompt": "Every answer is incorrect, state the error and write the correct answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t1-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{3} \\times x^{4} = x^{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Multiplied instead of added the exponents. Correct: $x^{7}$",
          "worked": "Add the exponents; do not multiply them. $x^3\\times x^4=x^{3+4}=x^7$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t1-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$y^{5} \\times y = y^{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Forgot the implied exponent of 1. Correct: $y^{6}$",
          "worked": "Use the implied exponent of 1. $y^5\\times y=y^{5+1}=y^6$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t1-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$a^{2} \\times a^{2} = 2a^{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Added the bases. Correct: $a^{4}$",
          "worked": "Multiplying powers does not introduce a coefficient of 2. $a^2\\times a^2=a^{2+2}=a^4$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t1-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$b^{3} \\times b^{4} = b^{34}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Wrote the exponents next to each other. Correct: $b^{7}$",
          "worked": "Add the exponents; do not concatenate their digits. $b^3\\times b^4=b^{3+4}=b^7$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t1-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$m^{5} \\times n^{3} = mn^{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Bases different, cannot use index laws. Correct simplification is $m^{5}n^{3}$",
          "worked": "The bases differ, so keep their powers separate. $m^5\\times n^3=m^5n^3$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t1-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$p^{2} \\times p^{3} = 2p^{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "There is no 2; just keep the base. Correct: $p^{5}$",
          "worked": "Keep the common base and add the exponents. $p^2\\times p^3=p^{2+3}=p^5$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t1-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$w^{6} \\times w^{2} = w^{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Subtracted instead of added. Correct: $w^{8}$",
          "worked": "Multiplication requires addition of exponents, not subtraction. $w^6\\times w^2=w^{6+2}=w^8$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
