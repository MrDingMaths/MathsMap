        "type": "part",
        "label": "a",
        "prompt": "Differentiate $e^{2-3x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6xe^{2-3x^2}$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}\\left(e^{2-3x^2}\\right)&=e^{2-3x^2}\\frac{d}{dx}(2-3x^2)\\\\&=-6xe^{2-3x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-a57f0-p58-practice-slot-13-slot-13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int xe^{2-3x^2}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac16e^{2-3x^2}+C$",
          "worked": "Using part a,\n$$\\begin{align*}\\int xe^{2-3x^2}\\,dx&=-\\frac16\\int -6xe^{2-3x^2}\\,dx\\\\&=-\\frac16e^{2-3x^2}+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
