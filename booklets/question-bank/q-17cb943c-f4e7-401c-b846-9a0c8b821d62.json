  "content": {
    "id": "p17-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A travel agency calculates the expense $E$ per person of organising a holiday in a group of $x$ people as $E=200+400x$. The cost $C$ for each person taking a holiday is $C=900-100x$.\n\nShow that the profit to the travel agency with a group of $x$ people is given by $P=700x-500x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P=x(C-E)=x(700-500x)=700x-500x^2$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p17-q17-worked-per-person-text",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Profit per person = Cost − Expenses",
                "marks": []
              }
            ]
          },
          {
            "id": "p17-q17-worked-per-person-maths",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}C-E&=(900-100x)-(200+400x)\\\\C-E&=700-500x\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p17-q17-worked-total-text",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Total profit = Number of people × Profit per person",
                "marks": []
              }
            ]
          },
          {
            "id": "p17-q17-worked-total-maths",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}P&=x(700-500x)\\\\P&=700x-500x^2\\end{aligned}",
                "display": true
              }
            ]
