        "type": "part",
        "label": "a",
        "prompt": "Use the index law for division to write $\\dfrac{5^2}{5^2}$ as a power of 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{2-2}=5^0$",
          "worked": "$$\\begin{align*}\\frac{5^2}{5^2}&=5^{2-2}\\\\&=5^0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p56-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "If a nonzero number is divided by itself, what is the answer?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$, so $5^0=1$.",
          "worked": "A nonzero number divided by itself is $1$. Since $\\dfrac{5^2}{5^2}=1$ and part a gives $5^0$, it follows that $5^0=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
