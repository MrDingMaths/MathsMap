  "content": {
    "id": "p29-feedback-spinner-variation-root",
    "type": "question",
    "label": "5",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "473075a6-4fe8-474b-8f64-92437921159c",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A spinner has four equal sections: red, blue, green and yellow. The spinner is spun several times. Each spin is independent of the others.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-feedback-spinner-variation-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "ebae4baf-b286-42f7-b8a9-77a904652f69",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Predict how the probability of getting at least one red changes as the number of spins increases.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It increases, but it never reaches 1.",
          "worked": "Each extra spin gives another chance to get red, so the probability of at least one red increases. There is always a chance that no red appears, so the probability stays below 1.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p29-feedback-spinner-variation-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "22c5a6d5-3805-4bc8-ab5f-70d3c7c3091c",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find the probability of getting at least one red in 1 spin.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "The complement is no red.\n$$\\begin{aligned}P(\\text{at least one red})&=1-P(\\text{no red})\\\\&=1-\\frac34\\\\&=\\frac14\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p29-feedback-spinner-variation-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "4db05a55-7de3-4acd-b408-1f6858d208bf",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find the probability of getting at least one red in 2 spins.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac7{16}$",
          "worked": "The complement is no red on both spins.\n$$\\begin{aligned}P(\\text{at least one red})&=1-P(\\text{no red})\\\\&=1-\\frac34\\times\\frac34\\\\&=1-\\frac9{16}=\\frac7{16}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p29-feedback-spinner-variation-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "e398b031-da79-4134-8c13-ca2cbe23491a",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find the probability of getting at least one red in 3 spins.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{37}{64}$",
          "worked": "The complement is no red on all three spins.\n$$\\begin{aligned}P(\\text{at least one red})&=1-P(\\text{no red})\\\\&=1-\\frac34\\times\\frac34\\times\\frac34\\\\&=1-\\frac{27}{64}=\\frac{37}{64}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p29-feedback-spinner-variation-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "356c51c9-6824-4b4d-a0ea-2e85c68ee644",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find the probability of getting at least one red in 4 spins.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{175}{256}$",
          "worked": "The complement is no red on all four spins.\n$$\\begin{aligned}P(\\text{at least one red})&=1-P(\\text{no red})\\\\&=1-\\frac34\\times\\frac34\\times\\frac34\\times\\frac34\\\\&=1-\\frac{81}{256}=\\frac{175}{256}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
