  "content": {
    "id": "p21-question-34-37-root",
    "type": "question",
    "label": null,
    "prompt": "Given $\\log_{10}(2)=a$ and $\\log_{10}(3)=b$, express the following in terms of $a$ and $b$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-question-34-37-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{10}(6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b$",
          "worked": "$$\\begin{align*}\\log_{10}(6)&=\\log_{10}(2)+\\log_{10}(3)\\\\\\log_{10}(6)&=a+b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-question-34-37-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-a$",
          "worked": "$$\\begin{align*}\\log_{10}(5)&=\\log_{10}\\left(\\frac{10}{2}\\right)\\\\\\log_{10}(5)&=\\log_{10}(10)-\\log_{10}(2)\\\\\\log_{10}(5)&=1-a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-34-37-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{10}(15)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-a+b$",
          "worked": "$$\\begin{align*}\\log_{10}(15)&=\\log_{10}\\left(\\frac{3\\times10}{2}\\right)\\\\\\log_{10}(15)&=\\log_{10}(3)+\\log_{10}(10)-\\log_{10}(2)\\\\\\log_{10}(15)&=1-a+b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-34-37-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{10}(18)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+2b$",
          "worked": "$$\\begin{align*}\\log_{10}(18)&=\\log_{10}(2\\times3^2)\\\\\\log_{10}(18)&=\\log_{10}(2)+2\\log_{10}(3)\\\\\\log_{10}(18)&=a+2b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
