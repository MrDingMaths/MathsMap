  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The curved surface area of a cone is $150\\text{ cm}^2$ and the radius of the base is $5\\text{ cm}$.\nGive answers correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the slant height?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9.5\\text{ cm}$",
          "worked": "$\\begin{align*}\\pi rl &= 150\\\\5\\pi l &= 150\\\\l &= \\frac{30}{\\pi}\\\\l &\\approx 9.5\\text{ cm}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the perpendicular height?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.1\\text{ cm}$",
          "worked": "Using Pythagoras and the unrounded slant height:\n$\\begin{align*}h^2 &= l^2-r^2\\\\h^2 &= \\left(\\frac{30}{\\pi}\\right)^2-5^2\\\\h &= \\sqrt{\\left(\\frac{30}{\\pi}\\right)^2-25}\\\\h &\\approx 8.1\\text{ cm}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the surface area of the cone?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$228.5\\text{ cm}^2$",
          "worked": "$\\begin{align*}A &= \\pi r^2+\\pi rl\\\\A &= \\pi(5)^2+150\\\\A &\\approx 228.5\\text{ cm}^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
