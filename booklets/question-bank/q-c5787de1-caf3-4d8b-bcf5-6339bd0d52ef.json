  "content": {
    "id": "p18-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find two natural numbers whose sum is 30 and whose least common multiple is 112.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$14$ and $16$.",
      "worked": "$$112=2^4\\times7.$$ Both numbers must divide $112$ and be less than $30$. The possible numbers are $1,2,4,7,8,14,16,28$. The pairs with sum $30$ are $(2,28)$ and $(14,16)$.\n\n$$\\begin{align*}\\operatorname{LCM}(2,28)&=28,\\\\14&=2\\times7,\\\\16&=2^4,\\\\\\operatorname{LCM}(14,16)&=2^4\\times7\\\\\\operatorname{LCM}(14,16)&=112.\\end{align*}$$\n\nTherefore, the numbers are $14$ and $16$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
