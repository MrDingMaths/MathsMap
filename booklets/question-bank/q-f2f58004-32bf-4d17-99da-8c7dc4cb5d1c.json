              "latex": "\\frac{x}{a}+\\frac{y}{b}=1",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $x$- and $y$-intercepts of this line and hence explain why it’s called the intercept form of a straight line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $a$; $y$-intercept: $b$. It is called intercept form because $a$ and $b$ directly give the two intercepts.",
          "worked": "When $y=0$:\n$$\\begin{aligned}\\frac{x}{a}&=1\\\\x&=a\\end{aligned}$$\nWhen $x=0$:\n$$\\begin{aligned}\\frac{y}{b}&=1\\\\y&=b\\end{aligned}$$\nThe intercepts are $(a,0)$ and $(0,b)$. It is called intercept form because $a$ and $b$ directly give the $x$- and $y$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p16-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the intercept form to find the equation of a line with $x$-intercept at $-2$ and $y$-intercept at $3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{-2}+\\dfrac{y}{3}=1$, or $3x-2y=-6$.",
          "worked": "$$\\begin{aligned}\\frac{x}{-2}+\\frac{y}{3}&=1\\\\-3x+2y&=6\\\\3x-2y&=-6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q9-c",
        "type": "group",
        "label": "c",
        "prompt": "Use this knowledge to quickly sketch these lines without any calculations.",
