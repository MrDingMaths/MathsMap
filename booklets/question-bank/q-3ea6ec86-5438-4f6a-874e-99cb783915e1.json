  "content": {
    "id": "p63-q26-response",
    "type": "question",
    "label": "26",
    "prompt": "Find the exact area of the region containing the origin bounded by the circle $x^2+y^2=4$ and the lines $x=1$ and $x=-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
