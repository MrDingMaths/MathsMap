  "content": {
    "id": "p21-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "$f(x)=3x+4$ and $g(x)=ax^2$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Work out an expression for $f^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p21-q17-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "f^{-1}(x)=\\frac{x-4}{3}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y&=3x+4\\\\x&=3y+4\\\\3y&=x-4\\\\y&=\\frac{x-4}{3}\\\\f^{-1}(x)&=\\frac{x-4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $f(g(3))=85$, find the value of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p21-q17-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}g(3)&=9a\\\\f(9a)&=27a+4\\\\27a+4&=85\\\\27a&=81\\\\a&=3\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
