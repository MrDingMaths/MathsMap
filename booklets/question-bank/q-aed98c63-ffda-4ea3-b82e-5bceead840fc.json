  "content": {
    "id": "p34-q10",
    "type": "question",
    "label": "10",
    "prompt": "In each case identify how the graph of the second equation can be obtained from the graph of the first by a suitable dilation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-2x$ and $y=3x^2-6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Vertical dilation by a factor of $3$.",
          "worked": "Replace $y$ with $\\frac{y}{k}$ in the first equation.\n$$\\begin{align*}\\frac{y}{k}&=x^2-2x\\\\y&=k(x^2-2x)\\\\y&=kx^2-2kx\\end{align*}$$\nComparing coefficients with $y=3x^2-6x$ gives $k=3$. The dilation is vertical by a factor of $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p34-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{1}{x-4}$ and $y=\\dfrac{1}{2x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal dilation by a factor of $\\tfrac12$.",
          "worked": "Replace $x$ with $\\frac{x}{a}$ in the first equation.\n$$\\begin{align*}y&=\\frac{1}{x/a-4}\\\\\\frac{1}{a}&=2\\\\a&=\\frac12\\end{align*}$$\nThe dilation is horizontal by a factor of $\\tfrac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p34-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=3^x$ and $y=3^{\\frac{x}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal dilation by a factor of $4$.",
          "worked": "Replace $x$ with $\\frac{x}{a}$ in the first equation.\n$$\\begin{align*}y&=3^{x/a}\\\\a&=4\\end{align*}$$\nThe dilation is horizontal by a factor of $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p34-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{1}{x+1}$ and $y=\\dfrac{2}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Vertical dilation by a factor of $2$.",
          "worked": "Replace $y$ with $\\frac{y}{k}$ in the first equation.\n$$\\begin{align*}\\frac{y}{k}&=\\frac{1}{x+1}\\\\y&=\\frac{k}{x+1}\\\\k&=2\\end{align*}$$\nThe dilation is vertical by a factor of $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
