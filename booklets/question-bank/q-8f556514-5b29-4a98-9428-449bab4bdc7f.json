      {
        "id": "p34-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the mode of $X$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "The greatest probability is $0.4$, which occurs at $X=3$. Therefore the mode is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p34-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Jane drives to work on two consecutive days. Assume the numbers of red traffic lights on the two days are independent. What is the probability that the number of traffic lights that are red is the same on both days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3$",
          "worked": "Let $X_1$ and $X_2$ be the numbers of red traffic lights on the first and second days. Independence gives\n$$\\begin{align*}P(X_1=X_2)&=P(0,0)+P(1,1)+P(2,2)+P(3,3)\\\\P(X_1=X_2)&=0.1^2+0.2^2+0.3^2+0.4^2\\\\P(X_1=X_2)&=0.01+0.04+0.09+0.16\\\\P(X_1=X_2)&=0.3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
