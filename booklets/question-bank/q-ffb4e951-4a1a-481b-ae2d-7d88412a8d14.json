    "answer": {
      "short": "19 cm, 19 cm and 22 cm. Let each equal side be $x$ cm; $3x+3=60$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p76-q23-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "x",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " be the length of each equal side, in centimetres.",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}x+x+(x+3)&=60\\\\3x+3&=60\\\\3x&=57\\\\x&=19\\end{aligned}",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "The sides are 19 cm, 19 cm and 22 cm.",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Check: ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "19+19+22=60",
                "display": false,
