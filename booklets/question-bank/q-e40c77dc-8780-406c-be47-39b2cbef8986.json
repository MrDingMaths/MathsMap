        "id": "p14-q7-a",
        "type": "group",
        "label": "a",
        "prompt": "Given that $p\\propto q$ and $p=12$ when $q=1.5$, find the exact value of:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q7-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$p$ when $q=6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$p=48$",
              "worked": "$$\\begin{align*}p&=kq\\\\12&=1.5k\\\\k&=8\\\\p&=8q\\\\p&=8\\times6\\\\p&=48\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          },
          {
            "id": "p14-q7-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$q$ when $p=81$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$q=\\frac{81}{8}$",
              "worked": "Using $p=8q$ from part (i):\n$$\\begin{align*}81&=8q\\\\q&=\\frac{81}{8}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p14-q7-b",
        "type": "group",
        "label": "b",
        "prompt": "Given that $a\\propto b^2$ and $a=20$ when $b=4$, find the formula for $a$ in terms of $b$ and find the exact value of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q7-b-formula",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=\\frac54b^2$",
              "worked": "$$\\begin{align*}a&=kb^2\\\\20&=k\\times4^2\\\\k&=\\frac{20}{16}=\\frac54\\\\a&=\\frac54b^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36,
