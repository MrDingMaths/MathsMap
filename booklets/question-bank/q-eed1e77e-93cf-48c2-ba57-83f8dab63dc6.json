      {
        "id": "p16-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f(x)=x\\tan^{-1}x-\\frac12\\ln(1+x^2)$, show that $f''(x)=\\dfrac{1}{1+x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=\\tan^{-1}x$, so $f''(x)=\\dfrac{1}{1+x^2}$.",
          "worked": "$$\\begin{aligned}f'(x)&=\\tan^{-1}x+\\frac{x}{1+x^2}-\\frac12\\cdot\\frac{2x}{1+x^2}\\\\&=\\tan^{-1}x+\\frac{x}{1+x^2}-\\frac{x}{1+x^2}\\\\&=\\tan^{-1}x,\\\\f''(x)&=\\frac{1}{1+x^2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Is the graph of $y=f(x)$ concave up or concave down at $x=-1$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave up, since $f''(-1)=\\frac12>0$.",
          "worked": "$$\\begin{aligned}f''(-1)&=\\frac{1}{1+(-1)^2}\\\\&=\\frac12>0.\\end{aligned}$$\nThe graph is concave up at $x=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
