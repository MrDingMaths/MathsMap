    "id": "v2-6b115e019-practice-slot-14-root",
    "type": "question",
    "label": null,
    "prompt": "Find the values of $x$ for which $y''=0$ if $y=x^4-2x^3-12x^2+x-3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=2,-1$",
      "worked": "$$\\begin{align*}y'&=4x^3-6x^2-24x+1\\\\y''&=12x^2-12x-24\\\\12x^2-12x-24&=0\\\\x^2-x-2&=0\\\\(x-2)(x+1)&=0\\\\x&=2,-1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
