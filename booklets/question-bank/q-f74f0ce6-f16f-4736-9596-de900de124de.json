  "content": {
    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find a formula for the circumference $C$ of a circle in terms of its area $A$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$C=\\sqrt{4A\\pi}$",
      "worked": "$$\\begin{align*}A&=\\pi r^2\\\\r&=\\sqrt{\\frac{A}{\\pi}}\\\\C&=2\\pi\\sqrt{\\frac{A}{\\pi}}\\\\C&=\\sqrt{4A\\pi}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
