  "content": {
    "id": "v2-b-p32-practice-p44-slot-10-upper-root",
    "type": "question",
    "label": null,
    "prompt": "A builder's plan of a house is drawn with a scale of $1:50$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b-p32-practice-p44-slot-10-upper-slot-10-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The lounge room is 9.4 cm long on the plan.\nFind its actual length in metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.7\\text{ m}$",
          "worked": "$$\\begin{align*}\\text{Actual length}&=9.4\\times50\\text{ cm}\\\\&=470\\text{ cm}\\\\&=4.7\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-b-p32-practice-p44-slot-10-upper-slot-10-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The deck is a rectangle that measures 12 cm by 7.5 cm on the plan.\nFind the actual perimeter of the deck in metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19.5\\text{ m}$",
          "worked": "$$\\begin{align*}\\text{Actual length}&=12\\times50\\text{ cm}=600\\text{ cm}=6\\text{ m}\\\\\\text{Actual width}&=7.5\\times50\\text{ cm}=375\\text{ cm}=3.75\\text{ m}\\\\\\text{Perimeter}&=2\\times(6+3.75)\\\\&=19.5\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
