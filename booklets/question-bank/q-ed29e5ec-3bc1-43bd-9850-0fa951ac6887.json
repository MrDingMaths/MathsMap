  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "If $f(x)=\\cos 2x$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-derivative",
        "type": "part",
        "label": "a",
        "prompt": "Find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-2\\sin 2x$",
          "worked": "$\\begin{aligned}f'(x)&=-\\sin(2x)\\times2\\\\&=-2\\sin 2x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p7-q4-values",
        "type": "group",
        "label": "",
        "prompt": "Then find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q4-a",
            "type": "part",
            "label": "b",
            "prompt": "$f'(0)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0$",
              "worked": "$\\begin{aligned}f'(0)&=-2\\sin 0\\\\&=0\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 11
          },
          {
            "id": "p7-q4-b",
            "type": "part",
            "label": "c",
            "prompt": "$f'\\left(\\frac{\\pi}{12}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1$",
              "worked": "$\\begin{aligned}f'\\left(\\frac{\\pi}{12}\\right)&=-2\\sin\\left(\\frac{\\pi}{6}\\right)\\\\&=-2\\left(\\frac12\\right)\\\\&=-1\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p7-q4-c",
            "type": "part",
            "label": "d",
            "prompt": "$f'\\left(\\frac{\\pi}{6}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\sqrt3$",
              "worked": "$\\begin{aligned}f'\\left(\\frac{\\pi}{6}\\right)&=-2\\sin\\left(\\frac{\\pi}{3}\\right)\\\\&=-2\\left(\\frac{\\sqrt3}{2}\\right)\\\\&=-\\sqrt3\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p7-q4-d",
            "type": "part",
            "label": "e",
            "prompt": "$f'\\left(\\frac{\\pi}{4}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2$",
              "worked": "$\\begin{aligned}f'\\left(\\frac{\\pi}{4}\\right)&=-2\\sin\\left(\\frac{\\pi}{2}\\right)\\\\&=-2(1)\\\\&=-2\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          }
        ]
      }
    ]
