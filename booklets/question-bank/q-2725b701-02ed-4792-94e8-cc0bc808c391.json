  "content": {
    "id": "p33-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Jim works for 4 days a week and earns \\$842.66 per week.\nFind how much he earns for these periods to the nearest cent.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Fortnightly",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1685.32 per fortnight.",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay} &= \\text{Weekly pay}\\times 2\\\\ &= \\$842.66\\times 2\\\\ &= \\$1685.32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Yearly",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$43 818.32 per year.",
          "worked": "$$\\begin{align*}\\text{Yearly pay} &= \\text{Weekly pay}\\times 52\\\\ &= \\$842.66\\times 52\\\\ &= \\$43\\,818.32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Monthly",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3651.53 per month.",
          "worked": "$$\\begin{align*}\\text{Yearly pay} &= \\$842.66\\times 52\\\\ &= \\$43\\,818.32\\\\ \\text{Monthly pay} &= \\frac{\\$43\\,818.32}{12}\\\\ &\\approx \\$3651.53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
