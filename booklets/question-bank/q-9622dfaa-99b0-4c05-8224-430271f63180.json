  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the values of $a$ and $b$ such that $x^2-8x+7=(x+a)^2+b$, and hence solve the equation $x^2-8x+7=0$ by instead solving $(x+a)^2+b=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-4$, $b=-9$. The solutions are $x=1$ and ${x=7}$.",
      "worked": "$$\\begin{align*}x^2-8x+7&=x^2-8x+16-16+7\\\\x^2-8x+7&=(x-4)^2-9\\end{align*}$$\nSo $a=-4$ and $b=-9$. Solve the resulting equation.\n$$\\begin{align*}(x-4)^2-9&=0\\\\(x-4)^2&=9\\\\x-4&=\\pm3\\\\x&=1,\\quad 7\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
