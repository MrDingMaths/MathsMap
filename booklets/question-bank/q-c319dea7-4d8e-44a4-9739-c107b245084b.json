  "content": {
    "id": "p9-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Consider $\\dfrac{2}{x+1}\\leq4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the restriction on the values of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne-1$",
          "worked": "$$\\begin{aligned}x+1&\\ne0\\\\x&\\ne-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p9-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Multiply both sides by $(x+1)^2$ to show $4(x+1)^2-2(x+1)\\geq0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(x+1)^2-2(x+1)\\geq0$",
          "worked": "For $x\\ne-1$, $(x+1)^2>0$, so the inequality direction is unchanged:\n$$\\begin{aligned}\\frac{2}{x+1}(x+1)^2&\\leq4(x+1)^2\\\\2(x+1)&\\leq4(x+1)^2\\\\4(x+1)^2-2(x+1)&\\geq0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p9-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Factorise out $(x+1)$ and show this simplifies to $(x+1)(2x+1)\\geq0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(2x+1)\\geq0$",
          "worked": "$$\\begin{aligned}(x+1)\\bigl(4(x+1)-2\\bigr)&\\geq0\\\\(x+1)(4x+2)&\\geq0\\\\2(x+1)(2x+1)&\\geq0\\\\(x+1)(2x+1)&\\geq0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p9-q2-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
