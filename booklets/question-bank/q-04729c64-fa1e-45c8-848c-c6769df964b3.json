        "id": "p32-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{\\sqrt{5}-2}+\\frac{2}{\\sqrt{5}+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt{5}+2$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{5}-2}+\\frac{2}{\\sqrt{5}+2}&=\\frac{3(\\sqrt{5}+2)}{5-4}+\\frac{2(\\sqrt{5}-2)}{5-4}\\\\\\frac{3}{\\sqrt{5}-2}+\\frac{2}{\\sqrt{5}+2}&=3\\sqrt{5}+6+2\\sqrt{5}-4\\\\\\frac{3}{\\sqrt{5}-2}+\\frac{2}{\\sqrt{5}+2}&=5\\sqrt{5}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2}{6-3\\sqrt{3}}-\\frac{1}{2\\sqrt{3}+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{3}$",
          "worked": "$$\\begin{align*}\\frac{2}{6-3\\sqrt{3}}-\\frac{1}{2\\sqrt{3}+3}&=\\frac{2(6+3\\sqrt{3})}{36-27}-\\frac{2\\sqrt{3}-3}{12-9}\\\\\\frac{2}{6-3\\sqrt{3}}-\\frac{1}{2\\sqrt{3}+3}&=\\frac{4+2\\sqrt{3}}{3}-\\frac{2\\sqrt{3}-3}{3}\\\\\\frac{2}{6-3\\sqrt{3}}-\\frac{1}{2\\sqrt{3}+3}&=\\frac{4+2\\sqrt{3}-2\\sqrt{3}+3}{3}\\\\\\frac{2}{6-3\\sqrt{3}}-\\frac{1}{2\\sqrt{3}+3}&=\\frac{7}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
