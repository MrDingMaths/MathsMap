            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "600 g of A and 400 g of B.",
                "marks": []
              }
            ]
          },
          {
            "id": "p17-q19-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
