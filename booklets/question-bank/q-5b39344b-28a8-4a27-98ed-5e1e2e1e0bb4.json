  "content": {
    "id": "p17-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A coffee blender mixes two types of coffee. Type $A$ costs $\\$13$ per kg and type $B$ costs $\\$18$ per kg. How many grams of each type of coffee should be blended so that 1 kg costs $\\$15$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p17-q19-short-result",
            "type": "paragraph",
