  "content": {
    "id": "p47-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q3-initial",
        "type": "part",
        "label": "a",
        "prompt": "Find the discriminant of $x^2+4x+k=0$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=16-4k$",
          "worked": "$\\begin{aligned}\\Delta&=b^2-4ac\\\\&=4^2-4(1)(k)\\\\&=16-4k\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p47-q3-followup",
        "type": "group",
        "label": "",
        "prompt": "By solving the inequality, find values of $k$ where the equation $x^2+4x+k=0$ has:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p47-q3-a",
            "type": "part",
            "label": "b",
            "prompt": "No real solutions $\\Delta<0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k>4$",
              "worked": "$\\Delta<0$ requires\n$$\\begin{aligned}16-4k&<0\\\\-4k&<-16\\\\k&>4\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p47-q3-b",
            "type": "part",
            "label": "c",
            "prompt": "One solution $\\Delta=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=4$",
              "worked": "$\\Delta=0$ requires\n$$\\begin{aligned}16-4k&=0\\\\-4k&=-16\\\\k&=4\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p47-q3-c",
            "type": "part",
            "label": "d",
            "prompt": "Two solutions $\\Delta>0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k<4$",
              "worked": "$\\Delta>0$ requires\n$$\\begin{aligned}16-4k&>0\\\\-4k&>-16\\\\k&<4\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
  },
