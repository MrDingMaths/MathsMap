  "content": {
    "id": "p8-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The value of a car depreciates by 12% per year. Faith's car cost $\\$55\\,000$ when new.\nWork out the value of the car after each time below. Round to 2 decimal places where needed.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q12-a-node",
        "type": "part",
        "label": "a",
        "prompt": "1 year",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$48\\,400$",
          "worked": "The yearly multiplier is $1-0.12=0.88$.\n$$\\begin{align*}V&=55\\,000\\times0.88\\\\&=\\$48\\,400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q12-b-node",
        "type": "part",
        "label": "b",
        "prompt": "5 years",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$29\\,025.26$",
          "worked": "The yearly multiplier is $0.88$.\n$$\\begin{align*}V&=55\\,000\\times(0.88)^5\\\\&\\approx\\$29\\,025.26\\end{align*}$$\nRounded to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q12-c-node",
        "type": "part",
        "label": "c",
        "prompt": "10 years",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$15\\,317.55$",
          "worked": "The yearly multiplier is $0.88$.\n$$\\begin{align*}V&=55\\,000\\times(0.88)^{10}\\\\&\\approx\\$15\\,317.55\\end{align*}$$\nRounded to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
