  "content": {
    "id": "p10-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Find the percentage profit or loss on costs in these situations. Give non-exact percentages to the nearest $0.1\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Costs $\\$26\\,000$ and sales $\\$52\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit}&=52\\,000-26\\,000\\\\\\text{Profit}&=\\$26\\,000\\\\\\text{Percentage profit}&=\\frac{26\\,000}{26\\,000}\\times100\\%\\\\\\text{Percentage profit}&=100\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Costs $\\$182\\,000$ and sales $\\$150\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17.6\\%$ loss",
          "worked": "$$\\begin{align*}\\text{Loss}&=182\\,000-150\\,000\\\\\\text{Loss}&=\\$32\\,000\\\\\\text{Percentage loss}&=\\frac{32\\,000}{182\\,000}\\times100\\%\\\\\\text{Percentage loss}&\\approx17.6\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
