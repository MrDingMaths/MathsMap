  "content": {
    "id": "p105-q29-root",
    "type": "question",
    "label": "29",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p105-q29-a",
        "type": "part",
        "label": "a",
        "prompt": "$1-\\left(\\frac{1}{2}+\\frac{1}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}1-\\left(\\frac{1}{2}+\\frac{1}{4}\\right)&=1-\\left(\\frac{2}{4}+\\frac{1}{4}\\right)\\\\&=1-\\frac{3}{4}\\\\&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p105-q29-b",
        "type": "part",
        "label": "b",
        "prompt": "$1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}\\right)&=1-\\left(\\frac{4}{8}+\\frac{2}{8}+\\frac{1}{8}\\right)\\\\&=1-\\frac{7}{8}\\\\&=\\frac{1}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p105-q29-c",
        "type": "part",
        "label": "c",
        "prompt": "$1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{16}$",
          "worked": "$$\\begin{align*}1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}\\right)&=1-\\left(\\frac{8}{16}+\\frac{4}{16}+\\frac{2}{16}+\\frac{1}{16}\\right)\\\\&=1-\\frac{15}{16}\\\\&=\\frac{1}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p105-q29-d",
        "type": "part",
        "label": "d",
        "prompt": "$1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}+\\frac{1}{32}+\\frac{1}{64}+\\frac{1}{128}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{128}$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}1-\\left(\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{8}+\\frac{1}{16}+\\frac{1}{32}+\\frac{1}{64}+\\frac{1}{128}\\right)\\\\&=1-\\left(\\frac{64+32+16+8+4+2+1}{128}\\right)\\\\&=1-\\frac{127}{128}\\\\&=\\frac{1}{128}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p105-q29-e",
        "type": "part",
        "label": "e",
        "prompt": "What do you notice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The answer equals the smallest fraction in the brackets. The sum in the brackets gets closer to $1$.",
          "worked": "The answers are $\\frac{1}{4}$, $\\frac{1}{8}$, $\\frac{1}{16}$ and $\\frac{1}{128}$, each equal to the smallest fraction in its brackets. As more successive halves are added, the sum gets closer to $1$ and the amount remaining gets smaller.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
