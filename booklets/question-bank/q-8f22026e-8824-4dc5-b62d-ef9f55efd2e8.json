  "content": {
    "id": "p12-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Ned has 4 blue tokens, 3 red tokens, and 2 green tokens. How many ways can he arrange these in a row?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1260$",
      "worked": "There are 9 tokens, identical within each colour.\n$$\\begin{align*}N&=\\frac{9!}{4!3!2!}\\\\N&=1260\\end{align*}$$",
      "solutionDiagrams": []
    },
