    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "one decade ago",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "855 robberies per year",
          "worked": "$$\\begin{align*}\\text{Robberies per year}&=958\\div1.12\\\\\\text{Robberies per year}&\\approx855\\end{align*}$$",
