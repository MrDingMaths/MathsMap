  "content": {
    "id": "p31-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A piece of string that is 1170 cm long is to be cut into 26 equal lengths. How long is each piece?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$45\\text{ cm}$",
      "worked": "Divide $1170$ by $26$ using long division. Since $26\\times4=104$, write $4$ in the tens place.\n\n$$117-104=13$$\n\nBring down the final $0$ to make $130$. Since $26\\times5=130$, write $5$ in the units place.\n\n$$130-130=0$$\n\nEach piece is $45\\text{ cm}$ long.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
