  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "$\\$14\\,200$ is invested for 2 years at 2.9% p.a. interest, compounded yearly.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the value of the investment after 2 years. Answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$15\\,035.54$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 14\\,200(1+0.029)^2\\\\FV &\\approx \\$15\\,035.54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the total amount of interest earned? Answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$835.54$",
          "worked": "$$\\begin{align*}I &= FV-PV\\\\I &= 14\\,200(1+0.029)^2-14\\,200\\\\I &\\approx \\$835.54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
