        "format": "tikz",
        "code": "\\begin{tikzpicture}[x=9mm,y=9mm,line width=0.8pt,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\coordinate (A) at (0,0);\\coordinate (B) at (4,0);\\coordinate (C) at (4,2);\\coordinate (P) at (2,3.5);\\coordinate (D) at (0,2);\n\\coordinate (Bv) at (5.2,0.8);\\coordinate (Cv) at (5.2,2.8);\\coordinate (Pv) at (3.2,4.3);\n\\draw[fill=white] (B)--(Bv)--(Cv)--(C)--cycle;\n\\draw[fill=white] (C)--(P)--(Pv)--(Cv)--cycle;\n\\draw[fill=white] (A)--(B)--(C)--(P)--(D)--cycle;\n\\draw[dashed,line width=0.4pt] (D)--(C);\n\\draw[<->,line width=0.4pt] (2,2)--(2,3.5);\n\\node[left] at (2,2.75) {$1.5\\text{ m}$};\n\\node[below] at (2,0) {$4\\text{ m}$};\n\\node[left] at (0,1) {$2\\text{ m}$};\n\\node[below right] at (4.6,0.4) {$3\\text{ m}$};\n\\end{tikzpicture}",
