  "content": {
    "id": "p40-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "For each normally distributed random variable, use the given mean and SD and the empirical rule to estimate the probability.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Mean 172, SD 8. Find $P(X>188)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.025$",
          "worked": "$$\\begin{aligned}z&=\\frac{188-172}{8}\\\\&=2\\end{aligned}$$\nUsing the empirical rule,\n$$\\begin{aligned}P(X>188)&=P(z>2)\\\\&\\approx\\frac{1-0.95}{2}\\\\&=0.025.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p40-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Mean 172, SD 8. Find $P(X<156)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.025$",
          "worked": "$$\\begin{aligned}z&=\\frac{156-172}{8}\\\\&=-2\\end{aligned}$$\nUsing the empirical rule,\n$$\\begin{aligned}P(X<156)&=P(z<-2)\\\\&\\approx\\frac{1-0.95}{2}\\\\&=0.025.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p40-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Mean 172, SD 8. Find $P(X>164)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.84$",
          "worked": "$$\\begin{aligned}z&=\\frac{164-172}{8}\\\\&=-1\\end{aligned}$$\nUsing symmetry and the empirical rule,\n$$\\begin{aligned}P(X>164)&=P(z>-1)\\\\&\\approx0.5+\\frac{0.68}{2}\\\\&=0.84.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p40-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Mean 50, SD 5. Find $P(X>60)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.025$",
          "worked": "$$\\begin{aligned}z&=\\frac{60-50}{5}\\\\&=2\\end{aligned}$$\nUsing the empirical rule,\n$$\\begin{aligned}P(X>60)&=P(z>2)\\\\&\\approx\\frac{1-0.95}{2}\\\\&=0.025.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p40-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "Mean 50, SD 5. Find $P(X<35)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.0015$",
          "worked": "$$\\begin{aligned}z&=\\frac{35-50}{5}\\\\&=-3\\end{aligned}$$\nUsing the empirical rule,\n$$\\begin{aligned}P(X<35)&=P(z<-3)\\\\&\\approx\\frac{1-0.997}{2}\\\\&=0.0015.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p40-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "Mean 50, SD 5. Find $P(X>45)$.",
