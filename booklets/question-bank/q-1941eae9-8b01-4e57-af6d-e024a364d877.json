    "children": [
      {
        "id": "p48-q28-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the double-angle formulae to rewrite $2\\cos^2x$ in terms of $\\cos 2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\cos^2x=1+\\cos 2x$.",
          "worked": "$$\\begin{align*}\\cos 2x&=2\\cos^2x-1\\\\2\\cos^2x&=1+\\cos 2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p48-q28-b",
        "type": "part",
        "label": "b",
        "prompt": "Use part a to find an implicit equation for the solution of the DE $\\dfrac{dy}{dx}=\\dfrac{2\\cos^2x}{y}$ passing through $(0,\\sqrt2)$. Do not solve for $y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^2=2x+\\sin 2x+2$.",
          "worked": "$$\\begin{align*}y\\,dy&=2\\cos^2x\\,dx\\\\y\\,dy&=(1+\\cos 2x)\\,dx\\\\\\int y\\,dy&=\\int(1+\\cos 2x)\\,dx\\\\\\frac{y^2}{2}&=x+\\frac12\\sin 2x+C\\end{align*}$$\nSubstitute $(0,\\sqrt2)$:\n$$\\begin{align*}1&=0+0+C\\\\C&=1\\\\y^2&=2x+\\sin 2x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
