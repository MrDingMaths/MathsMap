  "content": {
    "id": "p55-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the equation of the line that is perpendicular to $y=5-\\frac14x$ and passes through $(0,28)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=4x+28$",
      "worked": "The perpendicular gradient is the negative reciprocal.\n$$\\begin{align*}m_{\\mathrm{orig}}&=-\\frac14\\\\m_{\\mathrm{perp}}&=4\\\\c_{\\mathrm{perp}}&=28\\\\y&=4x+28\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
