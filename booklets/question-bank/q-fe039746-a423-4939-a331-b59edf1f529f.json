    "children": [
      {
        "id": "p23-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $\\sin^2x$ in terms of $\\cos 2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2x=\\frac12-\\frac12\\cos 2x$",
          "worked": "$$\\begin{aligned}\\cos 2x&=1-2\\sin^2x\\\\\\sin^2x&=\\frac12-\\frac12\\cos 2x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p23-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "The region bounded by the curve $y=\\sin x$, the $x$-axis and the vertical line $x=\\frac{\\pi}{2}$ is rotated about the $x$-axis. Find the volume of the solid generated.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi^2}{4}\\text{ units}^3$",
          "worked": "$$\\begin{aligned}V&=\\pi\\int_0^{\\pi/2}\\sin^2x\\,dx\\\\V&=\\pi\\int_0^{\\pi/2}\\left(\\frac12-\\frac12\\cos 2x\\right)\\,dx\\\\V&=\\pi\\left[\\frac{x}{2}-\\frac{\\sin 2x}{4}\\right]_0^{\\pi/2}\\\\V&=\\frac{\\pi^2}{4}\\text{ units}^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
