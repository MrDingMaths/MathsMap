  "content": {
    "id": "p45-q8-13-node",
    "type": "question",
    "label": "8",
    "prompt": "Let $P(2,6)$ be a point on $y=f(x)$. Find the new coordinates of $P$ on the graph of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q8",
        "type": "part",
        "label": "a",
        "prompt": "$y=5f(2x+4)-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,26)$",
          "worked": "Since $f(2)=6$, set the argument equal to $2$:\n$$\\begin{align*}2x+4&=2\\\\x&=\\frac{2-4}{2}\\\\x&=-1\\\\y&=5(6)-4\\\\y&=26\\end{align*}$$\nThe new coordinates are $(-1,26)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p45-q9",
        "type": "part",
        "label": "b",
        "prompt": "$y=2f(3x-7)+5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,17)$",
          "worked": "Since $f(2)=6$:\n$$\\begin{align*}3x-7&=2\\\\x&=\\frac{2+7}{3}\\\\x&=3\\\\y&=2(6)+5\\\\y&=17\\end{align*}$$\nThe new coordinates are $(3,17)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p45-q10",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{f(2x)-3}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(1,\\frac32\\right)$",
          "worked": "Since $f(2)=6$:\n$$\\begin{align*}2x&=2\\\\x&=1\\\\y&=\\frac{6-3}{2}\\\\y&=\\frac32\\end{align*}$$\nThe new coordinates are $\\left(1,\\frac32\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p45-q11",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac13 f(2x+1)-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac12,1\\right)$",
          "worked": "Since $f(2)=6$:\n$$\\begin{align*}2x+1&=2\\\\x&=\\frac{2-1}{2}\\\\x&=\\frac12\\\\y&=\\frac13(6)-1\\\\y&=1\\end{align*}$$\nThe new coordinates are $\\left(\\frac12,1\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p45-q12",
        "type": "part",
        "label": "e",
        "prompt": "$y=-f\\!\\left(\\frac{3x-1}{2}\\right)-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p45-q12-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\left(\\frac53,-10\\right)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p45-q12-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Set the argument equal to 2; reflect the original vertical coordinate and subtract 4.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Since $f(2)=6$:\n$$\\begin{align*}\\frac{3x-1}{2}&=2\\\\3x-1&=4\\\\x&=\\frac53\\\\y&=-6-4\\\\y&=-10\\end{align*}$$\nThe new coordinates are $\\left(\\frac53,-10\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p45-q13",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac32 f\\!\\left(\\frac{1-2x}{3}\\right)-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p45-q13-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\left(-\\frac52,7\\right)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p45-q13-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Set the argument equal to 2; multiply the original vertical coordinate by ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac32",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and subtract 2.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Since $f(2)=6$:\n$$\\begin{align*}\\frac{1-2x}{3}&=2\\\\1-2x&=6\\\\x&=-\\frac52\\\\y&=\\frac32(6)-2\\\\y&=7\\end{align*}$$\nThe new coordinates are $\\left(-\\frac52,7\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
    ]
  },
