    "children": [
      {
        "id": "v2-c10bb-p19-practice-slot-2-2-slot-2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=ax+b$.\n\nIf $f(2)=7$ and $f^{-1}(1)=-1$, work out the values of $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$, $b=3$.",
          "worked": "Apply $f$ to both sides of $f^{-1}(1)=-1$.\n$$\\begin{align*}f(-1)&=1\\\\-a+b&=1\\end{align*}$$\nAlso $f(2)=7$ gives\n$$\\begin{align*}2a+b&=7\\\\3a&=6\\\\a&=2.\\end{align*}$$\nSubstitute into $-a+b=1$.\n$$\\begin{align*}-2+b&=1\\\\b&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-c10bb-p19-practice-slot-2-2-slot-2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=3x-2$ and $g(x)=px+q$.\n\nIf $g\\left(f^{-1}(4)\\right)=11$ and $g^{-1}(5)=f(1)$, work out the values of $p$ and $q$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=6$, $q=-1$.",
          "worked": "Find $f^{-1}(4)$.\n$$\\begin{align*}f(x)&=4\\\\3x-2&=4\\\\x&=2\\end{align*}$$\nSo $g(2)=11$. Also $f(1)=1$, so $g^{-1}(5)=1$ and\n$$g(1)=5.$$\nThen\n$$\\begin{align*}2p+q&=11\\\\p+q&=5\\\\p&=6.\\end{align*}$$\nSubstitute into $p+q=5$.\n$$\\begin{align*}6+q&=5\\\\q&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
