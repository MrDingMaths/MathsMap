          "inlines": [
            {
              "type": "text",
              "text": "A survey of Year 7 students’ favourite sport is carried out.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "One fifth reply that netball is their favourite, one-quarter rugby and one-third soccer.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "The remainder of students leave the question unanswered.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the Year 7 students answered the survey question?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{47}{60}$",
          "worked": "$$\\begin{align*}\\frac{1}{5}+\\frac{1}{4}+\\frac{1}{3}&=\\frac{12}{60}+\\frac{15}{60}+\\frac{20}{60}\\\\&=\\frac{47}{60}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the Year 7 students left the question unanswered?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{60}$",
          "worked": "$$\\begin{align*}1-\\frac{47}{60}&=\\frac{60}{60}-\\frac{47}{60}\\\\&=\\frac{13}{60}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
