    "children": [
      {
        "id": "p68-q51-a",
        "type": "part",
        "label": "a",
        "prompt": "State any restrictions on $x$ and $y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\le x\\le1$, $0\\le y\\le1$.",
          "worked": "Since $x=\\cos t$ and $y=\\sin^2t$, their ranges give $-1\\le x\\le1$ and $0\\le y\\le1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p68-q51-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the Cartesian equation of the curve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1-x^2$, where $-1\\le x\\le1$.",
          "worked": "$$\\begin{align*}y&=\\sin^2t\\\\y&=1-\\cos^2t\\\\y&=1-x^2\\end{align*}$$Since $x=\\cos t$, the restriction is $-1\\le x\\le1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p68-q51-c",
        "type": "part",
        "label": "c",
        "prompt": "Sketch the graph of the curve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The arc of $y=1-x^2$ from $(-1,0)$ to $(1,0)$, with both endpoints included and vertex $(0,1)$.",
