  "content": {
    "id": "p4-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Use Pythagoras’ theorem to find the unknown side in each of the two right-angled triangles, then find the values of the following trigonometric ratios.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "p4-q2-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 4 p4-q2-diagram\"}\n\\begin{tikzpicture}[x=0.25cm,y=0.25cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont},draw=black,text=black]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (L) at (-6,0);\n\\coordinate (F) at (0,0);\n\\coordinate (R) at (15,0);\n\\coordinate (B) at (0,-8);\n\\draw (L)--(R)--(B)--cycle;\n\\draw (F)--node[midway,right] {$8$}(B);\n\\path (L)--node[midway,below left] {$10$}(B);\n\\draw[line width=0.4pt] (-0.8,0)--(-0.8,-0.8)--(0,-0.8);\n\\draw[line width=0.4pt] (0,-0.8)--(0.8,-0.8)--(0.8,0);\n\\draw[<->,line width=0.4pt] ($(F)+(0,1.2)$)--node[midway,above] {$15$}($(R)+(0,1.2)$);\n\\path (L) ++(-26.565:2.2) node {$x$};\n\\path (R) ++(194.036:2.7) node {$y$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 60,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 4,
          "sourceRegion": "Question 2, joined triangles",
          "description": "Joined downward-pointing right triangles with a shared perpendicular. The dimension arrow labels only the right horizontal segment.",
          "mathematics": "The shared perpendicular has length 8. The left hypotenuse has length 10. The right horizontal leg has length 15. Angle x is at the left top vertex and angle y at the right top vertex. Both triangles are right-angled at the shared top vertex.",
          "answerVisibility": "Only supplied lengths and angle labels are visible; the missing lengths 6 and 17 are withheld."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p4-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cot x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac34$",
          "worked": "Let the unknown horizontal side of the left triangle be $a$.\n$$\\begin{align*}a^2&=10^2-8^2\\\\a^2&=36\\\\a&=6\\\\\\cot x&=\\frac{\\mathrm{Adj}}{\\mathrm{Opp}}\\\\\\cot x&=\\frac68=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\operatorname{cosec} y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{17}{8}$",
          "worked": "Let the unknown hypotenuse of the right triangle be $h$.\n$$\\begin{align*}h^2&=15^2+8^2\\\\h^2&=289\\\\h&=17\\\\\\operatorname{cosec} y&=\\frac{\\mathrm{Hyp}}{\\mathrm{Opp}}\\\\\\operatorname{cosec} y&=\\frac{17}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sec x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac53$",
          "worked": "Using the horizontal side $6$ found in part a,\n$$\\begin{align*}\\sec x&=\\frac{\\mathrm{Hyp}}{\\mathrm{Adj}}\\\\\\sec x&=\\frac{10}{6}=\\frac53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cot y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{15}{8}$",
          "worked": "$$\\begin{align*}\\cot y&=\\frac{\\mathrm{Adj}}{\\mathrm{Opp}}\\\\\\cot y&=\\frac{15}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ],
