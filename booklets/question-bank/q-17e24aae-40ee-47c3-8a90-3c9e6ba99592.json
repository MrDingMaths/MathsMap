    "difficulty": "Challenge",
    "difficultyReason": "Generalises the digit-sum test for divisibility by 9 using place value."
  },
  "content": {
    "id": "p92-q77-root",
    "type": "question",
    "label": "77",
    "prompt": "Consider that the two-digit number $\\overline{ab}$ can be written as $10a+b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p92-q77-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why this number is divisible by 9 if the digit sum $a+b$ is divisible by 9.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10a+b=9a+(a+b)$. Both terms are divisible by 9 when $a+b$ is divisible by 9.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p92-q77-a-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}10a+b&=9a+a+b\\\\10a+b&=9a+(a+b)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-a-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "9a",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is divisible by 9, the number is divisible by 9 whenever ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "a+b",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " (the digit sum) is divisible by 9.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p92-q77-b",
        "type": "part",
        "label": "b",
        "prompt": "Extend the rule ‘a number is divisible by 9 if its digit sum is divisible by 9’ for a three-digit number $\\overline{abc}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100a+10b+c=99a+9b+(a+b+c)$. The number is divisible by 9 if its digit sum $a+b+c$ is divisible by 9.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p92-q77-b-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}100a+10b+c&=99a+9b+a+b+c\\\\100a+10b+c&=(99a+9b)+(a+b+c)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-b-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "99a+9b",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is divisible by 9, the number is divisible by 9 whenever ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "a+b+c",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " (the digit sum) is divisible by 9.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p92-q77-c",
        "type": "part",
        "label": "c",
        "prompt": "Does this work for all whole numbers written in base ten? Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. Each power of 10 is one more than a multiple of 9, so a whole number differs from its digit sum by a multiple of 9.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p92-q77-c-introduction",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Consider an ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "(n+1)",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": "-digit whole number with digits ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "d_n,d_{n-1},d_{n-2},\\ldots,d_1,d_0",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-place-value",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The number can be written as",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "d_n\\times10^n+d_{n-1}\\times10^{n-1}+\\cdots+d_1\\times10^1+d_0\\times10^0.",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-nines",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "n\\geq1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "10^n-1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " consists of n digits, each equal to 9, so it is divisible by 9. Therefore, the number can be written as follows.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-repeated-introduction",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Any whole number with digits ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "d_n,d_{n-1},\\ldots,d_1,d_0",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " can be written as:",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-expanded-number",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(d_n\\cdot10^n)+(d_{n-1}\\cdot10^{n-1})+\\cdots+d_1\\cdot10^1+d_0\\cdot10^0",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-split-product",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "We can split each product, for example",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "d_n\\cdot10^n=d_n(10^n-1)+d_n.",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-multiples",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "10^n-1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is a multiple of 9 (for example, 9, 99, 999, …; it is 0 when n = 0). So:",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-annotated-decomposition",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}d_n\\cdot10^n+\\cdots+d_0&=\\underbrace{d_n(10^n-1)+\\cdots+d_1(10-1)}_{\\text{divisible by 9}}\\\\ &\\quad+\\underbrace{(d_n+d_{n-1}+\\cdots+d_0)}_{\\text{digit sum}}\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The first part is divisible by 9, so the whole number is divisible by 9 if and only if the digit sum is divisible by 9.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p92-q77-c-final",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Yes.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 85
      }
    ]
