        "answer": {
          "short": "$-4x-12$",
          "worked": "$$\\begin{aligned}(x+2)^2-(x+4)^2&=x^2+4x+4-(x^2+8x+16)\\\\(x+2)^2-(x+4)^2&=x^2+4x+4-x^2-8x-16\\\\(x+2)^2-(x+4)^2&=-4x-12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-1h-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+6)^2-(x+5)^2$",
