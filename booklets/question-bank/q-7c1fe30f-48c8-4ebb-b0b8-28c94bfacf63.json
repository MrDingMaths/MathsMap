  "content": {
    "id": "p19-q5",
    "type": "question",
    "label": "5",
    "prompt": "Two marbles are picked at random, one from a bag containing three red and four blue marbles, and the other from a bag containing five red and two blue. Find the probability of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Two red marbles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15}{49}$",
          "worked": "$$\\begin{align*}P(\\text{two red})&=\\frac{3}{7}\\times\\frac{5}{7}\\\\P(\\text{two red})&=\\frac{15}{49}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Two blue marbles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8}{49}$",
          "worked": "$$\\begin{align*}P(\\text{two blue})&=\\frac{4}{7}\\times\\frac{2}{7}\\\\P(\\text{two blue})&=\\frac{8}{49}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "A red from the first bag and blue from second",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6}{49}$",
          "worked": "The selections from the two bags are independent.\n$$\\begin{align*}P(R_1\\text{ and }B_2)&=\\frac{3}{7}\\times\\frac{2}{7}\\\\P(R_1\\text{ and }B_2)&=\\frac{6}{49}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
