  "content": {
    "id": "p17-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Express $\\dfrac{1}{\\sqrt{2}+\\sqrt{3}+\\sqrt{5}}$ with a rational denominator.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{2\\sqrt{3}+3\\sqrt{2}-\\sqrt{30}}{12}$.\n\nTreat $\\sqrt{2}+\\sqrt{3}$ as one term when choosing the first conjugate.",
      "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{2}+\\sqrt{3}+\\sqrt{5}}&=\\frac{\\sqrt{2}+\\sqrt{3}-\\sqrt{5}}{(\\sqrt{2}+\\sqrt{3})^2-(\\sqrt{5})^2}\\\\\\frac{1}{\\sqrt{2}+\\sqrt{3}+\\sqrt{5}}&=\\frac{\\sqrt{2}+\\sqrt{3}-\\sqrt{5}}{2+2\\sqrt{6}+3-5}\\\\\\frac{1}{\\sqrt{2}+\\sqrt{3}+\\sqrt{5}}&=\\frac{\\sqrt{2}+\\sqrt{3}-\\sqrt{5}}{2\\sqrt{6}}\\times\\frac{\\sqrt{6}}{\\sqrt{6}}\\\\\\frac{1}{\\sqrt{2}+\\sqrt{3}+\\sqrt{5}}&=\\frac{\\sqrt{12}+\\sqrt{18}-\\sqrt{30}}{12}\\\\\\frac{1}{\\sqrt{2}+\\sqrt{3}+\\sqrt{5}}&=\\frac{2\\sqrt{3}+3\\sqrt{2}-\\sqrt{30}}{12}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
