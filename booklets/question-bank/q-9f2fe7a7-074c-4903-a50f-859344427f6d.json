        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Adding an integer to itself as many times as the modulus gives a sum congruent to zero.",
          "worked": "Each sum is a multiple of its modulus. Adding an integer $a$ to itself $m$ times gives $ma$, which is divisible by $m$, so its remainder is zero:\n\n$$\\underbrace{a+a+\\cdots+a}_{m\\text{ terms}}=ma\\equiv0\\pmod{m}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
