  "content": {
    "id": "p25-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Convert each measurement into nanoseconds.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "One day",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.64\\times10^{13}\\text{ ns}$",
          "worked": "$$\\begin{aligned}1\\text{ day}&=24\\times60\\times60=86400\\text{ s}\\\\&=86400\\times10^9\\text{ ns}\\\\&=8.64\\times10^{13}\\text{ ns}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "One week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.048\\times10^{14}\\text{ ns}$",
          "worked": "$$\\begin{aligned}1\\text{ week}&=604800\\text{ s}\\\\&=604800\\times10^9\\text{ ns}\\\\&=6.048\\times10^{14}\\text{ ns}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "14 hours 35 seconds",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.0435\\times10^{13}\\text{ ns}$",
          "worked": "$$\\begin{aligned}t&=14\\times3600+35=50435\\text{ s}\\\\t&=50435\\times10^9\\text{ ns}\\\\t&=5.0435\\times10^{13}\\text{ ns}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "672 microseconds",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.72\\times10^5\\text{ ns}$",
          "worked": "One microsecond is 1000 nanoseconds.\n$$\\begin{aligned}t&=672\\times1000\\text{ ns}\\\\t&=6.72\\times10^5\\text{ ns}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
