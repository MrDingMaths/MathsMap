  "content": {
    "id": "p34-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Bread mix bags have mean weight $4.95$ kg and standard deviation $0.15$ kg. Assume the weights are approximately normally distributed. Bags are rejected if under $4.65$ kg or over $5.25$ kg.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage are rejected?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $5\\%$.",
          "worked": "$$\\begin{aligned}z(4.65)&=\\frac{4.65-4.95}{0.15}=-2\\\\z(5.25)&=\\frac{5.25-4.95}{0.15}=2\\end{aligned}$$\nApproximately $95\\%$ lie within $2$ standard deviations, so the percentage rejected is $100\\%-95\\%=5\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p34-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage are rejected for being too light?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $2.5\\%$.",
          "worked": "The two tails outside $2$ standard deviations contain approximately $5\\%$ altogether. By symmetry, $$P(X<4.65)=P(Z<-2)\\approx\\frac{5\\%}{2}=2.5\\%.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q17-c",
        "type": "group",
        "label": "c",
        "prompt": "The manager changes the rule: only bags outside $3$ standard deviations are rejected.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p34-q17-c-i",
            "type": "part",
            "label": "i",
            "prompt": "What percentage will be rejected?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Approximately $0.3\\%$.",
              "worked": "Approximately $99.7\\%$ lie within $3$ standard deviations. The percentage rejected is $$100\\%-99.7\\%=0.3\\%.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p34-q17-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What weights will be rejected?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Weights below $4.5$ kg or above $5.4$ kg.",
              "worked": "$$\\begin{aligned}\\mu-3\\sigma&=4.95-3(0.15)=4.5\\text{ kg}\\\\\\mu+3\\sigma&=4.95+3(0.15)=5.4\\text{ kg}\\end{aligned}$$\nReject bags with $X<4.5$ kg or $X>5.4$ kg.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      }
    ]
  },
