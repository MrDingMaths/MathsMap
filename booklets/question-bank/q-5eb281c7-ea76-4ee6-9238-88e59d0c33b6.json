            "children": [],
            "answer": {
              "short": "$1296$",
              "worked": "Each die has six possible results, so the number of ordered outcomes is $6^4=1296$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10,
            "responseSpace": "scaffold"
          },
          {
            "id": "p27-challenge-q3-b-ii",
