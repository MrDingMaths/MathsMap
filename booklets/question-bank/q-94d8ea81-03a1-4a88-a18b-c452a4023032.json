    "children": [
      {
        "id": "p46-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the quotient and remainder when $x^4-2x^3+x^2-5x+7$ is divided by $x^2+x-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Quotient: $x^2-3x+5$; remainder: $12-13x$.",
          "worked": "$$\\begin{array}{r|l}&x^2-3x+5\\\\\\hline x^2+x-1&x^4-2x^3+x^2-5x+7\\\\&\\underline{-(x^4+x^3-x^2)}\\\\&-3x^3+2x^2-5x+7\\\\&\\underline{-(-3x^3-3x^2+3x)}\\\\&5x^2-8x+7\\\\&\\underline{-(5x^2+5x-5)}\\\\&-13x+12\\end{array}$$\nQuotient: $x^2-3x+5$; remainder: $12-13x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p46-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $a$ and $b$ such that $x^4-2x^3+x^2+ax+b$ is exactly divisible by $x^2+x-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=8$, $b=-5$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p46-q11-b-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Using the long division in part a, the remainder is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(ax-3x-5x)+(b+5)=(a-8)x+(b+5)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p46-q11-b-zero",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For exact divisibility, both coefficients of the remainder must be zero.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p46-q11-b-coefficients",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}a-8&=0\\\\b+5&=0\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p46-q11-b-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=8,\\qquad b=-5",
                    "display": false
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
