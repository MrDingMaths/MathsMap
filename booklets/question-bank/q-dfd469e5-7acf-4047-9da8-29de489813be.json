  "content": {
    "id": "p57-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify the following. $\\sqrt[3]{x^5}\\times\\sqrt x$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^{\\frac{13}{6}}$, $x\\ge0$.",
      "worked": "The square root requires $x\\ge0$.\n$$\\begin{align*}\\sqrt[3]{x^5}\\times\\sqrt x&=x^{\\frac{5}{3}}x^{\\frac{1}{2}}\\\\\\sqrt[3]{x^5}\\times\\sqrt x&=x^{\\frac{10}{6}+\\frac{3}{6}}\\\\\\sqrt[3]{x^5}\\times\\sqrt x&=x^{\\frac{13}{6}}.\\end{align*}$$",
      "solutionDiagrams": []
    },
