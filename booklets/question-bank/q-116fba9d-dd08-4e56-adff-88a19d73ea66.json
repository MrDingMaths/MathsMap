    "children": [
      {
        "id": "p18-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3x}{10}+\\frac{x}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{5}$",
          "worked": "$$\\begin{align*}\\frac{3x}{10}+\\frac{x}{10}&=\\frac{4x}{10}\\\\\\frac{3x}{10}+\\frac{x}{10}&=\\frac{2x}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{7x}{6}-\\frac{3x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x}{12}$",
          "worked": "$$\\begin{align*}\\frac{7x}{6}-\\frac{3x}{4}&=\\frac{14x}{12}-\\frac{9x}{12}\\\\\\frac{7x}{6}-\\frac{3x}{4}&=\\frac{14x-9x}{12}\\\\\\frac{7x}{6}-\\frac{3x}{4}&=\\frac{5x}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x}{2}+\\frac{3x}{4}-\\frac{2x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{12}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}+\\frac{3x}{4}-\\frac{2x}{3}&=\\frac{6x+9x-8x}{12}\\\\\\frac{x}{2}+\\frac{3x}{4}-\\frac{2x}{3}&=\\frac{7x}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p18-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{x+1}+\\frac{1}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(2x+5)}{(x+3)(x+1)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+1}+\\frac{1}{x+3}&=\\frac{3(x+3)+(x+1)}{(x+1)(x+3)}\\\\\\frac{3}{x+1}+\\frac{1}{x+3}&=\\frac{4x+10}{(x+1)(x+3)}\\\\\\frac{3}{x+1}+\\frac{1}{x+3}&=\\frac{2(2x+5)}{(x+1)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{5}{x+2}+\\frac{4}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3(3x+1)}{(x+2)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{5}{x+2}+\\frac{4}{x-1}&=\\frac{5(x-1)+4(x+2)}{(x+2)(x-1)}\\\\\\frac{5}{x+2}+\\frac{4}{x-1}&=\\frac{9x+3}{(x+2)(x-1)}\\\\\\frac{5}{x+2}+\\frac{4}{x-1}&=\\frac{3(3x+1)}{(x+2)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5}{x-2}+\\frac{1}{1-3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14x-3}{(x-2)(3x-1)}$\n\nUse $1-3x=-(3x-1)$ before combining.",
          "worked": "$$\\begin{align*}\\frac{5}{x-2}+\\frac{1}{1-3x}&=\\frac{5}{x-2}-\\frac{1}{3x-1}\\\\\\frac{5}{x-2}+\\frac{1}{1-3x}&=\\frac{5(3x-1)-(x-2)}{(x-2)(3x-1)}\\\\\\frac{5}{x-2}+\\frac{1}{1-3x}&=\\frac{15x-5-x+2}{(x-2)(3x-1)}\\\\\\frac{5}{x-2}+\\frac{1}{1-3x}&=\\frac{14x-3}{(x-2)(3x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p18-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{2}{x+4}+\\frac{3}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+4}{(x+4)(x-4)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x+4}+\\frac{3}{x-4}&=\\frac{2(x-4)+3(x+4)}{(x+4)(x-4)}\\\\\\frac{2}{x+4}+\\frac{3}{x-4}&=\\frac{2x-8+3x+12}{(x+4)(x-4)}\\\\\\frac{2}{x+4}+\\frac{3}{x-4}&=\\frac{5x+4}{(x+4)(x-4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{2}{(x-3)^2}+\\frac{4}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(2x-5)}{(x-3)^2}$",
          "worked": "$$\\begin{align*}\\frac{2}{(x-3)^2}+\\frac{4}{x-3}&=\\frac{2+4(x-3)}{(x-3)^2}\\\\\\frac{2}{(x-3)^2}+\\frac{4}{x-3}&=\\frac{4x-10}{(x-3)^2}\\\\\\frac{2}{(x-3)^2}+\\frac{4}{x-3}&=\\frac{2(2x-5)}{(x-3)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q10-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{3x}{(x-5)^2}+\\frac{1}{x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x-5}{(x-5)^2}$",
          "worked": "$$\\begin{align*}\\frac{3x}{(x-5)^2}+\\frac{1}{x-5}&=\\frac{3x+(x-5)}{(x-5)^2}\\\\\\frac{3x}{(x-5)^2}+\\frac{1}{x-5}&=\\frac{4x-5}{(x-5)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
