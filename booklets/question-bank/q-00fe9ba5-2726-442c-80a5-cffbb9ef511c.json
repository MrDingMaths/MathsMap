  "content": {
    "id": "p23-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The diameter of a balloon $D$ varies inversely with the thickness of the rubber $x$.\nThe diameter of the balloon is 80 mm when the rubber is 2 mm thick.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Using $y=\\dfrac{k}{x}$, find the constant of variation $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=160$",
          "worked": "$$\\begin{align*}80&=\\frac{k}{2}\\\\k&=80\\times2\\\\k&=160\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence write an equation relating diameter $D$ and thickness $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D=\\dfrac{160}{x}$",
          "worked": "Using $k=160$ in the inverse-variation model gives\n$$D=\\frac{160}{x}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the diameter when the thickness is 0.8 mm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "200 mm",
          "worked": "$$\\begin{align*}D&=\\frac{160}{0.8}\\\\D&=200\\text{ mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p23-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the thickness correct to one decimal place when the diameter is 115.3 mm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1.4 mm",
          "worked": "$$\\begin{align*}115.3&=\\frac{160}{x}\\\\x&=\\frac{160}{115.3}\\\\x&\\approx1.4\\text{ mm}\\end{align*}$$\nCorrect to one decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Sketch the graph of this information.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p23-q7-e-grid",
            "role": "question",
            "format": "tikz",
