              "type": "text",
              "text": "A weight on an elastic string drops down 60 cm and then bounces back to ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\dfrac{2}{3}",
              "display": false
            },
            {
              "type": "text",
              "text": " of its initial height.",
