  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A park contains paved areas, lawns and garden beds. $8\\%$ of the area of the park is garden bed. There are $22\\,000\\text{ m}^2$ of garden bed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the total area of the park?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$275\\,000\\text{ m}^2$",
          "worked": "$$\\begin{align*}\\text{Area representing }1\\%&=22\\,000\\div8\\\\\\text{Area representing }1\\%&=2750\\text{ m}^2\\\\\\text{Total area}&=2750\\times100\\\\\\text{Total area}&=275\\,000\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The lawns are $80\\%$ of the park. How many square metres of lawn are there?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$220\\,000\\text{ m}^2$",
          "worked": "$$\\begin{align*}\\text{Lawn area}&=2750\\times80\\\\\\text{Lawn area}&=220\\,000\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
