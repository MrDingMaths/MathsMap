  "content": {
    "id": "p11-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The side lengths of a square increase by $25\\%$ so that its new area is $25\\text{ cm}^2$. Find the original side lengths of the square.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\text{ cm}$",
      "worked": "The new side length is $\\sqrt{25}=5\\text{ cm}$. Let $x$ cm be the original side length. The new side length is $125\\%$ of the original.\n\n$$\\begin{align*}1.25x&=5\\\\x&=\\frac{5}{1.25}\\\\x&=4\\end{align*}$$\n\nEach original side is $4\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
