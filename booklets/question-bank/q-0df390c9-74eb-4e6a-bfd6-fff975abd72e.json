  "content": {
    "id": "p28-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find a monic quadratic equation that has roots equal to $2-\\sqrt{3}$ and $2+\\sqrt{3}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^2-4x+1=0$.",
      "worked": "The required roots give the factors $x-(2-\\sqrt{3})$ and $x-(2+\\sqrt{3})$. Their product has leading coefficient 1.\n$$\\begin{align*}(x-2+\\sqrt{3})(x-2-\\sqrt{3})&=0\\\\(x-2)^2-3&=0\\\\x^2-4x+4-3&=0\\\\x^2-4x+1&=0.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
