          "inlines": [
            {
              "type": "text",
              "text": "Edgar fills the bathtub so it is a quarter full and then adds half a bucket of water.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "A full bathtub can contain ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "T",
              "display": false
            },
            {
              "type": "text",
              "text": " litres and a bucket contains ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "B",
              "display": false
            },
            {
              "type": "text",
              "text": " litres.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the total amount of water in the bathtub as the sum of two algebraic fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{T}{4}+\\dfrac{B}{2}$ litres",
          "worked": "A quarter of the bathtub's capacity is $\\dfrac{T}{4}$ litres; half a bucket is $\\dfrac{B}{2}$ litres.\n\nTotal water: $\\dfrac{T}{4}+\\dfrac{B}{2}$ litres.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify the expression in part a to get a single algebraic fraction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{T+2B}{4}$ litres",
          "worked": "$$\\begin{align*}\\frac{T}{4}+\\frac{B}{2}&=\\frac{T}{4}+\\frac{2B}{4}\\\\&=\\frac{T+2B}{4}\\end{align*}$$\nThe total is $\\dfrac{T+2B}{4}$ litres.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
