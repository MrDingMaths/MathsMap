      {
        "id": "p19-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the size of $\\angle AOB$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180^\\circ$",
          "worked": "$\\angle AOB = 180^\\circ$, since $AB$ is a diameter and $A$, $O$ and $B$ lie on a straight line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the size of $\\angle ACB$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90^\\circ$",
          "worked": "$\\angle ACB = 90^\\circ$, since the angle in a semicircle is $90^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "If $\\angle CAB = 30^\\circ$, find $\\angle ABC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60^\\circ$",
          "worked": "$\\angle ACB = 90^\\circ$ (angle in a semicircle). Using the angle sum of a triangle:\n$$\\begin{align*}\\angle ABC &= 180^\\circ - 90^\\circ - 30^\\circ\\\\\\angle ABC &= 60^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "If $\\angle ABC = 83^\\circ$, find $\\angle CAB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^\\circ$",
          "worked": "$\\angle ACB = 90^\\circ$ (angle in a semicircle). Using the angle sum of a triangle:\n$$\\begin{align*}\\angle CAB &= 180^\\circ - 90^\\circ - 83^\\circ\\\\\\angle CAB &= 7^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ],
