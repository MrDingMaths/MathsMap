    "id": "p98-q25-response",
    "type": "question",
    "label": "25",
    "prompt": "The distance $d$ a spring stretches varies directly with the square root of the force $F$ applied. If $d = 6$ when $F = 36$, find $d$ when $F = 64$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$d = 8$",
      "worked": "$$\\begin{align*}d &= k\\sqrt{F}\\\\6 &= k\\sqrt{36}\\\\k &= 1\\end{align*}$$\nWhen $F = 64$:\n$$\\begin{align*}d &= \\sqrt{64}\\\\d &= 8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
