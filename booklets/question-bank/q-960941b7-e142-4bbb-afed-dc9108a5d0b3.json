  "content": {
    "id": "equations-r6-backfill-4-root",
    "type": "question",
    "label": null,
    "prompt": "Write $\\frac{x-7}{x+2}$ in the form $a+\\frac{b}{x+2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1-\\frac{9}{x+2}$",
      "worked": "$$\\begin{align*}\\frac{x-7}{x+2}&=a+\\frac{b}{x+2}\\\\x-7&=a(x+2)+b\\\\x-7&=ax+2a+b\\end{align*}$$\nEquate coefficients and constant terms.\n$$\\begin{align*}a&=1\\\\2a+b&=-7\\\\2+b&=-7\\\\b&=-9\\end{align*}$$\nHence $\\frac{x-7}{x+2}=1-\\frac{9}{x+2}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
