  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Sketch $y=-(x+2)^2+4$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave down.",
          "worked": "$a=-1<0$, so the parabola is concave down.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,0)$.",
          "worked": "Let $x=0$.\n$$\\begin{align*}y&=-(0+2)^2+4\\\\y&=0\\end{align*}$$\nThe $y$-intercept is $(0,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-4,0)$ and $(0,0)$.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-(x+2)^2+4\\\\(x+2)^2&=4\\\\x+2&=\\pm2\\\\x&=-2\\pm2\\\\x&=-4\\text{ or }0\\end{align*}$$\nThe $x$-intercepts are $(-4,0)$ and $(0,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p24-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,4)$.",
          "worked": "In $y=a(x-h)^2+k$, $h=-2$ and $k=4$. The vertex is $(-2,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p24-q4-sketch",
        "type": "part",
        "label": "e",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A downward-opening parabola with vertex $(-2,4)$ and intercepts $(-4,0)$ and $(0,0)$.",
          "worked": "Plot the vertex $(-2,4)$ and the intercepts $(-4,0)$ and $(0,0)$. Draw a smooth downward-opening parabola symmetric about $x=-2$.",
          "solutionDiagrams": [
            {
              "id": "p24-q4-graph",
