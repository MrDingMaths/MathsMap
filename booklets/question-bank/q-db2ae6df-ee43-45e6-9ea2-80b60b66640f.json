  "content": {
    "id": "p21-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Simplify by first factorising.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{6x^2-x-35}{3x+7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x-5$",
          "worked": "$$\\begin{align*}\\frac{6x^2-x-35}{3x+7}&=\\frac{(3x+7)(2x-5)}{3x+7}\\\\&=2x-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{8x^2+10x-3}{2x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x-1$",
          "worked": "$$\\begin{align*}\\frac{8x^2+10x-3}{2x+3}&=\\frac{(2x+3)(4x-1)}{2x+3}\\\\&=4x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{10x-2}{15x^2+7x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{3x+2}$",
          "worked": "$$\\begin{align*}\\frac{10x-2}{15x^2+7x-2}&=\\frac{2(5x-1)}{(5x-1)(3x+2)}\\\\&=\\frac{2}{3x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{20x-12}{10x^2-21x+9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{2x-3}$",
          "worked": "$$\\begin{align*}\\frac{20x-12}{10x^2-21x+9}&=\\frac{4(5x-3)}{(5x-3)(2x-3)}\\\\&=\\frac{4}{2x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{2x^2+11x+12}{6x^2+11x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+4}{3x+1}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+11x+12}{6x^2+11x+3}&=\\frac{(2x+3)(x+4)}{(2x+3)(3x+1)}\\\\&=\\frac{x+4}{3x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q19-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{12x^2-x-1}{8x^2+14x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x-1}{2x+3}$",
          "worked": "$$\\begin{align*}\\frac{12x^2-x-1}{8x^2+14x+3}&=\\frac{(4x+1)(3x-1)}{(4x+1)(2x+3)}\\\\&=\\frac{3x-1}{2x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q19-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{9x^2-4}{15x^2+4x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x-2}{5x-2}$",
          "worked": "$$\\begin{align*}\\frac{9x^2-4}{15x^2+4x-4}&=\\frac{(3x-2)(3x+2)}{(3x+2)(5x-2)}\\\\&=\\frac{3x-2}{5x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q19-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{14x^2+19x-3}{49x^2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+3}{7x+1}$",
          "worked": "$$\\begin{align*}\\frac{14x^2+19x-3}{49x^2-1}&=\\frac{(7x-1)(2x+3)}{(7x-1)(7x+1)}\\\\&=\\frac{2x+3}{7x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q19-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{8x^2-2x-15}{16x^2-25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x-3}{4x-5}$",
          "worked": "$$\\begin{align*}\\frac{8x^2-2x-15}{16x^2-25}&=\\frac{(4x+5)(2x-3)}{(4x+5)(4x-5)}\\\\&=\\frac{2x-3}{4x-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q19-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{25-4a^2}{6a^2-11a-10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2a+5}{3a+2}$",
          "worked": "$$\\begin{align*}\\frac{25-4a^2}{6a^2-11a-10}&=\\frac{(5-2a)(5+2a)}{(2a-5)(3a+2)}\\\\&=\\frac{-(2a-5)(2a+5)}{(2a-5)(3a+2)}\\\\&=-\\frac{2a+5}{3a+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q19-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{40+11b-2b^2}{8b^2+34b+35}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8-b}{4b+7}$",
          "worked": "$$\\begin{align*}\\frac{40+11b-2b^2}{8b^2+34b+35}&=\\frac{(8-b)(2b+5)}{(2b+5)(4b+7)}\\\\&=\\frac{8-b}{4b+7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q19-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{x^2y^2-4}{xy^2-3mxy-2y+6m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{xy+2}{y-3m}$",
          "worked": "$$\\begin{align*}xy^2-3mxy-2y+6m&=xy(y-3m)-2(y-3m)\\\\&=(xy-2)(y-3m)\\end{align*}$$\n$$\\begin{align*}\\frac{x^2y^2-4}{xy^2-3mxy-2y+6m}&=\\frac{(xy-2)(xy+2)}{(xy-2)(y-3m)}\\\\&=\\frac{xy+2}{y-3m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
