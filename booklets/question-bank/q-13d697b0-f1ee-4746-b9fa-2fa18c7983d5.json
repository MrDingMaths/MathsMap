  "content": {
    "id": "p37-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A fair coin is tossed six times. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "the first three tosses are heads",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac18$",
          "worked": "The final three tosses are unrestricted.\n$$\\begin{align*}\\Pr(\\text{first three heads})&=\\left(\\frac12\\right)^3\\\\\\Pr(\\text{first three heads})&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "the first three tosses are heads, and the rest are not",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{64}$",
          "worked": "The required order is HHHTTT.\n$$\\begin{align*}\\Pr(\\text{HHHTTT})&=\\left(\\frac12\\right)^3\\left(\\frac12\\right)^3\\\\\\Pr(\\text{HHHTTT})&=\\frac1{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "we obtain exactly three heads",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac5{16}$",
          "worked": "Let $X$ count the heads. There are $\\binom63$ ways to choose their positions.\n$$\\begin{align*}\\Pr(X=3)&=\\binom63\\left(\\frac12\\right)^3\\left(\\frac12\\right)^3\\\\\\Pr(X=3)&=\\frac{20}{64}\\\\\\Pr(X=3)&=\\frac5{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p37-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "at least one head is obtained.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{63}{64}$",
          "worked": "Let $X$ count the heads. Use the complement, obtaining no heads.\n$$\\begin{align*}\\Pr(X\\ge1)&=1-\\Pr(X=0)\\\\\\Pr(X\\ge1)&=1-\\left(\\frac12\\right)^6\\\\\\Pr(X\\ge1)&=\\frac{63}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
