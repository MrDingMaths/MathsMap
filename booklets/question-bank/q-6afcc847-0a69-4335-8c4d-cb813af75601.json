    "children": [
      {
        "id": "p4-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the volume of a cube with side $x$ cm:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=x^3\\text{ cm}^3$",
          "worked": "$$V=x\\times x\\times x=x^3\\text{ cm}^3$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "The volume of three identical cube shaped containers is $18\\text{ m}^3$. Calculate the side length of one of the cubes in exact form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[3]{6}\\text{ m}$",
          "worked": "Let the side length of each cube be $x$ metres.\n$$\\begin{align*}3x^3&=18\\\\x^3&=6\\\\x&=\\sqrt[3]{6}\\end{align*}$$\nThe side length is $\\sqrt[3]{6}\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
