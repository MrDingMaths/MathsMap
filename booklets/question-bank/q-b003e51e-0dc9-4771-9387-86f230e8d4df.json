        "answer": {
          "short": "For $x=10$, $100$, $1000$ and $10000$, respectively, the values are $2.59$, $2.70$, $2.72$ and $2.72$.",
          "worked": "$$\\begin{align*}\\left(1+\\frac{1}{10}\\right)^{10}&\\approx 2.59\\\\ \\left(1+\\frac{1}{100}\\right)^{100}&\\approx 2.70\\\\ \\left(1+\\frac{1}{1000}\\right)^{1000}&\\approx 2.72\\\\ \\left(1+\\frac{1}{10000}\\right)^{10000}&\\approx 2.72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
