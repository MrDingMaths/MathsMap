          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "How many ways can this be done?",
              "marks": []
            }
          ]
        },
        {
          "id": "p24-q14-hint",
          "type": "paragraph",
          "fontSize": null,
