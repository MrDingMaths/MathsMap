              "type": "math",
              "latex": "r",
              "display": false
            },
            {
              "type": "text",
              "text": " distinct objects. The order of selection is not relevant, and selecting the same object multiple times is allowed.",
              "marks": []
            }
          ]
        },
        {
          "id": "p24-q14-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
