    "id": "v2-725bd-p30-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "For $\\underset{\\sim}{p}=\\begin{pmatrix}-2\\\\5\\end{pmatrix}$ and $\\underset{\\sim}{q}=\\begin{pmatrix}3\\\\-1\\end{pmatrix}$, write $\\underset{\\sim}{p}$, $\\underset{\\sim}{q}$ and $2\\underset{\\sim}{p}-\\underset{\\sim}{q}$ in component form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\underset{\\sim}{p}=-2i+5j$, $\\underset{\\sim}{q}=3i-j$, $2\\underset{\\sim}{p}-\\underset{\\sim}{q}=-7i+11j$",
      "worked": "$\\underset{\\sim}{p}=-2i+5j$ and $\\underset{\\sim}{q}=3i-j$.\n$$\\begin{aligned}2\\underset{\\sim}{p}-\\underset{\\sim}{q}&=2(-2i+5j)-(3i-j)\\\\&=-4i+10j-3i+j\\\\&=-7i+11j\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
