    "children": [
      {
        "id": "p30-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "For $\\underset{\\sim}{u}=2i+j$ and $\\underset{\\sim}{v}=-i+2j$, write $\\underset{\\sim}{u}$, $\\underset{\\sim}{v}$ and $\\underset{\\sim}{u}+\\underset{\\sim}{v}$ as column vectors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{u}=\\begin{pmatrix}2\\\\1\\end{pmatrix}$, $\\underset{\\sim}{v}=\\begin{pmatrix}-1\\\\2\\end{pmatrix}$, $\\underset{\\sim}{u}+\\underset{\\sim}{v}=\\begin{pmatrix}1\\\\3\\end{pmatrix}$",
          "worked": "$\\underset{\\sim}{u}=\\begin{pmatrix}2\\\\1\\end{pmatrix}$ and $\\underset{\\sim}{v}=\\begin{pmatrix}-1\\\\2\\end{pmatrix}$.\n$$\\begin{aligned}\\underset{\\sim}{u}+\\underset{\\sim}{v}&=\\begin{pmatrix}2\\\\1\\end{pmatrix}+\\begin{pmatrix}-1\\\\2\\end{pmatrix}\\\\&=\\begin{pmatrix}1\\\\3\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p30-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "For $\\underset{\\sim}{a}=\\begin{pmatrix}3\\\\2\\end{pmatrix}$ and $\\underset{\\sim}{b}=\\begin{pmatrix}4\\\\1\\end{pmatrix}$, write $\\underset{\\sim}{a}$, $\\underset{\\sim}{b}$ and $\\underset{\\sim}{a}-\\underset{\\sim}{b}$ in component form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{a}=3i+2j$, $\\underset{\\sim}{b}=4i+j$, $\\underset{\\sim}{a}-\\underset{\\sim}{b}=-i+j$",
          "worked": "$\\underset{\\sim}{a}=3i+2j$ and $\\underset{\\sim}{b}=4i+j$.\n$$\\begin{aligned}\\underset{\\sim}{a}-\\underset{\\sim}{b}&=(3i+2j)-(4i+j)\\\\&=-i+j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
