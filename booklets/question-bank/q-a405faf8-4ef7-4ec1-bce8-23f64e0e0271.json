  "content": {
    "id": "p10-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A ball is dropped from the top of a building, and the distance of the ball from the ground after $t$ seconds is given by the equation $h=100-5t^2$, where $h$ is measured in metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "How tall is the building?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\text{ m}$",
          "worked": "$$\\begin{align*}h(0)&=100-5(0)^2\\\\&=100\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "How long does it take for the ball to hit the ground? Give an exact answer and an approximation to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{20}\\text{ s}\\approx4.47\\text{ s}$",
          "worked": "At the ground, $h=0$.\n$$\\begin{align*}100-5t^2&=0\\\\t^2&=20\\\\t&=\\sqrt{20}\\\\&\\approx4.47\\text{ s}\\end{align*}$$\nTake the positive value because $t\\ge0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, state the time interval $t\\in[a,b]$ where this model is valid.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t\\in[0,\\sqrt{20}]$ seconds.",
          "worked": "The model applies from release at $t=0$ until impact at $t=\\sqrt{20}$ seconds, so $t\\in[0,\\sqrt{20}]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q10-d",
        "type": "group",
        "label": "d",
        "prompt": "What is the rate of change $\\dfrac{dh}{dt}$ of the height:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q10-d-i",
            "type": "part",
            "label": "i",
            "prompt": "initially?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0\\text{ m/s}$",
              "worked": "$$\\begin{align*}\\frac{dh}{dt}&=-10t\\\\h'(0)&=-10(0)\\\\&=0\\text{ m/s}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p10-q10-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "when it hits the ground?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-10\\sqrt{20}\\text{ m/s}$",
              "worked": "$$\\begin{align*}\\frac{dh}{dt}&=-10t\\\\h'(\\sqrt{20})&=-10\\sqrt{20}\\text{ m/s}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      },
      {
        "id": "p10-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "When is the rate at which $h$ decreases the largest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "At $t=\\sqrt{20}\\text{ s}\\approx4.47\\text{ s}$, just as the ball reaches the ground.",
          "worked": "Since $h'(t)=-10t$, the rate of decrease is $10t$ for $t\\ge0$. This increases throughout $0\\le t\\le\\sqrt{20}$, so it is largest at $t=\\sqrt{20}\\text{ s}\\approx4.47\\text{ s}$, just as the ball reaches the ground.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
