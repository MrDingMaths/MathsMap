  "content": {
    "id": "p15-q6-response",
    "type": "question",
    "label": "6",
    "prompt": "A piece of string 256 cm long is to be divided in the ratio $5:3$. How long is each part?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$160\\text{ cm}$ and $96\\text{ cm}$.",
      "worked": "$$\\begin{align*}\\text{Total parts}&=5+3=8\\\\\\text{Length of one part}&=256\\div8=32\\text{ cm}\\\\\\text{Longer length}&=5\\times32=160\\text{ cm}\\\\\\text{Shorter length}&=3\\times32=96\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
