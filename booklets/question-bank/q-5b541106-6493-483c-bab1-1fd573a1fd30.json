  "content": {
    "id": "p14-q71-root",
    "type": "question",
    "label": "71",
    "prompt": "In some rows of Pascal’s triangle (where the row and column number starts from 0), the number in column 3 is an integer multiple of the number in column 2. Find the rows for which this occurs.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Rows $5,8,11,\\ldots$, namely $n=3k+2$ for integers $k\\geq1$.",
      "worked": "Both columns exist when $n\\geq3$. Their entries are $\\binom{n}{3}$ and $\\binom{n}{2}$. If the first is $k$ times the second,\n$$\\begin{align*}\n\\frac{\\binom{n}{3}}{\\binom{n}{2}}&=k\\\\\n\\frac{n-2}{3}&=k\\\\\nn&=3k+2.\n\\end{align*}$$\nSince $n\\geq3$, the integer $k$ satisfies $k\\geq1$. Thus the rows are $5,8,11,\\ldots$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
