        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"annulusFill\",\"hex\":\"D4E8FF\",\"reason\":\"Identifies the region APQB whose perimeter is compared with that of the unshaded sector OAB.\"}],\"reference\":\"source PDF page 64, printed page 277, p64-q32-diagram\"}\n\\begin{tikzpicture}[draw=black,text=black,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{annulusFill}{HTML}{D4E8FF}\n\\coordinate (O) at (0,0);\n\\coordinate (A) at (165:2.1);\n\\coordinate (P) at (165:3);\n\\coordinate (B) at (15:2.1);\n\\coordinate (Q) at (15:3);\n\\fill[annulusFill] (Q) arc[start angle=15,end angle=165,radius=3] -- (A) arc[start angle=165,end angle=15,radius=2.1] -- cycle;\n\\draw[line width=0.8pt] (P)--(O)--(Q);\n\\draw[line width=0.8pt] (Q) arc[start angle=15,end angle=165,radius=3];\n\\draw[line width=0.8pt] (B) arc[start angle=15,end angle=165,radius=2.1];\n\\draw[line width=0.4pt] (15:0.45) arc[start angle=15,end angle=165,radius=0.45];\n\\node at (90:0.72) {$\\theta$};\n\\draw[line width=0.4pt] ($(O)!0.5!(A)+(75:0.07)$)--($(O)!0.5!(A)+(255:0.07)$);\n\\draw[line width=0.4pt] ($(O)!0.5!(B)+(105:0.07)$)--($(O)!0.5!(B)+(285:0.07)$);\n\\draw[line width=0.4pt] ($(A)!0.45!(P)+(75:0.07)$)--($(A)!0.45!(P)+(255:0.07)$);\n\\draw[line width=0.4pt] ($(A)!0.55!(P)+(75:0.07)$)--($(A)!0.55!(P)+(255:0.07)$);\n\\draw[line width=0.4pt] ($(B)!0.45!(Q)+(105:0.07)$)--($(B)!0.45!(Q)+(285:0.07)$);\n\\draw[line width=0.4pt] ($(B)!0.55!(Q)+(105:0.07)$)--($(B)!0.55!(Q)+(285:0.07)$);\n\\foreach \\point in {O,A,B,P,Q}{\\fill[black] (\\point) circle[radius=1.2pt];}\n\\node[below] at (O) {$O$};\n\\node[below left] at (A) {$A$};\n\\node[below right] at (B) {$B$};\n\\node[left] at (P) {$P$};\n\\node[right] at (Q) {$Q$};\n\\coordinate (rStart) at ($(A)+(-0.15,-0.48)$);\n\\coordinate (rEnd) at ($(O)+(-0.15,-0.48)$);\n\\coordinate (RStart) at ($(O)+(0.15,-0.48)$);\n\\coordinate (REnd) at ($(Q)+(0.15,-0.48)$);\n\\draw[<->,line width=0.4pt] (rStart)--node[midway,above,sloped] {$r\\text{ cm}$}(rEnd);\n\\draw[<->,line width=0.4pt] (RStart)--node[midway,above,sloped] {$R\\text{ cm}$}(REnd);\n\\end{tikzpicture}",
