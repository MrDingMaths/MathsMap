        "answer": {
          "short": "$20\\pi\\text{ cm}$",
          "worked": "$$\\begin{align*}C&=2\\pi r\\\\C&=2\\pi(10)\\\\C&=20\\pi\\text{ cm}\\end{align*}$$",
