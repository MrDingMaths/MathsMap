          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Find the coefficient of the term indicated in the following expansions.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q12-17-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+3)^6\\qquad [x^2]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1215$",
          "worked": "$$\\begin{align*}T_k&=\\binom{6}{k}x^{6-k}3^k\\\\6-k&=2\\\\k&=4\\end{align*}$$\nThe coefficient of $x^2$ is\n$$\\begin{align*}\\binom{6}{4}3^4&=15\\times81\\\\\\binom{6}{4}3^4&=1215.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q12-17-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2x+1)^7\\qquad [x^5]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$672$",
          "worked": "$$\\begin{align*}T_k&=\\binom{7}{k}(2x)^{7-k}\\\\7-k&=5\\\\k&=2\\end{align*}$$\nThe coefficient of $x^5$ is\n$$\\begin{align*}\\binom{7}{2}2^5&=21\\times32\\\\\\binom{7}{2}2^5&=672.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q12-17-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3x-2)^8\\qquad [x^3]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-48\\,384$",
          "worked": "$$\\begin{align*}T_k&=\\binom{8}{k}(3x)^{8-k}(-2)^k\\\\8-k&=3\\\\k&=5\\end{align*}$$\nThe coefficient of $x^3$ is\n$$\\begin{align*}\\binom{8}{5}3^3(-2)^5&=56\\times27\\times(-32)\\\\\\binom{8}{5}3^3(-2)^5&=-48\\,384.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q12-17-d",
        "type": "part",
        "label": "d",
        "prompt": "$(4x-3)^5\\qquad [x^3]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5760$",
          "worked": "$$\\begin{align*}T_k&=\\binom{5}{k}(4x)^{5-k}(-3)^k\\\\5-k&=3\\\\k&=2\\end{align*}$$\nThe coefficient of $x^3$ is\n$$\\begin{align*}\\binom{5}{2}4^3(-3)^2&=10\\times64\\times9\\\\\\binom{5}{2}4^3(-3)^2&=5760.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q12-17-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+2y)^5\\qquad [x^3y^2]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$",
          "worked": "$$T_k=\\binom{5}{k}2^kx^{5-k}y^k.$$\nFor $x^3y^2$, $k=2$. The coefficient is\n$$\\begin{align*}\\binom{5}{2}2^2&=10\\times4\\\\\\binom{5}{2}2^2&=40.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q12-17-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x-2y)^6\\qquad [x^3y^3]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-160$",
          "worked": "$$T_k=\\binom{6}{k}(-2)^kx^{6-k}y^k.$$\nFor $x^3y^3$, $k=3$. The coefficient is\n$$\\begin{align*}\\binom{6}{3}(-2)^3&=20\\times(-8)\\\\\\binom{6}{3}(-2)^3&=-160.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
