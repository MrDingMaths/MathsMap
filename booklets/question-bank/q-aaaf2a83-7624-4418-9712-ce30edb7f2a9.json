  "content": {
    "id": "p12-q12-17-root",
    "type": "question",
    "label": null,
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p12-q12-17-stem",
          "type": "paragraph",
          "fontSize": null,
