  "content": {
    "id": "p55-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "In a scale model of a Spitfire (aeroplane), each length $m$ on the model varies directly with the corresponding length $s$ on the Spitfire.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Write this algebraically.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=ks$.",
          "worked": "Direct variation gives $m=ks$, where $k$ is the constant of proportionality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p55-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "The length of the Spitfire is $9.12\\text{ m}$ and the model has length $0.38\\text{ m}$. What is the constant of proportionality?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac{1}{24}$.",
          "worked": "$$\\begin{align*}0.38&=k\\times9.12\\\\k&=\\frac{0.38}{9.12}\\\\k&=\\frac{1}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p55-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "The height of the Spitfire on the runway is $3.48\\text{ m}$. What is the height of the model?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.145\\text{ m}$ or $145\\text{ mm}$.",
          "worked": "$$\\begin{align*}m&=\\frac{1}{24}\\times3.48\\\\m&=0.145\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p55-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "The wing span of the model is $468\\text{ mm}$. What is the wingspan of the Spitfire in metres?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11.232\\text{ m}$.",
          "worked": "$468\\text{ mm}=0.468\\text{ m}$.\n$$\\begin{align*}0.468&=\\frac{s}{24}\\\\s&=24\\times0.468\\\\s&=11.232\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
