    ],
    "children": [
      {
        "id": "p8-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why he is incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The radius is $\\frac{7}{2}\\ \\text{m}$, not $7\\ \\text{m}$.",
          "worked": "Ed used the diameter as the radius. The formula $A=\\pi r^{2}$ uses the radius, which is half the diameter: $r=\\frac{7}{2}\\ \\text{m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Write the correct area in terms of $\\pi$ as a fraction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{49}{4}\\pi\\ \\text{m}^{2}$",
          "worked": "$$\\begin{align*}r&=\\frac{7}{2}\\ \\text{m}\\\\A&=\\pi r^{2}\\\\A&=\\pi\\left(\\frac{7}{2}\\right)^{2}\\\\A&=\\frac{49}{4}\\pi\\ \\text{m}^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
