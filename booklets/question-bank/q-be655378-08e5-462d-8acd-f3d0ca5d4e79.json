  "content": {
    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Ed calculated the area of this circle as $49\\pi\\ \\text{m}^{2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p8-q8-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 8, p8-q8-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (A) at (127:1.55);\n\\coordinate (B) at (-53:1.55);\n\\draw[black,line width=0.8pt] (O) circle[radius=1.55cm];\n\\draw[black,line width=0.8pt] (A)--(B);\n\\fill[black] (O) circle[radius=0.055cm];\n\\node[anchor=south west,inner sep=1pt] at (0.04,0.08) {$7\\,\\mathrm{m}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 33,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "description": "Unshaded circle with centre dot and a diameter from upper left to lower right, labelled 7 m near the centre.",
          "mathematics": "The complete diameter is 7 m; no radius or area answer is shown.",
          "answerVisibility": "Permanent student-visible given only.",
