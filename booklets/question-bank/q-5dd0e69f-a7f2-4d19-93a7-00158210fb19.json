  "content": {
    "id": "p41-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{1-\\frac{1}{x+1}}{\\frac{1}{x}+\\frac{1}{x+1}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{2x+1}$",
          "worked": "Multiply the main numerator and denominator by $x(x+1)$.\n\n$$\\begin{align*}\\frac{1-\\frac{1}{x+1}}{\\frac{1}{x}+\\frac{1}{x+1}}&=\\frac{x(x+1)-x}{(x+1)+x}\\\\&=\\frac{x^2+x-x}{2x+1}\\\\&=\\frac{x^2}{2x+1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p41-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{\\frac{1}{x}+\\frac{1}{x+1}}{\\frac{1}{x}-\\frac{1}{x+1}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+1$",
          "worked": "Multiply the main numerator and denominator by $x(x+1)$.\n\n$$\\begin{align*}\\frac{\\frac{1}{x}+\\frac{1}{x+1}}{\\frac{1}{x}-\\frac{1}{x+1}}&=\\frac{(x+1)+x}{(x+1)-x}\\\\&=\\frac{2x+1}{1}\\\\&=2x+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p41-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{\\frac{2}{x}+\\frac{1}{x+3}}{\\frac{3}{x}-\\frac{1}{x+3}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3(x+2)}{2x+9}$",
          "worked": "Multiply the main numerator and denominator by $x(x+3)$.\n\n$$\\begin{align*}\\frac{\\frac{2}{x}+\\frac{1}{x+3}}{\\frac{3}{x}-\\frac{1}{x+3}}&=\\frac{2(x+3)+x}{3(x+3)-x}\\\\&=\\frac{3x+6}{2x+9}\\\\&=\\frac{3(x+2)}{2x+9}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p41-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{\\frac{3}{x+2}-\\frac{2}{x+1}}{\\frac{5}{x+2}-\\frac{4}{x+1}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-1}{x-3}$",
          "worked": "Multiply the main numerator and denominator by $(x+2)(x+1)$.\n\n$$\\begin{align*}\\frac{\\frac{3}{x+2}-\\frac{2}{x+1}}{\\frac{5}{x+2}-\\frac{4}{x+1}}&=\\frac{3(x+1)-2(x+2)}{5(x+1)-4(x+2)}\\\\&=\\frac{3x+3-2x-4}{5x+5-4x-8}\\\\&=\\frac{x-1}{x-3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
