    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.44\\text{ patients/hour}$",
      "worked": "From 8:30 am to 5:30 pm is $9$ hours.\n$$\\begin{align*}\n\\text{Rate}&=\\frac{40\\text{ patients}}{9\\text{ hours}}\\\\\n&=\\frac{(40\\div9)\\text{ patients}}{(9\\div9)\\text{ hours}}\\\\\n&=\\frac{\\frac{40}{9}\\text{ patients}}{1\\text{ hour}}\\\\\n&\\approx4.44\\text{ patients/hour}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
