        "answerSpaceMm": 12
      },
      {
        "id": "p18-q5-part3",
        "type": "part",
        "label": "c",
        "prompt": "Even though the size and number of parts changed, why is $\\frac{2}{5}$ equal to $\\frac{4}{10}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The shaded amount is still the same.",
          "worked": "The whole and the shaded area have not changed. The same shaded area is two of the original five parts and four of the new ten parts, so $\\frac{2}{5}=\\frac{4}{10}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
