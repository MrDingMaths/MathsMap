      {
        "id": "p18-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $y$-intercept by putting $x=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2$; the intercept is $(0,-2)$.",
          "worked": "When $x=0$,\n$$\\begin{align*}y&=2(0)-2\\\\y&=-2.\\end{align*}$$\nThe $y$-intercept is $-2$, at $(0,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the $x$-intercept by putting $y=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$; the intercept is $(1,0)$.",
          "worked": "When $y=0$,\n$$\\begin{align*}2x-2&=0\\\\2x&=2\\\\x&=1.\\end{align*}$$\nThe $x$-intercept is $1$, at $(1,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
