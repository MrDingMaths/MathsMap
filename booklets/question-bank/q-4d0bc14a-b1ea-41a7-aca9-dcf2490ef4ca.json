  "content": {
    "id": "p35-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "The interval $AB$ has endpoints $A(1,7)$ and $B(-1,-11)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{-11-7}{-1-1}\\\\m_{AB}&=\\frac{-18}{-2}\\\\m_{AB}&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the distance between points $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{82}$",
          "worked": "$$\\begin{align*}AB^2&=(-1-1)^2+(-11-7)^2\\\\AB^2&=(-2)^2+(-18)^2\\\\AB^2&=4+324\\\\AB^2&=328\\\\AB&=\\sqrt{328}\\\\AB&=2\\sqrt{82}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p35-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of the line that passes through $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=9x-2$",
          "worked": "Using $m=9$ and $A(1,7)$,\n$$\\begin{align*}y-7&=9(x-1)\\\\y-7&=9x-9\\\\y&=9x-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q22-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the coordinates of the midpoint of interval $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-2)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{1+(-1)}{2},\\frac{7+(-11)}{2}\\right)\\\\M&=(0,-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q22-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the equation of the perpendicular bisector of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q22-e-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y=-\\frac{1}{9}x-2",
                    "display": false
                  }
                ]
              },
              {
                "id": "p35-q22-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the negative reciprocal gradient and the midpoint.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The perpendicular bisector passes through $M(0,-2)$ and has gradient $-\\frac19$.\n$$\\begin{align*}m_\\perp&=-\\frac{1}{9}\\\\y-(-2)&=-\\frac19(x-0)\\\\y+2&=-\\frac19x\\\\y&=-\\frac19x-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
