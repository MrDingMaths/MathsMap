  "content": {
    "id": "v2-p34-classification-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Seven students recorded the number of books they read over the holidays.\n\n$4,\\ 5,\\ 5,\\ 7,\\ 9,\\ 12,\\ 14$",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-p34-classification-slot-3-slot-3-a",
        "type": "part",
        "label": "a",
        "prompt": "Range",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\text{Range}&=14-4\\\\\\text{Range}&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-p34-classification-slot-3-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "Mode",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$5$ occurs twice; every other value occurs once. The mode is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-p34-classification-slot-3-slot-3-c",
        "type": "part",
        "label": "c",
        "prompt": "Mean",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}\\overline{x}&=\\frac{\\text{sum of data values}}{\\text{number of data values}}\\\\\\overline{x}&=\\frac{4+5+5+7+9+12+14}{7}\\\\\\overline{x}&=\\frac{56}{7}\\\\\\overline{x}&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-p34-classification-slot-3-slot-3-d",
        "type": "part",
        "label": "d",
        "prompt": "Median",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\text{Position}&=\\frac{7+1}{2}\\\\\\text{Position}&=4\\end{align*}$$\n\nThe $4^{\\mathrm{th}}$ score is $7$, so the median is $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
