    "prompt": "Evaluate each expression for $a=2$, $b=1$ and $c=3$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-algebra-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$a+b+c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}a+b+c&=2+1+3\\\\a+b+c&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-algebra-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$abc$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}abc&=2\\times1\\times3\\\\abc&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-algebra-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{a+b}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{a+b}{c}&=\\frac{2+1}{3}\\\\\\frac{a+b}{c}&=\\frac{3}{3}\\\\\\frac{a+b}{c}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p6-algebra-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a^2+b^2}{a^2-b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{3}=1\\dfrac{2}{3}$",
          "worked": "$$\\begin{align*}\\frac{a^2+b^2}{a^2-b^2}&=\\frac{2^2+1^2}{2^2-1^2}\\\\\\frac{a^2+b^2}{a^2-b^2}&=\\frac{4+1}{4-1}\\\\\\frac{a^2+b^2}{a^2-b^2}&=\\frac{5}{3}\\\\\\frac{a^2+b^2}{a^2-b^2}&=1\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
