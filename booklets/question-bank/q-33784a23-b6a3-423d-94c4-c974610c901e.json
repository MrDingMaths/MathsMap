    "type": "question",
    "label": "4",
    "prompt": "For these questions, it is not possible to use the identity $\\sin^{-1}(\\sin x)=x$, so you must evaluate the inner function first.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\arcsin\\left(2\\sin\\left(-\\frac{\\pi}{6}\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\pi}{2}$",
          "worked": "$$\\begin{aligned}\\sin\\left(-\\frac{\\pi}{6}\\right)&=-\\frac12\\\\2\\sin\\left(-\\frac{\\pi}{6}\\right)&=-1\\\\\\arcsin(-1)&=-\\frac{\\pi}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p28-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\arctan\\left(3\\tan\\left(\\frac{7\\pi}{6}\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{3}$",
          "worked": "$$\\begin{aligned}\\tan\\left(\\frac{7\\pi}{6}\\right)&=\\tan\\left(\\frac{\\pi}{6}\\right)=\\frac{1}{\\sqrt3}\\\\3\\tan\\left(\\frac{7\\pi}{6}\\right)&=3\\left(\\frac{1}{\\sqrt3}\\right)=\\sqrt3\\\\\\arctan(\\sqrt3)&=\\frac{\\pi}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
