  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The estimated cost $\\$C$ of building a brick veneer house on a concrete slab is directly proportional to the area $A$ of floor space in square metres. If it costs $\\$80\\,000$ for $150\\text{ m}^2$, how much floor space could you expect for $\\$126\\,400$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$237\\text{ m}^2$",
      "worked": "$$\\begin{align*}C &= kA\\\\80\\,000 &= 150k\\\\k &= \\frac{80\\,000}{150}\\\\k &= \\frac{1600}{3}\\\\C &= \\frac{1600}{3}A\\\\126\\,400 &= \\frac{1600}{3}A\\\\A &= \\frac{126\\,400\\times3}{1600}\\\\A &= 237\\end{align*}$$\nThe floor space is $237\\text{ m}^2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
