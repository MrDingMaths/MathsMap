  "content": {
    "id": "p55-cc-7-9-root",
    "type": "question",
    "label": "2",
    "prompt": "True or False? Let $a,b\\in\\left[0,\\frac{\\pi}{2}\\right]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-cc-7-9-a",
        "type": "part",
        "label": "a",
        "prompt": "If $a>b$, then $\\sin a>\\sin b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The sine curve is strictly increasing on $\\left[0,\\frac{\\pi}{2}\\right]$, so the larger angle has the larger sine value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p55-cc-7-9-b",
        "type": "part",
        "label": "b",
        "prompt": "If $a>b$, then $\\cos a>\\cos b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. $\\cos a<\\cos b$.",
          "worked": "False. The cosine curve is strictly decreasing on $\\left[0,\\frac{\\pi}{2}\\right]$, so the larger angle has the smaller cosine value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p55-cc-7-9-c",
        "type": "part",
        "label": "c",
        "prompt": "If $a>b$ and $a<\\frac{\\pi}{2}$, then $\\tan a>\\tan b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The tangent curve is strictly increasing on $\\left[0,\\frac{\\pi}{2}\\right)$. Since $0\\le b<a<\\frac{\\pi}{2}$, the larger angle has the larger tangent value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
