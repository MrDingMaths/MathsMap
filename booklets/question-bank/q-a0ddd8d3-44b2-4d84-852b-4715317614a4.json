  "content": {
    "id": "p13-q5-response",
    "type": "question",
    "label": "5",
    "prompt": "Simplify $\\left(\\frac{p}{q}\\right)^3\\div(pq^{-2})$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{p^2}{q}$",
      "worked": "$$\\begin{align*}\\left(\\frac{p}{q}\\right)^3\\div(pq^{-2})&=\\frac{p^3}{q^3}\\div\\frac{p}{q^2}\\\\&=\\frac{p^3}{q^3}\\times\\frac{q^2}{p}\\\\&=p^{3-1}q^{2-3}\\\\&=\\frac{p^2}{q}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
