  "content": {
    "id": "p18-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Let $m,n\\in\\mathbb R$ with $m\\ne0$. Prove that the quadratic equation $2mx^2+3nx-4m=0$ has two real solutions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\Delta=9n^2+32m^2>0$, so there are two distinct real solutions.",
      "worked": "$$\\begin{align*}\\Delta&=(3n)^2-4(2m)(-4m)\\\\\\Delta&=9n^2+32m^2.\\end{align*}$$\nSince $n^2\\ge0$ and $m\\ne0$, we have $32m^2>0$. Thus $\\Delta>0$, so the quadratic has two distinct real solutions.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
