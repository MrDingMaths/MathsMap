        "label": "a",
        "prompt": "$\\frac12-\\frac13-\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac1{12}$",
          "worked": "$$\\begin{align*}\\frac12-\\frac13-\\frac14&=\\frac6{12}-\\frac4{12}-\\frac3{12}\\\\\\frac12-\\frac13-\\frac14&=-\\frac1{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac12-\\left(-\\frac13\\right)-\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac7{12}$",
          "worked": "$$\\begin{align*}\\frac12-\\left(-\\frac13\\right)-\\frac14&=\\frac12+\\frac13-\\frac14\\\\\\frac12-\\left(-\\frac13\\right)-\\frac14&=\\frac6{12}+\\frac4{12}-\\frac3{12}\\\\\\frac12-\\left(-\\frac13\\right)-\\frac14&=\\frac7{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$-\\frac12+\\frac13-\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac5{12}$",
          "worked": "$$\\begin{align*}-\\frac12+\\frac13-\\frac14&=-\\frac6{12}+\\frac4{12}-\\frac3{12}\\\\-\\frac12+\\frac13-\\frac14&=-\\frac5{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$-\\frac12-\\frac13-\\left(-\\frac14\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac7{12}$",
          "worked": "$$\\begin{align*}-\\frac12-\\frac13-\\left(-\\frac14\\right)&=-\\frac12-\\frac13+\\frac14\\\\-\\frac12-\\frac13-\\left(-\\frac14\\right)&=-\\frac6{12}-\\frac4{12}+\\frac3{12}\\\\-\\frac12-\\frac13-\\left(-\\frac14\\right)&=-\\frac7{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
