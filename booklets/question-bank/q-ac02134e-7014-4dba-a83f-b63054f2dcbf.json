  "content": {
    "id": "v2-b65bc-p20-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Solve in the domain $\\theta\\in[0,4\\pi]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b65bc-p20-practice-slot-10-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\theta=-\\frac{1}{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{3\\pi}{4},\\frac{5\\pi}{4},\\frac{11\\pi}{4},\\frac{13\\pi}{4}$",
          "worked": "The reference angle is $\\frac{\\pi}{4}$. Since $\\cos\\theta<0$, the solutions lie in quadrants II and III.\n\nIn $[0,2\\pi)$,\n$$\\begin{align*}\\theta&=\\frac{3\\pi}{4}\\quad\\text{or}\\quad\\frac{5\\pi}{4}.\\end{align*}$$\nAdd $2\\pi$ to obtain the remaining solutions in the domain:\n$$\\begin{align*}\\frac{3\\pi}{4}+2\\pi&=\\frac{11\\pi}{4}\\\\\\frac{5\\pi}{4}+2\\pi&=\\frac{13\\pi}{4}.\\end{align*}$$\nTherefore,\n$$\\theta=\\frac{3\\pi}{4},\\frac{5\\pi}{4},\\frac{11\\pi}{4},\\frac{13\\pi}{4}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-b65bc-p20-practice-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\theta=-\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{2\\pi}{3},\\frac{5\\pi}{3},\\frac{8\\pi}{3},\\frac{11\\pi}{3}$",
          "worked": "The reference angle is $\\frac{\\pi}{3}$. Since $\\tan\\theta<0$, the solutions lie in quadrants II and IV.\n\nIn $[0,2\\pi)$,\n$$\\begin{align*}\\theta&=\\frac{2\\pi}{3}\\quad\\text{or}\\quad\\frac{5\\pi}{3}.\\end{align*}$$\nAdd $2\\pi$ to obtain the remaining solutions in the domain:\n$$\\begin{align*}\\frac{2\\pi}{3}+2\\pi&=\\frac{8\\pi}{3}\\\\\\frac{5\\pi}{3}+2\\pi&=\\frac{11\\pi}{3}.\\end{align*}$$\nTherefore,\n$$\\theta=\\frac{2\\pi}{3},\\frac{5\\pi}{3},\\frac{8\\pi}{3},\\frac{11\\pi}{3}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
