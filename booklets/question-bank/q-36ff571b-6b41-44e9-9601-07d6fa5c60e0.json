  "content": {
    "id": "v2-f1e31-p55-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "State if the following is an identity, contradiction or conditional equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-f1e31-p55-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(3x-4)=6x-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Identity.",
          "worked": "$$\\begin{align*}6x-8&=6x-8\\\\0&=0\\end{align*}$$\nThis is true for all values of $x$, so the equation is an identity.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f1e31-p55-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$5x+3=2(x+4)+3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Contradiction.",
          "worked": "$$\\begin{align*}5x+3&=2x+8+3x\\\\5x+3&=5x+8\\\\3&=8\\end{align*}$$\nThis statement is false, so the equation is a contradiction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f1e31-p55-practice-slot-7-slot-7-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$7-2(x-3)=3x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Conditional equation.",
          "worked": "$$\\begin{align*}7-2x+6&=3x+1\\\\13-2x&=3x+1\\\\12&=5x\\\\x&=\\frac{12}{5}\\end{align*}$$\nIt is true only when $x=\\frac{12}{5}$, so it is a conditional equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f1e31-p55-practice-slot-7-slot-7-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$3(x+2)-(x-4)=2(x+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Identity.",
          "worked": "$$\\begin{align*}3x+6-x+4&=2x+10\\\\2x+10&=2x+10\\\\0&=0\\end{align*}$$\nThis is true for all values of $x$, so the equation is an identity.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f1e31-p55-practice-slot-7-slot-7-q-e",
        "type": "part",
        "label": "e",
        "prompt": "$4(2x-1)-3x=5(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Contradiction.",
          "worked": "$$\\begin{align*}8x-4-3x&=5x+5\\\\5x-4&=5x+5\\\\-4&=5\\end{align*}$$\nThis statement is false, so the equation is a contradiction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
