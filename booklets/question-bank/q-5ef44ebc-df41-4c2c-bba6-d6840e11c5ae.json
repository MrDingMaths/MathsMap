  "content": {
    "id": "p38-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A balloon travels at $24\\text{ km/h}$ for 4 hours 40 minutes. How far does it travel?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$112\\text{ km}$",
      "worked": "$$\\begin{align*}\\text{Time}&=4+\\frac{40}{60}\\text{ h}\\\\\\text{Time}&=\\frac{14}{3}\\text{ h}\\end{align*}$$\n\n$$\\begin{align*}\\text{Distance}&=\\text{speed}\\times\\text{time}\\\\\\text{Distance}&=24\\times\\frac{14}{3}\\text{ km}\\\\\\text{Distance}&=112\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
