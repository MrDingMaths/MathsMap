            {
              "type": "text",
              "text": "To any convex polyhedron we can associate a convex ",
              "marks": []
            },
            {
              "type": "text",
              "text": "dual polyhedron",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": ". This is done in such a way that the faces of the polyhedron correspond to the vertices of the dual polyhedron, and the edges between adjacent vertices of the polyhedron correspond to the edges between adjacent faces of the dual polyhedron.",
              "marks": []
            }
          ]
        },
        {
          "id": "p19-q23-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
