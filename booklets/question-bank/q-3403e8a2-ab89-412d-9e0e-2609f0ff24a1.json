  "content": {
    "id": "root-10-6",
    "type": "question",
    "label": null,
    "prompt": "Let f(x) be the function \"increase x by 50%\".",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "part-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the equation for $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=1.5x$",
          "worked": "Increasing by $50\\%$ multiplies by $1.5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      },
      {
        "id": "group-b-pq-pilot-p10-q6",
        "type": "group",
        "label": "b",
        "prompt": "A student in Year 8 says: \"Let g(x) be decrease x by 50%.\"",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "part-b(i)",
            "type": "part",
            "label": "i",
            "prompt": "Write the equation for $g(x)$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$g(x)=0.5x$",
              "worked": "Decreasing by $50\\%$ leaves half the original amount.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": null
          },
          {
            "id": "part-b(ii)",
            "type": "part",
            "label": "ii",
            "prompt": "Show that she is incorrect by finding $g(f(x))$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$g(f(x))=0.75x$",
              "worked": "$g(f(x)) = 0.5(1.5x) = 0.75x \\ne x$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": null
          }
        ]
      },
      {
        "id": "part-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the inverse function $f^{-1}(x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\frac{2}{3})x$",
          "worked": "Undo multiplication by $1.5$: $f^{-1}(x) = \\frac{x}{1.5} = (\\frac{2}{3})x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      },
      {
        "id": "part-d",
        "type": "part",
        "label": "d",
        "prompt": "Therefore, to undo a 50\\% increase, what percentage do you need to decrease by?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33.3%$",
          "worked": "Multiplying by $\\frac{2}{3}$ means removing $\\frac{1}{3}$ of the value, i.e. a $33.3%$ decrease.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      }
    ]
