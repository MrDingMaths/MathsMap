              "inlines": [
                {
                  "type": "text",
                  "text": "The formula ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\operatorname{area}(\\triangle ABC)=\\frac12 ab\\sin C",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " implies the area of the triangle above is ",
