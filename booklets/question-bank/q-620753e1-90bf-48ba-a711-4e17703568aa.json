      {
        "id": "p22-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, show that\n$$\\sin 2\\theta=2\\sin\\theta\\cos\\theta.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin 2\\theta=2\\sin\\theta\\cos\\theta$.\n\nEquate the two expressions for the triangle's area and multiply by $2$.",
          "worked": "Equating the two expressions for the area gives\n$$\\begin{align*}\\frac12\\sin 2\\theta&=\\sin\\theta\\cos\\theta\\\\\\sin 2\\theta&=2\\sin\\theta\\cos\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
