  "content": {
    "id": "p65-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p65-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $n(n+2)+1=(n+1)^2$ for all integers $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n(n+2)+1=n^2+2n+1=(n+1)^2$.",
          "worked": "$$\\begin{align*}n(n+2)+1&=n^2+2n+1\\\\&=(n+1)^2\\end{align*}$$\nThis identity holds for every integer $n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p65-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence state the relationship between the product of two integers differing by 2 and the square of the integer between them.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The product of two integers differing by 2 is always 1 less than the square of the integer between them.",
          "worked": "The integers are $n$ and $n+2$, and the integer between them is $n+1$. From part a,\n$$n(n+2)=(n+1)^2-1.$$\nTheir product is 1 less than the square of the integer between them.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p65-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Verify for $11\\times13$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11\\times13=143=144-1=12^2-1$.",
          "worked": "The integer between 11 and 13 is 12.\n$$\\begin{align*}11\\times13&=143\\\\&=144-1\\\\&=12^2-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
