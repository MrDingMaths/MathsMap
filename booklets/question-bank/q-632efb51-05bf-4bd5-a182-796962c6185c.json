    "id": "p55-q11-root",
    "type": "question",
    "label": "",
    "prompt": "Integrate using the reverse chain rule, or otherwise:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan x\\sec^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\tan^2 x+C$",
          "worked": "Let $u=\\tan x$, so $du=\\sec^2 x\\,dx$.\n$$\\begin{aligned}\\int\\tan x\\sec^2 x\\,dx&=\\int u\\,du\\\\&=\\frac12u^2+C\\\\&=\\frac12\\tan^2 x+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p55-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\frac{\\sin^2 x}{1+\\cos x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-\\sin x+C$",
          "worked": "$$\\begin{aligned}\\frac{\\sin^2 x}{1+\\cos x}&=\\frac{1-\\cos^2 x}{1+\\cos x}\\\\&=\\frac{(1-\\cos x)(1+\\cos x)}{1+\\cos x}\\\\&=1-\\cos x\\end{aligned}$$\n$$\\int(1-\\cos x)\\,dx=x-\\sin x+C$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p55-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\frac{1+\\cos^3 x}{\\cos^2 x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan x+\\sin x+C$",
          "worked": "$$\\frac{1+\\cos^3 x}{\\cos^2 x}=\\sec^2 x+\\cos x$$\n$$\\int(\\sec^2 x+\\cos x)\\,dx=\\tan x+\\sin x+C$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
