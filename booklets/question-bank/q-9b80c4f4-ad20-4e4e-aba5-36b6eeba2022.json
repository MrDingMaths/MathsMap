  "content": {
    "id": "p35-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Make the variable in brackets the subject of the formula. All variables take positive values.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\pi r^2+\\pi rh\\quad(h)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\dfrac{A-\\pi r^2}{\\pi r}$",
          "worked": "$$\\begin{align*}A-\\pi r^2&=\\pi rh\\\\\\pi rh&=A-\\pi r^2\\\\h&=\\frac{A-\\pi r^2}{\\pi r}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p35-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\pi r\\sqrt{h^2+r^2}\\quad(h)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\sqrt{\\left(\\dfrac{A}{\\pi r}\\right)^2-r^2}$\n\nTake the positive square root because $h>0$.",
          "worked": "$$\\begin{align*}\\frac{A}{\\pi r}&=\\sqrt{h^2+r^2}\\\\\\left(\\frac{A}{\\pi r}\\right)^2&=h^2+r^2\\\\h^2&=\\left(\\frac{A}{\\pi r}\\right)^2-r^2\\\\h&=\\sqrt{\\left(\\frac{A}{\\pi r}\\right)^2-r^2}\\end{align*}$$\nTake the positive square root because $h>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p35-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$E=\\frac12m(v^2-u^2)\\quad(u)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=\\sqrt{v^2-\\dfrac{2E}{m}}$\n\nTake the positive square root because $u>0$.",
          "worked": "$$\\begin{align*}\\frac{2E}{m}&=v^2-u^2\\\\u^2&=v^2-\\frac{2E}{m}\\\\u&=\\sqrt{v^2-\\frac{2E}{m}}\\end{align*}$$\nTake the positive square root because $u>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p35-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{ax+by}{c}=x-b\\quad(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{b(c+y)}{c-a}$\n\nCollect the $x$ terms and factorise out $x$.",
          "worked": "$$\\begin{align*}ax+by&=cx-bc\\\\cx-ax&=bc+by\\\\x(c-a)&=b(c+y)\\\\x&=\\frac{b(c+y)}{c-a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
