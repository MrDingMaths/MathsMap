            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "14 days.",
              "worked": "Add the frequencies of the first two classes:\n$$8+6=14$$\nThere were 14 days.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p9-q5-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "between $24.3^\\circ\\mathrm{C}$ and $25.7^\\circ\\mathrm{C}$ (inclusive)?",
            "layout": "list",
