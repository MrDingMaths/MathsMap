            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "2 days.",
              "worked": "Only the $25.8$–$26.0^\\circ\\mathrm{C}$ class is above $25.7^\\circ\\mathrm{C}$. Its frequency is 2, so there were 2 days.",
              "solutionDiagrams": []
