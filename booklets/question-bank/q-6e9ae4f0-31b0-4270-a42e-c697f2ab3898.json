  "content": {
    "id": "p7-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "By how much must the numerator of $\\frac{1}{11}$ be increased to give a result of $\\frac{1}{10}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{10}$",
      "worked": "Let $x$ be the increase in the numerator.\n\n$$\\begin{align*}\\frac{1+x}{11}&=\\frac{1}{10}\\\\1+x&=\\frac{11}{10}\\\\x&=\\frac{11}{10}-1\\\\x&=\\frac{1}{10}\\end{align*}$$\n\nThe numerator must be increased by $\\frac{1}{10}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
