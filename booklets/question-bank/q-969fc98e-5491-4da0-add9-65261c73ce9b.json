    "children": [
      {
        "id": "p35-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the exact value of $a$ if $f(x)=\\dfrac{a}{x}$ is a continuous PDF defined in the domain $[1,6]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{1}{\\ln 6}$",
          "worked": "$$\\begin{aligned}\\int_1^6\\frac{a}{x}\\,dx&=1\\\\a[\\ln x]_1^6&=1\\\\a(\\ln 6-\\ln 1)&=1\\\\a&=\\frac{1}{\\ln 6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p35-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the CDF.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\dfrac{\\ln x}{\\ln 6}$ for $1\\le x\\le6$; $F(x)=0$ for $x<1$ and $F(x)=1$ for $x>6$.",
          "worked": "For $1\\le x\\le6$,\n$$\\begin{aligned}F(x)&=\\int_1^x\\frac{1}{t\\ln 6}\\,dt\\\\&=\\frac{1}{\\ln 6}[\\ln t]_1^x\\\\&=\\frac{\\ln x}{\\ln 6}.\\end{aligned}$$\nOutside this interval, $F(x)=0$ for $x<1$ and $F(x)=1$ for $x>6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q7-c",
        "type": "group",
        "label": "c",
        "prompt": "Find to 2 decimal places:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p35-q7-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(X\\le3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.61$",
              "worked": "$$\\begin{aligned}P(X\\le3)&=F(3)\\\\&=\\frac{\\ln3}{\\ln6}\\\\&\\approx0.61\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p35-q7-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(X\\le2)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.39$",
              "worked": "$$\\begin{aligned}P(X\\le2)&=F(2)\\\\&=\\frac{\\ln2}{\\ln6}\\\\&\\approx0.39\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p35-q7-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(X>5)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.10$",
              "worked": "$$\\begin{aligned}P(X>5)&=1-F(5)\\\\&=1-\\frac{\\ln5}{\\ln6}\\\\&\\approx0.10\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p35-q7-c-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(X\\ge4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.23$",
              "worked": "$$\\begin{aligned}P(X\\ge4)&=1-F(4)\\\\&=1-\\frac{\\ln4}{\\ln6}\\\\&\\approx0.23\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p35-q7-c-v",
            "type": "part",
            "label": "v",
            "prompt": "$P(2\\le X\\le5)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.51$",
              "worked": "$$\\begin{aligned}P(2\\le X\\le5)&=F(5)-F(2)\\\\&=\\frac{\\ln5-\\ln2}{\\ln6}\\\\&=\\frac{\\ln(5/2)}{\\ln6}\\\\&\\approx0.51\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      }
    ]
  },
