            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 32 p32-q9-graph\"}\n\\begin{tikzpicture}[x=0.72cm,y=0.078cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{gridPaint}{HTML}{CCCCCC}\n\\foreach \\v in {130,132,...,200}{\\draw[gridPaint,line width=0.15pt] (10,\\v)--(17,\\v);}\n\\foreach \\v in {140,150,...,200}{\\draw[gridPaint,line width=0.25pt] (10,\\v)--(17,\\v);}\n\\foreach \\u in {10,11,...,17}{\\draw[gridPaint,line width=0.25pt] (\\u,130)--(\\u,200);}\n\\draw[black,line width=0.5pt,->] (10,130)--(17.5,130) node[right] {$a$};\n\\draw[black,line width=0.5pt,->] (10,130)--(10,204.5) node[above] {$h$};\n\\foreach \\u in {10,11,...,17}{\\draw[black,line width=0.4pt] (\\u,130)--(\\u,128.8);\\node[below] at (\\u,128.8) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\u\\special{dvisvgm:raw </g>}};}\n\\foreach \\v in {140,150,...,200}{\\draw[black,line width=0.4pt] (10,\\v)--(9.88,\\v);\\node[left] at (9.88,\\v) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\v\\special{dvisvgm:raw </g>}};}\n\\node[below] at (13.5,122) {Age (years)};\n\\node[rotate=90] at (8.85,165) {Height (cm)};\n\\node[above] at (13.5,206) {Age and height of males};\n\\foreach \\u/\\v in {11/138,11/149,12/140,12/142,12/149,12/153,12/162,12/167,13/147,13/156,13/157,13/167,13/170,13/175,14/155,14/161,14/162,14/170,14/190,15/160,15/170,16/152,16/174,16/178,16/187}{\\fill[black] (\\u,\\v) circle[radius=2.25pt];}\n\\draw[black,line width=0.8pt] plot[domain=11:16,samples=2] (\\x,{6*\\x+80});\n\\end{tikzpicture}",
            "src": null,
