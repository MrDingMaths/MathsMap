        "children": [
          {
            "id": "p32-q9-gradient",
            "type": "part",
            "label": "a",
            "prompt": "Determine the gradient of the line of best fit.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6$ cm per year",
              "worked": "$$\\begin{aligned}m&=\\frac{176-146}{16-11}\\\\&=6\\end{aligned}$$\nThe gradient is $6$ cm per year.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p32-q9-gradient-meaning",
            "type": "part",
            "label": "b",
            "prompt": "Explain the meaning of the gradient of the line of best fit.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The model predicts an increase in height of 6 cm for each additional year of age, for males aged 11 to 16.",
              "worked": "For males aged 11 to 16, each additional year of age corresponds to a predicted increase in height of 6 cm.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q9-equation",
            "type": "part",
            "label": "c",
            "prompt": "Determine the equation of the line of best fit.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$h=6a+80$",
              "worked": "Using $(a,h)=(11,146)$:\n$$\\begin{aligned}h&=6a+b\\\\146&=6(11)+b\\\\b&=80\\\\h&=6a+80\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ],
        "diagramPlacement": "beside-prompt"
      },
      {
        "id": "p32-q9-prediction",
        "type": "part",
        "label": "d",
        "prompt": "Use the equation to predict the height of a 17-year-old.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$182$ cm",
          "worked": "Let $a=17$.\n$$\\begin{aligned}h&=6(17)+80\\\\&=182\\end{aligned}$$\nThe predicted height is $182$ cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q9-limitation",
        "type": "part",
        "label": "e",
        "prompt": "Why would this model not be useful for predicting the height of a 45-year-old male?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Adults stop growing, so this linear trend cannot be extended reliably to age 45.",
          "worked": "Age 45 is far outside the observed age range of 11 to 16. Males generally stop growing when they become adults, so the adolescent linear trend does not continue to age 45.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
