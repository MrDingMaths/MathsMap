  "content": {
    "id": "v2-fe60d6-p6-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Find the absolute error of each measurement.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-fe60d6-p6-practice-slot-2-s2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "A plank is measured as $2.35\\text{ m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pm 0.005\\text{ m}$",
          "worked": "$$\\begin{align*}\\text{Precision}&=0.01\\text{ m}\\\\\\text{Absolute error}&=\\tfrac12\\times0.01=\\pm 0.005\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-fe60d6-p6-practice-slot-2-s2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "A swimmer's time is recorded as $52.4\\text{ s}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pm 0.05\\text{ s}$",
          "worked": "$$\\begin{align*}\\text{Precision}&=0.1\\text{ s}\\\\\\text{Absolute error}&=\\tfrac12\\times0.1=\\pm 0.05\\text{ s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-fe60d6-p6-practice-slot-2-s2-q-c",
        "type": "part",
        "label": "c",
        "prompt": "A bag of flour has a mass of $3500\\text{ g}$ (nearest 100).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pm 50\\text{ g}$",
          "worked": "$$\\begin{align*}\\text{Precision}&=100\\text{ g}\\\\\\text{Absolute error}&=\\tfrac12\\times100=\\pm 50\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
