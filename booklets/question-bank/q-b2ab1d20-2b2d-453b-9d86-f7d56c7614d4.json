    "children": [
      {
        "id": "v2-f3075-p38-practice-slot-2-lower-slot-2-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the minimum value of $y=x^2-6x+11$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum value $y=2$.",
          "worked": "$$\\begin{align*}x&=-\\frac{-6}{2(1)}\\\\x&=3\\\\y&=3^2-6(3)+11\\\\y&=2\\end{align*}$$\nThe parabola is concave up, so the minimum value is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-f3075-p38-practice-slot-2-lower-slot-2-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the maximum value of $y=-2x^2+8x-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Maximum value $y=5$.",
          "worked": "$$\\begin{align*}x&=-\\frac{8}{2(-2)}\\\\x&=2\\\\y&=-2(2)^2+8(2)-3\\\\y&=5\\end{align*}$$\nThe parabola is concave down, so the maximum value is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
