        "answer": {
          "short": "$c=\\frac{5}{243}$",
          "worked": "$$\\begin{align*}\\int_0^3 cx^4\\,dx&=1\\\\c\\left[\\frac{x^5}{5}\\right]_0^3&=1\\\\\\frac{243c}{5}&=1\\\\c&=\\frac{5}{243}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
