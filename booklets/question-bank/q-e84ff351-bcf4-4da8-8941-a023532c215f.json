        "id": "p14-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=c$, domain $[0,6]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=\\frac{1}{6}$",
          "worked": "$$\\begin{align*}\\int_0^6 c\\,dx&=1\\\\6c&=1\\\\c&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
