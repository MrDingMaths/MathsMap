  "content": {
    "id": "p15-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "In a class of 24 students, 11 study biology, 13 study chemistry and 8 study both biology and chemistry. One of these students is randomly selected. Find the probability that the student:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "studies chemistry",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{24}$",
          "worked": "$$\\Pr(C)=\\frac{13}{24},$$\nwhere $C$ is the event that the student studies chemistry.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "does not study biology",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{24}$",
          "worked": "There are $24-11=13$ students who do not study biology.\n$$\\Pr(B')=\\frac{13}{24}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "studies biology and chemistry",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "$$\\Pr(B\\cap C)=\\frac8{24}=\\frac13,$$\nwhere $B$ and $C$ denote studying biology and chemistry respectively.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "studies biology or chemistry",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "$$\\begin{align*}\\Pr(B\\cup C)&=\\frac{11+13-8}{24}\\\\\\Pr(B\\cup C)&=\\frac{16}{24}=\\frac23.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "studies at least one of biology and chemistry",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "At least one means the union of the two subjects.\n$$\\begin{align*}\\Pr(B\\cup C)&=\\frac{11+13-8}{24}\\\\\\Pr(B\\cup C)&=\\frac{16}{24}=\\frac23.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "studies exactly one of biology or chemistry",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "Biology only: $11-8=3$. Chemistry only: $13-8=5$.\n$$\\Pr(\\text{exactly one})=\\frac{3+5}{24}=\\frac13.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "studies chemistry but not biology",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac5{24}$",
          "worked": "There are $13-8=5$ students who study chemistry only.\n$$\\Pr(C\\cap B')=\\frac5{24}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "studies neither biology nor chemistry",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "The number studying at least one subject is $11+13-8=16$, so $24-16=8$ study neither.\n$$\\Pr((B\\cup C)')=\\frac8{24}=\\frac13.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "studies biology given that they study chemistry",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac8{13}$",
          "worked": "Of the 13 chemistry students, 8 study biology.\n$$\\Pr(B\\mid C)=\\frac8{13}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "studies chemistry given that they study biology",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac8{11}$",
          "worked": "Of the 11 biology students, 8 study chemistry.\n$$\\Pr(C\\mid B)=\\frac8{11}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "studies biology given that they do not study chemistry",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{11}$",
          "worked": "There are $24-13=11$ students who do not study chemistry. Of these, $11-8=3$ study biology.\n$$\\Pr(B\\mid C')=\\frac3{11}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "does not study chemistry given that they study biology.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{11}$",
          "worked": "Of the 11 biology students, $11-8=3$ do not study chemistry.\n$$\\Pr(C'\\mid B)=\\frac3{11}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
