  "content": {
    "id": "p49-q9",
    "type": "question",
    "label": "9",
    "prompt": "Emily does a 2 part test. She scores 19 out of 30 in Section A and 45 out of 55 in Section B.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage did she score in Section A?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$63.\\dot{3}\\%$",
          "worked": "$$\\begin{align*}\\text{Section A percentage} &= \\frac{19}{30}\\times100\\\\&=63.\\dot{3}\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p49-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage did she score in Section B?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81.\\overline{81}\\%$",
          "worked": "$$\\begin{align*}\\text{Section B percentage} &= \\frac{45}{55}\\times100\\\\&=81.\\overline{81}\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p49-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "What percentage was her overall mark out of 85? Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75.29\\%$",
          "worked": "$$\\begin{align*}\\text{Total marks scored} &=19+45\\\\&=64\\\\\\text{Overall percentage} &=\\frac{64}{85}\\times100\\\\&\\approx75.29\\%\\end{align*}$$\nTo 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
