        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{5}{x^3}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{5}{2x^2}+C$",
          "worked": "$$\\begin{align*}\\int5x^{-3}\\,dx&=\\frac{5x^{-2}}{-2}+C\\\\&=-\\frac{5}{2x^2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-p31-practice-j11-043248-j11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{5}{x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{5}{x}+C$",
          "worked": "$$\\begin{align*}\\int5x^{-2}\\,dx&=\\frac{5x^{-1}}{-1}+C\\\\&=-\\frac{5}{x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-p31-practice-j11-043248-j11-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{5}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\ln|x|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{5}{x}\\,dx&=5\\int\\frac{1}{x}\\,dx\\\\&=5\\ln|x|+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-p31-practice-j11-043248-j11-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int5\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x+C$",
          "worked": "$$\\begin{align*}\\int5x^{0}\\,dx&=5x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
