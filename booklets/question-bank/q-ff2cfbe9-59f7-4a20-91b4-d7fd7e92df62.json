    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^5$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(x^6)&=6x^{6-1}\\\\\\frac{d}{dx}(x^6)&=6x^5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{x^2}$",
          "worked": "$$\\frac{1}{x}=x^{-1}.$$ $$\\begin{align*}\\frac{d}{dx}(x^{-1})&=-x^{-2}\\\\\\frac{d}{dx}(x^{-1})&=-\\frac{1}{x^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2}{x^3}$",
          "worked": "$$\\frac{1}{x^2}=x^{-2}.$$ $$\\begin{align*}\\frac{d}{dx}(x^{-2})&=-2x^{-3}\\\\\\frac{d}{dx}(x^{-2})&=-\\frac{2}{x^3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2\\sqrt{x}}$",
          "worked": "$$\\sqrt{x}=x^{1/2}.$$ $$\\begin{align*}\\frac{d}{dx}(x^{1/2})&=\\frac12 x^{-1/2}\\\\\\frac{d}{dx}(x^{1/2})&=\\frac{1}{2\\sqrt{x}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt[3]{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3\\sqrt[3]{x^2}}$",
          "worked": "$$\\sqrt[3]{x}=x^{1/3}.$$ $$\\begin{align*}\\frac{d}{dx}(x^{1/3})&=\\frac13 x^{-2/3}\\\\\\frac{d}{dx}(x^{1/3})&=\\frac{1}{3\\sqrt[3]{x^2}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{x^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5\\sqrt{x^3}}{2}$",
          "worked": "$$\\sqrt{x^5}=x^{5/2}.$$ $$\\begin{align*}\\frac{d}{dx}(x^{5/2})&=\\frac52 x^{3/2}\\\\\\frac{d}{dx}(x^{5/2})&=\\frac{5\\sqrt{x^3}}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{1}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{2\\sqrt{x^3}}$",
          "worked": "$$\\frac{1}{\\sqrt{x}}=x^{-1/2}.$$ $$\\begin{align*}\\frac{d}{dx}(x^{-1/2})&=-\\frac12 x^{-3/2}\\\\\\frac{d}{dx}(x^{-1/2})&=-\\frac{1}{2\\sqrt{x^3}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p11-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "For $x\\ne0$, write $5=5x^0$. The factor $0$ from the power rule gives derivative $0$. The function is constant everywhere, so its derivative is also $0$ at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
