                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=-8$",
          "worked": "$$\\begin{align*}(x+4)(x+c)(2x-1)&=\\bigl(x^{2}+(c+4)x+4c\\bigr)(2x-1)\\\\&=2x^{3}+(2c+7)x^{2}+(7c-4)x-4c.\\end{align*}$$\nEquate the coefficient of $x^{2}$ to $-9$:\n$$\\begin{align*}2c+7&=-9\\\\2c&=-16\\\\c&=-8.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
