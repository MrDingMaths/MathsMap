  "content": {
    "id": "p15-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Solve each of the following equations:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_3 x+\\log_3 2=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{27}{2}$",
          "worked": "$$\\begin{align*}\\log_3(2x)&=3\\\\2x&=3^3\\\\x&=\\frac{27}{2}.\\end{align*}$$\nThis satisfies $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_4 x-\\log_4 3=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=48$",
          "worked": "$$\\begin{align*}\\log_4\\left(\\frac{x}{3}\\right)&=2\\\\\\frac{x}{3}&=4^2\\\\x&=48.\\end{align*}$$\nThis satisfies $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2(x+1)-\\log_2 x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac17$",
          "worked": "$$\\begin{align*}\\log_2\\left(\\frac{x+1}{x}\\right)&=3\\\\\\frac{x+1}{x}&=8\\\\x+1&=8x\\\\x&=\\frac17.\\end{align*}$$\nThis satisfies $x>0$ and $x+1>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p15-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_3(x+1)-\\log_3(x-1)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{14}{13}$",
          "worked": "$$\\begin{align*}\\log_3\\left(\\frac{x+1}{x-1}\\right)&=3\\\\\\frac{x+1}{x-1}&=27\\\\x+1&=27x-27\\\\26x&=28\\\\x&=\\frac{14}{13}.\\end{align*}$$\nThis satisfies $x>1$, so both logarithm arguments are positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p15-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_3 x+2\\log_3 2=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{27}{4}$",
          "worked": "$$\\begin{align*}\\log_3(4x)&=3\\\\4x&=3^3\\\\x&=\\frac{27}{4}.\\end{align*}$$\nThis satisfies $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
