      {
        "id": "p27-q6-part-c",
        "type": "part",
        "label": "c",
        "prompt": "If $b$ is an even whole number divisible by 3, what are the possible last digits of $b$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0,2,4,6,8$.",
          "worked": "A number that is even and divisible by 3 is a multiple of 6. The multiples $0,6,12,18,24$ have last digits $0,6,2,8,4$, covering every even digit. No odd last digit is possible, so the possible last digits are $0,2,4,6,8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q6-part-d",
        "type": "part",
        "label": "d",
        "prompt": "Is it true that for any even whole number $a$, $a^2+1$ is not divisible by 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.\n\nA square leaves remainder 0 or 1 when divided by 3, so adding 1 leaves remainder 1 or 2.",
          "worked": "Yes. Any whole number is a multiple of 3, one more than a multiple of 3, or one less than a multiple of 3. Its square therefore leaves remainder 0, 1 or 1 respectively when divided by 3. Adding 1 gives remainder 1 or 2, never 0. Thus $a^2+1$ is not divisible by 3 for any even whole number $a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
