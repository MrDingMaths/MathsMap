  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{\\frac49}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac49}&=\\frac{\\sqrt4}{\\sqrt9}\\\\\\sqrt{\\frac49}&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{\\frac{16}{25}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac45$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{16}{25}}&=\\frac{\\sqrt{16}}{\\sqrt{25}}\\\\\\sqrt{\\frac{16}{25}}&=\\frac45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[3]{\\frac8{27}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "$$\\begin{align*}\\sqrt[3]{\\frac8{27}}&=\\frac{\\sqrt[3]8}{\\sqrt[3]{27}}\\\\\\sqrt[3]{\\frac8{27}}&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[3]{\\frac{27}{125}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "$$\\begin{align*}\\sqrt[3]{\\frac{27}{125}}&=\\frac{\\sqrt[3]{27}}{\\sqrt[3]{125}}\\\\\\sqrt[3]{\\frac{27}{125}}&=\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt{\\frac59}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt5}{3}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac59}&=\\frac{\\sqrt5}{\\sqrt9}\\\\\\sqrt{\\frac59}&=\\frac{\\sqrt5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{\\frac{27}{25}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3\\sqrt3}{5}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{27}{25}}&=\\frac{\\sqrt{27}}{\\sqrt{25}}\\\\\\sqrt{\\frac{27}{25}}&=\\frac{\\sqrt9\\times\\sqrt3}{5}\\\\\\sqrt{\\frac{27}{25}}&=\\frac{3\\sqrt3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p7-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt{\\frac8{25}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2\\sqrt2}{5}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac8{25}}&=\\frac{\\sqrt8}{\\sqrt{25}}\\\\\\sqrt{\\frac8{25}}&=\\frac{\\sqrt4\\times\\sqrt2}{5}\\\\\\sqrt{\\frac8{25}}&=\\frac{2\\sqrt2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p7-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sqrt{\\frac{12}{75}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac25$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{12}{75}}&=\\sqrt{\\frac4{25}}\\\\\\sqrt{\\frac{12}{75}}&=\\frac{\\sqrt4}{\\sqrt{25}}\\\\\\sqrt{\\frac{12}{75}}&=\\frac25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
