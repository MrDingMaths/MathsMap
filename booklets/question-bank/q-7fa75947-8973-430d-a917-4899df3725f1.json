  "content": {
    "id": "p10-ch7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "For $x=20$, find the value of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-ch7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\frac{x}{2}&=\\frac{20}{2}\\\\\\frac{x}{2}&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-ch7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x}{5}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\frac{x}{5}+3&=\\frac{20}{5}+3\\\\\\frac{x}{5}+3&=4+3\\\\\\frac{x}{5}+3&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-ch7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x+2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\frac{1}{3}$",
          "worked": "$$\\begin{align*}\\frac{x+2}{3}&=\\frac{20+2}{3}\\\\\\frac{x+2}{3}&=\\frac{22}{3}\\\\\\frac{x+2}{3}&=7\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-ch7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x-2}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{x-2}{4}&=\\frac{20-2}{4}\\\\\\frac{x-2}{4}&=\\frac{18}{4}\\\\\\frac{x-2}{4}&=4\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-ch7-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3(x+50)}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$$\\begin{align*}\\frac{3(x+50)}{7}&=\\frac{3(20+50)}{7}\\\\\\frac{3(x+50)}{7}&=\\frac{3\\times70}{7}\\\\\\frac{3(x+50)}{7}&=3\\times10\\\\\\frac{3(x+50)}{7}&=30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-ch7-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{3x}{10}+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$\\begin{align*}\\frac{3x}{10}+10&=\\frac{3\\times20}{10}+10\\\\\\frac{3x}{10}+10&=6+10\\\\\\frac{3x}{10}+10&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-ch7-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$3\\left(\\frac{x-20}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}3\\left(\\frac{x-20}{5}\\right)&=3\\left(\\frac{20-20}{5}\\right)\\\\3\\left(\\frac{x-20}{5}\\right)&=3\\times0\\\\3\\left(\\frac{x-20}{5}\\right)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-ch7-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$60-\\frac{3x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "$$\\begin{align*}60-\\frac{3x}{5}&=60-\\frac{3\\times20}{5}\\\\60-\\frac{3x}{5}&=60-12\\\\60-\\frac{3x}{5}&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-ch7-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$21-\\frac{360}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}21-\\frac{360}{x}&=21-\\frac{360}{20}\\\\21-\\frac{360}{x}&=21-18\\\\21-\\frac{360}{x}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
