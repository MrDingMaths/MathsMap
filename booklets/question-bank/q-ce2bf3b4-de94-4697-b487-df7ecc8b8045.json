  "content": {
    "id": "p2-q1-root",
    "type": "question",
    "label": "2",
    "prompt": "Write down the expansion of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+4x+1$",
          "worked": "$$\\begin{align*}(2x+1)^2&=(2x)^2+2(2x)(1)+1^2\\\\(2x+1)^2&=4x^2+4x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(3x-4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-24x+16$",
          "worked": "$$\\begin{align*}(3x-4)^2&=(3x)^2-2(3x)(4)+4^2\\\\(3x-4)^2&=9x^2-24x+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3xy-4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2y^2-24xy+16$",
          "worked": "$$\\begin{align*}(3xy-4)^2&=(3xy)^2-2(3xy)(4)+4^2\\\\(3xy-4)^2&=9x^2y^2-24xy+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3x-4y)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-24xy+16y^2$",
          "worked": "$$\\begin{align*}(3x-4y)^2&=(3x)^2-2(3x)(4y)+(4y)^2\\\\(3x-4y)^2&=9x^2-24xy+16y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(x+\\frac{1}{x}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2+\\frac{1}{x^2}$",
          "worked": "For $x\\ne 0$,\n\n$$\\begin{align*}\\left(x+\\frac{1}{x}\\right)^2&=x^2+2x\\cdot\\frac{1}{x}+\\left(\\frac{1}{x}\\right)^2\\\\\\left(x+\\frac{1}{x}\\right)^2&=x^2+2+\\frac{1}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p2-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(x+\\frac{1}{x}\\right)\\left(x-\\frac{1}{x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-\\frac{1}{x^2}$",
          "worked": "Use the difference of two squares for $x\\ne 0$.\n\n$$\\begin{align*}\\left(x+\\frac{1}{x}\\right)\\left(x-\\frac{1}{x}\\right)&=x^2-\\left(\\frac{1}{x}\\right)^2\\\\\\left(x+\\frac{1}{x}\\right)\\left(x-\\frac{1}{x}\\right)&=x^2-\\frac{1}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p2-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(2x+1)(3x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2-5x-4$",
          "worked": "$$\\begin{align*}(2x+1)(3x-4)&=6x^2-8x+3x-4\\\\(2x+1)(3x-4)&=6x^2-5x-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$(2x-3y)(2x+3y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2-9y^2$",
          "worked": "$$\\begin{align*}(2x-3y)(2x+3y)&=(2x)^2-(3y)^2\\\\(2x-3y)(2x+3y)&=4x^2-9y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$(2x+y)(3x-4y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2-5xy-4y^2$",
          "worked": "$$\\begin{align*}(2x+y)(3x-4y)&=6x^2-8xy+3xy-4y^2\\\\(2x+y)(3x-4y)&=6x^2-5xy-4y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
