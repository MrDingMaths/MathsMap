  "content": {
    "id": "p19-q49-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=\\dfrac{x-4}{x-1}$. The graph of $y=f(x)$ is reflected in the $x$-axis and then the $y$-axis to form the graph $y=g(x)$.\n\nFind the intersection points of $f$ and $g$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
