  "content": {
    "id": "p3-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Two distinct vertices of a cube are chosen at random. Find the probability that the chosen vertices will be the endpoints of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "an edge of the cube",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{7}$",
          "worked": "Fix the first vertex. Of the seven remaining vertices, three are joined to it by an edge.\n$$\\begin{align*}\\Pr(\\text{edge})&=\\frac{3}{7}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p3-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "a face diagonal of the cube",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{7}$",
          "worked": "Fix the first vertex. It lies on three faces, each with one opposite vertex across a face diagonal. These are three of the seven remaining vertices.\n$$\\begin{align*}\\Pr(\\text{face diagonal})&=\\frac{3}{7}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p3-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "an interior diagonal of the cube.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{7}$",
          "worked": "Fix the first vertex. Only the opposite vertex is joined to it by an interior diagonal, out of seven remaining vertices.\n$$\\begin{align*}\\Pr(\\text{interior diagonal})&=\\frac{1}{7}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
