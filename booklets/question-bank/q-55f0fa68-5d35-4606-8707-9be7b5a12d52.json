  "content": {
    "id": "p11-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A right-angled triangle has one angle of $40^{\\circ}$ and a perimeter of 10. Find the length of the hypotenuse. Give your answer to two decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.15$\n\nExpress the shorter sides as $h\\sin40^{\\circ}$ and $h\\cos40^{\\circ}$, then use the perimeter.",
      "worked": "Let $h$ be the hypotenuse. The shorter sides are $h\\sin40^{\\circ}$ and $h\\cos40^{\\circ}$.\n$$\\begin{align*}h+h\\sin40^{\\circ}+h\\cos40^{\\circ}&=10\\\\h(1+\\sin40^{\\circ}+\\cos40^{\\circ})&=10\\\\h&=\\frac{10}{1+\\sin40^{\\circ}+\\cos40^{\\circ}}\\\\h&\\approx4.15\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
