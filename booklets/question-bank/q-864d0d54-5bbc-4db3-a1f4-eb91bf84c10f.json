  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A fair six-sided die is thrown and the uppermost number is noted. Find the probability that the number is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "even",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "Favourable outcomes: $\\{2,4,6\\}$.\n\n$$P(\\text{even})=\\frac36=\\frac12$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "a 6",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac16$",
          "worked": "Only outcome $6$ is favourable.\n\n$$P(6)=\\frac16$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "less than or equal to 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "Favourable outcomes: $\\{1,2,3\\}$.\n\n$$P(\\text{at most }3)=\\frac36=\\frac12$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "even and a 6",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac16$",
          "worked": "The common outcome is $6$.\n\n$$P(\\text{even and }6)=\\frac16$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "even or a 6",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "The union is $\\{2,4,6\\}$ because $6$ is already even.\n\n$$P(\\text{even or }6)=\\frac36=\\frac12$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "less than or equal to 3 and a 6",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No outcome is both at most $3$ and equal to $6$.\n\n$$P(\\text{at most }3\\text{ and }6)=0$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "less than or equal to 3 or a 6",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "The union is $\\{1,2,3,6\\}$.\n\n$$P(\\text{at most }3\\text{ or }6)=\\frac46=\\frac23$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "even and less than or equal to 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac16$",
          "worked": "The only common outcome is $2$.\n\n$$P(\\text{even and at most }3)=\\frac16$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "even or less than or equal to 3",
