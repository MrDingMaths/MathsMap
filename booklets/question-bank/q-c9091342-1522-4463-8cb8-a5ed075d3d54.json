  "content": {
    "id": "p15-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "If $x=\\dfrac1t$ and $y=\\dfrac1{1-x}$ and $z=\\dfrac{y}{y-1}$, show that $z=t$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$z=t$.\n\nSubstitute for $x$ and $y$, then clear the compound fractions.",
      "worked": "$$\\begin{align*}y&=\\frac1{1-\\frac1t}\\\\y&=\\frac{t}{t-1}\\\\z&=\\frac{\\frac{t}{t-1}}{\\frac{t}{t-1}-1}\\\\z&=\\frac{t}{t-(t-1)}\\\\z&=t\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
