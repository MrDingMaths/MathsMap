        "id": "p15-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equation $x^2-x-2=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $x=2$.",
          "worked": "$$\\begin{align*}(x-2)(x+1)&=0\\\\x-2&=0\\quad\\text{or}\\quad x+1=0\\\\x&=2\\quad\\text{or}\\quad x=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "How would you read the solution to the equation $x^2-x-2=0$ from the graph?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Read the $x$-coordinates where the graph crosses the $x$-axis: $x=-1$ and $x=2$.",
          "worked": "On the $x$-axis, $y=0$. The graph crosses this axis at $(-1,0)$ and $(2,0)$, so the solutions of $x^2-x-2=0$ are $x=-1$ and $x=2$.",
          "solutionDiagrams": []
        },
