    "children": [
      {
        "id": "p50-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-6x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercepts: $(3-\\sqrt5,0)$ and $(3+\\sqrt5,0)$.\n$y=(x+\\sqrt5-3)(x-\\sqrt5-3)$.",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}x&=\\frac{6\\pm\\sqrt{(-6)^2-4(1)(4)}}{2(1)}\\\\x&=\\frac{6\\pm\\sqrt{20}}{2}\\\\x&=3\\pm\\sqrt5\\end{align*}$$\nThe $x$-intercepts are $(3-\\sqrt5,0)$ and $(3+\\sqrt5,0)$.\n$$y=(x+\\sqrt5-3)(x-\\sqrt5-3)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p50-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2+2x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercepts: $(-1-\\sqrt2,0)$ and $(-1+\\sqrt2,0)$.\n$y=(x+\\sqrt2+1)(x-\\sqrt2+1)$.",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}x&=\\frac{-2\\pm\\sqrt{2^2-4(1)(-1)}}{2(1)}\\\\x&=\\frac{-2\\pm\\sqrt8}{2}\\\\x&=-1\\pm\\sqrt2\\end{align*}$$\nThe $x$-intercepts are $(-1-\\sqrt2,0)$ and $(-1+\\sqrt2,0)$.\n$$y=(x+\\sqrt2+1)(x-\\sqrt2+1)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p50-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-x^2+3x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercepts: $\\left(\\frac{3-\\sqrt5}{2},0\\right)$ and $\\left(\\frac{3+\\sqrt5}{2},0\\right)$.\n$y=-\\left(x-\\frac{3+\\sqrt5}{2}\\right)\\left(x-\\frac{3-\\sqrt5}{2}\\right)$.",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}x&=\\frac{-3\\pm\\sqrt{3^2-4(-1)(-1)}}{2(-1)}\\\\x&=\\frac{-3\\pm\\sqrt5}{-2}\\\\x&=\\frac{3\\pm\\sqrt5}{2}\\end{align*}$$\nThe $x$-intercepts are $\\left(\\frac{3-\\sqrt5}{2},0\\right)$ and $\\left(\\frac{3+\\sqrt5}{2},0\\right)$. Retain the leading coefficient $-1$:\n$$y=-\\left(x-\\frac{3+\\sqrt5}{2}\\right)\\left(x-\\frac{3-\\sqrt5}{2}\\right)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 82
      }
    ]
  },
