  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A landscaper is constructing a rectangular garden bed.\nThree of the sides are to be fenced using 40 metres of fencing, while an existing wall will form the fourth side of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Let $x$ be the length of each of the two sides perpendicular to the wall.\nShow that the side parallel to the wall has length $40-2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40-2x$ metres.",
          "worked": "Let $y$ be the length parallel to the wall, in metres.\nFencing length:\n$$\\begin{align*}40&=2x+y\\\\y&=40-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the area of the garden bed is given by $A=40x-2x^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=40x-2x^2$.",
          "worked": "Using $y=40-2x$:\n$$\\begin{align*}A&=xy\\\\A&=x(40-2x)\\\\A&=40x-2x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\dfrac{dA}{dx}$ and hence find the value of $x$ that maximises $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dA}{dx}=40-4x$; the area is maximised when $x=10$ metres.",
          "worked": {
            "format": "maths-editor-document-v1",
