  "content": {
    "id": "p19-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find $\\Pr(A\\cup B)$ if $A$ and $B$ are independent and\n$$\\Pr(A)=0.6,\\quad \\Pr(B)=0.5.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.8$",
      "worked": "Since $A$ and $B$ are independent,\n$$\\begin{align*}\\Pr(A\\cup B)&=\\Pr(A)+\\Pr(B)-\\Pr(A)\\Pr(B)\\\\\\Pr(A\\cup B)&=0.6+0.5-0.6\\times0.5\\\\\\Pr(A\\cup B)&=0.8.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
