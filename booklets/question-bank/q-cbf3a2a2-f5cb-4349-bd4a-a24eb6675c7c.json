        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-57$",
          "worked": "$$\\begin{align*}2x+3&=2\\times(-30)+3\\\\2x+3&=-60+3\\\\2x+3&=-57\\end{align*}$$",
