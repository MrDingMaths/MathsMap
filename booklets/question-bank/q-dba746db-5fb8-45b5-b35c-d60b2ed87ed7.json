  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Express each of the following as a product of prime numbers:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$12^2-2^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times5\\times7$",
          "worked": "$$\\begin{align*}12^2-2^2&=(12-2)(12+2)\\\\12^2-2^2&=10\\times14\\\\12^2-2^2&=(2\\times5)(2\\times7)\\\\12^2-2^2&=2^2\\times5\\times7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$11^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^2\\times13$",
          "worked": "$$\\begin{align*}11^2-4&=(11-2)(11+2)\\\\11^2-4&=9\\times13\\\\11^2-4&=3^2\\times13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$17^2-6^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11\\times23$",
          "worked": "$$\\begin{align*}17^2-6^2&=(17-6)(17+6)\\\\17^2-6^2&=11\\times23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$21^2-64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13\\times29$",
          "worked": "$$\\begin{align*}21^2-64&=(21-8)(21+8)\\\\21^2-64&=13\\times29\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$38^2-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times13\\times37$",
          "worked": "$$\\begin{align*}38^2-1&=(38-1)(38+1)\\\\38^2-1&=37\\times39\\\\38^2-1&=3\\times13\\times37\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$27^2-14^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13\\times41$",
          "worked": "$$\\begin{align*}27^2-14^2&=(27-14)(27+14)\\\\27^2-14^2&=13\\times41\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
