  "content": {
    "id": "p28-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Find a formula for the surface area of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q16/a",
        "type": "part",
        "label": "a",
        "prompt": "a half-cylinder of height $h$ and radius $r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=2rh+\\pi rh+\\pi r^2$.\n\nInclude the rectangular cut face.",
          "worked": "The two semicircular ends together have area $\\pi r^2$. The curved surface unwraps to a rectangle of width $\\pi r$ and height $h$. The flat cut face has dimensions $2r\\times h$.\n\n$$\\begin{align*}A&=\\pi r^2+(\\pi r)h+(2r)h\\\\A&=2rh+\\pi rh+\\pi r^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p28-q16/b",
        "type": "part",
        "label": "b",
        "prompt": "a quarter-cylinder of height $h$ and radius $r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=2rh+\\dfrac{\\pi rh}{2}+\\dfrac{\\pi r^2}{2}$.\n\nInclude both rectangular cut faces.",
          "worked": "The two quarter-circle ends together have area $\\frac{\\pi r^2}{2}$. The curved surface unwraps to a rectangle of width $\\frac{\\pi r}{2}$ and height $h$. Each of the two flat cut faces has area $rh$.\n\n$$\\begin{align*}A&=\\frac{\\pi r^2}{2}+\\frac{\\pi r}{2}h+rh+rh\\\\A&=2rh+\\frac{\\pi rh}{2}+\\frac{\\pi r^2}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
