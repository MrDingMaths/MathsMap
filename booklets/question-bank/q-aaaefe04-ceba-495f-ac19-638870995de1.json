                "type": "text",
                "text": "Change every logarithm to the same base and cancel the common factors.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\log_2(3)\\log_3(4)\\log_4(5)\\log_5(6)\\log_6(7)\\log_7(8)&=\\frac{\\ln3}{\\ln2}\\times\\frac{\\ln4}{\\ln3}\\times\\frac{\\ln5}{\\ln4}\\times\\frac{\\ln6}{\\ln5}\\times\\frac{\\ln7}{\\ln6}\\times\\frac{\\ln8}{\\ln7}\\\\\\log_2(3)\\log_3(4)\\log_4(5)\\log_5(6)\\log_6(7)\\log_7(8)&=\\frac{\\ln8}{\\ln2}\\\\\\log_2(3)\\log_3(4)\\log_4(5)\\log_5(6)\\log_6(7)\\log_7(8)&=\\frac{3\\ln2}{\\ln2}\\\\\\log_2(3)\\log_3(4)\\log_4(5)\\log_5(6)\\log_6(7)\\log_7(8)&=3.\\end{align*}$$",
      "solutionDiagrams": []
    },
