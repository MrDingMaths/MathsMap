  "content": {
    "id": "p2-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The ratio of length to width of a rectangle is $3:2$. Find the rectangle’s dimensions if its perimeter is $120\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Length $36\\text{ cm}$, width $24\\text{ cm}$.",
      "worked": "Let the length and width be $3x\\text{ cm}$ and $2x\\text{ cm}$, respectively.\n\n$$\\begin{align*}2(3x)+2(2x)&=120\\\\10x&=120\\\\x&=12\\end{align*}$$\n\nThe length is $3\\times12=36\\text{ cm}$ and the width is $2\\times12=24\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
