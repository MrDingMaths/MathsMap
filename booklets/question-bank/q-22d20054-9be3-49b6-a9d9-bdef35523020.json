  "content": {
    "id": "p31-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A hockey team played 27 matches in a season. The ratio of losses to wins was $4:5$. How many games did the team win and how many did it lose?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "15 wins and 12 losses.",
      "worked": "There are $4+5=9$ parts altogether.\n$$\\begin{align*}\\text{Matches per part}&=27\\div9\\\\\\text{Matches per part}&=3\\\\\\text{Wins}&=5\\times3\\\\\\text{Wins}&=15\\\\\\text{Losses}&=4\\times3\\\\\\text{Losses}&=12\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
