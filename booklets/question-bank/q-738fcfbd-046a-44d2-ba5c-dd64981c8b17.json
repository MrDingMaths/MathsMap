  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Calculate the following overtime rates.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Time and a half when the hourly rate is \\$15.96/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$23.94}{\\text{h}}$",
          "worked": "$$\\begin{align*}\\text{Overtime rate}&=15.96\\times1.5\\\\\\text{Overtime rate}&=\\$23.94/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Double time when the hourly rate is \\$23.90/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$47.80}{\\text{h}}$",
          "worked": "$$\\begin{align*}\\text{Overtime rate}&=23.90\\times2\\\\\\text{Overtime rate}&=\\$47.80/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Double time and a half when the hourly rate is \\$17.40/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\$43.50}{\\text{h}}$",
          "worked": "$$\\begin{align*}\\text{Overtime rate}&=17.40\\times2.5\\\\\\text{Overtime rate}&=\\$43.50/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
