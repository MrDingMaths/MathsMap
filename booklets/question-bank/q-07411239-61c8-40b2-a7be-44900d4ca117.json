  "content": {
    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Two companies, A and B, each offer you a sales position. Both jobs are essentially the same, but A pays a straight $8\\%$ commission while B pays $\\$51$ per week plus $5\\%$ commission. For what amount of weekly sales will A pay more money?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Weekly sales must exceed $\\$1700$.",
      "worked": "Let $x$ be weekly sales in dollars. A pays $0.08x$ dollars and B pays $51+0.05x$ dollars.\n$$\\begin{align*}0.08x&>51+0.05x\\\\0.03x&>51\\\\x&>\\frac{51}{0.03}\\\\x&>1700\\end{align*}$$\nA pays more when weekly sales exceed $\\$1700$.",
      "solutionDiagrams": []
    },
