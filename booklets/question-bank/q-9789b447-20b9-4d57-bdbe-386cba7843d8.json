  "content": {
    "id": "p39-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A toy store is having a sale in which everything is discounted by $10\\%$ of the recommended retail price (RRP). A remote-control car has a RRP of $\\$120$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the discount on the car.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$12$",
          "worked": "$$\\begin{align*}\\text{Discount} &= 0.10\\times\\$120\\\\\\text{Discount} &= \\$12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p39-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the selling price of the car.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$108$",
          "worked": "$$\\begin{align*}\\text{Selling-price percentage} &= 100\\%-10\\%=90\\%\\\\\\text{Selling price} &= 0.90\\times\\$120\\\\\\text{Selling price} &= \\$108\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
