  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Verify that the given function satisfies the DE for every value of the arbitrary constant $C$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=Ce^x-x-1;\\quad y'=x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=x+y=Ce^x-1$ for every $C$.",
          "worked": "$$\\begin{aligned}y'&=Ce^x-1\\\\\\mathrm{RHS}&=x+y\\\\&=x+Ce^x-x-1\\\\&=Ce^x-1\\\\&=y'\\end{aligned}$$\nThe DE is satisfied for every $C$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=Cxe^{-x};\\quad xy'=y(1-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy'=y(1-x)=Cxe^{-x}(1-x)$ for every $C$.",
          "worked": "$$\\begin{aligned}y'&=Ce^{-x}-Cxe^{-x}\\\\&=Ce^{-x}(1-x)\\\\\\mathrm{LHS}&=xy'\\\\&=Cxe^{-x}(1-x)\\\\\\mathrm{RHS}&=y(1-x)\\\\&=Cxe^{-x}(1-x)\\end{aligned}$$\nLHS equals RHS for every $C$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\sin(x+C);\\quad (y')^2=1-y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y')^2=1-y^2=\\cos^2(x+C)$ for every $C$.",
          "worked": "$$\\begin{aligned}y'&=\\cos(x+C)\\\\\\mathrm{LHS}&=(y')^2\\\\&=\\cos^2(x+C)\\\\\\mathrm{RHS}&=1-y^2\\\\&=1-\\sin^2(x+C)\\\\&=\\cos^2(x+C)\\end{aligned}$$\nLHS equals RHS for every $C$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{C}{x}+2;\\quad \\frac{dy}{dx}=\\frac{2-y}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{2-y}{x}=-\\dfrac{C}{x^2}$ for every $C$, with $x\\ne0$.",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=-\\frac{C}{x^2}\\\\\\mathrm{RHS}&=\\frac{2-y}{x}\\\\&=\\frac{2-\\left(\\frac{C}{x}+2\\right)}{x}\\\\&=-\\frac{C}{x^2}\\\\&=\\frac{dy}{dx}\\end{aligned}$$\nThe DE is satisfied for every $C$ on an interval where $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
