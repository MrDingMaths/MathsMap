  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find a positive integer that, when increased by 30, is 12 less than its square.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7$",
      "worked": "Let $n$ be the positive integer.\n$$\\begin{align*}n+30&=n^2-12\\\\n^2-n-42&=0\\\\(n-7)(n+6)&=0\\\\n&=7\\text{ or }-6.\\end{align*}$$\nThe positive integer is $7$. Check: $7+30=37$ and $7^2-12=37$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 47
  },
