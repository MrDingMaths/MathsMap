        "id": "v2-8d9c0-p24-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int (e^{3x}+6x^2)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{e^{3x}}{3}+2x^3+C$",
          "worked": "$$\\begin{align*}\\int (e^{3x}+6x^2)\\,dx&=\\frac{e^{3x}}{3}+\\frac{6x^3}{3}+C\\\\&=\\frac{e^{3x}}{3}+2x^3+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-8d9c0-p24-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int (4e^{2x+1}-x^{-3})\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2e^{2x+1}+\\dfrac{1}{2x^2}+C$",
          "worked": "$$\\begin{align*}\\int (4e^{2x+1}-x^{-3})\\,dx&=\\frac{4e^{2x+1}}{2}-\\frac{x^{-2}}{-2}+C\\\\&=2e^{2x+1}+\\frac{1}{2x^2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-8d9c0-p24-practice-slot-3-slot-3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int (6e^{x/2}+3\\sqrt{x})\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12e^{x/2}+2x^{3/2}+C$",
          "worked": "$$\\begin{align*}\\int (6e^{x/2}+3x^{1/2})\\,dx&=\\frac{6e^{x/2}}{1/2}+\\frac{3x^{3/2}}{3/2}+C\\\\&=12e^{x/2}+2x^{3/2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
