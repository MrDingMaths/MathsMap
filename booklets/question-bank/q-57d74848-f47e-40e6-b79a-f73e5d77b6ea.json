  "content": {
    "id": "p15-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Write the following in surd form.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{\\frac{3}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[4]{x^3}$",
          "worked": "$x^{\\frac{3}{4}}=\\sqrt[4]{x^3}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{\\frac{4}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[3]{x^4}$",
          "worked": "$x^{\\frac{4}{3}}=\\sqrt[3]{x^4}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^{-\\frac{4}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{\\sqrt[3]{x^4}}$",
          "worked": "$\\begin{aligned}x^{-\\frac{4}{3}}&=\\frac1{x^{\\frac{4}{3}}}\\\\&=\\frac1{\\sqrt[3]{x^4}}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x^{\\frac{1}{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt[5]x$",
          "worked": "$2x^{\\frac{1}{5}}=2\\sqrt[5]x$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2x)^{\\frac{1}{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[5]{2x}$",
          "worked": "$(2x)^{\\frac{1}{5}}=\\sqrt[5]{2x}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^{-\\frac{7}{5}}y^{\\frac{1}{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt[5]y}{\\sqrt[5]{x^7}}$",
          "worked": "$\\begin{aligned}x^{-\\frac{7}{5}}y^{\\frac{1}{5}}&=\\frac{y^{\\frac{1}{5}}}{x^{\\frac{7}{5}}}\\\\&=\\frac{\\sqrt[5]y}{\\sqrt[5]{x^7}}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
