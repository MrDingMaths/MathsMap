                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{1+\\sin\\theta}{1-\\sin\\theta}=\\left(\\frac{1+\\sin\\theta}{\\cos\\theta}\\right)^2=(\\sec\\theta+\\tan\\theta)^2",
                    "display": false
                  }
                ]
