        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta$",
          "worked": "$$\\begin{align*}\\sin(90^\\circ-\\theta)&=\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
