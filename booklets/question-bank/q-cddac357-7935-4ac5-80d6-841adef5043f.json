        "type": "part",
        "label": "b",
        "prompt": "$\\cos(90^\\circ-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\theta$",
          "worked": "$$\\begin{align*}\\cos(90^\\circ-\\theta)&=\\sin\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-ep-9-14-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(90^\\circ-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\theta$",
          "worked": "$$\\begin{align*}\\tan(90^\\circ-\\theta)&=\\frac{\\sin(90^\\circ-\\theta)}{\\cos(90^\\circ-\\theta)}\\\\\\tan(90^\\circ-\\theta)&=\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\tan(90^\\circ-\\theta)&=\\cot\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-ep-9-14-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sec(90^\\circ-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{cosec}\\theta$",
          "worked": "$$\\begin{align*}\\sec(90^\\circ-\\theta)&=\\frac{1}{\\cos(90^\\circ-\\theta)}\\\\\\sec(90^\\circ-\\theta)&=\\frac{1}{\\sin\\theta}\\\\\\sec(90^\\circ-\\theta)&=\\operatorname{cosec}\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-ep-9-14-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\operatorname{cosec}(90^\\circ-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sec\\theta$",
          "worked": "$$\\begin{align*}\\operatorname{cosec}(90^\\circ-\\theta)&=\\frac{1}{\\sin(90^\\circ-\\theta)}\\\\\\operatorname{cosec}(90^\\circ-\\theta)&=\\frac{1}{\\cos\\theta}\\\\\\operatorname{cosec}(90^\\circ-\\theta)&=\\sec\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-ep-9-14-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\cot(90^\\circ-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta$",
          "worked": "$$\\begin{align*}\\cot(90^\\circ-\\theta)&=\\frac{\\cos(90^\\circ-\\theta)}{\\sin(90^\\circ-\\theta)}\\\\\\cot(90^\\circ-\\theta)&=\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\cot(90^\\circ-\\theta)&=\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
