  "content": {
    "id": "p21-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find points on the graph of each function where the tangent has a gradient of $0$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=4+4x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,8)$",
          "worked": "$$\\begin{aligned}f'(x)&=4-2x\\\\4-2x&=0\\\\x&=2\\\\f(2)&=4+4(2)-2^2\\\\&=8\\end{aligned}$$\nThe point is $(2,8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^3-12x+24$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,8)$ and $(-2,40)$",
          "worked": "$$\\begin{aligned}f'(x)&=3x^2-12\\\\3x^2-12&=0\\\\x^2&=4\\\\x&=\\pm2\\\\f(2)&=2^3-12(2)+24\\\\&=8\\\\f(-2)&=(-2)^3-12(-2)+24\\\\&=40\\end{aligned}$$\nThe points are $(2,8)$ and $(-2,40)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No points.",
          "worked": "$$f'(x)=3$$\nThe tangent gradient is always $3$, so it cannot equal $0$. There are no such points.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=4x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,4)$",
          "worked": "$$\\begin{aligned}f'(x)&=4-2x\\\\4-2x&=0\\\\x&=2\\\\f(2)&=4(2)-2^2\\\\&=4\\end{aligned}$$\nThe point is $(2,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=x^4-2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,0)$, $(1,-1)$ and $(-1,-1)$",
          "worked": "$$\\begin{aligned}f'(x)&=4x^3-4x\\\\4x^3-4x&=0\\\\4x(x-1)(x+1)&=0\\\\x&=0,\\ 1,\\ -1\\end{aligned}$$\n$$\\begin{aligned}f(0)&=0\\\\f(1)&=1^4-2(1)^2\\\\&=-1\\\\f(-1)&=(-1)^4-2(-1)^2\\\\&=-1\\end{aligned}$$\nThe points are $(0,0)$, $(1,-1)$ and $(-1,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p21-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=x^5+x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No points.",
          "worked": "$$\\begin{aligned}f'(x)&=5x^4+1\\\\5x^4+1&=0\\\\x^4&=-\\frac15\\end{aligned}$$\nSince $x^4\\geq0$ for real $x$, there is no real solution. There are no such points.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
