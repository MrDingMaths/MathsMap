  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A chord of a circle of radius $3$ cm subtends an angle of $150^\\circ$ at the centre. Find the",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "length of the arc.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5\\pi}{2}\\text{ cm}$",
          "worked": "$$\\begin{align*}\\theta&=150\\times\\frac{\\pi}{180}=\\frac{5\\pi}{6}\\text{ rad}\\\\l&=r\\theta\\\\l&=3\\times\\frac{5\\pi}{6}\\\\l&=\\frac{5\\pi}{2}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "area of the sector.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15\\pi}{4}\\text{ cm}^2$",
          "worked": "$$\\begin{align*}\\theta&=150\\times\\frac{\\pi}{180}=\\frac{5\\pi}{6}\\text{ rad}\\\\A&=\\frac{1}{2}r^2\\theta\\\\A&=\\frac{1}{2}\\times3^2\\times\\frac{5\\pi}{6}\\\\A&=\\frac{15\\pi}{4}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
