      "evidence": ".booklet-work/reasoning-ratings/calls/inverse-functions-v1/dd1534d1aabf52f1e1889407305e96c24a822ba29c92e45108c74e44225f0988-1792560391296/last-message.txt"
    }
  },
  "content": {
    "id": "p22-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "$f(x)=2x+4$ and $g(x)=3x-8$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f^{-1}(x)$ and $g^{-1}(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=\\dfrac{x-4}{2}$, $g^{-1}(x)=\\dfrac{x+8}{3}$.",
          "worked": "For $f$:\n$$\\begin{align*}y&=2x+4\\\\x&=2y+4\\\\y&=\\frac{x-4}{2}\\\\f^{-1}(x)&=\\frac{x-4}{2}\\end{align*}$$\nFor $g$:\n$$\\begin{align*}y&=3x-8\\\\x&=3y-8\\\\y&=\\frac{x+8}{3}\\\\g^{-1}(x)&=\\frac{x+8}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p22-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Find an expression for $f(g(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=6x-12$.",
          "worked": "$$\\begin{align*}f(g(x))&=2(3x-8)+4\\\\f(g(x))&=6x-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p22-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "Find an expression for the inverse of $f(g(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(fg)^{-1}(x)=\\dfrac{x+12}{6}$.",
          "worked": "$$\\begin{align*}y&=6x-12\\\\x&=6y-12\\\\y&=\\frac{x+12}{6}\\\\(fg)^{-1}(x)&=\\frac{x+12}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "Is $(fg)^{-1}(x)$ the same as $f^{-1}(g^{-1}(x))$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. $f^{-1}(g^{-1}(x))=\\dfrac{x-4}{6}$, whereas $(fg)^{-1}(x)=\\dfrac{x+12}{6}$.",
          "worked": "$$\\begin{align*}f^{-1}(g^{-1}(x))&=\\frac{\\frac{x+8}{3}-4}{2}\\\\f^{-1}(g^{-1}(x))&=\\frac{x+8-12}{6}\\\\f^{-1}(g^{-1}(x))&=\\frac{x-4}{6}\\end{align*}$$\nNo. This differs from $(fg)^{-1}(x)=\\dfrac{x+12}{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p22-q20-e",
        "type": "part",
        "label": "e",
        "prompt": "Is $(fg)^{-1}(x)$ the same as $g^{-1}(f^{-1}(x))$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. $g^{-1}(f^{-1}(x))=\\dfrac{x+12}{6}=(fg)^{-1}(x)$.",
          "worked": "$$\\begin{align*}g^{-1}(f^{-1}(x))&=\\frac{\\frac{x-4}{2}+8}{3}\\\\g^{-1}(f^{-1}(x))&=\\frac{x-4+16}{6}\\\\g^{-1}(f^{-1}(x))&=\\frac{x+12}{6}\\end{align*}$$\nYes. This equals $(fg)^{-1}(x)$; the inverse functions are applied in reverse order.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
