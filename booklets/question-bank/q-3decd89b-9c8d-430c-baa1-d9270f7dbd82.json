  "content": {
    "id": "p36-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A manufacturer of suits can produce a suit at a cost of $\\$250$. When he sells it to a clothing store owner, he makes a $20\\%$ profit on the suit. To cover costs, the store owner increases the cost of the suit a further $30\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "For what price does the store owner sell the suit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$390$",
          "worked": "$$\\begin{align*}\\text{Selling price}&=250\\times1.20\\times1.30\\\\\\text{Selling price}&=300\\times1.30\\\\\\text{Selling price}&=\\$390\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p36-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the total percentage increase in the cost of the suit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56\\%$",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=1.20\\times1.30\\\\\\text{Combined multiplier}&=1.56\\end{align*}$$\nThe selling price is $156\\%$ of the original cost, so the total percentage increase is $156\\%-100\\%=56\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
