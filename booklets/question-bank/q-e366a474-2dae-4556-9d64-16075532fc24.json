  "content": {
    "id": "p26-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find the first term and the number of terms if a series has:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$d=4$, $\\ell=32$ and $S_n=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-32$, $n=17$.",
          "worked": "$$\\begin{align*}S_n&=\\frac n2(a+\\ell)\\\\0&=\\frac n2(a+32)\\\\a&=-32\\qquad(n>0)\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\32&=-32+(n-1)(4)\\\\64&=4n-4\\\\68&=4n\\\\n&=17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p26-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$d=-3$, $\\ell=-10$ and $S_n=55$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=20$, $n=11$.",
          "worked": "$$\\begin{align*}S_n&=\\frac n2(a+\\ell)\\\\55&=\\frac n2(a-10)\\\\110&=n(a-10)\\qquad\\text{(1)}\\end{align*}$$\n$$\\begin{align*}a_n&=a+(n-1)d\\\\-10&=a+(n-1)(-3)\\\\-10&=a-3n+3\\\\a&=3n-13\\qquad\\text{(2)}\\end{align*}$$\nSubstitute (2) into (1):\n$$\\begin{align*}110&=n(3n-13-10)\\\\110&=n(3n-23)\\\\3n^2-23n-110&=0\\\\(3n+10)(n-11)&=0\\\\n&=11\\qquad(n>0)\\end{align*}$$\n$$\\begin{align*}a&=3(11)-13\\\\a&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 77
      }
    ]
  },
