  "content": {
    "id": "p39-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\frac{1}{x}}{\\frac{2}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "Multiply the main numerator and denominator by $x$.\n$$\\begin{align*}\\dfrac{\\frac{1}{x}}{\\frac{2}{x}}&=\\dfrac{x\\left(\\frac{1}{x}\\right)}{x\\left(\\frac{2}{x}\\right)}\\\\&=\\dfrac{1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p39-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\frac{2}{x}}{\\frac{1}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "Multiply the main numerator and denominator by $x$.\n$$\\begin{align*}\\dfrac{\\frac{2}{x}}{\\frac{1}{x}}&=\\dfrac{x\\left(\\frac{2}{x}\\right)}{x\\left(\\frac{1}{x}\\right)}\\\\&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p39-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\frac{1}{x}}{\\frac{1}{x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$",
          "worked": "Multiply the main numerator and denominator by $x^2$.\n$$\\begin{align*}\\dfrac{\\frac{1}{x}}{\\frac{1}{x^2}}&=\\dfrac{x^2\\left(\\frac{1}{x}\\right)}{x^2\\left(\\frac{1}{x^2}\\right)}\\\\&=x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\frac{1}{x^2}}{\\frac{1}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x}$",
          "worked": "Multiply the main numerator and denominator by $x^2$.\n$$\\begin{align*}\\dfrac{\\frac{1}{x^2}}{\\frac{1}{x}}&=\\dfrac{x^2\\left(\\frac{1}{x^2}\\right)}{x^2\\left(\\frac{1}{x}\\right)}\\\\&=\\dfrac{1}{x}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\frac{x}{y}}{\\frac{x}{y^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$",
          "worked": "Multiply the main numerator and denominator by $y^2$.\n$$\\begin{align*}\\dfrac{\\frac{x}{y}}{\\frac{x}{y^2}}&=\\dfrac{y^2\\left(\\frac{x}{y}\\right)}{y^2\\left(\\frac{x}{y^2}\\right)}\\\\&=\\dfrac{xy}{x}\\\\&=y.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\frac{x^2}{y}}{\\frac{x}{y^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy$",
          "worked": "Multiply the main numerator and denominator by $y^2$.\n$$\\begin{align*}\\dfrac{\\frac{x^2}{y}}{\\frac{x}{y^2}}&=\\dfrac{y^2\\left(\\frac{x^2}{y}\\right)}{y^2\\left(\\frac{x}{y^2}\\right)}\\\\&=\\dfrac{x^2y}{x}\\\\&=xy.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
