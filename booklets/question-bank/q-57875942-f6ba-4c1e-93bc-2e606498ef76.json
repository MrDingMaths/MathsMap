      {
        "id": "p63-question-21-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $y=xe^x$, and hence find $\\displaystyle\\int_0^2 xe^x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=e^x+xe^x$; $\\displaystyle\\int_0^2 xe^x\\,dx=e^2+1$.",
          "worked": "$$\\begin{align*}y'&=e^x+xe^x\\\\xe^x&=y'-e^x\\\\\\int_0^2 xe^x\\,dx&=\\int_0^2(y'-e^x)\\,dx\\\\\\int_0^2 xe^x\\,dx&=[y-e^x]_0^2\\\\\\int_0^2 xe^x\\,dx&=[xe^x-e^x]_0^2\\\\\\int_0^2 xe^x\\,dx&=(2e^2-e^2)-(0-1)\\\\\\int_0^2 xe^x\\,dx&=e^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p63-question-21-b",
        "type": "part",
        "label": "b",
        "prompt": "Differentiate $y=xe^{-x}$, and hence find $\\displaystyle\\int_{-2}^0 xe^{-x}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=e^{-x}-xe^{-x}$; $\\displaystyle\\int_{-2}^0 xe^{-x}\\,dx=-1-e^2$.",
          "worked": "$$\\begin{align*}y'&=e^{-x}-xe^{-x}\\\\xe^{-x}&=-y'+e^{-x}\\\\\\int_{-2}^0 xe^{-x}\\,dx&=\\int_{-2}^0(-y'+e^{-x})\\,dx\\\\\\int_{-2}^0 xe^{-x}\\,dx&=[-y-e^{-x}]_{-2}^0\\\\\\int_{-2}^0 xe^{-x}\\,dx&=[-xe^{-x}-e^{-x}]_{-2}^0\\\\\\int_{-2}^0 xe^{-x}\\,dx&=(-1)-(2e^2-e^2)\\\\\\int_{-2}^0 xe^{-x}\\,dx&=-1-e^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
