  "content": {
    "id": "p52-q16-response",
    "type": "question",
    "label": "16",
    "prompt": "A parabola has $x$-intercepts at $x=-3$ and $x=3$. The $y$-intercept is $-\\dfrac{9}{2}$. Find the equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\dfrac{1}{2}(x+3)(x-3)$",
      "worked": "$$\\begin{align*}y&=k(x+3)(x-3)\\\\-\\frac{9}{2}&=k(0+3)(0-3)\\\\k&=\\frac{1}{2}\\\\\\therefore y&=\\frac{1}{2}(x+3)(x-3)\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
