      {
        "id": "p66-q27-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the value of $k$ for which:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p66-q27-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\overrightarrow{AP}=\\frac34\\overrightarrow{PB}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=\\frac37$",
              "worked": "$$\\begin{align*}\\overrightarrow{AP}&=\\frac34(\\overrightarrow{AB}-\\overrightarrow{AP})\\\\\\overrightarrow{AP}&=\\frac34\\overrightarrow{AB}-\\frac34\\overrightarrow{AP}\\\\\\frac74\\overrightarrow{AP}&=\\frac34\\overrightarrow{AB}\\\\\\frac74k\\overrightarrow{AB}&=\\frac34\\overrightarrow{AB}\\\\k&=\\frac37\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p66-q27-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\overrightarrow{AP}=-\\frac35\\overrightarrow{PB}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=-\\frac32$",
              "worked": "$$\\begin{align*}\\overrightarrow{AP}&=-\\frac35(\\overrightarrow{AB}-\\overrightarrow{AP})\\\\\\overrightarrow{AP}&=-\\frac35\\overrightarrow{AB}+\\frac35\\overrightarrow{AP}\\\\\\frac25\\overrightarrow{AP}&=-\\frac35\\overrightarrow{AB}\\\\\\frac25k\\overrightarrow{AB}&=-\\frac35\\overrightarrow{AB}\\\\k&=-\\frac32\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p66-q27-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\overrightarrow{AP}=-\\frac23\\overrightarrow{PB}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=-2$",
              "worked": "$$\\begin{align*}\\overrightarrow{AP}&=-\\frac23\\overrightarrow{PB}\\\\\\overrightarrow{PB}&=\\overrightarrow{AB}-\\overrightarrow{AP}\\\\\\overrightarrow{AP}&=-\\frac23(\\overrightarrow{AB}-\\overrightarrow{AP})\\\\\\overrightarrow{AP}&=-\\frac23\\overrightarrow{AB}+\\frac23\\overrightarrow{AP}\\\\\\frac13\\overrightarrow{AP}&=-\\frac23\\overrightarrow{AB}\\\\\\frac13k\\overrightarrow{AB}&=-\\frac23\\overrightarrow{AB}\\\\k&=-2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 51
          }
        ]
      },
      {
        "id": "p66-q27-c",
        "type": "part",
        "label": "c",
        "prompt": "Let $\\underset{\\sim}{a}$, $\\underset{\\sim}{b}$ and $\\underset{\\sim}{p}$ be the respective position vectors of the points $A$, $B$ and $P$ relative to an origin $O$. Prove that $\\underset{\\sim}{p}=(1-k)\\underset{\\sim}{a}+k\\underset{\\sim}{b}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{p}-\\underset{\\sim}{a}=k(\\underset{\\sim}{b}-\\underset{\\sim}{a})$, so $\\underset{\\sim}{p}=(1-k)\\underset{\\sim}{a}+k\\underset{\\sim}{b}$.",
          "worked": "$$\\begin{align*}\\overrightarrow{AB}&=\\overrightarrow{OB}-\\overrightarrow{OA}=\\underset{\\sim}{b}-\\underset{\\sim}{a}\\\\\\overrightarrow{AP}&=\\overrightarrow{OP}-\\overrightarrow{OA}=\\underset{\\sim}{p}-\\underset{\\sim}{a}\\end{align*}$$\nGiven $\\overrightarrow{AP}=k\\overrightarrow{AB}$,\n$$\\begin{align*}\\underset{\\sim}{p}-\\underset{\\sim}{a}&=k(\\underset{\\sim}{b}-\\underset{\\sim}{a})\\\\\\underset{\\sim}{p}-\\underset{\\sim}{a}&=k\\underset{\\sim}{b}-k\\underset{\\sim}{a}\\\\\\underset{\\sim}{p}&=\\underset{\\sim}{a}-k\\underset{\\sim}{a}+k\\underset{\\sim}{b}\\\\\\underset{\\sim}{p}&=(1-k)\\underset{\\sim}{a}+k\\underset{\\sim}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
