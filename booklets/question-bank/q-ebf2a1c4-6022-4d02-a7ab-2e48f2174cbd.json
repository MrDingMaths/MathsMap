  "content": {
    "id": "p32-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "The price of a shirt including GST is $\\$110$. What is the pre-GST price of the shirt?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$100$",
      "worked": "GST is $10\\%$ of the pre-GST price, so the price including GST is $110\\%$ of the pre-GST price.\n\n$$\\begin{align*}110\\%\\text{ of the pre-GST price}&=\\$110\\\\10\\%\\text{ of the pre-GST price}&=\\$110\\div11=\\$10\\\\100\\%\\text{ of the pre-GST price}&=\\$10\\times10=\\$100\\end{align*}$$",
      "solutionDiagrams": []
