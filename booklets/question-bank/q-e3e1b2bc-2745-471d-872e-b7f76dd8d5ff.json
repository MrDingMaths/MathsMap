      {
        "id": "p5-q2a",
        "type": "part",
        "label": "a",
        "prompt": "Plot the graph of $q$ against $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A smooth increasing curve through $(0,0)$, $(1,4)$, $(4,8)$, $(9,12)$ and $(16,16)$.",
          "worked": "Put $p$ on the horizontal axis and $q$ on the vertical axis. Plot $(0,0)$, $(1,4)$, $(4,8)$, $(9,12)$ and $(16,16)$, then join them with a smooth increasing curve that becomes less steep.",
          "solutionDiagrams": [
            {
              "id": "p5-q2a-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"page 5 question 2a; teacher page 75\"}\n\\begin{tikzpicture}[x=0.24cm,y=0.24cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[->,line width=0.5pt] (-1,0)--(21,0) node[right] {$p$};\n\\draw[->,line width=0.5pt] (0,-1)--(0,20) node[above] {$q$};\n\\foreach \\x in {5,10,15,20}{\\draw[line width=0.4pt] (\\x,0)--(\\x,-0.45) node[below] {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\x$\\special{dvisvgm:raw </g>}};}\n\\foreach \\y in {5,10,15}{\\draw[line width=0.4pt] (0,\\y)--(-0.45,\\y) node[left] {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\y$\\special{dvisvgm:raw </g>}};}\n\\node[below left] at (0,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$0$\\special{dvisvgm:raw </g>}};\n\\draw[line width=0.8pt,domain=0:4.25,samples=90,variable=\\t] plot ({\\t*\\t},{4*\\t});\n\\foreach \\x/\\y in {0/0,1/4,4/8,9/12,16/16}{\\fill (\\x,\\y) circle[radius=1.2pt];}\n\\end{tikzpicture}",
