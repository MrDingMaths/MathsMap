  "content": {
    "id": "p30-q7",
    "type": "question",
    "label": "7",
    "prompt": "A circle has centre $(4,-3)$ and one of the $x$-intercepts is at $(-\\sqrt7+4,0)$.\nDetermine the equation of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-4)^2+(y+3)^2=16$",
      "worked": "$$\\begin{align*}r^2&=(4-\\sqrt7-4)^2+(0+3)^2\\\\&=7+9\\\\&=16\\end{align*}$$\nThe distance between the centre and the intercept is $4$, so the radius is $4$.\n$$(x-4)^2+(y+3)^2=16$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
