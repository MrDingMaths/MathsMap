  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A photograph 129 mm by 90 mm is enlarged to 172 mm by 120 mm.\nWhat is the scale factor?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{4}{3}$",
      "worked": "$$\\begin{align*}\\text{Scale factor}&=\\frac{\\text{Image length}}{\\text{Original length}}\\\\&=\\frac{172}{129}\\\\&=\\frac{4}{3}\\end{align*}$$\nThe other pair gives $\\frac{120}{90}=\\frac{4}{3}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
