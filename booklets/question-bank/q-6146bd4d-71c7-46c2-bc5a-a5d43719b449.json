        "type": "part",
        "label": "a",
        "prompt": "Show that $BC=\\tan\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p5-q101-a-short-result",
                "type": "paragraph",
