                "inlines": [
                  {
                    "type": "text",
                    "text": "Use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\tan\\theta=\\frac{BC}{AB}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " with ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "AB=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\tan\\theta &= \\frac{BC}{AB}\\\\\\tan\\theta &= BC\\qquad(AB=1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q101-b",
        "type": "part",
        "label": "b",
        "prompt": "Prove that $AC=\\sec\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p5-q101-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "AC=\\sec\\theta",
                    "display": false
                  }
                ]
              },
              {
                "id": "p5-q101-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the reciprocal of ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\cos\\theta=\\frac{AB}{AC}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", with ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "AB=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\sec\\theta &= \\frac{1}{\\cos\\theta}\\\\\\sec\\theta &= \\frac{AC}{AB}\\\\\\sec\\theta &= AC\\qquad(AB=1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q101-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, show that $1+\\tan^2\\theta=\\sec^2\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p5-q101-c-short-result",
                "type": "paragraph",
                "fontSize": null,
