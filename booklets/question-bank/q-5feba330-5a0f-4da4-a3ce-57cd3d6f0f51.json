    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q58-a",
        "type": "part",
        "label": "a",
        "prompt": "Let $1=f(0)$. Show that $1=\\{0\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1=\\{0\\}$, since $\\varnothing\\cup\\{0\\}=\\{0\\}$.",
          "worked": "$$\\begin{align*}1&=0\\cup\\{0\\}\\\\1&=\\{\\}\\cup\\{0\\}\\\\1&=\\{0\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q58-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $2=f(1)$. Show that $2=\\{0,1\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2=\\{0,1\\}$, since $\\{0\\}\\cup\\{1\\}=\\{0,1\\}$.",
          "worked": "$$\\begin{align*}2&=1\\cup\\{1\\}\\\\2&=\\{0\\}\\cup\\{1\\}\\\\2&=\\{0,1\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q58-c",
        "type": "part",
        "label": "c",
        "prompt": "Let $3=f(2)$. Show that $3=\\{0,1,2\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3=\\{0,1,2\\}$, since $\\{0,1\\}\\cup\\{2\\}=\\{0,1,2\\}$.",
          "worked": "$$\\begin{align*}3&=2\\cup\\{2\\}\\\\3&=\\{0,1\\}\\cup\\{2\\}\\\\3&=\\{0,1,2\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q58-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the value of $n$ such that $f(n)=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=4=\\{0,1,2,3\\}$.",
          "worked": "$$\\begin{align*}f(4)&=\\{0,1,2,3\\}\\cup\\{4\\}\\\\f(4)&=\\{0,1,2,3,4\\}\\\\f(4)&=5.\\end{align*}$$\n\nTherefore $n=4=\\{0,1,2,3\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q58-e",
        "type": "part",
        "label": "e",
        "prompt": "Explain why there is no value of $n$ such that $f(n)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No such $n$ exists: $n\\cup\\{n\\}$ contains $n$, so it cannot be empty.",
          "worked": "The singleton $\\{n\\}$ contains $n$, so $f(n)=n\\cup\\{n\\}$ contains at least one element.\n\nTherefore $f(n)$ cannot equal $0=\\varnothing$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
