    "id": "p23-q2-response",
    "type": "question",
    "label": "2",
    "prompt": "A parabola has $x$-intercepts of $-2$ and $4$. What is the $x$-coordinate of the vertex?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$",
      "worked": "The vertex lies halfway between the two $x$-intercepts.\n\n$$\\begin{align*}x&=\\frac{-2+4}{2}\\\\x&=1\\end{align*}$$",
      "solutionDiagrams": []
    },
