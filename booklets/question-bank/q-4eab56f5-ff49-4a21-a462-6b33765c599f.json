  "content": {
    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The number of people ($N$) who attend a show varies inversely with the amount of floor space (in $\\mathrm{cm}^2$) allowed per person ($A$). A venue can hold 480 people if each person is allowed $2000\\ \\mathrm{cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "How many people could the venue hold if each person was allowed $2400\\ \\mathrm{cm}^2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "400 people",
          "worked": "$$\\begin{aligned}N&=\\frac{k}{A}\\\\480&=\\frac{k}{2000}\\\\k&=960000\\\\N&=\\frac{960000}{A}\\\\N&=\\frac{960000}{2400}\\\\N&=400\\end{aligned}$$\nThe venue could hold 400 people.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p24-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the space allowed per person to allow 500 to attend the show?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1920\\ \\mathrm{cm}^2$ per person",
          "worked": "$$\\begin{aligned}N&=\\frac{k}{A}\\\\480&=\\frac{k}{2000}\\\\k&=960000\\\\N&=\\frac{960000}{A}\\\\500&=\\frac{960000}{A}\\\\500A&=960000\\\\A&=1920\\end{aligned}$$\nThe space allowed is $1920\\ \\mathrm{cm}^2$ per person.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
