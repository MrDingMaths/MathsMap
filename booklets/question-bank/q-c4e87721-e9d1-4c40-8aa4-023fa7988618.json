  "content": {
    "id": "p47-q4",
    "type": "question",
    "label": "4",
    "prompt": "A telecommunications company’s rates for local calls from private telephones consist of a quarterly rental fee of $\\$40$ plus 25c for every call.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation that describes the total quarterly cost $C$ dollars for $n$ calls.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C = 40 + 0.25n$",
          "worked": "Each call costs $25\\text{c}=\\$0.25$, and the fixed quarterly fee is $\\$40$.\n$$C=40+0.25n.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p47-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "How many calls could you make for $\\$90.50$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "202 calls.",
          "worked": "$$\\begin{align*}90.50&=40+0.25n\\\\50.50&=0.25n\\\\\\frac{50.50}{0.25}&=n\\\\202&=n\\end{align*}$$\nYou could make 202 calls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
