  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The temperature in Daylesford on a very cold winter’s day went from $-2^{\\circ}\\mathrm{C}$ to $9^{\\circ}\\mathrm{C}$. What was the change in temperature?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "An increase of $11^{\\circ}\\mathrm{C}$.",
      "worked": "Change in temperature = final temperature − initial temperature.\n\n$$\\begin{align*}9-(-2)&=9+2\\\\9-(-2)&=11\\end{align*}$$\n\nThe temperature increased by $11^{\\circ}\\mathrm{C}$.",
      "solutionDiagrams": []
    },
