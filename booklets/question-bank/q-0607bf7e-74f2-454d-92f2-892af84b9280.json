  "content": {
    "id": "p51-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Two roots of $x^3-3x^2+kx+12=0$ sum to zero.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the roots.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2,\\ 2,\\ 3$",
          "worked": "Let the roots be $\\alpha,-\\alpha,\\beta$. Using the sum and product of roots,\n$$\\begin{align*}\\alpha-\\alpha+\\beta&=3\\\\\\beta&=3\\\\\\alpha(-\\alpha)(3)&=-12\\\\-3\\alpha^2&=-12\\\\\\alpha^2&=4\\\\\\alpha&=\\pm2.\\end{align*}$$\nThe roots are $-2,2,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      },
      {
        "id": "p51-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-4$",
          "worked": "Using the sum of pairwise products,\n$$\\begin{align*}k&=(-2)(2)+(-2)(3)+(2)(3)\\\\k&=-4-6+6\\\\k&=-4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
