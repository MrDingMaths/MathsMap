    "children": [
      {
        "id": "p58-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the expansion of $(a-b)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-2ab+b^2$",
          "worked": "$$\\begin{align*}(a-b)^2&=a^2-2ab+b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p58-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the expansion in part a to square $\\sqrt{6+\\sqrt{11}}-\\sqrt{6-\\sqrt{11}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$, using $(a-b)^2=a^2-2ab+b^2$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p58-q12-b-substitution",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a=\\sqrt{6+\\sqrt{11}},\\quad b=\\sqrt{6-\\sqrt{11}}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p58-q12-b-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "center",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}(a-b)^2&=(6+\\sqrt{11})-2\\sqrt{6+\\sqrt{11}}\\sqrt{6-\\sqrt{11}}+(6-\\sqrt{11})\\\\(a-b)^2&=12-2\\sqrt{(6+\\sqrt{11})(6-\\sqrt{11})}\\\\(a-b)^2&=12-2\\sqrt{36-11}\\\\(a-b)^2&=12-2\\sqrt{25}\\\\(a-b)^2&=2\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p58-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence evaluate $\\sqrt{6+\\sqrt{11}}-\\sqrt{6-\\sqrt{11}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}$",
          "worked": "Since $\\sqrt{6+\\sqrt{11}}>\\sqrt{6-\\sqrt{11}}$, the difference is positive. From part b,\n$$\\begin{align*}\\left(\\sqrt{6+\\sqrt{11}}-\\sqrt{6-\\sqrt{11}}\\right)^2&=2\\\\\\sqrt{6+\\sqrt{11}}-\\sqrt{6-\\sqrt{11}}&=\\sqrt{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
