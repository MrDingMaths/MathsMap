  "content": {
    "id": "p18-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{12a}{3c^3}\\times\\dfrac{6a^4}{4c^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6a^5}{c^7}$",
          "worked": "$$\\begin{align*}\\frac{12a}{3c^3}\\times\\frac{6a^4}{4c^4}&=\\frac{72a\\cdot a^4}{12c^3c^4}\\\\&=\\frac{72a^5}{12c^7}\\\\&=\\frac{6a^5}{c^7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{24m^7n^5}{5m^3n}\\times\\dfrac{5m^2n^4}{8mn^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3m^5n^6$",
          "worked": "$$\\begin{align*}\\frac{24m^7n^5}{5m^3n}\\times\\frac{5m^2n^4}{8mn^2}&=\\frac{120m^9n^9}{40m^4n^3}\\\\&=\\frac{120m^5n^6}{40}\\\\&=3m^5n^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{p^4q^3}{p^2q}\\div\\dfrac{p^3q^2}{p^6q^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^5q^4$",
          "worked": "$$\\begin{align*}\\frac{p^4q^3}{p^2q}\\div\\frac{p^3q^2}{p^6q^4}&=\\frac{p^4q^3}{p^2q}\\times\\frac{p^6q^4}{p^3q^2}\\\\&=\\frac{p^{10}q^7}{p^5q^3}\\\\&=p^5q^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{8k^4m^5}{5km^3}\\times\\dfrac{15km}{4k}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6k^3m^3$",
          "worked": "$$\\begin{align*}\\frac{8k^4m^5}{5km^3}\\times\\frac{15km}{4k}&=\\frac{120k^5m^6}{20k^2m^3}\\\\&=\\frac{120k^3m^3}{20}\\\\&=6k^3m^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{12x^7y^3}{5x^4y}\\div\\dfrac{8xy^4}{25x^2y^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{15x^4y}{2}$",
          "worked": "$$\\begin{align*}\\frac{12x^7y^3}{5x^4y}\\div\\frac{8xy^4}{25x^2y^3}&=\\frac{12x^7y^3}{5x^4y}\\times\\frac{25x^2y^3}{8xy^4}\\\\&=\\frac{300x^9y^6}{40x^5y^5}\\\\&=\\frac{300x^4y}{40}\\\\&=\\frac{15x^4y}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{9m^5n^2}{12mn}\\times\\dfrac{4mn^3}{m^4n^2}\\div\\dfrac{2m^2n}{m^3n^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3m^2n^3}{2}$",
          "worked": "$$\\begin{align*}\\frac{9m^5n^2}{12mn}\\times\\frac{4mn^3}{m^4n^2}\\div\\frac{2m^2n}{m^3n^2}&=\\frac{9m^5n^2}{12mn}\\times\\frac{4mn^3}{m^4n^2}\\times\\frac{m^3n^2}{2m^2n}\\\\&=\\frac{36m^9n^7}{24m^7n^4}\\\\&=\\frac{36m^2n^3}{24}\\\\&=\\frac{3m^2n^3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
