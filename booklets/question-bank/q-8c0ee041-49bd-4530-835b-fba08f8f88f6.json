  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "",
    "prompt": "An equation of the form $ax^2+bx=0$ will always have two solutions if $a$ and $b$ are not zero.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "By factorising the LHS, explain why one of the solutions will always be $x=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(ax+b)=0$. The factor $x$ is zero when $x=0$, so $x=0$ is always a solution.",
          "worked": "$$\\begin{align*}ax^2+bx&=0\\\\x(ax+b)&=0\\end{align*}$$\nBy the null factor law, $x=0$ or $ax+b=0$. Therefore $x=0$ is always a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "What would the other solution be, in terms of $a$ and $b$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac{b}{a}$.",
          "worked": "$$\\begin{align*}ax+b&=0\\\\ax&=-b\\\\x&=-\\frac{b}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
