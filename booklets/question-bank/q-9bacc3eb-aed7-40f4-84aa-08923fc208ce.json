        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-5$.",
          "worked": "Parallel lines have the same gradient. The gradient of $y=-5x$ is $-5$, so $m=-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
