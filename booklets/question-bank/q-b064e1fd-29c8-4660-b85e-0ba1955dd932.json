  "content": {
    "id": "p39-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Consider the differential equation $\\dfrac{dy}{dx}=3y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the constant solution?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=0$.",
          "worked": "For a constant solution, $y'=0$. Thus $0=3y$, giving $y=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p39-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the DE obtained by taking the reciprocal of both sides.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dx}{dy}=\\dfrac1{3y}$ for $y\\ne0$.",
          "worked": "For $y\\ne0$, taking reciprocals gives $\\dfrac{dx}{dy}=\\dfrac1{3y}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Use direct integration to obtain $x$ as a function of $y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac13\\ln|y|+C$.",
          "worked": "$$\\begin{align*}x&=\\int\\frac1{3y}\\,dy\\\\x&=\\frac13\\ln|y|+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p39-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Make $y$ the subject, simplifying the constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=Ae^{3x}$, where $A\\in\\mathbb R$.",
          "worked": "$$\\begin{align*}x-C&=\\frac13\\ln|y|\\\\\\ln|y|&=3x-3C\\\\|y|&=e^{-3C}e^{3x}\\\\y&=Ae^{3x}.\\end{align*}$$\nThe nonzero solutions have $A=\\pm e^{-3C}$; including the constant solution allows any real $A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p39-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "Check that the constant solution is included in part d.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=0$ gives $y=0$.",
          "worked": "Setting $A=0$ gives $y=0e^{3x}=0$, the constant solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p39-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "Find the solution for $y(0)=-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-e^{3x}$.",
          "worked": "Substitute $y(0)=-1$:\n$$\\begin{align*}-1&=Ae^0\\\\A&=-1\\\\y&=-e^{3x}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
