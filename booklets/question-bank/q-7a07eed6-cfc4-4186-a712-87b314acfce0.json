  "content": {
    "id": "v2-f09f139ae-practice-slot-4-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Find the mode of $f(x)=\\dfrac{3(6x-x^2)}{100}$ defined in the interval $0\\le x\\le5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Mode $=3$.",
      "worked": "This is a concave down parabola, so its turning point is a maximum.\n$$\\begin{align*}f'(x)&=\\frac{3(6-2x)}{100}\\\\0&=\\frac{3(6-2x)}{100}\\\\x&=3\\end{align*}$$\nSince $3\\in[0,5]$, the turning point is in the domain.\n$$f(0)=0,\\qquad f(3)=\\frac{27}{100},\\qquad f(5)=\\frac{15}{100}.$$\nThe maximum occurs at $x=3$, so the mode is $3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
