  "content": {
    "id": "p19-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A salad dressing consists of $\\frac{3}{8}$ vinegar, $\\frac{1}{2}$ oil and $\\frac{1}{8}$ lemon juice by volume. Find the ratio vinegar : oil : lemon juice in simplest form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3:4:1$",
      "worked": "Multiply each term by the lowest common denominator, $8$.\n\n$$\\begin{align*}\\text{vinegar : oil : lemon juice}&=\\frac{3}{8}:\\frac{1}{2}:\\frac{1}{8}\\\\\\text{vinegar : oil : lemon juice}&=3:4:1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
