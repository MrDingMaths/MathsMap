  "content": {
    "id": "p18-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The sum of a number and its reciprocal is $\\frac{25}{12}$. Find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac34$ or $x=\\frac43$.",
      "worked": "Let the number be $x\\ne0$.\n$$\\begin{align*}x+\\frac1x&=\\frac{25}{12}\\\\12x^2+12&=25x\\\\12x^2-25x+12&=0\\\\x&=\\frac{25\\pm\\sqrt{(-25)^2-4(12)(12)}}{2(12)}\\\\x&=\\frac{25\\pm7}{24}\\\\x&=\\frac34\\text{ or }\\frac43\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
