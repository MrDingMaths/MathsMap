      {
        "id": "p57-q9-root",
        "type": "part",
        "label": "a",
        "prompt": "$6x^2-13x-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+1)(2x-5)$.\n\nSplit $-13x$ into $-15x+2x$, then factorise in pairs.",
          "worked": "$$\\begin{align*}6x^2-13x-5&=6x^2-15x+2x-5\\\\6x^2-13x-5&=3x(2x-5)+(2x-5)\\\\6x^2-13x-5&=(3x+1)(2x-5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p57-q10-root",
        "type": "part",
        "label": "b",
        "prompt": "$3xy+6x+2y+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y+2)(3x+2)$",
          "worked": "$$\\begin{align*}3xy+6x+2y+4&=3x(y+2)+2(y+2)\\\\3xy+6x+2y+4&=(y+2)(3x+2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p57-q11-root",
        "type": "part",
        "label": "c",
        "prompt": "$4x^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-3)(2x+3)$",
          "worked": "$$\\begin{align*}4x^2-9&=(2x)^2-3^2\\\\4x^2-9&=(2x-3)(2x+3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p57-q12-root",
        "type": "part",
        "label": "d",
        "prompt": "$ax-2a+3x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+3)(x-2)$",
          "worked": "$$\\begin{align*}ax-2a+3x-6&=a(x-2)+3(x-2)\\\\ax-2a+3x-6&=(a+3)(x-2).\\end{align*}$$",
