  "content": {
    "id": "p9-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "From a ship, a person is spotted floating in the sea at a horizontal distance of $200\\text{ m}$ from the ship. If the viewing position on the ship is $20\\text{ m}$ above sea level, find the angle of depression from the ship to person in the sea. Give your answer to the nearest degree.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6^{\\circ}$",
      "worked": "The angle of depression equals the angle of elevation because the horizontal lines are parallel.\n$$\\begin{align*}\\tan\\theta &= \\frac{20}{200}\\\\\\theta &= \\tan^{-1}\\left(\\frac{20}{200}\\right)\\\\\\theta &\\approx 6^{\\circ}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
