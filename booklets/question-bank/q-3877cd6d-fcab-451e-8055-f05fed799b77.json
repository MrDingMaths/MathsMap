  "content": {
    "id": "v2-11f0f-p40-practice-retro-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "The line $y=4x-5$ touches the parabola $y=x^2+bx+4$ at just one point.\nFind the possible values of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=10$ or $b=-2$",
      "worked": "Set the equations equal.\n$$\\begin{align*}x^2+bx+4&=4x-5\\\\x^2+(b-4)x+9&=0\\end{align*}$$\nOne point of intersection gives $\\Delta=0$.\n$$\\begin{align*}(b-4)^2-4(1)(9)&=0\\\\(b-4)^2&=36\\\\b-4&=\\pm6\\\\b&=10\\text{ or }-2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
  },
