  "content": {
    "id": "p26-q17-root",
    "type": "question",
    "label": "17",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p26-q17-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "In each case, factor the quadratic to find the ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x",
              "display": false
            },
            {
              "type": "text",
              "text": "-intercepts. Hence find the equation of the axis of symmetry.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+2x+1-p^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+1-p)(x+1+p)$.\n\n$x$-intercepts: $(-1+p,0)$ and $(-1-p,0)$. Axis: $x=-1$.",
          "worked": "$$\\begin{align*}y&=(x+1)^2-p^2\\\\y&=(x+1-p)(x+1+p)\\end{align*}$$\nAt the $x$-intercepts, $y=0$, so\n$$\\begin{align*}x+1-p&=0\\quad\\text{or}\\\\x+1+p&=0\\\\x&=-1+p\\quad\\text{or}\\quad -1-p.\\end{align*}$$\nThe axis lies midway between the zeroes:\n$$\\begin{align*}x&=\\frac{(-1+p)+(-1-p)}{2}\\\\x&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p26-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2-2px-1+p^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-p-1)(x-p+1)$.\n\n$x$-intercepts: $(p-1,0)$ and $(p+1,0)$. Axis: $x=p$.",
          "worked": "$$\\begin{align*}y&=(x-p)^2-1\\\\y&=(x-p-1)(x-p+1)\\end{align*}$$\nAt the $x$-intercepts, $y=0$, so\n$$\\begin{align*}x-p-1&=0\\quad\\text{or}\\\\x-p+1&=0\\\\x&=p+1\\quad\\text{or}\\quad p-1.\\end{align*}$$\nThe axis lies midway between the zeroes:\n$$\\begin{align*}x&=\\frac{(p-1)+(p+1)}{2}\\\\x&=p.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p26-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2-2x-2p-p^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-p-2)(x+p)$.\n\n$x$-intercepts: $(p+2,0)$ and $(-p,0)$. Axis: $x=1$.",
          "worked": "$$\\begin{align*}y&=(x-1)^2-(p+1)^2\\\\y&=(x-1-p-1)(x-1+p+1)\\\\y&=(x-p-2)(x+p)\\end{align*}$$\nAt the $x$-intercepts, $y=0$, so\n$$\\begin{align*}x-p-2&=0\\quad\\text{or}\\\\x+p&=0\\\\x&=p+2\\quad\\text{or}\\quad -p.\\end{align*}$$\nThe axis lies midway between the zeroes:\n$$\\begin{align*}x&=\\frac{(p+2)+(-p)}{2}\\\\x&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      }
    ]
  },
