  "content": {
    "id": "p24-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Fill in the missing numbers to complete these equivalent fractions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{3}=\\dfrac{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}{6}=\\dfrac{4}{\\boxed{\\rule{0pt}{4mm}\\hspace{6mm}}}=\\dfrac{\\boxed{\\rule{0pt}{4mm}\\hspace{6mm}}}{30}=\\dfrac{\\boxed{\\rule{0pt}{4mm}\\hspace{6mm}}}{60}=\\dfrac{100}{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2,\\ 12,\\ 10,\\ 20,\\ 300$.",
          "worked": "$$\\begin{align*}\\frac{1}{3}&=\\frac{1\\times2}{3\\times2}=\\frac{2}{6}\\\\\\frac{1}{3}&=\\frac{1\\times4}{3\\times4}=\\frac{4}{12}\\\\\\frac{1}{3}&=\\frac{1\\times10}{3\\times10}=\\frac{10}{30}\\\\\\frac{1}{3}&=\\frac{1\\times20}{3\\times20}=\\frac{20}{60}\\\\\\frac{1}{3}&=\\frac{1\\times100}{3\\times100}=\\frac{100}{300}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p24-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2}{8}=\\dfrac{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}{4}=\\dfrac{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}{12}=\\dfrac{6}{\\boxed{\\rule{0pt}{4mm}\\hspace{6mm}}}=\\dfrac{\\boxed{\\rule{0pt}{4mm}\\hspace{6mm}}}{80}=\\dfrac{10}{\\boxed{\\rule{0pt}{4mm}\\hspace{6mm}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\ 3,\\ 24,\\ 20,\\ 40$.",
          "worked": "$$\\begin{align*}\\frac{2}{8}&=\\frac{2\\div2}{8\\div2}=\\frac{1}{4}\\\\\\frac{1}{4}&=\\frac{1\\times3}{4\\times3}=\\frac{3}{12}\\\\\\frac{2}{8}&=\\frac{2\\times3}{8\\times3}=\\frac{6}{24}\\\\\\frac{2}{8}&=\\frac{2\\times10}{8\\times10}=\\frac{20}{80}\\\\\\frac{2}{8}&=\\frac{2\\times5}{8\\times5}=\\frac{10}{40}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
  },
