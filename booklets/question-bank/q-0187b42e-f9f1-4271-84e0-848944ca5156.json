  "content": {
    "id": "p63-q19-root",
    "type": "question",
    "label": null,
    "prompt": "The quadrilateral $OABC$ has vertices $O(0,0)$, $A(5,-3)$, $B(7,4)$ and $C(2,7)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p63-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\overrightarrow{OA}+\\frac12\\overrightarrow{AC}=\\frac12\\overrightarrow{OB}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{OA}+\\frac12\\overrightarrow{AC}=\\begin{pmatrix}\\frac72\\\\2\\end{pmatrix}=\\frac12\\overrightarrow{OB}$.",
          "worked": "$$\\begin{align*}\\overrightarrow{AC}&=\\overrightarrow{OC}-\\overrightarrow{OA}\\\\&=\\begin{pmatrix}2-5\\\\7-(-3)\\end{pmatrix}\\\\&=\\begin{pmatrix}-3\\\\10\\end{pmatrix}\\\\\\frac12\\overrightarrow{AC}&=\\begin{pmatrix}-\\frac32\\\\5\\end{pmatrix}\\end{align*}$$\n$$\\begin{align*}\\overrightarrow{OA}+\\frac12\\overrightarrow{AC}&=\\begin{pmatrix}5\\\\-3\\end{pmatrix}+\\begin{pmatrix}-\\frac32\\\\5\\end{pmatrix}\\\\&=\\begin{pmatrix}\\frac72\\\\2\\end{pmatrix}\\end{align*}$$\n$$\\begin{align*}\\overrightarrow{OB}&=\\begin{pmatrix}7\\\\4\\end{pmatrix}\\\\\\frac12\\overrightarrow{OB}&=\\begin{pmatrix}\\frac72\\\\2\\end{pmatrix}\\end{align*}$$\nHence, $\\overrightarrow{OA}+\\frac12\\overrightarrow{AC}=\\frac12\\overrightarrow{OB}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p63-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "What type of special quadrilateral is $OABC$? Give a reason for your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A parallelogram, because its diagonals bisect each other.",
          "worked": "$\\overrightarrow{OA}+\\frac12\\overrightarrow{AC}$ is the position vector of the midpoint of diagonal $AC$.\n$\\frac12\\overrightarrow{OB}$ is the position vector of the midpoint of diagonal $OB$.\nPart a shows these position vectors are equal, so the diagonals have the same midpoint. Therefore, $OABC$ is a parallelogram because its diagonals bisect each other.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
