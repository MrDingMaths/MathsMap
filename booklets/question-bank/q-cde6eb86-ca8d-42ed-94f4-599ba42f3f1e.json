  "content": {
    "id": "p41-q3-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the function $g(x)=2-x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $g(g(0))$, $g(g(4))$, $g(g(-2))$ and $g(g(-9))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(g(0))=0$, $g(g(4))=4$, $g(g(-2))=-2$, $g(g(-9))=-9$.",
          "worked": "$$\\begin{align*}g(g(0))&=g(2)=2-2\\\\g(g(0))&=0\\\\g(g(4))&=g(-2)=2-(-2)\\\\g(g(4))&=4\\\\g(g(-2))&=g(4)=2-4\\\\g(g(-2))&=-2\\\\g(g(-9))&=g(11)=2-11\\\\g(g(-9))&=-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p41-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $g(g(x))=x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(g(x))=2-(2-x)=x$.",
          "worked": "$$\\begin{align*}g(g(x))&=2-(2-x)\\\\g(g(x))&=2-2+x\\\\g(g(x))&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p41-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $g(g(g(x)))=g(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(g(g(x)))=g(x)$.",
          "worked": "Using $g(g(x))=x$ from part b,\n$$\\begin{align*}g(g(g(x)))&=g(x)\\\\g(g(g(x)))&=2-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
