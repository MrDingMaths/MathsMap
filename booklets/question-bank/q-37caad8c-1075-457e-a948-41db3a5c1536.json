  "content": {
    "id": "p18-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "I start with a number, multiply it by 5 and add 7 and I end up with 28. What was the number I started with?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\frac15$.",
      "worked": "Let $x$ be the starting number.\n\n$$\\begin{align*}5x+7&=28\\\\5x&=21\\\\x&=\\frac{21}{5}\\\\x&=4\\frac15\\end{align*}$$\n\nCheck: $5\\times\\frac{21}{5}+7=28$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
