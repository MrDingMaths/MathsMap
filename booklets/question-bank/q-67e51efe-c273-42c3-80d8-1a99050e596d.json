  "content": {
    "id": "p17-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The King takes a chessboard of 64 squares, and places 1 grain of wheat on the first square, 2 grains on the next square, 4 grains on the next square, and so on.\n\nHow many grains are on:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "the last square? Answer using scientific notation to 2 significant figures.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9.2\\times10^{18}$ grains",
          "worked": "$a=1$, $r=2$, $n=64$.\n\n$$\\begin{align*}a_{64}&=ar^{63}\\\\a_{64}&=1(2^{63})\\\\a_{64}&=2^{63}\\\\a_{64}&\\approx9.2\\times10^{18}\\end{align*}$$\n\nThere are approximately $9.2\\times10^{18}$ grains on the last square, to 2 significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The whole chessboard? Answer in index form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{64}-1$ grains",
          "worked": "$a=1$, $r=2$, $n=64$.\n\n$$\\begin{align*}S_{64}&=\\frac{a(r^{64}-1)}{r-1}\\\\S_{64}&=\\frac{1(2^{64}-1)}{2-1}\\\\S_{64}&=2^{64}-1\\end{align*}$$\n\nThere are $2^{64}-1$ grains on the whole chessboard.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
