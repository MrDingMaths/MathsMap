      {
        "id": "p19-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "How many possible hands are there?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\,598\\,960$",
          "worked": "Order does not matter in a hand.\n\n$$\\begin{align*}N&=\\binom{52}{5}\\\\N&=2\\,598\\,960.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "How many hands contain the ace of spades?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$249\\,900$",
          "worked": "The ace of spades is fixed. Choose the other four cards from the remaining fifty-one.\n\n$$\\begin{align*}N&=\\binom{51}{4}\\\\N&=249\\,900.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "How many hands contain exactly two aces?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$103\\,776$",
          "worked": "Choose two of the four aces and three of the forty-eight non-aces.\n\n$$\\begin{align*}N&=\\binom{4}{2}\\binom{48}{3}\\\\N&=6\\times17\\,296\\\\N&=103\\,776.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "How many hands contain exactly two clubs?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$712\\,842$",
          "worked": "Choose two of the thirteen clubs and three of the thirty-nine non-clubs.\n\n$$\\begin{align*}N&=\\binom{13}{2}\\binom{39}{3}\\\\N&=78\\times9139\\\\N&=712\\,842.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "How many hands contain only hearts?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1287$",
          "worked": "All five cards must come from the thirteen hearts.\n\n$$\\begin{align*}N&=\\binom{13}{5}\\\\N&=1287.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
