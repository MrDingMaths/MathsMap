  "content": {
    "id": "p6-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Write a fraction that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "is closer to $1$ than $\\frac{7}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{15}{16}$.",
          "worked": "$$\\begin{align*}1-\\frac{7}{8}&=\\frac{1}{8}\\\\1-\\frac{15}{16}&=\\frac{1}{16}\\end{align*}$$\nSince $\\frac{1}{16}<\\frac{1}{8}$, $\\frac{15}{16}$ is closer to $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "is between $\\frac{1}{3}$ and $\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{1}{2}$.",
          "worked": "$$\\frac{1}{3}=\\frac{2}{6},\\qquad \\frac{1}{2}=\\frac{3}{6},\\qquad \\frac{2}{3}=\\frac{4}{6}.$$\nThus $\\frac{1}{3}<\\frac{1}{2}<\\frac{2}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p6-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "is equivalent to $\\frac{1}{2}$, but has a denominator greater than $50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{26}{52}$.",
          "worked": "$$\\frac{1}{2}=\\frac{1\\times26}{2\\times26}=\\frac{26}{52}.$$\nThe denominator $52$ is greater than $50$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p6-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "is between $4$ and $5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{9}{2}$.",
          "worked": "$$4=\\frac{8}{2}<\\frac{9}{2}<\\frac{10}{2}=5.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p6-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "is larger than $\\frac{4}{7}$ but smaller than $\\frac{8}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{2}{3}$.",
          "worked": "$$\\frac{4}{7}=\\frac{36}{63},\\qquad \\frac{2}{3}=\\frac{42}{63},\\qquad \\frac{8}{9}=\\frac{56}{63}.$$\nSince $36<42<56$, $\\frac{4}{7}<\\frac{2}{3}<\\frac{8}{9}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "is larger than $2$ but closer to $2$ than $1\\frac{11}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{49}{24}$.\n\nIts distance from $2$ is $\\frac{1}{24}$, less than $\\frac{1}{12}$.",
          "worked": "$$\\begin{align*}2-1\\frac{11}{12}&=\\frac{24}{12}-\\frac{23}{12}\\\\2-1\\frac{11}{12}&=\\frac{1}{12}\\\\\\frac{49}{24}-2&=\\frac{49}{24}-\\frac{48}{24}\\\\\\frac{49}{24}-2&=\\frac{1}{24}\\end{align*}$$\nSince $\\frac{49}{24}>2$ and $\\frac{1}{24}<\\frac{1}{12}$, this fraction satisfies both conditions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
