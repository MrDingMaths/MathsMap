  "content": {
    "id": "p19-q21-response",
    "type": "question",
    "label": "21",
    "prompt": "Solve $\\log_2(6-x)-\\log_2(4-x)=2$, when $x<4$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac{10}{3}$\n\nUse the quotient law, convert to exponential form and check the original domain.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p19-q21-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\log_2\\left(\\frac{6-x}{4-x}\\right)&=2\\\\\\frac{6-x}{4-x}&=4\\\\6-x&=4(4-x)\\\\6-x&=16-4x\\\\3x&=10\\\\x&=\\frac{10}{3}\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p19-q21-check",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\frac{10}{3}<4",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ", so both logarithm arguments are positive and the solution is valid.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
