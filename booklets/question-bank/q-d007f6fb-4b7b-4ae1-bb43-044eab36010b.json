  "content": {
    "id": "p16-q39-response",
    "type": "question",
    "label": "39",
    "prompt": "Simplify the following.\n$$\\frac{m+1}{m^2-m}-\\frac{2}{m-1}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\dfrac1m$, $m\\in\\mathbb R\\setminus\\{0,1\\}$.",
      "worked": "$$\\begin{align*}\\frac{m+1}{m^2-m}-\\frac{2}{m-1}&=\\frac{m+1-2m}{m(m-1)}\\\\\\frac{m+1}{m^2-m}-\\frac{2}{m-1}&=\\frac{-(m-1)}{m(m-1)}\\\\\\frac{m+1}{m^2-m}-\\frac{2}{m-1}&=-\\frac1m\\end{align*}$$\nOriginal domain: $m\\in\\mathbb R\\setminus\\{0,1\\}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
