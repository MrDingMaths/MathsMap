    "questionDiagrams": [
      {
        "id": "p12-q1-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"rectangleBlue\",\"hex\":\"268CFF\",\"reason\":\"supplied quadrilateral plotted on coordinate axes\"}],\"reference\":\"source page 12 p12-q1-diagram\"}\n\\begin{tikzpicture}[x=0.48cm,y=0.48cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{gridBorder}{HTML}{CCCCCC}\n\\definecolor{rectangleBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-5.3,-4.3) rectangle (6.5,8.5);\n\\draw[step=1,gridBorder,line width=0.25pt] (-5,-4) grid (6,8);\n\\draw[<->,black,line width=0.5pt] (-5,0)--(6,0) node[below left] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-4)--(0,8) node[above left] {$y$};\n\\foreach \\v in {-4,-3,-2,-1,1,2,3,4,5}{\\draw[black,line width=0.4pt] (\\v,0.10)--(\\v,-0.10);\\node[below,inner sep=2pt] at (\\v,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\v$\\special{dvisvgm:raw </g>}};}\n\\foreach \\v in {-3,-2,-1,1,2,3,4,5,6,7}{\\draw[black,line width=0.4pt] (0.10,\\v)--(-0.10,\\v);\\node[left,inner sep=2pt] at (0,\\v) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\v$\\special{dvisvgm:raw </g>}};}\n\\node[below left,inner sep=2pt] at (0,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$0$\\special{dvisvgm:raw </g>}};\n\\coordinate (A) at (-3,0);\\coordinate (B) at (1,6);\\coordinate (C) at (4,4);\\coordinate (D) at (0,-2);\n\\draw[rectangleBlue,line width=0.8pt] (A)--(B)--(C)--(D)--cycle;\n\\foreach \\p in {A,B,C,D}{\\fill[rectangleBlue] (\\p) circle (1.5pt);}\n\\node[above left,black] at (A) {$A$};\\node[above left,black] at (B) {$B$};\\node[above right,black] at (C) {$C$};\\node[below right,black] at (D) {$D$};\n\\end{tikzpicture}",
