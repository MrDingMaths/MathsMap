      {
        "id": "p12-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the lengths of $AC$ and $BD$ and show that the diagonals are equal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AC=BD=\\sqrt{65}$; the diagonals are equal.",
          "worked": "$$\\begin{align*}AC&=\\sqrt{(4-(-3))^2+(4-0)^2}=\\sqrt{65}\\\\BD&=\\sqrt{(0-1)^2+(-2-6)^2}=\\sqrt{65}\\end{align*}$$\nThe diagonals are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the midpoints of the diagonals $AC$ and $BD$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both midpoints are $\\left(\\frac12,2\\right)$.",
          "worked": "$$\\begin{align*}M_{AC}&=\\left(\\frac{-3+4}{2},\\frac{0+4}{2}\\right)=\\left(\\frac12,2\\right)\\\\M_{BD}&=\\left(\\frac{1+0}{2},\\frac{6+(-2)}{2}\\right)=\\left(\\frac12,2\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "What property of rectangles have you shown?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The diagonals of a rectangle are equal and bisect each other.",
          "worked": "The diagonals have equal lengths and the same midpoint, so they are equal and bisect each other.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
