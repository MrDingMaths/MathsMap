    "type": "question",
    "label": "10",
    "prompt": "Large crates of soft drinks each contain 56 bottles. It is decided that these are too heavy, so 8 bottles are removed from each crate. How many bottles are there in 15 of the lighter crates?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$720$ bottles",
      "worked": "$$\\begin{align*}(56-8)\\times15&=48\\times15\\\\(56-8)\\times15&=720\\end{align*}$$\nThere are 720 bottles.",
      "solutionDiagrams": []
    },
