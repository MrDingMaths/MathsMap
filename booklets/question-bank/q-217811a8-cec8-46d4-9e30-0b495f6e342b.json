        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{169}$",
          "worked": "There are 12 face cards. Replacement leaves 12 face cards available for the second draw.\n\n$$\\begin{align*}P(\\text{both face cards})&=\\frac{12}{52}\\times\\frac{12}{52}\\\\P(\\text{both face cards})&=\\frac{9}{169}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p24-q10-e",
