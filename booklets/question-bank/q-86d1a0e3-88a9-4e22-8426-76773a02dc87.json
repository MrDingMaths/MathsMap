    "children": [],
    "answer": {
      "short": "$x=\\pm3$.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2-27\\\\3x^2-27&=0\\\\x^2&=9\\\\x&=\\pm3\\end{align*}$$",
