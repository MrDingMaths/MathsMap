  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "I roll a fair 6-sided die. What is the probability of scoring a 5?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "There is one favourable outcome among six equally likely outcomes.\n$$P(5)=\\frac{1}{6}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "I flip a fair coin. What is the probability of getting Tails?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Tails is one of two equally likely outcomes.\n$$P(\\text{Tails})=\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "I do both of the above. What is the probability of getting both a 5 and Tails?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{12}$",
          "worked": "The die roll and coin flip are independent.\n$$\\begin{align*}P(5\\text{ and Tails})&=P(5)\\times P(\\text{Tails})\\\\&=\\frac{1}{6}\\times\\frac{1}{2}\\\\&=\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
