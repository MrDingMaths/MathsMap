  "content": {
    "id": "p23-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The graph of $y=x^4$ undergoes each of the given transformations. In each case, find the equation of the resulting quartic.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "A translation by 1 unit up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^4+1$",
          "worked": "Add 1 to the function value:\n$$y=x^4+1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "A translation by 2 units to the left.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+2)^4$",
          "worked": "Replace $x$ by $x+2$:\n$$y=(x+2)^4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "A translation by 3 units to the right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-3)^4$",
          "worked": "Replace $x$ by $x-3$:\n$$y=(x-3)^4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "A translation by 4 units down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^4-4$",
          "worked": "Subtract 4 from the function value:\n$$y=x^4-4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "A reflection in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^4$",
          "worked": "Negate the function value:\n$$y=-x^4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "A dilation by a factor of 2 from the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x^4$",
          "worked": "Multiply the function value by 2:\n$$y=2x^4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "A dilation by a factor of $\\frac13$ from the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac13x^4$",
          "worked": "Multiply the function value by $\\frac13$:\n$$y=\\frac13x^4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
