      {
        "id": "p51-q4-explanation",
        "type": "part",
        "label": "g",
        "prompt": "Explain why the rule “multiply by the numerator and keep the denominator the same” works when multiplying a whole number and a fraction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Multiplication by a whole number is repeated addition. Adding equal fractions adds their numerators while keeping the denominator the same.",
          "worked": "Multiplication by a whole number is repeated addition of the same fraction, so the denominator stays the same and the numerator is multiplied by the whole number. Writing the whole number over 1 also gives\n$$\\begin{align*}n\\times\\frac{a}{b}&=\\frac{n}{1}\\times\\frac{a}{b}\\\\&=\\frac{n\\times a}{1\\times b}\\\\&=\\frac{na}{b}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
