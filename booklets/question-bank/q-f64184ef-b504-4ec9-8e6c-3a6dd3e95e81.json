            "answer": {
              "short": "$\\frac{5}{2}$",
              "worked": "$$\\begin{align*}\\frac{1}{2}\\times5&=\\frac{1}{2}\\times\\frac{5}{1}\\\\&=\\frac{1\\times5}{2\\times1}\\\\&=\\frac{5}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p51-q4-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\frac{2}{3}\\times24$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$16$",
              "worked": "$$\\begin{align*}\\frac{2}{3}\\times24&=\\frac{2}{3}\\times\\frac{24}{1}\\\\&=\\frac{2\\times24}{3\\times1}\\\\&=\\frac{48}{3}\\\\&=16\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p51-q4-c",
            "type": "part",
            "label": "c",
            "prompt": "$25\\times\\frac{3}{5}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$15$",
              "worked": "$$\\begin{align*}25\\times\\frac{3}{5}&=\\frac{25}{1}\\times\\frac{3}{5}\\\\&=\\frac{25\\times3}{1\\times5}\\\\&=\\frac{75}{5}\\\\&=15\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p51-q4-d",
            "type": "part",
            "label": "d",
            "prompt": "$\\frac{2}{7}$ of $42$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12$",
              "worked": "$$\\begin{align*}\\frac{2}{7}\\text{ of }42&=\\frac{2}{7}\\times\\frac{42}{1}\\\\&=\\frac{2\\times42}{7\\times1}\\\\&=\\frac{84}{7}\\\\&=12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p51-q4-e",
            "type": "part",
            "label": "e",
            "prompt": "$\\frac{1}{4}$ of $16$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$$\\begin{align*}\\frac{1}{4}\\text{ of }16&=\\frac{1}{4}\\times\\frac{16}{1}\\\\&=\\frac{1\\times16}{4\\times1}\\\\&=\\frac{16}{4}\\\\&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p51-q4-f",
            "type": "part",
            "label": "f",
