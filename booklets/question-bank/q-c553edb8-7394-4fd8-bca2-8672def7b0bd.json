  "content": {
    "id": "p23-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q1a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p23-q1a-stem",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "A truck uses 9 L of fuel per 100 km.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "How many litres are needed for the truck to travel 28 km?",
                  "marks": []
                }
              ]
            },
            {
              "id": "p23-q1a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{9\\text{ L}}{100\\text{ km}}=\\frac{x\\text{ L}}{28\\text{ km}}",
                  "display": true,
                  "colour": "#268cff"
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.52\\text{ L}$",
          "worked": "$$\\begin{align*}\\frac{9\\text{ L}}{100\\text{ km}}&=\\frac{x\\text{ L}}{28\\text{ km}}\\\\\\frac{9}{100}\\times28\\text{ L}&=x\\text{ L}\\\\2.52\\text{ L}&=x\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p23-q1b",
        "type": "part",
        "label": "b",
        "prompt": "Perfume costs $\\$157.90$ for 50 mL.\nHow much does it cost for 80 mL?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$252.64$",
          "worked": "$$\\begin{align*}\\frac{\\$157.90}{50\\text{ mL}}&=\\frac{\\$x}{80\\text{ mL}}\\\\\\frac{157.90}{50}\\times80&=x\\\\252.64&=x\\end{align*}$$\nThe cost is $\\$252.64$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-q1c",
        "type": "part",
        "label": "c",
        "prompt": "Phillipa types at 75 words per minute.\nHow long would it take her to type a 500-word essay?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.\\dot{6}\\text{ min}$",
          "worked": "$$\\begin{align*}\\frac{75\\text{ words}}{1\\text{ min}}&=\\frac{500\\text{ words}}{x\\text{ min}}\\end{align*}$$\nTake reciprocals of both sides.\n$$\\begin{align*}\\frac{1\\text{ min}}{75\\text{ words}}&=\\frac{x\\text{ min}}{500\\text{ words}}\\\\\\frac{1}{75}\\times500\\text{ min}&=x\\text{ min}\\\\\\frac{20}{3}\\text{ min}&=x\\text{ min}\\\\6.\\dot{6}\\text{ min}&=x\\text{ min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p23-q1d",
        "type": "part",
        "label": "d",
        "prompt": "2 litres of paint cover $9\\text{ m}^2$.\nHow much paint is needed for $104\\text{ m}^2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23.\\dot{1}\\text{ L}$",
          "worked": "$$\\begin{align*}\\frac{2\\text{ L}}{9\\text{ m}^2}&=\\frac{x\\text{ L}}{104\\text{ m}^2}\\\\\\frac{2}{9}\\times104\\text{ L}&=x\\text{ L}\\\\\\frac{208}{9}\\text{ L}&=x\\text{ L}\\\\23.\\dot{1}\\text{ L}&=x\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-q1e",
        "type": "part",
        "label": "e",
        "prompt": "A tap is dripping at a rate of 200 mL every 5 minutes.\nHow much water drips in 13 minutes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$520\\text{ mL}$",
          "worked": "$$\\begin{align*}\\frac{200\\text{ mL}}{5\\text{ min}}&=\\frac{x\\text{ mL}}{13\\text{ min}}\\\\\\frac{200}{5}\\times13\\text{ mL}&=x\\text{ mL}\\\\520\\text{ mL}&=x\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-q1f",
        "type": "part",
        "label": "f",
        "prompt": "A snail travelling at a constant speed travels 400 mm in 8 minutes. How far does it travel in 7 minutes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$350\\text{ mm}$",
          "worked": "$$\\begin{align*}\\frac{400\\text{ mm}}{8\\text{ min}}&=\\frac{x\\text{ mm}}{7\\text{ min}}\\\\\\frac{400}{8}\\times7\\text{ mm}&=x\\text{ mm}\\\\350\\text{ mm}&=x\\text{ mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-q1g",
        "type": "part",
        "label": "g",
        "prompt": "A footballer scores an average of 4 goals every 6 games.\nHow many games would it take for him to score 20 goals?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\text{ games}$",
          "worked": "$$\\begin{align*}\\frac{4\\text{ goals}}{6\\text{ games}}&=\\frac{20\\text{ goals}}{x\\text{ games}}\\end{align*}$$\nTake reciprocals of both sides.\n$$\\begin{align*}\\frac{6\\text{ games}}{4\\text{ goals}}&=\\frac{x\\text{ games}}{20\\text{ goals}}\\\\\\frac{6}{4}\\times20\\text{ games}&=x\\text{ games}\\\\30\\text{ games}&=x\\text{ games}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p23-q1h",
        "type": "part",
        "label": "h",
        "prompt": "A computer can process 500 megabytes of information in 4 seconds.\nHow long would it take to process 3700 megabytes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$29.6\\text{ s}$",
          "worked": "$$\\begin{align*}\\frac{500\\text{ MB}}{4\\text{ s}}&=\\frac{3700\\text{ MB}}{x\\text{ s}}\\end{align*}$$\nTake reciprocals of both sides.\n$$\\begin{align*}\\frac{4\\text{ s}}{500\\text{ MB}}&=\\frac{x\\text{ s}}{3700\\text{ MB}}\\\\\\frac{4}{500}\\times3700\\text{ s}&=x\\text{ s}\\\\29.6\\text{ s}&=x\\text{ s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
