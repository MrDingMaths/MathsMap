    "type": "question",
    "label": "11",
    "prompt": "A certain type of material for curtains costs $\\$x$ a metre. How much would $1\\frac{4}{5}\\text{ m}$ cost?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$\\frac{9x}{5}$",
      "worked": "Cost equals length multiplied by the cost per metre.\n$$\\begin{align*}\\text{Cost}&=1\\frac{4}{5}\\times x\\\\\\text{Cost}&=\\frac{9}{5}\\times x\\\\\\text{Cost}&=\\frac{9x}{5}\\text{ dollars}.\\end{align*}$$",
