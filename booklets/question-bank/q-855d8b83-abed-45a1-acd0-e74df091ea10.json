  "content": {
    "id": "p5-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The Red Pyramid in Egypt is the third tallest pyramid ever built.\n\nIt has a square base with a side length of 220 m and a perpendicular height of 104 m.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p5-q5-a-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What is the area of the square base? ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$48\\,400\\,\\mathrm{m}^{2}$",
                  "width": 33
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\,400\\,\\mathrm{m}^{2}$",
          "worked": "$\\begin{aligned}A&=220^{2}\\\\A&=48\\,400\\,\\mathrm{m}^{2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine the volume of the Red Pyramid. Answer to the nearest cubic metre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,677\\,867\\,\\mathrm{m}^{3}$",
          "worked": "$\\begin{aligned}V&=\\frac13Ah\\\\V&=\\frac13\\times48\\,400\\times104\\\\V&=\\frac{5\\,033\\,600}{3}\\,\\mathrm{m}^{3}\\\\V&\\approx1\\,677\\,867\\,\\mathrm{m}^{3}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
