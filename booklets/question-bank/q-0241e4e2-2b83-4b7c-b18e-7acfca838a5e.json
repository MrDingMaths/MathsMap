  "content": {
    "id": "p16-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "By examining the discriminant, state the number of distinct real solutions and, for any real roots, whether they are rational or irrational. Assume that the coefficients of the quadratic are integers.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q4a",
        "type": "part",
        "label": "a",
        "prompt": "$9x^2-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two distinct rational roots.",
          "worked": "$$\\begin{align*}\\Delta&=0^2-4(9)(-4)\\\\\\Delta&=144\\end{align*}$$\n$144$ is a positive perfect square, so there are two distinct rational roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q4b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+3x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two distinct rational roots.",
          "worked": "$$\\begin{align*}\\Delta&=3^2-4(1)(2)\\\\\\Delta&=1\\end{align*}$$\n$1$ is a positive perfect square, so there are two distinct rational roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q4c",
        "type": "part",
        "label": "c",
        "prompt": "$-2x^2+5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two distinct irrational roots.",
          "worked": "$$\\begin{align*}\\Delta&=5^2-4(-2)(2)\\\\\\Delta&=41\\end{align*}$$\n$41$ is positive and is not a perfect square, so there are two distinct irrational roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q4d",
        "type": "part",
        "label": "d",
        "prompt": "$-4x^2+20x-25=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "One distinct rational root.",
          "worked": "$$\\begin{align*}\\Delta&=20^2-4(-4)(-25)\\\\\\Delta&=0\\end{align*}$$\nThe two values in the quadratic formula coincide at the rational root $x=-\\frac{b}{2a}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q4e",
        "type": "part",
        "label": "e",
        "prompt": "$3x^2+4x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real roots.",
          "worked": "$$\\begin{align*}\\Delta&=4^2-4(3)(2)\\\\\\Delta&=-8\\end{align*}$$\nSince $\\Delta<0$, there are no real roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p16-q4f",
        "type": "part",
        "label": "f",
        "prompt": "$25x^2-20x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "One distinct rational root.",
          "worked": "$$\\begin{align*}\\Delta&=(-20)^2-4(25)(4)\\\\\\Delta&=0\\end{align*}$$\nThe two values in the quadratic formula coincide at the rational root $x=-\\frac{b}{2a}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
