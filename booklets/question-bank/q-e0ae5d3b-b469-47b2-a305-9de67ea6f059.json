  "content": {
    "id": "p57-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A shop buys printers for \\$80 and sells them for \\$95.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "How much profit does the shop make for each printer?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$15",
          "worked": "$$\\begin{align*}\\text{Profit}&=95-80\\\\&=15\\end{align*}$$\nProfit for each printer: \\$15.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p57-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage profit does the shop make for each printer?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "18.75% profit",
          "worked": "$$\\begin{align*}\\text{Percentage profit}&=\\frac{15}{80}\\times100\\\\&=18.75\\%\\end{align*}$$\nPercentage profit for each printer: 18.75%.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
