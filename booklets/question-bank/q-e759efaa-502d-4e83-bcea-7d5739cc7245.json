  "content": {
    "id": "p39-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A plane is flying at a speed of $840\\text{ km/h}$. How far will it travel between 10:30 a.m. and 11:15 a.m.?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$630\\text{ km}$",
      "worked": "The elapsed time from 10:30 a.m. to 11:15 a.m. is 45 minutes.\n\n$$\\begin{align*}\\text{Time}&=\\frac{45}{60}\\text{ h}\\\\\\text{Time}&=\\frac34\\text{ h}\\\\\\text{Distance}&=\\text{speed}\\times\\text{time}\\\\\\text{Distance}&=840\\times\\frac34\\text{ km}\\\\\\text{Distance}&=630\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
