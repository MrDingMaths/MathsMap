  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the equation of the final curve in the form $y=f(ax+b)$ if $y=f(x)$ is",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q7a",
        "type": "part",
        "label": "a",
        "prompt": "squashed horizontally by a factor of 2, then translated left by 1 unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=f(2x+2)$",
          "worked": "Squash horizontally by a factor of 2.\n\n$$y=f(2x)$$\n\nReplace $x$ with $x+1$ to translate left by 1 unit.\n\n$$\\begin{align*}y&=f\\bigl(2(x+1)\\bigr)\\\\y&=f(2x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q7b",
        "type": "part",
        "label": "b",
        "prompt": "stretched horizontally by a factor of 3, then translated right by 6 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=f\\left(\\frac{1}{3}x-2\\right)$",
          "worked": "Stretch horizontally by a factor of 3.\n\n$$y=f\\left(\\frac{x}{3}\\right)$$\n\nReplace $x$ with $x-6$ to translate right by 6 units.\n\n$$\\begin{align*}y&=f\\left(\\frac{x-6}{3}\\right)\\\\y&=f\\left(\\frac{1}{3}x-2\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
