  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Mila and Sophie each have the same number of computer games ($x$ computer games each). Rachel, who doesn’t have any games, takes one-third of Mila’s computer games and a quarter of Sophie’s computer games to give her a total of 77 computer games.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation describing the total number of computer games for Rachel.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{3}+\\frac{x}{4}=77$",
          "worked": "$\\frac{x}{3}+\\frac{x}{4}=77$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equation to find how many computer games Mila and Sophie each had.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "132 computer games each.",
          "worked": "$$\\begin{align*}\\frac{4x}{12}+\\frac{3x}{12}&=77\\\\\\frac{7x}{12}&=77\\\\7x&=924\\\\x&=132\\end{align*}$$\nMila and Sophie each had 132 computer games.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
