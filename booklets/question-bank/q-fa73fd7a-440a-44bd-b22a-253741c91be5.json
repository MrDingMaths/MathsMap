      {
        "id": "p21-review-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove that triangle $BEC$ is similar to triangle $FED$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\triangle BEC\\sim\\triangle FED$ (AAA).",
          "worked": "Since $BC\\parallel AD$, $\\angle CBE=\\angle DFE$ by alternate angles. Also $\\angle CEB=\\angle FED$ are vertically opposite. Therefore $\\triangle BEC\\sim\\triangle FED$ by AAA.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-review-q3-b-i",
        "type": "part",
        "label": "b",
        "prompt": "Given that $CD=3ED$, $AB=6$ and $BC=8$, find $ED$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ED=2$.",
          "worked": "Opposite sides of a parallelogram are equal, so $CD=AB=6$. Hence $3ED=6$ and $ED=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p21-review-q3-b-ii",
        "type": "part",
        "label": "c",
        "prompt": "With the same givens, find $DF$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$DF=4$.",
          "worked": "Since $CE=CD-ED=6-2=4$, the similarity in part a gives $\\frac{BC}{FD}=\\frac{CE}{ED}=\\frac{4}{2}=2$. Thus $\\frac{8}{DF}=2$, so $DF=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
