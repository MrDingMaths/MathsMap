  "content": {
    "id": "p6-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Suppose that there are distinct terms $a_r$ and $a_s$ in an arithmetic sequence for which $a_r=s$ and $a_s=r$. Determine $a_{r+s}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0$\n\nThe common difference is $-1$; advance $s$ places from $a_r=s$.",
      "worked": "Let $d$ be the common difference. Since $r\\ne s$,\n$$\\begin{align*}d&=\\frac{a_s-a_r}{s-r}\\\\d&=\\frac{r-s}{s-r}\\\\d&=-1.\\end{align*}$$\nTherefore,\n$$\\begin{align*}a_{r+s}&=a_r+sd\\\\a_{r+s}&=s+s(-1)\\\\a_{r+s}&=0.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
