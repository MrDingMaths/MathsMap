    "answer": {
      "short": "Student: 11 years; sister: 14 years; father: 36 years. Use $n+(n+3)=(n+25)-11$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p20-q21-answer-age-expressions",
