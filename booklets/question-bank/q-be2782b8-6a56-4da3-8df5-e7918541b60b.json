            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Student: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": "; sister: ",
                "marks": []
