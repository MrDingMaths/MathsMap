    "id": "v2-3cf9e-p17-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Each interior angle of a regular polygon is $100^{\\circ}$ larger than each exterior angle.\nFind the number of sides of the polygon.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "9 sides",
      "worked": "Let $E$ be each exterior angle. The interior and exterior angles at each vertex sum to $180^{\\circ}$.\n$$\\begin{align*}E+(E+100^{\\circ})&=180^{\\circ}\\\\2E&=80^{\\circ}\\\\E&=40^{\\circ}\\end{align*}$$\n$$\\begin{align*}n&=\\frac{360^{\\circ}}{40^{\\circ}}\\\\&=9\\end{align*}$$\nThe polygon has 9 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
