        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "If 2 kg of tomatoes cost $\\$5$, how many kilograms of tomatoes can I buy for $\\$8$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3.2 kg",
          "worked": "$\\$1$ buys $2\\div5=0.4$ kg of tomatoes.\n\n$\\$8$ buys $8\\times0.4=3.2$ kg of tomatoes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "If a dozen apples costs $\\$5$, how much do 17 apples cost? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$7.08$",
          "worked": "1 apple costs $\\dfrac{5}{12}$ dollars.\n\n17 apples cost $\\dfrac{17\\times5}{12}=\\dfrac{85}{12}$ dollars.\n\nThe cost is $\\$7.08$ to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "If 350 g of tinned pineapple contains 210 g of fruit, how much fruit will 500 g contain?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "300 g",
          "worked": "50 g of tinned pineapple contains $210\\div7=30$ g of fruit.\n\n500 g contains $10\\times30=300$ g of fruit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "If 750 mL of soft drink contains 288 g of sugar, how much sugar will 1 litre contain?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "384 g",
          "worked": "1 litre is 1000 mL.\n\n250 mL contains $288\\div3=96$ g of sugar.\n\n1000 mL contains $4\\times96=384$ g of sugar.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
