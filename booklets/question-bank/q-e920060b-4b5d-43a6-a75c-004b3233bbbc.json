    "id": "v2-4ab09-p14-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "Calculate the total pay using the equivalent hours method. Ravi earns \\$26.50/h and in a week, he works 30 normal hours and 6 hours at time-and-a-half.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4ab09-p14-practice-slot-11-slot-11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Equivalent normal hours:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$39\\text{ h}$",
          "worked": "$$\\begin{align*}\\text{Equivalent normal hours} &= 30+(6\\times1.5)\\\\&=39\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-4ab09-p14-practice-slot-11-slot-11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Total pay:",
        "layout": "list",
