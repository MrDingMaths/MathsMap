  "content": {
    "id": "v2-bb60af-p5-practice-slot-1-upper-root",
    "type": "question",
    "label": null,
    "prompt": "A rumour spreads through a school. The number of students who know it doubles every hour. At 8 am, 1 student knows it.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-bb60af-p5-practice-slot-1-upper-s1u-q-a",
        "type": "part",
        "label": "a",
        "prompt": "How many students know the rumour at 2 pm, in index form?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^6$ students",
          "worked": "From 8 am to 2 pm is 6 hours of doubling, so $2^6$ students know the rumour.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-bb60af-p5-practice-slot-1-upper-s1u-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Write your answer to part a as a basic numeral.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64$ students",
          "worked": "$$\\begin{align*}2^6&=2\\times2\\times2\\times2\\times2\\times2\\\\&=64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-bb60af-p5-practice-slot-1-upper-s1u-q-c",
        "type": "part",
        "label": "c",
        "prompt": "The school has 800 students. At what time will more than 800 students first know the rumour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6 pm",
          "worked": "$$\\begin{align*}2^9&=512\\\\2^{10}&=1024\\end{align*}$$\nMore than 800 students first know the rumour after 10 hours, which is 6 pm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
