        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{11-3}{6-2}\\\\m_{AB}&=\\frac{8}{4}\\\\m_{AB}&=2\\end{align*}$$",
