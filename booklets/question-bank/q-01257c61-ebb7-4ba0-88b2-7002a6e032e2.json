  "content": {
    "id": "p10-q20-response",
    "type": "question",
    "label": "20",
    "prompt": "Find the largest sum of money that cannot be obtained using only coins of value 3 units and 5 units.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7$ units.\n\nEvery amount from $8$ units onwards can be formed by adding 3-unit coins to $8$, $9$ or $10$ units.",
      "worked": "With no 5-unit coin, $7$ would need to be a multiple of $3$. With one 5-unit coin, the remaining $2$ units cannot be made. Two 5-unit coins exceed $7$, so $7$ units cannot be obtained.\n\n$$\\begin{align*}8&=5+3\\\\9&=3+3+3\\\\10&=5+5\\end{align*}$$\n\nEvery integer greater than $10$ is one of $8$, $9$ or $10$ plus a positive multiple of $3$. Adding 3-unit coins therefore gives every amount greater than $7$ units. The largest unobtainable amount is $7$ units.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
