  "content": {
    "id": "p28-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify using the Pythagorean identities",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin^2\\theta\\operatorname{cosec}^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\sin^2\\theta\\operatorname{cosec}^2\\theta&=\\sin^2\\theta\\times\\frac{1}{\\sin^2\\theta}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p28-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cot^2\\theta-\\operatorname{cosec}^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{aligned}\\cot^2\\theta-\\operatorname{cosec}^2\\theta&=\\cot^2\\theta-(\\cot^2\\theta+1)\\\\&=-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan^2\\theta-\\dfrac{1}{\\cos^2\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{aligned}\\tan^2\\theta-\\frac{1}{\\cos^2\\theta}&=\\tan^2\\theta-\\sec^2\\theta\\\\&=\\tan^2\\theta-(\\tan^2\\theta+1)\\\\&=-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin^2\\theta-\\sin^2\\theta\\cos^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^4\\theta$",
          "worked": "$$\\begin{aligned}\\sin^2\\theta-\\sin^2\\theta\\cos^2\\theta&=\\sin^2\\theta(1-\\cos^2\\theta)\\\\&=\\sin^2\\theta\\times\\sin^2\\theta\\\\&=\\sin^4\\theta\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin^4\\theta-\\cos^4\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^2\\theta-\\cos^2\\theta$",
          "worked": "$$\\begin{aligned}\\sin^4\\theta-\\cos^4\\theta&=(\\sin^2\\theta-\\cos^2\\theta) \\times(\\sin^2\\theta+\\cos^2\\theta)\\\\&=(\\sin^2\\theta-\\cos^2\\theta)\\times1\\\\&=\\sin^2\\theta-\\cos^2\\theta\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p28-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sin\\theta+\\cos\\theta)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+2\\sin\\theta\\cos\\theta$",
          "worked": "$$\\begin{aligned}(\\sin\\theta+\\cos\\theta)^2&=\\sin^2\\theta+2\\sin\\theta\\cos\\theta +\\cos^2\\theta\\\\&=1+2\\sin\\theta\\cos\\theta\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$1-\\tan^2\\theta+\\sec^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}1-\\tan^2\\theta+\\sec^2\\theta&=1-\\tan^2\\theta+(\\tan^2\\theta+1)\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\tan^2\\theta\\cos^2\\theta+\\cot^2\\theta\\sin^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\tan^2\\theta\\cos^2\\theta+\\cot^2\\theta\\sin^2\\theta\\\\&=\\frac{\\sin^2\\theta}{\\cos^2\\theta}\\cos^2\\theta +\\frac{\\cos^2\\theta}{\\sin^2\\theta}\\sin^2\\theta\\\\&=\\sin^2\\theta+\\cos^2\\theta\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
