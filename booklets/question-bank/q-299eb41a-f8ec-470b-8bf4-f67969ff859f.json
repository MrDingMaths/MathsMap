      {
        "id": "p19-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $2x^2+3x-6$ in the form $A(x+1)^2+B(x+1)+C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x+1)^2-(x+1)-7$",
          "worked": "Equating coefficients of $x^2$ gives $A=2$. Substituting $x=-1$ gives $C=-7$. Substituting $x=0$:\n$$\\begin{align*}-6&=2+B-7\\\\B&=-1.\n\\end{align*}$$\nHence\n$$2x^2+3x-6=2(x+1)^2-(x+1)-7.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p19-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Express $3x^2-2x-1$ in the form $p(x-1)^2+q(x-1)+r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x-1)^2+4(x-1)$",
          "worked": "Equating coefficients of $x^2$ gives $p=3$. Substituting $x=1$ gives $r=0$. Substituting $x=0$:\n$$\\begin{align*}-1&=3-q\\\\q&=4.\n\\end{align*}$$\nHence\n$$3x^2-2x-1=3(x-1)^2+4(x-1).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
