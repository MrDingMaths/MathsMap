  "content": {
    "id": "p44-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "From a group of eleven students, a committee of five students is formed. How many ways can this be done?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\binom{11}{5}=462$",
      "worked": "Order does not matter when selecting the committee.\n\n$$\\begin{align*}N&=\\binom{11}{5}\\\\N&=\\frac{11!}{5!6!}\\\\N&=462\\end{align*}$$",
      "solutionDiagrams": []
