          "inlines": [
            {
              "type": "text",
              "text": "Consider the infinite sum of reciprocals of powers of 2 below.",
              "marks": []
            }
          ]
        },
        {
          "id": "p29-q9-series",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "S=1+\\frac12+\\frac1{2^2}+\\frac1{2^3}+\\cdots",
              "display": true
            }
          ]
        },
        {
          "id": "p29-q9-working-intro",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "We can find its value by factoring out ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac12",
              "display": false
            },
            {
              "type": "text",
              "text": " to give",
              "marks": []
            }
          ]
        },
        {
          "id": "p29-q9-working-equation",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "S=1+\\frac12\\left(1+\\frac12+\\frac1{2^2}+\\frac1{2^3}+\\cdots\\right)",
              "display": true
            }
          ]
        },
        {
          "id": "p29-q9-demonstration-result",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Therefore, ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "S=1+\\frac12S",
              "display": false
            },
            {
              "type": "text",
              "text": ". Solving this equation gives ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "S=2",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
