      {
        "id": "p46-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Using diagram i, prove that $\\angle DEC=70^{\\circ}$. Provide full reasoning.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle EDC=60^{\\circ}$ and $\\angle ECD=50^{\\circ}$ because rectangle corners are right angles. Hence $\\angle DEC=180^{\\circ}-(60^{\\circ}+50^{\\circ})=70^{\\circ}$ by the triangle angle sum.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p46-q9-a-answer-d",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\angle EDC&=90^{\\circ}-30^{\\circ}\\\\\\angle EDC&=60^{\\circ}\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "Angles in a rectangle are right angles.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p46-q9-a-answer-c",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\angle ECD&=90^{\\circ}-40^{\\circ}\\\\\\angle ECD&=50^{\\circ}\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "Angles in a rectangle are right angles.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p46-q9-a-answer-e",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\angle DEC&=180^{\\circ}-(60^{\\circ}+50^{\\circ})\\\\\\angle DEC&=70^{\\circ}\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "Angles in a triangle add up to 180°.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p46-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Using diagram ii, prove that $\\angle DEC=(x+y)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rectangle corners give $\\angle EDC=90^{\\circ}-x$ and $\\angle ECD=90^{\\circ}-y$. Their sum is $180^{\\circ}-(x+y)$, so the triangle angle sum gives $\\angle DEC=x+y$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p46-q9-b-answer-d",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\angle EDC=90^{\\circ}-x",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "Angles in a rectangle are right angles.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p46-q9-b-answer-c",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\angle ECD=90^{\\circ}-y",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "Angles in a rectangle are right angles.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p46-q9-b-answer-sum",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\angle EDC+\\angle ECD&=(90^{\\circ}-x)+(90^{\\circ}-y)\\\\\\angle EDC+\\angle ECD&=180^{\\circ}-(x+y)\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p46-q9-b-answer-e",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\angle DEC&=180^{\\circ}-[180^{\\circ}-(x+y)]\\\\\\angle DEC&=x+y\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "Angles in a triangle add up to 180°.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
