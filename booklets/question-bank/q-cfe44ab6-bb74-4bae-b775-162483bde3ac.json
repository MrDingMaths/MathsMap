  "content": {
    "id": "p10-translation-root",
    "type": "question",
    "label": "",
    "prompt": "The dataset is $3,\\ 6,\\ 8,\\ 11,\\ 14,\\ 18,\\ 22$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-translation-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the IQR of the original dataset.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$Q_1=6$ and $Q_3=18$, so $\\mathrm{IQR}=18-6=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-translation-b",
        "type": "part",
        "label": "b",
        "prompt": "Add 5 to every value in the original dataset. Find the new five-number summary.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8,\\ 11,\\ 16,\\ 23,\\ 27$",
          "worked": "The new dataset is $8,11,13,16,19,23,27$. Excluding the median gives the five-number summary $8,11,16,23,27$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-translation-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the new dataset’s IQR.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$\\mathrm{IQR}=23-11=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-translation-d",
        "type": "part",
        "label": "d",
        "prompt": "Explain why adding 5 to every value leaves the IQR unchanged.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both quartiles increase by 5, so their difference stays the same.",
          "worked": "$Q_1$ and $Q_3$ both increase by 5, so $(Q_3+5)-(Q_1+5)=Q_3-Q_1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
