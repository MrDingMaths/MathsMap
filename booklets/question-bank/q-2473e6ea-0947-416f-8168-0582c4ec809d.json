          "inlines": [
            {
              "type": "text",
              "text": "In general, what is the least number of distinct points on an exponential curve of the form ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=k(a^x)+h",
              "display": false
            },
            {
              "type": "text",
              "text": ", where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "k\\ne0,\\ a>0,\\ a\\ne1",
              "display": false
            },
            {
              "type": "text",
              "text": ", needed to uniquely determine the curve?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p38-q51-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Three points, in general.",
                "marks": []
              }
            ]
          },
          {
            "id": "p38-q51-short-known-asymptote",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "If the horizontal asymptote is known, two points suffice.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "The model $y=k(a^x)+h$ has three unknown parameters: $k$, $a$ and $h$. In general, three distinct points supply the three conditions needed to determine them. If the horizontal asymptote $y=h$ is known, only $k$ and $a$ remain unknown, so two points suffice.",
      "solutionDiagrams": []
    },
