  "content": {
    "id": "p16-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the remainder when $P(x)=x^3+2x+1$ is divided by:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1a",
        "type": "part",
        "label": "a",
        "prompt": "$x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "By the Remainder Theorem, the remainder is $P(2)$.\n$$\\begin{align*}P(2)&=2^3+2(2)+1\\\\P(2)&=8+4+1\\\\P(2)&=13.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q1b",
        "type": "part",
        "label": "b",
        "prompt": "$x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-32$",
          "worked": "By the Remainder Theorem, the remainder is $P(-3)$.\n$$\\begin{align*}P(-3)&=(-3)^3+2(-3)+1\\\\P(-3)&=-27-6+1\\\\P(-3)&=-32.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q1c",
        "type": "part",
        "label": "c",
        "prompt": "$2x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{8}$",
          "worked": "The zero of $2x-1$ is $\\frac12$, so the remainder is $P\\left(\\frac12\\right)$.\n$$\\begin{align*}P\\left(\\frac12\\right)&=\\left(\\frac12\\right)^3+2\\left(\\frac12\\right)+1\\\\P\\left(\\frac12\\right)&=\\frac18+1+1\\\\P\\left(\\frac12\\right)&=\\frac{17}{8}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
