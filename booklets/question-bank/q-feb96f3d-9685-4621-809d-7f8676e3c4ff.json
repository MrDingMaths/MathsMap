    "label": "3",
    "prompt": "Show that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q3a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x+2$ is strictly increasing on $\\mathbb R$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(b)-f(a)=3(b-a)>0$ whenever $a<b$. Hence $f$ is strictly increasing on $\\mathbb R$.",
          "worked": "Let $a,b\\in\\mathbb R$ with $a<b$. Then $b-a>0$.\n$$\\begin{align*}f(b)-f(a)&=(3b+2)-(3a+2)\\\\f(b)-f(a)&=3(b-a)>0.\\end{align*}$$\nThus $f(a)<f(b)$, so $f$ is strictly increasing on $\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q3b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=-2x+3$ is strictly decreasing on $\\mathbb R$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(b)-f(a)=-2(b-a)<0$ whenever $a<b$. Hence $f$ is strictly decreasing on $\\mathbb R$.",
          "worked": "Let $a,b\\in\\mathbb R$ with $a<b$. Then $b-a>0$.\n$$\\begin{align*}f(b)-f(a)&=(-2b+3)-(-2a+3)\\\\f(b)-f(a)&=-2(b-a)<0.\\end{align*}$$\nThus $f(a)>f(b)$, so $f$ is strictly decreasing on $\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q3c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^3$ is strictly increasing on $\\mathbb R$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(b)-f(a)=\\frac{b-a}{2}\\big((a+b)^2+a^2+b^2\\big)>0$ for $a<b$.\n\nThe bracket is positive because $a$ and $b$ cannot both be zero. Hence $f$ is strictly increasing.",
          "worked": "Let $a,b\\in\\mathbb R$ with $a<b$. Then $b-a>0$.\n$$\\begin{align*}f(b)-f(a)&=b^3-a^3\\\\f(b)-f(a)&=(b-a)(b^2+ab+a^2)\\\\f(b)-f(a)&=\\frac{b-a}{2}\\big((a+b)^2+b^2+a^2\\big)>0.\\end{align*}$$\nThe sum of squares is positive because $a<b$ prevents $a=b=0$. Thus $f(a)<f(b)$, so $f$ is strictly increasing on $\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p33-q3d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^4$ is strictly increasing on $[0,\\infty)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(b)-f(a)=(b-a)(b+a)(b^2+a^2)>0$ for $0\\le a<b$. Hence $f$ is strictly increasing on $[0,\\infty)$.",
          "worked": "Let $0\\le a<b$. Then $b-a>0$, $b+a>0$ and $b^2+a^2>0$.\n$$\\begin{align*}f(b)-f(a)&=b^4-a^4\\\\f(b)-f(a)&=(b^2-a^2)(b^2+a^2)\\\\f(b)-f(a)&=(b-a)(b+a)(b^2+a^2)>0.\\end{align*}$$\nThus $f(a)<f(b)$, so $f$ is strictly increasing on $[0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p33-q3e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\dfrac{x}{x^2+1}$ is strictly decreasing on $[1,\\infty)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(b)-f(a)=-\\dfrac{(b-a)(ab-1)}{(a^2+1)(b^2+1)}<0$ for $1\\le a<b$.\n\nHere $ab>1$, so $f$ is strictly decreasing on $[1,\\infty)$.",
          "worked": "Let $1\\le a<b$. Then $b-a>0$, $ab>1$ and $(a^2+1)(b^2+1)>0$.\n$$\\begin{align*}f(b)-f(a)&=\\frac{b}{b^2+1}-\\frac{a}{a^2+1}\\\\f(b)-f(a)&=\\frac{b(a^2+1)-a(b^2+1)}{(a^2+1)(b^2+1)}\\\\f(b)-f(a)&=\\frac{ab(a-b)+(b-a)}{(a^2+1)(b^2+1)}\\\\f(b)-f(a)&=-\\frac{(b-a)(ab-1)}{(a^2+1)(b^2+1)}<0.\\end{align*}$$\nThus $f(a)>f(b)$, so $f$ is strictly decreasing on $[1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p33-q3f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\dfrac{x-2}{x-1}$ is strictly increasing on $(1,\\infty)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(b)-f(a)=\\dfrac{b-a}{(b-1)(a-1)}>0$ for $1<a<b$. Hence $f$ is strictly increasing on $(1,\\infty)$.",
          "worked": "Let $1<a<b$. Then $b-a>0$, $a-1>0$ and $b-1>0$.\n$$\\begin{align*}f(b)-f(a)&=\\frac{b-2}{b-1}-\\frac{a-2}{a-1}\\\\f(b)-f(a)&=\\frac{(a-1)(b-2)-(a-2)(b-1)}{(b-1)(a-1)}\\\\f(b)-f(a)&=\\frac{b-a}{(b-1)(a-1)}>0.\\end{align*}$$\nThus $f(a)<f(b)$, so $f$ is strictly increasing on $(1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      }
    ]
  },
