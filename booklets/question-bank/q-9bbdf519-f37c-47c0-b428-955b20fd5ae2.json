        "answer": {
          "short": "$5+\\sqrt{7}$",
          "worked": "$$\\begin{align*}(\\sqrt{7}+2)(\\sqrt{7}-1)&=7-\\sqrt{7}+2\\sqrt{7}-2\\\\&=5+\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q3-h",
