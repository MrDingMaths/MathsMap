    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt{5}+2)(\\sqrt{5}+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+3\\sqrt{5}$",
          "worked": "$$\\begin{align*}(\\sqrt{5}+2)(\\sqrt{5}+1)&=5+\\sqrt{5}+2\\sqrt{5}+2\\\\&=7+3\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2+\\sqrt{5})(1+\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+3\\sqrt{5}$",
          "worked": "$$\\begin{align*}(2+\\sqrt{5})(1+\\sqrt{5})&=2+2\\sqrt{5}+\\sqrt{5}+5\\\\&=7+3\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2-\\sqrt{5})(1+\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3+\\sqrt{5}$",
          "worked": "$$\\begin{align*}(2-\\sqrt{5})(1+\\sqrt{5})&=2+2\\sqrt{5}-\\sqrt{5}-5\\\\&=-3+\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(\\sqrt{5}-2)(\\sqrt{5}-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7-3\\sqrt{5}$",
          "worked": "$$\\begin{align*}(\\sqrt{5}-2)(\\sqrt{5}-1)&=5-\\sqrt{5}-2\\sqrt{5}+2\\\\&=7-3\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2+2\\sqrt{5})(1+\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12+4\\sqrt{5}$",
          "worked": "$$\\begin{align*}(2+2\\sqrt{5})(1+\\sqrt{5})&=2+2\\sqrt{5}+2\\sqrt{5}+10\\\\&=12+4\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sqrt{5}+2)(\\sqrt{5}-1)$",
        "layout": "list",
