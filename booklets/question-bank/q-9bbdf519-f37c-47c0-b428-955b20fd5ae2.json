        "answer": {
          "short": "$3+\\sqrt{5}$",
          "worked": "$$\\begin{align*}(\\sqrt{5}+2)(\\sqrt{5}-1)&=5-\\sqrt{5}+2\\sqrt{5}-2\\\\&=3+\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$(\\sqrt{7}+2)(\\sqrt{7}-1)$",
