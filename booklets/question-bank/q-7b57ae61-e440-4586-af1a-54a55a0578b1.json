        "label": "a",
        "prompt": "$y=\\sin 2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{aligned}y'&=2\\cos 2x\\\\y''&=-4\\sin 2x\\\\y'''&=-8\\cos 2x\\\\y''''&=16\\sin 2x\\end{aligned}$",
          "worked": "$\\begin{aligned}y&=\\sin 2x\\\\y'&=2\\cos 2x\\\\y''&=2(-2\\sin 2x)=-4\\sin 2x\\\\y'''&=-4(2\\cos 2x)=-8\\cos 2x\\\\y''''&=-8(-2\\sin 2x)=16\\sin 2x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\cos 10x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{aligned}y'&=-10\\sin 10x\\\\y''&=-100\\cos 10x\\\\y'''&=1000\\sin 10x\\\\y''''&=10000\\cos 10x\\end{aligned}$",
          "worked": "$\\begin{aligned}y&=\\cos 10x\\\\y'&=-10\\sin 10x\\\\y''&=-10(10\\cos 10x)\\\\&=-100\\cos 10x\\\\y'''&=-100(-10\\sin 10x)\\\\&=1000\\sin 10x\\\\y''''&=1000(10\\cos 10x)\\\\&=10000\\cos 10x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\sin\\left(\\frac{x}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{aligned}y'&=\\frac12\\cos\\left(\\frac{x}{2}\\right)\\\\y''&=-\\frac14\\sin\\left(\\frac{x}{2}\\right)\\\\y'''&=-\\frac18\\cos\\left(\\frac{x}{2}\\right)\\\\y''''&=\\frac1{16}\\sin\\left(\\frac{x}{2}\\right)\\end{aligned}$",
          "worked": "$\\begin{aligned}y&=\\sin\\left(\\frac{x}{2}\\right)\\\\y'&=\\frac12\\cos\\left(\\frac{x}{2}\\right)\\\\y''&=\\frac12\\left(-\\frac12\\right)\\sin\\left(\\frac{x}{2}\\right)\\\\&=-\\frac14\\sin\\left(\\frac{x}{2}\\right)\\\\y'''&=-\\frac14\\left(\\frac12\\right)\\cos\\left(\\frac{x}{2}\\right)\\\\&=-\\frac18\\cos\\left(\\frac{x}{2}\\right)\\\\y''''&=-\\frac18\\left(-\\frac12\\right)\\sin\\left(\\frac{x}{2}\\right)\\\\&=\\frac1{16}\\sin\\left(\\frac{x}{2}\\right)\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\cos\\left(\\frac{x}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{aligned}y'&=-\\frac13\\sin\\left(\\frac{x}{3}\\right)\\\\y''&=-\\frac19\\cos\\left(\\frac{x}{3}\\right)\\\\y'''&=\\frac1{27}\\sin\\left(\\frac{x}{3}\\right)\\\\y''''&=\\frac1{81}\\cos\\left(\\frac{x}{3}\\right)\\end{aligned}$",
          "worked": "$\\begin{aligned}y&=\\cos\\left(\\frac{x}{3}\\right)\\\\y'&=-\\frac13\\sin\\left(\\frac{x}{3}\\right)\\\\y''&=-\\frac13\\left(\\frac13\\right)\\cos\\left(\\frac{x}{3}\\right)\\\\&=-\\frac19\\cos\\left(\\frac{x}{3}\\right)\\\\y'''&=-\\frac19\\left(-\\frac13\\right)\\sin\\left(\\frac{x}{3}\\right)\\\\&=\\frac1{27}\\sin\\left(\\frac{x}{3}\\right)\\\\y''''&=\\frac1{27}\\left(\\frac13\\right)\\cos\\left(\\frac{x}{3}\\right)\\\\&=\\frac1{81}\\cos\\left(\\frac{x}{3}\\right)\\end{aligned}$",
