  "content": {
    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "In each case the discriminant $\\Delta$ of the quadratic function involves the pronumeral $k$. Put $\\Delta=0$ in order to find the values of $k$ for which the quadratic has exactly one zero.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+10x+k$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=25$",
          "worked": "Exactly one zero requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=10^2-4(1)k\\\\\\Delta&=100-4k\\\\100-4k&=0\\\\k&=25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=kx^2-4x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=4$",
          "worked": "Exactly one zero of the quadratic requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=(-4)^2-4k(1)\\\\\\Delta&=16-4k\\\\16-4k&=0\\\\k&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2x^2-3x+(k+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\frac18$",
          "worked": "Exactly one zero requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=(-3)^2-4(2)(k+1)\\\\\\Delta&=1-8k\\\\1-8k&=0\\\\k&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(k-2)x^2+6x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=11$",
          "worked": "Exactly one zero of the quadratic requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=6^2-4(k-2)(1)\\\\\\Delta&=44-4k\\\\44-4k&=0\\\\k&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
