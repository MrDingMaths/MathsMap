  "content": {
    "id": "p40-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The curve $y=ax^2-4x+1$ has a stationary point where $x=\\frac12$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2ax-4\\end{align*}$$\nAt the stationary point, $\\frac{dy}{dx}=0$ and $x=\\frac12$.\n$$\\begin{align*}2a\\left(\\frac12\\right)-4&=0\\\\a-4&=0\\\\a&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, or otherwise, find the stationary point and determine its nature.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac12,0\\right)$, minimum.",
          "worked": "$$\\begin{align*}y&=4x^2-4x+1\\end{align*}$$\nAt $x=\\frac12$:\n$$\\begin{align*}y&=4\\left(\\frac12\\right)^2-4\\left(\\frac12\\right)+1\\\\y&=0\\end{align*}$$\n$$\\begin{align*}\\frac{d^2y}{dx^2}&=8>0\\end{align*}$$\nTherefore, $\\left(\\frac12,0\\right)$ is a minimum turning point.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
