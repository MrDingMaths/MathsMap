    "children": [
      {
        "id": "p22-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What is Michael’s $z$-score (correct to two decimal places) for his mark in Construction?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.23$",
          "worked": "$$\\begin{aligned}z_C&=\\frac{x_C-\\mu_C}{\\sigma_C}\\\\z_C&=\\frac{77-64.6}{10.1}\\\\z_C&=\\frac{124}{101}\\\\z_C&\\approx1.23\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p22-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Michael achieved the same $z$-score in both Construction and Legal studies.\nWhat is the mean for Legal studies? Answer correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$58.7$",
          "worked": "Use the unrounded $z$-score from part a.\n$$\\begin{aligned}\\bar{x}&=x_L-z_C\\sigma_L\\\\\\bar{x}&=74-\\frac{124}{101}(12.5)\\\\\\bar{x}&=\\frac{5924}{101}\\\\\\bar{x}&\\approx58.7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "What mark does Michael require in Construction to achieve a $z$-score of 2?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84.8$",
          "worked": "$$\\begin{aligned}x_C&=\\mu_C+z\\sigma_C\\\\x_C&=64.6+2(10.1)\\\\x_C&=84.8\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "What mark does Michael require in Legal studies to achieve a $z$-score of 2? Answer correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$83.7$",
          "worked": "Use the unrounded mean from part b.\n$$\\begin{aligned}x_L&=\\bar{x}+z\\sigma_L\\\\x_L&=\\frac{5924}{101}+2(12.5)\\\\x_L&=\\frac{8449}{101}\\\\x_L&\\approx83.7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
