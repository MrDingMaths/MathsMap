  "content": {
    "id": "p34-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Amy buys 4 tickets in a raffle in which 50 tickets are sold. The tickets are drawn for first and second prizes. What is the probability that Amy wins",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "first prize?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{25}$",
          "worked": "$$\\begin{align*}P(\\text{first prize}) &= \\frac{4}{50}\\\\&=\\frac{2}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p34-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "second prize, given that she wins first prize?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{49}$",
          "worked": "After Amy wins first prize, 3 of her tickets remain among the 49 remaining tickets.\n$$P(\\text{second prize}\\mid\\text{first prize})=\\frac{3}{49}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "second prize, given that she does not win first prize?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{49}$",
          "worked": "If Amy does not win first prize, all 4 of her tickets remain among the 49 remaining tickets.\n$$P(\\text{second prize}\\mid\\text{not first prize})=\\frac{4}{49}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
