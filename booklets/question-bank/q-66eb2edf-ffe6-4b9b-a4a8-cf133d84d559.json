  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The following are either difference of squares expansions or perfect square expansions. Which are which?",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^2-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Difference of squares expansion.",
          "worked": "$$a^2-1=a^2-1^2$$\n\nThis is a difference of squares expansion.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^2-2a+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perfect square expansion.",
          "worked": "$$a^2-2a+1=a^2-2\\times a\\times1+1^2$$\n\nThis is the perfect square expansion of $(a-1)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Difference of squares expansion.",
          "worked": "$$x^2-9=x^2-3^2$$\n\nThis is a difference of squares expansion.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2-25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Difference of squares expansion.",
          "worked": "$$4x^2-25=(2x)^2-5^2$$\n\nThis is a difference of squares expansion.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$4a^2+12a+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perfect square expansion.",
          "worked": "$$4a^2+12a+9=(2a)^2+2\\times2a\\times3+3^2$$\n\nThis is the perfect square expansion of $(2a+3)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$9a^2-6a+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perfect square expansion.",
          "worked": "$$9a^2-6a+1=(3a)^2-2\\times3a\\times1+1^2$$\n\nThis is the perfect square expansion of $(3a-1)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
