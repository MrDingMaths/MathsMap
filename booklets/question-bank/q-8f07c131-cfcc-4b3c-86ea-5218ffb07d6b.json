  "content": {
    "id": "p37-ex3f-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the discriminant $\\Delta=b^2-4ac$ of each quadratic function, then find the zeroes. Give the zeroes first in surd form, then correct to two decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-ex3f-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2+2x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=12$; $x=-1\\pm\\sqrt3\\approx-2.73,\\ 0.73$.",
          "worked": "$$\\begin{align*}\\Delta&=2^2-4(1)(-2)\\\\\\Delta&=12\\\\x&=\\frac{-2\\pm\\sqrt{12}}{2}\\\\x&=-1\\pm\\sqrt3\\\\x&\\approx-2.73\\text{ or }0.73\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p37-ex3f-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2-4x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=12$; $x=2\\pm\\sqrt3\\approx0.27,\\ 3.73$.",
          "worked": "$$\\begin{align*}\\Delta&=(-4)^2-4(1)(1)\\\\\\Delta&=12\\\\x&=\\frac{4\\pm\\sqrt{12}}{2}\\\\x&=2\\pm\\sqrt3\\\\x&\\approx0.27\\text{ or }3.73\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p37-ex3f-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=-x^2+3x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=1$; $x=1$ or $2$ ($1.00$ or $2.00$).",
          "worked": "$$\\begin{align*}\\Delta&=3^2-4(-1)(-2)\\\\\\Delta&=1\\\\x&=\\frac{-3\\pm\\sqrt1}{-2}\\\\x&=1\\text{ or }2\\end{align*}$$\n\nTo two decimal places, the zeroes are $1.00$ and $2.00$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p37-ex3f-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=-x^2-2x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=20$; $x=-1\\pm\\sqrt5\\approx-3.24,\\ 1.24$.",
          "worked": "$$\\begin{align*}\\Delta&=(-2)^2-4(-1)(4)\\\\\\Delta&=20\\\\x&=\\frac{2\\pm\\sqrt{20}}{-2}\\\\x&=-1\\pm\\sqrt5\\\\x&\\approx-3.24\\text{ or }1.24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p37-ex3f-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=3x^2-2x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=28$; $x=\\frac{1\\pm\\sqrt7}{3}\\approx-0.55,\\ 1.22$.",
          "worked": "$$\\begin{align*}\\Delta&=(-2)^2-4(3)(-2)\\\\\\Delta&=28\\\\x&=\\frac{2\\pm\\sqrt{28}}{6}\\\\x&=\\frac{1\\pm\\sqrt7}{3}\\\\x&\\approx-0.55\\text{ or }1.22\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p37-ex3f-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=2x^2+4x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=24$; $x=\\frac{-2\\pm\\sqrt6}{2}\\approx-2.22,\\ 0.22$.",
          "worked": "$$\\begin{align*}\\Delta&=4^2-4(2)(-1)\\\\\\Delta&=24\\\\x&=\\frac{-4\\pm\\sqrt{24}}{4}\\\\x&=\\frac{-2\\pm\\sqrt6}{2}\\\\x&\\approx-2.22\\text{ or }0.22\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
