        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,1)$",
          "worked": "$$\\begin{align*}3x+2(x-1)&=8\\\\5x-2&=8\\\\5x&=10\\\\x&=2\\\\y&=2-1\\\\y&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p20-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\begin{aligned}x&=2y+3\\\\11y-5x&=-14\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5,1)$",
          "worked": "$$\\begin{align*}11y-5(2y+3)&=-14\\\\y-15&=-14\\\\y&=1\\\\x&=2(1)+3\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p21-part-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\begin{aligned}x&=3y-5\\\\3y+5x&=11\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,2)$",
          "worked": "$$\\begin{align*}3y+5(3y-5)&=11\\\\18y-25&=11\\\\18y&=36\\\\y&=2\\\\x&=3(2)-5\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p21-part-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\begin{aligned}y&=5-2x\\\\y&=\\frac{3}{2}x-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,1)$",
          "worked": "$$\\begin{align*}5-2x&=\\frac{3}{2}x-2\\\\10-4x&=3x-4\\\\14&=7x\\\\x&=2\\\\y&=5-2(2)\\\\y&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-part-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\begin{aligned}y&=5x-1\\\\y&=\\frac{11-3x}{2}\\end{aligned}$$",
