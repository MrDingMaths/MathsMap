      },
      {
        "id": "p20-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}y&=2x-18\\\\y&=6x-30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,-12)$",
          "worked": "$$\\begin{align*}2x-18&=6x-30\\\\12&=4x\\\\x&=3\\\\y&=2(3)-18\\\\y&=-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p20-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}y&=30+6x\\\\y&=-2x+18\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\dfrac{3}{2},21\\right)$",
          "worked": "$$\\begin{align*}-2x+18&=30+6x\\\\-8x&=12\\\\x&=-\\frac{3}{2}\\\\y&=-2\\left(-\\frac{3}{2}\\right)+18\\\\y&=21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p20-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}y&=x+5\\\\3x+y&=13\\end{aligned}$$",
