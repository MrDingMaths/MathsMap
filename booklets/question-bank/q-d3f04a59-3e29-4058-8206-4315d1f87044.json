        "children": [],
        "answer": {
          "short": "$(2,7)$",
          "worked": "$$\\begin{align*}3x+(x+5)&=13\\\\4x+5&=13\\\\4x&=8\\\\x&=2\\\\y&=2+5\\\\y&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p20-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}y&=x-1\\\\3x+2y&=8\\end{aligned}$$",
