        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(6,3)$",
          "worked": "$$\\begin{align*}-3x+21&=-2x+15\\\\6&=x\\\\x&=6\\\\y&=-2(6)+15\\\\y&=3\\end{align*}$$",
