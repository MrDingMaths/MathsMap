        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(5,\\dfrac{18}{5}\\right)$",
          "worked": "$$\\begin{align*}x&=41-10y\\\\4(41-10y)-5y&=2\\\\164-45y&=2\\\\-45y&=-162\\\\y&=\\frac{18}{5}\\\\x&=41-10\\left(\\frac{18}{5}\\right)\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 63
      },
      {
        "id": "p21-part-r",
        "type": "part",
        "label": "r",
        "prompt": "$$\\begin{aligned}2x+3y&=47\\\\4x-y&=45\\end{aligned}$$",
