        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,4)$",
          "worked": "$$\\begin{align*}5x-1&=\\frac{11-3x}{2}\\\\10x-2&=11-3x\\\\13x&=13\\\\x&=1\\\\y&=5(1)-1\\\\y&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-part-m",
        "type": "part",
        "label": "m",
        "prompt": "$$\\begin{aligned}y+2x&=-18\\\\y+6x&=30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(12,-42)$",
          "worked": "$$\\begin{align*}y&=-18-2x\\\\(-18-2x)+6x&=30\\\\4x-18&=30\\\\4x&=48\\\\x&=12\\\\y&=-18-2(12)\\\\y&=-42\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-part-n",
        "type": "part",
        "label": "n",
        "prompt": "$$\\begin{aligned}2x+y&=-18\\\\6x-y&=-30\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-6,-6)$",
          "worked": "$$\\begin{align*}y&=-18-2x\\\\6x-(-18-2x)&=-30\\\\8x+18&=-30\\\\8x&=-48\\\\x&=-6\\\\y&=-18-2(-6)\\\\y&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-part-o",
        "type": "part",
        "label": "o",
        "prompt": "$$\\begin{aligned}2x+3y&=8\\\\4x-y&=7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\dfrac{29}{14},\\dfrac{9}{7}\\right)$",
          "worked": "$$\\begin{align*}y&=4x-7\\\\2x+3(4x-7)&=8\\\\14x-21&=8\\\\14x&=29\\\\x&=\\frac{29}{14}\\\\y&=4\\left(\\frac{29}{14}\\right)-7\\\\y&=\\frac{58}{7}-\\frac{49}{7}\\\\y&=\\frac{9}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p21-part-p",
        "type": "part",
        "label": "p",
        "prompt": "$$\\begin{aligned}2x-y&=9\\\\3x-7y&=19\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,-1)$",
          "worked": "$$\\begin{align*}y&=2x-9\\\\3x-7(2x-9)&=19\\\\-11x+63&=19\\\\-11x&=-44\\\\x&=4\\\\y&=2(4)-9\\\\y&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-part-q",
        "type": "part",
        "label": "q",
        "prompt": "$$\\begin{aligned}4x-5y&=2\\\\x+10y&=41\\end{aligned}$$",
