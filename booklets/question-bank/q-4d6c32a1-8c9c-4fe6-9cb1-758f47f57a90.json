  "content": {
    "id": "p3-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Draw a right-angled triangle with angle $\\theta$ for which $\\cos\\theta=\\frac12$. Find $\\sin\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sin\\theta=\\frac{\\sqrt3}{2}$",
      "worked": "Choose adjacent side $1$ and hypotenuse $2$. Let $x$ be the opposite side.\n$$\\begin{align*}x^2+1^2&=2^2\\\\x^2&=3\\\\x&=\\sqrt3\\\\\\sin\\theta&=\\frac{\\sqrt3}{2}\\end{align*}$$",
