  "content": {
    "id": "p41-o-root",
    "type": "question",
    "label": "o",
    "prompt": "A shopkeeper wants to sell an item for \\$500, including GST. How much GST is he charging his customers? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$45.45$",
      "worked": "The GST-inclusive price represents $110\\%$ of the pre-GST price. Divide by $11$ to find the $10\\%$ GST component.\n$$\\begin{align*}110\\% &= \\$500\\\\10\\% &= \\$\\frac{500}{11}\\\\10\\% &\\approx \\$45.45\\end{align*}$$\nThe GST is $\\$45.45$, to the nearest cent.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
