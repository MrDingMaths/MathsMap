        "children": [],
        "answer": {
          "short": "$175$",
          "worked": "Let $x$ be the total.\n$$\\begin{align*}0.40x &= 200\\\\x &= \\frac{200}{0.40}=500\\\\0.35x &= 0.35\\times500=175\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
