      {
        "id": "p49-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "6% of the total is 36.\nFind 20%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "Let $x$ be the total.\n$$\\begin{align*}0.06x &= 36\\\\x &= \\frac{36}{0.06}=600\\\\0.20x &= 0.20\\times600=120\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p49-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "15% of the total is 45.\nFind 80%",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$240$",
          "worked": "Let $x$ be the total.\n$$\\begin{align*}0.15x &= 45\\\\x &= \\frac{45}{0.15}=300\\\\0.80x &= 0.80\\times300=240\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p49-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "40% of the total is 200.\nFind 35%.",
