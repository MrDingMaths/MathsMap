  "content": {
    "id": "p41-q-response",
    "type": "question",
    "label": "q",
    "prompt": "In a sale, the price of a laptop is reduced by 25%. A week later, the price is reduced by a further 15%. The final price is \\$586.50. Work out the original price of the laptop before the sale.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$920",
      "worked": "The combined multiplier is $0.75\\times0.85=0.6375$, so \\$586.50 represents $63.75\\%$ of the original price.\n\n$$\\begin{align*}63.75\\%&=\\$586.50\\\\1\\%&=\\frac{\\$586.50}{63.75}\\\\100\\%&=\\frac{\\$586.50}{63.75}\\times100\\\\100\\%&=\\$920\\end{align*}$$\n\nThe original price was \\$920.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
