  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Six friends buy a large box of jelly snakes. The snakes come in 5 different colours. How many snakes are needed so that every person has two of each colour?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "60 snakes",
      "worked": "$$\\begin{align*}6\\times5\\times2&=6\\times2\\times5\\\\6\\times5\\times2&=12\\times5\\\\6\\times5\\times2&=60\\end{align*}$$\n\n60 snakes are needed.",
