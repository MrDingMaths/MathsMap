      {
        "id": "v2-b-p34-continuation-slot-20-slot-20-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\operatorname{cosec}\\theta-\\cot\\theta)^2=\\dfrac{1-\\cos\\theta}{1+\\cos\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1-\\cos\\theta}{1+\\cos\\theta}=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\left(\\frac{1}{\\sin\\theta}-\\frac{\\cos\\theta}{\\sin\\theta}\\right)^2\\\\&=\\left(\\frac{1-\\cos\\theta}{\\sin\\theta}\\right)^2\\\\&=\\frac{(1-\\cos\\theta)^2}{\\sin^2\\theta}\\\\&=\\frac{(1-\\cos\\theta)^2}{1-\\cos^2\\theta}\\\\&=\\frac{(1-\\cos\\theta)^2}{(1-\\cos\\theta)(1+\\cos\\theta)}\\\\&=\\frac{1-\\cos\\theta}{1+\\cos\\theta}\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "v2-b-p34-continuation-slot-20-slot-20-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\dfrac{\\cos\\theta}{1+\\sin\\theta}\\right)^2=\\dfrac{1-\\sin\\theta}{1+\\sin\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1-\\sin\\theta}{1+\\sin\\theta}=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\cos^2\\theta}{(1+\\sin\\theta)^2}\\\\&=\\frac{1-\\sin^2\\theta}{(1+\\sin\\theta)^2}\\\\&=\\frac{(1-\\sin\\theta)(1+\\sin\\theta)}{(1+\\sin\\theta)^2}\\\\&=\\frac{1-\\sin\\theta}{1+\\sin\\theta}\\\\&=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
