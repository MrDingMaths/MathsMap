  "content": {
    "id": "p11-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "There are thirty-three students in a class and there are 20% more boys than girls. How many girls are in the class?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "15 girls.",
      "worked": "Let $x$ be the number of girls. The number of boys is $1.2x$.\n\n$$\\begin{align*}x+1.2x&=33\\\\2.2x&=33\\\\22x&=330\\\\x&=\\frac{330}{22}\\\\x&=15\\end{align*}$$\n\nThere are 15 girls in the class.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
