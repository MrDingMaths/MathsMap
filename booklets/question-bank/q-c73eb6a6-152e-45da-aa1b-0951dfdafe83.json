  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Given $\\sin\\theta=\\frac13$, find the value of $\\cos\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\cos\\theta=\\pm\\frac{2\\sqrt2}{3}$.",
      "worked": "$$\\begin{align*}\\cos^2\\theta&=1-\\sin^2\\theta\\\\\\cos^2\\theta&=1-\\left(\\frac13\\right)^2\\\\\\cos^2\\theta&=\\frac89\\\\\\cos\\theta&=\\pm\\frac{2\\sqrt2}{3}\\end{align*}$$\nBoth signs are possible because no quadrant is specified.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
