      {
        "id": "p6-p5a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $x$- and $y$-intercepts of $\\ell$ and hence explain why this is called the intercept form of a straight line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $a$; $y$-intercept: $b$. The constants $a$ and $b$ give the line's intercepts.",
          "worked": "For the $x$-intercept, set $y=0$.\n$$\\begin{align*}\\frac{x}{a}+\\frac{0}{b}&=1\\\\x&=a\\end{align*}$$\nFor the $y$-intercept, set $x=0$.\n$$\\begin{align*}\\frac{0}{a}+\\frac{y}{b}&=1\\\\y&=b\\end{align*}$$\nThe intercept points are $(a,0)$ and $(0,b)$. Since the constants in the denominators directly give the $x$- and $y$-intercepts, the equation is called intercept form.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-p5b",
        "type": "part",
        "label": "b",
        "prompt": "Use the intercept form to find the equation of the line with $x$- and $y$-intercepts at $-2$ and $3$ respectively.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{x}{2}+\\frac{y}{3}=1$.",
          "worked": "Substitute $a=-2$ and $b=3$ into intercept form.\n$$\\begin{align*}\\frac{x}{-2}+\\frac{y}{3}&=1\\\\-\\frac{x}{2}+\\frac{y}{3}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
