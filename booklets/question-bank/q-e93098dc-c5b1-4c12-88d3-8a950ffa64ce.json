  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify the following and express your answer as an exact value in simplest form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin45^\\circ+\\cos45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt2$",
          "worked": "$$\\begin{align*}\\sin45^\\circ+\\cos45^\\circ&=\\frac1{\\sqrt2}+\\frac1{\\sqrt2}\\\\\\sin45^\\circ+\\cos45^\\circ&=\\frac2{\\sqrt2}\\\\\\sin45^\\circ+\\cos45^\\circ&=\\sqrt2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin^2 45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\sin^2 45^\\circ&=\\left(\\frac1{\\sqrt2}\\right)^2\\\\\\sin^2 45^\\circ&=\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos45^\\circ\\sec45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\cos45^\\circ\\sec45^\\circ&=\\frac1{\\sqrt2}\\times\\sqrt2\\\\\\cos45^\\circ\\sec45^\\circ&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sec^2 60^\\circ-\\tan^2 60^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sec^2 60^\\circ-\\tan^2 60^\\circ&=2^2-(\\sqrt3)^2\\\\\\sec^2 60^\\circ-\\tan^2 60^\\circ&=4-3\\\\\\sec^2 60^\\circ-\\tan^2 60^\\circ&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\cos^2 30^\\circ-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}2\\cos^2 30^\\circ-1&=2\\left(\\frac{\\sqrt3}{2}\\right)^2-1\\\\2\\cos^2 30^\\circ-1&=2\\times\\frac34-1\\\\2\\cos^2 30^\\circ-1&=\\frac32-1\\\\2\\cos^2 30^\\circ-1&=\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p8-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sin60^\\circ\\cos30^\\circ+\\cos60^\\circ\\sin30^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin60^\\circ\\cos30^\\circ+\\cos60^\\circ\\sin30^\\circ&=\\frac{\\sqrt3}{2}\\times\\frac{\\sqrt3}{2}+\\frac12\\times\\frac12\\\\\\sin60^\\circ\\cos30^\\circ+\\cos60^\\circ\\sin30^\\circ&=\\frac34+\\frac14\\\\\\sin60^\\circ\\cos30^\\circ+\\cos60^\\circ\\sin30^\\circ&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
