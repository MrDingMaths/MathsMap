  "content": {
    "id": "p15-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Given $p(x)=x^2-4$ and $q(x)=2x+3$, simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$p(q(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+12x+5$",
          "worked": "$$\\begin{align*}p(q(x))&=(2x+3)^2-4\\\\p(q(x))&=4x^2+12x+9-4\\\\p(q(x))&=4x^2+12x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$q(p(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2-5$",
          "worked": "$$\\begin{align*}q(p(x))&=2(x^2-4)+3\\\\q(p(x))&=2x^2-8+3\\\\q(p(x))&=2x^2-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$p(p(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-8x^2+12$",
          "worked": "$$\\begin{align*}p(p(x))&=(x^2-4)^2-4\\\\p(p(x))&=x^4-8x^2+16-4\\\\p(p(x))&=x^4-8x^2+12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$q(q(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x+9$",
          "worked": "$$\\begin{align*}q(q(x))&=2(2x+3)+3\\\\q(q(x))&=4x+6+3\\\\q(q(x))&=4x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
