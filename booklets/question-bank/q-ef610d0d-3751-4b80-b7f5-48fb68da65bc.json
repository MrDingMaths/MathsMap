  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A circle is drawn with centre $O$. The line $AB$ is tangent to the circle at $A$ and line $OB$ intersects the circle at $C$. Given $AB=10$ and $BC=5$, find the radius of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7.5$",
      "worked": "Let the radius be $r$. Then $OA=OC=r$ and $OB=r+5$. Since $OA$ is perpendicular to tangent $AB$,\n$$\\begin{align*}(r+5)^2&=r^2+10^2\\\\r^2+10r+25&=r^2+100\\\\10r&=75\\\\r&=7.5\\end{align*}$$\nThe radius is $7.5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
