  "content": {
    "id": "p14-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Use prime factorisation to help you solve each of the following questions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Express 210 as the product of two consecutive natural numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14\\times15$",
          "worked": "$$\\begin{align*}210&=2\\times3\\times5\\times7\\\\210&=(2\\times7)(3\\times5)\\\\210&=14\\times15\\end{align*}$$\n\n14 and 15 are consecutive natural numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Express 3360 as the product of three consecutive natural numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14\\times15\\times16$",
          "worked": "$$\\begin{align*}3360&=2^5\\times3\\times5\\times7\\\\3360&=(2\\times7)(3\\times5)2^4\\\\3360&=14\\times15\\times16\\end{align*}$$\n\n14, 15 and 16 are consecutive natural numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Express 3024 as the product of consecutive natural numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\times7\\times8\\times9$",
          "worked": "$$\\begin{align*}3024&=2^4\\times3^3\\times7\\\\3024&=(2\\times3)\\times7\\times2^3\\times3^2\\\\3024&=6\\times7\\times8\\times9\\end{align*}$$\n\n6, 7, 8 and 9 are consecutive natural numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Express 675 as the product of two consecutive odd numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\times27$",
          "worked": "$$\\begin{align*}675&=3^3\\times5^2\\\\675&=5^2\\times3^3\\\\675&=25\\times27\\end{align*}$$\n\n25 and 27 are consecutive odd numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Express 440 as the product of two consecutive even numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\times22$",
          "worked": "$$\\begin{align*}440&=2^3\\times5\\times11\\\\440&=(2^2\\times5)(2\\times11)\\\\440&=20\\times22\\end{align*}$$\n\n20 and 22 are consecutive even numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "Express 2688 as the product of three consecutive even numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\times14\\times16$",
          "worked": "$$\\begin{align*}2688&=2^7\\times3\\times7\\\\2688&=(2^2\\times3)(2\\times7)2^4\\\\2688&=12\\times14\\times16\\end{align*}$$\n\n12, 14 and 16 are consecutive even numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "Express 1287 as a product of three consecutive odd numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\times11\\times13$",
          "worked": "$$\\begin{align*}1287&=3^2\\times11\\times13\\\\1287&=9\\times11\\times13\\end{align*}$$\n\n9, 11 and 13 are consecutive odd numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "Express 5760 as a product of consecutive even numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\times18\\times20$",
          "worked": "$$\\begin{align*}5760&=2^7\\times3^2\\times5\\\\5760&=2^4(2\\times3^2)(2^2\\times5)\\\\5760&=16\\times18\\times20\\end{align*}$$\n\n16, 18 and 20 are consecutive even numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "Express 3465 as a product of consecutive odd numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\times7\\times9\\times11$",
          "worked": "$$\\begin{align*}3465&=3^2\\times5\\times7\\times11\\\\3465&=5\\times7\\times3^2\\times11\\\\3465&=5\\times7\\times9\\times11\\end{align*}$$\n\n5, 7, 9 and 11 are consecutive odd numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
