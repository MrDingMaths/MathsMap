  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the coordinates of $B$ in each midpoint problem.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2a",
        "type": "part",
        "label": "a",
        "prompt": "$M(2,3)$ is the midpoint of $A(1,1)$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B(3,5)$",
          "worked": "Let $B=(x,y)$. Using the midpoint formula,\n$$\\begin{align*}\\frac{1+x}{2}&=2\\\\1+x&=4\\\\x&=3\\end{align*}$$\n$$\\begin{align*}\\frac{1+y}{2}&=3\\\\1+y&=6\\\\y&=5\\end{align*}$$\nTherefore, $B=(3,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p6-q2b",
        "type": "part",
        "label": "b",
        "prompt": "$M(-3,4)$ is the midpoint of $A(1,-3)$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B(-7,11)$",
          "worked": "Let $B=(x,y)$. Using the midpoint formula,\n$$\\begin{align*}\\frac{1+x}{2}&=-3\\\\1+x&=-6\\\\x&=-7\\end{align*}$$\n$$\\begin{align*}\\frac{-3+y}{2}&=4\\\\-3+y&=8\\\\y&=11\\end{align*}$$\nTherefore, $B=(-7,11)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
  },
