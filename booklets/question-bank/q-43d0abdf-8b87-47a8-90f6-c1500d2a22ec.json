  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the remainder when $1234 + 5678$ is divided by $5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2$",
      "worked": "Since $1234\\equiv4\\pmod{5}$ and $5678\\equiv3\\pmod{5}$,\n$$\\begin{align*}1234+5678&\\equiv4+3\\pmod{5}\\\\1234+5678&\\equiv7\\pmod{5}\\\\1234+5678&\\equiv2\\pmod{5}.\\end{align*}$$\nThe remainder is $2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
