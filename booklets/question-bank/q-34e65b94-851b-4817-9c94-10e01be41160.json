    "type": "question",
    "label": null,
    "prompt": "Find the equation of a line with a gradient of $3$ and an $x$-intercept of $-2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=3x+6$",
      "worked": "The $x$-intercept gives the point $(-2,0)$.\n$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-0&=3(x+2)\\\\y&=3x+6\\end{aligned}$$",
