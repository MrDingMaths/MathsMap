  "content": {
    "id": "p7-q12-root",
    "type": "question",
    "label": null,
    "prompt": "Solve each of the following equations for $x$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+\\frac{1}{a}=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=b-\\frac{1}{a}$",
          "worked": "$$\\begin{align*}x+\\frac{1}{a}-\\frac{1}{a}&=b-\\frac{1}{a}\\\\x&=b-\\frac{1}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x+a}{x+b}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{a-bc}{c-1}$\n\nClear the denominator, then collect the terms in $x$.",
          "worked": "$$\\begin{align*}x+a&=c(x+b)\\\\x+a&=cx+bc\\\\a-bc&=cx-x\\\\a-bc&=(c-1)x\\\\x&=\\frac{a-bc}{c-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x}{a}+\\frac{1}{b}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=ca-\\frac{a}{b}$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=c-\\frac{1}{b}\\\\x&=a\\left(c-\\frac{1}{b}\\right)\\\\x&=ca-\\frac{a}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{a}-\\frac{1}{b}=\\frac{1}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{a}{c}+\\frac{a}{b}$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=\\frac{1}{c}+\\frac{1}{b}\\\\x&=a\\left(\\frac{1}{c}+\\frac{1}{b}\\right)\\\\x&=\\frac{a}{c}+\\frac{a}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x-a}{a}+\\frac{x-b}{b}=\\frac{x-c}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{abc}{bc+ac-ab}$\n\nMultiply by $abc$, expand and collect the terms in $x$.",
          "worked": "$$\\begin{align*}bc(x-a)+ac(x-b)&=ab(x-c)\\\\bcx-abc+acx-abc&=abx-abc\\\\bcx+acx-abx&=abc\\\\(bc+ac-ab)x&=abc\\\\x&=\\frac{abc}{bc+ac-ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{a+x}{x-a}=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{a(b+1)}{b-1}$\n\nClear the denominator, then factorise the collected terms in $x$.",
          "worked": "$$\\begin{align*}a+x&=b(x-a)\\\\a+x&=bx-ab\\\\a+ab&=bx-x\\\\a(b+1)&=(b-1)x\\\\x&=\\frac{a(b+1)}{b-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
