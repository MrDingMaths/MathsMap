      {
        "id": "p22-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "How many arrangements of the letters A, B, C and D are possible if no letter can be used twice?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "$$\\begin{aligned}{}^4P_4&=4\\times3\\times2\\times1\\\\&=24\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p22-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "How many arrangements of any 3 of these letters are possible?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "$$\\begin{aligned}{}^4P_3&=4\\times3\\times2\\\\&=24\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p22-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why the answers to parts a and b are the same.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Once three letters are arranged, the remaining letter is uniquely determined, so there is only one choice for the fourth position.",
          "worked": "$${}^4P_4=4\\times3\\times2\\times1$$\n$${}^4P_3=4\\times3\\times2$$\nThe extra factor is 1, so the two counts are equal. Once three letters are arranged, there is only one remaining letter to place fourth.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
