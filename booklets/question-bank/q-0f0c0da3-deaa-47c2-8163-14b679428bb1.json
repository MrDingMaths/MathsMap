  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Write down the gradient and $y$-intercept of each of the lines whose equations are given below:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=3$; $y$-intercept $(0,2)$.",
          "worked": "Comparing $y=3x+2$ with $y=mx+c$ gives $m=3$ and $c=2$. The $y$-intercept is $(0,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-2$; $y$-intercept $(0,3)$.",
          "worked": "Comparing $y=-2x+3$ with $y=mx+c$ gives $m=-2$ and $c=3$. The $y$-intercept is $(0,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=4x-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=4$; $y$-intercept $(0,-5)$.",
          "worked": "Comparing $y=4x-5$ with $y=mx+c$ gives $m=4$ and $c=-5$. The $y$-intercept is $(0,-5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=5+2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2$; $y$-intercept $(0,5)$.",
          "worked": "$$y=2x+5$$\nComparing with $y=mx+c$ gives $m=2$ and $c=5$. The $y$-intercept is $(0,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=3-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-4$; $y$-intercept $(0,3)$.",
          "worked": "$$y=-4x+3$$\nComparing with $y=mx+c$ gives $m=-4$ and $c=3$. The $y$-intercept is $(0,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=-2-9x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-9$; $y$-intercept $(0,-2)$.",
          "worked": "$$y=-9x-2$$\nComparing with $y=mx+c$ gives $m=-9$ and $c=-2$. The $y$-intercept is $(0,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\dfrac{2x+3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1$; $y$-intercept $\\left(0,\\frac32\\right)$.",
          "worked": "$$\\begin{align*}y&=\\frac{2x}{2}+\\frac32\\\\y&=x+\\frac32\\end{align*}$$\nThus $m=1$ and the $y$-intercept is $\\left(0,\\frac32\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\dfrac{-3x+2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-1$; $y$-intercept $\\left(0,\\frac23\\right)$.",
          "worked": "$$\\begin{align*}y&=\\frac{-3x}{3}+\\frac23\\\\y&=-x+\\frac23\\end{align*}$$\nThus $m=-1$ and the $y$-intercept is $\\left(0,\\frac23\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=-\\dfrac{2x+4}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\frac25$; $y$-intercept $\\left(0,-\\frac45\\right)$.",
          "worked": "$$\\begin{align*}y&=\\frac{-2x-4}{5}\\\\y&=-\\frac25x-\\frac45\\end{align*}$$\nThus $m=-\\frac25$ and the $y$-intercept is $\\left(0,-\\frac45\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$y=-\\dfrac{2x-4}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\frac25$; $y$-intercept $\\left(0,\\frac45\\right)$.",
          "worked": "$$\\begin{align*}y&=\\frac{-2x+4}{5}\\\\y&=-\\frac25x+\\frac45\\end{align*}$$\nThus $m=-\\frac25$ and the $y$-intercept is $\\left(0,\\frac45\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$2y+3x=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\frac32$; $y$-intercept $(0,3)$.",
          "worked": "$$\\begin{align*}2y&=-3x+6\\\\y&=-\\frac32x+3\\end{align*}$$\nThus $m=-\\frac32$ and the $y$-intercept is $(0,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p14-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$3y-4x=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac43$; $y$-intercept $(0,4)$.",
          "worked": "$$\\begin{align*}3y&=4x+12\\\\y&=\\frac43x+4\\end{align*}$$\nThus $m=\\frac43$ and the $y$-intercept is $(0,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
