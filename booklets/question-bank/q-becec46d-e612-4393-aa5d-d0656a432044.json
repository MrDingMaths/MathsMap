  "content": {
    "id": "v2-8a855d2d5-p8-topic-slot-2-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Find the $y$-intercept of the tangent to $y=3e^x$ at the point where $x=t$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=3e^t(1-t)$",
      "worked": "At $x=t$, the point is $(t,3e^t)$.\n$$\\begin{align*}\\frac{dy}{dx}&=3e^x\\\\m&=3e^t\\end{align*}$$\nThe tangent is\n$$\\begin{align*}y-3e^t&=3e^t(x-t)\\end{align*}$$\nAt the $y$-intercept, $x=0$:\n$$\\begin{align*}y&=3e^t-3te^t\\\\&=3e^t(1-t)\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
