              "inlines": [
                {
                  "type": "text",
                  "text": "If the student continues to take 80% reduction photocopies, what are the dimensions of the picture after:",
                  "marks": []
                }
              ]
            },
            {
              "id": "p29-q3-c-instruction",
              "type": "paragraph",
