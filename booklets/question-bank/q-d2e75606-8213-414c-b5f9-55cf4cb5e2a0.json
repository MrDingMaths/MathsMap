  "content": {
    "id": "p29-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A student is using a photocopy machine to reduce a picture of dimensions $170\\text{ mm}\\times125\\text{ mm}$. He sets the photocopier on 80% reduction (that is, each length in the photocopy will be 80% of its original length).",
