      }
    ],
    "children": [
      {
        "id": "p29-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What are the dimensions of the photocopy of the picture?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\text{ mm}\\times136\\text{ mm}$",
          "worked": "$\\begin{align*}125\\times0.8&=100\\text{ mm}\\\\170\\times0.8&=136\\text{ mm}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p29-q3-b",
        "type": "part",
