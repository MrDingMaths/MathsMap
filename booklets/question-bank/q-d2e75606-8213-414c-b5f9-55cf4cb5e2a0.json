              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "In each case, express your answer in terms of a power of 0.8.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p29-q3-c-i",
            "type": "part",
            "label": "i",
            "prompt": "3 photocopies?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$125\\times0.8^3\\text{ mm}\\times170\\times0.8^3\\text{ mm}$",
              "worked": "Each length is multiplied by $0.8$ three times.\n\n$\\begin{align*}w_3&=125\\times0.8^3\\text{ mm}\\\\h_3&=170\\times0.8^3\\text{ mm}\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p29-q3-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "4 photocopies?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$125\\times0.8^4\\text{ mm}\\times170\\times0.8^4\\text{ mm}$",
              "worked": "Each length is multiplied by $0.8$ four times.\n\n$\\begin{align*}w_4&=125\\times0.8^4\\text{ mm}\\\\h_4&=170\\times0.8^4\\text{ mm}\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p29-q3-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$n$ photocopies?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$125\\times0.8^n\\text{ mm}\\times170\\times0.8^n\\text{ mm}$",
              "worked": "Each length is multiplied by $0.8$ on each of the $n$ photocopies.\n\n$\\begin{align*}w_n&=125\\times0.8^n\\text{ mm}\\\\h_n&=170\\times0.8^n\\text{ mm}\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p30-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the area of the original picture?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21\\,250\\text{ mm}^2$",
          "worked": "$A_0=125\\times170=21\\,250\\text{ mm}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p30-q3-e",
        "type": "group",
        "label": "e",
        "prompt": "What is the area of the picture after:\n\nIn each case, express your answers in terms of a power of 0.8.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q3-e-i",
            "type": "part",
            "label": "i",
            "prompt": "1 photocopy?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$21\\,250\\times0.8^2\\text{ mm}^2$",
              "worked": "$\\begin{align*}A_1&=(125\\times0.8)(170\\times0.8)\\\\A_1&=21\\,250\\times0.8^2\\text{ mm}^2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p30-q3-e-ii",
            "type": "part",
            "label": "ii",
            "prompt": "2 photocopies?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$21\\,250\\times0.8^4\\text{ mm}^2$",
              "worked": "$\\begin{align*}A_2&=(125\\times0.8^2)(170\\times0.8^2)\\\\A_2&=21\\,250\\times0.8^4\\text{ mm}^2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p30-q3-e-iii",
            "type": "part",
            "label": "iii",
            "prompt": "3 photocopies?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$21\\,250\\times0.8^6\\text{ mm}^2$",
              "worked": "$\\begin{align*}A_3&=(125\\times0.8^3)(170\\times0.8^3)\\\\A_3&=21\\,250\\times0.8^6\\text{ mm}^2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p30-q3-e-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$n$ photocopies?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$21\\,250\\times0.8^{2n}\\text{ mm}^2$\n\nBoth dimensions have multiplier $0.8^n$, so the area multiplier is $0.8^{2n}$.",
              "worked": "$\\begin{align*}A_n&=(125\\times0.8^n)(170\\times0.8^n)\\\\A_n&=21\\,250\\times0.8^{n+n}\\\\A_n&=21\\,250\\times0.8^{2n}\\text{ mm}^2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          }
        ]
      },
      {
        "id": "p30-q3-f",
        "type": "group",
        "label": "f",
        "prompt": "If the student started with a picture of dimensions $x\\text{ cm}\\times y\\text{ cm}$, and successive photocopies are taken with reduction 80%:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q3-f-i",
            "type": "part",
            "label": "i",
            "prompt": "what are the dimensions of the picture after $n$ photocopies?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x\\times0.8^n\\text{ cm}\\times y\\times0.8^n\\text{ cm}$",
              "worked": "Each original dimension has multiplier $0.8^n$.\n\n$\\begin{align*}w_n&=x\\times0.8^n\\text{ cm}\\\\h_n&=y\\times0.8^n\\text{ cm}\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p30-q3-f-ii",
            "type": "part",
            "label": "ii",
            "prompt": "what is the area of the picture after $n$ photocopies?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$xy\\times0.8^{2n}\\text{ cm}^2$\n\nMultiply the two reduced dimensions and add the indices of $0.8$.",
              "worked": "$\\begin{align*}A_n&=(x\\times0.8^n)(y\\times0.8^n)\\\\A_n&=xy\\times0.8^{n+n}\\\\A_n&=xy\\times0.8^{2n}\\text{ cm}^2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          }
        ]
      }
    ],
