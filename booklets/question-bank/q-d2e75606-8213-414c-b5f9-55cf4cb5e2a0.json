        "prompt": "What are the dimensions of the photocopy of the photocopy?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80\\text{ mm}\\times108.8\\text{ mm}$",
          "worked": "$\\begin{align*}100\\times0.8&=80\\text{ mm}\\\\136\\times0.8&=108.8\\text{ mm}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p29-q3-c",
        "type": "group",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
