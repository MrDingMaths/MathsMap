        "label": "a",
        "prompt": "Find $f(g(8))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-51$",
          "worked": "$$\\begin{align*}g(8)&=-3(8)-2\\\\g(8)&=-26\\\\f(g(8))&=2(-26)+1\\\\f(g(8))&=-51\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p140-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the rule for $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=-6x-3$",
          "worked": "$$\\begin{align*}f(g(x))&=f(-3x-2)\\\\f(g(x))&=2(-3x-2)+1\\\\f(g(x))&=-6x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p140-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve for $a$, given $f(g(a))=21$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-4$",
          "worked": "$$\\begin{align*}-6a-3&=21\\\\-6a&=24\\\\a&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
