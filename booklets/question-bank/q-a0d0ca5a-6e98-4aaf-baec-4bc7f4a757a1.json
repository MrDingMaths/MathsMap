  "content": {
    "id": "p8-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "If $\\dfrac{x}{a}+b=\\dfrac{c}{d}$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "solve the equation for $x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{ac}{d}-ab$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=\\frac{c}{d}-b\\\\x&=a\\left(\\frac{c}{d}-b\\right)\\\\x&=\\frac{ac}{d}-ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q11-b",
        "type": "group",
        "label": "b",
        "prompt": "use the formula you found in part a to solve for $x$:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q11-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\dfrac{x}{2}+3=\\dfrac{3}{7}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-\\dfrac{36}{7}$",
              "worked": "Here $a=2$, $b=3$, $c=3$ and $d=7$.\n\n$$\\begin{align*}x&=\\frac{ac}{d}-ab\\\\x&=\\frac{2\\times3}{7}-2\\times3\\\\x&=\\frac{6}{7}-\\frac{42}{7}\\\\x&=-\\frac{36}{7}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p8-q11-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\dfrac{x}{2}-\\dfrac{1}{2}=\\dfrac{1}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=2$",
              "worked": "Here $a=2$, $b=-\\frac12$, $c=1$ and $d=2$.\n\n$$\\begin{align*}x&=\\frac{ac}{d}-ab\\\\x&=\\frac{2\\times1}{2}-2\\left(-\\frac12\\right)\\\\x&=1+1\\\\x&=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p8-q11-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$3x-\\dfrac{1}{3}=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\dfrac{10}{9}$",
              "worked": "Write $3x=\\dfrac{x}{\\frac{1}{3}}$. Here $a=\\frac13$, $b=-\\frac13$, $c=3$ and $d=1$.\n\n$$\\begin{align*}x&=\\frac{ac}{d}-ab\\\\x&=\\frac{(\\frac13)\\times3}{1}-\\frac13\\left(-\\frac13\\right)\\\\x&=1+\\frac19\\\\x&=\\frac{10}{9}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      }
    ]
  },
