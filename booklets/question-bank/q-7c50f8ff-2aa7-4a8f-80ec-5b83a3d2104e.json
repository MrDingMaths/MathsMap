  "content": {
    "id": "p15-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A card is drawn from a standard deck of 52 cards. Find the probability that the card:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "is red given that it is a king",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "Of the 4 kings, 2 are red.\n$$\\Pr(\\text{red}\\mid\\text{king})=\\frac24=\\frac12.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "is a king given that it is red",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{13}$",
          "worked": "Of the 26 red cards, 2 are kings.\n$$\\Pr(\\text{king}\\mid\\text{red})=\\frac2{26}=\\frac1{13}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "is a heart given that it is a queen",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "Of the 4 queens, 1 is a heart.\n$$\\Pr(\\text{heart}\\mid\\text{queen})=\\frac14.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "is a queen given that it is a heart",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{13}$",
          "worked": "Of the 13 hearts, 1 is a queen.\n$$\\Pr(\\text{queen}\\mid\\text{heart})=\\frac1{13}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "is a king given that it is a queen",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No queen is a king.\n$$\\Pr(\\text{king}\\mid\\text{queen})=\\frac04=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "is red given that it is a heart",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "All 13 hearts are red.\n$$\\Pr(\\text{red}\\mid\\text{heart})=\\frac{13}{13}=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "is a heart given that it is red.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "Of the 26 red cards, 13 are hearts.\n$$\\Pr(\\text{heart}\\mid\\text{red})=\\frac{13}{26}=\\frac12.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
