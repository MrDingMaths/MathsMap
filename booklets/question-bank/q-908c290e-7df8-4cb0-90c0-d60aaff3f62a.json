  "content": {
    "id": "p3-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the value of $n$ if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^{2n}-(17\\times2^n)+16=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=0$ or $n=4$.\n\nSubstitute $y=2^n$ and factorise.",
          "worked": "Let $y=2^n$.\n$$\\begin{align*}y^2-17y+16&=0\\\\(y-1)(y-16)&=0\\end{align*}$$\nBy the null factor law, $y=1$ or $y=16$.\n$$\\begin{align*}2^n&=1\\text{ or }2^n=16\\\\2^n&=2^0\\text{ or }2^n=2^4\\\\n&=0\\text{ or }n=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p3-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{2n}-(20\\times2^n)+64=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=2$ or $n=4$.\n\nSubstitute $y=2^n$ and factorise.",
          "worked": "Let $y=2^n$.\n$$\\begin{align*}y^2-20y+64&=0\\\\(y-4)(y-16)&=0\\end{align*}$$\nBy the null factor law, $y=4$ or $y=16$.\n$$\\begin{align*}2^n&=4\\text{ or }2^n=16\\\\2^n&=2^2\\text{ or }2^n=2^4\\\\n&=2\\text{ or }n=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p3-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^{2n+1}-(28\\times3^n)+9=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-1$ or $n=2$.\n\nSubstitute $y=3^n$ and factorise.",
          "worked": "Let $y=3^n$, so $3^{2n+1}=3y^2$.\n$$\\begin{align*}3y^2-28y+9&=0\\\\(3y-1)(y-9)&=0\\end{align*}$$\nBy the null factor law, $y=\\frac13$ or $y=9$.\n$$\\begin{align*}3^n&=\\frac13\\text{ or }3^n=9\\\\3^n&=3^{-1}\\text{ or }3^n=3^2\\\\n&=-1\\text{ or }n=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
