  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A quadrilateral has vertices $P(-7,2)$, $Q(2,-7)$, $R(5,-4)$ and $S(-4,5)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the lengths of $PR$ and $QS$ in surd form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$PR=QS=6\\sqrt{5}$.",
          "worked": "$$\\begin{align*}PR&=\\sqrt{(5-(-7))^2+(-4-2)^2}\\\\PR&=\\sqrt{180}=6\\sqrt{5}\\\\QS&=\\sqrt{(-4-2)^2+(5-(-7))^2}\\\\QS&=\\sqrt{180}=6\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the midpoints of $PR$ and $QS$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both midpoints are $(-1,-1)$.",
          "worked": "$$\\begin{align*}M_{PR}&=\\left(\\frac{-7+5}{2},\\frac{2+(-4)}{2}\\right)\\\\M_{PR}&=(-1,-1)\\\\M_{QS}&=\\left(\\frac{2+(-4)}{2},\\frac{-7+5}{2}\\right)\\\\M_{QS}&=(-1,-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Is $PR$ perpendicular to $QS$? Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. $m_{PR}=-\\frac12$ and $m_{QS}=-2$, so their product is $1\\ne-1$.",
          "worked": "$$\\begin{align*}m_{PR}&=\\frac{-4-2}{5-(-7)}=-\\frac12\\\\m_{QS}&=\\frac{5-(-7)}{-4-2}=-2\\\\m_{PR}m_{QS}&=\\left(-\\frac12\\right)(-2)=1\\end{align*}$$\n$PR$ is not perpendicular to $QS$, because the product of their gradients is not $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "What type of quadrilateral is $PQRS$? Explain.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rectangle: its diagonals are equal and bisect each other at $(-1,-1)$. It is not a rhombus because its diagonals are not perpendicular.",
          "worked": "$PR=QS=6\\sqrt5$, and both diagonals have midpoint $(-1,-1)$. The diagonals are equal and bisect each other, so $PQRS$ is a rectangle. Its diagonals are not perpendicular, so it is not a rhombus.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
