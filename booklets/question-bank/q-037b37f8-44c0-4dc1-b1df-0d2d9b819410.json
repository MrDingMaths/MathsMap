  "content": {
    "id": "p52-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Beca says that $y=8x+\\sqrt{25}$ and $y=5+8x$ are parallel. Marta says they are not.\nWho do you agree with? Explain your answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Marta. Both equations describe the same line, $y=8x+5$.",
      "worked": "$\\sqrt{25}=5$, so both equations simplify to $y=8x+5$. They have the same gradient and the same $y$-intercept, so they are the same line rather than two distinct parallel lines. Marta is correct.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 22
  },
