      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin 2x+2\\sin x=2\\sin x(\\cos x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=2\\sin x(\\cos x+1)=\\mathrm{RHS}$",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\sin 2x+2\\sin x\\\\&=2\\sin x\\cos x+2\\sin x\\\\&=2\\sin x(\\cos x+1)\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos 2x+\\cos^2x=3\\cos^2x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=3\\cos^2x-1=\\mathrm{RHS}$",
          "worked": "Using $\\cos 2x=2\\cos^2x-1$,\n$$\\begin{aligned}\\mathrm{LHS}&=\\cos 2x+\\cos^2x\\\\&=(2\\cos^2x-1)+\\cos^2x\\\\&=3\\cos^2x-1\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos 2x-\\sin^2x=1-3\\sin^2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1-3\\sin^2x=\\mathrm{RHS}$",
          "worked": "Using $\\cos 2x=1-2\\sin^2x$,\n$$\\begin{aligned}\\mathrm{LHS}&=\\cos 2x-\\sin^2x\\\\&=(1-2\\sin^2x)-\\sin^2x\\\\&=1-3\\sin^2x\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sin 2x}{\\sin x}=2\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=2\\cos x=\\mathrm{RHS}$",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{\\sin 2x}{\\sin x}\\\\&=\\frac{2\\sin x\\cos x}{\\sin x}\\\\&=2\\cos x\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\sin 2x}{(1+\\cos 2x)}=\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\tan x=\\mathrm{RHS}$",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=(\\sin 2x)/(1+\\cos 2x)\\\\&=(2\\sin x\\cos x)/(1+2\\cos^2x-1)\\\\&=(2\\sin x\\cos x)/(2\\cos^2x)\\\\&=(\\sin x)/(\\cos x)\\\\&=\\tan x\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p7-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(1-\\cos 2x)}{\\sin x}=2\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=2\\sin x=\\mathrm{RHS}$",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{1-\\cos 2x}{\\sin x}\\\\&=\\frac{1-(1-2\\sin^2x)}{\\sin x}\\\\&=\\frac{2\\sin^2x}{\\sin x}\\\\&=2\\sin x\\\\&=\\mathrm{RHS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
