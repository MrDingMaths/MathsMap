  "content": {
    "id": "p18-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Show, by evaluating the definite integrals, that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\int_0^1 6x^2\\,dx=6\\int_0^1x^2\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\mathrm{RHS}=2$.",
          "worked": "LHS:\n$$\\begin{aligned}\\int_0^1 6x^2\\,dx&=\\left[2x^3\\right]_0^1\\\\&=2\\end{aligned}$$\nRHS:\n$$\\begin{aligned}6\\int_0^1x^2\\,dx&=6\\left[\\frac{x^3}{3}\\right]_0^1\\\\&=6\\left(\\frac13\\right)\\\\&=2\\end{aligned}$$\nThus $\\mathrm{LHS}=\\mathrm{RHS}=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p18-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\int_{-1}^2(x^3+x^2)\\,dx=\\int_{-1}^2x^3\\,dx+\\int_{-1}^2x^2\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\mathrm{RHS}=\\dfrac{27}{4}$.",
          "worked": "LHS:\n$$\\begin{aligned}\\int_{-1}^2(x^3+x^2)\\,dx&=\\left[\\frac{x^4}{4}+\\frac{x^3}{3}\\right]_{-1}^2\\\\&=\\left(4+\\frac83\\right)-\\left(\\frac14-\\frac13\\right)\\\\&=\\frac{27}{4}\\end{aligned}$$\nRHS:\n$$\\begin{aligned}\\int_{-1}^2x^3\\,dx+\\int_{-1}^2x^2\\,dx&=\\left[\\frac{x^4}{4}\\right]_{-1}^2+\\left[\\frac{x^3}{3}\\right]_{-1}^2\\\\&=\\left(4-\\frac14\\right)+\\left(\\frac83+\\frac13\\right)\\\\&=\\frac{15}{4}+3\\\\&=\\frac{27}{4}\\end{aligned}$$\nThus $\\mathrm{LHS}=\\mathrm{RHS}=\\dfrac{27}{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p18-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\int_0^3(x^2-4x+3)\\,dx=\\int_0^2(x^2-4x+3)\\,dx+\\int_2^3(x^2-4x+3)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\mathrm{RHS}=0$.",
          "worked": "LHS:\n$$\\begin{aligned}\\int_0^3(x^2-4x+3)\\,dx&=\\left[\\frac{x^3}{3}-2x^2+3x\\right]_0^3\\\\&=(9-18+9)-0\\\\&=0\\end{aligned}$$\nRHS:\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int_0^2(x^2-4x+3)\\,dx+\\int_2^3(x^2-4x+3)\\,dx\\\\&=\\left[\\frac{x^3}{3}-2x^2+3x\\right]_0^2+\\left[\\frac{x^3}{3}-2x^2+3x\\right]_2^3\\\\&=\\left(\\frac83-8+6\\right)+\\left((9-18+9)-\\left(\\frac83-8+6\\right)\\right)\\\\&=0\\end{aligned}$$\nThus $\\mathrm{LHS}=\\mathrm{RHS}=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
