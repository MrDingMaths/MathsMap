  "content": {
    "id": "p41-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A right-angled triangle has sides of 5, 12 and 13 cm. Find its area.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$30\\text{ cm}^2$",
      "worked": "The longest side, $13\\text{ cm}$, is the hypotenuse, so the perpendicular sides are $5\\text{ cm}$ and $12\\text{ cm}$.\n$$\\begin{align*}A&=\\frac12 bh\\\\A&=\\frac12\\times5\\times12\\\\A&=30\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
