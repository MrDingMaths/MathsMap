  "content": {
    "id": "p45-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Given four numbers, $a,b,c,d$ satisfy the proportion $\\dfrac{a}{b}=\\dfrac{c}{d}$, prove they also satisfy the following. Assume all displayed denominators are non-zero.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{a}{c}=\\frac{b}{d}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a}{c}=\\dfrac{\\frac{bc}{d}}{c}=\\dfrac{b}{d}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p45-q7-shared-preparation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "From ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{a}{b}=\\frac{c}{d}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a=\\frac{bc}{d}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " (so ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "ad=bc",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ").",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p45-q7-a-proof",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\mathrm{LHS}&=\\frac{a}{c}\\\\&=\\frac{\\frac{bc}{d}}{c}\\\\&=\\frac{b}{d}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p45-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{a+b}{b}=\\frac{c+d}{d}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a+b}{b}=\\dfrac{a}{b}+1=\\dfrac{c}{d}+1=\\dfrac{c+d}{d}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{a+b}{b}\\\\&=\\frac{a}{b}+1\\\\&=\\frac{c}{d}+1\\\\&=\\frac{c+d}{d}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p45-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{a-b}{b}=\\frac{c-d}{d}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a-b}{b}=\\dfrac{a}{b}-1=\\dfrac{c}{d}-1=\\dfrac{c-d}{d}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{a-b}{b}\\\\&=\\frac{a}{b}-1\\\\&=\\frac{c}{d}-1\\\\&=\\frac{c-d}{d}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p45-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{a+b}{a-b}=\\frac{c+d}{c-d}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a+b}{a-b}=\\dfrac{\\frac{a}{b}+1}{\\frac{a}{b}-1}=\\dfrac{\\frac{c}{d}+1}{\\frac{c}{d}-1}=\\dfrac{c+d}{c-d}$.",
          "worked": "$$\\begin{aligned}\\mathrm{LHS}&=\\frac{a+b}{a-b}\\\\&=\\frac{(a+b)/b}{(a-b)/b}\\\\&=\\frac{(c+d)/d}{(c-d)/d}\\\\&=\\frac{c+d}{c-d}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p45-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{a}{b}=\\frac{a+c}{b+d}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Since $a+c=\\dfrac{c(b+d)}{d}$, $\\dfrac{a+c}{b+d}=\\dfrac{c}{d}=\\dfrac{a}{b}$.",
          "worked": "$$\\begin{aligned}a+c&=\\frac{bc}{d}+c\\\\&=\\frac{c(b+d)}{d}\\end{aligned}$$\nTherefore,\n$$\\begin{aligned}\\mathrm{RHS}&=\\frac{a+c}{b+d}\\\\&=\\frac{c}{d}\\\\&=\\frac{a}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
    ]
  },
