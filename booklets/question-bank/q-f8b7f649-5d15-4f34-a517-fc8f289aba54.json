  "content": {
    "id": "p80-q32-root",
    "type": "question",
    "label": "",
    "prompt": "A survey has eight 'Yes/No'-type questions.\nHow many ways can the survey be answered if there are",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p80-q32-a",
        "type": "part",
        "label": "a",
        "prompt": "no restrictions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "256",
          "worked": "Each of the eight questions has two possible answers.\n$$2^8=256.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p80-q32-b",
        "type": "part",
        "label": "b",
        "prompt": "exactly three 'No' answers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "56",
          "worked": "Choose which three questions receive 'No'; the others receive 'Yes'.\n$$\\binom{8}{3}=56.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p80-q32-c",
        "type": "part",
        "label": "c",
        "prompt": "at least two 'No' answers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "247",
          "worked": "Subtract the cases of zero or one 'No' from all possible responses.\n$$\\begin{aligned}N&=2^8-\\binom{8}{0}-\\binom{8}{1}\\\\&=256-1-8\\\\&=247.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p80-q32-d",
        "type": "part",
        "label": "d",
        "prompt": "at least six 'Yes' answers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "37",
          "worked": "Count the cases of six, seven or eight 'Yes' answers.\n$$\\begin{aligned}N&=\\binom{8}{2}+\\binom{8}{1}+\\binom{8}{0}\\\\&=28+8+1\\\\&=37.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p80-q32-e",
        "type": "part",
        "label": "e",
        "prompt": "at most two 'No' answers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "37",
          "worked": "At most two 'No' answers is equivalent to at least six 'Yes' answers, as in part d.\n$$\\binom{8}{0}+\\binom{8}{1}+\\binom{8}{2}=37.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p80-q32-f",
        "type": "part",
        "label": "f",
        "prompt": "at most six 'Yes' answers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "247",
          "worked": "At most six 'Yes' answers is equivalent to at least two 'No' answers, as in part c.\n$$2^8-\\binom{8}{0}-\\binom{8}{1}=247.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
