  "content": {
    "id": "p59-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "For what values of $x$ does the function $f(x)=\\dfrac{1}{4x-1}$ have $f'(x)=-\\dfrac{4}{49}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=2$ or $x=-\\dfrac{3}{2}$.",
      "worked": "$$\\begin{align*}f(x)&=(4x-1)^{-1}\\\\f'(x)&=-(4x-1)^{-2}\\times4\\\\f'(x)&=-\\frac{4}{(4x-1)^2}\\end{align*}$$\n$$\\begin{align*}-\\frac{4}{(4x-1)^2}&=-\\frac{4}{49}\\\\(4x-1)^2&=49\\\\4x-1&=\\pm7\\\\x&=2\\text{ or }-\\frac{3}{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
