    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q50-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $R>0$ and $0<\\alpha<\\frac\\pi2$ if\n$$\\cos\\theta+\\cos\\left(\\theta+\\frac\\pi3\\right)=R\\cos(\\theta+\\alpha).$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=\\sqrt3$, $\\alpha=\\frac\\pi6$.",
          "worked": "$$\\begin{align*}\\cos\\theta+\\cos\\left(\\theta+\\frac\\pi3\\right)&=\\cos\\theta+\\frac12\\cos\\theta-\\frac{\\sqrt3}{2}\\sin\\theta\\\\\\cos\\theta+\\cos\\left(\\theta+\\frac\\pi3\\right)&=\\frac32\\cos\\theta-\\frac{\\sqrt3}{2}\\sin\\theta.\\end{align*}$$\nMatching coefficients with $R\\cos(\\theta+\\alpha)$ gives $R\\cos\\alpha=\\frac32$ and $R\\sin\\alpha=\\frac{\\sqrt3}{2}$.\n$$\\begin{align*}R&=\\sqrt{\\left(\\frac32\\right)^2+\\left(\\frac{\\sqrt3}{2}\\right)^2}=\\sqrt3\\\\\\tan\\alpha&=\\frac{\\sqrt3}{3}\\\\\\alpha&=\\frac\\pi6.\\end{align*}$$\nThe specified first-quadrant interval determines $\\alpha$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p39-q50-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, solve the equation for $0\\le\\theta\\le2\\pi$:\n$$\\cos\\theta+\\cos\\left(\\theta+\\frac\\pi3\\right)=\\frac{\\sqrt3}{2}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac\\pi6,\\ \\frac{3\\pi}{2}$.",
          "worked": "$$\\begin{align*}\\sqrt3\\cos\\left(\\theta+\\frac\\pi6\\right)&=\\frac{\\sqrt3}{2}\\\\\\cos\\left(\\theta+\\frac\\pi6\\right)&=\\frac12.\\end{align*}$$\nSince $\\frac\\pi6\\le\\theta+\\frac\\pi6\\le\\frac{13\\pi}{6}$,\n$$\\begin{align*}\\theta+\\frac\\pi6&=\\frac\\pi3,\\ \\frac{5\\pi}{3}\\\\\\theta&=\\frac\\pi6,\\ \\frac{3\\pi}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
