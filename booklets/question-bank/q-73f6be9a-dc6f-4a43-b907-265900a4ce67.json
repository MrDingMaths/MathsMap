        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{align*}P(\\text{Year 11})&=x\\\\P(\\text{Year 11})&=1-(0.3+0.15+0.1+0.05)\\\\P(\\text{Year 11})&=1-0.6\\\\P(\\text{Year 11})&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p40-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(\\text{Year 7 or Year 8})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.45$",
          "worked": "The year groups are mutually exclusive.\n$$\\begin{align*}P(\\text{Year 7 or Year 8})&=P(\\text{Year 7})+P(\\text{Year 8})\\\\P(\\text{Year 7 or Year 8})&=0.3+0.15\\\\P(\\text{Year 7 or Year 8})&=0.45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p40-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(\\text{not Year 9})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9$",
          "worked": "$$\\begin{align*}P(\\text{not Year 9})&=1-P(\\text{Year 9})\\\\P(\\text{not Year 9})&=1-0.1\\\\P(\\text{not Year 9})&=0.9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
