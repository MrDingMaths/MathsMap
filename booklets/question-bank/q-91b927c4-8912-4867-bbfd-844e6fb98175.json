  "content": {
    "id": "p33-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Give money answers to the nearest cent and percentage increases to 2 decimal places where needed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q2-a",
        "type": "group",
        "label": "a",
        "prompt": "Gary has borrowed $\\$200\\,000$ for six years at $8\\%$ p.a. interest, compounded annually, in order to start his indoor decorating business. He intends to pay the whole amount back, plus interest, at the end of the six years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p33-q2-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Find the amount owing after one year.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$216\\,000$",
              "worked": "$$\\begin{align*}A_1&=200\\,000\\times1.08\\\\A_1&=\\$216\\,000\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q2-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find the amount owing after two years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$233\\,280$",
              "worked": "$$\\begin{align*}A_2&=200\\,000\\times(1.08)^2\\\\A_2&=\\$233\\,280\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q2-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Find the amount owing after six years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$317\\,374.86$",
              "worked": "$$\\begin{align*}A_6&=200\\,000\\times(1.08)^6\\\\A_6&\\approx\\$317\\,374.86\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q2-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "Find the percentage increase in the loan over the six years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$58.69\\%$",
              "worked": "$$\\begin{align*}\\text{Percentage increase}&=((1.08)^6-1)\\times100\\%\\\\\\text{Percentage increase}&\\approx58.69\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q2-a-v",
            "type": "part",
            "label": "v",
            "prompt": "Find the total interest charged over the six years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$117\\,374.86$",
              "worked": "$$\\begin{align*}I&=200\\,000(1.08)^6-200\\,000\\\\I&\\approx\\$117\\,374.86\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p33-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the simple interest on the principal of $\\$200\\,000$ over the six years at the same rate of $8\\%$ p.a.",
