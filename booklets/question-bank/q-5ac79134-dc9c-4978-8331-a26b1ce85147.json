  "content": {
    "id": "p7-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "How many serial numbers are there of the form JVJ24601, i.e. three letters followed by five digits?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$26^3\\times10^5$",
      "worked": "Each letter position has 26 choices and each digit position has 10 choices. Repetitions are allowed, as shown by the repeated J in JVJ24601.\n$$N=26^3\\times10^5=1\\,757\\,600\\,000.$$\nThere are $1\\,757\\,600\\,000$ serial numbers.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
