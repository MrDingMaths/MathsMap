    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q76-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(x)=1+\\dfrac{4}{x-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=1+\\dfrac{4}{x-1}$ for $x\\ne1$.\n\nCombine the terms over $x-1$.",
          "worked": "For $x\\ne1$,\n$$\\begin{align*}f(x)&=1+\\frac{4}{x-1}\\\\f(x)&=\\frac{x-1+4}{x-1}\\\\f(x)&=\\frac{x+3}{x-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p29-q76-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\dfrac{4}{(x-1)^2}$, $x\\ne1$.\n\nDifferentiate the rewritten form from part (a).",
          "worked": "From part (a), $f(x)=1+4(x-1)^{-1}$. Hence\n$$\\begin{align*}f'(x)&=0+4[-(x-1)^{-2}](1)\\\\f'(x)&=-\\frac{4}{(x-1)^2},\\qquad x\\ne1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
