  "content": {
    "id": "p44-task-6-9-root",
    "type": "question",
    "label": null,
    "prompt": "Write down the resulting equation after applying the given transformation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q6",
        "type": "part",
        "label": "a",
        "prompt": "Dilate $y=\\sqrt{x}$ horizontally by a scale factor $\\frac14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2\\sqrt{x}$",
          "worked": "Replace $x$ by $x\\div\\frac14=4x$.\n$$\\begin{align*}y&=\\sqrt{4x}\\\\y&=2\\sqrt{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q7",
        "type": "part",
        "label": "b",
        "prompt": "Dilate $y=\\frac{1}{x+2}$ horizontally by a scale factor $\\frac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{2x+2}$",
          "worked": "Replace $x$ by $x\\div\\frac12=2x$.\n$$\\begin{align*}y&=\\frac{1}{x/\\left(\\frac12\\right)+2}\\\\y&=\\frac{1}{2x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p44-q8",
        "type": "part",
        "label": "c",
        "prompt": "Dilate $y=2x^3$ vertically by a scale factor $5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=10x^3$",
          "worked": "Replace $y$ by $\\frac{y}{5}$.\n$$\\begin{align*}\\frac{y}{5}&=2x^3\\\\y&=10x^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q9",
        "type": "part",
        "label": "d",
        "prompt": "Dilate $y=\\sqrt{x+2}$ vertically by a scale factor $\\frac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{\\sqrt{x+2}}{2}$",
          "worked": "Replace $y$ by $y\\div\\frac12=2y$.\n$$\\begin{align*}2y&=\\sqrt{x+2}\\\\y&=\\frac{\\sqrt{x+2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
