    "type": "question",
    "label": null,
    "prompt": "List all the permutations of the letters PQRS, taken three at a time. How many are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "PQR, PQS, PRQ, PRS, PSQ, PSR; QPR, QPS, QRP, QRS, QSP, QSR; RPQ, RPS, RQP, RQS, RSP, RSQ; SPQ, SPR, SQP, SQR, SRP, SRQ; $24$ permutations.",
      "worked": "Starting with P: PQR, PQS, PRQ, PRS, PSQ, PSR.\n\nStarting with Q: QPR, QPS, QRP, QRS, QSP, QSR.\n\nStarting with R: RPQ, RPS, RQP, RQS, RSP, RSQ.\n\nStarting with S: SPQ, SPR, SQP, SQR, SRP, SRQ.\n\n$\\begin{aligned}{}^{4}P_{3}&=4\\times3\\times2\\\\&=24\\end{aligned}$",
      "solutionDiagrams": []
    },
