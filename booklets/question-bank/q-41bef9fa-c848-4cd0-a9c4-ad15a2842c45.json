  "content": {
    "id": "p5-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Solve each of the following equations for $x$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$(20\\%\\text{ of }x)+5=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}0.2x+5&=6\\\\0.2x&=1\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$40\\%\\text{ of }(x-2)=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=27$",
          "worked": "$$\\begin{align*}0.4(x-2)&=10\\\\x-2&=25\\\\x&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$(125\\%\\text{ of }x)-10=80$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=72$",
          "worked": "$$\\begin{align*}1.25x-10&=80\\\\1.25x&=90\\\\x&=72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$140\\%\\text{ of }(x-3)=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{21}{2}$\n\nConvert the percentage to a decimal and collect the $x$ terms.",
          "worked": "$$\\begin{align*}1.4(x-3)&=x\\\\1.4x-4.2&=x\\\\0.4x&=4.2\\\\x&=\\frac{21}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
