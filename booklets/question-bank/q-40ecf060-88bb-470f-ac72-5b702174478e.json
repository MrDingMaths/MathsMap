  "content": {
    "id": "v2-p48-practice-slot-12-root",
    "type": "question",
    "label": null,
    "prompt": "A tractor worth \\$180 000 loses 12% of its value per year.\nAfter how many whole years will its value first fall below \\$60 000?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "9 years",
      "worked": "Let $n$ be the number of years, with $n$ a nonnegative integer.\n$$\\begin{align*}180000(0.88)^n&=60000\\\\(0.88)^n&=\\frac13\\\\n&=\\log_{0.88}\\left(\\frac13\\right)\\approx8.59\\end{align*}$$\nThe value decreases each year, so it first falls below \\$60 000 after 9 whole years.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
