  "content": {
    "id": "p8-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Use shifting, and completion of squares where necessary, to determine the centre and radius of each circle.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)^2+y^2=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-1,0)$, radius $2$.",
          "worked": "$$(x-(-1))^2+(y-0)^2=2^2.$$\nThe centre is $(-1,0)$ and the radius is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p8-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-1)^2+(y-2)^2=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(1,2)$, radius $1$.",
          "worked": "$$(x-1)^2+(y-2)^2=1^2.$$\nThe centre is $(1,2)$ and the radius is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p8-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-2x+y^2-4y-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(1,2)$, radius $3$.",
          "worked": "$$\\begin{align*}x^2-2x+y^2-4y&=4\\\\(x-1)^2-1+(y-2)^2-4&=4\\\\(x-1)^2+(y-2)^2&=9\\end{align*}$$\nThe centre is $(1,2)$ and the radius is $\\sqrt9=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+6x+y^2-8y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-3,4)$, radius $5$.",
          "worked": "$$\\begin{align*}x^2+6x+y^2-8y&=0\\\\(x+3)^2-9+(y-4)^2-16&=0\\\\(x+3)^2+(y-4)^2&=25\\end{align*}$$\nThe centre is $(-3,4)$ and the radius is $\\sqrt{25}=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-10x+y^2+8y+32=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(5,-4)$, radius $3$.",
          "worked": "$$\\begin{align*}x^2-10x+y^2+8y&=-32\\\\(x-5)^2-25+(y+4)^2-16&=-32\\\\(x-5)^2+(y+4)^2&=9\\end{align*}$$\nThe centre is $(5,-4)$ and the radius is $\\sqrt9=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2+14x+14+y^2-2y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-7,1)$, radius $6$.",
          "worked": "$$\\begin{align*}x^2+14x+y^2-2y&=-14\\\\(x+7)^2-49+(y-1)^2-1&=-14\\\\(x+7)^2+(y-1)^2&=36\\end{align*}$$\nThe centre is $(-7,1)$ and the radius is $\\sqrt{36}=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
