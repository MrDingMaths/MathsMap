    "prompt": "Find the number of multiples of 11 between 1000 and 2000.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "91 multiples.",
      "worked": "The positive multiples of 11 are $a_n=11n$.\n$$\\begin{aligned}1000&<11n<2000\\\\\\frac{1000}{11}&<n<\\frac{2000}{11}\\end{aligned}$$\nSince $n$ is an integer, $91\\le n\\le181$.\n\nNumber of multiples: $181-91+1=91$.",
      "solutionDiagrams": []
    },
