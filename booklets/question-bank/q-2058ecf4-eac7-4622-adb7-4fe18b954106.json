      {
        "id": "p34-q42-a",
        "type": "part",
        "label": "a",
        "prompt": "Find expressions for revenue $R(x)$ and cost $C(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R(x)=25x$, $C(x)=5x+1000$ (in dollars).",
          "worked": "The revenue line has intercept $0$.\n\n$$\\begin{align*}m_R&=\\frac{500}{20}=25\\\\R(x)&=25x\\end{align*}$$\n\nReading the cost line gives gradient $5$ and intercept $1000$.\n\n$$C(x)=5x+1000.$$\n\nBoth functions give amounts in dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q42-b",
        "type": "part",
        "label": "b",
        "prompt": "How much does it cost to print each book, not including fixed costs?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p34-q42-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "$5 per book.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The coefficient of $x$ in $C(x)=5x+1000$ is $5$, so the variable printing cost is 5 dollars per book.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p34-q42-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the price that each book is sold for?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p34-q42-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "$25 per book.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$R(x)=25x$, so the selling price is 25 dollars per book.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p34-q42-d",
        "type": "part",
        "label": "d",
        "prompt": "How many books must be sold to break even?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50 books.\n\nSet $R(x)=C(x)$.",
          "worked": "At break-even, $R(x)=C(x)$.\n\n$$\\begin{align*}25x&=5x+1000\\\\20x&=1000\\\\x&=50\\end{align*}$$\n\n50 books must be sold.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q42-e",
        "type": "part",
        "label": "e",
        "prompt": "Find an expression for profit $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=20x-1000$ dollars.",
          "worked": "$$\\begin{align*}P(x)&=R(x)-C(x)\\\\P(x)&=25x-(5x+1000)\\\\P(x)&=20x-1000\\end{align*}$$\n\nProfit is measured in dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q42-f",
        "type": "part",
        "label": "f",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p34-q42-f-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "How many books must be sold for a profit of $2000?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "150 books.\n\nSolve $20x-1000=2000$.",
          "worked": "$$\\begin{align*}20x-1000&=2000\\\\20x&=3000\\\\x&=150\\end{align*}$$\n\n150 books must be sold.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
