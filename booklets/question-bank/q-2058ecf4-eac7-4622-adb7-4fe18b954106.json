        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"revenueBlue\",\"hex\":\"268CFF\",\"reason\":\"Revenue series and its matching legend stroke\"},{\"name\":\"costRed\",\"hex\":\"EF6068\",\"reason\":\"Cost series and its matching legend stroke\"},{\"name\":\"graphGrid\",\"hex\":\"CCCCCC\",\"reason\":\"Pale coordinate grid distinguishes scale guides from axes and functions\"}],\"reference\":\"Source PDF page 34, printed page 98, p34-q42-graph\"}\n\\begin{tikzpicture}[x=0.8mm,y=0.035mm,>=stealth,every node/.style={text=black,font=\\fontsize{10pt}{12pt}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{revenueBlue}{HTML}{268CFF}\n\\definecolor{costRed}{HTML}{EF6068}\n\\definecolor{graphGrid}{HTML}{CCCCCC}\n\\path[use as bounding box] (-16,-200) rectangle (79,1840);\n\\foreach \\xx in {20,40,60} {\n  \\draw[graphGrid,line width=0.25pt] (\\xx,0)--(\\xx,1750);\n}\n\\foreach \\yy in {500,1000,1500} {\n  \\draw[graphGrid,line width=0.25pt] (0,\\yy)--(70,\\yy);\n}\n\\draw[black,line width=0.5pt,->] (0,0)--(71,0);\n\\draw[black,line width=0.5pt,->] (0,0)--(0,1780);\n\\foreach \\xx in {20,40,60} {\n  \\draw[black,line width=0.4pt] (\\xx,0)--(\\xx,35);\n  \\node[anchor=north,yshift=-2pt,font=\\fontsize{8.5pt}{10pt}\\selectfont] at (\\xx,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\xx$\\special{dvisvgm:raw </g>}};\n}\n\\foreach \\yy in {500,1000,1500} {\n  \\draw[black,line width=0.4pt] (0,\\yy)--(1.5,\\yy);\n  \\node[anchor=east,xshift=-2pt,font=\\fontsize{8.5pt}{10pt}\\selectfont] at (0,\\yy) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\yy$\\special{dvisvgm:raw </g>}};\n}\n\\draw[revenueBlue,line width=0.8pt] plot[domain=0:70,samples=2] (\\x,{25*\\x});\n\\draw[costRed,line width=0.8pt] plot[domain=0:70,samples=2] (\\x,{1000+5*\\x});\n\\draw[revenueBlue,line width=0.8pt] (45,1730)--(48,1730);\n\\node[anchor=west,inner sep=1pt] at (49,1730) {$R(x)$};\n\\draw[costRed,line width=0.8pt] (45,1600)--(48,1600);\n\\node[anchor=west,inner sep=1pt] at (49,1600) {$C(x)$};\n\\node[anchor=north west,xshift=1pt,yshift=-3pt] at (71,0) {$x$};\n\\node[anchor=east,xshift=-2pt] at (0,1750) {\\$};\n\\end{tikzpicture}",
