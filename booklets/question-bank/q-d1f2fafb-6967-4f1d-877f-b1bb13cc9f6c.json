    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-5855d-p41-practice-slot-14-slot-14-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the regression line predicting hourly pay $P$ from experience $E$. Give the coefficients to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=24.15+1.66E$.",
          "worked": "Enter experience as $x$ and hourly pay as $y$ in the calculator's two-variable statistics mode. Select linear regression $y=a+bx$.\n$$\\begin{align*}a&=24.146739\\ldots\\\\b&=1.663043\\ldots\\\\P&\\approx24.15+1.66E\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-5855d-p41-practice-slot-14-slot-14-b",
        "type": "part",
        "label": "b",
        "prompt": "Using the rounded equation from part a, predict the hourly pay of a barista with 6 years of experience. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An estimated hourly pay of $\\$34.1$.",
          "worked": "$$\\begin{align*}P&=24.15+1.66(6)\\\\P&=34.11\\\\P&\\approx34.1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-5855d-p41-practice-slot-14-slot-14-c",
        "type": "part",
        "label": "c",
        "prompt": "Using the rounded equation from part a, predict the experience of a barista with an hourly pay of 50 dollars. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An estimated experience of $15.6$ years.",
          "worked": "$$\\begin{align*}50&=24.15+1.66E\\\\1.66E&=25.85\\\\E&=\\frac{25.85}{1.66}\\\\E&\\approx15.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-5855d-p41-practice-slot-14-slot-14-d",
        "type": "part",
        "label": "d",
        "prompt": "Is part b or c an example of extrapolation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Part c: an hourly pay of $\\$50$ is outside the observed range $\\$26$–$\\$43$.",
          "worked": "Part b uses $6$ years of experience, within the observed range $1$–$11$, so it is interpolation. Part c uses an hourly pay of $\\$50$, above the observed range $\\$26$–$\\$43$, so it is extrapolation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
