  "content": {
    "id": "p26-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Recall that there are 100 centimetres in 1 metre and 1000 metres in 1 kilometre.\nWrite expressions for each of the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How many metres are there in $x$ km?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1000x$ m",
          "worked": "$\\begin{align*}\\text{Metres}&=x\\times1000\\\\\\text{Metres}&=1000x\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p26-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How many centimetres are there in $x$ metres?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100x$ cm",
          "worked": "$\\begin{align*}\\text{Centimetres}&=x\\times100\\\\\\text{Centimetres}&=100x\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p26-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "How many centimetres are there in $x$ km?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\,000x$ cm",
          "worked": "There are $1000x$ metres in $x$ km.\n$\\begin{align*}\\text{Centimetres}&=1000x\\times100\\\\\\text{Centimetres}&=100\\,000x\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
