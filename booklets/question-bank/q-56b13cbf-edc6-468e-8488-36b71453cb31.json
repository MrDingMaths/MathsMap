  "content": {
    "id": "v2-c46b1-p29-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Find the value of $k$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-c46b1-p29-practice-slot-5-slot-5-qa",
        "type": "part",
        "label": "a",
        "prompt": "the tangent to $y=x^3+kx$ at $x=1$ is parallel to the line $y=6x+1$,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=3$",
          "worked": "Parallel lines have equal gradients, so the tangent gradient is $6$.\n$$\\begin{align*}\\frac{dy}{dx}&=3x^2+k\\\\6&=3(1)^2+k\\\\k&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "v2-c46b1-p29-practice-slot-5-slot-5-qb",
        "type": "part",
        "label": "b",
        "prompt": "the normal to $y=2x^2-kx$ at $x=1$ is parallel to the line $x+3y-5=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=1$",
          "worked": "$$\\begin{align*}y&=-\\frac13x+\\frac53\\end{align*}$$\nThe normal gradient is $-\\frac13$, so the tangent gradient is\n$$m=-\\frac{1}{-\\frac13}=3.$$\n$$\\begin{align*}\\frac{dy}{dx}&=4x-k\\\\3&=4(1)-k\\\\k&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
