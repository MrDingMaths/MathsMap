  "content": {
    "id": "p7-q11-root",
    "type": "question",
    "label": null,
    "prompt": "Show that $\\log_a(b)\\times\\log_b(c)\\times\\log_c(a)=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$\n\nChange to a common base and cancel the matching factors.",
      "worked": "Since $a$, $b$ and $c$ are valid logarithm bases, their logarithms are nonzero.\n$$\\begin{align*}\\log_a(b)\\log_b(c)\\log_c(a)&=\\frac{\\log(b)}{\\log(a)}\\times\\frac{\\log(c)}{\\log(b)}\\times\\frac{\\log(a)}{\\log(c)}\\\\\\log_a(b)\\log_b(c)\\log_c(a)&=1.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 19
  },
