  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p12-q7-introduction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Some quartics can be factorised using the familiar perfect square identity ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "(x+y)^2=x^2+2xy+y^2",
              "display": false
            },
            {
              "type": "text",
              "text": ". Consider ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x^4+x^2+1",
              "display": false
            },
            {
              "type": "text",
              "text": ". We can force the middle term to have a coefficient of 2:",
              "marks": []
            }
          ]
        },
        {
          "id": "p12-q7-demonstration",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}x^4+x^2+1&=x^4+2x^2+1-x^2\\\\&=(x^2+1)^2-x^2\\\\&=(x^2+1-x)(x^2+1+x).\\end{aligned}",
              "display": true
            }
          ]
        },
        {
          "id": "p12-q7-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Using this technique, factorise each of the following polynomials:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^4-3x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2-x-1)(x^2+x-1)$\n\nWrite $(x^2-1)^2-x^2$, then use the difference of squares.",
          "worked": "$$\\begin{align*}x^4-3x^2+1&=x^4-2x^2+1-x^2\\\\x^4-3x^2+1&=(x^2-1)^2-x^2\\\\x^4-3x^2+1&=(x^2-x-1)(x^2+x-1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^4+3x^2+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2-x+2)(x^2+x+2)$\n\nWrite $(x^2+2)^2-x^2$, then use the difference of squares.",
          "worked": "$$\\begin{align*}x^4+3x^2+4&=x^4+4x^2+4-x^2\\\\x^4+3x^2+4&=(x^2+2)^2-x^2\\\\x^4+3x^2+4&=(x^2-x+2)(x^2+x+2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^4+4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2-2x+2)(x^2+2x+2)$\n\nWrite $(x^2+2)^2-(2x)^2$, then use the difference of squares.",
          "worked": "$$\\begin{align*}x^4+4&=x^4+4x^2+4-4x^2\\\\x^4+4&=(x^2+2)^2-(2x)^2\\\\x^4+4&=(x^2-2x+2)(x^2+2x+2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^4+\\frac14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14(2x^2-2x+1)(2x^2+2x+1)$\n\nWrite $(x^2+\\frac12)^2-x^2$, then use the difference of squares.",
          "worked": "$$\\begin{align*}x^4+\\frac14&=x^4+x^2+\\frac14-x^2\\\\x^4+\\frac14&=\\left(x^2+\\frac12\\right)^2-x^2\\\\x^4+\\frac14&=\\left(x^2-x+\\frac12\\right)\\left(x^2+x+\\frac12\\right)\\\\x^4+\\frac14&=\\frac14(2x^2-2x+1)(2x^2+2x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
