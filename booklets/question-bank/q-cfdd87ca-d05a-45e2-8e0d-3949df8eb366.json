    "id": "p10-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Find the selling price if the commission and the commission rate are as given. Where necessary, round to the nearest dollar.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Commission $\\$46$, rate $8\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$575$",
          "worked": "$$\\begin{align*}\\text{Selling price}&=\\text{commission}\\div8\\%\\\\\\text{Selling price}&=46\\div0.08\\\\\\text{Selling price}&=\\$575\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Commission $\\$724$, rate $5.6\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$12\\,929$",
          "worked": "$$\\begin{align*}\\text{Selling price}&=\\text{commission}\\div5.6\\%\\\\\\text{Selling price}&=724\\div0.056\\\\\\text{Selling price}&=\\frac{90500}{7}\\\\\\text{Selling price}&\\approx\\$12\\,929\\end{align*}$$\n\nTo the nearest dollar.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
