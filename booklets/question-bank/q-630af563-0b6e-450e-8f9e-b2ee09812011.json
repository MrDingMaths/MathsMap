  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Let $f(x)=3x+4$ and $g(x)=3-2x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(g(2))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}g(2)&=3-2(2)\\\\&=-1\\\\f(g(2))&=f(-1)\\\\&=3(-1)+4\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $g(f(2))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-17$",
          "worked": "$$\\begin{align*}f(2)&=3(2)+4\\\\&=10\\\\g(f(2))&=g(10)\\\\&=3-2(10)\\\\&=-17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $f(g(x))=-6x+13$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=3(3-2x)+4=-6x+13$.",
          "worked": "$$f(x)=3x+4$$\n$$\\begin{align*}f(g(x))&=f(3-2x)\\\\&=3(3-2x)+4\\\\&=-6x+13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $g(f(x))=-6x-5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(f(x))=3-2(3x+4)=-6x-5$.",
          "worked": "$$g(x)=3-2x$$\n$$\\begin{align*}g(f(x))&=g(3x+4)\\\\&=3-2(3x+4)\\\\&=-6x-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
