  "content": {
    "id": "v2-11f0f-p40-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "The line $y=-3x+c$ touches the parabola $y=x^2+x+5$ at just one point.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-11f0f-p40-practice-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=1$",
          "worked": "Set the equations equal.\n$$\\begin{align*}x^2+x+5&=-3x+c\\\\x^2+4x+5-c&=0\\end{align*}$$\nOne point of intersection gives $\\Delta=0$.\n$$\\begin{align*}4^2-4(1)(5-c)&=0\\\\16-20+4c&=0\\\\4c&=4\\\\c&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-11f0f-p40-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coordinates of the point where they touch.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,7)$",
          "worked": "With $c=1$:\n$$\\begin{align*}x^2+4x+4&=0\\\\(x+2)^2&=0\\\\x&=-2\\end{align*}$$\n$$\\begin{align*}y&=-3(-2)+1\\\\y&=7\\end{align*}$$\nThe point is $(-2,7)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
