  "content": {
    "id": "p27-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the smallest number that is greater than 1000 and divisible by:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q9-a",
