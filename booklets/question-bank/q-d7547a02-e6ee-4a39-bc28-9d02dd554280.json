    "children": [
      {
        "id": "p8-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^x=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}2^x&=2^4\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$4^{x+1}=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}4^{x+1}&=4^2\\\\x+1&=2\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^{x+1}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$$\\begin{align*}4^{x+1}&=4^0\\\\x+1&=0\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$4^{x+1}=\\frac{1}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac52$",
          "worked": "$$\\begin{align*}(2^2)^{x+1}&=2^{-3}\\\\2^{2x+2}&=2^{-3}\\\\2x+2&=-3\\\\x&=-\\frac52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$27^{x+1}=3\\times9^{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$",
          "worked": "$$\\begin{align*}3^{3(x+1)}&=3^1\\times3^{2(x-1)}\\\\3^{3x+3}&=3^{2x-1}\\\\3x+3&=2x-1\\\\x&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^{-2}=49$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\frac17$",
          "worked": "$$\\begin{align*}\\frac{1}{x^2}&=49\\\\x^2&=\\frac1{49}\\\\x&=\\pm\\frac17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
