              "type": "text",
              "text": "[Differentiating functions involving square roots by first principles]",
              "marks": []
            }
          ]
        },
        {
          "id": "p9-p1-definition",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
