  "content": {
    "id": "p4-stem-58-61-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following expressions, and express your answer as an exact value in simplest form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q58",
        "type": "part",
        "label": "a",
        "prompt": "$\\operatorname{cosec}^{2}30^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\operatorname{cosec}^{2}30^\\circ&=\\left(\\frac{1}{\\sin30^\\circ}\\right)^2\\\\\\operatorname{cosec}^{2}30^\\circ&=\\left(\\frac{1}{1/2}\\right)^2\\\\\\operatorname{cosec}^{2}30^\\circ&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q59",
        "type": "part",
        "label": "b",
        "prompt": "$\\sec60^\\circ+\\cot60^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\dfrac{\\sqrt3}{3}$",
          "worked": "$$\\begin{align*}\\sec60^\\circ+\\cot60^\\circ&=\\frac{1}{\\cos60^\\circ}+\\frac{\\cos60^\\circ}{\\sin60^\\circ}\\\\\\sec60^\\circ+\\cot60^\\circ&=\\frac{1}{1/2}+\\frac{1/2}{\\sqrt3/2}\\\\\\sec60^\\circ+\\cot60^\\circ&=2+\\frac{1}{\\sqrt3}\\\\\\sec60^\\circ+\\cot60^\\circ&=2+\\frac{\\sqrt3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q60",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{\\sec30^\\circ-\\tan30^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sec30^\\circ-\\tan30^\\circ}&=\\frac{1}{\\dfrac{1}{\\cos30^\\circ}-\\tan30^\\circ}\\\\\\frac{1}{\\sec30^\\circ-\\tan30^\\circ}&=\\frac{1}{\\dfrac{2}{\\sqrt3}-\\dfrac{1}{\\sqrt3}}\\\\\\frac{1}{\\sec30^\\circ-\\tan30^\\circ}&=\\frac{1}{1/\\sqrt3}\\\\\\frac{1}{\\sec30^\\circ-\\tan30^\\circ}&=\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q61",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\operatorname{cosec}45^\\circ}{1+\\cot45^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2}{2}$",
          "worked": "$$\\begin{align*}\\frac{\\operatorname{cosec}45^\\circ}{1+\\cot45^\\circ}&=\\frac{\\dfrac{1}{\\sin45^\\circ}}{1+\\dfrac{\\cos45^\\circ}{\\sin45^\\circ}}\\\\\\frac{\\operatorname{cosec}45^\\circ}{1+\\cot45^\\circ}&=\\frac{\\sqrt2}{1+1}\\\\\\frac{\\operatorname{cosec}45^\\circ}{1+\\cot45^\\circ}&=\\frac{\\sqrt2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
