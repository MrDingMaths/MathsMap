    "type": "question",
    "label": null,
    "prompt": "Find a fraction between $0.3$ and $0.4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a5711-p37-practice-j8-034150-j8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $0.3$ and $0.4$ as fractions with a denominator of $100$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3=\\frac{30}{100}$ and $0.4=\\frac{40}{100}$",
          "worked": "$$\\begin{align*}0.3&=\\frac{3}{10}=\\frac{30}{100}\\\\0.4&=\\frac{4}{10}=\\frac{40}{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-a5711-p37-practice-j8-034150-j8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Write a fraction that is between $0.3$ and $0.4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{35}{100}$. Many other answers are possible.",
          "worked": "Any fraction from $\\frac{31}{100}$ to $\\frac{39}{100}$ lies between $\\frac{30}{100}$ and $\\frac{40}{100}$.\n$$\\frac{30}{100}<\\frac{35}{100}<\\frac{40}{100}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
