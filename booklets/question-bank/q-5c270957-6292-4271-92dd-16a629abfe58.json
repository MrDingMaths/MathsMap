  "content": {
    "id": "p24-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "There are four boys and four girls seated around a circular table. How many ways can they be arranged if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "the boys and girls are in their respective groups?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4!\\times4!=576$",
          "worked": "Treat the boys as one block and the girls as another. The two blocks have $(2-1)!=1$ circular arrangement. Each block has $4!$ internal arrangements.\n\n$$N=1\\times4!\\times4!=576.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p24-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "the boys and girls alternate?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3!\\times4!=144$",
          "worked": "Arrange the four boys in a circle in $3!$ ways. For alternation, place the four girls in the four intervening gaps in $4!$ ways.\n\n$$N=3!\\times4!=144.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
