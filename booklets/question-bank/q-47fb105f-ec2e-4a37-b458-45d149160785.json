  "content": {
    "id": "p29-q03-root",
    "type": "question",
    "label": "3",
    "prompt": "The product of two consecutive positive integers is 650. Find the numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$25$ and $26$.",
      "worked": "Let $n$ be the smaller positive integer. The next integer is $n+1$.\n$$\\begin{align*}n(n+1)&=650\\\\n^2+n-650&=0\\\\(n+26)(n-25)&=0\\\\n&=-26\\text{ or }25\\end{align*}$$\nReject $n=-26$ because the integers must be positive. The numbers are $25$ and $26$.\nCheck: $25\\times26=650$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
