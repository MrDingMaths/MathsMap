        "type": "part",
        "label": "a",
        "prompt": "The mean of 9 numbers is 11.\nWhat is the sum of the data values?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$99$",
          "worked": "$\\begin{align*}11&=\\frac{\\text{Sum}}{9}\\\\\\text{Sum}&=11\\times9\\\\\\text{Sum}&=99\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-3b3-p16-foundation-slot-7-slot-7-b",
        "type": "part",
        "label": "b",
        "prompt": "The mean of 16 numbers is 6.5.\nWhat is the sum of the data values?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$104$",
          "worked": "$\\begin{align*}6.5&=\\frac{\\text{Sum}}{16}\\\\\\text{Sum}&=6.5\\times16\\\\\\text{Sum}&=104\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-3b3-p16-foundation-slot-7-slot-7-c",
        "type": "part",
        "label": "c",
        "prompt": "A bakery in Geelong sells the same number of pies each day for 5 days.\nIt sells 12 pies each day.\nHow many pies does it sell in total?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60$ pies",
          "worked": "$\\begin{align*}12&=\\frac{\\text{Total}}{5}\\\\\\text{Total}&=12\\times5\\\\\\text{Total}&=60\\end{align*}$\n\nThe bakery sells 60 pies.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
