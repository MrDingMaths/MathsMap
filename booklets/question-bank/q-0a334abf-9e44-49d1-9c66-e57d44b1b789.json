  "content": {
    "id": "v2-515e2-p33-practice-j7-035338-root",
    "type": "question",
    "label": null,
    "prompt": "For events $A$ and $B$ from a sample space, $P(A\\mid B)=0.4$, $P(B\\mid A)=0.25$ and $P(A\\cap B)=0.12$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-515e2-p33-practice-j7-035338-j7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $P(B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3$",
          "worked": "$$\\begin{align*}P(B)&=\\frac{P(A\\cap B)}{P(A\\mid B)}\\\\P(B)&=\\frac{0.12}{0.4}\\\\P(B)&=0.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-515e2-p33-practice-j7-035338-j7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $P(A)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.48$",
          "worked": "$$\\begin{align*}P(A)&=\\frac{P(A\\cap B)}{P(B\\mid A)}\\\\P(A)&=\\frac{0.12}{0.25}\\\\P(A)&=0.48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-515e2-p33-practice-j7-035338-j7-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $P(A'\\cap B')$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.34$",
          "worked": "$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=0.48+0.3-0.12=0.66\\end{align*}$$\nUsing the Venn diagram,\n$$\\begin{align*}P(A'\\cap B')&=1-P(A\\cup B)\\\\P(A'\\cap B')&=1-0.66=0.34\\end{align*}$$",
          "solutionDiagrams": [
            {
