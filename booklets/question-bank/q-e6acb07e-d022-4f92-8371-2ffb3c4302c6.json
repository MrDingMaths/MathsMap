  "content": {
    "id": "p71-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A bookshelf is to hold 5 mathematics books, 8 novels and 7 cookbooks.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p71-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "In how many different ways could they be arranged?\n(Leave your answer in factorial notation.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20!$",
          "worked": "There are $5+8+7=20$ distinct books, so the number of arrangements is $20!$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p71-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "If the books are grouped in categories, in how many ways can they be arranged?\n(Answer in factorial notation.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 units. Arrange units, then arrange within units.\n$3!\\times5!\\times8!\\times7!$",
          "worked": "Treat the categories as 3 units. Arrange these units in $3!$ ways, then arrange the books within each unit in $5!$, $8!$ and $7!$ ways respectively.\n$$\\text{Number of arrangements}=3!\\times5!\\times8!\\times7!.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p71-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "If one book is chosen at random, find the probability that it is a cookbook.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{20}$",
          "worked": "There are 7 cookbooks among $5+8+7=20$ books.\n$$P(\\text{cookbook})=\\frac{7}{20}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
