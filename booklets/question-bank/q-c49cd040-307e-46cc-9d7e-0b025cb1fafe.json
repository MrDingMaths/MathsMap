    "children": [
      {
        "id": "p23-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the substitution $u=2^x$ to solve $4^x-9\\times2^x+14=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $x=\\log_2 7$.",
          "worked": "Let $u=2^x>0$, so $4^x=u^2$.\n$$\\begin{align*}u^2-9u+14&=0\\\\(u-2)(u-7)&=0\\\\u&=2\\text{ or }7\\\\2^x&=2\\text{ or }7\\\\x&=1\\text{ or }\\log_2 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p23-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the substitution $u=3^x$ to solve $3^{2x}-8\\times3^x-9=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$; $3^x=-1$ has no real solution.",
          "worked": "Let $u=3^x>0$.\n$$\\begin{align*}u^2-8u-9&=0\\\\(u-9)(u+1)&=0\\\\u&=9\\text{ or }-1\\end{align*}$$\nReject $u=-1$ because $3^x>0$.\n$$\\begin{align*}3^x&=9\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
