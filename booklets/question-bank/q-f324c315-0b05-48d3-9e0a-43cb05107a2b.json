  "content": {
    "id": "p28-q4-response",
    "type": "question",
    "label": "4",
    "prompt": "Jason works for a caravan company. If he sells \\$84000 worth of caravans in a month, and he earns \\$650 per month plus 4% commission on sales, how much does he earn that month?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$4010",
      "worked": "$$\\begin{align*}\\text{Pay} &= \\text{Retainer} + \\text{Percentage}\\times\\text{Sales}\\\\\\text{Pay} &= 650 + 0.04\\times84000\\\\\\text{Pay} &= \\$4010\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 27
  },
