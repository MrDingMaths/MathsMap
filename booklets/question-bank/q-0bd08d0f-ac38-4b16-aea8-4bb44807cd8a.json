  "content": {
    "id": "v2-2e5df0-p5-practice-slot-1-upper-root",
    "type": "question",
    "label": null,
    "prompt": "For the polynomial $P(x)=(a+4)x^4+(2b-1)x^3+(c+3)x^2+x-6$, find $a$, $b$, $c$ given that:\n\nThe degree is 3, the leading coefficient is 3, and there is no $x^2$ term.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-4,\\ b=2,\\ c=-3$.",
      "worked": "The degree is 3, so the coefficient of $x^4$ is zero. The leading coefficient is the coefficient of $x^3$. There is no $x^2$ term, so its coefficient is zero.\n\n$$\\begin{align*}a+4&=0\\\\a&=-4\\\\2b-1&=3\\\\b&=2\\\\c+3&=0\\\\c&=-3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
