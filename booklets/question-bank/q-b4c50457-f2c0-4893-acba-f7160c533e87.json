  "content": {
    "id": "v2-86222-p60-practice-slot-9-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Given that $a(x+b)^2+c=2x^2+12x+7$ for all $x$, find $a$, $b$ and $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=2,\\ b=3,\\ c=-11$.",
      "worked": "$$\\begin{align*}a(x+b)^2+c&=ax^2+2abx+ab^2+c\\end{align*}$$\nEquating coefficients,\n$$\\begin{align*}a&=2\\\\2ab&=12\\\\4b&=12\\\\b&=3\\\\ab^2+c&=7\\\\2(3)^2+c&=7\\\\c&=-11\\end{align*}$$\nThus $2x^2+12x+7=2(x+3)^2-11$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
