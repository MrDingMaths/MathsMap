  "content": {
    "id": "p18-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Factorise each of the following expressions:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$3(5^{2n})+10(5^n)+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3\\times5^n+1)(5^n+3)$\n\nLet $y=5^n$ and factorise the quadratic in $y$.",
          "worked": "Let $y=5^n$.\n$$\\begin{align*}3y^2+10y+3&=3y^2+9y+y+3\\\\3y^2+10y+3&=3y(y+3)+(y+3)\\\\3y^2+10y+3&=(3y+1)(y+3)\\\\3(5^{2n})+10(5^n)+3&=(3\\times5^n+1)(5^n+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$4(3^{2n})-8(3^n)+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2\\times3^n-1)(2\\times3^n-3)$\n\nLet $y=3^n$ and factorise the quadratic in $y$.",
          "worked": "Let $y=3^n$.\n$$\\begin{align*}4y^2-8y+3&=4y^2-2y-6y+3\\\\4y^2-8y+3&=2y(2y-1)-3(2y-1)\\\\4y^2-8y+3&=(2y-3)(2y-1)\\\\4(3^{2n})-8(3^n)+3&=(2\\times3^n-3)(2\\times3^n-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$2(7^{2n})+11(7^n)+15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2\\times7^n+5)(7^n+3)$\n\nLet $y=7^n$ and factorise the quadratic in $y$.",
          "worked": "Let $y=7^n$.\n$$\\begin{align*}2y^2+11y+15&=2y^2+6y+5y+15\\\\2y^2+11y+15&=2y(y+3)+5(y+3)\\\\2y^2+11y+15&=(2y+5)(y+3)\\\\2(7^{2n})+11(7^n)+15&=(2\\times7^n+5)(7^n+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
