  "content": {
    "id": "p31-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_1^3\\frac{3x^3+4x^2}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$42$",
          "worked": "$$\\begin{aligned}\\int_1^3\\frac{3x^3+4x^2}{x}\\,dx&=\\int_1^3(3x^2+4x)\\,dx\\\\&=\\left[x^3+2x^2\\right]_1^3\\\\&=(27+18)-(1+2)\\\\&=42\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p31-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^2\\frac{4x^4-x}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{aligned}\\int_1^2\\frac{4x^4-x}{x}\\,dx&=\\int_1^2(4x^3-1)\\,dx\\\\&=\\left[x^4-x\\right]_1^2\\\\&=(16-2)-(1-1)\\\\&=14\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p31-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_2^3\\frac{5x^2+9x^4}{x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$62$",
          "worked": "$$\\begin{aligned}\\int_2^3\\frac{5x^2+9x^4}{x^2}\\,dx&=\\int_2^3(5+9x^2)\\,dx\\\\&=\\left[5x+3x^3\\right]_2^3\\\\&=(15+81)-(10+24)\\\\&=62\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p31-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_1^2\\frac{x^3+4x^2}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{25}{3}$",
          "worked": "$$\\begin{aligned}\\int_1^2\\frac{x^3+4x^2}{x}\\,dx&=\\int_1^2(x^2+4x)\\,dx\\\\&=\\left[\\frac{x^3}{3}+2x^2\\right]_1^2\\\\&=\\left(\\frac83+8\\right)-\\left(\\frac13+2\\right)\\\\&=\\frac{25}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p31-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_1^3\\frac{x^3-x^2+x}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{20}{3}$",
          "worked": "$$\\begin{aligned}\\int_1^3\\frac{x^3-x^2+x}{x}\\,dx&=\\int_1^3(x^2-x+1)\\,dx\\\\&=\\left[\\frac{x^3}{3}-\\frac{x^2}{2}+x\\right]_1^3\\\\&=\\left(9-\\frac92+3\\right)-\\left(\\frac13-\\frac12+1\\right)\\\\&=\\frac{15}{2}-\\frac56\\\\&=\\frac{20}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p31-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_{-2}^{-1}\\frac{x^3-2x^5}{x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{aligned}\\int_{-2}^{-1}\\frac{x^3-2x^5}{x^2}\\,dx&=\\int_{-2}^{-1}(x-2x^3)\\,dx\\\\&=\\left[\\frac{x^2}{2}-\\frac{x^4}{2}\\right]_{-2}^{-1}\\\\&=\\left(\\frac12-\\frac12\\right)-(2-8)\\\\&=6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
