      {
        "id": "p11-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain what is meant when two figures are similar.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Corresponding angles are equal and corresponding sides are in the same ratio.",
          "worked": "Similar figures have equal corresponding angles and proportional corresponding side lengths.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q1-ratios",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q1-b",
            "type": "part",
            "label": "b",
            "prompt": "Write the ratio $\\sin\\theta$ for triangle A.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sin\\theta=\\dfrac{5}{13}$",
              "worked": "$$\\begin{aligned}\\sin\\theta&=\\frac{\\text{opposite}}{\\text{hypotenuse}}\\\\\\sin\\theta&=\\frac{5}{13}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p11-q1-c",
            "type": "part",
            "label": "c",
            "prompt": "Write the ratio $\\sin\\theta$ for triangle B.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sin\\theta=\\dfrac{10}{26}=\\dfrac{5}{13}$",
              "worked": "$$\\begin{aligned}\\sin\\theta&=\\frac{\\text{opposite}}{\\text{hypotenuse}}\\\\\\sin\\theta&=\\frac{10}{26}\\\\\\sin\\theta&=\\frac{5}{13}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p11-q1-d",
            "type": "part",
            "label": "d",
            "prompt": "Write the ratio $\\cos\\theta$ for triangle A.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\cos\\theta=\\dfrac{12}{13}$",
              "worked": "$$\\begin{aligned}\\cos\\theta&=\\frac{\\text{adjacent}}{\\text{hypotenuse}}\\\\\\cos\\theta&=\\frac{12}{13}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p11-q1-e",
            "type": "part",
            "label": "e",
            "prompt": "Write the ratio $\\cos\\theta$ for triangle B.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\cos\\theta=\\dfrac{24}{26}=\\dfrac{12}{13}$",
              "worked": "$$\\begin{aligned}\\cos\\theta&=\\frac{\\text{adjacent}}{\\text{hypotenuse}}\\\\\\cos\\theta&=\\frac{24}{26}\\\\\\cos\\theta&=\\frac{12}{13}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p11-q1-f",
            "type": "part",
            "label": "f",
            "prompt": "Write the ratio $\\tan\\theta$ for triangle A.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\tan\\theta=\\dfrac{5}{12}$",
              "worked": "$$\\begin{aligned}\\tan\\theta&=\\frac{\\text{opposite}}{\\text{adjacent}}\\\\\\tan\\theta&=\\frac{5}{12}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p11-q1-g",
            "type": "part",
            "label": "g",
            "prompt": "Write the ratio $\\tan\\theta$ for triangle B.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\tan\\theta=\\dfrac{10}{24}=\\dfrac{5}{12}$",
              "worked": "$$\\begin{aligned}\\tan\\theta&=\\frac{\\text{opposite}}{\\text{adjacent}}\\\\\\tan\\theta&=\\frac{10}{24}\\\\\\tan\\theta&=\\frac{5}{12}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p11-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "What do you notice about your answers? (hint: fully simplify them).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The corresponding trigonometric ratios are the same for similar triangles.",
          "worked": "Both triangles give $\\sin\\theta=\\frac{5}{13}$, $\\cos\\theta=\\frac{12}{13}$ and $\\tan\\theta=\\frac{5}{12}$. Scaling corresponding sides by the same factor leaves each ratio unchanged.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
