  "content": {
    "id": "p23-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A die is thrown. Let $A$ be the event that an even number appears.\n\nLet $B$ be the event that a number greater than 2 appears.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Are A and B mutually exclusive?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No, since $A\\cap B=\\{4,6\\}\\ne\\varnothing$.",
          "worked": "$A=\\{2,4,6\\}$ and $B=\\{3,4,5,6\\}$.\n\nNo, since $A\\cap B=\\{4,6\\}\\ne\\varnothing$; both events can occur on the same throw.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p23-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(A)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{2}$",
              "worked": "$A=\\{2,4,6\\}$.\n\n$$\\begin{align*}P(A)&=\\frac{3}{6}\\\\P(A)&=\\frac{1}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p23-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{3}$",
              "worked": "$B=\\{3,4,5,6\\}$.\n\n$$\\begin{align*}P(B)&=\\frac{4}{6}\\\\P(B)&=\\frac{2}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p23-q3-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(A\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{3}$",
              "worked": "$A\\cap B=\\{4,6\\}$.\n\n$$\\begin{align*}P(A\\cap B)&=\\frac{2}{6}\\\\P(A\\cap B)&=\\frac{1}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p23-q3-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(A\\cup B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{5}{6}$",
              "worked": {
                "format": "maths-editor-document-v1",
                "version": 1,
                "blocks": [
                  {
                    "id": "ab6a1352-f2d5-47d0-9a83-c3328b9756f8-compact-0",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "left",
                    "spaceBefore": 0,
                    "spaceAfter": 0,
                    "lineHeight": 1.25,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "math",
                        "latex": "\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=\\frac{1}{2}+\\frac{2}{3}-\\frac{1}{3}\\\\P(A\\cup B)&=\\frac{5}{6}\\end{align*}",
                        "display": true
                      }
                    ]
                  }
                ]
              },
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
  },
