        "id": "p9-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "a cylinder with radius $4\\text{ cm}$ and height $5\\text{ cm}$, correct to 1 decimal place",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$226.2\\text{ cm}^2$",
          "worked": "Include both circular ends and the curved surface.\n\n$$\\begin{align*}A&=2\\pi r^2+2\\pi rh\\\\A&=2\\pi\\times4^2+2\\pi\\times4\\times5\\\\A&=32\\pi+40\\pi\\\\A&=72\\pi\\text{ cm}^2\\\\A&\\approx226.2\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
