        "answer": {
          "short": "$76\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=2(lw+lh+wh)\\\\A&=2(5\\times4+5\\times2+4\\times2)\\\\A&=2(20+10+8)\\\\A&=76\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
