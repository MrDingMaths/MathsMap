        "answerSpaceMm": 6
      },
      {
        "id": "p57-q10",
        "type": "part",
        "label": "d",
        "prompt": "Let $f$ be an odd function with domain that includes $x=a$. If $f$ is increasing at $x=a$, then $f$ is increasing at $x=-a$.",
