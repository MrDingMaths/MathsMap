  "content": {
    "id": "v2-f-p10-introduction-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "At a swimming carnival, 25% of the students entered the freestyle and 15% entered both the freestyle and the backstroke. What is the probability that a student entered the backstroke, given that they entered the freestyle?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{5}$",
      "worked": "$$\\begin{align*}P(\\text{backstroke}\\mid\\text{freestyle})&=\\frac{P(\\text{both})}{P(\\text{freestyle})}\\\\&=\\frac{0.15}{0.25}\\\\&=\\frac{3}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
