  "content": {
    "id": "p11-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A two-digit number – that is, a number from 10 to 99 – is chosen at random. Find the probability that the number:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "is greater than 72",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{10}$.",
          "worked": "There are $99-10+1=90$ equally likely two-digit numbers. The favourable numbers are 73 through 99, so there are 27. Thus $P=\\frac{27}{90}=\\frac{3}{10}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "contains the digit 6 at least once (that is, a number such as 64, or 16 or 66)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac15$.",
          "worked": "There are 10 numbers 60–69. The other numbers ending in 6 are 16,26,36,46,56,76,86,96, eight more. Counting 66 only once gives 18 favourable numbers, so $P=\\frac{18}{90}=\\frac{1}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
