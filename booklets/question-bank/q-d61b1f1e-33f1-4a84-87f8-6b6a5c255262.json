  "content": {
    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Rationalise the denominator for each of the numbers below:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2}{2+\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4-2\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{2}{2+\\sqrt{3}}&=\\frac{2}{2+\\sqrt{3}}\\times\\frac{2-\\sqrt{3}}{2-\\sqrt{3}}\\\\\\frac{2}{2+\\sqrt{3}}&=\\frac{4-2\\sqrt{3}}{4-3}\\\\\\frac{2}{2+\\sqrt{3}}&=4-2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{5}{3-\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15+5\\sqrt{2}}{7}$",
          "worked": "$$\\begin{align*}\\frac{5}{3-\\sqrt{2}}&=\\frac{5}{3-\\sqrt{2}}\\times\\frac{3+\\sqrt{2}}{3+\\sqrt{2}}\\\\\\frac{5}{3-\\sqrt{2}}&=\\frac{15+5\\sqrt{2}}{9-2}\\\\\\frac{5}{3-\\sqrt{2}}&=\\frac{15+5\\sqrt{2}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2}{\\sqrt{5}+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{5}-4$",
          "worked": "$$\\begin{align*}\\frac{2}{\\sqrt{5}+2}&=\\frac{2}{\\sqrt{5}+2}\\times\\frac{\\sqrt{5}-2}{\\sqrt{5}-2}\\\\\\frac{2}{\\sqrt{5}+2}&=\\frac{2\\sqrt{5}-4}{5-4}\\\\\\frac{2}{\\sqrt{5}+2}&=2\\sqrt{5}-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{\\sqrt{6}-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6+3\\sqrt{6}}{2}$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{6}-2}&=\\frac{3}{\\sqrt{6}-2}\\times\\frac{\\sqrt{6}+2}{\\sqrt{6}+2}\\\\\\frac{3}{\\sqrt{6}-2}&=\\frac{3\\sqrt{6}+6}{6-4}\\\\\\frac{3}{\\sqrt{6}-2}&=\\frac{6+3\\sqrt{6}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{\\sqrt{5}-\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}+\\sqrt{5}$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{5}-\\sqrt{2}}&=\\frac{3}{\\sqrt{5}-\\sqrt{2}}\\times\\frac{\\sqrt{5}+\\sqrt{2}}{\\sqrt{5}+\\sqrt{2}}\\\\\\frac{3}{\\sqrt{5}-\\sqrt{2}}&=\\frac{3\\sqrt{5}+3\\sqrt{2}}{5-2}\\\\\\frac{3}{\\sqrt{5}-\\sqrt{2}}&=\\sqrt{5}+\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{6}{\\sqrt{2}+\\sqrt{8}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{6}{\\sqrt{2}+\\sqrt{8}}&=\\frac{6}{\\sqrt{2}+\\sqrt{8}}\\times\\frac{\\sqrt{2}-\\sqrt{8}}{\\sqrt{2}-\\sqrt{8}}\\\\\\frac{6}{\\sqrt{2}+\\sqrt{8}}&=\\frac{6\\sqrt{2}-6\\sqrt{8}}{2-8}\\\\\\frac{6}{\\sqrt{2}+\\sqrt{8}}&=\\frac{-6\\sqrt{2}}{-6}\\\\\\frac{6}{\\sqrt{2}+\\sqrt{8}}&=\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{\\sqrt{6}+\\sqrt{5}}{\\sqrt{6}-\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11+2\\sqrt{30}$\n\nMultiply by the conjugate and expand the numerator.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{6}+\\sqrt{5}}{\\sqrt{6}-\\sqrt{5}}&=\\frac{\\sqrt{6}+\\sqrt{5}}{\\sqrt{6}-\\sqrt{5}}\\times\\frac{\\sqrt{6}+\\sqrt{5}}{\\sqrt{6}+\\sqrt{5}}\\\\\\frac{\\sqrt{6}+\\sqrt{5}}{\\sqrt{6}-\\sqrt{5}}&=\\frac{(\\sqrt{6}+\\sqrt{5})^2}{6-5}\\\\\\frac{\\sqrt{6}+\\sqrt{5}}{\\sqrt{6}-\\sqrt{5}}&=6+2\\sqrt{30}+5\\\\\\frac{\\sqrt{6}+\\sqrt{5}}{\\sqrt{6}-\\sqrt{5}}&=11+2\\sqrt{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{\\sqrt{8}-\\sqrt{6}}{\\sqrt{8}-\\sqrt{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "The numerator equals the nonzero denominator, so $\\frac{\\sqrt{8}-\\sqrt{6}}{\\sqrt{8}-\\sqrt{6}}=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{\\sqrt{2}+1}{\\sqrt{2}-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{5+4\\sqrt{2}}{7}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{2}+1}{\\sqrt{2}-3}&=\\frac{\\sqrt{2}+1}{\\sqrt{2}-3}\\times\\frac{\\sqrt{2}+3}{\\sqrt{2}+3}\\\\\\frac{\\sqrt{2}+1}{\\sqrt{2}-3}&=\\frac{2+3\\sqrt{2}+\\sqrt{2}+3}{2-9}\\\\\\frac{\\sqrt{2}+1}{\\sqrt{2}-3}&=-\\frac{5+4\\sqrt{2}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{\\sqrt{3}-2}{\\sqrt{2}+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2\\sqrt{2}+2\\sqrt{3}-\\sqrt{6}-4}{2}$\n\nMultiply by the conjugate and expand both products.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}-2}{\\sqrt{2}+2}&=\\frac{\\sqrt{3}-2}{\\sqrt{2}+2}\\times\\frac{\\sqrt{2}-2}{\\sqrt{2}-2}\\\\\\frac{\\sqrt{3}-2}{\\sqrt{2}+2}&=\\frac{\\sqrt{6}-2\\sqrt{3}-2\\sqrt{2}+4}{2-4}\\\\\\frac{\\sqrt{3}-2}{\\sqrt{2}+2}&=\\frac{2\\sqrt{2}+2\\sqrt{3}-\\sqrt{6}-4}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{\\sqrt{3}+1}{\\sqrt{2}-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3-\\sqrt{2}-\\sqrt{3}-\\sqrt{6}$\n\nMultiply by the conjugate; the denominator becomes $2-3=-1$.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}+1}{\\sqrt{2}-\\sqrt{3}}&=\\frac{\\sqrt{3}+1}{\\sqrt{2}-\\sqrt{3}}\\times\\frac{\\sqrt{2}+\\sqrt{3}}{\\sqrt{2}+\\sqrt{3}}\\\\\\frac{\\sqrt{3}+1}{\\sqrt{2}-\\sqrt{3}}&=\\frac{\\sqrt{6}+3+\\sqrt{2}+\\sqrt{3}}{2-3}\\\\\\frac{\\sqrt{3}+1}{\\sqrt{2}-\\sqrt{3}}&=-3-\\sqrt{2}-\\sqrt{3}-\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{10}+3\\sqrt{2}-\\sqrt{15}-2\\sqrt{3}$\n\nMultiply by the conjugate; simplify $\\sqrt{18}$ and $\\sqrt{12}$.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{6}}&=\\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{6}}\\times\\frac{\\sqrt{5}-\\sqrt{6}}{\\sqrt{5}-\\sqrt{6}}\\\\\\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{6}}&=\\frac{\\sqrt{15}-\\sqrt{18}-\\sqrt{10}+\\sqrt{12}}{5-6}\\\\\\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{6}}&=-\\sqrt{15}+3\\sqrt{2}+\\sqrt{10}-2\\sqrt{3}\\\\\\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{6}}&=\\sqrt{10}+3\\sqrt{2}-\\sqrt{15}-2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
