    "type": "question",
    "label": "10",
    "prompt": "Explain why $x>4$ and $x\\ge 5$ are not the same inequality.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x>4$ includes values such as $4.3$, whereas $x\\ge 5$ does not.",
      "worked": "For example, $4.3>4$, but $4.3<5$. So $4.3$ satisfies $x>4$ but does not satisfy $x\\ge 5$, and the solution sets are different.",
      "solutionDiagrams": []
    },
