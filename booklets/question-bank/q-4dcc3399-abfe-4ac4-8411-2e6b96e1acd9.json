  "content": {
    "id": "p24-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Determine the exact radius, in simplest form, of a circle with the given area. $A=\\pi r^2$",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$24\\pi\\text{ m}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{6}\\text{ m}$",
          "worked": "$$\\begin{align*}\\pi r^2&=24\\pi\\\\r^2&=24\\\\r&=\\sqrt{24}\\\\&=\\sqrt{4\\times6}\\\\&=2\\sqrt{6}\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$54\\pi\\text{ cm}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{6}\\text{ cm}$",
          "worked": "$$\\begin{align*}\\pi r^2&=54\\pi\\\\r^2&=54\\\\r&=\\sqrt{54}\\\\&=\\sqrt{9\\times6}\\\\&=3\\sqrt{6}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$128\\pi\\text{ mm}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\sqrt{2}\\text{ mm}$",
          "worked": "$$\\begin{align*}\\pi r^2&=128\\pi\\\\r^2&=128\\\\r&=\\sqrt{128}\\\\&=\\sqrt{64\\times2}\\\\&=8\\sqrt{2}\\text{ mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
