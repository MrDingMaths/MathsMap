  "content": {
    "id": "v2-6b115e019-practice-slot-15-root",
    "type": "question",
    "label": null,
    "prompt": "Use the quotient rule to find the first derivative of $y=\\dfrac{3x-1}{1-2x}$. Then use the chain rule to find the second derivative.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{dy}{dx}=\\dfrac{1}{(1-2x)^2}$; $\\dfrac{d^2y}{dx^2}=\\dfrac{4}{(1-2x)^3}$.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{(1-2x)(3)-(3x-1)(-2)}{(1-2x)^2}\\\\\\frac{dy}{dx}&=\\frac{3-6x+6x-2}{(1-2x)^2}\\\\\\frac{dy}{dx}&=\\frac{1}{(1-2x)^2}\\\\\\frac{dy}{dx}&=(1-2x)^{-2}\\\\\\frac{d^2y}{dx^2}&=-2(1-2x)^{-3}(-2)\\\\\\frac{d^2y}{dx^2}&=\\frac{4}{(1-2x)^3}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
