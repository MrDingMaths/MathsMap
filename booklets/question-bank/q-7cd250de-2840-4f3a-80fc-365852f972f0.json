  "content": {
    "id": "p40-q74-response",
    "type": "question",
    "label": "74",
    "prompt": "Let $y=\\dfrac{ax+b}{ax-b}$. Show that if $a$ and $b$ have opposite signs, then the tangent at any point on the curve will always have positive gradient.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
