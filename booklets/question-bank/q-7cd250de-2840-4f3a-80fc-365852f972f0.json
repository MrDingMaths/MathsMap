            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The parameters have opposite signs, so ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "ab<0",
                "display": false
              },
              {
                "type": "text",
                "text": "; the denominator is positive wherever the curve is defined.",
                "marks": []
              }
