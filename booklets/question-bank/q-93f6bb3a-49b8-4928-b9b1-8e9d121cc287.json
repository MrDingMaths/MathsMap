  "content": {
    "id": "p5-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "The prime factors of 210 are 2, 3, 5 and 7. Find six other factors of 210 without using division.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "For example, $6,10,14,15,21,35$.",
      "worked": "Multiply pairs of the given prime factors:\n$$\\begin{align*}2\\times3&=6\\\\2\\times5&=10\\\\2\\times7&=14\\\\3\\times5&=15\\\\3\\times7&=21\\\\5\\times7&=35\\end{align*}$$\nEach product is a factor of $210=2\\times3\\times5\\times7$, so six other factors are $6,10,14,15,21,35$.",
      "solutionDiagrams": []
    },
