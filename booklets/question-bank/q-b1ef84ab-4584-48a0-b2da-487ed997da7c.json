    "label": "5",
    "prompt": "True or False? $\\frac{x^2-y^2}{x+y}=x-y$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "True, for $x+y\\ne0$.",
      "worked": "$$\\begin{align*}\\frac{x^2-y^2}{x+y}&=\\frac{(x-y)(x+y)}{x+y}\\\\\\frac{x^2-y^2}{x+y}&=x-y\\end{align*}$$\nTrue on the original domain $x+y\\ne0$.",
      "solutionDiagrams": []
    },
