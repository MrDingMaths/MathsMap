        "type": "part",
        "label": "a",
        "prompt": "If $x<6$, how many different values can $x$ take?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Infinitely many.",
          "worked": "There are infinitely many real numbers less than $6$, so $x$ can take infinitely many values.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p26-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Give three values of $x$ that satisfy $x>-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answers: $-\\frac12,\\ 0,\\ 2.6$.",
          "worked": "$-\\frac12>-1$, $0>-1$ and $2.6>-1$, so all three values satisfy the inequality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p26-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Give three non-whole numbers that satisfy $x>2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answers: $2.7,\\ 11.8,\\ 14\\frac12$.",
          "worked": "$2.7>2$, $11.8>2$ and $14\\frac12>2$. None is a whole number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
