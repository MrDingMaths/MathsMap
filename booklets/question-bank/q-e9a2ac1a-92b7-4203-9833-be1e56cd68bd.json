    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(1+\\frac{1}{\\sqrt{2}}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{2}+\\sqrt{2}$",
          "worked": "$$\\begin{aligned}\\left(1+\\frac{1}{\\sqrt{2}}\\right)^2&=1+\\frac{2}{\\sqrt{2}}+\\frac{1}{2}\\\\&=\\frac{3}{2}+\\frac{2}{\\sqrt{2}}\\\\&=\\frac{3}{2}+\\sqrt{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p47-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\sqrt{3}-\\frac{1}{\\sqrt{3}}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{3}$",
          "worked": "$$\\begin{aligned}\\left(\\sqrt{3}-\\frac{1}{\\sqrt{3}}\\right)^2&=3-2\\left(\\sqrt{3}\\right)\\left(\\frac{1}{\\sqrt{3}}\\right)+\\frac{1}{3}\\\\&=3-2+\\frac{1}{3}\\\\&=\\frac{4}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
