    "type": "question",
    "label": "4",
    "prompt": "Factor each quadratic and hence find the $x$-intercepts.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+6x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+1)(x+5)$; $x$-intercepts: $-5,-1$.",
          "worked": "$$\\begin{align*}y&=(x+1)(x+5)\\\\0&=(x+1)(x+5)\\end{align*}$$\nBy the null factor law, $x+1=0$ or $x+5=0$, so the $x$-intercepts are $-1$ and $-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
