  "content": {
    "id": "p13-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Find the three numbers in geometric progression whose sum is $\\frac{14}{3}$ and whose product is $-8$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p13-q19-short-result",
            "type": "paragraph",
