                "latex": "6,-2,\\frac{2}{3}",
                "display": false
              },
              {
                "type": "text",
                "text": ", or in reverse order.",
                "marks": []
              }
            ]
          },
          {
            "id": "p13-q19-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
