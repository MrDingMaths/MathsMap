  "content": {
    "id": "p6-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Town $B$ is 800 km due south of town $A$, while town $C$ is due west of $A$. The bearing of $C$ from $B$ is $300^\\circ$. Find the distance $BC$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1600\\text{ km}$",
      "worked": "Triangle $ABC$ is right-angled at $A$. The bearing gives $\\angle ABC=360^\\circ-300^\\circ=60^\\circ$.\n$$\\begin{align*}\\cos60^\\circ&=\\frac{800}{BC}\\\\BC&=\\frac{800}{\\cos60^\\circ}\\\\BC&=1600\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
