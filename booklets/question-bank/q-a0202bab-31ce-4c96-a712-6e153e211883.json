  "content": {
    "id": "p29-q21-response",
    "type": "question",
    "label": "21",
    "prompt": "The temperature in a water tank decreases by 7% per hour. The initial temperature was $70^\\circ\\mathrm{C}$. What was the temperature after a day (to one decimal place)?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12.3^\\circ\\mathrm{C}$",
      "worked": "One day contains 24 hourly periods.\n$$\\begin{align*}T&=70(1-0.07)^{24}\\\\T&=70(0.93)^{24}\\\\T&\\approx12.3^\\circ\\mathrm{C}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
