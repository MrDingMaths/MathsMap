  "content": {
    "id": "v2-365ab-p13-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Given the continuous probability distribution $f(x)=kx^2$ for $1\\le x\\le4$, $0$ for all other $x$, find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\frac{1}{21}$",
      "worked": "$$\\begin{align*}\\int_1^4 kx^2\\,dx&=1\\\\k\\left[\\frac{x^3}{3}\\right]_1^4&=1\\\\k\\left(\\frac{64}{3}-\\frac{1}{3}\\right)&=1\\\\21k&=1\\\\k&=\\frac{1}{21}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
