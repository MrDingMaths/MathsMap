  "content": {
    "id": "v2-d2748-p15-practice-j24-034235-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=(x+2)e^x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d2748-p15-practice-j24-034235-j24-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f'(x)$, $f''(x)$ and $f'''(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=(x+3)e^x$, $f''(x)=(x+4)e^x$, $f'''(x)=(x+5)e^x$",
          "worked": "$$\\begin{align*}f'(x)&=(1)e^x+(x+2)e^x\\\\&=(x+3)e^x\\\\f''(x)&=(1)e^x+(x+3)e^x\\\\&=(x+4)e^x\\\\f'''(x)&=(1)e^x+(x+4)e^x\\\\&=(x+5)e^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-d2748-p15-practice-j24-034235-j24-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the $n$th derivative of $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{(n)}(x)=(x+2+n)e^x$",
          "worked": "Each derivative adds $1$ to the constant, so\n$$f^{(n)}(x)=(x+2+n)e^x$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-d2748-p15-practice-j24-034235-j24-q-c",
        "type": "part",
        "label": "c",
        "prompt": "For which value of $n$ is $f^{(n)}(-10)=0$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=8$",
          "worked": "$$\\begin{align*}f^{(n)}(-10)&=(-10+2+n)e^{-10}\\\\&=0\\\\n-8&=0\\\\n&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
