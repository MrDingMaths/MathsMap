    "id": "rates-routine-r5-3-q",
    "type": "question",
    "label": null,
    "prompt": "The number of insects in a colony is modelled by $P=3000e^{0.04t}$, where $t$ is the time in weeks.\n\nFind the rate at which the population is growing after 10 weeks, to the nearest insect per week.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$179$ insects per week.",
      "worked": "$$\\begin{align*}P'(10)&=0.04P(10)\\\\&=0.04\\times3000e^{0.04\\times10}\\\\&=120e^{0.4}\\\\&\\approx179\\text{ insects per week}\\end{align*}$$",
      "solutionDiagrams": []
    },
