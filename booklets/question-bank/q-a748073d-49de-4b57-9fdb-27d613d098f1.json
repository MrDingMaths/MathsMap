        "answer": {
          "short": "$49\\pi\\text{ cm}^{2}$",
          "worked": "$$\\begin{align*}r&=14\\div2=7\\text{ cm}\\\\A&=\\pi r^{2}\\\\A&=\\pi\\times7^{2}\\\\A&=49\\pi\\text{ cm}^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$7\\text{ cm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\frac14\\pi\\text{ cm}^{2}$",
          "worked": "$$\\begin{align*}r&=7\\div2=\\frac72\\text{ cm}\\\\A&=\\pi r^{2}\\\\A&=\\pi\\times\\left(\\frac72\\right)^{2}\\\\A&=\\frac{49}{4}\\pi\\text{ cm}^{2}\\\\A&=12\\frac14\\pi\\text{ cm}^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\frac12\\text{ mm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac1{16}\\pi\\text{ mm}^{2}$",
          "worked": "$$\\begin{align*}r&=\\frac72\\div2\\\\r&=\\frac74\\text{ mm}\\\\A&=\\pi r^{2}\\\\A&=\\pi\\times\\left(\\frac74\\right)^{2}\\\\A&=\\frac{49}{16}\\pi\\text{ mm}^{2}\\\\A&=3\\frac1{16}\\pi\\text{ mm}^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q4-d",
        "type": "part",
        "label": "d",
