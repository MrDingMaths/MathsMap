        "children": [],
        "answer": {
          "short": "$441\\pi\\text{ m}^{2}$",
          "worked": "$$\\begin{align*}r&=42\\div2=21\\text{ m}\\\\A&=\\pi r^{2}\\\\A&=\\pi\\times21^{2}\\\\A&=441\\pi\\text{ m}^{2}\\end{align*}$$",
