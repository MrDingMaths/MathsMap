    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28$",
          "worked": "$$\\begin{align*}f(-3)&=3(-3)^2+1\\\\f(-3)&=27+1\\\\f(-3)&=28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
