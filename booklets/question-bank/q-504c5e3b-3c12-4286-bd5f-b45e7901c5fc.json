        "children": [],
        "answer": {
          "short": "$3a^2+1$",
          "worked": "$$\\begin{align*}f(-a)&=3(-a)^2+1\\\\f(-a)&=3a^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p13-q9-c",
        "type": "part",
