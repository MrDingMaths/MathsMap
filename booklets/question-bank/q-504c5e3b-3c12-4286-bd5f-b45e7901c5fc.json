        "children": [],
        "answer": {
          "short": "$3a+1$",
          "worked": "$$\\begin{align*}f(\\sqrt{a})&=3(\\sqrt{a})^2+1\\\\f(\\sqrt{a})&=3a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p13-q9-f",
