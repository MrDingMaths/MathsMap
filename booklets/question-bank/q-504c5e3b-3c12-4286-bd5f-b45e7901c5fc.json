          "worked": "$$\\begin{align*}f(a^2)&=3(a^2)^2+1\\\\f(a^2)&=3a^4+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p13-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(2a)$",
