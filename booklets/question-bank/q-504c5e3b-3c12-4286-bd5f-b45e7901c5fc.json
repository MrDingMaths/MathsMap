          "short": "$12a^2+1$",
          "worked": "$$\\begin{align*}f(2a)&=3(2a)^2+1\\\\f(2a)&=3(4a^2)+1\\\\f(2a)&=12a^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(\\sqrt{a})$",
