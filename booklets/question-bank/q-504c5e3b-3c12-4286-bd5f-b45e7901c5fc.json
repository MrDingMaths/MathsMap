        "answer": {
          "short": "$3a^2+6a+4$",
          "worked": "$$\\begin{align*}f(1+a)&=3(1+a)^2+1\\\\f(1+a)&=3(1+2a+a^2)+1\\\\f(1+a)&=3+6a+3a^2+1\\\\f(1+a)&=3a^2+6a+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
