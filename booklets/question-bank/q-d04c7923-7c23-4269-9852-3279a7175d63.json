        "answerSpaceMm": 14
      },
      {
        "id": "v2-4b59f-p11-practice-slot-4-lower-slot-4-lower-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why $6.48$ is rounded to the nearest tenth but $0.648$ is rounded to the nearest hundredth.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The first significant figure is in the ones place for $6.48$ but in the tenths place for $0.648$, so the 2nd significant figure is in the tenths place for $6.48$ and the hundredths place for $0.648$.",
          "worked": "The first significant digit of $6.48$ is $6$, in the ones place, so the 2nd significant digit is in the tenths place.\nThe first significant digit of $0.648$ is $6$, in the tenths place, so the 2nd significant digit is in the hundredths place.\n$$\\begin{aligned}6.48&\\approx6.5\\\\0.648&\\approx0.65\\end{aligned}$$",
