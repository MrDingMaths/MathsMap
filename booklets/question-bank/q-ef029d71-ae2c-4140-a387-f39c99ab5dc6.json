  "content": {
    "id": "p37-q5",
    "type": "question",
    "label": "5",
    "prompt": "Recall that the range of $f(x)=\\sqrt{x}$ is $y\\geq0$ because $\\sqrt{x}$ cannot be negative.\nUse this to determine the range of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\geq0$",
          "worked": "$$\\begin{aligned}\\sqrt{x}&\\geq0\\\\2\\sqrt{x}&\\geq0\\end{aligned}$$\nThe minimum is attained at $x=0$, so the range is $y\\geq0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\sqrt{x}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\geq3$",
          "worked": "$$\\begin{aligned}\\sqrt{x}&\\geq0\\\\\\sqrt{x}+3&\\geq3\\end{aligned}$$\nThe minimum is attained at $x=0$, so the range is $y\\geq3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sqrt{x}-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\geq-5$",
          "worked": "$$\\begin{aligned}\\sqrt{x}&\\geq0\\\\\\sqrt{x}-5&\\geq-5\\end{aligned}$$\nThe minimum is attained at $x=0$, so the range is $y\\geq-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=-\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\leq0$",
          "worked": "$$\\begin{aligned}\\sqrt{x}&\\geq0\\\\-\\sqrt{x}&\\leq0\\end{aligned}$$\nThe maximum is attained at $x=0$, so the range is $y\\leq0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=-\\sqrt{x}+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\leq4$",
          "worked": "$$\\begin{aligned}\\sqrt{x}&\\geq0\\\\-\\sqrt{x}&\\leq0\\\\-\\sqrt{x}+4&\\leq4\\end{aligned}$$\nThe maximum is attained at $x=0$, so the range is $y\\leq4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=3-\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\leq3$",
          "worked": "$$\\begin{aligned}\\sqrt{x}&\\geq0\\\\-\\sqrt{x}&\\leq0\\\\3-\\sqrt{x}&\\leq3\\end{aligned}$$\nThe maximum is attained at $x=0$, so the range is $y\\leq3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
