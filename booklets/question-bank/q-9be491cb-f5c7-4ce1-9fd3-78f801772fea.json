            {
              "type": "text",
              "text": "Consider the fraction ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{16}{64}",
              "display": false
            },
            {
              "type": "text",
              "text": ". This fraction has the curious property that its value is unchanged when the digits common to both the numerator and denominator are deleted:",
              "marks": []
            }
          ]
        },
        {
          "id": "p18-q21-cancellation",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
