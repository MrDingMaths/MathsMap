      {
        "id": "p126-q68-b",
        "type": "part",
        "label": "b",
        "prompt": "Find all possible values of $a$ if $f(a)=9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p126-q68-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=-18\\text{ or }0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p126-q68-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Solve both branches and retain only values in their stated domains.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "For $a\\ge0$:\n$$\\begin{align*}9-a^2&=9\\\\a^2&=0\\\\a&=0.\\end{align*}$$\nFor $a<0$:\n$$\\begin{align*}\\lvert a+9\\rvert&=9\\\\a+9&=\\pm9\\\\a&=0\\text{ or }-18.\\end{align*}$$\nOnly $-18$ satisfies the negative-branch restriction. The value $0$ is included through the quadratic branch.\n\nTherefore, $a=-18$ or $a=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      },
      {
        "id": "p126-q68-c",
        "type": "part",
        "label": "c",
        "prompt": "Find all possible values of $b$ if $f(b)=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p126-q68-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "b=-10,\\,-8\\text{ or }\\sqrt8",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p126-q68-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Solve both branches; reject ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-\\sqrt8",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " from the non-negative branch.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "For $b\\ge0$:\n$$\\begin{align*}9-b^2&=1\\\\b^2&=8\\\\b&=\\pm\\sqrt8.\\end{align*}$$\nRetain only $b=\\sqrt8$, since this branch requires $b\\ge0$.\n\nFor $b<0$:\n$$\\begin{align*}\\lvert b+9\\rvert&=1\\\\b+9&=\\pm1\\\\b&=-8\\text{ or }-10.\\end{align*}$$\nBoth values satisfy $b<0$.\n\nTherefore, $b=-10$, $-8$ or $\\sqrt8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      }
