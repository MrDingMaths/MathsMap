  "content": {
    "id": "p46-q63-group-root",
    "type": "question",
    "label": "19",
    "prompt": "Convert the following inequality statement to interval notation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p46-q63-node",
        "type": "part",
        "label": "a",
        "prompt": "$$1\\le x\\le3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in[1,3]$",
          "worked": "Both endpoints are included, so use two square brackets: $x\\in[1,3]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p46-q64-node",
        "type": "part",
        "label": "b",
        "prompt": "$$-2<x\\le5$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in(-2,5]$",
          "worked": "Exclude $-2$ with a round bracket and include 5 with a square bracket: $x\\in(-2,5]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p46-q65-node",
        "type": "part",
        "label": "c",
        "prompt": "$$-7\\le x<-3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in[-7,-3)$",
          "worked": "The inequality includes $-7$ and excludes $-3$, so use a square left bracket and a round right bracket: $x\\in[-7,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p46-q66-node",
        "type": "part",
        "label": "d",
        "prompt": "$$x\\ge4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in[4,\\infty)$",
          "worked": "Include 4 with a square bracket. The interval is unbounded above, and infinity takes a round bracket: $x\\in[4,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p46-q67-node",
        "type": "part",
        "label": "e",
        "prompt": "$$x>-2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in(-2,\\infty)$",
          "worked": "Exclude $-2$ and extend without an upper bound. Both brackets are round: $x\\in(-2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p46-q68-node",
        "type": "part",
        "label": "f",
        "prompt": "$$x\\le3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in(-\\infty,3]$",
          "worked": "The interval extends without a lower bound and includes 3: $x\\in(-\\infty,3]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
