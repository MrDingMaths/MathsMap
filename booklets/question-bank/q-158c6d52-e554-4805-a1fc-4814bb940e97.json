  "content": {
    "id": "p10-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The cost of $x$ kg of mince meat is $\\frac{2x}{5}$ dollars.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "How much would 1 kg cost?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$0.40$",
          "worked": "The cost of 1 kg, in dollars, is\n$$\\begin{align*}\\frac{2x}{5}\\div x&=\\frac{2x}{5x}\\\\\\frac{2x}{5}\\div x&=\\frac{2}{5}\\\\\\frac{2x}{5}\\div x&=0.40\\end{align*}$$\nSo 1 kg costs $\\$0.40$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How much would $z$ kg cost?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$\\frac{2z}{5}$",
          "worked": "Multiply the cost per kilogram by $z$. The cost, in dollars, is\n$$\\begin{align*}\\frac{2}{5}\\times z&=\\frac{2\\times z}{5}\\\\\\frac{2}{5}\\times z&=\\frac{2z}{5}\\end{align*}$$\nSo $z$ kg costs $\\$\\frac{2z}{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
