  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Multiply each of the following numbers by its conjugate:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$5+\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23$",
          "worked": "The conjugate is $5-\\sqrt2$.\n\n$$\\begin{align*}(5+\\sqrt2)(5-\\sqrt2)&=5^2-(\\sqrt2)^2\\\\(5+\\sqrt2)(5-\\sqrt2)&=25-2\\\\(5+\\sqrt2)(5-\\sqrt2)&=23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$3-\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "The conjugate is $3+\\sqrt2$.\n\n$$\\begin{align*}(3-\\sqrt2)(3+\\sqrt2)&=3^2-(\\sqrt2)^2\\\\(3-\\sqrt2)(3+\\sqrt2)&=9-2\\\\(3-\\sqrt2)(3+\\sqrt2)&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt3+\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "The conjugate is $\\sqrt3-\\sqrt2$.\n\n$$\\begin{align*}(\\sqrt3+\\sqrt2)(\\sqrt3-\\sqrt2)&=(\\sqrt3)^2-(\\sqrt2)^2\\\\(\\sqrt3+\\sqrt2)(\\sqrt3-\\sqrt2)&=3-2\\\\(\\sqrt3+\\sqrt2)(\\sqrt3-\\sqrt2)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\sqrt3-3\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6$",
          "worked": "The conjugate is $2\\sqrt3+3\\sqrt2$.\n\n$$\\begin{align*}(2\\sqrt3-3\\sqrt2)(2\\sqrt3+3\\sqrt2)&=(2\\sqrt3)^2-(3\\sqrt2)^2\\\\(2\\sqrt3-3\\sqrt2)(2\\sqrt3+3\\sqrt2)&=12-18\\\\(2\\sqrt3-3\\sqrt2)(2\\sqrt3+3\\sqrt2)&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
