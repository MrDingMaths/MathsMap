  "content": {
    "id": "v2-19076-p14-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "The exchange rates are $\\mathrm{A}\\$1=\\mathrm{US}\\$0.64$ and $\\mathrm{A}\\$1=$ £$0.48$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-19076-p14-practice-slot-4-slot-4-a",
        "type": "part",
        "label": "a",
        "prompt": "How many pounds is $\\$320$ US?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "£240",
          "worked": "Let $A$ be Australian dollars, $U$ US dollars and $P$ pounds.\n$$\\begin{align*}U&=0.64A\\\\320&=0.64A\\\\A&=\\frac{320}{0.64}\\\\A&=500\\end{align*}$$\n$$\\begin{align*}P&=0.48A\\\\P&=0.48\\times500\\\\P&=240\\end{align*}$$\n£240.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-19076-p14-practice-slot-4-slot-4-b",
        "type": "part",
        "label": "b",
        "prompt": "How many US dollars is £150?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$200$ US",
          "worked": "Let $A$ be Australian dollars, $U$ US dollars and $P$ pounds.\n$$\\begin{align*}P&=0.48A\\\\150&=0.48A\\\\A&=\\frac{150}{0.48}\\\\A&=312.5\\end{align*}$$\n$$\\begin{align*}U&=0.64A\\\\U&=0.64\\times312.5\\\\U&=200\\end{align*}$$\n$\\$200$ US.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
