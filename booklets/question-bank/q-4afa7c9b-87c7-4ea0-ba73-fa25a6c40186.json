    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "both bulbs are faulty",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "$$\\begin{aligned}P(\\text{both faulty})&=\\frac{2}{5}\\times\\frac{1}{4}\\\\&=\\frac{2}{20}\\\\&=\\frac{1}{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p28-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "neither bulb is faulty",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "$$\\begin{aligned}P(\\text{neither faulty})&=\\frac{3}{5}\\times\\frac{2}{4}\\\\&=\\frac{6}{20}\\\\&=\\frac{3}{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p28-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "the first bulb is faulty and the second one is not",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "After a faulty bulb is selected, three non-faulty bulbs remain among the four bulbs.\n$$\\begin{aligned}P(\\text{faulty, then not faulty})&=\\frac{2}{5}\\times\\frac{3}{4}\\\\&=\\frac{6}{20}\\\\&=\\frac{3}{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "the second bulb is faulty and the first one is not",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "After a non-faulty bulb is selected, two faulty bulbs remain among the four bulbs.\n$$\\begin{aligned}P(\\text{not faulty, then faulty})&=\\frac{3}{5}\\times\\frac{2}{4}\\\\&=\\frac{6}{20}\\\\&=\\frac{3}{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
