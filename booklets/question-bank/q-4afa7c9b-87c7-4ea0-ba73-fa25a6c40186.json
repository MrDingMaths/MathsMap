              "text": "A box contains five light bulbs, two of which are faulty.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Two bulbs are selected, one at a time ",
              "marks": []
            },
            {
              "type": "text",
              "text": "without replacement",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": ". Find the probability that:",
              "marks": []
            }
          ]
        }
