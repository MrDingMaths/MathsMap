  "content": {
    "id": "p22-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Find the domain of the following functions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\frac{1}{e^x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R},\\ x\\ne0$.",
          "worked": "The denominator cannot be zero. Its only zero is given by\n\n$$\\begin{align*}e^x-1&=0\\\\e^x&=1\\\\x&=0.\\end{align*}$$\n\nThe domain is $x\\in\\mathbb{R}$ with $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\frac{1}{e^x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathbb{R}$.",
          "worked": "For every real $x$, $e^x>0$, so $e^x+1>1$. The denominator is never zero and the domain is $\\mathbb{R}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p22-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\ln(x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>1$.",
          "worked": "The logarithm needs a positive argument.\n\n$$\\begin{align*}x-1&>0\\\\x&>1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p22-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\ln(2-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<2$.",
          "worked": "The logarithm needs a positive argument.\n\n$$\\begin{align*}2-x&>0\\\\2&>x\\\\x&<2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p22-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\ln(3x-6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>2$.",
          "worked": "The logarithm needs a positive argument.\n\n$$\\begin{align*}3x-6&>0\\\\3x&>6\\\\x&>2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p22-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\ln(8-2x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<4$.",
          "worked": "The logarithm needs a positive argument.\n\n$$\\begin{align*}8-2x&>0\\\\8&>2x\\\\x&<4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
