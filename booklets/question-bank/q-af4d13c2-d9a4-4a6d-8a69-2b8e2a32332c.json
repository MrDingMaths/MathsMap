    "children": [
      {
        "id": "p15-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x}{2}(4x+6)+\\dfrac{x}{3}(6x-9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2$.",
          "worked": "$$\\begin{align*}\\frac{x}{2}(4x+6)+\\frac{x}{3}(6x-9)&=2x^2+3x+2x^2-3x\\\\&=4x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3a}{4}(8a-4)-\\dfrac{2a}{3}(6a+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a^2-5a$.",
          "worked": "$$\\begin{align*}\\frac{3a}{4}(8a-4)-\\frac{2a}{3}(6a+3)&=6a^2-3a-4a^2-2a\\\\&=2a^2-5a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2x}{3}(3x+6)+\\dfrac{x}{4}(8x-12)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+x$.",
          "worked": "$$\\begin{align*}\\frac{2x}{3}(3x+6)+\\frac{x}{4}(8x-12)&=2x^2+4x+2x^2-3x\\\\&=4x^2+x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{y}{5}(10y-15)+\\dfrac{2y}{5}(5y+10)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4y^2+y$.",
          "worked": "$$\\begin{align*}\\frac{y}{5}(10y-15)+\\frac{2y}{5}(5y+10)&=2y^2-3y+2y^2+4y\\\\&=4y^2+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
