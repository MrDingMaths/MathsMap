  "content": {
    "id": "p18-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Rewrite in index form by making both sides a single logarithm then exponentiating both sides.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a(x+y)=\\log_a c+\\log_a d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+y=cd$",
          "worked": "$$\\begin{align*}\\log_a(x+y)&=\\log_a(cd)\\\\a^{\\log_a(x+y)}&=a^{\\log_a(cd)}\\\\x+y&=cd\\end{align*}$$\nRetain $a>0$, $a\\ne1$, $x+y>0$, $c>0$ and $d>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}x=3+\\log_{10}y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1000y$",
          "worked": "$$\\begin{align*}\\log_{10}x&=\\log_{10}1000+\\log_{10}y\\\\\\log_{10}x&=\\log_{10}(1000y)\\\\10^{\\log_{10}x}&=10^{\\log_{10}(1000y)}\\\\x&=1000y\\end{align*}$$\nRetain $x>0$ and $y>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_3 x=4\\log_3 y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=y^4$",
          "worked": "$$\\begin{align*}\\log_3 x&=\\log_3(y^4)\\\\3^{\\log_3 x}&=3^{\\log_3(y^4)}\\\\x&=y^4\\end{align*}$$\nRetain $x>0$ and $y>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\log_2 x+3\\log_2 y-4\\log_2 z=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2y^3=z^4$",
          "worked": "$$\\begin{align*}\\log_2(x^2)+\\log_2(y^3)-\\log_2(z^4)&=\\log_2 1\\\\\\log_2\\left(\\frac{x^2y^3}{z^4}\\right)&=\\log_2 1\\\\2^{\\log_2\\left(\\frac{x^2y^3}{z^4}\\right)}&=2^{\\log_2 1}\\\\\\frac{x^2y^3}{z^4}&=1\\\\x^2y^3&=z^4\\end{align*}$$\nRetain $x>0$, $y>0$ and $z>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q17-e",
        "type": "part",
        "label": "e",
        "prompt": "$x\\log_a 2=\\log_a y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^x=y$",
          "worked": "$$\\begin{align*}\\log_a(2^x)&=\\log_a y\\\\a^{\\log_a(2^x)}&=a^{\\log_a y}\\\\2^x&=y\\end{align*}$$\nRetain $a>0$, $a\\ne1$ and $y>0$; $x$ is real.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q17-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a x-\\log_a y=n\\log_a z$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=yz^n$",
          "worked": "$$\\begin{align*}\\log_a\\left(\\frac{x}{y}\\right)&=\\log_a(z^n)\\\\a^{\\log_a\\left(\\frac{x}{y}\\right)}&=a^{\\log_a(z^n)}\\\\\\frac{x}{y}&=z^n\\\\x&=yz^n\\end{align*}$$\nRetain $a>0$, $a\\ne1$, $x>0$, $y>0$ and $z>0$; $n$ is real.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q17-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{1}{2}\\log_2 x=\\frac{1}{3}\\log_2 y-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64x^3=y^2$",
          "worked": "$$\\begin{align*}\\log_2(x^{1/2})&=\\log_2(y^{1/3})-\\log_2 2\\\\\\log_2(x^{1/2})&=\\log_2\\left(\\frac{y^{1/3}}{2}\\right)\\\\2^{\\log_2(x^{1/2})}&=2^{\\log_2\\left(\\frac{y^{1/3}}{2}\\right)}\\\\x^{1/2}&=\\frac{y^{1/3}}{2}\\\\2x^{1/2}&=y^{1/3}\\\\(2x^{1/2})^6&=(y^{1/3})^6\\\\64x^3&=y^2\\end{align*}$$\nRetain $x>0$ and $y>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q17-h",
        "type": "part",
        "label": "h",
        "prompt": "$2\\log_3(2x+1)=3\\log_3(2y-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)^2=(2y-1)^3$",
          "worked": "$$\\begin{align*}\\log_3\\big((2x+1)^2\\big)&=\\log_3\\big((2y-1)^3\\big)\\\\3^{\\log_3\\big((2x+1)^2\\big)}&=3^{\\log_3\\big((2y-1)^3\\big)}\\\\(2x+1)^2&=(2y-1)^3\\end{align*}$$\nRetain $x>-\\frac{1}{2}$ and $y>\\frac{1}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
