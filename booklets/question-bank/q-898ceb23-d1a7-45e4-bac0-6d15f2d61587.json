  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": null,
    "prompt": "Find the following limits by first simplifying.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\lim_{x\\to0}\\frac{x^2-9x}{x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9$",
          "worked": "$$\\begin{align*}\\lim_{x\\to0}\\frac{x^2-9x}{x}&=\\lim_{x\\to0}\\frac{x(x-9)}{x}\\\\\\lim_{x\\to0}\\frac{x^2-9x}{x}&=\\lim_{x\\to0}(x-9)\\\\\\lim_{x\\to0}\\frac{x^2-9x}{x}&=0-9\\\\\\lim_{x\\to0}\\frac{x^2-9x}{x}&=-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\lim_{x\\to1}\\frac{x-1}{x^2-1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\lim_{x\\to1}\\frac{x-1}{x^2-1}&=\\lim_{x\\to1}\\frac{x-1}{(x-1)(x+1)}\\\\\\lim_{x\\to1}\\frac{x-1}{x^2-1}&=\\lim_{x\\to1}\\frac{1}{x+1}\\\\\\lim_{x\\to1}\\frac{x-1}{x^2-1}&=\\frac{1}{1+1}\\\\\\lim_{x\\to1}\\frac{x-1}{x^2-1}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\lim_{x\\to5}\\frac{x^2-25}{x-5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\lim_{x\\to5}\\frac{x^2-25}{x-5}&=\\lim_{x\\to5}\\frac{(x-5)(x+5)}{x-5}\\\\\\lim_{x\\to5}\\frac{x^2-25}{x-5}&=\\lim_{x\\to5}(x+5)\\\\\\lim_{x\\to5}\\frac{x^2-25}{x-5}&=5+5\\\\\\lim_{x\\to5}\\frac{x^2-25}{x-5}&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\lim_{x\\to0}\\frac{x^2+5x}{x^2-x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}\\lim_{x\\to0}\\frac{x^2+5x}{x^2-x}&=\\lim_{x\\to0}\\frac{x(x+5)}{x(x-1)}\\\\\\lim_{x\\to0}\\frac{x^2+5x}{x^2-x}&=\\lim_{x\\to0}\\frac{x+5}{x-1}\\\\\\lim_{x\\to0}\\frac{x^2+5x}{x^2-x}&=\\frac{0+5}{0-1}\\\\\\lim_{x\\to0}\\frac{x^2+5x}{x^2-x}&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\lim_{h\\to0}\\frac{2x^2h-9h^2}{h}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2$",
          "worked": "Hold $x$ fixed as $h\\to0$.\n\n$$\\begin{align*}\\lim_{h\\to0}\\frac{2x^2h-9h^2}{h}&=\\lim_{h\\to0}\\frac{h(2x^2-9h)}{h}\\\\\\lim_{h\\to0}\\frac{2x^2h-9h^2}{h}&=\\lim_{h\\to0}(2x^2-9h)\\\\\\lim_{h\\to0}\\frac{2x^2h-9h^2}{h}&=2x^2-9(0)\\\\\\lim_{h\\to0}\\frac{2x^2h-9h^2}{h}&=2x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p6-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\lim_{x\\to3}\\frac{x^2-9}{x^2-x-6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac65$",
          "worked": "$$\\begin{align*}\\lim_{x\\to3}\\frac{x^2-9}{x^2-x-6}&=\\lim_{x\\to3}\\frac{(x-3)(x+3)}{(x-3)(x+2)}\\\\\\lim_{x\\to3}\\frac{x^2-9}{x^2-x-6}&=\\lim_{x\\to3}\\frac{x+3}{x+2}\\\\\\lim_{x\\to3}\\frac{x^2-9}{x^2-x-6}&=\\frac{3+3}{3+2}\\\\\\lim_{x\\to3}\\frac{x^2-9}{x^2-x-6}&=\\frac65\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\lim_{x\\to-3}\\frac{x^2+2x-3}{x+3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}\\lim_{x\\to-3}\\frac{x^2+2x-3}{x+3}&=\\lim_{x\\to-3}\\frac{(x+3)(x-1)}{x+3}\\\\\\lim_{x\\to-3}\\frac{x^2+2x-3}{x+3}&=\\lim_{x\\to-3}(x-1)\\\\\\lim_{x\\to-3}\\frac{x^2+2x-3}{x+3}&=-3-1\\\\\\lim_{x\\to-3}\\frac{x^2+2x-3}{x+3}&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\lim_{x\\to2}\\frac{x^2-5x+6}{x-2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\lim_{x\\to2}\\frac{x^2-5x+6}{x-2}&=\\lim_{x\\to2}\\frac{(x-2)(x-3)}{x-2}\\\\\\lim_{x\\to2}\\frac{x^2-5x+6}{x-2}&=\\lim_{x\\to2}(x-3)\\\\\\lim_{x\\to2}\\frac{x^2-5x+6}{x-2}&=2-3\\\\\\lim_{x\\to2}\\frac{x^2-5x+6}{x-2}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\lim_{x\\to2}\\frac{x^2-4}{x^2-x-2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac43$",
          "worked": "$$\\begin{align*}\\lim_{x\\to2}\\frac{x^2-4}{x^2-x-2}&=\\lim_{x\\to2}\\frac{(x-2)(x+2)}{(x-2)(x+1)}\\\\\\lim_{x\\to2}\\frac{x^2-4}{x^2-x-2}&=\\lim_{x\\to2}\\frac{x+2}{x+1}\\\\\\lim_{x\\to2}\\frac{x^2-4}{x^2-x-2}&=\\frac{2+2}{2+1}\\\\\\lim_{x\\to2}\\frac{x^2-4}{x^2-x-2}&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\lim_{x\\to-1}\\frac{x^4-1}{x^2-1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\lim_{x\\to-1}\\frac{x^4-1}{x^2-1}&=\\lim_{x\\to-1}\\frac{(x^2-1)(x^2+1)}{x^2-1}\\\\\\lim_{x\\to-1}\\frac{x^4-1}{x^2-1}&=\\lim_{x\\to-1}(x^2+1)\\\\\\lim_{x\\to-1}\\frac{x^4-1}{x^2-1}&=(-1)^2+1\\\\\\lim_{x\\to-1}\\frac{x^4-1}{x^2-1}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
