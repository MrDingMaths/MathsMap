    "children": [
      {
        "id": "p31-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $(a^2+b^2)(c^2+d^2)=(ac-bd)^2+(ad+bc)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both sides expand to $a^2c^2+a^2d^2+b^2c^2+b^2d^2$.",
          "worked": "$$\\begin{align*}(ac-bd)^2+(ad+bc)^2&=a^2c^2-2abcd+b^2d^2\\\\&\\quad{}+a^2d^2+2abcd+b^2c^2\\\\(ac-bd)^2+(ad+bc)^2&=a^2c^2+a^2d^2+b^2c^2+b^2d^2\\\\(ac-bd)^2+(ad+bc)^2&=(a^2+b^2)(c^2+d^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p31-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence write $(3^2+1^2)(5^2+2^2)$ as the sum of two squares.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13^2+11^2$",
          "worked": "Use $a=3$, $b=1$, $c=5$ and $d=2$.\n$$\\begin{align*}(3^2+1^2)(5^2+2^2)&=(3\\times5-1\\times2)^2+(3\\times2+1\\times5)^2\\\\(3^2+1^2)(5^2+2^2)&=13^2+11^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
