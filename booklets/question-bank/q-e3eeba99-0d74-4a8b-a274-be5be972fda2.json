    "answer": {
      "short": "20 students",
      "worked": "$$\\begin{align*}\\text{Percentage not attending regularly} &= 100\\%-98\\%\\\\\\text{Percentage not attending regularly} &= 2\\%\\\\\\text{Number not attending regularly} &= 0.02\\times1000\\\\\\text{Number not attending regularly} &= 20\\end{align*}$$\n20 students do not attend regularly.",
