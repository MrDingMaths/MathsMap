  "content": {
    "id": "p50-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The remainder when $x^2+6x+6$ is divided by $(x-c)$ is $1$.\nFind the values of $c$ and hence the divisors.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c=-5$ or $-1$; divisors $x+5$ or $x+1$.",
      "worked": "By the remainder theorem,\n$\\begin{aligned}c^2+6c+6&=1\\\\c^2+6c+5&=0\\\\(c+5)(c+1)&=0\\\\c&=-5\\text{ or }-1\\end{aligned}$\nThe divisors are $x+5$ or $x+1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
