                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{\\sin 22.5^\\circ}{1-y}=\\frac{\\sin45^\\circ}{x}=\\frac{1}{x\\sqrt2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
