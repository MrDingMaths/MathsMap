  "content": {
    "id": "p62-q5-response",
    "type": "question",
    "label": "5",
    "prompt": "Write $\\dfrac{x+3}{x+5}$ in the form $a+\\dfrac{b}{x+5}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1-\\dfrac{2}{x+5}$",
      "worked": "Multiply by $x+5$ and equate coefficients.\n$$\\begin{align*}x+3&=a(x+5)+b\\\\x+3&=ax+5a+b\\\\a&=1\\\\3&=5(1)+b\\\\b&=-2\\end{align*}$$\nHence $\\dfrac{x+3}{x+5}=1-\\dfrac{2}{x+5}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
