  "content": {
    "id": "p22-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the probability that a three-digit number chosen at random is divisible by:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac15$",
          "worked": "There are $999-100+1=900$ three-digit numbers. The multiples are $100,105,\\ldots,995$.\n\n$$\\begin{align*}N_5&=\\frac{995-100}{5}+1\\\\N_5&=180\\\\P(5\\text{ divides})&=\\frac{180}{900}=\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p22-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "There are 900 three-digit numbers. The multiples are $102,105,\\ldots,999$.\n\n$$\\begin{align*}N_3&=\\frac{999-102}{3}+1\\\\N_3&=300\\\\P(3\\text{ divides})&=\\frac{300}{900}=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p22-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{15}$",
          "worked": "There are 900 three-digit numbers. The multiples are $105,120,\\ldots,990$.\n\n$$\\begin{align*}N_{15}&=\\frac{990-105}{15}+1\\\\N_{15}&=60\\\\P(15\\text{ divides})&=\\frac{60}{900}=\\frac1{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p22-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$3$ or $5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac7{15}$\n\nCount multiples of both 3 and 5 only once.",
          "worked": "Multiples of both 3 and 5 are multiples of 15.\n\n$$\\begin{align*}N_{3\\text{ or }5}&=300+180-60\\\\N_{3\\text{ or }5}&=420\\\\P(3\\text{ or }5)&=\\frac{420}{900}=\\frac7{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
