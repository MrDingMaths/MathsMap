        "prompt": "$(\\sqrt{2}+1)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17+12\\sqrt{2}$",
          "worked": "$$\\begin{align*}(\\sqrt{2}+1)^4&=(2+2\\sqrt{2}+1)^2\\\\(\\sqrt{2}+1)^4&=(3+2\\sqrt{2})^2\\\\(\\sqrt{2}+1)^4&=9+12\\sqrt{2}+8\\\\(\\sqrt{2}+1)^4&=17+12\\sqrt{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p43-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt{3}-1)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28-16\\sqrt{3}$",
          "worked": "$$\\begin{align*}(\\sqrt{3}-1)^4&=(3-2\\sqrt{3}+1)^2\\\\(\\sqrt{3}-1)^4&=(4-2\\sqrt{3})^2\\\\(\\sqrt{3}-1)^4&=16-16\\sqrt{3}+12\\\\(\\sqrt{3}-1)^4&=28-16\\sqrt{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
