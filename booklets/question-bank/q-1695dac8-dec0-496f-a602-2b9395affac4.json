  "content": {
    "id": "p70-q1-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p70-q1-subtitle",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "[A moving family of vertices]",
              "marks": [
                "bold"
              ]
            }
          ]
        },
        {
          "id": "p70-q1-introduction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "For each real value of ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "p",
              "display": false
            },
            {
              "type": "text",
              "text": ", consider",
              "marks": []
            }
          ]
        },
        {
          "id": "p70-q1-equation",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "y=(x-p)(x-p-4)+p",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p70-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the equation in vertex form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-p-2)^2+p-4$",
          "worked": "Complete the square around the midpoint of the two factors:\n$$\\begin{align*}y&=((x-p-2)+2)((x-p-2)-2)+p\\\\y&=(x-p-2)^2-4+p\\\\y&=(x-p-2)^2+p-4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p70-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "State the vertex and axis of symmetry in terms of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Vertex $(p+2,p-4)$; axis of symmetry $x=p+2$.",
          "worked": "From $y=(x-(p+2))^2+p-4$, the vertex is $(p+2,p-4)$ and the axis of symmetry is $x=p+2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p70-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "As $p$ varies, the vertices lie on a straight line. Find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-6$",
          "worked": "Let the vertex be $(X,Y)$. Since $X=p+2$ and $Y=p-4$,\n$$\\begin{align*}p&=X-2\\\\Y&=(X-2)-4\\\\Y&=X-6.\\end{align*}$$\nThe vertex locus is $y=x-6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p70-q1-d",
        "type": "group",
        "label": "d",
        "prompt": "Determine the values of $p$ for which the parabola has:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p70-q1-d-i",
            "type": "part",
            "label": "i",
            "prompt": "two $x$-intercepts",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$p<4$",
              "worked": "For an $x$-intercept,\n$$\\begin{align*}0&=(x-p-2)^2+p-4\\\\(x-p-2)^2&=4-p.\\end{align*}$$\nThere are two distinct solutions when $4-p>0$, so $p<4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p70-q1-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "exactly one $x$-intercept",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$p=4$",
              "worked": "There is exactly one solution to $(x-p-2)^2=4-p$ when $4-p=0$, so $p=4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p70-q1-d-iii",
            "type": "part",
            "label": "iii",
            "prompt": "no $x$-intercepts.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$p>4$",
              "worked": "A real square cannot be negative. Thus $(x-p-2)^2=4-p$ has no real solutions when $4-p<0$, so $p>4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      },
      {
        "id": "p70-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the value of $p$ for which the vertex lies on the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=-2$",
          "worked": "The vertex lies on the $y$-axis when its $x$-coordinate is zero:\n$$\\begin{align*}p+2&=0\\\\p&=-2.\\end{align*}$$\nThe vertex is then $(0,-6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p70-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "When the intercepts exist, express them exactly in terms of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=p+2\\pm\\sqrt{4-p}$, when $p\\leq4$.",
          "worked": "When $p\\leq4$,\n$$\\begin{align*}(x-p-2)^2&=4-p\\\\x-p-2&=\\pm\\sqrt{4-p}\\\\x&=p+2\\pm\\sqrt{4-p}.\\end{align*}$$\nThe intercepts are $(p+2-\\sqrt{4-p},0)$ and $(p+2+\\sqrt{4-p},0)$; they coincide when $p=4$.\n\nSupplementary resource: https://www.desmos.com/calculator/kqdpf58al7",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
