    "children": [
      {
        "id": "p24-q8a",
        "type": "part",
        "label": "a",
        "prompt": "Find the number of solutions to the equation $a+b+c=8$, where $a,b,c$ are non-negative integers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45$",
          "worked": "Represent each solution by 8 identical stars and 2 identical bars. Empty groups are allowed. Choose the 2 bar positions among the 10 positions.\n$$\\begin{align*}N&=\\binom{10}{2}\\\\N&=45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q8b",
        "type": "part",
        "label": "b",
        "prompt": "Find the number of solutions to the equation $a+b+c=8$, where $a,b,c$ are positive integers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21$",
          "worked": "Represent the total by 8 stars. To form three non-empty groups, choose 2 of the 7 gaps between consecutive stars for the bars.\n$$\\begin{align*}N&=\\binom{7}{2}\\\\N&=21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
