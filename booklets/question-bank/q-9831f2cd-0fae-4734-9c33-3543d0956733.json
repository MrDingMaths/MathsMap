  "content": {
    "id": "p6-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A set of thirteen consecutive positive integers has the property that the smallest seven integers have the same sum as the largest six. What is the value of the middle integer?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
