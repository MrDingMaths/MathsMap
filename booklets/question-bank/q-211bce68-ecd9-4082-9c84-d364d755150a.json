        "id": "index-t7-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\begin{aligned}\\frac{5a^2y^2\\times2y^4}{7y^4\\times a^3}&=\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{12mm}}}{\\boxed{\\rule{0pt}{4mm}\\hspace{12mm}}}\\\\[2mm]&=\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10y^{2}}{7a}$",
          "worked": "$$\\begin{align*}\\frac{5a^2y^2\\times2y^4}{7y^4\\times a^3}&=\\frac{10a^2y^6}{7a^3y^4} \\\\ &=\\frac{10y^{2}}{7a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
