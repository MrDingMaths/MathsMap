        "label": "a",
        "prompt": "$\\begin{aligned}\\frac{3h^2c\\times3h^4}{2h^3\\times c^3}&=\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{12mm}}}{\\boxed{\\rule{0pt}{4mm}\\hspace{12mm}}}\\\\[2mm]&=\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9h^{3}}{2c^{2}}$",
          "worked": "$$\\begin{align*}\\frac{3h^2c\\times3h^4}{2h^3\\times c^3}&=\\frac{9h^6c}{2h^3c^3} \\\\ &=\\frac{9h^{3}}{2c^{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
