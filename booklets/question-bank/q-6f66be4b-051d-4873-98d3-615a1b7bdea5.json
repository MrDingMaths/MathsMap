        "label": "a",
        "prompt": "$2x-6=-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$",
          "worked": "$$\\begin{align*}2x&=-12+6\\\\2x&=-6\\\\x&=-3\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=2(-3)-6\\\\&=-12\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x+6=-15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-10\\frac{1}{2}$",
          "worked": "$$\\begin{align*}2x&=-15-6\\\\2x&=-21\\\\x&=-\\frac{21}{2}=-10\\frac{1}{2}\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=2\\left(-\\frac{21}{2}\\right)+6\\\\&=-15\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x-3=-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2\\frac{1}{2}$",
          "worked": "$$\\begin{align*}2x&=-8+3\\\\2x&=-5\\\\x&=-\\frac{5}{2}=-2\\frac{1}{2}\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=2\\left(-\\frac{5}{2}\\right)-3\\\\&=-8\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$6-4x=26$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5$",
          "worked": "$$\\begin{align*}-4x&=26-6\\\\-4x&=20\\\\x&=\\frac{20}{-4}\\\\x&=-5\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=6-4(-5)\\\\&=26\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p8-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$5-2x=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3\\frac{1}{2}$",
          "worked": "$$\\begin{align*}-2x&=12-5\\\\-2x&=7\\\\x&=-\\frac{7}{2}=-3\\frac{1}{2}\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=5-2\\left(-\\frac{7}{2}\\right)\\\\&=12\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p8-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$6-5x=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{4}{5}$",
          "worked": "$$\\begin{align*}-5x&=10-6\\\\-5x&=4\\\\x&=-\\frac{4}{5}\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=6-5\\left(-\\frac{4}{5}\\right)\\\\&=10\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p8-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{x}{3}+4=22$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=54$",
          "worked": "$$\\begin{align*}\\frac{x}{3}&=22-4\\\\\\frac{x}{3}&=18\\\\x&=18\\times3\\\\x&=54\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=\\frac{54}{3}+4\\\\&=22\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
