        "answer": {
          "short": "$x=60$",
          "worked": "$$\\begin{align*}\\frac{x}{4}&=10+5\\\\\\frac{x}{4}&=15\\\\x&=15\\times4\\\\x&=60\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=\\frac{60}{4}-5\\\\&=10\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
