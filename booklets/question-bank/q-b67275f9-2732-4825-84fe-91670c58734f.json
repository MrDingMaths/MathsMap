  "content": {
    "id": "p19-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Show that $A$ and $B$ are independent given\n$$\\Pr(A\\cup B)=0.65,\\quad \\Pr(A)=0.3,\\quad \\Pr(B)=0.5.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Independent: $\\Pr(A\\cap B)=0.15=\\Pr(A)\\Pr(B)$.",
      "worked": "$$\\begin{align*}\\Pr(A\\cup B)&=\\Pr(A)+\\Pr(B)-\\Pr(A\\cap B)\\\\0.65&=0.3+0.5-\\Pr(A\\cap B)\\\\\\Pr(A\\cap B)&=0.15.\\end{align*}$$\n$$\\Pr(A)\\Pr(B)=0.3\\times0.5=0.15=\\Pr(A\\cap B).$$\nTherefore, $A$ and $B$ are independent.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
