    "children": [
      {
        "id": "p59-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{3x^2}{x^3-5}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_e|x^3-5|+C$",
          "worked": "The denominator has derivative $3x^2$, matching the numerator.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int\\frac{3x^2}{x^3-5}\\,dx\\\\&=\\log_e|x^3-5|+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p59-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{4x^3+1}{x^4+x-5}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_e|x^4+x-5|+C$",
          "worked": "The denominator has derivative $4x^3+1$, matching the numerator.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int\\frac{4x^3+1}{x^4+x-5}\\,dx\\\\&=\\log_e|x^4+x-5|+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p59-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{x^3-3x}{x^4-6x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14\\log_e|x^4-6x^2|+C$",
          "worked": "The denominator has derivative $4x^3-12x=4(x^3-3x)$.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int\\frac{x^3-3x}{x^4-6x^2}\\,dx\\\\&=\\frac14\\int\\frac{4x^3-12x}{x^4-6x^2}\\,dx\\\\&=\\frac14\\log_e|x^4-6x^2|+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p59-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{10x^3-7x}{5x^4-7x^2+8}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\log_e|5x^4-7x^2+8|+C$",
          "worked": "The denominator has derivative $20x^3-14x=2(10x^3-7x)$.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int\\frac{10x^3-7x}{5x^4-7x^2+8}\\,dx\\\\&=\\frac12\\int\\frac{20x^3-14x}{5x^4-7x^2+8}\\,dx\\\\&=\\frac12\\log_e|5x^4-7x^2+8|+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p59-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_2^3\\frac{3x^2-1}{x^3-x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log_e2$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int_2^3\\frac{3x^2-1}{x^3-x}\\,dx\\\\&=\\left[\\log_e|x^3-x|\\right]_2^3\\\\&=\\log_e24-\\log_e6\\\\&=\\log_e4=2\\log_e2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p59-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_e^{2e}\\frac{2x+2}{x^2+2x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_e\\left(\\frac{4(e+1)}{e+2}\\right)$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int_e^{2e}\\frac{2x+2}{x^2+2x}\\,dx\\\\&=\\left[\\log_e|x^2+2x|\\right]_e^{2e}\\\\&=\\log_e(4e^2+4e)-\\log_e(e^2+2e)\\\\&=\\log_e\\left(\\frac{4e(e+1)}{e(e+2)}\\right)\\\\&=\\log_e\\left(\\frac{4(e+1)}{e+2}\\right)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
