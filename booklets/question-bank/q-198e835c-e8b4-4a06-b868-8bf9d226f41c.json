    "id": "sum-product-b1-3-root",
    "type": "question",
    "label": null,
    "prompt": "One zero of $x^2-8x+k+3=0$ is $3$. Find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=12$",
      "worked": "Let the other zero be $\\beta$.\n$$\\begin{aligned}3+\\beta&=8\\\\\\beta&=5\\\\3\\beta&=k+3\\\\15&=k+3\\\\k&=12\\end{aligned}$$",
      "solutionDiagrams": []
    },
