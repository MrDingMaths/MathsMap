    "children": [
      {
        "id": "reuse-s5-p90-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for Desmond’s age in 4 years’ time and write an expression for double his age in 4 years’ time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d+4$, $2(d+4)$",
          "worked": "His age in 4 years’ time is $d+4$. Double that age is $2(d+4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "reuse-s5-p90-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an equation to describe the situation described above.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(d+4)=50$",
          "worked": "Double his age in 4 years’ time equals 50, so $2(d+4)=50$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "reuse-s5-p90-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve the equation to find his current age.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=21$ years.",
          "worked": "$$\\begin{align*}2(d+4)&=50\\\\d+4&=25\\\\d&=21\\end{align*}$$\nDesmond is 21 years old. In 4 years he will be 25, and double 25 is 50.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
