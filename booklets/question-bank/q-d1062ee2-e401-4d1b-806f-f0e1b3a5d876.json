        "type": "part",
        "label": "a",
        "prompt": "Given that $v=u+at$, find the value of $a$ when $v=26$, $u=4$ and $t=11$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$",
          "worked": "$$\\begin{align*}26&=4+11a\\\\22&=11a\\\\a&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $F=\\dfrac{GMm}{V^2}$, find the value of $G$ when $F=200$, $M=10$, $m=4$ and $V=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$G=20$",
          "worked": "$$\\begin{align*}200&=\\frac{G\\times10\\times4}{2^2}\\\\200&=10G\\\\G&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $P=\\dfrac{1}{r}+\\dfrac{1}{q}$, find the value of $r$ when $P=8.6$ and $q=0.4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\dfrac{10}{61}$",
          "worked": "$$\\begin{align*}8.6&=\\frac{1}{r}+\\frac{1}{0.4}\\\\8.6&=\\frac{1}{r}+2.5\\\\6.1&=\\frac{1}{r}\\\\6.1r&=1\\\\r&=\\frac{10}{61}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
