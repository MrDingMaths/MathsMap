  "content": {
    "id": "p18-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The formula for the calculation of compound interest is $A_n=P(1+R)^n$. Find, correct to one decimal place:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$A_n$ if $P=\\$50\\,000$, $R=8\\%$ and $n=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A_n=\\$62\\,985.6$",
          "worked": "$$\\begin{align*}A_n&=50\\,000(1+0.08)^3\\\\A_n&=62\\,985.6\\end{align*}$$\nThe amount is $\\$62\\,985.6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$P$ if $A_n=\\$80\\,000$, $R=5\\%$ and $n=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P\\approx\\$65\\,816.2$",
          "worked": "$$\\begin{align*}80\\,000&=P(1.05)^4\\\\P&=\\frac{80\\,000}{(1.05)^4}\\\\P&\\approx65\\,816.2\\end{align*}$$\nThe principal is approximately $\\$65\\,816.2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$n$ if $A_n=\\$60\\,000$, $R=2\\%$ and $P=\\$20\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n\\approx55.5$",
          "worked": "$$\\begin{align*}60\\,000&=20\\,000(1.02)^n\\\\3&=(1.02)^n\\\\\\log_{10}3&=n\\log_{10}(1.02)\\\\n&=\\frac{\\log_{10}3}{\\log_{10}(1.02)}\\\\n&\\approx55.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p18-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$n$ if $A_n=\\$90\\,000$, $R=4\\%$ and $P=\\$20\\,000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n\\approx38.3$",
          "worked": "$$\\begin{align*}90\\,000&=20\\,000(1.04)^n\\\\4.5&=(1.04)^n\\\\\\log_{10}(4.5)&=n\\log_{10}(1.04)\\\\n&=\\frac{\\log_{10}(4.5)}{\\log_{10}(1.04)}\\\\n&\\approx38.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
