  "content": {
    "id": "p10-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "A bathroom floor measures $2.4\\text{ m}$ by $1.8\\text{ m}$. Square tiles have side length $30\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p10-q18-feedback-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\": 1, \"kind\": \"geometry\", \"base\": [], \"semantic\": [], \"reference\": \"Authorised feedback p10-q18-feedback-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=2pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.8pt] (0,0) rectangle (38,23);\n\\node[below] at (19.0,0) {$2.4\\,\\mathrm{m}$};\n\\node[right] at (38,11.5) {$1.8\\,\\mathrm{m}$};\n\\draw[black,line width=0.8pt] (68,0) rectangle (90,22);\n\\node[below] at (79.0,0) {$30\\,\\mathrm{cm}$};\n\\node[right] at (90,11.0) {$30\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
