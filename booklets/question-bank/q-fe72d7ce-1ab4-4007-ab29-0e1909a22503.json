    "children": [
      {
        "id": "p10-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of the floor in $\\text{cm}^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$43\\,200\\text{ cm}^2$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p10-q18-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}l &= 2.4\\times100 = 240\\text{ cm}\\\\w &= 1.8\\times100 = 180\\text{ cm}\\\\A &= 240\\times180 = 43\\,200\\text{ cm}^2\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of one tile in $\\text{cm}^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$900\\text{ cm}^2$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p10-q18-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}A &= s^2\\\\A &= 30\\times30 = 900\\text{ cm}^2\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "How many tiles are needed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p10-q18-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "48 tiles",
                    "marks": [
                      "bold"
                    ]
                  }
                ]
              }
            ]
          },
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p10-q18-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Divide the floor area by the area of one tile.",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{align*}N &= 43\\,200\\div900\\\\N &= 48\\end{align*}",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "48 tiles",
                    "marks": [
                      "bold"
                    ]
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q18-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "809d3a6f-d0a0-40ea-8df9-f75a7ba1f1e4",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "The same floor is covered with square tiles of side 15 cm. How many tiles are needed?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "192 tiles",
          "worked": "$$A_{\\mathrm{tile}}=15^2=225\\,\\mathrm{cm}^{2}$$\n$$N=43\\,200\\div225=192$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q18-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "d881346e-8022-43e5-bc24-9b75183b79a1",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "The same floor is covered with square tiles of side 60 cm. How many tiles are needed?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "12 tiles",
          "worked": "$$A_{\\mathrm{tile}}=60^2=3600\\,\\mathrm{cm}^{2}$$\n$$N=43\\,200\\div3600=12$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q18-f",
        "type": "part",
        "label": "f",
        "prompt": "Optional: Explain why halving the tile side requires four times as many tiles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each tile has one-quarter of the area, so four times as many cover the floor.",
          "worked": "Halving both side lengths multiplies the area by one-half twice. Each tile therefore has one-quarter of the area, so four times as many cover the same floor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
