  "content": {
    "id": "p62-q8",
    "type": "question",
    "label": "8",
    "prompt": "In each part, the angle of inclination $\\alpha$ and a point $A$ on the line are given.\nUse $m=\\tan\\alpha$ to find the gradient of each line, then find its equation in exact general form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p62-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha=45^\\circ,\\ A=(1,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1$; $x-y-1=0$.",
          "worked": "$$\\begin{align*}m&=\\tan45^\\circ=1\\\\y&=x+c\\\\0&=1+c\\\\c&=-1\\\\y&=x-1\\\\x-y-1&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p62-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha=120^\\circ,\\ A=(-1,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\sqrt3$; $\\sqrt3x+y+\\sqrt3=0$.",
          "worked": "$$\\begin{align*}m&=\\tan120^\\circ=-\\sqrt3\\\\y&=-\\sqrt3x+c\\\\0&=-\\sqrt3(-1)+c\\\\c&=-\\sqrt3\\\\y&=-\\sqrt3x-\\sqrt3\\\\\\sqrt3x+y+\\sqrt3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p62-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha=30^\\circ,\\ A=(4,-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\dfrac1{\\sqrt3}$; $x-\\sqrt3y-4-3\\sqrt3=0$.",
          "worked": "$$\\begin{align*}m&=\\tan30^\\circ=\\frac1{\\sqrt3}\\\\y&=\\frac{x}{\\sqrt3}+c\\\\-3&=\\frac4{\\sqrt3}+c\\\\c&=-3-\\frac4{\\sqrt3}\\\\y&=\\frac{x}{\\sqrt3}-3-\\frac4{\\sqrt3}\\\\\\sqrt3y&=x-3\\sqrt3-4\\\\x-\\sqrt3y-4-3\\sqrt3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p62-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\alpha=150^\\circ,\\ A=(-2,-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\dfrac1{\\sqrt3}$; $x+\\sqrt3y+2+5\\sqrt3=0$.",
          "worked": "$$\\begin{align*}m&=\\tan150^\\circ=-\\frac1{\\sqrt3}\\\\y&=-\\frac{x}{\\sqrt3}+c\\\\-5&=-\\frac{-2}{\\sqrt3}+c\\\\c&=-5-\\frac2{\\sqrt3}\\\\y&=-\\frac{x}{\\sqrt3}-5-\\frac2{\\sqrt3}\\\\\\sqrt3y&=-x-5\\sqrt3-2\\\\x+\\sqrt3y+2+5\\sqrt3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
