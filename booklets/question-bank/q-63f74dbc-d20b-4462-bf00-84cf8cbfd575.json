  "content": {
    "id": "p18-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Avery, Bella and Charlotte start running around a circular track at the same time. Avery takes 42 seconds to complete every lap, Bella takes 66 seconds and Charlotte takes 110 seconds. How many seconds elapse before they pass the starting line at the same time?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2310$ seconds.",
      "worked": "The first simultaneous return occurs after the least common multiple of their lap times.\n$$\\begin{align*}42&=2\\times3\\times7\\\\66&=2\\times3\\times11\\\\110&=2\\times5\\times11\\end{align*}$$\nTaking the greatest power of each prime,\n$$\\begin{align*}\\operatorname{LCM}(42,66,110)&=2\\times3\\times5\\times7\\times11\\\\\\operatorname{LCM}(42,66,110)&=2310.\\end{align*}$$\nThey next pass the starting line together after $2310$ seconds.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
