  "content": {
    "id": "p50-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "The current credit card rate of interest on Bankerscard is 23% per annum, compounded monthly.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "If a cardholder can afford to repay $\\$1500$ per month on the card, what is the maximum value of purchases that can be made in one day if the debt is to be paid off in two months? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2915.90$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p50-q21-answer-a",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Monthly growth factor:",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "r=1+\\frac{0.23}{12}",
                    "display": true
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Let the maximum purchase be ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "P",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Start: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "P",
                    "display": false
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "1st repayment: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "Pr-1500",
                    "display": false
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "2nd repayment: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "Pr^2-1500r-1500",
                    "display": false
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "The two repayments form a geometric series:",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "1500+1500r",
                    "display": true
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "with ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a=1500",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", common ratio ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "n=2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". When the debt is repaid:",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}0&=Pr^2-1500\\frac{r^2-1}{r-1}\\\\Pr^2&=1500\\frac{r^2-1}{r-1}\\\\P&=\\frac{1500(r^2-1)}{r^2(r-1)}\\\\P&=2915.902546\\ldots\\\\P&\\approx\\$2915.90\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p50-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "How much would be saved in interest payments if the cardholder instead saved up the money for two months before making the purchase?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$84.10$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p50-q21-answer-b",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Using the geometric-series result from part (a):",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Total repaid: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2(1500)=\\$3000",
                    "display": false
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Interest: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "3000-2915.90=\\$84.10",
                    "display": false
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Therefore saving first would save $84.10 in interest.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
