  "content": {
    "id": "p19-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find all values of $\\theta\\in[0^\\circ,360^\\circ]$ satisfying the following equations. For each of these, the related acute angle is either $30^\\circ$, $45^\\circ$ or $60^\\circ$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\theta=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^\\circ,300^\\circ$.",
          "worked": "The related acute angle is $60^\\circ$. Cosine is positive in quadrants I and IV.\n$$\\begin{align*}\\theta&=60^\\circ,\\ 360^\\circ-60^\\circ\\\\\\theta&=60^\\circ,300^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin\\theta=-\\frac1{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=225^\\circ,315^\\circ$.",
          "worked": "The related acute angle is $45^\\circ$. Sine is negative in quadrants III and IV.\n$$\\begin{align*}\\theta&=180^\\circ+45^\\circ,\\ 360^\\circ-45^\\circ\\\\\\theta&=225^\\circ,315^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\theta=\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^\\circ,240^\\circ$.",
          "worked": "The related acute angle is $60^\\circ$. Tangent is positive in quadrants I and III.\n$$\\begin{align*}\\theta&=60^\\circ,\\ 180^\\circ+60^\\circ\\\\\\theta&=60^\\circ,240^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\theta=-\\frac{\\sqrt3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=240^\\circ,300^\\circ$.",
          "worked": "The related acute angle is $60^\\circ$. Sine is negative in quadrants III and IV.\n$$\\begin{align*}\\theta&=180^\\circ+60^\\circ,\\ 360^\\circ-60^\\circ\\\\\\theta&=240^\\circ,300^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\tan\\theta=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=135^\\circ,315^\\circ$.",
          "worked": "The related acute angle is $45^\\circ$. Tangent is negative in quadrants II and IV.\n$$\\begin{align*}\\theta&=180^\\circ-45^\\circ,\\ 360^\\circ-45^\\circ\\\\\\theta&=135^\\circ,315^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\cos\\theta=-\\frac{\\sqrt3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=150^\\circ,210^\\circ$.",
          "worked": "The related acute angle is $30^\\circ$. Cosine is negative in quadrants II and III.\n$$\\begin{align*}\\theta&=180^\\circ-30^\\circ,\\ 180^\\circ+30^\\circ\\\\\\theta&=150^\\circ,210^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sec\\theta=\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=45^\\circ,315^\\circ$.",
          "worked": "$$\\cos\\theta=\\frac1{\\sqrt2}$$\nThe related acute angle is $45^\\circ$. Cosine is positive in quadrants I and IV.\n$$\\begin{align*}\\theta&=45^\\circ,\\ 360^\\circ-45^\\circ\\\\\\theta&=45^\\circ,315^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\operatorname{cosec}\\theta=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=210^\\circ,330^\\circ$.",
          "worked": "$$\\sin\\theta=-\\frac12$$\nThe related acute angle is $30^\\circ$. Sine is negative in quadrants III and IV.\n$$\\begin{align*}\\theta&=180^\\circ+30^\\circ,\\ 360^\\circ-30^\\circ\\\\\\theta&=210^\\circ,330^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\cot\\theta=-\\frac1{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=120^\\circ,300^\\circ$.",
          "worked": "$$\\tan\\theta=-\\sqrt3$$\nThe related acute angle is $60^\\circ$. Tangent is negative in quadrants II and IV.\n$$\\begin{align*}\\theta&=180^\\circ-60^\\circ,\\ 360^\\circ-60^\\circ\\\\\\theta&=120^\\circ,300^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
