  "content": {
    "id": "p97-q15-response",
    "type": "question",
    "label": "15",
    "prompt": "The variable $z$ varies directly with the cube of $x$. If $z=64$ when $x=4$, find $z$ when $x=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$z=8$",
      "worked": "$$\\begin{align*}z&=kx^3\\\\64&=k(4^3)\\\\k&=1\\end{align*}$$\n\nWhen $x=2$,\n\n$$\\begin{align*}z&=2^3\\\\z&=8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
