  "content": {
    "id": "v2-954e5-p15-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "Find the value of $\\dfrac1{\\alpha^2}+\\dfrac1{\\beta^2}$ in each case, where $\\alpha$ and $\\beta$ are the roots of the equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-954e5-p15-practice-slot-6-slot-6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2-5x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{37}{9}$",
          "worked": "$\\alpha+\\beta=\\dfrac52$, $\\alpha\\beta=-\\dfrac32$.\n$$\\begin{align*}\\frac1{\\alpha^2}+\\frac1{\\beta^2}&=\\frac{\\alpha^2+\\beta^2}{(\\alpha\\beta)^2}\\\\&=\\frac{(\\alpha+\\beta)^2-2\\alpha\\beta}{(\\alpha\\beta)^2}\\\\&=\\frac{\\frac{25}{4}+3}{\\frac94}\\\\&=\\frac{37}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-954e5-p15-practice-slot-6-slot-6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+px+8=0$, given that $\\dfrac1{\\alpha^2}+\\dfrac1{\\beta^2}=\\dfrac5{16}$. Find the possible values of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\pm6$",
          "worked": "$\\alpha+\\beta=-p$, $\\alpha\\beta=8$.\n$$\\begin{align*}\\frac{(\\alpha+\\beta)^2-2\\alpha\\beta}{(\\alpha\\beta)^2}&=\\frac5{16}\\\\\\frac{p^2-16}{64}&=\\frac5{16}\\\\p^2-16&=20\\\\p^2&=36\\\\p&=\\pm6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
