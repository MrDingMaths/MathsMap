  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Using prime factorisation, determine:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10a",
        "type": "part",
        "label": "a",
        "prompt": "$\\phi(24)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}24&=2^3\\times3\\\\\\phi(24)&=\\phi(2^3)\\phi(3)\\\\\\phi(24)&=(2^3-2^2)(3-1)\\\\\\phi(24)&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10b",
        "type": "part",
        "label": "b",
        "prompt": "$\\phi(30)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}30&=2\\times3\\times5\\\\\\phi(30)&=\\phi(2)\\phi(3)\\phi(5)\\\\\\phi(30)&=(2-1)(3-1)(5-1)\\\\\\phi(30)&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10c",
        "type": "part",
        "label": "c",
        "prompt": "$\\phi(42)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}42&=2\\times3\\times7\\\\\\phi(42)&=\\phi(2)\\phi(3)\\phi(7)\\\\\\phi(42)&=(2-1)(3-1)(7-1)\\\\\\phi(42)&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10d",
        "type": "part",
        "label": "d",
        "prompt": "$\\phi(64)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32$",
          "worked": "$$\\begin{align*}64&=2^6\\\\\\phi(64)&=2^6-2^5\\\\\\phi(64)&=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q10e",
        "type": "part",
        "label": "e",
        "prompt": "$\\phi(320)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$128$",
          "worked": "$$\\begin{align*}320&=2^6\\times5\\\\\\phi(320)&=\\phi(2^6)\\phi(5)\\\\\\phi(320)&=(2^6-2^5)(5-1)\\\\\\phi(320)&=128\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10f",
        "type": "part",
        "label": "f",
        "prompt": "$\\phi(240)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64$",
          "worked": "$$\\begin{align*}240&=2^4\\times3\\times5\\\\\\phi(240)&=\\phi(2^4)\\phi(3)\\phi(5)\\\\\\phi(240)&=(2^4-2^3)(3-1)(5-1)\\\\\\phi(240)&=64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10g",
        "type": "part",
        "label": "g",
        "prompt": "$\\phi(432)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$144$",
          "worked": "$$\\begin{align*}432&=2^4\\times3^3\\\\\\phi(432)&=\\phi(2^4)\\phi(3^3)\\\\\\phi(432)&=(2^4-2^3)(3^3-3^2)\\\\\\phi(432)&=144\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q10h",
        "type": "part",
        "label": "h",
        "prompt": "$\\phi(1400)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$480$",
          "worked": "$$\\begin{align*}1400&=2^3\\times5^2\\times7\\\\\\phi(1400)&=\\phi(2^3)\\phi(5^2)\\phi(7)\\\\\\phi(1400)&=(2^3-2^2)(5^2-5)(7-1)\\\\\\phi(1400)&=4\\times20\\times6\\\\\\phi(1400)&=480\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
