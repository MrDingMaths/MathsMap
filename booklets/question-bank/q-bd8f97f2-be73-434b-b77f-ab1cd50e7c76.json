    "type": "question",
    "label": null,
    "prompt": "A teacher shares $72$ stickers equally among a group of students.\nEach student receives $6$ stickers.\nHow many students are in the group?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12$ students.\n\nDivide the total by the mean.",
      "worked": "$$\\begin{align*}n &= \\frac{72}{6}\\\\n &= 12\\end{align*}$$\nThere are $12$ students in the group.",
