        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\,404$",
          "worked": "$$\\begin{align*}102^2&=(100+2)^2\\\\102^2&=100^2+2\\times100\\times2+2^2\\\\102^2&=10\\,000+400+4\\\\102^2&=10\\,404\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p4-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$999^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$998\\,001$",
          "worked": "$$\\begin{align*}999^2&=(1000-1)^2\\\\999^2&=1000^2-2\\times1000\\times1+1^2\\\\999^2&=1\\,000\\,000-2000+1\\\\999^2&=998\\,001\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$203\\times197$",
