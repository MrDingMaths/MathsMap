    "difficulty": "Development",
    "difficultyReason": "Convert annual income to an hourly rate using weekly working hours and 52 weeks per year."
  },
  "content": {
    "id": "p36-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Convert the annual income to an equivalent hourly rate. Round to 2 d.p.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "\\$30 526 p.a., 38-hour week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$15.45/h",
          "worked": "$$\\begin{align*}\\text{Hours per year} &= 38\\times52\\\\ &= 1976\\\\ \\text{Hourly rate} &= \\frac{\\$30\\,526}{1976}\\\\ &\\approx \\$15.45/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p36-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "\\$48 253 p.a., 30-hour week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$30.93/h",
          "worked": "$$\\begin{align*}\\text{Hours per year} &= 30\\times52\\\\ &= 1560\\\\ \\text{Hourly rate} &= \\frac{\\$48\\,253}{1560}\\\\ &\\approx \\$30.93/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p36-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "\\$62 251.22 p.a., 28-hour week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$42.75/h",
          "worked": "$$\\begin{align*}\\text{Hours per year} &= 28\\times52\\\\ &= 1456\\\\ \\text{Hourly rate} &= \\frac{\\$62\\,251.22}{1456}\\\\ &\\approx \\$42.75/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p36-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "\\$25 994.60 p.a., 16-hour week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$31.24/h",
          "worked": "$$\\begin{align*}\\text{Hours per year} &= 16\\times52\\\\ &= 832\\\\ \\text{Hourly rate} &= \\frac{\\$25\\,994.60}{832}\\\\ &\\approx \\$31.24/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
