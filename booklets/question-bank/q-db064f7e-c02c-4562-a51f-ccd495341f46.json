  "content": {
    "id": "p58-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the natural domain of each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{1}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R},\\ x\\ne2$.",
          "worked": "The denominator cannot be zero.\n$$\\begin{align*}x-2&\\ne0\\\\x&\\ne2\\end{align*}$$\nThe natural domain is all real $x$ except $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p58-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\sqrt{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge1$.",
          "worked": "The expression under the square root must be non-negative.\n$$\\begin{align*}x-1&\\ge0\\\\x&\\ge1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sqrt{3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge-\\dfrac{2}{3}$.",
          "worked": "The expression under the square root must be non-negative.\n$$\\begin{align*}3x+2&\\ge0\\\\3x&\\ge-2\\\\x&\\ge-\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p58-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{1}{\\sqrt{2-x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<2$.",
          "worked": "The square root must be defined and the denominator must be non-zero, so the radicand must be positive.\n$$\\begin{align*}2-x&>0\\\\-x&>-2\\\\x&<2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
