      {
        "id": "p33-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the most popular sport for this group of students?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rugby.",
          "worked": "Rugby has the greatest frequency: $12$ students.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p33-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the least popular sport for this group of students?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Basketball.",
          "worked": "Basketball has the smallest frequency: $4$ students.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p33-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "What fraction of the students has chosen soccer as their favourite sport?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$$\\begin{align*}\\text{Soccer fraction}&=\\frac{6}{30}\\\\\\text{Soccer fraction}&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p33-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "What fraction of the students has chosen either rugby or AFL?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\begin{align*}\\text{Rugby or AFL fraction}&=\\frac{12+8}{30}\\\\\\text{Rugby or AFL fraction}&=\\frac{20}{30}\\\\\\text{Rugby or AFL fraction}&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
