  "content": {
    "id": "v2-a52cc-p10-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "\\$12 000 is invested at 5% p.a. compound interest.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a52cc-p10-practice-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the interest earned in the third year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$661.50$",
          "worked": "$$\\begin{align*}\\text{Balance after 2 years}&=12\\,000(1.05)^2=13\\,230\\\\\\text{Interest in year 3}&=13\\,230\\times0.05\\\\&=\\$661.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-a52cc-p10-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage of the total interest earned over the 3 years was earned in the third year? Round to the nearest per cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "35%",
          "worked": "$$\\begin{align*}FV&=12\\,000(1.05)^3=13\\,891.50\\\\\\text{Total interest}&=13\\,891.50-12\\,000=1891.50\\\\\\text{Percentage}&=\\frac{661.50}{1891.50}\\times100\\\\&\\approx35\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ],
    "responseKind": "group-answer",
    "answer": {
      "short": "a) $\\$661.50$; b) 35%",
      "worked": "See parts.",
      "solutionDiagrams": []
    }
  },
