  "content": {
    "id": "p20-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A cone has base radius $10\\text{ cm}$ and total surface area $1000\\text{ cm}^2$. Find, correct to two decimal places:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "the surface area of the curved part of the cone",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$685.84\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A_{\\text{curved}}&=1000-\\pi r^2\\\\A_{\\text{curved}}&=1000-100\\pi\\text{ cm}^2\\\\A_{\\text{curved}}&\\approx685.84\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p20-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "the slant height of the cone",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21.83\\text{ cm}$",
          "worked": "$$\\begin{align*}10\\pi\\ell&=1000-100\\pi\\\\\\ell&=\\frac{1000-100\\pi}{10\\pi}\\\\\\ell&=\\left(\\frac{100}{\\pi}-10\\right)\\text{ cm}\\\\\\ell&\\approx21.83\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p20-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "the height of the cone",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19.41\\text{ cm}$",
          "worked": "Use the unrounded slant height. By Pythagoras’ theorem:\n$$\\begin{align*}h^2+10^2&=\\left(\\frac{100}{\\pi}-10\\right)^2\\\\h&=\\sqrt{\\left(\\frac{100}{\\pi}-10\\right)^2-100}\\text{ cm}\\\\h&\\approx19.41\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
