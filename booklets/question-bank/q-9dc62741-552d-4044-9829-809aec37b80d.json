          {
            "id": "p36-q11-a-root",
            "type": "part",
            "label": "ii",
            "prompt": "Use the prime factorisation of $784$ to find $\\sqrt{784}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$28$",
              "worked": "$$\\begin{align*}784&=2^4\\times7^2\\\\784&=(2^2\\times7)^2\\\\\\sqrt{784}&=2^2\\times7\\\\\\sqrt{784}&=28\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
