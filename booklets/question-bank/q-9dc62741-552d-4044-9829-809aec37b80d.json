          {
            "id": "p36-q11-a-tree",
            "type": "part",
            "label": "i",
            "prompt": "Draw the factor tree of $784$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$784=2^4\\times7^2$. One possible factor tree is shown.",
              "worked": "$784=28\\times28$, with each $28=4\\times7$ and each $4=2\\times2$.\n$$\\begin{align*}784&=2\\times2\\times7\\times2\\times2\\times7\\\\784&=2^4\\times7^2\\end{align*}$$",
              "solutionDiagrams": [
                {
                  "id": "p36-q11-a-tree-solution",
                  "role": "solution",
                  "format": "tikz",
                  "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 36, p36-q11-a-tree-solution\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=2pt},line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\node (r) at (0,0) {$784$};\n\\node (l) at (-1.6,-0.9) {$28$};\n\\node (rr) at (1.6,-0.9) {$28$};\n\\node (l4) at (-2.3,-1.8) {$4$};\n\\node (l7) at (-0.9,-1.8) {$7$};\n\\node (r4) at (0.9,-1.8) {$4$};\n\\node (r7) at (2.3,-1.8) {$7$};\n\\node (l2a) at (-2.8,-2.7) {$2$};\n\\node (l2b) at (-1.8,-2.7) {$2$};\n\\node (r2a) at (0.4,-2.7) {$2$};\n\\node (r2b) at (1.4,-2.7) {$2$};\n\\draw[black] (r)--(l) (r)--(rr) (l)--(l4) (l)--(l7) (rr)--(r4) (rr)--(r7) (l4)--(l2a) (l4)--(l2b) (r4)--(r2a) (r4)--(r2b);\n\\end{tikzpicture}",
                  "src": null,
                  "widthMm": 65,
                  "alt": "Mathematical diagram",
                  "overlayOf": null,
                  "transparent": false,
                  "axes": null,
                  "spec": {
                    "sourcePage": 36,
                    "sourceRegion": "Question 11a",
                    "description": "One valid factor tree for 784, ending only in prime factors.",
                    "mathematics": "784=28×28; each 28=4×7; each 4=2×2.",
                    "answerVisibility": "Solution only; the source supplies a blank drawing area."
                  },
                  "derived": false,
                  "reviewStatus": "needs-review"
                }
              ]
            },
            "answerSpaceMm": 45
