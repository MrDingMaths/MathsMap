    "children": [
      {
        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "When $x$ is doubled, $y$ is some new value $y_2$. Show that $y_2=\\dfrac{y_1}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y_2=\\dfrac{k}{2x_1}=\\dfrac12\\left(\\dfrac{k}{x_1}\\right)=\\dfrac{y_1}{2}$.",
          "worked": "Initially, $y_1=\\dfrac{k}{x_1}$. When $x$ is doubled,\n$$\\begin{align*}y_2&=\\frac{k}{2x_1}\\\\y_2&=\\frac12\\left(\\frac{k}{x_1}\\right)\\\\y_2&=\\frac{y_1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, state the effect on $y$ if $x$ is doubled.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ is halved.",
          "worked": "Since $y_2=\\dfrac{y_1}{2}$, doubling $x$ halves $y$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q6-c",
        "type": "group",
        "label": "c",
        "prompt": "Use a similar technique, or otherwise, to state the effect on $y$ if $x$ is",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q6-c-i",
            "type": "part",
            "label": "i",
            "prompt": "halved.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y$ doubles.",
              "worked": "$$\\begin{align*}y_2&=\\frac{k}{x_1/2}\\\\y_2&=\\frac{2k}{x_1}\\\\y_2&=2y_1.\\end{align*}$$Thus $y$ doubles.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p8-q6-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "tripled.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y$ is divided by 3.",
              "worked": "$$\\begin{align*}y_2&=\\frac{k}{3x_1}\\\\y_2&=\\frac13\\left(\\frac{k}{x_1}\\right)\\\\y_2&=\\frac{y_1}{3}.\\end{align*}$$Thus $y$ is divided by 3.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      }
    ]
