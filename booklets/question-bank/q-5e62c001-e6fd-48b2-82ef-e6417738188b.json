  "content": {
    "id": "p24-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "If a fair six-sided die is rolled three times, find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "three sixes are obtained",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{216}$",
          "worked": "The rolls are independent.\n$$\\begin{align*}\\Pr(\\text{three sixes})&=\\frac16\\times\\frac16\\times\\frac16\\\\\\Pr(\\text{three sixes})&=\\frac{1}{216}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "a six is obtained for the first two rolls but not the third",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{216}$",
          "worked": "The probability of not rolling a six is $\\frac56$.\n$$\\begin{align*}\\Pr(\\text{six, six, not six})&=\\frac16\\times\\frac16\\times\\frac56\\\\\\Pr(\\text{six, six, not six})&=\\frac{5}{216}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "exactly two sixes are obtained.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{72}$\n\nAdd the probabilities for the three possible positions of the non-six.",
          "worked": "Let $S$ denote a six and $N$ a non-six. The mutually exclusive possibilities are $SSN$, $SNS$ and $NSS$.\n$$\\begin{align*}\\Pr(\\text{exactly two sixes})&=\\frac16\\times\\frac16\\times\\frac56+\\frac16\\times\\frac56\\times\\frac16+\\frac56\\times\\frac16\\times\\frac16\\\\\\Pr(\\text{exactly two sixes})&=3\\times\\frac{5}{216}\\\\\\Pr(\\text{exactly two sixes})&=\\frac{5}{72}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
