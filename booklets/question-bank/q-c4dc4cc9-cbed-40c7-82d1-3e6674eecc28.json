  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "How many ways can we form an odd three-digit number, using the digits $\\{1,2,3,4,5\\}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "without further restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75$",
          "worked": "The final digit is $1$, $3$ or $5$: $3$ choices. Repetition is allowed, so each of the first two digits has $5$ choices.\n\n$$\\begin{align*}N&=5\\times5\\times3\\\\N&=75\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "without repetition",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "Choose the final digit from $1$, $3$ or $5$: $3$ choices. There are then $4$ choices for the first digit and $3$ for the second digit.\n\n$$\\begin{align*}N&=4\\times3\\times3\\\\N&=36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
