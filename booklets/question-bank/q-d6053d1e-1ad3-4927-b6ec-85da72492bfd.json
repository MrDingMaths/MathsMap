  "content": {
    "id": "p15-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Suppose that $y$ is directly proportional to $x$ and inversely proportional to $w$. If $y=2$ when $x=7$ and $w=14$, find $y$ when $x=10$ and $w=8$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=5$",
      "worked": "For a positive constant $k$,\n$$\\begin{align*}y&=\\frac{kx}{w}\\\\2&=\\frac{k\\times7}{14}\\\\k&=4\\end{align*}$$\nThus $y=\\dfrac{4x}{w}$. When $x=10$ and $w=8$,\n$$\\begin{align*}y&=\\frac{4\\times10}{8}\\\\y&=5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
