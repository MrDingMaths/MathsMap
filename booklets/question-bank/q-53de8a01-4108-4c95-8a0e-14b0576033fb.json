  "content": {
    "id": "p19-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "There are approximately $20$ million registered cars in Australia. On average each car travels $16\\,000$ km per year, and uses $10$ litres of petrol for every $100$ kilometres travelled. Estimate the volume of petrol consumed by Australian cars each year, expressing your answer using scientific notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately $3.2\\times10^{10}$ litres per year.",
      "worked": "Annual petrol consumption per car:\n$$\\begin{align*}V_{\\text{car}}&=\\frac{16\\,000}{100}\\times10\\\\V_{\\text{car}}&=1600\\text{ L}\\end{align*}$$\nAnnual petrol consumption for all cars:\n$$\\begin{align*}V&=(2\\times10^7)(1.6\\times10^3)\\\\V&=3.2\\times10^{10}\\text{ L}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
