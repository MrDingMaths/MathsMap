  "content": {
    "id": "p36-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "How many cards must be dealt from a standard deck of 52 playing cards to be sure that you will obtain at least two cards of the same:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "colour",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 cards.",
          "worked": "There are two colours: red and black. Two cards could have different colours. By the pigeonhole principle, dealing $2+1=3$ cards guarantees at least two of the same colour.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p36-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "suit",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 cards.",
          "worked": "There are four suits. Four cards could include one of each suit. By the pigeonhole principle, dealing $4+1=5$ cards guarantees at least two of the same suit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p36-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "rank?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "14 cards.",
          "worked": "There are thirteen ranks: ace, 2 through 10, jack, queen and king. Thirteen cards could include one of each rank. By the pigeonhole principle, dealing $13+1=14$ cards guarantees at least two of the same rank.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
