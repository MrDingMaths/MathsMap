    ],
    "children": [
      {
        "id": "p11-q5-a-node",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "7c90d179-25e0-4cc1-872c-536e19cd7189",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "A blue marlin has a girth of 72 inches and a length of 156 inches. Could it weigh over 1000 pounds? ",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Give the estimated weight to 2 decimal places.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; the estimated weight is $1010.88$ pounds.",
          "worked": "$$\\begin{align*}w&=\\frac{Lg^2}{800}\\\\w&=\\frac{156(72)^2}{800}\\\\w&=1010.88\\text{ pounds}\\end{align*}$$\nYes, because $1010.88>1000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q5-b-node",
        "type": "part",
        "label": "b",
        "prompt": "A swordfish is 120 inches in length and weighs 175 pounds. Estimate its girth to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34.16$ inches",
          "worked": "$$\\begin{align*}w&=\\frac{Lg^2}{800}\\\\175&=\\frac{120g^2}{800}\\\\g^2&=\\frac{175\\times800}{120}\\\\g&=\\sqrt{\\frac{175\\times800}{120}}\\\\g&\\approx34.16\\text{ inches}\\end{align*}$$\nUse the positive square root because girth is a length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
