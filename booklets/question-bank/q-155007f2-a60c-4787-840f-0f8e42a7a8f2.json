          "inlines": [
            {
              "type": "text",
              "text": "In the United States, the weight of a fish is estimated by measuring the girth ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "g",
              "display": false
            },
            {
              "type": "text",
              "text": " (all around the fish) at the thickest point in inches and the length ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "L",
              "display": false
            },
            {
              "type": "text",
              "text": " also in inches. The formula for the estimated weight, in pounds, is",
              "marks": []
            }
          ]
        },
        {
          "id": "p11-q5-formula",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "w=\\frac{Lg^2}{800}",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p11-q5-fish-figure",
        "role": "question",
        "format": "image",
        "code": null,
        "src": "/booklet-assets/projects/simple-quadratic-equations-v1/67bc7ab83c53-image2.png",
