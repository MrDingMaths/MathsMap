    "type": "question",
    "label": "14",
    "prompt": "The angles of a triangle are in the ratio $6:5:7$. Find the size of each of the angles.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$60^\\circ$, $50^\\circ$ and $70^\\circ$.",
      "worked": "The angles of a triangle sum to $180^\\circ$.\n$$\\begin{align*}\\text{Total parts}&=6+5+7=18\\\\\\text{One part}&=180^\\circ\\div18=10^\\circ\\\\\\text{First angle}&=6\\times10^\\circ=60^\\circ\\\\\\text{Second angle}&=5\\times10^\\circ=50^\\circ\\\\\\text{Third angle}&=7\\times10^\\circ=70^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
