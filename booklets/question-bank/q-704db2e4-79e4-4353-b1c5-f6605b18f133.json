  "content": {
    "id": "p39-q52-root",
    "type": "question",
    "label": "52",
    "prompt": "Let $f(x)=k\\cos x+(k+2)\\sin x$. Find the value of $k$ that gives",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q52-a",
        "type": "part",
        "label": "a",
        "prompt": "an amplitude of $10$ units?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=6$ or $k=-8$.",
          "worked": "$$\\begin{align*}k^2+(k+2)^2&=10^2\\\\2k^2+4k+4&=100\\\\k^2+2k-48&=0\\\\(k+8)(k-6)&=0\\\\k&=-8,\\ 6.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p39-q52-b",
        "type": "part",
        "label": "b",
        "prompt": "the smallest possible amplitude?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-1$.\n\nMinimise $R^2=2(k+1)^2+2$.",
          "worked": "$$\\begin{align*}R^2&=k^2+(k+2)^2\\\\R^2&=2k^2+4k+4\\\\R^2&=2(k+1)^2+2.\\end{align*}$$\nSince $(k+1)^2\\ge0$, the minimum occurs at $k=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
