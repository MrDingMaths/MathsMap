  "content": {
    "id": "p15-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Trains leave Central to Parramatta every 15 minutes and to Chatswood every 21 minutes.\nA train to Parramatta and a train to Chatswood both leave Central at 11 am.\nWhat is the next time a train to Parramatta and a train to Chatswood will leave at the same time?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12:45 pm, after 105 minutes.",
      "worked": "Use the LCM because both departure intervals must divide the elapsed time. The HCF of 15 and 21 is 3.\n$$\\begin{align*}\\operatorname{LCM}(15,21)&=\\frac{15\\times21}{3}\\\\\\operatorname{LCM}(15,21)&=105\\end{align*}$$\n105 minutes is 1 hour 45 minutes. The next simultaneous departure is at 12:45 pm.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
