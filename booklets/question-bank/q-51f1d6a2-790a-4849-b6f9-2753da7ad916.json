    "type": "question",
    "label": "41",
    "prompt": "Rationalise the denominator of the following. $\\dfrac{2}{1+\\sqrt{3}}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt{3}-1$\n\nMultiply numerator and denominator by $1-\\sqrt{3}$.",
      "worked": "$$\\begin{align*}\\frac{2}{1+\\sqrt{3}}&=\\frac{2}{1+\\sqrt{3}}\\times\\frac{1-\\sqrt{3}}{1-\\sqrt{3}}\\\\\\frac{2}{1+\\sqrt{3}}&=\\frac{2-2\\sqrt{3}}{1-3}\\\\\\frac{2}{1+\\sqrt{3}}&=\\frac{2-2\\sqrt{3}}{-2}\\\\\\frac{2}{1+\\sqrt{3}}&=\\sqrt{3}-1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
