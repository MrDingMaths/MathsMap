            "label": "i",
            "prompt": "$\\frac{3}{5}+\\frac{1}{10}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{7}{10}$",
              "worked": "$$\\begin{align*}\\frac{3}{5}+\\frac{1}{10}&=\\frac{6}{10}+\\frac{1}{10}\\\\&=\\frac{7}{10}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p9-q1-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\frac{3}{40}+\\frac{1}{20}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{8}$",
              "worked": "$$\\begin{align*}\\frac{3}{40}+\\frac{1}{20}&=\\frac{3}{40}+\\frac{2}{40}\\\\&=\\frac{5}{40}\\\\&=\\frac{1}{8}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
          },
          {
            "id": "p9-q1-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\frac{3}{z}+\\frac{1}{2z}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{7}{2z}$",
              "worked": "$$\\begin{align*}\\frac{3}{z}+\\frac{1}{2z}&=\\frac{6}{2z}+\\frac{1}{2z}\\\\&=\\frac{7}{2z}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p9-q1-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$\\frac{3}{2x}+\\frac{1}{x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{5}{2x}$",
              "worked": "$$\\begin{align*}\\frac{3}{2x}+\\frac{1}{x}&=\\frac{3}{2x}+\\frac{2}{2x}\\\\&=\\frac{5}{2x}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p9-q1-b",
        "type": "group",
        "label": "b",
