            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{40}$",
              "worked": "$$\\begin{align*}\\frac{3}{40}-\\frac{1}{20}&=\\frac{3}{40}-\\frac{2}{40}\\\\&=\\frac{1}{40}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p9-q1-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\frac{3}{z}-\\frac{1}{2z}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{5}{2z}$",
              "worked": "$$\\begin{align*}\\frac{3}{z}-\\frac{1}{2z}&=\\frac{6}{2z}-\\frac{1}{2z}\\\\&=\\frac{5}{2z}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
