            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{2}$",
              "worked": "$$\\begin{align*}\\frac{3}{5}-\\frac{1}{10}&=\\frac{6}{10}-\\frac{1}{10}\\\\&=\\frac{5}{10}\\\\&=\\frac{1}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
