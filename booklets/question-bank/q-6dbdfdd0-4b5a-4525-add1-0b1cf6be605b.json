  "content": {
    "id": "p22-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Let $f:\\mathbb{R}\\to\\mathbb{R}$ and $g:\\mathbb{R}\\to\\mathbb{R}$ be given by $f(x)=x^2+2$ and $g(x)=x^2-2$. Find the value(s) of $x$ for which:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(g(x))=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ 0,\\ 2$.",
          "worked": "$$\\begin{align*}f(g(x))&=(x^2-2)^2+2\\\\(x^2-2)^2+2&=6\\\\(x^2-2)^2&=4\\\\x^2-2&=\\pm2\\\\x^2&=4\\text{ or }0\\\\x&=-2,\\ 0,\\ 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p22-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(f(x))=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\sqrt{\\sqrt{5}-2}$.",
          "worked": "$$\\begin{align*}g(f(x))&=(x^2+2)^2-2\\\\(x^2+2)^2-2&=3\\\\(x^2+2)^2&=5\\\\x^2+2&=\\sqrt{5}\\\\x^2&=\\sqrt{5}-2\\\\x&=\\pm\\sqrt{\\sqrt{5}-2}\\end{align*}$$\nSince $x^2+2\\ge2$, the negative square root is impossible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
