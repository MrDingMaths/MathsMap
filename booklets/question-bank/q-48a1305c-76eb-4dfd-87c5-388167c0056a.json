  "content": {
    "id": "p19-ex5f-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Solve each of these equations for $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-ex5f-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$ax+b=cx+d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{d-b}{a-c}$",
          "worked": "$$\\begin{align*}ax+b&=cx+d\\\\ax-cx+b&=d\\\\ax-cx&=d-b\\\\x(a-c)&=d-b\\\\x&=\\frac{d-b}{a-c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-ex5f-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$mx+n=nx-m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{m+n}{n-m}$",
          "worked": "$$\\begin{align*}mx+n&=nx-m\\\\mx-nx+n&=-m\\\\mx-nx&=-m-n\\\\x(m-n)&=-m-n\\\\x&=\\frac{m+n}{n-m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-ex5f-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$a(x+b)=cx+d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{d-ab}{a-c}$",
          "worked": "$$\\begin{align*}a(x+b)&=cx+d\\\\ax+ab&=cx+d\\\\ax-cx+ab&=d\\\\ax-cx&=d-ab\\\\x(a-c)&=d-ab\\\\x&=\\frac{d-ab}{a-c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p19-ex5f-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$a(x-b)=c(x-d)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{ab-cd}{a-c}$",
          "worked": "$$\\begin{align*}a(x-b)&=c(x-d)\\\\ax-ab&=cx-cd\\\\ax-cx-ab&=-cd\\\\ax-cx&=ab-cd\\\\x(a-c)&=ab-cd\\\\x&=\\frac{ab-cd}{a-c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
