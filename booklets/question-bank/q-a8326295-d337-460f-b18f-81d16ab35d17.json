  "content": {
    "id": "p17-q4-root",
    "type": "question",
    "label": null,
    "prompt": "Solve for $x\\in[0,2\\pi]$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin x=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3\\pi}{2}$.",
          "worked": "On the unit circle, sine is $-1$ at the bottom point only.\n$$x=\\frac{3\\pi}{2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p17-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos x=\\frac{1}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{\\pi}{4},\\frac{7\\pi}{4}$.",
          "worked": "Cosine is positive in quadrants I and IV.\n$$\\begin{align*}x&=\\frac{\\pi}{4},2\\pi-\\frac{\\pi}{4},\\\\x&=\\frac{\\pi}{4},\\frac{7\\pi}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,2\\pi$.",
          "worked": "Cosine is $1$ at the positive horizontal axis. Both domain endpoints are included:\n$$x=0,2\\pi.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p17-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan x=-\\frac{1}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5\\pi}{6},\\frac{11\\pi}{6}$.",
          "worked": "Tangent is negative in quadrants II and IV, with reference angle $\\frac{\\pi}{6}$.\n$$\\begin{align*}x&=\\pi-\\frac{\\pi}{6},2\\pi-\\frac{\\pi}{6},\\\\x&=\\frac{5\\pi}{6},\\frac{11\\pi}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p17-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos x=-\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2\\pi}{3},\\frac{4\\pi}{3}$.",
          "worked": "Cosine is negative in quadrants II and III, with reference angle $\\frac{\\pi}{3}$.\n$$\\begin{align*}x&=\\pi-\\frac{\\pi}{3},\\pi+\\frac{\\pi}{3},\\\\x&=\\frac{2\\pi}{3},\\frac{4\\pi}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p17-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan x=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3\\pi}{4},\\frac{7\\pi}{4}$.",
          "worked": "Tangent is negative in quadrants II and IV, with reference angle $\\frac{\\pi}{4}$.\n$$\\begin{align*}x&=\\pi-\\frac{\\pi}{4},2\\pi-\\frac{\\pi}{4},\\\\x&=\\frac{3\\pi}{4},\\frac{7\\pi}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
