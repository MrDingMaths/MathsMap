      {
        "id": "p22-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Use the formula to find the volume of water in the tank after $2\\frac12$ minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27\\frac12$ litres.",
          "worked": "$$\\begin{align*}V&=5\\times\\frac52+15\\\\V&=\\frac{25}{2}+15\\\\V&=27\\frac12\\text{ litres}\\end{align*}$$",
