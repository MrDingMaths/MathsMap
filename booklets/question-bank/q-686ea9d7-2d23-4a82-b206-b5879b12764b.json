        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=5t+15$, for $0\\le t\\le5$.",
          "worked": "The initial volume is 15 litres and the volume increases by 5 litres each minute, so $V=5t+15$ for $0\\le t\\le5$.",
          "solutionDiagrams": []
