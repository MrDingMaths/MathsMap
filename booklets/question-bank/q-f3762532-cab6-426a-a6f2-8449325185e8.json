        "answer": {
          "short": "$\\dfrac{1}{4}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{4(x+3)}&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
