        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{4(x+3)}{8(x+3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{4(x+3)}{8(x+3)}&=\\frac{4}{8}\\\\&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q3d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{4(x+3)^2}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(x+3)$",
          "worked": "$$\\begin{align*}\\frac{4(x+3)^2}{x+3}&=\\frac{4(x+3)(x+3)}{x+3}\\\\&=4(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q3e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{4(x+3)}{(x+3)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{4(x+3)}{(x+3)^2}&=\\frac{4(x+3)}{(x+3)(x+3)}\\\\&=\\frac{4}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q3f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(x+3)^2}{4(x+3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{4}$",
          "worked": "$$\\begin{align*}\\frac{(x+3)^2}{4(x+3)}&=\\frac{(x+3)(x+3)}{4(x+3)}\\\\&=\\frac{x+3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
