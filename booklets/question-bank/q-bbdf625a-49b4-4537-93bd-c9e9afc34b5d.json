              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "The lowest minted year was 1972, with 8.25 million coins, and the highest minted year was 2005, with 194.3 million coins.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p14-act5-intro-3",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
