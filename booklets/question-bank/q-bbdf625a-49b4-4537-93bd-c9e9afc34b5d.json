            "answer": {
              "short": "Practical activity.",
              "worked": "Collect a pool of 5-cent coins large enough to take the required samples.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          },
          {
            "id": "p14-act5-b",
            "type": "part",
            "label": "b",
            "prompt": "Take samples of 20 and record the age of each.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Results vary. Record 20 coin ages, in years, for each sample.",
              "worked": "For each coin, calculate its age in years as the year of collection minus its minting year. Record all 20 ages for each sample separately.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p14-act5-c",
            "type": "part",
            "label": "c",
            "prompt": "Calculate the mean age of the 20 coins.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Results vary. $\\text{Mean age}=\\dfrac{\\text{sum of the 20 ages}}{20}$ years.",
              "worked": "Add the 20 recorded ages for each sample, then divide by 20:\n$$\\text{Mean age}=\\frac{\\text{sum of the 20 ages}}{20}\\text{ years}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p14-act5-d",
            "type": "part",
            "label": "d",
            "prompt": "Compare your results with others and record all of the results on a dot plot.",
