    "type": "question",
    "label": "4",
    "prompt": "True or False? Let $A$ and $B$ be sets in a universal set $U$.\n\n$A\\cup B=U$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "False.",
      "worked": "False. Elements of $U$ may lie outside both sets. For example, let $U=\\{1,2\\}$ and $A=B=\\{1\\}$. Then $A\\cup B=\\{1\\}\\ne U$.",
      "solutionDiagrams": []
    },
