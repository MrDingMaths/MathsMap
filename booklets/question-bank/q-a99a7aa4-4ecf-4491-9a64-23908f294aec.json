  "content": {
    "id": "p59-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Write down the centre and radius of each circle. Shifting may help locate the centre.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p59-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+y^2=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(0,0)$, radius $1$.",
          "worked": "Compare with $(x-a)^2+(y-b)^2=r^2$. Here $a=0$, $b=0$ and $r^2=1$, so the centre is $(0,0)$ and the radius is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p59-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+1)^2+y^2=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-1,0)$, radius $2$.",
          "worked": "The circle $x^2+y^2=4$ has radius $\\sqrt{4}=2$. Replacing $x$ by $x+1$ shifts its centre left by 1 unit to $(-1,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p59-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x-2)^2+(y+3)^2=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(2,-3)$, radius $\\sqrt{5}$.",
          "worked": "The circle $x^2+y^2=5$ has radius $\\sqrt{5}$. Shift it right by 2 units and down by 3 units to obtain centre $(2,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p59-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+(y-4)^2=64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(0,4)$, radius $8$.",
          "worked": "The circle $x^2+y^2=64$ has radius $\\sqrt{64}=8$. Replacing $y$ by $y-4$ shifts its centre up by 4 units to $(0,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
