  "content": {
    "id": "p61-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Daily rainfall in a city is normally distributed with mean 4.2 mm and standard deviation 1.5 mm.\nOn a particular day, rainfall exceeds 75% of all recorded days. Find that day's rainfall to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5.2\\text{ mm}$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p61-q5-worked-percentile",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "We want a z-score with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "P(Z\\le z)=0.75",
                "display": false
              }
            ]
          },
          {
            "id": "p61-q5-worked-z",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using the table, or inverse normal on a calculator, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "z\\approx0.67",
                "display": false
              }
            ]
          },
          {
            "id": "p61-q5-worked-rainfall",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}x&=\\mu+z\\sigma\\\\x&\\approx4.2+0.67(1.5)\\\\x&\\approx5.2\\text{ mm}\\quad\\text{(1 d.p.)}\\end{aligned}",
                "display": false
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
