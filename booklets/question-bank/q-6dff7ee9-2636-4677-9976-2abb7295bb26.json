  "content": {
    "id": "p54-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Consider the graph of $y=\\sqrt{x}$. Find the equation of the final graph if $y=\\sqrt{x}$ is",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "translated right by 3 units, then reflected across the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sqrt{-x-3}$",
          "worked": "Translate right: replace $x$ by $x-3$.\n$$y=\\sqrt{x-3}$$\nReflect across the $y$-axis: replace $x$ by $-x$.\n$$\\begin{align*}y&=\\sqrt{(-x)-3}\\\\y&=\\sqrt{-x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p54-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "reflected across the $y$-axis, then translated right by 3 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sqrt{3-x}$",
          "worked": "Reflect across the $y$-axis: replace $x$ by $-x$.\n$$y=\\sqrt{-x}$$\nTranslate right: replace $x$ by $x-3$.\n$$\\begin{align*}y&=\\sqrt{-(x-3)}\\\\y&=\\sqrt{3-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p54-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "translated left by 2 units, then reflected across the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sqrt{-x+2}$",
          "worked": "Translate left: replace $x$ by $x+2$.\n$$y=\\sqrt{x+2}$$\nReflect across the $y$-axis: replace $x$ by $-x$.\n$$\\begin{align*}y&=\\sqrt{(-x)+2}\\\\y&=\\sqrt{-x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p54-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "reflected across the $y$-axis, then translated left by 2 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sqrt{-x-2}$",
          "worked": "Reflect across the $y$-axis: replace $x$ by $-x$.\n$$y=\\sqrt{-x}$$\nTranslate left: replace $x$ by $x+2$.\n$$\\begin{align*}y&=\\sqrt{-(x+2)}\\\\y&=\\sqrt{-x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
