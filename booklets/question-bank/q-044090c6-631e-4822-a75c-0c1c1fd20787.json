    "children": [
      {
        "id": "p51-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "How far from home did the cyclists start?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "90 km",
          "worked": "All three lines start at a distance of 90 km from home.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p51-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "How far was Jim from home after 1 hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "80 km",
          "worked": "At $t=1$ h, Jim's line is at 80 km from home.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p51-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "When was Sam 80 km from home?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "After 30 min",
          "worked": "Sam's line reaches 80 km from home at $t=0.5$ h, which is 30 min after starting.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p51-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "How long did it take Ben to travel 45 km?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 h 30 min",
          "worked": "$$\\begin{aligned}\\text{Distance from home}&=90-45\\\\&=45\\text{ km}\\end{aligned}$$\nBen's line reaches 45 km from home at $t=1.5$ h, so he took 1 h 30 min.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p51-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Which line is the steepest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ben's journey",
          "worked": "Ben's line has the greatest decrease in distance from home over the same time, so it is the steepest.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p51-q3-f",
        "type": "group",
        "label": "f",
        "prompt": "Calculate the speed of each cyclist.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p51-q3-f-jim",
            "type": "part",
            "label": "",
            "prompt": "Jim:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "10 km/h",
              "worked": "$$\\begin{aligned}\\text{Speed}&=\\frac{\\text{distance travelled}}{\\text{time taken}}\\\\&=\\frac{(90-70)\\text{ km}}{2\\text{ h}}\\\\&=10\\text{ km/h}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p51-q3-f-sam",
            "type": "part",
            "label": "",
            "prompt": "Sam:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "20 km/h",
              "worked": "$$\\begin{aligned}\\text{Speed}&=\\frac{\\text{distance travelled}}{\\text{time taken}}\\\\&=\\frac{(90-50)\\text{ km}}{2\\text{ h}}\\\\&=20\\text{ km/h}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p51-q3-f-ben",
            "type": "part",
            "label": "",
            "prompt": "Ben:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "30 km/h",
              "worked": "$$\\begin{aligned}\\text{Speed}&=\\frac{\\text{distance travelled}}{\\text{time taken}}\\\\&=\\frac{(90-30)\\text{ km}}{2\\text{ h}}\\\\&=30\\text{ km/h}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p51-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "Another cyclist starts at the same point and travels at 15 km/h for 2 hours.\nDescribe the line for this cyclist.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A straight descending line from $(0,90)$ to $(2,60)$, steeper than Jim's but less steep than Sam's.",
          "worked": "$$\\begin{aligned}\\text{Distance travelled}&=15\\times2\\\\&=30\\text{ km}\\\\\\text{Final distance from home}&=90-30\\\\&=60\\text{ km}\\end{aligned}$$\nThe line descends straight from $(0,90)$ to $(2,60)$. Since $10<15<20$, it is steeper than Jim's line but less steep than Sam's.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
