        "id": "p62-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate his annual income tax payable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$316.16",
          "worked": "The tax bracket is \\$18 201–\\$45 000.\n$$\\begin{align*}\\text{Excess} &= 19\\,864-18\\,200\\\\\\text{Excess} &= 1\\,664\\\\\\text{Tax payable} &= 0+0.19\\times1\\,664\\\\\\text{Tax payable} &= \\$316.16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p62-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Should he receive a tax refund or does he have a tax liability?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tax liability.",
          "worked": "$$\\begin{align*}\\text{Instalments}-\\text{tax payable} &= 220-316.16\\\\\\text{Instalments}-\\text{tax payable} &= -\\$96.16\\end{align*}$$\nHe has paid too little tax, so he has a tax liability.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
