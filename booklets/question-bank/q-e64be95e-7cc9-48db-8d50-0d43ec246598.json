        "answer": {
          "short": "$\\pm 0.05\\text{ cm}$",
          "worked": "$$\\begin{align*}\\text{Precision}&=0.1\\text{ cm}\\\\\\text{Absolute error}&=\\tfrac12\\times0.1=\\pm 0.05\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
