        "label": "b",
        "prompt": "$0.250\\text{ kg}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pm 0.0005\\text{ kg}$",
          "worked": "$$\\begin{align*}\\text{Precision}&=0.001\\text{ kg}\\\\\\text{Absolute error}&=\\tfrac12\\times0.001=\\pm 0.0005\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
