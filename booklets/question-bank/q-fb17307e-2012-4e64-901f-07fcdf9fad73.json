    "label": null,
    "prompt": "Solve for $n$.\n$${}^{11}C_n+{}^{11}C_{n+1}={}^{12}C_5$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=4$ or $6$.",
      "worked": "Using Pascal's identity,\n$${}^{12}C_{n+1}={}^{12}C_5.$$\n$$\\begin{align*}n+1&=5\\\\n&=4\\end{align*}$$\nBy symmetry,\n$$\\begin{align*}(n+1)+5&=12\\\\n&=6.\\end{align*}$$\nHence $n=4$ or $6$.",
      "solutionDiagrams": []
    },
