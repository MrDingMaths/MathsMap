  "content": {
    "id": "p35-q1",
    "type": "question",
    "label": "1",
    "prompt": "Consider $\\int 2x(1+x^2)^3\\,dx$, with $u=1+x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $du=2x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{du}{dx}=2x$, so $du=2x\\,dx$.",
          "worked": "$$\\begin{aligned}u&=1+x^2\\\\\\frac{du}{dx}&=2x\\\\du&=2x\\,dx\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Show the integral can be written as $\\int u^3\\,du$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\int 2x(1+x^2)^3\\,dx=\\int u^3\\,du$.",
          "worked": "Using $1+x^2=u$ and $2x\\,dx=du$,\n$$\\begin{aligned}\\int 2x(1+x^2)^3\\,dx&=\\int (1+x^2)^3(2x\\,dx)\\\\&=\\int u^3\\,du.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p35-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find the primitive of $2x(1+x^2)^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14(1+x^2)^4+C$.",
          "worked": "$$\\begin{aligned}\\int u^3\\,du&=\\frac{u^4}{4}+C\\\\&=\\frac14(1+x^2)^4+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Check by differentiating.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}\\left[\\dfrac14(1+x^2)^4+C\\right]=2x(1+x^2)^3$.",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}\\left[\\frac14(1+x^2)^4+C\\right]&=\\frac14\\cdot4(1+x^2)^3\\cdot2x\\\\&=2x(1+x^2)^3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
