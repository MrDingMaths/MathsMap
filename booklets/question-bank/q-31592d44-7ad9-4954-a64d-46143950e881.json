  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A polynomial is a function $P(x)=x^3-7x^2+x-1$.\nTherefore, we can evaluate polynomials using function notation. Evaluate the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-19$",
          "worked": "$$\\begin{align*}P(2)&=2^3-7(2)^2+2-1\\\\&=8-28+2-1\\\\&=-19\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10$",
          "worked": "$$\\begin{align*}P(-1)&=(-1)^3-7(-1)^2+(-1)-1\\\\&=-1-7-1-1\\\\&=-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p6-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}P(0)&=0^3-7(0)^2+0-1\\\\&=0-0+0-1\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
