  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Given that $p=-0.001$, $q=0.02$ and $r=-0.14$, evaluate:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$p+q-r$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.159$",
          "worked": "$$\\begin{align*}p+q-r&=(-0.001)+0.02-(-0.14)\\\\p+q-r&=0.019+0.14\\\\p+q-r&=0.159\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$p-q+r$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.161$",
          "worked": "$$\\begin{align*}p-q+r&=(-0.001)-0.02+(-0.14)\\\\p-q+r&=-0.021-0.14\\\\p-q+r&=-0.161\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{pr}{q}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.007$",
          "worked": "$$\\begin{align*}\\frac{pr}{q}&=\\frac{(-0.001)\\times(-0.14)}{0.02}\\\\\\frac{pr}{q}&=\\frac{0.00014}{0.02}\\\\\\frac{pr}{q}&=0.007\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{qr}{p}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.8$",
          "worked": "$$\\begin{align*}\\frac{qr}{p}&=\\frac{0.02\\times(-0.14)}{-0.001}\\\\\\frac{qr}{p}&=\\frac{-0.0028}{-0.001}\\\\\\frac{qr}{p}&=2.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{r}{pq}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7000$",
          "worked": "$$\\begin{align*}\\frac{r}{pq}&=\\frac{-0.14}{(-0.001)\\times0.02}\\\\\\frac{r}{pq}&=\\frac{-0.14}{-0.00002}\\\\\\frac{r}{pq}&=7000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{q}{p}+r$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-20.14$",
          "worked": "$$\\begin{align*}\\frac{q}{p}+r&=\\frac{0.02}{-0.001}+(-0.14)\\\\\\frac{q}{p}+r&=-20-0.14\\\\\\frac{q}{p}+r&=-20.14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
