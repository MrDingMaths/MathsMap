        "label": "a",
        "prompt": "Show that the point $\\left(cp,\\frac{c}{p}\\right)$ lies on the hyperbola $xy=c^2$, where $c$ is a constant and $p\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy=c^2$.",
          "worked": "$$\\begin{aligned}xy&=(cp)\\cdot\\left(\\frac{c}{p}\\right)\\\\xy&=cp\\cdot\\frac{c}{p}\\\\xy&=c^2\\end{aligned}$$\nTherefore the point lies on $xy=c^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
