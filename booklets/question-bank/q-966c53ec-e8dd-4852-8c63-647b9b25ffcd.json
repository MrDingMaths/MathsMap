  "content": {
    "id": "p6-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The graph $y=x^2$ undergoes each of the transformations indicated below. For each of these transformations, find the equation of the resulting parabola.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "A translation by 1 unit up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2+1$",
          "worked": "Add 1 to every $y$-value.\n$$y=x^2+1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "A translation by 2 units to the left.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+2)^2$",
          "worked": "Replace $x$ with $x+2$.\n$$y=(x+2)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "A translation by 3 units to the right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-3)^2$",
          "worked": "Replace $x$ with $x-3$.\n$$y=(x-3)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "A translation by 4 units down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2-4$",
          "worked": "Subtract 4 from every $y$-value.\n$$y=x^2-4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "A reflection in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^2$",
          "worked": "Negate every $y$-value.\n$$y=-x^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "A vertical dilation by a factor of 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x^2$",
          "worked": "Multiply every $y$-value by 2.\n$$y=2x^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "A vertical dilation by a factor of $\\frac{1}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{3}x^2$",
          "worked": "Multiply every $y$-value by $\\frac{1}{3}$.\n$$y=\\frac{1}{3}x^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
