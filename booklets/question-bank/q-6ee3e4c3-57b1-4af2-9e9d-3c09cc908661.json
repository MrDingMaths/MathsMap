    "type": "question",
    "label": "18",
    "prompt": "Consider the function $y=(1-x)e^x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$.",
          "worked": "Since $e^x>0$,\n$$\\begin{align*}(1-x)e^x&=0\\\\1-x&=0\\\\x&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p52-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $y'$ and $y''$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-xe^x$, $y''=-(x+1)e^x$.",
          "worked": "$$\\begin{align*}y'&=-e^x+(1-x)e^x\\\\y'&=-xe^x\\\\y''&=-e^x-xe^x\\\\y''&=-(x+1)e^x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that the curve has a maximum turning point at its $y$-intercept, and a point of inflection at $(-1,2e^{-1})$.",
