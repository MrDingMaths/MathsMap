  "content": {
    "id": "p18-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "A gym has 150 members. 90 use the weights, 110 use cardio equipment.\nIf all members use at least one type of equipment, how many use both?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "50 members.",
      "worked": "All members use at least one type of equipment, so the union contains 150 members. Let $x$ be the number who use both.\nUsing the addition rule:\n$$\\begin{align*}150&=90+110-x\\\\150&=200-x\\\\x&=50\\end{align*}$$\n50 members use both.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
