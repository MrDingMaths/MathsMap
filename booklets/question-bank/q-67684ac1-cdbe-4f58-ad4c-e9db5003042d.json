    "children": [
      {
        "id": "p7-ch15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$8xy+2y+12x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2y+3)(4x+1)$",
          "worked": "$$\\begin{align*}8xy+2y+12x+3&=(8xy+2y)+(12x+3)\\\\8xy+2y+12x+3&=2y(4x+1)+3(4x+1)\\\\8xy+2y+12x+3&=(2y+3)(4x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-ch15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$6ax+15x-4a-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-2)(2a+5)$",
          "worked": "$$\\begin{align*}6ax+15x-4a-10&=(6ax+15x)-(4a+10)\\\\6ax+15x-4a-10&=3x(2a+5)-2(2a+5)\\\\6ax+15x-4a-10&=(3x-2)(2a+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-ch15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$6ac+2bd-3bc-4ad$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3c-2d)(2a-b)$\n\nRearrange the terms to obtain a common binomial factor.",
          "worked": "$$\\begin{align*}6ac+2bd-3bc-4ad&=6ac-3bc-4ad+2bd\\\\6ac+2bd-3bc-4ad&=3c(2a-b)-2d(2a-b)\\\\6ac+2bd-3bc-4ad&=(3c-2d)(2a-b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p7-ch15-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$2m^2-mp+6mn-3np$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2m-p)(m+3n)$",
          "worked": "$$\\begin{align*}2m^2-mp+6mn-3np&=(2m^2-mp)+(6mn-3np)\\\\2m^2-mp+6mn-3np&=m(2m-p)+3n(2m-p)\\\\2m^2-mp+6mn-3np&=(2m-p)(m+3n)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
