  "content": {
    "id": "p24-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Mr Taylor usually travels from his home to work at an average speed of $30\\text{ km/h}$. However, today there was a traffic jam, so his average speed was $20\\text{ km/h}$ and it took him $20$ minutes longer than usual. Find the distance from his home to work.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20\\text{ km}$",
      "worked": "Let $d$ km be the distance from home to work. The usual time is $\\frac{d}{30}$ hours and today's time is $\\frac{d}{20}$ hours. The extra time is $20$ minutes $=\\frac13$ hour.\n$$\\begin{align*}\\frac{d}{20}-\\frac{d}{30}&=\\frac13\\\\3d-2d&=20\\\\d&=20\\end{align*}$$\nThe distance is $20\\text{ km}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
