    "children": [
      {
        "id": "p8-q9a",
        "type": "part",
        "label": "a",
        "prompt": "Given $\\sin\\theta+\\cos\\theta=\\frac12$, find $\\cos\\theta\\sin\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta\\sin\\theta=-\\frac38$.",
          "worked": "$$\\begin{align*}(\\sin\\theta+\\cos\\theta)^2&=\\sin^2\\theta+2\\sin\\theta\\cos\\theta+\\cos^2\\theta\\\\\\left(\\frac12\\right)^2&=1+2\\sin\\theta\\cos\\theta\\\\2\\sin\\theta\\cos\\theta&=\\frac14-1\\\\\\sin\\theta\\cos\\theta&=-\\frac38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q9b",
        "type": "part",
        "label": "b",
        "prompt": "Given $\\sin\\theta\\cos\\theta=-\\frac38$, find $\\cos\\theta+\\sin\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta+\\sin\\theta=\\pm\\frac12$.",
          "worked": "$$\\begin{align*}(\\cos\\theta+\\sin\\theta)^2&=\\cos^2\\theta+2\\sin\\theta\\cos\\theta+\\sin^2\\theta\\\\(\\cos\\theta+\\sin\\theta)^2&=1+2\\left(-\\frac38\\right)\\\\(\\cos\\theta+\\sin\\theta)^2&=\\frac14\\\\\\cos\\theta+\\sin\\theta&=\\pm\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
