    "type": "question",
    "label": null,
    "prompt": "For which values of $k$ will the line $y=k$ intersect $y=3-|2x+1|$ twice?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k<3$.",
      "worked": "The graph is a downward V with vertex $\\left(-\\frac{1}{2},3\\right)$ and maximum value $3$. A horizontal line below the vertex intersects both branches, so $k<3$.\n\nWhen $k=3$, there is one intersection at the vertex; when $k>3$, there are no intersections.",
      "solutionDiagrams": []
    },
