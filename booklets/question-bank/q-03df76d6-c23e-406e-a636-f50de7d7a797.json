      {
        "id": "p18-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A square has side length $3\\text{ cm}$. Find the length of the diagonal correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.24\\text{ cm}$",
          "worked": "The diagonal divides the square into two right-angled triangles. Let $d$ be the diagonal length in centimetres.\n$$\\begin{align*}d^2&=3^2+3^2\\\\d^2&=18\\\\d&=\\sqrt{18}\\\\d&\\approx4.24\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p18-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "The diagonal length of a square is $4\\text{ cm}$. Find the side length of the square correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.83\\text{ cm}$",
          "worked": "Let $s$ be the side length in centimetres. The diagonal is the hypotenuse of a right-angled triangle with two equal shorter sides.\n$$\\begin{align*}s^2+s^2&=4^2\\\\2s^2&=16\\\\s^2&=8\\\\s&=\\sqrt8\\\\s&\\approx2.83\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
