  "content": {
    "id": "p16-q1-root",
    "type": "question",
    "label": "8",
    "prompt": "Racing and chasing. In a cross-country race, Manus sees a friend 70 m ahead of him. He knows that his friend runs at a steady speed of 2.8 m/s in races of this length. Manus wishes to catch up with him, so he speeds up to 3.2 m/s.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "How long will it take Manus to catch up with his friend?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "175 s.",
          "worked": "The closing speed is $3.2-2.8=0.4\\text{ m/s}$. The time is $\\frac{70}{0.4}=175\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "If Manus is a kilometre from the finish when he sets out after his friend, how far from the finish line will he overtake him?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "440 m from the finish.",
          "worked": "In 175 s Manus travels $3.2(175)=560\\text{ m}$. His remaining distance is $1000-560=440\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
