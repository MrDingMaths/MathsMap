      {
        "id": "p55-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain, without any calculations, why she must be incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both taps together must fill the bathtub in less than 30 minutes. Add their rates of work rather than averaging their times.",
          "worked": "The cold-water tap alone fills the bathtub in 30 minutes. With the hot water tap also running, it must fill faster, so the time must be less than 30 minutes. Beatrix averaged the times instead of adding the rates.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p55-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find how long it would take to fill the bathtub.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 minutes",
          "worked": "$$\\begin{align*}\\text{Combined rate}&=\\frac{1\\text{ bathtub}}{30\\text{ minutes}}+\\frac{1\\text{ bathtub}}{60\\text{ minutes}}\\\\\\text{Combined rate}&=\\frac{3\\text{ bathtubs}}{60\\text{ minutes}}\\\\\\text{Combined rate}&=\\frac{1\\text{ bathtub}}{20\\text{ minutes}}\\end{align*}$$\nThe bathtub takes 20 minutes to fill.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
