        "label": "a",
        "prompt": "$\\log_6(4)+\\log_6(9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_6(4)+\\log_6(9)&=\\log_6(4\\times9)\\\\\\log_6(4)+\\log_6(9)&=\\log_6(6^2)\\\\\\log_6(4)+\\log_6(9)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p47-q13",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}(25)+\\log_{10}(40)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\log_{10}(25)+\\log_{10}(40)&=\\log_{10}(25\\times40)\\\\\\log_{10}(25)+\\log_{10}(40)&=\\log_{10}(10^3)\\\\\\log_{10}(25)+\\log_{10}(40)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p47-q14",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_8(24)-\\log_8(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_8(24)-\\log_8(3)&=\\log_8\\left(\\frac{24}{3}\\right)\\\\\\log_8(24)-\\log_8(3)&=\\log_8(8)\\\\\\log_8(24)-\\log_8(3)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p47-q15",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_9(30)-\\log_9(10)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\log_9(30)-\\log_9(10)&=\\log_9\\left(\\frac{30}{10}\\right)\\\\\\log_9(30)-\\log_9(10)&=\\log_9\\left(9^{\\frac12}\\right)\\\\\\log_9(30)-\\log_9(10)&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p47-q16",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{12}(18)+\\log_{12}(8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{12}(18)+\\log_{12}(8)&=\\log_{12}(18\\times8)\\\\\\log_{12}(18)+\\log_{12}(8)&=\\log_{12}(12^2)\\\\\\log_{12}(18)+\\log_{12}(8)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
