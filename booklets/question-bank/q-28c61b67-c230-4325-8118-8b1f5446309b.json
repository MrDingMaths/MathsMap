  "content": {
    "id": "p3-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the average rate of change of $y$ with respect to $x$, over the specified intervals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2x^2$, $[0,1]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$.",
          "worked": "$$\\begin{align*}\\text{Average rate}&=\\frac{2(1)^2-2(0)^2}{1-0}\\\\\\text{Average rate}&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^3$, $[-1,3]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$.",
          "worked": "$$\\begin{align*}\\text{Average rate}&=\\frac{3^3-(-1)^3}{3-(-1)}\\\\\\text{Average rate}&=\\frac{28}{4}\\\\\\text{Average rate}&=7.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{1}{x}$, $[-4,-2]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{8}$.",
          "worked": "$$\\begin{align*}\\text{Average rate}&=\\frac{-\\frac{1}{2}-(-\\frac{1}{4})}{-2-(-4)}\\\\\\text{Average rate}&=\\frac{-\\frac{1}{4}}{2}\\\\\\text{Average rate}&=-\\frac{1}{8}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p3-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{1}{x^2}$, $[2,3]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{5}{36}$.",
          "worked": "$$\\begin{align*}\\text{Average rate}&=\\frac{\\frac{1}{9}-\\frac{1}{4}}{3-2}\\\\\\text{Average rate}&=\\frac{4-9}{36}\\\\\\text{Average rate}&=-\\frac{5}{36}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p3-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\sqrt{x}$, $[0,4]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$.",
          "worked": "$$\\begin{align*}\\text{Average rate}&=\\frac{\\sqrt{4}-\\sqrt{0}}{4-0}\\\\\\text{Average rate}&=\\frac{2}{4}\\\\\\text{Average rate}&=\\frac{1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{1}{\\sqrt{x}}$, $[1,2]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1-\\sqrt{2}}{\\sqrt{2}}$.",
          "worked": "$$\\begin{align*}\\text{Average rate}&=\\frac{\\frac{1}{\\sqrt{2}}-1}{2-1}\\\\\\text{Average rate}&=\\frac{1-\\sqrt{2}}{\\sqrt{2}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
