  "content": {
    "id": "p24-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A couple have two children. What is the probability that both of the children are boys, given that at least one of the children is a boy? Assume that at birth, a child has an equal chance of being a boy or a girl.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{3}$",
      "worked": "Let $B$ denote a boy and $G$ a girl, with the older child's outcome listed first. The equally likely outcomes are $BB$, $BG$, $GB$ and $GG$. Given at least one boy, the remaining outcomes are $BB$, $BG$ and $GB$. Only $BB$ has two boys.\n$$\\begin{align*}\\Pr(\\text{both boys}\\mid\\text{at least one boy})&=\\frac{\\Pr(\\text{both boys})}{\\Pr(\\text{at least one boy})}\\\\\\Pr(\\text{both boys}\\mid\\text{at least one boy})&=\\frac{1/4}{3/4}\\\\\\Pr(\\text{both boys}\\mid\\text{at least one boy})&=\\frac{1}{3}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
