            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x",
                "display": false
              },
              {
                "type": "text",
                "text": " be the mean percentage mark of the two excluded students.",
                "marks": []
              }
            ]
          },
          {
