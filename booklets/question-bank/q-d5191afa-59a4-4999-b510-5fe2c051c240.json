              "type": "text",
              "text": "The mean mark for a class of 32 students in a Maths test is 68%.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "If the results of two students are excluded, the mean rises to 72%.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Find the mean mark of the two students whose results were excluded.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8\\%$; the excluded total is $32\\times68-30\\times72=16$, so their mean mark is $(16\\div2)\\%=8\\%$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p18-q12-answer-definition",
            "type": "paragraph",
