  "content": {
    "id": "v2-ifficulty-metadata-slot-42-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Name the inverse operations, in order, that isolate $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-ifficulty-metadata-slot-42-lower-slot-42-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(x+7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\div2$, then $-7$",
          "worked": "$$2(x+7)\\overset{\\color{#268cff}{\\div2}}{\\longrightarrow}x+7\\overset{\\color{#268cff}{-7}}{\\longrightarrow}x$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-ifficulty-metadata-slot-42-lower-slot-42-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x-3}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\times5$, then $+3$",
          "worked": "$$\\frac{x-3}{5}\\overset{\\color{#268cff}{\\times5}}{\\longrightarrow}x-3\\overset{\\color{#268cff}{+3}}{\\longrightarrow}x$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
