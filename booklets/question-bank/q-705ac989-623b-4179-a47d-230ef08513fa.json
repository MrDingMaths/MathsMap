  "content": {
    "id": "p14-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the length of the longest thin, inflexible stick that can be placed inside a cube of side length 3 metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\sqrt{3}\\text{ metres}$",
      "worked": "The longest stick lies along the space diagonal.\n\n$$\\begin{align*}d^2 &= 3^2+3^2+3^2\\\\d^2 &= 27\\\\d &= \\sqrt{27}\\\\d &= 3\\sqrt{3}\\text{ metres}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
