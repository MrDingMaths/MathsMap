  "content": {
    "id": "p38-q5-root",
    "type": "question",
    "label": "5",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p38-q5-scenario-1",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Caitlin lives in Wollongong and travels to Sydney daily.",
              "marks": []
            }
          ]
        },
        {
          "id": "p38-q5-scenario-2",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "The car trip requires her to travel at different speeds.",
              "marks": []
            }
          ]
        },
        {
          "id": "p38-q5-scenario-3",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "She travels 30 kilometres at 60 km/h and 40 kilometres at 100 km/h.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the total distance of the trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Total distance}&=30+40\\\\\\text{Total distance}&=70\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p38-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "How long (in hours) does the trip take?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9\\text{ h}$",
          "worked": "$$\\begin{align*}t&=\\frac{d}{s}\\\\\\text{Total time}&=\\frac{30}{60}+\\frac{40}{100}\\\\\\text{Total time}&=0.5+0.4\\\\\\text{Total time}&=0.9\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p38-q5-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p38-q5-c-question",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What is her average speed (in km/h) when travelling to Sydney?",
                  "marks": []
                }
              ]
            },
            {
              "id": "p38-q5-c-method-cue",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find average speed by dividing ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "total distance",
                  "marks": [
                    "italic"
                  ]
                },
                {
                  "type": "text",
                  "text": " by ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "total time",
                  "marks": [
                    "italic"
                  ]
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            },
            {
              "id": "p38-q5-c-rounding",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Answer correct to two decimal places.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$77.78\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{Average speed}&=\\frac{\\text{total distance}}{\\text{total time}}\\\\\\text{Average speed}&=\\frac{70}{0.9}\\\\\\text{Average speed}&=\\frac{700}{9}\\text{ km/h}\\\\\\text{Average speed}&\\approx77.78\\text{ km/h}\\end{align*}$$\nTo two decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
