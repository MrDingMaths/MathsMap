    "children": [
      {
        "id": "p58-q19-root",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+8x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4\\pm2\\sqrt5$",
          "worked": "$$\\begin{align*}(x+4)^2-20&=0\\\\(x+4)^2&=20\\\\x+4&=\\pm2\\sqrt5\\\\x&=-4\\pm2\\sqrt5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p58-q20-root",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+3x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-3\\pm\\sqrt5}{2}$",
          "worked": "Using $a=1$, $b=3$ and $c=1$ in the quadratic formula:\n$$\\begin{align*}x&=\\frac{-3\\pm\\sqrt{3^2-4(1)(1)}}{2(1)}\\\\x&=\\frac{-3\\pm\\sqrt5}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p58-q21-root",
        "type": "part",
        "label": "c",
        "prompt": "$4x^2+20x+25=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac52$",
          "worked": "$$\\begin{align*}(2x+5)^2&=0\\\\2x+5&=0\\\\x&=-\\frac52.\\end{align*}$$\nThis is a double root.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p58-q22-root",
        "type": "part",
        "label": "d",
        "prompt": "$3x^2+5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $x=-\\dfrac23$.",
          "worked": "$$\\begin{align*}3x(x+1)+2(x+1)&=0\\\\(3x+2)(x+1)&=0.\\end{align*}$$\nBy the null factor law, $3x+2=0$ or $x+1=0$.\n$$x=-\\frac23\\quad\\text{or}\\quad x=-1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
