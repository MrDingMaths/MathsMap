    "type": "question",
    "label": null,
    "prompt": "How many eight-letter words can be formed using the letters of the word COMMITTEE?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$45360$",
      "worked": "COMMITTEE has nine letters: C, O, M, M, I, T, T, E, E. Leave out one letter.\n\nLeave out C, O or I:\n$$\\frac{8!}{2!\\times2!\\times2!}=5040$$\nLeave out M:\n$$\\frac{8!}{2!\\times2!}=10080$$\nLeave out T:\n$$\\frac{8!}{2!\\times2!}=10080$$\nLeave out E:\n$$\\frac{8!}{2!\\times2!}=10080$$\nTotal:\n$$3\\times5040+3\\times10080=45360$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
