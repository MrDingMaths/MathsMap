      {
        "id": "p22-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=2x+1\\\\x+y&=4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=3$.",
          "worked": "Substitute $y=2x+1$ into $x+y=4$.\n$$\\begin{align*}x+(2x+1)&=4\\\\3x+1&=4\\\\3x&=3\\\\x&=1\\end{align*}$$\nSubstituting $x=1$ gives\n$$\\begin{align*}y&=2(1)+1\\\\y&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p22-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=3x-2\\\\3x+2y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=1$.",
          "worked": "Substitute $y=3x-2$ into $3x+2y=5$.\n$$\\begin{align*}3x+2(3x-2)&=5\\\\3x+6x-4&=5\\\\9x-4&=5\\\\9x&=9\\\\x&=1\\end{align*}$$\nSubstituting $x=1$ gives\n$$\\begin{align*}y&=3(1)-2\\\\y&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p22-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=2x-3\\\\x+2y&=9\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=3$.",
          "worked": "Substitute $y=2x-3$ into $x+2y=9$.\n$$\\begin{align*}x+2(2x-3)&=9\\\\x+4x-6&=9\\\\5x-6&=9\\\\5x&=15\\\\x&=3\\end{align*}$$\nSubstituting $x=3$ gives\n$$\\begin{align*}y&=2(3)-3\\\\y&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p22-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=7-2x\\\\x+y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=3$.",
          "worked": "Substitute $y=7-2x$ into $x+y=5$.\n$$\\begin{align*}x+(7-2x)&=5\\\\7-x&=5\\\\-x&=-2\\\\x&=2\\end{align*}$$\nSubstituting $x=2$ gives\n$$\\begin{align*}y&=7-2(2)\\\\y&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
