  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The voltage, $V$ volts, supplied by an electrical outlet is described by the sine function $V=k\\sin(at)+c$, where $k$, $a$ and $c$ are constants, $t$ is measured in seconds and $k>0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "If the voltage, $V$, oscillates between $-240$ volts and $240$ volts, find the value of $k$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=240$, $c=0$.",
          "worked": "$$\\begin{align*}k&=\\frac{240-(-240)}{2}\\\\k&=240\\\\c&=\\frac{240+(-240)}{2}\\\\c&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "If it has a frequency of $50$ Hz (meaning $50$ cycles per second), find the value of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=100\\pi$.",
          "worked": "The frequency is $50$ Hz, so the period is $\\frac{1}{50}$ s.\n$$\\begin{align*}a&=\\frac{2\\pi}{\\frac{1}{50}}\\\\a&=100\\pi\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine the voltage ($V$) function as a transformation of the sine function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V(t)=240\\sin(100\\pi t)$.",
          "worked": "Substituting $k=240$, $a=100\\pi$ and $c=0$ gives\n$$V(t)=240\\sin(100\\pi t).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
