                        "display": false
                      }
                    ]
                  },
                  {
                    "id": "p3-q3bviii-short-method",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "left",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Use the complement of both dice showing odd numbers.",
                        "marks": []
                      }
                    ]
                  }
                ]
              },
              "worked": "The product is odd only when both numbers are odd. The three odd rows and three odd columns give $3\\times3=9$ such cells. $$\\begin{align*}P(\\text{even product})&=1-\\frac{9}{36}\\\\P(\\text{even product})&=\\frac{3}{4}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          }
        ]
