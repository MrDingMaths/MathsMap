  "content": {
    "id": "p38-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The length of a rectangle is increased by $12\\%$ and the width is decreased by $10\\%$. What is the percentage change in the area?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.8\\%$ increase.\n\nThe area multiplier is $1.12\\times0.90=1.008$.",
      "worked": "Let the original length and width be $l$ and $w$. The original area is $A=lw$.\n\n$$\\begin{align*}A_{\\text{new}}&=(1.12l)(0.90w)\\\\A_{\\text{new}}&=1.008lw\\\\A_{\\text{new}}&=1.008A.\\end{align*}$$\n\nThe new area is $100.8\\%$ of the original area.\n\n$$\\begin{align*}\\text{Percentage increase}&=100.8\\%-100\\%\\\\\\text{Percentage increase}&=0.8\\%.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
