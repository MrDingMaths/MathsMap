      {
        "id": "p28-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Reggi works as a salesperson and is paid a commission of 4% of the value of her sales. Calculate Reggi’s commission for a week in which she sells \\$6800 worth of goods.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$272$",
          "worked": "$$\\begin{align*}\\text{Commission}&=\\text{Percentage}\\times\\text{Sales}\\\\\\text{Commission}&=0.04\\times6800\\\\\\text{Commission}&=\\$272\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p28-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Phillipa works as a salesperson and is paid a commission of 5% of the value of her sales. If Phillipa sells \\$16 000 worth of goods one week, what is her commission?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$800$",
          "worked": "$$\\begin{align*}\\text{Commission}&=\\text{Percentage}\\times\\text{Sales}\\\\\\text{Commission}&=0.05\\times16\\,000\\\\\\text{Commission}&=\\$800\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p28-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "An actress is paid a 2.5% royalty on ticket sales to her latest movie. How much does she earn if the box office was \\$2,403,556?",
