        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$60\\,088.90$",
          "worked": "$$\\begin{align*}\\text{Royalty}&=\\text{Percentage}\\times\\text{Sales}\\\\\\text{Royalty}&=0.025\\times2\\,403\\,556\\\\\\text{Royalty}&=\\$60\\,088.90\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p28-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "Mike works as a salesperson and is paid a commission of 1.55% of the value of his sales. If he sells \\$22 000 worth of goods one week, what is his commission?",
