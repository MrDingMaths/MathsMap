    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$49^x-6\\times7^x-7=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$\n\nSubstitute $u=7^x$ and keep the positive root.",
          "worked": "Let $u=7^x>0$. Then $49^x=u^2$.\n\n$$\\begin{align*}u^2-6u-7&=0\\\\(u-7)(u+1)&=0\\\\u&=7\\text{ or }-1\\end{align*}$$\n\nSince $u>0$, use $u=7$.\n\n$$\\begin{align*}7^x&=7^1\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$9^x-2\\times3^x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$\n\nSubstitute $u=3^x$ and keep the positive root.",
          "worked": "Let $u=3^x>0$. Then $9^x=u^2$.\n\n$$\\begin{align*}u^2-2u&=3\\\\u^2-2u-3&=0\\\\(u-3)(u+1)&=0\\\\u&=3\\text{ or }-1\\end{align*}$$\n\nSince $u>0$, use $u=3$.\n\n$$\\begin{align*}3^x&=3^1\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p11-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^x+2^{x+1}-8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$\n\nSubstitute $u=2^x$ and keep the positive root.",
          "worked": "Let $u=2^x>0$. Then $4^x=u^2$ and $2^{x+1}=2u$.\n\n$$\\begin{align*}u^2+2u-8&=0\\\\(u+4)(u-2)&=0\\\\u&=-4\\text{ or }2\\end{align*}$$\n\nSince $u>0$, use $u=2$.\n\n$$\\begin{align*}2^x&=2^1\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
