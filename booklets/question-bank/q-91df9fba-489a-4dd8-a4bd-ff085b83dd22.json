        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}f'(x)&=2x-1\\\\f'(-2)&=2(-2)-1\\\\f'(-2)&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
