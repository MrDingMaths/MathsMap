  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Let $a$ and $b$ be real constants with $a\\ne0$. Explain why:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$|ax+b|\\ge0$ is true for all real values of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An absolute value is always non-negative.",
          "worked": "For every real $x$, $ax+b$ is real and its absolute value is non-negative. Therefore $|ax+b|\\ge0$ for all real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$|ax+b|>0$ is true for all real values of $x$, except $x=-\\frac ba$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|ax+b|>0$ exactly when $ax+b\\ne0$, so $x\\ne-\\frac ba$.",
          "worked": "An absolute value is positive unless its argument is zero.\n$$\\begin{aligned}ax+b&=0\\\\ax&=-b\\\\x&=-\\frac ba\\end{aligned}$$\nThus $|ax+b|>0$ for every real $x$ except $x=-\\frac ba$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p17-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$|ax+b|<0$ has no solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An absolute value cannot be negative.",
          "worked": "$|ax+b|\\ge0$ for every real $x$, so $|ax+b|<0$ is impossible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p17-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$|ax+b|\\le0$ has only one solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It holds only when $ax+b=0$, giving the single solution $x=-\\frac ba$.",
          "worked": "Since an absolute value is non-negative, $|ax+b|\\le0$ requires $|ax+b|=0$.\n$$\\begin{aligned}ax+b&=0\\\\ax&=-b\\\\x&=-\\frac ba\\end{aligned}$$\nAs $a\\ne0$, this gives exactly one solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
