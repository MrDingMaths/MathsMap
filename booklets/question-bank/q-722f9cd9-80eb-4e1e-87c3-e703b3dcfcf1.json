  "content": {
    "id": "p23-q56-57-root",
    "type": "question",
    "label": "56",
    "prompt": "Given $A$, $B$ and $C$ are angles in a triangle, prove the following identities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q56-57-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin A=\\sin B\\cos C+\\cos B\\sin C$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin A=\\sin(B+C)=\\sin B\\cos C+\\cos B\\sin C$.\n\nUse $A=180^\\circ-(B+C)$ and the sine sum expansion.",
          "worked": "Since $A+B+C=180^\\circ$,\n$$\\begin{align*}\\sin A&=\\sin\\bigl(180^\\circ-(B+C)\\bigr)\\\\\\sin A&=\\sin(B+C)\\\\\\sin A&=\\sin B\\cos C+\\cos B\\sin C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-q56-57-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos A=\\sin B\\sin C-\\cos B\\cos C$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos A=-\\cos(B+C)=\\sin B\\sin C-\\cos B\\cos C$.\n\nUse $A=180^\\circ-(B+C)$ and the cosine sum expansion.",
          "worked": "Since $A+B+C=180^\\circ$,\n$$\\begin{align*}\\cos A&=\\cos\\bigl(180^\\circ-(B+C)\\bigr)\\\\\\cos A&=-\\cos(B+C)\\\\\\cos A&=-\\bigl(\\cos B\\cos C-\\sin B\\sin C\\bigr)\\\\\\cos A&=\\sin B\\sin C-\\cos B\\cos C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
