          "worked": "$$\\begin{align*}X'&=\\{B,C,E\\}\\\\Y'&=\\{A,B,F\\}\\\\X'\\cup Y'&=\\{A,B,C,E,F\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
