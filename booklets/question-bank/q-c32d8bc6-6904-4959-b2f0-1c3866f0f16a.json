        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}-(2x)&=-\\bigl(2\\times(-2)\\bigr)\\\\-(2x)&=-(-4)\\\\-(2x)&=4\\end{align*}$$",
