    "type": "question",
    "label": "7",
    "prompt": "If $a=\\log_8 225$ and $b=\\log_2 15$, find $a$ in terms of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=\\frac{2b}{3}$\n\nChange to base 2 and apply the power law.",
      "worked": "$$\\begin{align*}a&=\\frac{\\log_2 225}{\\log_2 8}\\\\a&=\\frac{\\log_2(15^2)}{\\log_2(2^3)}\\\\a&=\\frac{2\\log_2 15}{3}\\\\a&=\\frac{2b}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
