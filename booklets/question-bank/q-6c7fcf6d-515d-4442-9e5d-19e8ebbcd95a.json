    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\frac{3}{20}\\text{ m}$",
      "worked": "$$\\begin{align*}\\text{Total length}&=9\\times\\frac{7}{20}\\\\&=\\frac{63}{20}\\\\&=3\\frac{3}{20}\\text{ m}\\end{align*}$$",
