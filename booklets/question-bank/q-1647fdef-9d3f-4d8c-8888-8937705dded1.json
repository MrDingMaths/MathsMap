  "content": {
    "id": "v2-65d2d-p61-practice-slot-14-root",
    "type": "question",
    "label": null,
    "prompt": "Write the equation of each curve after the shift.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-65d2d-p61-practice-slot-14-slot-14-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^3$ shifted 5 units up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^3+5$",
          "worked": "Adding $c>0$ shifts the graph up by $c$ units, so $y=x^3+5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-65d2d-p61-practice-slot-14-slot-14-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^4$ shifted 3 units right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-3)^4$",
          "worked": "A shift right by $b$ units, $b>0$, gives $y=(x-b)^4$, so $y=(x-3)^4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-65d2d-p61-practice-slot-14-slot-14-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^3$ shifted 4 units left.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+4)^3$",
          "worked": "A shift left by 4 units means $b=-4$, so $y=(x-(-4))^3=(x+4)^3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
