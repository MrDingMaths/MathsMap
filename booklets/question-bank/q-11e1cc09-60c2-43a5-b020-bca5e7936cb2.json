  "content": {
    "id": "p9-q4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the value of $t$ if the gradient from:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(t,3)$ to $B(2,t)$ is $2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\dfrac73$",
          "worked": "$$\\begin{align*}\\frac{t-3}{2-t}&=2\\\\t-3&=4-2t\\\\3t&=7\\\\t&=\\frac73\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p9-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(t,2)$ to $B(-3,t)$ is $3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=-\\dfrac74$",
          "worked": "$$\\begin{align*}\\frac{t-2}{-3-t}&=3\\\\t-2&=-9-3t\\\\4t&=-7\\\\t&=-\\frac74\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p9-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(t,-4)$ to $B(3,t)$ is $-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=10$",
          "worked": "$$\\begin{align*}\\frac{t+4}{3-t}&=-2\\\\t+4&=-6+2t\\\\t&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
