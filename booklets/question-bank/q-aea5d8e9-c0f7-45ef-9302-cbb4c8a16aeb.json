        "prompt": "$\\log_2 5+\\log_2 4+\\log_2 7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 140$",
          "worked": "$$\\begin{align*}\\log_2 5+\\log_2 4+\\log_2 7&=\\log_2(5\\times4\\times7)\\\\\\log_2 5+\\log_2 4+\\log_2 7&=\\log_2 140\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-review-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_5 1000-\\log_5 100-\\log_5 10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\log_5 1000-\\log_5 100-\\log_5 10&=\\log_5\\left(\\frac{1000}{100\\times10}\\right)\\\\\\log_5 1000-\\log_5 100-\\log_5 10&=\\log_5 1\\\\\\log_5 1000-\\log_5 100-\\log_5 10&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p18-review-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_7 7+\\log_7 343-3\\log_7 49$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_7 7+\\log_7 343-3\\log_7 49&=1+3-3\\times2\\\\\\log_7 7+\\log_7 343-3\\log_7 49&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-review-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_3 25+2\\log_3 5-2\\log_3 75$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$\n\nUse the power and quotient laws to obtain $\\log_3(\\frac{1}{9})$.",
          "worked": "$$\\begin{align*}\\log_3 25+2\\log_3 5-2\\log_3 75&=\\log_3\\left(\\frac{25\\times5^2}{75^2}\\right)\\\\\\log_3 25+2\\log_3 5-2\\log_3 75&=\\log_3\\left(\\frac{625}{5625}\\right)\\\\\\log_3 25+2\\log_3 5-2\\log_3 75&=\\log_3(3^{-2})\\\\\\log_3 25+2\\log_3 5-2\\log_3 75&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
