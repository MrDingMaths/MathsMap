    "type": "question",
    "label": "1",
    "prompt": "It takes 3 diggers 4 hours to dig 5 holes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q1a",
        "type": "part",
        "label": "a",
        "prompt": "How many hours will it take 2 diggers to dig 12 holes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{72}{5}$ hours",
          "worked": "Fewer diggers increase the time; more holes also increase the time.\n$$\\begin{align*}\\text{Time}&=4\\times\\frac{3}{2}\\times\\frac{12}{5}\\\\\\text{Time}&=\\frac{72}{5}\\text{ hours}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p18-q1b",
        "type": "part",
        "label": "b",
        "prompt": "How many holes will 12 diggers dig in 20 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "100 holes",
          "worked": "More diggers and more time both increase the number of holes.\n$$\\begin{align*}\\text{Number of holes}&=5\\times\\frac{12}{3}\\times\\frac{20}{4}\\\\\\text{Number of holes}&=100.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q1c",
        "type": "part",
        "label": "c",
        "prompt": "How many hours will it take for 4 diggers to dig 15 holes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 hours",
          "worked": "More diggers decrease the time; more holes increase the time.\n$$\\begin{align*}\\text{Time}&=4\\times\\frac{3}{4}\\times\\frac{15}{5}\\\\\\text{Time}&=9\\text{ hours}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
