    "children": [
      {
        "id": "p20-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "To fill my tank with petrol costs $\\$55.00$ at $\\$1.10$ per litre. What is the price in dollars per litre if, after a price rise, it costs $\\$62.50$ to fill the tank with the same amount of petrol?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1.25$ per litre",
          "worked": "$$\\begin{align*}\\text{Volume of petrol}&=55\\div1.10\\\\&=50\\text{ L}\\\\\\text{New price per litre}&=62.50\\div50\\\\&=\\$1.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "A person purchases 50 litres at $\\$1.12$ per litre. Some time later the price has increased to $\\$1.40$ per litre. How many litres can now be purchased for the same amount of money?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "40 litres",
          "worked": "$$\\begin{align*}\\text{Amount spent}&=50\\times1.12\\\\&=\\$56\\\\\\text{New volume}&=56\\div1.40\\\\&=40\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Let $\\$C$ be the cost of buying $V$ litres of petrol at $R$ dollars per litre. Find the formula relating $C$, $V$ and $R$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=VR$",
          "worked": "Cost equals volume multiplied by price per litre, so $C=VR$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
