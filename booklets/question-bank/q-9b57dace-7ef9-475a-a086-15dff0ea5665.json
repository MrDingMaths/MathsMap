  "content": {
    "id": "p17-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Express each natural number in each pair as a product of prime numbers. Hence, find the greatest common divisor and the least common multiple of each pair.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$6$ and $8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6=2\\times3$, $8=2^3$; $\\mathrm{GCD}=2$, $\\mathrm{LCM}=24$.",
          "worked": "$$\\begin{align*}6&=2\\times3\\\\8&=2^3\\\\\\mathrm{GCD}(6,8)&=2\\\\\\mathrm{LCM}(6,8)&=2^3\\times3\\\\\\mathrm{LCM}(6,8)&=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p17-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$5$ and $13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$ and $13$ are prime; $\\mathrm{GCD}=1$, $\\mathrm{LCM}=65$.",
          "worked": "$5$ and $13$ are distinct primes.\n$$\\begin{align*}\\mathrm{GCD}(5,13)&=1\\\\\\mathrm{LCM}(5,13)&=5\\times13\\\\\\mathrm{LCM}(5,13)&=65\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$16$ and $6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16=2^4$, $6=2\\times3$; $\\mathrm{GCD}=2$, $\\mathrm{LCM}=48$.",
          "worked": "$$\\begin{align*}16&=2^4\\\\6&=2\\times3\\\\\\mathrm{GCD}(16,6)&=2\\\\\\mathrm{LCM}(16,6)&=2^4\\times3\\\\\\mathrm{LCM}(16,6)&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p17-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$12$ and $18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12=2^2\\times3$, $18=2\\times3^2$; $\\mathrm{GCD}=6$, $\\mathrm{LCM}=36$.",
          "worked": "$$\\begin{align*}12&=2^2\\times3\\\\18&=2\\times3^2\\\\\\mathrm{GCD}(12,18)&=2\\times3\\\\\\mathrm{GCD}(12,18)&=6\\\\\\mathrm{LCM}(12,18)&=2^2\\times3^2\\\\\\mathrm{LCM}(12,18)&=36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p17-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$36$ and $120$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36=2^2\\times3^2$, $120=2^3\\times3\\times5$; $\\mathrm{GCD}=12$, $\\mathrm{LCM}=360$.",
          "worked": "$$\\begin{align*}36&=2^2\\times3^2\\\\120&=2^3\\times3\\times5\\\\\\mathrm{GCD}(36,120)&=2^2\\times3\\\\\\mathrm{GCD}(36,120)&=12\\\\\\mathrm{LCM}(36,120)&=2^3\\times3^2\\times5\\\\\\mathrm{LCM}(36,120)&=360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p17-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$70$ and $144$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70=2\\times5\\times7$, $144=2^4\\times3^2$; $\\mathrm{GCD}=2$, $\\mathrm{LCM}=5040$.",
          "worked": "$$\\begin{align*}70&=2\\times5\\times7\\\\144&=2^4\\times3^2\\\\\\mathrm{GCD}(70,144)&=2\\\\\\mathrm{LCM}(70,144)&=2^4\\times3^2\\times5\\times7\\\\\\mathrm{LCM}(70,144)&=5040\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p17-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$342$ and $99$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$342=2\\times3^2\\times19$, $99=3^2\\times11$; $\\mathrm{GCD}=9$, $\\mathrm{LCM}=3762$.",
          "worked": "$$\\begin{align*}342&=2\\times3^2\\times19\\\\99&=3^2\\times11\\\\\\mathrm{GCD}(342,99)&=3^2\\\\\\mathrm{GCD}(342,99)&=9\\\\\\mathrm{LCM}(342,99)&=2\\times3^2\\times11\\times19\\\\\\mathrm{LCM}(342,99)&=3762\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p17-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$1200$ and $660$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1200=2^4\\times3\\times5^2$, $660=2^2\\times3\\times5\\times11$; $\\mathrm{GCD}=60$, $\\mathrm{LCM}=13\\,200$.",
          "worked": "$$\\begin{align*}1200&=2^4\\times3\\times5^2\\\\660&=2^2\\times3\\times5\\times11\\\\\\mathrm{GCD}(1200,660)&=2^2\\times3\\times5\\\\\\mathrm{GCD}(1200,660)&=60\\\\\\mathrm{LCM}(1200,660)&=2^4\\times3\\times5^2\\times11\\\\\\mathrm{LCM}(1200,660)&=13\\,200\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
