      {
        "id": "p12-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the scale factor for the area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "The area scale factor is the square of the length scale factor.\n$$k^2=3^2=9.$$",
          "solutionDiagrams": []
