        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "The corresponding side lengths are 6 and 2 grid units.\n$$k=\\frac{6}{2}=3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
