    "type": "question",
    "label": "1",
    "prompt": "Given $f(x)=2x^3-3x+4$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $f'(1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}f'(x)&=6x^2-3\\\\f'(1)&=6(1)^2-3\\\\f'(1)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "What does $f'(1)$ represent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The gradient of the tangent to the curve at $x=1$ is $3$.",
          "worked": "$f'(1)$ is the gradient of the tangent to $y=f(x)$ at $x=1$. From part a, this gradient is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
