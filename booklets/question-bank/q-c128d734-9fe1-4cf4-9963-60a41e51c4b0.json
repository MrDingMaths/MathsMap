  "content": {
    "id": "p4-q7",
    "type": "question",
    "label": "7",
    "prompt": "Consider the piece-wise defined function\n$$f(x)=\\begin{cases}x^2,&x\\le 1,\\\\2-x,&x>1.\\end{cases}$$\nFind the following.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Since $-2\\le1$, use $f(x)=x^2$.\n$$\\begin{align*}f(-2)&=(-2)^2\\\\f(-2)&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $1\\le1$, use $f(x)=x^2$.\n$$\\begin{align*}f(1)&=1^2\\\\f(1)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "Since $3>1$, use $f(x)=2-x$.\n$$\\begin{align*}f(3)&=2-3\\\\f(3)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p4-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "Since $-3\\le1$, use $f(x)=x^2$.\n$$\\begin{align*}f(-3)&=(-3)^2\\\\f(-3)&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
