  "content": {
    "id": "p13-q13-root",
    "type": "question",
    "label": null,
    "prompt": "A square has side length $2\\sqrt{3}$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "the area of the square",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$ square units",
          "worked": "$$\\begin{align*}A&=(2\\sqrt{3})^2\\\\A&=4\\times3\\\\A&=12\\end{align*}$$\nThe area is $12$ square units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "the length of the diagonal",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{6}$",
          "worked": "Let $d$ be the diagonal length.\n$$\\begin{align*}d^2&=(2\\sqrt{3})^2+(2\\sqrt{3})^2\\\\d^2&=12+12\\\\d^2&=24\\\\d&=\\sqrt{4\\times6}\\\\d&=2\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
