      {
        "id": "p7-q5a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y=e^{-x}$ and $y=e^{3x}$ are each solutions of $y''-2y'-3y=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both functions give $y''-2y'-3y=0$.",
          "worked": "For $y=e^{-x}$:\n$$\\begin{aligned}y'&=-e^{-x},\\\\y''&=e^{-x}.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{LHS}&=e^{-x}-2(-e^{-x})-3e^{-x}\\\\&=e^{-x}+2e^{-x}-3e^{-x}\\\\&=0=\\mathrm{RHS}.\\end{aligned}$$\nFor $y=e^{3x}$:\n$$\\begin{aligned}y'&=3e^{3x},\\\\y''&=9e^{3x}.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{LHS}&=9e^{3x}-2(3e^{3x})-3e^{3x}\\\\&=9e^{3x}-6e^{3x}-3e^{3x}\\\\&=0=\\mathrm{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p7-q5b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $y=Ae^{-x}+Be^{3x}$ is also a solution for any constants $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y''-2y'-3y=0$ for all constants $A$ and $B$.",
          "worked": "$$\\begin{aligned}y'&=-Ae^{-x}+3Be^{3x},\\\\y''&=Ae^{-x}+9Be^{3x}.\\end{aligned}$$\n$$\\begin{aligned}\\mathrm{LHS}&=y''-2y'-3y\\\\&=(Ae^{-x}+9Be^{3x})-2(-Ae^{-x}+3Be^{3x})-3(Ae^{-x}+Be^{3x})\\\\&=A(1+2-3)e^{-x}+B(9-6-3)e^{3x}\\\\&=0=\\mathrm{RHS}.\\end{aligned}$$\nThus it is a solution for any constants $A$ and $B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
