        "children": [
          {
            "id": "p41-q2-a",
            "type": "part",
            "label": "a",
            "prompt": "Pearson’s correlation coefficient $r$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=-0.26$",
              "worked": "Enter age as $x$ and time as $y$ in two-variable statistics mode. Select linear regression and read Pearson's correlation coefficient.\n$$\\begin{align*}r&=-0.2551259466\\\\r&\\approx-0.26\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p41-q2-b",
            "type": "part",
            "label": "b",
            "prompt": "The equation of the line of best fit $y=a+bx$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=30.35-0.23x$, where $x$ is age in years and $y$ is time in seconds.",
              "worked": "Using linear regression with age as $x$ and time as $y$:\n$$\\begin{align*}a&=30.3479452055\\\\b&=-0.2301369863\\\\y&\\approx30.35-0.23x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      },
      {
        "id": "p41-q2-strength",
        "type": "part",
        "label": "c",
        "prompt": "Identify the strength and direction of the association.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Weak negative association.",
          "worked": "$r\\approx-0.26$ is negative and lies in the weak negative range on the supplied correlation scale.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p41-q2-interpretation",
        "type": "part",
        "label": "d",
        "prompt": "Interpret the gradient and $y$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each additional year of age is associated with an estimated decrease of 0.23 s in swimming time. The intercept gives a formal model time of 30.35 s at age 0; it is outside the observed ages and is not a realistic prediction.",
          "worked": "The gradient is approximately $-0.23$ seconds per year, so the estimated time to swim 25 m tends to decrease by 0.23 s for each additional year of age.\n\nAt $x=0$, the model gives $y=30.35$ s. This is the formal intercept, but age 0 is outside the observed range of 11–26 years, so it has no realistic predictive interpretation here.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
