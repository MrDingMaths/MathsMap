  "content": {
    "id": "p13-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "[$t$ formula]",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove algebraically that $(1-t^2)^2+(2t)^2=(1+t^2)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-t^2)^2+(2t)^2=1+2t^2+t^4=(1+t^2)^2$.",
          "worked": "$$\\begin{align*}(1-t^2)^2+(2t)^2&=1-2t^2+t^4+4t^2\\\\&=1+2t^2+t^4\\\\&=(1+t^2)^2.\\end{align*}$$\nThe final expression follows by recognising a perfect square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\cos x=\\dfrac{1-t^2}{1+t^2}$, where $x$ is acute and $t$ is positive, find expressions for $\\sin x$ and $\\tan x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin x=\\dfrac{2t}{1+t^2},\\quad \\tan x=\\dfrac{2t}{1-t^2}$.",
          "worked": "Take adjacent side $1-t^2$ and hypotenuse $1+t^2$. These are positive because $x$ is acute.\nUsing part a and $t>0$,\n$$\\begin{align*}\\mathrm{Opp}&=\\sqrt{(1+t^2)^2-(1-t^2)^2}\\\\&=\\sqrt{4t^2}\\\\&=2t.\\end{align*}$$\nHence\n$$\\begin{align*}\\sin x&=\\frac{\\mathrm{Opp}}{\\mathrm{Hyp}}=\\frac{2t}{1+t^2},\\\\\\tan x&=\\frac{\\mathrm{Opp}}{\\mathrm{Adj}}=\\frac{2t}{1-t^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
