  "content": {
    "id": "p16-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A biologist discovers that the number of organisms present in a Petri dish increases by 8% each minute. If there are initially 5000 organisms present in the dish, find the number of organisms in the dish:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "after 1 minute",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5400 organisms",
          "worked": "The multiplier for an 8% increase is $1.08$.\n$$N=5000\\times1.08=5400.$$\nThere are 5400 organisms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "after 2 minutes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5832 organisms",
          "worked": "$$\\begin{align*}N&=5000\\times1.08^2\\\\N&=5832.\\end{align*}$$\nThere are 5832 organisms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "after $x$ minutes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5000\\times1.08^x$ organisms",
          "worked": "The initial number is multiplied by $1.08$ for each minute, so after $x$ minutes:\n$$N=5000\\times1.08^x.$$\nThere are $5000\\times1.08^x$ organisms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "after 20 minutes, to the nearest whole organism",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "23 305 organisms",
          "worked": "$$\\begin{align*}N&=5000\\times1.08^{20}\\\\N&\\approx23304.7857.\\end{align*}$$\nTo the nearest whole organism, there are 23 305 organisms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
