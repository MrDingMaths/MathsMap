        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{9}$",
          "worked": "Let $x=0.444\\ldots$.\n$$\\begin{align*}10x&=4.444\\ldots\\\\10x-x&=4.444\\ldots-0.444\\ldots\\\\9x&=4\\\\x&=\\frac{4}{9}\\end{align*}$$",
