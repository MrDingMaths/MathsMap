  "content": {
    "id": "p14-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A line with gradient $\\frac{2}{3}$ passes through the midpoint of $(5,6)$ and $(1,10)$.\n\nFind the equation of the line.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Midpoint: $(3,8)$; $y=\\frac{2x}{3}+6$.",
      "worked": "$$\\begin{aligned}M&=\\left(\\frac{5+1}{2},\\frac{6+10}{2}\\right)\\\\M&=(3,8)\\end{aligned}$$\nUsing $m=\\frac{2}{3}$ and $(3,8)$:\n$$\\begin{aligned}y-8&=\\frac{2}{3}(x-3)\\\\y-8&=\\frac{2x}{3}-2\\\\y&=\\frac{2x}{3}+6\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
