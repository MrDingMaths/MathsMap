    "type": "question",
    "label": "9",
    "prompt": "A particular strain of bacteria increases its population on a certain prepared Petri dish by 18% every hour. Calculate the size of the original population four hours ago if there are now the following numbers of bacteria. Give answers to the nearest whole bacterium.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$10\\,000$ bacteria",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
