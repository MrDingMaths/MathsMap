    "children": [
      {
        "id": "p18-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{(x-2)(x+1)}+\\frac{2}{(x-2)(x-3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x-1}{(x-3)(x+1)(x-2)}$",
          "worked": "$$\\begin{align*}\\frac{1}{(x-2)(x+1)}+\\frac{2}{(x-2)(x-3)}&=\\frac{(x-3)+2(x+1)}{(x-2)(x+1)(x-3)}\\\\\\frac{1}{(x-2)(x+1)}+\\frac{2}{(x-2)(x-3)}&=\\frac{x-3+2x+2}{(x-2)(x+1)(x-3)}\\\\\\frac{1}{(x-2)(x+1)}+\\frac{2}{(x-2)(x-3)}&=\\frac{3x-1}{(x-2)(x+1)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p18-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3}{(x+3)(x+1)}+\\frac{6}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3(2x+3)}{(x+3)(x+1)}$",
          "worked": "$$\\begin{align*}\\frac{3}{(x+3)(x+1)}+\\frac{6}{x+3}&=\\frac{3+6(x+1)}{(x+3)(x+1)}\\\\\\frac{3}{(x+3)(x+1)}+\\frac{6}{x+3}&=\\frac{6x+9}{(x+3)(x+1)}\\\\\\frac{3}{(x+3)(x+1)}+\\frac{6}{x+3}&=\\frac{3(2x+3)}{(x+3)(x+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2}{x^2+x-2}+\\frac{5}{x^2-3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x+6}{(x+2)(x-1)(x-2)}$",
          "worked": "$x^2+x-2=(x+2)(x-1)$ and $x^2-3x+2=(x-1)(x-2)$.\n$$\\begin{align*}\\frac{2}{x^2+x-2}+\\frac{5}{x^2-3x+2}&=\\frac{2}{(x+2)(x-1)}+\\frac{5}{(x-1)(x-2)}\\\\\\frac{2}{x^2+x-2}+\\frac{5}{x^2-3x+2}&=\\frac{2(x-2)+5(x+2)}{(x+2)(x-1)(x-2)}\\\\\\frac{2}{x^2+x-2}+\\frac{5}{x^2-3x+2}&=\\frac{2x-4+5x+10}{(x+2)(x-1)(x-2)}\\\\\\frac{2}{x^2+x-2}+\\frac{5}{x^2-3x+2}&=\\frac{7x+6}{(x+2)(x-1)(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p18-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{x^2-4}+\\frac{6}{x^2-2x-8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3(3x-8)}{(x-4)(x+2)(x-2)}$",
          "worked": "$x^2-4=(x-2)(x+2)$ and $x^2-2x-8=(x-4)(x+2)$.\n$$\\begin{align*}\\frac{3}{x^2-4}+\\frac{6}{x^2-2x-8}&=\\frac{3}{(x-2)(x+2)}+\\frac{6}{(x-4)(x+2)}\\\\\\frac{3}{x^2-4}+\\frac{6}{x^2-2x-8}&=\\frac{3(x-4)+6(x-2)}{(x-4)(x+2)(x-2)}\\\\\\frac{3}{x^2-4}+\\frac{6}{x^2-2x-8}&=\\frac{9x-24}{(x-4)(x+2)(x-2)}\\\\\\frac{3}{x^2-4}+\\frac{6}{x^2-2x-8}&=\\frac{3(3x-8)}{(x-4)(x+2)(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p18-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{2}{(x+7)(x-3)}+\\frac{3}{(x+4)(3-x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-x-13}{(x-3)(x+4)(x+7)}$\n\nUse $3-x=-(x-3)$ before forming the common denominator.",
          "worked": "Since $3-x=-(x-3)$,\n$$\\begin{align*}\\frac{2}{(x+7)(x-3)}+\\frac{3}{(x+4)(3-x)}&=\\frac{2}{(x+7)(x-3)}-\\frac{3}{(x+4)(x-3)}\\\\\\frac{2}{(x+7)(x-3)}+\\frac{3}{(x+4)(3-x)}&=\\frac{2(x+4)-3(x+7)}{(x-3)(x+4)(x+7)}\\\\\\frac{2}{(x+7)(x-3)}+\\frac{3}{(x+4)(3-x)}&=\\frac{2x+8-3x-21}{(x-3)(x+4)(x+7)}\\\\\\frac{2}{(x+7)(x-3)}+\\frac{3}{(x+4)(3-x)}&=\\frac{-x-13}{(x-3)(x+4)(x+7)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p18-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{6}{x(x+3)}+\\frac{2}{(x+3)(x-4)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8(x-3)}{x(x+3)(x-4)}$",
          "worked": "$$\\begin{align*}\\frac{6}{x(x+3)}+\\frac{2}{(x+3)(x-4)}&=\\frac{6(x-4)+2x}{x(x+3)(x-4)}\\\\\\frac{6}{x(x+3)}+\\frac{2}{(x+3)(x-4)}&=\\frac{8x-24}{x(x+3)(x-4)}\\\\\\frac{6}{x(x+3)}+\\frac{2}{(x+3)(x-4)}&=\\frac{8(x-3)}{x(x+3)(x-4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
