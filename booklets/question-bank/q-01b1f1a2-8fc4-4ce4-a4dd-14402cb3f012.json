  "content": {
    "id": "p47-q3",
    "type": "question",
    "label": "3",
    "prompt": "The weekly wage, $w$ dollars, of a vacuum cleaner salesperson consists of a fixed sum of $\\$350$ plus $\\$20$ for each cleaner sold. If $n$ cleaners are sold per week,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation that describes the weekly wage of the salesperson.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w = 20n + 350$",
          "worked": "The rate is $20$ dollars per cleaner and the fixed wage is $350$ dollars. Using $y=mx+c$ gives\n$$w=20n+350.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p47-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "How much would the salesperson make if he sold 23 vacuums that week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$810$",
          "worked": "$$\\begin{align*}w&=20(23)+350\\\\w&=810\\end{align*}$$\nThe weekly wage is $\\$810$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p47-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "How many cleaners would he have to sell to make at least $\\$1215$ in a week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "At least 44 cleaners.",
          "worked": "$$\\begin{align*}20n+350&\\geq1215\\\\20n&\\geq865\\\\n&\\geq43.25\\end{align*}$$\nHe must sell a whole number of cleaners, so he needs at least 44 cleaners. Selling 43 earns $\\$1210$, while selling 44 earns $\\$1230$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
