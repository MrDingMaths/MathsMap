  "content": {
    "id": "p45-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Given $\\dfrac{p}{q}=\\dfrac{2}{3}$, prove that:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{p-q}{q}=-\\frac{1}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{p-q}{q}=\\dfrac{p}{q}-1=\\dfrac{2}{3}-1=-\\dfrac{1}{3}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{p-q}{q}\\\\&=\\frac{p}{q}-1\\\\&=\\frac{2}{3}-1\\\\&=-\\frac{1}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p45-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{p-q}{p+q}=-\\frac{1}{5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{p-q}{p+q}=\\dfrac{\\frac{2}{3}-1}{\\frac{2}{3}+1}=-\\dfrac{1}{5}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{p-q}{p+q}\\\\&=\\frac{\\frac{p}{q}-1}{\\frac{p}{q}+1}\\\\&=\\frac{\\frac{2}{3}-1}{\\frac{2}{3}+1}\\\\&=-\\frac{1}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p45-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{p^2+q^2}{p^2-q^2}=-\\frac{13}{5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{p^2+q^2}{p^2-q^2}=\\dfrac{\\frac{4}{9}+1}{\\frac{4}{9}-1}=-\\dfrac{13}{5}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{p^2+q^2}{p^2-q^2}\\\\&=\\frac{\\frac{p^2}{q^2}+1}{\\frac{p^2}{q^2}-1}\\\\&=\\frac{\\frac{4}{9}+1}{\\frac{4}{9}-1}\\\\&=-\\frac{13}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
