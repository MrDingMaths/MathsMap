  "content": {
    "id": "p31-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_1^5\\frac1x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln 5$",
          "worked": "$$\\begin{align*}\\int_1^5\\frac1x\\,dx&=[\\ln|x|]_1^5\\\\\\int_1^5\\frac1x\\,dx&=\\ln5-\\ln1\\\\\\int_1^5\\frac1x\\,dx&=\\ln5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p31-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^3\\frac1x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln 3$",
          "worked": "$$\\begin{align*}\\int_1^3\\frac1x\\,dx&=[\\ln|x|]_1^3\\\\\\int_1^3\\frac1x\\,dx&=\\ln3-\\ln1\\\\\\int_1^3\\frac1x\\,dx&=\\ln3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p31-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{-8}^{-2}\\frac1x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\ln 2$",
          "worked": "$$\\begin{align*}\\int_{-8}^{-2}\\frac1x\\,dx&=[\\ln|x|]_{-8}^{-2}\\\\\\int_{-8}^{-2}\\frac1x\\,dx&=\\ln2-\\ln8\\\\\\int_{-8}^{-2}\\frac1x\\,dx&=\\ln2-3\\ln2\\\\\\int_{-8}^{-2}\\frac1x\\,dx&=-2\\ln2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p31-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{-3}^{9}\\frac1x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Undefined.",
          "worked": "The interval $[-3,9]$ contains $x=0$, where $\\frac{1}{x}$ is undefined. The improper integrals on either side of $0$ do not converge, so the definite integral is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p31-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_1^4\\frac{dx}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln 2$",
          "worked": "$$\\begin{align*}\\int_1^4\\frac{dx}{2x}&=\\left[\\frac12\\ln|x|\\right]_1^4\\\\\\int_1^4\\frac{dx}{2x}&=\\frac12(\\ln4-\\ln1)\\\\\\int_1^4\\frac{dx}{2x}&=\\frac12(2\\ln2)\\\\\\int_1^4\\frac{dx}{2x}&=\\ln2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p31-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_{-15}^{-5}\\frac{dx}{5x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac15\\ln 3$",
          "worked": "$$\\begin{align*}\\int_{-15}^{-5}\\frac{dx}{5x}&=\\left[\\frac15\\ln|x|\\right]_{-15}^{-5}\\\\\\int_{-15}^{-5}\\frac{dx}{5x}&=\\frac15(\\ln5-\\ln15)\\\\\\int_{-15}^{-5}\\frac{dx}{5x}&=\\frac15\\ln\\frac13\\\\\\int_{-15}^{-5}\\frac{dx}{5x}&=-\\frac15\\ln3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
