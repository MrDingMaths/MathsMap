        "children": [],
        "answer": {
          "short": "$5.64$",
          "worked": "$$\\begin{align*}\\log_2 50&=\\log_2 2+2\\log_2 5\\\\\\log_2 50&\\approx1+2(2.32)\\\\\\log_2 50&\\approx5.64\\end{align*}$$",
