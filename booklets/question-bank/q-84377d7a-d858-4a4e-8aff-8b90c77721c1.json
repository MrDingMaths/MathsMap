    "type": "question",
    "label": "5",
    "prompt": "Do not use a calculator.\n\nGiven that $\\log_2 3\\approx1.58$ and $\\log_2 5\\approx2.32$, use the log laws to find approximations for:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
