        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.90$",
          "worked": "$$\\begin{align*}\\log_2 15&=\\log_2 3+\\log_2 5\\\\\\log_2 15&\\approx1.58+2.32\\\\\\log_2 15&\\approx3.90\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.16$",
          "worked": "$$\\begin{align*}\\log_2 9&=2\\log_2 3\\\\\\log_2 9&\\approx2(1.58)\\\\\\log_2 9&\\approx3.16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
