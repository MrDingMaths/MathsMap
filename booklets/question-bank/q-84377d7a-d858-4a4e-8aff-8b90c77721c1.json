        "children": [],
        "answer": {
          "short": "$3.32$",
          "worked": "$$\\begin{align*}\\log_2 10&=\\log_2 2+\\log_2 5\\\\\\log_2 10&\\approx1+2.32\\\\\\log_2 10&\\approx3.32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q5-d",
