  "content": {
    "id": "p44-q12-response",
    "type": "question",
    "label": "12",
    "prompt": "The interquartile range of a set of data is 10. If there are no outliers in this dataset, what is the largest possible range?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$40$",
      "worked": "Since $1.5\\times\\mathrm{IQR}=15$, all values lie within $[Q_1-15,\\ Q_3+15]$. The largest possible range is the difference between these fences.\n$$\\begin{align*}\\text{Maximum range} &= (Q_3+15)-(Q_1-15)\\\\\\text{Maximum range} &= \\mathrm{IQR}+30\\\\\\text{Maximum range} &= 10+30=40\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
