    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{4m^2n^5p^{-6}}{16m^{-2}n^5p^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{m^4}{4p^9}$",
          "worked": "$$\\begin{aligned}\\frac{4m^2n^5p^{-6}}{16m^{-2}n^5p^3}&=\\frac14m^{2-(-2)}n^{5-5}p^{-6-3}\\\\\\frac{4m^2n^5p^{-6}}{16m^{-2}n^5p^3}&=\\frac{m^4}{4p^9}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$(4y)^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{64y^3}$",
          "worked": "$$\\begin{aligned}(4y)^{-3}&=\\frac{1}{4^3y^3}\\\\(4y)^{-3}&=\\frac{1}{64y^3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2^2y^3)^{-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2^{10}y^{15}}$",
          "worked": "$$\\begin{aligned}(2^2y^3)^{-5}&=2^{-10}y^{-15}\\\\(2^2y^3)^{-5}&=\\frac{1}{2^{10}y^{15}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$(5^{-2}x^3)^{-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5^{10}}{x^{15}}$",
          "worked": "$$\\begin{aligned}(5^{-2}x^3)^{-5}&=5^{10}x^{-15}\\\\(5^{-2}x^3)^{-5}&=\\frac{5^{10}}{x^{15}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$(3^{-3}a^2b^{-1})^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3^{12}b^4}{a^8}$",
          "worked": "$$\\begin{aligned}(3^{-3}a^2b^{-1})^{-4}&=3^{12}a^{-8}b^4\\\\(3^{-3}a^2b^{-1})^{-4}&=\\frac{3^{12}b^4}{a^8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p26-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\dfrac{a^3}{b^2}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b^4}{a^6}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{a^3}{b^2}\\right)^{-2}&=\\left(\\frac{b^2}{a^3}\\right)^2\\\\\\left(\\frac{a^3}{b^2}\\right)^{-2}&=\\frac{b^4}{a^6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(\\dfrac{5g^2}{h^{-3}}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{25g^4h^6}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{5g^2}{h^{-3}}\\right)^{-2}&=(5g^2h^3)^{-2}\\\\\\left(\\frac{5g^2}{h^{-3}}\\right)^{-2}&=\\frac{1}{25g^4h^6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p26-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\dfrac{m^{-3}}{(2n)^{-4}}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{m^6}{2^8n^8}$\n\nTake the reciprocal, then apply the power laws.",
          "worked": "$$\\begin{aligned}\\left(\\frac{m^{-3}}{(2n)^{-4}}\\right)^{-2}&=\\left(\\frac{(2n)^{-4}}{m^{-3}}\\right)^2\\\\\\left(\\frac{m^{-3}}{(2n)^{-4}}\\right)^{-2}&=\\left(\\frac{m^3}{2^4n^4}\\right)^2\\\\\\left(\\frac{m^{-3}}{(2n)^{-4}}\\right)^{-2}&=\\frac{m^6}{2^8n^8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
