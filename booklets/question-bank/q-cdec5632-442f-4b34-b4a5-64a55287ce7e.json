    "type": "question",
    "label": "3",
    "prompt": "For each function, first find $\\dfrac{dy}{dx}$ then evaluate $\\dfrac{dy}{dx}$ at $x=2$, giving your answer first in exact form and then correct to two decimal places.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=e^{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3e^{3x}$; $y'(2)=3e^6\\approx1210.29$.",
          "worked": "$$\\begin{aligned}y'&=3e^{3x}\\\\y'(2)&=3e^{3(2)}\\\\y'(2)&=3e^6\\\\y'(2)&\\approx1210.29\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=e^{-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-2e^{-2x}$; $y'(2)=-2e^{-4}\\approx-0.04$.",
          "worked": "$$\\begin{aligned}y'&=-2e^{-2x}\\\\y'(2)&=-2e^{-2(2)}\\\\y'(2)&=-2e^{-4}\\\\y'(2)&\\approx-0.04\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=e^{3x/2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac32e^{3x/2}$; $y'(2)=\\dfrac32e^3\\approx30.13$.",
          "worked": "$$\\begin{aligned}y'&=\\frac32e^{3x/2}\\\\y'(2)&=\\frac32e^{3(2)/2}\\\\y'(2)&=\\frac32e^3\\\\y'(2)&\\approx30.13\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
