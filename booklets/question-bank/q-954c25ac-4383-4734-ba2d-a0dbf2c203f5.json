        "id": "p30-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "3.75 kilograms of butter at $\\$1.50$ a kilogram",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$5.63$",
          "worked": "$$\\begin{align*}3.75\\times1.50&=\\frac{375\\times150}{10000}\\\\3.75\\times1.50&=5.625\\\\3.75\\times1.50&\\approx5.63\\end{align*}$$\nThe butter costs $\\$5.63$ to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p30-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$3\\frac{1}{2}$ dozen eggs at $\\$2.80$ per dozen",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$9.80$",
          "worked": "$$3\\frac{1}{2}=3.5$$\n$$\\begin{align*}3.5\\times2.80&=\\frac{35\\times280}{1000}\\\\3.5\\times2.80&=9.8\\end{align*}$$\nThe eggs cost $\\$9.80$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p30-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "4.35 kilograms of cheese at $\\$7.50$ a kilogram",
        "layout": "list",
        "columns": null,
