        "answer": {
          "short": "$\\$32.63$",
          "worked": "$$\\begin{align*}4.35\\times7.50&=\\frac{435\\times750}{10000}\\\\4.35\\times7.50&=32.625\\\\4.35\\times7.50&\\approx32.63\\end{align*}$$\nThe cheese costs $\\$32.63$ to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
