  "content": {
    "id": "p21-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The lines with equations $y=nx+2$ and $y=mx+3$ intersect at $(3,-1)$. Find $m$ and $n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=-\\frac{4}{3}$, $n=-1$.",
      "worked": "The intersection point lies on both lines. Substituting $x=3$ and $y=-1$ into $y=nx+2$ gives\n$$\\begin{align*}-1&=3n+2\\\\3n&=-3\\\\n&=-1\\end{align*}$$\nSubstituting into $y=mx+3$ gives\n$$\\begin{align*}-1&=3m+3\\\\3m&=-4\\\\m&=-\\frac{4}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
