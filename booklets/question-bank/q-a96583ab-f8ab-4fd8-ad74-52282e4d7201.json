    "children": [
      {
        "id": "p21-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\sqrt{x}-\\frac{1}{\\sqrt{x}}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+\\frac{1}{x}-2$",
          "worked": "$$\\begin{align*}\\left(\\sqrt{x}-\\frac{1}{\\sqrt{x}}\\right)^2&=(\\sqrt{x})^2-2\\sqrt{x}\\cdot\\frac{1}{\\sqrt{x}}+\\left(\\frac{1}{\\sqrt{x}}\\right)^2\\\\(\\sqrt{x})^2-2\\sqrt{x}\\cdot\\frac{1}{\\sqrt{x}}+\\left(\\frac{1}{\\sqrt{x}}\\right)^2&=x-2+\\frac{1}{x}\\end{align*}$$\n\nThe expression is defined for $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p21-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\sqrt{x}+\\frac{1}{\\sqrt{x}}\\right)\\left(\\sqrt{x}-\\frac{1}{\\sqrt{x}}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-\\frac{1}{x}$",
          "worked": "$$\\begin{align*}\\left(\\sqrt{x}+\\frac{1}{\\sqrt{x}}\\right)\\left(\\sqrt{x}-\\frac{1}{\\sqrt{x}}\\right)&=(\\sqrt{x})^2-\\left(\\frac{1}{\\sqrt{x}}\\right)^2\\\\(\\sqrt{x})^2-\\left(\\frac{1}{\\sqrt{x}}\\right)^2&=x-\\frac{1}{x}\\end{align*}$$\n\nThe expression is defined for $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
