        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{v-u}{t}$",
          "worked": "$$\\begin{align*}v-u&=mt\\\\\\frac{v-u}{t}&=m\\\\m&=\\frac{v-u}{t}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "v2-2621d3-p6-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$T=c-3m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{c-T}{3}$",
          "worked": "$$\\begin{align*}T-c&=-3m\\\\\\frac{T-c}{-3}&=m\\\\m&=\\frac{c-T}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "v2-2621d3-p6-practice-slot-3-slot-3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$A=\\frac{m}{k}-ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=k(A+ab)$",
          "worked": "$$\\begin{align*}A+ab&=\\frac{m}{k}\\\\k(A+ab)&=m\\\\m&=k(A+ab)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "v2-2621d3-p6-practice-slot-3-slot-3-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$E=2m+3n+p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{E-3n-p}{2}$",
          "worked": "$$\\begin{align*}E-3n-p&=2m\\\\\\frac{E-3n-p}{2}&=m\\\\m&=\\frac{E-3n-p}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "v2-2621d3-p6-practice-slot-3-slot-3-q-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{2m}{3}+c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{3(y-c)}{2}$",
          "worked": "$$\\begin{align*}y-c&=\\frac{2m}{3}\\\\3(y-c)&=2m\\\\\\frac{3(y-c)}{2}&=m\\\\m&=\\frac{3(y-c)}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-2621d3-p6-practice-slot-3-slot-3-q-f",
        "type": "part",
        "label": "f",
        "prompt": "$w=q^{2}-\\frac{m}{p}$",
