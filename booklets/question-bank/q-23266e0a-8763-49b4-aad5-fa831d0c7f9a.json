        "answer": {
          "short": "$m=p(q^{2}-w)$",
          "worked": "$$\\begin{align*}w-q^{2}&=-\\frac{m}{p}\\\\-p(w-q^{2})&=m\\\\m&=p(q^{2}-w)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
