  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "In medieval Europe, the Black Death plague had an extremely high fatality rate. Calculate the percentage of those who died from the disease if the number of survivors in a village of 300 people infected with the disease was 15.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$95\\%$",
      "worked": "Number who died: $300-15=285$.\n$$\\begin{align*}\\text{Percentage who died}&=\\frac{285}{300}\\times100\\%\\\\\\text{Percentage who died}&=95\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
