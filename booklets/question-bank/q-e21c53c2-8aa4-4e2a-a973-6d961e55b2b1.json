  "content": {
    "id": "p37-cc-12-root",
    "type": "question",
    "label": "2",
    "prompt": "If $4\\cos x-3\\sin x=R\\sin(x+\\alpha)$ where $R>0$, which quadrant is $\\alpha$ in?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Second quadrant.",
      "worked": "$$R\\sin(x+\\alpha)=R\\cos\\alpha\\sin x+R\\sin\\alpha\\cos x.$$\nEquating coefficients gives $R\\sin\\alpha=4$ and $R\\cos\\alpha=-3$. Since $R>0$, $\\sin\\alpha>0$ and $\\cos\\alpha<0$. Therefore $\\alpha$ is in the second quadrant.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
