  "content": {
    "id": "v2-1ddc9-p55-practice-slot-7-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Solve $4\\cos^2\\theta=3$ for $0\\leq\\theta<360^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\theta=30^\\circ,\\ 150^\\circ,\\ 210^\\circ,\\ 330^\\circ$",
      "worked": "$$\\begin{align*}4\\cos^2\\theta&=3\\\\\\cos^2\\theta&=\\frac34\\\\\\cos\\theta&=\\pm\\frac{\\sqrt{3}}{2}\\\\A&=\\cos^{-1}\\left(\\frac{\\sqrt{3}}{2}\\right)=30^\\circ\\end{align*}$$\nThe positive value gives Q1 and Q4; the negative value gives Q2 and Q3.\n$$\\begin{align*}\\theta&=30^\\circ,\\ 180^\\circ-30^\\circ,\\ 180^\\circ+30^\\circ,\\ 360^\\circ-30^\\circ\\\\\\theta&=30^\\circ,\\ 150^\\circ,\\ 210^\\circ,\\ 330^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
