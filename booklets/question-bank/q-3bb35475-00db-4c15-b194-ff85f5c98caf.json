        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}x^2-2x&=(-2)^2-2\\times(-2)\\\\x^2-2x&=4+4\\\\x^2-2x&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
