  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Let $P_0$ and $k$ be any constants. Show that $P=P_0e^{kt}$ satisfies the differential equation $\\dfrac{dP}{dt}=kP$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{dP}{dt}=kP_0e^{kt}=kP$.",
      "worked": "$$\\begin{align*} \\frac{dP}{dt}&=P_0\\frac{d}{dt}\\bigl(e^{kt}\\bigr)\\\\ \\frac{dP}{dt}&=P_0ke^{kt}\\\\ \\frac{dP}{dt}&=kP.\\end{align*}$$",
      "solutionDiagrams": []
    },
