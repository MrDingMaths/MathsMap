  "content": {
    "id": "p49-q30-root",
    "type": "question",
    "label": "30",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q30-a",
        "type": "part",
        "label": "a",
        "prompt": "Let $y=x\\times u$, where $u$ is an unknown function of $x$. Use the product rule to find an expression for $y'$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=u+xu'$",
          "worked": "$$\\begin{align*}y'&=1\\cdot u+x\\frac{du}{dx}\\\\y'&=u+xu'\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p49-q30-b",
        "type": "group",
        "label": "b",
        "prompt": "Consider the DE $xy'=2x+2y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p49-q30-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Use the result of part a to write a corresponding DE for $u$ that is separable.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{u'}{2+u}=\\dfrac1x$",
              "worked": "Substitute $y=xu$ and $y'=u+xu'$ into $xy'=2x+2y$:\n$$\\begin{align*}x(u+xu')&=2x+2xu\\\\xu+x^2u'&=2x+2xu\\\\x^2u'&=2x+xu\\\\x^2u'&=x(2+u)\\\\xu'&=2+u\\\\\\frac{u'}{2+u}&=\\frac1x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
          },
          {
            "id": "p49-q30-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Solve this DE for $u$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$u=Cx-2$",
              "worked": "$$\\begin{align*}\\frac{1}{u+2}\\,du&=\\frac1x\\,dx\\\\\\int\\frac{1}{u+2}\\,du&=\\int\\frac1x\\,dx\\\\\\ln|u+2|&=\\ln|x|+K\\\\u+2&=Ax\\\\u&=Cx-2\\end{align*}$$\nThe constant solution $u=-2$ is included by taking $C=0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p49-q30-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Hence write down the general solution of $xy'=2x+2y$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=Cx^2-2x$",
              "worked": "$$\\begin{align*}y&=xu\\\\y&=x(Cx-2)\\\\y&=Cx^2-2x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      }
    ]
  },
