  "content": {
    "id": "p41-25j-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "An urn contains balls labelled $1$ to $n$. A random sample of $k$ balls is drawn and arranged in a row. Find the probability the sequence is increasing.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{k!}$.\n\nEach sample has exactly one increasing arrangement among its $k!$ arrangements.",
      "worked": "Each selection of $k$ balls has exactly one increasing arrangement. There are $\\binom{n}{k}$ favourable sequences and $\\dfrac{n!}{(n-k)!}$ equally likely ordered sequences.\n\n$$\\begin{align*}\\Pr(\\text{increasing})&=\\frac{\\binom{n}{k}}{n!/(n-k)!}\\\\\\Pr(\\text{increasing})&=\\frac{n!}{k!(n-k)!}\\times\\frac{(n-k)!}{n!}\\\\\\Pr(\\text{increasing})&=\\frac{1}{k!}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
