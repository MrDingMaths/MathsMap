        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Any factor pair of $144$; for example, $12,\\ 12$.",
          "worked": "The numerator of the product is $9\\times2=18$. Since $\\frac{18}{144}=\\frac18$, the two denominators must multiply to $144$.\n$$\\begin{align*}\\frac9{12}\\times\\frac2{12}&=\\frac{9\\times2}{12\\times12}\\\\&=\\frac{18}{144}\\\\&=\\frac18\\end{align*}$$\nAny factor pair of $144$ works.",
          "solutionDiagrams": []
