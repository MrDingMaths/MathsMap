                  "type": "math",
                  "latex": "\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{15mm}}}{3}\\times\\frac12=\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{15mm}}}{3}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Any pair with the first number double the second; for example, $2,\\ 1$.",
          "worked": "Multiplying by $\\frac12$ halves the first numerator. The first number must be double the second.\n$$\\begin{align*}\\frac23\\times\\frac12&=\\frac{2\\times1}{3\\times2}\\\\&=\\frac26\\\\&=\\frac13\\end{align*}$$\nFor example, the boxes can contain $2$ and $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p52-q8-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p52-q8-b-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac79\\times\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}=3\\frac89",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}3\\frac89&=\\frac{35}{9}\\\\\\frac79\\times5&=\\frac{7\\times5}{9}\\\\&=\\frac{35}{9}\\end{align*}$$\nThe missing number is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
