        "id": "p19-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "What is Hoang’s $z$-score for his result in Chinese?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5$",
          "worked": "$$\\begin{align*}z_C&=\\frac{x_C-\\mu_C}{\\sigma_C}\\\\z_C&=\\frac{81-72}{6}\\\\z_C&=1.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
