        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}z_V&=\\frac{x_V-\\mu_V}{\\sigma_V}\\\\z_V&=\\frac{77-61}{8}\\\\z_V&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
