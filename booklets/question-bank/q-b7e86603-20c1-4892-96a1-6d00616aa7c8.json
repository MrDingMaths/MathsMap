  "content": {
    "id": "p22-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A square has sides of length $2+\\sqrt3$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "the perimeter",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8+4\\sqrt3$",
          "worked": "$$\\begin{align*}P&=4(2+\\sqrt3)\\\\P&=8+4\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "the area",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+4\\sqrt3$",
          "worked": "$$\\begin{align*}A&=(2+\\sqrt3)(2+\\sqrt3)\\\\A&=4+2\\sqrt3+2\\sqrt3+3\\\\A&=7+4\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
