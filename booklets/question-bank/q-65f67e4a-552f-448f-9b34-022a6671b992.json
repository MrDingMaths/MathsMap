  "content": {
    "id": "p15-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The ratio of length to width of a rectangle is $3:2$. Find the perimeter of the rectangle if its area is $96\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p15-q13-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "40\\text{ cm}",
                "display": false
              }
            ]
          },
          {
            "id": "p15-q13-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Use the area to find dimensions of 12 cm and 8 cm, then double their sum.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Let the length be $3k$ cm and the width be $2k$ cm.\n$$\\begin{align*}(3k)(2k)&=96\\\\6k^2&=96\\\\k^2&=16\\\\k&=4\\end{align*}$$\nSince dimensions are positive, $k=4$.\n$$\\begin{align*}\\text{Length}&=3\\times4=12\\text{ cm}\\\\\\text{Width}&=2\\times4=8\\text{ cm}\\\\P&=2(12+8)\\\\P&=40\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 84
