  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Suppose that $\\cos 2\\theta=\\frac{1}{3}$. Find the possible values of $\\sin\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sin\\theta=\\pm\\frac{\\sqrt{3}}{3}$.",
      "worked": "$$\\begin{align*}\\cos 2\\theta&=1-2\\sin^2\\theta\\\\\\frac{1}{3}&=1-2\\sin^2\\theta\\\\2\\sin^2\\theta&=\\frac{2}{3}\\\\\\sin^2\\theta&=\\frac{1}{3}\\\\\\sin\\theta&=\\pm\\frac{\\sqrt{3}}{3}\\end{align*}$$\n\nBoth signs are possible because no quadrant is specified.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
