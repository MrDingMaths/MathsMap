    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $101\\times99=9999$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$101\\times99=9999$.",
          "worked": "$$\\begin{align*}101\\times99&=101\\times(100-1)\\\\101\\times99&=10100-101\\\\101\\times99&=9999\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p33-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find $\\frac{1}{101}$ as a recurring decimal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{101}=0.\\dot{0}09\\dot{9}$.\n\nThe repeating cycle is 0099.",
          "worked": "Using $0.999\\ldots=1$ as in the previous question,\n\n$$\\begin{align*}101\\times0.00990099\\ldots&=101\\times\\left(\\frac{99}{10000}+\\frac{99}{100000000}+\\cdots\\right)\\\\101\\times0.00990099\\ldots&=0.9999+0.00009999+\\cdots\\\\101\\times0.00990099\\ldots&=0.99999999\\ldots\\\\101\\times0.00990099\\ldots&=1\\end{align*}$$\n\nTherefore $\\frac{1}{101}=0.\\dot{0}09\\dot{9}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the methods of the previous question to find $\\frac{1}{101}$, $\\frac{100}{101}$ and $\\frac{1000}{101}$ as recurring decimals, and hence find $\\frac{91}{101}$ as a recurring decimal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{101}=0.\\dot{0}09\\dot{9}$, $\\frac{100}{101}=0.\\dot{9}90\\dot{0}$, $\\frac{1000}{101}=9.\\dot{9}00\\dot{9}$; hence $\\frac{91}{101}=0.\\dot{9}00\\dot{9}$.\n\nMultiply the first expansion by 100 and 1000, then subtract 9 from the last result.",
          "worked": "$$\\begin{align*}\\frac{1}{101}&=0.00990099\\ldots\\\\\\frac{100}{101}&=100\\times0.00990099\\ldots\\\\\\frac{100}{101}&=0.99009900\\ldots\\\\\\frac{1000}{101}&=1000\\times0.00990099\\ldots\\\\\\frac{1000}{101}&=9.90099009\\ldots\\end{align*}$$\n\nSince $1000=9\\times101+91$,\n\n$$\\begin{align*}\\frac{91}{101}&=\\frac{1000}{101}-9\\\\\\frac{91}{101}&=9.90099009\\ldots-9\\\\\\frac{91}{101}&=0.\\dot{9}00\\dot{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p33-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Find $\\frac{2}{101}$, $\\frac{3}{101}$ and $\\frac{4}{101}$ as recurring decimals.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{101}=0.\\dot{0}19\\dot{8}$, $\\frac{3}{101}=0.\\dot{0}29\\dot{7}$, $\\frac{4}{101}=0.\\dot{0}39\\dot{6}$.",
          "worked": "$$\\begin{align*}\\frac{2}{101}&=2\\times0.00990099\\ldots\\\\\\frac{2}{101}&=0.01980198\\ldots=0.\\dot{0}19\\dot{8}\\\\\\frac{3}{101}&=3\\times0.00990099\\ldots\\\\\\frac{3}{101}&=0.02970297\\ldots=0.\\dot{0}29\\dot{7}\\\\\\frac{4}{101}&=4\\times0.00990099\\ldots\\\\\\frac{4}{101}&=0.03960396\\ldots=0.\\dot{0}39\\dot{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
