    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q11",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_5(x)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=25$",
          "worked": "$$\\begin{align*}x&=5^2\\\\x&=25\\end{align*}$$\n\nThe domain is $x>0$, which this solution satisfies.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q12",
        "type": "part",
        "label": "b",
        "prompt": "$\\ln(x)=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac1e$",
          "worked": "$$\\begin{align*}x&=e^{-1}\\\\x&=\\frac1e\\end{align*}$$\n\nThe domain is $x>0$, which this solution satisfies.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q13",
        "type": "part",
        "label": "c",
        "prompt": "$\\ln(x-2)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2+e^3$",
          "worked": "$$\\begin{align*}x-2&=e^3\\\\x&=2+e^3\\end{align*}$$\n\nThe domain is $x>2$, which this solution satisfies.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q14",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_2(x+3)=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1021$",
          "worked": "$$\\begin{align*}x+3&=2^{10}\\\\x+3&=1024\\\\x&=1021\\end{align*}$$\n\nThe domain is $x>-3$, which this solution satisfies.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p31-q15",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_2(4x)=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}4x&=2^4\\\\4x&=16\\\\x&=4\\end{align*}$$\n\nThe domain is $x>0$, which this solution satisfies.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p31-q16",
        "type": "part",
        "label": "f",
        "prompt": "$2\\log_3(x)=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=9$",
          "worked": "$$\\begin{align*}\\log_3(x)&=2\\\\x&=3^2\\\\x&=9\\end{align*}$$\n\nThe domain is $x>0$, which this solution satisfies.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
