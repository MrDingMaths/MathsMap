  "content": {
    "id": "v2-d7528-p52-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "If $\\overrightarrow{OM}=\\begin{pmatrix}6\\\\-2\\end{pmatrix}$ and $\\overrightarrow{ON}=\\begin{pmatrix}-3\\\\5\\end{pmatrix}$, find the resultant vector for:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d7528-p52-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{OM}+\\overrightarrow{ON}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}3\\\\3\\end{pmatrix}$",
          "worked": "$\\begin{aligned}\\overrightarrow{OM}+\\overrightarrow{ON}&=\\begin{pmatrix}6\\\\-2\\end{pmatrix}+\\begin{pmatrix}-3\\\\5\\end{pmatrix}\\\\&=\\begin{pmatrix}6-3\\\\-2+5\\end{pmatrix}\\\\&=\\begin{pmatrix}3\\\\3\\end{pmatrix}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-d7528-p52-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{OM}-\\overrightarrow{ON}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}9\\\\-7\\end{pmatrix}$",
          "worked": "$\\begin{aligned}\\overrightarrow{OM}-\\overrightarrow{ON}&=\\begin{pmatrix}6\\\\-2\\end{pmatrix}-\\begin{pmatrix}-3\\\\5\\end{pmatrix}\\\\&=\\begin{pmatrix}6-(-3)\\\\-2-5\\end{pmatrix}\\\\&=\\begin{pmatrix}9\\\\-7\\end{pmatrix}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
