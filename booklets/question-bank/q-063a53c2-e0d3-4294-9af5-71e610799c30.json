        "label": "c",
        "prompt": "Calculate the total distance travelled during the 10 seconds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75\\text{ m}$",
          "worked": "Distance travelled is the area under the speed-time graph.\n$$\\begin{aligned}\\text{Rectangle area}&=5\\times10=50\\text{ m}\\\\\\text{Triangle area}&=\\frac12\\times10\\times(10-5)=25\\text{ m}\\\\\\text{Total distance}&=50+25=75\\text{ m}\\end{aligned}$$",
          "solutionDiagrams": []
        },
