              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"boatBlue\",\"hex\":\"268CFF\",\"reason\":\"speed-time series\"}],\"reference\":\"source page 44 p44-q4-a-answer\"}\n\\begin{tikzpicture}[x=0.45cm,y=0.225cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{boatBlue}{HTML}{268CFF}\n\\definecolor{gridGrey}{HTML}{CCCCCC}\n\\draw[step=1,line width=0.25pt,color=gridGrey,xstep=1,ystep=2] (0,0) grid (11,12);\n\\draw[->,black,line width=0.5pt] (0,0)--(11,0);\n\\draw[->,black,line width=0.5pt] (0,0)--(0,12);\n\\node[anchor=north east] at (-0.12,-0.25) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}0\\special{dvisvgm:raw </g>}};\n\\foreach \\t in {2,4,6,8,10} {\n\\draw[black,line width=0.4pt] (\\t,0)--(\\t,-0.18);\n\\node[anchor=north] at (\\t,-0.35) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\t\\special{dvisvgm:raw </g>}};\n}\n\\foreach \\v in {2,4,6,8,10} {\n\\draw[black,line width=0.4pt] (0,\\v)--(-0.12,\\v);\n\\node[anchor=east] at (-0.22,\\v) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\v\\special{dvisvgm:raw </g>}};\n}\n\\node[anchor=north] at (5.5,-1.9) {Time (s)};\n\\node[rotate=90,anchor=south] at (-1.55,6) {Speed (m/s)};\n\\draw[boatBlue,line width=0.8pt] (0,5)--(10,10);\n\\end{tikzpicture}",
