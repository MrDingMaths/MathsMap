  "content": {
    "id": "p6-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A number is chosen at random from the first 20 positive whole numbers. What is the probability that it is not a prime number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{5}$",
      "worked": "The primes from 1 to 20 are $2,3,5,7,11,13,17,19$, so there are 8 primes. The number 1 is not prime.\n\n$$\\begin{align*}P(\\text{prime})&=\\frac{8}{20}\\\\P(\\text{not prime})&=1-\\frac{8}{20}\\\\P(\\text{not prime})&=\\frac{12}{20}\\\\P(\\text{not prime})&=\\frac{3}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
