        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that this is a probability distribution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each probability is between $0$ and $1$, and $\\frac16+\\frac13+\\frac12=1$.",
          "worked": "Each of $\\frac16$, $\\frac13$ and $\\frac12$ lies between $0$ and $1$.\n\n$$\\begin{align*}\\sum P(x)&=\\frac16+\\frac13+\\frac12\\\\\\sum P(x)&=\\frac16+\\frac26+\\frac36\\\\\\sum P(x)&=1\\end{align*}$$\n\nTherefore this is a probability distribution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
