  "content": {
    "id": "p16-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A curve has $\\dfrac{d^2y}{dx^2}=8x$ and the tangent at $(-2,5)$ has an angle of inclination of $45^\\circ$ with the $x$-axis. Find the equation of the curve.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\dfrac{4x^3}{3}-15x-\\dfrac{43}{3}$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
