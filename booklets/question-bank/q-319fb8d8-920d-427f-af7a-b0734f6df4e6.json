  "content": {
    "id": "p41-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The radius of a circular pool of water increases by $8\\%$. What is the exact percentage change in the area of the pool of water?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16.64\\%$ increase.\n\nSquare the radius multiplier to obtain the area multiplier.",
      "worked": "Let the original radius be $r$, so the original area is $\\pi r^2$.\n\n$$\\begin{align*}\\text{New area}&=\\pi(1.08r)^2\\\\\\text{New area}&=1.1664\\pi r^2\\\\\\text{Percentage increase}&=(1.1664-1)\\times100\\%\\\\\\text{Percentage increase}&=16.64\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
