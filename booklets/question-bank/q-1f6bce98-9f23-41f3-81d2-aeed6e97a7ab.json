    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p77-q21a",
        "type": "part",
        "label": "a",
        "prompt": "Find the velocity-time function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(t)=-\\dfrac{8}{(t+1)^{3/2}}$.",
          "worked": "$$\\begin{align*}x(t)&=16(t+1)^{-1/2}\\\\v(t)=\\frac{dx}{dt}&=16\\left(-\\frac12\\right)(t+1)^{-3/2}\\\\v(t)&=-\\frac{8}{(t+1)^{3/2}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p77-q21b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why the particle is only travelling in one direction, and state that direction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It always travels to the left because $v(t)<0$ for $t\\geq0$.",
          "worked": "For $t\\geq0$, $(t+1)^{3/2}>0$, so $v(t)=-\\dfrac{8}{(t+1)^{3/2}}<0$. The particle therefore always travels to the left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p77-q21c",
        "type": "part",
        "label": "c",
        "prompt": "Find how far the particle has travelled in the first 3 seconds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\text{ m}$. The particle moves in one direction, so the distance is $|x(3)-x(0)|$.",
          "worked": "The velocity is always negative, so the distance travelled is the magnitude of the change in displacement.\n$$\\begin{align*}x(0)&=\\frac{16}{\\sqrt{1}}=16\\\\x(3)&=\\frac{16}{\\sqrt{4}}=8\\\\\\text{distance}&=|x(3)-x(0)|\\\\\\text{distance}&=|8-16|=8\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
