  "content": {
    "id": "p21-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the number that when multiplied by $\\frac35$ gives $\\frac9{10}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac32$",
      "worked": "The required number is $\\frac9{10}\\div\\frac35$.\n$$\\begin{align*}\\frac9{10}\\div\\frac35&=\\frac9{10}\\times\\frac53\\\\\\frac9{10}\\div\\frac35&=\\frac{3\\times1}{2\\times1}\\\\\\frac9{10}\\div\\frac35&=\\frac32\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
