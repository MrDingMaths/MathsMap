    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the complete expansion of $(1+x)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+4x^3+6x^2+4x+1$",
          "worked": "The fourth row of Pascal’s triangle is $1,4,6,4,1$.\n$$\\begin{align*}(1+x)^4&=1+4x+6x^2+4x^3+x^4\\\\(1+x)^4&=x^4+4x^3+6x^2+4x+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, evaluate $(1.01)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.04060401$",
          "worked": "Substitute $x=0.01$ into the expansion from part (a).\n$$\\begin{align*}(1.01)^4&=1+4(0.01)+6(0.01)^2+4(0.01)^3+(0.01)^4\\\\(1.01)^4&=1+0.04+0.0006+0.000004+0.00000001\\\\(1.01)^4&=1.04060401.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
