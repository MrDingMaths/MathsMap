  "content": {
    "id": "p26-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A tank fills at a rate of $\\dfrac{x^2+3x}{x+3}$ litres per minute. The tank holds $\\dfrac{x^2+3x+2}{x+1}$ litres.\n\nWrite an expression for how long it takes to fill.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{x+2}{x}$ minutes",
      "worked": "Time = volume ÷ rate.\n$$\\begin{align*}\n\\text{Time}&=\\frac{x^2+3x+2}{x+1}\\div\\frac{x^2+3x}{x+3}\\\\\n&=\\frac{x^2+3x+2}{x+1}\\times\\frac{x+3}{x^2+3x}\\\\\n&=\\frac{(x+1)(x+2)}{x+1}\\times\\frac{x+3}{x(x+3)}\\\\\n&=\\frac{x+2}{x}\\text{ minutes}.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
