  "content": {
    "id": "p54-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "It takes two movers 6 and 5 hours respectively to move a one-bedroom apartment. How long will it take both of them to move the apartment together, to the nearest minute?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "2 hours 44 minutes",
      "worked": "$$\\begin{align*}\\text{Combined rate}&=\\frac{1\\text{ apartment}}{6\\text{ hours}}+\\frac{1\\text{ apartment}}{5\\text{ hours}}\\\\\\text{Combined rate}&=\\frac{11\\text{ apartments}}{30\\text{ hours}}\\\\\\text{Combined rate}&=\\frac{1\\text{ apartment}}{\\frac{30}{11}\\text{ hours}}\\\\\\text{Time}&=\\frac{30}{11}\\text{ hours}\\end{align*}$$\nUsing the ° ′ ″ button gives 2 hours 43 minutes 38.18… seconds, so the time is **2 hours 44 minutes**, to the nearest minute.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
