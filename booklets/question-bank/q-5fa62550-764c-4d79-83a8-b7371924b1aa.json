  "content": {
    "id": "p14-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A square of side length $x$ has one side reduced by 1 unit and the other increased by 1 unit.\nBy forming an expression for the area, explain why the area of the resulting rectangle is not the same as the original square.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x+1)(x-1)=x^2-1$. The rectangle has an area 1 square unit less than the original square.",
      "worked": "The original square has area $x^2$ square units. The rectangle has sides $x-1$ and $x+1$ units.\n$$\\begin{align*}A_{\\text{rectangle}}&=(x-1)(x+1)\\\\&=x^2-1^2\\\\&=x^2-1\\end{align*}$$\nIts area is 1 square unit less than the original square.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
