  "content": {
    "id": "v2-515e2-p33-practice-slot-18-root",
    "type": "question",
    "label": null,
    "prompt": "Mia has a 70% probability of catching the bus on Monday and a 56% probability of catching the bus on both Monday and Tuesday. Find the probability that Mia will catch the bus on Tuesday given that she catches it on Monday.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{4}{5}$",
      "worked": "$$\\begin{align*}P(\\text{Tuesday}\\mid\\text{Monday})&=\\frac{P(\\text{both days})}{P(\\text{Monday})}\\\\P(\\text{Tuesday}\\mid\\text{Monday})&=\\frac{0.56}{0.70}\\\\P(\\text{Tuesday}\\mid\\text{Monday})&=\\frac{4}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
