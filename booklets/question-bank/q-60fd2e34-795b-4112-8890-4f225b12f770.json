  "content": {
    "id": "p12-q88-response",
    "type": "question",
    "label": "88",
    "prompt": "Factorise, and hence simplify the following: $\\dfrac{5^{x+1}+5^x}{5^x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6$",
      "worked": "$$\\begin{align*}\\frac{5^{x+1}+5^x}{5^x}&=\\frac{5^x(5+1)}{5^x}\\\\\\frac{5^{x+1}+5^x}{5^x}&=6.\\end{align*}$$\nFor real $x$, $5^x>0$, so cancellation is valid.",
      "solutionDiagrams": []
    },
