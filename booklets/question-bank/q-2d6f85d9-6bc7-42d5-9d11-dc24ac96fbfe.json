    "label": null,
    "prompt": "A bag of oranges weighs $3.472\\text{ kg}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a3cd93-p7-practice-j3-231818-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $100\\text{ g}$ in kilograms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.1\\text{ kg}$",
          "worked": "$$\\begin{align*}1000\\text{ g}&=1\\text{ kg}\\\\100\\text{ g}&=100\\div1000\\text{ kg}\\\\&=0.1\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-a3cd93-p7-practice-j3-231818-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Round the weight of the bag to the nearest $100\\text{ g}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.5\\text{ kg}$",
          "worked": "$100\\text{ g}=0.1\\text{ kg}$, so round to the nearest tenth of a kilogram. The critical digit is $7$ in the hundredths place. Round up.\n$$3.472\\text{ kg}\\approx3.5\\text{ kg}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
