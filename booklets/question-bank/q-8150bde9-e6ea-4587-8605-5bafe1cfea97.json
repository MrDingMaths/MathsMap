        "children": [
          {
            "id": "p29-q15-a",
            "type": "part",
            "label": "a",
            "prompt": "at $15\\%$ p.a. for two years",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$32.3\\%$",
              "worked": "$$\\begin{align*}\\text{Growth} &= \\bigl((1+0.15)^2-1\\bigr)\\times100\\%\\\\\\text{Growth} &= 32.25\\%\\\\\\text{Growth} &\\approx 32.3\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
