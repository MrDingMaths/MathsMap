      {
        "id": "p29-q15-g",
        "type": "part",
        "label": "g",
        "prompt": "What do you observe about these results?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The total percentage growth is approximately the same, but increases as the number of years increases.",
          "worked": "The growth rises slightly from $32.3\\%$ to $34.6\\%$ as the number of years increases. In every case, the annual percentage rate multiplied by the number of years is $30$, but compound growth is greater than $30\\%$ because interest also earns interest.",
