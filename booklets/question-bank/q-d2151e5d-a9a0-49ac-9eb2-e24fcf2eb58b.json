line width=0.8pt,->] plot[domain=1:-3,samples=2] (\\x,{-\\x-1});\n\\draw[graphBlue,line width=0.8pt,->] plot[domain=1:5,samples=2] (\\x,{\\x-3});\n\\fill[graphBlue] (1,-2) circle[radius=1.5pt];\n\\node[anchor=north west,xshift=3pt,yshift=-3pt] at (1,-2) {$(1,-2)$};\n\\node[anchor=center] at (-1.7,2.85) {$y=-x-1$};\n\\node[anchor=center] at (3.6,2.85) {$y=x-3$};\n\\end{tikzpicture}",
