        "id": "p125-q39-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $x$-intercepts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,0)$ and $(3,0)$.",
          "worked": "At an $x$-intercept, $y=0$.\n$$\\begin{align*}|x-1|-2&=0\\\\|x-1|&=2\\\\x-1&=\\pm2\\\\x&=-1\\text{ or }x=3\\end{align*}$$\nThe $x$-intercepts are $(-1,0)$ and $(3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p125-q39-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the $y$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-1)$.",
          "worked": "At the $y$-intercept, $x=0$.\n$$\\begin{align*}f(0)&=|0-1|-2\\\\f(0)&=-1\\end{align*}$$\nThe $y$-intercept is $(0,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p125-q39-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the coordinates of the vertex.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-2)$.",
          "worked": "At the vertex, the expression inside the absolute value is zero.\n$$\\begin{align*}x-1&=0\\\\x&=1\\end{align*}$$\nThe vertical translation is $-2$, so the vertex is $(1,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
