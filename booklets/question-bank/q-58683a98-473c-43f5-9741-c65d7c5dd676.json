  "content": {
    "id": "p38-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A train travels for 36 minutes at 80 km/h. How far does it go?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$48\\text{ km}$",
      "worked": "$$\\begin{align*}\\text{Time}&=\\frac{36}{60}\\text{ h}\\\\\\text{Time}&=\\frac35\\text{ h}\\end{align*}$$\n\n$$\\begin{align*}\\text{Distance}&=\\text{speed}\\times\\text{time}\\\\\\text{Distance}&=80\\times\\frac35\\text{ km}\\\\\\text{Distance}&=48\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
