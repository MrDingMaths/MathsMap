  "content": {
    "id": "p11-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Cards with numbers 1–100 written on them are placed in a box. One card is randomly chosen. What is the probability of obtaining a number divisible by 5?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{5}$",
      "worked": "The favourable numbers are $5,10,15,\\ldots,100$, giving $100\\div5=20$ favourable outcomes out of $100$ equally likely outcomes.\n\n$$\\begin{align*}P(\\text{divisible by }5)&=\\frac{20}{100}\\\\P(\\text{divisible by }5)&=\\frac{1}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
