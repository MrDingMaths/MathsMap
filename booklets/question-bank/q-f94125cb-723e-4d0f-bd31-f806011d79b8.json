  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The cost of 53 litres of petrol is \\$73.67. Express this cost in \\$/L.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{\\$1.39}{\\text{L}}$",
      "worked": "$$\\begin{align*}\\text{Cost per litre} &= \\frac{\\$73.67}{53\\text{ L}}\\\\\\text{Cost per litre} &= \\frac{\\$73.67\\div53}{53\\text{ L}\\div53}\\\\\\text{Cost per litre} &= \\frac{\\$1.39}{1\\text{ L}}\\\\\\text{Cost per litre} &= \\$1.39/\\text{L}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
