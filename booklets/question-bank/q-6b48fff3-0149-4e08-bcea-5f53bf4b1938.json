  "content": {
    "id": "p35-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The total resistance $R$ of two resistors with resistances $r_1$ and $r_2$, joined in parallel, is given by the formula $\\frac{1}{R}=\\frac{1}{r_1}+\\frac{1}{r_2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $R$ if $r_1=4$ and $r_2=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=\\frac{12}{7}$",
          "worked": "$$\\begin{align*}\\frac{1}{R}&=\\frac{1}{4}+\\frac{1}{3}\\\\\\frac{1}{R}&=\\frac{3+4}{12}\\\\\\frac{1}{R}&=\\frac{7}{12}\\\\R&=\\frac{12}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p35-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $r_1$ if $R=2$ and $r_2=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r_1=3$",
          "worked": "$$\\begin{align*}\\frac{1}{2}&=\\frac{1}{r_1}+\\frac{1}{6}\\\\\\frac{1}{r_1}&=\\frac{1}{2}-\\frac{1}{6}\\\\\\frac{1}{r_1}&=\\frac{3-1}{6}\\\\\\frac{1}{r_1}&=\\frac{1}{3}\\\\r_1&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
