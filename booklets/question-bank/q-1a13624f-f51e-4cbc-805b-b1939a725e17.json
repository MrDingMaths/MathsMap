  "content": {
    "id": "p61-q17-content",
    "type": "question",
    "label": "17",
    "prompt": "Differentiate $(\\log_e x)^2$, and hence find $\\displaystyle\\int_{\\sqrt e}^{e}\\frac{\\log_e x}{x}\\,dx$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\displaystyle\\frac{d}{dx}(\\log_e x)^2=\\frac{2\\log_e x}{x}$; integral $=\\dfrac38$.",
      "worked": "$$\\begin{aligned}\\frac{d}{dx}(\\log_e x)^2&=2\\log_e x\\times\\frac1x\\\\&=2\\frac{\\log_e x}{x}.\\end{aligned}$$\n$$\\frac{\\log_e x}{x}=\\frac12\\times2\\frac{\\log_e x}{x}.$$\n$$\\begin{aligned}\\int_{\\sqrt e}^{e}\\frac{\\log_e x}{x}\\,dx&=\\frac12\\left[(\\log_e x)^2\\right]_{\\sqrt e}^{e}\\\\&=\\frac12\\left(1^2-\\left(\\frac12\\right)^2\\right)\\\\&=\\frac12\\left(1-\\frac14\\right)\\\\&=\\frac38.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
