  "content": {
    "id": "v2-62855-p44-patterns-topup-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "The expression $9-4x$ is evaluated for consecutive values of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-62855-p44-patterns-topup-slot-5-topup-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What does the value of the expression change by each time $x$ increases by $1$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "The coefficient of $x$ is $-4$, so the value changes by $-4$ each time $x$ increases by $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-62855-p44-patterns-topup-slot-5-topup-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What does the value of the expression start at?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}9-4x&=9-4(0)\\\\&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ],
    "responseKind": "group-answer",
    "answer": {
      "short": "a) $-4$ b) $9$",
      "worked": "See parts.",
      "solutionDiagrams": []
    }
  },
