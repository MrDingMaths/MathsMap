  "content": {
    "id": "p19-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve the following for $\\theta\\in[0^\\circ,360^\\circ]$, giving answers to the nearest minute.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\theta=\\frac13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta\\approx19^\\circ28',160^\\circ32'$.",
          "worked": "Let $\\alpha=\\sin^{-1}(\\frac13)$. Sine is positive in quadrants I and II.\n$$\\begin{align*}\\theta&=\\alpha,\\ 180^\\circ-\\alpha\\\\\\theta&\\approx19^\\circ28',160^\\circ32'\\end{align*}$$\nRound only the final angles to the nearest minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\theta=-0.7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta\\approx134^\\circ26',225^\\circ34'$.",
          "worked": "Let $\\alpha=\\cos^{-1}(0.7)$. Cosine is negative in quadrants II and III.\n$$\\begin{align*}\\theta&=180^\\circ-\\alpha,\\ 180^\\circ+\\alpha\\\\\\theta&\\approx134^\\circ26',225^\\circ34'\\end{align*}$$\nRound only the final angles to the nearest minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cot\\theta=2.74$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta\\approx20^\\circ3',200^\\circ3'$.",
          "worked": "$$\\tan\\theta=\\frac1{2.74}$$\nLet $\\alpha=\\tan^{-1}(\\frac1{2.74})$. Tangent is positive in quadrants I and III.\n$$\\begin{align*}\\theta&=\\alpha,\\ 180^\\circ+\\alpha\\\\\\theta&\\approx20^\\circ3',200^\\circ3'\\end{align*}$$\nRound only the final angles to the nearest minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
