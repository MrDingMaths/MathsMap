  "content": {
    "id": "p20-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Let $P(x)=x^3-x^2-4x+4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x=1$ is a root of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(1)=0$, so $x=1$ is a root.",
          "worked": "$$\\begin{align*}P(1)&=1^3-1^2-4(1)+4\\\\P(1)&=1-1-4+4\\\\P(1)&=0\\end{align*}$$\nSince $P(1)=0$, $x=1$ is a root.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $x=2$ is a root of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(2)=0$, so $x=2$ is a root.",
          "worked": "$$\\begin{align*}P(2)&=2^3-2^2-4(2)+4\\\\P(2)&=8-4-8+4\\\\P(2)&=0\\end{align*}$$\nSince $P(2)=0$, $x=2$ is a root.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $x=3$ is not a root of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(3)=10\\ne0$, so $x=3$ is not a root.",
          "worked": "$$\\begin{align*}P(3)&=3^3-3^2-4(3)+4\\\\P(3)&=27-9-12+4\\\\P(3)&=10\\ne0\\end{align*}$$\nSince $P(3)\\ne0$, $x=3$ is not a root.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
