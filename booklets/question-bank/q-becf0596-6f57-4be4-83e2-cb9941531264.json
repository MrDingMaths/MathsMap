  "content": {
    "id": "p20-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A parabola has vertex $(1,-2)$ and passes through the point $(3,2)$. Find its equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=(x-1)^2-2$, or $y=x^2-2x-1$.",
      "worked": "The vertex gives $y=a(x-1)^2-2$. Substituting $(3,2)$:\n\n$$\\begin{align*}2&=a(3-1)^2-2\\\\2&=4a-2\\\\4a-2&=2\\\\4a&=4\\\\a&=1\\end{align*}$$\n\nHence $y=(x-1)^2-2$, or $y=x^2-2x-1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
