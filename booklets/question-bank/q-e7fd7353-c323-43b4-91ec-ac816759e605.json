    "id": "p13-q2-p10-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A card is drawn at random from an ordinary pack of 52 playing cards. What is the probability that it is not a King?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{12}{13}$",
      "worked": "There are four Kings in the pack.\n$$\\begin{align*}P(\\text{not a King})&=1-\\frac{4}{52}\\\\P(\\text{not a King})&=\\frac{48}{52}\\\\P(\\text{not a King})&=\\frac{12}{13}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
