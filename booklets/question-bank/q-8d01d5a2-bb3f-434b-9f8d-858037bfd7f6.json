    "children": [
      {
        "id": "p9-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "List the first ten natural numbers that leave a remainder of 2 when divided by 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2, 5, 8, 11, 14, 17, 20, 23, 26, 29$.",
          "worked": "Start at 2 and add 3 each time, since each number has the form $3q+2$ for a non-negative integer $q$.\n\n$$2, 5, 8, 11, 14, 17, 20, 23, 26, 29.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "List the first ten natural numbers that leave a remainder of 3 when divided by 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3, 7, 11, 15, 19, 23, 27, 31, 35, 39$.",
          "worked": "Start at 3 and add 4 each time, since each number has the form $4q+3$ for a non-negative integer $q$.\n\n$$3, 7, 11, 15, 19, 23, 27, 31, 35, 39.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the smallest natural number that leaves a remainder of 2 when divided by 3 and a remainder of 3 when divided by 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$.\n\nIt is the first number common to the two remainder lists.",
          "worked": "The numbers leaving remainder 2 when divided by 3 begin\n$$2, 5, 8, 11, 14, \\ldots$$\nThe numbers leaving remainder 3 when divided by 4 begin\n$$3, 7, 11, 15, 19, \\ldots$$\nThe first common number is $11$. Checking:\n$$\\begin{align*}11&=3\\times3+2\\\\11&=4\\times2+3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
