  "content": {
    "id": "p18-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Suppose there is no prime number that divides both $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "What can be said about the greatest common divisor of $a$ and $b$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{GCD}(a,b)=1$.",
          "worked": "Any common divisor greater than $1$ would have a prime factor dividing both $a$ and $b$. Therefore, their only positive common divisor is $1$.\n\n$$\\operatorname{GCD}(a,b)=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "What can be said about the least common multiple of $a$ and $b$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{LCM}(a,b)=ab$.",
          "worked": "The prime factorisations of $a$ and $b$ have no primes in common. Taking the greatest power of each prime therefore includes every prime-power factor from both numbers.\n\n$$\\operatorname{LCM}(a,b)=ab.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
