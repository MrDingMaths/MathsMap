    ],
    "children": [
      {
        "id": "p67-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of line $AC$ and hence determine $\\theta$, correct to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AC}=\\dfrac23$, $\\theta\\approx34^\\circ$.",
          "worked": "$$\\begin{align*}m_{AC}&=\\frac{4-0}{7-1}\\\\m_{AC}&=\\frac23\\\\\\tan\\theta&=\\frac23\\\\\\theta&=\\tan^{-1}\\!\\left(\\frac23\\right)\\\\\\theta&\\approx34^\\circ.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p67-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Derive the equation of $AC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x-3y-2=0$.",
          "worked": "Using $A(1,0)$ and $m_{AC}=\\frac23$:\n$$\\begin{align*}y-0&=\\frac23(x-1)\\\\3y&=2x-2\\\\2x-3y-2&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p67-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the coordinates of the midpoint $D$ of $AC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D(4,2)$.",
          "worked": "$$\\begin{align*}D&=\\left(\\frac{1+7}{2},\\frac{0+4}{2}\\right)\\\\D&=(4,2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p67-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $AC$ is perpendicular to $BD$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AC}m_{BD}=\\frac23\\left(-\\frac32\\right)=-1$, so $AC\\perp BD$.",
          "worked": "$$\\begin{align*}m_{BD}&=\\frac{2-8}{4-0}\\\\m_{BD}&=-\\frac32\\\\m_{AC}m_{BD}&=\\frac23\\left(-\\frac32\\right)\\\\m_{AC}m_{BD}&=-1.\\end{align*}$$\nThe gradients have product $-1$, so $AC\\perp BD$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p67-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "What type of triangle is $ABC$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Isosceles.",
          "worked": "$BD$ is perpendicular to $AC$ and passes through its midpoint, so $BD$ is the perpendicular bisector of $AC$. Therefore $BA=BC$, and triangle $ABC$ is isosceles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p67-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "Find the area of this triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$26$ square units.",
          "worked": "$$\\begin{align*}AC&=\\sqrt{(7-1)^2+(4-0)^2}\\\\AC&=\\sqrt{52}\\\\BD&=\\sqrt{(4-0)^2+(2-8)^2}\\\\BD&=\\sqrt{52}.\\end{align*}$$\nSince $BD\\perp AC$, $BD$ is the perpendicular height.\n$$\\begin{align*}\\text{Area}&=\\frac12\\times AC\\times BD\\\\\\text{Area}&=\\frac12\\times\\sqrt{52}\\times\\sqrt{52}\\\\\\text{Area}&=26\\text{ square units}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p67-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "Write the coordinates of a point $E$ such that $ABCE$ is a rhombus.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(8,-4)$.",
          "worked": "The diagonals $AC$ and $BE$ must bisect each other at $D(4,2)$.\n$$\\begin{align*}\\frac{0+x_E}{2}&=4\\\\x_E&=8\\\\\\frac{8+y_E}{2}&=2\\\\y_E&=-4.\\end{align*}$$\nThus $E=(8,-4)$. The diagonals bisect each other and are perpendicular, so $ABCE$ is a rhombus.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
