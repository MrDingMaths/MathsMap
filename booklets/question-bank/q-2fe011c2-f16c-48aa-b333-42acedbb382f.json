  "content": {
    "id": "p67-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Consider the diagram.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p67-q10-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 67 p67-q10-diagram\"}\n\\begin{tikzpicture}[x=0.55cm,y=0.55cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (1,0);\n\\coordinate (B) at (0,8);\n\\coordinate (C) at (7,4);\n\\coordinate (D) at (4,2);\n\\coordinate (R) at (8,0);\n\\draw[->,line width=0.5pt] (-2,0)--(10,0) node[below] {$x$};\n\\draw[->,line width=0.5pt] (0,-3)--(0,10) node[left] {$y$};\n\\draw[line width=0.8pt] (A)--(B)--(C)--cycle;\n\\draw[line width=0.8pt] (B)--(D);\n\\fill (A) circle (1.6pt) node[below right] {$A(1,0)$};\n\\fill (B) circle (1.6pt) node[above right] {$B(0,8)$};\n\\fill (C) circle (1.6pt) node[above right] {$C(7,4)$};\n\\fill (D) circle (1.6pt) node[below right,xshift=1mm,yshift=-1mm] {$D$};\n\\pic[draw,->,line width=0.4pt,angle radius=12mm,angle eccentricity=1.25,\"$\\theta$\"] {angle=R--A--C};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 67,
          "sourceRegion": "Question 10, coordinate diagram",
          "description": "Triangle ABC with D on AC and segment BD. Positive axes are arrowed and labelled; no grid, ticks, equality marks or right-angle marker. The acute inclination at A is labelled theta.",
          "mathematics": "A=(1,0), B=(0,8), C=(7,4), D=(4,2). AC has gradient 2/3. D is plotted but its coordinates are not supplied to students.",
          "answerVisibility": "All source givens and labels visible; derived coordinates and measurements omitted."
