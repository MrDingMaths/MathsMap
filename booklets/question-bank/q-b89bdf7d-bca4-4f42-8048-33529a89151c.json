    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m_1=m_3=\\frac{4}{3}$ and $m_2=m_4=-\\frac{3}{4}$. Opposite sides are parallel and adjacent sides are perpendicular because $\\frac{4}{3}\\times\\left(-\\frac{3}{4}\\right)=-1$. Hence the quadrilateral is a rectangle.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p15-q9-worked-gradients",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\text{Line 1: }4x-3y+10&=0\\quad\\to\\quad m_1=\\frac{4}{3}\\\\\\text{Line 2: }3x+4y+7&=0\\quad\\to\\quad m_2=-\\frac{3}{4}\\\\\\text{Line 3: }4x-3y-7&=0\\quad\\to\\quad m_3=\\frac{4}{3}\\\\\\text{Line 4: }3x+4y+1&=0\\quad\\to\\quad m_4=-\\frac{3}{4}\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p15-q9-worked-parallel",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "m_1=m_3",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "m_2=m_4",
                "display": false
              },
              {
                "type": "text",
                "text": ", so opposite sides are parallel.",
                "marks": []
              }
            ]
          },
          {
            "id": "p15-q9-worked-perpendicular",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "m_1\\times m_2=\\frac{4}{3}\\times\\left(-\\frac{3}{4}\\right)=-1",
                "display": false
              },
              {
                "type": "text",
                "text": ", so adjacent sides are perpendicular.",
                "marks": []
              }
            ]
          },
          {
            "id": "p15-q9-worked-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The quadrilateral is a rectangle.",
                "marks": []
              }
            ]
          }
        ]
