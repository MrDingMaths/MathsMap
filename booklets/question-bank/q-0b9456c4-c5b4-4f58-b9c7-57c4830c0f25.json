  "content": {
    "id": "p31-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "If $c=3$, evaluate these expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q8-left-column",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p31-q8-a",
            "type": "part",
            "label": "a",
            "prompt": "$4+c$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7$",
              "worked": "$$\\begin{align*}4+c&=4+3\\\\4+c&=7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p31-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "$4c$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12$",
              "worked": "$$\\begin{align*}4c&=4(3)\\\\4c&=12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p31-q8-c",
            "type": "part",
            "label": "c",
            "prompt": "$4c+c$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$15$",
              "worked": "$$\\begin{align*}4c+c&=4(3)+3\\\\4c+c&=12+3\\\\4c+c&=15\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p31-q8-d",
            "type": "part",
            "label": "d",
            "prompt": "$5c$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$15$",
              "worked": "$$\\begin{align*}5c&=5(3)\\\\5c&=15\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p31-q8-e",
            "type": "part",
            "label": "e",
            "prompt": "$5c-7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8$",
              "worked": "$$\\begin{align*}5c-7&=5(3)-7\\\\5c-7&=15-7\\\\5c-7&=8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p31-q8-f",
            "type": "part",
            "label": "f",
            "prompt": "$(5c-7)\\div2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$$\\begin{align*}(5c-7)\\div2&=(5(3)-7)\\div2\\\\(5c-7)\\div2&=(15-7)\\div2\\\\(5c-7)\\div2&=8\\div2\\\\(5c-7)\\div2&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p31-q8-g",
            "type": "part",
            "label": "g",
            "prompt": "$5c-7\\div2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$11.5$",
              "worked": "$$\\begin{align*}5c-7\\div2&=5(3)-7\\div2\\\\5c-7\\div2&=15-3.5\\\\5c-7\\div2&=11.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p31-q8-right-column",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p31-q8-h",
            "type": "part",
            "label": "h",
            "prompt": "$\\dfrac{5c-7}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$$\\begin{align*}\\frac{5c-7}{2}&=\\frac{5(3)-7}{2}\\\\\\frac{5c-7}{2}&=\\frac{15-7}{2}\\\\\\frac{5c-7}{2}&=\\frac{8}{2}\\\\\\frac{5c-7}{2}&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p31-q8-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\dfrac{4c}{4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "$$\\begin{align*}\\frac{4c}{4}&=\\frac{4(3)}{4}\\\\\\frac{4c}{4}&=\\frac{12}{4}\\\\\\frac{4c}{4}&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p31-q8-j",
            "type": "part",
            "label": "j",
            "prompt": "$\\dfrac{c}{4c}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{4}$",
              "worked": "$$\\begin{align*}\\frac{c}{4c}&=\\frac{3}{4(3)}\\\\\\frac{c}{4c}&=\\frac{3}{12}\\\\\\frac{c}{4c}&=\\frac{1}{4}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p31-q8-k",
            "type": "part",
            "label": "k",
            "prompt": "$c^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9$",
              "worked": "$$\\begin{align*}c^2&=3^2\\\\c^2&=9\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p31-q8-l",
            "type": "part",
            "label": "l",
            "prompt": "$2c^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$18$",
              "worked": "$$\\begin{align*}2c^2&=2(3)^2\\\\2c^2&=2(9)\\\\2c^2&=18\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p31-q8-m",
            "type": "part",
            "label": "m",
            "prompt": "$(2c)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$36$",
              "worked": "$$\\begin{align*}(2c)^2&=(2(3))^2\\\\(2c)^2&=6^2\\\\(2c)^2&=36\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p31-q8-n",
            "type": "part",
            "label": "n",
            "prompt": "$\\dfrac{6c}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9$",
              "worked": "$\\frac{6c}{2}=\\frac{6(3)}{2}=9$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          }
        ]
      }
    ]
  },
