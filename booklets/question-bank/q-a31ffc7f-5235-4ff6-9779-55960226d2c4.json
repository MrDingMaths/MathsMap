  "content": {
    "id": "p38-q18-root",
    "type": "question",
    "label": null,
    "prompt": "Prove that $f(|x|)$ is an even function, for all functions $f(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(|-x|)=f(|x|)$, so $f(|x|)$ is even.",
      "worked": "Let $g(x)=f(|x|)$. Since $|-x|=|x|$,\n$$\\begin{align*}g(-x)&=f(|-x|)\\\\g(-x)&=f(|x|)\\\\g(-x)&=g(x).\\end{align*}$$\nThus $g$ is even.",
      "solutionDiagrams": []
    },
