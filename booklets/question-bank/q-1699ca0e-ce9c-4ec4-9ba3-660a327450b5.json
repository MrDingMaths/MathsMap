  "content": {
    "id": "p9-q10",
    "type": "question",
    "label": "10",
    "prompt": "In a survey of 450 people, 38% preferred coffee, 42% preferred tea, and the rest preferred neither. How many people preferred neither?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "90 people",
      "worked": "$$\\begin{align*}\\text{Percentage preferring neither}&=100\\%-38\\%-42\\%\\\\\\text{Percentage preferring neither}&=20\\%\\\\\\text{Number preferring neither}&=20\\%\\times450\\\\\\text{Number preferring neither}&=0.20\\times450\\\\\\text{Number preferring neither}&=90\\end{align*}$$\n90 people preferred neither.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
