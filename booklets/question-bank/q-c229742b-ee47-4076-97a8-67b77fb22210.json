        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{v}=2i+bj$ has direction $60^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=2\\sqrt3$",
          "worked": "$$\\begin{aligned}\\tan(60^\\circ)&=\\frac{b}{2}\\\\\\sqrt3&=\\frac{b}{2}\\\\b&=2\\sqrt3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-5bb25-p34-practice-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{w}=-3i+bj$ has direction $135^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=3$",
          "worked": "$$\\begin{aligned}\\tan(135^\\circ)&=\\frac{b}{-3}\\\\-1&=\\frac{b}{-3}\\\\b&=3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
