  "content": {
    "id": "p13-q11",
    "type": "question",
    "label": "11",
    "prompt": "Henry travels 48 km by train in $\\frac34$ of an hour and then cycles 12 km in $\\frac12$ of an hour.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How long is he travelling in total?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac14\\text{ h}$",
          "worked": "$$\\begin{align*}\\text{Total time}&=\\frac34+\\frac12\\\\\\text{Total time}&=\\frac54\\\\\\text{Total time}&=1\\frac14\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "What is his average speed during the train trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{Train speed}&=48\\div\\frac34\\\\\\text{Train speed}&=48\\times\\frac43\\\\\\text{Train speed}&=64\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "What is his average speed during the bike trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{Bike speed}&=12\\div\\frac12\\\\\\text{Bike speed}&=12\\times2\\\\\\text{Bike speed}&=24\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "What is his average speed over the whole trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\text{ km/h}$\n\nDivide the total distance by the total time.",
          "worked": "$$\\begin{align*}\\text{Total distance}&=48+12\\\\\\text{Total distance}&=60\\text{ km}\\\\\\text{Average speed}&=60\\div\\frac54\\\\\\text{Average speed}&=60\\times\\frac45\\\\\\text{Average speed}&=48\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
