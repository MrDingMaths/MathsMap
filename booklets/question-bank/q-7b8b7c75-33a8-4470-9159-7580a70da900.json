  "content": {
    "id": "p15-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find a formula relating $x$ and $y$ for each of these statements, making $y$ the subject.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y$ is three less than $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-3$",
          "worked": "$$y=x-3$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$ is four more than the square of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2+4$",
          "worked": "$$y=x^2+4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y$ is eight times the square root of one-fifth of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=8\\sqrt{\\dfrac{x}{5}}$",
          "worked": "One-fifth of $x$ is $\\dfrac{x}{5}$. Take its square root, then multiply by $8$:\n$$y=8\\sqrt{\\frac{x}{5}}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x$ and $y$ are supplementary angles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=180-x$",
          "worked": "Supplementary angles add to $180^\\circ$.\n$$\\begin{align*}x+y&=180\\\\y&=180-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "A car travelled 80 km in $x$ hours at an average speed of $y$ km/h.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{80}{x}$",
          "worked": "Average speed is distance divided by time:\n$$y=\\frac{80}{x}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "A car used $x$ litres of petrol on a trip of 80 km and the fuel consumption was $y$ litres/100 km.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{5x}{4}$",
          "worked": "Convert the fuel used over $80$ km to the equivalent amount over $100$ km:\n$$\\begin{align*}y&=\\frac{x}{80}\\times100\\\\y&=\\frac{5x}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
