    "type": "question",
    "label": null,
    "prompt": "The angle sum of a regular polygon is $3240^{\\circ}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-165a9d-p5-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "How many sides does it have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20",
          "worked": "$$\\begin{aligned}S&=180(n-2)\\\\3240&=180(n-2)\\\\18&=n-2\\\\n&=20\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-165a9d-p5-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the size of each angle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$162^{\\circ}$",
          "worked": "The interior angles of a regular polygon are equal.\n$$\\begin{aligned}\\text{Each interior angle}&=\\frac{3240^{\\circ}}{20}\\\\&=162^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
