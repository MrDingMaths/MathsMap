        "id": "p42-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the value of $\\alpha$ if $\\sin x=\\cos(\\alpha-x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha=\\frac{\\pi}{2}$",
          "worked": "Using the complementary-angle identity,\n$$\\sin x=\\cos\\left(\\frac{\\pi}{2}-x\\right).$$\nHence $\\alpha=\\frac{\\pi}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p42-q13-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p42-q13-b-instruction",
              "type": "paragraph",
