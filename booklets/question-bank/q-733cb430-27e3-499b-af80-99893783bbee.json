              "inlines": [
                {
                  "type": "math",
                  "latex": "\\cos\\left(\\frac{\\pi}{12}+x\\right)=\\sin x",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5\\pi}{24}$",
          "worked": "$$\\begin{align*}\\sin\\left(\\frac{\\pi}{2}-\\left(\\frac{\\pi}{12}+x\\right)\\right)&=\\sin x\\\\\\sin\\left(\\frac{5\\pi}{12}-x\\right)&=\\sin x\\end{align*}$$\nSince $0\\le x\\le\\frac{\\pi}{2}$, both arguments lie in $\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$, where sine is increasing. Therefore,\n$$\\begin{align*}\\frac{5\\pi}{12}-x&=x\\\\2x&=\\frac{5\\pi}{12}\\\\x&=\\frac{5\\pi}{24}\\end{align*}$$\nThis value lies in the stated domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
