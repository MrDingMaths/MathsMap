        "answer": {
          "short": "$0,\\ \\text{undefined},\\ 0,\\ \\text{undefined},\\ 0$, respectively.",
          "worked": "$\\tan\\theta=\\frac{\\sin\\theta}{\\cos\\theta}$. At $0,\\pi,2\\pi$, sine is zero and cosine is nonzero, so tangent is zero. At $\\frac{\\pi}{2},\\frac{3\\pi}{2}$, cosine is zero, so tangent is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
