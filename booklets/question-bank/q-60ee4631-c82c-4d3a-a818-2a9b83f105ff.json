    "type": "question",
    "label": "",
    "prompt": "Find the area enclosed by $y=x^2-4$ and $y=2x-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{32}{3}\\ \\mathrm{u}^2$",
      "worked": "$$\\begin{align*}x^2-4&=2x-1\\\\x^2-2x-3&=0\\\\(x-3)(x+1)&=0\\\\x&=-1,\\ 3\\end{align*}$$\n$$\\begin{align*}A&=\\int_{-1}^{3}\\big((2x-1)-(x^2-4)\\big)\\,dx\\\\&=\\int_{-1}^{3}(3+2x-x^2)\\,dx\\\\&=\\left[3x+x^2-\\frac{x^3}{3}\\right]_{-1}^{3}\\\\&=(9+9-9)-\\left(-3+1+\\frac13\\right)\\\\&=9+\\frac53\\\\&=\\frac{32}{3}\\ \\mathrm{u}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
