      {
        "id": "p28-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x+2}{5}+\\frac{x-1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9x+3}{20}$",
          "worked": "$$\\begin{align*}\\frac{x+2}{5}+\\frac{x-1}{4}&=\\frac{4(x+2)+5(x-1)}{20}\\\\\\frac{x+2}{5}+\\frac{x-1}{4}&=\\frac{4x+8+5x-5}{20}\\\\\\frac{x+2}{5}+\\frac{x-1}{4}&=\\frac{9x+3}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
