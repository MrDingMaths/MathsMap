        "type": "part",
        "label": "f",
        "prompt": "$\\frac{x+3}{4}-\\frac{x+1}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5-x}{12}$",
