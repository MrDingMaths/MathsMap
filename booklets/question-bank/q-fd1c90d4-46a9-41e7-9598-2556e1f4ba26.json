    "type": "question",
    "label": "4",
    "prompt": "Given that $v=u+at$, find $t$, given that $v=16$, $u=10$ and $a=5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{6}{5}$",
      "worked": "$$\\begin{align*}at&=v-u\\\\t&=\\frac{v-u}{a}\\\\t&=\\frac{16-10}{5}\\\\t&=\\frac{6}{5}\\end{align*}$$",
