        "children": [],
        "answer": {
          "short": "$18$ cm²",
          "worked": "$$\\begin{align*}x+3&=6\\\\x&=3\\\\A_{ABCD}&=6\\times3\\\\A_{ABCD}&=18\\text{ cm}^2\\end{align*}$$",
