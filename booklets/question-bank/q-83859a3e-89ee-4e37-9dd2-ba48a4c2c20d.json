        "type": "part",
        "label": "a",
        "prompt": "Show that the perimeter of the rectangle opposite is $(4x+6)$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+2(x+3)=4x+6$ cm.",
          "worked": "$$\\begin{align*}P&=2x+2(x+3)\\\\P&=2x+2x+6\\\\P&=4x+6\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the perimeter of the rectangle if $AD=2$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$ cm",
          "worked": "Since $AD=x$ cm, $x=2$.\n$$\\begin{align*}P&=4(2)+6\\\\P&=14\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the value of $x$ if the perimeter is $36$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7.5$",
          "worked": "$$\\begin{align*}4x+6&=36\\\\4x&=30\\\\x&=\\frac{30}{4}\\\\x&=7.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p30-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the area of the rectangle $ABCD$ in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+3x)$ cm²",
          "worked": "$$\\begin{align*}A_{ABCD}&=x(x+3)\\\\A_{ABCD}&=(x^2+3x)\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the area of the rectangle if $AB=6$ cm.",
