  "content": {
    "id": "p11-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A letter is chosen at random from the word RANDOM.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "List the sample space for this experiment.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{R,A,N,D,O,M\\}$.",
          "worked": "Each of the six different letters is one possible outcome, so the sample space is $\\{R,A,N,D,O,M\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "If $E$ is the event 'the letter chosen is a vowel', write down the outcomes that satisfy $E$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$E=\\{A,O\\}$.",
              "worked": "The vowels among R,A,N,D,O,M are A and O, so $E=\\{A,O\\}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p11-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What is the probability of $E$ occurring?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$P(E)=\\frac13$.",
              "worked": "There are two favourable vowels out of six equally likely letters, so $P(E)=\\frac{2}{6}=\\frac{1}{3}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      }
    ]
