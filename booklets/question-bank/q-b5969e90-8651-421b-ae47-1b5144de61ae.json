  "content": {
    "id": "p4-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Peter joined three of his friends for dinner. They decided to share the bill of $\\$y$ equally.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "How much did Peter have to pay?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$\\frac{y}{4}$",
          "worked": "There are $1+3=4$ diners.\n$$\\begin{align*}\\text{Peter's share}&=y\\div4\\\\\\text{Peter's share}&=\\frac{y}{4}\\text{ dollars}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Peter had a 50-dollar note in his wallet. How much did he have left after the meal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$\\left(50-\\frac{y}{4}\\right)$",
          "worked": "$$\\begin{align*}\\text{Money left}&=\\text{money Peter had}-\\text{Peter's share}\\\\\\text{Money left}&=50-\\frac{y}{4}\\text{ dollars}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
