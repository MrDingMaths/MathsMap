  "content": {
    "id": "v2-481a5-p20-practice-j4-030951-root",
    "type": "question",
    "label": null,
    "prompt": "A line is perpendicular to $2x-3y+6=0$ and passes through $(4,-1)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-481a5-p20-practice-j4-030951-j4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange $2x-3y+6=0$ into the form $y=mx+c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{2x}{3}+2$",
          "worked": "$$\\begin{align*}-3y&=-2x-6\\\\y&=\\frac{2x}{3}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-481a5-p20-practice-j4-030951-j4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "State the gradient of $2x-3y+6=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{3}$",
          "worked": "From $y=\\dfrac{2x}{3}+2$, $m_{\\mathrm{original}}=\\dfrac{2}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-481a5-p20-practice-j4-030951-j4-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the gradient of a line perpendicular to $2x-3y+6=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3}{2}$",
          "worked": "$$m_{\\mathrm{new}}=-\\frac{1}{m_{\\mathrm{original}}}=-\\frac{3}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-481a5-p20-practice-j4-030951-j4-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of the perpendicular line through $(4,-1)$, in gradient-intercept form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{3x}{2}+5$",
          "worked": "$$\\begin{align*}y-y_1&=m_{\\mathrm{new}}(x-x_1)\\\\y+1&=-\\frac{3}{2}(x-4)\\\\y+1&=-\\frac{3x}{2}+6\\\\y&=-\\frac{3x}{2}+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
