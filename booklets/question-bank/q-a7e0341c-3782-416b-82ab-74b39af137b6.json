  "content": {
    "id": "p13-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "For the function $f(x)=x^2-3x+5$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{f(2)+f(3)}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}f(2)&=2^2-3(2)+5=3\\\\f(3)&=3^2-3(3)+5=5\\\\\\frac{f(2)+f(3)}2&=\\frac{3+5}{2}\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p13-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{f(0)+4f(2)+f(4)}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\dfrac13$",
          "worked": "$$\\begin{align*}f(0)&=0^2-3(0)+5=5\\\\f(2)&=2^2-3(2)+5=3\\\\f(4)&=4^2-3(4)+5=9\\\\\\frac{f(0)+4f(2)+f(4)}6&=\\frac{5+4(3)+9}{6}\\\\&=\\frac{26}{6}\\\\&=4\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
