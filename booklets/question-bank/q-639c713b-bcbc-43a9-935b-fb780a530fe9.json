        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{100-64}{9}}&=\\sqrt{\\frac{36}{9}}\\\\&=\\sqrt4\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p44-q1-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\sqrt{\\dfrac{10^2-8^2}{3^2}}$",
