        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{10^2-8^2}{3^2}}&=\\sqrt{\\frac{100-64}{9}}\\\\&=\\sqrt{\\frac{36}{9}}\\\\&=\\sqrt4\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p44-q1-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\sqrt[3]{\\dfrac{5^2-3^2}{2}}\\times\\sqrt[3]8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\sqrt[3]{\\frac{5^2-3^2}{2}}\\times\\sqrt[3]8&=\\sqrt[3]{\\frac{25-9}{2}}\\times\\sqrt[3]8\\\\&=\\sqrt[3]{\\frac{16}{2}}\\times\\sqrt[3]8\\\\&=\\sqrt[3]8\\times\\sqrt[3]8\\\\&=2\\times2\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p44-q1-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\sqrt{\\dfrac{9-5}{9}}$",
