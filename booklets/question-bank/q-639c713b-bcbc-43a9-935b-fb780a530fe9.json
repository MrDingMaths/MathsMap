      {
        "id": "p44-q1-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{5\\times(3+1)^2}{17+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\frac{5\\times(3+1)^2}{17+3}&=\\frac{5\\times4^2}{17+3}\\\\&=\\frac{5\\times4^2}{20}\\\\&=\\frac{5\\times16}{20}\\\\&=\\frac{80}{20}\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p44-q1-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\sqrt{\\dfrac{100-64}{9}}$",
