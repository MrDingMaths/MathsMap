        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac23$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{9-5}{9}}&=\\sqrt{\\frac49}\\\\&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p44-q1-r",
        "type": "part",
        "label": "r",
        "prompt": "$\\sqrt{\\dfrac{28+4}{28+22}}+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{29}{5}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{28+4}{28+22}}+5&=\\sqrt{\\frac{32}{28+22}}+5\\\\&=\\sqrt{\\frac{32}{50}}+5\\\\&=\\sqrt{\\frac{16}{25}}+5\\\\&=\\frac45+5\\\\&=\\frac45+\\frac{25}{5}\\\\&=\\frac{29}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
