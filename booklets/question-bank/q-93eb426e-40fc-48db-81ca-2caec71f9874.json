    "children": [
      {
        "id": "p19-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What are the maximum and minimum values of $\\cos\\theta$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Maximum: $1$; minimum: $-1$.",
          "worked": "The highest point of the cosine graph has ordinate $1$, and its lowest point has ordinate $-1$. Thus the maximum is $1$ and the minimum is $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Where do they occur?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Maximum: $\\theta=360^\\circ n$; minimum: $\\theta=180^\\circ+360^\\circ n$, where $n$ is any integer.",
          "worked": "On $0^\\circ\\leq\\theta\\leq360^\\circ$, the cosine graph reaches $1$ at $0^\\circ$ and $360^\\circ$, and reaches $-1$ at $180^\\circ$. The graph repeats every $360^\\circ$.\n\nTherefore maxima occur at $\\theta=360^\\circ n$, and minima occur at $\\theta=180^\\circ+360^\\circ n$, where $n$ is any integer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
