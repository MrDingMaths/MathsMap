  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "For the function $f(x)=3x+1$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(1)-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}f(1)-2&=(3(1)+1)-2\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$3f(-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6$",
          "worked": "$$\\begin{align*}3f(-1)&=3(3(-1)+1)\\\\&=3(-2)\\\\&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(9)\\div f(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}f(9)\\div f(2)&=(3(9)+1)\\div(3(2)+1)\\\\&=28\\div7\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
