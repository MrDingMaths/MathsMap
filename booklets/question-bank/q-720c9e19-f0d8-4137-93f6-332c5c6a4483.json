  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "4",
    "prompt": "For each of the following functions, find $f(-x)$ and hence determine whether they are even, odd or neither.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-2x$. Odd.",
          "worked": "$$\\begin{align*}f(-x)&=2(-x)\\\\f(-x)&=-2x\\\\f(-x)&=-f(x)\\end{align*}$$\nOdd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=x^2+1$. Even.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2+1\\\\f(-x)&=x^2+1\\\\f(-x)&=f(x)\\end{align*}$$\nEven.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^2+x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=x^2-x$. Neither.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2+(-x)\\\\f(-x)&=x^2-x\\end{align*}$$\nThis is neither $f(x)=x^2+x$ nor $-f(x)=-x^2-x$ as an identity. Hence the function is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x^3$. Odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^3\\\\f(-x)&=-x^3\\\\f(-x)&=-f(x)\\end{align*}$$\nOdd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=x-x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x+x^3$. Odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)-(-x)^3\\\\f(-x)&=-x+x^3\\\\f(-x)&=-(x-x^3)\\\\f(-x)&=-f(x)\\end{align*}$$\nOdd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p12-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-\\dfrac{1}{x}$. Odd.",
          "worked": "$$\\begin{align*}f(-x)&=\\frac{1}{-x}\\\\f(-x)&=-\\frac{1}{x}\\\\f(-x)&=-f(x)\\end{align*}$$\nOdd, for $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p12-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=2^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=2^{-x}$. Neither.",
          "worked": "$$f(-x)=2^{-x}$$\nThis is neither $f(x)=2^x$ nor $-f(x)=-2^x$ as an identity. Hence the function is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(x)=x^4-x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=x^4-x^2+1$. Even.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^4-(-x)^2+1\\\\f(-x)&=x^4-x^2+1\\\\f(-x)&=f(x)\\end{align*}$$\nEven.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$f(x)=\\sqrt{1-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=\\sqrt{1-x^2}$. Even.",
          "worked": "$$\\begin{align*}f(-x)&=\\sqrt{1-(-x)^2}\\\\f(-x)&=\\sqrt{1-x^2}\\\\f(-x)&=f(x)\\end{align*}$$\nEven, on the domain $-1\\le x\\le1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$f(x)=\\dfrac{x}{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-\\dfrac{x}{x^2+1}$. Odd.",
          "worked": "$$\\begin{align*}f(-x)&=\\frac{-x}{(-x)^2+1}\\\\f(-x)&=-\\frac{x}{x^2+1}\\\\f(-x)&=-f(x)\\end{align*}$$\nOdd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p12-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$f(x)=x+\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x-\\dfrac{1}{x}$. Odd.",
          "worked": "$$\\begin{align*}f(-x)&=-x+\\frac{1}{-x}\\\\f(-x)&=-x-\\frac{1}{x}\\\\f(-x)&=-\\left(x+\\frac{1}{x}\\right)\\\\f(-x)&=-f(x)\\end{align*}$$\nOdd, for $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$f(x)=\\dfrac{x-1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-\\dfrac{1+x}{1-x}$. Neither.",
          "worked": "$$\\begin{align*}f(-x)&=\\frac{-x-1}{-x+1}\\\\f(-x)&=-\\frac{1+x}{1-x}\\end{align*}$$\nThis equals neither $f(x)$ nor $-f(x)$ as an identity. Hence the function is neither even nor odd. Its domain also excludes $-1$ while including $1$, so it is asymmetric about zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
