    "type": "question",
    "label": "",
    "prompt": "A fair 6-sided die is rolled.\nWhat is the expected frequency of it landing on a four if you roll it 300 times?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "50 times",
      "worked": "$P(\\text{four})=\\frac{1}{6}$.\n$$\\begin{align*}f&=np\\\\&=300\\times\\frac{1}{6}\\\\&=50\\text{ times}\\end{align*}$$",
      "solutionDiagrams": []
