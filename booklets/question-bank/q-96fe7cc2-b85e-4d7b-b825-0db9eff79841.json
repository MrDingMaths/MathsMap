  "content": {
    "id": "p39-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A real estate agent charges a commission of 8.9% on every property sale.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "If a house sells for $\\$540000$, how much commission will the real estate agent receive, and how much is left for the seller?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Commission: $\\$48060$; seller receives $\\$491940$.",
          "worked": "$$\\begin{align*}\\text{Commission}&=540000\\times8.9\\%\\\\\\text{Commission}&=540000\\times0.089\\\\\\text{Commission}&=\\$48060\\\\\\text{Seller receives}&=540000-48060\\\\\\text{Seller receives}&=\\$491940\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p39-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "If the real estate agent receives a commission of $\\$8455$ for selling a house, what was the selling price of the house, and what did the seller actually receive?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Selling price: $\\$95000$; seller receives $\\$86545$.",
          "worked": "$$\\begin{align*}\\text{Commission}&=\\text{selling price}\\times0.089\\\\\\text{Selling price}&=8455\\div0.089\\\\\\text{Selling price}&=\\$95000\\\\\\text{Seller receives}&=95000-8455\\\\\\text{Seller receives}&=\\$86545\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
