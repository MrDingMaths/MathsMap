  "content": {
    "id": "p11-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The formula for kinetic energy is $E=\\frac12mv^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $E$ correct to three significant figures, when $m=9.21\\times10^{-11}$ and $v=3.00\\times10^7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.14\\times10^4$",
          "worked": "$$\\begin{align*}E&=\\tfrac12(9.21\\times10^{-11})(3.00\\times10^7)^2\\\\E&=\\tfrac12\\times9.21\\times9\\times10^3\\\\E&=41445\\\\E&\\approx4.14\\times10^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $v$ correct to four significant figures, when $E=2.834\\times10^{-10}$ and $m=6.418\\times10^{-29}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.972\\times10^9$",
          "worked": "$$\\begin{align*}v^2&=\\frac{2E}{m}\\\\v^2&=\\frac{2(2.834\\times10^{-10})}{6.418\\times10^{-29}}\\\\v&=\\sqrt{\\frac{5.668}{6.418}\\times10^{19}}\\\\v&\\approx2.971769112\\times10^9\\\\v&\\approx2.972\\times10^9\\end{align*}$$\n\nUse the positive root for speed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
