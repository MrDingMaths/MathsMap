  "content": {
    "id": "v2-76d80-p20-practice-slot-8-lower-root",
    "type": "question",
    "label": null,
    "prompt": "The hire charges for kayaks at shops A and B are given by:\nShop A: $C=15h$, where $\\$C$ is the cost of hiring for $h$ hours\nShop B: $\\$30$ plus $\\$9$ per hour",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-76d80-p20-practice-slot-8-lower-slot-8-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find a rule for $\\$C$ charged for $h$ hours at Shop B.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=30+9h$",
          "worked": "The charge is the fixed amount plus the hourly rate multiplied by the hours.\n$$\\begin{align*}C&=30+9h\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-76d80-p20-practice-slot-8-lower-slot-8-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "v2-76d80-p20-practice-slot-8-lower-slot-8-lower-q-b-d1",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Solve the rule for Shop A and your rule from part ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "a",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": " simultaneously.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(h,C)=(5,75)$",
          "worked": "Substitute $C=15h$ into $C=30+9h$.\n$$\\begin{align*}15h&=30+9h\\\\6h&=30\\\\h&=5\\end{align*}$$\nSubstitute $h=5$ into $C=15h$.\n$$\\begin{align*}C&=15(5)\\\\C&=75\\end{align*}$$\nThus $h=5$ hours and $C=\\$75$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-76d80-p20-practice-slot-8-lower-slot-8-lower-q-c",
        "type": "part",
        "label": "c",
        "prompt": "State the number of hours for which the cost is the same at the two shops.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 hours",
          "worked": "The solution gives $h=5$, so the cost is the same after 5 hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
