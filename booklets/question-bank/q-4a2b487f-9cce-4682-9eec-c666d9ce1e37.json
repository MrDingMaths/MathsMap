  "content": {
    "id": "v2-165a9d-p5-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "A rule for the size of an interior angle $I$ of a regular polygon with $n$ sides is $I=\\dfrac{180(n-2)}{n}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-165a9d-p5-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the rule to find the size of an interior angle of a regular polygon with $15$ sides.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$156^{\\circ}$",
          "worked": "$$\\begin{align*}I&=\\frac{180(n-2)}{n}\\\\I&=\\frac{180(15-2)}{15}\\\\I&=156^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-165a9d-p5-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the rule to find the number of sides of a regular polygon with interior angle $144^{\\circ}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "10 sides",
          "worked": "$$\\begin{align*}144&=\\frac{180(n-2)}{n}\\\\144n&=180n-360\\\\360&=36n\\\\n&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
