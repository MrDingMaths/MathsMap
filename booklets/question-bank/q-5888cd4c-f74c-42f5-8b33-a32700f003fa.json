  "content": {
    "id": "p20-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Let $13x^2-7x+6=a(2-x)^2+b(2-x)+c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate the constants $a$, $b$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=13$, $b=-45$, $c=44$.",
          "worked": "Equate coefficients of $x^2$ to obtain $a=13$.\n\nSubstitute $x=2$:\n$$\\begin{align*}c&=13(2)^2-7(2)+6\\\\c&=44.\\end{align*}$$\nSubstitute $x=1$:\n$$\\begin{align*}12&=13+b+44\\\\b&=-45.\\end{align*}$$\nThus $a=13$, $b=-45$ and $c=44$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p20-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence evaluate $13x^2-7x+6$ when $x=1.98$ without using a calculator.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$43.1052$.\n\nUse $2-1.98=0.02$ in the identity from part a.",
          "worked": "Since $2-1.98=0.02$, use part a:\n$$\\begin{align*}13(1.98)^2-7(1.98)+6&=13(0.02)^2-45(0.02)+44\\\\13(1.98)^2-7(1.98)+6&=13(0.0004)-0.9+44\\\\13(1.98)^2-7(1.98)+6&=0.0052-0.9+44\\\\13(1.98)^2-7(1.98)+6&=43.1052.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
