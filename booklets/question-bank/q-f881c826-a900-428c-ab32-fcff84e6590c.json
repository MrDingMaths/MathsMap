    "prompt": "Find the missing numbers.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-62673-p50-practice-slot-3-upper-gen-slot-3-upper-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{5}{6}\\times\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{10}=\\frac{1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac56\\times\\frac{\\square}{10}&=\\frac{5\\times\\square}{60}\\\\\\frac14&=\\frac{15}{60}\\end{align*}$$\nSo $5\\times\\square=15$ and the missing numerator is $3$.\n$$\\frac56\\times\\frac3{10}=\\frac{15}{60}=\\frac14$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-62673-p50-practice-slot-3-upper-gen-slot-3-upper-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{8}\\times\\frac{4}{9}=\\frac{1}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{\\square}{8}\\times\\frac49&=\\frac{4\\times\\square}{72}\\\\\\frac16&=\\frac{12}{72}\\end{align*}$$\nSo $4\\times\\square=12$ and the missing numerator is $3$.\n$$\\frac38\\times\\frac49=\\frac{12}{72}=\\frac16$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-62673-p50-practice-slot-3-upper-gen-slot-3-upper-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{5}{12}\\times\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}=\\frac{10}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}\\frac{5}{12}\\times\\square&=\\frac{5\\times\\square}{12}\\\\\\frac{10}{3}&=\\frac{40}{12}\\end{align*}$$\nSo $5\\times\\square=40$ and the missing number is $8$.\n$$\\frac5{12}\\times8=\\frac{40}{12}=\\frac{10}{3}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-62673-p50-practice-slot-3-upper-gen-slot-3-upper-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}\\times\\frac{4}{5}=\\frac{3}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}\\frac{3}{\\square}\\times\\frac45&=\\frac{3\\times4}{\\square\\times5}\\\\&=\\frac{12}{5\\times\\square}\\\\\\frac{3}{10}&=\\frac{12}{40}\\end{align*}$$\nSo $5\\times\\square=40$ and the missing denominator is $8$.\n$$\\frac38\\times\\frac45=\\frac{12}{40}=\\frac3{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
