      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Why did the negative sign disappear when Andy wrote his solution?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Moving $b^{-2}$ from the denominator to the numerator makes its index positive.",
          "worked": "A negative index means taking a reciprocal. Since $b^{-2}=\\frac{1}{b^2}$, moving this factor from the denominator to the numerator gives $b^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Why did the 3 stay in the denominator?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The 3 was not raised to a negative power.",
          "worked": "The negative index applies only to $b$. The factor 3 therefore stays in the denominator.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Simplify:\n$$\\frac{2}{x^{-3}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^3$",
          "worked": "$$\\begin{align*}\\frac{2}{x^{-3}}&=2x^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
