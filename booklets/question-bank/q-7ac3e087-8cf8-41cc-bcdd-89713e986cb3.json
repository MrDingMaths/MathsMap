    "children": [
      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin75^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3+1}{2\\sqrt2}$",
          "worked": "$$\\begin{aligned}\\sin75^\\circ&=\\sin(45^\\circ+30^\\circ)\\\\&=\\sin45^\\circ\\cos30^\\circ+\\cos45^\\circ\\sin30^\\circ\\\\&=\\frac1{\\sqrt2}\\left(\\frac{\\sqrt3}2\\right)+\\frac1{\\sqrt2}\\left(\\frac12\\right)\\\\&=\\frac{\\sqrt3}{2\\sqrt2}+\\frac1{2\\sqrt2}\\\\&=\\frac{\\sqrt3+1}{2\\sqrt2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos75^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3-1}{2\\sqrt2}$",
          "worked": "$$\\begin{aligned}\\cos75^\\circ&=\\cos(45^\\circ+30^\\circ)\\\\&=\\cos45^\\circ\\cos30^\\circ-\\sin45^\\circ\\sin30^\\circ\\\\&=\\frac1{\\sqrt2}\\left(\\frac{\\sqrt3}2\\right)-\\frac1{\\sqrt2}\\left(\\frac12\\right)\\\\&=\\frac{\\sqrt3}{2\\sqrt2}-\\frac1{2\\sqrt2}\\\\&=\\frac{\\sqrt3-1}{2\\sqrt2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan75^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\sqrt3$",
          "worked": "$$\\begin{aligned}\\tan75^\\circ&=\\frac{\\sin75^\\circ}{\\cos75^\\circ}\\\\&=\\frac{\\dfrac{\\sqrt3+1}{2\\sqrt2}}{\\dfrac{\\sqrt3-1}{2\\sqrt2}}\\\\&=\\frac{\\sqrt3+1}{\\sqrt3-1}\\\\&=\\frac{(\\sqrt3+1)^2}{(\\sqrt3-1)(\\sqrt3+1)}\\\\&=\\frac{3+2\\sqrt3+1}{3-1}\\\\&=\\frac{4+2\\sqrt3}{2}\\\\&=2+\\sqrt3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      }
    ]
  },
