  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "If $V=x^3+4x^2-3x+4$ and $\\dfrac{dV}{dt}=10$, evaluate $\\dfrac{dx}{dt}$ when $x=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{5}{4}$",
      "worked": "$$\\begin{aligned}\\frac{dV}{dx}&=3x^2+8x-3\\\\\\frac{dV}{dt}&=\\frac{dV}{dx}\\times\\frac{dx}{dt}\\\\10&=(3x^2+8x-3)\\frac{dx}{dt}\\end{aligned}$$\nAt $x=1$:\n$$\\begin{aligned}10&=(3+8-3)\\frac{dx}{dt}\\\\10&=8\\frac{dx}{dt}\\\\\\frac{dx}{dt}&=\\frac{10}{8}=\\frac54\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
