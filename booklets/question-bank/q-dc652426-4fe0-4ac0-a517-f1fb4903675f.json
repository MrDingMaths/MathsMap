  "content": {
    "id": "p2-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider points $A(2,1)$ and $B(-1,2)$, and the parabola with equation $y=x^2$. Find points $P$ on the parabola such that $AP=BP$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p2-q3-short-result",
            "type": "paragraph",
