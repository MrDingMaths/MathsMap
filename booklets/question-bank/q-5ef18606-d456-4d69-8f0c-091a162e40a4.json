        "answer": {
          "short": "$\\$33.60$",
          "worked": "$$\\begin{align*}\\text{Social spending}&=84\\times40\\%\\\\\\text{Social spending}&=84\\times0.40\\\\\\text{Social spending}&=\\$33.60\\end{align*}$$",
