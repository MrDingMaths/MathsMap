  "content": {
    "id": "p41-q8",
    "type": "question",
    "label": "8",
    "prompt": "Terry, Ash and Felicity share a prize in the ratio $11:8:6$. Ash received $\\$720$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "How much did Terry receive?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$990$",
          "worked": "Ash's share represents 8 parts.\n$$\\begin{align*}8\\text{ parts}&=\\$720\\\\1\\text{ part}&=\\$720\\div8=\\$90\\\\11\\text{ parts}&=\\$90\\times11=\\$990\\end{align*}$$\nTerry received $\\$990$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p41-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "How much more money did Ash receive compared to Felicity?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ash received $\\$180$ more than Felicity.",
          "worked": "$$\\begin{align*}8\\text{ parts}&=\\$720\\\\1\\text{ part}&=\\$720\\div8=\\$90\\\\\\text{Difference in parts}&=8-6=2\\\\2\\text{ parts}&=\\$90\\times2=\\$180\\end{align*}$$\nAsh received $\\$180$ more than Felicity.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p41-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "How much was the total prize money?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2250$",
          "worked": "$$\\begin{align*}8\\text{ parts}&=\\$720\\\\1\\text{ part}&=\\$720\\div8=\\$90\\\\\\text{Total parts}&=11+8+6=25\\\\25\\text{ parts}&=\\$90\\times25=\\$2250\\end{align*}$$\nThe total prize money was $\\$2250$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
