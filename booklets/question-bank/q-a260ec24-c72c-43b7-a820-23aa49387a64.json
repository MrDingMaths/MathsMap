        "prompt": "A rectangle has area $x\\text{ cm}^2$ and width $2\\text{ cm}$. What is the perimeter of the rectangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p17-q6-a-shape",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"User-requested feedback diagram; p17-q6-a-shape\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,draw=black,line width=0.8pt,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont,inner sep=1pt}]\n\\draw (0,0) rectangle (28,12);\n\\node at (14,6) {$x\\,\\mathrm{cm}^2$};\n\\node[anchor=east] at (-1,6) {$2\\,\\mathrm{cm}$};\n\\node[anchor=north] at (14,-1) {$?\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
            "src": null,
