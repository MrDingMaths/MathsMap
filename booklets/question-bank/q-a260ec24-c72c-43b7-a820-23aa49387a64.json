        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$(x+4)\\text{ cm}$; length $=\\frac{x}{2}\\text{ cm}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p17-q6-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\text{Length}&=\\frac{x}{2}\\text{ cm}\\\\\\text{Perimeter}&=2\\left(\\frac{x}{2}+2\\right)\\text{ cm}\\\\\\text{Perimeter}&=\\left(2\\times\\frac{x}{2}+2\\times2\\right)\\text{ cm}\\\\\\text{Perimeter}&=(x+4)\\text{ cm}\\end{align*}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
