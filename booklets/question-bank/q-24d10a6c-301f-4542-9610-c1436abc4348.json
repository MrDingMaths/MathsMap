  "content": {
    "id": "p12-ch18-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Given $d\\propto t^2$ and $d=18.75$ when $t=5$, find the formula for $d$ in terms of $t$ and the exact value of each quantity below. Take $t\\geq0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-ch18-q8-formula",
        "type": "part",
        "label": "",
        "prompt": "Formula for $d$ in terms of $t$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=\\frac34t^2$",
          "worked": "$\\begin{align*}d&=kt^2\\\\18.75&=25k\\\\k&=\\frac{18.75}{25}=\\frac34\\\\d&=\\frac34t^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-ch18-q8-values",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-ch18-q8-a",
            "type": "part",
            "label": "a",
            "prompt": "$d$ when $t=9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$d=60.75$",
              "worked": "$\\begin{align*}d&=\\frac34\\times9^2\\\\d&=\\frac{243}{4}\\\\d&=60.75\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p12-ch18-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "$d$ when $t=12$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$d=108$",
              "worked": "$\\begin{align*}d&=\\frac34\\times12^2\\\\d&=\\frac34\\times144\\\\d&=108\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p12-ch18-q8-c",
            "type": "part",
            "label": "c",
            "prompt": "$t$ when $d=48$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t=8$",
              "worked": "$\\begin{align*}48&=\\frac34t^2\\\\t^2&=48\\times\\frac43\\\\t^2&=64\\\\t&=8\\end{align*}$\n\nUse the positive square root because $t\\geq0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          }
        ]
      }
    ]
