  "content": {
    "id": "p34-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A die is thrown 4 times. Find the probability of throwing:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "2 threes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{216}$",
          "worked": "Let $X$ count the threes. Then $X\\sim\\operatorname{Bin}(4,\\frac16)$.\n$$\\begin{aligned}P(X=2)&=\\binom42\\left(\\frac16\\right)^2\\left(\\frac56\\right)^2\\\\&=\\frac{25}{216}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p34-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "3 ones",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{324}$",
          "worked": "Let $X$ count the ones. Then $X\\sim\\operatorname{Bin}(4,\\frac16)$.\n$$\\begin{aligned}P(X=3)&=\\binom43\\left(\\frac16\\right)^3\\left(\\frac56\\right)\\\\&=\\frac{5}{324}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p34-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "1 four",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{125}{324}$",
          "worked": "Let $X$ count the fours. Then $X\\sim\\operatorname{Bin}(4,\\frac16)$.\n$$\\begin{aligned}P(X=1)&=\\binom41\\left(\\frac16\\right)\\left(\\frac56\\right)^3\\\\&=\\frac{125}{324}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p34-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "fewer than 3 ones",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{425}{432}$",
          "worked": "Let $X$ count the ones. Then $X\\sim\\operatorname{Bin}(4,\\frac16)$.\n$$\\begin{aligned}P(X<3)&=1-P(X=3)-P(X=4)\\\\&=1-\\binom43\\left(\\frac16\\right)^3\\left(\\frac56\\right)-\\left(\\frac16\\right)^4\\\\&=\\frac{425}{432}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "at least 3 fives",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{432}$",
          "worked": "Let $X$ count the fives. Then $X\\sim\\operatorname{Bin}(4,\\frac16)$.\n$$\\begin{aligned}P(X\\ge3)&=P(X=3)+P(X=4)\\\\&=\\binom43\\left(\\frac16\\right)^3\\left(\\frac56\\right)+\\left(\\frac16\\right)^4\\\\&=\\frac{7}{432}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
