  "content": {
    "id": "p17-p3-root",
    "type": "question",
    "label": "3",
    "prompt": "Let $f(x)=\\sqrt{x}$ and $g(x)=-x^2-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-p3-a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $g(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(f(x))=-x-1$, for $x\\geq0$.",
          "worked": "$$\\begin{align*}g(f(x))&=g(\\sqrt{x})\\\\g(f(x))&=-(\\sqrt{x})^2-1\\\\g(f(x))&=-x-1.\\end{align*}$$ The domain is $x\\geq0$, since $f(x)=\\sqrt{x}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-p3-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{-x^2-1}$, which is undefined for real $x$.",
          "worked": "Substitution gives the expression $$\\sqrt{-x^2-1}.$$ Since $-x^2-1<0$ for every real $x$, this gives no real value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-p3-c",
        "type": "part",
        "label": "c",
        "prompt": "One of the above does not work. Find out which one, and explain why it does not work.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))$ has no real values because $-x^2-1<0$ for every real $x$.",
          "worked": "For real $x$, $x^2\\geq0$, so $g(x)=-x^2-1\\leq-1<0$. These outputs lie outside the domain of $f(x)=\\sqrt{x}$. Thus $f(g(x))$ has no real inputs for which it is defined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
