  "content": {
    "id": "p58-q3",
    "type": "question",
    "label": "3",
    "prompt": "Calculate the time it will take to deliver intravenous liquid at these rates.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "600 mL delivered at 15 drops/min and there are 10 drops/mL",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ h }40\\text{ min}$",
          "worked": "The quantities are volume, time and drops. Let $x$ be the delivery time in minutes.\n$$\\begin{align*}\\frac{\\text{Time}}{\\text{Volume}}&=\\frac{\\text{Time}}{\\text{Drops}}\\times\\frac{\\text{Drops}}{\\text{Volume}}\\\\\\frac{x\\text{ min}}{600\\text{ mL}}&=\\frac{1\\text{ min}}{15\\text{ drops}}\\times\\frac{10\\text{ drops}}{1\\text{ mL}}\\\\\\frac{x\\text{ min}}{600\\text{ mL}}&=\\frac{10\\text{ min}}{15\\text{ mL}}\\\\x&=600\\times\\frac{10}{15}=400\\end{align*}$$\nThe delivery time is $400\\text{ min}=6\\text{ h }40\\text{ min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p58-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "500 mL delivered at 10 drops/min and there are 12 drops/mL",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\text{ h}$",
          "worked": "The quantities are volume, time and drops. Let $x$ be the delivery time in minutes.\n$$\\begin{align*}\\frac{\\text{Time}}{\\text{Volume}}&=\\frac{\\text{Time}}{\\text{Drops}}\\times\\frac{\\text{Drops}}{\\text{Volume}}\\\\\\frac{x\\text{ min}}{500\\text{ mL}}&=\\frac{1\\text{ min}}{10\\text{ drops}}\\times\\frac{12\\text{ drops}}{1\\text{ mL}}\\\\\\frac{x\\text{ min}}{500\\text{ mL}}&=\\frac{12\\text{ min}}{10\\text{ mL}}\\\\x&=500\\times\\frac{12}{10}=600\\end{align*}$$\nThe delivery time is $600\\text{ min}=10\\text{ h}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p58-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "1.2 L delivered at 25 drops/min and there are 20 drops/mL",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\text{ h}$",
          "worked": "The quantities are volume, time and drops. Let $x$ be the delivery time in minutes.\n$$\\begin{align*}\\frac{\\text{Time}}{\\text{Volume}}&=\\frac{\\text{Time}}{\\text{Drops}}\\times\\frac{\\text{Drops}}{\\text{Volume}}\\\\\\frac{x\\text{ min}}{1.2\\text{ L}}&=\\frac{1\\text{ min}}{25\\text{ drops}}\\times\\frac{20\\text{ drops}}{1\\text{ mL}}\\\\\\frac{x\\text{ min}}{1200\\text{ mL}}&=\\frac{1\\text{ min}}{25\\text{ drops}}\\times\\frac{20\\text{ drops}}{1\\text{ mL}}\\\\\\frac{x\\text{ min}}{1200\\text{ mL}}&=\\frac{20\\text{ min}}{25\\text{ mL}}\\\\x&=1200\\times\\frac{20}{25}=960\\end{align*}$$\nThe delivery time is $960\\text{ min}=16\\text{ h}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p58-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "1.8 L delivered at 20 drops/min and there are 15 drops/mL",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22\\text{ h }30\\text{ min}$",
          "worked": "The quantities are volume, time and drops. Let $x$ be the delivery time in minutes.\n$$\\begin{align*}\\frac{\\text{Time}}{\\text{Volume}}&=\\frac{\\text{Time}}{\\text{Drops}}\\times\\frac{\\text{Drops}}{\\text{Volume}}\\\\\\frac{x\\text{ min}}{1.8\\text{ L}}&=\\frac{1\\text{ min}}{20\\text{ drops}}\\times\\frac{15\\text{ drops}}{1\\text{ mL}}\\\\\\frac{x\\text{ min}}{1800\\text{ mL}}&=\\frac{1\\text{ min}}{20\\text{ drops}}\\times\\frac{15\\text{ drops}}{1\\text{ mL}}\\\\\\frac{x\\text{ min}}{1800\\text{ mL}}&=\\frac{15\\text{ min}}{20\\text{ mL}}\\\\x&=1800\\times\\frac{15}{20}=1350\\end{align*}$$\nThe delivery time is $1350\\text{ min}=22\\text{ h }30\\text{ min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
