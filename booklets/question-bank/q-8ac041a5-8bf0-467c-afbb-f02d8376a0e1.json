  "content": {
    "id": "p8-formulas-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Rewrite each formula so that the pronumeral shown in the box is the subject.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-formulas-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\pi ab\\qquad\\boxed{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{A}{\\pi b}$",
          "worked": "$$\\begin{align*}A&=\\pi ab\\\\\\frac{A}{\\pi b}&=a\\end{align*}$$\nTherefore, $a=\\dfrac{A}{\\pi b}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-formulas-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\pi r(r+\\ell)\\qquad\\boxed{\\ell}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ell=\\dfrac{A-\\pi r^2}{\\pi r}$",
          "worked": "$$\\begin{align*}A&=\\pi r(r+\\ell)\\\\\\frac{A}{\\pi r}&=r+\\ell\\\\\\frac{A}{\\pi r}-r&=\\ell\\end{align*}$$\nTherefore, $\\ell=\\dfrac{A-\\pi r^2}{\\pi r}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-formulas-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$S=\\dfrac{n(a-1)}{2}\\qquad\\boxed{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{2S+n}{n}$",
          "worked": "$$\\begin{align*}S&=\\frac{n(a-1)}{2}\\\\2S&=n(a-1)\\\\\\frac{2S}{n}&=a-1\\\\\\frac{2S}{n}+1&=a\\end{align*}$$\nTherefore, $a=\\dfrac{2S+n}{n}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-formulas-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\ell=a+(n-1)d\\qquad\\boxed{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac{\\ell+d-a}{d}$",
          "worked": "$$\\begin{align*}\\ell&=a+(n-1)d\\\\\\ell-a&=(n-1)d\\\\\\frac{\\ell-a}{d}&=n-1\\\\\\frac{\\ell-a}{d}+1&=n\\end{align*}$$\nTherefore, $n=\\dfrac{\\ell+d-a}{d}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-formulas-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$v=at+bt\\qquad\\boxed{t}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\dfrac{v}{a+b}$",
          "worked": "$$\\begin{align*}v&=at+bt\\\\v&=(a+b)t\\\\\\frac{v}{a+b}&=t\\end{align*}$$\nTherefore, $t=\\dfrac{v}{a+b}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-formulas-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$ap=b^2-bp\\qquad\\boxed{p}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\dfrac{b^2}{a+b}$",
          "worked": "$$\\begin{align*}ap&=b^2-bp\\\\ap+bp&=b^2\\\\(a+b)p&=b^2\\\\p&=\\frac{b^2}{a+b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-formulas-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{1}{a}=\\dfrac{1}{b}+\\dfrac{1}{c}\\qquad\\boxed{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\dfrac{ac}{c-a}$",
          "worked": "$$\\begin{align*}\\frac{1}{a}&=\\frac{1}{b}+\\frac{1}{c}\\\\\\frac{1}{a}-\\frac{1}{c}&=\\frac{1}{b}\\\\\\frac{c-a}{ac}&=\\frac{1}{b}\\\\b(c-a)&=ac\\\\b&=\\frac{ac}{c-a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-formulas-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$a=\\dfrac{h}{R-r}\\qquad\\boxed{r}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=R-\\dfrac{h}{a}$",
          "worked": "$$\\begin{align*}a&=\\frac{h}{R-r}\\\\a(R-r)&=h\\\\R-r&=\\frac{h}{a}\\\\R-\\frac{h}{a}&=r\\end{align*}$$\nTherefore, $r=R-\\dfrac{h}{a}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-formulas-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$T=2\\pi\\sqrt{\\dfrac{\\ell}{g}}\\qquad\\boxed{\\ell}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ell=\\dfrac{gT^2}{4\\pi^2}$",
          "worked": "$$\\begin{align*}T&=2\\pi\\sqrt{\\frac{\\ell}{g}}\\\\\\frac{T}{2\\pi}&=\\sqrt{\\frac{\\ell}{g}}\\\\\\frac{T^2}{4\\pi^2}&=\\frac{\\ell}{g}\\\\\\frac{gT^2}{4\\pi^2}&=\\ell\\end{align*}$$\nTherefore, $\\ell=\\dfrac{gT^2}{4\\pi^2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-formulas-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$m=\\dfrac{3x}{may^2}\\qquad\\boxed{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\pm\\sqrt{\\dfrac{3x}{m^2a}}$",
          "worked": "$$\\begin{align*}m&=\\frac{3x}{may^2}\\\\m^2ay^2&=3x\\\\y^2&=\\frac{3x}{m^2a}\\\\y&=\\pm\\sqrt{\\frac{3x}{m^2a}}\\end{align*}$$\nBoth square roots are required because no positive-value restriction is stated.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
