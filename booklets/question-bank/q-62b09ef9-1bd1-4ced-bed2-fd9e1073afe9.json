  "content": {
    "id": "p4-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the equations of the circles that match each of the following descriptions:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "A circle has centre $(0,0)$ and passes through the point $(3,4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=5^2$",
          "worked": "$$\\begin{align*}r&=\\sqrt{(3-0)^2+(4-0)^2}\\\\r&=\\sqrt{25}\\\\r&=5.\\end{align*}$$\nHence $x^2+y^2=25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "A circle has centre $(0,0)$ and passes through the point $(1,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=2$",
          "worked": "$$\\begin{align*}r&=\\sqrt{(1-0)^2+(1-0)^2}\\\\r&=\\sqrt{2}.\\end{align*}$$\nHence $x^2+y^2=(\\sqrt{2})^2=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "A circle has centre $(0,0)$ and passes through the point $(\\sqrt{2},\\sqrt{2})$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=2^2$",
          "worked": "$$\\begin{align*}r&=\\sqrt{(\\sqrt{2}-0)^2+(\\sqrt{2}-0)^2}\\\\r&=\\sqrt{2+2}\\\\r&=2.\\end{align*}$$\nHence $x^2+y^2=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "A circle has centre $(0,4)$ and passes through the point $(3,0)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+(y-4)^2=5^2$",
          "worked": "$$\\begin{align*}r&=\\sqrt{(3-0)^2+(0-4)^2}\\\\r&=\\sqrt{25}\\\\r&=5.\\end{align*}$$\nHence $x^2+(y-4)^2=25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "A circle has centre $(2,3)$ and passes through the point $(-1,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2+(y-3)^2=13$",
          "worked": "$$\\begin{align*}r&=\\sqrt{(-1-2)^2+(1-3)^2}\\\\r&=\\sqrt{9+4}\\\\r&=\\sqrt{13}.\\end{align*}$$\nHence $(x-2)^2+(y-3)^2=13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
