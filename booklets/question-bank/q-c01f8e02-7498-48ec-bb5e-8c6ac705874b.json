  "content": {
    "id": "p33-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Eight people are chosen from a group of 12 people.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can this be done?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle \\binom{12}{8}=495$ ways.",
          "worked": "Order does not matter, so choose eight of the twelve people.\n$$\\begin{align*}\\binom{12}{8}&=\\frac{12!}{8!\\,4!}\\\\\\binom{12}{8}&=495.\\end{align*}$$\nThere are $495$ ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose that Mary is one of the 12 people in the group. How many ways are there of choosing eight people that do not include Mary?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle \\binom{11}{8}=165$ ways.",
          "worked": "Excluding Mary leaves eleven people from whom to choose eight.\n$$\\begin{align*}\\binom{11}{8}&=\\frac{11!}{8!\\,3!}\\\\\\binom{11}{8}&=165.\\end{align*}$$\nThere are $165$ ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Suppose that Mary is chosen. How many ways are there of choosing the other seven people?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle \\binom{11}{7}=330$ ways.",
          "worked": "Mary is already chosen, so choose seven more people from the remaining eleven.\n$$\\begin{align*}\\binom{11}{7}&=\\frac{11!}{7!\\,4!}\\\\\\binom{11}{7}&=330.\\end{align*}$$\nThere are $330$ ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence, write down a binomial identity from the above process.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle \\binom{12}{8}=\\binom{11}{7}+\\binom{11}{8}$.\n\nAdd the counts with Mary and without Mary.",
          "worked": "Every selection either includes Mary or excludes Mary. These cases are disjoint and cover all selections, so\n$$\\begin{align*}\\binom{12}{8}&=\\binom{11}{7}+\\binom{11}{8}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
