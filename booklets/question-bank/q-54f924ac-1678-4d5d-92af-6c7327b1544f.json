  "content": {
    "id": "p9-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "For the quadratic equation $ax^2-4x+3=0$, where $a\\ne0$, find the values of $a$ for which the equation has:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "one solution",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac43$",
          "worked": "One real solution requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=(-4)^2-4(a)(3)\\\\\\Delta&=16-12a\\\\16-12a&=0\\\\a&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p9-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "two solutions",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a<\\dfrac43$, with $a\\ne0$.",
          "worked": "Two distinct real solutions require $\\Delta>0$.\n$$\\begin{align*}\\Delta&=(-4)^2-4(a)(3)\\\\\\Delta&=16-12a\\\\16-12a&>0\\\\16&>12a\\\\a&<\\frac43\\end{align*}$$\nAlso $a\\ne0$, since the equation is quadratic.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "no solutions",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a>\\dfrac43$",
          "worked": "No real solutions requires $\\Delta<0$.\n$$\\begin{align*}\\Delta&=(-4)^2-4(a)(3)\\\\\\Delta&=16-12a\\\\16-12a&<0\\\\16&<12a\\\\a&>\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
