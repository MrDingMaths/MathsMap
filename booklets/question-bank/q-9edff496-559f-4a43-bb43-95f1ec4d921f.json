        "id": "v2-c10bb-p19-practice-slot-1-slot-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Let $f(x)=5-2x^3$. Solve the equation $f^{-1}(x)=-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$",
          "worked": "$$\\begin{align*}f(f^{-1}(x))&=f(-1)\\\\x&=f(-1)\\\\x&=5-2(-1)^3\\\\x&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-c10bb-p19-practice-slot-1-slot-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $g(x)=\\dfrac{3x}{x-1}$. Solve the equation $g^{-1}(x)=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{9}{2}$",
          "worked": "$$\\begin{align*}g(g^{-1}(x))&=g(3)\\\\x&=g(3)\\\\x&=\\frac{3(3)}{3-1}\\\\x&=\\frac{9}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
