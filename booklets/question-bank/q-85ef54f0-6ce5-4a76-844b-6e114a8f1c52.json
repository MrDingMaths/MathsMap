                {
                  "type": "math",
                  "latex": "(A'\\cup B'\\cup C')'",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cap B\\cap C$",
          "worked": "An element outside the union of the three complements belongs to all three original sets.\n$$\\begin{align*}(A'\\cup B'\\cup C')'&=A''\\cap B''\\cap C''\\\\(A'\\cup B'\\cup C')'&=A\\cap B\\cap C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
