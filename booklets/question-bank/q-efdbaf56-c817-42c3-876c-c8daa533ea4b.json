  "content": {
    "id": "p53-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Which of the following pairs of transformations commute?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q4-a-node",
        "type": "part",
        "label": "a",
        "prompt": "reflection in the $y$-axis and horizontal translation",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Do not commute.",
          "worked": "Both act horizontally. Reflecting reverses the direction of a translation, so changing the order changes the image.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p53-q4-b-node",
        "type": "part",
        "label": "b",
        "prompt": "vertical dilation and vertical translation",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Do not commute.",
          "worked": "Both act vertically. Translating first scales the translation distance when the dilation is applied; translating afterwards does not.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p53-q4-c-node",
        "type": "part",
        "label": "c",
        "prompt": "vertical dilation and reflection in the $x$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Commute.",
          "worked": "Reflection in the $x$-axis is a vertical dilation of factor $-1$. Two dilations commute, since their factors multiply to the same result in either order.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p53-q4-d-node",
        "type": "part",
        "label": "d",
        "prompt": "horizontal translation and vertical translation",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Commute.",
          "worked": "One changes only the $x$-coordinate and the other changes only the $y$-coordinate. These changes are independent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p53-q4-e-node",
        "type": "part",
        "label": "e",
        "prompt": "horizontal dilation and horizontal translation",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Do not commute.",
          "worked": "Both act horizontally. Translating first scales the translation distance when the dilation is applied; translating afterwards does not.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p53-q4-f-node",
        "type": "part",
        "label": "f",
        "prompt": "reflection in the $x$-axis and horizontal translation",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Commute.",
          "worked": "Reflection in the $x$-axis changes only the $y$-coordinate; horizontal translation changes only the $x$-coordinate. These changes are independent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
