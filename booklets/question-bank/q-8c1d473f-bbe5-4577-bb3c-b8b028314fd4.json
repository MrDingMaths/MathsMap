    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the number of ways couple $A$ can sit together, i.e. $|A|$. Hence, also find $|B|$ and $|C|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|A|=|B|=|C|=2!\\times5!=240$.",
          "worked": "Treat couple $A$ as one element. There are five elements to arrange and $2!$ orders within the couple.\n$$\\begin{align*}|A|&=2!\\times5!\\\\|A|&=240\\end{align*}$$\nThe same count applies to either other couple, so $|B|=|C|=240$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the number of ways couple $A$ can sit together, and couple $B$ also sit together, i.e. $|A\\cap B|$. Hence, also find $|A\\cap C|$ and $|B\\cap C|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|A\\cap B|=|A\\cap C|=|B\\cap C|=2!\\times2!\\times4!=96$.",
          "worked": "Treat each of couples $A$ and $B$ as one element. Arrange the four elements, allowing $2!$ orders within each couple.\n$$\\begin{align*}|A\\cap B|&=2!\\times2!\\times4!\\\\|A\\cap B|&=96\\end{align*}$$\nThe same count applies to either other pair of couples, so $|A\\cap C|=|B\\cap C|=96$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q26-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the number of ways all three couples sit together, i.e. $|A\\cap B\\cap C|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|A\\cap B\\cap C|=2!\\times2!\\times2!\\times3!=48$.",
          "worked": "Arrange the three couple blocks, allowing $2!$ orders within each block.\n$$\\begin{align*}|A\\cap B\\cap C|&=2!\\times2!\\times2!\\times3!\\\\|A\\cap B\\cap C|&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q26-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the number of ways at least one of the couples sit together, i.e. $|A\\cup B\\cup C|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|A\\cup B\\cup C|=480$.\n\nAdd the three single counts, subtract the three pairwise counts, then add the triple count.",
          "worked": "By the supplied inclusion-exclusion formula,\n$$\\begin{align*}|A\\cup B\\cup C|&=3\\times240-3\\times96+48\\\\|A\\cup B\\cup C|&=480.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q26-e",
        "type": "part",
        "label": "e",
        "prompt": "Hence, find the number of ways none of the couples sit together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6!-480=240$ ways.\n\nSubtract arrangements with at least one couple together from all arrangements.",
          "worked": "There are $6!$ unrestricted arrangements. Subtract those with at least one couple together.\n$$\\begin{align*}N&=6!-480\\\\N&=240.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
