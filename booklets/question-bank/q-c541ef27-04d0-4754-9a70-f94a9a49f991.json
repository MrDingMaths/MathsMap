  "content": {
    "id": "p10-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Nick works out that there are 168 hours in each week. He spends $37.5\\%$ of this time sleeping, $20\\%$ at school, $2\\%$ at his part-time job and $5\\%$ doing homework. The rest of his time is leisure time.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How many hours each week does Nick work at his part-time job?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3.36 hours",
          "worked": "$$\\begin{align*}\\text{Hours at his part-time job}&=\\frac{2}{100}\\times168\\\\\\text{Hours at his part-time job}&=3.36\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How many hours homework does he do each week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8.4 hours",
          "worked": "$$\\begin{align*}\\text{Hours doing homework}&=\\frac{5}{100}\\times168\\\\\\text{Hours doing homework}&=8.4\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "What percentage of his week does Nick have as leisure time?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35.5\\%$",
          "worked": "$$\\begin{align*}\\text{Leisure percentage}&=100\\%-(37.5\\%+20\\%+2\\%+5\\%)\\\\\\text{Leisure percentage}&=100\\%-64.5\\%\\\\\\text{Leisure percentage}&=35.5\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
