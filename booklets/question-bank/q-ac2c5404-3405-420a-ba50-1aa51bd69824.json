  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "If $\\sin x=\\frac34$ and $\\frac\\pi2<x<\\pi$, find the exact value of $\\sin 2x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\frac{3\\sqrt7}{8}$",
      "worked": "By drawing a right-angled triangle in quadrant II, $\\cos x=-\\frac{\\sqrt7}{4}$.\n$$\\begin{aligned}\\sin 2x&=2\\sin x\\cos x\\\\&=2\\left(\\frac34\\right)\\left(-\\frac{\\sqrt7}{4}\\right)\\\\&=-\\frac{3\\sqrt7}{8}.\\end{aligned}$$",
      "solutionDiagrams": []
    },
