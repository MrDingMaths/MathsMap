  "content": {
    "id": "p25-q2",
    "type": "question",
    "label": "2",
    "prompt": "A waterfall flows at $2\\ \\text{m s}^{-1}$ over a vertical $5$ m cliff. How far out from the cliff does it fall?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2$ m",
      "worked": "Take the top of the cliff as the origin, with upward positive.\n$$x=2t,\\qquad y=-5t^2.$$\nAt the bottom, $y=-5$:\n$$\\begin{align*}-5t^2&=-5\\\\t_{\\text{flight}}&=1\\ \\text{s}.\\end{align*}$$\n$$\\begin{align*}\\text{Range}&=x(1)\\\\&=2(1)\\\\&=2\\ \\text{m}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
