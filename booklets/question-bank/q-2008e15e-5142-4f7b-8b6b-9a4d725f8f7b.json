    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.4$",
      "worked": "The events are mutually exclusive, so their probabilities add.\n$$\\begin{align*}P(\\text{none})&=1-\\bigl(P(A)+P(B)+P(C)\\bigr)\\\\P(\\text{none})&=1-(0.1+0.2+0.3)\\\\P(\\text{none})&=0.4.\\end{align*}$$",
      "solutionDiagrams": []
    },
