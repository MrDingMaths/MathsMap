            {
              "type": "text",
              "text": "Given three mutually exclusive events ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "A",
              "display": false
            },
            {
              "type": "text",
              "text": ", ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "B",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "C",
              "display": false
            },
            {
              "type": "text",
              "text": " such that ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "P(A)=0.1",
              "display": false
            },
            {
              "type": "text",
              "text": ", ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "P(B)=0.2",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "P(C)=0.3",
              "display": false
            },
            {
              "type": "text",
              "text": ", find the probability that none of them occur.",
              "marks": []
            }
          ]
        }
