                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Divide the total distance by the total time.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\text{Total time}&=25+15\\\\\\text{Total time}&=40\\text{ min}=\\frac{2}{3}\\text{ h}\\\\\\text{Average speed}&=\\frac{\\text{total distance}}{\\text{total time}}\\\\\\text{Average speed}&=20\\div\\frac{2}{3}\\\\\\text{Average speed}&=30\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
