  "content": {
    "id": "p39-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Lucas took 25 minutes to walk 2.5 km and then 15 minutes to travel 17.5 km by train.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the total distance Lucas travelled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Total distance}&=2.5+17.5\\\\\\text{Total distance}&=20\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "What was his average speed when he was walking?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{Walking time}&=\\frac{25}{60}\\text{ h}\\\\\\text{Average walking speed}&=\\frac{2.5}{25/60}\\\\\\text{Average walking speed}&=2.5\\times\\frac{60}{25}\\\\\\text{Average walking speed}&=6\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p39-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "What was his average speed on the train trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\text{Train time}&=\\frac{15}{60}\\text{ h}\\\\\\text{Average train speed}&=\\frac{17.5}{15/60}\\\\\\text{Average train speed}&=17.5\\times4\\\\\\text{Average train speed}&=70\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p39-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "What was his average speed for the entire trip?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q11-d-short-result",
                "type": "paragraph",
