      {
        "id": "p32-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "Complete each of these subtractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p32-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\frac{1}{2}-\\frac{1}{3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{6}$",
              "worked": "$$\\begin{align*}\\frac{1}{2}-\\frac{1}{3}&=\\frac{3}{6}-\\frac{2}{6}\\\\\\frac{1}{2}-\\frac{1}{3}&=\\frac{1}{6}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p32-q4-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\frac{1}{4}-\\frac{1}{5}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{20}$",
              "worked": "$$\\begin{align*}\\frac{1}{4}-\\frac{1}{5}&=\\frac{5}{20}-\\frac{4}{20}\\\\\\frac{1}{4}-\\frac{1}{5}&=\\frac{1}{20}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p32-q4-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\frac{1}{7}-\\frac{1}{8}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{56}$",
              "worked": "$$\\begin{align*}\\frac{1}{7}-\\frac{1}{8}&=\\frac{8}{56}-\\frac{7}{56}\\\\\\frac{1}{7}-\\frac{1}{8}&=\\frac{1}{56}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p32-q4-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$\\frac{1}{9}-\\frac{1}{10}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{90}$",
              "worked": "$$\\begin{align*}\\frac{1}{9}-\\frac{1}{10}&=\\frac{10}{90}-\\frac{9}{90}\\\\\\frac{1}{9}-\\frac{1}{10}&=\\frac{1}{90}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p32-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "State a rule for subtracting consecutive unit fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Subtract the smaller consecutive unit fraction from the larger: the result is a unit fraction whose denominator is the product of their denominators.",
          "worked": "The examples give $\\frac{1}{2\\times3}$, $\\frac{1}{4\\times5}$, $\\frac{1}{7\\times8}$ and $\\frac{1}{9\\times10}$. With a common denominator, the numerators differ by 1. Thus the difference is a unit fraction with denominator equal to the product of the two original denominators.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p32-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Write $\\frac{1}{12}$ as the difference of two consecutive unit fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}-\\frac{1}{4}$\n\nThe consecutive denominators have product $3\\times4=12$.",
          "worked": "The consecutive whole numbers with product 12 are 3 and 4.\n\n$$\\begin{align*}\\frac{1}{3}-\\frac{1}{4}&=\\frac{4}{12}-\\frac{3}{12}\\\\\\frac{1}{3}-\\frac{1}{4}&=\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
