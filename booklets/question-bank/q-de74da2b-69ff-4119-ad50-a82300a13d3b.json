        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.443$",
          "worked": "$$\\begin{align*}\\int_0^1 2^x\\,dx&=\\left[\\frac{2^x}{\\ln 2}\\right]_0^1\\\\\\int_0^1 2^x\\,dx&=\\frac{2-1}{\\ln 2}\\\\\\int_0^1 2^x\\,dx&\\approx1.443\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
