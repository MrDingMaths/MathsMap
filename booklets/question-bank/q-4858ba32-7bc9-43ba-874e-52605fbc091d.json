        "id": "p9-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "The first term of a GP is $a=25$ and the fourth term is $a_4=200$.\n\nUse the formula $a_n=ar^{n-1}$ to find the common ratio $r$, then write down the first five terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=2$; first five terms: $25,50,100,200,400$.",
          "worked": "$$\\begin{align*}a_4&=ar^3\\\\200&=25r^3\\\\r^3&=8\\\\r&=2\\end{align*}$$\nFirst five terms: $25,50,100,200,400$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the common ratio $r$ of a GP for which:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q10-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$a=3,\\quad a_6=96$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=2$.",
              "worked": "$$\\begin{align*}a_6&=ar^5\\\\96&=3r^5\\\\r^5&=32\\\\r&=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p9-q10-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$a=1000,\\quad a_7=0.001$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=\\pm0.1$.",
