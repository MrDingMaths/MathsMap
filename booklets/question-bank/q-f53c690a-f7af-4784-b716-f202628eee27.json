  "content": {
    "id": "p44-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Consider the curve $y=x^2-5x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the point on the curve where the gradient is 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,-6)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x-5\\\\2x-5&=1\\\\x&=3\\\\y&=3^2-5(3)\\\\y&=-6\\end{align*}$$\n\nThe point is $(3,-6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p44-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the equation of the tangent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-9$",
          "worked": "The tangent has gradient $1$ and passes through $(3,-6)$.\n\n$$\\begin{align*}y-(-6)&=1(x-3)\\\\y+6&=x-3\\\\y&=x-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
