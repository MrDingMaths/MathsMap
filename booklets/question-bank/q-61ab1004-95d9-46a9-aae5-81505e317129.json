  "content": {
    "id": "v2-a6b7a-p46-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "A landscaper mixes 36 kg of compost, 54 kg of sand and 30 kg of loam to make garden soil.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a6b7a-p46-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage of the mix is compost?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\%$",
          "worked": "$$\\begin{align*}\\text{Total mass}&=36+54+30\\\\&=120\\text{ kg}\\\\\\text{Percentage of compost}&=\\frac{36}{120}\\times100\\\\&=30\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-a6b7a-p46-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Another 30 kg of loam is added to the mix. What percentage of the mix is now loam?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40\\%$",
          "worked": "$$\\begin{align*}\\text{Loam}&=30+30=60\\text{ kg}\\\\\\text{Total mass}&=120+30=150\\text{ kg}\\\\\\text{Percentage of loam}&=\\frac{60}{150}\\times100\\\\&=40\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-a6b7a-p46-practice-slot-5-slot-5-q-c",
        "type": "part",
        "label": "c",
        "prompt": "What percentage of the mix is now sand?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage of sand}&=\\frac{54}{150}\\times100\\\\&=36\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "v2-a6b7a-p46-practice-slot-5-slot-5-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Sand was $45\\%$ of the original mix. Explain why the percentage of sand has decreased even though no sand was removed.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The amount of sand stayed at 54 kg but the total mass increased from 120 kg to 150 kg, so sand is a smaller fraction of the total.",
          "worked": "$$\\begin{align*}\\text{Original}&:\\frac{54}{120}\\times100\\%=45\\%\\\\\\text{Now}&:\\frac{54}{150}\\times100\\%=36\\%\\end{align*}$$\nThe numerator stayed the same but the denominator (the total) increased, so the percentage decreased.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
