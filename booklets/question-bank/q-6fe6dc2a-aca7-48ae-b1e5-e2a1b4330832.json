  "content": {
    "id": "p47-q11-response",
    "type": "question",
    "label": "11",
    "prompt": "There are 3 yellow and 5 white counters in a bag.\nThree are picked at random. Counters are not replaced after each pick.\nWhat is the probability of picking three of the same colour?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{11}{56}$",
      "worked": "Let $Y$ denote yellow and $W$ denote white. Multiply along each same-colour path, then add the probabilities.\n$$\\begin{align*}P(YYY)&=\\frac{3}{8}\\times\\frac{2}{7}\\times\\frac{1}{6}=\\frac{6}{336}\\\\P(WWW)&=\\frac{5}{8}\\times\\frac{4}{7}\\times\\frac{3}{6}=\\frac{60}{336}\\\\P(\\text{three of the same colour})&=\\frac{6}{336}+\\frac{60}{336}\\\\&=\\frac{66}{336}=\\frac{11}{56}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
