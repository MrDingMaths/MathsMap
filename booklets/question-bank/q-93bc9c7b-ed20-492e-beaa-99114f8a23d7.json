        "label": "a",
        "prompt": "$\\frac{z^3}{z^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z$",
          "worked": "$$\\begin{align*}\\frac{z^3}{z^2}&=\\frac{z\\times z\\times z}{z\\times z}\\\\\\frac{z^3}{z^2}&=z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3x^2y}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^2$",
          "worked": "$$\\begin{align*}\\frac{3x^2y}{y}&=\\frac{3x^2\\times y}{y}\\\\\\frac{3x^2y}{y}&=3x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{5m^3n^3}{m^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5mn^3$",
          "worked": "Cancel the two common factors of $m$.\n\n$$\\begin{align*}\\frac{5m^3n^3}{m^2}&=\\frac{5m\\times m^2n^3}{m^2}\\\\\\frac{5m^3n^3}{m^2}&=5mn^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{xyzw}{yzwx}$",
