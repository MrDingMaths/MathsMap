        "label": "a",
        "prompt": "$$\\begin{aligned}x-y&=2\\\\3x+y&=14\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4,\\ y=2$",
          "worked": "Adding the equations:\n$$\\begin{align*}(x-y)+(3x+y)&=2+14\\\\4x&=16\\\\x&=4\\end{align*}$$\nSubstituting $x=4$ into the first equation:\n$$\\begin{align*}4-y&=2\\\\-y&=-2\\\\y&=2\\end{align*}$$\nCheck: $4-2=2$ and $3(4)+2=14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p11-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}2x-3y&=3\\\\x+3y&=6\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=1$",
          "worked": "Adding the equations:\n$$\\begin{align*}(2x-3y)+(x+3y)&=3+6\\\\3x&=9\\\\x&=3\\end{align*}$$\nSubstituting $x=3$ into the second equation:\n$$\\begin{align*}3+3y&=6\\\\3y&=3\\\\y&=1\\end{align*}$$\nCheck: $2(3)-3(1)=3$ and $3+3(1)=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p11-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}3x+y&=4\\\\-3x+2y&=-10\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=-2$",
          "worked": "Adding the equations:\n$$\\begin{align*}(3x+y)+(-3x+2y)&=4-10\\\\3y&=-6\\\\y&=-2\\end{align*}$$\nSubstituting $y=-2$ into the first equation:\n$$\\begin{align*}3x-2&=4\\\\3x&=6\\\\x&=2\\end{align*}$$\nCheck: $3(2)-2=4$ and $-3(2)+2(-2)=-10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p11-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}2x-y&=1\\\\5x+y&=13\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=3$",
          "worked": "Adding the equations:\n$$\\begin{align*}(2x-y)+(5x+y)&=1+13\\\\7x&=14\\\\x&=2\\end{align*}$$\nSubstituting $x=2$ into the second equation:\n$$\\begin{align*}10+y&=13\\\\y&=3\\end{align*}$$\nCheck: $2(2)-3=1$ and $5(2)+3=13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p11-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}3x+2y&=14\\\\4x-2y&=14\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4,\\ y=1$",
          "worked": "Adding the equations:\n$$\\begin{align*}(3x+2y)+(4x-2y)&=14+14\\\\7x&=28\\\\x&=4\\end{align*}$$\nSubstituting $x=4$ into the first equation:\n$$\\begin{align*}12+2y&=14\\\\2y&=2\\\\y&=1\\end{align*}$$\nCheck: $3(4)+2(1)=14$ and $4(4)-2(1)=14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p11-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}-x-y&=3\\\\x+5y&=-11\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ y=-2$",
          "worked": "Adding the equations:\n$$\\begin{align*}(-x-y)+(x+5y)&=3-11\\\\4y&=-8\\\\y&=-2\\end{align*}$$\nSubstituting $y=-2$ into the second equation:\n$$\\begin{align*}x+5(-2)&=-11\\\\x-10&=-11\\\\x&=-1\\end{align*}$$\nCheck: $-(-1)-(-2)=3$ and $-1+5(-2)=-11$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
