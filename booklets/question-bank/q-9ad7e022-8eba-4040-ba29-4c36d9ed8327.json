    "label": null,
    "prompt": "Evaluate $\\left(\\sin\\frac{5\\pi}{12}+\\cos\\frac{5\\pi}{12}\\right)^2$ without a calculator.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac32$.",
      "worked": "$$\\begin{align*}\\left(\\sin\\frac{5\\pi}{12}+\\cos\\frac{5\\pi}{12}\\right)^2&=\\sin^2\\frac{5\\pi}{12}+\\cos^2\\frac{5\\pi}{12}+2\\sin\\frac{5\\pi}{12}\\cos\\frac{5\\pi}{12}\\\\\\left(\\sin\\frac{5\\pi}{12}+\\cos\\frac{5\\pi}{12}\\right)^2&=1+\\sin\\frac{5\\pi}{6}\\\\\\left(\\sin\\frac{5\\pi}{12}+\\cos\\frac{5\\pi}{12}\\right)^2&=1+\\frac12\\\\\\left(\\sin\\frac{5\\pi}{12}+\\cos\\frac{5\\pi}{12}\\right)^2&=\\frac32.\\end{align*}$$",
      "solutionDiagrams": []
    },
