  "content": {
    "id": "p4-q10",
    "type": "question",
    "label": "10",
    "prompt": "Find $f(k)-f(k-1)$ in simplest form if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2k-1$",
          "worked": "$$\\begin{align*}f(k)-f(k-1)&=k^2-(k-1)^2\\\\f(k)-f(k-1)&=k^2-(k^2-2k+1)\\\\f(k)-f(k-1)&=2k-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p4-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=3x^2+2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6k-1$",
          "worked": "$$\\begin{align*}f(k)-f(k-1)&=3k^2+2k-[3(k-1)^2+2(k-1)]\\\\f(k)-f(k-1)&=3k^2+2k-[3k^2-6k+3+2k-2]\\\\f(k)-f(k-1)&=3k^2+2k-(3k^2-4k+1)\\\\f(k)-f(k-1)&=6k-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\frac1x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac1{k(k-1)}$, for $k\\ne0,1$.",
          "worked": "For $k\\ne0,1$,\n$$\\begin{align*}f(k)-f(k-1)&=\\frac1k-\\frac1{k-1}\\\\f(k)-f(k-1)&=\\frac{(k-1)-k}{k(k-1)}\\\\f(k)-f(k-1)&=-\\frac1{k(k-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p4-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=2^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{k-1}$",
          "worked": "$$\\begin{align*}f(k)-f(k-1)&=2^k-2^{k-1}\\\\f(k)-f(k-1)&=2^{k-1}(2-1)\\\\f(k)-f(k-1)&=2^{k-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
