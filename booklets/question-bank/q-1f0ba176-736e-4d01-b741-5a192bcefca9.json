  "content": {
    "id": "p6-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The numbers on a roulette wheel go from 0 to 36. The wheel is spun. What is the probability that when it stops it will be pointing to:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "an even number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19}{37}$",
          "worked": "There are 37 equally likely outcomes. The even numbers are $0,2,4,\\ldots,36$, giving 19 favourable outcomes; zero is even.\n\n$$P(\\text{even number})=\\frac{19}{37}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "an odd number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{18}{37}$",
          "worked": "The odd numbers are $1,3,5,\\ldots,35$, giving 18 favourable outcomes out of 37 equally likely outcomes.\n\n$$P(\\text{odd number})=\\frac{18}{37}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "a number less than 10, excluding zero?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{37}$",
          "worked": "The favourable outcomes are $1,2,3,4,5,6,7,8,9$. There are 9 favourable outcomes out of 37 equally likely outcomes.\n\n$$P(\\text{less than 10, excluding zero})=\\frac{9}{37}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
