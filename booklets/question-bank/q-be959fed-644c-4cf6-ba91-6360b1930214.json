  "content": {
    "id": "p3-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Can 220 be written as the product of two numbers $a$ and $b$, where half of the factors of $a$ are odd, and half of the factors of $b$ are odd?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p3-q11-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Yes: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=10,\\quad b=22",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p3-q11-short-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Each number has four positive factors, exactly two of which are odd.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}220&=2^2\\times5\\times11\\\\220&=(2\\times5)(2\\times11)\\\\220&=10\\times22\\end{align*}$$\nThe positive factors of $10$ are $1,2,5,10$; two of these are odd.\n\nThe positive factors of $22$ are $1,2,11,22$; two of these are odd.\n\nTherefore, $a=10$ and $b=22$ satisfy both conditions.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
