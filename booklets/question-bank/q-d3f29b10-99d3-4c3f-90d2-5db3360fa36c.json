  "content": {
    "id": "p18-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find pairs of numbers that satisfy the following conditions:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q5a",
        "type": "part",
        "label": "a",
        "prompt": "Their product is $6$, and their sum is $\\frac{11}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$ and $\\frac32$.",
          "worked": "Let one number be $x$. The other is $\\frac{11}{2}-x$.\n$$\\begin{align*}x\\left(\\frac{11}{2}-x\\right)&=6\\\\2x^2-11x+12&=0\\\\x&=\\frac{11\\pm\\sqrt{(-11)^2-4(2)(12)}}{2(2)}\\\\x&=\\frac{11\\pm5}{4}\\\\x&=4\\text{ or }\\frac32\\end{align*}$$\nThe pair is $4$ and $\\frac32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p18-q5b",
        "type": "part",
        "label": "b",
        "prompt": "Their sum is $\\frac32$, and the sum of their reciprocals is $\\frac{27}{10}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$ and $\\frac56$.",
          "worked": "Let the numbers be $x$ and $y$, where $x,y\\ne0$.\n$$\\begin{align*}x+y&=\\frac32\\\\\\frac1x+\\frac1y&=\\frac{27}{10}\\\\\\frac{x+y}{xy}&=\\frac{27}{10}\\\\xy&=\\frac32\\times\\frac{10}{27}=\\frac59\\end{align*}$$\nSince $y=\\frac32-x$,\n$$\\begin{align*}x\\left(\\frac32-x\\right)&=\\frac59\\\\18x^2-27x+10&=0\\\\x&=\\frac{27\\pm\\sqrt{(-27)^2-4(18)(10)}}{2(18)}\\\\x&=\\frac{27\\pm3}{36}\\\\x&=\\frac23\\text{ or }\\frac56\\end{align*}$$\nThe pair is $\\frac23$ and $\\frac56$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 118
      }
    ]
  },
