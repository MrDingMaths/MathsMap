    "children": [
      {
        "id": "p21-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Dakota travels 7 km in 3 h. How far does she go in 4 h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{28}{3}\\text{ km}$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{7}{3}\\text{ km/h}\\\\d&=st\\\\d&=\\frac{7}{3}\\times4\\\\d&=\\frac{28}{3}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p21-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Eric travels 17 km in 2 h. How long will it take for him to travel 12 km?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{24}{17}\\text{ h}$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{17}{2}\\text{ km/h}\\\\t&=\\frac{d}{s}\\\\t&=12\\div\\frac{17}{2}\\\\t&=\\frac{24}{17}\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p21-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Ava travels $\\dfrac{1}{3}$ km in $\\dfrac{1}{4}$ h. How far does she go in $\\dfrac{2}{3}$ h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8}{9}\\text{ km}$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{1}{3}\\div\\frac{1}{4}\\\\s&=\\frac{4}{3}\\text{ km/h}\\\\d&=st\\\\d&=\\frac{4}{3}\\times\\frac{2}{3}\\\\d&=\\frac{8}{9}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Pedro travels $\\dfrac{3}{4}$ km in $\\dfrac{1}{3}$ h. How long will it take for him to travel $\\dfrac{4}{5}$ km?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16}{45}\\text{ h}$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{3}{4}\\div\\frac{1}{3}\\\\s&=\\frac{9}{4}\\text{ km/h}\\\\t&=\\frac{d}{s}\\\\t&=\\frac{4}{5}\\div\\frac{9}{4}\\\\t&=\\frac{16}{45}\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
