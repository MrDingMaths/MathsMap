  "content": {
    "id": "p44-q6",
    "type": "question",
    "label": "6",
    "prompt": "At a cinema, a large drink costs $\\$2$ more than an ice cream. Ally buys five drinks and seven ice creams for $\\$70$. Let $d$ be the price of a drink and $c$ be the price of an ice cream.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Write two linear equations to model this information.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=c+2$, $5d+7c=70$.",
          "worked": "$$\\begin{align*}d&=c+2\\quad\\text{(1)}\\\\5d+7c&=70\\quad\\text{(2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p44-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equations simultaneously to find the cost of each item.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ice cream: $\\$5$; drink: $\\$7$.",
          "worked": "Substitute (1) into (2).\n$$\\begin{align*}5(c+2)+7c&=70\\\\12c+10&=70\\\\12c&=60\\\\c&=5\\\\d&=5+2\\\\d&=7\\end{align*}$$\nAn ice cream costs $\\$5$ and a drink costs $\\$7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
