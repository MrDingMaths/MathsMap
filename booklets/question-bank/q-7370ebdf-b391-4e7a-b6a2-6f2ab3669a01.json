  "content": {
    "id": "p45-q61-root",
    "type": "question",
    "label": "61",
    "prompt": "A sculpture consists of a set of poles set in a row, with the tallest pole 2.4 m high, the next pole 2.1, the next one 1.8 and so on, down to the last pole which is 0.6 m high.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q61-a",
        "type": "part",
        "label": "a",
        "prompt": "How many poles are in the sculpture?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "7 poles",
          "worked": "$a=2.4$, $a_n=0.6$, $d=-0.3$.\n$$\\begin{align*}a_n&=a+(n-1)d\\\\0.6&=2.4+(n-1)(-0.3)\\\\0.6&=2.4-0.3n+0.3\\\\0.6&=2.7-0.3n\\\\0.3n&=2.1\\\\n&=7\\end{align*}$$\nThere are 7 poles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p45-q61-b",
        "type": "part",
        "label": "b",
        "prompt": "The poles are made of timber. What length of timber is there altogether in the poles?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10.5\\text{ m}$",
          "worked": "$$\\begin{align*}S_7&=\\frac{7}{2}[2.4+0.6]\\\\S_7&=\\frac{7}{2}(3)\\\\S_7&=10.5\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
