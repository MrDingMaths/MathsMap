    "children": [
      {
        "id": "p4-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$-8x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4(2x+1)$",
          "worked": "The negative HCF is $-4$.\n$$\\begin{aligned}-8x-4&=-4\\left(\\frac{-8x}{-4}+\\frac{-4}{-4}\\right)\\\\&=-4(2x+1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$-4x-2$",
