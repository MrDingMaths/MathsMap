    "type": "question",
    "label": "2",
    "prompt": "What principal will earn $\\$1000$ simple interest at:\n\nGive monetary answers to the nearest cent where necessary.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$4\\%$ p.a. over five years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$5000$",
          "worked": "$$\\begin{align*}I&=PRT\\\\1000&=P\\times0.04\\times5\\\\P&=\\frac{1000}{0.04\\times5}\\\\P&=\\$5000\\end{align*}$$",
