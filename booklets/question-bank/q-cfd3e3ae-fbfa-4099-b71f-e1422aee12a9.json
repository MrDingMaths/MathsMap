        "answer": {
          "short": "$28b^2+45b+18$",
          "worked": "$\\begin{align*}(7b+6)(4b+3)&=7b(4b+3)+6(4b+3)\\\\(7b+6)(4b+3)&=28b^2+21b+24b+18\\\\(7b+6)(4b+3)&=28b^2+45b+18\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(a+2b)(a-2b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
