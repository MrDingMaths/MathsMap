        "answer": {
          "short": "$a^2-4b^2$",
          "worked": "$\\begin{align*}(a+2b)(a-2b)&=a(a-2b)+2b(a-2b)\\\\(a+2b)(a-2b)&=a^2-2ab+2ab-4b^2\\\\(a+2b)(a-2b)&=a^2-4b^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$(m-n)(m-2n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^2-3mn+2n^2$",
          "worked": "$\\begin{align*}(m-n)(m-2n)&=m(m-2n)-n(m-2n)\\\\(m-n)(m-2n)&=m^2-2mn-mn+2n^2\\\\(m-n)(m-2n)&=m^2-3mn+2n^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$(m-n)(m+n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^2-n^2$",
          "worked": "$\\begin{align*}(m-n)(m+n)&=m(m+n)-n(m+n)\\\\(m-n)(m+n)&=m^2+mn-mn-n^2\\\\(m-n)(m+n)&=m^2-n^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$(a+b)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+2ab+b^2$",
          "worked": "$\\begin{align*}(a+b)^2&=(a+b)(a+b)\\\\(a+b)^2&=a(a+b)+b(a+b)\\\\(a+b)^2&=a^2+ab+ab+b^2\\\\(a+b)^2&=a^2+2ab+b^2\\end{align*}$",
