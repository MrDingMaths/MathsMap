  "content": {
    "id": "p69-q1-response",
    "type": "question",
    "label": "1",
    "prompt": "A hot-air balloon is $700\\text{ m}$ above level ground. The angle of depression from the balloon to a vineyard is $25^\\circ$. Find the horizontal distance from the balloon to the vineyard in metres, correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1501.2\\text{ m}$",
      "worked": "Let $d$ metres be the horizontal distance. The angle of elevation from the vineyard is $25^\\circ$, since the horizontal lines are parallel.\n\n$$\\begin{align*}\\tan25^\\circ&=\\frac{700}{d}\\\\d&=\\frac{700}{\\tan25^\\circ}\\\\d&\\approx1501.2\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
