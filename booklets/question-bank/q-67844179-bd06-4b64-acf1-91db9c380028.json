      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $y=e^x$ is always increasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=e^x>0$ for all real $x$, so the function is always increasing.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=e^x\\end{align*}$$\nSince $e^x>0$ for all real $x$, the gradient is always positive, so $y=e^x$ is always increasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why $y=e^{-x}$ is always decreasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-e^{-x}<0$ for all real $x$, so the function is always decreasing.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=-e^{-x}\\end{align*}$$\nSince $e^{-x}>0$ for all real $x$, the gradient $-e^{-x}$ is always negative, so $y=e^{-x}$ is always decreasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
