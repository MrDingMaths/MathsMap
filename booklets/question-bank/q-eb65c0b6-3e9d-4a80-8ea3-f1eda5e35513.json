  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify each of the following, expressing your answers using positive indices:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$b^{15}\\times b^{-10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^5$",
          "worked": "$\\begin{align*}b^{15}\\times b^{-10}&=b^{15+(-10)}\\\\b^{15}\\times b^{-10}&=b^5\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$c^6\\times c^{-8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{c^2}$",
          "worked": "$\\begin{align*}c^6\\times c^{-8}&=c^{6-8}\\\\c^6\\times c^{-8}&=c^{-2}\\\\c^6\\times c^{-8}&=\\frac1{c^2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$d^{-4}\\times d^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{d^8}$",
          "worked": "$\\begin{align*}d^{-4}\\times d^{-4}&=d^{-4+(-4)}\\\\d^{-4}\\times d^{-4}&=d^{-8}\\\\d^{-4}\\times d^{-4}&=\\frac1{d^8}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{a^3}{a^{-5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^8$",
          "worked": "$\\begin{align*}\\frac{a^3}{a^{-5}}&=a^{3-(-5)}\\\\\\frac{a^3}{a^{-5}}&=a^8\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{b^{-5}}{b^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{b^{11}}$",
          "worked": "$\\begin{align*}\\frac{b^{-5}}{b^6}&=b^{-5-6}\\\\\\frac{b^{-5}}{b^6}&=b^{-11}\\\\\\frac{b^{-5}}{b^6}&=\\frac1{b^{11}}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{c^{-4}}{c^{-4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$\\begin{align*}\\frac{c^{-4}}{c^{-4}}&=c^{-4-(-4)}\\\\\\frac{c^{-4}}{c^{-4}}&=c^0\\\\\\frac{c^{-4}}{c^{-4}}&=1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{x^{-2}y^5}{x^5y^{-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y^8}{x^7}$",
          "worked": "$\\begin{align*}\\frac{x^{-2}y^5}{x^5y^{-3}}&=x^{-2-5}y^{5-(-3)}\\\\\\frac{x^{-2}y^5}{x^5y^{-3}}&=x^{-7}y^8\\\\\\frac{x^{-2}y^5}{x^5y^{-3}}&=\\frac{y^8}{x^7}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p6-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x^{-3}y^{-4}}{x^{-2}y^{-5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac yx$",
          "worked": "$\\begin{align*}\\frac{x^{-3}y^{-4}}{x^{-2}y^{-5}}&=x^{-3-(-2)}y^{-4-(-5)}\\\\\\frac{x^{-3}y^{-4}}{x^{-2}y^{-5}}&=x^{-1}y\\\\\\frac{x^{-3}y^{-4}}{x^{-2}y^{-5}}&=\\frac yx\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p6-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$(n^{-4})^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^{12}$",
          "worked": "$\\begin{align*}(n^{-4})^{-3}&=n^{(-4)(-3)}\\\\(n^{-4})^{-3}&=n^{12}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$(d^3)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{d^6}$",
          "worked": "$\\begin{align*}(d^3)^{-2}&=d^{3(-2)}\\\\(d^3)^{-2}&=d^{-6}\\\\(d^3)^{-2}&=\\frac1{d^6}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$(x^2y^3)^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{x^8y^{12}}$",
          "worked": "$\\begin{align*}(x^2y^3)^{-4}&=x^{2(-4)}y^{3(-4)}\\\\(x^2y^3)^{-4}&=x^{-8}y^{-12}\\\\(x^2y^3)^{-4}&=\\frac1{x^8y^{12}}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$(a^2b^{-3})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^4}{b^6}$",
          "worked": "$\\begin{align*}(a^2b^{-3})^2&=a^{2\\times2}b^{-3\\times2}\\\\(a^2b^{-3})^2&=a^4b^{-6}\\\\(a^2b^{-3})^2&=\\frac{a^4}{b^6}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q2-m",
        "type": "part",
        "label": "m",
        "prompt": "$(3a)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{9a^2}$",
          "worked": "$\\begin{align*}(3a)^{-2}&=\\frac1{(3a)^2}\\\\(3a)^{-2}&=\\frac1{9a^2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q2-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\left(\\frac ab\\right)^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b^3}{a^3}$",
          "worked": "$\\begin{align*}\\left(\\frac ab\\right)^{-3}&=\\frac1{\\left(\\frac ab\\right)^3}\\\\\\left(\\frac ab\\right)^{-3}&=\\frac1{\\frac{a^3}{b^3}}\\\\\\left(\\frac ab\\right)^{-3}&=\\frac{b^3}{a^3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p6-q2-o",
        "type": "part",
        "label": "o",
        "prompt": "$(2^{-1}x^3)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac4{x^6}$",
          "worked": "$\\begin{align*}(2^{-1}x^3)^{-2}&=2^{(-1)(-2)}x^{3(-2)}\\\\(2^{-1}x^3)^{-2}&=4x^{-6}\\\\(2^{-1}x^3)^{-2}&=\\frac4{x^6}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q2-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\left(\\frac{x^2}{y^{-3}}\\right)^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{x^6y^9}$",
          "worked": "$\\begin{align*}\\left(\\frac{x^2}{y^{-3}}\\right)^{-3}&=\\frac{x^{2(-3)}}{y^{(-3)(-3)}}\\\\\\left(\\frac{x^2}{y^{-3}}\\right)^{-3}&=\\frac{x^{-6}}{y^9}\\\\\\left(\\frac{x^2}{y^{-3}}\\right)^{-3}&=\\frac1{x^6y^9}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
