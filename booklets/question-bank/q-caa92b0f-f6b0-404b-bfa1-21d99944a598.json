  "content": {
    "id": "p31-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The cost of a lounge suite is \\$990 including GST.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the GST payable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$90",
          "worked": "The GST-inclusive price represents $110\\%$ of the pre-GST price.\n$$\\begin{align*}110\\% &= \\text{\\$}990\\\\10\\% &= \\text{\\$}\\frac{990}{11}\\\\10\\% &= \\text{\\$}90\\end{align*}$$\nThe GST payable is \\$90.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p31-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the pre-GST price",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$900",
          "worked": "The GST-inclusive price represents $110\\%$ of the pre-GST price.\n$$\\begin{align*}110\\% &= \\text{\\$}990\\\\10\\% &= \\text{\\$}\\frac{990}{11}\\\\10\\% &= \\text{\\$}90\\\\100\\% &= \\text{\\$}(90\\times10)\\\\100\\% &= \\text{\\$}900\\end{align*}$$\nThe pre-GST price is \\$900.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
