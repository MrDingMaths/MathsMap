    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$28.43\\text{ cm}$ or $12.65\\text{ cm}$.",
      "worked": "Possibility 1: 18 cm and 22 cm are the shorter sides.\n$$\\begin{align*}\nh &= \\sqrt{18^2+22^2} \\\\\nh &\\approx 28.43\\text{ cm}\n\\end{align*}$$\nPossibility 2: 22 cm is the hypotenuse.\n$$\\begin{align*}\na &= \\sqrt{22^2-18^2} \\\\\na &\\approx 12.65\\text{ cm}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
