    "children": [
      {
        "id": "p20-q10",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_8(2)+\\log_8(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_8(2)+\\log_8(4)&=\\log_8(2\\times4)\\\\\\log_8(2)+\\log_8(4)&=\\log_8(8)\\\\\\log_8(2)+\\log_8(4)&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q11",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{15}(3)+\\log_{15}(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_{15}(3)+\\log_{15}(5)&=\\log_{15}(3\\times5)\\\\\\log_{15}(3)+\\log_{15}(5)&=\\log_{15}(15)\\\\\\log_{15}(3)+\\log_{15}(5)&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q12",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_6(9)+\\log_6(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_6(9)+\\log_6(4)&=\\log_6(9\\times4)\\\\\\log_6(9)+\\log_6(4)&=\\log_6(36)\\\\\\log_6(9)+\\log_6(4)&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q13",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{10}(40)+\\log_{10}(25)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\log_{10}(40)+\\log_{10}(25)&=\\log_{10}(40\\times25)\\\\\\log_{10}(40)+\\log_{10}(25)&=\\log_{10}(1000)\\\\\\log_{10}(40)+\\log_{10}(25)&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
