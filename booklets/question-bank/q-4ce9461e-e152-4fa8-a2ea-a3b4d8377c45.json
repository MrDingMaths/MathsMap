  "content": {
    "id": "p16-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "$A(2,4)$, $B(4,-3)$, and $C(-5,3)$ are the vertices of a triangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$X$ and $Y$ are midpoints of $AB$ and $AC$ respectively.\n\nFind the coordinates of $X$ and $Y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$X=(3,\\tfrac12)$, $Y=(-\\tfrac32,\\tfrac72)$.",
          "worked": "$$\\begin{align*}X&=\\left(\\frac{2+4}{2},\\frac{4+(-3)}{2}\\right)\\\\X&=\\left(3,\\frac12\\right)\\\\Y&=\\left(\\frac{2+(-5)}{2},\\frac{4+3}{2}\\right)\\\\Y&=\\left(-\\frac32,\\frac72\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the gradients of $XY$ and $CB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{XY}=m_{CB}=-\\tfrac23$.",
          "worked": "$$\\begin{align*}m_{XY}&=\\frac{\\frac72-\\frac12}{-\\frac32-3}\\\\m_{XY}&=-\\frac23\\\\m_{CB}&=\\frac{3-(-3)}{-5-4}\\\\m_{CB}&=-\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "What type of quadrilateral is $XYCB$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A trapezium: $XY\\parallel CB$.",
          "worked": "$m_{XY}=m_{CB}=-\\tfrac23$, so $XY\\parallel CB$.\n\nThe other opposite sides, $YC$ and $BX$, lie along $AC$ and $AB$ respectively. Their gradients are $\\tfrac17$ and $-\\tfrac72$, so they are not parallel.\n\nTherefore $XYCB$ is a trapezium.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the lengths of $XY$ and $CB$. Hence show that $CB=2XY$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$XY=\\dfrac{3\\sqrt{13}}2$, $CB=3\\sqrt{13}$; hence $CB=2XY$.",
          "worked": "$$\\begin{align*}XY&=\\sqrt{\\left(-\\frac32-3\\right)^2+\\left(\\frac72-\\frac12\\right)^2}\\\\XY&=\\frac{3\\sqrt{13}}2\\\\CB&=\\sqrt{(-5-4)^2+(3-(-3))^2}\\\\CB&=3\\sqrt{13}\\\\2XY&=2\\times\\frac{3\\sqrt{13}}2\\\\2XY&=3\\sqrt{13}\\\\2XY&=CB\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
