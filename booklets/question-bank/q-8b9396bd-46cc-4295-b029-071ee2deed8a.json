  "content": {
    "id": "v2-47c15-p39-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "A school has 1250 students. 36% catch the train to school and 22% catch the bus.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-47c15-p39-practice-slot-1-slot-1-a",
        "type": "part",
        "label": "a",
        "prompt": "How many students catch the train?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$450$ students",
          "worked": "$$\\begin{align*}\\text{Train}&=0.36\\times1250\\\\\\text{Train}&=450\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-47c15-p39-practice-slot-1-slot-1-b",
        "type": "part",
        "label": "b",
        "prompt": "How many students catch neither the train nor the bus?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$525$ students",
          "worked": "$$\\begin{align*}\\text{Percentage neither}&=100\\%-36\\%-22\\%\\\\\\text{Percentage neither}&=42\\%\\\\\\text{Number neither}&=0.42\\times1250\\\\\\text{Number neither}&=525\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
