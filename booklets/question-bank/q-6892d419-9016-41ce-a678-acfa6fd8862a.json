  "content": {
    "id": "v2-7-practice-section-j7-034150-root",
    "type": "question",
    "label": null,
    "prompt": "Convert these decimals to fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-7-practice-section-j7-034150-j7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$0.\\dot{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{9}$",
          "worked": "The one-digit recurring block gives a denominator of $9$.\n$$0.\\dot{7}=\\frac{7}{9}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-7-practice-section-j7-034150-j7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$0.0\\dot{7}$ is one tenth of $0.\\dot{7}$. Write $0.0\\dot{7}$ as a fraction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{90}$",
          "worked": "$$\\begin{align*}0.0\\dot{7}&=\\frac{1}{10}\\times\\frac{7}{9}\\\\0.0\\dot{7}&=\\frac{7}{90}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-7-practice-section-j7-034150-j7-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$0.0\\dot{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{15}$",
          "worked": "$$\\begin{align*}0.0\\dot{6}&=\\frac{1}{10}\\times\\frac{6}{9}\\\\0.0\\dot{6}&=\\frac{6}{90}\\\\0.0\\dot{6}&=\\frac{1}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
