      {
        "id": "p22-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^6-7x^3-8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $x=2$.",
          "worked": "Let $u=x^3$, so $x^6=u^2$.\n\n$$\\begin{align*}u^2-7u-8&=0\\\\(u+1)(u-8)&=0\\\\u&=-1\\text{ or }8\\\\x^3&=-1\\text{ or }8\\\\x&=-1\\text{ or }2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{2x}-3\\times2^x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$.",
          "worked": "Let $u=2^x$, so $2^{2x}=u^2$.\n\n$$\\begin{align*}u^2-3u-4&=0\\\\(u+1)(u-4)&=0\\\\u&=-1\\text{ or }4\\end{align*}$$\n\nSince $2^x>0$, only $u=4$ is possible.\n\n$$\\begin{align*}2^x&=4\\\\2^x&=2^2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
