  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve for $x$ by first rewriting index form, or otherwise.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 64 = x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}2^x &= 64\\\\2^x &= 2^6\\\\x &= 6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}1000 = x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}10^x &= 1000\\\\10^x &= 10^3\\\\x &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2 x = 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$\\begin{align*}x &= 2^4\\\\x &= 16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_3 x = 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81$",
          "worked": "$$\\begin{align*}x &= 3^4\\\\x &= 81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{10}x = 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1000$",
          "worked": "$$\\begin{align*}x &= 10^3\\\\x &= 1000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_3 x = -2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "$$\\begin{align*}x &= 3^{-2}\\\\x &= \\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_4 x = -1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}x &= 4^{-1}\\\\x &= \\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_7 x = -3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{343}$",
          "worked": "$$\\begin{align*}x &= 7^{-3}\\\\x &= \\frac{1}{343}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\log_x 27 = 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}x^3 &= 27\\\\x &= \\sqrt[3]{27}\\\\x &= 3\\end{align*}$$\nThe base satisfies $x > 0$ and $x \\ne 1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\log_x 32 = 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}x^5 &= 32\\\\x^5 &= 2^5\\\\x &= 2\\end{align*}$$\nThe base satisfies $x > 0$ and $x \\ne 1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\log_x 64 = 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}x^3 &= 64\\\\x &= \\sqrt[3]{64}\\\\x &= 4\\end{align*}$$\nThe base satisfies $x > 0$ and $x \\ne 1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q6-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\log_x 81 = 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "A logarithm base requires $x > 0$ and $x \\ne 1$.\n$$\\begin{align*}x^4 &= 81\\\\x^4 &= 3^4\\\\x &= 3\\end{align*}$$\nThe value $-3$ is excluded because the base must be positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
