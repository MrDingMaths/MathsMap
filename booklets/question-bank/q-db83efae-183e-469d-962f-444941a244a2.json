  "content": {
    "id": "p17-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Let $A$ and $B$ be events such that $\\Pr(A)=0.8$, $\\Pr(A\\cup B)=0.9$ and $\\Pr(A\\mid B)=0.5$. Find $\\Pr(B)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\Pr(B)=0.2$.",
      "worked": "By the conditional probability formula,\n$$\\begin{align*}\\Pr(A\\cap B)&=\\Pr(A\\mid B)\\Pr(B)\\\\\\Pr(A\\cap B)&=0.5\\Pr(B).\\end{align*}$$\nUsing the addition rule,\n$$\\begin{align*}\\Pr(A\\cup B)&=\\Pr(A)+\\Pr(B)-\\Pr(A\\cap B)\\\\0.9&=0.8+\\Pr(B)-0.5\\Pr(B)\\\\0.1&=0.5\\Pr(B)\\\\\\Pr(B)&=0.2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
