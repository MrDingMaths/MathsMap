  "content": {
    "id": "p25-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "In a survey, 35% of respondents said they felt a penalty was too lenient and 20% felt it was too harsh. If there were 1200 respondents, how many felt the penalty was appropriate?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "540 respondents",
      "worked": "The percentage who felt the penalty was appropriate is $100\\%-35\\%-20\\%=45\\%$.\n\n$$\\begin{align*}10\\%\\text{ of }1200&=1200\\div10=120\\\\5\\%\\text{ of }1200&=120\\div2=60\\\\45\\%\\text{ of }1200&=4\\times120+60\\\\&=540\\end{align*}$$\n\n540 respondents felt the penalty was appropriate.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
