    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q31",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(45^\\circ-\\theta)\\cos(45^\\circ-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\cos 2\\theta$",
          "worked": "$$\\begin{align*}\\sin(45^\\circ-\\theta)\\cos(45^\\circ-\\theta)&=\\frac12\\sin\\bigl(2(45^\\circ-\\theta)\\bigr)\\\\\\sin(45^\\circ-\\theta)\\cos(45^\\circ-\\theta)&=\\frac12\\sin(90^\\circ-2\\theta)\\\\\\sin(45^\\circ-\\theta)\\cos(45^\\circ-\\theta)&=\\frac12\\cos 2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p30-q32",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos^4\\theta-\\sin^4\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos 2\\theta$",
          "worked": "$$\\begin{align*}\\cos^4\\theta-\\sin^4\\theta&=(\\cos^2\\theta-\\sin^2\\theta)(\\cos^2\\theta+\\sin^2\\theta)\\\\\\cos^4\\theta-\\sin^4\\theta&=\\cos^2\\theta-\\sin^2\\theta\\\\\\cos^4\\theta-\\sin^4\\theta&=\\cos 2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q33",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\theta\\cos\\theta\\cos 2\\theta\\cos 4\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac18\\sin 8\\theta$\n\nApply the sine double-angle identity three times.",
          "worked": "$$\\begin{align*}\\sin\\theta\\cos\\theta\\cos 2\\theta\\cos 4\\theta&=\\frac12\\sin 2\\theta\\cos 2\\theta\\cos 4\\theta\\\\\\sin\\theta\\cos\\theta\\cos 2\\theta\\cos 4\\theta&=\\frac14\\sin 4\\theta\\cos 4\\theta\\\\\\sin\\theta\\cos\\theta\\cos 2\\theta\\cos 4\\theta&=\\frac18\\sin 8\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p30-q34",
        "type": "part",
        "label": "d",
        "prompt": "$1-\\frac12\\sin\\theta\\tan\\frac\\theta2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1+\\cos\\theta}{2}$",
          "worked": "$$\\begin{align*}1-\\frac12\\sin\\theta\\tan\\frac\\theta2&=1-\\frac12\\left(2\\sin\\frac\\theta2\\cos\\frac\\theta2\\right)\\frac{\\sin\\frac\\theta2}{\\cos\\frac\\theta2}\\\\1-\\frac12\\sin\\theta\\tan\\frac\\theta2&=1-\\sin^2\\frac\\theta2\\\\1-\\frac12\\sin\\theta\\tan\\frac\\theta2&=\\cos^2\\frac\\theta2\\\\1-\\frac12\\sin\\theta\\tan\\frac\\theta2&=\\frac{1+\\cos\\theta}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p30-q35",
        "type": "part",
        "label": "e",
        "prompt": "$1+\\tan\\theta\\tan\\frac\\theta2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sec\\theta$",
          "worked": "$$\\begin{align*}1+\\tan\\theta\\tan\\frac\\theta2&=1+\\frac{\\sin\\theta}{\\cos\\theta}\\frac{\\sin\\theta}{1+\\cos\\theta}\\\\1+\\tan\\theta\\tan\\frac\\theta2&=\\frac{\\cos\\theta(1+\\cos\\theta)+\\sin^2\\theta}{\\cos\\theta(1+\\cos\\theta)}\\\\1+\\tan\\theta\\tan\\frac\\theta2&=\\frac{1+\\cos\\theta}{\\cos\\theta(1+\\cos\\theta)}\\\\1+\\tan\\theta\\tan\\frac\\theta2&=\\sec\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p30-q36",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{\\tan 2\\theta-\\tan\\theta}{\\cot\\theta+\\tan 2\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^2\\theta$\n\nSubstitute the tangent double-angle formula and simplify the compound fraction.",
          "worked": "Let $t=\\tan\\theta$.\n$$\\begin{align*}\\frac{\\tan 2\\theta-\\tan\\theta}{\\cot\\theta+\\tan 2\\theta}&=\\frac{\\frac{2t}{1-t^2}-t}{\\frac1t+\\frac{2t}{1-t^2}}\\\\\\frac{\\tan 2\\theta-\\tan\\theta}{\\cot\\theta+\\tan 2\\theta}&=\\frac{\\frac{t(1+t^2)}{1-t^2}}{\\frac{1+t^2}{t(1-t^2)}}\\\\\\frac{\\tan 2\\theta-\\tan\\theta}{\\cot\\theta+\\tan 2\\theta}&=t^2\\\\\\frac{\\tan 2\\theta-\\tan\\theta}{\\cot\\theta+\\tan 2\\theta}&=\\tan^2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p30-q37",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{\\sin 3\\theta}{\\sin\\theta}-\\frac{\\cos 3\\theta}{\\cos\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$\n\nExpand each triple angle as $2\\theta+\\theta$ and use $\\sin 2\\theta=2\\sin\\theta\\cos\\theta$.",
          "worked": "$$\\begin{align*}\\frac{\\sin 3\\theta}{\\sin\\theta}-\\frac{\\cos 3\\theta}{\\cos\\theta}&=\\frac{\\sin 2\\theta\\cos\\theta+\\cos 2\\theta\\sin\\theta}{\\sin\\theta}-\\frac{\\cos 2\\theta\\cos\\theta-\\sin 2\\theta\\sin\\theta}{\\cos\\theta}\\\\\\frac{\\sin 3\\theta}{\\sin\\theta}-\\frac{\\cos 3\\theta}{\\cos\\theta}&=\\sin 2\\theta\\left(\\frac{\\cos\\theta}{\\sin\\theta}+\\frac{\\sin\\theta}{\\cos\\theta}\\right)\\\\\\frac{\\sin 3\\theta}{\\sin\\theta}-\\frac{\\cos 3\\theta}{\\cos\\theta}&=2\\sin\\theta\\cos\\theta\\frac{\\cos^2\\theta+\\sin^2\\theta}{\\sin\\theta\\cos\\theta}\\\\\\frac{\\sin 3\\theta}{\\sin\\theta}-\\frac{\\cos 3\\theta}{\\cos\\theta}&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p30-q38",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{\\sin\\theta+\\cos\\theta}{\\sin\\theta-\\cos\\theta}+\\frac{\\sin\\theta-\\cos\\theta}{\\sin\\theta+\\cos\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\sec 2\\theta$\n\nCombine the fractions, then use the Pythagorean and cosine double-angle identities.",
          "worked": "$$\\begin{align*}\\frac{\\sin\\theta+\\cos\\theta}{\\sin\\theta-\\cos\\theta}+\\frac{\\sin\\theta-\\cos\\theta}{\\sin\\theta+\\cos\\theta}&=\\frac{(\\sin\\theta+\\cos\\theta)^2+(\\sin\\theta-\\cos\\theta)^2}{\\sin^2\\theta-\\cos^2\\theta}\\\\\\frac{\\sin\\theta+\\cos\\theta}{\\sin\\theta-\\cos\\theta}+\\frac{\\sin\\theta-\\cos\\theta}{\\sin\\theta+\\cos\\theta}&=\\frac{2\\sin^2\\theta+2\\cos^2\\theta}{\\sin^2\\theta-\\cos^2\\theta}\\\\\\frac{\\sin\\theta+\\cos\\theta}{\\sin\\theta-\\cos\\theta}+\\frac{\\sin\\theta-\\cos\\theta}{\\sin\\theta+\\cos\\theta}&=-\\frac{2}{\\cos 2\\theta}\\\\\\frac{\\sin\\theta+\\cos\\theta}{\\sin\\theta-\\cos\\theta}+\\frac{\\sin\\theta-\\cos\\theta}{\\sin\\theta+\\cos\\theta}&=-2\\sec 2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
