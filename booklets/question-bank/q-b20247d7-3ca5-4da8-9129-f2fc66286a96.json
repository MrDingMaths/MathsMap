  "content": {
    "id": "p30-q31-38-root",
    "type": "question",
    "label": null,
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p30-q31-38-instruction",
          "type": "paragraph",
          "fontSize": null,
