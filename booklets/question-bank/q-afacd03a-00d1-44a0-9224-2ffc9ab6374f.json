        "id": "p13-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1\\pm\\sqrt5}{2}$",
          "worked": "Here $a=1$, $b=-1$ and $c=-1$.\n$$\\begin{align*}x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{1\\pm\\sqrt{(-1)^2-4(1)(-1)}}{2(1)}\\\\x&=\\frac{1\\pm\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$4x^2-8x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1\\pm\\frac{\\sqrt3}{2}$",
          "worked": "Here $a=4$, $b=-8$ and $c=1$.\n$$\\begin{align*}x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{8\\pm\\sqrt{(-8)^2-4(4)(1)}}{2(4)}\\\\x&=\\frac{8\\pm4\\sqrt3}{8}\\\\x&=1\\pm\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
