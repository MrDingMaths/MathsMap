        "answer": {
          "short": "$\\dfrac{dy}{dx}=(x-2)^3(3x+1)^4(27x-26)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=4(x-2)^3(3x+1)^5+(x-2)^4\\bigl[5(3x+1)^4(3)\\bigr]\\\\\\frac{dy}{dx}&=(x-2)^3(3x+1)^4\\bigl[4(3x+1)+15(x-2)\\bigr]\\\\\\frac{dy}{dx}&=(x-2)^3(3x+1)^4(27x-26)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-408aa4f17-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(2x-1)^3(x^2+4)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2(2x-1)^2(x^2+4)^3(11x^2-4x+12)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3(2x-1)^2(2)(x^2+4)^4+(2x-1)^3\\bigl[4(x^2+4)^3(2x)\\bigr]\\\\\\frac{dy}{dx}&=2(2x-1)^2(x^2+4)^3\\bigl[3(x^2+4)+4x(2x-1)\\bigr]\\\\\\frac{dy}{dx}&=2(2x-1)^2(x^2+4)^3(11x^2-4x+12)\\end{align*}$$",
          "solutionDiagrams": []
        },
