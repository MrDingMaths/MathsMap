  "content": {
    "id": "p16-q18",
    "type": "question",
    "label": "18",
    "prompt": "Rosie factorised $16xyz + 24xn = 4(4xyz + 6xn)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why she is not fully correct.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The terms in the brackets share common factors.",
          "worked": "The bracketed terms have HCF $2x$, so the factorisation is incomplete.\n$$\\begin{align*}4(4xyz + 6xn) &= 4\\times 2x(2yz + 3n)\\\\&= 8x(2yz + 3n)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Charlotte says it should have been $8(2xyz + 3xn)$. Explain why she is not fully correct.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The terms in the brackets still share a common factor of $x$.",
          "worked": "The bracketed terms still have HCF $x$, so the factorisation is incomplete.\n$$\\begin{align*}8(2xyz + 3xn) &= 8\\times x(2yz + 3n)\\\\&= 8x(2yz + 3n)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
