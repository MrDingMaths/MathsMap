    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+2x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1\\pm\\sqrt{3}$",
          "worked": "$$\\begin{align*}x^2+2x+1-1-2&=0\\\\(x+1)^2-3&=0\\\\(x+1)^2&=3\\\\x+1&=\\pm\\sqrt{3}\\\\x&=-1\\pm\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-6x+6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3\\pm\\sqrt{3}$",
          "worked": "$$\\begin{align*}x^2-6x+9-9+6&=0\\\\(x-3)^2-3&=0\\\\(x-3)^2&=3\\\\x-3&=\\pm\\sqrt{3}\\\\x&=3\\pm\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+4x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2\\pm\\sqrt{2}$",
          "worked": "$$\\begin{align*}x^2+4x+4-4+2&=0\\\\(x+2)^2-2&=0\\\\(x+2)^2&=2\\\\x+2&=\\pm\\sqrt{2}\\\\x&=-2\\pm\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p12-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+3x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-3\\pm\\sqrt{5}}{2}$",
          "worked": "$$\\begin{align*}x^2+3x+\\frac94-\\frac94+1&=0\\\\\\left(x+\\frac32\\right)^2-\\frac54&=0\\\\\\left(x+\\frac32\\right)^2&=\\frac54\\\\x+\\frac32&=\\pm\\frac{\\sqrt5}{2}\\\\x&=\\frac{-3\\pm\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p12-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-5x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{5\\pm\\sqrt{13}}{2}$",
          "worked": "$$\\begin{align*}x^2-5x+\\frac{25}{4}-\\frac{25}{4}+3&=0\\\\\\left(x-\\frac52\\right)^2-\\frac{13}{4}&=0\\\\\\left(x-\\frac52\\right)^2&=\\frac{13}{4}\\\\x-\\frac52&=\\pm\\frac{\\sqrt{13}}{2}\\\\x&=\\frac{5\\pm\\sqrt{13}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p12-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2-x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{1\\pm\\sqrt{5}}{2}$",
          "worked": "$$\\begin{align*}x^2-x+\\frac14-\\frac14-1&=0\\\\\\left(x-\\frac12\\right)^2-\\frac54&=0\\\\\\left(x-\\frac12\\right)^2&=\\frac54\\\\x-\\frac12&=\\pm\\frac{\\sqrt5}{2}\\\\x&=\\frac{1\\pm\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
