  "content": {
    "id": "p18-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "David has $\\$600$ in a bank account. He takes $\\$x$ from the account every week.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q6-a",
        "type": "group",
        "label": "a",
        "prompt": "How much money does he have in the account after:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q6-a-i",
            "type": "part",
            "label": "i",
            "prompt": "1 week?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(600-x)$",
              "worked": "$$\\begin{align*}\\text{Amount left}&=600-1\\times x\\\\\\text{Amount left}&=600-x\\end{align*}$$\nThe balance is $\\$(600-x)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p18-q6-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "5 weeks?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(600-5x)$",
              "worked": "$$\\begin{align*}\\text{Amount left}&=600-5\\times x\\\\\\text{Amount left}&=600-5x\\end{align*}$$\nThe balance is $\\$(600-5x)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p18-q6-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the value of his bank account after 5 weeks if:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q6-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x=100$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$100$",
              "worked": "$$\\begin{align*}\\text{Amount left}&=600-5\\times100\\\\\\text{Amount left}&=600-500\\\\\\text{Amount left}&=100\\end{align*}$$\nThe balance is $\\$100$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p18-q6-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x=200$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\$400$",
              "worked": "$$\\begin{align*}\\text{Amount left}&=600-5\\times200\\\\\\text{Amount left}&=600-1000\\\\\\text{Amount left}&=-400\\end{align*}$$\nThe balance is $-\\$400$. David has overdrawn his account by $\\$400$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
