  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{n!}{(n+1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{n+1}$",
          "worked": "$$\\begin{align*}\\frac{n!}{(n+1)!}&=\\frac{n!}{(n+1)n!}\\\\\\frac{n!}{(n+1)!}&=\\frac{1}{n+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q3b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{(n+1)!}{(n-1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n(n+1)$",
          "worked": "$$\\begin{align*}\\frac{(n+1)!}{(n-1)!}&=\\frac{(n+1)n(n-1)!}{(n-1)!}\\\\\\frac{(n+1)!}{(n-1)!}&=n(n+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q3c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{n!(m-1)!}{(n-1)!m!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n}{m}$",
          "worked": "$$\\begin{align*}\\frac{n!(m-1)!}{(n-1)!m!}&=\\frac{n(n-1)!(m-1)!}{(n-1)!m(m-1)!}\\\\\\frac{n!(m-1)!}{(n-1)!m!}&=\\frac{n}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q3d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{(n^2-4)!}{(n-2)(n^2-5)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n+2$",
          "worked": "$$\\begin{align*}\\frac{(n^2-4)!}{(n-2)(n^2-5)!}&=\\frac{(n^2-4)(n^2-5)!}{(n-2)(n^2-5)!}\\\\\\frac{(n^2-4)!}{(n-2)(n^2-5)!}&=\\frac{n^2-4}{n-2}\\\\\\frac{(n^2-4)!}{(n-2)(n^2-5)!}&=\\frac{(n-2)(n+2)}{n-2}\\\\\\frac{(n^2-4)!}{(n-2)(n^2-5)!}&=n+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
