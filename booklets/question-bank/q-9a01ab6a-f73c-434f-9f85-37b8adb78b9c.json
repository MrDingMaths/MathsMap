              "type": "text",
              "text": " are both odd functions, then their product will be an even function. To prove this, note that",
              "marks": []
            }
          ]
        },
        {
          "id": "p33-q5-proof",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}(f\\cdot g)(-x)&=f(-x)\\cdot g(-x)\\\\&=(-f(x))\\cdot(-g(x))\\\\&=f(x)\\cdot g(x)\\\\&=(f\\cdot g)(x).\\end{aligned}",
              "display": true
            }
          ]
        },
        {
          "id": "p33-q5-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
