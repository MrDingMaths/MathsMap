    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q5a",
        "type": "part",
        "label": "a",
        "prompt": "If $f$ and $g$ are both odd, then $f+g$ is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f+g)(-x)=-(f+g)(x)$, so $f+g$ is odd.",
          "worked": "For every $x\\in\\mathbb R$,\n$$\\begin{align*}(f+g)(-x)&=f(-x)+g(-x)\\\\(f+g)(-x)&=-f(x)-g(x)\\\\(f+g)(-x)&=-(f+g)(x).\\end{align*}$$\nHence, $f+g$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q5b",
        "type": "part",
        "label": "b",
        "prompt": "If $f$ and $g$ are both even, then $f+g$ is even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f+g)(-x)=(f+g)(x)$, so $f+g$ is even.",
          "worked": "For every $x\\in\\mathbb R$,\n$$\\begin{align*}(f+g)(-x)&=f(-x)+g(-x)\\\\(f+g)(-x)&=f(x)+g(x)\\\\(f+g)(-x)&=(f+g)(x).\\end{align*}$$\nHence, $f+g$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q5c",
        "type": "part",
        "label": "c",
        "prompt": "If $f$ is even and $g$ is odd, then $f\\cdot g$ is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f\\cdot g)(-x)=-(f\\cdot g)(x)$, so $f\\cdot g$ is odd.",
          "worked": "For every $x\\in\\mathbb R$,\n$$\\begin{align*}(f\\cdot g)(-x)&=f(-x)\\cdot g(-x)\\\\(f\\cdot g)(-x)&=f(x)\\cdot(-g(x))\\\\(f\\cdot g)(-x)&=-f(x)\\cdot g(x)\\\\(f\\cdot g)(-x)&=-(f\\cdot g)(x).\\end{align*}$$\nHence, $f\\cdot g$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p33-q5d",
        "type": "part",
        "label": "d",
        "prompt": "If $f$ and $g$ are both even, then $f\\cdot g$ is even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f\\cdot g)(-x)=(f\\cdot g)(x)$, so $f\\cdot g$ is even.",
          "worked": "For every $x\\in\\mathbb R$,\n$$\\begin{align*}(f\\cdot g)(-x)&=f(-x)\\cdot g(-x)\\\\(f\\cdot g)(-x)&=f(x)\\cdot g(x)\\\\(f\\cdot g)(-x)&=(f\\cdot g)(x).\\end{align*}$$\nHence, $f\\cdot g$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q5e",
        "type": "part",
        "label": "e",
        "prompt": "Prove that there is only one function that is both even and odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=0$ for every $x\\in\\mathbb R$.\n\nThe parity definitions give $f(x)=-f(x)$; the zero function satisfies both definitions.",
          "worked": "If $f$ is both even and odd, then for every $x\\in\\mathbb R$,\n$$\\begin{align*}f(-x)&=f(x),\\\\f(-x)&=-f(x).\\end{align*}$$\nTherefore,\n$$\\begin{align*}f(x)&=-f(x)\\\\2f(x)&=0\\\\f(x)&=0.\\end{align*}$$\nConversely, the zero function satisfies $f(-x)=f(x)=0$ and $f(-x)=-f(x)=0$. Thus it is the only function that is both even and odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
