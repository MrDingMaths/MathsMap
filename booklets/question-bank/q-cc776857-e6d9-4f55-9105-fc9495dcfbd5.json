  "content": {
    "id": "p11-q6",
    "type": "question",
    "label": "6",
    "prompt": "A formula for the area of a rectangle is $A = bh$, where $b$ is the base and $h$ is the height.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the area of a rectangle with base length of 8 cm and height of 9 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A = 72\\text{ cm}^2$",
          "worked": "$$\\begin{align*} A &= bh \\\\ A &= (8)(9) \\\\ A &= 72\\text{ cm}^2 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the base length of a rectangle with area of $20\\text{ cm}^2$ and height of 4 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b = 5\\text{ cm}$",
          "worked": "$$\\begin{align*} A &= bh \\\\ 20 &= 4b \\\\ b &= 5\\text{ cm} \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p11-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the height of a rectangle with area of $25\\text{ cm}^2$ and base length of 5 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h = 5\\text{ cm}$",
          "worked": "$$\\begin{align*} A &= bh \\\\ 25 &= 5h \\\\ h &= 5\\text{ cm} \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
