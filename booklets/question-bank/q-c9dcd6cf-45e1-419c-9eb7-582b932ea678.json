        "type": "group",
        "label": "a",
        "prompt": "A junior secretary earned $\\$40\\,000$ from 1 July 2000 to 30 June 2001. Determine how much someone in that position would earn from:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q-cont-a-i",
            "type": "part",
            "label": "i",
            "prompt": "1 July 2001 to 30 June 2002",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$42\\,400$",
              "worked": "$$\\begin{align*}\\text{Annual salary}&=40\\,000\\times1.06\\\\\\text{Annual salary}&=\\$42\\,400\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p30-q-cont-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "1 July 2006 to 30 June 2007",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
