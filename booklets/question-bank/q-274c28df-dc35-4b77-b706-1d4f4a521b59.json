  "content": {
    "id": "p18-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Solve the equation $(x^2+2)^2-14(x^2+2)+33=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\pm1$ or $x=\\pm3$.\n\nSet $u=x^2+2$, giving $u=3$ or $u=11$.",
      "worked": "Let $u=x^2+2$.\n$$\\begin{align*}u^2-14u+33&=0\\\\u&=\\frac{14\\pm\\sqrt{196-132}}2\\\\u&=\\frac{14\\pm8}2.\\end{align*}$$\nThus $u=3$ or $u=11$.\n$$\\begin{align*}x^2+2&=3\\\\x^2&=1\\\\x&=\\pm1,\\end{align*}$$\nor\n$$\\begin{align*}x^2+2&=11\\\\x^2&=9\\\\x&=\\pm3.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 102
  },
