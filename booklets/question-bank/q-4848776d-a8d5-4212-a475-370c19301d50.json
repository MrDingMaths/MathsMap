  "content": {
    "id": "p16-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Using a calculator, or otherwise, classify these numbers as either surds, rational, or not real.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surd",
          "worked": "Surd: $7$ is not a perfect square, so $\\sqrt{7}$ is irrational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\sqrt{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surd",
          "worked": "Surd: $\\sqrt{11}$ is irrational, and multiplying it by $2$ gives an irrational value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sqrt{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rational",
          "worked": "$$\\begin{aligned}2\\sqrt{25}&=2\\times5\\\\&=10\\end{aligned}$$\nRational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$-5\\sqrt{144}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rational",
          "worked": "$$\\begin{aligned}-5\\sqrt{144}&=-5\\times12\\\\&=-60\\end{aligned}$$\nRational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3\\sqrt{9}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rational",
          "worked": "$$\\begin{aligned}\\frac{3\\sqrt{9}}{2}&=\\frac{3\\times3}{2}\\\\&=\\frac{9}{2}\\end{aligned}$$\nRational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{-5\\sqrt{3}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surd",
          "worked": "Surd: $\\sqrt{3}$ is irrational, and multiplying it by the nonzero rational number $-\\frac{5}{2}$ gives an irrational value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$1-\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surd",
          "worked": "Surd: subtracting the irrational number $\\sqrt{3}$ from $1$ gives an irrational value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$2+\\sqrt{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rational",
          "worked": "$$\\begin{aligned}2+\\sqrt{4}&=2+2\\\\&=4\\end{aligned}$$\nRational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\sqrt{\\dfrac{4}{25}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rational",
          "worked": "$$\\sqrt{\\frac{4}{25}}=\\frac{2}{5}$$\nRational, since $\\left(\\frac{2}{5}\\right)^2=\\frac{4}{25}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q9-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\sqrt{\\dfrac{5}{16}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surd",
          "worked": "Surd: $\\frac{5}{16}$ is not the square of a rational number, so its square root is irrational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q9-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\sqrt{-11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not real",
          "worked": "Not real: a negative number has no real square root.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q9-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\sqrt{99}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Surd",
          "worked": "Surd: $99$ is not a perfect square, so $\\sqrt{99}$ is irrational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
