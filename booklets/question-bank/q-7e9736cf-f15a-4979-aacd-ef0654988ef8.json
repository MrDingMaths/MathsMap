    "answer": {
      "short": "$\\frac1{20}$",
      "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\left[\\left(\\frac12+\\frac13\\right)+\\frac14\\right]\\times\\frac15-\\frac16\\\\&=\\left[\\left(\\frac36+\\frac26\\right)+\\frac14\\right]\\times\\frac15-\\frac16\\\\&=\\left(\\frac56+\\frac14\\right)\\times\\frac15-\\frac16\\\\&=\\left(\\frac{20}{24}+\\frac6{24}\\right)\\times\\frac15-\\frac16\\\\&=\\frac{26}{24}\\times\\frac15-\\frac16\\\\&=\\frac{13}{12}\\times\\frac15-\\frac16\\\\&=\\frac{13}{60}-\\frac16\\\\&=\\frac{13}{60}-\\frac{10}{60}\\\\&=\\frac3{60}\\\\&=\\frac1{20}\\end{align*}$$",
      "solutionDiagrams": []
    },
