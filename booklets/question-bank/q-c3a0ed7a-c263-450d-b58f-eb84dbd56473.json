  "content": {
    "id": "p31-q10-response",
    "type": "question",
    "label": "10",
    "prompt": "Find the equation of a circle with diameter $KL$, where $K(5,7)$ and $L(-9,3)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x+2)^2+(y-5)^2=53$",
      "worked": "The centre is the midpoint of the diameter.\n$$\\begin{aligned}\n\\text{Centre}&=\\left(\\frac{5+(-9)}{2},\\frac{7+3}{2}\\right)\\\\\n&=(-2,5).\n\\end{aligned}$$\nUsing the distance from the centre to $K$:\n$$\\begin{aligned}\nr^2&=(5-(-2))^2+(7-5)^2\\\\\n&=53.\n\\end{aligned}$$\nHence the equation is $(x+2)^2+(y-5)^2=53$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
