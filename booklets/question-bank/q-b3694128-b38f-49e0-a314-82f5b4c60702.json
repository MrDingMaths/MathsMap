  "content": {
    "id": "p3-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find each of the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\frac{\\pi}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2+\\sqrt6}{4}$",
          "worked": "$$\\begin{align*}\\cos\\frac{\\pi}{12}&=\\cos\\left(\\frac{\\pi}{3}-\\frac{\\pi}{4}\\right)\\\\\\cos\\frac{\\pi}{12}&=\\cos\\frac{\\pi}{3}\\cos\\frac{\\pi}{4}+\\sin\\frac{\\pi}{3}\\sin\\frac{\\pi}{4}\\\\\\cos\\frac{\\pi}{12}&=\\frac12\\cdot\\frac{\\sqrt2}{2}+\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}\\\\\\cos\\frac{\\pi}{12}&=\\frac{\\sqrt2+\\sqrt6}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p3-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin\\frac{5\\pi}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2+\\sqrt6}{4}$",
          "worked": "$$\\begin{align*}\\sin\\frac{5\\pi}{12}&=\\sin\\left(\\frac{\\pi}{4}+\\frac{\\pi}{6}\\right)\\\\\\sin\\frac{5\\pi}{12}&=\\sin\\frac{\\pi}{4}\\cos\\frac{\\pi}{6}+\\cos\\frac{\\pi}{4}\\sin\\frac{\\pi}{6}\\\\\\sin\\frac{5\\pi}{12}&=\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}+\\frac{\\sqrt2}{2}\\cdot\\frac12\\\\\\sin\\frac{5\\pi}{12}&=\\frac{\\sqrt2+\\sqrt6}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p3-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\frac{7\\pi}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2-\\sqrt3$",
          "worked": "$$\\begin{align*}\\tan\\frac{7\\pi}{12}&=\\tan\\left(\\frac{\\pi}{3}+\\frac{\\pi}{4}\\right)\\\\\\tan\\frac{7\\pi}{12}&=\\frac{\\tan\\frac{\\pi}{3}+\\tan\\frac{\\pi}{4}}{1-\\tan\\frac{\\pi}{3}\\tan\\frac{\\pi}{4}}\\\\\\tan\\frac{7\\pi}{12}&=\\frac{\\sqrt3+1}{1-\\sqrt3}\\\\\\tan\\frac{7\\pi}{12}&=\\frac{(\\sqrt3+1)(1+\\sqrt3)}{(1-\\sqrt3)(1+\\sqrt3)}\\\\\\tan\\frac{7\\pi}{12}&=-2-\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p3-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\frac{11\\pi}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{\\sqrt2+\\sqrt6}{4}$",
          "worked": "$$\\begin{align*}\\cos\\frac{11\\pi}{12}&=\\cos\\left(\\frac{2\\pi}{3}+\\frac{\\pi}{4}\\right)\\\\\\cos\\frac{11\\pi}{12}&=\\cos\\frac{2\\pi}{3}\\cos\\frac{\\pi}{4}-\\sin\\frac{2\\pi}{3}\\sin\\frac{\\pi}{4}\\\\\\cos\\frac{11\\pi}{12}&=-\\frac12\\cdot\\frac{\\sqrt2}{2}-\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}\\\\\\cos\\frac{11\\pi}{12}&=-\\frac{\\sqrt2+\\sqrt6}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p3-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin\\frac{17\\pi}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{\\sqrt2+\\sqrt6}{4}$",
          "worked": "$$\\begin{align*}\\sin\\frac{17\\pi}{12}&=\\sin\\left(\\frac{5\\pi}{4}+\\frac{\\pi}{6}\\right)\\\\\\sin\\frac{17\\pi}{12}&=\\sin\\frac{5\\pi}{4}\\cos\\frac{\\pi}{6}+\\cos\\frac{5\\pi}{4}\\sin\\frac{\\pi}{6}\\\\\\sin\\frac{17\\pi}{12}&=-\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}-\\frac{\\sqrt2}{2}\\cdot\\frac12\\\\\\sin\\frac{17\\pi}{12}&=-\\frac{\\sqrt2+\\sqrt6}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p3-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan\\frac{19\\pi}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2-\\sqrt3$",
          "worked": "$$\\begin{align*}\\tan\\frac{19\\pi}{12}&=\\tan\\left(\\frac{4\\pi}{3}+\\frac{\\pi}{4}\\right)\\\\\\tan\\frac{19\\pi}{12}&=\\frac{\\tan\\frac{4\\pi}{3}+\\tan\\frac{\\pi}{4}}{1-\\tan\\frac{4\\pi}{3}\\tan\\frac{\\pi}{4}}\\\\\\tan\\frac{19\\pi}{12}&=\\frac{\\sqrt3+1}{1-\\sqrt3}\\\\\\tan\\frac{19\\pi}{12}&=\\frac{(\\sqrt3+1)(1+\\sqrt3)}{(1-\\sqrt3)(1+\\sqrt3)}\\\\\\tan\\frac{19\\pi}{12}&=-2-\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
  },
