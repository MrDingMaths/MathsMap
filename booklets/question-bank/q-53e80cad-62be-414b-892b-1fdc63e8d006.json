  "content": {
    "id": "p11-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "There are three green apples and two red apples in a bowl. Georgia is blindfolded and randomly chooses one of the apples. What is the probability that she chooses a green apple?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{5}$",
      "worked": "There are $3+2=5$ apples. Each apple is equally likely to be chosen, and three are green.\n\n$$\\begin{align*}P(\\text{green apple})&=\\frac{\\text{number of green apples}}{\\text{total number of apples}}\\\\P(\\text{green apple})&=\\frac{3}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
