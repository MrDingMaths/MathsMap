  "content": {
    "id": "p111-q47-root",
    "type": "question",
    "label": "47",
    "prompt": "Find the fraction that is equivalent to $\\frac{3}{4}$ and:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p111-q47-a",
        "type": "part",
        "label": "a",
        "prompt": "the difference between the denominator and the numerator is 7.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{28}$",
          "worked": "Write the equivalent fraction as $\\frac{3a}{4a}$.\n$$\\begin{align*}4a-3a&=7\\\\a&=7\\end{align*}$$\nThe fraction is $\\frac{3\\times7}{4\\times7}=\\frac{21}{28}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p111-q47-b",
        "type": "part",
        "label": "b",
        "prompt": "the product of the denominator and the numerator is 300.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15}{20}$",
          "worked": "Write the equivalent fraction as $\\frac{3a}{4a}$, using positive numerator and denominator.\n$$\\begin{align*}(3a)(4a)&=300\\\\12a^2&=300\\\\a^2&=25\\\\a&=5\\end{align*}$$\nThe fraction is $\\frac{3\\times5}{4\\times5}=\\frac{15}{20}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
