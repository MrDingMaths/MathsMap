    "type": "question",
    "label": "14",
    "prompt": "Let $f(x)=2^x$. Show that $f(x)\\times f(-x)=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(x)\\times f(-x)=2^{x-x}=1$.",
      "worked": "$$\\begin{align*}f(x)\\times f(-x)&=2^x\\times2^{-x}\\\\f(x)\\times f(-x)&=2^{x-x}\\\\f(x)\\times f(-x)&=2^0=1\\end{align*}$$",
      "solutionDiagrams": []
