  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "$P(x)=ax^3+4$. If $P(2)=28$, find the value of the leading coefficient $a$ and hence find the polynomial.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=3$; $P(x)=3x^3+4$.",
      "worked": "$$\\begin{align*}P(2)&=a(2)^3+4\\\\28&=8a+4\\\\24&=8a\\\\a&=3\\\\P(x)&=3x^3+4\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 51
  },
