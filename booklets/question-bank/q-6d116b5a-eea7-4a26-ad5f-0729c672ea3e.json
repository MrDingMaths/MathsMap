    "type": "question",
    "label": "8",
    "prompt": "For two events $E$ and $F$, $P(E)=0.85$, $P(F)=0.72$ and $P(E\\cup F)=0.95$. Find $P(E\\cap F)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.62$\n\nSubtract the union probability from the sum of the two event probabilities.",
      "worked": "$$\\begin{align*}P(E\\cup F)&=P(E)+P(F)-P(E\\cap F)\\\\0.95&=0.85+0.72-P(E\\cap F)\\\\P(E\\cap F)&=0.85+0.72-0.95\\\\P(E\\cap F)&=0.62\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
