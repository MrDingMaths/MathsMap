  "content": {
    "id": "p17-question-1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider $f(x)=5x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-question-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(1)=5$ and $f(1+h)=5+10h+5h^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(1)=5(1)^2=5$ and $f(1+h)=5(1+2h+h^2)=5+10h+5h^2$.",
          "worked": "$$\\begin{align*}f(1)&=5(1)^2\\\\f(1)&=5\\end{align*}$$\n$$\\begin{align*}f(1+h)&=5(1+h)^2\\\\f(1+h)&=5(1+2h+h^2)\\\\f(1+h)&=5+10h+5h^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-question-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\dfrac{f(1+h)-f(1)}{h}=10+5h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{f(1+h)-f(1)}{h}=\\dfrac{10h+5h^2}{h}=10+5h$, for $h\\ne0$.",
          "worked": "For $h\\ne0$,\n$$\\begin{align*}\\frac{f(1+h)-f(1)}{h}&=\\frac{5+10h+5h^2-5}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=\\frac{h(10+5h)}{h}\\\\\\frac{f(1+h)-f(1)}{h}&=10+5h.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p17-question-1-c",
        "type": "part",
        "label": "c",
        "prompt": "Take the limit as $h\\to0$ to show that $f'(1)=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(1)=\\lim_{h\\to0}(10+5h)=10$.",
          "worked": "$$\\begin{align*}f'(1)&=\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}\\\\f'(1)&=\\lim_{h\\to0}(10+5h)\\\\f'(1)&=10.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
