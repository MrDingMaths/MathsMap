              {
                "id": "p16-q6-a-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\Pr(A)&=1-\\Pr(A')\\\\\\Pr(A)&=1-0.5\\\\\\Pr(A)&=0.5\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\Pr(A'\\cap B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3$",
          "worked": "$$\\begin{aligned}\\Pr(A'\\cap B)&=\\Pr(A')-\\Pr(A'\\cap B')\\\\\\Pr(A'\\cap B)&=0.5-0.2\\\\\\Pr(A'\\cap B)&=0.3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\Pr(A'\\cup B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.6$",
          "worked": "$$\\begin{aligned}\\Pr(A'\\cup B)&=\\Pr(A')+\\Pr(B)-\\Pr(A'\\cap B)\\\\\\Pr(A'\\cup B)&=0.5+0.4-0.3\\\\\\Pr(A'\\cup B)&=0.6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\Pr(A\\mid B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.25$",
          "worked": "$$\\begin{aligned}\\Pr(A\\mid B)&=\\frac{\\Pr(A\\cap B)}{\\Pr(B)}\\\\\\Pr(A\\mid B)&=\\frac{0.1}{0.4}\\\\\\Pr(A\\mid B)&=0.25\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\Pr(B'\\mid A')$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{aligned}\\Pr(B'\\mid A')&=\\frac{\\Pr(B'\\cap A')}{\\Pr(A')}\\\\\\Pr(B'\\mid A')&=\\frac{0.2}{0.5}\\\\\\Pr(B'\\mid A')&=0.4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\Pr(B'\\mid(A\\cap B))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No outcome in $A\\cap B$ belongs to $B'$.\n\n$$\\begin{aligned}\\Pr(B'\\mid(A\\cap B))&=\\frac{0}{0.1}\\\\\\Pr(B'\\mid(A\\cap B))&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p16-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\Pr((A\\cap B)\\mid(A\\cup B))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.125$",
          "worked": "$$\\begin{aligned}\\Pr(A\\cup B)&=1-\\Pr(A'\\cap B')\\\\\\Pr(A\\cup B)&=1-0.2=0.8\\end{aligned}$$\n\nSince $A\\cap B\\subseteq A\\cup B$,\n\n$$\\begin{aligned}\\Pr((A\\cap B)\\mid(A\\cup B))&=\\frac{\\Pr(A\\cap B)}{\\Pr(A\\cup B)}\\\\\\Pr((A\\cap B)\\mid(A\\cup B))&=\\frac{0.1}{0.8}\\\\\\Pr((A\\cap B)\\mid(A\\cup B))&=0.125\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
