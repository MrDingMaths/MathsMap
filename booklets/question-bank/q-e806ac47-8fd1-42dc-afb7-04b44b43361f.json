  "content": {
    "id": "p43-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The probability of selecting a black jelly bean from a packet is $0.16$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the mean number of black jelly beans selected from $20$ packets.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.2$ black jelly beans",
          "worked": "$$\\begin{aligned}E(X)&=np\\\\E(X)&=20(0.16)\\\\E(X)&=3.2\\end{aligned}$$\nThe mean is $3.2$ black jelly beans.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p43-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the variance of black jelly beans selected from $50$ packets.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.72$",
          "worked": "$$\\begin{aligned}\\operatorname{Var}(X)&=np(1-p)\\\\\\operatorname{Var}(X)&=50(0.16)(0.84)\\\\\\operatorname{Var}(X)&=6.72\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
