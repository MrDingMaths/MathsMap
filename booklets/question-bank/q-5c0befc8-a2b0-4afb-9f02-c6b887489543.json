  "content": {
    "id": "v2-044f0-p28-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x^2-10x+16$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-044f0-p28-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "State the largest domain that contains $x=3$ so that the inverse function $f^{-1}$ exists.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,5]$.",
          "worked": "$$\\begin{align*}f(x)&=x^2-10x+16\\\\f(x)&=(x-5)^2-9.\\end{align*}$$\nThe vertex is $(5,-9)$. The largest branch containing $x=3$ is the left branch, so the domain is $(-\\infty,5]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-044f0-p28-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $f^{-1}(x)$ for the domain of $f$ found in part (a).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=5-\\sqrt{x+9}$.",
          "worked": "Interchange $x$ and $y$ in $y=(x-5)^2-9$:\n$$\\begin{align*}x&=(y-5)^2-9\\\\(y-5)^2&=x+9\\\\y-5&=-\\sqrt{x+9}\\\\y&=5-\\sqrt{x+9}.\\end{align*}$$\nUse the negative square root because the inverse must have $y\\leq5$. Thus $f^{-1}(x)=5-\\sqrt{x+9}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-044f0-p28-practice-slot-7-slot-7-q-c",
        "type": "part",
        "label": "c",
        "prompt": "State the domain and range of $f^{-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $[-9,\\infty)$. Range: $(-\\infty,5]$.",
          "worked": "The restricted $f$ has domain $(-\\infty,5]$ and range $[-9,\\infty)$. Interchanging domain and range gives $f^{-1}$ domain $[-9,\\infty)$ and range $(-\\infty,5]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
