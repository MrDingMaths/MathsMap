        "id": "p32-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\displaystyle\\int_2^k 3\\,dx=3k-6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\int_2^k 3\\,dx=[3x]_2^k=3k-6$.",
          "worked": "$$\\begin{align*}\\int_2^k 3\\,dx&=[3x]_2^k\\\\&=3k-3(2)\\\\&=3k-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p32-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the value of $k$, given that $\\displaystyle\\int_2^k 3\\,dx=18$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=8$.",
          "worked": "$$\\begin{align*}3k-6&=18\\\\3k&=24\\\\k&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
