  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "In each equation the discriminant $\\Delta$ of the quadratic involves $\\lambda$. Solve $\\Delta<0$ to find the values of $\\lambda$ for which each quadratic equation has no zeroes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+6x+\\lambda=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\lambda>9$",
          "worked": "$$\\begin{align*}\\Delta&=6^2-4(1)(\\lambda)\\\\\\Delta&=36-4\\lambda\\\\36-4\\lambda&<0\\\\36&<4\\lambda\\\\\\lambda&>9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\lambda x^2-10x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\lambda>25$",
          "worked": "$$\\begin{align*}\\Delta&=(-10)^2-4(\\lambda)(1)\\\\\\Delta&=100-4\\lambda\\\\100-4\\lambda&<0\\\\100&<4\\lambda\\\\\\lambda&>25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x^2-5x+(\\lambda+3)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\lambda>\\frac18$",
          "worked": "$$\\begin{align*}\\Delta&=(-5)^2-4(2)(\\lambda+3)\\\\\\Delta&=25-8\\lambda-24\\\\\\Delta&=1-8\\lambda\\\\1-8\\lambda&<0\\\\1&<8\\lambda\\\\\\lambda&>\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$(\\lambda-1)x^2+6x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\lambda>4$",
          "worked": "$$\\begin{align*}\\Delta&=6^2-4(\\lambda-1)(3)\\\\\\Delta&=36-12\\lambda+12\\\\\\Delta&=48-12\\lambda\\\\48-12\\lambda&<0\\\\48&<12\\lambda\\\\\\lambda&>4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
