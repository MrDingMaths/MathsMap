  "content": {
    "id": "p15-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "On a farm the ratio of horses to cows is $3:2$ and the ratio of cows to goats is $4:3$. Find the ratio of goats to horses.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1:2$\n\nMatch the cow parts to combine the two ratios.",
      "worked": "Match the number of cow parts.\n\n$$\\begin{align*}\\text{horses}:\\text{cows}&=3:2\\\\\\text{horses}:\\text{cows}&=6:4\\end{align*}$$\n\nSince cows to goats is $4:3$, horses to cows to goats is $6:4:3$.\n\n$$\\begin{align*}\\text{goats}:\\text{horses}&=3:6\\\\\\text{goats}:\\text{horses}&=1:2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
