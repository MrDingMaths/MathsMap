        "answer": {
          "short": "\\$3681.17/month",
          "worked": "$$\\begin{align*}\\text{Annual income} &= \\$849.50\\times52\\\\ &= \\$44\\,174.00\\\\ \\text{Monthly pay} &= \\frac{\\$44\\,174.00}{12}\\\\ &\\approx \\$3681.17/\\text{month}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
