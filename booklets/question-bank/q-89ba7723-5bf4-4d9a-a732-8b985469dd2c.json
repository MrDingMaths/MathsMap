      {
        "id": "p36-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "\\$420 weekly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1820.00/month",
          "worked": "$$\\begin{align*}\\text{Annual income} &= \\$420\\times52\\\\ &= \\$21\\,840\\\\ \\text{Monthly pay} &= \\frac{\\$21\\,840}{12}\\\\ &= \\$1820.00/\\text{month}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p36-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "\\$620 weekly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$2686.67/month",
          "worked": "$$\\begin{align*}\\text{Annual income} &= \\$620\\times52\\\\ &= \\$32\\,240\\\\ \\text{Monthly pay} &= \\frac{\\$32\\,240}{12}\\\\ &\\approx \\$2686.67/\\text{month}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p36-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "\\$1123.20 weekly",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$4867.20/month",
          "worked": "$$\\begin{align*}\\text{Annual income} &= \\$1123.20\\times52\\\\ &= \\$58\\,406.40\\\\ \\text{Monthly pay} &= \\frac{\\$58\\,406.40}{12}\\\\ &= \\$4867.20/\\text{month}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p36-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "\\$849.50 weekly.",
