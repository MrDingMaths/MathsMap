  "content": {
    "id": "p31-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "If $x^3+ax^2+bx-4$ is exactly divisible by $x+4$ and $x-1$, find the values of $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p31-q9-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "a=4,\\quad b=-1",
