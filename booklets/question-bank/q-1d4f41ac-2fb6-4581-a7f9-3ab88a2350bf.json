    "id": "p39-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "$\\underset{\\sim}{a}=ki+3j$ where $k>0$. If $|\\underset{\\sim}{a}|=5$, find the unit vector in the same direction $\\underset{\\sim}{\\hat a}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\underset{\\sim}{\\hat a}=\\dfrac15(4i+3j)$",
      "worked": "$$\\begin{aligned}|\\underset{\\sim}{a}|^2&=k^2+9=25\\\\k^2&=16\\\\k&=4\\quad\\text{(since }k>0\\text{)}\\\\\\underset{\\sim}{a}&=4i+3j\\\\\\underset{\\sim}{\\hat a}&=\\frac15(4i+3j)\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
