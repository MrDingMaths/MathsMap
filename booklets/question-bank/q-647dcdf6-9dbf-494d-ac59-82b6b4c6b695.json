    "label": "7",
    "prompt": "Rachel’s birthday cake is cut into eight equal pieces. Rachel eats six pieces.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage did Rachel eat?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75\\%$",
          "worked": "$$\\begin{align*}\\frac{6}{8}&=\\frac{3}{4}\\\\\\frac{6}{8}&=\\frac{75}{100}\\\\\\frac{6}{8}&=75\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p34-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage of the cake remains?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$",
          "worked": "$$\\begin{align*}\\text{Cake remaining}&=100\\%-75\\%\\\\\\text{Cake remaining}&=25\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
