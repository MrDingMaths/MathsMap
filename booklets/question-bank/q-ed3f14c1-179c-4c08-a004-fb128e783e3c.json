  "content": {
    "id": "p32-q8",
    "type": "question",
    "label": "8",
    "prompt": "Find the component of $\\underset{\\sim}{a}$ in the direction of $\\underset{\\sim}{b}$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=\\mathbf{i}+\\mathbf{j},\\quad \\underset{\\sim}{b}=3\\mathbf{i}+\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac65\\mathbf{i}+\\dfrac25\\mathbf{j}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=1(3)+1(1)=4\\\\|\\underset{\\sim}{b}|^2&=3^2+1^2=10\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac4{10}(3\\mathbf{i}+\\mathbf{j})\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac65\\mathbf{i}+\\frac25\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{a}=4\\mathbf{i}-3\\mathbf{j},\\quad \\underset{\\sim}{b}=6\\mathbf{i}+2\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27}{10}\\mathbf{i}+\\dfrac9{10}\\mathbf{j}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=4(6)+(-3)(2)=18\\\\|\\underset{\\sim}{b}|^2&=6^2+2^2=40\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac{18}{40}(6\\mathbf{i}+2\\mathbf{j})\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac9{20}(6\\mathbf{i}+2\\mathbf{j})\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac{27}{10}\\mathbf{i}+\\frac9{10}\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
