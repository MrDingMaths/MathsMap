  "content": {
    "id": "p12-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Consider the graph of $y=(x-2)(x-4)$. Find the equation of the resulting curve after this graph is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "reflected in the $x$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-2)(x-4)$",
          "worked": "Reflection in the $x$-axis changes the sign of each $y$-coordinate.\n$$\\begin{align*}y&=-(x-2)(x-4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "reflected in the $y$-axis",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+2)(x+4)$",
          "worked": "Reflection in the $y$-axis replaces $x$ by $-x$.\n$$\\begin{align*}y&=(-x-2)(-x-4)\\\\y&=(x+2)(x+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p12-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "rotated by $180^\\circ$ about the origin.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x+2)(x+4)$",
          "worked": "A half-turn about the origin maps $(x,y)$ to $(-x,-y)$, combining reflections in both axes.\n$$\\begin{align*}y&=-(-x-2)(-x-4)\\\\y&=-(x+2)(x+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
