      {
        "id": "v2-a3345-p37-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f''(x)=-8\\sin 2x$ and $f'(0)=3$, $f(0)=5$, find $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=2\\sin 2x-x+5$",
          "worked": "$$\\begin{align*}f''(x)&=-8\\sin 2x\\\\f'(x)&=4\\cos 2x+C_1\\end{align*}$$\nUsing $f'(0)=3$:\n$$\\begin{align*}4+C_1&=3\\\\C_1&=-1\\\\f'(x)&=4\\cos 2x-1\\\\f(x)&=2\\sin 2x-x+C_2\\end{align*}$$\nUsing $f(0)=5$:\n$$\\begin{align*}0-0+C_2&=5\\\\f(x)&=2\\sin 2x-x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-a3345-p37-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "If $f''(x)=\\sin\\left(\\frac{x}{2}\\right)$ and $f'(\\pi)=3$, $f(\\pi)=3\\pi-1$, find $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=-4\\sin\\left(\\frac{x}{2}\\right)+3x+3$",
          "worked": "$$\\begin{align*}f''(x)&=\\sin\\left(\\frac{x}{2}\\right)\\\\f'(x)&=-2\\cos\\left(\\frac{x}{2}\\right)+C_1\\end{align*}$$\nUsing $f'(\\pi)=3$:\n$$\\begin{align*}-2\\cos\\frac{\\pi}{2}+C_1&=3\\\\C_1&=3\\\\f'(x)&=-2\\cos\\left(\\frac{x}{2}\\right)+3\\\\f(x)&=-4\\sin\\left(\\frac{x}{2}\\right)+3x+C_2\\end{align*}$$\nUsing $f(\\pi)=3\\pi-1$:\n$$\\begin{align*}-4\\sin\\frac{\\pi}{2}+3\\pi+C_2&=3\\pi-1\\\\-4+C_2&=-1\\\\C_2&=3\\\\f(x)&=-4\\sin\\left(\\frac{x}{2}\\right)+3x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
