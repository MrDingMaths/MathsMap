  "content": {
    "id": "p10-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A parabola has roots at $x=1$ and $x=-3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q11-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p10-q11-a-intro",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "The intercept-form of the parabola is",
                  "marks": []
                }
              ]
            },
            {
              "id": "p10-q11-a-formula",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "y=a(x-\\alpha)(x-\\beta).",
                  "display": true
                }
              ]
            },
            {
              "id": "p10-q11-a-task",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "State the value of two of the unknowns.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha=1$, $\\beta=-3$ (or interchanged).",
          "worked": "In intercept form, $\\alpha$ and $\\beta$ are the roots. Thus $\\alpha=1$ and $\\beta=-3$, or vice versa.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "The parabola also passes through the point $(0,-6)$. Find the value of the last pronumeral.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$.",
          "worked": "$$\\begin{align*}y&=a(x-1)(x+3)\\\\-6&=a(0-1)(0+3)\\\\-6&=-3a\\\\a&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p10-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, state the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2(x-1)(x+3)$.",
          "worked": "Substituting $a=2$, $\\alpha=1$ and $\\beta=-3$ into intercept form gives $y=2(x-1)(x+3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
