  "content": {
    "id": "p108-q69-response",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the circle that passes through $(2,4)$, $(7,-1)$, and $(-2,2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p108-q69-short-result",
            "type": "paragraph",
            "fontSize": null,
