        "id": "p43-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{x-2}{x+2}\\,dx$, $x=u-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)-4\\ln|x+2|+C$",
          "worked": "$x=u-2$, so $u=x+2$ and $dx=du$.\n$$\\begin{aligned}\\int\\frac{x-2}{x+2}\\,dx&=\\int\\frac{u-4}{u}\\,du\\\\&=\\int\\left(1-\\frac4u\\right)\\,du\\\\&=u-4\\ln|u|+C\\\\&=(x+2)-4\\ln|x+2|+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p43-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{2x+1}{\\sqrt{2x-1}}\\,dx$, $x=\\frac12(u+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13(2x-1)^{3/2}+2\\sqrt{2x-1}+C$",
          "worked": "$x=\\frac12(u+1)$, so $u=2x-1$ and $dx=\\frac12\\,du$.\n$$\\begin{aligned}\\int\\frac{2x+1}{\\sqrt{2x-1}}\\,dx&=\\frac12\\int\\frac{u+2}{\\sqrt u}\\,du\\\\&=\\frac12\\int\\left(u^{1/2}+2u^{-1/2}\\right)\\,du\\\\&=\\frac13u^{3/2}+2u^{1/2}+C\\\\&=\\frac13(2x-1)^{3/2}\\\\&\\quad+2\\sqrt{2x-1}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
