        "type": "part",
        "label": "a",
        "prompt": "Evaluate the integral $\\displaystyle\\int_N^0 e^x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-e^N$",
          "worked": "$$\\begin{align*}\\int_N^0 e^x\\,dx&=\\left[e^x\\right]_N^0\\\\&=1-e^N\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p42-q22b",
        "type": "part",
        "label": "b",
        "prompt": "What is its limit as $N\\to-\\infty$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "As $N\\to-\\infty$, $e^N\\to0$.\n$$\\lim_{N\\to-\\infty}(1-e^N)=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
