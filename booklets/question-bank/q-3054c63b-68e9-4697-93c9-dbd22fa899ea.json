  "content": {
    "id": "p20-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Solve the following for $\\theta\\in[0,2\\pi]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\sin^2\\theta+\\sin\\theta=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0,\\pi,\\frac{7\\pi}{6},\\frac{11\\pi}{6},2\\pi$.",
          "worked": "$$\\begin{align*}\\sin\\theta(2\\sin\\theta+1)&=0\\\\\\sin\\theta&=0\\quad\\text{or}\\quad-\\frac{1}{2}\\\\\\theta&=0,\\ \\pi,\\ \\frac{7\\pi}{6},\\ \\frac{11\\pi}{6},\\ 2\\pi\\end{align*}$$\nThe solutions include both endpoints of the interval.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p20-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\sin^2\\theta-3\\sin\\theta+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{\\pi}{6},\\frac{\\pi}{2},\\frac{5\\pi}{6}$.",
          "worked": "$$\\begin{align*}(2\\sin\\theta-1)(\\sin\\theta-1)&=0\\\\\\sin\\theta&=\\frac{1}{2}\\quad\\text{or}\\quad1\\\\\\theta&=\\frac{\\pi}{6},\\ \\frac{\\pi}{2},\\ \\frac{5\\pi}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p20-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sin^2\\theta-5\\sin\\theta+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{\\pi}{2}$.",
          "worked": "$$\\begin{align*}(2\\sin\\theta-3)(\\sin\\theta-1)&=0\\\\\\sin\\theta&=\\frac{3}{2}\\quad\\text{or}\\quad1\\end{align*}$$\nReject $\\sin\\theta=\\frac{3}{2}$ since $-1\\leq\\sin\\theta\\leq1$. Hence $\\theta=\\frac{\\pi}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin^2\\theta=2\\cos\\theta+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\pi$.\n\nUse $\\sin^2\\theta=1-\\cos^2\\theta$ to obtain a quadratic in $\\cos\\theta$.",
          "worked": "$$\\begin{align*}1-\\cos^2\\theta&=2\\cos\\theta+2\\\\\\cos^2\\theta+2\\cos\\theta+1&=0\\\\(\\cos\\theta+1)^2&=0\\\\\\cos\\theta&=-1\\\\\\theta&=\\pi\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
