  "content": {
    "id": "p65-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "If $x>3$ and $y<5$, work out if the following expressions are positive or negative.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p65-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "$3-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Negative.",
          "worked": "Since $x>3$, $3-x<0$. The expression is negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p65-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{y-5}{3-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Positive; dividing two negatives gives a positive.",
          "worked": "Since $y<5$, $y-5<0$. Since $x>3$, $3-x<0$. Dividing two negatives gives a positive result.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p65-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x-3)(5-y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Positive; multiplying two positives gives a positive.",
          "worked": "Since $x>3$, $x-3>0$. Since $y<5$, $5-y>0$. Multiplying two positives gives a positive result.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p65-q22-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3-x)^2(5-y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Positive; $(3-x)^2>0$ since $x>3$, and $5-y>0$.",
          "worked": "Since $x>3$, $3-x$ is negative. Squaring multiplies this negative by itself, so $(3-x)^2>0$. Since $y<5$, $5-y>0$. Multiplying the two positive factors gives a positive result.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
