    "type": "question",
    "label": "4",
    "prompt": "For each equation, complete the square and show that the equation has no solution.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+8x+18=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution: $(x+4)^2=-2$.",
          "worked": "$$\\begin{align*}x^2+8x+16-16+18&=0\\\\(x+4)^2+2&=0\\\\(x+4)^2&=-2\\end{align*}$$\nSince $(x+4)^2\\geq0$ for every real $x$, there is no real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-4x+6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution: $(x-2)^2=-2$.",
          "worked": "$$\\begin{align*}x^2-4x+4-4+6&=0\\\\(x-2)^2+2&=0\\\\(x-2)^2&=-2\\end{align*}$$\nSince $(x-2)^2\\geq0$ for every real $x$, there is no real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p18-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+2x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution: $(x+1)^2=-3$.",
          "worked": "$$\\begin{align*}x^2+2x+1-1+4&=0\\\\(x+1)^2+3&=0\\\\(x+1)^2&=-3\\end{align*}$$\nSince $(x+1)^2\\geq0$ for every real $x$, there is no real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p18-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution: $\\left(x+\\frac12\\right)^2=-\\frac74$.",
          "worked": "$$\\begin{align*}x^2+x+\\frac14-\\frac14+2&=0\\\\\\left(x+\\frac12\\right)^2+\\frac74&=0\\\\\\left(x+\\frac12\\right)^2&=-\\frac74\\end{align*}$$\nSince $\\left(x+\\frac12\\right)^2\\geq0$ for every real $x$, there is no real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p18-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2+2x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution: $(x+1)^2=-1$.",
          "worked": "$$\\begin{align*}x^2+2x+1-1+2&=0\\\\(x+1)^2+1&=0\\\\(x+1)^2&=-1\\end{align*}$$\nSince $(x+1)^2\\geq0$ for every real $x$, there is no real solution.",
          "solutionDiagrams": []
