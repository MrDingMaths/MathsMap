  "content": {
    "id": "p24-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A vat is designed by rotating about the $x$-axis the region between the curve $y=1+\\dfrac1x$ and the $x$-axis from $x=\\dfrac12$ to $x=3$. Show that its volume is $\\dfrac{\\pi}{6}(25+12\\ln6)\\text{ u}^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$V=\\dfrac{\\pi}{6}(25+12\\ln6)\\text{ u}^3$.",
      "worked": "$$\\begin{aligned}V&=\\pi\\int_{1/2}^3\\left(1+\\frac1x\\right)^2\\,dx\\\\&=\\pi\\int_{1/2}^3\\left(1+\\frac2x+\\frac1{x^2}\\right)\\,dx\\\\&=\\pi\\left[x+2\\ln x-\\frac1x\\right]_{1/2}^3\\\\&=\\pi\\left[\\left(\\frac83+2\\ln3\\right)-\\left(-\\frac32-2\\ln2\\right)\\right]\\\\&=\\pi\\left(\\frac{25}{6}+2\\ln6\\right)\\\\&=\\frac{\\pi}{6}(25+12\\ln6)\\text{ u}^3.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
