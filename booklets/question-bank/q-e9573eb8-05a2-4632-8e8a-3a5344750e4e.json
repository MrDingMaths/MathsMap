  "content": {
    "id": "p32-q18-root",
    "type": "question",
    "label": null,
    "prompt": "Solve the following quadratic inequalities.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+3)(x-2)\\geq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq-3$ or $x\\geq2$.",
          "worked": "$$\\begin{align*}(x+3)(x-2)&=0\\\\x&=-3\\text{ or }2\\end{align*}$$\nThe quadratic opens upwards, so it is non-negative outside the roots, including the roots. Thus $x\\leq-3$ or $x\\geq2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p32-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2-3x)(x+4)>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4<x<\\dfrac23$.",
          "worked": "$$\\begin{align*}(2-3x)(x+4)&=0\\\\x&=\\frac23\\text{ or }-4\\end{align*}$$\nThe quadratic opens downwards, so it is positive between the roots. Thus $-4<x<\\dfrac23$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p32-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+9x+20\\leq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5\\leq x\\leq-4$.",
          "worked": "$$\\begin{align*}x^2+9x+20&=(x+5)(x+4)\\\\(x+5)(x+4)&=0\\\\x&=-5\\text{ or }-4\\end{align*}$$\nThe quadratic opens upwards, so it is non-positive between the roots, including the roots. Thus $-5\\leq x\\leq-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p32-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$6+x-x^2\\geq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\leq x\\leq3$.",
          "worked": "$$\\begin{align*}6+x-x^2&=-(x-3)(x+2)\\\\-(x-3)(x+2)&=0\\\\x&=-2\\text{ or }3\\end{align*}$$\nThe quadratic opens downwards, so it is non-negative between the roots, including the roots. Thus $-2\\leq x\\leq3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p32-q18-e",
        "type": "part",
        "label": "e",
        "prompt": "$4x^2+12x-7>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-\\dfrac72$ or $x>\\dfrac12$.",
          "worked": "$$\\begin{align*}4x^2+12x-7&=(2x+7)(2x-1)\\\\(2x+7)(2x-1)&=0\\\\x&=-\\frac72\\text{ or }\\frac12\\end{align*}$$\nThe quadratic opens upwards, so it is positive outside the roots. Thus $x<-\\dfrac72$ or $x>\\dfrac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p32-q18-f",
        "type": "part",
        "label": "f",
        "prompt": "$2+3x-9x^2>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac13<x<\\dfrac23$.",
          "worked": "$$\\begin{align*}2+3x-9x^2&=(2-3x)(3x+1)\\\\(2-3x)(3x+1)&=0\\\\x&=-\\frac13\\text{ or }\\frac23\\end{align*}$$\nThe quadratic opens downwards, so it is positive between the roots. Thus $-\\dfrac13<x<\\dfrac23$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
