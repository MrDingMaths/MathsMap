      {
        "id": "p47-q27-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{x}{x+2}=1-\\dfrac{2}{x+2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-\\dfrac{2}{x+2}=\\dfrac{x+2-2}{x+2}=\\dfrac{x}{x+2}$.",
          "worked": "$$\\begin{aligned}1-\\frac{2}{x+2}&=\\frac{x+2-2}{x+2}\\\\&=\\frac{x}{x+2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p47-q27-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence solve the IVP $(x+2)y'-xy=0$ with $y(0)=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{4e^x}{(x+2)^2}$, $x>-2$.",
          "worked": "$$\\begin{aligned}\\frac{y'}{y}&=\\frac{x}{x+2}\\\\&=1-\\frac{2}{x+2}\\\\\\int\\frac{1}{y}\\,dy&=\\int\\left(1-\\frac{2}{x+2}\\right)dx\\\\\\log|y|&=x-2\\log|x+2|+C\\\\y&=\\frac{Ae^x}{(x+2)^2}\\end{aligned}$$\nSubstituting $x=0$, $y=1$:\n$$\\begin{aligned}1&=\\frac{A}{4}\\\\A&=4\\\\y&=\\frac{4e^x}{(x+2)^2}\\end{aligned}$$\nThe interval containing the initial point is $x>-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
