  "content": {
    "id": "p12-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A spherical bubble of radius $r$ is shrinking so that its volume $V$ is decreasing at a constant rate of $200\\text{ cm}^3/\\text{s}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{dV}{dt}=4\\pi r^2\\left(\\dfrac{dr}{dt}\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dV}{dt}=4\\pi r^2\\dfrac{dr}{dt}$.",
          "worked": "$$\\begin{align*}V&=\\frac43\\pi r^3\\\\\\frac{dV}{dr}&=4\\pi r^2\\\\\\frac{dV}{dt}&=\\frac{dV}{dr}\\times\\frac{dr}{dt}\\\\\\frac{dV}{dt}&=4\\pi r^2\\frac{dr}{dt}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "At what rate is its radius decreasing when the radius is $5\\text{ cm}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Decreasing at $\\dfrac{2}{\\pi}\\text{ cm/s}$.",
          "worked": "The volume is decreasing, so $\\dfrac{dV}{dt}=-200\\text{ cm}^3/\\text{s}$. When $r=5\\text{ cm}$,\n$$\\begin{align*}-200&=4\\pi(5)^2\\frac{dr}{dt}\\\\\\frac{dr}{dt}&=-\\frac{200}{100\\pi}\\\\\\frac{dr}{dt}&=-\\frac2\\pi\\text{ cm/s}.\\end{align*}$$\nThe radius is decreasing at $\\dfrac2\\pi\\text{ cm/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the radius when the radius is decreasing at $2\\pi\\text{ cm/s}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac5\\pi\\text{ cm}$.",
          "worked": "Here $\\dfrac{dr}{dt}=-2\\pi\\text{ cm/s}$ and $\\dfrac{dV}{dt}=-200\\text{ cm}^3/\\text{s}$.\n$$\\begin{align*}-200&=4\\pi r^2(-2\\pi)\\\\r^2&=\\frac{25}{\\pi^2}\\\\r&=\\frac5\\pi\\text{ cm}.\\end{align*}$$\nTake the positive root because $r$ is a radius.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p12-q10-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
