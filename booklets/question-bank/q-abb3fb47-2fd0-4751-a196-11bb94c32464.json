  "content": {
    "id": "p26-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "For each value of $x$, find $(x-1)^2$ and simplify.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=3a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9a^2-6a+1$",
          "worked": "$$\\begin{align*}(x-1)^2&=(3a-1)^2\\\\(x-1)^2&=(3a)^2-2\\times3a\\times1+1^2\\\\(x-1)^2&=9a^2-6a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=-2b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4b^2+4b+1$",
          "worked": "$$\\begin{align*}(x-1)^2&=(-2b-1)^2\\\\(x-1)^2&=(-2b)^2-2\\times(-2b)\\times1+1^2\\\\(x-1)^2&=4b^2+4b+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=2a+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2$",
          "worked": "$$\\begin{align*}(x-1)^2&=(2a+1-1)^2\\\\(x-1)^2&=(2a)^2\\\\(x-1)^2&=4a^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=-4b+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16b^2-8b+1$",
          "worked": "$$\\begin{align*}(x-1)^2&=(-4b+2-1)^2\\\\(x-1)^2&=(-4b+1)^2\\\\(x-1)^2&=(-4b)^2+2\\times(-4b)\\times1+1^2\\\\(x-1)^2&=16b^2-8b+1\\end{align*}$$",
          "solutionDiagrams": []
        },
