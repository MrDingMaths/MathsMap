  "content": {
    "id": "p41-q1-root",
    "type": "question",
    "label": null,
    "prompt": "Often a pattern emerges when a function is composed with itself. Let $f(x)=x+2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q1-a",
        "type": "group",
        "label": "a",
        "prompt": "Evaluate the following.",
