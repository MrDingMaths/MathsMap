        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p41-q1-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$f(0)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$$\\begin{align*}f(0)&=0+2\\\\f(0)&=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          },
          {
            "id": "p41-q1-a-ii",
            "type": "part",
            "label": "ii",
