            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(2)=4$",
              "worked": "$$\\begin{align*}f(f(0))&=f(2)\\\\f(f(0))&=2+2\\\\f(f(0))&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p41-q1-a-iii",
