        "label": "a",
        "prompt": "$\\sin(90^{\\circ}-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta$",
          "worked": "$$\\begin{align*}\\sin(90^{\\circ}-\\theta)&=\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sec(90^{\\circ}-\\alpha)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{cosec}\\alpha$",
          "worked": "$$\\begin{align*}\\sec(90^{\\circ}-\\alpha)&=\\operatorname{cosec}\\alpha\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{\\cot(90^{\\circ}-\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\beta$",
          "worked": "$$\\begin{align*}\\frac{1}{\\cot(90^{\\circ}-\\beta)}&=\\frac{1}{\\tan\\beta}\\\\\\frac{1}{\\cot(90^{\\circ}-\\beta)}&=\\cot\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\cos(90^{\\circ}-\\phi)}{\\sin(90^{\\circ}-\\phi)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\phi$",
          "worked": "$$\\begin{align*}\\frac{\\cos(90^{\\circ}-\\phi)}{\\sin(90^{\\circ}-\\phi)}&=\\frac{\\sin\\phi}{\\cos\\phi}\\\\\\frac{\\cos(90^{\\circ}-\\phi)}{\\sin(90^{\\circ}-\\phi)}&=\\tan\\phi\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sec\\theta-\\operatorname{cosec}(90^{\\circ}-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\sec\\theta-\\operatorname{cosec}(90^{\\circ}-\\theta)&=\\sec\\theta-\\sec\\theta\\\\\\sec\\theta-\\operatorname{cosec}(90^{\\circ}-\\theta)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan70^{\\circ}+\\cot20^{\\circ}-2\\tan70^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\cot20^{\\circ}&=\\tan70^{\\circ}\\end{align*}$$\n$$\\begin{align*}\\tan70^{\\circ}+\\cot20^{\\circ}-2\\tan70^{\\circ}&=\\tan70^{\\circ}+\\tan70^{\\circ}-2\\tan70^{\\circ}\\\\\\tan70^{\\circ}+\\cot20^{\\circ}-2\\tan70^{\\circ}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\sin55^{\\circ}}{\\cos35^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{\\sin55^{\\circ}}{\\cos35^{\\circ}}&=\\frac{\\cos35^{\\circ}}{\\cos35^{\\circ}}\\\\\\frac{\\sin55^{\\circ}}{\\cos35^{\\circ}}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\cot25^{\\circ}+\\tan65^{\\circ}}{\\cot25^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{\\cot25^{\\circ}+\\tan65^{\\circ}}{\\cot25^{\\circ}}&=\\frac{\\cot25^{\\circ}+\\cot25^{\\circ}}{\\cot25^{\\circ}}\\\\\\frac{\\cot25^{\\circ}+\\tan65^{\\circ}}{\\cot25^{\\circ}}&=\\frac{2\\cot25^{\\circ}}{\\cot25^{\\circ}}\\\\\\frac{\\cot25^{\\circ}+\\tan65^{\\circ}}{\\cot25^{\\circ}}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
