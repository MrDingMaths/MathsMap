        "label": "a",
        "prompt": "$\\displaystyle\\int_0^{\\pi/2}\\frac{\\sin 2x}{1+\\sin^2x}\\,dx,\\qquad u=\\sin^2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln 2$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p40-q11-a-working-layout",
                "type": "layout",
                "arrangement": "parallel",
                "title": "",
                "border": false,
                "padding": 3,
                "margin": 3,
                "gap": 3,
                "columns": 2,
                "slots": [
                  {
                    "id": "p40-q11-a-main",
                    "blocks": [
                      {
                        "id": "p40-q11-a-main-equations",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\int_0^{\\pi/2}\\frac{\\sin 2x}{1+\\sin^2x}\\,dx&=\\int_0^1\\frac{1}{1+u}\\,du\\\\&=\\left[\\ln(1+u)\\right]_0^1\\\\&=\\ln 2.\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p40-q11-a-substitution",
                    "blocks": [
                      {
                        "id": "p40-q11-a-substitution-equations",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}u&=\\sin^2x\\\\\\frac{du}{dx}&=2\\sin x\\cos x\\\\&=\\sin 2x\\\\dx&=\\frac{du}{2\\sin x\\cos x}\\\\x=0 &: u=0\\\\x=\\frac{\\pi}{2} &: u=1.\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 59
      },
      {
        "id": "p40-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^e\\frac{\\ln x+1}{(x\\ln x+1)^2}\\,dx,\\qquad u=x\\ln x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{e}{e+1}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p40-q11-b-working-layout",
                "type": "layout",
                "arrangement": "parallel",
                "title": "",
                "border": false,
                "padding": 3,
                "margin": 3,
                "gap": 3,
                "columns": 2,
                "slots": [
                  {
                    "id": "p40-q11-b-main",
                    "blocks": [
                      {
                        "id": "p40-q11-b-main-equations",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\int_1^e\\frac{\\ln x+1}{(x\\ln x+1)^2}\\,dx&=\\int_0^e(u+1)^{-2}\\,du\\\\&=\\left[-\\frac{1}{u+1}\\right]_0^e\\\\&=-\\frac{1}{e+1}+1\\\\&=\\frac{e}{e+1}.\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p40-q11-b-substitution",
                    "blocks": [
                      {
                        "id": "p40-q11-b-substitution-equations",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}u&=x\\ln x\\\\\\frac{du}{dx}&=\\ln x+1\\\\dx&=\\frac{du}{\\ln x+1}\\\\x=1 &: u=0\\\\x=e &: u=e.\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
