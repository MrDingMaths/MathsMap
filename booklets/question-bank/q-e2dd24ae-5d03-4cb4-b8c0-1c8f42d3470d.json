    "type": "question",
    "label": null,
    "prompt": "Priya has read $37.5\\%$ of a 240-page book. Liam has read $\\dfrac{2}{5}$ of a 230-page book. Who has read more pages, and by how many?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Liam has read more, by 2 pages (92 pages compared with 90).",
      "worked": "$$\\begin{align*}\\text{Priya: }37.5\\%\\text{ of }240&=0.375\\times240\\\\&=90\\\\\\text{Liam: }\\tfrac{2}{5}\\text{ of }230&=230\\div5\\times2\\\\&=46\\times2\\\\&=92\\\\92-90&=2\\end{align*}$$",
      "solutionDiagrams": []
    },
