  "content": {
    "id": "p73-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A sports committee of five members is to be chosen from eight AFL footballers and seven soccer players. Find the probability that the committee will contain:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p73-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "only AFL footballers,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8}{429}$",
          "worked": "Choose all five members from the eight AFL footballers.\n$$\\begin{aligned}P&=\\frac{\\binom{8}{5}}{\\binom{15}{5}}\\\\&=\\frac{56}{3003}\\\\&=\\frac{8}{429}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p73-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "only soccer players,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{143}$",
          "worked": "Choose all five members from the seven soccer players.\n$$\\begin{aligned}P&=\\frac{\\binom{7}{5}}{\\binom{15}{5}}\\\\&=\\frac{21}{3003}\\\\&=\\frac{1}{143}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p73-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "three soccer players and two AFL footballers,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{140}{429}$",
          "worked": "Choose three of the seven soccer players and two of the eight AFL footballers.\n$$\\begin{aligned}P&=\\frac{\\binom{7}{3}\\times\\binom{8}{2}}{\\binom{15}{5}}\\\\&=\\frac{980}{3003}\\\\&=\\frac{140}{429}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p73-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "at least one soccer player,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{421}{429}$",
          "worked": "The complement is a committee containing only AFL footballers.\n$$\\begin{aligned}P(\\text{at least one soccer player})&=1-\\frac{8}{429}\\\\&=\\frac{421}{429}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p73-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "at most one soccer player,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{11}$",
          "worked": "The disjoint cases are no soccer players or one soccer player and four AFL footballers.\n$$\\begin{aligned}P&=\\frac{\\binom{8}{5}+\\binom{7}{1}\\times\\binom{8}{4}}{\\binom{15}{5}}\\\\&=\\frac{56+490}{3003}\\\\&=\\frac{2}{11}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p73-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "Ian, a particular soccer player.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3}$",
          "worked": "Include Ian and choose the other four members from the remaining fourteen players.\n$$\\begin{aligned}P&=\\frac{\\binom{14}{4}}{\\binom{15}{5}}\\\\&=\\frac{1001}{3003}\\\\&=\\frac{1}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
