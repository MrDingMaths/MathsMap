    "type": "question",
    "label": null,
    "prompt": "In a survey of 600 Year 9 students, 85% own a mobile phone.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-268748-p7-practice-j5-090234-j5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage of the students do not own a mobile phone?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\%$",
          "worked": "$$\\begin{align*}100\\%-85\\%&=15\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
