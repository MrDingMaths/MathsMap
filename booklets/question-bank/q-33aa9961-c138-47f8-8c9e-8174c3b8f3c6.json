        "label": "b",
        "prompt": "How many students do not own a mobile phone?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "90 students",
          "worked": "$$\\begin{align*}15\\%\\times600&=0.15\\times600\\\\&=90\\end{align*}$$\n90 students do not own a mobile phone.",
