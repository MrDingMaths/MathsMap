    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x+\\dfrac{2x+1}{x^2-2}$",
      "worked": "$$\\begin{align*}(x^3+1)-x(x^2-2)&=2x+1\\\\x^3+1&=x(x^2-2)+(2x+1)\\\\\\frac{x^3+1}{x^2-2}&=x+\\frac{2x+1}{x^2-2}\\end{align*}$$",
