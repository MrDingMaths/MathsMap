    "id": "p20-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find $a$ in terms of $b$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^2-5ab+6b^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2b$ or $a=3b$.",
          "worked": "$$\\begin{align*}a^2-5ab+6b^2&=0\\\\(a-2b)(a-3b)&=0\\end{align*}$$\nBy the null factor law,\n$$\\begin{align*}a-2b&=0\\quad\\text{or}\\quad a-3b=0\\\\a&=2b\\quad\\text{or}\\quad a=3b.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$3a^2+5ab-2b^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-2b$ or $a=\\frac{b}{3}$.",
          "worked": "$$\\begin{align*}3a^2+5ab-2b^2&=0\\\\3a^2+6ab-ab-2b^2&=0\\\\3a(a+2b)-b(a+2b)&=0\\\\(3a-b)(a+2b)&=0\\end{align*}$$\nBy the null factor law,\n$$\\begin{align*}3a-b&=0\\quad\\text{or}\\quad a+2b=0\\\\a&=\\frac{b}{3}\\quad\\text{or}\\quad a=-2b.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
