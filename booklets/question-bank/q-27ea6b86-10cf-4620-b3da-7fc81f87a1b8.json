        "id": "v2-078cb-p18-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that all three discs are red?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{42}$",
          "worked": "$$\\begin{align*}P(R,R,R)&=\\frac{5}{9}\\times\\frac{4}{8}\\times\\frac{3}{7}\\\\&=\\frac{60}{504}\\\\&=\\frac{5}{42}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-078cb-p18-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that exactly two of the discs are red?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{21}$",
          "worked": "Exactly two red can happen in three orders: $RRG$, $RGR$ and $GRR$.\n$$\\begin{align*}P(R,R,G)&=\\frac{5}{9}\\times\\frac{4}{8}\\times\\frac{4}{7}=\\frac{80}{504}\\\\P(R,G,R)&=\\frac{5}{9}\\times\\frac{4}{8}\\times\\frac{4}{7}=\\frac{80}{504}\\\\P(G,R,R)&=\\frac{4}{9}\\times\\frac{5}{8}\\times\\frac{4}{7}=\\frac{80}{504}\\\\P(\\text{exactly two red})&=\\frac{240}{504}\\\\&=\\frac{10}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
