  "content": {
    "id": "v2-fb14d-p17-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Sketch these graphs to show the transformation. Clearly label the asymptotes and intercepts.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-fb14d-p17-practice-slot-1-lower-slot-1-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$$y=\\frac{1}{x}-2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Asymptotes: $x=0$, $y=-2$. $x$-intercept: $(\\frac12,0)$. No $y$-intercept. Translation 2 units down.",
          "worked": "At $x=0$ the function is undefined, so there is no $y$-intercept. For the $x$-intercept, let $y=0$:\n$$\\begin{align*}0&=\\frac1x-2\\\\2&=\\frac1x\\\\2x&=1\\\\x&=\\frac12\\end{align*}$$\nThe asymptotes are $x=0$ and $y=-2$. Translate $y=\\frac{1}{x}$ down 2 units; the branches lie above-right and below-left of the asymptotes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-fb14d-p17-practice-slot-1-lower-slot-1-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$$y=\\frac{1}{x+2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Asymptotes: $x=-2$, $y=0$. $y$-intercept: $(0,\\frac12)$. No $x$-intercept. Translation 2 units left.",
          "worked": "For the $y$-intercept, let $x=0$:\n$$\\begin{align*}y&=\\frac1{0+2}\\\\y&=\\frac12\\end{align*}$$\nThe numerator is nonzero, so there is no $x$-intercept. The asymptotes are $x=-2$ and $y=0$. Translate $y=\\frac{1}{x}$ left 2 units; the branches lie above-right and below-left of the asymptotes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-fb14d-p17-practice-slot-1-lower-slot-1-lower-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$$y=\\frac{1}{x-2}+1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Asymptotes: $x=2$, $y=1$. Intercepts: $(1,0)$ and $(0,\\frac12)$. Translation 2 units right and 1 unit up.",
          "worked": "For the $y$-intercept, let $x=0$:\n$$\\begin{align*}y&=\\frac1{0-2}+1\\\\y&=\\frac12\\end{align*}$$\nFor the $x$-intercept, let $y=0$:\n$$\\begin{align*}0&=\\frac1{x-2}+1\\\\-1&=\\frac1{x-2}\\\\-x+2&=1\\\\x&=1\\end{align*}$$\nThe asymptotes are $x=2$ and $y=1$. Translate $y=\\frac{1}{x}$ right 2 units and up 1 unit; the branches lie above-right and below-left of the asymptotes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
