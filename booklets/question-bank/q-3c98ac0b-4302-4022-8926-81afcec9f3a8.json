          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "a",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": "  An open rectangular box is to be formed by cutting squares of side length ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x",
              "display": false
            },
            {
              "type": "text",
              "text": " cm from the corners of a rectangular sheet of metal that has length 40 cm and width 15 cm.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the volume of the box is given by $V=600x-110x^2+4x^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=x(40-2x)(15-2x)=600x-110x^2+4x^3$.",
          "worked": "$$\\begin{aligned}V&=l\\times w\\times h\\\\V&=(40-2x)(15-2x)x\\\\V&=x(600-110x+4x^2)\\\\V&=600x-110x^2+4x^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p26-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\dfrac{dV}{dx}$ and hence find the value of $x$ that maximises the volume of the box.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dV}{dx}=600-220x+12x^2$; the maximum occurs at $x=\\dfrac{10}{3}$ cm.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p26-q8-domain",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For a non-degenerate box, ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "0<x<\\frac{15}{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p26-q8-derivative",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{dV}{dx}&=600-220x+12x^2\\\\\\frac{dV}{dx}&=4(150-55x+3x^2)\\\\\\frac{dV}{dx}&=4(3x-10)(x-15)\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p26-q8-stationary",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{dV}{dx}=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " when ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "4(3x-10)(x-15)=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", giving ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=\\frac{10}{3}\\text{ or }15",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". Only ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{10}{3}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " is in the physical domain.",
                    "marks": []
                  }
                ]
              },
