  "content": {
    "id": "p43-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A person of height $h$ metres stands on the surface of Earth, which is assumed to be a sphere of radius $R$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p43-q10-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 43 p43-q10-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0); \\coordinate (S) at (0,1.5); \\coordinate (E) at (0,2.2); \\coordinate (T) at ({1.5*sqrt(1-(1.5/2.2)^2)},{2.25/2.2});\n\\draw[black] (O) circle (1.5);\n\\draw[black] (O)--node[right] {$R$}(S)--node[left] {$h$}(E)--node[above right] {$d$}(T);\n\\fill[black] (O) circle (1.4pt); \\node[left] at (O) {$O$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 45,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 43,
          "sourceRegion": "Question 10 shared Earth diagram",
          "description": "Unfilled schematic globe with latitude and meridian cues, dashed rear latitude portions, centre, observer height, radius and horizon tangent.",
          "mathematics": "The tangent contact is derived from R=1.5 and observer distance 2.2 in schematic coordinates. Height is exaggerated; these drawing coordinates are not additional givens.",
          "answerVisibility": "Only source labels O, R, h and d are visible. Decorative pale cyan fill is omitted."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p43-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the distance, $d$, to the horizon is given by $d=\\sqrt{h^2+2hR}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d^2=h(h+2R)=h^2+2hR$, so $d=\\sqrt{h^2+2hR}$.",
          "worked": "The square of a tangent from an external point equals the product of the two secant intercepts. The secant through Earth's centre has intercepts $h$ and $h+2R$.\n$$\\begin{align*}d^2&=h(h+2R)\\\\d^2&=h^2+2hR\\\\d&=\\sqrt{h^2+2hR}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p43-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the straight-line distance to the horizon that can be seen by a person of height $1.8\\text{ m}$. Use $R=6400\\text{ km}$. Give your answer in metres to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4800.00\\text{ m}$.",
          "worked": "$R=6400\\text{ km}=6\\,400\\,000\\text{ m}$.\n$$\\begin{align*}d&=\\sqrt{1.8^2+2(1.8)(6\\,400\\,000)}\\\\d&=\\sqrt{23\\,040\\,003.24}\\\\d&\\approx4800.00\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p43-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "The formula in part a is often given as $d\\approx\\sqrt{2hR}$. Why might this be the case?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h^2$ is extremely small compared with $2hR$.",
          "worked": "A person's height is extremely small compared with Earth's radius, so $h^2$ is negligible compared with $2hR$. Thus $h^2+2hR\\approx2hR$ and $d\\approx\\sqrt{2hR}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
