  "content": {
    "id": "p5-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify each expression, writing each pronumeral in the answer with a positive index.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3m^3)^2\\times2m^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18m^{12}$",
          "worked": "$$\\begin{align*}(3m^3)^2\\times2m^6&=9m^6\\times2m^6\\\\(3m^3)^2\\times2m^6&=18m^{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2p^5)^2\\div(4p^6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^4$",
          "worked": "$$\\begin{align*}(2p^5)^2\\div(4p^6)&=\\frac{4p^{10}}{4p^6}\\\\(2p^5)^2\\div(4p^6)&=p^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{(a^2b)^3}{ab^4}\\times\\dfrac{a^2b^5}{ab}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^6b^3$",
          "worked": "$$\\begin{align*}\\frac{(a^2b)^3}{ab^4}\\times\\frac{a^2b^5}{ab}&=\\frac{a^6b^3}{ab^4}\\times\\frac{a^2b^5}{ab}\\\\\\frac{(a^2b)^3}{ab^4}\\times\\frac{a^2b^5}{ab}&=a^{6+2-1-1}b^{3+5-4-1}\\\\\\frac{(a^2b)^3}{ab^4}\\times\\frac{a^2b^5}{ab}&=a^6b^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{m^4n^2}{mn^3}\\div\\dfrac{(mn^2)^3}{m^5n^8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^5n$",
          "worked": "$$\\begin{align*}\\frac{m^4n^2}{mn^3}\\div\\frac{(mn^2)^3}{m^5n^8}&=\\frac{m^4n^2}{mn^3}\\times\\frac{m^5n^8}{m^3n^6}\\\\\\frac{m^4n^2}{mn^3}\\div\\frac{(mn^2)^3}{m^5n^8}&=m^{4+5-1-3}n^{2+8-3-6}\\\\\\frac{m^4n^2}{mn^3}\\div\\frac{(mn^2)^3}{m^5n^8}&=m^5n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p5-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{a^4b^6}{(ab^2)^2}\\times\\dfrac{a^5b}{a^2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^5b^2$",
          "worked": "$$\\begin{align*}\\frac{a^4b^6}{(ab^2)^2}\\times\\frac{a^5b}{a^2b}&=\\frac{a^4b^6}{a^2b^4}\\times\\frac{a^5b}{a^2b}\\\\\\frac{a^4b^6}{(ab^2)^2}\\times\\frac{a^5b}{a^2b}&=a^{4+5-2-2}b^{6+1-4-1}\\\\\\frac{a^4b^6}{(ab^2)^2}\\times\\frac{a^5b}{a^2b}&=a^5b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(p^4q)^2}{pq^3}\\div\\dfrac{pq}{(p^2q)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^{12}q$",
          "worked": "$$\\begin{align*}\\frac{(p^4q)^2}{pq^3}\\div\\frac{pq}{(p^2q)^3}&=\\frac{p^8q^2}{pq^3}\\times\\frac{p^6q^3}{pq}\\\\\\frac{(p^4q)^2}{pq^3}\\div\\frac{pq}{(p^2q)^3}&=p^{8+6-1-1}q^{2+3-3-1}\\\\\\frac{(p^4q)^2}{pq^3}\\div\\frac{pq}{(p^2q)^3}&=p^{12}q\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
