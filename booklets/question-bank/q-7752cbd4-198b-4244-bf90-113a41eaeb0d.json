    "label": "7",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p20-q7-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A box contains five light bulbs, two of which are faulty.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Two bulbs are selected, one at a time ",
              "marks": []
            },
            {
              "type": "text",
              "text": "without replacement",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": ". Find the probability that:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Both bulbs are faulty.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "$$\\begin{align*}P(\\text{both faulty})&=\\frac{2}{5}\\times\\frac{1}{4}\\\\P(\\text{both faulty})&=\\frac{1}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Neither bulb is faulty.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "$$\\begin{align*}P(\\text{neither faulty})&=\\frac{3}{5}\\times\\frac{2}{4}\\\\P(\\text{neither faulty})&=\\frac{3}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "First bulb is faulty and the second not.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "Let $F$ mean faulty and $N$ mean not faulty; the letters give the selection order.\n$$\\begin{align*}P(FN)&=\\frac{2}{5}\\times\\frac{3}{4}\\\\P(FN)&=\\frac{3}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "The second bulb is faulty and the first is not.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "Let $F$ mean faulty and $N$ mean not faulty; the letters give the selection order.\n$$\\begin{align*}P(NF)&=\\frac{3}{5}\\times\\frac{2}{4}\\\\P(NF)&=\\frac{3}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Exactly one of the bulbs is faulty.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "The faulty bulb can be selected first or second. These outcomes are mutually exclusive.\n$$\\begin{align*}P(\\text{exactly one faulty})&=\\frac{2}{5}\\times\\frac{3}{4}+\\frac{3}{5}\\times\\frac{2}{4}\\\\P(\\text{exactly one faulty})&=\\frac{3}{10}+\\frac{3}{10}\\\\P(\\text{exactly one faulty})&=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p20-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "At least one bulb is faulty.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{10}$",
          "worked": "The complement is that neither bulb is faulty.\n$$\\begin{align*}P(\\text{at least one faulty})&=1-P(\\text{neither faulty})\\\\P(\\text{at least one faulty})&=1-\\frac{3}{10}\\\\P(\\text{at least one faulty})&=\\frac{7}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
