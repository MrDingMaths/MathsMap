  "content": {
    "id": "p35-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Ten people are on a 6-week diet to lose weight. Their weight is recorded every week.\nThe correlation coefficient of the data is $-0.77$. Does this show that the diet works?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "There is a strong negative correlation: weight tends to decrease with time. This alone does not prove that the diet causes weight loss.",
      "worked": "Since $r=-0.77$, there is a strong negative correlation between time on the diet and weight. Weight tends to decrease as time increases, but correlation alone does not establish that the diet caused the decrease.",
      "solutionDiagrams": []
    },
