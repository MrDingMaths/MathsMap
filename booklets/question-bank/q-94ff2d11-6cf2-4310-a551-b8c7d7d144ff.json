  "content": {
    "id": "p33-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Solve each first-order differential equation ($y\\ne0$).",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{dy}{dx}=\\dfrac{2}{y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^3=6x+C$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=\\frac{y^2}{2}\\\\x&=\\int\\frac{y^2}{2}\\,dy\\\\x&=\\frac{y^3}{6}+C\\\\y^3&=6x+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p33-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{dy}{dx}=\\sqrt y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\left(\\dfrac{x-C}{2}\\right)^2$, $x>C$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=\\frac1{\\sqrt y}\\\\\\frac{dx}{dy}&=y^{-1/2}\\\\x&=\\int y^{-1/2}\\,dy\\\\x&=2\\sqrt y+C\\\\\\sqrt y&=\\frac{x-C}{2}\\\\y&=\\left(\\frac{x-C}{2}\\right)^2\\end{aligned}$$Since $y\\ne0$ and $\\sqrt y>0$, take $x>C$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p33-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{dy}{dx}=\\dfrac1{e^y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln(x-C)$, $x>C$, with $y\\ne0$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=e^y\\\\x&=\\int e^y\\,dy\\\\x&=e^y+C\\\\y&=\\ln(x-C)\\end{aligned}$$Take $x>C$ and restrict to an interval on which $y\\ne0$, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p33-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{dy}{dx}=y^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^5=5x+C$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=y^4\\\\x&=\\int y^4\\,dy\\\\x&=\\frac{y^5}{5}+C\\\\y^5&=5x+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p33-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{dy}{dx}=y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac1{C-x}$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=\\frac1{y^2}\\\\x&=\\int y^{-2}\\,dy\\\\x&=-\\frac1y+C\\\\y&=-\\frac1{x-C}\\\\y&=\\frac1{C-x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
  },
