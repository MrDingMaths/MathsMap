  "content": {
    "id": "v2-eba00f-p5-practice-fb2456bf-j4-20261109-root",
    "type": "question",
    "label": null,
    "prompt": "Mia mixes two shades of orange paint from red and yellow.\nIn shade A, the ratio of red to yellow is $1:3$.\nIn shade B, the ratio of red to yellow is $2:5$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-eba00f-p5-practice-fb2456bf-j4-20261109-fb2456bf-j4-a",
        "type": "part",
        "label": "a",
        "prompt": "Write each ratio of red to yellow as a fraction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Shade A: $\\frac{1}{3}$; shade B: $\\frac{2}{5}$",
          "worked": "$$\\begin{align*}\\text{Shade A}&=\\frac{1}{3}\\\\\\text{Shade B}&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-eba00f-p5-practice-fb2456bf-j4-20261109-fb2456bf-j4-b",
        "type": "part",
        "label": "b",
        "prompt": "Write these fractions over a common denominator.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{15}$ and $\\frac{6}{15}$",
          "worked": "$$\\begin{align*}\\frac{1}{3}&=\\frac{5}{15}\\\\\\frac{2}{5}&=\\frac{6}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-eba00f-p5-practice-fb2456bf-j4-20261109-fb2456bf-j4-c",
        "type": "part",
        "label": "c",
        "prompt": "Which shade has more red compared with yellow?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Shade B",
          "worked": "Since $\\frac{6}{15}>\\frac{5}{15}$, shade B has more red compared with yellow.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
