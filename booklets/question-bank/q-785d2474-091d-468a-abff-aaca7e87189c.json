  "content": {
    "id": "p22-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find any points on each curve where the tangent has the given angle of inclination.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{x^3}{3}-7,\\quad 45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(1,-\\dfrac{20}{3}\\right)$ and $\\left(-1,-\\dfrac{22}{3}\\right)$",
          "worked": "$$\\begin{aligned}m&=\\tan45^\\circ\\\\&=1\\\\f'(x)&=x^2\\\\x^2&=1\\\\x&=\\pm1\\\\f(1)&=\\frac{1^3}{3}-7\\\\&=-\\frac{20}{3}\\\\f(-1)&=\\frac{(-1)^3}{3}-7\\\\&=-\\frac{22}{3}\\end{aligned}$$\nThe points are $\\left(1,-\\dfrac{20}{3}\\right)$ and $\\left(-1,-\\dfrac{22}{3}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p22-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2+\\dfrac{x^3}{3},\\quad 135^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-1,\\dfrac{2}{3}\\right)$",
          "worked": "$$\\begin{aligned}m&=\\tan135^\\circ\\\\&=-1\\\\f'(x)&=2x+x^2\\\\x^2+2x&=-1\\\\x^2+2x+1&=0\\\\(x+1)^2&=0\\\\x&=-1\\\\f(-1)&=(-1)^2+\\frac{(-1)^3}{3}\\\\&=\\frac23\\end{aligned}$$\nThe point is $\\left(-1,\\dfrac23\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p22-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2+1,\\quad 120^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\dfrac{\\sqrt3}{2},\\dfrac74\\right)$",
          "worked": "$$\\begin{aligned}m&=\\tan120^\\circ\\\\&=-\\sqrt3\\\\f'(x)&=2x\\\\2x&=-\\sqrt3\\\\x&=-\\frac{\\sqrt3}{2}\\\\f\\left(-\\frac{\\sqrt3}{2}\\right)&=\\left(-\\frac{\\sqrt3}{2}\\right)^2+1\\\\&=\\frac34+1\\\\&=\\frac74\\end{aligned}$$\nThe point is $\\left(-\\dfrac{\\sqrt3}{2},\\dfrac74\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
