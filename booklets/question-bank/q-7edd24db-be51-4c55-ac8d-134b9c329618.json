  "content": {
    "id": "p43-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "This graph shows the relationship between degrees Celsius and degrees Fahrenheit.\nThe freezing point of water is $0^\\circ\\mathrm{C}$ or $32^\\circ\\mathrm{F}$, while the boiling point is at $100^\\circ\\mathrm{C}$ or $212^\\circ\\mathrm{F}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p43-q12-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"temperatureBlue\",\"hex\":\"268CFF\",\"reason\":\"temperature conversion graph and its marked freezing point\"}],\"reference\":\"source page 43 p43-q12-graph\"}\n\\begin{tikzpicture}[x=0.043cm,y=0.045cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{temperatureBlue}{HTML}{268CFF}\n\\draw[black,line width=0.15pt,xstep=10,ystep=10] (-40,-20) grid (100,220);\n\\draw[black,line width=0.5pt,<->] (-47,0)--(108,0) node[right] {$^\\circ\\mathrm{C}$};\n\\draw[black,line width=0.5pt,<->] (0,-27)--(0,227) node[above] {$^\\circ\\mathrm{F}$};\n\\foreach \\x in {-40,-20,20,40,60,80,100}{\\draw[black,line width=0.4pt] (\\x,-1.5)--(\\x,1.5);\\node[below,inner sep=0.2pt] at (\\x,-2) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\x$\\special{dvisvgm:raw </g>}};}\n\\foreach \\y in {-20,20,40,60,80,100,120,140,160,180,200,220}{\\draw[black,line width=0.4pt] (-1.8,\\y)--(1.8,\\y);\\node[left,inner sep=0.2pt] at (-2,\\y) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\y$\\special{dvisvgm:raw </g>}};}\n\\draw[temperatureBlue,line width=0.8pt,<->] plot[domain=-32:108,samples=2] (\\x,{1.8*\\x+32});\n\\fill[temperatureBlue] (0,32) circle[radius=1.6pt];\n\\fill[black] (100,212) circle[radius=1.6pt];\n\\node[black,right] at (8,32) {$(0,32)$};\n\\node[black,left] at (96,212) {$(100,212)$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 43,
          "sourceRegion": "Question 12, left-hand Celsius–Fahrenheit graph",
          "description": "Portrait conversion graph with negative ranges, a 10-unit grid, double-ended axes and conversion line, both labelled coordinate points and an unlabelled origin.",
          "mathematics": "F = 1.8C + 32; grid C from -40 to 100 and F from -20 to 220, at 10-unit intervals. Label horizontal ticks -40, -20, 20, 40, 60, 80, 100 and vertical ticks -20, 20 through 220 in steps of 20.",
          "answerVisibility": "The conversion line and labelled points (0,32) and (100,212) are permanent student-visible givens. No responses are included."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p43-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the $y$-intercept of the line?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32$",
          "worked": "At $C=0$, the graph gives $F=32$. The $y$-intercept is $32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p43-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the gradient of the line?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.8$",
          "worked": "$$\\begin{align*}m&=\\frac{\\text{rise}}{\\text{run}}\\\\m&=\\frac{212-32}{100-0}\\\\m&=1.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p43-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an equation $y=mx+c$ to relate Celsius and Fahrenheit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F=1.8C+32$",
          "worked": "Using $m=1.8$ and $c=32$:\n$$\\begin{align*}F&=mC+c\\\\F&=1.8C+32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p43-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Use your equation to convert $48^\\circ\\mathrm{C}$ to Fahrenheit.\nDoes this match the graph?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$118.4^\\circ\\mathrm{F}$. Yes.",
          "worked": "$$\\begin{align*}F&=1.8(48)+32\\\\F&=118.4\\end{align*}$$\nThe temperature is $118.4^\\circ\\mathrm{F}$. Yes; the graph gives approximately $118^\\circ\\mathrm{F}$ at $48^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p43-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "Use your equation to convert $200^\\circ\\mathrm{F}$ to Celsius. Give your answer to 2 decimal places.\nDoes this match the graph?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$93.33^\\circ\\mathrm{C}$. Yes.",
          "worked": "$$\\begin{align*}200&=1.8C+32\\\\168&=1.8C\\\\C&=\\frac{168}{1.8}\\\\C&=\\frac{280}{3}\\\\C&\\approx93.33\\end{align*}$$\nThe temperature is $93.33^\\circ\\mathrm{C}$ to 2 decimal places. Yes; the graph gives approximately $93^\\circ\\mathrm{C}$ at $200^\\circ\\mathrm{F}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
