  "content": {
    "id": "p12-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Given the formula $v=u+at$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange the formula to make $u$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=v-at$",
          "worked": "$$\\begin{align*}v-at&=u\\\\u&=v-at\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the value of $u$ when:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$v=20$, $a=2$ and $t=5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$u=10$",
              "worked": "$$\\begin{align*}u&=v-at\\\\u&=20-2\\times5\\\\u&=10\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p12-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$v=40$, $a=-6$ and $t=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$u=64$",
              "worked": "$$\\begin{align*}u&=v-at\\\\u&=40-(-6)\\times4\\\\u&=40+24\\\\u&=64\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Rearrange the formula to make $a$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{v-u}{t}$",
          "worked": "$$\\begin{align*}v-u&=at\\\\a&=\\frac{v-u}{t}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p12-q3-d",
        "type": "group",
        "label": "d",
        "prompt": "Find the value of $a$ when:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q3-d-i",
            "type": "part",
            "label": "i",
            "prompt": "$v=20$, $u=15$ and $t=2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=2.5$",
              "worked": "$$\\begin{align*}a&=\\frac{v-u}{t}\\\\a&=\\frac{20-15}{2}\\\\a&=\\frac{5}{2}\\\\a&=2.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p12-q3-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$v=-26.8$, $u=-14.4$ and $t=2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=-6.2$",
              "worked": "$$\\begin{align*}a&=\\frac{v-u}{t}\\\\a&=\\frac{-26.8-(-14.4)}{2}\\\\a&=\\frac{-12.4}{2}\\\\a&=-6.2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p12-q3-d-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$v=\\dfrac12$, $u=\\dfrac23$ and $t=\\dfrac56$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=-\\dfrac15$",
              "worked": "$$\\begin{align*}a&=\\frac{v-u}{t}\\\\a&=\\left(\\frac12-\\frac23\\right)\\div\\frac56\\\\a&=-\\frac16\\times\\frac65\\\\a&=-\\frac15\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 50
          }
        ]
      },
      {
        "id": "p12-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Rearrange the formula to make $t$ the subject and find $t$ when $v=6$, $u=7$ and $a=-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\dfrac{v-u}{a}$; $t=\\dfrac13$.",
          "worked": "$$\\begin{align*}v-u&=at\\\\t&=\\frac{v-u}{a}\\\\t&=\\frac{6-7}{-3}\\\\t&=\\frac{-1}{-3}\\\\t&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
