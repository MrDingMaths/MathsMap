  "content": {
    "id": "p22-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Let $f:\\mathbb{R}\\to\\mathbb{R}$ and $g:\\mathbb{R}\\to\\mathbb{R}$ be given by $f(x)=2x+3$ and $g(x)=3x+2$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(f\\circ g)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x+7$",
          "worked": "$$\\begin{align*}(f\\circ g)(x)&=f(g(x))\\\\(f\\circ g)(x)&=f(3x+2)\\\\(f\\circ g)(x)&=2(3x+2)+3\\\\(f\\circ g)(x)&=6x+7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(g\\circ f)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x+11$",
          "worked": "$$\\begin{align*}(g\\circ f)(x)&=g(f(x))\\\\(g\\circ f)(x)&=g(2x+3)\\\\(g\\circ f)(x)&=3(2x+3)+2\\\\(g\\circ f)(x)&=6x+11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(f\\circ f)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x+9$",
          "worked": "$$\\begin{align*}(f\\circ f)(x)&=f(f(x))\\\\(f\\circ f)(x)&=f(2x+3)\\\\(f\\circ f)(x)&=2(2x+3)+3\\\\(f\\circ f)(x)&=4x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(g\\circ g)(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x+8$",
          "worked": "$$\\begin{align*}(g\\circ g)(x)&=g(g(x))\\\\(g\\circ g)(x)&=g(3x+2)\\\\(g\\circ g)(x)&=3(3x+2)+2\\\\(g\\circ g)(x)&=9x+8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(f\\circ(g\\circ f))(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x+25$",
          "worked": "$$\\begin{align*}(f\\circ(g\\circ f))(x)&=f(g(f(x)))\\\\(f\\circ(g\\circ f))(x)&=f(g(2x+3))\\\\(f\\circ(g\\circ f))(x)&=f(6x+11)\\\\(f\\circ(g\\circ f))(x)&=2(6x+11)+3\\\\(f\\circ(g\\circ f))(x)&=12x+25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p22-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$(g\\circ(f\\circ g))(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18x+23$",
          "worked": "$$\\begin{align*}(g\\circ(f\\circ g))(x)&=g(f(g(x)))\\\\(g\\circ(f\\circ g))(x)&=g(f(3x+2))\\\\(g\\circ(f\\circ g))(x)&=g(6x+7)\\\\(g\\circ(f\\circ g))(x)&=3(6x+7)+2\\\\(g\\circ(f\\circ g))(x)&=18x+23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
