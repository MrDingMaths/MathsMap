    "children": [
      {
        "id": "p25-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Nick has found the gradient of this line to be $5$.\n\nWithout calculation, explain why Nick must be incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The gradient is negative.",
          "worked": "The line falls from left to right, so its gradient is negative. It cannot be $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p25-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Nicole has found the gradient of the line to be $-\\dfrac{1}{5}$.\n\nThis is incorrect. What mistake do you think Nicole has made?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Nicole used $\\dfrac{\\text{run}}{\\text{rise}}$ instead of $\\dfrac{\\text{rise}}{\\text{run}}$.",
          "worked": "Nicole reversed rise and run. Moving right $1$ unit, the line falls $5$ units, so\n$$\\begin{aligned}m&=\\frac{\\text{rise}}{\\text{run}}\\\\m&=\\frac{-5}{1}\\\\m&=-5.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ],
