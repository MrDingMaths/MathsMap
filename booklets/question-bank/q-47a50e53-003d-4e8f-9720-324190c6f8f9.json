    "children": [
      {
        "id": "p40-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\triangle TDC$ is a right-angled triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle CDT=225^\\circ-135^\\circ=90^\\circ$, so $\\triangle TDC$ is right-angled at $D$.",
          "worked": "The bearing of $D$ from $T$ is $315^\\circ$, so the bearing of $T$ from $D$ is $135^\\circ$.\n$$\\begin{align*}\\angle CDT&=225^\\circ-135^\\circ\\\\&=90^\\circ\\end{align*}$$\nTherefore, $\\triangle TDC$ is right-angled at $D$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p40-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the bearing of the construction site from the town, to the nearest minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$247^\\circ24'$",
          "worked": "$$\\begin{align*}\\cos\\angle DTC&=\\frac{40}{105}\\\\\\angle DTC&=\\cos^{-1}\\!\\left(\\frac{40}{105}\\right)\\\\\\text{Bearing of }C\\text{ from }T&=315^\\circ-\\cos^{-1}\\!\\left(\\frac{40}{105}\\right)\\\\&\\approx247^\\circ24'\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ],
