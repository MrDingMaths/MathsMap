  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Use Heron’s formula to find the area of an equilateral triangle of side length $2\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt3\\text{ cm}^2$",
      "worked": "$$\\begin{align*}s&=\\frac{2+2+2}{2}=3\\\\A&=\\sqrt{s(s-a)(s-b)(s-c)}\\\\A&=\\sqrt{3(3-2)(3-2)(3-2)}\\\\A&=\\sqrt3\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
