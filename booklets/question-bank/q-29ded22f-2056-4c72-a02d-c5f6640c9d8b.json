    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p76-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Where is the particle initially?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(0)=1\\text{ m}$.",
          "worked": "$x(0)=2(0)^2-4(0)+1=1$. The particle is initially at $x=1\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p76-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Where is the particle after 5 seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(5)=31\\text{ m}$.",
          "worked": "$x(5)=2(5)^2-4(5)+1=31$. The particle is at $x=31\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p76-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the velocity-time equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(t)=4t-4\\text{ m/s}$.",
          "worked": "$v(t)=x'(t)=4t-4\\text{ m/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p76-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the displacement when it is stationary.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(1)=-1\\text{ m}$; the particle is stationary when $v(1)=0$.",
          "worked": "\n\n$$\\begin{align*}v(t)&=4t-4\\\\0&=4t-4\\\\t&=1\\\\x(1)&=2(1)^2-4(1)+1=-1\\end{align*}$$\n\n The displacement when stationary is $-1\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
