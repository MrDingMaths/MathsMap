    "children": [
      {
        "id": "p13-q1",
        "type": "part",
        "label": "a",
        "prompt": "The number of distinct arrangements of AAB is $\\dfrac{3!}{2!}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "There are three letters, including two identical A’s. The number of distinct arrangements is $\\dfrac{3!}{2!}=3$, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p13-q2",
        "type": "part",
        "label": "b",
        "prompt": "The number of ways to arrange the letters AABBCCCC so that the C’s are all together is $\\dfrac{5!}{2!2!4!}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "Treat CCCC as one block. The five elements are A, A, B, B and CCCC, giving $\\dfrac{5!}{2!2!}=30$ arrangements. The C’s were not permuted within their block, so no division by $4!$ is needed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p13-q3",
        "type": "part",
        "label": "c",
        "prompt": "AAB has two ways to arrange the letters so that the A’s are not together: ABA and BAB.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "ABA is the only arrangement with the A’s separated. BAB contains two B’s and only one A, so it is not an arrangement of AAB.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p13-q4",
        "type": "part",
        "label": "d",
        "prompt": "The number of distinct arrangements of the word BALLOON is $\\dfrac{7!}{2!2!}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "BALLOON contains seven letters, with two L’s and two O’s. The number of distinct arrangements is $\\dfrac{7!}{2!2!}=1260$, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
