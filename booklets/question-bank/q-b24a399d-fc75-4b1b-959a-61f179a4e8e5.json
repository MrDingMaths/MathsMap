  "content": {
    "id": "p13-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Suppose that P, Q and R are the points $(\\sqrt3,8)$, $(3\\sqrt3,14)$ and $(5\\sqrt3,12)$ respectively.\n\nIt is known that the angle between the vectors $\\overrightarrow{PQ}$ and $\\overrightarrow{PR}$ is $30^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the vectors $\\overrightarrow{PQ}$ and $\\overrightarrow{PR}$ in component form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{PQ}=2\\sqrt3\\mathbf{i}+6\\mathbf{j}$, $\\overrightarrow{PR}=4\\sqrt3\\mathbf{i}+4\\mathbf{j}$.",
          "worked": "$$\\begin{aligned}\\overrightarrow{PQ}&=(3\\sqrt3-\\sqrt3,14-8)=2\\sqrt3\\mathbf{i}+6\\mathbf{j}\\\\\\overrightarrow{PR}&=(5\\sqrt3-\\sqrt3,12-8)=4\\sqrt3\\mathbf{i}+4\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p13-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\overrightarrow{PQ}\\cdot\\overrightarrow{PR}$ using the result $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=x_1x_2+y_1y_2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "$$\\begin{aligned}\\overrightarrow{PQ}\\cdot\\overrightarrow{PR}&=(2\\sqrt3)(4\\sqrt3)+(6)(4)\\\\&=24+24\\\\&=48\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p13-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Confirm your answer to part b using the result $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=|\\underset{\\sim}{u}||\\underset{\\sim}{v}|\\cos\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\overrightarrow{PQ}||\\overrightarrow{PR}|\\cos30^\\circ=48$.",
          "worked": "$$\\begin{aligned}|\\overrightarrow{PQ}|&=\\sqrt{12+36}=\\sqrt{48}\\\\|\\overrightarrow{PR}|&=\\sqrt{48+16}=8\\end{aligned}$$\n\n$$\\begin{aligned}\\overrightarrow{PQ}\\cdot\\overrightarrow{PR}&=|\\overrightarrow{PQ}||\\overrightarrow{PR}|\\cos30^\\circ\\\\&=\\sqrt{48}\\times8\\times\\frac{\\sqrt3}{2}\\\\&=48\\end{aligned}$$\n\nThis agrees with part b.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
