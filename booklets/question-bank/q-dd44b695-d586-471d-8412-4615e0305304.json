  "content": {
    "id": "p3-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "If $x=2$ is a solution of the equation $x^2+3x+k=0$, then find the other solution.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-5$.\n\nSubstitute $x=2$ to find $k=-10$, then factorise.",
      "worked": "Substitute $x=2$:\n$$\\begin{align*}2^2+3(2)+k&=0\\\\10+k&=0\\\\k&=-10\\end{align*}$$\nThen\n$$\\begin{align*}x^2+3x-10&=0\\\\(x-2)(x+5)&=0\\end{align*}$$\nBy the null factor law, $x=2$ or $x=-5$. The other solution is $x=-5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
