  "content": {
    "id": "v2-512e8f-p9-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "The parabola $y=x^2+bx+8$ passes through the point $(6,8)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-512e8f-p9-practice-slot-6-slot-6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Use symmetry to find the equation of the axis of symmetry.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "When $x=0$, $y=8$, so $(0,8)$ is on the parabola. The points $(0,8)$ and $(6,8)$ have the same $y$-value, so the axis of symmetry is halfway between them.\n$$\\begin{align*}x&=\\frac{0+6}{2}\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-512e8f-p9-practice-slot-6-slot-6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-6$",
          "worked": "$$\\begin{align*}8&=6^2+b(6)+8\\\\8&=44+6b\\\\6b&=-36\\\\b&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-512e8f-p9-practice-slot-6-slot-6-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the minimum value of $y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "The parabola opens upwards, so the minimum is on the axis $x=3$.\n$$\\begin{align*}y&=3^2-6(3)+8\\\\y&=9-18+8\\\\y&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ],
    "responseKind": "group-answer",
    "answer": {
      "short": "a) $x=3$  b) $b=-6$  c) $-1$",
      "worked": "See parts.",
      "solutionDiagrams": []
    }
  },
