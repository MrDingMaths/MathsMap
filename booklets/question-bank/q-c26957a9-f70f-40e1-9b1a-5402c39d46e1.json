  "content": {
    "id": "p37-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A fair die is rolled three times. Find the probability that exactly one six is obtained.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{25}{72}$",
      "worked": "Let $X$ be the number of sixes. There are three independent trials with success probability $\\frac{1}{6}$.\n$$\\begin{align*}\\Pr(X=1)&=\\binom{3}{1}\\left(\\frac{1}{6}\\right)\\left(\\frac{5}{6}\\right)^2\\\\\\Pr(X=1)&=\\frac{75}{216}\\\\\\Pr(X=1)&=\\frac{25}{72}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
