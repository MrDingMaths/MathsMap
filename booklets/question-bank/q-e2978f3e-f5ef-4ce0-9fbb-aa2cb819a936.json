  "content": {
    "id": "v2-09aa8-p53-practice-j6-100327-root",
    "type": "question",
    "label": null,
    "prompt": "Find the prime factorisation of $18^3$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-09aa8-p53-practice-j6-100327-j6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $18$ as a product of prime factors, using indices.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times3^2$",
          "worked": "$$\\begin{align*}18&=2\\times3\\times3\\\\&=2\\times3^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-09aa8-p53-practice-j6-100327-j6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the rule $(ab)^n=a^n\\times b^n$ to write $18^3$ as a product of powers of $2$ and $3^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^3\\times(3^2)^3$",
          "worked": "$$\\begin{align*}18^3&=(2\\times3^2)^3\\\\&=2^3\\times(3^2)^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-09aa8-p53-practice-j6-100327-j6-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Simplify to give the prime factorisation of $18^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^3\\times3^6$",
          "worked": "$$\\begin{align*}2^3\\times(3^2)^3&=2^3\\times3^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
