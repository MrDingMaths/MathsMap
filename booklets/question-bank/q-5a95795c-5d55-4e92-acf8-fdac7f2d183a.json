  "content": {
    "id": "p28-q20",
    "type": "question",
    "label": "20",
    "prompt": "A 35 mg piece of radioactive substance is decaying at a rate of 0.5% per year. Determine the mass remaining after 400 years to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.7\\text{ mg}$.",
      "worked": "$$\\begin{align*}m &= m_0(1-r)^n\\\\m &= 35(1-0.005)^{400}\\\\m &= 35(0.995)^{400}\\\\m &\\approx 4.7\\text{ mg}\\end{align*}$$\nTo one decimal place.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
