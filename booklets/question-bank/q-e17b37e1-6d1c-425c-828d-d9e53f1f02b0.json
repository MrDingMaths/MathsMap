  "content": {
    "id": "p33-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q8-a",
        "type": "group",
        "label": "a",
        "prompt": "Consider the function $y=x(x+2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p33-q8-a-i",
            "type": "part",
            "label": "i",
            "prompt": "The graph in part a is stretched horizontally by a factor of 2.\nWrite down the equation of this new function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac14x(x+4)$",
              "worked": "Replace $x$ with $\\frac{x}{2}$.\n$$\\begin{aligned}y&=\\frac{x}{2}\\left(\\frac{x}{2}+2\\right)\\\\y&=\\frac14x(x+4)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p33-q8-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "This graph is then stretched vertically by a factor of 3.\nWrite down the equation of this new function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac34x(x+4)$",
              "worked": "Replace $y$ with $\\frac{y}{3}$ in the result of part a i.\n$$\\begin{aligned}\\frac{y}{3}&=\\frac14x(x+4)\\\\y&=\\frac34x(x+4)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p33-q8-b",
        "type": "group",
        "label": "b",
        "prompt": "Consider again $y=x(x+2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p33-q8-b-i",
            "type": "part",
            "label": "i",
            "prompt": "The graph in part b is stretched vertically by a factor of 3.\nWrite down the equation of this new function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=3x(x+2)$",
              "worked": "Replace $y$ with $\\frac{y}{3}$.\n$$\\begin{aligned}\\frac{y}{3}&=x(x+2)\\\\y&=3x(x+2)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p33-q8-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "This graph is then stretched horizontally by a factor of 2.\nWrite down the equation of this new function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac34x(x+4)$",
              "worked": "Replace $x$ with $\\frac{x}{2}$ in the result of part b i.\n$$\\begin{aligned}y&=3\\left(\\frac{x}{2}\\right)\\left(\\frac{x}{2}+2\\right)\\\\y&=\\frac34x(x+4)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p33-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Compare your equations in parts a ii and b ii.\nDid the order of the two dilations change the final results?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. Both give $y=\\frac34x(x+4)$.",
          "worked": "No. Both orders give $y=\\frac34x(x+4)$. The horizontal dilation changes the $x$-coordinates and the vertical dilation changes the $y$-coordinates independently.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
