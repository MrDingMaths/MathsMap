    "type": "question",
    "label": null,
    "prompt": "Consider the curve defined parametrically by $x=4t-1$, $y=t^2$.\n\nWhat value of $t$ would give the coordinate $(11,9)$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$t=3$",
      "worked": "$\\begin{aligned}4t-1&=11\\\\4t&=12\\\\t&=3\\end{aligned}$\n\nCheck: $y=3^2=9$",
      "solutionDiagrams": []
    },
