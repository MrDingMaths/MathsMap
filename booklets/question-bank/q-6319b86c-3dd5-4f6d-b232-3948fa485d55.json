      {
        "id": "routine-using-r7-horizontal-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $y=e^{\\sin 2x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2\\cos 2x\\,e^{\\sin 2x}$",
          "worked": "$$\\begin{align*}y'&=e^{\\sin 2x}\\times 2\\cos 2x\\\\&=2\\cos 2x\\,e^{\\sin 2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "routine-using-r7-horizontal-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find, in the domain $0\\le x\\le \\pi$, the $x$-coordinates of the points on the curve $y=e^{\\sin 2x}$ where the tangent is horizontal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{\\pi}{4},\\dfrac{3\\pi}{4}$",
          "worked": "A horizontal tangent has gradient $0$.\n\n$$2\\cos 2x\\,e^{\\sin 2x}=0$$\n\nSince $e^{\\sin 2x}>0$, we need $\\cos 2x=0$.\n\nIn $0\\le x\\le \\pi$, we have $0\\le 2x\\le 2\\pi$, so\n\n$$2x=\\frac{\\pi}{2},\\frac{3\\pi}{2}$$\n\n$$x=\\frac{\\pi}{4},\\frac{3\\pi}{4}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
