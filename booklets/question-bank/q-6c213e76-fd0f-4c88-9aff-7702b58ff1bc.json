  "content": {
    "id": "v2-fb109-p39-practice-slot-14-root",
    "type": "question",
    "label": null,
    "prompt": "Find the unit vector in the direction of $\\underset{\\sim}{u}+\\underset{\\sim}{v}$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-fb109-p39-practice-slot-14-slot-14-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{u}=5i-2j$ and $\\underset{\\sim}{v}=-2i+6j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac15(3i+4j)$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}+\\underset{\\sim}{v}&=(5i-2j)+(-2i+6j)\\\\&=3i+4j\\\\|\\underset{\\sim}{u}+\\underset{\\sim}{v}|&=\\sqrt{3^2+4^2}\\\\&=5\\\\\\text{unit vector}&=\\frac15(3i+4j)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-fb109-p39-practice-slot-14-slot-14-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{u}=6i-4j$ and $\\underset{\\sim}{v}=2i-2j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac15(4i-3j)$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}+\\underset{\\sim}{v}&=(6i-4j)+(2i-2j)\\\\&=8i-6j\\\\|\\underset{\\sim}{u}+\\underset{\\sim}{v}|&=\\sqrt{8^2+(-6)^2}\\\\&=10\\\\\\text{unit vector}&=\\frac{1}{10}(8i-6j)\\\\&=\\frac15(4i-3j)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
