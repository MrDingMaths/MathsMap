  "content": {
    "id": "p29-q9-root",
    "type": "question",
    "label": null,
    "prompt": "Mr Guernsey earns $\\$14\\,800$ more than Mr Jersey, and Mrs Mann earns $\\$22\\,000$ less than Mr Jersey.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q9-a",
        "type": "group",
        "label": "a",
        "prompt": "If $\\$x$ represents Mr Jersey’s salary, express the salary of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p29-q9-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Mr Guernsey in terms of $x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(x+14\\,800)$",
              "worked": "Add $\\$14\\,800$ to Mr Jersey’s salary: $\\$(x+14\\,800)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p29-q9-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Mrs Mann in terms of $x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$(x-22\\,000)$",
              "worked": "Subtract $\\$22\\,000$ from Mr Jersey’s salary: $\\$(x-22\\,000)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      },
      {
        "id": "p29-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "If the total of the three incomes is $\\$351\\,600$, find the income of each person.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mr Jersey: $\\$119\\,600$; Mr Guernsey: $\\$134\\,400$; Mrs Mann: $\\$97\\,600$.",
          "worked": "$$\\begin{align*}x+(x+14\\,800)+(x-22\\,000)&=351\\,600\\\\3x-7200&=351\\,600\\\\3x&=358\\,800\\\\x&=119\\,600\\end{align*}$$\nMr Jersey earns $\\$119\\,600$.\nMr Guernsey earns $\\$(119\\,600+14\\,800)=\\$134\\,400$.\nMrs Mann earns $\\$(119\\,600-22\\,000)=\\$97\\,600$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
