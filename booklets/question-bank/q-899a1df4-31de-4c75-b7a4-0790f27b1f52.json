  "content": {
    "id": "v2-165a9d-p5-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "A polygon has $n$ sides.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-165a9d-p5-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the angle sum of a polygon with $n+1$ sides.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180(n-1)$",
          "worked": "$$\\begin{align*}S&=180\\big((n+1)-2\\big)\\\\S&=180(n-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-165a9d-p5-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that adding one side to a polygon increases its angle sum by $180^{\\circ}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The increase is $180(n-1)-180(n-2)=180^{\\circ}$.",
          "worked": "$$\\begin{align*}\\text{Increase}&=180(n-1)-180(n-2)\\\\&=180\\big((n-1)-(n-2)\\big)\\\\&=180(1)\\\\&=180^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-165a9d-p5-practice-slot-2-slot-2-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the number of sides of a polygon whose angle sum is $1260^{\\circ}$ greater than the angle sum of a hexagon.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "13 sides",
          "worked": "Each extra side adds $180^{\\circ}$.\n$$\\begin{align*}\\text{Extra sides}&=\\frac{1260^{\\circ}}{180^{\\circ}}\\\\&=7\\\\n&=6+7\\\\&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
