  "content": {
    "id": "p50-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "Consider $2x^3+kx^2-32x-16$. Find $k$ and the roots if two of the roots sum to zero.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
