  "content": {
    "id": "p21-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Consider the tangent with gradient $1$ to the curve $y=x^2-5x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the point of contact on the curve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,-6)$",
          "worked": "The derivative is $\\frac{dy}{dx}=2x-5$. Set it equal to the given gradient.\n\n$$\\begin{align*}2x-5&=1\\\\2x&=6\\\\x&=3\\end{align*}$$\n\n$$\\begin{align*}y&=3^2-5(3)\\\\y&=-6\\end{align*}$$\n\nThe point of contact is $(3,-6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the equation of the tangent at this point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-9$",
          "worked": "Use gradient $1$ and the point $(3,-6)$.\n\n$$\\begin{align*}y-(-6)&=1(x-3)\\\\y+6&=x-3\\\\y&=x-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
