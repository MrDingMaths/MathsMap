  "content": {
    "id": "p71-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Differentiate $x^2e^x$. Hence find $\\int x(2+x)e^x\\,dx$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p71-q3-completion-short-0",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 1,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\dfrac{d}{dx}(x^2e^x)=x(2+x)e^x",
                "display": true
              }
            ]
          },
          {
            "id": "p71-q3-completion-short-1",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 1,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\displaystyle\\int x(2+x)e^x\\,dx=x^2e^x+C",
                "display": true
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\frac{d}{dx}(x^2e^x)&=2xe^x+x^2e^x\\\\&=x(2+x)e^x\\end{align*}$$\nTherefore\n$$\\int x(2+x)e^x\\,dx=x^2e^x+C.$$",
      "solutionDiagrams": []
