    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that all side lengths are equal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$DE=EF=FG=GD=5$.",
          "worked": "$$\\begin{align*}DE&=\\sqrt{(1-(-4))^2+(2-2)^2}=5\\\\EF&=\\sqrt{(4-1)^2+(-2-2)^2}=5\\\\FG&=\\sqrt{(-1-4)^2+(-2-(-2))^2}=5\\\\GD&=\\sqrt{(-4-(-1))^2+(2-(-2))^2}=5\\end{align*}$$\nAll four sides are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "By finding the gradients, show that the opposite sides are parallel.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{DE}=m_{FG}=0$ and $m_{EF}=m_{GD}=-\\frac43$, so opposite sides are parallel.",
          "worked": "$$\\begin{align*}m_{DE}&=\\frac{2-2}{1-(-4)}=0\\\\m_{EF}&=\\frac{-2-2}{4-1}=-\\frac43\\\\m_{FG}&=\\frac{-2-(-2)}{-1-4}=0\\\\m_{GD}&=\\frac{2-(-2)}{-4-(-1)}=-\\frac43\\end{align*}$$\n$m_{DE}=m_{FG}$ and $m_{EF}=m_{GD}$, so opposite sides are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that the diagonals $DF$ and $GE$ are perpendicular.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{DF}=-\\frac12$ and $m_{GE}=2$. Their product is $-1$, so $DF\\perp GE$.",
          "worked": "$$\\begin{align*}m_{DF}&=\\frac{-2-2}{4-(-4)}=-\\frac12\\\\m_{GE}&=\\frac{2-(-2)}{1-(-1)}=2\\\\m_{DF}\\times m_{GE}&=-\\frac12\\times2=-1\\end{align*}$$\nThe diagonals are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that the midpoints of $DF$ and $GE$ are the same point (the diagonals bisect each other).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both midpoints are $(0,0)$, so the diagonals bisect each other.",
          "worked": "$$\\begin{align*}M_{DF}&=\\left(\\frac{-4+4}{2},\\frac{2+(-2)}{2}\\right)=(0,0)\\\\M_{GE}&=\\left(\\frac{-1+1}{2},\\frac{-2+2}{2}\\right)=(0,0)\\end{align*}$$\nThe diagonals have the same midpoint, so they bisect each other.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
