  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The vertices of a rhombus are $D(-4,2)$, $E(1,2)$, $F(4,-2)$ and $G(-1,-2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p12-q2-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"rhombusBlue\",\"hex\":\"268CFF\",\"reason\":\"supplied quadrilateral plotted on coordinate axes\"}],\"reference\":\"source page 12 p12-q2-diagram\"}\n\\begin{tikzpicture}[x=0.55cm,y=0.55cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{rhombusBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-6.2,-5.1) rectangle (7,5.1);\n\\draw[<->,black,line width=0.5pt] (-5.8,0)--(6.6,0) node[below left] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-4.8)--(0,4.8) node[above left] {$y$};\n\\node[below left,inner sep=2pt] at (0,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$0$\\special{dvisvgm:raw </g>}};\n\\coordinate (D) at (-4,2);\\coordinate (E) at (1,2);\\coordinate (F) at (4,-2);\\coordinate (G) at (-1,-2);\n\\draw[rhombusBlue,line width=0.8pt] (D)--(E)--(F)--(G)--cycle;\n\\foreach \\p in {D,E,F,G}{\\fill[rhombusBlue] (\\p) circle (1.6pt);}\n\\node[above left,black] at (D) {$D$};\\node[above right,black] at (E) {$E$};\\node[below right,black] at (F) {$F$};\\node[below left,black] at (G) {$G$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 12,
          "sourceRegion": "Q2 coordinate sketch",
          "description": "Rhombus DEFG on unnumbered double-ended Cartesian axes. No grid, ticks or diagonals; DE and FG are horizontal.",
          "mathematics": {
            "vertices": {
              "D": [
                -4,
                2
              ],
