  "content": {
    "id": "v2-d340c-p54-practice-j5-092930-root",
    "type": "question",
    "label": null,
    "prompt": "Jess and Sam are washing cars for a school fundraiser. Jess can wash 3 cars in 6 hours. Sam can wash 2 cars in 3 hours.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d340c-p54-practice-j5-092930-j5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write each person's rate in cars per hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jess: $\\dfrac{1}{2}$ car/hour. Sam: $\\dfrac{2}{3}$ car/hour.",
          "worked": "$$\\begin{align*}\\text{Jess}&=\\frac{3\\text{ cars}}{6\\text{ hours}}=\\frac{1}{2}\\text{ car/hour}\\\\\\text{Sam}&=\\frac{2\\text{ cars}}{3\\text{ hours}}=\\frac{2}{3}\\text{ car/hour}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-d340c-p54-practice-j5-092930-j5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find their combined rate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{6}$ cars/hour",
          "worked": "$$\\begin{align*}\\text{Combined rate}&=\\frac{1}{2}+\\frac{2}{3}\\\\\\text{Combined rate}&=\\frac{7}{6}\\text{ cars/hour}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-d340c-p54-practice-j5-092930-j5-q-c",
        "type": "part",
        "label": "c",
        "prompt": "How long will it take them to wash 14 cars together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "12 hours",
          "worked": "$$\\begin{align*}\\text{Time}&=14\\div\\frac{7}{6}\\\\\\text{Time}&=14\\times\\frac{6}{7}\\\\\\text{Time}&=12\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
