  "content": {
    "id": "p16-q3",
    "type": "question",
    "label": "3",
    "prompt": "Find the coordinates of the points of intersection of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+y^2=4$ and $x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,0)$.",
          "worked": "$$\\begin{align*}2^2+y^2&=4\\\\y^2&=0\\\\y&=0\\end{align*}$$\nThe intersection is $(2,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+y^2=9$ and $y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-3,0)$ and $(3,0)$.",
          "worked": "$$\\begin{align*}x^2+0^2&=9\\\\x^2&=9\\\\x&=\\pm3\\end{align*}$$\nThe intersections are $(-3,0)$ and $(3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p16-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+y^2=32$ and $y=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,4)$ and $(-4,-4)$.",
          "worked": "$$\\begin{align*}x^2+x^2&=32\\\\2x^2&=32\\\\x^2&=16\\\\x&=\\pm4\\end{align*}$$\nSince $y=x$, the intersections are $(4,4)$ and $(-4,-4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+y^2=81$ and $y=2\\sqrt2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-3,-6\\sqrt2)$ and $(3,6\\sqrt2)$.",
          "worked": "$$\\begin{align*}x^2+(2\\sqrt2x)^2&=81\\\\9x^2&=81\\\\x^2&=9\\\\x&=\\pm3\\end{align*}$$\nWhen $x=-3$, $y=2\\sqrt2(-3)=-6\\sqrt2$. When $x=3$, $y=2\\sqrt2(3)=6\\sqrt2$.\nThe intersections are $(-3,-6\\sqrt2)$ and $(3,6\\sqrt2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
