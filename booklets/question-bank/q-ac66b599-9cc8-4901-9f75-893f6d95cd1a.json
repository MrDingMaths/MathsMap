      {
        "id": "p58-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $y=e^{x^3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=3x^2e^{x^3}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=e^{x^3}\\frac{d}{dx}(x^3)\\\\&=3x^2e^{x^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p58-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int_{-1}^{0}x^2e^{x^3}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13(1-e^{-1})$",
          "worked": "Using part a,\n$$\\begin{align*}\\int_{-1}^{0}x^2e^{x^3}\\,dx&=\\frac13\\int_{-1}^{0}3x^2e^{x^3}\\,dx\\\\&=\\left[\\frac13e^{x^3}\\right]_{-1}^{0}\\\\&=\\frac13e^0-\\frac13e^{-1}\\\\&=\\frac13(1-e^{-1}).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
