  "content": {
    "id": "p19-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Show that $\\cos 2\\theta=1-2\\sin^2\\theta$ is true when",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\theta=\\frac{\\pi}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=\\text{RHS}=0$.",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\cos\\left(2\\times\\frac{\\pi}{4}\\right)\\\\\\text{LHS}&=\\cos\\left(\\frac{\\pi}{2}\\right)\\\\\\text{LHS}&=0\\end{align*}$$\n$$\\begin{align*}\\text{RHS}&=1-2\\sin^2\\left(\\frac{\\pi}{4}\\right)\\\\\\text{RHS}&=1-2\\left(\\frac{\\sqrt{2}}{2}\\right)^2\\\\\\text{RHS}&=0\\end{align*}$$\nTherefore $\\text{LHS}=\\text{RHS}$, so the identity is true for $\\theta=\\frac{\\pi}{4}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\theta=-\\frac{5\\pi}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=\\text{RHS}=\\frac{1}{2}$.",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\cos\\left(2\\times-\\frac{5\\pi}{6}\\right)\\\\\\text{LHS}&=\\cos\\left(-\\frac{5\\pi}{3}\\right)\\\\\\text{LHS}&=\\frac{1}{2}\\end{align*}$$\n$$\\begin{align*}\\text{RHS}&=1-2\\sin^2\\left(-\\frac{5\\pi}{6}\\right)\\\\\\text{RHS}&=1-2\\left(-\\frac{1}{2}\\right)^2\\\\\\text{RHS}&=\\frac{1}{2}\\end{align*}$$\nTherefore $\\text{LHS}=\\text{RHS}$, so the identity is true for $\\theta=-\\frac{5\\pi}{6}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
