          "short": "$\\tfrac12$",
          "worked": "$$\\begin{align*}\\log_a(\\sqrt a)&=\\log_a(a^{1/2})\\\\\\log_a(\\sqrt a)&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
