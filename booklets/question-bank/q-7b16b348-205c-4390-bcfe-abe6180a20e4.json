        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_a\\left(\\frac1{a^2}\\right)&=\\log_a(a^{-2})\\\\\\log_a\\left(\\frac1{a^2}\\right)&=-2\\end{align*}$$",
