  "content": {
    "id": "p37-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The Hungry Hour Cafe purchased an air-conditioning system six years ago for $\\$250000$, and is assuming a depreciation rate of $20\\%$. Give the percentage decrease to $2$ decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value after one year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$200000$",
          "worked": "Each year the system retains $100\\%-20\\%=80\\%$ of its value.\n\n$$\\begin{align*}V_1&=250000\\times0.80\\\\V_1&=\\$200000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p37-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value after two years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$160000$",
          "worked": "$$\\begin{align*}V_2&=250000\\times(0.80)^2\\\\V_2&=\\$160000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p37-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the value after six years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$65536$",
          "worked": "$$\\begin{align*}V_6&=250000\\times(0.80)^6\\\\V_6&=\\$65536\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p37-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the percentage decrease in value over the six years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$73.79\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage remaining}&=(0.80)^6\\times100\\%\\\\\\text{Percentage remaining}&=26.2144\\%\\\\\\text{Percentage decrease}&=100\\%-26.2144\\%\\\\\\text{Percentage decrease}&\\approx73.79\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "What is the average depreciation, in dollars p.a., on the air-conditioning system over the six years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$30744$ p.a.",
          "worked": "$$\\begin{align*}\\text{Total depreciation}&=250000-65536\\\\\\text{Total depreciation}&=\\$184464\\\\\\text{Average depreciation}&=184464\\div6\\\\\\text{Average depreciation}&=\\$30744\\text{ p.a.}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
