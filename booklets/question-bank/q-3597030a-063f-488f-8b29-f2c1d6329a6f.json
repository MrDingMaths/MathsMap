  "content": {
    "id": "p60-q13-root",
    "type": "question",
    "label": null,
    "prompt": "Complete the squares to find the centre and radius of each circle.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+y^2-2y=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(0,1)$; radius $2$.",
          "worked": "$$\\begin{align*}x^2+(y^2-2y+1)&=3+1\\\\x^2+(y-1)^2&=4\\end{align*}$$\nCentre $(0,1)$; radius $\\sqrt4=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p60-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+6x+y^2+8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-3,0)$; radius $1$.",
          "worked": "$$\\begin{align*}x^2+6x+y^2&=-8\\\\(x^2+6x+9)+y^2&=-8+9\\\\(x+3)^2+y^2&=1\\end{align*}$$\nCentre $(-3,0)$; radius $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p60-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-4x+y^2+6y-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(2,-3)$; radius $4$.",
          "worked": "$$\\begin{align*}x^2-4x+y^2+6y&=3\\\\(x^2-4x+4)+(y^2+6y+9)&=3+4+9\\\\(x-2)^2+(y+3)^2&=16\\end{align*}$$\nCentre $(2,-3)$; radius $\\sqrt{16}=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p60-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+y^2-8x+14y=35$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(4,-7)$; radius $10$.",
          "worked": "$$\\begin{align*}(x^2-8x+16)+(y^2+14y+49)&=35+16+49\\\\(x-4)^2+(y+7)^2&=100\\end{align*}$$\nCentre $(4,-7)$; radius $\\sqrt{100}=10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
