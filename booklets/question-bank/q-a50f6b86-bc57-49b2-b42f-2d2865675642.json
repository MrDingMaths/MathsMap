  "content": {
    "id": "v2-x-topic-1-practice-b9a013ab-j9-20261111-root",
    "type": "question",
    "label": null,
    "prompt": "Complete the working to find the value of $x$ in these equations.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-x-topic-1-practice-b9a013ab-j9-20261111-b9a013ab-j9-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{align*}3^{x}\\times3^{2}&=3^{7}\\\\3^{x+\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}}&=3^{7}\\\\\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}&=7\\\\x&=\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\end{align*}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}3^{x}\\times3^{2}&=3^{7}\\\\3^{x+2}&=3^{7}\\\\x+2&=7\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "v2-x-topic-1-practice-b9a013ab-j9-20261111-b9a013ab-j9-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{align*}2^{x+1}\\times2^{4}&=2^{9}\\\\2^{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}&=2^{9}\\\\\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}&=9\\\\x&=\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\end{align*}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}2^{x+1}\\times2^{4}&=2^{9}\\\\2^{x+5}&=2^{9}\\\\x+5&=9\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "v2-x-topic-1-practice-b9a013ab-j9-20261111-b9a013ab-j9-c",
        "type": "part",
        "label": "c",
        "prompt": "$6^{2x} \\times 6^{x} = 6^{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}6^{2x}\\times6^{x}&=6^{15}\\\\6^{3x}&=6^{15}\\\\3x&=15\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
