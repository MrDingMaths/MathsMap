        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}AB^2&=(7-1)^2+(5-5)^2\\\\AB^2&=6^2+0^2\\\\AB^2&=36\\\\AB&=6\\end{align*}$$",
          "solutionDiagrams": []
