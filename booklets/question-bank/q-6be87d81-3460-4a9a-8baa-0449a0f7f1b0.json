        "children": [],
        "answer": {
          "short": "$2\\sqrt{17}$",
          "worked": "$$\\begin{align*}AB^2&=(3-1)^2+(-2-6)^2\\\\AB^2&=2^2+(-8)^2\\\\AB^2&=68\\\\AB&=\\sqrt{68}\\\\AB&=2\\sqrt{17}\\end{align*}$$",
