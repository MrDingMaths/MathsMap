    "children": [
      {
        "id": "p32-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{x^2}{9}$ defined in the domain $[0,3]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\dfrac{x^3}{27}$ for $0\\le x\\le3$; $F(x)=0$ for $x<0$ and $F(x)=1$ for $x>3$.",
          "worked": "For $0\\le x\\le3$:\n$$\\begin{align*}F(x)&=\\int_0^x\\frac{t^2}{9}\\,dt\\\\F(x)&=\\frac19\\left[\\frac{t^3}{3}\\right]_0^x\\\\F(x)&=\\frac{x^3}{27}.\\end{align*}$$\nOutside this interval, $F(x)=0$ for $x<0$ and $F(x)=1$ for $x>3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p32-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{e^x}{e^4-1}$ in the interval $0\\le x\\le4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\dfrac{e^x-1}{e^4-1}$ for $0\\le x\\le4$; $F(x)=0$ for $x<0$ and $F(x)=1$ for $x>4$.",
          "worked": "For $0\\le x\\le4$:\n$$\\begin{align*}F(x)&=\\int_0^x\\frac{e^t}{e^4-1}\\,dt\\\\F(x)&=\\frac{1}{e^4-1}\\left[e^t\\right]_0^x\\\\F(x)&=\\frac{e^x-1}{e^4-1}.\\end{align*}$$\nOutside this interval, $F(x)=0$ for $x<0$ and $F(x)=1$ for $x>4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p32-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{4(x-2)^3}{625}$ in the domain $[2,7]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\dfrac{(x-2)^4}{625}$ for $2\\le x\\le7$; $F(x)=0$ for $x<2$ and $F(x)=1$ for $x>7$.",
          "worked": "For $2\\le x\\le7$:\n$$\\begin{align*}F(x)&=\\int_2^x\\frac{4(t-2)^3}{625}\\,dt\\\\F(x)&=\\left[\\frac{(t-2)^4}{625}\\right]_2^x\\\\F(x)&=\\frac{(x-2)^4}{625}.\\end{align*}$$\nOutside this interval, $F(x)=0$ for $x<2$ and $F(x)=1$ for $x>7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p32-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{3x(8-x)}{135}$ in the domain $[2,5]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\dfrac{12x^2-x^3-40}{135}$ for $2\\le x\\le5$; $F(x)=0$ for $x<2$ and $F(x)=1$ for $x>5$.",
          "worked": "For $2\\le x\\le5$:\n$$\\begin{align*}F(x)&=\\int_2^x\\frac{3t(8-t)}{135}\\,dt\\\\F(x)&=\\frac{3}{135}\\left[4t^2-\\frac{t^3}{3}\\right]_2^x\\\\F(x)&=\\frac{3}{135}\\left(4x^2-\\frac{x^3}{3}-16+\\frac83\\right)\\\\F(x)&=\\frac{12x^2-x^3-40}{135}.\\end{align*}$$\nOutside this interval, $F(x)=0$ for $x<2$ and $F(x)=1$ for $x>5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
