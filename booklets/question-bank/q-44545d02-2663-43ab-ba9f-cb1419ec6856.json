  "content": {
    "id": "p3-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A car travels 20 km in 0.5 hours and then 50 km in 1.5 hours. Calculate the car’s average speed over the whole trip.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$35\\text{ km/h}$.",
      "worked": "$$\\begin{align*}\\text{Average speed}&=\\frac{\\text{total distance}}{\\text{total time}}\\\\\\text{Average speed}&=\\frac{20+50}{0.5+1.5}\\\\\\text{Average speed}&=\\frac{70}{2}=35\\text{ km/h}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
