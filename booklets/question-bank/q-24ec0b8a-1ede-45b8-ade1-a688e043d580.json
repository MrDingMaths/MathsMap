  "content": {
    "id": "sum-product-b1-2-root",
    "type": "question",
    "label": null,
    "prompt": "If $\\alpha$ and $\\beta$ are the zeroes of $5x^2-3x-1=0$, find:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "sum-product-b1-2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac35$",
          "worked": "$$\\begin{aligned}\\alpha+\\beta&=-\\frac ba\\\\\\alpha+\\beta&=-\\frac{-3}{5}\\\\\\alpha+\\beta&=\\frac35\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "sum-product-b1-2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac15$",
          "worked": "$$\\begin{aligned}\\alpha\\beta&=\\frac ca\\\\\\alpha\\beta&=\\frac{-1}{5}\\\\\\alpha\\beta&=-\\frac15\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "sum-product-b1-2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha^2+\\beta^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{19}{25}$",
          "worked": "$$\\begin{aligned}\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\\\alpha^2+\\beta^2&=\\left(\\frac35\\right)^2-2\\left(-\\frac15\\right)\\\\\\alpha^2+\\beta^2&=\\frac{9}{25}+\\frac{10}{25}\\\\\\alpha^2+\\beta^2&=\\frac{19}{25}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "sum-product-b1-2-d",
        "type": "part",
        "label": "d",
        "prompt": "$|\\alpha-\\beta|$\n\n(hint: square it)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{29}}{5}$",
          "worked": "$$\\begin{aligned}(\\alpha-\\beta)^2&=(\\alpha+\\beta)^2-4\\alpha\\beta\\\\(\\alpha-\\beta)^2&=\\left(\\frac35\\right)^2-4\\left(-\\frac15\\right)\\\\(\\alpha-\\beta)^2&=\\frac{9}{25}+\\frac{20}{25}\\\\(\\alpha-\\beta)^2&=\\frac{29}{25}\\\\|\\alpha-\\beta|&=\\frac{\\sqrt{29}}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
