  "content": {
    "id": "p3-practice-rocket-root",
    "type": "question",
    "label": "",
    "prompt": "A model rocket is launched into the air. Its height after $t$ seconds is given by $h(t)=-t^2+10t$, where $h$ is in metres.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-practice-rocket-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the average rate of change of height between $t=0$ and $t=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\text{Average rate of change}&=\\frac{h(4)-h(0)}{4-0}\\\\&=\\frac{(-4^2+10\\times4)-0}{4}\\\\&=\\frac{24}{4}\\\\&=6\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-practice-rocket-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the average rate of change of height between $t=6$ and $t=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\text{Average rate of change}&=\\frac{h(10)-h(6)}{10-6}\\\\&=\\frac{(-10^2+10\\times10)-(-6^2+10\\times6)}{4}\\\\&=\\frac{0-24}{4}\\\\&=-6\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
