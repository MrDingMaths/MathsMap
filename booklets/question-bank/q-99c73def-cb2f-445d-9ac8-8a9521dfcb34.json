    "id": "p10-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The line passing through the points $(1,4)$ and $(3,a)$ has gradient $2$. Find the value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=8$",
      "worked": "$$\\begin{align*}2&=\\frac{a-4}{3-1}\\\\2&=\\frac{a-4}{2}\\\\a-4&=4\\\\a&=8\\end{align*}$$",
