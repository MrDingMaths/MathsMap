    "id": "intro-functions-parameter-r6-1-root",
    "type": "question",
    "label": null,
    "prompt": "$f(x)=px^2+3x$.\n\nFind $p$ if $f(-2)=2f(1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=6$.",
      "worked": "$$\\begin{align*}f(-2)&=p(-2)^2+3(-2)\\\\&=4p-6\\\\f(1)&=p(1)^2+3(1)\\\\&=p+3\\\\4p-6&=2(p+3)\\\\4p-6&=2p+6\\\\2p&=12\\\\p&=6\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
