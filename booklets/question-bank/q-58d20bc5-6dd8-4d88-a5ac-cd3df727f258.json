  "content": {
    "id": "p16-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Use the quotient rule to differentiate:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q3-a",
        "type": "part",
        "label": "a",
        "prompt": ": $y=\\dfrac{e^x}{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{e^x(2x-3)}{(2x-1)^2}$",
          "worked": "$$\\begin{align*}y'&=\\frac{(2x-1)e^x-2e^x}{(2x-1)^2}\\\\y'&=\\frac{e^x(2x-3)}{(2x-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac{x}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(1-x)e^{-x}$",
          "worked": "$$\\begin{align*}y'&=\\frac{e^x-xe^x}{e^{2x}}\\\\y'&=(1-x)e^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{e^x}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{e^x(x-2)}{x^3}$",
          "worked": "$$\\begin{align*}y'&=\\frac{x^2e^x-2xe^x}{x^4}\\\\y'&=\\left(\\frac{x-2}{x^3}\\right)e^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p16-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{x^2}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(2x-x^2)e^{-x}$",
          "worked": "$$\\begin{align*}y'&=\\frac{2xe^x-x^2e^x}{e^{2x}}\\\\y'&=(2x-x^2)e^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{e^x}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{xe^x}{(x+1)^2}$",
          "worked": "$$\\begin{align*}y'&=\\frac{(x+1)e^x-e^x}{(x+1)^2}\\\\y'&=\\frac{xe^x}{(x+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p16-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{x+1}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-xe^{-x}$",
          "worked": "$$\\begin{align*}y'&=\\frac{e^x-(x+1)e^x}{e^{2x}}\\\\y'&=-xe^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\frac{x-3}{e^{2x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(7-2x)e^{-2x}$",
          "worked": "$$\\begin{align*}y'&=\\frac{e^{2x}-2(x-3)e^{2x}}{e^{4x}}\\\\y'&=(7-2x)e^{-2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\frac{1-x^2}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x^2-2x-1)e^{-x}$",
          "worked": "$$\\begin{align*}y'&=\\frac{-2xe^x-(1-x^2)e^x}{e^{2x}}\\\\y'&=(x^2-2x-1)e^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
