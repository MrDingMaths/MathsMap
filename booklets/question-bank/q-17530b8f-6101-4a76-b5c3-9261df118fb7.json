  "content": {
    "id": "v2-49160-p14-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "A rectangle has area $\\frac{15a}{8}$ cm$^2$ and width $\\frac{3a}{4}$ cm.\n\nFind the length of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{2}\\text{ cm}$",
      "worked": "$$\\begin{align*}\\text{Length} &= \\frac{15a}{8}\\div\\frac{3a}{4}\\\\&=\\frac{15a}{8}\\times\\frac{4}{3a}\\\\&=\\frac{5}{2}\\times\\frac{1}{1}\\\\&=\\frac{5}{2}\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
