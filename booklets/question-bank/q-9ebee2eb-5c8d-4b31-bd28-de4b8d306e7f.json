        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the multiple of 6 closest to 1000.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1002$",
          "worked": "$$1000=6\\times166+4.$$ The adjacent multiples are $996$ and $1002$.\n$$\\begin{align*}1000-996&=4\\\\1002-1000&=2\\end{align*}$$Therefore, the closest multiple is $1002$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the multiple of 4 closest to 112233.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$112232$",
          "worked": "$$112233=4\\times28058+1.$$ The adjacent multiples are $112232$ and $112236$.\n$$\\begin{align*}112233-112232&=1\\\\112236-112233&=3\\end{align*}$$Therefore, the closest multiple is $112232$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the multiple of 7 closest to 123456.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$123459$",
          "worked": "$$123456=7\\times17636+4.$$ The adjacent multiples are $123452$ and $123459$.\n$$\\begin{align*}123456-123452&=4\\\\123459-123456&=3\\end{align*}$$Therefore, the closest multiple is $123459$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
