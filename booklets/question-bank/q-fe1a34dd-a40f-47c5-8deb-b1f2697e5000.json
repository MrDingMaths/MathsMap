    "type": "question",
    "label": "3",
    "prompt": "A rectangular prism has a volume of $660\\text{ cm}^3$. If its length is $12\\text{ cm}$ and its width is $11\\text{ cm}$, calculate the height of the rectangular prism.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5\\text{ cm}$",
      "worked": "$$\\begin{align*}V&=Ah\\\\660&=(12\\times11)h\\\\h&=\\frac{660}{132}\\\\h&=5\\text{ cm}\\end{align*}$$",
