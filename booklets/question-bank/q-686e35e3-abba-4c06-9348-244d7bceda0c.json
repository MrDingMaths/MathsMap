          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "What is the largest whole number of nuggets that ",
              "marks": []
            },
            {
              "type": "text",
              "text": "cannot",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": " be purchased?",
              "marks": []
