              "type": "text",
              "text": "A fast food store sells nuggets in boxes of 5 and 8. ",
              "marks": []
            }
          ]
        },
        {
          "id": "p37-q18-demonstration",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "You can buy 31 nuggets at a time since ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "3\\times5+2\\times8=31",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
