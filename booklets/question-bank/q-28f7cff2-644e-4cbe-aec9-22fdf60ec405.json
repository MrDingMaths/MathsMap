  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Rationalise the denominator for each of the numbers below:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\frac{1}{2+\\sqrt2+\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{2+5\\sqrt2+3\\sqrt3-4\\sqrt6}{23}$",
          "worked": "$$\\begin{align*}\\frac{1}{2+\\sqrt2+\\sqrt3}&=\\frac{2+\\sqrt2-\\sqrt3}{(2+\\sqrt2)^2-3}\\\\\\frac{1}{2+\\sqrt2+\\sqrt3}&=\\frac{2+\\sqrt2-\\sqrt3}{3+4\\sqrt2}\\\\\\frac{1}{2+\\sqrt2+\\sqrt3}&=\\frac{(2+\\sqrt2-\\sqrt3)(4\\sqrt2-3)}{32-9}\\\\\\frac{1}{2+\\sqrt2+\\sqrt3}&=\\frac{2+5\\sqrt2+3\\sqrt3-4\\sqrt6}{23}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p14-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\frac{1}{1+\\sqrt3+\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{7+3\\sqrt3-\\sqrt5-2\\sqrt{15}}{11}$",
          "worked": "$$\\begin{align*}\\frac{1}{1+\\sqrt3+\\sqrt5}&=\\frac{1+\\sqrt3-\\sqrt5}{(1+\\sqrt3)^2-5}\\\\\\frac{1}{1+\\sqrt3+\\sqrt5}&=\\frac{1+\\sqrt3-\\sqrt5}{2\\sqrt3-1}\\\\\\frac{1}{1+\\sqrt3+\\sqrt5}&=\\frac{(1+\\sqrt3-\\sqrt5)(2\\sqrt3+1)}{12-1}\\\\\\frac{1}{1+\\sqrt3+\\sqrt5}&=\\frac{7+3\\sqrt3-\\sqrt5-2\\sqrt{15}}{11}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p14-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\frac{1}{1+\\sqrt2-\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{2+\\sqrt2+\\sqrt6}{4}$",
          "worked": "$$\\begin{align*}\\frac{1}{1+\\sqrt2-\\sqrt3}&=\\frac{1+\\sqrt2+\\sqrt3}{(1+\\sqrt2)^2-3}\\\\\\frac{1}{1+\\sqrt2-\\sqrt3}&=\\frac{1+\\sqrt2+\\sqrt3}{2\\sqrt2}\\\\\\frac{1}{1+\\sqrt2-\\sqrt3}&=\\frac{(1+\\sqrt2+\\sqrt3)\\sqrt2}{4}\\\\\\frac{1}{1+\\sqrt2-\\sqrt3}&=\\frac{2+\\sqrt2+\\sqrt6}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p14-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\frac{1}{3-\\sqrt3-\\sqrt6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle-\\frac{3\\sqrt2+2\\sqrt3+\\sqrt6}{12}$",
          "worked": "$$\\begin{align*}\\frac{1}{3-\\sqrt3-\\sqrt6}&=\\frac{3-\\sqrt3+\\sqrt6}{(3-\\sqrt3)^2-6}\\\\\\frac{1}{3-\\sqrt3-\\sqrt6}&=\\frac{3-\\sqrt3+\\sqrt6}{6-6\\sqrt3}\\\\\\frac{1}{3-\\sqrt3-\\sqrt6}&=\\frac{(3-\\sqrt3+\\sqrt6)(1+\\sqrt3)}{6(1-3)}\\\\\\frac{1}{3-\\sqrt3-\\sqrt6}&=-\\frac{3\\sqrt2+2\\sqrt3+\\sqrt6}{12}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
