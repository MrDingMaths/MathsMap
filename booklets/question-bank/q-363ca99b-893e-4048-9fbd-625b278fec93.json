    "type": "question",
    "label": "3",
    "prompt": "Find $\\dfrac{dy}{dx}$, leaving your answer in index notation.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^{-\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-\\dfrac12x^{-\\frac32}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=-\\frac12x^{-\\frac12-1}\\\\\\frac{dy}{dx}&=-\\frac12x^{-\\frac32}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^{\\frac32}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac32x^{\\frac12}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\frac32x^{\\frac32-1}\\\\\\frac{dy}{dx}&=\\frac32x^{\\frac12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=6x^{\\frac23}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=4x^{-\\frac13}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=6\\times\\frac23x^{\\frac23-1}\\\\\\frac{dy}{dx}&=4x^{-\\frac13}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=12x^{-\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-4x^{-\\frac43}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=12\\times\\left(-\\frac13\\right)x^{-\\frac13-1}\\\\\\frac{dy}{dx}&=-4x^{-\\frac43}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=4x^{\\frac14}+8x^{-\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=x^{-\\frac34}-4x^{-\\frac32}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=4\\times\\frac14x^{\\frac14-1}\\\\&\\quad+8\\times\\left(-\\frac12\\right)x^{-\\frac12-1}\\\\\\frac{dy}{dx}&=x^{-\\frac34}-4x^{-\\frac32}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=7x^{\\frac73}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{49}{3}x^{\\frac43}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=7\\times\\frac73x^{\\frac73-1}\\\\\\frac{dy}{dx}&=\\frac{49}{3}x^{\\frac43}\\end{aligned}$$",
