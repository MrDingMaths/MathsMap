  "content": {
    "id": "p7-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find a relation between $x$ and $y$ that does not involve logarithms.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_3 x+\\log_3 y=\\log_3(x+y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy=x+y$",
          "worked": "$$\\begin{align*}\\log_3(xy)&=\\log_3(x+y)\\\\xy&=x+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\log_{10}x-3\\log_{10}y=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2=\\frac{1}{10}y^3$",
          "worked": "$$\\begin{align*}\\log_{10}(x^2)-\\log_{10}(y^3)&=-1\\\\\\log_{10}\\left(\\frac{x^2}{y^3}\\right)&=-1\\\\\\frac{x^2}{y^3}&=10^{-1}\\\\x^2&=\\frac{1}{10}y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_5 y=3+2\\log_5 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=125x^2$",
          "worked": "$$\\begin{align*}\\log_5 y-2\\log_5 x&=3\\\\\\log_5\\left(\\frac{y}{x^2}\\right)&=3\\\\\\frac{y}{x^2}&=5^3\\\\y&=125x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p7-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_7(1+y)-\\log_7(1-y)=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1+y}{1-y}=7^x$",
          "worked": "$$\\begin{align*}\\log_7\\left(\\frac{1+y}{1-y}\\right)&=x\\\\\\frac{1+y}{1-y}&=7^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
