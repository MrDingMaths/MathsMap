    "children": [
      {
        "id": "p24-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the sum of the infinite geometric series\n$$\\frac{1}{3}+\\frac{1}{3^2}+\\frac{1}{3^3}+\\cdots.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The first term and common ratio are both $\\frac{1}{3}$, with $|r|<1$.\n$$\\begin{align*}S&=\\frac{\\frac{1}{3}}{1-\\frac{1}{3}}\\\\S&=\\frac{1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the following sum\n$$\\frac{1}{3}+\\frac{2}{3^2}+\\frac{3}{3^3}+\\cdots.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{4}$\n\nSubtract one third of the series from itself and use part (a).",
          "worked": "Let $S$ denote the required sum.\n$$\\begin{align*}S&=\\frac{1}{3}+\\frac{2}{3^2}+\\frac{3}{3^3}+\\cdots\\\\\\frac{1}{3}S&=\\frac{1}{3^2}+\\frac{2}{3^3}+\\frac{3}{3^4}+\\cdots.\\end{align*}$$\nSubtracting gives the series in part (a):\n$$\\begin{align*}S-\\frac{1}{3}S&=\\frac{1}{3}+\\frac{1}{3^2}+\\frac{1}{3^3}+\\cdots\\\\S-\\frac{1}{3}S&=\\frac{1}{2}\\\\\\frac{2}{3}S&=\\frac{1}{2}\\\\S&=\\frac{3}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
