    "children": [
      {
        "id": "p11-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y=\\sin x$ is a solution of $y''+y=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y''=-\\sin x$, so $y''+y=-\\sin x+\\sin x=0$.",
          "worked": "$$\\begin{align*}y&=\\sin x\\\\y'&=\\cos x\\\\y''&=-\\sin x.\\end{align*}$$\n$$\\begin{align*}\\text{LHS}&=y''+y\\\\&=-\\sin x+\\sin x\\\\&=0=\\text{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p11-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "For a solution of $y''+y=0$, find $y''$ at a point where $y=12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y''=-12$.",
          "worked": "$$\\begin{align*}y''&=-y\\\\&=-12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p11-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "If $y=f(x)$ is a solution of this DE, what does the equation say about $f''(x)$? Answer in terms of a transformation of $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f''(x)=-f(x)$: the graph of $f''$ is the reflection of the graph of $f$ in the $x$-axis.",
          "worked": "$$\\begin{align*}f''(x)+f(x)&=0\\\\f''(x)&=-f(x).\\end{align*}$$\nThus the graph of $f''$ is the graph of $f$ reflected in the $x$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
