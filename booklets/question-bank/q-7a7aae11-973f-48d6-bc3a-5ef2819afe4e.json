  "content": {
    "id": "v2-ceb80-p39-practice-slot-1-upper-root",
    "type": "question",
    "label": null,
    "prompt": "A machine fills bottles with water. The volumes are normally distributed with mean 600 mL and standard deviation 5 mL. A bottle is rejected if it contains less than 590 mL or more than 615 mL. In a batch of 4000 bottles, how many are expected to be rejected?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately 106 bottles.",
      "worked": "$$\\begin{aligned}z(590)&=\\frac{590-600}{5}=-2\\\\z(615)&=\\frac{615-600}{5}=3\\\\P(Z<-2)&\\approx0.025\\\\P(Z>3)&\\approx0.0015\\\\P(\\text{rejected})&\\approx0.025+0.0015=0.0265\\\\\\text{Expected number}&=0.0265\\times4000=106\\text{ bottles}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
