  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the midpoint of the interval $AB$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(-1,2)$, $B(3,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,4)$",
          "worked": "$$\\begin{align*}x_M&=\\frac{-1+3}{2}\\\\x_M&=1\\\\y_M&=\\frac{2+6}{2}\\\\y_M&=4\\end{align*}$$\nThe midpoint is $(1,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(2,8)$, $B(-1,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac12,5\\right)$",
          "worked": "$$\\begin{align*}x_M&=\\frac{2+(-1)}{2}\\\\x_M&=\\frac12\\\\y_M&=\\frac{8+2}{2}\\\\y_M&=5\\end{align*}$$\nThe midpoint is $\\left(\\frac12,5\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(2,4)$, $B(6,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,6)$",
          "worked": "$$\\begin{align*}x_M&=\\frac{2+6}{2}\\\\x_M&=4\\\\y_M&=\\frac{4+8}{2}\\\\y_M&=6\\end{align*}$$\nThe midpoint is $(4,6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(-2,-6)$, $B(-4,-8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-3,-7)$",
          "worked": "$$\\begin{align*}x_M&=\\frac{-2+(-4)}{2}\\\\x_M&=-3\\\\y_M&=\\frac{-6+(-8)}{2}\\\\y_M&=-7\\end{align*}$$\nThe midpoint is $(-3,-7)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$A(-1,5)$, $B(2,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac12,6\\right)$",
          "worked": "$$\\begin{align*}x_M&=\\frac{-1+2}{2}\\\\x_M&=\\frac12\\\\y_M&=\\frac{5+7}{2}\\\\y_M&=6\\end{align*}$$\nThe midpoint is $\\left(\\frac12,6\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$A(-12,16)$, $B(2,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-5,12)$",
          "worked": "$$\\begin{align*}x_M&=\\frac{-12+2}{2}\\\\x_M&=-5\\\\y_M&=\\frac{16+8}{2}\\\\y_M&=12\\end{align*}$$\nThe midpoint is $(-5,12)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
