        "columns": null,
        "questionDiagrams": [
          {
            "id": "p29-q10-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 29 p29-q10-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (-1.5,1);\n\\coordinate (B) at (1.5,1);\n\\coordinate (C) at (0,0);\n\\coordinate (D) at (-2.4,-1.6);\n\\coordinate (E) at (2.4,-1.6);\n\\draw[black,line width=0.8pt] (A)--(B)--(D)--(E)--cycle;\n\\draw[black,line width=0.4pt,->] (-0.18,1)--(0.18,1);\n\\draw[black,line width=0.4pt,->] (-0.18,-1.6)--(0.18,-1.6);\n\\node[above left] at (A) {$A$};\n\\node[above right] at (B) {$B$};\n\\node[below,yshift=-2pt] at (C) {$C$};\n\\node[above left] at (D) {$D$};\n\\node[above right] at (E) {$E$};\n\\draw[black,line width=0.4pt,<->] ($(A)+(0,0.24)$)--node[midway,above] {$10\\text{ cm}$} ($(B)+(0,0.24)$);\n\\draw[black,line width=0.4pt,<->] ($(C)+(0.16,-0.24)$)--node[midway,below right] {$8\\text{ cm}$} ($(B)+(0.16,-0.24)$);\n\\draw[black,line width=0.4pt,<->] ($(D)+(0,-0.24)$)--node[midway,below] {$16\\text{ cm}$} ($(E)+(0,-0.24)$);\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 76,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 29,
              "sourceRegion": "Question 10a bow-tie diagram",
              "description": "Two opposing triangles share C. A, C and E are collinear; B, C and D are collinear. Matching parallel marks identify AB and DE. External dimension arrows identify AB, BC and DE. Decorative yellow fills are omitted.",
              "mathematics": "AB = 10 cm, BC = 8 cm, DE = 16 cm and AB is parallel to DE. Correspondence is A ↔ E, B ↔ D, C ↔ C.",
              "answerVisibility": "Only supplied givens and marks are visible; no derived lengths or proof annotations."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$\\angle ACB=\\angle ECD$ (vertically opposite), $\\angle BAC=\\angle DEC$ and $\\angle ABC=\\angle EDC$ (alternate angles). Therefore $\\triangle ABC\\sim\\triangle EDC$.",
          "worked": "$\\angle ACB=\\angle ECD$ (vertically opposite angles).\n\n$\\angle BAC=\\angle DEC$ (alternate angles, $AB\\parallel DE$).\n\n$\\angle ABC=\\angle EDC$ (alternate angles, $AB\\parallel DE$).\n\nTherefore $\\triangle ABC\\sim\\triangle EDC$, since all corresponding angles are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
