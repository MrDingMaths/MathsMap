  "content": {
    "id": "p20-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A parabola has $y$-intercept 4 and vertex at $(1,6)$. Find its equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-2(x-1)^2+6$, or $y=-2x^2+4x+4$.",
      "worked": "The vertex gives $y=a(x-1)^2+6$. The $y$-intercept gives the point $(0,4)$.\n\n$$\\begin{align*}4&=a(0-1)^2+6\\\\4&=a+6\\\\a&=-2\\end{align*}$$\n\nHence,\n$$\\begin{align*}y&=-2(x-1)^2+6\\\\y&=-2x^2+4x+4.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
