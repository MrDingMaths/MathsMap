  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x-2$ and $g(x)=\\sqrt{x}$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x}-2$",
          "worked": "$$\\begin{align*}f(g(x))&=g(x)-2\\\\f(g(x))&=\\sqrt{x}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p16-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, state the domain of $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge0$",
          "worked": "The square root requires $x\\ge0$, and subtracting $2$ adds no restriction. The domain is $[0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p16-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the domain of $g(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge2$",
          "worked": "$$g(f(x))=\\sqrt{x-2}.$$\nThe expression under the square root must be nonnegative:\n$$\\begin{align*}x-2&\\ge0\\\\x&\\ge2\\end{align*}$$\nThe domain is $[2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
