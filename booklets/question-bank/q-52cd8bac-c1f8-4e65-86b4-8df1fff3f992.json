        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\log_5(0.2)&=\\log_5(1/5)\\\\\\log_5(0.2)&=-\\log_5(5)\\\\\\log_5(0.2)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_5\\left(\\frac{8}{9}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a-2b$",
          "worked": "$$\\begin{align*}\\log_5(8/9)&=\\log_5(2^3/3^2)\\\\\\log_5(8/9)&=\\log_5(2^3)-\\log_5(3^2)\\\\\\log_5(8/9)&=3\\log_5(2)-2\\log_5(3)\\\\\\log_5(8/9)&=3a-2b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_5(\\sqrt{30})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(a+b+1)$",
          "worked": "$$\\begin{align*}\\log_5(\\sqrt{30})&=\\tfrac12\\log_5(2\\cdot3\\cdot5)\\\\\\log_5(\\sqrt{30})&=\\tfrac12(\\log_5(2)+\\log_5(3)+\\log_5(5))\\\\\\log_5(\\sqrt{30})&=\\tfrac12(a+b+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_5(6.4)$",
        "layout": "list",
        "columns": null,
