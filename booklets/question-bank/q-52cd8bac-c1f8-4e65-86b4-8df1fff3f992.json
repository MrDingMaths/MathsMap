        "children": [],
        "answer": {
          "short": "$a+b$",
          "worked": "$$\\begin{align*}\\log_5(6)&=\\log_5(2\\cdot3)\\\\\\log_5(6)&=\\log_5(2)+\\log_5(3)\\\\\\log_5(6)&=a+b\\end{align*}$$",
