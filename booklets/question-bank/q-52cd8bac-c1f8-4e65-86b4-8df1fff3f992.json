        "answer": {
          "short": "$b-a$",
          "worked": "$$\\begin{align*}\\log_5(1.5)&=\\log_5(3/2)\\\\\\log_5(1.5)&=\\log_5(3)-\\log_5(2)\\\\\\log_5(1.5)&=b-a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
