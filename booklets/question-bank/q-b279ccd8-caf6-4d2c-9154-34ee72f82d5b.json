  "content": {
    "id": "v2-0f4f9-p16-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "$v$ varies directly with $w$ and $v = 35$ when $w = 45$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-0f4f9-p16-practice-slot-6-s6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$w$ when $v = 28$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w = 36$",
          "worked": "$$\\begin{align*}v &= kw\\\\35 &= k(45)\\\\k &= \\frac{35}{45}\\\\k &= \\frac{7}{9}\\\\v &= \\frac{7}{9}w\\\\28 &= \\frac{7}{9}w\\\\w &= 28\\times\\frac{9}{7}\\\\w &= 36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-0f4f9-p16-practice-slot-6-s6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$v$ when $w = 1.8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v = 1.4$",
          "worked": "Using $v = \\frac{7}{9}w$ from part a:\n$$\\begin{align*}v &= \\frac{7}{9}(1.8)\\\\v &= 1.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
