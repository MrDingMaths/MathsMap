        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$256=2^8$; $\\sqrt{256}=16$.",
          "worked": "$$\\begin{align*}256&=16\\times16\\\\256&=2^4\\times2^4\\\\256&=2^8\\\\\\sqrt{256}&=2^4\\\\\\sqrt{256}&=16\\end{align*}$$",
