          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "True or False?",
              "marks": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-tf-group-part-a",
        "type": "part",
        "label": "a",
        "prompt": "The gradient of a horizontal line is zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "A horizontal line has zero change in $y$. Its rise is zero, so its gradient is $0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p32-tf-group-part-b",
        "type": "part",
        "label": "b",
        "prompt": "The gradient of a vertical line is $\\pm\\infty$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. The gradient is undefined.",
          "worked": "A vertical line has zero change in $x$. The gradient formula $m=\\frac{y_2-y_1}{x_2-x_1}$ would require division by zero, so the gradient is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p32-tf-group-part-c",
        "type": "part",
        "label": "c",
        "prompt": "If the angle of inclination is acute, then $m>0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "For an acute angle $\\theta$, $\\tan\\theta>0$. Since $m=\\tan\\theta$, the gradient is positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p32-tf-group-part-d",
        "type": "part",
        "label": "d",
        "prompt": "If the angle of inclination is $90^\\circ$, then $m=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. $m$ is undefined.",
          "worked": "An angle of inclination of $90^\\circ$ gives a vertical line. Its gradient is undefined because the change in $x$ is zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p32-tf-group-part-e",
        "type": "part",
        "label": "e",
        "prompt": "Profit is the total amount of money from sales.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. This is revenue.",
          "worked": "Revenue is the total money received from sales. Profit is revenue minus cost: $P(x)=R(x)-C(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p32-tf-group-part-f",
        "type": "part",
        "label": "f",
        "prompt": "Profit is the difference between cost and revenue.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False (intended reading). Profit is revenue minus cost.",
          "worked": "The intended false statement interprets the printed order as cost minus revenue. Profit is given by $P(x)=R(x)-C(x)$. The wording “difference between” alone does not specify the subtraction order.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
