  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve the following quadratic equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x-5)^2=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5\\pm\\sqrt3$",
          "worked": "$$\\begin{align*}(x-5)^2&=3\\\\x-5&=\\pm\\sqrt3\\\\x&=5\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+2)^2-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2\\pm\\sqrt3$",
          "worked": "$$\\begin{align*}(x+2)^2-3&=0\\\\(x+2)^2&=3\\\\x+2&=\\pm\\sqrt3\\\\x&=-2\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x-1)^2-\\frac19=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac23$ or $x=\\frac43$",
          "worked": "$$\\begin{align*}(x-1)^2&=\\frac19\\\\x-1&=\\pm\\frac13\\\\x&=1\\pm\\frac13\\\\x&=\\frac23\\text{ or }x=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x+2)^2-6\\frac14=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$ or $x=-\\frac92$",
          "worked": "$$\\begin{align*}(x+2)^2&=6\\frac14=\\frac{25}{4}\\\\x+2&=\\pm\\frac52\\\\x&=-2\\pm\\frac52\\\\x&=\\frac12\\text{ or }x=-\\frac92\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
