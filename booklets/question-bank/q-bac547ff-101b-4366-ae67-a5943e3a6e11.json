  "content": {
    "id": "p25-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "In a game of Australian Rules football, a team scored $\\frac{1}{6}$ of its total points in the first quarter, $\\frac{2}{9}$ of its points in the second quarter and $\\frac{5}{27}$ of its points in the third quarter.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the team’s points were scored in the first two quarters?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{18}$",
          "worked": "$$\\begin{align*}\\frac{1}{6}+\\frac{2}{9}&=\\frac{3}{18}+\\frac{4}{18}\\\\\\frac{1}{6}+\\frac{2}{9}&=\\frac{7}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p25-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the team’s points were scored in the first three quarters?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{31}{54}$",
          "worked": "$$\\begin{align*}\\frac{7}{18}+\\frac{5}{27}&=\\frac{21}{54}+\\frac{10}{54}\\\\\\frac{7}{18}+\\frac{5}{27}&=\\frac{31}{54}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p25-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "What fraction of the team’s points were scored in the final (fourth) quarter?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{23}{54}$",
          "worked": "Subtract the fraction scored in the first three quarters from the whole total.\n$$\\begin{align*}1-\\frac{31}{54}&=\\frac{54}{54}-\\frac{31}{54}\\\\1-\\frac{31}{54}&=\\frac{23}{54}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
