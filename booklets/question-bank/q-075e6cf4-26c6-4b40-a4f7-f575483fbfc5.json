    "children": [
      {
        "id": "p14-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the prime factorisation of $108$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$108=2^2\\times3^3$.",
          "worked": "$$\\begin{align*}108&=2\\times54\\\\108&=2\\times2\\times27\\\\108&=2\\times2\\times3\\times3\\times3\\\\108&=2^2\\times3^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why $108$ has twelve factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q8-b-short-count",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(2+1)(3+1)=12",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " factors.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p14-q8-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Each factor chooses one of three powers of ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and one of four powers of ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "3",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Every factor of $108=2^2\\times3^3$ has the form $2^a3^b$, where $a=0,1,2$ and $b=0,1,2,3$. There are three choices for $a$ and four choices for $b$. Unique prime factorisation ensures that these choices give distinct factors, so there are $3\\times4=12$ factors.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find a natural number less than $108$ with the same number of factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q8-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "96",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " (for example).",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p14-q8-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "96=2^5\\times3",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", it has ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(5+1)(1+1)=12",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " factors.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$96=2^5\\times3<108$. Every factor of $96$ has the form $2^a3^b$, where $a=0,1,2,3,4,5$ and $b=0,1$. There are six choices for $a$ and two choices for $b$, giving $6\\times2=12$ factors. Thus $96$ is a suitable number.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
