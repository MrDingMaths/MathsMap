  "content": {
    "id": "p10-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "When breeding labradors, the probability of breeding a black dog is $\\frac{5}{7}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability of breeding a dog that is not black?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{7}$",
          "worked": "$\\begin{aligned}P(\\text{not black})&=1-P(\\text{black})\\\\P(\\text{not black})&=1-\\frac{5}{7}\\\\P(\\text{not black})&=\\frac{2}{7}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "If you bred 56 dogs, how many would you expect not to be black?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "16 dogs",
          "worked": "$\\begin{aligned}f&=np\\\\f&=56\\times\\frac{2}{7}\\\\f&=16\\end{aligned}$\n\nExpect 16 dogs not to be black.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
