  "content": {
    "id": "v2-5021a0-p9-practice-retro-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "A rectangular prism display case measures $1.2$ m by $0.7$ m by $2$ m.\nPriya paints all the faces of the case.\nOne tin of paint costs $\\$12$. Each tin covers $4\\text{ m}^2$.\nWork out the total cost of the paint that Priya needs.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$36$",
      "worked": "$$\\begin{align*}A&=2(1.2\\times0.7)+2(1.2\\times2)+2(0.7\\times2)\\\\&=1.68+4.8+2.8\\\\&=9.28\\text{ m}^2\\\\\\text{Tins required}&=9.28\\div4\\\\&=2.32\\end{align*}$$\nPriya needs $3$ whole tins.\n$$\\begin{align*}\\text{Cost}&=\\$12\\times3\\\\&=\\$36\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
