    "answer": {
      "short": "\\$82.41",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p45-q16-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "$3.86 represents 10% of the pre-GST cost of the items charged GST.",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}\\text{GST-inclusive cost of taxable items} &= \\$3.86\\times11\\\\\\text{GST-inclusive cost of taxable items} &= \\$42.46\\\\\\text{Cost of items without GST} &= \\$124.87-\\$42.46\\\\\\text{Cost of items without GST} &= \\$82.41\\end{aligned}",
                "display": false
              }
            ]
          }
        ]
      },
