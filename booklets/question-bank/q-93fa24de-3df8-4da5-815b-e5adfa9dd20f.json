          "inlines": [
            {
              "type": "text",
              "text": "GST, at a rate of 10%, is only charged on some items.",
              "marks": []
            }
          ]
        },
        {
          "id": "p45-q16-request",
          "type": "paragraph",
          "fontSize": null,
