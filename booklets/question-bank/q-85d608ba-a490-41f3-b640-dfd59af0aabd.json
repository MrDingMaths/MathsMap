    "type": "question",
    "label": "21",
    "prompt": "If $x:y=3:5$ and $x+y=3$, then find the values of $x$ and $y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac{9}{8}$ and $y=\\frac{15}{8}$.",
      "worked": "There are $3+5=8$ parts in total.\n\n$$\\begin{align*}\\text{Value of one part}&=3\\div8\\\\\\text{Value of one part}&=\\frac{3}{8}\\\\x&=3\\times\\frac{3}{8}\\\\x&=\\frac{9}{8}\\\\y&=5\\times\\frac{3}{8}\\\\y&=\\frac{15}{8}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
