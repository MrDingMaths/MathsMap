    "answer": {
      "short": "$43.5$.\n\nDouble the original mean, multiply by $5$, then subtract the original total.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p16-q3-supplied-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Original total: ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "3+7+9+10=29",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Original mean: ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\frac{29}{4}=7.25",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "New mean: ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "2\\times7.25=14.5",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{align*}14.5&=\\frac{29+x}{5}\\\\72.5&=29+x\\\\x&=43.5\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
