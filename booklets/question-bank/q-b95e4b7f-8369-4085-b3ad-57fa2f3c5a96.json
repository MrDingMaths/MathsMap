    "label": null,
    "prompt": "Let $f(x)=x-x^3$. Show that $f(-x)=-f(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(-x)=-x+x^3=-(x-x^3)=-f(x)$.",
      "worked": "$$\\begin{align*}f(-x)&=(-x)-(-x)^3\\\\f(-x)&=-x+x^3\\\\f(-x)&=-(x-x^3)\\\\f(-x)&=-f(x).\\end{align*}$$",
