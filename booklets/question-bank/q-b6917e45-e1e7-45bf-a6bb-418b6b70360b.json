        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=0$",
          "worked": "At the $y$-intercept, $x=0$.\n$$\\begin{align*}5&=(0-h)^2+5\\\\h^2&=0\\\\h&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
