    "id": "p32-review-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Consider the parabola $y=(x-h)^2+5$. Find the value of $h$ if the $y$-intercept is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-review-q2a",
        "type": "part",
