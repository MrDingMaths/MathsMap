    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q22-27-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin2\\theta\\cos\\theta-\\cos2\\theta\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\theta$",
          "worked": "$$\\begin{align*}\\sin2\\theta\\cos\\theta-\\cos2\\theta\\sin\\theta&=\\sin(2\\theta-\\theta)\\\\\\sin2\\theta\\cos\\theta-\\cos2\\theta\\sin\\theta&=\\sin\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q22-27-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos3\\theta\\sin2\\theta+\\sin3\\theta\\cos2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin5\\theta$",
          "worked": "$$\\begin{align*}\\cos3\\theta\\sin2\\theta+\\sin3\\theta\\cos2\\theta&=\\sin(3\\theta+2\\theta)\\\\\\cos3\\theta\\sin2\\theta+\\sin3\\theta\\cos2\\theta&=\\sin5\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q22-27-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\tan3\\theta-\\tan\\theta}{1+\\tan3\\theta\\tan\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan2\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\tan3\\theta-\\tan\\theta}{1+\\tan3\\theta\\tan\\theta}&=\\tan(3\\theta-\\theta)\\\\\\frac{\\tan3\\theta-\\tan\\theta}{1+\\tan3\\theta\\tan\\theta}&=\\tan2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p22-q22-27-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos(\\alpha+\\beta)\\cos\\beta+\\sin(\\alpha+\\beta)\\sin\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\alpha$",
          "worked": "$$\\begin{align*}\\cos(\\alpha+\\beta)\\cos\\beta+\\sin(\\alpha+\\beta)\\sin\\beta&=\\cos((\\alpha+\\beta)-\\beta)\\\\\\cos(\\alpha+\\beta)\\cos\\beta+\\sin(\\alpha+\\beta)\\sin\\beta&=\\cos\\alpha\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q22-27-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin(\\alpha-\\beta)\\cos\\beta+\\cos(\\alpha-\\beta)\\sin\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\alpha$",
          "worked": "$$\\begin{align*}\\sin(\\alpha-\\beta)\\cos\\beta+\\cos(\\alpha-\\beta)\\sin\\beta&=\\sin((\\alpha-\\beta)+\\beta)\\\\\\sin(\\alpha-\\beta)\\cos\\beta+\\cos(\\alpha-\\beta)\\sin\\beta&=\\sin\\alpha\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q22-27-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\tan(\\alpha-\\beta)+\\tan(\\beta)}{1-\\tan(\\alpha-\\beta)\\tan(\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\alpha$",
          "worked": "$$\\begin{align*}\\frac{\\tan(\\alpha-\\beta)+\\tan(\\beta)}{1-\\tan(\\alpha-\\beta)\\tan(\\beta)}&=\\tan((\\alpha-\\beta)+\\beta)\\\\\\frac{\\tan(\\alpha-\\beta)+\\tan(\\beta)}{1-\\tan(\\alpha-\\beta)\\tan(\\beta)}&=\\tan\\alpha\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
