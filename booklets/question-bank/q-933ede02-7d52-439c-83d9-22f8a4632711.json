  "content": {
    "id": "p33-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A cylindrical water tank has a diameter of 3 m and a height of 2 m. Calculate, to the nearest 100 mL, the volume of the tank in:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\text{m}^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14.1372\\text{ m}^3$",
          "worked": "Radius $r=\\frac{3}{2}=1.5$ m, so $V=\\pi(1.5)^2(2)=4.5\\pi\\text{ m}^3$. The nearest 100 mL is $0.0001\\text{ m}^3$, giving $V\\approx14.1372\\text{ m}^3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p33-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "litres",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14\\,137.2\\text{ L}$",
          "worked": "Use the unrounded volume: $4500\\pi\\text{ L}\\approx14\\,137.2\\text{ L}$ to the nearest $0.1$ L (100 mL).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
