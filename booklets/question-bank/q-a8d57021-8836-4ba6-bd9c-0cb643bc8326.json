  "content": {
    "id": "p28-q18",
    "type": "question",
    "label": "18",
    "prompt": "A car costs $\\$12\\,000$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Helen pays a deposit of 30% and pays the rest in 12 monthly instalments at 0% interest. How much does she pay each month?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$700$ per month.",
          "worked": "$$\\begin{align*}\\text{Deposit} &= 0.3\\times12\\,000\\\\\\text{Deposit} &= \\$3600\\end{align*}$$\n$$\\begin{align*}\\text{Amount left to pay} &= 12\\,000-3600\\\\\\text{Amount left to pay} &= \\$8400\\end{align*}$$\n$$\\begin{align*}\\text{Monthly payment} &= 8400\\div12\\\\\\text{Monthly payment} &= \\$700\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p28-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "The price of the car decreases by 13%. What is the new price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$10\\,440$.",
          "worked": "$$\\begin{align*}\\text{New price} &= 12\\,000(1-0.13)\\\\\\text{New price} &= 12\\,000\\times0.87\\\\\\text{New price} &= \\$10\\,440\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "Steven sells the car for $\\$14\\,880$. What is his percentage profit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24\\%$.",
          "worked": "$$\\begin{align*}\\text{Profit} &= 14\\,880-12\\,000\\\\\\text{Profit} &= \\$2880\\end{align*}$$\n$$\\begin{align*}\\text{Percentage profit} &= \\frac{2880}{12\\,000}\\times100\\%\\\\\\text{Percentage profit} &= 24\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p28-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "The value of the car depreciates by 7% each year. How much is it worth after 5 years? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$8348.26$.",
          "worked": "$$\\begin{align*}S &= V_0(1-r)^n\\\\S &= 12\\,000(1-0.07)^5\\\\S &= 12\\,000(0.93)^5\\\\S &\\approx \\$8348.26\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
