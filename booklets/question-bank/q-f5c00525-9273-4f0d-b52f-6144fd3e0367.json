  "content": {
    "id": "p8-q11-root",
    "type": "question",
    "label": "",
    "prompt": "Convert the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$7.2\\ \\mathrm{Gg}$ to $\\mathrm{t}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7200\\ \\mathrm{t}$",
          "worked": "A tonne is $1\\ \\mathrm{Mg}$. Convert to the smaller unit by multiplying.\n$$\\begin{align*}7.2\\ \\mathrm{Gg}&=(7.2\\times1000)\\ \\mathrm{Mg}\\\\&=7200\\ \\mathrm{Mg}\\\\&=7200\\ \\mathrm{t}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$2.9\\ \\mathrm{cg}$ to $\\mathrm{ng}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$29\\,000\\,000\\ \\mathrm{ng}$",
          "worked": "$1\\ \\mathrm{cg}=10\\ \\mathrm{mg}$, and each further step to micrograms and nanograms multiplies by $1000$.\n$$\\begin{align*}2.9\\ \\mathrm{cg}&=(2.9\\times10\\times1000\\times1000)\\ \\mathrm{ng}\\\\&=29\\,000\\,000\\ \\mathrm{ng}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$9\\ \\mathrm{kL}$ to $\\mathrm{mL}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\,000\\,000\\ \\mathrm{mL}$",
          "worked": "Multiply by $1000$ from kilolitres to litres, then by $1000$ from litres to millilitres.\n$$\\begin{align*}9\\ \\mathrm{kL}&=(9\\times1000\\times1000)\\ \\mathrm{mL}\\\\&=9\\,000\\,000\\ \\mathrm{mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$4.3\\ \\mathrm{cm}$ to $\\mu\\mathrm{m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$43\\,000\\ \\mu\\mathrm{m}$",
          "worked": "Multiply by $10$ from centimetres to millimetres, then by $1000$ to micrometres.\n$$\\begin{align*}4.3\\ \\mathrm{cm}&=(4.3\\times10\\times1000)\\ \\mu\\mathrm{m}\\\\&=43\\,000\\ \\mu\\mathrm{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$5.3\\ \\mathrm{ms}$ to $\\mathrm{ns}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\,300\\,000\\ \\mathrm{ns}$",
          "worked": "Multiply by $1000$ from milliseconds to microseconds, then by $1000$ to nanoseconds.\n$$\\begin{align*}5.3\\ \\mathrm{ms}&=(5.3\\times1000\\times1000)\\ \\mathrm{ns}\\\\&=5\\,300\\,000\\ \\mathrm{ns}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$9\\ \\mathrm{kg}$ to $\\mathrm{mg}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\,000\\,000\\ \\mathrm{mg}$",
          "worked": "Multiply by $1000$ from kilograms to grams, then by $1000$ to milligrams.\n$$\\begin{align*}9\\ \\mathrm{kg}&=(9\\times1000\\times1000)\\ \\mathrm{mg}\\\\&=9\\,000\\,000\\ \\mathrm{mg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
