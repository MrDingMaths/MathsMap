  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "What is the domain of each function?",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real numbers.",
          "worked": "The exponential expression $2^x$ is defined for every real value of $x$. The domain is all real numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=7^{3x}+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real numbers.",
          "worked": "The exponential expression $7^{3x}$ is defined for every real value of $x$. Adding $5$ introduces no restriction, so the domain is all real numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\log_5 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>0$.",
          "worked": "The argument of a logarithm must be positive. Hence the domain is $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\log_3(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>2$.",
          "worked": "The logarithmic argument must be positive:\n\n$$\\begin{align*}x-2&>0\\\\x&>2\\end{align*}$$\n\nThe domain is $x>2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\log_2(-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<0$.",
          "worked": "The logarithmic argument must be positive:\n\n$$\\begin{align*}-x&>0\\\\x&<0\\end{align*}$$\n\nDividing by $-1$ reverses the inequality. The domain is $x<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=2\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real numbers.",
          "worked": "The expression $\\sin x$ is defined for every real value of $x$. Multiplying by $2$ introduces no restriction, so the domain is all real numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
