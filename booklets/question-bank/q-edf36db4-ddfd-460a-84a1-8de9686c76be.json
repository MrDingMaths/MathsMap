      {
        "id": "p15-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why the table is not symmetrical along the diagonal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The number of likes one friend gives another need not equal the number received in return.",
          "worked": "The likes are directed. For example, Keira gives Charlotte 32 likes, while Charlotte gives Keira 6, so the corresponding entries on opposite sides of the diagonal differ.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why the diagonal is blank within the context of the scenario.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The table records likes given to the other friends, not to their own posts.",
          "worked": "Each diagonal entry would represent a friend liking their own posts. The scenario records likes the friends give to each other, so these entries are not included.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
