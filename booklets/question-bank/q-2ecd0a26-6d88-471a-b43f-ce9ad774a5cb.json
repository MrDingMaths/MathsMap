    "type": "question",
    "label": "9",
    "prompt": "A car uses 40 L of petrol to travel 320 km. How far can it travel with 50 L of petrol?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$400\\text{ km}$",
      "worked": "$$\\begin{aligned}\\text{Distance per litre}&=320\\div40=8\\text{ km}\\\\\\text{Distance with 50 L}&=50\\times8=400\\text{ km}.\\end{aligned}$$",
