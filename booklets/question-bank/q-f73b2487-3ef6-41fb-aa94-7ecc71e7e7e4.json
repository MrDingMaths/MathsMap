  "content": {
    "id": "p11-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "If $A=\\{1,4,7,8\\}$ and $B=\\{1,2,4,5,7\\}$, state whether the following statements are true or false.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. $8\\in A$ but $8\\notin B$, so the sets do not have the same elements.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$|A|=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. $A$ contains the four distinct elements $1,4,7,8$, so $|A|=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$|B|=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. $B$ contains five distinct elements, so $|B|=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "$A\\subset B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False; $8\\in A$ but $8\\notin B$.",
          "worked": "False. $8\\in A$ but $8\\notin B$, so $A$ is not a subset of $B$ and therefore cannot be a proper subset.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-e",
        "type": "part",
        "label": "e",
        "prompt": "$A\\cup B=\\{1,2,4,5,7,8\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The union contains every element in either set, with no repetitions: $A\\cup B=\\{1,2,4,5,7,8\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-f",
        "type": "part",
        "label": "f",
        "prompt": "$A\\cap B=\\{1,4,7\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The elements common to both sets are $1,4,7$, so $A\\cap B=\\{1,4,7\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
