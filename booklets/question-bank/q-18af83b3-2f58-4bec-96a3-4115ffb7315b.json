        "type": "part",
        "label": "a",
        "prompt": "Divide $\\$72$ in the ratio $1:2:5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$9$, $\\$18$ and $\\$45$.",
          "worked": "$$\\begin{align*}\\text{Total parts}&=1+2+5=8\\\\\\text{One part}&=\\$72\\div8=\\$9\\\\\\text{First share}&=1\\times\\$9=\\$9\\\\\\text{Second share}&=2\\times\\$9=\\$18\\\\\\text{Third share}&=5\\times\\$9=\\$45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q8b",
        "type": "part",
        "label": "b",
        "prompt": "Divide $95\\text{ kg}$ in the ratio $5:6:8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\text{ kg}$, $30\\text{ kg}$ and $40\\text{ kg}$.",
          "worked": "$$\\begin{align*}\\text{Total parts}&=5+6+8=19\\\\\\text{One part}&=95\\div19=5\\text{ kg}\\\\\\text{First share}&=5\\times5=25\\text{ kg}\\\\\\text{Second share}&=6\\times5=30\\text{ kg}\\\\\\text{Third share}&=8\\times5=40\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
