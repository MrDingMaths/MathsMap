  "content": {
    "id": "p24-review-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "There are 10 marbles, numbered 1 to 10, in a bowl. A marble is randomly taken out. What is the probability of getting:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-review-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "a 6?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "Only the outcome 6 is favourable, out of 10 equally likely outcomes.\n\n$$P(6)=\\frac{1}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-review-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "an even number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The favourable outcomes are $\\{2,4,6,8,10\\}$.\n\n$$\\begin{align*}P(\\text{even number})&=\\frac{5}{10}\\\\P(\\text{even number})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-review-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "a number divisible by 5?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "The favourable outcomes are $\\{5,10\\}$.\n\n$$\\begin{align*}P(\\text{divisible by }5)&=\\frac{2}{10}\\\\P(\\text{divisible by }5)&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-review-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "a number greater than 4?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "The favourable outcomes are $\\{5,6,7,8,9,10\\}$.\n\n$$\\begin{align*}P(\\text{number greater than }4)&=\\frac{6}{10}\\\\P(\\text{number greater than }4)&=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
