      {
        "id": "p20-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down, in factored form, the monic quadratic polynomial $P(x)$ with factors $x-12$ and $x+9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x-12)(x+9)$.",
          "worked": "The polynomial is monic, so the multiplier of the product is 1.\n\n$$P(x)=(x-12)(x+9).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Expand $P(x)$, then show that $P(12)$ and $P(-9)$ are both zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=x^2-3x-108$; $P(12)=P(-9)=0$.",
          "worked": "$$\\begin{align*}P(x)&=x^2+9x-12x-108\\\\P(x)&=x^2-3x-108\\end{align*}$$\n\n$$\\begin{align*}P(12)&=144-36-108\\\\P(12)&=0\\\\P(-9)&=81+27-108\\\\P(-9)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
