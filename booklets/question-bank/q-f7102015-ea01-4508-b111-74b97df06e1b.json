  "content": {
    "id": "p58-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The curve $y=3x^2-4$ has a gradient of $6$ at point $A$.\nFind the equation of the tangent to the curve at $A$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6x-y-7=0$",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=6x\\\\6x&=6\\\\x&=1\\\\y&=3(1)^2-4\\\\y&=-1\\end{align*}$$\nThus $A=(1,-1)$.\n$$\\begin{align*}y-(-1)&=6(x-1)\\\\y+1&=6x-6\\\\6x-y-7&=0\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
