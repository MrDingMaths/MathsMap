  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the gradient from $A$ to $B$ for each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(1,3),\\ B(3,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}m&=\\frac{7-3}{3-1}\\\\m&=\\frac{4}{2}\\\\m&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(2,5),\\ B(3,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}m&=\\frac{8-5}{3-2}\\\\m&=\\frac{3}{1}\\\\m&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(-1,1),\\ B(1,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}m&=\\frac{5-1}{1-(-1)}\\\\m&=\\frac{4}{2}\\\\m&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(-3,2),\\ B(9,-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{7}{12}$",
          "worked": "$$\\begin{align*}m&=\\frac{-5-2}{9-(-3)}\\\\m&=-\\frac{7}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$A(-5,2),\\ B(-3,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}m&=\\frac{6-2}{-3-(-5)}\\\\m&=\\frac{4}{2}\\\\m&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$A(-4,-3),\\ B(7,-8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{5}{11}$",
          "worked": "$$\\begin{align*}m&=\\frac{-8-(-3)}{7-(-4)}\\\\m&=-\\frac{5}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$A(\\frac12,\\frac14),\\ B(\\frac32,\\frac34)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}m&=\\frac{\\frac34-\\frac14}{\\frac32-\\frac12}\\\\m&=\\frac{\\frac12}{1}\\\\m&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$A(\\frac12,\\frac34),\\ B(\\frac56,\\frac78)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac38$",
          "worked": "$$\\begin{align*}m&=\\frac{\\frac78-\\frac34}{\\frac56-\\frac12}\\\\m&=\\frac{\\frac18}{\\frac13}\\\\m&=\\frac18\\times3\\\\m&=\\frac38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
