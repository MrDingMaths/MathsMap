  "content": {
    "id": "p12-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A rectangle has length $x$ cm and width $\\frac{2x}{5}$ cm. What is the area of the rectangle? Find the area if $x=10$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2x^2}{5}\\text{ cm}^2$; when $x=10$, $40\\text{ cm}^2$.",
      "worked": "Area is length multiplied by width.\n\n$$\\begin{align*}A&=x\\times\\frac{2x}{5}\\\\A&=\\frac{2x\\times x}{5}\\\\A&=\\frac{2x^2}{5}\\text{ cm}^2\\end{align*}$$\n\nWhen $x=10$:\n\n$$\\begin{align*}A&=\\frac{2\\times10^2}{5}\\\\A&=40\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
