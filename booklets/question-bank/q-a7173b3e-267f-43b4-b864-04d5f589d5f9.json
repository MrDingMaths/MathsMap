  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the derivative of each function in simplest form:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x\\cos^{-1}x-\\sqrt{1-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^{-1}x$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\cos^{-1}x-\\frac{x}{\\sqrt{1-x^2}}-\\frac{-2x}{2\\sqrt{1-x^2}}\\\\&=\\cos^{-1}x-\\frac{x}{\\sqrt{1-x^2}}+\\frac{x}{\\sqrt{1-x^2}}\\\\&=\\cos^{-1}x.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      },
      {
        "id": "p17-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin^{-1}(e^{3x})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3e^{3x}}{\\sqrt{1-e^{6x}}}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{3e^{3x}}{\\sqrt{1-(e^{3x})^2}}\\\\&=\\frac{3e^{3x}}{\\sqrt{1-e^{6x}}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p17-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin^{-1}\\!\\left(\\dfrac{2x-3}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac2{\\sqrt{7+12x-4x^2}}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{1/2}{\\sqrt{1-\\left(\\frac{2x-3}{4}\\right)^2}}\\\\&=\\frac2{\\sqrt{16-(2x-3)^2}}\\\\&=\\frac2{\\sqrt{7+12x-4x^2}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p17-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan^{-1}\\!\\left(\\dfrac1{1-x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{x^2-2x+2}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{(1-x)^{-2}}{1+\\left(\\frac1{1-x}\\right)^2}\\\\&=\\frac1{(1-x)^2+1}\\\\&=\\frac1{x^2-2x+2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p17-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin^{-1}(e^x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{e^x}{\\sqrt{1-e^{2x}}}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{e^x}{\\sqrt{1-(e^x)^2}}\\\\&=\\frac{e^x}{\\sqrt{1-e^{2x}}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p17-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_e\\sqrt{\\sin^{-1}x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{2\\sin^{-1}x\\sqrt{1-x^2}}$",
          "worked": "$$\\begin{aligned}y&=\\frac12\\log_e(\\sin^{-1}x),\\\\\\frac{dy}{dx}&=\\frac1{2\\sin^{-1}x}\\cdot\\frac1{\\sqrt{1-x^2}}\\\\&=\\frac1{2\\sin^{-1}x\\sqrt{1-x^2}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sin^{-1}\\sqrt{\\log_e x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{2x\\sqrt{\\log_e x\\,(1-\\log_e x)}}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\frac1{\\sqrt{1-\\log_e x}}\\cdot\\frac1{2\\sqrt{\\log_e x}}\\cdot\\frac1x\\\\&=\\frac1{2x\\sqrt{\\log_e x\\,(1-\\log_e x)}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p17-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sqrt{x}\\sin^{-1}\\sqrt{1-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sin^{-1}\\sqrt{1-x}}{2\\sqrt{x}}-\\dfrac1{2\\sqrt{1-x}}$",
          "worked": "By the product and chain rules,\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{\\sin^{-1}\\sqrt{1-x}}{2\\sqrt{x}}\\\\&\\quad+\\sqrt{x}\\cdot\\frac{-1}{2\\sqrt{1-x}\\sqrt{1-(1-x)}}\\\\&=\\frac{\\sin^{-1}\\sqrt{1-x}}{2\\sqrt{x}}-\\frac{\\sqrt{x}}{2\\sqrt{1-x}\\sqrt{x}}\\\\&=\\frac{\\sin^{-1}\\sqrt{1-x}}{2\\sqrt{x}}-\\frac1{2\\sqrt{1-x}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p17-q8-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\tan^{-1}\\!\\left(\\dfrac{x+2}{1-2x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{x^2+1}$",
          "worked": "Let $u=\\dfrac{x+2}{1-2x}$.\n$$\\begin{aligned}u'&=\\frac{(1-2x)+2(x+2)}{(1-2x)^2}\\\\&=\\frac5{(1-2x)^2},\\\\\\frac{dy}{dx}&=\\frac{\\dfrac5{(1-2x)^2}}{1+\\left(\\frac{x+2}{1-2x}\\right)^2}\\\\&=\\frac5{(1-2x)^2+(x+2)^2}\\\\&=\\frac5{5x^2+5}\\\\&=\\frac1{x^2+1}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
