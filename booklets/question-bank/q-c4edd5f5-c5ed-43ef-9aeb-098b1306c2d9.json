  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": null,
    "prompt": "Solve for $x$ in each of the following cases:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "The average of $x$, 2 and 3 is equal to 7.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=16$",
          "worked": "$$\\begin{align*}\\frac{x+2+3}{3}&=7\\\\x+5&=21\\\\x&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "The average of $x$, $\\frac{3}{4}$ and $\\frac{4}{3}$ is equal to 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{11}{12}$",
          "worked": "$$\\begin{align*}\\frac{x+\\frac{3}{4}+\\frac{4}{3}}{3}&=1\\\\x+\\frac{3}{4}+\\frac{4}{3}&=3\\\\x+\\frac{9}{12}+\\frac{16}{12}&=\\frac{36}{12}\\\\x&=\\frac{11}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p6-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "The average of $x$, 4 and 5 is equal to $2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p6-q7-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x=\\frac{9}{5}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p6-q7-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Multiply both sides by 3, then collect the unknown on one side.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{x+4+5}{3}&=2x\\\\x+9&=6x\\\\9&=5x\\\\x&=\\frac{9}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
