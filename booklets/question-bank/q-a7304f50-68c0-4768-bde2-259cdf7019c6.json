    "children": [
      {
        "id": "p5-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the total area of the large square by expanding $(a+b)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+2ab+b^2$",
          "worked": "$$\\begin{align*}A&=(a+b)^2\\\\A&=a^2+2ab+b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the total area of the large square by finding the sum of four triangular areas and the area of the smaller square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\times\\frac{ab}{2}+c^2=2ab+c^2$",
          "worked": "Each right triangle has area $\\frac{ab}{2}$; the smaller square has area $c^2$.\n$$\\begin{align*}A&=4\\times\\frac{ab}{2}+c^2\\\\A&=2ab+c^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Equate the two results, and deduce the Pythagorean Theorem.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+b^2=c^2$, by equating the areas and subtracting $2ab$.",
          "worked": "$$\\begin{align*}a^2+2ab+b^2&=2ab+c^2\\\\a^2+b^2&=c^2\\end{align*}$$\nThus the square of the hypotenuse equals the sum of the squares of the other two sides.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
