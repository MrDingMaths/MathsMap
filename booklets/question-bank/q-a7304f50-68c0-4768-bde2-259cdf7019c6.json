        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"triangleFill\",\"hex\":\"FCDFE1\",\"reason\":\"four congruent triangle areas\"},{\"name\":\"squareFill\",\"hex\":\"FCE8D5\",\"reason\":\"central square area\"}],\"reference\":\"source page 5 p5-q11-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{triangleFill}{HTML}{FCDFE1}\\definecolor{squareFill}{HTML}{FCE8D5}\n\\coordinate (O) at (0,0);\\coordinate (X) at (4,0);\\coordinate (Y) at (4,4);\\coordinate (Z) at (0,4);\n\\coordinate (P) at (1.5,0);\\coordinate (Q) at (4,1.5);\\coordinate (R) at (2.5,4);\\coordinate (S) at (0,2.5);\n\\fill[triangleFill] (O)--(X)--(Y)--(Z)--cycle;\n\\fill[squareFill] (P)--(Q)--(R)--(S)--cycle;\n\\draw[black,line width=0.8pt] (O)--(X)--(Y)--(Z)--cycle;\n\\draw[black,line width=0.8pt] (P)--(Q)--(R)--(S)--cycle;\n\\path (O)--node[below] {$a$}(P);\\path (O)--node[left] {$b$}(S);\\path (S)--node[midway,below right] {$c$}(P);\n\\end{tikzpicture}",
