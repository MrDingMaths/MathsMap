        "axes": null,
        "spec": {
          "sourcePage": 5,
          "sourceRegion": "Right column, question 11",
          "description": "Large square containing a tilted square and four congruent right triangles. Light red and orange distinguish the areas in the proof.",
          "mathematics": "Outer side a+b; corner-triangle legs a and b; inner-square side c. Drawing coordinates specify proportions only, not numerical givens.",
