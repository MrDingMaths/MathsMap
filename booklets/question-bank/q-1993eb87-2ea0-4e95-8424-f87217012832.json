    "difficulty": "Development",
    "difficultyReason": "Calculate observed and theoretical probabilities and explain their difference through random variation."
  },
  "content": {
    "id": "p24-q2",
    "type": "question",
    "label": "2",
    "prompt": "When a fair coin is tossed 100 times, the results are 53 heads and 47 tails.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the relative frequency of getting a tail?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{47}{100}$",
          "worked": "$$\\begin{align*}rf&=\\frac{\\text{Frequency of tails}}{\\text{Total trials}}\\\\rf&=\\frac{47}{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the theoretical probability of getting a tail?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}=\\frac{50}{100}$",
          "worked": "A fair coin has two equally likely outcomes, and one is a tail.\n$$\\begin{align*}P(\\text{tail})&=\\frac{1}{2}\\\\P(\\text{tail})&=\\frac{50}{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why the theoretical probability and relative frequency do not match.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Random variation means the observed proportion in 100 tosses need not equal the theoretical probability.",
          "worked": "The theoretical probability is $\\frac{1}{2}$, while the observed relative frequency is $\\frac{47}{100}$. Random variation means 100 tosses need not produce exactly 50 tails.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
