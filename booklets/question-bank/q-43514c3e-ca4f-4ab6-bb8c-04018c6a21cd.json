  "content": {
    "id": "p15-g31-34-root",
    "type": "question",
    "label": null,
    "prompt": "Given the following functions, find $f(2)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-g31-34-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}f(2)&=3(2)-1\\\\f(2)&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-g31-34-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2x^2+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}f(2)&=2(2)^2+2\\\\f(2)&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-g31-34-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}f(2)&=\\frac{1}{2-1}\\\\f(2)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-g31-34-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{x+2}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}f(2)&=\\frac{2+2}{2-3}\\\\f(2)&=\\frac{4}{-1}\\\\f(2)&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
