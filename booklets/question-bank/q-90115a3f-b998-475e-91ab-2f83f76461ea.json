  "content": {
    "id": "sum-product-b1-4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the value(s) of $k$ if the quadratic equation $x^2+kx+6=0$ has consecutive roots.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\pm5$",
      "worked": "Let the roots be $r$ and $r+1$.\n$$\\begin{aligned}r(r+1)&=6\\\\r^2+r-6&=0\\end{aligned}$$\nPSF: Product $=-6$, Sum $=1$, Factors $=3$ and $-2$.\n$$\\begin{aligned}(r+3)(r-2)&=0\\\\r&=-3\\text{ or }2\\end{aligned}$$\nSum of roots:\n$$\\begin{aligned}r+(r+1)&=-k\\\\2r+1&=-k\\end{aligned}$$\nWhen $r=2$: $5=-k$, so $k=-5$.\n\nWhen $r=-3$: $-5=-k$, so $k=5$.\n\nHence $k=\\pm5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
