  "content": {
    "id": "p36-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If I started a train trip at 1430 and finished it at 0625 the next day, how long did the journey take?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "15 hours 55 minutes",
      "worked": "From 1430 to midnight is 9 hours 30 minutes. From midnight to 0625 is 6 hours 25 minutes.\n\n$$\\begin{align*}\\text{Journey time}&=9\\text{ h }30\\text{ min}+6\\text{ h }25\\text{ min}\\\\\\text{Journey time}&=15\\text{ h }55\\text{ min}\\end{align*}$$",
      "solutionDiagrams": []
    },
