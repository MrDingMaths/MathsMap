        "answer": {
          "short": "$250500$",
          "worked": "$a=2,\\ d=2,\\ \\ell=1000$\n$$\\begin{aligned}a_n&=a+(n-1)d\\\\1000&=2+(n-1)(2)\\\\998&=2n-2\\\\1000&=2n\\\\n&=500\\end{aligned}$$\n$$\\begin{aligned}S_{500}&=\\frac{500}{2}(2+1000)\\\\S_{500}&=250500\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p21-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$1000+1001+\\cdots+3000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4002000$",
          "worked": "$a=1000,\\ d=1,\\ \\ell=3000$\n$$\\begin{aligned}a_n&=a+(n-1)d\\\\3000&=1000+(n-1)(1)\\\\2000&=n-1\\\\n&=2001\\end{aligned}$$\n$$\\begin{aligned}S_{2001}&=\\frac{2001}{2}(1000+3000)\\\\S_{2001}&=4002000\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p21-q4-c",
