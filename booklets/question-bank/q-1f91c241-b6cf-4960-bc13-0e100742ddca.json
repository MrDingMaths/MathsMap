            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"regionOrange\",\"hex\":\"FCE8D5\",\"reason\":\"identifies the triangle whose area is requested\"}],\"reference\":\"source page 10, p10-q3-a-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{regionOrange}{HTML}{FCE8D5}\n\\fill[regionOrange] (0,1)--(2,0)--(3,3)--cycle;\n\\draw[black,line width=0.25pt,step=1] (0,0) grid (3,3);\n\\draw[black,line width=0.8pt] (0,1)--(2,0)--(3,3)--cycle;\n\\end{tikzpicture}",
