    "children": [
      {
        "id": "p22-q3-c",
        "type": "part",
        "label": "a",
        "prompt": "Solve $2x+8=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}2x+8&=10\\\\2x&=2\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q3-d",
        "type": "part",
        "label": "b",
        "prompt": "Factorise $2x+8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x+4)$",
          "worked": "$$\\begin{align*}2x+8&=2\\times x+2\\times4\\\\&=2(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p22-q3-e",
        "type": "part",
        "label": "c",
        "prompt": "Evaluate $2x+8$ if $x=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{align*}2x+8&=2\\times3+8\\\\&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p22-q3-f",
        "type": "part",
        "label": "d",
        "prompt": "Expand and simplify $(2x+8)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+32x+64$",
          "worked": "$$\\begin{align*}(2x+8)^2&=(2x+8)(2x+8)\\\\&=4x^2+16x+16x+64\\\\&=4x^2+32x+64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
