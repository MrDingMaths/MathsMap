      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Use calculus to find the gradient of the tangent to $y=e^x$ at $P(1,e)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=e^x\\\\\\left.\\frac{dy}{dx}\\right|_{x=1}&=e^1=e\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the equation of the tangent at $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=ex$",
          "worked": "$$\\begin{aligned}y-e&=e(x-1)\\\\y&=ex-e+e\\\\y&=ex\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the $x$-intercept of the tangent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "At $y=0$,\n$$\\begin{aligned}0&=ex\\\\x&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
