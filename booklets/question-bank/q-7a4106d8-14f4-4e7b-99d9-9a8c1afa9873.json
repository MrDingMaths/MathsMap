    "type": "question",
    "label": "4",
    "prompt": "Determine if y=-2x+3 contains the point (1,0).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No.",
      "worked": "For $x=1$,\n$$\\begin{align*}-2x+3&=-2(1)+3\\\\-2x+3&=1.\\end{align*}$$\nSince $1\\ne0$, $(1,0)$ does not lie on the line.",
      "solutionDiagrams": []
    },
