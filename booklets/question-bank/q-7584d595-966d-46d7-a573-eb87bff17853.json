  "content": {
    "id": "v2-2ee03-p25-practice-slot-13-lower-root",
    "type": "question",
    "label": null,
    "prompt": "The graph of a monic cubic polynomial $P(x)$ is shown.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "v2-2ee03-p25-practice-slot-13-lower-slot-13-lower-q-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"slot-13 lower graph\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.12cm]\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\\def\\tk#1{\\special{dvisvgm:raw <g data-graph-text=\"tick\">}#1\\special{dvisvgm:raw </g>}}\\draw[<->,black,line width=0.5pt] (-3.2,0)--(4.4,0) node[right] {$x$};\\draw[<->,black,line width=0.5pt] (0,-13)--(0,18) node[above] {$y$};\\draw[<->,black,line width=0.8pt] plot[domain=-2.2:3.7,samples=140] (\\x,{(\\x+1)^2*(\\x-3)});\\node[above] at (-1,0) {\\tk{$-1$}};\\node[above left] at (3,0) {\\tk{$3$}};\\end{tikzpicture}",
        "src": null,
        "widthMm": 60,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": false
      }
    ],
    "children": [
      {
        "id": "v2-2ee03-p25-practice-slot-13-lower-slot-13-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the equation of $P(x)$ in factorised form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x+1)^2(x-3)$",
          "worked": "The curve touches the $x$-axis at $x=-1$, a double root, and crosses at $x=3$, a single root. The polynomial is monic, so\n$$P(x)=(x+1)^2(x-3).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-2ee03-p25-practice-slot-13-lower-slot-13-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the values of $b$, $c$ and $d$ in $P(x)=x^3+bx^2+cx+d$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-1$, $c=-5$, $d=-3$",
          "worked": "$$\\begin{align*}P(x)&=(x^2+2x+1)(x-3)\\\\&=x^2(x-3)+2x(x-3)+1(x-3)\\\\&=x^3-3x^2+2x^2-6x+x-3\\\\&=x^3-x^2-5x-3\\end{align*}$$\nHence $b=-1$, $c=-5$, $d=-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
