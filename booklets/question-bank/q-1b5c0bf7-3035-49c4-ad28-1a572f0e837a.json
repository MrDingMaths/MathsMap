  "content": {
    "id": "p20-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Use a similar technique to Question 11 to solve the following equations for $\\theta$ in the domain $\\theta\\in[0^\\circ,360^\\circ]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos(\\theta+60^\\circ)=\\frac{\\sqrt3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=270^\\circ,330^\\circ$.",
          "worked": "Let $u=\\theta+60^\\circ$, so $u\\in[60^\\circ,420^\\circ]$. The related angle is $30^\\circ$.\n$$\\begin{align*}\\cos u&=\\frac{\\sqrt3}{2}\\\\u&=330^\\circ,390^\\circ\\\\\\theta&=u-60^\\circ\\\\\\theta&=270^\\circ,330^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p20-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan(\\theta-45^\\circ)=\\frac1{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=75^\\circ,255^\\circ$.",
          "worked": "Let $u=\\theta-45^\\circ$, so $u\\in[-45^\\circ,315^\\circ]$. The related angle is $30^\\circ$.\n$$\\begin{align*}\\tan u&=\\frac1{\\sqrt3}\\\\u&=30^\\circ,210^\\circ\\\\\\theta&=u+45^\\circ\\\\\\theta&=75^\\circ,255^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p20-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin(\\theta+150^\\circ)=-\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^\\circ,180^\\circ$.",
          "worked": "Let $u=\\theta+150^\\circ$, so $u\\in[150^\\circ,510^\\circ]$. Sine is negative in the third and fourth quadrants; the related angle is $30^\\circ$.\n$$\\begin{align*}\\sin u&=-\\frac12\\\\u&=210^\\circ,330^\\circ\\\\\\theta&=u-150^\\circ\\\\\\theta&=60^\\circ,180^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p20-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan(\\theta+210^\\circ)=-\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=90^\\circ,270^\\circ$.",
          "worked": "Let $u=\\theta+210^\\circ$, so $u\\in[210^\\circ,570^\\circ]$. Tangent is negative in the second and fourth quadrants; the related angle is $60^\\circ$.\n$$\\begin{align*}\\tan u&=-\\sqrt3\\\\u&=300^\\circ,480^\\circ\\\\\\theta&=u-210^\\circ\\\\\\theta&=90^\\circ,270^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
