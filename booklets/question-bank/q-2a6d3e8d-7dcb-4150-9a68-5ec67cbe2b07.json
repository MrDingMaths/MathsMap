  "content": {
    "id": "p24-review-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Twenty cards are put in a hat. Fifteen of the cards are blue and numbered 1 to 15. The other five cards are red and numbered 16 to 20. A card is taken randomly from the hat. Find the probability of taking out:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-review-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "a blue card",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{4}$",
          "worked": "There are 15 blue cards among 20 cards.\n\n$$P(\\text{blue})=\\frac{15}{20}=\\frac{3}{4}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-review-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "a red card",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "There are 5 red cards among 20 cards.\n\n$$P(\\text{red})=\\frac{5}{20}=\\frac{1}{4}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-review-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "a red card with an odd number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "The red cards with odd numbers are 17 and 19, giving 2 favourable outcomes.\n\n$$P(\\text{red and odd})=\\frac{2}{20}=\\frac{1}{10}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-review-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "a number greater than 16",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "The favourable numbers are 17, 18, 19 and 20.\n\n$$P(\\text{number greater than }16)=\\frac{4}{20}=\\frac{1}{5}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-review-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "an odd number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "There are 10 odd numbers from 1 to 20.\n\n$$P(\\text{odd})=\\frac{10}{20}=\\frac{1}{2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-review-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "a number divisible by 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "The favourable numbers are 3, 6, 9, 12, 15 and 18.\n\n$$P(\\text{divisible by }3)=\\frac{6}{20}=\\frac{3}{10}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
