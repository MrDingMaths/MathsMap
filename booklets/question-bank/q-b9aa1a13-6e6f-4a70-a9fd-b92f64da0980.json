  "content": {
    "id": "p12-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Decide which elements would need to be removed from event $A$ if the two events $A$ and $B$ described below are to become mutually exclusive.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\{1,2,3,4\\},\\quad B=\\{4,5,6,7\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remove $4$ from $A$.",
          "worked": "$A\\cap B=\\{4\\}$. Remove $4$ from $A$ so the events have no elements in common.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\{10,12,14,16,18\\},\\quad B=\\{9,10,11,12\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remove $10$ and $12$ from $A$.",
          "worked": "$A\\cap B=\\{10,12\\}$. Remove $10$ and $12$ from $A$ so the events have no elements in common.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$A=\\{a,b,c,d,e\\},\\quad B=\\{a,c,e,g\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remove $a$, $c$ and $e$ from $A$.",
          "worked": "$A\\cap B=\\{a,c,e\\}$. Remove $a$, $c$ and $e$ from $A$ so the events have no elements in common.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "$A=\\{1,3,5,8,10,15,20,22,23\\},\\quad B=\\{7,9,14,16,19,21,26\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No elements need removing; the events are already mutually exclusive.",
          "worked": "$A\\cap B=\\varnothing$. The events have no elements in common, so no elements need removing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
