        "type": "part",
        "label": "(3)",
        "prompt": "Explain why this option is correct or incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Incorrect. The same 25,000 dollars rise took 18 months, then 4 months.",
          "worked": "March 2009 to September 2010 is 18 months; September 2010 to January 2011 is 4 months.\nEach increase is 25,000 dollars, so equal increases over unequal time intervals give different average rates.",
