  "content": {
    "id": "p12-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the equation of the tangent and normal to $y=2x-x^2$ at $x=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Tangent $y=-2x+4$. Normal $y=\\frac12x-1$.",
      "worked": "At $x=2$, $y=2(2)-2^2=0$. Since $y'=2-2x$, the tangent gradient is $2-2(2)=-2$ and the normal gradient is $\\frac12$.\n\nFor the tangent through $(2,0)$,\n\n$$\\begin{align*}y&=-2(x-2)\\\\y&=-2x+4.\\end{align*}$$\n\nFor the normal through $(2,0)$,\n\n$$\\begin{align*}y&=\\frac12(x-2)\\\\y&=\\frac12x-1.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 31
  },
