  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Use a product-to-sum formula to evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\frac{5\\pi}{12}\\cos\\frac{\\pi}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "$$\\begin{align*}\\cos\\frac{5\\pi}{12}\\cos\\frac{\\pi}{12}&=\\frac12\\left[\\cos\\left(\\frac{5\\pi}{12}-\\frac{\\pi}{12}\\right)+\\cos\\left(\\frac{5\\pi}{12}+\\frac{\\pi}{12}\\right)\\right]\\\\\\cos\\frac{5\\pi}{12}\\cos\\frac{\\pi}{12}&=\\frac12\\left(\\cos\\frac\\pi3+\\cos\\frac\\pi2\\right)\\\\\\cos\\frac{5\\pi}{12}\\cos\\frac{\\pi}{12}&=\\frac12\\left(\\frac12+0\\right)\\\\\\cos\\frac{5\\pi}{12}\\cos\\frac{\\pi}{12}&=\\frac14.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\frac{11\\pi}{24}\\sin\\frac{7\\pi}{24}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt2-1}{4}$",
          "worked": "$$\\begin{align*}\\cos\\frac{11\\pi}{24}\\sin\\frac{7\\pi}{24}&=\\frac12\\left[\\sin\\left(\\frac{7\\pi}{24}+\\frac{11\\pi}{24}\\right)+\\sin\\left(\\frac{7\\pi}{24}-\\frac{11\\pi}{24}\\right)\\right]\\\\\\cos\\frac{11\\pi}{24}\\sin\\frac{7\\pi}{24}&=\\frac12\\left[\\sin\\frac{3\\pi}{4}+\\sin\\left(-\\frac\\pi6\\right)\\right]\\\\\\cos\\frac{11\\pi}{24}\\sin\\frac{7\\pi}{24}&=\\frac12\\left(\\frac{\\sqrt2}{2}-\\frac12\\right)\\\\\\cos\\frac{11\\pi}{24}\\sin\\frac{7\\pi}{24}&=\\frac{\\sqrt2-1}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\frac{3\\pi}{8}\\sin\\frac\\pi8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\sin\\frac{3\\pi}{8}\\sin\\frac\\pi8&=\\frac12\\left[\\cos\\left(\\frac{3\\pi}{8}-\\frac\\pi8\\right)-\\cos\\left(\\frac{3\\pi}{8}+\\frac\\pi8\\right)\\right]\\\\\\sin\\frac{3\\pi}{8}\\sin\\frac\\pi8&=\\frac12\\left(\\cos\\frac\\pi4-\\cos\\frac\\pi2\\right)\\\\\\sin\\frac{3\\pi}{8}\\sin\\frac\\pi8&=\\frac12\\left(\\frac{\\sqrt2}{2}-0\\right)\\\\\\sin\\frac{3\\pi}{8}\\sin\\frac\\pi8&=\\frac{\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\frac{19\\pi}{24}\\sin\\frac\\pi{24}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1-\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\cos\\frac{19\\pi}{24}\\sin\\frac\\pi{24}&=\\frac12\\left[\\sin\\left(\\frac\\pi{24}+\\frac{19\\pi}{24}\\right)+\\sin\\left(\\frac\\pi{24}-\\frac{19\\pi}{24}\\right)\\right]\\\\\\cos\\frac{19\\pi}{24}\\sin\\frac\\pi{24}&=\\frac12\\left[\\sin\\frac{5\\pi}{6}+\\sin\\left(-\\frac{3\\pi}{4}\\right)\\right]\\\\\\cos\\frac{19\\pi}{24}\\sin\\frac\\pi{24}&=\\frac12\\left(\\frac12-\\frac{\\sqrt2}{2}\\right)\\\\\\cos\\frac{19\\pi}{24}\\sin\\frac\\pi{24}&=\\frac{1-\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
