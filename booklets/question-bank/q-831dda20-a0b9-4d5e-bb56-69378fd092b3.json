    "children": [
      {
        "id": "p11-ex18b-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $a\\propto b$ and $b=0.5$ when $a=1$, find the formula for $a$ in terms of $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2b$",
          "worked": "Since $a\\propto b$, $a=kb$ for some constant $k$.\n\nWhen $a=1$ and $b=0.5$:\n$$\\begin{align*}1&=k\\times0.5\\\\k&=\\frac{1}{0.5}\\\\k&=2\\end{align*}$$\nThus $a=2b$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-ex18b-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $m\\propto n$ and $m=9.6$ when $n=3$, find the formula for $m$ in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=3.2n$",
          "worked": "Since $m\\propto n$, $m=kn$ for some constant $k$.\n\nWhen $m=9.6$ and $n=3$:\n$$\\begin{align*}9.6&=k\\times3\\\\k&=\\frac{9.6}{3}\\\\k&=3.2\\end{align*}$$\nThus $m=3.2n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
