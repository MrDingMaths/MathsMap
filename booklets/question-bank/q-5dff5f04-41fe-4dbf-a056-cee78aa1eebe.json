  "content": {
    "id": "p12-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "A positive number is increased by 50% and then the answer is decreased by 50%.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Will the final answer be greater than, less than, or the same as the original number? Justify your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Less than the original, since $1.5\\times0.5=0.75$.",
          "worked": "The multipliers are $1.5$ and $0.5$.\n$$1.5\\times0.5=0.75$$\nThe final answer is 75% of the original positive number, so it is less than the original.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "How would your answer to part a change if the decrease happens before the increase? Why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No change: $0.5\\times1.5=0.75$. Multiplication gives the same result in either order.",
          "worked": "With the decrease first, the combined multiplier is\n$$0.5\\times1.5=0.75.$$\nThe final answer is still 75% of the original, so it remains less than the original. Changing the order of multiplication does not change the product.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
