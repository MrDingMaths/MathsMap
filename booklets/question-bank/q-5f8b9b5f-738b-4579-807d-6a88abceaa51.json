    "type": "question",
    "label": "15",
    "prompt": "During a sale the price of a suit is reduced from $\\$420$ to $\\$370$. Calculate the percentage discount, correct to 1 decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$11.9\\%$",
      "worked": "$$\\begin{align*}\\text{Reduction}&=420-370\\\\\\text{Reduction}&=\\$50\\end{align*}$$\n$$\\begin{align*}\\text{Percentage discount}&=\\frac{50}{420}\\times100\\%\\\\\\text{Percentage discount}&\\approx11.9\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
