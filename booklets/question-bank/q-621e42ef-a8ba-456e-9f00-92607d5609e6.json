  "content": {
    "id": "p19-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Expand these expressions. Write your final answer without fractional or negative indices.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(x^{\\frac12}+x^{-\\frac12}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2+\\frac1x$",
          "worked": "$\\begin{aligned}\\left(x^{\\frac12}+x^{-\\frac12}\\right)^2&=\\left(x^{\\frac12}\\right)^2+2x^{\\frac12}x^{-\\frac12}+\\left(x^{-\\frac12}\\right)^2\\\\&=x+2x^0+x^{-1}\\\\&=x+2+\\frac1x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(x^{\\frac12}-x^{-\\frac12}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2+\\frac1x$",
          "worked": "$\\begin{aligned}\\left(x^{\\frac12}-x^{-\\frac12}\\right)^2&=\\left(x^{\\frac12}\\right)^2-2x^{\\frac12}x^{-\\frac12}+\\left(x^{-\\frac12}\\right)^2\\\\&=x-2x^0+x^{-1}\\\\&=x-2+\\frac1x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(x^{\\frac52}-x^{-\\frac52}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5-2+\\frac1{x^5}$",
          "worked": "$\\begin{aligned}\\left(x^{\\frac52}-x^{-\\frac52}\\right)^2&=\\left(x^{\\frac52}\\right)^2-2x^{\\frac52}x^{-\\frac52}+\\left(x^{-\\frac52}\\right)^2\\\\&=x^5-2x^0+x^{-5}\\\\&=x^5-2+\\frac1{x^5}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(x+5x^{-1}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+10+\\frac{25}{x^2}$",
          "worked": "$\\begin{aligned}\\left(x+5x^{-1}\\right)^2&=x^2+2x\\left(5x^{-1}\\right)+\\left(5x^{-1}\\right)^2\\\\&=x^2+10x^0+25x^{-2}\\\\&=x^2+10+\\frac{25}{x^2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(x^2-7x^{-2}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-14+\\frac{49}{x^4}$",
          "worked": "$\\begin{aligned}\\left(x^2-7x^{-2}\\right)^2&=\\left(x^2\\right)^2-2x^2\\left(7x^{-2}\\right)+\\left(7x^{-2}\\right)^2\\\\&=x^4-14x^0+49x^{-4}\\\\&=x^4-14+\\frac{49}{x^4}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(3x^{\\frac12}-2x^{-\\frac12}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x-12+\\frac4x$",
          "worked": "$\\begin{aligned}\\left(3x^{\\frac12}-2x^{-\\frac12}\\right)^2&=\\left(3x^{\\frac12}\\right)^2-2\\left(3x^{\\frac12}\\right)\\left(2x^{-\\frac12}\\right)+\\left(2x^{-\\frac12}\\right)^2\\\\&=9x-12x^0+4x^{-1}\\\\&=9x-12+\\frac4x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
