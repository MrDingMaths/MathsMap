    "type": "question",
    "label": "7",
    "prompt": "The mean of a Bernoulli distribution is $\\frac{9}{10}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q7-a-node",
        "type": "part",
