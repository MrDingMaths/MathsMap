        "prompt": "Find the variance.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{100}$",
          "worked": "$\\begin{aligned}p&=\\frac{9}{10}\\\\\\operatorname{Var}(X)&=p(1-p)\\\\\\operatorname{Var}(X)&=\\frac{9}{10}\\left(\\frac{1}{10}\\right)=\\frac{9}{100}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
