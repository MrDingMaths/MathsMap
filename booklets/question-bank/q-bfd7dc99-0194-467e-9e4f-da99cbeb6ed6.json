  "content": {
    "id": "v2-86222-p60-practice-slot-9-upper-root",
    "type": "question",
    "label": null,
    "prompt": "The minimum value of $x^2-8x+k$ is 3. Find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=19$",
      "worked": "Write $x^2-8x+k=(x+a)^2+c$.\n$$\\begin{align*}x^2-8x+k&=x^2+2ax+a^2+c\\\\2a&=-8\\\\a&=-4\\\\a^2+c&=k\\\\c&=k-16\\end{align*}$$\nSo $x^2-8x+k=(x-4)^2+k-16$. Since $(x-4)^2\\geq0$, the minimum value is $k-16$.\n$$\\begin{align*}k-16&=3\\\\k&=19\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
