    "type": "question",
    "label": null,
    "prompt": "A baker has 4.5 kg of flour. Each loaf of bread uses 300 g of flour. How many loaves can the baker make?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "15 loaves",
      "worked": "$$\\begin{align*}4.5\\text{ kg}&=4.5\\times1000\\text{ g}\\\\&=4500\\text{ g}\\\\\\text{Number of loaves}&=4500\\div300\\\\&=15\\end{align*}$$",
