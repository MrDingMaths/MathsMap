    "children": [
      {
        "id": "v2-fb109-p39-practice-slot-15-slot-15-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=ki+12j$ and $|\\underset{\\sim}{a}|=13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\pm5$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{a}|&=\\sqrt{k^2+12^2}=13\\\\k^2+144&=169\\\\k^2&=25\\\\k&=\\pm5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-fb109-p39-practice-slot-15-slot-15-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{b}=mi-5j$ where $m<0$, and $|\\underset{\\sim}{b}|=\\sqrt{41}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-4$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{b}|&=\\sqrt{m^2+(-5)^2}=\\sqrt{41}\\\\m^2+25&=41\\\\m^2&=16\\\\m&=-4\\quad\\text{(since }m<0\\text{)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
