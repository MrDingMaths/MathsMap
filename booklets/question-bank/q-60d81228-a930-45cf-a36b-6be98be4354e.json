        "children": [],
        "answer": {
          "short": "$2 \\div a$",
          "worked": "$$\\begin{align*}\\frac{2}{a} &= 2 \\div a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{a}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a \\div 2$",
          "worked": "$$\\begin{align*}\\frac{a}{2} &= a \\div 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a \\times a$",
          "worked": "$$\\begin{align*}a^2 &= a \\times a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$2ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2 \\times a \\times b$",
          "worked": "$$\\begin{align*}2ab &= 2 \\times a \\times b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$(ab)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab \\times ab$",
          "worked": "$$\\begin{align*}(ab)^2 &= ab \\times ab\\\\(ab)^2 &= a \\times b \\times a \\times b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
