  "content": {
    "id": "p58-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Calculate the number of drops per minute required at a rate of 15 drops/mL in these situations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "volume of 1.4 L over 7 h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50 drops/min",
          "worked": "Quantities: volume, time and drops.\n$$\\begin{align*}\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{\\text{Drops}}{\\text{Volume}}\\times\\frac{\\text{Volume}}{\\text{Time}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{15\\text{ drops}}{1\\text{ mL}}\\times\\frac{1.4\\text{ L}}{7\\text{ h}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{15\\text{ drops}}{1\\text{ mL}}\\times\\frac{1400\\text{ mL}}{420\\text{ min}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=50\\text{ drops/min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p58-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "volume of 1.5 L over 6 h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "62.5 drops/min",
          "worked": "Quantities: volume, time and drops.\n$$\\begin{align*}\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{\\text{Drops}}{\\text{Volume}}\\times\\frac{\\text{Volume}}{\\text{Time}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{15\\text{ drops}}{1\\text{ mL}}\\times\\frac{1.5\\text{ L}}{6\\text{ h}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{15\\text{ drops}}{1\\text{ mL}}\\times\\frac{1500\\text{ mL}}{360\\text{ min}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=62.5\\text{ drops/min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p58-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "volume of 800 mL over 4 h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50 drops/min",
          "worked": "Quantities: volume, time and drops.\n$$\\begin{align*}\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{\\text{Drops}}{\\text{Volume}}\\times\\frac{\\text{Volume}}{\\text{Time}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{15\\text{ drops}}{1\\text{ mL}}\\times\\frac{800\\text{ mL}}{4\\text{ h}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=\\frac{15\\text{ drops}}{1\\text{ mL}}\\times\\frac{800\\text{ mL}}{240\\text{ min}}\\\\\\frac{\\text{Drops}}{\\text{Time}}&=50\\text{ drops/min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
