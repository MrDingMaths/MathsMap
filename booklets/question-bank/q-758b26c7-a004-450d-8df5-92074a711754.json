  "content": {
    "id": "p7-p6-root",
    "type": "question",
    "label": null,
    "prompt": "Show that $\\log_{a^x}(b)=\\dfrac{\\log_a(b)}{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{\\log_a(b)}{x}$\n\nChange to base $a$ and use $\\log_a(a^x)=x$ in the denominator.",
      "worked": "The logarithms are defined for $a>0$, $a\\ne1$, $b>0$ and $x\\ne0$.\n$$\\begin{align*}\\log_{a^x}(b)&=\\frac{\\log_a(b)}{\\log_a(a^x)}\\\\\\log_{a^x}(b)&=\\frac{\\log_a(b)}{x}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 19
  },
