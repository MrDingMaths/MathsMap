    "type": "question",
    "label": "8",
    "prompt": "The sum $S$ of the consecutive whole numbers from 1 to $n$ inclusive is given by the formula $S=\\dfrac{n(n+1)}{2}$. Find the sum of the integers from:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "1 to 30",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$465$",
          "worked": "$$\\begin{align*}S&=\\frac{30(30+1)}{2}\\\\S&=\\frac{30\\times31}{2}\\\\S&=465\\end{align*}$$",
          "solutionDiagrams": []
