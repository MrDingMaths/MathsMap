        "answer": {
          "short": "$1275$",
          "worked": "$$\\begin{align*}S&=\\frac{50(50+1)}{2}\\\\S&=\\frac{50\\times51}{2}\\\\S&=1275\\end{align*}$$",
          "solutionDiagrams": []
