  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Each number from 1 to 500 is written on a card and put into a box. A card is withdrawn at random. What is the probability of obtaining a card with:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "a number less than 100?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{99}{500}$",
          "worked": "The favourable numbers are $1,2,\\ldots,99$: 99 of the 500 equally likely outcomes.\n\n$$P(\\text{less than }100)=\\frac{99}{500}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "a number divisible by 10?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "The favourable numbers are $10,20,\\ldots,500$. There are $500\\div10=50$ of them.\n\n$$\\begin{aligned}P(\\text{divisible by }10)&=\\frac{50}{500}\\\\P(\\text{divisible by }10)&=\\frac{1}{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "a number divisible by 5?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "The favourable numbers are $5,10,\\ldots,500$. There are $500\\div5=100$ of them.\n\n$$\\begin{aligned}P(\\text{divisible by }5)&=\\frac{100}{500}\\\\P(\\text{divisible by }5)&=\\frac{1}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
