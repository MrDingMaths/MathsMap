  "content": {
    "id": "v2-c5fa9-p19-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Find the mean in each of the following situations.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-c5fa9-p19-practice-slot-10-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Anna scored 68 in Art, where the mean was 56.4 and the standard deviation was 8.5.\nAnna achieved the same $z$-score in Drama, where she scored 79 and the standard deviation was 6.4.\nWhat is the mean for Drama? Answer correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70.3$",
          "worked": "$$\\begin{aligned}z_A&=\\frac{68-56.4}{8.5}\\\\z_A&=\\frac{116}{85}\\\\\\bar{x}&=x_D-z_A\\sigma_D\\\\\\bar{x}&=79-\\frac{116}{85}(6.4)\\\\\\bar{x}&\\approx70.3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-c5fa9-p19-practice-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Mia scored 47 in Chemistry, where the mean was 58.6 and the standard deviation was 7.5.\nMia achieved the same $z$-score in Biology, where she scored 52 and the standard deviation was 6.4.\nWhat is the mean for Biology? Answer correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$61.9$",
          "worked": "$$\\begin{aligned}z_C&=\\frac{47-58.6}{7.5}\\\\z_C&=-\\frac{116}{75}\\\\\\bar{x}&=x_B-z_C\\sigma_B\\\\\\bar{x}&=52+\\frac{116}{75}(6.4)\\\\\\bar{x}&\\approx61.9\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
