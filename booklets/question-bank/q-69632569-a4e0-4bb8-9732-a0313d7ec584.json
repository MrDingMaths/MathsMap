  "content": {
    "id": "p147-g27-28-root",
    "type": "question",
    "label": "14",
    "prompt": "Determine whether the following functions are even or odd.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p147-g27-28-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^4-x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^4-(-x)^2+1\\\\f(-x)&=x^4-x^2+1\\\\f(-x)&=f(x)\\end{align*}$$\nTherefore $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p147-g27-28-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{x}{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Odd.",
          "worked": "$$\\begin{align*}f(-x)&=\\frac{-x}{(-x)^2+1}\\\\f(-x)&=-\\frac{x}{x^2+1}\\\\f(-x)&=-f(x)\\end{align*}$$\nTherefore $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
