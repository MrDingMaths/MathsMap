    "type": "question",
    "label": "41",
    "prompt": "Solve the following equation.\n$$x-6\\sqrt{x}+8=0.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=4$ or $x=16$.",
      "worked": "Let $u=\\sqrt{x}\\ge0$.\n$$\\begin{align*}u^2-6u+8&=0\\\\(u-2)(u-4)&=0\\\\u&=2\\text{ or }u=4\\\\\\sqrt{x}&=2\\text{ or }\\sqrt{x}=4\\\\x&=4\\text{ or }x=16.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
