    "children": [
      {
        "id": "v2-77442-p19-practice-slot-11-slot-11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\dfrac{2}{3}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9}{4}$",
          "worked": "$$\\begin{align*}\\left(\\frac{2}{3}\\right)^{-2}&=\\frac{1}{\\left(\\frac{2}{3}\\right)^{2}}\\\\&=\\frac{1}{\\frac{4}{9}}\\\\&=\\frac{9}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-77442-p19-practice-slot-11-slot-11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$(0.4)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{25}{4}$",
          "worked": "$$\\begin{align*}(0.4)^{-2}&=\\left(\\frac{2}{5}\\right)^{-2}\\\\&=\\frac{1}{\\left(\\frac{2}{5}\\right)^{2}}\\\\&=\\frac{1}{\\frac{4}{25}}\\\\&=\\frac{25}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "v2-77442-p19-practice-slot-11-slot-11-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1.5)^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8}{27}$",
          "worked": "$$\\begin{align*}(1.5)^{-3}&=\\left(\\frac{3}{2}\\right)^{-3}\\\\&=\\frac{1}{\\left(\\frac{3}{2}\\right)^{3}}\\\\&=\\frac{1}{\\frac{27}{8}}\\\\&=\\frac{8}{27}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
