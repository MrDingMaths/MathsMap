  "content": {
    "id": "v2-c9203b0c5-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "Find $E(X)$ and $\\operatorname{Var}(X)$ for each PDF.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-c9203b0c5-practice-slot-8-slot-8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{3}{8}x^2$, domain $[0,2]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=\\frac32$, $\\operatorname{Var}(X)=\\frac3{20}$.",
          "worked": "$$\\begin{align*}E(X)&=\\int_0^2 x\\left(\\frac38x^2\\right)dx\\\\&=\\frac38\\left[\\frac{x^4}{4}\\right]_0^2\\\\&=\\frac38(4)\\\\&=\\frac32\\end{align*}$$\n$$\\begin{align*}E(X^2)&=\\int_0^2 x^2\\left(\\frac38x^2\\right)dx\\\\&=\\frac38\\left[\\frac{x^5}{5}\\right]_0^2\\\\&=\\frac38\\left(\\frac{32}5\\right)\\\\&=\\frac{12}5\\end{align*}$$\n$$\\begin{align*}\\operatorname{Var}(X)&=E(X^2)-(E(X))^2\\\\&=\\frac{12}5-\\frac94\\\\&=\\frac3{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "v2-c9203b0c5-practice-slot-8-slot-8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{x}{4}$, domain $[1,3]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E(X)=\\frac{13}6$, $\\operatorname{Var}(X)=\\frac{11}{36}$.",
          "worked": "$$\\begin{align*}E(X)&=\\int_1^3 x\\left(\\frac x4\\right)dx\\\\&=\\frac14\\left[\\frac{x^3}{3}\\right]_1^3\\\\&=\\frac14\\left(\\frac{26}3\\right)\\\\&=\\frac{13}6\\end{align*}$$\n$$\\begin{align*}E(X^2)&=\\int_1^3 x^2\\left(\\frac x4\\right)dx\\\\&=\\frac14\\left[\\frac{x^4}{4}\\right]_1^3\\\\&=\\frac14(20)\\\\&=5\\end{align*}$$\n$$\\begin{align*}\\operatorname{Var}(X)&=E(X^2)-(E(X))^2\\\\&=5-\\frac{169}{36}\\\\&=\\frac{11}{36}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
  },
