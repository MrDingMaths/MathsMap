  "content": {
    "id": "p62-q3.response",
    "type": "question",
    "label": "2",
    "prompt": "If the radius of a sector is doubled, by what factor must the angle be changed to ensure the area of the new sector remains the same as the original?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Multiply the angle by $\\frac14$; divide it by $4$.",
      "worked": "$$\\begin{align*}\\frac12(2r)^2\\theta_{\\text{new}} &= \\frac12r^2\\theta \\\\ \\theta_{\\text{new}} &= \\frac{\\theta}{4}.\\end{align*}$$\nThe angle must be divided by $4$.",
      "solutionDiagrams": []
    },
