    "id": "p2-c1-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The quotient arising from the division of a number by 53 is 29 and the remainder is 23. What is this number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1560$",
      "worked": "Dividend = divisor × quotient + remainder.\n\n$$\\begin{align*}\\text{Number}&=53\\times29+23\\\\\\text{Number}&=1537+23\\\\\\text{Number}&=1560\\end{align*}$$",
      "solutionDiagrams": []
