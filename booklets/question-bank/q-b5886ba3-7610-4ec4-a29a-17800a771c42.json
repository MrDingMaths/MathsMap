  "content": {
    "id": "p41-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "For a class party, Lilian buys $x$ biscuits at \\$3 each and $y$ cans of drink at \\$2 each.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the total amount of money she spent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x + 2y$ dollars.",
          "worked": "The biscuits cost $3x$ dollars and the drinks cost $2y$ dollars. The total cost is $3x + 2y$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p41-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "If Lilian bought 20 biscuits and 12 cans of drink, how much did she spend in total?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$84$",
          "worked": "Substitute $x=20$ and $y=12$ into the total cost $C$, in dollars.\n$$\\begin{align*}C &= 3(20) + 2(12) \\\\ C &= 60 + 24 \\\\ C &= 84\\end{align*}$$\nLilian spent $\\$84$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
