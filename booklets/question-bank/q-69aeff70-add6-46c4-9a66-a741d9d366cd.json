  "content": {
    "id": "v2-b20da-p35-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Find the required values in each part.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b20da-p35-practice-slot-3-slot-3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $x$ for which $f(x)=x^3-3x^2-9x$ is increasing and concave down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-1$",
          "worked": "$$\\begin{align*}f'(x)&=3x^2-6x-9\\\\&=3(x-3)(x+1)\\\\f''(x)&=6x-6\\end{align*}$$\nIncreasing: $f'(x)>0$, so $x<-1$ or $x>3$.\nConcave down: $f''(x)<0$, so $x<1$.\nBoth conditions hold when $x<-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-b20da-p35-practice-slot-3-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the values of $x$ for which $f(x)=2x^3-9x^2+12x$ is decreasing and concave up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac32<x<2$",
          "worked": "$$\\begin{align*}f'(x)&=6x^2-18x+12\\\\&=6(x-1)(x-2)\\\\f''(x)&=12x-18\\end{align*}$$\nDecreasing: $f'(x)<0$, so $1<x<2$.\nConcave up: $f''(x)>0$, so $x>\\frac32$.\nBoth conditions hold when $\\frac32<x<2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-b20da-p35-practice-slot-3-slot-3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the values of $k$ for which $f(x)=x^3+kx^2+x$ is decreasing and concave up at $x=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3<k<-2$",
          "worked": "$$\\begin{align*}f'(x)&=3x^2+2kx+1\\\\f''(x)&=6x+2k\\end{align*}$$\nDecreasing at $x=1$: $f'(1)=4+2k<0$, so $k<-2$.\nConcave up at $x=1$: $f''(1)=6+2k>0$, so $k>-3$.\nHence $-3<k<-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
