  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the new amount after each percentage change.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\$45\\,000$ is increased by $20\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$54\\,000$",
          "worked": "$$\\begin{align*}\\text{Increase}&=\\frac{20}{100}\\times45\\,000\\\\\\text{Increase}&=9000\\\\\\text{New amount}&=45\\,000+9000\\\\\\text{New amount}&=\\$54\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\$60\\,000$ is decreased by $15\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$51\\,000$",
          "worked": "$$\\begin{align*}\\text{Decrease}&=\\frac{15}{100}\\times60\\,000\\\\\\text{Decrease}&=9000\\\\\\text{New amount}&=60\\,000-9000\\\\\\text{New amount}&=\\$51\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\$32\\,000$ is increased by $12\\frac{1}{2}\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$36\\,000$",
          "worked": "$$\\begin{align*}\\text{Increase}&=\\frac{12\\frac12}{100}\\times32\\,000\\\\\\text{Increase}&=\\frac18\\times32\\,000\\\\\\text{Increase}&=4000\\\\\\text{New amount}&=32\\,000+4000\\\\\\text{New amount}&=\\$36\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      },
      {
        "id": "p24-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$42\\,000$ hectares is increased by $24\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$52\\,080$ hectares",
          "worked": "$$\\begin{align*}\\text{Increase}&=\\frac{24}{100}\\times42\\,000\\\\\\text{Increase}&=10\\,080\\text{ hectares}\\\\\\text{New area}&=42\\,000+10\\,080\\\\\\text{New area}&=52\\,080\\text{ hectares}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
