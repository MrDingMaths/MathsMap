  "content": {
    "id": "v2-1479f-p27-practice-retro-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Write the equation of the circle with centre $(4,-1)$ that passes through the point $(6,2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-4)^2+(y+1)^2=13$",
      "worked": "The radius is the distance from the centre to $(6,2)$:\n$$\\begin{align*}r^2&=(6-4)^2+(2-(-1))^2\\\\&=4+9\\\\&=13\\end{align*}$$\nUsing $(x-a)^2+(y-b)^2=r^2$:\n$$\\begin{align*}(x-4)^2+(y-(-1))^2&=13\\\\(x-4)^2+(y+1)^2&=13\\end{align*}$$",
      "solutionDiagrams": []
    },
