  "content": {
    "id": "p26-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "For every $a\\in\\mathbb{R}$, the graph of $y=ax^3+2x^2+3x+a$ passes through a common point. Find the coordinates of this point.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(-1,-1)$",
      "worked": "$$\\begin{align*}y&=a(x^3+1)+2x^2+3x.\\end{align*}$$\nFor the point to be independent of $a$, its coefficient must be zero.\n$$\\begin{align*}x^3+1&=0\\\\x^3&=-1\\\\x&=-1.\\end{align*}$$\nAt $x=-1$,\n$$\\begin{align*}y&=a((-1)^3+1)+2(-1)^2+3(-1)\\\\y&=0+2-3\\\\y&=-1.\\end{align*}$$\nThe common point is $(-1,-1)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
