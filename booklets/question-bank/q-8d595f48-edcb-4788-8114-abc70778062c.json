  "content": {
    "id": "p42-q8",
    "type": "question",
    "label": null,
    "prompt": "Suppose that $F(x)=4x$ and $G(x)=\\sqrt{x}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $F(G(25))$, $G(F(25))$, $F(F(25))$ and $G(G(25))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(G(25))=20$, $G(F(25))=10$, $F(F(25))=400$, $G(G(25))=\\sqrt5$.",
          "worked": "$$\\begin{align*}F(G(25))&=F(5)=4(5)=20\\\\G(F(25))&=G(100)=\\sqrt{100}=10\\\\F(F(25))&=F(100)=4(100)=400\\\\G(G(25))&=G(5)=\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p42-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $F(G(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{x}$",
          "worked": "$$\\begin{align*}F(G(x))&=F(\\sqrt{x})\\\\F(G(x))&=4\\sqrt{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p42-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $G(F(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{4x}=2\\sqrt{x}$",
          "worked": "$$\\begin{align*}G(F(x))&=G(4x)\\\\G(F(x))&=\\sqrt{4x}\\\\G(F(x))&=2\\sqrt{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p42-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence show that $F(G(x))=2G(F(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both sides equal $4\\sqrt{x}$ for $x\\geq0$.",
          "worked": "For $x\\geq0$,\n$$\\begin{align*}2G(F(x))&=2(2\\sqrt{x})\\\\2G(F(x))&=4\\sqrt{x}\\\\2G(F(x))&=F(G(x))\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p42-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "State the domain and range of $F(G(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $x\\geq0$. Range: $y\\geq0$.",
          "worked": "$F(G(x))=4\\sqrt{x}$ requires $x\\geq0$. Its minimum output is 0 at $x=0$, and it increases without bound.\n\nDomain: $x\\geq0$. Range: $y\\geq0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
