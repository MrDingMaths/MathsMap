    "type": "question",
    "label": null,
    "prompt": "$O$ is the centre of the circle.\nGive the size of the angle at the centre subtended by the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "v2-4b2a13-p9-practice-slot-3-slot-3-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"slot-3-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black},line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (A) at (90:2);\n\\coordinate (B) at (-5:2);\n\\coordinate (C) at (215:2);\n\\draw (O) circle (2);\n\\draw (O)--(A) (O)--(B) (O)--(C);\n\\fill (O) circle (1.4pt);\n\\node[left,inner sep=3pt] at (O) {$O$};\n\\node[above] at (A) {$A$};\n\\node[right] at (B) {$B$};\n\\node[below left] at (C) {$C$};\n\\node at (42.5:0.8) {$95^\\circ$};\n\\node at (-75:0.8) {$140^\\circ$};\n\\end{tikzpicture}",
        "src": null,
