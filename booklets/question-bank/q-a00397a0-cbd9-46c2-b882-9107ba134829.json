    "children": [
      {
        "id": "v2-4b2a13-p9-practice-slot-3-slot-3-a",
        "type": "part",
        "label": "a",
        "prompt": "Chord $CA$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125^\\circ$",
          "worked": "Angles around a point sum to $360^\\circ$.\n$$\\begin{align*}\\angle COA&=360^\\circ-95^\\circ-140^\\circ\\\\&=125^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "v2-4b2a13-p9-practice-slot-3-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "Major arc $BC$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$220^\\circ$",
          "worked": "The major arc $BC$ is on the opposite side of $O$ from the $140^\\circ$ sector.\n$$\\begin{align*}\\text{Angle}&=360^\\circ-140^\\circ\\\\&=220^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
