      {
        "id": "p48-q01-08-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{16}\\left(\\frac{1}{8}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3}{4}$",
          "worked": "$$\\begin{align*}\\log_{16}\\left(\\frac{1}{8}\\right)&=\\log_{16}(2^{-3})\\\\\\log_{16}\\left(\\frac{1}{8}\\right)&=\\log_{16}\\left(16^{-\\frac34}\\right)\\\\\\log_{16}\\left(\\frac{1}{8}\\right)&=-\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p48-q01-08-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{27}\\left(\\frac{1}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{3}$",
          "worked": "$$\\begin{align*}\\log_{27}\\left(\\frac{1}{3}\\right)&=\\log_{27}(3^{-1})\\\\\\log_{27}\\left(\\frac{1}{3}\\right)&=\\log_{27}\\left(27^{-\\frac13}\\right)\\\\\\log_{27}\\left(\\frac{1}{3}\\right)&=-\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p48-q01-08-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_9(\\sqrt{3})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\log_9(\\sqrt3)&=\\log_9\\left(3^{\\frac12}\\right)\\\\\\log_9(\\sqrt3)&=\\log_9\\left(9^{\\frac14}\\right)\\\\\\log_9(\\sqrt3)&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p48-q01-08-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{125}(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "$$\\begin{align*}\\log_{125}(5)&=\\log_{125}\\left(125^{\\frac13}\\right)\\\\\\log_{125}(5)&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p48-q01-08-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{\\frac14}(8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3}{2}$",
          "worked": "$$\\begin{align*}\\log_{\\frac14}(8)&=\\log_{2^{-2}}(2^3)\\\\\\log_{\\frac14}(8)&=\\log_{\\frac14}\\left(\\left(\\frac14\\right)^{-\\frac32}\\right)\\\\\\log_{\\frac14}(8)&=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p48-q01-08-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_{16}(\\sqrt{2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}\\log_{16}(\\sqrt2)&=\\log_{16}\\left(2^{\\frac12}\\right)\\\\\\log_{16}(\\sqrt2)&=\\log_{16}\\left(16^{\\frac18}\\right)\\\\\\log_{16}(\\sqrt2)&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p48-q01-08-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_{81}(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\log_{81}(3)&=\\log_{81}\\left(81^{\\frac14}\\right)\\\\\\log_{81}(3)&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p48-q01-08-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_8(\\sqrt[3]{2})$",
        "layout": "list",
        "columns": null,
