        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "$$\\begin{align*}\\log_8(\\sqrt[3]2)&=\\log_8\\left(2^{\\frac13}\\right)\\\\\\log_8(\\sqrt[3]2)&=\\log_8\\left(8^{\\frac19}\\right)\\\\\\log_8(\\sqrt[3]2)&=\\frac19\\end{align*}$$",
          "solutionDiagrams": []
