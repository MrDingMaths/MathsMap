        "answer": {
          "short": "$x=12.26\\text{ cm},\\quad y=6.11\\text{ cm}$",
          "worked": "$$\\begin{align*}\\cos 26.5^{\\circ}&=\\frac{x}{13.7}\\\\x&=13.7\\cos 26.5^{\\circ}\\\\x&\\approx12.26\\text{ cm}\\\\\\sin 26.5^{\\circ}&=\\frac{y}{13.7}\\\\y&=13.7\\sin 26.5^{\\circ}\\\\y&\\approx6.11\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48,
        "responseSpace": "scaffold"
      },
