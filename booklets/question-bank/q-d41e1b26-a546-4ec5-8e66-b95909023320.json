    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the tangent to $y=e^x$ at $x=t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^t(x-t+1)$.",
          "worked": "At $x=t$, the point is $(t,e^t)$.\n$$\\begin{aligned}\\frac{dy}{dx}&=e^x\\\\m&=e^t\\end{aligned}$$\nThe tangent is\n$$\\begin{aligned}y-e^t&=e^t(x-t)\\\\y&=e^t(x-t+1).\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence show the $x$-intercept of this tangent is $t-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=t-1$.",
          "worked": "At the $x$-intercept, $y=0$:\n$$\\begin{aligned}0&=e^t(x-t+1).\\end{aligned}$$\nSince $e^t\\ne0$,\n$$\\begin{aligned}x-t+1&=0\\\\x&=t-1.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "In Q1–3, the tangents to $y=e^x$ at $Q(0,1)$, $P(1,e)$ and $R\\left(-1,\\frac{1}{e}\\right)$ had $x$-intercepts $-1$, $0$ and $-2$, respectively. Does your result in part b agree with these results?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. The $x$-intercept is always 1 less than the $x$-coordinate of the point of tangency.",
          "worked": "Yes. For Q1–3, the points of tangency have $x$-coordinates $0$, $1$ and $-1$. Substituting these values into $x=t-1$ gives intercepts $-1$, $0$ and $-2$, respectively, agreeing with those answers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
