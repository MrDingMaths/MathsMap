  "content": {
    "id": "p47-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "IQ is approximately normally distributed in Australia with mean 98 and standard deviation 15. Use the standard normal distribution table.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A genius is defined as IQ over 140. What percentage of the population is this? Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.26\\%$",
          "worked": "$$\\begin{aligned}z&=\\frac{140-98}{15}\\\\z&=2.8\\\\P(X>140)&=1-P(Z\\le2.8)\\\\P(X>140)&\\approx1-0.9974\\\\P(X>140)&\\approx0.0026\\end{aligned}$$\nThe percentage is $0.0026\\times100\\%=0.26\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p47-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "In 25 million people, how many geniuses would you expect?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 65 000 people.",
          "worked": "$$\\begin{aligned}\\text{Expected number}&\\approx25\\,000\\,000\\times0.0026\\\\\\text{Expected number}&\\approx65\\,000\\end{aligned}$$\nApproximately 65 000 people would have an IQ over 140.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
