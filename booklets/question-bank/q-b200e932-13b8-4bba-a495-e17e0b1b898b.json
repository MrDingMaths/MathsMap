  "content": {
    "id": "p30-q6-root",
    "type": "question",
    "label": "6",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "91212bd2-1bda-4172-86a2-ac4bb69ae8ce",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "The value of a car is expected to reduce by 8% per year. The original cost is $300 000.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the equation in the form $S=V_0(1-r)^n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S=300\\,000(0.92)^n$",
          "worked": "$$\\begin{align*}S &= V_0(1-r)^n\\\\S &= 300\\,000(1-0.08)^n\\\\S &= 300\\,000(0.92)^n\\end{align*}$$\nHere $n$ is the number of years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p30-q6-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p30-q6-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find the time it takes for the car’s value to be half the original value.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Round your answer to 1 decimal place.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.3$ years",
          "worked": "$$\\begin{align*}S &= 300\\,000(0.92)^n\\\\150\\,000 &= 300\\,000(0.92)^n\\\\\\frac{1}{2} &= 0.92^n\\\\n &= \\log_{0.92}\\frac{1}{2}\\\\n &\\approx 8.3\\end{align*}$$\nThe time is $8.3$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
