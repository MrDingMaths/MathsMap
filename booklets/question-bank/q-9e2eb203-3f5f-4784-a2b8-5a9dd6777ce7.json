        "answer": {
          "short": "$\\frac{1}{12}$",
          "worked": "$$\\begin{align*}1-\\frac{11}{12}&=\\frac{12}{12}-\\frac{11}{12}\\\\&=\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
