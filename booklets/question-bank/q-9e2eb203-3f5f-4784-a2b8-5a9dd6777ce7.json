        "children": [],
        "answer": {
          "short": "$-\\frac{1}{12}$",
          "worked": "$$\\begin{align*}\\frac{11}{12}-1&=\\frac{11}{12}-\\frac{12}{12}\\\\&=-\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q2-c",
