    "id": "p32-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve the quadratic inequalities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q3a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+3x-70>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-10$ or $x>7$.",
          "worked": "$$\\begin{align*}y&=x^2+3x-70\\\\y&=(x+10)(x-7)\\end{align*}$$\nThe upward-opening parabola crosses the $x$-axis at $-10$ and $7$. It is above the axis outside these intercepts.\nThus $x<-10$ or $x>7$. The intercepts are excluded because the inequality is strict.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-q3b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-5x-24<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3<x<8$.",
          "worked": "$$\\begin{align*}y&=x^2-5x-24\\\\y&=(x+3)(x-8)\\end{align*}$$\nThe upward-opening parabola crosses the $x$-axis at $-3$ and $8$. It is below the axis between these intercepts.\nThus $-3<x<8$. The intercepts are excluded because the inequality is strict.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-q3c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+9x+20\\geq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq-5$ or $x\\geq-4$.",
          "worked": "$$\\begin{align*}y&=x^2+9x+20\\\\y&=(x+5)(x+4)\\end{align*}$$\nThe upward-opening parabola crosses the $x$-axis at $-5$ and $-4$. It is on or above the axis outside these intercepts, including the intercepts.\nThus $x\\leq-5$ or $x\\geq-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-q3d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-7x+12\\leq0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\leq x\\leq4$.",
          "worked": "$$\\begin{align*}y&=x^2-7x+12\\\\y&=(x-3)(x-4)\\end{align*}$$\nThe upward-opening parabola crosses the $x$-axis at $3$ and $4$. It is on or below the axis between these intercepts, including the intercepts.\nThus $3\\leq x\\leq4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
