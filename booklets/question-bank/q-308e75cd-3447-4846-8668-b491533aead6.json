  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the primitive of each function after expanding.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x(x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3}{3}-\\dfrac{3x^2}{2}+C$",
          "worked": "$$\\begin{align*}f'(x)&=x(x-3)\\\\f'(x)&=x^2-3x\\\\f(x)&=\\frac{x^3}{3}-\\frac{3x^2}{2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+1)(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3}{3}-\\dfrac{x^2}{2}-2x+C$",
          "worked": "$$\\begin{align*}f'(x)&=(x+1)(x-2)\\\\f'(x)&=x^2-2x+x-2\\\\f'(x)&=x^2-x-2\\\\f(x)&=\\frac{x^3}{3}-\\frac{x^2}{2}-2x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3x-1)(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3+\\dfrac{11x^2}{2}-4x+C$",
          "worked": "$$\\begin{align*}f'(x)&=(3x-1)(x+4)\\\\f'(x)&=3x^2+12x-x-4\\\\f'(x)&=3x^2+11x-4\\\\f(x)&=x^3+\\frac{11x^2}{2}-4x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2(5x^3-4x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x^6}{6}-x^4+C$",
          "worked": "$$\\begin{align*}f'(x)&=x^2(5x^3-4x)\\\\f'(x)&=5x^5-4x^3\\\\f(x)&=\\frac{5x^6}{6}-\\frac{4x^4}{4}+C\\\\f(x)&=\\frac{5x^6}{6}-x^4+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$2x^3(4x^4+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^8+\\dfrac{x^4}{2}+C$",
          "worked": "$$\\begin{align*}f'(x)&=2x^3(4x^4+1)\\\\f'(x)&=8x^7+2x^3\\\\f(x)&=\\frac{8x^8}{8}+\\frac{2x^4}{4}+C\\\\f(x)&=x^8+\\frac{x^4}{2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x-3)(1+x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{2}+\\dfrac{x^4}{4}-3x-x^3+C$",
          "worked": "$$\\begin{align*}f'(x)&=(x-3)(1+x^2)\\\\f'(x)&=x+x^3-3-3x^2\\\\f(x)&=\\frac{x^2}{2}+\\frac{x^4}{4}-3x-x^3+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
