    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3^x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 unit down.",
          "worked": "Replacing $y$ with $y+1$ gives $y+1=3^x$, so the graph translates 1 unit down.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
