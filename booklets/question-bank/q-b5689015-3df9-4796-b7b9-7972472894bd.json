  "content": {
    "id": "p20-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "A multiple-choice quiz has 8 questions where each question has two options: T or F. How many possible answer keys are there if it is to have",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "exactly five F?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56$",
          "worked": "Choose the five positions occupied by F; the other three positions are T.\n$$N=\\binom{8}{5}=56.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "at most one T?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "Add the disjoint cases of zero T and one T.\n$$N=\\binom{8}{0}+\\binom{8}{1}=1+8=9.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "at least one F?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^8-1=255$",
          "worked": "There are $2^8$ answer keys in total. Exclude the single key containing only T.\n$$N=2^8-1=255.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p20-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "at least two T?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$247$\n\nSubtract the keys with zero or one T from all $2^8$ keys.",
          "worked": "Exclude the disjoint cases containing zero T or one T from all answer keys.\n$$\\begin{align*}N&=2^8-\\binom{8}{0}-\\binom{8}{1}\\\\N&=256-1-8\\\\N&=247.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
