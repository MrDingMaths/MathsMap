  "content": {
    "id": "p17-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "For each line, find the points on the line that have x-values of $1$ and $2$, and hence find the gradient of the line.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=-3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-3),\\ (2,-6)$; gradient $-3$.",
          "worked": "At $x=1$, $y=-3\\times1=-3$. At $x=2$, $y=-3\\times2=-6$. Hence\n$$\\begin{aligned}\\text{gradient}&=\\frac{-6-(-3)}{2-1}\\\\&=-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-4x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-2),\\ (2,-6)$; gradient $-4$.",
          "worked": "At $x=1$, $y=-4\\times1+2=-2$. At $x=2$, $y=-4\\times2+2=-6$. Hence\n$$\\begin{aligned}\\text{gradient}&=\\frac{-6-(-2)}{2-1}\\\\&=-4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-2x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,3),\\ (2,1)$; gradient $-2$.",
          "worked": "At $x=1$, $y=-2\\times1+5=3$. At $x=2$, $y=-2\\times2+5=1$. Hence\n$$\\begin{aligned}\\text{gradient}&=\\frac{1-(3)}{2-1}\\\\&=-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=-x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,1),\\ (2,0)$; gradient $-1$.",
          "worked": "At $x=1$, $y=-1\\times1+2=1$. At $x=2$, $y=-1\\times2+2=0$. Hence\n$$\\begin{aligned}\\text{gradient}&=\\frac{0-(1)}{2-1}\\\\&=-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
