  "content": {
    "id": "p35-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "An archer finds that on average he hits the bulls-eye nine times out of ten. Assuming that successive attempts are independent, find the probability that in twenty attempts each of the following occurs. Give your answers correct to five decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "He scores at least eighteen hits.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.67693$",
          "worked": "Let $X$ be the number of hits, so $X\\sim\\operatorname{Bin}(20,0.9)$.\n$$\\begin{align*}P(X\\ge18)&=P(X=18)+P(X=19)+P(X=20)\\\\&=\\binom{20}{18}(0.9)^{18}(0.1)^2+\\binom{20}{19}(0.9)^{19}(0.1)+(0.9)^{20}\\\\&\\approx0.67693.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p35-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "He misses at least once.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.87842$",
          "worked": "At least one miss is the complement of twenty hits.\n$$\\begin{align*}P(\\text{at least one miss})&=1-P(X=20)\\\\&=1-(0.9)^{20}\\\\&\\approx0.87842.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
