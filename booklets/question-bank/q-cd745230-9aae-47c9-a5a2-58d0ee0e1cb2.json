    "type": "question",
    "label": "45",
    "prompt": "How many terms of the series $80+73+66+\\ldots$ are needed to give a sum of 495?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "11 terms.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p39-q45-worked-givens",
