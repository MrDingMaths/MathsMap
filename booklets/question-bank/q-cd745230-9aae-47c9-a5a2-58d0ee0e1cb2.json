                "type": "math",
                "latex": "a=80,\\quad d=73-80=-7,\\quad S_n=495",
                "display": false,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p39-q45-worked-calculation",
            "type": "paragraph",
            "fontSize": null,
