            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}S_n&=\\frac n2[2a+(n-1)d]\\\\495&=\\frac n2[2(80)+(n-1)(-7)]\\\\990&=n[160-7n+7]\\\\990&=n(167-7n)\\\\990&=167n-7n^2\\\\7n^2-167n+990&=0\\\\(7n-90)(n-11)&=0\\\\n&=\\frac{90}{7}\\text{ or }11\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
