  "content": {
    "id": "p22-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Jane and Anthony run a business. They have decided that all profits will be divided between them in the ratio $5:4$, with Jane receiving the larger share. In 2005, the business made $\\$81\\,900$. How much does each person receive?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Jane: $\\$45\\,500$; Anthony: $\\$36\\,400$.",
      "worked": "There are $5+4=9$ parts in total.\n$$\\begin{align*}\\text{Value of one part}&=\\$81\\,900\\div9\\\\\\text{Value of one part}&=\\$9\\,100\\\\\\text{Jane's share}&=5\\times\\$9\\,100=\\$45\\,500\\\\\\text{Anthony's share}&=4\\times\\$9\\,100=\\$36\\,400\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
