  "content": {
    "id": "p57-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "When a polynomial $P(x)$ is divided by $x^2-5$, the remainder is $x+4$.\nFind the remainder when $P(x)+P(-x)$ is divided by $x^2-5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8$; the linear remainder terms cancel when the identities are added.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p57-q19-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "P(x)=(x^2-5)Q(x)+x+4",
                "display": true,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}P(-x)&=((-x)^2-5)Q(-x)+(-x)+4\\\\P(-x)&=(x^2-5)Q(-x)-x+4\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}P(x)+P(-x)&=(x^2-5)Q(x)+x+4+(x^2-5)Q(-x)-x+4\\\\P(x)+P(-x)&=(x^2-5)Q(x)+(x^2-5)Q(-x)+8\\\\P(x)+P(-x)&=(x^2-5)(Q(x)+Q(-x))+8\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Therefore the remainder is 8.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
