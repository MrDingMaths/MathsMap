        "answer": {
          "short": "$1\\frac{21}{40}$",
          "worked": "$$\\begin{align*}3\\frac{2}{5}-1\\frac{7}{8}&=(3-1)+\\frac{2}{5}-\\frac{7}{8}\\\\&=2+\\frac{16}{40}-\\frac{35}{40}\\\\&=2-\\frac{19}{40}\\\\&=1+\\frac{40}{40}-\\frac{19}{40}\\\\&=1\\frac{21}{40}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p30-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Check your answer by redoing the question using the improper fractions method.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{21}{40}$, agreeing with part a.",
          "worked": "$$\\begin{align*}3\\frac{2}{5}-1\\frac{7}{8}&=\\frac{17}{5}-\\frac{15}{8}\\\\&=\\frac{136}{40}-\\frac{75}{40}\\\\&=\\frac{61}{40}\\\\&=1\\frac{21}{40}\\end{align*}$$\nThis agrees with part a.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
