  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A rectangular deck has length 6 m and width 4 m. It costs $\\$90$ per square metre to tile the deck. How much will the tiling cost?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$2160$",
      "worked": "$$\\begin{align*}\\text{Area}&=L\\times W\\\\\\text{Area}&=6\\times4\\\\\\text{Area}&=24\\,\\mathrm{m}^2\\\\\\text{Cost}&=24\\times\\$90\\\\\\text{Cost}&=\\$2160\\end{align*}$$",
      "solutionDiagrams": []
    },
