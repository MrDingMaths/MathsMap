        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source PDF page 17, p17-q27-diagram\"}\n\\begin{tikzpicture}[x=2cm,y=2cm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\usetikzlibrary{calc,angles,quotes}\n% Explicit solid: O=(0,0,0), A=(1.3,0,0), B=(0,2.3,0), C=(0,0,1.7).\n% Faces OAB,OAC,OBC,ABC. Orthographic view toward the solid from (1,1,1).\n% Projection basis u=(-1,1,0)/sqrt(2), v=(-1,-1,2)/sqrt(6).\n% ABC is the visible face; OA,OB,OC are obscured edges; AC,CB,AB are silhouettes.\n\\coordinate (O) at (0,0);\n\\coordinate (A) at (-0.91924,-0.53072);\n\\coordinate (B) at (1.62635,-0.93897);\n\\coordinate (C) at (0,1.38804);\n\\draw[black,line width=0.8pt] (A)--(C)--(B)--cycle;\n\\draw[black,line width=0.8pt,dashed] (A)--(O)--(B) (O)--(C);\n% Three right-angle facets derived from the projected coordinate axes.\n\\coordinate (oa) at ($(O)!0.11!(A)$);\n\\coordinate (ob) at ($(O)!0.062!(B)$);\n\\coordinate (oc) at ($(O)!0.075!(C)$);\n\\draw[black,line width=0.4pt] (oa)--($(oa)+(ob)-(O)$)--(ob);\n\\draw[black,line width=0.4pt] (oa)--($(oa)+(oc)-(O)$)--(oc);\n\\draw[black,line width=0.4pt] (ob)--($(ob)+(oc)-(O)$)--(oc);\n\\pic[draw=black,line width=0.4pt,angle radius=6mm,angle eccentricity=1.25,\"$\\alpha$\"] {angle=O--A--C};\n\\pic[draw=black,line width=0.4pt,angle radius=8mm,angle eccentricity=1.2,\"$\\theta$\"] {angle=B--A--O};\n\\pic[draw=black,line width=0.4pt,angle radius=7mm,angle eccentricity=1.25,\"$\\beta$\"] {angle=C--B--O};\n\\path (A)--(B) node[midway,below=3pt] {$d$};\n\\fill[black] (A) circle (0.7pt) (B) circle (0.7pt) (C) circle (0.7pt) (O) circle (0.7pt);\n\\node[below left=2pt] at (A) {$A$};\n\\node[below right=2pt] at (B) {$B$};\n\\node[above=2pt] at (C) {$C$};\n\\node[below=4pt] at (O) {$O$};\n\\end{tikzpicture}",
        "src": null,
