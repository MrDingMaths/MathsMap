  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "How many ways can the letters of the word ADDITIVITY be arranged if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$151\\,200$",
          "worked": "There are ten letters, with two D’s, two T’s and three I’s.\n$$\\begin{align*}N&=\\frac{10!}{2!\\times2!\\times3!}\\\\N&=151\\,200\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q9b",
        "type": "part",
        "label": "b",
        "prompt": "the I’s are all together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\,080$",
          "worked": "Treat III as one element. Arrange eight elements, including two D’s and two T’s. The identical I’s have only one arrangement within their block.\n$$\\begin{align*}N&=\\frac{8!}{2!\\times2!}\\\\N&=10\\,080\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p13-q9c",
        "type": "part",
        "label": "c",
        "prompt": "the I’s are all together, and the T’s are on the ends?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
