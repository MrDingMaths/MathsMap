  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find, giving answers in the form $y=mx+b$, the equations of the tangent and normal to:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=4\\ln x$ at the point $Q(1,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=4x-4$. Normal: $y=-\\frac14x+\\frac14$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac4x\\\\m_{\\mathrm{tangent}}&=\\frac41=4\\\\m_{\\mathrm{normal}}&=-\\frac14\\end{align*}$$\nTangent through $Q(1,0)$:\n$$\\begin{align*}y-0&=4(x-1)\\\\y&=4x-4\\end{align*}$$\nNormal through $Q(1,0)$:\n$$\\begin{align*}y-0&=-\\frac14(x-1)\\\\y&=-\\frac14x+\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\ln x+3$ at the point $R(1,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=x+2$. Normal: $y=-x+4$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac1x\\\\m_{\\mathrm{tangent}}&=\\frac11=1\\\\m_{\\mathrm{normal}}&=-1\\end{align*}$$\nTangent through $R(1,3)$:\n$$\\begin{align*}y-3&=x-1\\\\y&=x+2\\end{align*}$$\nNormal through $R(1,3)$:\n$$\\begin{align*}y-3&=-(x-1)\\\\y&=-x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2\\ln x-2$ at the point $S(1,-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=2x-4$. Normal: $y=-\\frac12x-\\frac32$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac2x\\\\m_{\\mathrm{tangent}}&=\\frac21=2\\\\m_{\\mathrm{normal}}&=-\\frac12\\end{align*}$$\nTangent through $S(1,-2)$:\n$$\\begin{align*}y+2&=2(x-1)\\\\y&=2x-4\\end{align*}$$\nNormal through $S(1,-2)$:\n$$\\begin{align*}y+2&=-\\frac12(x-1)\\\\y&=-\\frac12x-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
