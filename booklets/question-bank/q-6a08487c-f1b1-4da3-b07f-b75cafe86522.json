  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A square has side length $5\\text{ cm}$. A rectangle has length $7\\text{ cm}$ and width $3\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p17-q8-feedback-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\": 1, \"kind\": \"geometry\", \"base\": [], \"semantic\": [], \"reference\": \"Authorised feedback p17-q8-feedback-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=2pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.8pt] (0,0) rectangle (38,23);\n\\node[below] at (19.0,0) {$7\\,\\mathrm{cm}$};\n\\node[right] at (38,11.5) {$3\\,\\mathrm{cm}$};\n\\draw[black,line width=0.8pt] (68,0) rectangle (90,22);\n\\node[below] at (79.0,0) {$5\\,\\mathrm{cm}$};\n\\node[right] at (90,11.0) {$5\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 116,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": false,
