    "children": [
      {
        "id": "p17-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find both areas.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Square: $25\\text{ cm}^2$. Rectangle: $21\\text{ cm}^2$.",
          "worked": "$$\\begin{align*}A_{\\text{square}}&=l^2\\\\A_{\\text{square}}&=5^2\\\\A_{\\text{square}}&=25\\text{ cm}^2\\\\A_{\\text{rectangle}}&=lw\\\\A_{\\text{rectangle}}&=7\\times3\\\\A_{\\text{rectangle}}&=21\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Which has the larger area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Square.",
          "worked": "The square, since $25\\text{ cm}^2>21\\text{ cm}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p17-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Which has the larger perimeter?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Neither. Both perimeters are $20\\text{ cm}$.",
          "worked": "$$\\begin{align*}P_{\\text{square}}&=4\\times5\\\\P_{\\text{square}}&=20\\text{ cm}\\\\P_{\\text{rectangle}}&=2(7+3)\\\\P_{\\text{rectangle}}&=20\\text{ cm}\\end{align*}$$\nNeither has a larger perimeter.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p17-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Can a shape have a larger area but smaller perimeter than another shape?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. A $5\\text{ cm}$ square has area $25\\text{ cm}^2$ and perimeter $20\\text{ cm}$; an $8\\text{ cm}\\times3\\text{ cm}$ rectangle has area $24\\text{ cm}^2$ and perimeter $22\\text{ cm}$.",
          "worked": "Yes. For example, a square with side length $5\\text{ cm}$ has area $25\\text{ cm}^2$ and perimeter $20\\text{ cm}$. A rectangle measuring $8\\text{ cm}$ by $3\\text{ cm}$ has area $24\\text{ cm}^2$ and perimeter $22\\text{ cm}$. The square has a larger area and a smaller perimeter.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
