    "type": "question",
    "label": "16",
    "prompt": "$X\\sim\\operatorname{Bin}(5,p)$ and $P(X=5)=0.07776$. Find $p$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=0.6$.",
      "worked": "$$\\begin{aligned}P(X=5)&=\\binom55p^5(1-p)^0=p^5,\\\\p^5&=0.07776,\\\\p&=\\sqrt[5]{0.07776}=0.6.\\end{aligned}$$",
      "solutionDiagrams": []
    },
