  "content": {
    "id": "v2-a6752-p28-practice-j6-214331-root",
    "type": "question",
    "label": null,
    "prompt": "A netball player scores each penalty shot with probability 0.6, independently. She takes 10 shots.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a6752-p28-practice-j6-214331-j6-a",
        "type": "part",
        "label": "a",
        "prompt": "How many shots must she score to score exactly 70% of her shots?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$ shots",
          "worked": "$$\\begin{align*}70\\%\\text{ of }10&=0.7\\times10\\\\&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-a6752-p28-practice-j6-214331-j6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the probability that she scores exactly 70% of her shots, correct to four decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.2150$",
          "worked": "Let $X$ be the number of shots scored. Then $X\\sim\\operatorname{Bin}(10,0.6)$.\n$$\\begin{align*}P(X=7)&=\\binom{10}{7}(0.6)^7(0.4)^3\\\\&\\approx0.2150\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
