  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Write down the new equation obtained when the following translation is applied to $f(x)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2x$, translate left 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+4$",
          "worked": "$$\\begin{align*}y&=f(x+2)\\\\y&=2(x+2)\\\\y&=2x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2x$, translate down 3 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-3$",
          "worked": "$$\\begin{align*}y&=f(x)-3\\\\y&=2x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\frac{1}{x-1}$, translate left 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{x+1}$",
          "worked": "$$\\begin{align*}y&=f(x+2)\\\\y&=\\frac{1}{(x+2)-1}\\\\y&=\\frac{1}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\frac{1}{x-1}$, translate down 3 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{x-1}-3$",
          "worked": "$$\\begin{align*}y&=f(x)-3\\\\y&=\\frac{1}{x-1}-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=2x^2$, translate right 4 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2(x-4)^2$",
          "worked": "$$\\begin{align*}y&=f(x-4)\\\\y&=2(x-4)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=2x^2$, translate up 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x^2+2$",
          "worked": "$$\\begin{align*}y&=f(x)+2\\\\y&=2x^2+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=3-2x$, translate up 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=5-2x$",
          "worked": "$$\\begin{align*}y&=f(x)+2\\\\y&=3-2x+2\\\\y&=5-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(x)=3-2x$, translate left 3 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x-3$",
          "worked": "$$\\begin{align*}y&=f(x+3)\\\\y&=3-2(x+3)\\\\y&=3-2x-6\\\\y&=-2x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
