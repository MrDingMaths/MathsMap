  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The decimal $0.abc$, where $a,b,c$ are digits, represents what percentage?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$ab.c\\%$",
      "worked": "$$\\begin{align*}0.abc\\times100 &= ab.c\\end{align*}$$\nTherefore the percentage is $ab.c\\%$. Here $ab.c$ denotes the digits $a$, $b$, then the decimal point and digit $c$.",
      "solutionDiagrams": []
