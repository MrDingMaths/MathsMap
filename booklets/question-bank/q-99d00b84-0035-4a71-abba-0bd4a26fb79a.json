  "content": {
    "id": "v2-db8d2-p31-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Find the value of each investment at the end of its term. Give each answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-db8d2-p31-practice-slot-1-slot-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Tanya deposits $\\$350$ at the end of each quarter for 8 years into an account earning 6% p.a., compounded quarterly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$14\\,240.90$",
          "worked": "Quarterly growth factor $r=1+\\dfrac{0.06}{4}=1.015$, and $n=8\\times4=32$.\n$$\\begin{align*}FV&=350(1.015)^{31}+350(1.015)^{30}+\\cdots+350\\\\&=\\frac{350\\left(1.015^{32}-1\\right)}{1.015-1}\\\\&\\approx\\$14\\,240.90\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-db8d2-p31-practice-slot-1-slot-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Sam deposits $\\$200$ at the end of each month for 3 years into an account earning 4.8% p.a., compounded monthly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$7727.62$",
          "worked": "Monthly growth factor $r=1+\\dfrac{0.048}{12}=1.004$, and $n=3\\times12=36$.\n$$\\begin{align*}FV&=200(1.004)^{35}+200(1.004)^{34}+\\cdots+200\\\\&=\\frac{200\\left(1.004^{36}-1\\right)}{1.004-1}\\\\&\\approx\\$7727.62\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-db8d2-p31-practice-slot-1-slot-1-c",
        "type": "part",
        "label": "c",
        "prompt": "Wei deposits $\\$2000$ at the end of each year for 12 years into an account earning 6% p.a., compounded annually. After the last deposit he leaves the balance in the account for a further 3 years at the same rate. Find the balance at the end of the 15 years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$40\\,184.74$",
          "worked": "Balance at the end of year 12, from the geometric series with $a=2000$, $r=1.06$, $n=12$:\n$$\\begin{align*}FV_{12}&=\\frac{2000\\left(1.06^{12}-1\\right)}{1.06-1}\\\\&\\approx\\$33\\,739.88\\end{align*}$$\nNo further deposits are made, so this balance grows for 3 more years:\n$$\\begin{align*}FV_{15}&=FV_{12}\\times(1.06)^3\\\\&\\approx\\$40\\,184.74\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
