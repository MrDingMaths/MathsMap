  "content": {
    "id": "p78-q27-root",
    "type": "question",
    "label": "",
    "prompt": "There are two round tables, one oak and one mahogany, each with five seats. In how many ways may a group of ten people be seated?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$145\\,152$ ways",
      "worked": "Choose five people for the oak table: $\\binom{10}{5}=252$.\n\nArrange them around the oak table: $(5-1)!=4!=24$.\n\nArrange the remaining five around the mahogany table: $4!=24$.\n\nThe tables are distinct, so no division by $2$ is needed.\n\n$$\\begin{aligned}N&=\\binom{10}{5}(4!)(4!)\\\\&=252\\times24\\times24\\\\&=145\\,152.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 23
  },
