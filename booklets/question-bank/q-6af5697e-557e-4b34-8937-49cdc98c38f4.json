  "content": {
    "id": "v2-p22-practice-slot-6-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Solve $\\log_2(x+3)-\\log_2(x-3)=2$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=5$",
      "worked": "The domain requires $x>3$.\n$$\\begin{align*}\\log_2\\left(\\frac{x+3}{x-3}\\right)&=2\\\\\\frac{x+3}{x-3}&=2^2\\\\x+3&=4x-12\\\\15&=3x\\\\x&=5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
