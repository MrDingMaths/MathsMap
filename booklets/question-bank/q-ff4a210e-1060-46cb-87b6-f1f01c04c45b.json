        },
        {
          "id": "p67-q3-stem-procedure",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "If the card is gold, the participant considers the statement ‘I regularly cycle to school’ and answers ",
              "marks": []
            },
            {
              "type": "text",
              "text": "True",
              "marks": [
                "italic"
