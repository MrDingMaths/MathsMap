  "content": {
    "id": "p6-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the reference angle for each of the following angles:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$150^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^{\\circ}$",
          "worked": "Quadrant II.\n$$\\begin{align*}\\phi &= 180^{\\circ}-150^{\\circ}\\\\\\phi &= 30^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$135^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45^{\\circ}$",
          "worked": "Quadrant II.\n$$\\begin{align*}\\phi &= 180^{\\circ}-135^{\\circ}\\\\\\phi &= 45^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$210^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^{\\circ}$",
          "worked": "Quadrant III.\n$$\\begin{align*}\\phi &= 210^{\\circ}-180^{\\circ}\\\\\\phi &= 30^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$315^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45^{\\circ}$",
          "worked": "Quadrant IV.\n$$\\begin{align*}\\phi &= 360^{\\circ}-315^{\\circ}\\\\\\phi &= 45^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$170^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10^{\\circ}$",
          "worked": "Quadrant II.\n$$\\begin{align*}\\phi &= 180^{\\circ}-170^{\\circ}\\\\\\phi &= 10^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$225^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45^{\\circ}$",
          "worked": "Quadrant III.\n$$\\begin{align*}\\phi &= 225^{\\circ}-180^{\\circ}\\\\\\phi &= 45^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$240^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60^{\\circ}$",
          "worked": "Quadrant III.\n$$\\begin{align*}\\phi &= 240^{\\circ}-180^{\\circ}\\\\\\phi &= 60^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$1000^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80^{\\circ}$",
          "worked": "$$\\begin{align*}\\theta_0 &= 1000^{\\circ}-2\\times360^{\\circ}\\\\\\theta_0 &= 280^{\\circ}\\end{align*}$$\nThe terminal side is in Quadrant IV.\n$$\\begin{align*}\\phi &= 360^{\\circ}-280^{\\circ}\\\\\\phi &= 80^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$780^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60^{\\circ}$",
          "worked": "$$\\begin{align*}\\theta_0 &= 780^{\\circ}-2\\times360^{\\circ}\\\\\\theta_0 &= 60^{\\circ}\\end{align*}$$\nThe terminal side is in Quadrant I, so $\\phi=60^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q6-j",
        "type": "part",
        "label": "j",
        "prompt": "$-300^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60^{\\circ}$",
          "worked": "$$\\begin{align*}\\theta_0 &= -300^{\\circ}+360^{\\circ}\\\\\\theta_0 &= 60^{\\circ}\\end{align*}$$\nThe terminal side is in Quadrant I, so $\\phi=60^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q6-k",
        "type": "part",
        "label": "k",
        "prompt": "$-30^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^{\\circ}$",
          "worked": "$$\\begin{align*}\\theta_0 &= -30^{\\circ}+360^{\\circ}\\\\\\theta_0 &= 330^{\\circ}\\end{align*}$$\nThe terminal side is in Quadrant IV.\n$$\\begin{align*}\\phi &= 360^{\\circ}-330^{\\circ}\\\\\\phi &= 30^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q6-l",
        "type": "part",
        "label": "l",
        "prompt": "$-150^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^{\\circ}$",
          "worked": "$$\\begin{align*}\\theta_0 &= -150^{\\circ}+360^{\\circ}\\\\\\theta_0 &= 210^{\\circ}\\end{align*}$$\nThe terminal side is in Quadrant III.\n$$\\begin{align*}\\phi &= 210^{\\circ}-180^{\\circ}\\\\\\phi &= 30^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
