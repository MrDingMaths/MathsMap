    "label": "3",
    "prompt": "Find the sum of the first 50 multiples of 100.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$127\\,500$",
      "worked": "The first term is $100$ and the last term is $50\\times100=5000$.\n\n$$\\begin{align*}S_{50}&=50\\left(\\frac{100+5000}{2}\\right)\\\\S_{50}&=50\\times2550\\\\S_{50}&=127\\,500.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
