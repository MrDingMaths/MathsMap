  "content": {
    "id": "p33-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "How many ways can four adults and four children be arranged in a line so that",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "there is an adult at the start or the end of the line",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31\\,680$",
          "worked": "Let $A$ contain arrangements with an adult at the start and $B$ contain arrangements with an adult at the end. There are $4\\times7!$ arrangements in each set. For both ends to be adults, choose the two adults in $4\\times3$ ways and arrange the remaining six people in $6!$ ways.\n$$\\begin{align*}|A\\cup B|&=|A|+|B|-|A\\cap B|\\\\|A\\cup B|&=4\\times7!+4\\times7!-4\\times3\\times6!\\\\|A\\cup B|&=31\\,680.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p33-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "the adults or the children are grouped together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-q8-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "4608",
                    "display": false
                  }
                ]
              },
              {
                "id": "p33-q8-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Treat each grouped set as a block; subtract arrangements where both sets are grouped.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Let $A$ contain arrangements with the four adults together and $B$ contain arrangements with the four children together. In each case, arrange one block and four other people in $5!$ ways, and arrange the people within the block in $4!$ ways. If both groups are together, arrange the two blocks in $2!$ ways and their members in $4!\\times4!$ ways.\n$$\\begin{align*}|A\\cup B|&=|A|+|B|-|A\\cap B|\\\\|A\\cup B|&=5!\\times4!+5!\\times4!-2!\\times4!\\times4!\\\\|A\\cup B|&=4608.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
