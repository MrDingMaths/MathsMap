            "id": "p14-q6-a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 14 p14-q6-a-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,2);\\coordinate (B) at (2.8,2);\\coordinate (C) at (0,0);\n\\draw (A)--node[above] {$x+2$}(B)--node[midway,below right] {$10$}(C)--node[left] {$x$}(A);\n\\draw[line width=0.4pt] (0,1.72)--(0.28,1.72)--(0.28,2);\n\\end{tikzpicture}",
