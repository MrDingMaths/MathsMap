        ],
        "children": [],
        "answer": {
          "short": "$x=13$",
          "worked": "By Pythagoras’ theorem,\n$$\\begin{align*}(x-1)^2+5^2&=x^2\\\\x^2-2x+26&=x^2\\\\2x&=26\\\\x&=13.\\end{align*}$$\nThe side lengths are $12$, $5$ and $13$, all positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46,
        "responseSpace": "scaffold"
