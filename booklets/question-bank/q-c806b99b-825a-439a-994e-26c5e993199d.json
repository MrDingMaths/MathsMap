        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{-\\frac16}$",
          "worked": "$$\\begin{align*}2^{\\frac13}\\times2^{\\frac16}\\times2^{-\\frac23}&=2^{\\frac13+\\frac16-\\frac23}\\\\2^{\\frac13}\\times2^{\\frac16}\\times2^{-\\frac23}&=2^{\\frac26+\\frac16-\\frac46}\\\\2^{\\frac13}\\times2^{\\frac16}\\times2^{-\\frac23}&=2^{-\\frac16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^{\\frac14}\\times a^{\\frac25}\\times a^{-\\frac1{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{\\frac{11}{20}}$",
          "worked": "$$\\begin{align*}a^{\\frac14}\\times a^{\\frac25}\\times a^{-\\frac1{10}}&=a^{\\frac14+\\frac25-\\frac1{10}}\\\\a^{\\frac14}\\times a^{\\frac25}\\times a^{-\\frac1{10}}&=a^{\\frac5{20}+\\frac8{20}-\\frac2{20}}\\\\a^{\\frac14}\\times a^{\\frac25}\\times a^{-\\frac1{10}}&=a^{\\frac{11}{20}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^{\\frac13}\\times\\left(2^{\\frac25}\\right)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{\\frac73}$",
          "worked": "$$\\begin{align*}2^{\\frac13}\\times\\left(2^{\\frac25}\\right)^5&=2^{\\frac13}\\times2^{\\frac25\\times5}\\\\2^{\\frac13}\\times\\left(2^{\\frac25}\\right)^5&=2^{\\frac13+2}\\\\2^{\\frac13}\\times\\left(2^{\\frac25}\\right)^5&=2^{\\frac73}\\end{align*}$$",
          "solutionDiagrams": []
