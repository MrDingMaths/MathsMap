        "answer": {
          "short": "$x^2+8x+8$",
          "worked": "$$\\begin{align*}(x+4)(x+3)+x-4&=x^2+3x+4x+12+x-4\\\\&=x^2+8x+8\\end{align*}$$",
          "solutionDiagrams": []
