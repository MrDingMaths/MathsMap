  "content": {
    "id": "p9-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The angle of elevation of the top of a castle wall from a point on the ground $25\\text{ m}$ from the base of the castle wall is $32^{\\circ}$. Find the height of the castle wall to the nearest metre.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16\\text{ m}$",
      "worked": "Let $h$ be the height of the castle wall in metres.\n$$\\begin{align*}\\tan 32^{\\circ} &= \\frac{h}{25}\\\\h &= 25\\tan 32^{\\circ}\\\\h &\\approx 16\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
