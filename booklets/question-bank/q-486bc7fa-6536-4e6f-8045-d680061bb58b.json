  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Twelve cards are put into a hat. Five of the cards are red and are numbered 1 to 5, and the other seven cards are blue and are numbered 6 to 12. A card is taken randomly from the hat. Find the probability of taking out:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "a blue card",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{12}$",
          "worked": "There are 7 blue cards among 12 equally likely cards.\n$$P(\\text{blue})=\\frac{7}{12}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "a card with an even number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The even numbers are $2,4,6,8,10,12$: 6 favourable outcomes.\n$$\\begin{align*}P(\\text{even})&=\\frac{6}{12}\\\\P(\\text{even})&=\\frac{1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "a card with a prime number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{12}$",
          "worked": "The prime numbers are $2,3,5,7,11$: 5 favourable outcomes.\n$$P(\\text{prime})=\\frac{5}{12}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q2-d",
