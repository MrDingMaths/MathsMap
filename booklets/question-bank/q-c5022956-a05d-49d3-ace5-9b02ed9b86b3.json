    "label": null,
    "prompt": "If $f(x)=ax^2+bx+c$, then simplify $f(x)-f(-x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2bx$",
      "worked": "$f(-x)=a(-x)^2+b(-x)+c=ax^2-bx+c$.\n\n$$\\begin{align*}f(x)-f(-x)&=(ax^2+bx+c)-(ax^2-bx+c)\\\\f(x)-f(-x)&=2bx.\\end{align*}$$",
