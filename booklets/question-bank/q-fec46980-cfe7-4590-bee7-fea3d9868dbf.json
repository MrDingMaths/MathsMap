  "content": {
    "id": "p15-problem-1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the value of $a$ and $b$ so that $f(x)$ is continuous.\n$$f(x)=\\begin{cases}a,&\\text{for }x<2\\\\(x-3)^2,&\\text{for }2\\le x\\le6\\\\b-x,&\\text{for }x>6\\end{cases}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=1$, $b=15$.",
      "worked": "At $x=2$, the two rules must agree:\n$$\\begin{align*}a&=(2-3)^2\\\\a&=1.\\end{align*}$$\nAt $x=6$, the two rules must agree:\n$$\\begin{align*}b-6&=(6-3)^2\\\\b-6&=9\\\\b&=15.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
