  "content": {
    "id": "p28-q8-response",
    "type": "question",
    "label": "8",
    "prompt": "Without completing the square fully, explain how you can tell immediately that $x^2+4x+10$ cannot be written as a difference of two squares.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Half of $4$ is $2$, and $10>2^2$. The remaining constant is positive, so this gives a sum of squares rather than a difference of squares.",
      "worked": "Half of the coefficient of $x$ is $2$. The perfect-square constant is therefore $2^2=4$. Since $10>4$, the remaining constant is $10-4=6>0$. Completing the square would give a squared expression plus a positive constant, so it cannot be factorised over the reals using a difference of two squares.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
