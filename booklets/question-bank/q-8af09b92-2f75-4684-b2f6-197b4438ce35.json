  "content": {
    "id": "p5-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify the following by multiplying the numerator and denominator by an appropriate term.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\frac{1}{x}}{1+\\frac{1}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x+1}$",
          "worked": "$$\\begin{align*}\\frac{\\frac{1}{x}}{1+\\frac{1}{x}}&=\\frac{x\\cdot\\frac{1}{x}}{x\\left(1+\\frac{1}{x}\\right)}\\\\&=\\frac{1}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\frac{1}{x}+\\frac{1}{y}}{\\frac{1}{x}-\\frac{1}{y}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y+x}{y-x}$",
          "worked": "Multiply the numerator and denominator by $xy$.\n\n$$\\begin{align*}\\frac{\\frac{1}{x}+\\frac{1}{y}}{\\frac{1}{x}-\\frac{1}{y}}&=\\frac{\\frac{xy}{x}+\\frac{xy}{y}}{\\frac{xy}{x}-\\frac{xy}{y}}\\\\&=\\frac{y+x}{y-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p5-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\frac{y}{x}+\\frac{x}{y}}{\\frac{y}{x}-\\frac{x}{y}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y^2+x^2}{y^2-x^2}$",
          "worked": "Multiply the numerator and denominator by $xy$.\n\n$$\\begin{align*}\\frac{\\frac{y}{x}+\\frac{x}{y}}{\\frac{y}{x}-\\frac{x}{y}}&=\\frac{\\frac{xy^2}{x}+\\frac{x^2y}{y}}{\\frac{xy^2}{x}-\\frac{x^2y}{y}}\\\\&=\\frac{y^2+x^2}{y^2-x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p5-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\frac{2}{x}+\\frac{1}{x+3}}{\\frac{3}{x}-\\frac{1}{x+3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3(x+2)}{2x+9}$",
          "worked": "Multiply the numerator and denominator by $x(x+3)$.\n\n$$\\begin{align*}\\frac{\\frac{2}{x}+\\frac{1}{x+3}}{\\frac{3}{x}-\\frac{1}{x+3}}&=\\frac{2(x+3)+x}{3(x+3)-x}\\\\&=\\frac{3x+6}{2x+9}\\\\&=\\frac{3(x+2)}{2x+9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
