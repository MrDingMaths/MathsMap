  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Evaluate each of the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$1+2+\\cdots+11+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$78$",
          "worked": "There are 6 pairs, each with sum 13.\n$$\\begin{align*}1+2+\\cdots+11+12&=(1+12)+(2+11)+\\cdots+(6+7)\\\\1+2+\\cdots+11+12&=6\\times13\\\\1+2+\\cdots+11+12&=78\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$10+11+\\cdots+24+25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$280$",
          "worked": "There are 16 terms, making 8 pairs, each with sum 35.\n$$\\begin{align*}10+11+\\cdots+24+25&=(10+25)+(11+24)+\\cdots+(17+18)\\\\10+11+\\cdots+24+25&=8\\times35\\\\10+11+\\cdots+24+25&=280\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$2+4+\\cdots+28+30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$240$",
          "worked": "There are 15 terms. Pair the outer terms to obtain 7 pairs with sum 32, leaving the middle term 16.\n$$\\begin{align*}2+4+\\cdots+28+30&=(2+30)+(4+28)+\\cdots+(14+18)+16\\\\2+4+\\cdots+28+30&=7\\times32+16\\\\2+4+\\cdots+28+30&=240\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$1+3+\\cdots+37+39$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$400$",
          "worked": "There are 20 terms, making 10 pairs, each with sum 40.\n$$\\begin{align*}1+3+\\cdots+37+39&=(1+39)+(3+37)+\\cdots+(19+21)\\\\1+3+\\cdots+37+39&=10\\times40\\\\1+3+\\cdots+37+39&=400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
