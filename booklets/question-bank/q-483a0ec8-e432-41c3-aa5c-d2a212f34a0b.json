    "label": "5",
    "prompt": "Factorise $(1+\\beta+\\alpha)^2+2\\alpha\\beta(1+\\beta+\\alpha)+\\alpha^2\\beta^2$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\bigl((1+\\alpha+\\beta)+\\alpha\\beta\\bigr)^2$",
      "worked": "This is a perfect square. Take $a=1+\\beta+\\alpha$ and $b=\\alpha\\beta$.\n$$\\begin{align*}2ab&=2\\alpha\\beta(1+\\beta+\\alpha)\\\\b^2&=\\alpha^2\\beta^2.\\end{align*}$$\nUsing $a^2+2ab+b^2=(a+b)^2$, the factorised expression is $\\bigl((1+\\alpha+\\beta)+\\alpha\\beta\\bigr)^2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
