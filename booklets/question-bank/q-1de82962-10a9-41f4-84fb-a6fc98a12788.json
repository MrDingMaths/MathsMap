  "content": {
    "id": "p47-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A die is thrown. Let $A$ be the event that an even number appears.\n\nLet $B$ be the event that a number greater than 2 appears.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Are $A$ and $B$ mutually exclusive?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No, since $A\\cap B=\\{4,6\\}\\ne\\varnothing$.",
          "worked": "$A=\\{2,4,6\\}$ and $B=\\{3,4,5,6\\}$.\n\nSince $A\\cap B=\\{4,6\\}\\ne\\varnothing$, the events are not mutually exclusive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p47-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p47-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(A)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac12$",
              "worked": "$$\\begin{align*}P(A)&=\\frac36\\\\P(A)&=\\frac12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p47-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac23$",
              "worked": "$$\\begin{align*}P(B)&=\\frac46\\\\P(B)&=\\frac23\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p47-q3-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(A\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac13$",
              "worked": "$$\\begin{align*}P(A\\cap B)&=\\frac26\\\\P(A\\cap B)&=\\frac13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p47-q3-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(A\\cup B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac56$",
              "worked": "$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)\\\\&\\quad-P(A\\cap B)\\\\P(A\\cup B)&=\\frac12+\\frac23-\\frac13\\\\P(A\\cup B)&=\\frac56\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      }
    ]
  },
