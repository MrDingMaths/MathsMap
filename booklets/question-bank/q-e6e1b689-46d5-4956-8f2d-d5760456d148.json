  "content": {
    "id": "p53-q7",
    "type": "question",
    "label": "7",
    "prompt": "Find the percentage change when:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q7-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p53-q7-a-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "$12 is increased ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "to",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": " $15.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Change}&=15-12=3\\\\\\text{Percentage change}&=\\frac{3}{12}\\times100\\%=25\\%\\end{align*}$$\nThe amount increased by $25\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p53-q7-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p53-q7-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "$12 is increased ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "by",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": " $15.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Final amount}&=12+15=27\\\\\\text{Change}&=27-12=15\\\\\\text{Percentage change}&=\\frac{15}{12}\\times100\\%=125\\%\\end{align*}$$\nThe amount increased by $125\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p53-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the difference between “increased to” and “increased by”?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "“Increased to” gives the final value; “increased by” gives the change.",
          "worked": "“Increased to” gives the final value, so increasing \\$12 to \\$15 means a \\$3 increase. “Increased by” gives the change, so increasing \\$12 by \\$15 gives a final value of \\$27.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
