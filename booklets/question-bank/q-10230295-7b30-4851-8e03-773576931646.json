  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Evaluate each expression for $x=-\\frac{2}{5}$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}5x+6&=5\\times\\left(-\\frac{2}{5}\\right)+6\\\\5x+6&=-2+6\\\\5x+6&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$-5x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}-5x+6&=-5\\times\\left(-\\frac{2}{5}\\right)+6\\\\-5x+6&=2+6\\\\-5x+6&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$5(x+6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28$",
          "worked": "$$\\begin{align*}5(x+6)&=5\\times\\left(-\\frac{2}{5}+6\\right)\\\\5(x+6)&=5\\times\\left(-\\frac{2}{5}+\\frac{30}{5}\\right)\\\\5(x+6)&=5\\times\\frac{28}{5}\\\\5(x+6)&=28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$-5(x+6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-28$",
          "worked": "$$\\begin{align*}-5(x+6)&=-5\\times\\left(-\\frac{2}{5}+6\\right)\\\\-5(x+6)&=-5\\times\\left(-\\frac{2}{5}+\\frac{30}{5}\\right)\\\\-5(x+6)&=-5\\times\\frac{28}{5}\\\\-5(x+6)&=-28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$-5x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{4}{5}$",
          "worked": "$$\\begin{align*}-5x^2&=-5\\times\\left(-\\frac{2}{5}\\right)^2\\\\-5x^2&=-5\\times\\frac{4}{25}\\\\-5x^2&=-\\frac{20}{25}\\\\-5x^2&=-\\frac{4}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{5}{x}&=5\\div\\left(-\\frac{2}{5}\\right)\\\\\\frac{5}{x}&=-\\left(\\frac{5}{1}\\times\\frac{5}{2}\\right)\\\\\\frac{5}{x}&=-\\frac{25}{2}\\\\\\frac{5}{x}&=-12\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
