        "type": "part",
        "label": "a",
        "prompt": "Find an expression for the sum of the first 30 terms of the arithmetic sequence $x+2,\\ 3x+3,\\ 5x+4,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15(60x+33)$",
          "worked": "$a=x+2$, $d=(3x+3)-(x+2)=2x+1$.\n$$\\begin{align*}S_{30}&=\\frac{30}{2}[2a+29d]\\\\S_{30}&=15[2(x+2)+29(2x+1)]\\\\S_{30}&=15[2x+4+58x+29]\\\\S_{30}&=15(60x+33)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-b4eae-p40-practice-slot-13-slot-13-b",
        "type": "part",
        "label": "b",
        "prompt": "Find an expression for the sum of the first 24 terms of the arithmetic sequence $4x-1,\\ 3x+2,\\ 2x+5,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12(67-15x)$",
          "worked": "$a=4x-1$, $d=(3x+2)-(4x-1)=3-x$.\n$$\\begin{align*}S_{24}&=\\frac{24}{2}[2a+23d]\\\\S_{24}&=12[2(4x-1)+23(3-x)]\\\\S_{24}&=12[8x-2+69-23x]\\\\S_{24}&=12(67-15x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
