        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7!=5040$",
          "worked": "Arrange the seven distinct letters.\n$$\\begin{align*}N&=7!\\\\N&=5040\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "the letters M and S are at either ends of the line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2!\\times5!=240$",
          "worked": "M and S can occupy the two ends in $2!$ orders. Arrange the remaining five letters between them.\n$$\\begin{align*}N&=2!\\times5!\\\\N&=240\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "the vowels are together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3!\\times5!=720$",
          "worked": "Treat O, U and E as one block, with $3!$ internal orders. Arrange the block and the four consonants in $5!$ ways.\n$$\\begin{align*}N&=3!\\times5!\\\\N&=720\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p8-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "none of the vowels appear together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p8-q17-d-short-result",
