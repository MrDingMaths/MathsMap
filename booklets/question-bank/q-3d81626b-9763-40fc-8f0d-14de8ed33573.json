  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The mean price of bags of potatoes at different supermarkets was $\\$7.50$. The sum of the data was $\\$90.00$. How many bags of potatoes were included in the survey?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12 bags",
      "worked": "The mean is the total divided by the number of values, so divide the total by the mean to find the number of bags.\n\n$$\\begin{align*}\\text{Number of bags}&=\\frac{90.00}{7.50}\\\\\\text{Number of bags}&=12\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
