  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Consider the function\n$$f(x)=\\begin{cases}1,&x<1,\\\\(x-1)^2+1,&x\\ge1.\\end{cases}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(-3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $-3<1$, use the first rule:\n$$f(-3)=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $f(2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "Since $2\\ge1$, use the second rule:\n$$\\begin{align*}f(2)&=(2-1)^2+1\\\\f(2)&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Sketch the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal at $y=1$ for $x<1$, then the right-hand branch of $y=(x-1)^2+1$ for $x\\ge1$, meeting at the included point $(1,1)$.",
          "worked": "For $x<1$, take the graph of $y=1$. For $x\\ge1$, take the right-hand branch of $y=(x-1)^2+1$. Both pieces meet at $(1,1)$, which is included by the second rule.",
          "solutionDiagrams": [
            {
              "id": "p7-q2-c-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 7 question 2(c); teacher page 31 Section B question 2(c)\"}\n\\begin{tikzpicture}[x=0.85cm,y=0.85cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[->,line width=0.5pt] (-3,0)--(3.8,0) node[right] {$x$};\n\\draw[->,line width=0.5pt] (0,-1.5)--(0,5.3) node[above] {$y$};\n\\draw[line width=0.8pt] (-3,1)--(1,1);\n\\draw[line width=0.8pt,domain=1:3,samples=60] plot (\\x,{(\\x-1)^2+1});\n\\fill (1,1) circle[radius=1.5pt];\n\\node[below right] at (1,1) {$(1,1)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 55,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
