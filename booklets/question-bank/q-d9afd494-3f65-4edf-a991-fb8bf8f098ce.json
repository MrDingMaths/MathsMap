          ]
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[1,\\infty)$",
          "worked": "The constant branch gives $1$. For $x\\ge1$, $(x-1)^2+1\\ge1$, with minimum $1$ at $x=1$ and no upper bound. Therefore the range is $[1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
