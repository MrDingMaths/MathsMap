            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\tan57^{\\circ}&=\\frac{h}{a}\\\\a&=\\frac{h}{\\tan57^{\\circ}}\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p53-q22-worked-right-triangle",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
