            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\tan33^{\\circ}&=\\frac{h}{b}\\\\b&=\\frac{h}{\\tan33^{\\circ}}\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p53-q22-worked-height",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}a+b&=1\\\\\\frac{h}{\\tan57^{\\circ}}+\\frac{h}{\\tan33^{\\circ}}&=1\\\\h\\left(\\frac{1}{\\tan57^{\\circ}}+\\frac{1}{\\tan33^{\\circ}}\\right)&=1\\\\h&=\\frac{1}{\\frac{1}{\\tan57^{\\circ}}+\\frac{1}{\\tan33^{\\circ}}}\\\\h&=0.4567727\\ldots\\text{ km}\\\\h&=456.7727\\ldots\\text{ m}\\\\h&\\approx457\\text{ m}\\end{aligned}",
                "display": true,
