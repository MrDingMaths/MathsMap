                "text": " and ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "b",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ". Measure all three lengths in kilometres.",
                "marks": [],
