  "content": {
    "id": "p17-q1-11-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p17-true-false-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "True or False?",
              "marks": [
                "bold"
              ],
              "colour": "#ef8b2c"
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q1-11-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=-x^2$ is a reflection of $y=x^2$ in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace $y$ with $-y$.\n$$\\begin{align*}-y&=x^2\\\\y&=-x^2\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-x^2$ is a reflection of $y=x^2$ in the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "Replace $x$ with $-x$.\n$$\\begin{align*}y&=(-x)^2\\\\y&=x^2\\end{align*}$$\nFalse. Reflection in the $y$-axis leaves this graph unchanged.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-x^3$ is a reflection of $y=x^3$ in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace $y$ with $-y$.\n$$\\begin{align*}-y&=x^3\\\\y&=-x^3\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=-x^3$ is a reflection of $y=x^3$ in the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace $x$ with $-x$.\n$$\\begin{align*}y&=(-x)^3\\\\y&=-x^3\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=-x^2-3$ is a reflection of $y=x^2+3$ in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace $y$ with $-y$.\n$$\\begin{align*}-y&=x^2+3\\\\y&=-x^2-3\\end{align*}$$\nTrue. Both terms change sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{1-x}{x+1}$ is a reflection of $y=\\dfrac{x-1}{x+1}$ in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace $y$ with $-y$.\n$$\\begin{align*}-y&=\\frac{x-1}{x+1}\\\\y&=-\\frac{x-1}{x+1}\\\\y&=\\frac{1-x}{x+1}\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\dfrac{x+1}{x-1}$ is a reflection of $y=\\dfrac{x-1}{x+1}$ in the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace every $x$ with $-x$.\n$$\\begin{align*}y&=\\frac{-x-1}{-x+1}\\\\y&=\\frac{-(x+1)}{-(x-1)}\\\\y&=\\frac{x+1}{x-1}\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^3+y^3=1$ is a reflection of $y^3-x^3=1$ in the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace $x$ with $-x$ in the original equation.\n$$\\begin{align*}y^3-(-x)^3&=1\\\\y^3+x^3&=1\\\\x^3+y^3&=1\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=x(x-2)(x-4)$ is a rotation $180^\\circ$ about the origin of $y=x(x+2)(x+4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace both $x$ and $y$ with their negatives.\n$$\\begin{align*}-y&=(-x)(-x+2)(-x+4)\\\\-y&=-x(x-2)(x-4)\\\\y&=x(x-2)(x-4)\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-j",
        "type": "part",
        "label": "j",
        "prompt": "$x^2+y^3=-1$ is a rotation $180^\\circ$ about the origin of $x^2+y^3=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "Replace both coordinates with their negatives.\n$$\\begin{align*}(-x)^2+(-y)^3&=1\\\\x^2-y^3&=1\\end{align*}$$\nFalse. The rotated curve has equation $x^2-y^3=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p17-q1-11-k",
        "type": "part",
        "label": "k",
        "prompt": "$x^3+y^3=-1$ is a rotation $180^\\circ$ about the origin of $x^3+y^3=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Replace both coordinates with their negatives.\n$$\\begin{align*}(-x)^3+(-y)^3&=1\\\\-x^3-y^3&=1\\\\x^3+y^3&=-1\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
