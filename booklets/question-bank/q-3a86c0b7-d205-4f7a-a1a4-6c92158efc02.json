  "content": {
    "id": "p14-q1",
    "type": "question",
    "label": "1",
    "prompt": "The product of 2 numbers is 20. Show that the sum of the numbers is $S=x+\\frac{20}{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$S=x+y=x+\\frac{20}{x}$, since $xy=20$.",
      "worked": "Let the two numbers be $x$ and $y$.\n\nProduct:\n$$\\begin{align*}20&=xy\\\\y&=\\frac{20}{x}\\end{align*}$$\nSum:\n$$\\begin{align*}S&=x+y\\\\S&=x+\\frac{20}{x}\\end{align*}$$",
      "solutionDiagrams": []
    },
