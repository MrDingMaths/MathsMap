  "content": {
    "id": "v2-c37f8-p11-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify $\\left(\\dfrac{6m^{-1}}{2n^{2}}\\right)^{-2}$ and express as a fraction involving non-negative indices only.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{m^{2}n^{4}}{9}$",
      "worked": "$$\\begin{align*}\\left(\\frac{6m^{-1}}{2n^{2}}\\right)^{-2}&=\\left(\\frac{3m^{-1}}{n^{2}}\\right)^{-2}\\\\&=\\left(\\frac{3}{mn^{2}}\\right)^{-2}\\\\&=\\left(\\frac{mn^{2}}{3}\\right)^{2}\\\\&=\\frac{m^{2}n^{4}}{9}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
