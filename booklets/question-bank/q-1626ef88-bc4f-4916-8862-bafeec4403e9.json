  "content": {
    "id": "p4-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A book of 420 pages has pictures on 60 of its pages. If one page is chosen at random, what is the probability that it has a picture on it?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{7}$",
      "worked": "There are 60 favourable pages out of 420 equally likely pages.\n$$\\begin{align*}P(\\text{picture})&=\\frac{60}{420}\\\\P(\\text{picture})&=\\frac{1}{7}\\end{align*}$$",
      "solutionDiagrams": []
    },
