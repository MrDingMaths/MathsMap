    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9$; the remaining total is $6\\times19-4\\times24=18$, so their mean is $18\\div2=9$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p18-q11-answer-definition",
            "type": "paragraph",
            "fontSize": null,
