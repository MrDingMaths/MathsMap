            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}19&=\\frac{24(4)+2x}{6}\\\\114&=24(4)+2x\\\\114&=96+2x\\\\18&=2x\\\\x&=9\\end{align*}",
