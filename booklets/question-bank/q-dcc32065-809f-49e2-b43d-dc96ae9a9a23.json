            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x",
                "display": false
              },
              {
                "type": "text",
                "text": " be the mean score of the remaining two friends. Their total score is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2x",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
