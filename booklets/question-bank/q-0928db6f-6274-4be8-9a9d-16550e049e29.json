  "content": {
    "id": "p11-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "During the last school holidays, Stephen drove from Brisbane to Cairns along the Bruce Highway. He set his trip meter to zero when he left home. It showed $1236\\text{ km}$ at Townsville and $1586\\text{ km}$ on his arrival in Cairns. How far did he drive between Townsville and Cairns?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$350\\text{ km}$",
      "worked": "Subtract the Townsville reading from the Cairns reading.\n$$\\begin{align*}1586-1236&=1586-1200-36\\\\1586-1236&=386-36\\\\1586-1236&=350\\end{align*}$$\nHe drove $350\\text{ km}$ between Townsville and Cairns.",
      "solutionDiagrams": []
    },
