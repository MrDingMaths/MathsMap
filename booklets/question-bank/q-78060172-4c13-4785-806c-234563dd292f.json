  "content": {
    "id": "p19-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A man puts $\\$1000$ into a bank account every month for 12 months. Initially, he had $\\$3000$ in the bank.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How much does he have in the account at the end of 12 months, given that he has not withdrawn any money?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$15\\,000$",
          "worked": "$$\\begin{align*}3000+12\\times1000&=3000+12\\,000\\\\3000+12\\times1000&=15\\,000\\end{align*}$$\nHe has $\\$15\\,000$ in the account.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "At the end of the 12 months, he writes a cheque for $\\$20\\,000$. How much does he now have left?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\$5000$; he owes $\\$5000$.",
          "worked": "$$15\\,000-20\\,000=-5000$$\nHis balance is $-\\$5000$, meaning he owes $\\$5000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
