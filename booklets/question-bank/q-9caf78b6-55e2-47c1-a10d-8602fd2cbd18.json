    "children": [
      {
        "id": "p33-group-6-10-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x^2+3x)(2x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=6x^2+10x-3$",
          "worked": "$$\\begin{aligned}y'&=(2x+3)(2x-1)+2(x^2+3x)\\\\y'&=6x^2+10x-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p33-group-6-10-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(x^2+1)(x^2+2x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4x^3+6x^2+8x+2$",
          "worked": "$$\\begin{aligned}y'&=2x(x^2+2x+3)+(x^2+1)(2x+2)\\\\y'&=4x^3+6x^2+8x+2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p33-group-6-10-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(2x-5)(x^3+x^2+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=8x^3-9x^2-10x+2$",
          "worked": "$$\\begin{aligned}y'&=2(x^3+x^2+1)+(2x-5)(3x^2+2x)\\\\y'&=8x^3-9x^2-10x+2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p33-group-6-10-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(x^2-4x+1)(x^2+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4x^3-12x^2+8x-12$",
          "worked": "$$\\begin{aligned}y'&=(2x-4)(x^2+3)+2x(x^2-4x+1)\\\\y'&=4x^3-12x^2+8x-12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p33-group-6-10-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=(3x^2-x+2)(x^2-2x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=12x^3-21x^2+8x-4$",
          "worked": "$$\\begin{aligned}y'&=(6x-1)(x^2-2x)+(3x^2-x+2)(2x-2)\\\\y'&=12x^3-21x^2+8x-4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
