  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify the following by first rationalising the denominator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{2\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt5}{10}$",
          "worked": "$$\\begin{align*}\\frac1{2\\sqrt5}&=\\frac{1}{2\\sqrt5}\\cdot\\frac{\\sqrt5}{\\sqrt5}\\\\\\frac1{2\\sqrt5}&=\\frac{\\sqrt5}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5\\sqrt2}{3\\sqrt{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt5}{3}$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt2}{3\\sqrt{10}}&=\\frac{5\\sqrt2}{3\\sqrt{10}}\\cdot\\frac{\\sqrt{10}}{\\sqrt{10}}\\\\\\frac{5\\sqrt2}{3\\sqrt{10}}&=\\frac{5\\sqrt{20}}{30}\\\\\\frac{5\\sqrt2}{3\\sqrt{10}}&=\\frac{10\\sqrt5}{30}\\\\\\frac{5\\sqrt2}{3\\sqrt{10}}&=\\frac{\\sqrt5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{5\\sqrt3}{3\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{15}}3$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt3}{3\\sqrt5}&=\\frac{5\\sqrt3}{3\\sqrt5}\\cdot\\frac{\\sqrt5}{\\sqrt5}\\\\\\frac{5\\sqrt3}{3\\sqrt5}&=\\frac{5\\sqrt{15}}{15}\\\\\\frac{5\\sqrt3}{3\\sqrt5}&=\\frac{\\sqrt{15}}3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sqrt2}{5-\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2+5\\sqrt2}{23}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt2}{5-\\sqrt2}&=\\frac{\\sqrt2}{5-\\sqrt2}\\cdot\\frac{5+\\sqrt2}{5+\\sqrt2}\\\\\\frac{\\sqrt2}{5-\\sqrt2}&=\\frac{\\sqrt2(5+\\sqrt2)}{25-2}\\\\\\frac{\\sqrt2}{5-\\sqrt2}&=\\frac{2+5\\sqrt2}{23}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{5+\\sqrt2}{5-\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27+10\\sqrt2}{23}$",
          "worked": "$$\\begin{align*}\\frac{5+\\sqrt2}{5-\\sqrt2}&=\\frac{5+\\sqrt2}{5-\\sqrt2}\\cdot\\frac{5+\\sqrt2}{5+\\sqrt2}\\\\\\frac{5+\\sqrt2}{5-\\sqrt2}&=\\frac{(5+\\sqrt2)^2}{25-2}\\\\\\frac{5+\\sqrt2}{5-\\sqrt2}&=\\frac{25+10\\sqrt2+2}{23}\\\\\\frac{5+\\sqrt2}{5-\\sqrt2}&=\\frac{27+10\\sqrt2}{23}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1}{\\sqrt3+1}+\\dfrac{\\sqrt3-1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3(\\sqrt3-1)}4$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt3+1}+\\frac{\\sqrt3-1}{4}&=\\frac{\\sqrt3-1}{3-1}+\\frac{\\sqrt3-1}{4}\\\\\\frac1{\\sqrt3+1}+\\frac{\\sqrt3-1}{4}&=\\frac{2(\\sqrt3-1)}4+\\frac{\\sqrt3-1}{4}\\\\\\frac1{\\sqrt3+1}+\\frac{\\sqrt3-1}{4}&=\\frac{3(\\sqrt3-1)}4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{42}{\\sqrt{63}}-\\dfrac6{\\sqrt7+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\frac{42}{\\sqrt{63}}-\\frac6{\\sqrt7+2}&=\\frac{42\\sqrt{63}}{63}-\\frac{6(\\sqrt7-2)}{7-4}\\\\\\frac{42}{\\sqrt{63}}-\\frac6{\\sqrt7+2}&=2\\sqrt7-2(\\sqrt7-2)\\\\\\frac{42}{\\sqrt{63}}-\\frac6{\\sqrt7+2}&=2\\sqrt7-2\\sqrt7+4\\\\\\frac{42}{\\sqrt{63}}-\\frac6{\\sqrt7+2}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
