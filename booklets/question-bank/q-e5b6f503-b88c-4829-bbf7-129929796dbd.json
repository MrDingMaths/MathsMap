        "children": [
          {
            "id": "p31-q5-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(BB)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{9}{49}$",
              "worked": "$$\\begin{align*}P(BB)&=\\frac{3}{7}\\times\\frac{3}{7}\\\\&=\\frac{9}{49}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p31-q5-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(BW)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{12}{49}$",
              "worked": "$$\\begin{align*}P(BW)&=\\frac{3}{7}\\times\\frac{4}{7}\\\\&=\\frac{12}{49}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p31-q5-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(WB)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{12}{49}$",
              "worked": "$$\\begin{align*}P(WB)&=\\frac{4}{7}\\times\\frac{3}{7}\\\\&=\\frac{12}{49}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p31-q5-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(WW)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{16}{49}$",
              "worked": "$$\\begin{align*}P(WW)&=\\frac{4}{7}\\times\\frac{4}{7}\\\\&=\\frac{16}{49}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ],
        "diagramPlacement": "beside-prompt"
      },
      {
        "id": "p31-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence, by adding, find the probability that:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p31-q5-b-i",
            "type": "part",
            "label": "i",
            "prompt": "both discs drawn have the same colour,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{25}{49}$",
              "worked": "$$\\begin{align*}P(\\text{same colour})&=P(BB)+P(WW)\\\\&=\\frac{9}{49}+\\frac{16}{49}\\\\&=\\frac{25}{49}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p31-q5-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the discs drawn have different colours.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{24}{49}$",
              "worked": "$$\\begin{align*}P(\\text{different colours})&=P(BW)+P(WB)\\\\&=\\frac{12}{49}+\\frac{12}{49}\\\\&=\\frac{24}{49}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          }
        ]
      }
