  "content": {
    "id": "p31-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A bag contains three black and four white discs. A disc is selected from the bag, its colour is noted, and it is then returned to the bag before a second disc is drawn.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q5-a",
        "type": "group",
        "label": "a",
        "prompt": "By multiplying along the branches of the tree, find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p31-q5-tree",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 31 p31-q5-tree\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black},line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (S) at (0,0);\n\\coordinate (B) at (2,1.4);\n\\coordinate (W) at (2,-1.4);\n\\coordinate (BB) at (4,2.1);\n\\coordinate (BW) at (4,0.7);\n\\coordinate (WB) at (4,-0.7);\n\\coordinate (WW) at (4,-2.1);\n\\node[align=center] at (2,3.0) {1st\\\\Draw};\n\\node[align=center] at (4,3.0) {2nd\\\\Draw};\n\\node[left] at (S) {Start};\n\\draw[black] (S) -- (B) node[midway,above left] {$\\frac{3}{7}$};\n\\draw[black] (S) -- (W) node[midway,below left] {$\\frac{4}{7}$};\n\\draw[black] (B) -- (BB) node[midway,above] {$\\frac{3}{7}$};\n\\draw[black] (B) -- (BW) node[midway,below] {$\\frac{4}{7}$};\n\\draw[black] (W) -- (WB) node[midway,above] {$\\frac{3}{7}$};\n\\draw[black] (W) -- (WW) node[midway,below] {$\\frac{4}{7}$};\n\\node[fill=white,inner sep=2pt] at (B) {B};\n\\node[fill=white,inner sep=2pt] at (W) {W};\n\\node[right] at (BB) {B};\n\\node[right] at (BW) {W};\n\\node[right] at (WB) {B};\n\\node[right] at (WW) {W};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 60,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 31,
              "sourceRegion": "Question 5, tree to the left of part a",
              "description": "Two-stage probability tree with Start, 1st Draw and 2nd Draw labels. B is above W at both stages; all six probabilities are supplied. White label masks keep branch lines clear of outcome letters.",
              "mathematics": "Replacement makes the draws independent. Each stage has P(B)=3/7 and P(W)=4/7; paths are BB, BW, WB and WW.",
              "answerVisibility": "All branch probabilities and outcome letters are permanent givens; final path probabilities are absent."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
