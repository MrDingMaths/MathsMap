  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Water drops falling from a tap are spheres of diameter $0.4\\text{ cm}$.\n15 drops per minute leak from the tap.\nHow much water, to the nearest mL, is wasted in one day? ($1\\text{ mL}=1\\text{ cm}^3$)",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$724\\text{ mL}$",
      "worked": "$\\begin{aligned}r&=0.4\\div2=0.2\\text{ cm}\\\\V_{\\text{drop}}&=\\frac43\\pi(0.2)^3\\text{ cm}^3\\\\N&=15\\times60\\times24=21600\\\\V_{\\text{day}}&=21600\\times\\frac43\\pi(0.2)^3\\\\&=230.4\\pi\\text{ mL}\\\\&\\approx724\\text{ mL}\\end{aligned}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
