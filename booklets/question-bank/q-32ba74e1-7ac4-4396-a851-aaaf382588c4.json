    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q14-a",
        "type": "group",
        "label": "a",
        "prompt": "Express as a percentage of the 25 g serving:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q14-a-i",
            "type": "part",
            "label": "i",
            "prompt": "the mass of carbohydrate",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$14.4\\%$",
              "worked": "$\\frac{3.6}{25}\\times100\\%=14.4\\%$.",
