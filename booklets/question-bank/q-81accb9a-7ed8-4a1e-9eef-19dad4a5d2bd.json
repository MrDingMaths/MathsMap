  "content": {
    "id": "p30-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Alexis runs part of a journey then walks the rest. She runs $4\\frac{6}{7}$ km then walks for $2\\frac{3}{4}$ km.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "How far is the journey altogether?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\frac{17}{28}\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Total distance}&=\\frac{34}{7}+\\frac{11}{4}\\\\&=\\frac{136}{28}+\\frac{77}{28}\\\\&=\\frac{213}{28}\\\\&=7\\frac{17}{28}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p30-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How much further does she run than walk?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\frac{3}{28}\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Difference}&=\\frac{34}{7}-\\frac{11}{4}\\\\&=\\frac{136}{28}-\\frac{77}{28}\\\\&=\\frac{59}{28}\\\\&=2\\frac{3}{28}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
