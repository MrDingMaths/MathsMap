            "type": "part",
            "label": "b",
            "prompt": "Which score has the highest frequency?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "110",
              "worked": "The three leaves $0$ on stem $11$ represent three scores of $110$. Every other score occurs at most twice.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p27-q5-c",
            "type": "part",
            "label": "c",
            "prompt": "Suggest three possible scores that could be represented by the missing digit in the fifth row.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "127, 128 or 129",
              "worked": "The ordered leaf after $7$ can be $7$, $8$ or $9$. With stem $12$, these represent scores $127$, $128$ or $129$.",
