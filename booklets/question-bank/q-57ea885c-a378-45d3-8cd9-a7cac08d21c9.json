      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Use calculus to find the gradient of the tangent to $y=e^x$ at $Q(0,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=e^x\\\\\\left.\\frac{dy}{dx}\\right|_{x=0}&=e^0=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the equation of the tangent at $Q$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x+1$",
          "worked": "$$\\begin{aligned}y-1&=1(x-0)\\\\y&=x+1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the $x$-intercept of the tangent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "At $y=0$,\n$$\\begin{aligned}0&=x+1\\\\x&=-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
