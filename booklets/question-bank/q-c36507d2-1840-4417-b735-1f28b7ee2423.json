    "children": [
      {
        "id": "p8-q12-a-node",
        "type": "part",
        "label": "a",
        "prompt": "For a given polynomial $P(x)$, what does the value of $P(-1)$ equate to?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The alternating sum of the coefficients: add coefficients of even-degree terms and subtract coefficients of odd-degree terms.",
          "worked": "Write $P(x)=a_0+a_1x+a_2x^2+\\cdots+a_nx^n$. Then\n$$P(-1)=a_0-a_1+a_2-a_3+\\cdots+(-1)^na_n.$$\nEven powers of $-1$ equal $1$ and odd powers equal $-1$, so this is the alternating sum of the coefficients.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q12-b-node",
        "type": "part",
        "label": "b",
        "prompt": "For a given polynomial $P(x)$, what does the value of $\\frac12[P(1)+P(-1)]$ equate to?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The sum of the coefficients of even-degree terms, including the constant term.",
          "worked": "Let $S_e$ be the sum of the coefficients of even-degree terms and $S_o$ the sum for odd-degree terms.\n$$\\begin{align*}P(1)&=S_e+S_o\\\\P(-1)&=S_e-S_o\\\\\\frac12[P(1)+P(-1)]&=S_e.\\end{align*}$$\nThe odd-degree coefficients cancel, leaving the sum of the even-degree coefficients.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q12-c-node",
        "type": "part",
        "label": "c",
        "prompt": "For a given polynomial $P(x)$, what does the value of $\\frac12[P(1)-P(-1)]$ equate to?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The sum of the coefficients of odd-degree terms.",
          "worked": "Let $S_e$ be the sum of the coefficients of even-degree terms and $S_o$ the sum for odd-degree terms.\n$$\\begin{align*}P(1)&=S_e+S_o\\\\P(-1)&=S_e-S_o\\\\\\frac12[P(1)-P(-1)]&=S_o.\\end{align*}$$\nThe even-degree coefficients cancel, leaving the sum of the odd-degree coefficients.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
