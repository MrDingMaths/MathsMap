  "content": {
    "id": "p24-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The population of a city was $92\\,000$ on 1 February 1920. By 1 February 1950, the population had fallen by $45\\%$. Find the population at this second date.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$50\\,600$ people",
      "worked": "$$\\begin{align*}\\text{Drop in population}&=\\frac{45}{100}\\times92\\,000\\\\\\text{Drop in population}&=45\\times920\\\\\\text{Drop in population}&=41\\,400\\\\\\text{Population on 1 February 1950}&=92\\,000-41\\,400\\\\\\text{Population on 1 February 1950}&=50\\,600\\end{align*}$$\n\nThe population was $50\\,600$ people.",
      "solutionDiagrams": []
    },
