  "content": {
    "id": "p10-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Simplify the following by first factorising using the difference of two squares.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2-100}{x+10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-10$",
          "worked": "$$\\begin{align*}\\frac{x^2-100}{x+10}&=\\frac{(x-10)(x+10)}{x+10}\\\\&=x-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2-49}{x+7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-7$",
          "worked": "$$\\begin{align*}\\frac{x^2-49}{x+7}&=\\frac{(x-7)(x+7)}{x+7}\\\\&=x-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2-25}{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-5$",
          "worked": "$$\\begin{align*}\\frac{x^2-25}{x+5}&=\\frac{(x-5)(x+5)}{x+5}\\\\&=x-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2(x-20)}{x^2-400}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{x+20}$",
          "worked": "$$\\begin{align*}\\frac{2(x-20)}{x^2-400}&=\\frac{2(x-20)}{(x-20)(x+20)}\\\\&=\\frac{2}{x+20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q20-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{5(x-6)}{x^2-36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{x+6}$",
          "worked": "$$\\begin{align*}\\frac{5(x-6)}{x^2-36}&=\\frac{5(x-6)}{(x-6)(x+6)}\\\\&=\\frac{5}{x+6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q20-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{3x+27}{x^2-81}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{x-9}$",
          "worked": "$$\\begin{align*}\\frac{3x+27}{x^2-81}&=\\frac{3(x+9)}{(x-9)(x+9)}\\\\&=\\frac{3}{x-9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
