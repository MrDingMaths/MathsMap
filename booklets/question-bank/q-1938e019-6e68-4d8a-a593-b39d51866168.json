            "type": "part",
            "label": "c",
            "prompt": "Find three consecutive even numbers that add up to 42.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12,\\ 14,\\ 16$",
              "worked": "Let $2n$ be the first even number, where $n$ is an integer.\n$$\\begin{align*}2n+(2n+2)+(2n+4)&=42\\\\6n+6&=42\\\\6n&=36\\\\n&=6\\end{align*}$$\nThe numbers are $2(6),\\ 2(6)+2,\\ 2(6)+4$, so they are $12,\\ 14,\\ 16$.\nCheck: $12+14+16=42$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 45
          },
          {
            "id": "p79-q33-d",
            "type": "part",
            "label": "d",
            "prompt": "Find four consecutive even numbers that add up to 52.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10,\\ 12,\\ 14,\\ 16$",
              "worked": "Let $2n$ be the first even number, where $n$ is an integer.\n$$\\begin{align*}2n+(2n+2)+(2n+4)+(2n+6)&=52\\\\8n+12&=52\\\\8n&=40\\\\n&=5\\end{align*}$$\nThe numbers are $2(5),\\ 2(5)+2,\\ 2(5)+4,\\ 2(5)+6$, so they are $10,\\ 12,\\ 14,\\ 16$.\nCheck: $10+12+14+16=52$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 52
          }
