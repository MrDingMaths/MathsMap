            "type": "part",
            "label": "a",
            "prompt": "The sum of three consecutive integers is 261. Find the integers.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$86,\\ 87,\\ 88$",
              "worked": "Let $n$ be the first integer.\n$$\\begin{align*}n+(n+1)+(n+2)&=261\\\\3n+3&=261\\\\3n&=258\\\\n&=86\\end{align*}$$\nThe integers are $86,\\ 87,\\ 88$.\nCheck: $86+87+88=261$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p79-q33-b",
            "type": "part",
            "label": "b",
            "prompt": "The sum of three consecutive integers is 342. Find the integers.",
