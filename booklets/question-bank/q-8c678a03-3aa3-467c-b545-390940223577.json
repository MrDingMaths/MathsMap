  "content": {
    "id": "p14-ep-13-root",
    "type": "question",
    "label": "13",
    "prompt": "Let $f(x)=4x-x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-ep-13-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down $f(x+h)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x+4h-x^2-2xh-h^2$",
          "worked": "$$\\begin{align*}f(x+h)&=4(x+h)-(x+h)^2\\\\&=4x+4h-x^2-2xh-h^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-ep-13-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $\\dfrac{f(x+h)-f(x)}{h}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4-2x-h$",
          "worked": "$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{4x+4h-x^2-2xh-h^2-(4x-x^2)}{h}\\\\&=\\frac{4h-2xh-h^2}{h}\\\\&=4-2x-h\\quad(h\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-ep-13-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=4-2x$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\&=\\lim_{h\\to0}(4-2x-h)\\\\&=4-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
