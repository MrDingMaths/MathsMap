  "content": {
    "id": "p32-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A cylinder of radius $3\\,\\mathrm{cm}$ has a volume of $36\\pi\\,\\mathrm{cm}^3$. Find the height of this cylinder.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\,\\mathrm{cm}$",
      "worked": "$$\\begin{align*}V&=\\pi r^2h\\\\36\\pi&=\\pi\\times3^2\\times h\\\\h&=\\frac{36\\pi}{9\\pi}\\\\h&=4\\,\\mathrm{cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
