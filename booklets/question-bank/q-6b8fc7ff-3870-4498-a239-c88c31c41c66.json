  "content": {
    "id": "p15-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Consider the function $f(x)=\\frac{\\sqrt{x}+1}{x-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\frac{\\sqrt{x}+1}{x-1}=\\frac{1}{\\sqrt{x}-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Factor $x-1=(\\sqrt{x}+1)(\\sqrt{x}-1)$ and cancel $\\sqrt{x}+1$.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{x}+1}{x-1}&=\\frac{\\sqrt{x}+1}{(\\sqrt{x}+1)(\\sqrt{x}-1)}\\\\\\frac{\\sqrt{x}+1}{x-1}&=\\frac{1}{\\sqrt{x}-1}\\end{align*}$$\n\nThe cancelled factor is positive for all $x\\ge 0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, differentiate $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\frac{1}{2\\sqrt{x}(\\sqrt{x}-1)^2}$ for $x>0$, $x\\ne 1$.",
          "worked": "$$f(x)=(\\sqrt{x}-1)^{-1}$$\n\n$$\\begin{align*}f'(x)&=-(\\sqrt{x}-1)^{-2}\\cdot\\frac{1}{2\\sqrt{x}}\\\\f'(x)&=-\\frac{1}{2\\sqrt{x}(\\sqrt{x}-1)^2},\\qquad x>0,\\quad x\\ne 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
