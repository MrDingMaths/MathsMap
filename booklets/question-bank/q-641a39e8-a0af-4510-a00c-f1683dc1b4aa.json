  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Let $A=\\{3,4,5,6\\}$ and $B=\\{5,6,8\\}$ have universal set $\\Omega=\\{1,2,\\ldots,9\\}$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$A'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,7,8,9\\}$",
          "worked": "$$A'=\\Omega\\setminus A=\\{1,2,7,8,9\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$B'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,3,4,7,9\\}$",
          "worked": "$$B'=\\Omega\\setminus B=\\{1,2,3,4,7,9\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$A\\cap A'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\varnothing$",
          "worked": "A set and its complement have no common elements, so $A\\cap A'=\\varnothing$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$A'\\cup A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,\\ldots,9\\}$",
          "worked": "A set together with its complement contains every element of the universal set: $A'\\cup A=\\Omega=\\{1,2,\\ldots,9\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$A\\setminus A'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{3,4,5,6\\}$",
          "worked": "No element of $A$ belongs to $A'$, so $A\\setminus A'=A=\\{3,4,5,6\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$A\\setminus B'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{5,6\\}$",
          "worked": "Keep the elements of $A$ that do not belong to $B'$, equivalently the elements also in $B$:\n$$A\\setminus B'=A\\cap B=\\{5,6\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$(A'\\setminus B)'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{3,4,5,6,8\\}$",
          "worked": "$$\\begin{align*}A'\\setminus B&=\\{1,2,7,9\\}\\\\(A'\\setminus B)'&=\\Omega\\setminus\\{1,2,7,9\\}\\\\(A'\\setminus B)'&=\\{3,4,5,6,8\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$A'\\cap B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{8\\}$",
          "worked": "The only common element of $A'=\\{1,2,7,8,9\\}$ and $B=\\{5,6,8\\}$ is 8, so $A'\\cap B=\\{8\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$A\\cup B'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,3,4,5,6,7,9\\}$",
          "worked": "Combine all elements of $A=\\{3,4,5,6\\}$ and $B'=\\{1,2,3,4,7,9\\}$:\n$$A\\cup B'=\\{1,2,3,4,5,6,7,9\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q6-j",
        "type": "part",
        "label": "j",
        "prompt": "$(A\\cap B)'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,3,4,7,8,9\\}$",
          "worked": "$$\\begin{align*}A\\cap B&=\\{5,6\\}\\\\(A\\cap B)'&=\\Omega\\setminus\\{5,6\\}\\\\(A\\cap B)'&=\\{1,2,3,4,7,8,9\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
