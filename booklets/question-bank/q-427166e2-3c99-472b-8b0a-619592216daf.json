  "content": {
    "id": "p25-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the future value of an investment of $\\$1$ at the end of each year for 19 years at 7% p.a. Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$37.38$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
