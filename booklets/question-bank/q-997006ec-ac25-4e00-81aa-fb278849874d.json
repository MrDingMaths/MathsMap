    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q50-a",
        "type": "part",
        "label": "a",
        "prompt": "annually",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2$",
          "worked": "With $n=1$ and $r=1$:\n$$\\begin{align*}FV&=1(1+1)^1\\\\FV&=2\\end{align*}$$\nThe future value is $\\$2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q50-b",
        "type": "part",
        "label": "b",
        "prompt": "monthly",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2.613035$",
          "worked": "With $n=12$ and $r=\\dfrac{1}{12}$:\n$$\\begin{align*}FV&=1\\left(1+\\frac{1}{12}\\right)^{12}\\\\FV&\\approx2.613035\\end{align*}$$\nThe future value is $\\$2.613035$ to 6 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q50-c",
        "type": "part",
        "label": "c",
        "prompt": "daily",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2.714567$",
          "worked": "With $n=365$ and $r=\\dfrac{1}{365}$:\n$$\\begin{align*}FV&=1\\left(1+\\frac{1}{365}\\right)^{365}\\\\FV&\\approx2.714567\\end{align*}$$\nThe future value is $\\$2.714567$ to 6 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q50-d",
        "type": "part",
        "label": "d",
        "prompt": "every second",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p10-q50-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\$2.718282",
                    "display": false
                  }
                ]
              },
              {
                "id": "p10-q50-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use 31,536,000 compounding periods in a 365-day year.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}n&=365\\times24\\times60\\times60\\\\n&=31\\,536\\,000\\end{align*}$$\nWith $r=\\dfrac{1}{31\\,536\\,000}$:\n$$\\begin{align*}FV&=1\\left(1+\\frac{1}{31\\,536\\,000}\\right)^{31\\,536\\,000}\\\\FV&\\approx2.718282\\end{align*}$$\nThe future value is $\\$2.718282$ to 6 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p10-q50-e",
        "type": "part",
        "label": "e",
        "prompt": "What do you notice as the number of compounding periods increases?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The future value increases towards $e$ dollars, approximately $\\$2.718282$.",
          "worked": "The future values increase as the number of compounding periods increases, approaching $e$ dollars.\n$$\\lim_{n\\to\\infty}\\left(1+\\frac{1}{n}\\right)^n=e.$$\nThus the limiting future value is approximately $\\$2.718282$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
