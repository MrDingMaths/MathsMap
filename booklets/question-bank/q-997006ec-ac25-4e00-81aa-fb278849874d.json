          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Use a 365-day year. Give the future values in parts (b)–(d) to 6 decimal places.",
              "marks": []
            }
          ]
        }
