            {
              "type": "text",
              "text": "Suppose $1 is invested at 100% per annum for one year. Find the future value of the investment if it is compounded:",
              "marks": []
            }
          ]
        },
        {
          "id": "p10-q50-precision",
          "type": "paragraph",
