  "content": {
    "id": "index-t10-q4-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify each of the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{\\left( 2m^{3}n \\right)^{3}}{m^{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8m^{5}n^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{\\left( 2m^{3}n \\right)^{3}}{m^{4}} &= 2^{3}\\,m^{3\\times3 - 4}\\,n^{3} \\\\\n&= 8m^{5}n^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3\\left(2^2c^4d^5\\right)^3}{\\left(2cd^2\\right)^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12c^{8}d^{7}$",
          "worked": "$$\\begin{align*}\n\\frac{3\\left(2^2c^4d^5\\right)^3}{\\left(2cd^2\\right)^4} &= \\frac{3\\times2^{6}\\,c^{4\\times3 - 4}\\,d^{5\\times3 - 2\\times4}}{2^{4}} \\\\\n&= 12c^{8}d^{7}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{-5\\left(3^5m^3n^2\\right)^2}{\\left(-3^3m^2n\\right)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15n$",
          "worked": "$$\\begin{align*}\n\\frac{-5\\left(3^5m^3n^2\\right)^2}{\\left(-3^3m^2n\\right)^3} &= \\frac{5\\times3^{10}\\,m^{3\\times2 - 2\\times3}\\,n^{2\\times2 - 3}}{3^{9}} \\\\\n&= 15n\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
