  "content": {
    "id": "p31-q52-54-root",
    "type": "question",
    "label": null,
    "prompt": "Prove the following identities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q52-54-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\operatorname{cosec}2\\theta=\\frac12\\sec\\theta\\operatorname{cosec}\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{cosec}2\\theta=\\frac1{2\\sin\\theta\\cos\\theta}=\\frac12\\sec\\theta\\operatorname{cosec}\\theta$.",
          "worked": "$$\\begin{align*}\\operatorname{cosec}2\\theta&=\\frac1{\\sin2\\theta}\\\\\\operatorname{cosec}2\\theta&=\\frac1{2\\sin\\theta\\cos\\theta}\\\\\\operatorname{cosec}2\\theta&=\\frac12\\sec\\theta\\operatorname{cosec}\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p31-q52-54-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cot2\\theta=\\frac{\\cot^2\\theta-1}{2\\cot\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot2\\theta=\\frac{\\cos^2\\theta-\\sin^2\\theta}{2\\sin\\theta\\cos\\theta}=\\frac{\\cot^2\\theta-1}{2\\cot\\theta}$.\n\nDivide numerator and denominator by $\\sin^2\\theta$.",
          "worked": "$$\\begin{align*}\\cot2\\theta&=\\frac{\\cos2\\theta}{\\sin2\\theta}\\\\\\cot2\\theta&=\\frac{\\cos^2\\theta-\\sin^2\\theta}{2\\sin\\theta\\cos\\theta}\\\\\\cot2\\theta&=\\frac{\\frac{\\cos^2\\theta}{\\sin^2\\theta}-1}{2\\frac{\\cos\\theta}{\\sin\\theta}}\\\\\\cot2\\theta&=\\frac{\\cot^2\\theta-1}{2\\cot\\theta}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p31-q52-54-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sec2\\theta=\\frac{\\sec^2\\theta}{2-\\sec^2\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sec2\\theta=\\frac1{2\\cos^2\\theta-1}=\\frac{\\sec^2\\theta}{2-\\sec^2\\theta}$.\n\nUse $\\cos^2\\theta=\\frac1{\\sec^2\\theta}$.",
          "worked": "$$\\begin{align*}\\sec2\\theta&=\\frac1{\\cos2\\theta}\\\\\\sec2\\theta&=\\frac1{2\\cos^2\\theta-1}\\\\\\sec2\\theta&=\\frac1{\\frac2{\\sec^2\\theta}-1}\\\\\\sec2\\theta&=\\frac{\\sec^2\\theta}{2-\\sec^2\\theta}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
