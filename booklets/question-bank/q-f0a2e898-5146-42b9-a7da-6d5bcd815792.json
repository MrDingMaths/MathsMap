  "content": {
    "id": "v2-a6564-p25-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Find $f(g(x))$ and its domain.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a6564-p25-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2-1$ and $g(x)=\\sqrt{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=x+2$, with domain $[-3,\\infty)$.",
          "worked": "$$\\begin{align*}f(g(x))&=(\\sqrt{x+3})^2-1\\\\f(g(x))&=x+3-1\\\\f(g(x))&=x+2\\end{align*}$$\nSince the domain of $g(x)$ is restricted to $x\\geq-3$, the domain of $f(g(x))$ is also restricted to $x\\geq-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-a6564-p25-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2x^2-1$ and $g(x)=\\sqrt{4-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=7-2x$, with domain $(-\\infty,4]$.",
          "worked": "$$\\begin{align*}f(g(x))&=2(\\sqrt{4-x})^2-1\\\\f(g(x))&=2(4-x)-1\\\\f(g(x))&=7-2x\\end{align*}$$\nSince the domain of $g(x)$ is restricted to $x\\leq4$, the domain of $f(g(x))$ is also restricted to $x\\leq4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
