  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify these algebraic fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3(a+b)}{4}-\\dfrac{a-b}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7a+11b}{12}$",
          "worked": "$$\\begin{aligned}\\frac{3(a+b)}{4}-\\frac{a-b}{6}&=\\frac{9(a+b)}{12}-\\frac{2(a-b)}{12}\\\\&=\\frac{9(a+b)-2(a-b)}{12}\\\\&=\\frac{9a+9b-2a+2b}{12}\\\\&=\\frac{7a+11b}{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3x+2}{3x}+\\dfrac{7}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{19x+8}{12x}$",
          "worked": "$$\\begin{aligned}\\frac{3x+2}{3x}+\\frac{7}{12}&=\\frac{4(3x+2)}{12x}+\\frac{7x}{12x}\\\\&=\\frac{4(3x+2)+7x}{12x}\\\\&=\\frac{12x+8+7x}{12x}\\\\&=\\frac{19x+8}{12x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p11-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2x-1}{4}+\\dfrac{2-3x}{10x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10x^2-11x+4}{20x}$",
          "worked": "$$\\begin{aligned}\\frac{2x-1}{4}+\\frac{2-3x}{10x}&=\\frac{5x(2x-1)}{20x}+\\frac{2(2-3x)}{20x}\\\\&=\\frac{5x(2x-1)+2(2-3x)}{20x}\\\\&=\\frac{10x^2-5x+4-6x}{20x}\\\\&=\\frac{10x^2-11x+4}{20x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p11-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a+1}{6a}+\\dfrac{a-4}{2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4a-11}{6a}$",
          "worked": "$$\\begin{aligned}\\frac{a+1}{6a}+\\frac{a-4}{2a}&=\\frac{a+1}{6a}+\\frac{3(a-4)}{6a}\\\\&=\\frac{a+1+3(a-4)}{6a}\\\\&=\\frac{a+1+3a-12}{6a}\\\\&=\\frac{4a-11}{6a}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p11-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{7}{12}-\\dfrac{3x+2}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-5x-8}{12x}$ or $-\\dfrac{5x+8}{12x}$",
          "worked": "$$\\begin{aligned}\\frac{7}{12}-\\frac{3x+2}{3x}&=\\frac{7x}{12x}-\\frac{4(3x+2)}{12x}\\\\&=\\frac{7x-4(3x+2)}{12x}\\\\&=\\frac{7x-12x-8}{12x}\\\\&=\\frac{-5x-8}{12x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p11-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{6b+7}{4b}-\\dfrac{3b-2}{5b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{18b+43}{20b}$",
          "worked": "$$\\begin{aligned}\\frac{6b+7}{4b}-\\frac{3b-2}{5b}&=\\frac{5(6b+7)}{20b}-\\frac{4(3b-2)}{20b}\\\\&=\\frac{5(6b+7)-4(3b-2)}{20b}\\\\&=\\frac{30b+35-12b+8}{20b}\\\\&=\\frac{18b+43}{20b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p11-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{8c+6}{5c}+\\dfrac{7c-3}{6c^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{48c^2+71c-15}{30c^2}$",
          "worked": "$$\\begin{aligned}\\frac{8c+6}{5c}+\\frac{7c-3}{6c^2}&=\\frac{6c(8c+6)}{30c^2}+\\frac{5(7c-3)}{30c^2}\\\\&=\\frac{6c(8c+6)+5(7c-3)}{30c^2}\\\\&=\\frac{48c^2+36c+35c-15}{30c^2}\\\\&=\\frac{48c^2+71c-15}{30c^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p11-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{9d-4}{6d}-\\dfrac{2d+5}{d^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9d^2-16d-30}{6d^2}$",
          "worked": "$$\\begin{aligned}\\frac{9d-4}{6d}-\\frac{2d+5}{d^2}&=\\frac{d(9d-4)}{6d^2}-\\frac{6(2d+5)}{6d^2}\\\\&=\\frac{d(9d-4)-6(2d+5)}{6d^2}\\\\&=\\frac{9d^2-4d-12d-30}{6d^2}\\\\&=\\frac{9d^2-16d-30}{6d^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p11-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{2x+3}{2x}-\\dfrac{1-3x}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x^2+9x-2}{2x^2}$",
          "worked": "$$\\begin{aligned}\\frac{2x+3}{2x}-\\frac{1-3x}{x^2}&=\\frac{x(2x+3)}{2x^2}-\\frac{2(1-3x)}{2x^2}\\\\&=\\frac{x(2x+3)-2(1-3x)}{2x^2}\\\\&=\\frac{2x^2+3x-2+6x}{2x^2}\\\\&=\\frac{2x^2+9x-2}{2x^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p11-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{4a-2}{3a^2}+\\dfrac{5}{4a^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16a^2-8a+15}{12a^3}$",
          "worked": "$$\\begin{aligned}\\frac{4a-2}{3a^2}+\\frac{5}{4a^3}&=\\frac{4a(4a-2)}{12a^3}+\\frac{15}{12a^3}\\\\&=\\frac{4a(4a-2)+15}{12a^3}\\\\&=\\frac{16a^2-8a+15}{12a^3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p11-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{8c+6}{5c^3}+\\dfrac{7c-3}{6c^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{35c^2+33c+36}{30c^3}$",
          "worked": "$$\\begin{aligned}\\frac{8c+6}{5c^3}+\\frac{7c-3}{6c^2}&=\\frac{6(8c+6)}{30c^3}+\\frac{5c(7c-3)}{30c^3}\\\\&=\\frac{6(8c+6)+5c(7c-3)}{30c^3}\\\\&=\\frac{48c+36+35c^2-15c}{30c^3}\\\\&=\\frac{35c^2+33c+36}{30c^3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p11-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{4-d}{6d^2}-\\dfrac{9d-4}{7d^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-7d^2-26d+24}{42d^3}$",
          "worked": "$$\\begin{aligned}\\frac{4-d}{6d^2}-\\frac{9d-4}{7d^3}&=\\frac{7d(4-d)}{42d^3}-\\frac{6(9d-4)}{42d^3}\\\\&=\\frac{7d(4-d)-6(9d-4)}{42d^3}\\\\&=\\frac{28d-7d^2-54d+24}{42d^3}\\\\&=\\frac{-7d^2-26d+24}{42d^3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
