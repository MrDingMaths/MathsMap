  "content": {
    "id": "p17-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Chords $AB$ and $CD$ of a given circle intersect at a right angle at $E$. Given $BE=16$, $DE=4$, and $AD=5$, find $CE$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$CE=12$.",
      "worked": "In right-angled $\\triangle AED$, Pythagoras’ Theorem gives\n$$\\begin{align*}AE^2&=AD^2-DE^2\\\\AE^2&=5^2-4^2\\\\AE^2&=9\\\\AE&=3.\\end{align*}$$\nBy the Power of a Point Theorem,\n$$\\begin{align*}CE\\times DE&=AE\\times BE\\\\CE\\times4&=3\\times16\\\\CE&=12.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
