        "answer": {
          "short": "$6k + 5$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p69-q14-a-answer",
                "type": "paragraph",
                "fontSize": null,
