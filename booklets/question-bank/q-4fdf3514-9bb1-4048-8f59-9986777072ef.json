                    "latex": "\\begin{aligned}k^3 &= k\\times k^2\\\\k^3 &= k(k+5)\\\\k^3 &= k^2+5k\\\\k^3 &= (k+5)+5k\\\\k^3 &= 6k+5\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
