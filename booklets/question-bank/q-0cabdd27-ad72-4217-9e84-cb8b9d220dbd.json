    "type": "question",
    "label": "7",
    "prompt": "Given $\\overrightarrow{OA}=\\begin{pmatrix}a\\\\b\\end{pmatrix}$ and $\\overrightarrow{OB}=\\begin{pmatrix}-1\\\\-3\\end{pmatrix}$, the vector for $\\overrightarrow{AB}$ is $\\begin{pmatrix}7\\\\3\\end{pmatrix}$.\n\nFind the values of $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-8,\\ b=-6$.",
      "worked": "$\\begin{aligned}\\overrightarrow{AB}&=\\overrightarrow{OB}-\\overrightarrow{OA}\\\\\\begin{pmatrix}7\\\\3\\end{pmatrix}&=\\begin{pmatrix}-1\\\\-3\\end{pmatrix}-\\begin{pmatrix}a\\\\b\\end{pmatrix}\\\\&=\\begin{pmatrix}-1-a\\\\-3-b\\end{pmatrix}\\end{aligned}$\n\nEquating components:\n\n$\\begin{aligned}-1-a&=7\\\\a&=-8\\\\-3-b&=3\\\\b&=-6\\end{aligned}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
