  "content": {
    "id": "p11-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "There were 160 chocolates in a box yesterday, but now there are 116. What was the percentage change?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$27.5\\%$ decrease.",
      "worked": "$$\\begin{align*}\\text{Percentage decrease} &= \\frac{160-116}{160}\\times100\\% \\\\\n\\text{Percentage decrease} &= \\frac{44}{160}\\times100\\% \\\\\n\\text{Percentage decrease} &= 27.5\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
