    "children": [
      {
        "id": "v2-1659ef0f4-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "In the expansion of $(1+ax+bx^{2})(1+x)^{6}$, the coefficients of $x$ and $x^{2}$ are both 0.\n\nFind the values of $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-6,\\quad b=21$",
          "worked": "$$(1+x)^{6}=1+6x+15x^{2}+\\cdots$$\n\nCoefficient of $x^{1}$:$$\\begin{aligned}1(6)+a(1)&=0\\\\a&=-6\\end{aligned}$$\n\nCoefficient of $x^{2}$:$$\\begin{aligned}1(15)+a(6)+b(1)&=0\\\\15-36+b&=0\\\\b&=21\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-1659ef0f4-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "In the expansion of $(a+bx)(1+x)^{5}$, the coefficients of $x^{2}$ and $x^{3}$ are 15 and 10 respectively.\n\nFind the values of $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2,\\quad b=-1$",
          "worked": "$$(1+x)^{5}=1+5x+10x^{2}+10x^{3}+\\cdots$$\n\nCoefficient of $x^{2}$:$$\\begin{aligned}10a+5b&=15\\\\2a+b&=3\\end{aligned}$$\n\nCoefficient of $x^{3}$:$$\\begin{aligned}10a+10b&=10\\\\a+b&=1\\end{aligned}$$\n\nSubtracting gives $a=2$, so $b=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
