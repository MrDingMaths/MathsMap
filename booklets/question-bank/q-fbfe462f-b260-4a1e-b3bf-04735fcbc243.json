  "content": {
    "id": "p49-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A plumber charges a call-out fee of $\\$90$ as well as $\\$2$ per minute while working.\n\nSuppose the plumber works for $t$ hours.\n\nWhat equation expresses the amount the plumber charges ($c$ dollars) as a function of time ($t$ hours)?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c = 90 + 120t$.",
      "worked": "The hourly rate is $60\\times\\$2=\\$120$.\n\n$$\\begin{align*}c &= mt + c_0\\\\c &= 120t + 90\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
