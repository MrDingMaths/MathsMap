    "children": [
      {
        "id": "p53-q1-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p53-q1-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}&(4^4)^3=(4\\times\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\times\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\times4)^3\\\\&\\phantom{(4^4)^3}=(4\\times\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\times\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\times4)\\times(4\\times\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\times\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\times4)\\\\&\\phantom{(4^4)^3=}\\quad\\times(4\\times\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\times\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}\\times4)\\\\&\\phantom{(4^4)^3}=4^{\\boxed{\\rule{0pt}{3mm}\\hspace{5mm}}}\\end{aligned}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each factor box: $4$. Exponent box: $12$. Result: $4^{12}$.",
          "worked": "$$\\begin{align*}(4^4)^3&=(4\\times4\\times4\\times4)^3\\\\&=(4\\times4\\times4\\times4)\\times(4\\times4\\times4\\times4)\\\\&\\quad\\times(4\\times4\\times4\\times4)\\\\&=4^{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
