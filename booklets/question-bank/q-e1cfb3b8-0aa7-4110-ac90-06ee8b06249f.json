  "content": {
    "id": "p13-q2-root",
    "type": "question",
    "label": "",
    "prompt": "Write each equation of a circle in parametric form with the parameter $\\theta$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q2a",
        "type": "part",
        "label": "a",
        "prompt": "$$x^2+y^2=4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{aligned}x&=2\\cos\\theta\\\\y&=2\\sin\\theta\\end{aligned}$$",
          "worked": "$$\\left(\\frac{x}{2}\\right)^2+\\left(\\frac{y}{2}\\right)^2=1.$$\nDefine\n$$\\begin{aligned}\\cos\\theta&=\\frac{x}{2}\\\\\\sin\\theta&=\\frac{y}{2}.\\end{aligned}$$\nRearranging:\n$$\\begin{aligned}x&=2\\cos\\theta\\\\y&=2\\sin\\theta.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p13-q2b",
        "type": "part",
        "label": "b",
        "prompt": "$$(x-3)^2+(y+1)^2=36$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{aligned}x&=3+6\\cos\\theta\\\\y&=-1+6\\sin\\theta\\end{aligned}$$",
          "worked": "$$\\left(\\frac{x-3}{6}\\right)^2+\\left(\\frac{y+1}{6}\\right)^2=1.$$\nDefine\n$$\\begin{aligned}\\cos\\theta&=\\frac{x-3}{6}\\\\\\sin\\theta&=\\frac{y+1}{6}.\\end{aligned}$$\nRearranging:\n$$\\begin{aligned}x&=3+6\\cos\\theta\\\\y&=-1+6\\sin\\theta.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p13-q2c",
        "type": "part",
        "label": "c",
        "prompt": "$$x^2+4x+y^2-5=0$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{aligned}x&=-2+3\\cos\\theta\\\\y&=3\\sin\\theta\\end{aligned}$$",
          "worked": "$$\\begin{aligned}x^2+4x+y^2&=5\\\\(x+2)^2+y^2&=9\\\\\\left(\\frac{x+2}{3}\\right)^2+\\left(\\frac{y}{3}\\right)^2&=1.\\end{aligned}$$\nDefine\n$$\\begin{aligned}\\cos\\theta&=\\frac{x+2}{3}\\\\\\sin\\theta&=\\frac{y}{3}.\\end{aligned}$$\nRearranging:\n$$\\begin{aligned}x&=-2+3\\cos\\theta\\\\y&=3\\sin\\theta.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
