    "id": "p14-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "An expanding spherical storage bag has $800\\text{ cm}^{3}$ of water pumped into it.\nFind the diameter of the bag after all the water has been pumped in. Answer to 2 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$11.52\\text{ cm}$",
      "worked": "$$\\begin{align*}V&=\\frac43\\pi r^3\\\\800&=\\frac43\\pi r^3\\\\r^3&=\\frac{600}{\\pi}\\\\r&=\\sqrt[3]{\\frac{600}{\\pi}}\\\\d&=2\\sqrt[3]{\\frac{600}{\\pi}}\\\\d&\\approx11.52\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
