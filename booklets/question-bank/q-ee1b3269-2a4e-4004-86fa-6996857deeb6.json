    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$3x+y=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3x+12$; gradient $-3$, $y$-intercept $12$.",
          "worked": "$$\\begin{align*}3x+y&=12\\\\y&=12-3x\\\\y&=-3x+12\\end{align*}$$\nThe gradient is $-3$ and the $y$-intercept is $12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
