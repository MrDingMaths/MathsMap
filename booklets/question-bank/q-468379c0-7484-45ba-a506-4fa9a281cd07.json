    "label": "16",
    "prompt": "Yolanda runs $400\\text{ m}$ in $52$ seconds. What is her average speed in m/s?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7\\frac{9}{13}\\text{ m/s}$",
      "worked": "$$\\begin{align*}\\text{Average speed}&=\\frac{\\text{distance}}{\\text{time}}\\\\\\text{Average speed}&=\\frac{400}{52}\\text{ m/s}\\\\\\text{Average speed}&=\\frac{100}{13}\\text{ m/s}\\\\\\text{Average speed}&=7\\frac{9}{13}\\text{ m/s}\\end{align*}$$",
