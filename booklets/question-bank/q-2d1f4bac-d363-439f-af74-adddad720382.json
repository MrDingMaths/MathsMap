  "content": {
    "id": "p18-q64-66",
    "type": "question",
    "label": null,
    "prompt": "Eliminate $\\theta$ from each of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q64",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\operatorname{cosec}\\theta$ and $y=2\\cot\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2-y^2=4$",
          "worked": "Using $\\operatorname{cosec}^2\\theta-\\cot^2\\theta=1$, with $\\sin\\theta\\ne0$:\n$$\\begin{align*}4x^2-y^2&=4\\operatorname{cosec}^2\\theta-(2\\cot\\theta)^2\\\\4x^2-y^2&=4\\operatorname{cosec}^2\\theta-4\\cot^2\\theta\\\\4x^2-y^2&=4(\\operatorname{cosec}^2\\theta-\\cot^2\\theta)\\\\4x^2-y^2&=4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q65",
        "type": "part",
        "label": "b",
        "prompt": "$x=3\\sec\\theta$ and $y=3\\tan\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-y^2=9$",
          "worked": "Using $\\sec^2\\theta-\\tan^2\\theta=1$, with $\\cos\\theta\\ne0$:\n$$\\begin{align*}x^2-y^2&=9\\sec^2\\theta-9\\tan^2\\theta\\\\x^2-y^2&=9(\\sec^2\\theta-\\tan^2\\theta)\\\\x^2-y^2&=9.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q66",
        "type": "part",
        "label": "c",
        "prompt": "$x=\\sin\\theta+\\cos\\theta$ and $y=\\sin\\theta-\\cos\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=2$",
          "worked": "$$\\begin{align*}x^2+y^2&=(\\sin\\theta+\\cos\\theta)^2+(\\sin\\theta-\\cos\\theta)^2\\\\x^2+y^2&=\\sin^2\\theta+2\\sin\\theta\\cos\\theta+\\cos^2\\theta+\\sin^2\\theta-2\\sin\\theta\\cos\\theta+\\cos^2\\theta\\\\x^2+y^2&=2\\sin^2\\theta+2\\cos^2\\theta\\\\x^2+y^2&=2(\\sin^2\\theta+\\cos^2\\theta)\\\\x^2+y^2&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
