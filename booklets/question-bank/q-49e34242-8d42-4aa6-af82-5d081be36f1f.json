              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 4,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{1}{4}+\\frac{1}{8}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;2=\\frac{1}{2}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\times$",
          "worked": "$$\\begin{align*}\\frac14+\\frac18\\times2&=\\frac14+\\frac14\\\\&=\\frac12\\end{align*}$$\nThe missing operation is $\\times$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p97-q8-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p97-q8-b-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 4,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "4\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{2}{3}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;5=3\\frac{13}{15}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-,\\ \\div$ (left to right)",
          "worked": "$$\\begin{align*}4-\\frac23\\div5&=4-\\frac23\\times\\frac15\\\\&=4-\\frac{2}{15}\\\\&=\\frac{58}{15}\\\\&=3\\frac{13}{15}\\end{align*}$$\nThe missing operations are $-$ and $\\div$, from left to right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p97-q8-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p97-q8-c-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 4,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "2\\frac12\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;1\\frac12\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;3\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;3=0",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$+,\\ \\div,\\ -$ (left to right)",
          "worked": "$$\\begin{align*}2\\frac12+1\\frac12\\div3-3&=\\frac52+\\frac32\\times\\frac13-3\\\\&=\\frac52+\\frac12-3\\\\&=3-3\\\\&=0\\end{align*}$$\nThe missing operations are $+$, $\\div$ and $-$, from left to right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
