    "type": "question",
    "label": "5",
    "prompt": "A man earns a salary of $\\$1440$ for a 44-hour week. His weekly salary is increased by $10\\%$ and his hours are reduced by $10\\%$. Find his new hourly salary.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$40$ per hour.",
      "worked": "$$\\begin{align*}\\text{New weekly salary}&=1440\\times1.10\\\\\\text{New weekly salary}&=\\$1584\\\\\\text{New weekly hours}&=44\\times0.90\\\\\\text{New weekly hours}&=39.6\\\\\\text{New hourly salary}&=1584\\div39.6\\\\\\text{New hourly salary}&=\\$40\\text{ per hour}\\end{align*}$$",
