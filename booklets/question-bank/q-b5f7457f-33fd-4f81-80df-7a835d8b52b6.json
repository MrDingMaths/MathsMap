  "content": {
    "id": "p11-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "A suburban home is advertised as $650\\text{ m}^{2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Express this in hectares.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.065\\text{ ha}$",
          "worked": "$$\\begin{align*}650\\text{ m}^{2} &= (650\\div10\\,000)\\text{ ha}\\\\&=0.065\\text{ ha}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "A nearby farm is $3.2\\text{ ha}$. How many suburban homes could fit on the farm?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "49 complete blocks.",
          "worked": "$$\\begin{align*}\\text{Farm area} &= (3.2\\times10\\,000)\\text{ m}^{2}\\\\&=32\\,000\\text{ m}^{2}\\\\\\text{Number of blocks} &=32\\,000\\div650\\\\&=49+\\frac{3}{13}\\end{align*}$$\nOnly complete blocks count, so 49 suburban homes could fit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
