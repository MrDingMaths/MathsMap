  "content": {
    "id": "p41-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A cyclist travels at $a$ of their maximum speed for the first half of a journey and $b$ of their maximum speed for the second half. Their average speed as a fraction of maximum speed is $\\dfrac{1}{\\frac{1}{2}\\left(\\frac{1}{a}+\\frac{1}{b}\\right)}$. Simplify this expression.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{2ab}{a+b}$",
      "worked": "Multiply the main numerator and denominator by $2ab$.\n\n$$\\begin{align*}\\frac{1}{\\frac{1}{2}\\left(\\frac{1}{a}+\\frac{1}{b}\\right)}&=\\frac{2ab}{b+a}\\\\&=\\frac{2ab}{a+b}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
