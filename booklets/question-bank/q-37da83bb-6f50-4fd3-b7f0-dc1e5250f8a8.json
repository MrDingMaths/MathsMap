  "content": {
    "id": "p59-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "$ABC$ is a triangle. $\\overrightarrow{AB}=2\\underset{\\sim}{a}+\\underset{\\sim}{b}$ and $\\overrightarrow{BC}=\\underset{\\sim}{a}-3\\underset{\\sim}{b}$.\n\nWrite in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p59-q4-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 59 p59-q4-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,draw=black,text=black,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (0.65,3.1);\n\\coordinate (C) at (3.65,1.45);\n\\draw (A)--(B)--(C)--cycle;\n\\draw[->] (A)--(0.325,1.55);\n\\draw[->] (B)--(2.15,2.275);\n\\path (A)--(B) node[midway,left=4pt] {$2\\underset{\\sim}{a}+\\underset{\\sim}{b}$};\n\\path (B)--(C) node[midway,above right=2pt] {$\\underset{\\sim}{a}-3\\underset{\\sim}{b}$};\n\\node[below left=2pt] at (A) {$A$};\n\\node[above=2pt] at (B) {$B$};\n\\node[right=2pt] at (C) {$C$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 62,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
