    "children": [
      {
        "id": "p59-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{AC}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\underset{\\sim}{a}-2\\underset{\\sim}{b}$",
          "worked": "By the triangle law,\n$$\\begin{aligned}\\overrightarrow{AC}&=\\overrightarrow{AB}+\\overrightarrow{BC}\\\\\\overrightarrow{AC}&=(2\\underset{\\sim}{a}+\\underset{\\sim}{b})+(\\underset{\\sim}{a}-3\\underset{\\sim}{b})\\\\\\overrightarrow{AC}&=3\\underset{\\sim}{a}-2\\underset{\\sim}{b}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p59-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{CA}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\underset{\\sim}{a}+2\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{CA}&=-\\overrightarrow{AC}\\\\\\overrightarrow{CA}&=-(3\\underset{\\sim}{a}-2\\underset{\\sim}{b})\\\\\\overrightarrow{CA}&=-3\\underset{\\sim}{a}+2\\underset{\\sim}{b}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ],
    "diagramPlacement": "beside-prompt"
