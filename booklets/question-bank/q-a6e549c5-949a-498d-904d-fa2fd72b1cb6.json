  "content": {
    "id": "p27-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The population of a town increases at a rate of $5.8\\%$ p.a. for 10 years, compounded annually. Initially, the population was $34\\,000$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the population at the end of the 10-year period? Give your answer to the nearest person.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$59\\,750$ people",
          "worked": "$$\\begin{align*}A_{10}&=34\\,000(1+0.058)^{10}\\\\A_{10}&=34\\,000(1.058)^{10}\\\\A_{10}&\\approx59\\,750\\end{align*}$$\nThe population was approximately $59\\,750$ people, to the nearest person.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p27-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What was the total percentage increase, correct to the nearest $1\\%$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$76\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\frac{34\\,000(1.058)^{10}-34\\,000}{34\\,000}\\times100\\%\\\\\\text{Percentage increase}&=\\bigl((1.058)^{10}-1\\bigr)\\times100\\%\\\\\\text{Percentage increase}&\\approx76\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
