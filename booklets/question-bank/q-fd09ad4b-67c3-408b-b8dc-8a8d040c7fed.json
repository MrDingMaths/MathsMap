          "inlines": [
            {
              "type": "text",
              "text": "Alex has 2 red, 4 blue, 1 yellow and 3 green pens in his pencil case.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "He picks a pen at random, draws a circle, then replaces the pen.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Then he does the same for a second circle.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "What is the probability that both circles are green?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{9}{100}$",
      "worked": "There are $2+4+1+3=10$ pens. Replacement makes the selections independent.\n$$\\begin{align*}P(\\text{green})&=\\frac{3}{10}\\\\P(\\text{both green})&=\\frac{3}{10}\\times\\frac{3}{10}\\\\&=\\frac{9}{100}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
