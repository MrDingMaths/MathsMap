  "content": {
    "id": "p36-q31-root",
    "type": "question",
    "label": "31",
    "prompt": "The common ratio of a geometric series is $4$ and the sum of the first $5$ terms is $3069$.\nFind the first term.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=9$",
      "worked": "$r=4,\\quad S_5=3069$\n$$\\begin{aligned}S_5&=\\frac{a(r^5-1)}{r-1}\\\\3069&=\\frac{a(4^5-1)}{4-1}\\\\3069&=\\frac{a(1024-1)}{3}\\\\3069&=\\frac{a(1023)}{3}\\\\3069&=341a\\\\\\therefore\\ a&=9\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
