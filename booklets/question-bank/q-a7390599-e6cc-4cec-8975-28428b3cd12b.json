    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2$",
      "worked": "$$\\begin{align*}2\\log_6(3)+\\log_6(8)-\\log_6(2)&=\\log_6\\left(\\frac{3^2\\times8}{2}\\right)\\\\2\\log_6(3)+\\log_6(8)-\\log_6(2)&=\\log_6(6^2)\\\\2\\log_6(3)+\\log_6(8)-\\log_6(2)&=2\\end{align*}$$",
      "solutionDiagrams": []
