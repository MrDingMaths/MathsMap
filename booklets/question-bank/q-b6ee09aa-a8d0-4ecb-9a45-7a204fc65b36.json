  "content": {
    "id": "p26-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Evaluate $a+2b-c$ when:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$a=\\frac14$, $b=\\frac12$ and $c=\\frac38$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac78$",
          "worked": "$$\\begin{align*}a+2b-c&=\\frac14+2\\times\\frac12-\\frac38\\\\a+2b-c&=\\frac28+\\frac88-\\frac38\\\\a+2b-c&=\\frac78\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p26-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$a=\\frac b3$, $b=-\\frac14$ and $c=\\frac{5b}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac38$",
          "worked": "$$\\begin{align*}a&=\\frac{-\\frac14}{3}\\\\a&=-\\frac1{12}\\end{align*}$$\n$$\\begin{align*}c&=\\frac{5\\times(-\\frac14)}6\\\\c&=-\\frac5{24}\\end{align*}$$\n$$\\begin{align*}a+2b-c&=-\\frac1{12}+2\\times\\left(-\\frac14\\right)-\\left(-\\frac5{24}\\right)\\\\a+2b-c&=-\\frac2{24}-\\frac{12}{24}+\\frac5{24}\\\\a+2b-c&=-\\frac38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p26-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$a=\\frac1c$, $b=\\frac{3c}{2}$ and $c=\\frac38$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{41}{12}$",
          "worked": "$$\\begin{align*}a&=\\frac1{\\frac38}\\\\a&=\\frac83\\end{align*}$$\n$$\\begin{align*}b&=\\frac{3\\times\\frac38}{2}\\\\b&=\\frac9{16}\\end{align*}$$\n$$\\begin{align*}a+2b-c&=\\frac83+2\\times\\frac9{16}-\\frac38\\\\a+2b-c&=\\frac{64}{24}+\\frac{27}{24}-\\frac9{24}\\\\a+2b-c&=\\frac{41}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p26-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$a=c^2$, $b=\\frac1{c^2}$ and $c=\\frac23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{77}{18}$",
          "worked": "$$\\begin{align*}a&=\\left(\\frac23\\right)^2\\\\a&=\\frac49\\end{align*}$$\n$$\\begin{align*}b&=\\frac1{(\\frac23)^2}\\\\b&=\\frac94\\end{align*}$$\n$$\\begin{align*}a+2b-c&=\\frac49+2\\times\\frac94-\\frac23\\\\a+2b-c&=\\frac8{18}+\\frac{81}{18}-\\frac{12}{18}\\\\a+2b-c&=\\frac{77}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
