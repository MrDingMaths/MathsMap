  "content": {
    "id": "p54-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "When the polynomial $P(x)$ is divided by $(x-1)(x+3)$, the quotient is $Q(x)$ and the remainder is $(2x+5)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write this information in quotient-remainder form $P(x)=Q(x)D(x)+R(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x-1)(x+3)Q(x)+(2x+5)$",
          "worked": "$$P(x)=(x-1)(x+3)Q(x)+(2x+5)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p54-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, by evaluating $P(1)$, find the remainder when $P(x)$ is divided by $(x-1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}P(1)&=(1-1)(1+3)Q(1)+2(1)+5\\\\P(1)&=7\\end{align*}$$\nBy the remainder theorem, the remainder is $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p54-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the remainder when $P(x)$ is divided by $(x+3)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}P(-3)&=(-3-1)(-3+3)Q(-3)+2(-3)+5\\\\P(-3)&=-1\\end{align*}$$\nBy the remainder theorem, the remainder is $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
