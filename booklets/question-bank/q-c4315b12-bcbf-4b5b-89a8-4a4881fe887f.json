  "content": {
    "id": "p11-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A water tank is being emptied. The quantity $Q$ litres of water remaining in the tank at any time $t$ minutes after it starts to empty is given by $Q(t)=1000(20-t)^2$, $0\\leq t\\leq20$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "At what rate is the tank being emptied at any time $t$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2000(20-t)$ L/min.",
          "worked": "$$\\begin{align*}Q'(t)&=1000\\times2(20-t)(-1)\\\\Q'(t)&=-2000(20-t)\\end{align*}$$\nThe emptying rate is $-Q'(t)=2000(20-t)$ L/min.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "How much time does it take to empty the tank? (When is $Q=0$?)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 minutes.",
          "worked": "$$\\begin{align*}1000(20-t)^2&=0\\\\20-t&=0\\\\t&=20\\end{align*}$$\nThe tank empties after 20 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "At what time is the water flowing out at a rate of 20 000 litres per minute?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "After 10 minutes.",
          "worked": "$$\\begin{align*}2000(20-t)&=20\\,000\\\\20-t&=10\\\\t&=10\\end{align*}$$\nThe water flows out at this rate after 10 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the average rate at which the water flows out in the first 5 minutes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35\\,000$ L/min.",
          "worked": "$$\\begin{align*}Q(0)&=1000(20)^2=400\\,000\\\\Q(5)&=1000(15)^2=225\\,000\\end{align*}$$\nAverage outflow rate:\n$$\\begin{align*}\\frac{Q(0)-Q(5)}{5-0}&=\\frac{400\\,000-225\\,000}{5}\\\\&=35\\,000\\text{ L/min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
