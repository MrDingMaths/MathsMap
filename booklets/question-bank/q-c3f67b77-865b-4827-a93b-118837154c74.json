  "content": {
    "id": "p35-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Recall that the range of $f(x)=x^2$ is $y\\ge 0$ because $x^2$ cannot be negative.\nUse this, or your knowledge of the graph, to determine the range of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=4x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ge 0$",
          "worked": "Since $x^2\\ge 0$, $4x^2\\ge 0$. The minimum is $0$ at $x=0$, so the range is $y\\ge 0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ge 3$",
          "worked": "Since $x^2\\ge 0$, $x^2+3\\ge 3$. The minimum is $3$ at $x=0$, so the range is $y\\ge 3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3x^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ge -4$",
          "worked": "Since $x^2\\ge 0$, $3x^2-4\\ge -4$. The minimum is $-4$ at $x=0$, so the range is $y\\ge -4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 0$",
          "worked": "Since $x^2\\ge 0$, $-x^2\\le 0$. The maximum is $0$ at $x=0$, so the range is $y\\le 0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=-x^2+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 6$",
          "worked": "Since $-x^2\\le 0$, $-x^2+6\\le 6$. The maximum is $6$ at $x=0$, so the range is $y\\le 6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=5-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 5$",
          "worked": "Since $x^2\\ge 0$, $5-x^2\\le 5$. The maximum is $5$ at $x=0$, so the range is $y\\le 5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=3-4x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 3$",
          "worked": "Since $4x^2\\ge 0$, $3-4x^2\\le 3$. The maximum is $3$ at $x=0$, so the range is $y\\le 3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(x)=(x-3)^2+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ge 2$",
          "worked": "Since $(x-3)^2\\ge 0$, $(x-3)^2+2\\ge 2$. The minimum is $2$ at $x=3$, so the range is $y\\ge 2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$f(x)=10-(x+2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 10$",
          "worked": "Since $(x+2)^2\\ge 0$, $10-(x+2)^2\\le 10$. The maximum is $10$ at $x=-2$, so the range is $y\\le 10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
