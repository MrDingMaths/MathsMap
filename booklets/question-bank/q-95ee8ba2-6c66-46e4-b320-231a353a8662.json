      {
        "id": "p4-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $11\\times81=891$, find $12\\times81$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$972$",
          "worked": "$$\\begin{align*}12\\times81&=(11+1)\\times81\\\\12\\times81&=11\\times81+1\\times81\\\\12\\times81&=891+81\\\\12\\times81&=972\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $15\\times55=825$, find $16\\times55$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$880$",
          "worked": "$$\\begin{align*}16\\times55&=(15+1)\\times55\\\\16\\times55&=15\\times55+1\\times55\\\\16\\times55&=825+55\\\\16\\times55&=880\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $58\\times59=3422$, find $57\\times59$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3363$",
          "worked": "$$\\begin{align*}57\\times59&=(58-1)\\times59\\\\57\\times59&=58\\times59-1\\times59\\\\57\\times59&=3422-59\\\\57\\times59&=3363\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Given that $99\\times99=9801$, find $99\\times98$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9702$",
          "worked": "$$\\begin{align*}99\\times98&=99\\times(99-1)\\\\99\\times98&=99\\times99-99\\times1\\\\99\\times98&=9801-99\\\\99\\times98&=9702\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
