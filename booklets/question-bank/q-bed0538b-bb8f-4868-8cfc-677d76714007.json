    "children": [
      {
        "id": "p14-task-01-a",
        "type": "part",
        "label": "a",
        "prompt": "All functions are relations.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. A function is a special type of relation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p14-task-01-b",
        "type": "part",
        "label": "b",
        "prompt": "All relations are functions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. A relation may associate one input with more than one output, so it need not be a function.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p14-task-01-c",
        "type": "part",
        "label": "c",
        "prompt": "In a function, each input has exactly one output.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. A function assigns exactly one output to each input.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p14-task-01-d",
        "type": "part",
        "label": "d",
        "prompt": "The first coordinate of each ordered pair in $f$ appears exactly once.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. In the function $f$, each input occurs as the first coordinate of exactly one ordered pair.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p14-task-01-e",
        "type": "part",
        "label": "e",
        "prompt": "In a relation from $A$ to $B$, each element in $A$ is associated with at least one element in $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. A relation from $A$ to $B$ may leave an element of $A$ without any associated element of $B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p14-task-01-f",
        "type": "part",
        "label": "f",
        "prompt": "In a relation from $A$ to $B$, each element in $A$ is associated with at most one element in $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. A relation may associate one element of $A$ with more than one element of $B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p14-task-01-g",
        "type": "part",
        "label": "g",
        "prompt": "In a relation from $A$ to $B$, each element in $A$ is associated with exactly one element in $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. Exactly one associated element of $B$ for every element of $A$ is required for a function, but not for a general relation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
