        "children": [],
        "answer": {
          "short": "\\$55\\,861.52 per year.",
          "worked": "$$\\begin{align*}\\text{Weekly pay} &= \\text{Hourly pay}\\times\\text{Hours per week}\\\\\\text{Weekly pay} &= \\$28.27\\times38\\\\\\text{Weekly pay} &= \\$1074.26\\\\\\text{Annual pay} &= \\$1074.26\\times52\\\\\\text{Annual pay} &= \\$55\\,861.52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
