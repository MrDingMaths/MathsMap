  "content": {
    "id": "p25-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Eric scored 60% on his most recent Mathematics test. He is determined to improve his score on the next topic test, which will be out of 30 marks. What is the least number of marks Eric can score to improve on his previous test score?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "19 marks",
      "worked": "$$\\begin{align*}50\\%\\text{ of }30&=30\\div2=15\\\\10\\%\\text{ of }30&=30\\div10=3\\\\60\\%\\text{ of }30&=15+3=18\\end{align*}$$\n\nEric must score more than 18 marks to improve on 60%, so the least whole-number score is 19 marks.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
