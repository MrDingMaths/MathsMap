  "content": {
    "id": "p6-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Write each of the following sets by listing their elements between braces:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\{4n:n\\in\\mathbb N\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{4,8,12,\\ldots\\}$",
          "worked": "For $n=1,2,3,\\ldots$, the values of $4n$ are $4,8,12,\\ldots$. The set is $\\{4,8,12,\\ldots\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\{4n:n\\in\\mathbb Z\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{\\ldots,-12,-8,-4,0,4,8,12,\\ldots\\}$",
          "worked": "Allowing negative integers, zero and positive integers gives all integer multiples of $4$: $\\{\\ldots,-12,-8,-4,0,4,8,12,\\ldots\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\{2n-1:n\\in\\mathbb N\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,3,5,\\ldots\\}$",
          "worked": "For $n=1,2,3,\\ldots$, the values of $2n-1$ are $1,3,5,\\ldots$. The set is $\\{1,3,5,\\ldots\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\{2m-1:m\\in\\mathbb Z\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{\\ldots,-5,-3,-1,1,3,5,\\ldots\\}$",
          "worked": "For $m=\\ldots,-2,-1,0,1,2,3,\\ldots$, the values of $2m-1$ are all odd integers: $\\{\\ldots,-5,-3,-1,1,3,5,\\ldots\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\{3n+1:n\\in\\mathbb N\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{4,7,10,13,\\ldots\\}$",
          "worked": "For $n=1,2,3,4,\\ldots$, the values of $3n+1$ are $4,7,10,13,\\ldots$. The set is $\\{4,7,10,13,\\ldots\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\{n\\in\\mathbb Z:-2\\le n<2\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{-2,-1,0,1\\}$",
          "worked": "The integers from $-2$ inclusive to $2$ exclusive are $-2,-1,0,1$. The set is $\\{-2,-1,0,1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\{m\\in\\mathbb N:-3\\le m\\le3\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,3\\}$",
          "worked": "Natural numbers begin at $1$. Those satisfying $-3\\le m\\le3$ are $1,2,3$, so the set is $\\{1,2,3\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\{x\\in\\mathbb R:x^2=3\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{-\\sqrt3,\\sqrt3\\}$",
          "worked": "$$\\begin{align*}x^2&=3\\\\x&=\\pm\\sqrt3\\end{align*}$$Both values are real, so the set is $\\{-\\sqrt3,\\sqrt3\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\{x\\in\\mathbb N:x^2=5\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\varnothing$",
          "worked": "Since $2^2<5<3^2$, no natural number has square $5$. The set is $\\varnothing$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\{n\\in\\mathbb Z:n^2=4\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{-2,2\\}$",
          "worked": "$$\\begin{align*}n^2&=4\\\\n&=\\pm2\\end{align*}$$Both values are integers, so the set is $\\{-2,2\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\{x\\in\\mathbb N:x^2=5\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\varnothing$",
          "worked": "Since $2^2<5<3^2$, no natural number has square $5$. The set is $\\varnothing$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\{x\\in\\mathbb R:x^3=8\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{2\\}$",
          "worked": "$$\\begin{align*}x^3&=8\\\\x&=2\\end{align*}$$The only real solution is $2$, so the set is $\\{2\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q1-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\{5a+2b:a,b\\in\\mathbb Z\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{\\ldots,-3,-2,-1,0,1,2,3,\\ldots\\}=\\mathbb Z$\n\nEvery integer $k$ is obtained by taking $a=k$ and $b=-2k$.",
          "worked": "Every value of $5a+2b$ is an integer. Conversely, for any integer $k$, choose $a=k$ and $b=-2k$:\n$$\\begin{align*}5a+2b&=5k+2(-2k)\\\\5a+2b&=k.\\end{align*}$$Thus the set is $\\{\\ldots,-3,-2,-1,0,1,2,3,\\ldots\\}=\\mathbb Z$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q1-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\{6a+2b:a,b\\in\\mathbb Z\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{\\ldots,-6,-4,-2,0,2,4,6,\\ldots\\}$\n\nAll values are even, and every even integer is obtained with $a=0$.",
          "worked": "$$6a+2b=2(3a+b),$$so every value is an even integer. Every even integer $2k$ is obtained by choosing $a=0$ and $b=k$. The set is $\\{\\ldots,-6,-4,-2,0,2,4,6,\\ldots\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
