  "content": {
    "id": "p19-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Seven boys and five girls are seated around a circular table with 12 chairs. Prove by way of contradiction that there are two boys sitting opposite one another.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "If no two boys sat opposite one another, the seven boys would require seven distinct girls opposite them. There are only five girls: a contradiction.",
      "worked": "Suppose no two boys sit opposite one another. Each of the seven boys must then sit opposite a girl. Different boys have different opposite chairs, so these must be seven distinct girls. This contradicts the fact that there are only five girls. Therefore, two boys sit opposite one another.",
      "solutionDiagrams": []
    },
