  "content": {
    "id": "p18-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A 50-cent piece has 12 equal sides and 12 equal angles. Calculate the size of each:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "exterior angle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^{\\circ}$",
          "worked": "$$\\begin{aligned}E&=\\frac{360^{\\circ}}{12}\\\\&=30^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "interior angle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$150^{\\circ}$",
          "worked": "$$\\begin{aligned}I&=180^{\\circ}-30^{\\circ}\\\\&=150^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
