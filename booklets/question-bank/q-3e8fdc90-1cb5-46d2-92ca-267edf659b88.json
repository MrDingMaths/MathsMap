  "content": {
    "id": "p31-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Calculate the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Increase $80$ by $10\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$88$",
          "worked": "$$\\begin{align*}10\\%\\text{ of }80 &= 80\\div10\\\\&=8\\\\\\text{New amount} &=80+8\\\\&=88\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Decrease $50$ by $60\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "$$\\begin{align*}50\\%\\text{ of }50 &=50\\div2=25\\\\10\\%\\text{ of }50 &=50\\div10=5\\\\60\\%\\text{ of }50 &=25+5=30\\\\\\text{New amount} &=50-30\\\\&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Increase $120$ by $20\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$144$",
          "worked": "$$\\begin{align*}20\\%\\text{ of }120 &=120\\div5\\\\&=24\\\\\\text{New amount} &=120+24\\\\&=144\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Decrease $80$ by $20\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64$",
          "worked": "$$\\begin{align*}20\\%\\text{ of }80 &=80\\div5\\\\&=16\\\\\\text{New amount} &=80-16\\\\&=64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Increase $240$ by $15\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$276$",
          "worked": "$$\\begin{align*}10\\%\\text{ of }240 &=240\\div10=24\\\\5\\%\\text{ of }240 &=24\\div2=12\\\\15\\%\\text{ of }240 &=24+12=36\\\\\\text{New amount} &=240+36\\\\&=276\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p31-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "Decrease $15$ by $10\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13.5$",
          "worked": "$$\\begin{align*}10\\%\\text{ of }15 &=15\\div10\\\\&=1.5\\\\\\text{New amount} &=15-1.5\\\\&=13.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
