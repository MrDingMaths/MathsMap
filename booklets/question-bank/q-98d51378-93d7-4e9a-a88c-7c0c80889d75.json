  "content": {
    "id": "p22-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Find a formula for $S_n$, and hence find $n$ for the given value of $S_n$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$5+10+20+\\cdots$ where $S_n=315$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=5(2^n-1)$; $n=6$.",
          "worked": "$a=5$, $r=2$.\n$$\\begin{aligned}S_n&=\\frac{a(r^n-1)}{r-1}\\\\S_n&=\\frac{5(2^n-1)}{2-1}\\\\S_n&=5(2^n-1)\\\\315&=5(2^n-1)\\\\63&=2^n-1\\\\2^n&=64\\\\2^n&=2^6\\\\n&=6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p22-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$5-10+20-\\cdots$ where $S_n=-425$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=\\dfrac{5(1-(-2)^n)}{3}$; $n=8$.",
          "worked": "$a=5$, $r=-2$.\n$$\\begin{aligned}S_n&=\\frac{a(1-r^n)}{1-r}\\\\S_n&=\\frac{5(1-(-2)^n)}{1-(-2)}\\\\S_n&=\\frac{5(1-(-2)^n)}{3}\\\\-425&=\\frac{5(1-(-2)^n)}{3}\\\\-1275&=5(1-(-2)^n)\\\\-255&=1-(-2)^n\\\\(-2)^n&=256\\\\n&=8\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p22-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$18+6+2+\\cdots$ where $S_n=26\\dfrac{8}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=27\\left(1-\\left(\\dfrac13\\right)^n\\right)$; $n=5$.",
          "worked": "$a=18$, $r=\\dfrac13$.\n$$\\begin{aligned}S_n&=\\frac{a(1-r^n)}{1-r}\\\\S_n&=\\frac{18\\left(1-\\left(\\frac13\\right)^n\\right)}{\\frac23}\\\\S_n&=27\\left(1-\\left(\\frac13\\right)^n\\right)\\\\26\\frac89&=27\\left(1-\\left(\\frac13\\right)^n\\right)\\\\\\frac{242}{9}&=27\\left(1-\\left(\\frac13\\right)^n\\right)\\\\\\frac{242}{243}&=1-\\left(\\frac13\\right)^n\\\\\\left(\\frac13\\right)^n&=\\frac1{243}\\\\\\left(\\frac13\\right)^n&=\\left(\\frac13\\right)^5\\\\n&=5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p22-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$48-24+12-\\cdots$ where $S_n=32\\dfrac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=32\\left(1-\\left(-\\dfrac12\\right)^n\\right)$; $n=7$.",
          "worked": "$a=48$, $r=-\\dfrac12$.\n$$\\begin{aligned}S_n&=\\frac{a(1-r^n)}{1-r}\\\\S_n&=\\frac{48\\left(1-\\left(-\\frac12\\right)^n\\right)}{\\frac32}\\\\S_n&=32\\left(1-\\left(-\\frac12\\right)^n\\right)\\\\32\\frac14&=32\\left(1-\\left(-\\frac12\\right)^n\\right)\\\\\\frac{129}{4}&=32\\left(1-\\left(-\\frac12\\right)^n\\right)\\\\\\frac{129}{128}&=1-\\left(-\\frac12\\right)^n\\\\\\left(-\\frac12\\right)^n&=-\\frac1{128}\\\\n&=7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
