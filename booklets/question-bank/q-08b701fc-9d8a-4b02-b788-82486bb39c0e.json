        "children": [],
        "answer": {
          "short": "$l=\\pi\\text{ cm},\\quad A=\\dfrac{5\\pi}{2}\\text{ cm}^2$",
          "worked": "$$\\begin{align*}l&=5\\times\\frac{\\pi}{5}\\\\l&=\\pi\\text{ cm}\\\\A&=\\frac12(5)^2\\times\\frac{\\pi}{5}\\\\A&=\\frac{5\\pi}{2}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38,
        "responseSpace": "scaffold"
