    "children": [
      {
        "id": "p10-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "How much water was in the container initially?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\text{ L}$",
          "worked": "$$\\begin{align*}V(0)&=\\frac{10-0}{2+0}\\\\V(0)&=5\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $V'(t)=-\\dfrac{12}{(2+t)^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V'(t)=\\dfrac{-(2+t)-(10-t)}{(2+t)^2}=-\\dfrac{12}{(2+t)^2}$.",
          "worked": "Using the quotient rule:\n$$\\begin{align*}V'(t)&=\\frac{-1(2+t)-(10-t)(1)}{(2+t)^2}\\\\V'(t)&=\\frac{-2-t-10+t}{(2+t)^2}\\\\V'(t)&=-\\frac{12}{(2+t)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p10-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why the container is always losing water.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V'(t)<0$ throughout the physical model, so the volume is decreasing.",
          "worked": "For $0\\le t\\le10$, $(2+t)^2>0$, so $V'(t)=-\\dfrac{12}{(2+t)^2}<0$. Therefore the container loses water throughout the model, until it is empty.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the rate at which $V$ is decreasing initially.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\text{ L/min}$",
          "worked": "$$\\begin{align*}V'(0)&=-\\frac{12}{(2+0)^2}\\\\V'(0)&=-3\\text{ L/min}\\end{align*}$$\nThe volume is decreasing at $3\\text{ L/min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p10-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the rate at which $V$ is decreasing when $t=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.75\\text{ L/min}$",
          "worked": "$$\\begin{align*}V'(2)&=-\\frac{12}{(2+2)^2}\\\\V'(2)&=-\\frac34\\text{ L/min}\\end{align*}$$\nThe volume is decreasing at $0.75\\text{ L/min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
