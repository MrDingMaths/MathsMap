    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x+1}{2}+\\frac{x+3}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x+11}{10}$",
          "worked": "$$\\begin{align*}\\frac{x+1}{2}+\\frac{x+3}{5}&=\\frac{5(x+1)}{10}+\\frac{2(x+3)}{10}\\\\&=\\frac{5(x+1)+2(x+3)}{10}\\\\&=\\frac{5x+5+2x+6}{10}\\\\&=\\frac{7x+11}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x+3}{3}+\\frac{x-4}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{12}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{3}+\\frac{x-4}{4}&=\\frac{4(x+3)}{12}+\\frac{3(x-4)}{12}\\\\&=\\frac{4(x+3)+3(x-4)}{12}\\\\&=\\frac{4x+12+3x-12}{12}\\\\&=\\frac{7x}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{a-2}{7}+\\frac{a-5}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15a-51}{56}$",
          "worked": "$$\\begin{align*}\\frac{a-2}{7}+\\frac{a-5}{8}&=\\frac{8(a-2)}{56}+\\frac{7(a-5)}{56}\\\\&=\\frac{8(a-2)+7(a-5)}{56}\\\\&=\\frac{8a-16+7a-35}{56}\\\\&=\\frac{15a-51}{56}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{y+4}{5}+\\frac{y-3}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11y+9}{30}$",
          "worked": "$$\\begin{align*}\\frac{y+4}{5}+\\frac{y-3}{6}&=\\frac{6(y+4)}{30}+\\frac{5(y-3)}{30}\\\\&=\\frac{6(y+4)+5(y-3)}{30}\\\\&=\\frac{6y+24+5y-15}{30}\\\\&=\\frac{11y+9}{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{m-4}{8}+\\frac{m+6}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13m+28}{40}$",
          "worked": "$$\\begin{align*}\\frac{m-4}{8}+\\frac{m+6}{5}&=\\frac{5(m-4)}{40}+\\frac{8(m+6)}{40}\\\\&=\\frac{5(m-4)+8(m+6)}{40}\\\\&=\\frac{5m-20+8m+48}{40}\\\\&=\\frac{13m+28}{40}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{x-2}{12}+\\frac{x-3}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x-13}{24}$",
          "worked": "$$\\begin{align*}\\frac{x-2}{12}+\\frac{x-3}{8}&=\\frac{2(x-2)}{24}+\\frac{3(x-3)}{24}\\\\&=\\frac{2(x-2)+3(x-3)}{24}\\\\&=\\frac{2x-4+3x-9}{24}\\\\&=\\frac{5x-13}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{y+4}{5}-\\frac{y-3}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y+41}{30}$",
          "worked": "$$\\begin{align*}\\frac{y+4}{5}-\\frac{y-3}{6}&=\\frac{6(y+4)}{30}-\\frac{5(y-3)}{30}\\\\&=\\frac{6(y+4)-5(y-3)}{30}\\\\&=\\frac{6y+24-5y+15}{30}\\\\&=\\frac{y+41}{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{m-4}{8}-\\frac{m+6}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-3m-68}{40}$",
          "worked": "$$\\begin{align*}\\frac{m-4}{8}-\\frac{m+6}{5}&=\\frac{5(m-4)}{40}-\\frac{8(m+6)}{40}\\\\&=\\frac{5(m-4)-8(m+6)}{40}\\\\&=\\frac{5m-20-8m-48}{40}\\\\&=\\frac{-3m-68}{40}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{x-2}{12}-\\frac{x-3}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-x+5}{24}$",
          "worked": "$$\\begin{align*}\\frac{x-2}{12}-\\frac{x-3}{8}&=\\frac{2(x-2)}{24}-\\frac{3(x-3)}{24}\\\\&=\\frac{2(x-2)-3(x-3)}{24}\\\\&=\\frac{2x-4-3x+9}{24}\\\\&=\\frac{-x+5}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{2b-3}{6}+\\frac{b+2}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11b-6}{24}$",
          "worked": "$$\\begin{align*}\\frac{2b-3}{6}+\\frac{b+2}{8}&=\\frac{4(2b-3)}{24}+\\frac{3(b+2)}{24}\\\\&=\\frac{4(2b-3)+3(b+2)}{24}\\\\&=\\frac{8b-12+3b+6}{24}\\\\&=\\frac{11b-6}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{3x+8}{6}+\\frac{2x-4}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{6}$",
          "worked": "$$\\begin{align*}\\frac{3x+8}{6}+\\frac{2x-4}{3}&=\\frac{3x+8}{6}+\\frac{2(2x-4)}{6}\\\\&=\\frac{3x+8+2(2x-4)}{6}\\\\&=\\frac{3x+8+4x-8}{6}\\\\&=\\frac{7x}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{2y-5}{7}+\\frac{3y+2}{14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7y-8}{14}$",
          "worked": "$$\\begin{align*}\\frac{2y-5}{7}+\\frac{3y+2}{14}&=\\frac{2(2y-5)}{14}+\\frac{3y+2}{14}\\\\&=\\frac{2(2y-5)+3y+2}{14}\\\\&=\\frac{4y-10+3y+2}{14}\\\\&=\\frac{7y-8}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac{2t-1}{8}+\\frac{t-2}{16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5t-4}{16}$",
          "worked": "$$\\begin{align*}\\frac{2t-1}{8}+\\frac{t-2}{16}&=\\frac{2(2t-1)}{16}+\\frac{t-2}{16}\\\\&=\\frac{2(2t-1)+t-2}{16}\\\\&=\\frac{4t-2+t-2}{16}\\\\&=\\frac{5t-4}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{2x+1}{2}-\\frac{x-2}{3}$",
        "layout": "list",
        "columns": null,
