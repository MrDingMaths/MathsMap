        "children": [],
        "answer": {
          "short": "$\\frac{4x+7}{6}$",
          "worked": "$$\\begin{align*}\\frac{2x+1}{2}-\\frac{x-2}{3}&=\\frac{3(2x+1)}{6}-\\frac{2(x-2)}{6}\\\\&=\\frac{3(2x+1)-2(x-2)}{6}\\\\&=\\frac{6x+3-2x+4}{6}\\\\&=\\frac{4x+7}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
