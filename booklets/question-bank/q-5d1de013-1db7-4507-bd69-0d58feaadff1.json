        "children": [],
        "answer": {
          "short": "$\\frac{5x+2}{10}$",
          "worked": "$$\\begin{align*}\\frac{3x+1}{10}+\\frac{2x+1}{10}&=\\frac{3x+1+2x+1}{10}\\\\&=\\frac{5x+2}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q3-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\frac{5x+3}{10}+\\frac{2x-2}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x-1}{5}$",
          "worked": "$$\\begin{align*}\\frac{5x+3}{10}+\\frac{2x-2}{4}&=\\frac{2(5x+3)}{20}+\\frac{5(2x-2)}{20}\\\\&=\\frac{2(5x+3)+5(2x-2)}{20}\\\\&=\\frac{10x+6+10x-10}{20}\\\\&=\\frac{20x-4}{20}\\\\&=\\frac{5x-1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p10-q3-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\frac{4-x}{3}+\\frac{2-x}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{34-10x}{21}$",
          "worked": "$$\\begin{align*}\\frac{4-x}{3}+\\frac{2-x}{7}&=\\frac{7(4-x)}{21}+\\frac{3(2-x)}{21}\\\\&=\\frac{7(4-x)+3(2-x)}{21}\\\\&=\\frac{28-7x+6-3x}{21}\\\\&=\\frac{34-10x}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q3-r",
        "type": "part",
        "label": "r",
        "prompt": "$\\frac{3-x}{14}-\\frac{x-1}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5-3x}{14}$",
          "worked": "$$\\begin{align*}\\frac{3-x}{14}-\\frac{x-1}{7}&=\\frac{3-x}{14}-\\frac{2(x-1)}{14}\\\\&=\\frac{3-x-2(x-1)}{14}\\\\&=\\frac{3-x-2x+2}{14}\\\\&=\\frac{5-3x}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
