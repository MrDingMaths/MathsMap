  "content": {
    "id": "p40-q6",
    "type": "question",
    "label": "6",
    "prompt": "This dot plot shows the frequency of households with $0$, $1$, $2$ or $3$ pets.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p40-q6-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 40 p40-q6-diagram\"}\n\\begin{tikzpicture}[x=7mm,y=7mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-1.35,-0.85) rectangle (4.35,7.35);\n\\draw[black,line width=0.5pt,<->,>=latex] (-1.25,0) -- (4.25,0);\n\\foreach \\x in {0,1,2,3} {\n  \\draw[black,line width=0.4pt] (\\x,0) -- (\\x,-0.22);\n}\n\\node[below=2pt,font=\\fontsize{8.5}{10}\\selectfont,text=black] at (0,-0.22) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$0$\\special{dvisvgm:raw </g>}};\n\\node[below=2pt,font=\\fontsize{8.5}{10}\\selectfont,text=black] at (1,-0.22) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\node[below=2pt,font=\\fontsize{8.5}{10}\\selectfont,text=black] at (2,-0.22) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\node[below=2pt,font=\\fontsize{8.5}{10}\\selectfont,text=black] at (3,-0.22) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\foreach \\y in {1,2,3} {\\fill[black] (0,\\y) circle[radius=0.68mm];}\n\\foreach \\y in {1,2,3,4,5,6,7} {\\fill[black] (1,\\y) circle[radius=0.68mm];}\n\\foreach \\y in {1,2,3,4} {\\fill[black] (2,\\y) circle[radius=0.68mm];}\n\\fill[black] (3,1) circle[radius=0.68mm];\n\\end{tikzpicture}",
