    "children": [
      {
        "id": "p40-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How many households were surveyed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$ households.",
          "worked": "$$3+7+4+1=15$$\n$15$ households were surveyed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p40-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the mean number of pets correct to $1$ decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.2$ pets.",
          "worked": "$$\\begin{align*}\\bar{x}&=\\frac{(3\\times0)+(7\\times1)+(4\\times2)+(1\\times3)}{15}\\\\\\bar{x}&=\\frac{18}{15}\\\\\\bar{x}&=1.2\\end{align*}$$\nThe mean is $1.2$ pets, correct to $1$ decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the median number of pets.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$ pet.",
          "worked": "$$\\begin{align*}\\text{Middle position}&=\\frac{15+1}{2}\\\\\\text{Middle position}&=8\\end{align*}$$\nThe 4th to 10th values are all $1$, so the 8th value is $1$.\nThe median is $1$ pet.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p40-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Identify the mode.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$ pet.",
          "worked": "$1$ pet occurs most frequently, with $7$ households. The mode is $1$ pet.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p40-q6-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p40-q6-e-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Another household with ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "7",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " pets is added to the list.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Does this change the median?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; the 8th and 9th values are both $1$, so the median remains $1$ pet.",
          "worked": "Adding $7$ at the end of the ordered data gives $16$ values. The middle values are the 8th and 9th; both are $1$.\n$$\\begin{align*}\\text{New median}&=\\frac{1+1}{2}\\\\\\text{New median}&=1\\end{align*}$$\nNo; the median remains $1$ pet.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
