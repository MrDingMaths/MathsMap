  "content": {
    "id": "p37-ex3f-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider the parabola $y=x^2-2x-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-ex3f-q1-a",
        "type": "group",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p37-ex3f-q1-ai",
            "type": "part",
            "label": "i",
            "prompt": "Use the value of $a$ to determine the concavity of the parabola.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Concave up.",
              "worked": "$a=1>0$, so the parabola is concave up.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p37-ex3f-q1-aii",
            "type": "part",
            "label": "ii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p37-ex3f-q1-aii-prompt",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Write down the value of the ",
                      "marks": []
                    },
                    {
                      "type": "math",
                      "latex": "y",
                      "display": false
                    },
                    {
                      "type": "text",
                      "text": "-intercept. ",
                      "marks": []
                    },
                    {
                      "type": "cloze",
                      "answer": "$-1$",
                      "width": 13
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-1$",
              "worked": "At $x=0$, $y=0^2-2(0)-1=-1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0,
            "responseSpace": "scaffold"
          },
          {
            "id": "p37-ex3f-q1-aiii",
            "type": "part",
            "label": "iii",
            "prompt": "Use the formula $x=-\\frac{b}{2a}$ to find the axis of symmetry.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=1$",
              "worked": "$$\\begin{align*}x&=-\\frac{-2}{2(1)}\\\\x&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p37-ex3f-q1-aiv",
            "type": "part",
            "label": "iv",
            "prompt": "Use the axis of symmetry to find the $y$-coordinate of the vertex.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-2$; vertex $(1,-2)$.",
              "worked": "At $x=1$,\n\n$$\\begin{align*}y&=1^2-2(1)-1\\\\y&=-2\\end{align*}$$\n\nThe vertex is $(1,-2)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p37-ex3f-q1-av",
            "type": "part",
            "label": "v",
            "prompt": "Calculate the discriminant $\\Delta=b^2-4ac$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\Delta=8$",
              "worked": "$$\\begin{align*}\\Delta&=(-2)^2-4(1)(-1)\\\\\\Delta&=8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p37-ex3f-q1-avi",
            "type": "part",
            "label": "vi",
            "prompt": "Explain why this parabola must have $x$-intercepts.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\Delta=8>0$, so there are two distinct real zeroes.",
              "worked": "Since $\\Delta=8>0$, the quadratic formula gives two distinct real zeroes. Therefore the graph has two $x$-intercepts.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p37-ex3f-q1-avii",
            "type": "part",
            "label": "vii",
            "prompt": "Find the $x$-intercepts using the quadratic formula $x=\\frac{-b+\\sqrt{\\Delta}}{2a}$ or $\\frac{-b-\\sqrt{\\Delta}}{2a}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(1-\\sqrt2,0)$ and $(1+\\sqrt2,0)$.",
              "worked": "$$\\begin{align*}x&=\\frac{2\\pm\\sqrt8}{2}\\\\x&=\\frac{2\\pm2\\sqrt2}{2}\\\\x&=1\\pm\\sqrt2\\end{align*}$$\n\nThe intercepts are $(1-\\sqrt2,0)$ and $(1+\\sqrt2,0)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      },
      {
        "id": "p37-ex3f-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Sketch the parabola, showing these features.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave up, with vertex $(1,-2)$, axis $x=1$, $y$-intercept $(0,-1)$ and $x$-intercepts $(1\\pm\\sqrt2,0)$.",
          "worked": "Plot the vertex $(1,-2)$ and the intercepts $(0,-1)$, $(1-\\sqrt2,0)$ and $(1+\\sqrt2,0)$. Draw a smooth upward-opening parabola symmetric about $x=1$.",
