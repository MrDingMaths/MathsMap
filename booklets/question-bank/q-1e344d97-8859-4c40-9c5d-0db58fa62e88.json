  "content": {
    "id": "p18-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Determine, by substitution, whether or not the given point lies on the given line.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3,1)\\qquad y=x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Substitute $x=3$ and $y=1$.\n$$\\begin{align*}\\text{LHS}&=1\\\\\\text{RHS}&=3-2\\\\\\text{RHS}&=1\\end{align*}$$\nThe two sides are equal, so $(3,1)$ lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$(7,4)\\qquad y=20-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Substitute $x=7$ and $y=4$.\n$$\\begin{align*}\\text{LHS}&=4\\\\\\text{RHS}&=20-2(7)\\\\\\text{RHS}&=6\\end{align*}$$\nSince $4\\ne6$, $(7,4)$ does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1,-2)\\qquad y=-3x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Substitute $x=1$ and $y=-2$.\n$$\\begin{align*}\\text{LHS}&=-2\\\\\\text{RHS}&=-3(1)+1\\\\\\text{RHS}&=-2\\end{align*}$$\nThe two sides are equal, so $(1,-2)$ lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$(-5,3)\\qquad 2x+3y+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Substitute $x=-5$ and $y=3$.\n$$\\begin{align*}2x+3y+1&=2(-5)+3(3)+1\\\\2x+3y+1&=-10+9+1\\\\2x+3y+1&=0\\end{align*}$$\nThe equation is satisfied, so $(-5,3)$ lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-1,-4)\\qquad 3x-2y-5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Substitute $x=-1$ and $y=-4$.\n$$\\begin{align*}3x-2y-5&=3(-1)-2(-4)-5\\\\3x-2y-5&=-3+8-5\\\\3x-2y-5&=0\\end{align*}$$\nThe equation is satisfied, so $(-1,-4)$ lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-6,-4)\\qquad 4x-5y-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Substitute $x=-6$ and $y=-4$.\n$$\\begin{align*}4x-5y-4&=4(-6)-5(-4)-4\\\\4x-5y-4&=-24+20-4\\\\4x-5y-4&=-8\\end{align*}$$\nSince $-8\\ne0$, $(-6,-4)$ does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
