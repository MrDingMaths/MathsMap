  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "By first expanding and/or simplifying, find $\\frac{dy}{dx}$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+2$",
          "worked": "$$y=x^2+2x+1.$$ $$\\frac{dy}{dx}=2x+2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+1$",
          "worked": "$$y=x^2+x.$$ $$\\frac{dy}{dx}=2x+1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p11-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{x^2+1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-\\frac{1}{x^2}$",
          "worked": "For $x\\ne0$, $$y=x+x^{-1}.$$ $$\\begin{align*}\\frac{dy}{dx}&=1-x^{-2}\\\\\\frac{dy}{dx}&=1-\\frac{1}{x^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{x^2-5x+6}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$ for $x\\ne2$",
          "worked": "For $x\\ne2$, $$\\begin{align*}y&=\\frac{(x-2)(x-3)}{x-2}\\\\y&=x-3.\\end{align*}$$ Hence $\\frac{dy}{dx}=1$ for $x\\ne2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\left(x+\\frac1x\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x-\\frac{2}{x^3}$",
          "worked": "For $x\\ne0$, $$\\begin{align*}y&=x^2+2x\\cdot x^{-1}+x^{-2}\\\\y&=x^2+2+x^{-2}.\\end{align*}$$ $$\\begin{align*}\\frac{dy}{dx}&=2x-2x^{-3}\\\\\\frac{dy}{dx}&=2x-\\frac{2}{x^3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
