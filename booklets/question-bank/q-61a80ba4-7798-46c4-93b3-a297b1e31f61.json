  "content": {
    "id": "p21-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A triangle has base $\\frac{2x}{3}$ cm and height $\\frac{x}{4}$ cm.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the area of the triangle in terms of $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{12}\\text{ cm}^2$",
          "worked": "Area is half the base multiplied by the height.\n\n$$\\begin{align*}A&=\\frac12\\times\\frac{2x}{3}\\times\\frac{x}{4}\\\\A&=\\frac{2x^2}{24}\\\\A&=\\frac{x^2}{12}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area if $x=24$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{24^2}{12}\\\\A&=\\frac{576}{12}\\\\A&=48\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
