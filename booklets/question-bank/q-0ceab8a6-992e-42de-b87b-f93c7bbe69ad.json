            "inlines": [
              {
                "type": "math",
                "latex": "\\binom{n}{k}+\\binom{n}{k-1}=\\frac{(n+1)!}{k!(n-k+1)!}=\\binom{n+1}{k}",
                "display": false
              }
            ]
          },
          {
            "id": "p39-q10-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Write both terms in factorial form and combine over the denominator ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k!(n-k+1)!",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\binom{n}{k}+\\binom{n}{k-1}&=\\frac{n!}{k!(n-k)!}+\\frac{n!}{(k-1)!(n-k+1)!}\\\\\\binom{n}{k}+\\binom{n}{k-1}&=\\frac{n!(n-k+1)}{k!(n-k+1)!}+\\frac{n!k}{k!(n-k+1)!}\\\\\\binom{n}{k}+\\binom{n}{k-1}&=\\frac{n![(n-k+1)+k]}{k!(n-k+1)!}\\\\\\binom{n}{k}+\\binom{n}{k-1}&=\\frac{n!(n+1)}{k!(n-k+1)!}\\\\\\binom{n}{k}+\\binom{n}{k-1}&=\\frac{(n+1)!}{k!(n+1-k)!}\\\\\\binom{n}{k}+\\binom{n}{k-1}&=\\binom{n+1}{k}\\end{align*}$$",
      "solutionDiagrams": []
