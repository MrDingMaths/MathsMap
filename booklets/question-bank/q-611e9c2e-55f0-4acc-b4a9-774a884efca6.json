    "children": [
      {
        "id": "p21-question-39-49-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_7(2)-\\log_7(98)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_7(2)-\\log_7(98)&=\\log_7\\left(\\frac{2}{98}\\right)\\\\\\log_7(2)-\\log_7(98)&=\\log_7(7^{-2})\\\\\\log_7(2)-\\log_7(98)&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-39-49-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}(5)+\\log_{10}(4)-\\log_{10}(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_{10}(5)+\\log_{10}(4)-\\log_{10}(2)&=\\log_{10}\\left(\\frac{5\\times4}{2}\\right)\\\\\\log_{10}(5)+\\log_{10}(4)-\\log_{10}(2)&=\\log_{10}(10)\\\\\\log_{10}(5)+\\log_{10}(4)-\\log_{10}(2)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-39-49-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{12}(2)-\\log_{12}(4)-\\log_{12}(6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\log_{12}(2)-\\log_{12}(4)-\\log_{12}(6)&=\\log_{12}\\left(\\frac{2}{4\\times6}\\right)\\\\\\log_{12}(2)-\\log_{12}(4)-\\log_{12}(6)&=\\log_{12}(12^{-1})\\\\\\log_{12}(2)-\\log_{12}(4)-\\log_{12}(6)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-39-49-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{25}(9)\\,\\log_{27}(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p21-item-42-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac13",
                    "display": false
                  }
                ]
              },
              {
                "id": "p21-item-42-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Change both logarithms to a common base and cancel.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\log_{25}(9)\\,\\log_{27}(5)&=\\frac{\\ln(9)}{\\ln(25)}\\times\\frac{\\ln(5)}{\\ln(27)}\\\\\\log_{25}(9)\\,\\log_{27}(5)&=\\frac{2\\ln(3)}{2\\ln(5)}\\times\\frac{\\ln(5)}{3\\ln(3)}\\\\\\log_{25}(9)\\,\\log_{27}(5)&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-question-39-49-part-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{12}(9)+\\log_{12}(2)+\\log_{12}(8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{12}(9)+\\log_{12}(2)+\\log_{12}(8)&=\\log_{12}(9\\times2\\times8)\\\\\\log_{12}(9)+\\log_{12}(2)+\\log_{12}(8)&=\\log_{12}(12^2)\\\\\\log_{12}(9)+\\log_{12}(2)+\\log_{12}(8)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-39-49-part-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_2(25)\\,\\log_5(8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p21-item-44-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "6",
                    "display": false
                  }
                ]
              },
              {
                "id": "p21-item-44-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Change both logarithms to a common base and use the power law.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\log_2(25)\\,\\log_5(8)&=\\frac{\\ln(25)}{\\ln(2)}\\times\\frac{\\ln(8)}{\\ln(5)}\\\\\\log_2(25)\\,\\log_5(8)&=\\frac{2\\ln(5)}{\\ln(2)}\\times\\frac{3\\ln(2)}{\\ln(5)}\\\\\\log_2(25)\\,\\log_5(8)&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-question-39-49-part-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_{10}(2)+\\log_{10}(4)+\\log_{10}(125)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\log_{10}(2)+\\log_{10}(4)+\\log_{10}(125)&=\\log_{10}(2\\times4\\times125)\\\\\\log_{10}(2)+\\log_{10}(4)+\\log_{10}(125)&=\\log_{10}(10^3)\\\\\\log_{10}(2)+\\log_{10}(4)+\\log_{10}(125)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-39-49-part-h",
        "type": "part",
        "label": "h",
        "prompt": "$2\\log_{10}(5)+\\frac13\\log_{10}(64)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}2\\log_{10}(5)+\\frac13\\log_{10}(64)&=\\log_{10}(5^2\\times64^{1/3})\\\\2\\log_{10}(5)+\\frac13\\log_{10}(64)&=\\log_{10}(100)\\\\2\\log_{10}(5)+\\frac13\\log_{10}(64)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-question-39-49-part-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\log_{21}(9)+\\log_{21}(49)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{21}(9)+\\log_{21}(49)&=\\log_{21}(9\\times49)\\\\\\log_{21}(9)+\\log_{21}(49)&=\\log_{21}(21^2)\\\\\\log_{21}(9)+\\log_{21}(49)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-39-49-part-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\log_2 70-\\log_2 5-\\log_2 7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_2 70-\\log_2 5-\\log_2 7&=\\log_2\\left(\\frac{70}{5\\times7}\\right)\\\\\\log_2 70-\\log_2 5-\\log_2 7&=\\log_2(2)\\\\\\log_2 70-\\log_2 5-\\log_2 7&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-39-49-part-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\log_6(2)+\\log_6(3)+\\log_6(4)+\\log_6(9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\log_6(2)+\\log_6(3)+\\log_6(4)+\\log_6(9)&=\\log_6(2\\times3\\times4\\times9)\\\\\\log_6(2)+\\log_6(3)+\\log_6(4)+\\log_6(9)&=\\log_6(6^3)\\\\\\log_6(2)+\\log_6(3)+\\log_6(4)+\\log_6(9)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
