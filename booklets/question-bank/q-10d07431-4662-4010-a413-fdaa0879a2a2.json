  "content": {
    "id": "p19-g-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the equation of the line passing through the given point with the given gradient. Write your answers in standard form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-g-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2,1)$ with gradient $3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x-y=5$",
          "worked": "$$\\begin{align*}y-1&=3(x-2)\\\\y-1&=3x-6\\\\3x-y&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-g-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-1,2)$ with gradient $2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y-2x=4$",
          "worked": "$$\\begin{align*}y-2&=2(x+1)\\\\y-2&=2x+2\\\\y-2x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-g-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3,-4)$ with gradient $-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y+2x=2$",
          "worked": "$$\\begin{align*}y+4&=-2(x-3)\\\\y+4&=-2x+6\\\\y+2x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-g-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2,-3)$ with gradient $\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2y=8$",
          "worked": "$$\\begin{align*}y+3&=\\frac12(x-2)\\\\2(y+3)&=x-2\\\\2y+6&=x-2\\\\x-2y&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-g-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(3,-1)$ with gradient $-\\frac34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+4y=5$",
          "worked": "$$\\begin{align*}y+1&=-\\frac34(x-3)\\\\4(y+1)&=-3(x-3)\\\\4y+4&=-3x+9\\\\3x+4y&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-g-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac12,\\frac12\\right)$ with gradient $\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4y-2x=1$",
          "worked": "$$\\begin{align*}y-\\frac12&=\\frac12\\left(x-\\frac12\\right)\\\\4\\left(y-\\frac12\\right)&=2\\left(x-\\frac12\\right)\\\\4y-2&=2x-1\\\\4y-2x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p19-g-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(\\frac23,\\frac34\\right)$ with gradient $\\frac45$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-48x+60y=13$",
          "worked": "$$\\begin{align*}y-\\frac34&=\\frac45\\left(x-\\frac23\\right)\\\\60\\left(y-\\frac34\\right)&=48\\left(x-\\frac23\\right)\\\\60y-45&=48x-32\\\\-48x+60y&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
