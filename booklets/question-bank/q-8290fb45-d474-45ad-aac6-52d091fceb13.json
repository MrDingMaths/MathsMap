                  "type": "text",
                  "text": "Try to find the coordinates of the points of intersection of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y=\\frac{1}{x}",
                  "display": false
                },
                {
                  "type": "text",
