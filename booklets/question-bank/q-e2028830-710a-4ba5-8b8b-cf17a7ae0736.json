    "answer": {
      "short": "$\\$26\\,500$",
      "worked": "$$\\begin{align*}\\text{Amount over }\\$800\\,000 &= 1\\,500\\,000-800\\,000\\\\&=\\$700\\,000\\\\\\text{Commission} &= 0.02\\times800\\,000+0.015\\times700\\,000\\\\&=\\$26\\,500\\end{align*}$$",
