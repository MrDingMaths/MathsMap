  "content": {
    "id": "p35-q29-root",
    "type": "question",
    "label": "29",
    "prompt": "A deck has 10 colours, each with 6 cards (total 60 cards). A 5-card hand is dealt uniformly at random without replacement. Find the probability that",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q29-a",
        "type": "part",
        "label": "a",
        "prompt": "all five cards have the same colour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\binom{10}{1}\\binom65}{\\binom{60}{5}}=\\dfrac5{455126}$",
          "worked": "Choose the colour, then choose five of its six cards. There are $\\binom{60}{5}$ equally likely hands.\n$$\\begin{align*}P(\\text{same colour})&=\\frac{\\binom{10}{1}\\binom65}{\\binom{60}{5}}\\\\P(\\text{same colour})&=\\frac{10\\times6}{5461512}\\\\P(\\text{same colour})&=\\frac5{455126}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p35-q29-b",
        "type": "part",
        "label": "b",
        "prompt": "all five cards have distinct colours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\binom{10}{5}6^5}{\\binom{60}{5}}=\\dfrac{11664}{32509}$",
          "worked": "Choose five colours, then choose one of the six cards from each colour.\n$$\\begin{align*}P(\\text{distinct colours})&=\\frac{\\binom{10}{5}\\binom61^5}{\\binom{60}{5}}\\\\P(\\text{distinct colours})&=\\frac{252\\times6^5}{5461512}\\\\P(\\text{distinct colours})&=\\frac{11664}{32509}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p35-q29-c",
        "type": "part",
        "label": "c",
        "prompt": "three cards are the same colour and the other two are different colours (and different from the first colour).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q29-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\dfrac{\\binom{10}{1}\\binom63\\binom92\\,6^2}{\\binom{60}{5}}=\\dfrac{10800}{227563}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p35-q29-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Choose the triple colour, then two different remaining colours and their cards.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Choose the triple colour in $\\binom{10}{1}$ ways and its three cards in $\\binom63$ ways. Choose two different colours from the remaining nine, then one card from each.\n$$\\begin{align*}P(\\text{colour pattern }3,1,1)&=\\frac{\\binom{10}{1}\\binom63\\binom92\\binom61^2}{\\binom{60}{5}}\\\\P(\\text{colour pattern }3,1,1)&=\\frac{10\\times20\\times36\\times6^2}{5461512}\\\\P(\\text{colour pattern }3,1,1)&=\\frac{10800}{227563}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
  },
