        "label": "a",
        "prompt": "A number $a$ has 5 added to it, and the result is 21.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+5=21$, $a=16$.",
          "worked": "$$\\begin{align*}a+5&=21\\\\a&=21-5\\\\a&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p9-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "A number $x$ is multiplied by 7, and the result is 35.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7x=35$, $x=5$.",
          "worked": "$$\\begin{align*}7x&=35\\\\x&=\\frac{35}{7}\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p9-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "A number $z$ is multiplied by 5, and the result is 37.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
