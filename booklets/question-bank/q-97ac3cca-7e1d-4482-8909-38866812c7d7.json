        "answer": {
          "short": "$5z=37$, $z=7\\frac{2}{5}$.",
          "worked": "$$\\begin{align*}5z&=37\\\\z&=\\frac{37}{5}\\\\z&=7\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p9-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "A number $m$ is multiplied by 5, and then 3 is added. The result is 50.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5m+3=50$, $m=9\\frac{2}{5}$.",
          "worked": "$$\\begin{align*}5m+3&=50\\\\5m&=50-3\\\\5m&=47\\\\m&=\\frac{47}{5}\\\\m&=9\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
