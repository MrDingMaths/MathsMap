          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "On a test track, the skid-mark length ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x",
              "display": false
            },
            {
              "type": "text",
              "text": " (in m) left by a car braking to a stop is modelled by a power law in the car’s initial speed ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y",
              "display": false
            },
            {
              "type": "text",
              "text": " (in ",
