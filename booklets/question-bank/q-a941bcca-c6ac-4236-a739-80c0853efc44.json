    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p98-q28-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the power $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p98-q28-a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "n=2",
                    "display": false
                  }
                ]
              },
              {
                "id": "p98-q28-a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Divide the observation equations to obtain ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\left(\\frac32\\right)^n=\\frac94",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}8&=k\\times40^n\\\\18&=k\\times60^n\\end{align*}$$\n\nDivide the second equation by the first to eliminate $k$.\n\n$$\\begin{align*}\\frac{18}{8}&=\\frac{k\\times60^n}{k\\times40^n}\\\\\\frac94&=\\left(\\frac32\\right)^n\\\\\\left(\\frac32\\right)^2&=\\left(\\frac32\\right)^n\\\\n&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p98-q28-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the constant $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\frac{1}{200}$",
          "worked": "$$\\begin{align*}8&=k\\times40^2\\\\k&=\\frac{8}{1600}\\\\k&=\\frac{1}{200}\\end{align*}$$\n\nThis value uses $x$ in metres and $y$ in $\\mathrm{km}\\,\\mathrm{h}^{-1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p98-q28-c",
        "type": "part",
        "label": "c",
        "prompt": "Predict the skid length when $y=80\\,\\mathrm{km}\\,\\mathrm{h}^{-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32\\,\\mathrm{m}$",
          "worked": "$$\\begin{align*}x&=\\frac{1}{200}\\times80^2\\\\x&=32\\,\\mathrm{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p98-q28-d",
        "type": "part",
        "label": "d",
        "prompt": "If the speed is doubled from $40\\,\\mathrm{km}\\,\\mathrm{h}^{-1}$ to $80\\,\\mathrm{km}\\,\\mathrm{h}^{-1}$, does this model predict that $x$ is exactly quadrupled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p98-q28-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Yes.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p98-q28-d-short-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " varies directly with ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y^2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " so doubling ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " multiplies ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " by ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "4",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The speed is multiplied by $\\frac{80}{40}=2$. Since $x=ky^2$, the skid length is multiplied by $2^2=4$.\n\nYes: the model predicts an increase from $8\\,\\mathrm{m}$ to $32\\,\\mathrm{m}$, exactly four times the original skid length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
