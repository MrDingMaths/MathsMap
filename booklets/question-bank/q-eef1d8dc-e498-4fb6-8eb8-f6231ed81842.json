  "content": {
    "id": "p21-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Find $f(x)$ if",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x+2)=x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x+3$",
          "worked": "Let $u=x+2$, so $x=u-2$.\n$$\\begin{align*}f(u)&=(u-2)+5\\\\f(u)&=u+3.\\end{align*}$$\nHence $f(x)=x+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p21-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x-1)=x^2-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x^2+2x$",
          "worked": "Let $u=x-1$, so $x=u+1$.\n$$\\begin{align*}f(u)&=(u+1)^2-1\\\\f(u)&=u^2+2u+1-1\\\\f(u)&=u^2+2u.\\end{align*}$$\nHence $f(x)=x^2+2x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p21-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(2x)=4x^2-4x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x^2-2x+1$",
          "worked": "Let $u=2x$, so $x=\\dfrac{u}{2}$.\n$$\\begin{align*}f(u)&=4\\left(\\frac{u}{2}\\right)^2-4\\left(\\frac{u}{2}\\right)+1\\\\f(u)&=u^2-2u+1.\\end{align*}$$\nHence $f(x)=x^2-2x+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
