          "inlines": [
            {
              "type": "text",
              "text": "Emily buys 6 mugs for $17.10. She sells each mug for $3.55. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Work out her percentage profit. Give your answer to 2 decimal places.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$24.56\\%$ profit",
      "worked": "$$\\begin{align*}\\text{Selling price}&=6\\times\\$3.55\\\\\\text{Selling price}&=\\$21.30\\\\\\text{Profit}&=\\$21.30-\\$17.10\\\\\\text{Profit}&=\\$4.20\\\\\\text{Percentage profit}&=\\frac{4.20}{17.10}\\times100\\%\\\\\\text{Percentage profit}&\\approx24.56\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
