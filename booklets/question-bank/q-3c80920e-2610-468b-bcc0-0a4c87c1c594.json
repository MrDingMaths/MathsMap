    "children": [
      {
        "id": "p16-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt{3}-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{3}+1}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{3}-1}&=\\frac{1}{\\sqrt{3}-1}\\times\\frac{\\sqrt{3}+1}{\\sqrt{3}+1}\\\\\\frac{1}{\\sqrt{3}-1}&=\\frac{\\sqrt{3}+1}{3-1}\\\\\\frac{1}{\\sqrt{3}-1}&=\\frac{\\sqrt{3}+1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{\\sqrt{7}+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{7}-2}{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{7}+2}&=\\frac{1}{\\sqrt{7}+2}\\times\\frac{\\sqrt{7}-2}{\\sqrt{7}-2}\\\\\\frac{1}{\\sqrt{7}+2}&=\\frac{\\sqrt{7}-2}{7-4}\\\\\\frac{1}{\\sqrt{7}+2}&=\\frac{\\sqrt{7}-2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{3+\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3-\\sqrt{5}}{4}$",
          "worked": "$$\\begin{align*}\\frac{1}{3+\\sqrt{5}}&=\\frac{1}{3+\\sqrt{5}}\\times\\frac{3-\\sqrt{5}}{3-\\sqrt{5}}\\\\\\frac{1}{3+\\sqrt{5}}&=\\frac{3-\\sqrt{5}}{9-5}\\\\\\frac{1}{3+\\sqrt{5}}&=\\frac{3-\\sqrt{5}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{4-\\sqrt{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4+\\sqrt{7}}{9}$",
          "worked": "$$\\begin{align*}\\frac{1}{4-\\sqrt{7}}&=\\frac{1}{4-\\sqrt{7}}\\times\\frac{4+\\sqrt{7}}{4+\\sqrt{7}}\\\\\\frac{1}{4-\\sqrt{7}}&=\\frac{4+\\sqrt{7}}{16-7}\\\\\\frac{1}{4-\\sqrt{7}}&=\\frac{4+\\sqrt{7}}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{\\sqrt{5}-\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{5}+\\sqrt{2}}{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{5}-\\sqrt{2}}&=\\frac{1}{\\sqrt{5}-\\sqrt{2}}\\times\\frac{\\sqrt{5}+\\sqrt{2}}{\\sqrt{5}+\\sqrt{2}}\\\\\\frac{1}{\\sqrt{5}-\\sqrt{2}}&=\\frac{\\sqrt{5}+\\sqrt{2}}{5-2}\\\\\\frac{1}{\\sqrt{5}-\\sqrt{2}}&=\\frac{\\sqrt{5}+\\sqrt{2}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1}{\\sqrt{10}+\\sqrt{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{10}-\\sqrt{6}}{4}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{10}+\\sqrt{6}}&=\\frac{1}{\\sqrt{10}+\\sqrt{6}}\\times\\frac{\\sqrt{10}-\\sqrt{6}}{\\sqrt{10}-\\sqrt{6}}\\\\\\frac{1}{\\sqrt{10}+\\sqrt{6}}&=\\frac{\\sqrt{10}-\\sqrt{6}}{10-6}\\\\\\frac{1}{\\sqrt{10}+\\sqrt{6}}&=\\frac{\\sqrt{10}-\\sqrt{6}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{1}{2\\sqrt{3}+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2\\sqrt{3}-1}{11}$",
          "worked": "$$\\begin{align*}\\frac{1}{2\\sqrt{3}+1}&=\\frac{1}{2\\sqrt{3}+1}\\times\\frac{2\\sqrt{3}-1}{2\\sqrt{3}-1}\\\\\\frac{1}{2\\sqrt{3}+1}&=\\frac{2\\sqrt{3}-1}{2^2\\times3-1^2}\\\\\\frac{1}{2\\sqrt{3}+1}&=\\frac{2\\sqrt{3}-1}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{1}{5-3\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5+3\\sqrt{2}}{7}$",
          "worked": "$$\\begin{align*}\\frac{1}{5-3\\sqrt{2}}&=\\frac{1}{5-3\\sqrt{2}}\\times\\frac{5+3\\sqrt{2}}{5+3\\sqrt{2}}\\\\\\frac{1}{5-3\\sqrt{2}}&=\\frac{5+3\\sqrt{2}}{5^2-3^2\\times2}\\\\\\frac{1}{5-3\\sqrt{2}}&=\\frac{5+3\\sqrt{2}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
