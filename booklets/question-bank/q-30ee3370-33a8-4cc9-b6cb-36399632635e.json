      {
        "id": "p2-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=x^2+2x-3\\\\y&=3x+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,12)$ and $(-2,-3)$.",
          "worked": "Equate the expressions for $y$:\n$$\\begin{align*}x^2+2x-3&=3x+3\\\\x^2-x-6&=0\\\\(x-3)(x+2)&=0\\\\x&=3\\text{ or }-2\\end{align*}$$\nFor $x=3$, $y=3(3)+3=12$.\n\nFor $x=-2$, $y=3(-2)+3=-3$.\n\nThe intersection points are $(3,12)$ and $(-2,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p2-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=2x^2+3x-3\\\\y&=2x+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,-1)$ and $\\left(\\frac32,6\\right)$.",
          "worked": "Equate the expressions for $y$:\n$$\\begin{align*}2x^2+3x-3&=2x+3\\\\2x^2+x-6&=0\\\\(2x-3)(x+2)&=0\\\\x&=\\frac32\\text{ or }-2\\end{align*}$$\nFor $x=\\frac32$, $y=2\\left(\\frac32\\right)+3=6$.\n\nFor $x=-2$, $y=2(-2)+3=-1$.\n\nThe intersection points are $(-2,-1)$ and $\\left(\\frac32,6\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p2-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=2x+1\\\\y&=\\frac3x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac32,-2\\right)$ and $(1,3)$.",
          "worked": "Equate the expressions for $y$, with $x\\ne0$:\n$$\\begin{align*}2x+1&=\\frac3x\\\\x(2x+1)&=3\\\\2x^2+x-3&=0\\\\(2x+3)(x-1)&=0\\\\x&=-\\frac32\\text{ or }1\\end{align*}$$\nFor $x=-\\frac32$, $y=2\\left(-\\frac32\\right)+1=-2$.\n\nFor $x=1$, $y=2(1)+1=3$.\n\nThe intersection points are $\\left(-\\frac32,-2\\right)$ and $(1,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p2-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=3x+7\\\\y&=\\frac6x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-3,-2)$ and $\\left(\\frac23,9\\right)$.",
          "worked": "Equate the expressions for $y$, with $x\\ne0$:\n$$\\begin{align*}3x+7&=\\frac6x\\\\x(3x+7)&=6\\\\3x^2+7x-6&=0\\\\(3x-2)(x+3)&=0\\\\x&=\\frac23\\text{ or }-3\\end{align*}$$\nFor $x=\\frac23$, $y=3\\left(\\frac23\\right)+7=9$.\n\nFor $x=-3$, $y=3(-3)+7=-2$.\n\nThe intersection points are $(-3,-2)$ and $\\left(\\frac23,9\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
