  "content": {
    "id": "p48-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "By examining the discriminant, state the number of distinct solutions and if they are rational or irrational.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p48-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$9x^{2}-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 distinct rational solutions.",
          "worked": "$$\\begin{aligned}\\Delta&=0^{2}-4(9)(-4)\\\\\\Delta&=144\\end{aligned}$$\nSince $\\Delta>0$ and $144=12^{2}$ is a perfect square, there are 2 distinct rational solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p48-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{2}+3x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 distinct rational solutions.",
          "worked": "$$\\begin{aligned}\\Delta&=3^{2}-4(1)(2)\\\\\\Delta&=1\\end{aligned}$$\nSince $\\Delta>0$ and $1=1^{2}$ is a perfect square, there are 2 distinct rational solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p48-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$-2x^{2}+5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 distinct irrational solutions.",
          "worked": "$$\\begin{aligned}\\Delta&=5^{2}-4(-2)(2)\\\\\\Delta&=41\\end{aligned}$$\nSince $\\Delta>0$ and $41$ is not a perfect square, there are 2 distinct irrational solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p48-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$-4x^{2}+20x-25=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 rational solution.",
          "worked": "$$\\begin{aligned}\\Delta&=20^{2}-4(-4)(-25)\\\\\\Delta&=0\\end{aligned}$$\nSince $\\Delta=0$, there is 1 distinct solution. It is rational because $0$ is a perfect square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p48-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x^{2}+4x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solutions.",
          "worked": "$$\\begin{aligned}\\Delta&=4^{2}-4(3)(2)\\\\\\Delta&=-8\\end{aligned}$$\nSince $\\Delta<0$, there are no real solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p48-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$25x^{2}-20x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 rational solution.",
          "worked": "$$\\begin{aligned}\\Delta&=(-20)^{2}-4(25)(4)\\\\\\Delta&=0\\end{aligned}$$\nSince $\\Delta=0$, there is 1 distinct solution. It is rational because $0$ is a perfect square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
