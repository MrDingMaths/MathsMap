  "content": {
    "id": "routine-arithmetic-r9-accumulation-2-root",
    "type": "question",
    "label": null,
    "prompt": "A factory produces 240 units on the first day of a production run. On each following day it produces 15 more units than on the previous day. How many units does it produce in total over 10 days?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3075$ units",
      "worked": "The daily outputs form an AP with $a=240$, $d=15$ and $n=10$.\n$$\\begin{aligned}S_{10}&=\\frac{10}{2}\\left[2(240)+9(15)\\right]\\\\&=5(480+135)\\\\&=5(615)\\\\&=3075\\text{ units}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
