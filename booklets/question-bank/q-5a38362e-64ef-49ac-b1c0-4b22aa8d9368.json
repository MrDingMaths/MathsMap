  "content": {
    "id": "p10-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "How many ways can three adults and two children be arranged in a line so that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "there is no restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "The five people are distinct.\n$$5!=120.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "no adult sits next to another adult",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "The only possible pattern is adult, child, adult, child, adult. Arrange the adults in their three positions and the children in their two positions.\n$$3!\\times2!=12.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "the children are grouped together",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "Treat the two children as one group. Arrange this group and the three adults in $4!$ ways, then arrange the children within their group in $2!$ ways.\n$$4!\\times2!=48.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "the adults are grouped together",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "Treat the three adults as one group. Arrange this group and the two children in $3!$ ways, then arrange the adults within their group in $3!$ ways.\n$$3!\\times3!=36.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "the adults and children are in groups",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "Treat the adults as one group and the children as another. Arrange the two groups, then arrange the people within each group.\n$$2!\\times3!\\times2!=24.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "the children do not sit together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$72$\n\nSubtract the arrangements with the children together from all arrangements.",
          "worked": "There are $5!$ unrestricted arrangements. When the children sit together, their group and the three adults can be arranged in $4!$ ways, with $2!$ orders inside the group. Subtract these unwanted arrangements.\n$$5!-(4!\\times2!)=120-48=72.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
