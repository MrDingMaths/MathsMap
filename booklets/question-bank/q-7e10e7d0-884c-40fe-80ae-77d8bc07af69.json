              "latex": "\\begin{array}{r|l}\\text{Stem}&\\text{Leaves}\\\\\\hline 1&2\\\\2&4\\;7\\\\3&2\\;4\\\\4&2\\;2\\\\5&2\\;2\\;8\\;8\\\\6&3\\;4\\;4\\;5\\;5\\;7\\;8\\;9\\\\\\end{array}",
