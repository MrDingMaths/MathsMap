  "content": {
    "id": "p30-q11-14-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q11",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin^2\\theta-\\cos^2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\cos2\\theta$",
          "worked": "$$\\begin{align*}\\sin^2\\theta-\\cos^2\\theta&=-(\\cos^2\\theta-\\sin^2\\theta)\\\\\\sin^2\\theta-\\cos^2\\theta&=-\\cos2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p30-q12",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\theta\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\sin2\\theta$",
          "worked": "$$\\begin{align*}\\cos\\theta\\sin\\theta&=\\frac12(2\\sin\\theta\\cos\\theta)\\\\\\cos\\theta\\sin\\theta&=\\frac12\\sin2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p30-q13",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\theta(1+\\cos2\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin2\\theta$",
          "worked": "$$\\begin{align*}\\tan\\theta(1+\\cos2\\theta)&=\\frac{\\sin\\theta}{\\cos\\theta}(2\\cos^2\\theta)\\\\\\tan\\theta(1+\\cos2\\theta)&=2\\sin\\theta\\cos\\theta\\\\\\tan\\theta(1+\\cos2\\theta)&=\\sin2\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q14",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1-\\cos2\\theta}{\\sin\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sin\\theta$",
          "worked": "$$\\begin{align*}\\frac{1-\\cos2\\theta}{\\sin\\theta}&=\\frac{2\\sin^2\\theta}{\\sin\\theta}\\\\\\frac{1-\\cos2\\theta}{\\sin\\theta}&=2\\sin\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
