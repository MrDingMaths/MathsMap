        "label": "a",
        "prompt": "Find $P(A\\cup B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.8$",
          "worked": "$$\\begin{align*}P(A\\cup B)&=0.5+0.4-0.1\\\\P(A\\cup B)&=0.8.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p39-q19b",
        "type": "part",
        "label": "b",
        "prompt": "Find $P(A\\mid B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.25$",
          "worked": "$$\\begin{align*}P(A\\mid B)&=\\frac{P(A\\cap B)}{P(B)}\\\\P(A\\mid B)&=\\frac{0.1}{0.4}\\\\P(A\\mid B)&=0.25.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q19c",
        "type": "part",
        "label": "c",
        "prompt": "Find $P(C)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3$",
          "worked": "The stem gives $P(C)=0.3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p39-q19d",
        "type": "part",
        "label": "d",
        "prompt": "Are $B$ and $C$ mutually exclusive?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, since $P(B\\cap C)=0$.",
          "worked": "$$\\begin{align*}P(B\\cap C)&=P(B)+P(C)-P(B\\cup C)\\\\P(B\\cap C)&=0.4+0.3-0.7\\\\P(B\\cap C)&=0.\\end{align*}$$\nYes. The intersection has probability zero, so $B$ and $C$ are mutually exclusive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
