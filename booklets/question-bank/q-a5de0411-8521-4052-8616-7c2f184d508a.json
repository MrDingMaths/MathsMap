  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Let $f:\\mathbb{R}\\to\\mathbb{R}$ where $f(x)=\\dfrac{x+2}{3}$. Find the inverse function $f^{-1}:\\mathbb{R}\\to\\mathbb{R}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f^{-1}:\\mathbb{R}\\to\\mathbb{R}$ where $f^{-1}(x)=3x-2$.",
      "worked": "Let $y=f(x)$. Interchange $x$ and $y$, then solve for $y$:\n$$\\begin{align*}x&=\\frac{y+2}{3}\\\\3x&=y+2\\\\y&=3x-2.\\end{align*}$$\nTherefore, $f^{-1}:\\mathbb{R}\\to\\mathbb{R}$ where $f^{-1}(x)=3x-2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
