  "content": {
    "id": "p76-q13",
    "type": "question",
    "label": "13",
    "prompt": "A particle has displacement-time equation $$x(t)=2t^{3}-10t^{2}+3.$$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p76-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the average velocity between $t=0$ to $t=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12\\text{ m/s}$. Use $\\dfrac{x(2)-x(0)}{2-0}$.",
          "worked": "$x(0)=3$ and $x(2)=2(2)^{3}-10(2)^{2}+3=-21$. \n\n$$\\begin{align*}\\text{Average velocity}&=\\frac{x(2)-x(0)}{2-0}\\\\\\text{Average velocity}&=\\frac{-21-3}{2}\\\\\\text{Average velocity}&=-12\\text{ m/s}.\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p76-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the velocity-time equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(t)=6t^{2}-20t\\text{ m/s}$",
          "worked": "$$\\begin{align*}v(t)&=\\frac{dx}{dt}\\\\v(t)&=6t^{2}-20t\\text{ m/s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p76-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the initial velocity of the particle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(0)=0\\text{ m/s}$",
          "worked": "$v(0)=6(0)^{2}-20(0)=0\\text{ m/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p76-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the speed of the particle after two seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\text{ m/s}$. Speed is $|v(2)|$.",
          "worked": "\n\n$$\\begin{align*}v(2)&=6(2)^{2}-20(2)\\\\v(2)&=-16\\text{ m/s}.\\end{align*}$$\n\n Speed is $|v(2)|=16\\text{ m/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p76-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "When is the particle stationary?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=0\\text{ s}$ and $t=\\dfrac{10}{3}\\text{ s}$. Set $v(t)=0$.",
          "worked": "The particle is stationary when $v(t)=0$. \n\n$$\\begin{align*}6t^{2}-20t&=0\\\\2t(3t-10)&=0\\\\t&=0,\\ \\frac{10}{3}.\\end{align*}$$\n\n Thus it is stationary at $t=0\\text{ s}$ and $t=\\dfrac{10}{3}\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
