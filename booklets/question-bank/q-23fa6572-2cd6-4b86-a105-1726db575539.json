  "content": {
    "id": "p28-q6",
    "type": "question",
    "label": "6",
    "prompt": "A player scores each three-point shot with probability 0.3, independently. She takes 8 shots. Find the probability she scores exactly 3. Give your answer correct to four decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.2541$",
      "worked": "Let $X$ be the number of shots scored. Then $X\\sim\\operatorname{Bin}(8,0.3)$.\n$$\\begin{align*}P(X=3)&=\\binom{8}{3}(0.3)^3(0.7)^5\\\\&\\approx0.2541\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
