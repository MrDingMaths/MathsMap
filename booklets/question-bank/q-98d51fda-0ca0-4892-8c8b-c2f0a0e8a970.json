  "content": {
    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "One zero of $x^2-3x+k-2=0$ is $-4$. Find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=-26$",
      "worked": "Let the other zero be $\\beta$.\n$$\\begin{aligned}-4+\\beta&=3\\\\\\beta&=7\\\\-4\\beta&=k-2\\\\-28&=k-2\\\\k&=-26\\end{aligned}$$\nAlternate method:\n$$\\begin{aligned}P(-4)&=16+12+k-2\\\\0&=26+k\\\\k&=-26\\end{aligned}$$",
      "solutionDiagrams": []
    },
