          "inlines": [
            {
              "type": "text",
              "text": "A student says: “If I triple both sides of a rectangle, the area triples.”",
              "marks": []
            }
          ]
        },
        {
          "id": "p18-q13-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Show with an example that this is wrong. What is the correct multiplier?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "9 times. For example, $3\\times4=12$ and $9\\times12=108$, with $108\\div12=9$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p18-q13-worked-original-sides",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Example: side lengths 3 and 4 units.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p18-q13-worked-original-area",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}A_{\\text{original}}&=3\\times4\\\\A_{\\text{original}}&=12\\text{ square units}\\end{aligned}",
                "display": false,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p18-q13-worked-new-sides",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 4,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "New side lengths: 9 and 12 units.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p18-q13-worked-new-area",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}A_{\\text{new}}&=9\\times12\\\\A_{\\text{new}}&=108\\text{ square units}\\end{aligned}",
                "display": false,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p18-q13-worked-comparison",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "108\\div12=9",
                "display": false,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p18-q13-worked-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The new area is 9 times the original area. Tripling each dimension multiplies the area by ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "3^2=3\\times3=9",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
