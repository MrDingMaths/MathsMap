  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Consider the formula $I = Prn$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $P$ when $I = 19500$, $r = 0.03$, $n = 25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P = 26000$",
          "worked": "$$\\begin{align*}I &= Prn \\\\ 19500 &= P(0.03)(25) \\\\ 19500 &= 0.75P \\\\ P &= \\frac{19500}{0.75} = 26000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $n$ when $I = 2100$, $P = 5000$, $r = \\frac{6}{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n = 7$",
          "worked": "$$\\begin{align*}I &= Prn \\\\ 2100 &= 5000\\left(\\frac{6}{100}\\right)n \\\\ 2100 &= 300n \\\\ n &= \\frac{2100}{300} = 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
