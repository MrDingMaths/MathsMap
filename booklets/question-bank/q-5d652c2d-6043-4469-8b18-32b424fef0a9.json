  "content": {
    "id": "p19-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Calculate the amount these investments will become after 4 years. Give monetary answers to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\$5000$ invested at 6% p.a. compounded annually.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$6312.38$",
          "worked": "$$\\begin{align*}r &= 0.06,\\qquad n=4\\\\FV &= PV(1+r)^n\\\\FV &= 5000(1+0.06)^4\\\\FV &\\approx \\$6312.38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p19-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\$5000$ invested at 6% p.a. compounded monthly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$6352.45$",
          "worked": "$$\\begin{align*}r &= \\frac{0.06}{12}=0.005\\\\n &= 4\\times12=48\\\\FV &= PV(1+r)^n\\\\FV &= 5000(1+0.005)^{48}\\\\FV &\\approx \\$6352.45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\$5000$ invested at 6% p.a. compounded weekly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$6355.37$",
          "worked": "Using 52 weeks per year:\n$$\\begin{align*}r &= \\frac{0.06}{52}\\\\n &= 4\\times52=208\\\\FV &= PV(1+r)^n\\\\FV &= 5000\\left(1+\\frac{0.06}{52}\\right)^{208}\\\\FV &\\approx \\$6355.37\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p19-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\$5000$ invested at 6% p.a. simple interest.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$6200.00$",
          "worked": "$$\\begin{align*}I &= Prn\\\\I &= 5000\\times0.06\\times4\\\\I &= \\$1200\\\\FV &= 5000+1200\\\\FV &= \\$6200.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p19-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Which investment will give the most money?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Weekly compounding.",
          "worked": "Weekly compounding gives $\\$6355.37$, the greatest of the four final amounts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
