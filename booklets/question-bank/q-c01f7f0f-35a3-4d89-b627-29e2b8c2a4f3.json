        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rational, $-\\frac{9}{4}$.",
          "worked": "$$\\begin{align*}-2\\frac14&=-\\frac{2\\times4+1}{4}\\\\-2\\frac14&=-\\frac94\\end{align*}$$This is a ratio of integers, so it is rational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rational, $\\frac{3}{1}$.",
          "worked": "$\\sqrt9=3=\\frac31$, so it is rational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q1-d",
        "type": "part",
        "label": "d",
