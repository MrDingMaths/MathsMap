  "content": {
    "id": "p27-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "For $\\triangle ABC$ we are given that $\\sin A=\\frac{3}{4}$, $\\sin B=\\frac{2}{3}$ and $a=3$. Find $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=\\frac{8}{3}$",
      "worked": "By the sine rule,\n$$\\begin{align*}\n\\frac{b}{\\sin B}&=\\frac{a}{\\sin A}\\\\\n\\frac{b}{2/3}&=\\frac{3}{3/4}\\\\\nb&=\\frac{3\\times\\frac{2}{3}}{\\frac{3}{4}}\\\\\nb&=\\frac{8}{3}.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
