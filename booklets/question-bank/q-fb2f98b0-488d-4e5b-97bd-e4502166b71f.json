  "content": {
    "id": "p32-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "When ice melts, its volume decreases by about $10\\%$. Suppose five cubes of ice of side length $2\\text{ cm}$ are placed in a cylindrical glass.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "If the glass has a radius of $3\\text{ cm}$, then find the height to which the water will rise.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{\\pi}\\text{ cm}$\n\nUse $90\\%$ of the ice volume as the water volume.",
          "worked": "Using the stated $10\\%$ decrease:\n\n$$\\begin{align*}V_{\\text{ice}}&=5\\times2^3=40\\text{ cm}^3\\\\V_{\\text{water}}&=0.9\\times40=36\\text{ cm}^3\\end{align*}$$\n\n$$\\begin{align*}\\pi\\times3^2\\times h&=36\\\\9\\pi h&=36\\\\h&=\\frac{36}{9\\pi}\\\\h&=\\frac{4}{\\pi}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p32-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "If the water rises to a height of $2\\text{ cm}$, then find the radius of the glass.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{\\dfrac{18}{\\pi}}\\text{ cm}$\n\nUse $90\\%$ of the ice volume as the water volume.",
          "worked": "Using the stated $10\\%$ decrease:\n\n$$\\begin{align*}V_{\\text{ice}}&=5\\times2^3=40\\text{ cm}^3\\\\V_{\\text{water}}&=0.9\\times40=36\\text{ cm}^3\\end{align*}$$\n\n$$\\begin{align*}\\pi r^2\\times2&=36\\\\2\\pi r^2&=36\\\\r^2&=\\frac{18}{\\pi}\\\\r&=\\sqrt{\\frac{18}{\\pi}}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
