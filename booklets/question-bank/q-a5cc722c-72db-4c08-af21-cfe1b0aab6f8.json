  "content": {
    "id": "v2-1ddc9-p55-practice-j13-215016-root",
    "type": "question",
    "label": null,
    "prompt": "Solve these equations for $0^{\\circ}\\le\\theta<360^{\\circ}$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1ddc9-p55-practice-j13-215016-j13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\cos\\theta-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60^{\\circ},300^{\\circ}$",
          "worked": "$$\\begin{align*}2\\cos\\theta-1&=0\\\\\\cos\\theta&=\\frac12\\\\A&=\\cos^{-1}\\left(\\frac12\\right)=60^{\\circ}\\end{align*}$$\nCosine is positive in Q1 and Q4.\n$$\\begin{align*}\\theta&=60^{\\circ},\\ 360^{\\circ}-60^{\\circ}\\\\\\theta&=60^{\\circ},300^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-1ddc9-p55-practice-j13-215016-j13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\theta+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180^{\\circ}$",
          "worked": "$$\\begin{align*}\\cos\\theta+1&=0\\\\\\cos\\theta&=-1\\\\\\theta&=180^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-1ddc9-p55-practice-j13-215016-j13-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2\\cos\\theta-1)(\\cos\\theta+1)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60^{\\circ},180^{\\circ},300^{\\circ}$",
          "worked": "$$\\begin{align*}(2\\cos\\theta-1)(\\cos\\theta+1)&=0\\\\2\\cos\\theta-1&=0\\quad\\text{or}\\\\\\cos\\theta+1&=0\\end{align*}$$\nFrom parts a and b, $\\theta=60^{\\circ},300^{\\circ}$ or $\\theta=180^{\\circ}$.\nThus $\\theta=60^{\\circ},180^{\\circ},300^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
