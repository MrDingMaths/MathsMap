  "content": {
    "id": "p11-q8",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the quartic polynomial with a triple root at $x=3$, single root at $x=-2$ and $y$-intercept $-27$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P(x)=\\dfrac12(x-3)^3(x+2)$",
      "worked": "$$\\begin{align*}P(x)&=k(x-3)^3(x+2)\\\\P(0)&=k(0-3)^3(0+2)\\\\-27&=-54k\\\\k&=\\frac12\\end{align*}$$\nTherefore $P(x)=\\dfrac12(x-3)^3(x+2)$.",
      "solutionDiagrams": []
    },
