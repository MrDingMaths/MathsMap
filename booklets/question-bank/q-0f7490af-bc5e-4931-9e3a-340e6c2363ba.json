    "difficultyReason": "Rewrite composite bases as prime-base powers and combine indices, including large exponents."
  },
  "content": {
    "id": "p74-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Express each of the following natural numbers as a product of prime numbers:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p74-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\times3\\times4\\times5\\times6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^4\\times3^2\\times5$",
          "worked": "$$\\begin{align*}2\\times3\\times4\\times5\\times6&=2\\times3\\times2^2\\times5\\times(2\\times3)\\\\2\\times3\\times4\\times5\\times6&=2^4\\times3^2\\times5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p74-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^2\\times3^2\\times4^2\\times5^2\\times6^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^8\\times3^4\\times5^2$",
          "worked": "$$\\begin{align*}2^2\\times3^2\\times4^2\\times5^2\\times6^2&=2^2\\times3^2\\times(2^2)^2\\times5^2\\times(2\\times3)^2\\\\2^2\\times3^2\\times4^2\\times5^2\\times6^2&=2^{2+4+2}\\times3^{2+2}\\times5^2\\\\2^2\\times3^2\\times4^2\\times5^2\\times6^2&=2^8\\times3^4\\times5^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p74-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^2\\times3^3\\times4^4\\times5^5\\times6^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{16}\\times3^9\\times5^5$",
          "worked": "$$\\begin{align*}2^2\\times3^3\\times4^4\\times5^5\\times6^6&=2^2\\times3^3\\times(2^2)^4\\times5^5\\times(2\\times3)^6\\\\2^2\\times3^3\\times4^4\\times5^5\\times6^6&=2^{2+8+6}\\times3^{3+6}\\times5^5\\\\2^2\\times3^3\\times4^4\\times5^5\\times6^6&=2^{16}\\times3^9\\times5^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p74-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$9^9\\times10^{10}\\times11^{11}\\times12^{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{34}\\times3^{30}\\times5^{10}\\times11^{11}$",
          "worked": "$$\\begin{align*}9^9\\times10^{10}\\times11^{11}\\times12^{12}&=(3^2)^9\\times(2\\times5)^{10}\\times11^{11}\\times(2^2\\times3)^{12}\\\\9^9\\times10^{10}\\times11^{11}\\times12^{12}&=2^{10+24}\\times3^{18+12}\\times5^{10}\\times11^{11}\\\\9^9\\times10^{10}\\times11^{11}\\times12^{12}&=2^{34}\\times3^{30}\\times5^{10}\\times11^{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
