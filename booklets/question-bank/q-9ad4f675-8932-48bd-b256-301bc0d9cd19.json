    "id": "p12-q7-node",
    "type": "question",
    "label": "7",
    "prompt": "Solve $2^x=5$, correct to 2 decimal places, by taking the natural log of both sides.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x\\approx2.32$",
      "worked": "$$\\begin{align*}\\ln(2^x)&=\\ln 5\\\\x\\ln 2&=\\ln 5\\\\x&=\\frac{\\ln 5}{\\ln 2}\\\\x&\\approx2.32\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
