  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The diameter of a circle has endpoints located at the coordinate $A(-1,-1)$ and $B(5,7)$. Find the equation of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-2)^2+(y-3)^2=25$",
      "worked": "The centre is the midpoint of $AB$.\n$$\\begin{align*}C&=\\left(\\frac{-1+5}{2},\\frac{-1+7}{2}\\right)\\\\C&=(2,3).\\end{align*}$$\n$$\\begin{align*}r^2&=(2-(-1))^2+(3-(-1))^2\\\\r^2&=25.\\end{align*}$$\nHence the equation is $(x-2)^2+(y-3)^2=25$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
