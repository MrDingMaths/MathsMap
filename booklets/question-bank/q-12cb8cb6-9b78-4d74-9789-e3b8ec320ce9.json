  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Using exact values, find the angles $\\theta$ between $0^\\circ$ and $360^\\circ$ inclusive, with the given trigonometric function.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\theta=\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^\\circ,300^\\circ$",
          "worked": "The related angle is $60^\\circ$. Cosine is positive in quadrants I and IV.\n$$\\begin{align*}\\theta&=60^\\circ\\text{ or }360^\\circ-60^\\circ\\\\\\theta&=60^\\circ\\text{ or }300^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\theta=-\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=120^\\circ,300^\\circ$",
          "worked": "The related angle is $60^\\circ$. Tangent is negative in quadrants II and IV.\n$$\\begin{align*}\\theta&=180^\\circ-60^\\circ\\text{ or }360^\\circ-60^\\circ\\\\\\theta&=120^\\circ\\text{ or }300^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\theta=\\frac1{\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=45^\\circ,135^\\circ$",
          "worked": "The related angle is $45^\\circ$. Sine is positive in quadrants I and II.\n$$\\begin{align*}\\theta&=45^\\circ\\text{ or }180^\\circ-45^\\circ\\\\\\theta&=45^\\circ\\text{ or }135^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\theta=-\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=210^\\circ,330^\\circ$",
          "worked": "The related angle is $30^\\circ$. Sine is negative in quadrants III and IV.\n$$\\begin{align*}\\theta&=180^\\circ+30^\\circ\\text{ or }360^\\circ-30^\\circ\\\\\\theta&=210^\\circ\\text{ or }330^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos\\theta=-\\frac{\\sqrt3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=150^\\circ,210^\\circ$",
          "worked": "The related angle is $30^\\circ$. Cosine is negative in quadrants II and III.\n$$\\begin{align*}\\theta&=180^\\circ-30^\\circ\\text{ or }180^\\circ+30^\\circ\\\\\\theta&=150^\\circ\\text{ or }210^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan\\theta=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=135^\\circ,315^\\circ$",
          "worked": "The related angle is $45^\\circ$. Tangent is negative in quadrants II and IV.\n$$\\begin{align*}\\theta&=180^\\circ-45^\\circ\\text{ or }360^\\circ-45^\\circ\\\\\\theta&=135^\\circ\\text{ or }315^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
