  "content": {
    "id": "p18-q9-root",
    "type": "question",
    "label": null,
    "prompt": "When the side length of a square is doubled, its area increases by 27 square units. Find the side length of the original square.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3$ units.",
      "worked": "Let $s>0$ be the original side length, in units.\n$$\\begin{align*}(2s)^2-s^2&=27\\\\3s^2&=27\\\\s^2&=9\\\\s&=\\pm3.\\end{align*}$$\nThe side length is positive, so the original side length is $3$ units.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
