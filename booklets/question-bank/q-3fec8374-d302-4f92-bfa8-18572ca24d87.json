            "prompt": "$A$ and $C$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5$",
              "worked": "$$\\begin{align*}AC^2&=(10-6)^2+(5-2)^2\\\\AC^2&=4^2+3^2\\\\AC^2&=25\\\\AC&=5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
