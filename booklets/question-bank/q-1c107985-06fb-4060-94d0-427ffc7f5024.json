  "content": {
    "id": "p25-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Write in the form $(x+a)^2+c$ by completing the square.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-1)^2+2$",
          "worked": "$\\begin{align*}x^2-2x+3&=x^2-2x+(-1)^2-(-1)^2+3\\\\&=(x-1)^2-1+3\\\\&=(x-1)^2+2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-8x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-4)^2-13$",
          "worked": "$\\begin{align*}x^2-8x+3&=x^2-8x+(-4)^2-(-4)^2+3\\\\&=(x-4)^2-16+3\\\\&=(x-4)^2-13\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-4x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2-1$",
          "worked": "$\\begin{align*}x^2-4x+3&=x^2-4x+(-2)^2-(-2)^2+3\\\\&=(x-2)^2-4+3\\\\&=(x-2)^2-1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-10x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)^2-22$",
          "worked": "$\\begin{align*}x^2-10x+3&=x^2-10x+(-5)^2-(-5)^2+3\\\\&=(x-5)^2-25+3\\\\&=(x-5)^2-22\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-6x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2-6$",
          "worked": "$\\begin{align*}x^2-6x+3&=x^2-6x+(-3)^2-(-3)^2+3\\\\&=(x-3)^2-9+3\\\\&=(x-3)^2-6\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
