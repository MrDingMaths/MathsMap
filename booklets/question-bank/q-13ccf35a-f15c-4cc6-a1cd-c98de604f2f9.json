        "type": "part",
        "label": "a",
        "prompt": "Differentiate $e^{x^2-2x+3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x-1)e^{x^2-2x+3}$",
          "worked": "$$\\begin{align*}\\frac{d}{dx}\\left(e^{x^2-2x+3}\\right)&=(2x-2)e^{x^2-2x+3}\\\\&=2(x-1)e^{x^2-2x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int (x-1)e^{x^2-2x+3}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12e^{x^2-2x+3}+C$",
          "worked": "Using part a,\n$$\\begin{align*}\\int(x-1)e^{x^2-2x+3}\\,dx&=\\frac12\\int 2(x-1)e^{x^2-2x+3}\\,dx\\\\&=\\frac12e^{x^2-2x+3}+C.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
