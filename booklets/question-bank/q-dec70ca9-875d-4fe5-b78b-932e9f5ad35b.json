  "content": {
    "id": "p19-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Prove that a quadrilateral cannot have two reflex angles.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Two reflex angles would already sum to more than $360^\\circ$, contradicting the quadrilateral angle sum.",
      "worked": "Suppose a quadrilateral has two reflex angles. Each exceeds $180^\\circ$, so these two angles alone sum to more than $2\\times180^\\circ=360^\\circ$. This contradicts the fact that all four interior angles sum to $360^\\circ$. Therefore, a quadrilateral cannot have two reflex angles.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
