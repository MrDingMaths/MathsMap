    "children": [
      {
        "id": "p30-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+\\frac{4}{11}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{18}{11}$",
          "worked": "$$\\begin{align*}x+\\frac{4}{11}-\\frac{4}{11}&=2-\\frac{4}{11}\\\\x&=\\frac{22}{11}-\\frac{4}{11}\\\\x&=\\frac{18}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p30-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{13}{15}=y-\\frac{8}{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{7}{5}$",
          "worked": "$$\\begin{align*}\\frac{13}{15}+\\frac{8}{15}&=y-\\frac{8}{15}+\\frac{8}{15}\\\\\\frac{21}{15}&=y\\\\\\frac{7}{5}&=y\\\\y&=\\frac{7}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p30-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$z+\\frac{14}{23}=\\frac{5}{23}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z=-\\frac{9}{23}$",
          "worked": "$$\\begin{align*}z+\\frac{14}{23}-\\frac{14}{23}&=\\frac{5}{23}-\\frac{14}{23}\\\\z&=\\frac{5-14}{23}\\\\z&=-\\frac{9}{23}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
