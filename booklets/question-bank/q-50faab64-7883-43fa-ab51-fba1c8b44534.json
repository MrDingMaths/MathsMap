      {
        "id": "v2-b20da-p35-practice-slot-2-slot-2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^3+6x+1$ is always increasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=3x^2+6>0$ for all $x$, so $f$ is always increasing.",
          "worked": "$$\\begin{align*}f'(x)&=3x^2+6\\end{align*}$$\nSince $x^2\\ge0$, $f'(x)\\ge6>0$ for all $x$. Hence $f(x)$ is always increasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-b20da-p35-practice-slot-2-slot-2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=5-4x-x^3$ is always decreasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-3x^2-4<0$ for all $x$, so $f$ is always decreasing.",
          "worked": "$$\\begin{align*}f'(x)&=-4-3x^2\\end{align*}$$\nSince $x^2\\ge0$, $f'(x)\\le-4<0$ for all $x$. Hence $f(x)$ is always decreasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-b20da-p35-practice-slot-2-slot-2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^3-3x^2+4x+2$ is always increasing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=3(x-1)^2+1>0$ for all $x$, so $f$ is always increasing.",
          "worked": "$$\\begin{align*}f'(x)&=3x^2-6x+4\\\\&=3(x-1)^2+1\\end{align*}$$\nSince $(x-1)^2\\ge0$, $f'(x)\\ge1>0$ for all $x$. Hence $f(x)$ is always increasing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
