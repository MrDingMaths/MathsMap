        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sqrt{2}+\\sqrt{8}&=\\sqrt{2}+2\\sqrt{2}\\\\\\sqrt{2}+\\sqrt{8}&=3\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
