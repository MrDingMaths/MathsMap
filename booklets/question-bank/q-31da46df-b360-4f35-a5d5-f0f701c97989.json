        "type": "part",
        "label": "b",
        "prompt": "$2\\sqrt{2}+\\sqrt{18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt{2}$",
          "worked": "$$\\begin{align*}2\\sqrt{2}+\\sqrt{18}&=2\\sqrt{2}+3\\sqrt{2}\\\\2\\sqrt{2}+\\sqrt{18}&=5\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p20-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{20}+\\sqrt{45}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt{5}$",
          "worked": "$$\\begin{align*}\\sqrt{20}+\\sqrt{45}&=\\sqrt{4\\cdot5}+\\sqrt{9\\cdot5}\\\\\\sqrt{20}+\\sqrt{45}&=2\\sqrt{5}+3\\sqrt{5}\\\\\\sqrt{20}+\\sqrt{45}&=5\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{90}-\\sqrt{40}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{10}$",
          "worked": "$$\\begin{align*}\\sqrt{90}-\\sqrt{40}&=\\sqrt{9\\cdot10}-\\sqrt{4\\cdot10}\\\\\\sqrt{90}-\\sqrt{40}&=3\\sqrt{10}-2\\sqrt{10}\\\\\\sqrt{90}-\\sqrt{40}&=\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2-3\\sqrt{2})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22-12\\sqrt{2}$",
          "worked": "$$\\begin{align*}(2-3\\sqrt{2})^2&=2^2-2(2)(3\\sqrt{2})+(3\\sqrt{2})^2\\\\(2-3\\sqrt{2})^2&=4-12\\sqrt{2}+18\\\\(2-3\\sqrt{2})^2&=22-12\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sqrt{6}-\\sqrt{3})(\\sqrt{6}+\\sqrt{3})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}(\\sqrt{6}-\\sqrt{3})(\\sqrt{6}+\\sqrt{3})&=(\\sqrt{6})^2-(\\sqrt{3})^2\\\\(\\sqrt{6}-\\sqrt{3})(\\sqrt{6}+\\sqrt{3})&=6-3\\\\(\\sqrt{6}-\\sqrt{3})(\\sqrt{6}+\\sqrt{3})&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
