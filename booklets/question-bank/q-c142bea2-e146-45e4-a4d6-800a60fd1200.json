  "content": {
    "id": "v2-3fc1c1-p8-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Find the gradient of the inverse function at:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-3fc1c1-p8-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=3$ given $f(x)=\\sqrt{2x-1}+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "The range of $f$ is $[1,\\infty)$, so $x=3$ is in the domain of $f^{-1}$. Find $f^{-1}(3)$:\n$$\\begin{align*}\\sqrt{2y-1}+1&=3\\\\2y-1&=4\\\\y&=\\frac52\\end{align*}$$\n$$\\begin{align*}f'(x)&=\\frac{1}{\\sqrt{2x-1}}\\\\f'\\left(\\frac52\\right)&=\\frac12\\\\(f^{-1})'(3)&=\\frac{1}{f'(5/2)}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-3fc1c1-p8-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=2$ given $f(x)=(x-1)^3+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The gradient does not exist because $f'(1)=0$.",
          "worked": "Find $f^{-1}(2)$:\n$$\\begin{align*}(y-1)^3+2&=2\\\\y&=1\\end{align*}$$\n$$\\begin{align*}f'(x)&=3(x-1)^2\\\\f'(1)&=0\\end{align*}$$\nSince $f'(1)=0$, $\\dfrac{1}{f'(1)}$ is undefined. The gradient of $f^{-1}$ at $x=2$ does not exist (the tangent is vertical).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
