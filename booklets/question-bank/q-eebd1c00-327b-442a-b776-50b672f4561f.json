  "content": {
    "id": "p28-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A square-based pyramid has four faces that are equilateral triangles of side length $a$. Find a formula for the surface area of this figure.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$A=(1+\\sqrt3)a^2$\n\nAdd the square base and four equilateral triangular faces.",
      "worked": "Let $t$ be the altitude of an equilateral triangular face.\n\n$$\\begin{align*}t&=\\sqrt{a^2-\\left(\\frac a2\\right)^2}\\\\t&=\\frac{\\sqrt3}{2}a\\\\A&=a^2+4\\left(\\frac12at\\right)\\\\A&=a^2+4\\left(\\frac12a\\cdot\\frac{\\sqrt3}{2}a\\right)\\\\A&=(1+\\sqrt3)a^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
