  "content": {
    "id": "p81-q11",
    "type": "question",
    "label": "11",
    "prompt": "A large bee farm produces 1200 litres of honey per day.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p81-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "If there are 1000 millilitres in 1 litre, how many millilitres of honey can the farm’s bees produce in one day?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,200\\,000\\text{ mL}$",
          "worked": "Multiply by $1000$, moving the decimal point 3 places to the right.\n$$1200 \\times 1000 = 1\\,200\\,000\\text{ mL}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p81-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "The farm’s honey is sold in 100-millilitre jars. How many jars of honey can the farm’s bees fill in one day?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\,000$ jars",
          "worked": "Using the daily volume from part a, divide by $100$, moving the decimal point 2 places to the left.\n$$1\\,200\\,000 \\div 100 = 12\\,000$$\nThe bees can fill $12\\,000$ jars in one day.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
