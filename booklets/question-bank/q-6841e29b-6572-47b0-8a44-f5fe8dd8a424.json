    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-2\\sin\\theta$",
      "worked": "Since sine is odd, $\\sin(-\\theta)=-\\sin\\theta$.\n$$\\begin{align*}3\\sin(-\\theta)+\\sin\\theta&=-3\\sin\\theta+\\sin\\theta\\\\3\\sin(-\\theta)+\\sin\\theta&=-2\\sin\\theta\\end{align*}$$",
      "solutionDiagrams": []
    },
