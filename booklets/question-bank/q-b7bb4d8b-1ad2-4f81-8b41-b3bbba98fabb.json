    "type": "question",
    "label": "3",
    "prompt": "Write the fraction that represents each of these situations.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-fractions-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "8 of 11 grandchildren visit their grandmother.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8}{11}$",
          "worked": "There are 8 visiting grandchildren out of 11 grandchildren, so the fraction is $\\frac{8}{11}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-fractions-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Twenty minutes out of one hour are spent reading.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "One hour is 60 minutes.\n$$\\begin{align*}\\text{Fraction spent reading}&=\\frac{20}{60}\\\\\\text{Fraction spent reading}&=\\frac{20\\div20}{60\\div20}\\\\\\text{Fraction spent reading}&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-fractions-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "One leg of a spider is broken.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "A spider has 8 legs. One of its 8 legs is broken, so the fraction is $\\frac{1}{8}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p5-fractions-q3-d",
