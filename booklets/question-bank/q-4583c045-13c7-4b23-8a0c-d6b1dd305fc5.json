  "content": {
    "id": "p20-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Give your answer correct to two decimal places.\n\nDuring a term, a student has an average of 46 marks after the first four tests and his average for the next six tests is 38 marks. What is his average for the ten tests?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$41.20$ marks",
      "worked": "$$\\begin{align*}\\text{Total marks for the first four tests}&=4\\times46=184\\\\\\text{Total marks for the next six tests}&=6\\times38=228\\\\\\overline{x}&=\\frac{184+228}{10}\\\\\\overline{x}&=41.20\\text{ marks}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
