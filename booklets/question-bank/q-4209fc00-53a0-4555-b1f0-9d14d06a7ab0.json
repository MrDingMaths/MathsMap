  "content": {
    "id": "v2-ee583-p27-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "Find the points of intersection of these graphs.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-ee583-p27-practice-slot-11-slot-11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+y^2=20$ and $y=2x-10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,-2)$",
          "worked": "$$\\begin{aligned}x^2+(2x-10)^2&=20\\\\5x^2-40x+80&=0\\\\x^2-8x+16&=0\\\\(x-4)^2&=0\\\\x&=4\\end{aligned}$$\n$$\\begin{aligned}y&=2(4)-10\\\\y&=-2\\end{aligned}$$\nThe line touches the circle at $(4,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "v2-ee583-p27-practice-slot-11-slot-11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+y^2-2x+4y-5=0$ and $x-y=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(1-\\sqrt5,-2-\\sqrt5\\right)$ and $\\left(1+\\sqrt5,-2+\\sqrt5\\right)$",
          "worked": "Rearrange the line to give $y=x-3$.\n$$\\begin{aligned}x^2+(x-3)^2-2x+4(x-3)-5&=0\\\\2x^2-4x-8&=0\\\\x^2-2x-4&=0\\\\x&=\\frac{2\\pm\\sqrt{4+16}}{2}\\\\x&=1\\pm\\sqrt5\\end{aligned}$$\nSubstitute into $y=x-3$:\n$$\\begin{aligned}y&=-2\\pm\\sqrt5\\end{aligned}$$\nThe points are $\\left(1-\\sqrt5,-2-\\sqrt5\\right)$ and $\\left(1+\\sqrt5,-2+\\sqrt5\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      }
    ]
  },
