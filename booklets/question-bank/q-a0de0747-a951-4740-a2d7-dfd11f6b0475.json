  "content": {
    "id": "p40-q10-response",
    "type": "question",
    "label": "10",
    "prompt": "Brothers Marco and Matthew start riding from home into town, which is 30 km away.\nMarco rode at 10 km/h and Matthew took 20 minutes longer to complete the trip.\nAssuming that they both rode at a constant speed, how fast was Matthew riding?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9\\text{ km/h}$. Matthew's time is $3\\text{ h }20\\text{ min}$.",
      "worked": "Marco's time:\n$$\\begin{align*}t_{\\text{Marco}}&=\\frac{d}{s}\\\\t_{\\text{Marco}}&=\\frac{30}{10}\\\\t_{\\text{Marco}}&=3\\text{ h}\\end{align*}$$\nMatthew's time:\n$$\\begin{align*}t_{\\text{Matthew}}&=3+\\frac{20}{60}\\\\t_{\\text{Matthew}}&=\\frac{10}{3}\\text{ h}\\end{align*}$$\nMatthew's speed:\n$$\\begin{align*}s_{\\text{Matthew}}&=\\frac{d}{t}\\\\s_{\\text{Matthew}}&=\\frac{30}{10/3}\\\\s_{\\text{Matthew}}&=9\\text{ km/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
