  "content": {
    "id": "p20-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac23\\div\\frac25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac53$",
          "worked": "$$\\begin{align*}\\frac23\\div\\frac25&=\\frac23\\times\\frac52\\\\\\frac23\\div\\frac25&=\\frac{1\\times5}{3\\times1}\\\\\\frac23\\div\\frac25&=\\frac53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac34\\div\\frac67$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac78$",
          "worked": "$$\\begin{align*}\\frac34\\div\\frac67&=\\frac34\\times\\frac76\\\\\\frac34\\div\\frac67&=\\frac{1\\times7}{4\\times2}\\\\\\frac34\\div\\frac67&=\\frac78\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac56\\div\\frac5{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac56\\div\\frac5{12}&=\\frac56\\times\\frac{12}5\\\\\\frac56\\div\\frac5{12}&=\\frac{1\\times2}{1\\times1}\\\\\\frac56\\div\\frac5{12}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac34\\div\\frac68$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac34\\div\\frac68&=\\frac34\\times\\frac86\\\\\\frac34\\div\\frac68&=\\frac{1\\times2}{1\\times2}\\\\\\frac34\\div\\frac68&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\div\\frac23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}2\\div\\frac23&=2\\times\\frac32\\\\2\\div\\frac23&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac49\\div6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac2{27}$",
          "worked": "$$\\begin{align*}\\frac49\\div6&=\\frac49\\times\\frac16\\\\\\frac49\\div6&=\\frac{2\\times1}{9\\times3}\\\\\\frac49\\div6&=\\frac2{27}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$8\\div\\frac45$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}8\\div\\frac45&=8\\times\\frac54\\\\8\\div\\frac45&=2\\times5\\\\8\\div\\frac45&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac67\\div9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac2{21}$",
          "worked": "$$\\begin{align*}\\frac67\\div9&=\\frac67\\times\\frac19\\\\\\frac67\\div9&=\\frac{2\\times1}{7\\times3}\\\\\\frac67\\div9&=\\frac2{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac23\\div1\\frac16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac47$",
          "worked": "$$\\begin{align*}\\frac23\\div1\\frac16&=\\frac23\\div\\frac76\\\\\\frac23\\div1\\frac16&=\\frac23\\times\\frac67\\\\\\frac23\\div1\\frac16&=\\frac{2\\times2}{1\\times7}\\\\\\frac23\\div1\\frac16&=\\frac47\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$2\\frac13\\div1\\frac16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}2\\frac13\\div1\\frac16&=\\frac73\\div\\frac76\\\\2\\frac13\\div1\\frac16&=\\frac73\\times\\frac67\\\\2\\frac13\\div1\\frac16&=\\frac{1\\times2}{1\\times1}\\\\2\\frac13\\div1\\frac16&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$2\\frac16\\div2\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{26}{27}$",
          "worked": "$$\\begin{align*}2\\frac16\\div2\\frac14&=\\frac{13}6\\div\\frac94\\\\2\\frac16\\div2\\frac14&=\\frac{13}6\\times\\frac49\\\\2\\frac16\\div2\\frac14&=\\frac{13\\times2}{3\\times9}\\\\2\\frac16\\div2\\frac14&=\\frac{26}{27}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$4\\frac14\\div2\\frac18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}4\\frac14\\div2\\frac18&=\\frac{17}4\\div\\frac{17}8\\\\4\\frac14\\div2\\frac18&=\\frac{17}4\\times\\frac8{17}\\\\4\\frac14\\div2\\frac18&=\\frac{1\\times2}{1\\times1}\\\\4\\frac14\\div2\\frac18&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
