    "children": [
      {
        "id": "v2-ee583-p27-practice-slot-9-slot-9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the points of intersection of the line $y=x+1$ and the circle $x^2+y^2=25$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,4)$ and $(-4,-3)$.",
          "worked": "$$\\begin{align*}x^2+(x+1)^2&=25\\\\2x^2+2x-24&=0\\\\x^2+x-12&=0\\\\(x+4)(x-3)&=0\\\\x&=-4\\text{ or }3\\end{align*}$$\nWhen $x=-4$, $y=-4+1=-3$. When $x=3$, $y=3+1=4$.\nThe points are $(3,4)$ and $(-4,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-ee583-p27-practice-slot-9-slot-9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The line $y=2x-5$ intersects the circle $x^2+y^2=10$ at $P$ and $Q$. Find the length of $PQ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt5$ units.",
          "worked": "$$\\begin{align*}x^2+(2x-5)^2&=10\\\\5x^2-20x+15&=0\\\\x^2-4x+3&=0\\\\(x-1)(x-3)&=0\\\\x&=1\\text{ or }3\\end{align*}$$\nWhen $x=1$, $y=-3$. When $x=3$, $y=1$. So $P(1,-3)$ and $Q(3,1)$.\n$$\\begin{align*}PQ&=\\sqrt{(3-1)^2+(1-(-3))^2}\\\\&=\\sqrt{4+16}\\\\&=2\\sqrt5\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
