  "content": {
    "id": "p5-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Evaluate the following, without the use of a calculator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2(32)-\\log_2(64)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\log_2(32)-\\log_2(64)&=\\log_2\\left(\\frac{32}{64}\\right)\\\\\\log_2(32)-\\log_2(64)&=\\log_2(2^{-1})\\\\\\log_2(32)-\\log_2(64)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p5-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_5(100)-\\log_5(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_5(100)-\\log_5(4)&=\\log_5\\left(\\frac{100}{4}\\right)\\\\\\log_5(100)-\\log_5(4)&=\\log_5(5^2)\\\\\\log_5(100)-\\log_5(4)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p5-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{10}(\\sqrt{10})\\times\\log_{10}(\\sqrt[3]{10})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "The two roots are $10^{1/2}$ and $10^{1/3}$.\n\n$$\\begin{align*}\\log_{10}(\\sqrt{10})\\times\\log_{10}(\\sqrt[3]{10})&=\\frac{1}{2}\\times\\frac{1}{3}\\\\\\log_{10}(\\sqrt{10})\\times\\log_{10}(\\sqrt[3]{10})&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p5-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_3(\\sqrt{3})-\\log_3\\left(\\frac{1}{9}\\right)+\\log_3(27)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\frac{1}{2}$",
          "worked": "The arguments are $3^{1/2}$, $3^{-2}$ and $3^3$, in order.\n\n$$\\begin{align*}\\log_3(\\sqrt{3})-\\log_3\\left(\\frac{1}{9}\\right)+\\log_3(27)&=\\frac{1}{2}-(-2)+3\\\\\\log_3(\\sqrt{3})-\\log_3\\left(\\frac{1}{9}\\right)+\\log_3(27)&=5\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
