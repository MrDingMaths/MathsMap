  "content": {
    "id": "p11-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Suppose $\\cos\\theta=0.4$. Find each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos(\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.4$",
          "worked": "$$\\begin{align*}\\cos(\\pi-\\theta)&=-\\cos\\theta\\\\\\cos(\\pi-\\theta)&=-0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos(-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{align*}\\cos(-\\theta)&=\\cos\\theta\\\\\\cos(-\\theta)&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos(\\pi+\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.4$",
          "worked": "$$\\begin{align*}\\cos(\\pi+\\theta)&=-\\cos\\theta\\\\\\cos(\\pi+\\theta)&=-0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos(2\\pi+\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{align*}\\cos(2\\pi+\\theta)&=\\cos\\theta\\\\\\cos(2\\pi+\\theta)&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
