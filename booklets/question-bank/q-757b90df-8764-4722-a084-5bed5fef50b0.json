      {
        "id": "p45-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "$(4,\\infty]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,\\infty)$",
          "worked": "Replace $]$ with $)$. Infinity is not a number and cannot be included as an endpoint, so the interval is $(4,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p45-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "$b\\subseteq\\{a,b,c,d\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b\\in\\{a,b,c,d\\}$",
          "worked": "Replace $\\subseteq$ with $\\in$. The letter $b$ is a listed element, so $b\\in\\{a,b,c,d\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p45-q26-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\{1\\}\\in\\{1,2,3,4\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\{1\\}\\subseteq\\{1,2,3,4\\}$.",
          "worked": "One correction is $\\{1\\}\\subseteq\\{1,2,3,4\\}$: the only element of $\\{1\\}$ belongs to the right-hand set. Replacing $\\in$ with $\\subset$ or $\\notin$ also makes a true statement.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p45-q26-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\varnothing\\in\\{a,b,c\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\varnothing\\subseteq\\{a,b,c\\}$.",
          "worked": "One correction is $\\varnothing\\subseteq\\{a,b,c\\}$, because the empty set is a subset of every set. With $a$, $b$ and $c$ interpreted as the ordinary letter elements shown, replacing $\\in$ with $\\subset$ or $\\notin$ is also valid.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p45-q26-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\{1,2\\}\\ne\\{2,1\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\{1,2\\}=\\{2,1\\}$.",
          "worked": "Replace $\\ne$ with $=$: order does not matter, and both sets contain exactly $1$ and $2$. Replacing $\\ne$ with $\\subseteq$ or $\\supseteq$ also gives a true statement.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p45-q26-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\{1,1,2\\}\\ne\\{1,2\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\{1,1,2\\}=\\{1,2\\}$.",
          "worked": "Replace $\\ne$ with $=$: repeated elements do not change a set, so both sets have the distinct elements $1$ and $2$. Replacing $\\ne$ with $\\subseteq$ or $\\supseteq$ is also valid.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
