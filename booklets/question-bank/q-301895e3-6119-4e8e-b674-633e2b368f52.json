  "content": {
    "id": "p20-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The curved surface of a cone of base radius $4\\text{ cm}$ has surface area $40\\pi\\text{ cm}^2$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "the slant height of the cone",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\text{ cm}$",
          "worked": "$$\\begin{align*}4\\pi\\ell&=40\\pi\\\\\\ell&=\\frac{40\\pi}{4\\pi}\\\\\\ell&=10\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p20-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "the height of the cone, correct to four decimal places",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9.1652\\text{ cm}$",
          "worked": "By Pythagoras’ theorem:\n$$\\begin{align*}h^2+4^2&=10^2\\\\h^2&=84\\\\h&=\\sqrt{84}\\text{ cm}\\\\h&\\approx9.1652\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
