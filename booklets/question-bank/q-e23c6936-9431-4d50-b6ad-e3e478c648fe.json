  "content": {
    "id": "p14-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "An ant is moving on the $xy$-plane, starting at $(0,0)$. At each step, the ant can move one unit Up (U), or one unit Right (R). After $n$ steps, the ant is at $(5,7)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}n&=5+7\\\\n&=12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "How many R moves did the ant take?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Each R move increases the $x$-coordinate by one. The ant took $5$ R moves.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p14-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "How many possible paths could the ant have taken?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$792$",
          "worked": "Each path is an arrangement of five R’s and seven U’s.\n$$\\begin{align*}N&=\\frac{12!}{5!\\,7!}\\\\N&=792.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
