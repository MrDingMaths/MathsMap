  "content": {
    "id": "p7-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Mt Kosciusko has a height of 2228 m, while the height of Mt Everest is 8848 m. Calculate your answers to this question correct to 3 decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage is the height of Mt Everest of the height of Mt Kosciusko?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$397.713\\%$",
          "worked": "$\\frac{8848}{2228}\\times100\\%\\approx397.713\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "The Earth’s radius is about 6400 km. What percentage of the radius of the Earth is the height of Mt Everest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.138\\%$",
          "worked": "Use the same units: $6400\\text{ km}=6400000\\text{ m}$. Then $\\frac{8848}{6400000}\\times100\\%\\approx0.138\\%$.",
