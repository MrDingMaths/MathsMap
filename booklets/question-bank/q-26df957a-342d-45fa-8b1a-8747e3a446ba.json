    "children": [
      {
        "id": "p49-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Would you expect this city to be in the Northern or Southern Hemisphere?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Southern Hemisphere; temperatures are high in January.",
          "worked": "The temperatures are high in January and lowest around July. This matches summer in January and winter in July in the Southern Hemisphere.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p49-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Which trigonometric graph does this resemble? A cosine or sine graph?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cosine.",
          "worked": "The graph starts near a maximum, falls to a minimum, then rises to another maximum. It resembles a cosine graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p49-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "If temperatures of a city in the Northern hemisphere were graphed, what graph would you expect, and why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A vertically shifted negative cosine graph; January is near the winter minimum.",
          "worked": "Starting in January, temperatures would be near a winter minimum, rise to a summer maximum, then fall again. This resembles a vertically shifted negative cosine graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p49-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Estimate the difference between the highest and lowest temperatures, to the nearest degree Celsius.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $14^{\\circ}\\mathrm{C}$.",
          "worked": "The highest temperature is approximately $24^{\\circ}\\mathrm{C}$ and the lowest is approximately $10^{\\circ}\\mathrm{C}$.\n$$\\begin{align*}\\text{Difference}&\\approx24-10\\\\&=14^{\\circ}\\mathrm{C}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p49-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "What is the period of this graph?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 year (12 months).",
          "worked": "The troughs occur around July in successive years, 12 months apart. The period is 12 months, or 1 year.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
