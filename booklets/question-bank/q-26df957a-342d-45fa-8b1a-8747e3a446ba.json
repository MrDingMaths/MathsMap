        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"temperatureRed\",\"hex\":\"EF6068\",\"reason\":\"temperature data series and matching graph title\"},{\"name\":\"gridBlue\",\"hex\":\"D4E8FF\",\"reason\":\"source-supported pale blue graph grid\"}],\"reference\":\"source page 49 p49-q6-graph\"}\n\\begin{tikzpicture}[x=0.35cm,y=0.12cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{temperatureRed}{HTML}{EF6068}\n\\definecolor{gridBlue}{HTML}{D4E8FF}\n\\path[use as bounding box] (-5,-10) rectangle (29,37);\n\\draw[gridBlue,line width=0.25pt,xstep=2,ystep=5] (0,0) grid (28,30);\n\\draw[black,line width=0.5pt,->] (0,0)--(28,0);\n\\draw[black,line width=0.5pt,->] (0,0)--(0,30);\n\\foreach \\v in {0,5,10,15,20,25} {\n  \\draw[black,line width=0.4pt] (-0.35,\\v)--(0,\\v);\n  \\node[left] at (-0.35,\\v) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\v$\\special{dvisvgm:raw </g>}};\n}\n\\foreach \\x/\\m in {2/J,4/M,6/M,8/J,10/S,12/N,14/J,16/M,18/M,20/J,22/S,24/N,26/J} {\n  \\draw[black,line width=0.4pt] (\\x,0)--(\\x,-1.2);\n  \\node[below] at (\\x,-1.3) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\m\\special{dvisvgm:raw </g>}};\n}\n\\node[rotate=90] at (-4,15) {Temperature (${}^{\\circ}$C)};\n\\node at (14,-8) {Month};\n\\node[temperatureRed,font=\\bfseries] at (14,34) {Average monthly temperature};\n\\draw[temperatureRed,line width=0.8pt] plot coordinates {(2,23.2) (3,22.3) (4,20.1) (5,18.4) (6,11.7) (7,11.2) (8,10.2) (9,11.2) (10,12.0) (11,14.4) (12,18.5) (13,21.7) (14,24.4) (15,24.4) (16,21.7) (17,16.2) (18,13.2) (19,10.9) (20,10.2) (21,10.9) (22,13.2) (23,15.0) (24,19.0) (25,20.7)};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 110,
