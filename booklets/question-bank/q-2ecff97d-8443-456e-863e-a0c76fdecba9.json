      {
        "id": "p9-p2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(x+h)-f(x)=-\\frac{h}{x(x+h)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x+h)-f(x)=-\\frac{h}{x(x+h)}$",
          "worked": "$$\\begin{align*}f(x+h)-f(x)&=\\frac{1}{x+h}-\\frac1x\\\\f(x+h)-f(x)&=\\frac{x-(x+h)}{x(x+h)}\\\\f(x+h)-f(x)&=-\\frac{h}{x(x+h)}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p9-p2-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, differentiate $y=\\frac{1}{x}$ using first principles, and show that $f'(x)=-\\frac{1}{x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\frac{1}{x^2}$ for $x\\ne0$.",
          "worked": "For $x\\ne0$, use the difference from part (a) and cancel $h$ before evaluating the limit.\n\n$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{-h}{h\\,x(x+h)}\\\\f'(x)&=\\lim_{h\\to0}\\left(-\\frac{1}{x(x+h)}\\right)\\\\f'(x)&=-\\frac{1}{x^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
