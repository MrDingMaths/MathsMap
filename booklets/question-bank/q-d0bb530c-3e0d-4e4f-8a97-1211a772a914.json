  "content": {
    "id": "p8-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Differentiate $f^{-1}(x)$ given:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=e^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f^{-1})'(x)=\\dfrac1x$",
          "worked": "$$\\begin{aligned}f^{-1}(x)&=\\ln x\\\\(f^{-1})'(x)&=\\frac1x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\ln x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f^{-1})'(x)=e^x$",
          "worked": "$$\\begin{aligned}f^{-1}(x)&=e^x\\\\(f^{-1})'(x)&=e^x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f^{-1})'(x)=2x$",
          "worked": "$$\\begin{aligned}f^{-1}(x)&=x^2,\\quad x\\geq0\\\\(f^{-1})'(x)&=2x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^7-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f^{-1})'(x)=\\dfrac{1}{7\\sqrt[7]{(x+1)^6}}$, $x\\ne-1$.",
          "worked": "$$\\begin{aligned}f^{-1}(x)&=\\sqrt[7]{x+1}\\\\(f^{-1})'(x)&=\\frac17(x+1)^{-6/7}\\\\&=\\frac{1}{7\\sqrt[7]{(x+1)^6}},\\quad x\\ne-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p8-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=(x+2)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(f^{-1})'(x)=\\dfrac{1}{3\\sqrt[3]{x^2}}$, $x\\ne0$.",
          "worked": "$$\\begin{aligned}f^{-1}(x)&=\\sqrt[3]{x}-2\\\\(f^{-1})'(x)&=\\frac13x^{-2/3}\\\\&=\\frac{1}{3\\sqrt[3]{x^2}},\\quad x\\ne0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
