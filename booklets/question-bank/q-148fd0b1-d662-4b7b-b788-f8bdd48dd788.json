  "content": {
    "id": "p39-q51-root",
    "type": "question",
    "label": "51",
    "prompt": "The range of $f(x)=\\sin x+b\\cos x$ spans a distance of $6$ units. Find the possible values of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=\\pm2\\sqrt2$.",
      "worked": "The amplitude is $R=\\sqrt{1+b^2}$, so the range spans $2R$ units.\n$$\\begin{align*}2\\sqrt{1+b^2}&=6\\\\1+b^2&=9\\\\b^2&=8\\\\b&=\\pm2\\sqrt2.\\end{align*}$$",
      "solutionDiagrams": []
    },
