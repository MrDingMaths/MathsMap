  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "How many ways can you form an even three-digit number using the digits $\\{0,1,2,3,4,5\\}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "without further restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90$",
          "worked": "The final digit has 3 choices: 0, 2 or 4. The leading digit has 5 choices, since it cannot be zero. The middle digit has 6 choices. Repetition is allowed.\n\n$$N=5\\times6\\times3=90.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "without repetition",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$52$",
          "worked": "Case 1: the final digit is 0. There are 5 choices for the leading digit and then 4 choices for the middle digit.\n\n$$N_0=5\\times4\\times1=20.$$\n\nCase 2: the final digit is 2 or 4. There are 4 choices for the nonzero leading digit and then 4 choices for the middle digit, which may be zero.\n\n$$N_{2,4}=4\\times4\\times2=32.$$\n\nThe cases are disjoint, so\n\n$$N=20+32=52.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
