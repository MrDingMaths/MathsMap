  "content": {
    "id": "v2-a28b0-p33-practice-slot-8-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the points $A(-1,0)$, $B(5,0)$ and let $P(x,y)$ be a point.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a28b0-p33-practice-slot-8-lower-slot-8-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression for the gradients of $PA$ and $PB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{PA}=\\dfrac{y}{x+1},\\quad m_{PB}=\\dfrac{y}{x-5}$.",
          "worked": "$$\\begin{align*}m_{PA}&=\\frac{y-0}{x-(-1)}=\\frac{y}{x+1}\\\\m_{PB}&=\\frac{y-0}{x-5}=\\frac{y}{x-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-a28b0-p33-practice-slot-8-lower-slot-8-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose $\\angle APB=90^\\circ$. Show that $x^2-4x+y^2-5=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perpendicular gradients give $y^2=-(x+1)(x-5)$, hence $x^2-4x+y^2-5=0$.",
          "worked": "Perpendicular gradients have product $-1$.\n$$\\begin{align*}m_{PA}\\times m_{PB}&=-1\\\\\\frac{y}{x+1}\\times\\frac{y}{x-5}&=-1\\\\y^2&=-(x+1)(x-5)\\\\y^2&=-x^2+4x+5\\\\x^2-4x+y^2-5&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-a28b0-p33-practice-slot-8-lower-slot-8-lower-c",
        "type": "part",
        "label": "c",
        "prompt": "By completing the square, find the centre and radius of this circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(2,0)$, radius $3$.",
          "worked": "$$\\begin{align*}x^2-4x+4-4+y^2-5&=0\\\\(x-2)^2+y^2-9&=0\\\\(x-2)^2+y^2&=9\\end{align*}$$\nComparing with $(x-a)^2+(y-b)^2=r^2$, the centre is $(2,0)$ and the radius is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
