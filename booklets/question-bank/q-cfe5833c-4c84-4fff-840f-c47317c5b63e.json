  "content": {
    "id": "p28-q7",
    "type": "question",
    "label": "7",
    "prompt": "In a one-day cricket game, a batsman has a chance of $\\frac15$ of hitting a boundary every time he faces a ball. If he faces all six balls in an over, what is the probability that he will hit exactly two boundaries, assuming that successive strikes are independent?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.24576$",
      "worked": "Let $X$ be the number of boundaries. Then $X\\sim\\operatorname{Bin}(6,\\frac15)$.\n$$\\begin{align*}P(X=2)&=\\binom{6}{2}\\left(\\frac15\\right)^2\\left(\\frac45\\right)^4\\\\&=\\frac{768}{3125}\\\\&=0.24576\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
