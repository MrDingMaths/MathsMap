        "answer": {
          "short": "$0.7$",
          "worked": "From the table, $$\\begin{aligned}\\Pr(A)&=0.3+0.4\\\\\\Pr(A)&=0.7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\Pr(B\\mid A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{7}$",
          "worked": "$$\\begin{aligned}\\Pr(B\\mid A)&=\\frac{\\Pr(A\\cap B)}{\\Pr(A)}\\\\\\Pr(B\\mid A)&=\\frac{0.3}{0.7}\\\\\\Pr(B\\mid A)&=\\frac{3}{7}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\Pr(B\\mid A')$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "$$\\begin{aligned}\\Pr(B\\mid A')&=\\frac{\\Pr(A'\\cap B)}{\\Pr(A')}\\\\\\Pr(B\\mid A')&=\\frac{0.1}{0.3}\\\\\\Pr(B\\mid A')&=\\frac{1}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\Pr(A'\\mid B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.25$",
          "worked": "$$\\begin{aligned}\\Pr(A'\\mid B)&=\\frac{\\Pr(A'\\cap B)}{\\Pr(B)}\\\\\\Pr(A'\\mid B)&=\\frac{0.1}{0.4}\\\\\\Pr(A'\\mid B)&=0.25\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\Pr(A\\cup B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.8$",
          "worked": "$$\\begin{aligned}\\Pr(A\\cup B)&=1-\\Pr(A'\\cap B')\\\\\\Pr(A\\cup B)&=1-0.2\\\\\\Pr(A\\cup B)&=0.8\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
