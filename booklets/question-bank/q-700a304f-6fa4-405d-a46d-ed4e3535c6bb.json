        "children": [],
        "answer": {
          "short": "$x^2+2x-15=0$",
          "worked": "$\\begin{aligned}\\alpha+\\beta&=3-5=-2\\\\\\alpha\\beta&=3(-5)=-15\\end{aligned}$\n\n$\\begin{aligned}x^2-(-2)x-15&=0\\\\x^2+2x-15&=0\\end{aligned}$",
