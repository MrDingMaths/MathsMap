        "id": "p6-q2d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac25$ and $\\dfrac52$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10x^2-29x+10=0$",
          "worked": "$\\begin{aligned}\\alpha+\\beta&=\\frac25+\\frac52\\\\&=\\frac{4+25}{10}\\\\&=\\frac{29}{10}\\\\\\alpha\\beta&=\\frac25\\times\\frac52\\\\&=1\\end{aligned}$\n\n$\\begin{aligned}x^2-\\frac{29}{10}x+1&=0\\\\10x^2-29x+10&=0\\end{aligned}$",
