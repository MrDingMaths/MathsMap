        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-4x+1=0$",
          "worked": "$\\begin{aligned}\\alpha+\\beta&=(2+\\sqrt3)+(2-\\sqrt3)\\\\&=4\\\\\\alpha\\beta&=(2+\\sqrt3)(2-\\sqrt3)\\\\&=4-3\\\\&=1\\end{aligned}$\n\n$x^2-4x+1=0$",
          "solutionDiagrams": []
