    "children": [
      {
        "id": "p3-surds-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{\\sqrt5+\\sqrt2}{\\sqrt5-\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7+2\\sqrt{10}}3$\n\nMultiply numerator and denominator by $\\sqrt5+\\sqrt2$.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt5+\\sqrt2}{\\sqrt5-\\sqrt2}&=\\frac{(\\sqrt5+\\sqrt2)^2}{5-2}\\\\\\frac{\\sqrt5+\\sqrt2}{\\sqrt5-\\sqrt2}&=\\frac{5+2\\sqrt{10}+2}{3}\\\\\\frac{\\sqrt5+\\sqrt2}{\\sqrt5-\\sqrt2}&=\\frac{7+2\\sqrt{10}}3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p3-surds-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\sqrt3+\\sqrt2}{3\\sqrt3-2\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13+5\\sqrt6}{19}$\n\nMultiply numerator and denominator by $3\\sqrt3+2\\sqrt2$.",
          "worked": "$$\\begin{align*}\\frac{\\sqrt3+\\sqrt2}{3\\sqrt3-2\\sqrt2}&=\\frac{(\\sqrt3+\\sqrt2)(3\\sqrt3+2\\sqrt2)}{27-8}\\\\\\frac{\\sqrt3+\\sqrt2}{3\\sqrt3-2\\sqrt2}&=\\frac{9+2\\sqrt6+3\\sqrt6+4}{19}\\\\\\frac{\\sqrt3+\\sqrt2}{3\\sqrt3-2\\sqrt2}&=\\frac{13+5\\sqrt6}{19}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p3-surds-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2\\sqrt2+1}{\\sqrt6-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4\\sqrt3+4\\sqrt2+\\sqrt6+2}{2}$\n\nMultiply numerator and denominator by $\\sqrt6+2$.",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt2+1}{\\sqrt6-2}&=\\frac{(2\\sqrt2+1)(\\sqrt6+2)}{6-4}\\\\\\frac{2\\sqrt2+1}{\\sqrt6-2}&=\\frac{2\\sqrt{12}+4\\sqrt2+\\sqrt6+2}{2}\\\\\\frac{2\\sqrt2+1}{\\sqrt6-2}&=\\frac{4\\sqrt3+4\\sqrt2+\\sqrt6+2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p3-surds-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3\\sqrt{10}+2}{2\\sqrt5+\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14\\sqrt2-\\sqrt5}{9}$\n\nMultiply numerator and denominator by $2\\sqrt5-\\sqrt2$.",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt{10}+2}{2\\sqrt5+\\sqrt2}&=\\frac{(3\\sqrt{10}+2)(2\\sqrt5-\\sqrt2)}{20-2}\\\\\\frac{3\\sqrt{10}+2}{2\\sqrt5+\\sqrt2}&=\\frac{30\\sqrt2-6\\sqrt5+4\\sqrt5-2\\sqrt2}{18}\\\\\\frac{3\\sqrt{10}+2}{2\\sqrt5+\\sqrt2}&=\\frac{14\\sqrt2-\\sqrt5}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
