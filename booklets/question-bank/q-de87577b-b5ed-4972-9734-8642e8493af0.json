  "content": {
    "id": "v2-de2f7-p10-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "The angle between the two equal sides of an isosceles triangle is $52^{\\circ}$. Work out the size of the other two angles.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$64^{\\circ}$ and $64^{\\circ}$",
      "worked": "The other two angles are equal. Let each be $a^{\\circ}$.\n$$\\begin{align*}a+a+52&=180 &&\\text{(angle sum of a triangle)}\\\\2a+52&=180\\\\2a&=128\\\\a&=64\\end{align*}$$\nThe other two angles are $64^{\\circ}$ and $64^{\\circ}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
