  "content": {
    "id": "p42-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the equations of the tangent and normal to each curve at the point $T(4,2)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=\\frac{x}{4}+1$.\n\nNormal: $y=-4x+18$.",
          "worked": "$$\\begin{align*}y&=x^{1/2}\\\\\\frac{dy}{dx}&=\\frac12x^{-1/2}\\\\m_T&=\\frac12(4)^{-1/2}\\\\m_T&=\\frac14\\\\m_N&=-\\frac{1}{1/4}=-4\\end{align*}$$\nTangent through $T(4,2)$:\n$$\\begin{align*}y-2&=\\frac14(x-4)\\\\y&=\\frac{x}{4}+1\\end{align*}$$\nNormal through $T(4,2)$:\n$$\\begin{align*}y-2&=-4(x-4)\\\\y&=-4x+18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p42-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sqrt{8-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=-\\frac{x}{4}+3$.\n\nNormal: $y=4x-14$.",
          "worked": "$$\\begin{align*}y&=(8-x)^{1/2}\\\\\\frac{dy}{dx}&=\\frac12(8-x)^{-1/2}(-1)\\\\\\frac{dy}{dx}&=-\\frac12(8-x)^{-1/2}\\\\m_T&=-\\frac12(8-4)^{-1/2}\\\\m_T&=-\\frac14\\\\m_N&=-\\frac{1}{-1/4}=4\\end{align*}$$\nTangent through $T(4,2)$:\n$$\\begin{align*}y-2&=-\\frac14(x-4)\\\\y&=-\\frac{x}{4}+3\\end{align*}$$\nNormal through $T(4,2)$:\n$$\\begin{align*}y-2&=4(x-4)\\\\y&=4x-14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
