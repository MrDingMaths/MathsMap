  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A market researcher interviews 200 people and discovers that 120 of them use a particular brand of toothpaste. Using this data, what is the relative frequency of a person:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "using the particular brand of toothpaste",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "$$\\begin{align*}\\text{Relative frequency}&=\\frac{120}{200}\\\\\\text{Relative frequency}&=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "not using the particular brand of toothpaste?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "$200-120=80$ people do not use the brand.\n\n$$\\begin{align*}\\text{Relative frequency}&=\\frac{80}{200}\\\\\\text{Relative frequency}&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
