  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Solve each of the following equations by first cross multiplying:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x+2}{5}=\\frac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5,\\ 3$",
          "worked": "$$\\begin{align*}x(x+2)&=15\\\\x^2+2x&=15\\\\x^2+2x-15&=0\\\\(x+5)(x-3)&=0\\\\x&=-5,\\ 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x+3}{2}=\\frac{8}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5,\\ 5$",
          "worked": "$$\\begin{align*}(x+3)(x-3)&=16\\\\x^2-9&=16\\\\x^2-25&=0\\\\(x-5)(x+5)&=0\\\\x&=-5,\\ 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x+2}{9}=\\frac{4}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-8,\\ 4$",
          "worked": "$$\\begin{align*}(x+2)^2&=36\\\\x^2+4x+4&=36\\\\x^2+4x-32&=0\\\\(x+8)(x-4)&=0\\\\x&=-8,\\ 4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3x+1}{2}=\\frac{4}{5x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ -\\frac{11}{15}$",
          "worked": "$$\\begin{align*}(3x+1)(5x-3)&=8\\\\15x^2-4x-3&=8\\\\15x^2-4x-11&=0\\\\(15x+11)(x-1)&=0\\\\x&=1,\\ -\\frac{11}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x-6}{4}=-\\frac{3}{x+7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6,\\ 5$",
          "worked": "$$\\begin{align*}(x-6)(x+7)&=-12\\\\x^2+x-42&=-12\\\\x^2+x-30&=0\\\\(x+6)(x-5)&=0\\\\x&=-6,\\ 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2x+3}{3}=-\\frac{3}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ -\\frac12$",
          "worked": "$$\\begin{align*}(2x+3)(x-4)&=-9\\\\2x^2-5x-12&=-9\\\\2x^2-5x-3&=0\\\\(2x+1)(x-3)&=0\\\\x&=3,\\ -\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
