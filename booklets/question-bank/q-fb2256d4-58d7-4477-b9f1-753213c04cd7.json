  "content": {
    "id": "p10-q18-root",
    "type": "question",
    "label": null,
    "prompt": "A card is drawn from a standard deck of 52 cards. Find the probability that the card is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "black and a king",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{26}$",
          "worked": "There are two black kings.\n$$\\begin{align*}\\Pr(\\text{black and a king})&=\\frac{2}{52}\\\\\\Pr(\\text{black and a king})&=\\frac{1}{26}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "a heart and a spade",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No card is both a heart and a spade; these events are mutually exclusive.\n$$\\Pr(\\text{a heart and a spade})=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "a heart and a king",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{52}$",
          "worked": "Only the king of hearts satisfies both conditions.\n$$\\Pr(\\text{a heart and a king})=\\frac{1}{52}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p10-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "a king and a queen",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No card is both a king and a queen; these events are mutually exclusive.\n$$\\Pr(\\text{a king and a queen})=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-q18-e",
        "type": "part",
        "label": "e",
        "prompt": "red and black",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No card is both red and black; these events are mutually exclusive.\n$$\\Pr(\\text{red and black})=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-q18-f",
        "type": "part",
        "label": "f",
        "prompt": "red and a heart.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "All 13 hearts are red.\n$$\\begin{align*}\\Pr(\\text{red and a heart})&=\\frac{13}{52}\\\\\\Pr(\\text{red and a heart})&=\\frac{1}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
