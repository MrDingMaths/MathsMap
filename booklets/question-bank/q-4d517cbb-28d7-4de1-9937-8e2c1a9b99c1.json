              {
                "type": "text",
                "text": "Write the right-hand side in factorial form and factorise the common factorial expression.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}{}^{n}P_k+k\\,{}^{n}P_{k-1}&=\\frac{n!}{(n-k)!}+\\frac{k\\,n!}{(n-k+1)!}\\\\{}^{n}P_k+k\\,{}^{n}P_{k-1}&=\\frac{n!}{(n-k)!}\\left(1+\\frac{k}{n-k+1}\\right)\\\\{}^{n}P_k+k\\,{}^{n}P_{k-1}&=\\frac{n!}{(n-k)!}\\cdot\\frac{n+1}{n-k+1}\\\\{}^{n}P_k+k\\,{}^{n}P_{k-1}&=\\frac{(n+1)!}{(n-k+1)!}\\\\{}^{n}P_k+k\\,{}^{n}P_{k-1}&={}^{n+1}P_k.\\end{align*}$$",
      "solutionDiagrams": []
