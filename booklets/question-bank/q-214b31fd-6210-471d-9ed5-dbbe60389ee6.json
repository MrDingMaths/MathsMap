  "content": {
    "id": "p23-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Find the pair of numbers whose sum is 5 and whose difference is 6.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\frac12$ and $\\frac{11}{2}$.",
      "worked": "Let $x$ be the larger number and $y$ the smaller number.\n$$\\begin{align*}x+y&=5\\\\x-y&=6\\\\2x&=11\\\\x&=\\frac{11}{2}\\\\y&=5-\\frac{11}{2}\\\\y&=-\\frac12\\end{align*}$$\nThe numbers are $-\\frac12$ and $\\frac{11}{2}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 72
  },
