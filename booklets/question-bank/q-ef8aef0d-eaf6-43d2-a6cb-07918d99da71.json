            },
            {
              "type": "math",
              "latex": "\\frac{\\sin\\theta}{\\cos\\theta}=\\tan\\theta",
              "display": false
            },
            {
              "type": "text",
              "text": ". Use this to solve each equation for ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "0^\\circ\\le\\theta\\le360^\\circ",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
