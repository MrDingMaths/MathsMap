        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}5^{-\\log_5 2}&=\\frac{1}{5^{\\log_5 2}}\\\\5^{-\\log_5 2}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$12^{2\\log_{12}7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$49$",
          "worked": "$$\\begin{align*}12^{2\\log_{12}7}&=\\left(12^{\\log_{12}7}\\right)^2\\\\12^{2\\log_{12}7}&=7^2=49\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p23-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^{\\log_2 3+\\log_2 5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}2^{\\log_2 3+\\log_2 5}&=2^{\\log_2(3\\times5)}\\\\2^{\\log_2 3+\\log_2 5}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p23-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$a^{n\\log_a x}$",
