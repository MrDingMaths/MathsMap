  "content": {
    "id": "p18-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "What is the least integer greater than 12 which, when divided by 7, 9 and 12, leaves a remainder of 1 in each case?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$253$.\n\nFind the LCM of 7, 9 and 12, then add 1.",
      "worked": "Subtracting $1$ gives a positive common multiple of $7$, $9$ and $12$.\n$$\\begin{align*}\\operatorname{LCM}(7,9,12)&=2^2\\times3^2\\times7\\\\\\operatorname{LCM}(7,9,12)&=252\\end{align*}$$\nTherefore, the least qualifying integer greater than $12$ is\n$$252+1=253.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
