  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "This question has a mix of linear and quadratic equations.\nSolve each equation using an appropriate technique.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q5-three-column-group",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q5-a",
            "type": "part",
            "label": "a",
            "prompt": "$3x+3=2x+9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=6$",
              "worked": "$$\\begin{align*}3x-2x&=9-3\\\\x&=6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q5-b",
            "type": "part",
            "label": "b",
            "prompt": "$5x^2=3x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=0$ or $\\frac35$",
              "worked": "$$\\begin{align*}5x^2-3x&=0\\\\x(5x-3)&=0\\end{align*}$$\nBy the null factor law, $x=0$ or $5x-3=0$.\n$$x=0\\quad\\text{or}\\quad x=\\frac35$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p8-q5-c",
            "type": "part",
            "label": "c",
            "prompt": "$50-x^2=25-x-x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-25$",
              "worked": "$$\\begin{align*}50&=25-x\\\\x&=-25\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q5-d",
            "type": "part",
            "label": "d",
            "prompt": "$x^2-11x-12=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=12$ or $-1$",
              "worked": "The factors of $-12$ with sum $-11$ are $-12$ and $1$.\n$$(x-12)(x+1)=0$$\nBy the null factor law, $x-12=0$ or $x+1=0$.\n$$x=12\\quad\\text{or}\\quad x=-1$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p8-q5-e",
            "type": "part",
            "label": "e",
            "prompt": "$x^2+10x=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=0$ or $-10$",
              "worked": "$$x(x+10)=0$$\nBy the null factor law, $x=0$ or $x+10=0$.\n$$x=0\\quad\\text{or}\\quad x=-10$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p8-q5-f",
            "type": "part",
            "label": "f",
            "prompt": "$3(3x+5)+6=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-2$",
              "worked": "$$\\begin{align*}9x+15+6&=3\\\\9x&=-18\\\\x&=-2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p8-q5-g",
            "type": "part",
            "label": "g",
            "prompt": "$(y+2)^2=y^2+13$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac94$",
              "worked": "$$\\begin{align*}y^2+4y+4&=y^2+13\\\\4y&=9\\\\y&=\\frac94\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p8-q5-h",
            "type": "part",
            "label": "h",
            "prompt": "$8x^2-2x-3=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-\\frac12$ or $\\frac34$",
              "worked": "$P=-24$, $S=-2$, $F=-6,4$.\n$$\\begin{align*}8x^2-6x+4x-3&=0\\\\2x(4x-3)+(4x-3)&=0\\\\(2x+1)(4x-3)&=0\\end{align*}$$\nBy the null factor law, $2x+1=0$ or $4x-3=0$.\n$$x=-\\frac12\\quad\\text{or}\\quad x=\\frac34$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 56
          },
          {
            "id": "p8-q5-i",
            "type": "part",
            "label": "i",
            "prompt": "$3x^2+27x+42=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-7$ or $-2$",
              "worked": "$$\\begin{align*}x^2+9x+14&=0\\\\(x+7)(x+2)&=0\\end{align*}$$\nBy the null factor law, $x+7=0$ or $x+2=0$.\n$$x=-7\\quad\\text{or}\\quad x=-2$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p8-q5-j",
            "type": "part",
            "label": "j",
            "prompt": "$2x-9=\\frac{x}{4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\frac{36}{7}$",
              "worked": "$$\\begin{align*}8x-36&=x\\\\7x&=36\\\\x&=\\frac{36}{7}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p8-q5-k",
            "type": "part",
            "label": "k",
            "prompt": "$(x-3)(x+5)=-16$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-1$",
              "worked": "$$\\begin{align*}x^2+2x-15&=-16\\\\x^2+2x+1&=0\\\\(x+1)^2&=0\\\\x&=-1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p8-q5-l",
            "type": "part",
            "label": "l",
            "prompt": "$6x^2=x+2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-\\frac12$ or $\\frac23$",
              "worked": "$$6x^2-x-2=0$$\n$P=-12$, $S=-1$, $F=-4,3$.\n$$\\begin{align*}6x^2-4x+3x-2&=0\\\\2x(3x-2)+(3x-2)&=0\\\\(2x+1)(3x-2)&=0\\end{align*}$$\nBy the null factor law, $2x+1=0$ or $3x-2=0$.\n$$x=-\\frac12\\quad\\text{or}\\quad x=\\frac23$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 62
          },
          {
            "id": "p8-q5-m",
            "type": "part",
            "label": "m",
            "prompt": "$(b+5)^2=(b+1)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b=-3$",
              "worked": "$$\\begin{align*}b^2+10b+25&=b^2+2b+1\\\\8b&=-24\\\\b&=-3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p8-q5-n",
            "type": "part",
            "label": "n",
            "prompt": "$x^3-6x^2+8x=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=0,2$ or $4$. Factorise as $x(x-2)(x-4)=0$.",
              "worked": "$$\\begin{align*}x(x^2-6x+8)&=0\\\\x(x-2)(x-4)&=0\\end{align*}$$\nBy the null factor law, $x=0$, $x-2=0$ or $x-4=0$.\n$$x=0,\\ 2\\ \\text{or}\\ 4$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p8-q5-o",
            "type": "part",
            "label": "o",
            "prompt": "$4x(x+1)=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\frac12$ or $-\\frac32$",
              "worked": "$$4x^2+4x-3=0$$\n$P=-12$, $S=4$, $F=6,-2$.\n$$\\begin{align*}4x^2+6x-2x-3&=0\\\\2x(2x+3)-(2x+3)&=0\\\\(2x-1)(2x+3)&=0\\end{align*}$$\nBy the null factor law, $2x-1=0$ or $2x+3=0$.\n$$x=\\frac12\\quad\\text{or}\\quad x=-\\frac32$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 62
          }
        ]
      },
      {
        "id": "p8-q5-two-column-group",
        "type": "group",
        "label": "",
