        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q5-p",
            "type": "part",
            "label": "p",
            "prompt": "Solve for $x$.\n$(a+2)(x-4)=(a+3)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\frac{a^2+10a+17}{a+2}$ for $a\\ne-2$. For $a=-2$, there is no solution.",
              "worked": "For $a\\ne-2$:\n$$\\begin{align*}x-4&=\\frac{(a+3)^2}{a+2}\\\\x&=\\frac{(a+3)^2+4(a+2)}{a+2}\\\\x&=\\frac{a^2+10a+17}{a+2}\\end{align*}$$\nFor $a=-2$, the original equation becomes $0=1$, so there is no solution.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          },
          {
            "id": "p8-q5-q",
            "type": "part",
            "label": "q",
            "prompt": "$(2y+3)^2=(y+1)(y-3)+3y^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-\\frac67$",
              "worked": "$$\\begin{align*}4y^2+12y+9&=y^2-2y-3+3y^2\\\\4y^2+12y+9&=4y^2-2y-3\\\\14y&=-12\\\\y&=-\\frac67\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          }
        ]
      }
    ]
