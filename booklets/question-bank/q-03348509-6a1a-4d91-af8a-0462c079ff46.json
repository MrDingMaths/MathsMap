  "content": {
    "id": "p10-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A bag contains one red, two blue and three green marbles. If one marble is drawn from the bag, find the probability that it is red or blue.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{2}$",
      "worked": "There are $1+2+3=6$ marbles. Red and blue are mutually exclusive outcomes.\n\n$$\\begin{align*}\\Pr(\\text{red or blue})&=\\Pr(\\text{red})+\\Pr(\\text{blue})\\\\\\Pr(\\text{red or blue})&=\\frac{1}{6}+\\frac{2}{6}\\\\\\Pr(\\text{red or blue})&=\\frac{1}{2}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
