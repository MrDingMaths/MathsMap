      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$49^{\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}49^{\\frac{1}{2}}&=\\sqrt{49}\\\\49^{\\frac{1}{2}}&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$125^{\\frac{1}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}125^{\\frac{1}{3}}&=\\sqrt[3]{125}\\\\125^{\\frac{1}{3}}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$8^{\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}8^{\\frac{2}{3}}&=(\\sqrt[3]{8})^2\\\\8^{\\frac{2}{3}}&=2^2\\\\8^{\\frac{2}{3}}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(9^3)^{\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "$$\\begin{align*}(9^3)^{\\frac{1}{2}}&=9^{\\frac{3}{2}}\\\\(9^3)^{\\frac{1}{2}}&=(\\sqrt{9})^3\\\\(9^3)^{\\frac{1}{2}}&=3^3\\\\(9^3)^{\\frac{1}{2}}&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{125}{64}\\right)^{\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{16}$",
          "worked": "$$\\begin{align*}\\left(\\frac{125}{64}\\right)^{\\frac{2}{3}}&=\\left(\\frac{\\sqrt[3]{125}}{\\sqrt[3]{64}}\\right)^2\\\\\\left(\\frac{125}{64}\\right)^{\\frac{2}{3}}&=\\left(\\frac54\\right)^2\\\\\\left(\\frac{125}{64}\\right)^{\\frac{2}{3}}&=\\frac{25}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(-8)^{\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$\n\nTake the real cube root of $-8$, then square it.",
          "worked": "$$\\begin{align*}(-8)^{\\frac{2}{3}}&=(\\sqrt[3]{-8})^2\\\\(-8)^{\\frac{2}{3}}&=(-2)^2\\\\(-8)^{\\frac{2}{3}}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
