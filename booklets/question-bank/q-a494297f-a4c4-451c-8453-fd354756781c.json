  "content": {
    "id": "p25-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Simplify the following expressions:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a a^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n$",
          "worked": "For $a>0$ and $a\\ne1$:\n$$\\begin{align*}x&=\\log_a a^n\\\\a^x&=a^n\\\\x&=n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{(a^n)}a$ ($n\\ne0$; $a>0$, $a\\ne1$).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1n$",
          "worked": "$$\\begin{align*}x&=\\log_{(a^n)}a\\\\(a^n)^x&=a\\\\a^{nx}&=a^1\\\\nx&=1\\\\x&=\\frac1n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a\\dfrac1{a^n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-n$",
          "worked": "For $a>0$ and $a\\ne1$:\n$$\\begin{align*}x&=\\log_a\\frac1{a^n}\\\\a^x&=\\frac1{a^n}\\\\a^x&=a^{-n}\\\\x&=-n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{a^n}\\dfrac1a$ ($n\\ne0$; $a>0$, $a\\ne1$).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac1n$",
          "worked": "$$\\begin{align*}x&=\\log_{a^n}\\frac1a\\\\(a^n)^x&=\\frac1a\\\\a^{nx}&=a^{-1}\\\\nx&=-1\\\\x&=-\\frac1n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
