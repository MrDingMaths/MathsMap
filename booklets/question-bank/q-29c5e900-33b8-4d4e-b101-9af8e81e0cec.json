          "inlines": [
            {
              "type": "text",
              "text": "Two particles ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "A",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "B",
              "display": false
            },
            {
              "type": "text",
              "text": " move simultaneously on the same straight line. Their displacements are given by",
              "marks": []
            }
          ]
        },
        {
          "id": "p85-q28-functions",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}x_A(t)&=t+\\sqrt{2t}\\\\x_B(t)&=-t+\\sqrt{2t}+1\\end{aligned}",
              "display": true
            }
          ]
        },
        {
          "id": "p85-q28-time",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "t",
              "display": false
            },
            {
              "type": "text",
              "text": " is time, measured in seconds.",
              "marks": []
            }
          ]
        },
        {
          "id": "p85-q28-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Determine if the particles will collide. If they do, find where this occurs and their speeds then.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
