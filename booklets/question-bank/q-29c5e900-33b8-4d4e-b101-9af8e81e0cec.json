    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p85-q28-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Yes. They collide at ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "t=\\tfrac12",
                "display": false
              },
              {
                "type": "text",
                "text": " s and position ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=\\tfrac32",
                "display": false
              },
              {
                "type": "text",
                "text": "; their speeds are ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "|v_A|=2",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "|v_B|=0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p85-q28-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Equating displacements gives the collision time; take the magnitudes of both derivatives for the speeds.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p85-q28-worked-collision",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}x_A(t)=x_B(t)&\\iff t+\\sqrt{2t}=-t+\\sqrt{2t}+1\\\\2t&=1\\\\t&=\\frac12\\text{ s}\\\\x_A\\!\\left(\\frac12\\right)&=\\frac12+1=\\frac32.\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p85-q28-worked-speeds",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}v_A(t)&=x_A'(t)=1+\\frac1{\\sqrt{2t}}\\\\v_B(t)&=x_B'(t)=-1+\\frac1{\\sqrt{2t}}\\\\\\left|v_A\\!\\left(\\frac12\\right)\\right|&=2\\\\\\left|v_B\\!\\left(\\frac12\\right)\\right|&=0.\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
      },
