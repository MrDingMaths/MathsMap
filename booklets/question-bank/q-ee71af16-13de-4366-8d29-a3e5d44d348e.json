    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5.36\\text{ km/L}$",
      "worked": "$$\\begin{align*}\\text{Fuel consumed} &= 56-\\frac{3}{4}\\times56\\\\\\text{Fuel consumed} &= 56-42\\\\\\text{Fuel consumed} &= 14\\text{ L}\\\\\\text{Fuel consumption rate} &= \\frac{75\\text{ km}}{14\\text{ L}}\\\\\\text{Fuel consumption rate} &\\approx 5.36\\text{ km/L}\\end{align*}$$",
      "solutionDiagrams": []
    },
