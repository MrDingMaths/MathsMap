  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Two dice are rolled and the sum of the values on the uppermost faces is noted. Find the probability that the sum is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{12}$",
          "worked": "The $36$ ordered outcomes are equally likely. The outcomes with sum $10$ are $(4,6)$, $(5,5)$ and $(6,4)$.\n$$\\begin{align*}P(\\text{sum }10)&=\\frac{3}{36}\\\\P(\\text{sum }10)&=\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{36}$",
          "worked": "Only $(6,6)$ has sum $12$, out of $36$ equally likely ordered outcomes.\n$$P(\\text{sum }12)=\\frac{1}{36}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "less than $9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{18}$",
          "worked": "The numbers of ordered outcomes for sums $2,3,4,5,6,7,8$ are respectively $1,2,3,4,5,6,5$.\n$$\\begin{align*}P(\\text{sum less than }9)&=\\frac{1+2+3+4+5+6+5}{36}\\\\P(\\text{sum less than }9)&=\\frac{26}{36}\\\\P(\\text{sum less than }9)&=\\frac{13}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
