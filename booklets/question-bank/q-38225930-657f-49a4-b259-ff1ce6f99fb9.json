                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(F)&=\\frac{3}{1000},\\qquad P(N)=\\frac{997}{1000}\\\\P(X=0)&=P(NN)=\\frac{997}{1000}\\times\\frac{997}{1000}=\\frac{994009}{1000000}\\\\P(X=1)&=P(FN)+P(NF)\\\\P(X=1)&=\\frac{3}{1000}\\times\\frac{997}{1000}+\\frac{997}{1000}\\times\\frac{3}{1000}=\\frac{5982}{1000000}\\\\P(X=2)&=P(FF)=\\frac{3}{1000}\\times\\frac{3}{1000}=\\frac{9}{1000000}\\end{aligned}",
                    "display": true
                  }
                ]
