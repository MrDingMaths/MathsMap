  "content": {
    "id": "p38-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Write down the new equation obtained when the following translation is applied to $f(x)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q5a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2x$, translate left 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+4$",
          "worked": "Replace $x$ with $x+2$.\n$$\\begin{align*}y&=2(x+2)\\\\y&=2x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p38-q5b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2x$, translate down 3 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-3$",
          "worked": "Replace $y$ with $y+3$.\n$$\\begin{align*}y+3&=2x\\\\y&=2x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p38-q5c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{1}{x-1}$, translate left 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{x+1}$",
          "worked": "Replace $x$ with $x+2$.\n$$\\begin{align*}y&=\\frac{1}{(x+2)-1}\\\\y&=\\frac{1}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q5d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{1}{x-1}$, translate down 3 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{x-1}-3$",
          "worked": "Replace $y$ with $y+3$.\n$$\\begin{align*}y+3&=\\frac{1}{x-1}\\\\y&=\\frac{1}{x-1}-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q5e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=2x^2$, translate right 4 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2(x-4)^2$",
          "worked": "Replace $x$ with $x-4$.\n$$y=2(x-4)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p38-q5f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=2x^2$, translate up 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x^2+2$",
          "worked": "Replace $y$ with $y-2$.\n$$\\begin{align*}y-2&=2x^2\\\\y&=2x^2+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p38-q5g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=3-2x$, translate up 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=5-2x$",
          "worked": "Replace $y$ with $y-2$.\n$$\\begin{align*}y-2&=3-2x\\\\y&=5-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p38-q5h",
        "type": "part",
        "label": "h",
        "prompt": "$f(x)=3-2x$, translate left 3 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x-3$",
          "worked": "Replace $x$ with $x+3$.\n$$\\begin{align*}y&=3-2(x+3)\\\\y&=3-2x-6\\\\y&=-2x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
