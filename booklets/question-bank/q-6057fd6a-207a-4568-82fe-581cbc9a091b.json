  "content": {
    "id": "v2-72eaf-p23-practice-slot-13-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Solve $\\sin(2\\theta+30^\\circ)=\\dfrac{\\sqrt3}{2}$ for $0^\\circ\\le\\theta<360^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\theta=15^\\circ,\\ 45^\\circ,\\ 195^\\circ,\\ 225^\\circ$",
      "worked": "Let $u=2\\theta+30^\\circ$.\n$$\\begin{aligned}30^\\circ&\\le 2\\theta+30^\\circ<750^\\circ\\\\30^\\circ&\\le u<750^\\circ\\end{aligned}$$\n$$\\sin u=\\frac{\\sqrt3}{2}$$\nThe reference angle is $60^\\circ$. Sine is positive in quadrants I and II.\n$$\\begin{aligned}u&=60^\\circ,\\ 120^\\circ,\\ 420^\\circ,\\ 480^\\circ\\\\2\\theta+30^\\circ&=60^\\circ,\\ 120^\\circ,\\ 420^\\circ,\\ 480^\\circ\\\\2\\theta&=30^\\circ,\\ 90^\\circ,\\ 390^\\circ,\\ 450^\\circ\\\\\\theta&=15^\\circ,\\ 45^\\circ,\\ 195^\\circ,\\ 225^\\circ\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
