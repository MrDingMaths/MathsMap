  "content": {
    "id": "p14-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Show that $A(2,5)$, $B(3,7)$, $C(-4,-1)$ and $D(-5,2)$ do not form a parallelogram.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$M_{AC}=(-1,2)$ and $M_{BD}=\\left(-1,\\frac{9}{2}\\right)$. The diagonals do not bisect each other, so $ABCD$ is not a parallelogram.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p14-q6-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\text{Midpoint of }AC&=\\left(\\frac{2+(-4)}{2},\\frac{5+(-1)}{2}\\right)=(-1,2)\\\\[4pt]\\text{Midpoint of }BD&=\\left(\\frac{3+(-5)}{2},\\frac{7+2}{2}\\right)=\\left(-1,\\frac{9}{2}\\right)\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p14-q6-answer-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Diagonals do not bisect each other, so ",
