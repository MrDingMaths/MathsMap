      {
        "id": "p17-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $(1+2x)^5$ as far as the term in $x^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+10x+40x^2+80x^3+\\cdots$",
          "worked": "$$\\begin{aligned}(1+2x)^5&=1+\\binom51(2x)+\\binom52(2x)^2+\\binom53(2x)^3+\\cdots\\\\&=1+10x+40x^2+80x^3+\\cdots.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p17-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the coefficient of $x^3$ in the expansion of $(2-3x)(1+2x)^5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$",
          "worked": "$$(2-3x)(1+2x)^5=(2-3x)(1+10x+40x^2+80x^3+\\cdots).$$\nCoefficient of $x^3$:\n$$\\begin{aligned}2(80)+(-3)(40)&=160-120\\\\&=40.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
