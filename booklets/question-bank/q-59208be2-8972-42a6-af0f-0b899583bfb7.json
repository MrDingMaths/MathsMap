  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "For each problem, write an equation and find the unknown number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2a",
        "type": "part",
        "label": "a",
        "prompt": "When half of a number is subtracted from two-thirds of the same number, the result is 10.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{3}-\\frac{x}{2}=10$, $x=60$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}\\frac{2x}{3}-\\frac{x}{2}&=10\\\\4x-3x&=60\\\\x&=60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q2b",
        "type": "part",
        "label": "b",
        "prompt": "Ten is subtracted from a number, and the result is multiplied by $-5$. The result of this is 30.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5(x-10)=30$, $x=4$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}-5(x-10)&=30\\\\x-10&=-6\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q2c",
        "type": "part",
        "label": "c",
        "prompt": "Six is added to two-thirds of a number, and the result is $-10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{3}+6=-10$, $x=-24$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}\\frac{2x}{3}+6&=-10\\\\\\frac{2x}{3}&=-16\\\\2x&=-48\\\\x&=-24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q2d",
        "type": "part",
        "label": "d",
        "prompt": "Two-thirds is subtracted from half of a number, and the result is $-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{2}-\\frac{2}{3}=-1$, $x=-\\frac{2}{3}$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}\\frac{x}{2}-\\frac{2}{3}&=-1\\\\\\frac{x}{2}&=-1+\\frac{2}{3}\\\\\\frac{x}{2}&=-\\frac{1}{3}\\\\x&=-\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
