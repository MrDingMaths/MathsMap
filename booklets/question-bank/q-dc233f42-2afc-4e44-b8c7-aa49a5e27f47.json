  "content": {
    "id": "p37-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A fair die is rolled 5 times. Each roll is either a six (success) or not a six (failure). Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "the first two rolls are sixes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{36}$",
          "worked": "The final three rolls are unrestricted.\n$$\\begin{align*}P(\\text{first two rolls are sixes})&=\\frac16\\times\\frac16\\\\P(\\text{first two rolls are sixes})&=\\frac1{36}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p37-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "the first two rolls are sixes, and the next three rolls are not",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{125}{7776}$",
          "worked": "$$\\begin{align*}P(\\text{SSFFF})&=\\left(\\frac16\\right)^2\\left(\\frac56\\right)^3\\\\P(\\text{SSFFF})&=\\frac{125}{7776}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "we obtain exactly two sixes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{625}{3888}$",
          "worked": "Let $X$ count the sixes. There are $\\binom52$ choices for their positions.\n$$\\begin{align*}P(X=2)&=\\binom52\\left(\\frac16\\right)^2\\left(\\frac56\\right)^3\\\\P(X=2)&=10\\times\\frac{125}{7776}\\\\P(X=2)&=\\frac{625}{3888}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p37-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "at least one roll is a six.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4651}{7776}$",
          "worked": "Let $X$ count the sixes. Use the complement, no sixes.\n$$\\begin{align*}P(X\\ge1)&=1-P(X=0)\\\\P(X\\ge1)&=1-\\left(\\frac56\\right)^5\\\\P(X\\ge1)&=1-\\frac{3125}{7776}\\\\P(X\\ge1)&=\\frac{4651}{7776}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
