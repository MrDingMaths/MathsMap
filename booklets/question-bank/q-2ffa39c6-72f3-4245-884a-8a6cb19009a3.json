  "content": {
    "id": "p19-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Express the following improper fractions as mixed numerals, and then decide which of each pair is larger.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{13}{6}$ and $\\frac{17}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{6}=2\\frac{1}{6}$ and $\\frac{17}{8}=2\\frac{1}{8}$. Larger: $\\frac{13}{6}$.",
          "worked": "$$\\begin{align*}\\frac{13}{6}&=2\\frac{1}{6}\\\\\\frac{17}{8}&=2\\frac{1}{8}\\\\\\frac{1}{6}&=\\frac{4}{24}\\\\\\frac{1}{8}&=\\frac{3}{24}\\end{align*}$$\nBoth whole parts are 2, and $\\frac{4}{24}>\\frac{3}{24}$, so $\\frac{13}{6}>\\frac{17}{8}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p19-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{21}{4}$ and $\\frac{47}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{4}=5\\frac{1}{4}$ and $\\frac{47}{8}=5\\frac{7}{8}$. Larger: $\\frac{47}{8}$.",
          "worked": "$$\\begin{align*}\\frac{21}{4}&=5\\frac{1}{4}\\\\\\frac{47}{8}&=5\\frac{7}{8}\\\\\\frac{1}{4}&=\\frac{2}{8}\\end{align*}$$\nBoth whole parts are 5, and $\\frac{2}{8}<\\frac{7}{8}$, so $\\frac{47}{8}$ is larger.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p19-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{12}{11}$ and $\\frac{3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12}{11}=1\\frac{1}{11}$ and $\\frac{3}{2}=1\\frac{1}{2}$. Larger: $\\frac{3}{2}$.",
          "worked": "$$\\begin{align*}\\frac{12}{11}&=1\\frac{1}{11}\\\\\\frac{3}{2}&=1\\frac{1}{2}\\\\\\frac{1}{11}&=\\frac{2}{22}\\\\\\frac{1}{2}&=\\frac{11}{22}\\end{align*}$$\nBoth whole parts are 1, and $\\frac{2}{22}<\\frac{11}{22}$, so $\\frac{3}{2}$ is larger.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p19-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{107}{25}$ and $\\frac{57}{14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{107}{25}=4\\frac{7}{25}$ and $\\frac{57}{14}=4\\frac{1}{14}$. Larger: $\\frac{107}{25}$.",
          "worked": "$$\\begin{align*}\\frac{107}{25}&=4\\frac{7}{25}\\\\\\frac{57}{14}&=4\\frac{1}{14}\\\\\\frac{7}{25}&=\\frac{98}{350}\\\\\\frac{1}{14}&=\\frac{25}{350}\\end{align*}$$\nBoth whole parts are 4, and $98>25$, so $\\frac{107}{25}$ is larger.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p19-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{130}{64}$ and $\\frac{101}{50}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{130}{64}=2\\frac{1}{32}$ and $\\frac{101}{50}=2\\frac{1}{50}$. Larger: $\\frac{130}{64}$.",
          "worked": "$$\\begin{align*}\\frac{130}{64}&=2\\frac{2}{64}=2\\frac{1}{32}\\\\\\frac{101}{50}&=2\\frac{1}{50}\\\\\\frac{1}{32}&=\\frac{25}{800}\\\\\\frac{1}{50}&=\\frac{16}{800}\\end{align*}$$\nBoth whole parts are 2, and $25>16$, so $\\frac{130}{64}$ is larger.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p19-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{143}{12}$ and $\\frac{143}{13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{143}{12}=11\\frac{11}{12}$ and $\\frac{143}{13}=11$. Larger: $\\frac{143}{12}$.",
          "worked": "$$\\begin{align*}\\frac{143}{12}&=11\\frac{11}{12}\\\\\\frac{143}{13}&=11\\end{align*}$$\nSince $11\\frac{11}{12}>11$, $\\frac{143}{12}$ is larger.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
