    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$9^{-\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "$$\\begin{align*}9^{-\\frac{1}{2}}&=\\frac{1}{\\sqrt9}\\\\9^{-\\frac{1}{2}}&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{25}$",
          "worked": "$$\\begin{align*}5^{-2}&=\\frac{1}{5^2}\\\\5^{-2}&=\\frac{1}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{3^{-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "$$\\begin{align*}\\frac{1}{3^{-3}}&=3^3\\\\\\frac{1}{3^{-3}}&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac25\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{4}$",
          "worked": "$$\\begin{align*}\\left(\\frac25\\right)^{-2}&=\\left(\\frac52\\right)^2\\\\\\left(\\frac25\\right)^{-2}&=\\frac{25}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\frac{1}{25}\\right)^{-\\frac{3}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125$\n\nTake the reciprocal of the base, then take the square root and cube it.",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{25}\\right)^{-\\frac{3}{2}}&=25^{\\frac{3}{2}}\\\\\\left(\\frac{1}{25}\\right)^{-\\frac{3}{2}}&=(\\sqrt{25})^3\\\\\\left(\\frac{1}{25}\\right)^{-\\frac{3}{2}}&=5^3\\\\\\left(\\frac{1}{25}\\right)^{-\\frac{3}{2}}&=125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^{-\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}4^{-\\frac{1}{2}}&=\\frac{1}{\\sqrt4}\\\\4^{-\\frac{1}{2}}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$125^{-\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{25}$",
          "worked": "$$\\begin{align*}125^{-\\frac{2}{3}}&=\\frac{1}{(\\sqrt[3]{125})^2}\\\\125^{-\\frac{2}{3}}&=\\frac{1}{5^2}\\\\125^{-\\frac{2}{3}}&=\\frac{1}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$8^{-3}\\times 2^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$\n\nWrite $8$ as $2^3$ to combine the powers of $2$.",
          "worked": "$$\\begin{align*}8^{-3}\\times2^8&=2^{-9}\\times2^8\\\\8^{-3}\\times2^8&=2^{-9+8}\\\\8^{-3}\\times2^8&=2^{-1}\\\\8^{-3}\\times2^8&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
