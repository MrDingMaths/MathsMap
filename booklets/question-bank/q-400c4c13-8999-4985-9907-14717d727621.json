  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "For the graph with equation $y=3x^2-2x-1$, find the coordinates of the:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "vertex",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac13,-\\frac43\\right)$",
          "worked": "The axis of symmetry is\n$$\\begin{align*}x&=-\\frac{-2}{2\\times3}\\\\x&=\\frac13.\\end{align*}$$\nSubstituting $x=\\frac13$:\n$$\\begin{align*}y&=3\\left(\\frac13\\right)^2-2\\left(\\frac13\\right)-1\\\\y&=\\frac13-\\frac23-1\\\\y&=-\\frac43.\\end{align*}$$\nThe vertex is $\\left(\\frac13,-\\frac43\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$x$-intercepts",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac13,0\\right)$ and $(1,0)$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}3x^2-2x-1&=0\\\\(3x+1)(x-1)&=0.\\end{align*}$$\nThus $3x+1=0$ or $x-1=0$, giving $x=-\\frac13$ or $x=1$.\nThe intercepts are $\\left(-\\frac13,0\\right)$ and $(1,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
