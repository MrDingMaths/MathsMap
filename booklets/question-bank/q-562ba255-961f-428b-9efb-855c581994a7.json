  "content": {
    "id": "p9-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Tim can ride 100 m in 15 seconds on his bike. Assuming he continues at the same speed, how many kilometres can he travel in 30 minutes?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\text{ km}$",
      "worked": "$$\\begin{align*}\\text{Time in seconds}&=30\\times60=1800\\\\\\text{Distance in 1 second}&=\\frac{100}{15}\\text{ m}\\\\\\text{Distance in 1800 seconds}&=\\frac{100}{15}\\times1800\\text{ m}\\\\\\text{Distance in 1800 seconds}&=12000\\text{ m}\\\\\\text{Distance in kilometres}&=12000\\div1000=12\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
