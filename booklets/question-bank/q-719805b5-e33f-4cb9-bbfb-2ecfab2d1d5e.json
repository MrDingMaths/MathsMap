    "children": [
      {
        "id": "p31-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^1\\frac{dx}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.6931$",
          "worked": "$$\\begin{align*}\\int_0^1\\frac{dx}{x+1}&=[\\ln|x+1|]_0^1\\\\\\int_0^1\\frac{dx}{x+1}&=\\ln2-\\ln1\\\\\\int_0^1\\frac{dx}{x+1}&=\\ln2\\\\\\int_0^1\\frac{dx}{x+1}&\\approx0.6931\\end{align*}$$\nTo 4 significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p31-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_{-7}^{-5}\\frac{dx}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.5108$",
          "worked": "$$\\begin{align*}\\int_{-7}^{-5}\\frac{dx}{x+2}&=[\\ln|x+2|]_{-7}^{-5}\\\\\\int_{-7}^{-5}\\frac{dx}{x+2}&=\\ln3-\\ln5\\\\\\int_{-7}^{-5}\\frac{dx}{x+2}&=\\ln\\frac35\\\\\\int_{-7}^{-5}\\frac{dx}{x+2}&\\approx-0.5108\\end{align*}$$\nTo 4 significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p31-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{-5}^{-2}\\frac{dx}{2x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.9730$",
          "worked": "$$\\begin{align*}\\int_{-5}^{-2}\\frac{dx}{2x+3}&=\\left[\\frac12\\ln|2x+3|\\right]_{-5}^{-2}\\\\\\int_{-5}^{-2}\\frac{dx}{2x+3}&=\\frac12(\\ln1-\\ln7)\\\\\\int_{-5}^{-2}\\frac{dx}{2x+3}&=-\\frac12\\ln7\\\\\\int_{-5}^{-2}\\frac{dx}{2x+3}&\\approx-0.9730\\end{align*}$$\nTo 4 significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p31-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_1^2\\frac{3}{5-2x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.648$",
          "worked": "$$\\begin{align*}\\int_1^2\\frac{3}{5-2x}\\,dx&=\\left[-\\frac32\\ln|5-2x|\\right]_1^2\\\\\\int_1^2\\frac{3}{5-2x}\\,dx&=-\\frac32(\\ln1-\\ln3)\\\\\\int_1^2\\frac{3}{5-2x}\\,dx&=\\frac32\\ln3\\\\\\int_1^2\\frac{3}{5-2x}\\,dx&\\approx1.648\\end{align*}$$\nTo 4 significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p31-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_{-1}^{1}\\frac{3}{7-3x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9163$",
          "worked": "$$\\begin{align*}\\int_{-1}^{1}\\frac{3}{7-3x}\\,dx&=[-\\ln|7-3x|]_{-1}^{1}\\\\\\int_{-1}^{1}\\frac{3}{7-3x}\\,dx&=-\\ln4+\\ln10\\\\\\int_{-1}^{1}\\frac{3}{7-3x}\\,dx&=\\ln\\frac52\\\\\\int_{-1}^{1}\\frac{3}{7-3x}\\,dx&\\approx0.9163\\end{align*}$$\nTo 4 significant figures.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p31-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_0^{11}\\frac{5}{2x-11}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Undefined.",
          "worked": "$$\\begin{align*}2x-11&=0\\\\x&=\\frac{11}{2}\\end{align*}$$\nThe integrand has a vertical asymptote at $x=\\frac{11}{2}$ inside $[0,11]$. The improper integral does not converge, so the definite integral is undefined.",
          "solutionDiagrams": []
        },
