            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Three pieces are 14 m each; the fourth piece is 8 m.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p76-q25-answer-check",
            "type": "paragraph",
            "fontSize": null,
