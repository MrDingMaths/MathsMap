            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The shorter piece is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "14-6=8",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " m.",
                "marks": [],
                "colour": "#268cff"
