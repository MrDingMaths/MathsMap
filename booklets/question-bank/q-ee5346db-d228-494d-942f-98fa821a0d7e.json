  "content": {
    "id": "p76-q25-response",
    "type": "question",
    "label": "25",
    "prompt": "A 50 m long rope is cut into four pieces.\nThree of them are equal but the other is 6 m shorter. How long are the pieces?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Three pieces are 14 m each and one piece is 8 m.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p76-q25-answer-definition",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "x",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " be the length of each longer piece, in metres.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p76-q25-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
