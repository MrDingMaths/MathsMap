            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}x+x+x+(x-6)&=50\\\\4x-6&=50\\\\4x&=56\\\\x&=14\\end{align*}",
                "display": false,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p76-q25-answer-shorter",
            "type": "paragraph",
