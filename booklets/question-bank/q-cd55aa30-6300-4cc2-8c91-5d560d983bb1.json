        "answer": {
          "short": "$\\mathrm{LHS}=6$, $\\mathrm{RHS}=6$; $6\\leq6$.\n\nSubstitute the given values, evaluate each side separately using absolute values, then compare the results.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=|2+4|\\\\&=6\\end{align*}$$$$\\begin{align*}\\mathrm{RHS}&=|2|+|4|\\\\&=2+4\\\\&=6\\end{align*}$$Hence $6\\leq6$, so the inequality holds.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$a=-1,\\ b=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=3$, $\\mathrm{RHS}=3$; $3\\leq3$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=|-1+(-2)|\\\\&=|-3|\\\\&=3\\end{align*}$$$$\\begin{align*}\\mathrm{RHS}&=|-1|+|-2|\\\\&=1+2\\\\&=3\\end{align*}$$Hence $3\\leq3$, so the inequality holds.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$a=-2,\\ b=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1$, $\\mathrm{RHS}=5$; $1\\leq5$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=|-2+3|\\\\&=|1|\\\\&=1\\end{align*}$$$$\\begin{align*}\\mathrm{RHS}&=|-2|+|3|\\\\&=2+3\\\\&=5\\end{align*}$$Hence $1\\leq5$, so the inequality holds.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$a=-4,\\ b=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=1$, $\\mathrm{RHS}=9$; $1\\leq9$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=|-4+5|\\\\&=|1|\\\\&=1\\end{align*}$$$$\\begin{align*}\\mathrm{RHS}&=|-4|+|5|\\\\&=4+5\\\\&=9\\end{align*}$$Hence $1\\leq9$, so the inequality holds.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$a=-7,\\ b=-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=10$, $\\mathrm{RHS}=10$; $10\\leq10$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=|-7+(-3)|\\\\&=|-10|\\\\&=10\\end{align*}$$$$\\begin{align*}\\mathrm{RHS}&=|-7|+|-3|\\\\&=7+3\\\\&=10\\end{align*}$$Hence $10\\leq10$, so the inequality holds.",
          "solutionDiagrams": []
