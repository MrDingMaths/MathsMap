  "content": {
    "id": "p9-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Use a product-to-sum formula to rewrite each of the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin4\\theta\\sin2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(\\cos2\\theta-\\cos6\\theta)$",
          "worked": "$$\\begin{align*}\\sin4\\theta\\sin2\\theta&=\\frac12[\\cos(4\\theta-2\\theta)-\\cos(4\\theta+2\\theta)]\\\\\\sin4\\theta\\sin2\\theta&=\\frac12(\\cos2\\theta-\\cos6\\theta).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin\\theta\\sin3\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(\\cos2\\theta-\\cos4\\theta)$",
          "worked": "$$\\begin{align*}\\sin\\theta\\sin3\\theta&=\\frac12[\\cos(\\theta-3\\theta)-\\cos(\\theta+3\\theta)]\\\\\\sin\\theta\\sin3\\theta&=\\frac12[\\cos(-2\\theta)-\\cos4\\theta]\\\\\\sin\\theta\\sin3\\theta&=\\frac12(\\cos2\\theta-\\cos4\\theta).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos2\\theta\\cos\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(\\cos\\theta+\\cos3\\theta)$",
          "worked": "$$\\begin{align*}\\cos2\\theta\\cos\\theta&=\\frac12[\\cos(2\\theta-\\theta)+\\cos(2\\theta+\\theta)]\\\\\\cos2\\theta\\cos\\theta&=\\frac12(\\cos\\theta+\\cos3\\theta).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos4\\theta\\cos2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(\\cos2\\theta+\\cos6\\theta)$",
          "worked": "$$\\begin{align*}\\cos4\\theta\\cos2\\theta&=\\frac12[\\cos(4\\theta-2\\theta)+\\cos(4\\theta+2\\theta)]\\\\\\cos4\\theta\\cos2\\theta&=\\frac12(\\cos2\\theta+\\cos6\\theta).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos2\\theta\\sin3\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(\\sin\\theta+\\sin5\\theta)$",
          "worked": "$$\\begin{align*}\\cos2\\theta\\sin3\\theta&=\\frac12[\\sin(3\\theta+2\\theta)+\\sin(3\\theta-2\\theta)]\\\\\\cos2\\theta\\sin3\\theta&=\\frac12(\\sin5\\theta+\\sin\\theta).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sin3\\theta\\cos4\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(\\sin7\\theta-\\sin\\theta)$",
          "worked": "$$\\begin{align*}\\sin3\\theta\\cos4\\theta&=\\frac12[\\sin(3\\theta+4\\theta)+\\sin(3\\theta-4\\theta)]\\\\\\sin3\\theta\\cos4\\theta&=\\frac12[\\sin7\\theta+\\sin(-\\theta)]\\\\\\sin3\\theta\\cos4\\theta&=\\frac12(\\sin7\\theta-\\sin\\theta).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
