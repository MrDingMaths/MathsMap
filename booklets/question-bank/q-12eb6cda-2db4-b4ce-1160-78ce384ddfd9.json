  "content": {
    "id": "p11-q41-group-root",
    "type": "question",
    "label": "11",
    "prompt": "Factorise the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q41-response",
        "type": "part",
        "label": "a",
        "prompt": "$81-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(9-x)(9+x)$",
          "worked": "$$\\begin{align*}81-x^2&=9^2-x^2\\\\81-x^2&=(9-x)(9+x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q42-response",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x+3)$",
          "worked": "$$\\begin{align*}x^2-9&=x^2-3^2\\\\x^2-9&=(x-3)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q43-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x^2}{25}-\\frac{y^2}{36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac{x}{5}-\\frac{y}{6}\\right)\\left(\\frac{x}{5}+\\frac{y}{6}\\right)$",
          "worked": "$$\\begin{align*}\\frac{x^2}{25}-\\frac{y^2}{36}&=\\left(\\frac{x}{5}\\right)^2-\\left(\\frac{y}{6}\\right)^2\\\\\\frac{x^2}{25}-\\frac{y^2}{36}&=\\left(\\frac{x}{5}-\\frac{y}{6}\\right)\\left(\\frac{x}{5}+\\frac{y}{6}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q44-response",
        "type": "part",
        "label": "d",
        "prompt": "$4a^2-25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2a-5)(2a+5)$",
          "worked": "$$\\begin{align*}4a^2-25&=(2a)^2-5^2\\\\4a^2-25&=(2a-5)(2a+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q45-response",
        "type": "part",
        "label": "e",
        "prompt": "$48x^2-27y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(4x-3y)(4x+3y)$\n\nTake out $3$, then factorise the difference of squares.",
          "worked": "$$\\begin{align*}48x^2-27y^2&=3(16x^2-9y^2)\\\\48x^2-27y^2&=3\\big((4x)^2-(3y)^2\\big)\\\\48x^2-27y^2&=3(4x-3y)(4x+3y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q46-response",
        "type": "part",
        "label": "f",
        "prompt": "$32m^2-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(4m-1)(4m+1)$\n\nTake out $2$, then factorise the difference of squares.",
          "worked": "$$\\begin{align*}32m^2-2&=2(16m^2-1)\\\\32m^2-2&=2\\big((4m)^2-1^2\\big)\\\\32m^2-2&=2(4m-1)(4m+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q47-response",
        "type": "part",
        "label": "g",
        "prompt": "$x^4-y^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+y^2)(x-y)(x+y)$\n\nApply the difference-of-squares formula twice.",
          "worked": "$$\\begin{align*}x^4-y^4&=(x^2-y^2)(x^2+y^2)\\\\x^4-y^4&=(x^2+y^2)(x-y)(x+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q48-response",
        "type": "part",
        "label": "h",
        "prompt": "$45p^2-5q^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(3p-q)(3p+q)$\n\nTake out $5$, then factorise the difference of squares.",
          "worked": "$$\\begin{align*}45p^2-5q^2&=5(9p^2-q^2)\\\\45p^2-5q^2&=5\\big((3p)^2-q^2\\big)\\\\45p^2-5q^2&=5(3p-q)(3p+q)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
