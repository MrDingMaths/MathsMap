  "content": {
    "id": "v2-659a8-p11-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "A jeweller weighs a ring as $6.5\\text{ g}$, to the nearest $0.1\\text{ g}$. A baker weighs flour as $750\\text{ g}$, to the nearest $10\\text{ g}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-659a8-p11-practice-slot-4-s4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the percentage error of each measurement. Answer to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Ring: $0.77\\%$; flour: $0.67\\%$",
          "worked": "$$\\begin{align*}\\text{Ring: absolute error}&=\\tfrac12\\times0.1=0.05\\text{ g}\\\\\\text{Percentage error}&=\\frac{0.05}{6.5}\\times100\\%\\approx0.77\\%\\\\\\text{Flour: absolute error}&=\\tfrac12\\times10=5\\text{ g}\\\\\\text{Percentage error}&=\\frac{5}{750}\\times100\\%\\approx0.67\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-659a8-p11-practice-slot-4-s4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Which measurement has the greater percentage error?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The ring",
          "worked": "$$0.77\\%>0.67\\%$$ so the ring measurement has the greater percentage error, even though its absolute error is smaller.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
