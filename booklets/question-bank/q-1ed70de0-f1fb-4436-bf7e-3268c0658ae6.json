    "children": [],
    "answer": {
      "short": "$1072\\text{ cm}^3$",
      "worked": "$\\begin{aligned}r&=16\\div2=8\\text{ cm}\\\\V&=\\frac12\\times\\frac43\\pi r^3\\\\&=\\frac12\\times\\frac43\\pi(8)^3\\\\&=\\frac{1024\\pi}{3}\\text{ cm}^3\\\\&\\approx1072\\text{ cm}^3\\end{aligned}$",
      "solutionDiagrams": []
    },
