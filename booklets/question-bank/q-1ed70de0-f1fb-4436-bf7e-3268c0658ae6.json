    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A bowl is in the shape of a hemisphere with a diameter of $16\\text{ cm}$.\nWhat is the volume of the bowl, correct to the nearest cubic centimetre?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
