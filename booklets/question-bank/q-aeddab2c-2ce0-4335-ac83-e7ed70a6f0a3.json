        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}(7-8)\\times(3-4)&=(-1)\\times(-1)\\\\(7-8)\\times(3-4)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
