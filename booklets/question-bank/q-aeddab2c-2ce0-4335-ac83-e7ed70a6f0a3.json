          "short": "$-1$",
          "worked": "$$\\begin{align*}(3-4)\\times(-5+6)&=(-1)\\times1\\\\(3-4)\\times(-5+6)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
