        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}(2\\times(-5))-((-4)\\times3)&=-10-(-12)\\\\(2\\times(-5))-((-4)\\times3)&=2\\end{align*}$$",
          "solutionDiagrams": []
