          "short": "$-15$",
          "worked": "$$\\begin{align*}6+(7\\times(-3))&=6+(-21)\\\\6+(7\\times(-3))&=-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
