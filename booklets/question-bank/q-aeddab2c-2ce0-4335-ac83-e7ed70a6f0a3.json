        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}(5\\times2)-12&=10-12\\\\(5\\times2)-12&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$6+(7\\times(-3))$",
