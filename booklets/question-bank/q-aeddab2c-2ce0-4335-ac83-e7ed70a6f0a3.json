          "short": "$-18$",
          "worked": "$$\\begin{align*}(3\\times4)-(5\\times6)&=12-30\\\\(3\\times4)-(5\\times6)&=-18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2\\times(-5))-((-4)\\times3)$",
