  "content": {
    "id": "p2-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "In a co-educational school of 1029 pupils, 504 are girls. What is the ratio of the number of girls to the number of boys?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$24:25$",
      "worked": "$$\\begin{aligned}\\text{Number of boys}&=1029-504=525\\\\\\text{Girls:boys}&=504:525\\\\\\text{Girls:boys}&=24:25\\quad(\\div21).\\end{aligned}$$",
