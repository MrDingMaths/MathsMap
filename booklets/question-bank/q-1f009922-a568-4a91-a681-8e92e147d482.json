    "type": "question",
    "label": "11",
    "prompt": "$5(2x+1)+c(x+d)=12x-1$\n\nWhat is the value of $c$ and $d$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c=2,\\ d=-3$",
      "worked": "$$\\begin{align*}5(2x+1)+c(x+d)&=10x+5+cx+cd\\\\&=(10+c)x+5+cd\\end{align*}$$\nCompare coefficients of $x$:\n$$\\begin{align*}10+c&=12\\\\c&=2\\end{align*}$$\nCompare constants and substitute $c=2$:\n$$\\begin{align*}5+2d&=-1\\\\2d&=-6\\\\d&=-3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
