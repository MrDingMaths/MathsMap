  "content": {
    "id": "p7-f1-root",
    "type": "question",
    "label": "1",
    "prompt": "Complete the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-f1-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^m\\times a^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{m+n}$",
          "worked": "Add the indices of powers with the same base. $a^m\\times a^n=a^{m+n}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-f1-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^m\\div a^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{m-n}$",
          "worked": "Subtract the divisor's index from the dividend's index. For $a\\ne0$, $a^m\\div a^n=a^{m-n}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-f1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(a^m)^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{mn}$",
          "worked": "Multiply the indices when raising a power to a power. $(a^m)^n=a^{mn}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-f1-d",
        "type": "part",
        "label": "d",
        "prompt": "$a^{\\frac{m}{n}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[n]{a^m}$",
          "worked": "The numerator gives the power and the denominator gives the root. $$\\begin{align*}a^{\\frac{m}{n}}&=(a^m)^{\\frac{1}{n}}\\\\a^{\\frac{m}{n}}&=\\sqrt[n]{a^m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-f1-e",
        "type": "part",
        "label": "e",
        "prompt": "$a^0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "For $a\\ne0$, the quotient $a\\div a$ is $1$ and has index $1-1=0$. Hence $a^0=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-f1-f",
        "type": "part",
        "label": "f",
        "prompt": "$a^{\\frac{1}{n}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[n]{a}$",
          "worked": "An index of $\\frac{1}{n}$ gives the $n$th root. $a^{\\frac{1}{n}}=\\sqrt[n]{a}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-f1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(ab)^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^nb^n$",
          "worked": "Apply the power to each factor. $(ab)^n=a^nb^n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-f1-h",
        "type": "part",
        "label": "h",
        "prompt": "$a^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a}$",
          "worked": "For $a\\ne0$, a negative index gives the reciprocal of the corresponding positive power. $a^{-1}=\\frac{1}{a}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
