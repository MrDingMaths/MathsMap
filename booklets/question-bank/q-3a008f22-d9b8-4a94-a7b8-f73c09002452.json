  "content": {
    "id": "p8-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "The area of a rectangle is $6x^2\\text{ cm}^2$. The width of the rectangle is $5\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the length of the rectangle, in terms of $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6x^2}{5}\\text{ cm}$",
          "worked": "Length is area divided by width.\n$$\\begin{align*}l&=\\frac{A}{w}\\\\l&=\\frac{6x^2}{5}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the length of the rectangle if $x=4$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19\\dfrac{1}{5}\\text{ cm}$",
          "worked": "$$\\begin{align*}l&=\\frac{6\\times4^2}{5}\\text{ cm}\\\\l&=\\frac{96}{5}\\text{ cm}\\\\l&=19\\frac{1}{5}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
