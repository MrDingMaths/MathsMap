    "type": "question",
    "label": "10",
    "prompt": "Two cards are selected at random without replacement from a standard pack, and the number of hearts is recorded. Find the expected value.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$E(X)=\\frac12$ heart.",
      "worked": {
        "format": "maths-editor-document-v1",
