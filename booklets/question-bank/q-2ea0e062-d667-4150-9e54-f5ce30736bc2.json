            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}P(X=0)&=\\frac{39}{52}\\times\\frac{38}{51}=\\frac{19}{34}\\\\P(X=1)&=\\frac{13}{52}\\times\\frac{39}{51}+\\frac{39}{52}\\times\\frac{13}{51}=\\frac{13}{34}\\\\P(X=2)&=\\frac{13}{52}\\times\\frac{12}{51}=\\frac{1}{17}\\end{aligned}",
                "display": true
              }
