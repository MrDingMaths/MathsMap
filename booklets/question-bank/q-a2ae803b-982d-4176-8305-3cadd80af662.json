  "content": {
    "id": "p23-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Each time she throws a dart, the probability that Mary hits the dartboard is $\\frac{2}{7}$.\n\nShe throws two darts, one after the other.\n\nWhat is the probability that she hits the dartboard with both darts?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{4}{49}$, assuming the throws are independent.",
      "worked": "Assuming the throws are independent,\n$$\\begin{align*}P(\\text{both hits}) &= P(\\text{first hit})\\times P(\\text{second hit})\\\\&=\\frac{2}{7}\\times\\frac{2}{7}\\\\&=\\frac{4}{49}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
