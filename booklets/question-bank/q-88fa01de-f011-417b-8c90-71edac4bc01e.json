      {
        "id": "p24-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt5+\\sqrt3)^2+(\\sqrt5-\\sqrt3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$\\begin{align*}(\\sqrt5+\\sqrt3)^2+(\\sqrt5-\\sqrt3)^2&=(5+2\\sqrt{15}+3)+(5-2\\sqrt{15}+3)\\\\(\\sqrt5+\\sqrt3)^2+(\\sqrt5-\\sqrt3)^2&=8+8\\\\(\\sqrt5+\\sqrt3)^2+(\\sqrt5-\\sqrt3)^2&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p24-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt5+\\sqrt3)^2-(\\sqrt5-\\sqrt3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{15}$",
          "worked": "$$\\begin{align*}(\\sqrt5+\\sqrt3)^2-(\\sqrt5-\\sqrt3)^2&=(8+2\\sqrt{15})-(8-2\\sqrt{15})\\\\(\\sqrt5+\\sqrt3)^2-(\\sqrt5-\\sqrt3)^2&=8+2\\sqrt{15}-8+2\\sqrt{15}\\\\(\\sqrt5+\\sqrt3)^2-(\\sqrt5-\\sqrt3)^2&=4\\sqrt{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p24-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\sqrt3+\\sqrt2)^2+(\\sqrt3-\\sqrt2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}(\\sqrt3+\\sqrt2)^2+(\\sqrt3-\\sqrt2)^2&=(3+2\\sqrt6+2)+(3-2\\sqrt6+2)\\\\(\\sqrt3+\\sqrt2)^2+(\\sqrt3-\\sqrt2)^2&=5+5\\\\(\\sqrt3+\\sqrt2)^2+(\\sqrt3-\\sqrt2)^2&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p24-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$(\\sqrt3+\\sqrt2)^2-(\\sqrt3-\\sqrt2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt6$",
          "worked": "$$\\begin{align*}(\\sqrt3+\\sqrt2)^2-(\\sqrt3-\\sqrt2)^2&=(5+2\\sqrt6)-(5-2\\sqrt6)\\\\(\\sqrt3+\\sqrt2)^2-(\\sqrt3-\\sqrt2)^2&=5+2\\sqrt6-5+2\\sqrt6\\\\(\\sqrt3+\\sqrt2)^2-(\\sqrt3-\\sqrt2)^2&=4\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt7-\\sqrt2)^2+(\\sqrt7+\\sqrt2)^2$",
        "layout": "list",
        "columns": null,
