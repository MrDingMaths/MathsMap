        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}(\\sqrt7-\\sqrt2)^2+(\\sqrt7+\\sqrt2)^2&=(7-2\\sqrt{14}+2)+(7+2\\sqrt{14}+2)\\\\(\\sqrt7-\\sqrt2)^2+(\\sqrt7+\\sqrt2)^2&=9+9\\\\(\\sqrt7-\\sqrt2)^2+(\\sqrt7+\\sqrt2)^2&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
