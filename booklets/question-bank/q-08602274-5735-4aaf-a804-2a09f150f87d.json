  "content": {
    "id": "p33-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A medicine bottle is in the shape of a cylinder with base diameter 50 mm and height 80 mm. If the normal dosage of medicine is 15 mL, how many dosages can be obtained from the bottle? (Assume that initially the bottle is completely full.)",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "10 complete dosages.",
      "worked": "The radius is 25 mm, so $V=\\pi(25)^2(80)=50\\,000\\pi\\text{ mm}^3=50\\pi\\text{ mL}$. Dividing by 15 gives $\\frac{50\\pi}{15}\\approx10.47$ doses. Therefore 10 complete 15 mL dosages can be obtained.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 14
  },
