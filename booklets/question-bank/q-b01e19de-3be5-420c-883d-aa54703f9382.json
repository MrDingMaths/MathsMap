  "content": {
    "id": "v2-p37-practice-slot-20-root",
    "type": "question",
    "label": null,
    "prompt": "Ava gets to school by bus, by train or on foot.\nThe probability that she takes the bus is 0.45.\nThe probability that she takes the train is 0.27.\nWhat is the probability that she walks?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.28$",
      "worked": "$$\\begin{align*}P(\\text{walks})&=1-\\bigl(P(\\text{bus})+P(\\text{train})\\bigr)\\\\P(\\text{walks})&=1-(0.45+0.27)\\\\P(\\text{walks})&=1-0.72\\\\P(\\text{walks})&=0.28\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
