  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A coin and a die are tossed. Use the product rule to find the probability of obtaining:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "a three and a head",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{12}$",
          "worked": "$$\\begin{align*}P(3\\text{ and }H)&=P(3)\\times P(H)\\\\P(3\\text{ and }H)&=\\frac{1}{6}\\times\\frac{1}{2}\\\\P(3\\text{ and }H)&=\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "a six and a tail",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{12}$",
          "worked": "$$\\begin{align*}P(6\\text{ and }T)&=P(6)\\times P(T)\\\\P(6\\text{ and }T)&=\\frac{1}{6}\\times\\frac{1}{2}\\\\P(6\\text{ and }T)&=\\frac{1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "an even number and a tail",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}P(\\text{even and }T)&=P(\\text{even})\\times P(T)\\\\P(\\text{even and }T)&=\\frac{3}{6}\\times\\frac{1}{2}\\\\P(\\text{even and }T)&=\\frac{3}{12}\\\\P(\\text{even and }T)&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p20-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "a number less than five and a head",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "$$\\begin{align*}P(<5\\text{ and }H)&=P(<5)\\times P(H)\\\\P(<5\\text{ and }H)&=\\frac{4}{6}\\times\\frac{1}{2}\\\\P(<5\\text{ and }H)&=\\frac{4}{12}\\\\P(<5\\text{ and }H)&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
