              "type": "text",
              "text": "Which two whole numbers, neither ending in zero, equal 1 000 000 000 when multiplied?",
              "marks": []
            }
          ]
        },
        {
          "id": "p63-q18-hint",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
