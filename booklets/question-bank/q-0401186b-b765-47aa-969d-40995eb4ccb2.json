  "content": {
    "id": "v2-139c65-p5-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Parabolas A, B and C each have the equation $y=ax^{2}$.\n\nA passes through $(4,8)$, B passes through $(2,8)$ and C passes through $(3,3)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-139c65-p5-practice-slot-2-slot-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $a$ for each parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A: $a=\\frac12$. B: $a=2$. C: $a=\\frac13$.",
          "worked": "$$\\begin{align*}\\text{A: } 8&=a(4)^2\\\\8&=16a\\\\a&=\\frac12\\\\\\text{B: } 8&=a(2)^2\\\\8&=4a\\\\a&=2\\\\\\text{C: } 3&=a(3)^2\\\\3&=9a\\\\a&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-139c65-p5-practice-slot-2-slot-2-b",
        "type": "part",
        "label": "b",
        "prompt": "List the parabolas from narrowest to widest.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "B, A, C.",
          "worked": "A larger coefficient of $x^2$ gives a narrower parabola. Since $2>\\frac12>\\frac13$, the order from narrowest to widest is B, A, C.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
