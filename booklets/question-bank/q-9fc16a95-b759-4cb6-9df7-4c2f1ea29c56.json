  "content": {
    "id": "p19-f2",
    "type": "question",
    "label": "2",
    "prompt": "The following are variations of the statement of the quotient rule.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-f2-a",
        "type": "part",
        "label": "a",
        "prompt": "If $u$ and $v$ are functions of $x$ and $y=\\frac{u}{v}$, then $y'=\\frac{vu'-\\left(\\hspace{14mm}\\right)}{\\left(\\hspace{14mm}\\right)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{vu'-uv'}{v^2}$",
          "worked": "$$y'=\\frac{vu'-uv'}{v^2}$$ Multiply the derivative of the numerator by the denominator, subtract the numerator times the derivative of the denominator, then divide by the square of the denominator. Here $v\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p19-f2-b",
        "type": "part",
        "label": "b",
        "prompt": "If $u$ and $v$ are functions of $x$, then $\\frac{d}{dx}\\left(\\frac{u}{v}\\right)=\\frac{v\\frac{du}{dx}-\\left(\\hspace{24mm}\\right)}{\\left(\\hspace{14mm}\\right)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d}{dx}\\left(\\frac{u}{v}\\right)=\\frac{v\\frac{du}{dx}-u\\frac{dv}{dx}}{v^2}$",
          "worked": "$$\\frac{d}{dx}\\left(\\frac{u}{v}\\right)=\\frac{v\\frac{du}{dx}-u\\frac{dv}{dx}}{v^2}$$ The term subtracted is $u$ times the derivative of $v$. The denominator is $v^2$, where $v\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p19-f2-c",
        "type": "part",
        "label": "c",
        "prompt": "If $h(x)=\\frac{f(x)}{g(x)}$, then $h'(x)=\\frac{g(x)f'(x)-\\left(\\hspace{29mm}\\right)}{\\left(\\hspace{15mm}\\right)^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h'(x)=\\frac{g(x)f'(x)-f(x)g'(x)}{(g(x))^2}$",
          "worked": "$$h'(x)=\\frac{g(x)f'(x)-f(x)g'(x)}{(g(x))^2}$$ The term subtracted is $f(x)g'(x)$, and the denominator is the square of $g(x)$. The rule applies where $g(x)\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
  },
