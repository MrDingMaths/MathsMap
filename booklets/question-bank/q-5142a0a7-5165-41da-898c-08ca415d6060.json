  "content": {
    "id": "v2-11f0f-p40-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Find the points of intersection of $y=x^2+3x$ and $y=2$, making use of the quadratic formula.\nLeave answers in exact surd form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\left(\\frac{-3-\\sqrt{17}}{2},2\\right)$ and $\\left(\\frac{-3+\\sqrt{17}}{2},2\\right)$.",
      "worked": "$$\\begin{align*}x^2+3x&=2\\\\x^2+3x-2&=0\\\\x&=\\frac{-3\\pm\\sqrt{3^2-4(1)(-2)}}{2(1)}\\\\x&=\\frac{-3\\pm\\sqrt{17}}{2}\\end{align*}$$\nSince $y=2$, the points are $\\left(\\frac{-3-\\sqrt{17}}{2},2\\right)$ and $\\left(\\frac{-3+\\sqrt{17}}{2},2\\right)$.\nFor the DESMOS check, these correspond to approximately $(-3.56,2)$ and $(0.56,2)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
