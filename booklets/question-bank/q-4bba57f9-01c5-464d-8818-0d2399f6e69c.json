  "content": {
    "id": "v2-d5d06-p18-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "How many terms of the series $3+8+13+\\cdots$ are needed to give a sum of 1010?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "20 terms.",
      "worked": "$a=3$, $d=5$.\n$$\\begin{align*}S_n&=\\frac{n}{2}[2a+(n-1)d]\\\\1010&=\\frac{n}{2}[2(3)+(n-1)5]\\\\2020&=n(5n+1)\\\\5n^2+n-2020&=0\\\\(n-20)(5n+101)&=0\\\\n&=20\\text{ or }-\\frac{101}{5}\\end{align*}$$\nSince $n$ is a positive integer, 20 terms are needed.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
