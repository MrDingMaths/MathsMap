  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the following extreme values.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the minimum value of $x^2-4x+14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$, attained when $x=2$.",
          "worked": "$$\\begin{align*}x^2-4x+14&=(x^2-4x+4)-4+14\\\\x^2-4x+14&=(x-2)^2+10\\\\x^2-4x+14&\\geq10.\\end{align*}$$\nEquality holds when $x=2$, so the minimum value is $10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the maximum value of $-x^2-2x+14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$, attained when $x=-1$.",
          "worked": "$$\\begin{align*}-x^2-2x+14&=-(x^2+2x)+14\\\\-x^2-2x+14&=-(x^2+2x+1)+1+14\\\\-x^2-2x+14&=-(x+1)^2+15\\\\-x^2-2x+14&\\leq15.\\end{align*}$$\nEquality holds when $x=-1$, so the maximum value is $15$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
