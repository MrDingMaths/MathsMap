          }
        ],
        "children": [],
        "answer": {
          "short": "$AB\\parallel CD$, since $130^{\\circ}+50^{\\circ}=180^{\\circ}$ and the co-interior angles are supplementary.",
          "worked": "$$\\begin{align*}\\angle CDB+\\angle DBA&=130^{\\circ}+50^{\\circ}\\\\\\angle CDB+\\angle DBA&=180^{\\circ}.\\end{align*}$$\nThe co-interior angles on transversal $DB$ are supplementary. Therefore, $AB\\parallel CD$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44,
        "responseSpace": "scaffold"
