    "type": "question",
    "label": "13",
    "prompt": "Find the sum of the coefficients in the expansion of $P(x)=(3x-2)^{100}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$",
      "worked": "The sum of the coefficients is $P(1)$, since every power of $x$ becomes $1$ when $x=1$.\n$$\\begin{align*}P(1)&=(3\\times1-2)^{100}\\\\P(1)&=1^{100}\\\\P(1)&=1.\\end{align*}$$",
      "solutionDiagrams": []
    },
