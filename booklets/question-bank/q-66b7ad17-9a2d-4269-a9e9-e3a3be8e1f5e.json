  "content": {
    "id": "p51-task79-82-root",
    "type": "question",
    "label": null,
    "prompt": "Find the range of the following quadratic functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-task79-82-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2(x+1)^2+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[3,\\infty)$",
          "worked": "The vertex is $(-1,3)$. Since $a=2>0$, the parabola is concave up and its minimum value is $3$.\n\nThe range is $[3,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p51-task79-82-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(3-x)(1+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p51-task79-82-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(-\\infty,4]",
                    "display": false
                  }
                ]
              },
              {
                "id": "p51-task79-82-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Completing the square gives ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=4-(x-1)^2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so the maximum is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "4",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y&=-x^2+2x+3\\\\y&=-(x^2-2x+1)+4\\\\y&=4-(x-1)^2\\end{align*}$$\n\nThe vertex is $(1,4)$. The parabola is concave down, so its maximum value is $4$.\n\nThe range is $(-\\infty,4]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p51-task79-82-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2+x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p51-task79-82-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\left[\\frac34,\\infty\\right)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p51-task79-82-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Completing the square gives ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=\\left(x+\\frac12\\right)^2+\\frac34",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so the minimum is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac34",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y&=\\left(x+\\frac12\\right)^2-\\frac14+1\\\\y&=\\left(x+\\frac12\\right)^2+\\frac34\\end{align*}$$\n\nThe vertex is $\\left(-\\frac12,\\frac34\\right)$. The parabola is concave up, so its minimum value is $\\frac34$.\n\nThe range is $\\left[\\frac34,\\infty\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p51-task79-82-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=5+4x-2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p51-task79-82-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(-\\infty,7]",
                    "display": false
                  }
                ]
              },
              {
                "id": "p51-task79-82-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Completing the square gives ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=7-2(x-1)^2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so the maximum is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "7",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y&=-2(x^2-2x)+5\\\\y&=-2\\bigl[(x-1)^2-1\\bigr]+5\\\\y&=7-2(x-1)^2\\end{align*}$$\n\nThe vertex is $(1,7)$. The parabola is concave down, so its maximum value is $7$.\n\nThe range is $(-\\infty,7]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
