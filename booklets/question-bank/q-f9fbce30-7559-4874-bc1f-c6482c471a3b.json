    "id": "p7-ch15-q1",
    "type": "question",
    "label": "1",
    "prompt": "A fair die is rolled once. Find the probability that the number showing on the die is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-ch15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "divisible by 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "The favourable outcomes are $3$ and $6$, out of six equally likely outcomes.\n\n$$\\begin{align*}P(\\text{divisible by }3)&=\\frac{2}{6}\\\\P(\\text{divisible by }3)&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-ch15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "an even number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The favourable outcomes are $2$, $4$ and $6$, out of six equally likely outcomes.\n\n$$\\begin{align*}P(\\text{even number})&=\\frac{3}{6}\\\\P(\\text{even number})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
