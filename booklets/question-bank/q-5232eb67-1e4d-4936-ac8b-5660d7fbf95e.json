  "content": {
    "id": "p2-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "What can be said about the integers $m$ and $n$ if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$m+n$ is even and $mn$ is even",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both integers are even.",
          "worked": "An even sum means the integers have the same parity. They cannot both be odd because their product is even. Therefore, both are even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$m+n$ is even and $mn$ is odd",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both integers are odd.",
          "worked": "An odd product requires both factors to be odd. Their sum is then even, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$m+n$ is odd and $mn$ is even",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "One integer is even and the other is odd.",
          "worked": "An odd sum requires opposite parities. One factor is therefore even, so the product is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$m+n$ is odd and $mn$ is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "This is not possible.",
          "worked": "An odd product requires both integers to be odd, but two odd integers have an even sum. The conditions cannot both hold.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
