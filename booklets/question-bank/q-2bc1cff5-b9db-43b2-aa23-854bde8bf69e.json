    "answer": {
      "short": "49 hours",
      "worked": "$$\\begin{align*}\\text{Normal pay} &= 18\\times35=\\$630\\\\\\text{Overtime pay} &= 1008-630=\\$378\\\\\\text{Overtime hourly rate} &= 18\\times1.5=\\$27/\\text{h}\\\\\\text{Overtime hours} &= \\frac{378}{27}=14\\text{ h}\\\\\\text{Total hours} &= 35+14=49\\text{ h}\\end{align*}$$",
      "solutionDiagrams": []
    },
