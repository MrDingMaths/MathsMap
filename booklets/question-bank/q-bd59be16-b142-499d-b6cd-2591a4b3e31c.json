    "difficulty": "Development",
    "difficultyReason": "Interpret absolute value inequalities using distance, interval bounds and the non-negativity of absolute value."
  },
  "content": {
    "id": "p75-q1-6-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p75-q1-6-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "True or False?",
              "marks": [
                "bold"
              ],
              "colour": "#ef8b2c"
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p75-q1",
        "type": "part",
        "label": "a",
        "prompt": "If $|x|\\le k$, then $-k\\le x\\le k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True. The premise gives $x\\le k$ and $-x\\le k$, hence $-k\\le x\\le k$.",
          "worked": "Absolute value is at least both $x$ and $-x$. Therefore $|x|\\le k$ gives $x\\le k$ and $-x\\le k$, so $-k\\le x\\le k$. The statement is true. If $k<0$, the premise has no solution and supplies no counterexample.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p75-q2",
        "type": "part",
        "label": "b",
        "prompt": "If $k>0$ and $|x|<k$, then $-k<x<k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "For $k>0$, $|x|<k$ means the distance of $x$ from $0$ is less than $k$. Thus $-k<x<k$, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p75-q3",
        "type": "part",
        "label": "c",
        "prompt": "If $|x-a|\\ge r$, then $x$ is at least $r$ units from $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$|x-a|$ is the distance of $x$ from $a$. The inequality says this distance is at least $r$, so the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p75-q4",
        "type": "part",
        "label": "d",
        "prompt": "The inequality $|x-2|<0$ has no solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$|x-2|\\ge0$ for every real $x$, so it cannot be less than $0$. There is no solution; the statement is true.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p75-q5",
        "type": "part",
        "label": "e",
        "prompt": "The inequality $|x+3|>-1$ has no solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. Every real number is a solution.",
          "worked": "$|x+3|\\ge0>-1$ for every real $x$. The solution is $x\\in\\mathbb{R}$, so the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p75-q6",
        "type": "part",
        "label": "f",
        "prompt": "The inequality $|x-4|\\le0$ has no solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. The only solution is $x=4$.",
          "worked": "Absolute value is non-negative, so $|x-4|\\le0$ requires $|x-4|=0$. Hence $x=4$, and the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
