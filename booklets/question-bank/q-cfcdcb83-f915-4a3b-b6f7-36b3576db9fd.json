    "label": "7",
    "prompt": "Find $c$, given $f(x)$ is a PDF on the given domain.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\frac{8}{3}(1-x)$, domain $[0,c]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{8}{3}\\int_0^c(1-x)\\,dx&=1\\\\\\frac{8}{3}\\left[x-\\frac{x^2}{2}\\right]_0^c&=1\\\\\\frac{8}{3}\\left(c-\\frac{c^2}{2}\\right)&=1\\\\4c^2-8c+3&=0\\\\(2c-1)(2c-3)&=0\\\\c&=\\frac{1}{2}\\text{ or }\\frac{3}{2}\\end{align*}$$\nFor $f(x)\\ge0$, we need $1-x\\ge0$ throughout $[0,c]$, so $c\\le1$. Reject $c=\\frac{3}{2}$.\n$$c=\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
