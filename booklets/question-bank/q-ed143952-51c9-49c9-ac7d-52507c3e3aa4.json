  "content": {
    "id": "p19-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Bottle 1 contains water and cordial in the ratio $2:5$. Bottle 2 has the same total volume and has water and cordial in the ratio $3:7$. If the contents are combined, what is the ratio of water to cordial? Hint: It is not $5:12$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
