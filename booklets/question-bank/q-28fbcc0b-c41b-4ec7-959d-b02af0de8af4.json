        "prompt": "$\\left(\\dfrac{2}{3}\\right)^{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16}{81}$",
          "worked": "$$\\begin{align*}\\left(\\frac{2}{3}\\right)^{4}&=\\frac{2^{4}}{3^{4}}\\\\&=\\frac{16}{81}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-77442-p19-practice-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$0.6^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27}{125}$",
          "worked": "$$\\begin{align*}0.6^{3}&=\\left(\\frac{3}{5}\\right)^{3}\\\\&=\\frac{3^{3}}{5^{3}}\\\\&=\\frac{27}{125}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-77442-p19-practice-slot-10-slot-10-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\dfrac{3}{4}\\right)^{2}\\times0.8^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{36}{125}$",
          "worked": "$$\\begin{align*}\\left(\\frac{3}{4}\\right)^{2}\\times0.8^{3}&=\\frac{9}{16}\\times\\left(\\frac{4}{5}\\right)^{3}\\\\&=\\frac{9}{16}\\times\\frac{64}{125}\\\\&=\\frac{9\\times4}{125}\\\\&=\\frac{36}{125}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
