        "label": "a",
        "prompt": "$2^{x+1}=2^{3x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "$$\\begin{align*}x+1 &= 3x-5 \\\\ 6 &= 2x \\\\ x &= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "feedback-exponents-bridge-b",
        "type": "part",
        "label": "b",
        "prompt": "$4^{x+1}=2^{3x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$",
          "worked": "$$\\begin{align*}(2^2)^{x+1} &= 2^{3x-5} \\\\ 2(x+1) &= 3x-5 \\\\ 2x+2 &= 3x-5 \\\\ x &= 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
