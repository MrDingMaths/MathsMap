        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{43}$",
          "worked": "Total number of lollies $=250+170+300+140=860$.\n\nThere are 140 toffees manufactured by the ACE Confectionary Company.\n\n$$\\begin{align*}P(\\text{ACE toffee})&=\\frac{140}{860}\\\\P(\\text{ACE toffee})&=\\frac{7}{43}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
