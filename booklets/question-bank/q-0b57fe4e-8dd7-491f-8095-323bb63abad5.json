      {
        "id": "p19-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Express the equation $ax+by=d$, where $a$, $b$ and $d$ are constants $(b\\ne0)$, in the form $y=mx+c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac abx+\\frac db$.",
          "worked": "$$\\begin{align*}ax+by&=d\\\\by&=-ax+d\\\\y&=-\\frac abx+\\frac db\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the gradient and $y$-intercept of the line whose equation is $ax+by=d$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Gradient $-\\frac ab$; $y$-intercept $\\frac db$.",
          "worked": "Comparing $y=-\\frac abx+\\frac db$ with $y=mx+c$, the gradient is $-\\frac ab$ and the $y$-intercept is $\\frac db$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
