  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Remi earns \\$28.20 per hour. He works 7 hours one day and 5 hours the next.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the total hours worked.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "12 hours",
          "worked": "$$\\begin{align*}\\text{Total hours}&=7+5\\\\\\text{Total hours}&=12\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find his pay over these two days.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$338.40",
          "worked": "$$\\begin{align*}\\text{Total pay}&=\\text{Hourly rate}\\times\\text{Hours}\\\\\\text{Total pay}&=\\$28.20/\\text{hour}\\times12\\text{ hours}\\\\\\text{Total pay}&=\\$338.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
