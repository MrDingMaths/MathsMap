            "inlines": [
              {
                "type": "text",
                "text": "Set up column A for the number of payments and column B for the balance. Enter 0 in A2 and B2. Enter 1 to 20 in A3:A22.",
                "marks": []
              }
            ]
          },
          {
            "id": "p11-q1-worked-formula",
            "type": "paragraph",
