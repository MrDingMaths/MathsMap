  "content": {
    "id": "p31-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "A piece of wire of length $L$ is bent to form a sector of a circle of radius $r$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "If the sector subtends an angle of $\\theta$ radians at the centre, show that $\\theta=\\dfrac{L}{r}-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{L-2r}{r}=\\dfrac{L}{r}-2$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p31-q18-a-answer-explanation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The angle in radians is the ratio of the arc length to the radius. The arc length is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "L-2r",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p31-q18-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\theta&=\\frac{L-2r}{r}\\\\\\theta&=\\frac{L}{r}-2\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p31-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the area of the sector is maximised when $r=\\dfrac{L}{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\dfrac{Lr-2r^2}{2}$, so $A'(r)=\\dfrac L2-2r=0$ at $r=\\dfrac L4$. Since $A''(r)=-2<0$, this gives the maximum.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p31-q18-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}A&=\\pi r^2\\times\\frac{\\frac Lr-2}{2\\pi}\\\\A&=\\frac{r(L-2r)}{2}\\\\A&=\\frac{Lr-2r^2}{2}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p31-q18-b-stationary-instruction",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "At a stationary point, ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{dA}{dr}=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p31-q18-b-derivative",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{dA}{dr}&=\\frac{d}{dr}\\left(\\frac{Lr-2r^2}{2}\\right)\\\\\\frac{dA}{dr}&=\\frac L2-2r\\\\0&=\\frac L2-2r\\\\L&=4r\\\\r&=\\frac L4\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p31-q18-b-maximum-check",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{d^2A}{dr^2}=-2<0",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "The area function is concave down throughout its domain, so this stationary point gives the global maximum. It is feasible: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\theta=\\frac{L}{\\frac{L}{4}}-2=2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " radians. Hence the area is maximised when ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r=\\frac L4",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
