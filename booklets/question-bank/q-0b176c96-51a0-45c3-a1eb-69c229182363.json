  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Rearrange these to make $q$ the subject.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$p=2q+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$q=\\frac{p-4}{2}$",
          "worked": "$$\\begin{align*}p-4&=2q\\\\q&=\\frac{p-4}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$p=q^2+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$q=\\pm\\sqrt{p-4}$",
          "worked": "$$\\begin{align*}p-4&=q^2\\\\q&=\\pm\\sqrt{p-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$p=2q^2+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$q=\\pm\\sqrt{\\frac{p-4}{2}}$",
          "worked": "$$\\begin{align*}p-4&=2q^2\\\\\\frac{p-4}{2}&=q^2\\\\q&=\\pm\\sqrt{\\frac{p-4}{2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
