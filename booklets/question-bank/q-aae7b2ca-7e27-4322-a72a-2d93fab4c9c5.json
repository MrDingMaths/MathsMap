  "content": {
    "id": "v2-3fc1c1-p8-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Find the gradient of the normal to the inverse function at:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-3fc1c1-p8-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2,1)$ given $f(x)=x^3+x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}f'(x)&=3x^2+1\\\\(f^{-1})'(2)&=\\frac{1}{f'(1)}\\\\&=\\frac14\\\\m_{\\text{normal}}&=-\\frac{1}{1/4}\\\\&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-3fc1c1-p8-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\dfrac12,1\\right)$ given $f(x)=\\dfrac{x}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac14$",
          "worked": "$$\\begin{align*}f'(x)&=\\frac{(x+1)-x}{(x+1)^2}\\\\&=\\frac{1}{(x+1)^2}\\\\f'(1)&=\\frac14\\\\(f^{-1})'\\left(\\frac12\\right)&=\\frac{1}{f'(1)}\\\\&=4\\\\m_{\\text{normal}}&=-\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
