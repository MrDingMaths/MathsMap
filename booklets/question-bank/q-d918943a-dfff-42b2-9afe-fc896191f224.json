        "id": "p33-group-15-22-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x-1)^3(2x+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x-1)^2(8x+13)$",
          "worked": "$$\\begin{aligned}y'&=3(x-1)^2(2x+5)+2(x-1)^3\\\\y'&=(x-1)^2\\big[3(2x+5)+2(x-1)\\big]\\\\y'&=(x-1)^2(8x+13)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-15-22-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x(x^2-5x+1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x^2-5x+1)^2(7x^2-20x+1)$",
          "worked": "$$\\begin{aligned}y'&=(x^2-5x+1)^3+3x(x^2-5x+1)^2(2x-5)\\\\y'&=(x^2-5x+1)^2\\big[(x^2-5x+1)+3x(2x-5)\\big]\\\\y'&=(x^2-5x+1)^2(7x^2-20x+1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-15-22-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x-2)(x^2+4x+5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x^2+4x+5)(5x^2+4x-11)$",
          "worked": "$$\\begin{aligned}y'&=(x^2+4x+5)^2+2(x-2)(x^2+4x+5)(2x+4)\\\\y'&=(x^2+4x+5)\\big[(x^2+4x+5)+2(x-2)(2x+4)\\big]\\\\y'&=(x^2+4x+5)(5x^2+4x-11)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-15-22-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(2x-1)(x^2+3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2(x^2+3)(5x^2-2x+3)$",
          "worked": "$$\\begin{aligned}y'&=2(x^2+3)^2+4x(2x-1)(x^2+3)\\\\y'&=2(x^2+3)\\big[(x^2+3)+2x(2x-1)\\big]\\\\y'&=2(x^2+3)(5x^2-2x+3)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-15-22-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=(x^2+1)(x^3-2x)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-i19-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y'=2x(x^2-2)(4x^4-x^2-2)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p33-i19-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the product and chain rules, then factorise.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{aligned}y'&=2x(x^3-2x)^2+2(x^2+1)(x^3-2x)(3x^2-2)\\\\y'&=2x(x^2-2)\\big[x^2(x^2-2)+(x^2+1)(3x^2-2)\\big]\\\\y'&=2x(x^2-2)(4x^4-x^2-2)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-15-22-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=x^2(1-3x^2)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2x(1-3x^2)^2(1-12x^2)$",
          "worked": "$$\\begin{aligned}y'&=2x(1-3x^2)^3-18x^3(1-3x^2)^2\\\\y'&=2x(1-3x^2)^2\\big[(1-3x^2)-9x^2\\big]\\\\y'&=2x(1-3x^2)^2(1-12x^2)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-15-22-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=(x+2)^2(3x-4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4(x+2)(3x-4)(3x+1)$",
          "worked": "$$\\begin{aligned}y'&=2(x+2)(3x-4)^2+6(x+2)^2(3x-4)\\\\y'&=2(x+2)(3x-4)\\big[(3x-4)+3(x+2)\\big]\\\\y'&=4(x+2)(3x-4)(3x+1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-group-15-22-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=(2x-1)^2(3x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2(2x-1)(3x+1)(12x-1)$",
          "worked": "$$\\begin{aligned}y'&=4(2x-1)(3x+1)^2+6(2x-1)^2(3x+1)\\\\y'&=2(2x-1)(3x+1)\\big[2(3x+1)+3(2x-1)\\big]\\\\y'&=2(2x-1)(3x+1)(12x-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
