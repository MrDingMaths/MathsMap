  "content": {
    "id": "p11-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Use Pascal's triangle to expand:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1+x^2)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+4x^2+6x^4+4x^6+x^8$",
          "worked": "Row 4 of Pascal's triangle is $1,4,6,4,1$.\n$$\\begin{aligned}(1+x^2)^4&=1+4(x^2)+6(x^2)^2+4(x^2)^3+(x^2)^4\\\\&=1+4x^2+6x^4+4x^6+x^8.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(1-3x^2)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-9x^2+27x^4-27x^6$",
          "worked": "Row 3 of Pascal's triangle is $1,3,3,1$.\n$$\\begin{aligned}(1-3x^2)^3&=1+3(-3x^2)+3(-3x^2)^2+(-3x^2)^3\\\\&=1-9x^2+27x^4-27x^6.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x^2+2y^3)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{12}+12x^{10}y^3+60x^8y^6+160x^6y^9+240x^4y^{12}+192x^2y^{15}+64y^{18}$",
          "worked": "Row 6 of Pascal's triangle is $1,6,15,20,15,6,1$.\n$$\\begin{aligned}(x^2+2y^3)^6&=x^{12}+6x^{10}(2y^3)+15x^8(4y^6)+20x^6(8y^9)+15x^4(16y^{12})+6x^2(32y^{15})+64y^{18}\\\\&=x^{12}+12x^{10}y^3+60x^8y^6+160x^6y^9+240x^4y^{12}+192x^2y^{15}+64y^{18}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p11-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(x-\\frac{1}{x}\\right)^9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^9-9x^7+36x^5-84x^3+126x-\\frac{126}{x}+\\frac{84}{x^3}-\\frac{36}{x^5}+\\frac{9}{x^7}-\\frac{1}{x^9}$",
          "worked": "Row 9 of Pascal's triangle is $1,9,36,84,126,126,84,36,9,1$.\n$$\\begin{aligned}\\left(x-\\frac1x\\right)^9&=x^9+9x^8\\left(-\\frac1x\\right)+36x^7\\left(\\frac1{x^2}\\right)+84x^6\\left(-\\frac1{x^3}\\right)+126x^5\\left(\\frac1{x^4}\\right)\\\\&\\mathrel{\\phantom{=}}+126x^4\\left(-\\frac1{x^5}\\right)+84x^3\\left(\\frac1{x^6}\\right)+36x^2\\left(-\\frac1{x^7}\\right)+9x\\left(\\frac1{x^8}\\right)-\\frac1{x^9}\\\\&=x^9-9x^7+36x^5-84x^3+126x-\\frac{126}{x}+\\frac{84}{x^3}-\\frac{36}{x^5}+\\frac9{x^7}-\\frac1{x^9}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p11-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt{x}+\\sqrt{y})^7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3\\sqrt{x}+7x^3\\sqrt{y}+21x^2y\\sqrt{x}+35x^2y\\sqrt{y}+35xy^2\\sqrt{x}+21xy^2\\sqrt{y}+7y^3\\sqrt{x}+y^3\\sqrt{y}$",
          "worked": "Row 7 of Pascal's triangle is $1,7,21,35,35,21,7,1$.\n$$\\begin{aligned}(\\sqrt{x}+\\sqrt{y})^7&=x^{7/2}+7x^3y^{1/2}+21x^{5/2}y+35x^2y^{3/2}+35x^{3/2}y^2+21xy^{5/2}+7x^{1/2}y^3+y^{7/2}\\\\&=x^3\\sqrt{x}+7x^3\\sqrt{y}+21x^2y\\sqrt{x}+35x^2y\\sqrt{y}+35xy^2\\sqrt{x}+21xy^2\\sqrt{y}+7y^3\\sqrt{x}+y^3\\sqrt{y}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p11-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{2}{x}+3x^2\\right)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{32}{x^5}+\\frac{240}{x^2}+720x+1080x^4+810x^7+243x^{10}$",
          "worked": "Row 5 of Pascal's triangle is $1,5,10,10,5,1$.\n$$\\begin{aligned}\\left(\\frac2x+3x^2\\right)^5&=\\frac{32}{x^5}+5\\left(\\frac{16}{x^4}\\right)(3x^2)+10\\left(\\frac8{x^3}\\right)(9x^4)+10\\left(\\frac4{x^2}\\right)(27x^6)+5\\left(\\frac2x\\right)(81x^8)+243x^{10}\\\\&=\\frac{32}{x^5}+\\frac{240}{x^2}+720x+1080x^4+810x^7+243x^{10}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
