      {
        "id": "p14-q6a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\cos(\\sin^{-1}x)=\\sqrt{1-x^2}$ for $-1\\le x\\le1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos(\\sin^{-1}x)=\\sqrt{1-x^2}$, for $-1\\le x\\le1$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q6a-work-let",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\alpha=\\sin^{-1}x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p14-q6a-work-range",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\sin\\alpha=x,\\qquad -\\frac{\\pi}{2}\\le\\alpha\\le\\frac{\\pi}{2},\\qquad \\cos\\alpha\\ge0.",
                    "display": true
                  }
                ]
              },
              {
                "id": "p14-q6a-work-triangle",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "0<|x|<1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", use a right-angled triangle with hypotenuse 1 and opposite side ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "|x|",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". By Pythagoras, the adjacent side is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\sqrt{1-x^2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". The inverse sine range fixes the cosine as non-negative.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p14-q6a-work-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\cos\\alpha&=\\frac{\\text{adjacent}}{\\text{hypotenuse}}\\\\&=\\frac{\\sqrt{1-x^2}}{1}\\\\&=\\sqrt{1-x^2}.\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p14-q6a-work-endpoints",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "At ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", both sides equal 1; at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=\\pm1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", both sides equal 0. Hence the identity holds throughout ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "[-1,1]",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
