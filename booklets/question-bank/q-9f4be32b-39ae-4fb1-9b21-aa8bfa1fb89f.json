    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $y$-intercept by substituting $x=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,2)$",
          "worked": "$$\\begin{align*}0+2y-4&=0\\\\2y&=4\\\\y&=2\\end{align*}$$\nThe $y$-intercept is $(0,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the $x$-intercept by substituting $y=0$ then solving.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,0)$",
          "worked": "$$\\begin{align*}x+2(0)-4&=0\\\\x&=4\\end{align*}$$\nThe $x$-intercept is $(4,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Sketch the graph on the axis.",
