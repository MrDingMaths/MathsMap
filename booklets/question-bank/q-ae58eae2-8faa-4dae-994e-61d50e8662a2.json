  "content": {
    "id": "p33-q12",
    "type": "question",
    "label": "12",
    "prompt": "Olivia factorises $16x^2-4$ to get $(4x+2)(4x-2)$ but the answers say $4(2x+1)(2x-1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "What should Olivia do to get from her answer to the actual answer?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Factorise 2 out of both brackets, then multiply the outside factors to give $4(2x+1)(2x-1)$.",
          "worked": "Factorise 2 out of each bracket.\n$$\\begin{align*}(4x+2)(4x-2)&=2(2x+1)\\times2(2x-1)\\\\&=4(2x+1)(2x-1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "What should Olivia have done initially to avoid this issue?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Factorise out the HCF, 4, first.",
          "worked": "Factorise out the HCF, 4, before using the difference-of-squares rule.\n$$\\begin{align*}16x^2-4&=4(4x^2-1)\\\\&=4(2x+1)(2x-1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
