  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Solve each equation for $x$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$$7x+a=3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{3-a}{7}$",
          "worked": "$$\\begin{align*}7x&=3-a\\\\x&=\\frac{3-a}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$$ax-b=c$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{b+c}{a}$",
          "worked": "$$\\begin{align*}ax&=b+c\\\\x&=\\frac{b+c}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{x}{a}+b=c$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a(c-b)$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=c-b\\\\x&=a(c-b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$$a-x=b$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a-b$",
          "worked": "$$\\begin{align*}a&=b+x\\\\a-b&=x\\\\x&=a-b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$$a-\\frac{x}{b}=c$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=b(a-c)$",
          "worked": "$$\\begin{align*}a&=c+\\frac{x}{b}\\\\a-c&=\\frac{x}{b}\\\\x&=b(a-c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p7-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$$x(a+b)=c$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{c}{a+b}$",
          "worked": "$$\\begin{align*}x&=\\frac{c}{a+b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$$a(x+b)=cx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{ab}{c-a}$\n\nExpand, collect the terms containing $x$, then factorise.",
          "worked": "$$\\begin{align*}ax+ab&=cx\\\\ab&=cx-ax\\\\ab&=(c-a)x\\\\x&=\\frac{ab}{c-a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac{x}{a}+\\frac{b}{c}=0$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac{ab}{c}$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=-\\frac{b}{c}\\\\x&=-\\frac{ab}{c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p7-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\frac{x}{a}-\\frac{b}{c}=d$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{ab}{c}+ad$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=d+\\frac{b}{c}\\\\x&=a\\left(d+\\frac{b}{c}\\right)\\\\x&=ad+\\frac{ab}{c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p7-q9-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\frac{x}{a}+b=\\frac{cx}{d}+e$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{ad(e-b)}{d-ac}$\n\nClear the denominators, collect the terms containing $x$, then factorise.",
          "worked": "$$\\begin{align*}dx+abd&=acx+ade\\\\dx-acx&=ade-abd\\\\(d-ac)x&=ad(e-b)\\\\x&=\\frac{ad(e-b)}{d-ac}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
