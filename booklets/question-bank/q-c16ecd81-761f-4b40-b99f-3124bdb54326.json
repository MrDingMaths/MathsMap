    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(2x+3)(2x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=8x$",
          "worked": "$$\\begin{align*}y&=4x^2-9\\\\\\frac{dy}{dx}&=8x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p56-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{1}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-\\dfrac{2x}{(x-3)^2(x+3)^2}$",
          "worked": "$$\\begin{align*}y&=(x^2-9)^{-1}\\\\\\frac{dy}{dx}&=-(x^2-9)^{-2}(2x)\\\\\\frac{dy}{dx}&=-\\frac{2x}{(x^2-9)^2}\\\\\\frac{dy}{dx}&=-\\frac{2x}{(x-3)^2(x+3)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p56-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x(4-x)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=4(1-x)(4-x)^2$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=(4-x)^3+x\\bigl[3(4-x)^2(-1)\\bigr]\\\\\\frac{dy}{dx}&=(4-x)^3-3x(4-x)^2\\\\\\frac{dy}{dx}&=(4-x)^2(4-x-3x)\\\\\\frac{dy}{dx}&=4(1-x)(4-x)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p56-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{3-x}{3+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-\\dfrac{6}{(3+x)^2}$",
          "worked": "$u=3-x$, $u'=-1$, $v=3+x$, $v'=1$.\n$$\\begin{align*}\\frac{dy}{dx}&=\\frac{(-1)(3+x)-(3-x)(1)}{(3+x)^2}\\\\\\frac{dy}{dx}&=\\frac{-3-x-3+x}{(3+x)^2}\\\\\\frac{dy}{dx}&=-\\frac{6}{(3+x)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p56-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=(x^4-1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=20x^3(x^2+1)^4(x+1)^4(x-1)^4$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=5(x^4-1)^4(4x^3)\\\\\\frac{dy}{dx}&=20x^3\\bigl[(x^2-1)(x^2+1)\\bigr]^4\\\\\\frac{dy}{dx}&=20x^3(x^2+1)^4(x+1)^4(x-1)^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p56-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{1}{\\sqrt{2-x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{1}{2\\sqrt{(2-x)^3}}$",
          "worked": "$$\\begin{align*}y&=(2-x)^{-1/2}\\\\\\frac{dy}{dx}&=-\\frac12(2-x)^{-3/2}(-1)\\\\\\frac{dy}{dx}&=\\frac{1}{2\\sqrt{(2-x)^3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p56-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=(x^3+5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=6x^2(x^3+5)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2(x^3+5)(3x^2)\\\\\\frac{dy}{dx}&=6x^2(x^3+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p56-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\dfrac{x^2+x+1}{2\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{3x^2+x-1}{4x\\sqrt{x}}$",
          "worked": "$$\\begin{align*}y&=\\frac12\\bigl(x^{3/2}+x^{1/2}+x^{-1/2}\\bigr)\\\\\\frac{dy}{dx}&=\\frac34x^{1/2}+\\frac14x^{-1/2}-\\frac14x^{-3/2}\\\\\\frac{dy}{dx}&=\\frac{3x^2+x-1}{4x\\sqrt{x}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p56-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\dfrac23x^2(x^3-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac23x(5x^3-2)$",
          "worked": "$$\\begin{align*}y&=\\frac23x^5-\\frac23x^2\\\\\\frac{dy}{dx}&=\\frac{10}{3}x^4-\\frac43x\\\\\\frac{dy}{dx}&=\\frac23x(5x^3-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p56-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$y=\\dfrac{x}{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{5}{(x+5)^2}$",
          "worked": "$u=x$, $u'=1$, $v=x+5$, $v'=1$.\n$$\\begin{align*}\\frac{dy}{dx}&=\\frac{(1)(x+5)-x(1)}{(x+5)^2}\\\\\\frac{dy}{dx}&=\\frac{x+5-x}{(x+5)^2}\\\\\\frac{dy}{dx}&=\\frac{5}{(x+5)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p56-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$y=x\\sqrt{x}+x^2\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac12\\sqrt{x}(3+5x)$",
          "worked": "$$\\begin{align*}y&=x^{3/2}+x^{5/2}\\\\\\frac{dy}{dx}&=\\frac32x^{1/2}+\\frac52x^{3/2}\\\\\\frac{dy}{dx}&=\\frac12\\sqrt{x}(3+5x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p56-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$y=\\left(x-\\dfrac1x\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{2(x-1)(x+1)(x^2+1)}{x^3}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2\\left(x-\\frac1x\\right)\\left(1+\\frac1{x^2}\\right)\\\\\\frac{dy}{dx}&=\\frac{2(x^2-1)(x^2+1)}{x^3}\\\\\\frac{dy}{dx}&=\\frac{2(x-1)(x+1)(x^2+1)}{x^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p56-q2-m",
        "type": "part",
        "label": "m",
        "prompt": "$y=x^3(x-1)^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=x^2(x-1)^7(11x-3)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2(x-1)^8+x^3\\bigl[8(x-1)^7\\bigr]\\\\\\frac{dy}{dx}&=x^2(x-1)^7\\bigl[3(x-1)+8x\\bigr]\\\\\\frac{dy}{dx}&=x^2(x-1)^7(11x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p56-q2-n",
        "type": "part",
        "label": "n",
        "prompt": "$y=\\left(\\sqrt{x}+\\dfrac1{\\sqrt{x}}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{(x+1)(x-1)}{x^2}$",
          "worked": "$$\\begin{align*}y&=x+2+\\frac1x\\\\\\frac{dy}{dx}&=1-x^{-2}\\\\\\frac{dy}{dx}&=\\frac{x^2-1}{x^2}\\\\\\frac{dy}{dx}&=\\frac{(x+1)(x-1)}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
