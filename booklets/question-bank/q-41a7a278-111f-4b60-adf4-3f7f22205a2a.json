  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify each of the following by noting that each logarithm is the inverse of an exponential:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_3 3^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\log_3 3^4=4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{\\log_2 9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$2^{\\log_2 9}=9$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_5 5^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\log_5 5^6=6$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$5^{\\log_5 7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$5^{\\log_5 7}=7$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p12-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_3 9^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\log_3 9^2&=\\log_3(3^2)^2\\\\\\log_3 9^2&=\\log_3 3^4\\\\\\log_3 9^2&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$3^{2\\log_3 5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25$",
          "worked": "$$\\begin{align*}3^{2\\log_3 5}&=(3^{\\log_3 5})^2\\\\3^{2\\log_3 5}&=5^2\\\\3^{2\\log_3 5}&=25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_2 8^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\log_2 8^2&=\\log_2(2^3)^2\\\\\\log_2 8^2&=\\log_2 2^6\\\\\\log_2 8^2&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$4^{2\\log_4 3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}4^{2\\log_4 3}&=(4^{\\log_4 3})^2\\\\4^{2\\log_4 3}&=3^2\\\\4^{2\\log_4 3}&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
