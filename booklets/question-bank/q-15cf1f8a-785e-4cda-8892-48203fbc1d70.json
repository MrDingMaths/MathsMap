  "content": {
    "id": "p23-review-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "In an indoor cricket match, a team has made 25 runs and lost 7 wickets. What is the score of the team? (A run adds 1 to the score and a wicket subtracts 5.)",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-10$",
      "worked": "$$\\begin{align*}\\text{Score}&=25+7\\times(-5)\\\\\\text{Score}&=25+(-35)\\\\\\text{Score}&=25-35\\\\\\text{Score}&=-10\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
