  "content": {
    "id": "p8-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the gradient from $A$ to $B$ for each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(a,b),\\ B(b,a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}m&=\\frac{a-b}{b-a}\\\\m&=\\frac{-(b-a)}{b-a}\\\\m&=-1\\end{align*}$$\n\nFor $a\\ne b$; if $a=b$, the points coincide and the gradient is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(a,-b),\\ B(-b,a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}m&=\\frac{a-(-b)}{-b-a}\\\\m&=\\frac{a+b}{-(a+b)}\\\\m&=-1\\end{align*}$$\n\nFor $a+b\\ne0$; otherwise the points coincide and the gradient is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(a,a^2),\\ B(b,b^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b$",
          "worked": "$$\\begin{align*}m&=\\frac{b^2-a^2}{b-a}\\\\m&=\\frac{(b-a)(b+a)}{b-a}\\\\m&=a+b\\end{align*}$$\n\nFor $a\\ne b$; if $a=b$, the points coincide and the gradient is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(-a,a^2),\\ B(b,b^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b-a$",
          "worked": "$$\\begin{align*}m&=\\frac{b^2-a^2}{b-(-a)}\\\\m&=\\frac{(b-a)(b+a)}{b+a}\\\\m&=b-a\\end{align*}$$\n\nFor $a+b\\ne0$; otherwise the points coincide and the gradient is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
