  "content": {
    "id": "p52-q4-root",
    "type": "question",
    "label": "",
    "prompt": "Use the products-to-sums formulae to find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\sin3x\\cos2x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{10}\\cos5x-\\dfrac12\\cos x+C$",
          "worked": "$$\\begin{aligned}\\sin3x\\cos2x&=\\frac12(\\sin5x+\\sin x)\\\\\\int\\sin3x\\cos2x\\,dx&=\\frac12\\int(\\sin5x+\\sin x)\\,dx\\\\&=-\\frac1{10}\\cos5x-\\frac12\\cos x+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p52-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\cos3x\\sin x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac18\\cos4x+\\dfrac14\\cos2x+C$",
          "worked": "$$\\begin{aligned}\\cos3x\\sin x&=\\frac12(\\sin4x-\\sin2x)\\\\\\int\\cos3x\\sin x\\,dx&=\\frac12\\int(\\sin4x-\\sin2x)\\,dx\\\\&=-\\frac18\\cos4x+\\frac14\\cos2x+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p52-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_0^{\\pi/4}2\\cos2x\\cos x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt2}{3}$",
          "worked": "$$\\begin{aligned}2\\cos2x\\cos x&=\\cos3x+\\cos x\\\\\\int_0^{\\pi/4}2\\cos2x\\cos x\\,dx&=\\int_0^{\\pi/4}(\\cos3x+\\cos x)\\,dx\\\\&=\\left[\\frac13\\sin3x+\\sin x\\right]_0^{\\pi/4}\\\\&=\\left(\\frac13\\sin\\frac{3\\pi}{4}+\\sin\\frac\\pi4\\right)-(0+0)\\\\&=\\frac{\\sqrt2}{6}+\\frac{\\sqrt2}{2}\\\\&=\\frac{2\\sqrt2}{3}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p52-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_0^{\\pi/3}\\sin5x\\sin2x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{\\sqrt3}{28}$",
          "worked": "$$\\begin{aligned}\\sin5x\\sin2x&=\\frac12(\\cos3x-\\cos7x)\\\\\\int_0^{\\pi/3}\\sin5x\\sin2x\\,dx&=\\int_0^{\\pi/3}\\frac12(\\cos3x-\\cos7x)\\,dx\\\\&=\\left[\\frac16\\sin3x-\\frac1{14}\\sin7x\\right]_0^{\\pi/3}\\\\&=\\left(\\frac16\\sin\\pi-\\frac1{14}\\sin\\frac{7\\pi}{3}\\right)-(0-0)\\\\&=\\frac16(0)-\\frac1{14}\\cdot\\frac{\\sqrt3}{2}\\\\&=-\\frac{\\sqrt3}{28}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
