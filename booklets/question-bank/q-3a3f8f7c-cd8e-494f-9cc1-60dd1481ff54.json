    "answer": {
      "short": "$4\\sqrt[3]2$",
      "worked": "$$\\begin{align*}\\frac8{\\sqrt[3]4}&=\\frac{8\\sqrt[3]2}{\\sqrt[3]4\\times\\sqrt[3]2}\\\\\\frac8{\\sqrt[3]4}&=\\frac{8\\sqrt[3]2}{2}\\\\\\frac8{\\sqrt[3]4}&=4\\sqrt[3]2\\end{align*}$$",
      "solutionDiagrams": []
