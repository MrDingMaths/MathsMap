      {
        "id": "p16-ex9c-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{1}{125}\\right)^{\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac15$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{125}\\right)^{\\frac13}&=\\left(\\frac{1}{5^3}\\right)^{\\frac13}\\\\\\left(\\frac{1}{125}\\right)^{\\frac13}&=\\frac{1}{5^{3\\times\\frac13}}\\\\\\left(\\frac{1}{125}\\right)^{\\frac13}&=\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-ex9c-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{1}{64}\\right)^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac18$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{64}\\right)^{\\frac12}&=\\left(\\frac{1}{8^2}\\right)^{\\frac12}\\\\\\left(\\frac{1}{64}\\right)^{\\frac12}&=\\frac{1}{8^{2\\times\\frac12}}\\\\\\left(\\frac{1}{64}\\right)^{\\frac12}&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-ex9c-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{1}{64}\\right)^{\\frac16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{64}\\right)^{\\frac16}&=\\left(\\frac{1}{2^6}\\right)^{\\frac16}\\\\\\left(\\frac{1}{64}\\right)^{\\frac16}&=\\frac{1}{2^{6\\times\\frac16}}\\\\\\left(\\frac{1}{64}\\right)^{\\frac16}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-ex9c-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{1}{10\\,000}\\right)^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{100}$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{10\\,000}\\right)^{\\frac12}&=\\left(\\frac{1}{100^2}\\right)^{\\frac12}\\\\\\left(\\frac{1}{10\\,000}\\right)^{\\frac12}&=\\frac{1}{100^{2\\times\\frac12}}\\\\\\left(\\frac{1}{10\\,000}\\right)^{\\frac12}&=\\frac{1}{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p16-ex9c-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\frac{1}{10\\,000}\\right)^{\\frac14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{10\\,000}\\right)^{\\frac14}&=\\left(\\frac{1}{10^4}\\right)^{\\frac14}\\\\\\left(\\frac{1}{10\\,000}\\right)^{\\frac14}&=\\frac{1}{10^{4\\times\\frac14}}\\\\\\left(\\frac{1}{10\\,000}\\right)^{\\frac14}&=\\frac{1}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
