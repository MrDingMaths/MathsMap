  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the prime factorisation of 1001. Hint: $1000=10^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1001=7\\times11\\times13$.",
          "worked": "$$\\begin{align*}1001&=10^3+1^3\\\\1001&=(10+1)(10^2-10+1)\\\\1001&=11\\times91\\\\1001&=7\\times11\\times13\\end{align*}$$\nAll three factors are prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p10-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Similarly, find the prime factorisation of 992.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$992=2^5\\times31$.",
          "worked": "$$\\begin{align*}992&=10^3-2^3\\\\992&=(10-2)(10^2+10\\times2+2^2)\\\\992&=8\\times124\\\\992&=2^5\\times31\\end{align*}$$\nBoth 2 and 31 are prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
