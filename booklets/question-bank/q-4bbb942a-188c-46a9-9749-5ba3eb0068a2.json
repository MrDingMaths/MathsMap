  "content": {
    "id": "p28-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A parallelogram has a height that is half of its base. The area of the parallelogram is $18\\text{ cm}^2$. What is the height and base of the parallelogram?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Height $=3\\text{ cm}$; base $=6\\text{ cm}$.",
      "worked": "The base is twice the height. We need two lengths whose product is $18$, with one twice the other. Since $3\\times6=18$ and $6=2\\times3$, the height is $3\\text{ cm}$ and the base is $6\\text{ cm}$.\n\nCheck:\n$$\\begin{align*}A&=bh\\\\A&=6\\times3\\\\A&=18\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
