  "content": {
    "id": "p9-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A cylinder of base radius $8\\text{ cm}$ has curved surface area $72\\pi\\text{ cm}^2$. Find its height.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.5\\text{ cm}$",
      "worked": "The curved surface area is $2\\pi rh$.\n$$\\begin{align*}2\\pi\\times8\\times h&=72\\pi\\\\16\\pi h&=72\\pi\\\\h&=\\frac{72\\pi}{16\\pi}\\\\h&=4.5\\text{ cm}\\end{align*}$$",
