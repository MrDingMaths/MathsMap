  "content": {
    "id": "p11-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Determine the annual income if someone earns \\$15.25 per hour for 40 hours per week. Use 52 weeks per year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$31 720 per year",
      "worked": "$$\\begin{align*}\\text{Annual income}&=\\text{Hourly rate}\\times\\text{Annual hours}\\\\\\text{Annual income}&=\\$15.25\\times(40\\times52)\\\\\\text{Annual income}&=\\$31\\,720\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
