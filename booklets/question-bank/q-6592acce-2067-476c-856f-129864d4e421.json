  "content": {
    "id": "p4-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A room has 4 walls and 2 doorways. The walls each have dimensions 7 m by 5 m, and the doorways have dimensions $\\tfrac34$ m by 2 m. If the inside walls of the room must be painted, how much will this cost if the rate for painting is \\$5 per square metre?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$685",
      "worked": "$$\\begin{aligned}A_{\\text{walls}}&=4\\times7\\times5=140\\text{ m}^2\\\\A_{\\text{doorways}}&=2\\times\\tfrac34\\times2=3\\text{ m}^2\\\\A_{\\text{painted}}&=140-3=137\\text{ m}^2\\\\\\text{Cost}&=137\\times5=\\$685.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
