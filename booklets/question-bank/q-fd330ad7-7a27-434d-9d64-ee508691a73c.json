  "content": {
    "id": "p8-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "By completing the square, locate the turning points on the graphs whose equations are:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+2x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,-8)$",
          "worked": "$$\\begin{align*}y&=(x^2+2x+1)-1-7\\\\y&=(x+1)^2-8\\end{align*}$$\nThe turning point is $(-1,-8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2+4x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,-8)$",
          "worked": "$$\\begin{align*}y&=(x^2+4x+4)-4-4\\\\y&=(x+2)^2-8\\end{align*}$$\nThe turning point is $(-2,-8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2-6x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,-16)$",
          "worked": "$$\\begin{align*}y&=(x^2-6x+9)-9-7\\\\y&=(x-3)^2-16\\end{align*}$$\nThe turning point is $(3,-16)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^2-8x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,-13)$",
          "worked": "$$\\begin{align*}y&=(x^2-8x+16)-16+3\\\\y&=(x-4)^2-13\\end{align*}$$\nThe turning point is $(4,-13)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=-x^2+6x-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,0)$",
          "worked": "$$\\begin{align*}y&=-(x^2-6x+9)\\\\y&=-\\bigl[(x-3)^2-9+9\\bigr]\\\\y&=-(x-3)^2\\end{align*}$$\nThe turning point is $(3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p8-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=-x^2-4x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,-3)$",
          "worked": "$$\\begin{align*}y&=-(x^2+4x+7)\\\\y&=-\\bigl[(x+2)^2-4+7\\bigr]\\\\y&=-(x+2)^2-3\\end{align*}$$\nThe turning point is $(-2,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p8-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=2x^2+4x+8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,6)$",
          "worked": "$$\\begin{align*}y&=2(x^2+2x+4)\\\\y&=2\\bigl[(x+1)^2-1+4\\bigr]\\\\y&=2(x+1)^2+6\\end{align*}$$\nThe turning point is $(-1,6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p8-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=-2x^2+8x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,14)$",
          "worked": "$$\\begin{align*}y&=-2(x^2-4x-3)\\\\y&=-2\\bigl[(x-2)^2-4-3\\bigr]\\\\y&=-2(x-2)^2+14\\end{align*}$$\nThe turning point is $(2,14)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p8-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=2x^2+x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac14,\\frac78\\right)$",
          "worked": "$$\\begin{align*}y&=2\\left(x^2+\\frac12x+\\frac12\\right)\\\\y&=2\\left[\\left(x+\\frac14\\right)^2-\\frac1{16}+\\frac12\\right]\\\\y&=2\\left(x+\\frac14\\right)^2+\\frac78\\end{align*}$$\nThe turning point is $\\left(-\\frac14,\\frac78\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p8-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$y=3x^2+2x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac13,\\frac23\\right)$",
          "worked": "$$\\begin{align*}y&=3\\left(x^2+\\frac23x+\\frac13\\right)\\\\y&=3\\left[\\left(x+\\frac13\\right)^2-\\frac19+\\frac13\\right]\\\\y&=3\\left(x+\\frac13\\right)^2+\\frac23\\end{align*}$$\nThe turning point is $\\left(-\\frac13,\\frac23\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p8-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$y=-2x^2+x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac14,-\\frac78\\right)$",
          "worked": "$$\\begin{align*}y&=-2\\left(x^2-\\frac12x+\\frac12\\right)\\\\y&=-2\\left[\\left(x-\\frac14\\right)^2-\\frac1{16}+\\frac12\\right]\\\\y&=-2\\left(x-\\frac14\\right)^2-\\frac78\\end{align*}$$\nThe turning point is $\\left(\\frac14,-\\frac78\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p8-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$y=-3x^2-4x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac23,\\frac{19}3\\right)$",
          "worked": "$$\\begin{align*}y&=-3\\left(x^2+\\frac43x-\\frac53\\right)\\\\y&=-3\\left[\\left(x+\\frac23\\right)^2-\\frac49-\\frac53\\right]\\\\y&=-3\\left(x+\\frac23\\right)^2+\\frac{19}3\\end{align*}$$\nThe turning point is $\\left(-\\frac23,\\frac{19}3\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
