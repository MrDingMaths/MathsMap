  "content": {
    "id": "p19-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the exact value of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\left(\\frac{\\pi}{3}\\right)+\\sin\\left(\\frac{11\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\cos\\left(\\frac{\\pi}{3}\\right)+\\sin\\left(\\frac{11\\pi}{6}\\right)&=\\frac{1}{2}-\\frac{1}{2}\\\\\\cos\\left(\\frac{\\pi}{3}\\right)+\\sin\\left(\\frac{11\\pi}{6}\\right)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p19-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\operatorname{cosec}\\left(\\frac{\\pi}{4}\\right)+\\sec\\left(\\frac{7\\pi}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\operatorname{cosec}\\left(\\frac{\\pi}{4}\\right)+\\sec\\left(\\frac{7\\pi}{4}\\right)&=\\frac{1}{\\frac{\\sqrt{2}}{2}}+\\frac{1}{\\frac{\\sqrt{2}}{2}}\\\\\\operatorname{cosec}\\left(\\frac{\\pi}{4}\\right)+\\sec\\left(\\frac{7\\pi}{4}\\right)&=\\sqrt{2}+\\sqrt{2}\\\\\\operatorname{cosec}\\left(\\frac{\\pi}{4}\\right)+\\sec\\left(\\frac{7\\pi}{4}\\right)&=2\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p19-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sec\\left(\\frac{2\\pi}{3}\\right)+\\tan\\left(\\frac{\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2+\\frac{1}{\\sqrt{3}}$",
          "worked": "$$\\begin{align*}\\sec\\left(\\frac{2\\pi}{3}\\right)+\\tan\\left(\\frac{\\pi}{6}\\right)&=\\frac{1}{-\\frac{1}{2}}+\\frac{1}{\\sqrt{3}}\\\\\\sec\\left(\\frac{2\\pi}{3}\\right)+\\tan\\left(\\frac{\\pi}{6}\\right)&=-2+\\frac{1}{\\sqrt{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan\\left(\\frac{3\\pi}{4}\\right)+\\cos\\left(\\frac{5\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1-\\frac{\\sqrt{3}}{2}$",
          "worked": "$$\\begin{align*}\\tan\\left(\\frac{3\\pi}{4}\\right)+\\cos\\left(\\frac{5\\pi}{6}\\right)&=-1+\\left(-\\frac{\\sqrt{3}}{2}\\right)\\\\\\tan\\left(\\frac{3\\pi}{4}\\right)+\\cos\\left(\\frac{5\\pi}{6}\\right)&=-1-\\frac{\\sqrt{3}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p19-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos(3\\pi)+\\cos\\left(-\\frac{\\pi}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\cos(3\\pi)+\\cos\\left(-\\frac{\\pi}{3}\\right)&=-1+\\frac{1}{2}\\\\\\cos(3\\pi)+\\cos\\left(-\\frac{\\pi}{3}\\right)&=-\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p19-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\cot\\left(\\frac{5\\pi}{3}\\right)-\\sec\\left(\\frac{7\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{\\sqrt{3}}$",
          "worked": "$$\\begin{align*}\\cot\\left(\\frac{5\\pi}{3}\\right)-\\sec\\left(\\frac{7\\pi}{6}\\right)&=\\frac{1}{-\\sqrt{3}}-\\frac{1}{-\\frac{\\sqrt{3}}{2}}\\\\\\cot\\left(\\frac{5\\pi}{3}\\right)-\\sec\\left(\\frac{7\\pi}{6}\\right)&=-\\frac{1}{\\sqrt{3}}+\\frac{2}{\\sqrt{3}}\\\\\\cot\\left(\\frac{5\\pi}{3}\\right)-\\sec\\left(\\frac{7\\pi}{6}\\right)&=\\frac{1}{\\sqrt{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
