  "content": {
    "id": "p18-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "In each of the following problems introduce a pronumeral, write an equation and solve it.\n\nIn each case, write an equation in $x$ and solve it.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "A number has 6 added to it, and the result is 24.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+6=24$, $x=18$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}x+6&=24\\\\x&=24-6\\\\x&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p18-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "A number is multiplied by 5, and the result is 35.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x=35$, $x=7$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}5x&=35\\\\x&=\\frac{35}{5}\\\\x&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p18-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "A number is multiplied by 3, and the result is 37.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x=37$, $x=12\\frac13$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}3x&=37\\\\x&=\\frac{37}{3}\\\\x&=12\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p18-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "A number is multiplied by 6, and then 4 is added. The result is 48.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x+4=48$, $x=7\\frac13$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}6x+4&=48\\\\6x&=44\\\\x&=\\frac{44}{6}\\\\x&=7\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "A number is divided by 6, and the result is 20.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{6}=20$, $x=120$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}\\frac{x}{6}&=20\\\\x&=20\\times6\\\\x&=120\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p18-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "A number is divided by 7, and 5 is subtracted from it. The result is 33.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{7}-5=33$, $x=266$.",
          "worked": "Let $x$ be the number.\n\n$$\\begin{align*}\\frac{x}{7}-5&=33\\\\\\frac{x}{7}&=38\\\\x&=38\\times7\\\\x&=266\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
