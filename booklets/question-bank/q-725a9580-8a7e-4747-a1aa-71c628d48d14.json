  "content": {
    "id": "v2-ffa03-p11-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Write the sum in sigma notation.\n\n$$4-7+10-13+16-19+22$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\displaystyle\\sum_{n=1}^{7}(-1)^{n-1}(3n+1)$",
      "worked": "$$\\begin{aligned}\\text{Terms without signs: }&4,7,10,13,16,19,22\\\\&=3n+1,\\ n=1,\\ldots,7\\\\\\text{Signs: }&+,-,+,-,\\ldots\\ \\text{so use }(-1)^{n-1}\\\\4-7+10-\\cdots+22&=\\sum_{n=1}^{7}(-1)^{n-1}(3n+1)\\end{aligned}$$",
      "solutionDiagrams": []
    },
