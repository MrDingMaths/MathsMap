  "content": {
    "id": "p56-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The remainder when $P(x)=x^4-8x^3-7x^2+3$ is divided by $x^2+x$ is $ax+3$.\nWhat is the value of $a$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-2$. At $x=-1$, $P(-1)=5=-a+3$.",
      "worked": "$$\\begin{align*}P(x)&=x(x+1)Q(x)+ax+3\\\\P(-1)&=(-1)^4-8(-1)^3-7(-1)^2+3\\\\P(-1)&=5\\\\P(-1)&=(-1)(-1+1)Q(-1)+a(-1)+3\\\\P(-1)&=-a+3\\\\5&=-a+3\\\\a&=-2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
