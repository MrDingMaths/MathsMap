  "content": {
    "id": "v2-1b3ff-p61-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "January daily maximum temperatures in Alice Springs are normally distributed with mean 36.4°C and standard deviation 2.8°C.\nOn a particular day, the maximum is hotter than 85% of all January days. Find that day's maximum temperature to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$39.3^\\circ\\text{C}$",
      "worked": "We want a z-score with $P(Z\\le z)=0.85$\n\nUsing the table, or inverse normal on a calculator, $z\\approx1.04$\n\n$$\\begin{aligned}x&=\\mu+z\\sigma\\\\x&\\approx36.4+1.04(2.8)\\\\x&\\approx39.3^\\circ\\text{C}\\quad\\text{(1 d.p.)}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
