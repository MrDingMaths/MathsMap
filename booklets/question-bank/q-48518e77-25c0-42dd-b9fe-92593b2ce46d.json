  "content": {
    "id": "p15-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "An inheritance is divided in the ratio $3:4:5$ and the smallest proportion of the inheritance is $\\$621$. What was the total inheritance worth?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$2484$",
      "worked": "The smallest share represents $3$ parts.\n\n$$\\begin{align*}\\text{Value of one part} &= 621\\div3\\\\\\text{Value of one part} &= 207\\\\\\text{Total inheritance} &= (3+4+5)\\times207\\\\\\text{Total inheritance} &= 2484\\end{align*}$$\n\nThe total inheritance was $\\$2484$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
