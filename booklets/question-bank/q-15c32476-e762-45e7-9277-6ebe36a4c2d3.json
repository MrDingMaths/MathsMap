        "prompt": "$\\frac{3}{4}\\times\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{7}=\\frac{15}{28}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\frac34\\times\\frac57&=\\frac{3\\times5}{4\\times7}\\\\&=\\frac{15}{28}\\end{align*}$$\nThe missing numerator is $5$ because $3\\times5=15$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-62673-p50-practice-slot-3-lower-gen-slot-3-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2}{5}\\times\\frac{3}{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}=\\frac{6}{35}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\frac25\\times\\frac37&=\\frac{2\\times3}{5\\times7}\\\\&=\\frac{6}{35}\\end{align*}$$\nThe missing denominator is $7$ because $5\\times7=35$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-62673-p50-practice-slot-3-lower-gen-slot-3-lower-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{9}\\times\\frac{4}{5}=\\frac{12}{45}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac39\\times\\frac45&=\\frac{3\\times4}{9\\times5}\\\\&=\\frac{12}{45}\\end{align*}$$\nThe missing numerator is $3$ because $3\\times4=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-62673-p50-practice-slot-3-lower-gen-slot-3-lower-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{3}\\times\\frac{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{4mm}\\hspace{8mm}}}=\\frac{8}{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac45$",
          "worked": "$$\\begin{align*}\\frac23\\times\\frac45&=\\frac{2\\times4}{3\\times5}\\\\&=\\frac{8}{15}\\end{align*}$$\nThe missing numerator is $4$ because $2\\times4=8$; the missing denominator is $5$ because $3\\times5=15$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
