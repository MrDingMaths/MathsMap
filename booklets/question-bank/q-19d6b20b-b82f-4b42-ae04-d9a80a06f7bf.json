  "content": {
    "id": "p33-task30-37-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the equation of the straight line satisfying the following criteria.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-task30-37-a",
        "type": "part",
        "label": "a",
        "prompt": "Has $y$-intercept 5 and gradient 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4x+5$.",
          "worked": "$$\\begin{align*}y&=mx+c\\\\y&=4x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p33-task30-37-b",
        "type": "part",
        "label": "b",
        "prompt": "Has gradient 2 and passes through $(-1,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+3$.",
          "worked": "$$\\begin{align*}y-1&=2(x+1)\\\\y-1&=2x+2\\\\y&=2x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-task30-37-c",
        "type": "part",
        "label": "c",
        "prompt": "Passes through $(2,3)$ and $(4,7)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-task30-37-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y=2x-1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p33-task30-37-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Find ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "m=2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " from the two points, then use point-gradient form.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}m&=\\frac{7-3}{4-2}\\\\m&=2\\\\y-3&=2(x-2)\\\\y&=2x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-task30-37-d",
        "type": "part",
        "label": "d",
        "prompt": "Parallel to $3x+4y-2=0$ and passes through the point $(-7,2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-task30-37-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y=-\\frac34x-\\frac{13}{4}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p33-task30-37-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the same gradient, ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-\\frac34",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", then point-gradient form.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "For the given line:\n$$\\begin{align*}4y&=-3x+2\\\\y&=-\\frac34x+\\frac12\\end{align*}$$\nParallel lines have the same gradient, so the required gradient is $-\\frac34$. Through $(-7,2)$:\n$$\\begin{align*}y-2&=-\\frac34(x+7)\\\\4y-8&=-3x-21\\\\y&=-\\frac34x-\\frac{13}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p33-task30-37-e",
        "type": "part",
        "label": "e",
        "prompt": "Perpendicular to $y=5x-1$ and passes through the point $(-8,4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
