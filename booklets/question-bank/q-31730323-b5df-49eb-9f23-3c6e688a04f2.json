    "id": "p20-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "In the park, Doyen saw people and dogs. Altogether, he counted 10 heads and 26 legs.\nHow many dogs and how many people did he see?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "7 people and 3 dogs.",
      "worked": {
