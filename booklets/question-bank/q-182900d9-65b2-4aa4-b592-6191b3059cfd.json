  "content": {
    "id": "p39-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A set of four cards contains two jacks, a queen and a king. Bob selects one card and then, without replacing it, selects another. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "both Bob's cards are jacks,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "$$\\begin{align*}P(\\text{both jacks})&=\\frac{2}{4}\\times\\frac{1}{3}\\\\P(\\text{both jacks})&=\\frac{2}{12}\\\\P(\\text{both jacks})&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "at least one of Bob's cards is a jack,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{6}$",
          "worked": "$$\\begin{align*}P(\\text{at least one jack})&=1-P(\\text{no jacks})\\end{align*}$$\n$$\\begin{align*}P(\\text{no jacks})&=\\frac{2}{4}\\times\\frac{1}{3}\\\\P(\\text{no jacks})&=\\frac{2}{12}\\\\P(\\text{no jacks})&=\\frac{1}{6}\\end{align*}$$\n$$\\begin{align*}P(\\text{at least one jack})&=1-\\frac{1}{6}\\\\P(\\text{at least one jack})&=\\frac{5}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p39-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "both Bob's cards are jacks, given that at least one of his cards is a jack.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "Let $D$ be the event that both cards are jacks and $A$ the event that at least one card is a jack. Since $D\\subseteq A$,\n$$\\begin{align*}P(D\\mid A)&=\\frac{P(D\\cap A)}{P(A)}\\\\P(D\\mid A)&=\\frac{P(D)}{P(A)}\\\\P(D\\mid A)&=\\frac{1/6}{5/6}\\\\P(D\\mid A)&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
