  "content": {
    "id": "p40-q8",
    "type": "question",
    "label": "8",
    "prompt": "For $x = 3$, $y = \\frac{1}{2}$, $z = -5$ evaluate these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q8-left-column",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p40-q8-a",
            "type": "part",
            "label": "a",
            "prompt": "$x + 4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7$",
              "worked": "$$\\begin{align*}x+4 &= 3+4\\\\x+4 &= 7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p40-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "$x - 4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1$",
              "worked": "$$\\begin{align*}x-4 &= 3-4\\\\x-4 &= -1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p40-q8-c",
            "type": "part",
            "label": "c",
            "prompt": "$4x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12$",
              "worked": "$$\\begin{align*}4x &= 4(3)\\\\4x &= 12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p40-q8-d",
            "type": "part",
            "label": "d",
            "prompt": "$4x + y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12.5$",
              "worked": "$$\\begin{align*}4x+y &= 4(3)+\\frac12\\\\4x+y &= 12+\\frac12\\\\4x+y &= 12.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p40-q8-e",
            "type": "part",
            "label": "e",
            "prompt": "$4x + 2y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$13$",
              "worked": "$$\\begin{align*}4x+2y &= 4(3)+2\\left(\\frac12\\right)\\\\4x+2y &= 12+1\\\\4x+2y &= 13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p40-q8-f",
            "type": "part",
            "label": "f",
            "prompt": "$4x - 2y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$11$",
              "worked": "$$\\begin{align*}4x-2y &= 4(3)-2\\left(\\frac12\\right)\\\\4x-2y &= 12-1\\\\4x-2y &= 11\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p40-q8-g",
            "type": "part",
            "label": "g",
            "prompt": "$2y - 4x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-11$",
              "worked": "$$\\begin{align*}2y-4x &= 2\\left(\\frac12\\right)-4(3)\\\\2y-4x &= 1-12\\\\2y-4x &= -11\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p40-q8-h",
            "type": "part",
            "label": "h",
            "prompt": "$2y + z$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-4$",
              "worked": "$$\\begin{align*}2y+z &= 2\\left(\\frac12\\right)+(-5)\\\\2y+z &= 1+(-5)\\\\2y+z &= -4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p40-q8-i",
            "type": "part",
            "label": "i",
            "prompt": "$3x + z$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$$\\begin{align*}3x+z &= 3(3)+(-5)\\\\3x+z &= 9+(-5)\\\\3x+z &= 4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p40-q8-j",
            "type": "part",
            "label": "j",
            "prompt": "$3x - z$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$14$",
              "worked": "$$\\begin{align*}3x-z &= 3(3)-(-5)\\\\3x-z &= 9-(-5)\\\\3x-z &= 14\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      },
      {
        "id": "p40-q8-right-column",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p40-q8-k",
            "type": "part",
            "label": "k",
            "prompt": "$-2z$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10$",
              "worked": "$$\\begin{align*}-2z &= -2(-5)\\\\-2z &= 10\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p40-q8-l",
            "type": "part",
            "label": "l",
            "prompt": "$-2z - x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7$",
              "worked": "$$\\begin{align*}-2z-x &= -2(-5)-3\\\\-2z-x &= 10-3\\\\-2z-x &= 7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p40-q8-m",
            "type": "part",
            "label": "m",
            "prompt": "$-2z - x - y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6.5$",
              "worked": "$$\\begin{align*}-2z-x-y &= -2(-5)-3-\\frac12\\\\-2z-x-y &= 10-3-\\frac12\\\\-2z-x-y &= 6.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p40-q8-n",
            "type": "part",
            "label": "n",
            "prompt": "$2(-2z - x - y)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$13$",
              "worked": "$$\\begin{align*}2(-2z-x-y) &= 2\\left(-2(-5)-3-\\frac12\\right)\\\\2(-2z-x-y) &= 2\\left(10-3-\\frac12\\right)\\\\2(-2z-x-y) &= 2\\left(\\frac{13}{2}\\right)\\\\2(-2z-x-y) &= 13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p40-q8-o",
            "type": "part",
            "label": "o",
            "prompt": "$2(2z + x + y)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-13$",
              "worked": "$$\\begin{align*}2(2z+x+y) &= 2\\left(2(-5)+3+\\frac12\\right)\\\\2(2z+x+y) &= 2\\left(-10+3+\\frac12\\right)\\\\2(2z+x+y) &= 2\\left(-\\frac{13}{2}\\right)\\\\2(2z+x+y) &= -13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p40-q8-p",
            "type": "part",
            "label": "p",
            "prompt": "$2x + x + y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9.5$",
              "worked": "$$\\begin{align*}2x+x+y &= 2(3)+3+\\frac12\\\\2x+x+y &= 6+3+\\frac12\\\\2x+x+y &= 9.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p40-q8-q",
            "type": "part",
            "label": "q",
            "prompt": "$\\frac{2x+x+y}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4.75$",
              "worked": "$$\\begin{align*}\\dfrac{2x+x+y}{2} &= \\dfrac{2(3)+3+\\dfrac12}{2}\\\\\\dfrac{2x+x+y}{2} &= \\dfrac{\\dfrac{19}{2}}{2}\\\\\\dfrac{2x+x+y}{2} &= \\dfrac{19}{4}\\\\\\dfrac{2x+x+y}{2} &= 4.75\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p40-q8-r",
            "type": "part",
            "label": "r",
            "prompt": "$\\frac{y+x+2z}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-3.25$",
              "worked": "$$\\begin{align*}\\dfrac{y+x+2z}{2} &= \\dfrac{\\dfrac12+3+2(-5)}{2}\\\\\\dfrac{y+x+2z}{2} &= \\dfrac{-\\dfrac{13}{2}}{2}\\\\\\dfrac{y+x+2z}{2} &= -\\dfrac{13}{4}\\\\\\dfrac{y+x+2z}{2} &= -3.25\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p40-q8-s",
            "type": "part",
            "label": "s",
            "prompt": "$\\frac{y+x-2z}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6.75$",
              "worked": "$$\\begin{align*}\\dfrac{y+x-2z}{2} &= \\dfrac{\\dfrac12+3-2(-5)}{2}\\\\\\dfrac{y+x-2z}{2} &= \\dfrac{\\dfrac{27}{2}}{2}\\\\\\dfrac{y+x-2z}{2} &= \\dfrac{27}{4}\\\\\\dfrac{y+x-2z}{2} &= 6.75\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p40-q8-t",
            "type": "part",
            "label": "t",
            "prompt": "$y+x-\\left(\\frac{2z}{2}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8.5$",
              "worked": "$$\\begin{align*}y+x-\\left(\\frac{2z}{2}\\right) &= \\frac12+3-\\left(\\frac{2(-5)}{2}\\right)\\\\y+x-\\left(\\frac{2z}{2}\\right) &= \\frac12+3-(-5)\\\\y+x-\\left(\\frac{2z}{2}\\right) &= 8.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      }
    ]
