  "content": {
    "id": "p17-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A particle is projected from the origin. Its horizontal and vertical displacement after $t$ seconds are $x=40t$ and $y=-5t^2+25t$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the initial values of $\\dot{x}$ and $\\dot{y}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dot{x}(0)=40\\text{ m/s}$ and $\\dot{y}(0)=25\\text{ m/s}$.",
          "worked": "$$\\begin{aligned}\\dot{x}&=40\\\\\\dot{y}&=-10t+25.\\end{aligned}$$\nAt $t=0$, $\\dot{x}=40\\text{ m/s}$ and $\\dot{y}=25\\text{ m/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence show the initial velocity is $5\\sqrt{89}$ m/s at an angle of approximately $32^\\circ$ above the horizontal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt{89}\\text{ m/s}$ at approximately $32^\\circ$ above the horizontal.",
          "worked": "$$\\begin{aligned}V&=\\sqrt{40^2+25^2}\\\\&=\\sqrt{1600+625}\\\\&=5\\sqrt{89}\\text{ m/s}.\\end{aligned}$$\n$$\\begin{aligned}\\theta&=\\tan^{-1}\\left(\\frac{25}{40}\\right)\\\\&=\\tan^{-1}\\left(\\frac{5}{8}\\right)\\\\&\\approx32^\\circ.\\end{aligned}$$\nBoth components are positive, so the direction is above the horizontal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
