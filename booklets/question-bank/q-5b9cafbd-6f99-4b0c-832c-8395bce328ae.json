        "label": "a",
        "prompt": "$2x^0+x^0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "For $x\\ne0$, $$\\begin{align*}2x^0+x^0&=2\\times1+1\\\\2x^0+x^0&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^{2x}\\times9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{2x+2}$",
          "worked": "$$\\begin{align*}3^{2x}\\times9&=3^{2x}\\times3^2\\\\3^{2x}\\times9&=3^{2x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^{2x}\\times3^{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{3x+1}$",
          "worked": "$$\\begin{align*}3^{2x}\\times3^{x+1}&=3^{2x+(x+1)}\\\\3^{2x}\\times3^{x+1}&=3^{3x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(6x^3y^4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36x^6y^8$",
          "worked": "$$\\begin{align*}(6x^3y^4)^2&=6^2(x^3)^2(y^4)^2\\\\(6x^3y^4)^2&=36x^{3\\times2}y^{4\\times2}\\\\(6x^3y^4)^2&=36x^6y^8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p7-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2x^{-3})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{x^6}$",
          "worked": "For $x\\ne0$, $$\\begin{align*}(2x^{-3})^2&=2^2x^{(-3)\\times2}\\\\(2x^{-3})^2&=4x^{-6}\\\\(2x^{-3})^2&=\\frac{4}{x^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p7-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{16x^4}{4x^{-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^7$",
          "worked": "For $x\\ne0$, $$\\begin{align*}\\frac{16x^4}{4x^{-3}}&=4x^{4-(-3)}\\\\\\frac{16x^4}{4x^{-3}}&=4x^7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
