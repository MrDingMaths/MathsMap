  "content": {
    "id": "p10-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the original amount if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "The price of a wallet increases by $10\\%$ to $\\$33$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$30$",
          "worked": "Let $x$ be the original price in dollars. The new price is $110\\%$ of the original.\n$$\\begin{align*}1.1x &= 33\\\\x &= \\frac{33}{1.1}\\\\x &= 30\\end{align*}$$\nThe original price is $\\$30$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "The price of a painting decreases by $10\\%$ to $\\$810$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$900$",
          "worked": "Let $x$ be the original price in dollars. The new price is $90\\%$ of the original.\n$$\\begin{align*}0.9x &= 810\\\\x &= \\frac{810}{0.9}\\\\x &= 900\\end{align*}$$\nThe original price is $\\$900$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "The price of a jacket increases by $20\\%$ to $\\$144$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$120$",
          "worked": "Let $x$ be the original price in dollars. The new price is $120\\%$ of the original.\n$$\\begin{align*}1.2x &= 144\\\\x &= \\frac{144}{1.2}\\\\x &= 120\\end{align*}$$\nThe original price is $\\$120$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p10-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "The price of a shirt decreases by $20\\%$ to $\\$24$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$30$",
          "worked": "Let $x$ be the original price in dollars. The new price is $80\\%$ of the original.\n$$\\begin{align*}0.8x &= 24\\\\x &= \\frac{24}{0.8}\\\\x &= 30\\end{align*}$$\nThe original price is $\\$30$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p10-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "The price of an apartment increases by $30\\%$ to $\\$520\\,000$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$400\\,000$",
          "worked": "Let $x$ be the original price in dollars. The new price is $130\\%$ of the original.\n$$\\begin{align*}1.3x &= 520\\,000\\\\x &= \\frac{520\\,000}{1.3}\\\\x &= 400\\,000\\end{align*}$$\nThe original price is $\\$400\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p10-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "The price of a car increases by $25\\%$ to $\\$21\\,700$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$17\\,360$",
          "worked": "Let $x$ be the original price in dollars. The new price is $125\\%$ of the original.\n$$\\begin{align*}1.25x &= 21\\,700\\\\x &= \\frac{21\\,700}{1.25}\\\\x &= 17\\,360\\end{align*}$$\nThe original price is $\\$17\\,360$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
