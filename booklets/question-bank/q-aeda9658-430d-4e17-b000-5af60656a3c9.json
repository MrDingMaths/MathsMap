              "worked": "$$\\begin{align*}206\\times205&=40\\,000+100\\bigl[2(6+5)\\bigr]+6\\times5\\\\206\\times205&=40\\,000+2200+30\\\\206\\times205&=42\\,230\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p6-q14-d-iii",
