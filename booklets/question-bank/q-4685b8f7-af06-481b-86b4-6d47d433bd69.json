  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "For $x=-\\dfrac{a}{2}-\\dfrac{b}{c}$, find the exact value of $x$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$a=2$, $b=-2$, $c=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$",
          "worked": "$$\\begin{align*}x&=-\\frac{2}{2}-\\frac{(-2)}{(-1)}\\\\x&=-1-2\\\\x&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$a=\\sqrt{2}$, $b=\\sqrt{2}$, $c=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac{3\\sqrt{2}}{4}$",
          "worked": "$$\\begin{align*}x&=-\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{4}\\\\x&=-\\frac{2\\sqrt{2}}{4}-\\frac{\\sqrt{2}}{4}\\\\x&=-\\frac{3\\sqrt{2}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$a=0$, $b=0$, $c=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "$$\\begin{align*}x&=-\\frac{0}{2}-\\frac{0}{5}\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$a=\\pi$, $b=-\\pi$, $c=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac{5\\pi}{14}$",
          "worked": "$$\\begin{align*}x&=-\\frac{\\pi}{2}-\\frac{(-\\pi)}{7}\\\\x&=-\\frac{\\pi}{2}+\\frac{\\pi}{7}\\\\x&=-\\frac{7\\pi}{14}+\\frac{2\\pi}{14}\\\\x&=-\\frac{5\\pi}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
