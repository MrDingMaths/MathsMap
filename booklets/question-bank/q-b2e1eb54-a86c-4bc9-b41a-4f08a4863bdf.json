  "content": {
    "id": "p5-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Simplify each expression, writing each pronumeral in the answer with a positive index.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$m^6\\times m^{-2}\\times m^{-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{m}$",
          "worked": "$$\\begin{align*}m^6\\times m^{-2}\\times m^{-5}&=m^{6-2-5}\\\\m^6\\times m^{-2}\\times m^{-5}&=\\frac{1}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$2a^{-1}b^3\\times4a^{-3}b^{-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8}{a^4b^3}$",
          "worked": "$$\\begin{align*}2a^{-1}b^3\\times4a^{-3}b^{-6}&=8a^{-4}b^{-3}\\\\2a^{-1}b^3\\times4a^{-3}b^{-6}&=\\frac{8}{a^4b^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$5p^2q^{-1}\\times3pq^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15p^3}{q^5}$",
          "worked": "$$\\begin{align*}5p^2q^{-1}\\times3pq^{-4}&=15p^3q^{-5}\\\\5p^2q^{-1}\\times3pq^{-4}&=\\frac{15p^3}{q^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{15p^4q^{-2}}{10p^{-7}q^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3p^{11}}{2q^6}$",
          "worked": "$$\\begin{align*}\\frac{15p^4q^{-2}}{10p^{-7}q^4}&=\\frac32p^{4-(-7)}q^{-2-4}\\\\\\frac{15p^4q^{-2}}{10p^{-7}q^4}&=\\frac{3p^{11}}{2q^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p5-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{5x^{-2}y^{-3}}{10x^4y^{-4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y}{2x^6}$",
          "worked": "$$\\begin{align*}\\frac{5x^{-2}y^{-3}}{10x^4y^{-4}}&=\\frac12x^{-2-4}y^{-3-(-4)}\\\\\\frac{5x^{-2}y^{-3}}{10x^4y^{-4}}&=\\frac{y}{2x^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p5-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$(2x^{-1})^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^4}{16}$",
          "worked": "$$\\begin{align*}(2x^{-1})^{-4}&=2^{-4}x^4\\\\(2x^{-1})^{-4}&=\\frac{x^4}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p5-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$(2a^{-1}b^3)^{-2}\\times4(a^2b)^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a^4b^9}$",
          "worked": "$$\\begin{align*}(2a^{-1}b^3)^{-2}\\times4(a^2b)^{-3}&=\\frac14a^2b^{-6}\\times4a^{-6}b^{-3}\\\\(2a^{-1}b^3)^{-2}\\times4(a^2b)^{-3}&=a^{-4}b^{-9}\\\\(2a^{-1}b^3)^{-2}\\times4(a^2b)^{-3}&=\\frac1{a^4b^9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p5-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$(m^{-2}n^3)^4\\times(m^{-5}n^2)^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^7n^6$",
          "worked": "$$\\begin{align*}(m^{-2}n^3)^4\\times(m^{-5}n^2)^{-3}&=m^{-8}n^{12}\\times m^{15}n^{-6}\\\\(m^{-2}n^3)^4\\times(m^{-5}n^2)^{-3}&=m^7n^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-q10-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(\\frac{m^2n^{-1}}{p^4}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{p^8n^2}{m^4}$",
          "worked": "$$\\begin{align*}\\left(\\frac{m^2n^{-1}}{p^4}\\right)^{-2}&=\\frac{m^{-4}n^2}{p^{-8}}\\\\\\left(\\frac{m^2n^{-1}}{p^4}\\right)^{-2}&=\\frac{p^8n^2}{m^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p5-q10-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\left(\\frac{a^{-1}b^4}{c^{-1}}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^2}{b^8c^2}$",
          "worked": "$$\\begin{align*}\\left(\\frac{a^{-1}b^4}{c^{-1}}\\right)^{-2}&=\\frac{a^2b^{-8}}{c^2}\\\\\\left(\\frac{a^{-1}b^4}{c^{-1}}\\right)^{-2}&=\\frac{a^2}{b^8c^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p5-q10-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{2a^{-1}b^2}{a^3b^{-2}}\\times\\frac{4a^6b^{-1}}{6ab^{-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4ab^5}{3}$",
          "worked": "$$\\begin{align*}\\frac{2a^{-1}b^2}{a^3b^{-2}}\\times\\frac{4a^6b^{-1}}{6ab^{-2}}&=2a^{-4}b^4\\times\\frac23a^5b\\\\\\frac{2a^{-1}b^2}{a^3b^{-2}}\\times\\frac{4a^6b^{-1}}{6ab^{-2}}&=\\frac{4ab^5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p5-q10-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{m^2n^{-3}}{m^4n^2}\\times\\frac{(mn^2)^{-3}}{m^4n^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{m^9n^{17}}$",
          "worked": "$$\\begin{align*}\\frac{m^2n^{-3}}{m^4n^2}\\times\\frac{(mn^2)^{-3}}{m^4n^6}&=m^{-2}n^{-5}\\times m^{-7}n^{-12}\\\\\\frac{m^2n^{-3}}{m^4n^2}\\times\\frac{(mn^2)^{-3}}{m^4n^6}&=m^{-9}n^{-17}\\\\\\frac{m^2n^{-3}}{m^4n^2}\\times\\frac{(mn^2)^{-3}}{m^4n^6}&=\\frac1{m^9n^{17}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p6-q10-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac{x^4y^{-1}}{(x^2y)^{-3}}\\div\\frac{xy^2}{(xy)^{-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^7}{y^2}$",
          "worked": "$$\\begin{align*}\\frac{x^4y^{-1}}{(x^2y)^{-3}}\\div\\frac{xy^2}{(xy)^{-2}}&=x^{10}y^2\\div x^3y^4\\\\\\frac{x^4y^{-1}}{(x^2y)^{-3}}\\div\\frac{xy^2}{(xy)^{-2}}&=x^7y^{-2}\\\\\\frac{x^4y^{-1}}{(x^2y)^{-3}}\\div\\frac{xy^2}{(xy)^{-2}}&=\\frac{x^7}{y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p6-q10-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{a^{-6}b^4}{(a^2b)^{-3}}\\div\\frac{(a^2b)^{-1}}{ab^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^3b^{11}$",
          "worked": "$$\\begin{align*}\\frac{a^{-6}b^4}{(a^2b)^{-3}}\\div\\frac{(a^2b)^{-1}}{ab^3}&=b^7\\div a^{-3}b^{-4}\\\\\\frac{a^{-6}b^4}{(a^2b)^{-3}}\\div\\frac{(a^2b)^{-1}}{ab^3}&=a^3b^{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p6-q10-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\frac{(2a^4b^{-2})^3}{c^2}\\times\\frac{(2^2a^{-3}b^2)^{-1}}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2a^{15}}{b^8c^3}$",
          "worked": "$$\\begin{align*}\\frac{(2a^4b^{-2})^3}{c^2}\\times\\frac{(2^2a^{-3}b^2)^{-1}}{c}&=\\frac{8a^{12}b^{-6}}{c^2}\\times\\frac{a^3b^{-2}}{4c}\\\\\\frac{(2a^4b^{-2})^3}{c^2}\\times\\frac{(2^2a^{-3}b^2)^{-1}}{c}&=\\frac{2a^{15}}{b^8c^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q10-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\frac{(m^2n^3)^2}{p^{-3}}\\times(mnp^{-2})^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$mn^3p^9$",
          "worked": "$$\\begin{align*}\\frac{(m^2n^3)^2}{p^{-3}}\\times(mnp^{-2})^{-3}&=m^4n^6p^3\\times m^{-3}n^{-3}p^6\\\\\\frac{(m^2n^3)^2}{p^{-3}}\\times(mnp^{-2})^{-3}&=mn^3p^9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q10-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\frac{(a^2)^3}{b^3}\\div\\left(\\frac{a}{b^2}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^8}{b^7}$",
          "worked": "$$\\begin{align*}\\frac{(a^2)^3}{b^3}\\div\\left(\\frac{a}{b^2}\\right)^{-2}&=\\frac{a^6}{b^3}\\times\\frac{a^2}{b^4}\\\\\\frac{(a^2)^3}{b^3}\\div\\left(\\frac{a}{b^2}\\right)^{-2}&=\\frac{a^8}{b^7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p6-q10-r",
        "type": "part",
        "label": "r",
        "prompt": "$\\frac{(2a^4)^2}{b^7}\\div\\frac{(a^2)^{-3}}{2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8a^{14}}{b^6}$",
          "worked": "$$\\begin{align*}\\frac{(2a^4)^2}{b^7}\\div\\frac{(a^2)^{-3}}{2b}&=\\frac{4a^8}{b^7}\\times2ba^6\\\\\\frac{(2a^4)^2}{b^7}\\div\\frac{(a^2)^{-3}}{2b}&=\\frac{8a^{14}}{b^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
