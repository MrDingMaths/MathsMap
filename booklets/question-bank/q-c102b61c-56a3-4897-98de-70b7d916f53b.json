  "content": {
    "id": "p27-q68-root",
    "type": "question",
    "label": "68",
    "prompt": "Solve $16^x-2^{2x+3}+15=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q68-short-result",
            "type": "paragraph",
            "fontSize": null,
