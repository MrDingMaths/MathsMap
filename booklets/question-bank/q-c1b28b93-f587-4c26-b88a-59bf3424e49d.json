  "content": {
    "id": "p29-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Simplify the surds and combine the fractions using a common denominator.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sqrt{8}}{3}-\\dfrac{\\sqrt{2}}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7\\sqrt{2}}{15}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{8}}{3}-\\frac{\\sqrt{2}}{5}&=\\frac{2\\sqrt{2}}{3}-\\frac{\\sqrt{2}}{5}\\\\&=\\frac{10\\sqrt{2}-3\\sqrt{2}}{15}\\\\&=\\frac{7\\sqrt{2}}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p29-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sqrt{12}}{4}+\\dfrac{\\sqrt{3}}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{12}}{4}+\\frac{\\sqrt{3}}{6}&=\\frac{2\\sqrt{3}}{4}+\\frac{\\sqrt{3}}{6}\\\\&=\\frac{6\\sqrt{3}+2\\sqrt{3}}{12}\\\\&=\\frac{8\\sqrt{3}}{12}\\\\&=\\frac{2\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p29-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3\\sqrt{5}}{4}-\\dfrac{\\sqrt{20}}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{5}}{12}$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt{5}}{4}-\\frac{\\sqrt{20}}{3}&=\\frac{3\\sqrt{5}}{4}-\\frac{2\\sqrt{5}}{3}\\\\&=\\frac{9\\sqrt{5}-8\\sqrt{5}}{12}\\\\&=\\frac{\\sqrt{5}}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p29-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sqrt{98}}{4}-\\dfrac{5\\sqrt{2}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3\\sqrt{2}}{4}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{98}}{4}-\\frac{5\\sqrt{2}}{2}&=\\frac{7\\sqrt{2}}{4}-\\frac{5\\sqrt{2}}{2}\\\\&=\\frac{7\\sqrt{2}-10\\sqrt{2}}{4}\\\\&=-\\frac{3\\sqrt{2}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p29-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{2\\sqrt{75}}{5}-\\dfrac{3\\sqrt{3}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{3}}{2}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{75}}{5}-\\frac{3\\sqrt{3}}{2}&=\\frac{10\\sqrt{3}}{5}-\\frac{3\\sqrt{3}}{2}\\\\&=\\frac{20\\sqrt{3}-15\\sqrt{3}}{10}\\\\&=\\frac{5\\sqrt{3}}{10}\\\\&=\\frac{\\sqrt{3}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p29-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\sqrt{63}}{9}-\\dfrac{4\\sqrt{7}}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{7\\sqrt{7}}{15}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{63}}{9}-\\frac{4\\sqrt{7}}{5}&=\\frac{3\\sqrt{7}}{9}-\\frac{4\\sqrt{7}}{5}\\\\&=\\frac{15\\sqrt{7}-36\\sqrt{7}}{45}\\\\&=-\\frac{21\\sqrt{7}}{45}\\\\&=-\\frac{7\\sqrt{7}}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p29-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{2\\sqrt{18}}{3}-\\dfrac{\\sqrt{72}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{18}}{3}-\\frac{\\sqrt{72}}{2}&=\\frac{6\\sqrt{2}}{3}-\\frac{6\\sqrt{2}}{2}\\\\&=\\frac{12\\sqrt{2}-18\\sqrt{2}}{6}\\\\&=-\\frac{6\\sqrt{2}}{6}\\\\&=-\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p29-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\sqrt{54}}{4}+\\dfrac{\\sqrt{24}}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{29\\sqrt{6}}{28}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{54}}{4}+\\frac{\\sqrt{24}}{7}&=\\frac{3\\sqrt{6}}{4}+\\frac{2\\sqrt{6}}{7}\\\\&=\\frac{21\\sqrt{6}+8\\sqrt{6}}{28}\\\\&=\\frac{29\\sqrt{6}}{28}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p29-q10-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{\\sqrt{27}}{5}-\\dfrac{\\sqrt{108}}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{27}}{5}-\\frac{\\sqrt{108}}{10}&=\\frac{3\\sqrt{3}}{5}-\\frac{6\\sqrt{3}}{10}\\\\&=\\frac{6\\sqrt{3}-6\\sqrt{3}}{10}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p29-q10-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{5\\sqrt{48}}{6}+\\dfrac{2\\sqrt{147}}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{5\\sqrt{48}}{6}+\\frac{2\\sqrt{147}}{3}&=\\frac{20\\sqrt{3}}{6}+\\frac{14\\sqrt{3}}{3}\\\\&=\\frac{20\\sqrt{3}+28\\sqrt{3}}{6}\\\\&=\\frac{48\\sqrt{3}}{6}\\\\&=8\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p29-q10-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{2\\sqrt{96}}{5}-\\dfrac{\\sqrt{600}}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6\\sqrt{6}}{35}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{96}}{5}-\\frac{\\sqrt{600}}{7}&=\\frac{8\\sqrt{6}}{5}-\\frac{10\\sqrt{6}}{7}\\\\&=\\frac{56\\sqrt{6}-50\\sqrt{6}}{35}\\\\&=\\frac{6\\sqrt{6}}{35}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p29-q10-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{3\\sqrt{125}}{14}-\\dfrac{2\\sqrt{80}}{21}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{29\\sqrt{5}}{42}$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt{125}}{14}-\\frac{2\\sqrt{80}}{21}&=\\frac{15\\sqrt{5}}{14}-\\frac{8\\sqrt{5}}{21}\\\\&=\\frac{45\\sqrt{5}-16\\sqrt{5}}{42}\\\\&=\\frac{29\\sqrt{5}}{42}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
