  "content": {
    "id": "p57-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A bag contains 3 green and 6 blue balls. How many ways are there of drawing 4 balls if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "the balls may be of any colour,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$126$",
          "worked": "$$\\begin{aligned}N&={}^{9}C_{4}\\\\&=126\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p57-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "there are exactly two green balls,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45$",
          "worked": "Choose 2 green balls and 2 blue balls.\n$$\\begin{aligned}N&={}^{3}C_{2}\\times{}^{6}C_{2}\\\\&=3\\times15\\\\&=45\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p57-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "there are at least two green balls,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$51$",
          "worked": "There are two cases.\n\n2 green and 2 blue: ${}^{3}C_{2}\\times{}^{6}C_{2}=45$ (part b).\n\n3 green and 1 blue: ${}^{3}C_{3}\\times{}^{6}C_{1}=6$.\n\nTotal: $45+6=51$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p57-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "there are more blue balls than green balls.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75$",
          "worked": "There are two cases.\n\n3 blue and 1 green: ${}^{6}C_{3}\\times{}^{3}C_{1}=60$.\n\n4 blue and no green: ${}^{6}C_{4}=15$.\n\nTotal: $60+15=75$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
