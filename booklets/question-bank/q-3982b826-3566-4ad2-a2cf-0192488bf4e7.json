  "content": {
    "id": "v2-33783-p14-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "In a street of 80 houses, 34 have solar panels, 29 have a water tank, and 12 have both.\nHow many houses have solar panels or a water tank?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "51 houses.",
      "worked": "Let $S$ and $T$ be the sets of houses with solar panels and a water tank.\n$$\\begin{align*}|S\\cup T|&=|S|+|T|-|S\\cap T|\\\\|S\\cup T|&=34+29-12\\\\|S\\cup T|&=51\\end{align*}$$\n51 houses have solar panels or a water tank.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
