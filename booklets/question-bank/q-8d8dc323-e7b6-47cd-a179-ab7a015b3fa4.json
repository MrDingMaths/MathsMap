      {
        "id": "p26-q30",
        "type": "part",
        "label": "a",
        "prompt": "$e^{2x-3}=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{3+\\ln 7}{2}$",
          "worked": "$$\\begin{align*}\\ln(e^{2x-3})&=\\ln 7\\\\2x-3&=\\ln 7\\\\2x&=3+\\ln 7\\\\x&=\\frac{3+\\ln 7}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p26-q31",
        "type": "part",
        "label": "b",
        "prompt": "$4^{3x+1}=14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac13\\left(\\dfrac{\\ln 14}{\\ln 4}-1\\right)$",
          "worked": "$$\\begin{align*}\\ln(4^{3x+1})&=\\ln 14\\\\(3x+1)\\ln 4&=\\ln 14\\\\3x+1&=\\frac{\\ln 14}{\\ln 4}\\\\3x&=\\frac{\\ln 14}{\\ln 4}-1\\\\x&=\\frac13\\left(\\frac{\\ln 14}{\\ln 4}-1\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p26-q32",
        "type": "part",
        "label": "c",
        "prompt": "$11^{x-4}=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4+\\dfrac{\\ln 6}{\\ln 11}$",
          "worked": "$$\\begin{align*}\\ln(11^{x-4})&=\\ln 6\\\\(x-4)\\ln 11&=\\ln 6\\\\x-4&=\\frac{\\ln 6}{\\ln 11}\\\\x&=4+\\frac{\\ln 6}{\\ln 11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p26-q33",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{e^{2x-1}-1}{3}=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{1+\\ln 16}{2}$",
          "worked": "$$\\begin{align*}e^{2x-1}-1&=15\\\\e^{2x-1}&=16\\\\\\ln(e^{2x-1})&=\\ln 16\\\\2x-1&=\\ln 16\\\\2x&=1+\\ln 16\\\\x&=\\frac{1+\\ln 16}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
