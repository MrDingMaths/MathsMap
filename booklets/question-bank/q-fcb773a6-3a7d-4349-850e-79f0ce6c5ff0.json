  "content": {
    "id": "p12-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Rearrange the following to make $a$ the subject.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$$y=\\sqrt{\\frac{a}{4}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4y^2$",
          "worked": "$$\\begin{align*}y^2&=\\frac{a}{4}\\\\a&=4y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p12-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$$y=\\sqrt{\\frac{a}{4}}+1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4(y-1)^2$",
          "worked": "$$\\begin{align*}y-1&=\\sqrt{\\frac{a}{4}}\\\\(y-1)^2&=\\frac{a}{4}\\\\a&=4(y-1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$$y=\\sqrt{\\frac{a^2}{4}+1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm\\sqrt{4(y^2-1)}$",
          "worked": "$$\\begin{align*}y^2&=\\frac{a^2}{4}+1\\\\y^2-1&=\\frac{a^2}{4}\\\\4(y^2-1)&=a^2\\\\a&=\\pm\\sqrt{4(y^2-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$$y=\\sqrt{a^2+\\frac{1}{4}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm\\sqrt{y^2-\\frac{1}{4}}$",
          "worked": "$$\\begin{align*}y^2&=a^2+\\frac{1}{4}\\\\y^2-\\frac{1}{4}&=a^2\\\\a&=\\pm\\sqrt{y^2-\\frac{1}{4}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
