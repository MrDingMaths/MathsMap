      {
        "id": "p34-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Why does the graph not show the whole parabola?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Time and height cannot be negative, so only $0\\leq t\\leq5$ is physically meaningful.",
          "worked": "The model describes the object's flight from launch to ground contact. Negative time is outside this flight and negative height would place the object below ground, so the graph shows only $0\\leq t\\leq5$.",
