  "content": {
    "id": "v2-94509-p15-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the number of terms in each partial sum and hence evaluate it.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-94509-p15-practice-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$2+6+18+\\cdots+4374$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$ terms; $S_8=6560$.",
          "worked": "$a=2$ and $r=3$.\n$$\\begin{align*}a_n&=ar^{n-1}\\\\4374&=2\\times3^{n-1}\\\\3^{n-1}&=2187\\\\3^{n-1}&=3^7\\\\n&=8\\end{align*}$$\n$$\\begin{align*}S_8&=\\frac{2(3^8-1)}{3-1}\\\\S_8&=6560\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-94509-p15-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$1-3+9-\\cdots+6561$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$ terms; $S_9=4921$.",
          "worked": "$a=1$ and $r=-3$.\n$$\\begin{align*}a_n&=ar^{n-1}\\\\6561&=(-3)^{n-1}\\\\3^8&=(-3)^{n-1}\\\\n-1&=8\\\\n&=9\\end{align*}$$\n$$\\begin{align*}S_9&=\\frac{1(1-(-3)^9)}{1-(-3)}\\\\S_9&=\\frac{1+19\\,683}{4}\\\\S_9&=4921\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-94509-p15-practice-slot-4-slot-4-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$192+96+48+\\cdots+\\dfrac{3}{16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$ terms; $S_{11}=\\dfrac{6141}{16}$.",
          "worked": "$a=192$ and $r=\\dfrac12$.\n$$\\begin{align*}a_n&=ar^{n-1}\\\\\\frac{3}{16}&=192\\left(\\frac12\\right)^{n-1}\\\\\\left(\\frac12\\right)^{n-1}&=\\frac{1}{1024}\\\\\\left(\\frac12\\right)^{n-1}&=\\left(\\frac12\\right)^{10}\\\\n&=11\\end{align*}$$\n$$\\begin{align*}S_{11}&=\\frac{192\\left(1-\\left(\\frac12\\right)^{11}\\right)}{1-\\frac12}\\\\S_{11}&=384\\times\\frac{2047}{2048}\\\\S_{11}&=\\frac{6141}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
