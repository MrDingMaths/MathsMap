      {
        "id": "p2-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the line through the point $(3, 2)$ parallel to the line with equation $y=2x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-4$",
          "worked": "Parallel lines have equal gradients, so $m=2$.\n\n$$\\begin{align*}y&=2x+c\\\\2&=2(3)+c\\\\c&=-4\\end{align*}$$\n\nTherefore $y=2x-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p2-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation of the line through the point $(3, 2)$ perpendicular to the line with equation $y=2x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac12x+\\frac72$",
          "worked": "Perpendicular gradients have product $-1$, so $m=-\\frac12$.\n\n$$\\begin{align*}y&=-\\frac12x+c\\\\2&=-\\frac12(3)+c\\\\c&=2+\\frac32\\\\c&=\\frac72\\end{align*}$$\n\nTherefore $y=-\\frac12x+\\frac72$, equivalently $x+2y=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
