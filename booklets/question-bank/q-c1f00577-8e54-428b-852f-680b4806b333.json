  "content": {
    "id": "p13-q3",
    "type": "question",
    "label": "3",
    "prompt": "A car travels a distance of 240 km at an average speed of 60 km/h. How long does the journey take?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\text{ hours}$",
      "worked": "$$\\begin{align*}\\text{Time}&=\\frac{\\text{distance}}{\\text{speed}}\\\\\\text{Time}&=\\frac{240}{60}\\\\\\text{Time}&=4\\text{ hours}\\end{align*}$$",
      "solutionDiagrams": []
    },
