  "content": {
    "id": "p39-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The land speed record is $20.4\\text{ km/min}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Express this speed in km/h.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1224\\text{ km/h}$",
          "worked": "$$\\begin{align*}\\frac{20.4\\text{ km}}{1\\text{ min}}&=\\frac{20.4\\text{ km}}{(1\\div60)\\text{ h}}\\\\\\frac{20.4\\text{ km}}{1\\text{ min}}&=\\frac{1224\\text{ km}}{1\\text{ h}}\\\\s&=1224\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "How far does this vehicle travel in 5 minutes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$102\\text{ km}$",
          "worked": "$$\\begin{align*}d&=st\\\\d&=20.4\\times5\\\\d&=102\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p39-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "How far does this vehicle travel in 1 second?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.34\\text{ km}$",
          "worked": "$$\\begin{align*}t&=\\frac{1}{60}\\text{ min}\\\\d&=st\\\\d&=20.4\\times\\frac{1}{60}\\\\d&=0.34\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "How long would it take for this vehicle to travel from Sydney to Brisbane (982 km)?\nAnswer to the nearest minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\text{ min}$",
          "worked": "$$\\begin{align*}t&=\\frac{d}{s}\\\\t&=\\frac{982}{20.4}\\\\t&=\\frac{2455}{51}\\text{ min}\\\\t&\\approx48\\text{ min}\\end{align*}$$\nTo the nearest minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
