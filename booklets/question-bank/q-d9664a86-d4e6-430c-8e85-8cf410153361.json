  "content": {
    "id": "p6-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "From a point $O$, the point $P$ has a bearing of $135^\\circ$ and is 12 km away. The point $Q$ is 16 km away from $O$ on a bearing of $225^\\circ$. Calculate the distance $PQ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20\\text{ km}$",
      "worked": "The angle $\\angle POQ=225^\\circ-135^\\circ=90^\\circ$. By Pythagoras' theorem,\n$$\\begin{align*}PQ^2&=12^2+16^2\\\\PQ^2&=400\\\\PQ&=20\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 21
