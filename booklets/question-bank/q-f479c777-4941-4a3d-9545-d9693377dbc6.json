  "content": {
    "id": "p52-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "An object is dropped from an aeroplane. Let $s$ be the speed of the particle in metres per second, and $t$ be time in seconds. The speed of the particle is given by the formula $s=10(1-e^{-t})$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the speed of the particle two seconds after release. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.65\\text{ m/s}$",
          "worked": "$$\\begin{align*}s&=10(1-e^{-2})\\\\s&\\approx8.65\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p52-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "How long does it take for the particle to reach a speed of 5 metres per second? Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\ln2\\approx0.69\\text{ seconds}$",
          "worked": "$$\\begin{align*}5&=10(1-e^{-t})\\\\\\frac12&=1-e^{-t}\\\\e^{-t}&=\\frac12\\\\-t&=\\ln\\left(\\frac12\\right)\\\\t&=\\ln2\\\\t&\\approx0.69\\text{ seconds}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p52-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Does this particle ever reach a speed of 10 metres per second? Justify your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. It approaches $10\\text{ m/s}$ but never reaches it.",
          "worked": "For every finite time $t\\ge0$, $e^{-t}>0$, so $10(1-e^{-t})<10$. As $t$ increases, $e^{-t}$ approaches zero, so the speed approaches $10\\text{ m/s}$ without reaching it.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
