  "content": {
    "id": "p59-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "In each case, find the function obtained by the given reflection or rotation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p59-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^3-2x+1$: reflect in the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^3+2x+1$",
          "worked": "Reflecting in the $y$-axis replaces $x$ by $-x$.\n\n$$\\begin{align*}y&=(-x)^3-2(-x)+1\\\\y&=-x^3+2x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p59-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2-3x-4$: reflect in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^2+3x+4$",
          "worked": "Reflecting in the $x$-axis changes the sign of each function value.\n\n$$\\begin{align*}y&=-(x^2-3x-4)\\\\y&=-x^2+3x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p59-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2^x-x$: rotate $180^\\circ$ about the origin.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2^{-x}-x$",
          "worked": "A $180^\\circ$ rotation about the origin sends $(x,y)$ to $(-x,-y)$, giving $y=-f(-x)$.\n\n$$\\begin{align*}y&=-\\bigl(2^{-x}-(-x)\\bigr)\\\\y&=-2^{-x}-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p59-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\sqrt{9-x^2}$: reflect in the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sqrt{9-x^2}$",
          "worked": "Replace $x$ by $-x$.\n\n$$\\begin{align*}y&=\\sqrt{9-(-x)^2}\\\\y&=\\sqrt{9-x^2}\\end{align*}$$\n\nThe function is unchanged because its graph is symmetric about the $y$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
