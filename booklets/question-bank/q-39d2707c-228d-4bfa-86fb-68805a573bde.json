  "content": {
    "id": "p20-q12-root",
    "type": "question",
    "label": null,
    "prompt": "State the domain of the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\sqrt{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge-3$",
          "worked": "The radicand must be nonnegative: $x+3\\ge0$. Hence the domain is $x\\ge-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac1{\\sqrt{x+3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-3$",
          "worked": "The square root is in the denominator, so $x+3>0$. Hence the domain is $x>-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p20-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac1{x^2+9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R$",
          "worked": "For every real $x$, $x^2+9\\ge9>0$. The denominator never vanishes, so the domain is $\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac1{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R,\\ x\\ne\\pm3$",
          "worked": "The denominator must be nonzero: $(x-3)(x+3)\\ne0$. The domain is $x\\in\\mathbb R$, $x\\ne\\pm3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\dfrac1{x^2-5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R,\\ x\\ne2,3$",
          "worked": "The denominator must be nonzero: $x^2-5x+6=(x-2)(x-3)\\ne0$. The domain is $x\\in\\mathbb R$, $x\\ne2,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\sqrt{6-3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le2$",
          "worked": "$$\\begin{align*}6-3x&\\ge0\\\\-3x&\\ge-6\\\\x&\\le2.\\end{align*}$$\nThe domain is $x\\le2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p20-q12-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=\\dfrac{x^3}{x^2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R,\\ x\\ne\\pm1$",
          "worked": "The denominator must be nonzero: $(x-1)(x+1)\\ne0$. The domain is $x\\in\\mathbb R$, $x\\ne\\pm1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q12-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(x)=\\dfrac1{\\sqrt{6-x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<6$",
          "worked": "The square root is in the denominator, so $6-x>0$. Hence the domain is $x<6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p20-q12-i",
        "type": "part",
        "label": "i",
        "prompt": "$f(x)=\\dfrac{x}{x^3+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R,\\ x\\ne0$",
          "worked": "The denominator is $x(x^2+1)$. Since $x^2+1>0$ for real $x$, only $x=0$ is excluded. The domain is $x\\in\\mathbb R$, $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
