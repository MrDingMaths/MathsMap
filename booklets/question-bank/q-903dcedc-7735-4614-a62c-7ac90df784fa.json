        "type": "part",
        "label": "a",
        "prompt": "$\\sin 360^\\circ=0$ and $\\cos 360^\\circ=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=(1,0)$ after one complete anticlockwise turn.",
          "worked": "Draw the unit circle centred at the origin and show one complete anticlockwise turn from the positive $x$-axis. Its endpoint is $P=(1,0)$. Sine is the $y$-coordinate and cosine is the $x$-coordinate.\n$$\\begin{align*}\\sin 360^\\circ&=0\\\\\\cos 360^\\circ&=1\\end{align*}$$",
          "solutionDiagrams": [
            {
              "id": "p6-q3-a-solution-circle",
              "role": "solution",
              "format": "tikz",
              "code": "\\begin{tikzpicture}[x=1.7cm,y=1.7cm,every node/.style={font=\\fontsize{10}{12}\\selectfont},>=stealth]\\path[use as bounding box] (-1.45,-1.4) rectangle (1.75,1.45);\\draw[black] (0,0) circle (1);\\draw[black,->] (-1.35,0)--(1.5,0) node[right] {$x$};\\draw[black,->] (0,-1.3)--(0,1.3) node[above] {$y$};\\node[below left] at (0,0) {$O$};\\draw[black,->] (1,0) arc[start angle=0,end angle=360,radius=1];\\fill[black] (1,0) circle (1.5pt);\\node[above right] at (1,0) {$(1,0)$};\\end{tikzpicture}",
              "src": null,
              "widthMm": 55,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 6,
                "sourceRegion": "Question 3(a); teacher PDF page 18, Section A 3(a)",
                "description": "Unit circle with a complete anticlockwise rotation ending on the positive x-axis; corrects the teacher diagram's endpoint label.",
                "mathematics": "The endpoint at 360 degrees is (1,0), so sine is 0 and cosine is 1.",
                "answerVisibility": "solution-only"
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 55
      },
