          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "The particle is initially at ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x=6",
              "display": false
            },
            {
              "type": "text",
              "text": ", and moves to the left with a speed of ",
