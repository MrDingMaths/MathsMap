  "content": {
    "id": "p26-group33-36",
    "type": "question",
    "label": null,
    "prompt": "Find the range.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-group33-36-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x+1$ for $-2\\le x\\le 3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=[-1,4]$.",
          "worked": "Add $1$ throughout the domain bounds. Both endpoints are attained.\n\n$$\\begin{align*}-1&\\le x+1\\le 4\\\\R&=[-1,4].\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-group33-36-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2$ for $-2\\le x\\le 1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p26-group33-36-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "R=[0,4]",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p26-group33-36-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The minimum occurs at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": "; check both domain endpoints for the maximum.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The domain contains $x=0$, where $x^2$ has its minimum. Compare the endpoint values for the maximum.\n\n$$\\begin{align*}f(0)&=0\\\\f(-2)&=4\\\\f(1)&=1.\\end{align*}$$\n\nThe minimum is $0$ and the maximum is $4$, with every intermediate value attained.\n\n$$R=[0,4].$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p26-group33-36-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sqrt{x}$ for $0\\le x\\le 9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=[0,3]$.",
          "worked": "Square root is increasing on the given domain. Taking square roots of the bounds gives\n\n$$\\begin{align*}0&\\le\\sqrt{x}\\le 3\\\\R&=[0,3].\\end{align*}$$\n\nBoth endpoints are attained.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p26-group33-36-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\sqrt{4-x}$ for $-5\\le x\\le 3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=[1,3]$.",
          "worked": "Subtract the input bounds from $4$, reversing their order, then take square roots.\n\n$$\\begin{align*}1&\\le 4-x\\le 9\\\\1&\\le\\sqrt{4-x}\\le 3\\\\R&=[1,3].\\end{align*}$$\n\nBoth bounds are attained at the included domain endpoints.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
