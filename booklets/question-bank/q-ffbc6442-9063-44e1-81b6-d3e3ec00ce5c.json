  "content": {
    "id": "p51-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Consider $x^3-2x^2+kx+18=0$. Given one of the roots is one more than another root, find the value of $k$ and the roots.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
