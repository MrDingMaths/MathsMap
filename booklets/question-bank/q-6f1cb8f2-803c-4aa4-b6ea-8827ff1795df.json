    "children": [
      {
        "id": "p52-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the natural domain of $y=\\dfrac{e^x}{x}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb R,\\ x\\ne0$.",
          "worked": "The numerator $e^x$ is defined for every real $x$, but the denominator cannot be zero. Hence the natural domain is $\\mathbb R\\setminus\\{0\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p52-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the curve has a local minimum at $(1,e)$ but no inflection points.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{e^x(x-1)}{x^2}$ changes from negative to positive at $x=1$, where $y=e$. Also $y''=\\dfrac{e^x((x-1)^2+1)}{x^3}$ is never zero: the curve is concave down for $x<0$ and concave up for $x>0$. There is no inflection point because $x=0$ is outside the domain.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p52-q19-b-derivatives",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}y'&=\\frac{xe^x-e^x}{x^2}\\\\y'&=\\frac{e^x(x-1)}{x^2}\\\\y''&=\\frac{x^2(xe^x)-2xe^x(x-1)}{x^4}\\\\y''&=\\frac{e^x(x^2-2x+2)}{x^3}\\\\y''&=\\frac{e^x((x-1)^2+1)}{x^3}\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p52-q19-b-stationary",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "e^x>0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", the only stationary point occurs at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", where ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=e",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
