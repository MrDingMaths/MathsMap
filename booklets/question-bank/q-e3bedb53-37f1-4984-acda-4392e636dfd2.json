  "content": {
    "id": "p19-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Express each number as a product of prime factors.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times5$",
          "worked": "$$15=3\\times5$$\nBoth factors are prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$75$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times5^2$",
          "worked": "$$\\begin{align*}75&=3\\times25\\\\75&=3\\times5\\times5\\\\75&=3\\times5^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times3^2$",
          "worked": "$$\\begin{align*}36&=4\\times9\\\\36&=2\\times2\\times3\\times3\\\\36&=2^2\\times3^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$96$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^5\\times3$",
          "worked": "$$\\begin{align*}96&=2\\times48\\\\96&=2^2\\times24\\\\96&=2^3\\times12\\\\96&=2^4\\times6\\\\96&=2^5\\times3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p19-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$256$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^8$",
          "worked": "Since $16=2\\times2\\times2\\times2=2^4$,\n$$\\begin{align*}256&=16\\times16\\\\256&=2^4\\times2^4\\\\256&=2^8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p19-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$841$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$29^2$",
          "worked": "$$\\begin{align*}841&=29\\times29\\\\841&=29^2\\end{align*}$$\n$29$ is prime: it has no prime divisor among $2$, $3$ and $5$, the primes below $\\sqrt{29}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
