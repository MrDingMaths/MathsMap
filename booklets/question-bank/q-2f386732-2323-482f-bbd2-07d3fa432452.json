        "answer": {
          "short": "$0.36$",
          "worked": "$$\\begin{align*}\\text{Total}&=12+18+14+6=50\\\\\\text{Relative frequency}&=\\frac{18}{50}\\\\&=0.36\\end{align*}$$",
