        "label": "b",
        "prompt": "Find the relative frequency of patients who waited 20 minutes or less as a percentage.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60\\%$",
          "worked": "Patients who waited 20 minutes or less are in the classes $0<t\\leq10$ and $10<t\\leq20$: $12+18=30$.\n\n$$\\begin{align*}\\text{Relative frequency}&=\\frac{30}{50}\\\\&=0.6\\\\&=60\\%\\end{align*}$$",
