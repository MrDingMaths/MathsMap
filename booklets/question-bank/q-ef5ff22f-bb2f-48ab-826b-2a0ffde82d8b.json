      {
        "id": "p53-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the range of the function $y=\\cos x\\sin x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12\\le y\\le\\frac12$.",
          "worked": "$$y=\\cos x\\sin x=\\frac12\\sin 2x.$$\nSince $-1\\le\\sin 2x\\le1$, the range is $-\\frac12\\le y\\le\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p53-q7-integration-group",
        "type": "group",
        "label": "",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p53-q7-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Integrate ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y=\\cos x\\sin x",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " in three ways:",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p53-q7-b",
            "type": "part",
            "label": "b",
            "prompt": "using the $\\sin 2x$ formula",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\frac14\\cos 2x+C$",
              "worked": "$$\\begin{aligned}\\int\\cos x\\sin x\\,dx&=\\int\\frac12\\sin 2x\\,dx\\\\&=-\\frac14\\cos 2x+C.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p53-q7-c",
            "type": "part",
            "label": "c",
            "prompt": "using the reverse chain rule in two different ways",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac12\\sin^2x+D$ and $-\\frac12\\cos^2x+E$.",
              "worked": "Using $u=\\sin x$, $du=\\cos x\\,dx$:\n$$\\begin{aligned}\\int\\cos x\\sin x\\,dx&=\\int u\\,du\\\\&=\\frac12u^2+D\\\\&=\\frac12\\sin^2x+D.\\end{aligned}$$\nUsing $u=\\cos x$, $du=-\\sin x\\,dx$:\n$$\\begin{aligned}\\int\\cos x\\sin x\\,dx&=-\\int u\\,du\\\\&=-\\frac12u^2+E\\\\&=-\\frac12\\cos^2x+E.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          },
          {
            "id": "p53-q7-d",
            "type": "part",
            "label": "d",
            "prompt": "Reconcile the three results.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The forms differ only by constants: $D=C-\\frac14$ and $E=C+\\frac14$.",
              "worked": "Using $\\cos 2x=1-2\\sin^2x$:\n$$\\begin{aligned}-\\frac14\\cos 2x+C&=-\\frac14(1-2\\sin^2x)+C\\\\&=\\frac12\\sin^2x+C-\\frac14.\\end{aligned}$$\nThus $D=C-\\frac14$.\n\nUsing $\\cos 2x=2\\cos^2x-1$:\n$$\\begin{aligned}-\\frac14\\cos 2x+C&=-\\frac14(2\\cos^2x-1)+C\\\\&=-\\frac12\\cos^2x+C+\\frac14.\\end{aligned}$$\nThus $E=C+\\frac14$. All three forms describe the same family of antiderivatives.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      }
    ]
