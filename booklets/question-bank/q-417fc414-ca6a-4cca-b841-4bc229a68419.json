    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2^x$.\n\nShow that $f(x)\\times f(-x)=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)f(-x)=2^x2^{-x}=1$.",
          "worked": "$$\\begin{align*}f(x)f(-x)&=2^x\\times2^{-x}\\\\&=2^{x-x}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x-x^3$.\n\nShow that $f(-x)=-f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x+x^3=-(x-x^3)=-f(x)$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)-(-x)^3\\\\&=-x+x^3\\\\&=-(x-x^3)\\\\&=-f(x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p18-q25-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{x}{x+1}$.\n\nShow that $f(x)+f\\!\\left(\\dfrac1x\\right)=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)+f(\\frac{1}{x})=\\dfrac{x}{x+1}+\\dfrac1{x+1}=1$, for $x\\ne0,-1$.",
          "worked": "For $x\\ne0,-1$,\n$$\\begin{align*}f\\!\\left(\\frac1x\\right)&=\\frac{1/x}{1/x+1}\\\\&=\\frac1{x+1}\\\\f(x)+f\\!\\left(\\frac1x\\right)&=\\frac{x}{x+1}+\\frac1{x+1}\\\\&=\\frac{x+1}{x+1}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p18-q25-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{x}{x^2+1}$.\n\nShow that $f\\!\\left(\\dfrac1x\\right)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(\\frac{1}{x})=\\dfrac{x}{x^2+1}=f(x)$, for $x\\ne0$.",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}f\\!\\left(\\frac1x\\right)&=\\frac{1/x}{(1/x)^2+1}\\\\&=\\frac{1/x}{(1+x^2)/x^2}\\\\&=\\frac{x}{1+x^2}\\\\&=f(x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q25-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=px^2-x$.\n\nFind $p$ if $f(-3)=2f(2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=-7$.",
          "worked": "$$\\begin{align*}f(-3)&=p(-3)^2-(-3)=9p+3\\\\f(2)&=p(2)^2-2=4p-2\\\\9p+3&=2(4p-2)\\\\9p+3&=8p-4\\\\p&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q25-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\dfrac{x}{x^2-1}$.\n\nShow that $f(x)+f\\!\\left(\\dfrac1x\\right)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(\\frac{1}{x})=-\\dfrac{x}{x^2-1}$, so $f(x)+f(\\frac{1}{x})=0$, for $x\\ne0,\\pm1$.",
          "worked": "For $x\\ne0,\\pm1$,\n$$\\begin{align*}f\\!\\left(\\frac1x\\right)&=\\frac{1/x}{1/x^2-1}\\\\&=\\frac{x}{1-x^2}\\\\&=-\\frac{x}{x^2-1}\\\\f(x)+f\\!\\left(\\frac1x\\right)&=\\frac{x}{x^2-1}-\\frac{x}{x^2-1}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p18-q25-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=\\dfrac{a-x}{1+bx}$, where $ab\\ne-1$ and $1+bx\\ne0$.\n\nShow that $f\\!\\left(\\dfrac{a-x}{1+bx}\\right)=x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f\\!\\left(\\dfrac{a-x}{1+bx}\\right)=\\dfrac{x(1+ab)}{1+ab}=x$.",
          "worked": "$$\\begin{align*}f\\!\\left(\\frac{a-x}{1+bx}\\right)&=\\frac{a-\\frac{a-x}{1+bx}}{1+b\\frac{a-x}{1+bx}}\\\\&=\\frac{a(1+bx)-(a-x)}{1+bx+b(a-x)}\\\\&=\\frac{abx+x}{1+ab}\\\\&=\\frac{x(1+ab)}{1+ab}\\\\&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p18-q25-h",
        "type": "part",
        "label": "h",
        "prompt": "$c(x)=\\dfrac{3^x+3^{-x}}2$, $s(x)=\\dfrac{3^x-3^{-x}}2$.\n\nShow that $(c(x))^2-(s(x))^2=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(c(x))^2-(s(x))^2=\\dfrac{4\\cdot3^x3^{-x}}4=1$.",
          "worked": "$$\\begin{align*}(c(x))^2-(s(x))^2&=\\frac{(3^x+3^{-x})^2-(3^x-3^{-x})^2}{4}\\\\&=\\frac{\\left(3^{2x}+2\\cdot3^x3^{-x}+3^{-2x}\\right)-\\left(3^{2x}-2\\cdot3^x3^{-x}+3^{-2x}\\right)}4\\\\&=\\frac{4\\cdot3^x3^{-x}}4\\\\&=3^0\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
