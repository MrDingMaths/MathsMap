  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A car is $d$ km from home after $t$ hours according to the formula $d=10t^2+5t+11$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q1-a",
        "type": "group",
        "label": "a",
        "prompt": "How far is the car from home:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q1-a-i",
            "type": "part",
            "label": "i",
            "prompt": "initially?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$11\\text{ km}$",
              "worked": "$$\\begin{align*}d(0)&=10(0)^2+5(0)+11\\\\&=11\\text{ km}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          },
          {
            "id": "p19-q1-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "after 3 hours?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$116\\text{ km}$",
              "worked": "$$\\begin{align*}d(3)&=10(3)^2+5(3)+11\\\\&=90+15+11\\\\&=116\\text{ km}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p19-q1-b",
        "type": "group",
        "label": "b",
        "prompt": "At what speed is the car travelling after:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q1-b-i",
            "type": "part",
            "label": "i",
            "prompt": "3 hours?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$65\\text{ km/h}$",
              "worked": "$$\\begin{align*}\\frac{\\mathrm{d}d}{\\mathrm{d}t}&=20t+5\\\\\\left.\\frac{\\mathrm{d}d}{\\mathrm{d}t}\\right|_{t=3}&=20(3)+5\\\\&=65\\text{ km/h}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p19-q1-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "5 hours?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$105\\text{ km/h}$",
              "worked": "$$\\begin{align*}\\frac{\\mathrm{d}d}{\\mathrm{d}t}&=20t+5\\\\\\left.\\frac{\\mathrm{d}d}{\\mathrm{d}t}\\right|_{t=5}&=20(5)+5\\\\&=105\\text{ km/h}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      }
    ]
