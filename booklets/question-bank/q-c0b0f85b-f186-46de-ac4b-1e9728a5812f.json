        "label": "a",
        "prompt": "$2\\sin30^{\\circ}\\cos30^{\\circ}=\\sin60^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sqrt3}{2}=\\mathrm{RHS}$",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=2\\left(\\frac12\\right)\\left(\\frac{\\sqrt3}{2}\\right)\\\\&=\\frac{2\\sqrt3}{4}\\\\&=\\frac{\\sqrt3}{2}=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos^260^{\\circ}-\\cos^230^{\\circ}=-\\dfrac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=-\\dfrac12=\\mathrm{RHS}$",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\left(\\frac12\\right)^2-\\left(\\frac{\\sqrt3}{2}\\right)^2\\\\&=\\frac14-\\frac34\\\\&=-\\frac24\\\\&=-\\frac12=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin60^{\\circ}\\cos45^{\\circ}-\\cos60^{\\circ}\\sin45^{\\circ}=\\dfrac{\\sqrt6-\\sqrt2}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sqrt6-\\sqrt2}{4}=\\mathrm{RHS}$",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sqrt3}{2}\\times\\frac1{\\sqrt2}-\\frac12\\times\\frac1{\\sqrt2}\\\\&=\\frac{\\sqrt3-1}{2\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}\\\\&=\\frac{\\sqrt6-\\sqrt2}{4}=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\tan60^{\\circ}-\\tan45^{\\circ}}{1+\\tan60^{\\circ}\\tan45^{\\circ}}=2-\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=2-\\sqrt3=\\mathrm{RHS}$",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sqrt3-1}{1+\\sqrt3}\\times\\frac{1-\\sqrt3}{1-\\sqrt3}\\\\&=\\frac{-4+2\\sqrt3}{-2}\\\\&=\\frac{4-2\\sqrt3}{2}\\\\&=2-\\sqrt3=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1}{\\dfrac1{\\cos30^{\\circ}}-\\tan30^{\\circ}}=\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\sqrt3=\\mathrm{RHS}$",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac1{\\left(\\frac2{\\sqrt3}-\\frac1{\\sqrt3}\\right)}\\\\&=\\frac1{\\left(\\frac1{\\sqrt3}\\right)}\\\\&=\\sqrt3=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p10-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1+\\tan30^{\\circ}}{1-\\tan30^{\\circ}}=2+\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=2+\\sqrt3=\\mathrm{RHS}$",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\left(1+\\frac1{\\sqrt3}\\right)}{\\left(1-\\frac1{\\sqrt3}\\right)}\\\\&=\\frac{\\left(\\frac{\\sqrt3+1}{\\sqrt3}\\right)}{\\left(\\frac{\\sqrt3-1}{\\sqrt3}\\right)}\\\\&=\\frac{\\sqrt3+1}{\\sqrt3-1}\\times\\frac{\\sqrt3+1}{\\sqrt3+1}\\\\&=\\frac{4+2\\sqrt3}{2}\\\\&=2+\\sqrt3=\\mathrm{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
