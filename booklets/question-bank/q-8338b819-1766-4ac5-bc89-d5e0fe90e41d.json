  "content": {
    "id": "p9-q29-root",
    "type": "question",
    "label": "29",
    "prompt": "Consider functions from $X=\\{a,b,c,d,e\\}$ to $Y=\\{0,1\\}$. How many are there if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q29-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^5=32$.",
          "worked": "Each of the five domain elements can map to either $0$ or $1$.\n$$\\begin{align*}N&=2^5\\\\N&=32.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q29-b",
        "type": "part",
        "label": "b",
        "prompt": "the range is $\\{0\\}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$.",
          "worked": "Every domain element must map to $0$, giving exactly one function.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-q29-c",
        "type": "part",
        "label": "c",
        "prompt": "the range is $\\{1\\}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$.",
          "worked": "Every domain element must map to $1$, giving exactly one function.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-q29-d",
        "type": "part",
        "label": "d",
        "prompt": "the range is $\\{0,1\\}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^5-2=30$.\n\nExclude the two constant functions.",
          "worked": "Both values must occur as images. Exclude the function mapping everything to $0$ and the function mapping everything to $1$.\n$$\\begin{align*}N&=2^5-1-1\\\\N&=30.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
