  "content": {
    "id": "v2-9683b8-p6-practice-j9-032038-root",
    "type": "question",
    "label": null,
    "prompt": "Find the values of $x$ that satisfy both conditions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-9683b8-p6-practice-j9-032038-j9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$x>-1$ and $x\\le3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1<x\\le3$",
          "worked": "Both must hold, so $x$ is above $-1$ and at most 3.\n$$-1<x\\le3$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-9683b8-p6-practice-j9-032038-j9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\ge2$ and $x>4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>4$",
          "worked": "Every value above 4 is also at least 2, so the second condition is the stricter.\n$$x>4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-9683b8-p6-practice-j9-032038-j9-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$x<1$ and $x>3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No value of $x$",
          "worked": "A number less than 1 cannot also be greater than 3, so no value satisfies both.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-9683b8-p6-practice-j9-032038-j9-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$x\\le2$ and $x\\ge2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "The only number that is both at most 2 and at least 2 is 2.\n$$x=2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
