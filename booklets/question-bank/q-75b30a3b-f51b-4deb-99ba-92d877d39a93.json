  "content": {
    "id": "p15-practice-1-root",
    "type": "question",
    "label": "",
    "prompt": "Find the value of $n$ for which the partial sum $S_n$ of $1+4+16+\\cdots$ is equal to $21\\,845$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=8$",
      "worked": "$a=1$, $r=4$ and $S_n=21\\,845$.\n$$\\begin{align*}S_n&=\\frac{a(r^n-1)}{r-1}\\\\21\\,845&=\\frac{4^n-1}{3}\\\\65\\,535&=4^n-1\\\\4^n&=65\\,536\\\\4^n&=4^8\\\\n&=8\\end{align*}$$",
      "solutionDiagrams": []
    },
