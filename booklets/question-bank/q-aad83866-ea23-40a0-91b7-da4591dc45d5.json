    "answer": {
      "short": "\\$17 320.45",
      "worked": "$$\\begin{align*}\\text{Taxable income} &= 84\\,000-900-474\\\\\\text{Taxable income} &= \\$82\\,626\\end{align*}$$\nThis is the third tax bracket.\n$$\\begin{align*}\\text{Excess} &= 82\\,626-45\\,000\\\\\\text{Excess} &= \\$37\\,626\\\\\\text{Tax payable} &= 5092+0.325\\times37\\,626\\\\\\text{Tax payable} &= \\$17\\,320.45\\end{align*}$$",
