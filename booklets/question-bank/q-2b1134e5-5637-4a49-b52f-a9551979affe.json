  "content": {
    "id": "p19-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A robot can build an identical robot in one hour. Two robots would take half that time, three robots would take a third of that time, and so on. Starting with one robot, how long would it take to have four robots in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p19-q13-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\frac{11}{6}\\text{ hours}",
                "display": false
              },
              {
                "type": "text",
                "text": " (1 hour 50 minutes).",
                "marks": []
              }
            ]
          },
          {
            "id": "p19-q13-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Add the times to build the second, third and fourth robots.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "The starting robot is included in the total, so three more robots are needed. Each newly completed robot joins the builders.\n\n$$\\begin{align*}\\text{Time to build the second robot} &= 1\\text{ hour}\\\\\\text{Time to build the third robot} &= \\frac{1}{2}\\text{ hour}\\\\\\text{Time to build the fourth robot} &= \\frac{1}{3}\\text{ hour}\\\\\\text{Total time} &= 1+\\frac{1}{2}+\\frac{1}{3}\\\\\\text{Total time} &= \\frac{11}{6}\\text{ hours}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
