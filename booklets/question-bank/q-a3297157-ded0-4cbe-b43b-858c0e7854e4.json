  "content": {
    "id": "p37-question-1-10-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p37-question-1-10-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "True or False? ",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "f(x)=k(a^x)+h",
              "display": false
            },
            {
              "type": "text",
              "text": " and let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "g(x)=k(b^{-x})+h",
              "display": false
            },
            {
              "type": "text",
              "text": ", where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "a,b>1",
              "display": false
            },
            {
              "type": "text",
              "text": ", ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "k\\ne0",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "h\\in\\mathbb{R}",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-part-1",
        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=f(x)$ will always have an $x$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. For example, with $k=1$ and $h=0$, $f(x)=a^x>0$ for every real $x$, so there is no $x$-intercept.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-2",
        "type": "part",
        "label": "b",
        "prompt": "The graph of $y=f(x)$ will always have a $y$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True.\n$$\\begin{align*}f(0)&=k(a^0)+h\\\\f(0)&=k+h\\end{align*}$$\nThe $y$-intercept is $(0,k+h)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-3",
        "type": "part",
        "label": "c",
        "prompt": "The graph of $y=g(x)$ will always have an $x$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. For example, with $k=1$ and $h=0$, $g(x)=b^{-x}>0$ for every real $x$, so there is no $x$-intercept.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-4",
        "type": "part",
        "label": "d",
        "prompt": "The graph of $y=g(x)$ will always have a $y$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True.\n$$\\begin{align*}g(0)&=k(b^0)+h\\\\g(0)&=k+h\\end{align*}$$\nThe $y$-intercept is $(0,k+h)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-5",
        "type": "part",
        "label": "e",
        "prompt": "The domain of $f$ is $(-\\infty,\\infty)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True. Since $a>1$, $a^x$ is defined for every real $x$. Multiplication by $k$ and addition of $h$ do not restrict the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-6",
        "type": "part",
        "label": "f",
        "prompt": "The domain of $g$ is $(-\\infty,\\infty)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True. Since $b>1$, $b^{-x}$ is defined for every real $x$. Multiplication by $k$ and addition of $h$ do not restrict the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-7",
        "type": "part",
        "label": "g",
        "prompt": "The range of $f$ is $(h,\\infty)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. Since $a^x>0$, the range is $(h,\\infty)$ when $k>0$, but $(-\\infty,h)$ when $k<0$. The value $h$ is never attained.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-8",
        "type": "part",
        "label": "h",
        "prompt": "The range of $g$ is $(-\\infty,h)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "False. Since $b^{-x}>0$, the range is $(-\\infty,h)$ when $k<0$, but $(h,\\infty)$ when $k>0$. The value $h$ is never attained.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-9",
        "type": "part",
        "label": "i",
        "prompt": "If $0<a<1$ (instead of $a>1$), then $f$ can be written in the form of $g$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True. Put $b=\\dfrac1a$, so $b>1$.\n$$\\begin{align*}f(x)&=k\\left[\\left(\\frac1b\\right)^x\\right]+h\\\\f(x)&=k(b^{-x})+h\\end{align*}$$\nThis is the form of $g$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p37-part-10",
        "type": "part",
        "label": "j",
        "prompt": "As $x\\to\\infty$, the graph of $g$ approaches $y=h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True. Since $b>1$, $b^{-x}\\to0$ as $x\\to\\infty$, so $g(x)=k(b^{-x})+h\\to h$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      }
    ]
  },
