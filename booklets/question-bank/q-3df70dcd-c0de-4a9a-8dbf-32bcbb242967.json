                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}L'(x)&=2-1800x^{-2}\\\\L'(x)&=\\frac{2x^2-1800}{x^2}.\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
