  "content": {
    "id": "p26-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find $R$ (exactly) and $\\alpha$ (correct to the nearest minute), if $R>0$ and $0^\\circ\\leq\\alpha<360^\\circ$, and:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$R\\sin\\alpha=5$ and $R\\cos\\alpha=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=13$, $\\alpha\\approx22^\\circ37'$.",
          "worked": "$$\\begin{align*}R^2&=5^2+12^2=169\\\\R&=13\\\\\\tan\\alpha&=\\frac{5}{12}\\end{align*}$$\nSince $R>0$ and both given coefficients are positive, $\\alpha$ is in quadrant I.\n$$\\begin{align*}\\alpha&=\\tan^{-1}\\left(\\frac{5}{12}\\right)\\\\\\alpha&\\approx22^\\circ37'\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p26-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$R\\cos\\alpha=2$ and $R\\sin\\alpha=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=2\\sqrt{5}$, $\\alpha\\approx63^\\circ26'$.",
          "worked": "$$\\begin{align*}R^2&=2^2+4^2=20\\\\R&=2\\sqrt{5}\\\\\\tan\\alpha&=\\frac{4}{2}=2\\end{align*}$$\nSince $R>0$ and both given coefficients are positive, $\\alpha$ is in quadrant I.\n$$\\begin{align*}\\alpha&=\\tan^{-1}(2)\\\\\\alpha&\\approx63^\\circ26'\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
