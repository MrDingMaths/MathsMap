    "id": "p35-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Show that horizontally translating $y=2^x$ is equivalent to dilating it vertically.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "A horizontal translation left by $c$ gives $y=2^{x+c}=2^c2^x$, a vertical dilation by factor $2^c$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
