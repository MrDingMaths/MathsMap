  "content": {
    "id": "p5-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the shortest distance from the point $(2,3)$ to a circle of radius $1$ centred at $(0,0)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt{13}-1$ units.",
      "worked": "The shortest segment lies along the line joining the point to the centre.\n$$\\begin{align*}d&=\\sqrt{(2-0)^2+(3-0)^2}\\\\d&=\\sqrt{13}.\\end{align*}$$\nThe point is outside the circle, so the shortest distance is\n$$\\sqrt{13}-1\\text{ units}.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
