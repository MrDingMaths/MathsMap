  "content": {
    "id": "p23-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Time taken in hours $(t)$ for a trip varies inversely with average speed $(s)$.\nIt takes 5 hours to complete a trip travelling at 68 km/h.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the constant of variation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=340$",
          "worked": "$$\\begin{align*}t&=\\frac{k}{s}\\\\5&=\\frac{k}{68}\\\\340&=k\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p23-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an inverse variation equation to describe this situation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{340}{s}$",
          "worked": "Using $k=340$ in $t=\\frac{k}{s}$:\n$$t=\\frac{340}{s}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the time taken for a trip with an average speed of 34 km/h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "10 hours",
          "worked": "$$\\begin{align*}t&=\\frac{340}{34}\\\\t&=10\\end{align*}$$\nThe trip takes 10 hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "What speed is required to complete the trip in 4 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "85 km/h",
          "worked": "$$\\begin{align*}4&=\\frac{340}{s}\\\\4s&=340\\\\s&=\\frac{340}{4}\\\\s&=85\\end{align*}$$\nThe required speed is 85 km/h.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
