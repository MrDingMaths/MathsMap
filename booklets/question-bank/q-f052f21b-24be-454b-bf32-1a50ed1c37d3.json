  "content": {
    "id": "p52-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Decide if these pairs of lines are parallel, perpendicular, or neither.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=3x-1\\\\y&=3x+7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "$m_1=3$ and $m_2=3$. The gradients are equal, so the lines are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p52-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=\\frac12x-6\\\\y&=\\frac{x}{2}-4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "$m_1=\\frac12$ and $m_2=\\frac12$. The gradients are equal, so the lines are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p52-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=-\\frac23x+1\\\\y&=\\frac23x-3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Neither.",
          "worked": "$m_1=-\\frac23$ and $m_2=\\frac23$.\n$$m_1m_2=-\\frac23\\times\\frac23=-\\frac49$$\nThe gradients are unequal and their product is not $-1$, so the lines are neither parallel nor perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=-8x+4\\\\y&=\\frac18x-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perpendicular.",
          "worked": "$m_1=-8$ and $m_2=\\frac18$.\n$$m_1m_2=-8\\times\\frac18=-1$$\nThe lines are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p52-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}x-y&=4\\\\y&=-x+\\frac12\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perpendicular.",
          "worked": "$$\\begin{aligned}x-y&=4\\\\y&=x-4\\end{aligned}$$\nThe gradients are $1$ and $-1$.\n$$m_1m_2=1\\times(-1)=-1$$\nThe lines are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p52-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}3x-y&=2\\\\x+3y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perpendicular.",
          "worked": "$$\\begin{aligned}3x-y&=2\\\\y&=3x-2\\end{aligned}$$\n$$\\begin{aligned}x+3y&=5\\\\3y&=5-x\\\\y&=-\\frac13x+\\frac53\\end{aligned}$$\nThe gradients are $3$ and $-\\frac13$.\n$$m_1m_2=3\\times\\left(-\\frac13\\right)=-1$$\nThe lines are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
