  "content": {
    "id": "p61-q3",
    "type": "question",
    "label": "3",
    "prompt": "A rectangular prism has width $y$ cm, length $(x+a)$ cm and height $(x+b)$ cm, where $a$ and $b$ are integers and $a>b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p61-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the surface area of the rectangular prism is given by the expression\n$$2y(2x+a+b)+2(x+a)(x+b)\\text{ cm}^2.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S=2y(x+a)+2y(x+b)+2(x+a)(x+b)=2y(2x+a+b)+2(x+a)(x+b)\\text{ cm}^2$.",
          "worked": "There are two faces of each of the three different areas.\n$$\\begin{align*}S&=2y(x+a)+2y(x+b)+2(x+a)(x+b)\\\\&=2y\\big((x+a)+(x+b)\\big)+2(x+a)(x+b)\\\\&=2y(2x+a+b)+2(x+a)(x+b)\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p61-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "If the surface area of the rectangular prism is equivalent to the expression $2y(2x+1)+2x^2+2x-12\\text{ cm}^2$, find $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3$, $b=-2$.",
          "worked": "$$\\begin{align*}S&=2y(2x+a+b)+2\\big(x^2+(a+b)x+ab\\big)\\\\&=4xy+2(a+b)y+2x^2+2(a+b)x+2ab\\end{align*}$$\nEquate the coefficients of $y$ and the constant terms.\n$$\\begin{align*}2(a+b)&=2\\\\a+b&=1\\\\2ab&=-12\\\\ab&=-6\\end{align*}$$\nThe integers $3$ and $-2$ have sum $1$ and product $-6$. Since $a>b$, $a=3$ and $b=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
