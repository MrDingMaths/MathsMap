    "children": [
      {
        "id": "p26-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the difference between $30\\%$ of $600$ and $33\\frac{1}{3}\\%$ of $600$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "$\\begin{align*}30\\%\\text{ of }600 &= (600\\div10)\\times3\\\\ &=180\\\\33\\frac{1}{3}\\%\\text{ of }600 &=600\\div3=200\\\\\\text{Difference} &=200-180=20\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p26-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down $3\\frac{1}{3}\\%$ of $600$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "$33\\frac{1}{3}\\%-30\\%=3\\frac{1}{3}\\%$, so the difference in part a gives $3\\frac{1}{3}\\%$ of $600$: $20$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p26-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Work out $3\\frac{1}{3}\\%$ of $90$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$\\begin{align*}33\\frac{1}{3}\\%\\text{ of }90 &=90\\div3=30\\\\3\\frac{1}{3}\\%\\text{ of }90 &=30\\div10=3\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "Work out $6\\frac{2}{3}\\%$ of $450$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$\\begin{align*}33\\frac{1}{3}\\%\\text{ of }450 &=450\\div3=150\\\\6\\frac{2}{3}\\%\\text{ of }450 &=150\\div5=30\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
