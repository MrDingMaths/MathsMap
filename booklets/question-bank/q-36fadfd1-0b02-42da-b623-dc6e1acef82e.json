        "type": "part",
        "label": "c",
        "prompt": "$a$ is directly proportional to the square root of $b$ and $a=12$ when $b=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4\\sqrt{b}$",
          "worked": "$$\\begin{align*}a&=k\\sqrt{b}\\\\12&=k\\sqrt{9}\\\\12&=3k\\\\k&=4\\\\a&=4\\sqrt{b}\\end{align*}$$",
          "solutionDiagrams": []
