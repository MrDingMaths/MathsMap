  "content": {
    "id": "p26-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Explain why a polynomial of odd degree must have at least one real root.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "An odd-degree polynomial has opposite signs at its two ends. Since its graph is continuous, it must cross the $x$-axis at least once.",
      "worked": "Let $P(x)$ have leading term $a_nx^n$, where $n$ is odd. For sufficiently large positive and negative $x$, the leading term determines the sign of $P(x)$. Since $n$ is odd, $a_nx^n$ has opposite signs at the two ends, so $P(x)$ also has opposite signs there.\n\nA polynomial is continuous, so its graph must cross the $x$-axis between these values. Hence there is some $c\\in\\mathbb{R}$ with $P(c)=0$, giving at least one real root.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
