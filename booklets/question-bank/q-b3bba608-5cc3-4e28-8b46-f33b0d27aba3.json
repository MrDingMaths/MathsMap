  "content": {
    "id": "p12-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The temperature in Canberra on a very cold day went from $11^\\circ\\mathrm{C}$ to $-3^\\circ\\mathrm{C}$. What was the change in temperature?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-14^\\circ\\mathrm{C}$, a fall of $14^\\circ\\mathrm{C}$.",
      "worked": "Change in temperature is final temperature minus initial temperature.\n\n$$\\begin{align*}\\text{Change}&=-3-11\\\\\\text{Change}&=-14^\\circ\\mathrm{C}.\\end{align*}$$\nThe temperature fell by $14^\\circ\\mathrm{C}$.",
      "solutionDiagrams": []
