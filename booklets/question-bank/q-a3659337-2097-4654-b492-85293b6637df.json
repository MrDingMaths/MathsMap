  "content": {
    "id": "p8-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Given $\\cos\\theta=\\frac23$, find the value of $\\tan\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\tan\\theta=\\pm\\frac{\\sqrt5}{2}$.",
      "worked": "$$\\begin{align*}\\sin^2\\theta&=1-\\left(\\frac23\\right)^2\\\\\\sin^2\\theta&=\\frac59\\\\\\sin\\theta&=\\pm\\frac{\\sqrt5}{3}\\\\\\tan\\theta&=\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\tan\\theta&=\\frac{\\pm\\sqrt5/3}{2/3}\\\\\\tan\\theta&=\\pm\\frac{\\sqrt5}{2}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
