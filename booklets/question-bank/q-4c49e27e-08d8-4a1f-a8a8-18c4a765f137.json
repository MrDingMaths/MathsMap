    "type": "question",
    "label": "",
    "prompt": "If $A=16x-2x^2$ and $\\dfrac{dx}{dt}=11$, evaluate $\\dfrac{dA}{dt}$ when $x=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$44$",
      "worked": "Variables: $A,x,t$.\n$$\\begin{aligned}\\frac{dA}{dt}&=\\frac{dA}{dx}\\times\\frac{dx}{dt}\\\\\\frac{dA}{dt}&=(16-4x)\\times11\\end{aligned}$$\nAt $x=3$:\n$$\\begin{aligned}\\frac{dA}{dt}&=(16-4(3))\\times11\\\\\\frac{dA}{dt}&=44\\end{aligned}$$",
      "solutionDiagrams": []
    },
