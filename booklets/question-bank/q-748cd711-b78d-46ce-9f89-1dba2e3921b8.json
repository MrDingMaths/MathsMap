  "content": {
    "id": "p15-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Solve these equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x+4}{7}+\\frac{2x-9}{6}=5x+1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{81}{190}$",
          "worked": "Multiply both sides by $42$.\n$$\\begin{align*}6(x+4)+7(2x-9)&=42(5x+1)\\\\6x+24+14x-63&=210x+42\\\\20x-39&=210x+42\\\\190x&=-81\\\\x&=-\\frac{81}{190}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p15-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{7n+1}{2}+7=\\frac{3n-25}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-5$",
          "worked": "Multiply both sides by $4$.\n$$\\begin{align*}2(7n+1)+28&=3n-25\\\\14n+30&=3n-25\\\\11n&=-55\\\\n&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p15-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{3}{4}-\\frac{x+1}{12}=\\frac{2}{3}-\\frac{x-1}{6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "Multiply both sides by $12$.\n$$\\begin{align*}9-(x+1)&=8-2(x-1)\\\\9-x-1&=8-2x+2\\\\8-x&=10-2x\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p15-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{4x+1}{6}-\\frac{2x-1}{15}=\\frac{3x-5}{5}-\\frac{6x+1}{10}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2.5$",
          "worked": "Multiply both sides by $30$.\n$$\\begin{align*}5(4x+1)-2(2x-1)&=6(3x-5)-3(6x+1)\\\\20x+5-4x+2&=18x-30-18x-3\\\\16x+7&=-33\\\\16x&=-40\\\\x&=-\\frac{5}{2}=-2.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p15-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$$-\\frac{x}{4}+\\frac{3}{8}=\\frac{1}{5}(3x-1)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{23}{34}$",
          "worked": "Multiply both sides by $40$.\n$$\\begin{align*}-10x+15&=8(3x-1)\\\\-10x+15&=24x-8\\\\23&=34x\\\\x&=\\frac{23}{34}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p15-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{4-x}{2}+\\frac{5}{3}=\\frac{2}{5}(1-2x)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{98}{9}$",
          "worked": "Multiply both sides by $30$.\n$$\\begin{align*}15(4-x)+50&=12(1-2x)\\\\60-15x+50&=12-24x\\\\110-15x&=12-24x\\\\9x&=-98\\\\x&=-\\frac{98}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
