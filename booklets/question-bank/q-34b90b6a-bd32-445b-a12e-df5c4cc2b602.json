    "label": "11",
    "prompt": "Find the value of $\\sqrt{7-4\\sqrt{3}}\\times\\sqrt{7+4\\sqrt{3}}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$, using the conjugate product $49-48$.",
      "worked": "$$\\begin{aligned}\\sqrt{7-4\\sqrt{3}}\\times\\sqrt{7+4\\sqrt{3}}&=\\sqrt{(7-4\\sqrt{3})(7+4\\sqrt{3})}\\\\&=\\sqrt{49-48}\\\\&=1\\end{aligned}$$",
      "solutionDiagrams": []
    },
