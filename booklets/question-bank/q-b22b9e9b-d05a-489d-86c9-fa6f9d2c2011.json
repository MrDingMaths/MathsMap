  "content": {
    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "How many ways can five different letters be posted to three different letterboxes?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q5a",
        "type": "part",
        "label": "a",
        "prompt": "without further restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$243$",
          "worked": "Each of the five letters has three choices of letterbox.\n$$N=3^5=243.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q5b",
        "type": "part",
        "label": "b",
        "prompt": "so that exactly one letterbox is empty",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90$",
          "worked": "Choose the empty letterbox in three ways. Allocate the letters to the other two letterboxes, excluding the two allocations that leave one of these empty.\n$$\\begin{align*}N&=3(2^5-2)\\\\N&=3\\times30\\\\N&=90.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q5c",
        "type": "part",
        "label": "c",
        "prompt": "so that exactly two letterboxes are empty",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "All five letters must go into the same letterbox. There are three choices of this letterbox, so $N=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q5d",
        "type": "part",
        "label": "d",
        "prompt": "so that no letterbox is empty",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p24-q5d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "150",
                    "display": false
                  }
                ]
              },
              {
                "id": "p24-q5d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Subtract the allocations with exactly one or two empty letterboxes from the unrestricted total.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Subtract the allocations counted in parts (b) and (c) from the unrestricted total.\n$$\\begin{align*}N&=243-90-3\\\\N&=150.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
