                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "At stationary points, ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y'=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}2(x-5)(3x-4)&=0\\\\x&=5\\text{ or }\\frac43.\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p22-q15-b-values",
