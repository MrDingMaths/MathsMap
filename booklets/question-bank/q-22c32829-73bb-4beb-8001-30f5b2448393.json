                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}y\\left(\\frac43\\right)&=\\left(\\frac43-5\\right)^2\\left(2\\cdot\\frac43+1\\right)\\\\y\\left(\\frac43\\right)&=\\frac{121}{9}\\cdot\\frac{11}{3}\\\\y\\left(\\frac43\\right)&=\\frac{1331}{27},\\\\y(5)&=(5-5)^2(2\\cdot5+1)\\\\y(5)&=0.\\end{aligned}",
