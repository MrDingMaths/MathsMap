        "id": "p22-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the product rule to show that if $y=(x-5)^2(2x+1)$, then $y'=2(x-5)(3x-4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2(x-5)(3x-4)$.",
          "worked": "$$\\begin{align*}y'&=2(x-5)(2x+1)+2(x-5)^2\\\\y'&=2(x-5)\\big[(2x+1)+(x-5)\\big]\\\\y'&=2(x-5)(3x-4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p22-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Find any stationary points and use a table of gradients to classify them.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Local maximum at $\\left(\\frac43,\\frac{1331}{27}\\right)$; local minimum at $(5,0)$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
