  "content": {
    "id": "p31-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Three numbers are in the ratio $2:5:3$. If the largest number is $120$, find the other two numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$48$ and $72$.",
      "worked": "The largest number corresponds to $5$ parts.\n$$\\begin{align*}5\\text{ parts}&=120\\\\1\\text{ part}&=120\\div5=24\\\\2\\text{ parts}&=2\\times24=48\\\\3\\text{ parts}&=3\\times24=72\\end{align*}$$\nThe other two numbers are $48$ and $72$.",
      "solutionDiagrams": []
    },
