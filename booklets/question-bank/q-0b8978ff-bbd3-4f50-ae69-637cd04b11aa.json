        "id": "p16-ex12d-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "In $\\triangle ABC$, $A=62^\\circ$, $B=54^\\circ$ and $a=8$. Find $b$, correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b\\approx7.33$",
          "worked": "$$\\begin{align*}\\frac{b}{\\sin54^\\circ}&=\\frac{8}{\\sin62^\\circ}\\\\b&=\\frac{8\\sin54^\\circ}{\\sin62^\\circ}\\\\b&\\approx7.33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p16-ex12d-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "In $\\triangle ABC$, $B=47^\\circ$, $C=82^\\circ$ and $b=10$. Find $a$, correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a\\approx10.63$",
          "worked": "$$\\begin{align*}A&=180^\\circ-47^\\circ-82^\\circ\\\\A&=51^\\circ\\end{align*}$$\n\n$$\\begin{align*}\\frac{a}{\\sin51^\\circ}&=\\frac{10}{\\sin47^\\circ}\\\\a&=\\frac{10\\sin51^\\circ}{\\sin47^\\circ}\\\\a&\\approx10.63\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
