  "content": {
    "id": "p6-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The fraction of a class that are boys is $\\frac{3}{5}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the class are girls?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "$$\\begin{aligned}\\text{Fraction who are girls}&=1-\\frac{3}{5}\\\\&=\\frac{2}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Eddie says that the ratio of boys to girls is $3:5$.\nExplain why he is incorrect and state the correct ratio of boys to girls.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:5$ is the ratio of boys to all students. The ratio of boys to girls is $3:2$.",
          "worked": "The $5$ represents the whole class, so $3:5$ compares boys to all students. Girls account for $5-3=2$ of the $5$ equal parts. Therefore, the ratio of boys to girls is $3:2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
