        "label": "a",
        "prompt": "Write down three powers of base 7.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answers: $7^2$, $7^3$, $7^4$.",
          "worked": "The base is the repeated factor. Three powers with base 7 are $7^2=7\\times7$, $7^3=7\\times7\\times7$ and $7^4=7\\times7\\times7\\times7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down three powers with index 7.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answers: $2^7$, $3^7$, $4^7$.",
          "worked": "The index gives the number of equal factors. The powers $2^7$, $3^7$ and $4^7$ each have index 7.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Write 49, 144 and 8 as powers with indices greater than 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$49=7^2$, $144=12^2$, $8=2^3$.",
          "worked": "$$\\begin{align*}49&=7\\times7=7^2\\\\144&=12\\times12=12^2\\\\8&=2\\times2\\times2=2^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
