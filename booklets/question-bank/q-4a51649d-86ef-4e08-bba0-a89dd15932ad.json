  "content": {
    "id": "v2-2c897-p51-practice-slot-13-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Solve $e^{3\\ln x}=4e^{\\ln x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=2$",
      "worked": "$$\\begin{align*}e^{3\\ln x}&=4e^{\\ln x}\\\\e^{\\ln x^3}&=4e^{\\ln x}\\\\x^3&=4x\\\\x^3-4x&=0\\\\x(x-2)(x+2)&=0\\end{align*}$$So $x=0$, $x=2$ or $x=-2$. Since $x>0$, $x=2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
