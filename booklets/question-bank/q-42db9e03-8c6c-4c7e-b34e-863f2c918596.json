  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Some piecework is paid on a sliding scale, meaning the pay per item changes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q9-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p24-q9-a-stem",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Alison makes flower arrangements. She is paid $6.80 for the first 20 arrangements.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "If she supplies more than 20 she is paid at a higher rate of $8.90 per arrangement.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "How much does she earn if she makes 28 flower arrangements?",
                  "marks": []
                }
              ]
            },
            {
              "id": "p24-q9-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "(20\\times",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$\\$6.80$",
                  "width": 20
                },
                {
                  "type": "math",
                  "latex": ")+(",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "8",
                  "width": 9
                },
                {
                  "type": "math",
                  "latex": "\\times\\$8.90)=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$\\$207.20$",
                  "width": 20
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$207.20",
          "worked": "$$\\begin{align*}\\text{Extra arrangements}&=28-20\\\\&=8\\\\\\text{Pay}&=(20\\times\\$6.80)+(8\\times\\$8.90)\\\\&=\\$136.00+\\$71.20\\\\&=\\$207.20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p24-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "James frames photographs. He is paid \\$7.95 for the first 30 frames, then afterwards he is paid \\$9.50 per frame. How much does he earn if he frames 56 photographs?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$485.50",
          "worked": "$$\\begin{align*}\\text{Extra frames}&=56-30\\\\&=26\\\\\\text{Pay}&=(30\\times\\$7.95)+(26\\times\\$9.50)\\\\&=\\$238.50+\\$247.00\\\\&=\\$485.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p24-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Malik picks fruit. He is paid \\$3.50 per bucket for the first 35 buckets. He is paid \\$4.25 for each extra bucket. How much does he earn if he picks 62 buckets of fruit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$237.25",
          "worked": "$$\\begin{align*}\\text{Extra buckets}&=62-35\\\\&=27\\\\\\text{Pay}&=(35\\times\\$3.50)+(27\\times\\$4.25)\\\\&=\\$122.50+\\$114.75\\\\&=\\$237.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p24-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Troy sells internet packages. He is paid \\$65.70 for each sale he makes. If he makes more than 5 sales, each extra sale is paid an additional \\$23.95 per sale. How much does he earn if he makes 8 sales?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$597.45; the extra \\$23.95 applies to 3 sales.",
          "worked": "$$\\begin{align*}\\text{Extra sales}&=8-5\\\\&=3\\\\\\text{Pay}&=(8\\times\\$65.70)+(3\\times\\$23.95)\\\\&=\\$525.60+\\$71.85\\\\&=\\$597.45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
