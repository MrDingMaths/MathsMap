    "children": [
      {
        "id": "p78-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the vertex in terms of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5,-9k)$.",
          "worked": "The axis lies midway between the roots $2$ and $8$:\n$$\\begin{align*}x&=\\frac{2+8}{2}\\\\x&=5.\\end{align*}$$\nAt $x=5$,\n$$\\begin{align*}y&=k(5-2)(5-8)\\\\y&=-9k.\\end{align*}$$\nThe vertex is $(5,-9k)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p78-q9-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p78-q9-b-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Show that the area of the triangle is",
                  "marks": []
                }
              ]
            },
            {
              "id": "p78-q9-b-result",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "27|k|.",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Base $6$, perpendicular height $9|k|$; area $=\\frac12(6)(9|k|)=27|k|$ square units.",
          "worked": "The triangle has base $8-2=6$ and perpendicular height $|-9k|=9|k|$. Hence\n$$\\begin{align*}\\text{Area}&=\\frac12\\times\\text{base}\\times\\text{height}\\\\\\text{Area}&=\\frac12(6)(9|k|)\\\\\\text{Area}&=27|k|\\text{ square units}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p78-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find every value of $k$ for which the triangle has area $54$ square units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=2$ or $k=-2$.",
          "worked": "Set the area equal to $54$:\n$$\\begin{align*}27|k|&=54\\\\|k|&=2.\\end{align*}$$\nThus $k=2$ or $k=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p78-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Give the equation and vertex of each resulting parabola.",
        "layout": "list",
