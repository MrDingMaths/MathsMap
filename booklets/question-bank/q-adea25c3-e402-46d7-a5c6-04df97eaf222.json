  "content": {
    "id": "p15-q4-content",
    "type": "question",
    "label": "4",
    "prompt": "Let $f(x)=x^2+px+q$. Find $p$ and $q$ if $f(1)=3$ and $f'(1)=5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=3$, $q=-1$. The derivative condition gives $p=3$; substituting into $f(1)=3$ gives $q=-1$.",
      "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{(x+h)^2+p(x+h)+q-(x^2+px+q)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2xh+h^2+ph}{h}\\\\f'(x)&=\\lim_{h\\to0}(2x+h+p)\\\\f'(x)&=2x+p\\\\f'(1)&=2+p=5\\\\p&=3\\\\f(1)&=1+p+q=3\\\\q&=-1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 78
  },
