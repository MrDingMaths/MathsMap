  "content": {
    "id": "p27-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "For $\\triangle ABC$ we are given that $\\angle A=43^\\circ$, $\\angle B=72^\\circ$ and $a=5.4$. Find $b$ and $c$, correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=7.5$ and $c=7.2$.",
      "worked": "$$\\begin{align*}\\angle C&=180^\\circ-43^\\circ-72^\\circ\\\\\\angle C&=65^\\circ\\end{align*}$$\nUsing the sine rule:\n$$\\begin{align*}\\frac{b}{\\sin72^\\circ}&=\\frac{5.4}{\\sin43^\\circ}\\\\b&=\\frac{5.4\\sin72^\\circ}{\\sin43^\\circ}\\\\b&\\approx7.5\\\\\\frac{c}{\\sin65^\\circ}&=\\frac{5.4}{\\sin43^\\circ}\\\\c&=\\frac{5.4\\sin65^\\circ}{\\sin43^\\circ}\\\\c&\\approx7.2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
