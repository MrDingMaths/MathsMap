  "content": {
    "id": "p66-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "In each part, the angle of inclination $\\alpha$ and a point $A$ on the line are given. Use $m=\\tan\\alpha$ to find the gradient of each line, then find its equation in exact general form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p66-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha=45^\\circ$, $A=(1,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1$; $x-y-1=0$.",
          "worked": "$$\\begin{align*}m&=\\tan45^\\circ\\\\m&=1\\\\y-0&=1(x-1)\\\\y&=x-1\\\\x-y-1&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p66-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha=120^\\circ$, $A=(-1,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\sqrt3$; $\\sqrt3x+y+\\sqrt3=0$.",
          "worked": "$$\\begin{align*}m&=\\tan120^\\circ\\\\m&=-\\sqrt3\\\\y-0&=-\\sqrt3(x+1)\\\\y&=-\\sqrt3x-\\sqrt3\\\\\\sqrt3x+y+\\sqrt3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p66-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha=30^\\circ$, $A=(4,-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\dfrac1{\\sqrt3}$; $x-\\sqrt3y-4-3\\sqrt3=0$.",
          "worked": "$$\\begin{align*}m&=\\tan30^\\circ\\\\m&=\\frac1{\\sqrt3}\\\\y+3&=\\frac1{\\sqrt3}(x-4)\\\\\\sqrt3y+3\\sqrt3&=x-4\\\\x-\\sqrt3y-4-3\\sqrt3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p66-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\alpha=150^\\circ$, $A=(-2,-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\dfrac1{\\sqrt3}$; $x+\\sqrt3y+2+5\\sqrt3=0$.",
          "worked": "$$\\begin{align*}m&=\\tan150^\\circ\\\\m&=-\\frac1{\\sqrt3}\\\\y+5&=-\\frac1{\\sqrt3}(x+2)\\\\\\sqrt3y+5\\sqrt3&=-x-2\\\\x+\\sqrt3y+2+5\\sqrt3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
