  "content": {
    "id": "p61-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Flo buys 12 cupcakes for \\$5.64. She sells the cupcakes for 60 cents each.\nWork out Flo's percentage profit. Give your answer to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$27.66\\%$ profit",
      "worked": "$$\\begin{align*}\\text{Selling price}&=12\\times\\$0.60\\\\\\text{Selling price}&=\\$7.20\\\\\\text{Profit}&=\\$7.20-\\$5.64\\\\\\text{Profit}&=\\$1.56\\\\\\text{Percentage profit}&=\\frac{1.56}{5.64}\\times100\\%\\\\\\text{Percentage profit}&\\approx27.66\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
