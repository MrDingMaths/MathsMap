  "content": {
    "id": "p62-q15",
    "type": "question",
    "label": "15",
    "prompt": "The triangle $ABC$ has vertices $A(2\\sqrt3,3)$, $B(3\\sqrt3,4)$ and $C(2\\sqrt3,5)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p62-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\overrightarrow{AB}$ and $\\overrightarrow{CB}$ as column vectors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AB}=\\begin{pmatrix}\\sqrt3\\\\1\\end{pmatrix}$, $\\overrightarrow{CB}=\\begin{pmatrix}\\sqrt3\\\\-1\\end{pmatrix}$.",
          "worked": "$$\\begin{aligned}\\overrightarrow{OA}&=\\begin{pmatrix}2\\sqrt3\\\\3\\end{pmatrix}\\\\\\overrightarrow{OB}&=\\begin{pmatrix}3\\sqrt3\\\\4\\end{pmatrix}\\\\\\overrightarrow{OC}&=\\begin{pmatrix}2\\sqrt3\\\\5\\end{pmatrix}\\end{aligned}$$\n$$\\begin{aligned}\\overrightarrow{AB}&=\\overrightarrow{OB}-\\overrightarrow{OA}\\\\&=\\begin{pmatrix}3\\sqrt3-2\\sqrt3\\\\4-3\\end{pmatrix}\\\\&=\\begin{pmatrix}\\sqrt3\\\\1\\end{pmatrix}\\end{aligned}$$\n$$\\begin{aligned}\\overrightarrow{CB}&=\\overrightarrow{OB}-\\overrightarrow{OC}\\\\&=\\begin{pmatrix}3\\sqrt3-2\\sqrt3\\\\4-5\\end{pmatrix}\\\\&=\\begin{pmatrix}\\sqrt3\\\\-1\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p62-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $|\\overrightarrow{AB}|$ and $|\\overrightarrow{CB}|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\overrightarrow{AB}|=|\\overrightarrow{CB}|=2$.",
          "worked": "$$\\begin{aligned}|\\overrightarrow{AB}|&=\\sqrt{(\\sqrt3)^2+1^2}\\\\&=2\\end{aligned}$$\n$$\\begin{aligned}|\\overrightarrow{CB}|&=\\sqrt{(\\sqrt3)^2+(-1)^2}\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p62-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "What type of special triangle is $ABC$? Why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Equilateral: all three sides have length $2$.",
          "worked": "$$\\begin{aligned}\\overrightarrow{AC}&=\\overrightarrow{OC}-\\overrightarrow{OA}\\\\&=\\begin{pmatrix}2\\sqrt3-2\\sqrt3\\\\5-3\\end{pmatrix}\\\\&=\\begin{pmatrix}0\\\\2\\end{pmatrix}\\end{aligned}$$\n$$\\begin{aligned}|\\overrightarrow{AC}|&=\\sqrt{0^2+2^2}\\\\&=2\\end{aligned}$$\n$|\\overrightarrow{AB}|=|\\overrightarrow{CB}|=|\\overrightarrow{AC}|$. Hence $ABC$ is an equilateral triangle, as each side has length $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
