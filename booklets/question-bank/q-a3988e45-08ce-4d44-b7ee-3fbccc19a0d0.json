  "content": {
    "id": "p35-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Identify the natural domain of these functions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge 0$",
          "worked": "The radicand must be non-negative, so the domain is $x\\ge 0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p35-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\sqrt{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge 2$",
          "worked": "The radicand must be non-negative.\n$$\\begin{align*}x-2&\\ge 0\\\\x&\\ge 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sqrt{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge -2$",
          "worked": "The radicand must be non-negative.\n$$\\begin{align*}x+2&\\ge 0\\\\x&\\ge -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\sqrt{5-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le 5$",
          "worked": "The radicand must be non-negative.\n$$\\begin{align*}5-x&\\ge 0\\\\x&\\le 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\sqrt{7-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le \\frac{7}{2}$",
          "worked": "The radicand must be non-negative.\n$$\\begin{align*}7-2x&\\ge 0\\\\2x&\\le 7\\\\x&\\le \\frac{7}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\sqrt{2+5x}+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge -\\frac{2}{5}$",
          "worked": "The radicand must be non-negative; the $+1$ outside the radical adds no restriction.\n$$\\begin{align*}2+5x&\\ge 0\\\\5x&\\ge -2\\\\x&\\ge -\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
