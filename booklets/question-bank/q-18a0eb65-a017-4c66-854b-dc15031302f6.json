  "content": {
    "id": "p60-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "From a standard deck of 52 playing cards, find how many five-card hands can be dealt:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "consisting of black cards only,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$65\\,780$",
          "worked": "There are 26 black cards.\n$$\\begin{align*}N&={}^{26}C_5\\\\&=65\\,780\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p60-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "consisting of diamonds only,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1287$",
          "worked": "There are 13 diamonds.\n$$\\begin{align*}N&={}^{13}C_5\\\\&=1287\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p60-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "containing all four kings,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "Include all four kings and choose the fifth card from the 48 non-kings.\n$$\\begin{align*}N&={}^{4}C_4\\times{}^{48}C_1\\\\&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p60-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "consisting of three diamonds and two clubs,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22\\,308$",
          "worked": "Choose three of the 13 diamonds and two of the 13 clubs.\n$$\\begin{align*}N&={}^{13}C_3\\times{}^{13}C_2\\\\&=22\\,308\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p60-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "consisting of three twos and another pair,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$288$",
          "worked": "Choose three of the four twos. Choose the pair's rank from the 12 remaining ranks, then choose two of its four cards.\n$$\\begin{align*}N&={}^{4}C_3\\times{}^{12}C_1\\times{}^{4}C_2\\\\&=4\\times12\\times6\\\\&=288\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p60-q19-f",
        "type": "part",
        "label": "f",
        "prompt": "consisting of one pair and three of a kind.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3744$",
          "worked": "For the pair, choose one of 13 ranks and two of its four cards. For the three of a kind, choose one of the 12 other ranks and three of its four cards. The ranks must differ.\n$$\\begin{align*}N&=({}^{13}C_1\\times{}^{4}C_2)\\times({}^{12}C_1\\times{}^{4}C_3)\\\\&=13\\times6\\times12\\times4\\\\&=3744\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
