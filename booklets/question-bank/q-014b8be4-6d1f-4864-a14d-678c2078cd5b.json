          "inlines": [
            {
              "type": "text",
              "text": "When antibiotics are introduced into the human body, the concentration of the antibiotic in the bloodstream can be modelled by the equation",
              "marks": []
            }
          ]
        },
        {
          "id": "p12-q12-equation",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "C(t)=9(e^{-0.2t}-e^{-0.4t}),",
              "display": true
            }
          ]
        },
        {
          "id": "p12-q12-units",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "t",
              "display": false
            },
            {
              "type": "text",
              "text": " is time in hours and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "C",
              "display": false
            },
            {
              "type": "text",
              "text": " is measured in ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\mu\\mathrm{g}\\,\\mathrm{mL}^{-1}",
              "display": false
