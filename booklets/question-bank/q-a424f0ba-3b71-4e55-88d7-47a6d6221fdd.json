        "type": "part",
        "label": "a",
        "prompt": "Find the scalar product of $\\mathbf u=3\\mathbf i-6\\mathbf j$ and $\\mathbf v=-2\\mathbf i-\\mathbf j$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathbf u\\cdot\\mathbf v=0$",
          "worked": "$$\\begin{align*}\\mathbf u\\cdot\\mathbf v&=3(-2)+(-6)(-1)\\\\&=-6+6\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the angle between the vectors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90^\\circ$",
          "worked": "Since $\\mathbf u\\cdot\\mathbf v=0$, the vectors are perpendicular. Hence $\\theta=90^\\circ$.",
