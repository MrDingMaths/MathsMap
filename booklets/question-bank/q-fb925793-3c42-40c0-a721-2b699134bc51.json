  "content": {
    "id": "p32-stem-53-62-content",
    "type": "question",
    "label": null,
    "prompt": "Find the domain of the following functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-stem-53-62-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\log_4(1+x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,\\infty)$",
          "worked": "The logarithm argument must be positive.\n$$\\begin{align*}1+x^2&\\geq 1>0\\end{align*}$$\nThis holds for every real $x$. The domain is $(-\\infty,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-stem-53-62-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\ln(3x-x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,3)$",
          "worked": "The logarithm argument must be positive.\n$$\\begin{align*}3x-x^2&>0\\\\x(3-x)&>0\\\\0&<x<3\\end{align*}$$\nThe domain is $(0,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-stem-53-62-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\ln(x^2-2x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,1)\\cup(1,\\infty)$",
          "worked": "The logarithm argument must be positive.\n$$\\begin{align*}x^2-2x+1&>0\\\\(x-1)^2&>0\\end{align*}$$\nThe square is positive for every $x\\ne 1$. The domain is $(-\\infty,1)\\cup(1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-stem-53-62-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\ln(2-x)+\\ln(3-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,2)$",
          "worked": "Both original logarithm arguments must be positive.\n$$\\begin{align*}2-x&>0\\\\x&<2\\\\3-x&>0\\\\x&<3\\end{align*}$$\nBoth restrictions hold when $x<2$. The domain is $(-\\infty,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p32-stem-53-62-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\ln(x^2-4x+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,\\infty)$",
          "worked": "The logarithm argument must be positive.\n$$\\begin{align*}x^2-4x+5&=(x-2)^2+1\\end{align*}$$\nSince $(x-2)^2\\geq 0$, the argument is at least 1 for every real $x$. The domain is $(-\\infty,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-stem-53-62-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\ln(4-x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,2)$",
          "worked": "The logarithm argument must be positive.\n$$\\begin{align*}4-x^2&>0\\\\x^2&<4\\\\-2&<x<2\\end{align*}$$\nThe domain is $(-2,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-stem-53-62-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=\\ln(4+x)+\\ln(4-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-4,4)$",
          "worked": "Both original logarithm arguments must be positive.\n$$\\begin{align*}4+x&>0\\\\x&>-4\\\\4-x&>0\\\\x&<4\\end{align*}$$\nBoth restrictions hold when $-4<x<4$. The domain is $(-4,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p32-stem-53-62-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(x)=\\ln(x^2-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,0)\\cup(1,\\infty)$",
          "worked": "The logarithm argument must be positive.\n$$\\begin{align*}x^2-x&>0\\\\x(x-1)&>0\\end{align*}$$\nThe factors have the same sign when $x<0$ or $x>1$. The domain is $(-\\infty,0)\\cup(1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-stem-53-62-i",
        "type": "part",
        "label": "i",
        "prompt": "$f(x)=\\ln(6-5x-x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-6,1)$",
          "worked": "The logarithm argument must be positive.\n$$\\begin{align*}6-5x-x^2&>0\\\\(1-x)(x+6)&>0\\\\-6&<x<1\\end{align*}$$\nThe domain is $(-6,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p32-stem-53-62-j",
        "type": "part",
        "label": "j",
        "prompt": "$f(x)=\\log_{10}\\left(\\frac{1}{x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,\\infty)$",
          "worked": "The reciprocal must be defined, so $x\\ne 0$, and the logarithm argument must be positive.\n$$\\begin{align*}\\frac{1}{x}&>0\\\\x&>0\\end{align*}$$\nThe domain is $(0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
