  "content": {
    "id": "v2-4ecde1-p4-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the equation $\\dfrac{5-2t}{3}-2=3$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4ecde1-p4-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Solve the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=-5$",
          "worked": "$$\\begin{align*}\\frac{5-2t}{3}&=5\\\\5-2t&=15\\\\-2t&=10\\\\t&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "v2-4ecde1-p4-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Verify your solution by substitution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LHS $=3=$ RHS",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\frac{5-2(-5)}{3}-2\\\\&=\\frac{15}{3}-2\\\\&=3\\\\&=\\text{RHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
