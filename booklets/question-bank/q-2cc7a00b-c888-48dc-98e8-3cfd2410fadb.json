    "children": [
      {
        "id": "p38-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why the area of this region may be written as $\\text{area}=2\\int_0^1(e-e^x)\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The curves are reflections of each other in the $y$-axis. The right half of the region lies under $y=e-e^x$ for $0\\le x\\le1$, so doubling its area gives the whole region.",
          "worked": "Replacing $x$ by $-x$ interchanges $y=e-e^{-x}$ and $y=e-e^x$, so the region is symmetric about the $y$-axis. For $0\\le x\\le1$, the region lies above the $x$-axis and below $y=e-e^x$, which reaches zero at $x=1$. Hence\n$$\\text{area}=2\\int_0^1(e-e^x)\\,dx.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p38-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the area of this region.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\text{ units}^2$",
          "worked": "$$\\begin{align*}\nA&=2\\int_0^1(e-e^x)\\,dx\\\\\nA&=2\\left[ex-e^x\\right]_0^1\\\\\nA&=2\\left[(e-e)-(0-1)\\right]\\\\\nA&=2\\text{ units}^2.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ],
    "diagramPlacement": "right-of-prompt"
