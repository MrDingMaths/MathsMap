        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"regionFill\",\"hex\":\"D4E8FF\",\"reason\":\"The region above the x-axis and below both exponential curves whose area is requested.\"}],\"reference\":\"page 38 question 17 diagram\"}\n\\begin{tikzpicture}[x=16mm,y=12mm,>=Stealth,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{regionFill}{HTML}{D4E8FF}\n\\path[fill=regionFill] (-1,0) -- plot[domain=-1:0,samples=45] (\\x,{exp(1)-exp(-\\x)}) -- plot[domain=0:1,samples=45] (\\x,{exp(1)-exp(\\x)}) -- cycle;\n\\draw[dashed,line width=0.4pt] (-2.05,{exp(1)})--(2.05,{exp(1)});\n\\draw[->,line width=0.5pt] (-2.05,0)--(2.12,0) node[right] {$x$};\n\\draw[->,line width=0.5pt] (0,-1.02)--(0,3.12) node[above] {$y$};\n\\draw[<->,line width=0.8pt] plot[domain=-2.05:1.28,samples=100] (\\x,{exp(1)-exp(\\x)});\n\\draw[<->,line width=0.8pt] plot[domain=-1.28:2.05,samples=100] (\\x,{exp(1)-exp(-\\x)});\n\\node[below] at (-1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[below] at (1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\node[left] at (0,{exp(1)-1}) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$e-1$\\special{dvisvgm:raw </g>}};\n\\node[below left] at (0,{exp(1)}) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$e$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
