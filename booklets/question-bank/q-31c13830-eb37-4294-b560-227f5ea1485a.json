            ]
          },
          "worked": "$$\\begin{align*}2(1+\\sqrt3)^2-(2+\\sqrt3)^2&=2(4+2\\sqrt3)-(7+4\\sqrt3)\\\\2(1+\\sqrt3)^2-(2+\\sqrt3)^2&=8+4\\sqrt3-7-4\\sqrt3\\\\2(1+\\sqrt3)^2-(2+\\sqrt3)^2&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
